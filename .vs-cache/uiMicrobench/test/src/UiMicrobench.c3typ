/**
 * Wrapper for Microbench type.
 *
 * This type does a couple things on top of what Microbench already does:
 *
 * 1. Adds a 'c3ui.' prefix to the name when reporting in Microbench
 * 2. Reports the results to Prometheus for visualization in Grafana via the UiPerformanceKpi
 * App.Meter. See the Test KPIs dashboald here: https://c3ui.c3ci.cloud/grafana/d/L5GUXnZNk/test-kpis
 */
@beta
type UiMicrobench {

  /**
   * Main entry point for executing a single KPI test.
   *
   * This uses a simplified version of Microbench.measureKpi and reports results to UiPerformanceKpi App.Meter.
   *
   * @param name the single test name, which forms the basis for the reported metrics
   * @param spec testing options
   * @param call code to be tested
   */
  @call(stayInEngine=true)
  measureKpi: inline function(name: !string, spec: MicrobenchSpec, call: !lambda(lambdaIterations: !int): any):
                !MicrobenchResultSet js-server

  /**
   * Reports a KPI using Microbench.reportKpiTime in addition to reporting it through UiPerformanceKpi App.Meter.
   *
   * @param name the single test name, which forms the basis for the reported metrics
   * @param time in ms that will be recorded in the MicrobenchResult
   */
  reportKpi: function(name: !string, timeMillis: !int): !MicrobenchResultSet js-server

  /**
   * Provides the default tags from the current execution context: Jarvis data, Hardware profile, App and Server
   */
  tagsFromContext: private function(): map<string, string> js-server

}
