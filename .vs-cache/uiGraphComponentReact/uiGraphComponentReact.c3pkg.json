{
  "name": "uiGraphComponentReact",
  "description": "A UI component for visualizing and interacting with graph data",
  "author": "studio <studio@c3.ai>",
  "version": "8.9.0",
  "compatibleToVersion": "8.7",
  "dependencies": {
    "uiGraphComponent": "8.9",
    "uiComponentLibraryReact": "8.9"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@c3/c3-base",
      "plugin:@c3/typescript",
      "prettier"
    ],
    "plugins": [
      "@c3",
      "prettier"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^e$|^_",
          "ignoreRestSiblings": true
        }
      ],
      "import/prefer-default-export": "off",
      "prettier/prettier": "error"
    }
  }
}
