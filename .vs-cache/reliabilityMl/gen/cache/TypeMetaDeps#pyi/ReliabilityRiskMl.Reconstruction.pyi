        ss_pipe = c3.MlPipe.convert(native_ss, name='ss')
        mm_pipe = c3.MlPipe.convert(native_mm, name='mm')
        x_mm = mm_pipe(x)
        y_ss = ss_pipe(y)
        y_out = lr_pipe(x_mm, y_ss)
        pipeline = mla.pipeline(x={'x':x}, y={'y':y}, out={'y_pred':y_out})
