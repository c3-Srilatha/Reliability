    class Pipeline(Generic[DX, DY, DI, DO], MlTemplate.Pipeline[DX, DY, void, DO, DI], ReliabilityMlDatasetPreparationRunResolvable):
        """
        This type represents a pipeline that can be specifically used within the C3 AI Reliability application. This pipeline
        computes, or learns to compute, a risk score from input time series data and generates an alert if the risk score
        exceeds a certain threshold. There are 7 required inputs and 1 optional input (all of which should be {@link Data}
        and should include a `subject` and `timestamp` index):
        - `features`: The input time series data for a singular asset.
        - `mask_IsAssetNotOperational`: A mask to exclude points when the asset is not operational.
        - `mask_AssetEvent`: A mask to exclude points when there is an event on the asset.
        - `mask_PreAssetEvent`: A pre-event mask to exclude likely anomalous behavior in the lead up to an event.
        - `mask_PostAssetEvent`: A post-event mask to exclude likely transient behavior during startups.
        - `mask_AdHocTraining`: User-defined training mask.
        - `mask_AdHocInference`: User-defined inference mask.
        - `target` (optional): The target risk score.
        
        This pipeline outputs 3 artifacts (the specific output keys are defined by {@link ReliabilityMLOutputConfig}):
        - Risk scores: A risk score for various points in time (may not include all points from input)
        - Normalized risk scores: The risk score for various points in time scaled to be between 0 and 1.
        - Alerts: A value for various points in time signifying whether or not an alert should be raised based on the
          risk scores.
        
        @remarks this represents a made instance of ReliabilityRiskMl.Pipeline
        """
        
        vertices: Optional[Array[MlPipeline.Vertex]]=None
        """
        List of all vertices in this graph.
        """

        edges: Optional[Array[FlowGraph.Edge[MlPipeline.Vertex]]]=None
        """
        List of all edges in this graph.
        """

        vertexConnections: Optional[Map[str, Map[str, Any]]]=None
        """
        Optimized double-linked-list-like data structure for traversing next and previous vertices. See {@link #precomputeVertexConnections}
        to opt-in to using this data structure. This representation is more beneficial to use when heavily using the
        `next*` and `prev*` methods.
        
        Outer map:
        Key - vertex string id
        Value - mapping of ports to vertices, i.e. "Inner map"
        
        Inner map:
        Key - port string name
        Value - [vertex string id for vertices connected to port]
                OR if key is "$self", then the vertex instance corresponding to the outer map key
        
        Example:
        ```
        const1 -----\            /---- action2
                     action1 ----
        const2 -----/            \---- action3
        ```
        The `vertexConnections` map would look like:
        ```
        {
          "const1": {
            "$self": < Workflow.Const, id="const1" >,
            "output": ["action1"]
          },
          "const2": {
            "$self": < Workflow.Const, id="const2" >,
            "output": ["action1"]
          },
          "action1": {
            "$self": < Workflow.Action, id="action1" >,
            "inputA": ["const1"],
            "inputB": ["const2"],
            "output": ["action2", "action3"]
          },
          "action2": {
            "$self": < Workflow.Action, id="action2" >,
            "input": ["action1"]
          },
          "action3": {
            "$self": < Workflow.Action, id="action3" >,
            "input": ["action1"]
          },
        }
        ```
