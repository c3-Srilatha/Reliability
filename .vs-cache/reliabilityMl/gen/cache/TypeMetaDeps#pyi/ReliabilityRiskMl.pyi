            ```
            [1]: from tensorflow.keras import Model
                 from tensorflow.keras.layers import Dense
            
                 class MyTensorFlowModel(Model)
                   def __init__(self, hidden_dim, num_classes):
                     self.hidden_layer = Dense(hidden_dim)
