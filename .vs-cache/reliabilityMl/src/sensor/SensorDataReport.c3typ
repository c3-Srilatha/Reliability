/**
 * Sensor Data report has calculated values in a specific time window.
 */

entity type SensorDataReport mixes SensorDataReportBase schema name "SNSR_DT_RPRT" {

  /**
   * Result of the calculation of the sensor data variance in a window given by #start and #end.
   * (See AggOp#VARIANCE)
   */
  variance: double

  /**
   * Start date selected to calculate the sensor data report.
   */
  start: !datetime
  /**
   * End date selected to calculate the sensor data report.
   */
  end: !datetime
  /**
   * {@link Interval} selected to calculate the sensor data report.
   */
  interval: Interval
  /**
   * Percentage of Flatline in a {@link Timeseries}.
   * Field calculated by a Standard deviation in a window. When the result is equial to zero indicates that there is a flatline.
   * Then it calculates the AVG of flatlines to get the percentate"
   * flatlineRatio is a value between 0 and 100
   */
  flatlineRatio: !int
  /**
   * Percentate of missing data in a {@link Timeseries}.
   * missingDataRatio is a value between 0 and 100
   */
  missingDataRatio: !int

  /**
   * {@link ReliabilityAsset} name purely used for display purposes. Denotes the participating asset from a {@link ReliabilityAssetSensorRelation} during the creation of this report.
   */
  assetName: string

  /**
   * Represents whether the {@link SensorDataReport} is user added.
   * It's `true`, if the current SensorDataReport was generated for a sensor not related via {@link ReliabilityAssetSensorRelation}s to the current asset.
   * It's `false`, if the current SensorDataReport was generated for a sensor related via {@link ReliabilityAssetSensorRelation}s to the current asset.
   */
  userAdded: ?boolean = false

  /**
   * Wrapper method for fetching {@link SensorDataReport} objects.
   *
   * The returned objects use the #sensor ID as their identifier, instead of the {@link SensorDataReport#id}.
   *
   * **Usage Context**:
   * This method is specifically intended for use in the Dataset Detail page, particularly in cases where
   * {@link FeatureDataReport}s are not available.
   * The reason for assigning the #sensor ID as the object ID is to enable sensors selection and creation of new datasets
   * directly from the "Selected Sensors" grid.
   * This simplifies row tracking and interaction in the UI.
   *
   * **Important**:
   * This is a specialized utility and is not designed for general-purpose use.
   * It reduces frontend overhead for this specific workflow and **should not be used elsewhere**.
   *
   * @param spec - The specification for fetching the data.
   * @param datasetId - The ID of the dataset for which the sensor data reports are being fetched.
   * @returns A {@link FetchResult} containing a list of {@link SensorDataReport} objects.
   */
  @action(group='read')
  fetchForDatasetDetail: function (
    /**
    * The specification for fetching the data
    */
    spec: !FetchSpec,
    /**
    * The ID of the dataset for which the sensor data reports are being fetched
    */
    datasetId: !string serialized ReliabilityMlDatasetPreparationRun
  ): !FetchResultWithTotalCount<SensorDataReport> js-rhino
}
