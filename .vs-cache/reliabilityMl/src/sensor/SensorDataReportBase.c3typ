/**
 * Base type that contains fields shared between {@link SensorDataReport} and {@link FeatureDataReport}.
 */
abstract type SensorDataReportBase {
  /**
   * The feature name that can be used to get the {@link #sensor} data
   */
  featureName: !string
  /**
   * Sensor that is the source of data for the data report.
   */
  sensor: !Sensor
  /**
   * Latest value in the window {@link SensorDataReport#start} to {@link SensorDataReport#end}
   */
  latestValue: !double
}
