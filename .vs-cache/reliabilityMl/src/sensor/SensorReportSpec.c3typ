/**
 * Arguments for the method {@link ReliabilityAsset#generateSensorDataReport}
 */
type SensorReportSpec {

  /**
   * Start {@link DateTime} selected to calculate the sensor data report.
   */
  start: !datetime

  /**
   * End {@link DateTime} selected to calculate the sensor data report.
   */
  end: !datetime

  /**
   * Interval to generate the {@link SensorDataReport}.
   */
  interval: string enum Interval = Interval.QUARTER_HOUR

  /**
   * If true, ignores existing {@link SensorDataReport}s and generates new reports.
   * If false, existing {@link SensorDataReport}s are considered during report generation.
   */
  forceRefresh: boolean

  /**
   * Array of {@link ReliabilityAssetSensorRelation} ID's
   */
  additionalRasrIds: [string]
}
