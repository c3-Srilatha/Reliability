/**
 * The metrics that each {@link FeatureDataReport} stores about the dataset.
 */
type FeatureDataReportMetrics {
  /**
   * The variance of the feature data.
   */
  variance: double
  /**
    * The median of the feature data.
    */
  median: double
  /**
    * The maximum value of the feature data.
    */
  maximum: double
  /**
    * The minimum value of the feature data.
    */
  minimum: double
  /**
   * The percentage of missing data for the feature.
   */
  missingDataPercentage: double
  /**
   * The percentage of flatline for the feature.
   * Calculated based on {@link ReliabilityMlFeaturePreparationSpec#flatliningTimeSteps} of the {@link FeatureDataReport#dataset}
   */
  flatlinePercentage: double
}
