/**
 * Contains metrics about a particular feature in a specific dataset, split across training and validation periods.
 */
type FeatureDataReport mixes SensorDataReportBase, WithId {

  /**
   * When returned by {@link ReliabilityMlDatasetPreparationRun#fetchFeatureDataReport},
   * this is set to the `sensor.id`. Otherwise, it is unset.
   */
  id: ~
  /**
   * The dataset for which this report was created.
   */
  dataset: !ReliabilityMlDatasetPreparationRun

  /**
   * Metrics for the training period of the {@link #dataset}
   */
  trainingMetrics: !FeatureDataReportMetrics
  /**
   * Metrics for the validation period of the {@link #dataset}
   */
  validationMetrics: !FeatureDataReportMetrics
}
