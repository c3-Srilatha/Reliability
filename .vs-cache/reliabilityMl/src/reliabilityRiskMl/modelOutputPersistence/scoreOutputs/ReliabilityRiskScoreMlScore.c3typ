/**
 * Represents the risk score for a given asset, repressenting the likehood of failure or experiencing an event.
 */
@db(datastore='cassandra',
    partitionKeyField='parent',
    persistenceOrder='start',
    persistDuplicates=false,
    compactType=true,
    shortIdReservationRange=100000,
    columnarStorage=false)
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskScoreMlScore mixes TimedDataPoint<ReliabilityRiskScoreMlScoreHeader> schema name 'MLMDLSC' {
  /**
   * The score value generated by the reliability risk model for a particular data point.
   * This field stores the actual score indicating the level of reliability or risk.
   */
  @ts(treatmentPath="parent.treatment")
  score: !double
}
