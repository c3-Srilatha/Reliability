/**
 * This type is used to keep track of the prediction timeseries made by a
 * [model](ReliabilityAssetToRiskModelValidationRelation#to) for model validation.
 */
@db(index=['parent'])
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskScoreMlValidationPredictionHeader mixes TimedDataHeader<ReliabilityRiskScoreMlValidationPrediction> schema name 'REL_RSMVPH' {

  /**
   * The reference to the parent relation that generated this prediction timeseries.
   */
  parent: !ReliabilityAssetToRiskModelValidationRelation

  /**
   * The treatment to use for the timeseries.
   */
  treatment: string enum AggOp = AggOp.AVG

  /**
   * The unit to use for the timeseries.
   */
  unitConstraint: Unit

  /**
   * {@link TimedDataFields#timeZone} gets overridden by this field. If not set, the default value is 'UTC'.
   *
   * The timezone to use for the timeseries.
   */
  timeZone: string = 'UTC'
}
