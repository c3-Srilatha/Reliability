/**
 * Represents a machine learning model contribution score used in the context of reliability risk assessments.
 * This entity captures the contribution of various factors or variables to the overall risk score prediction,
 * with upper and lower bounds indicating the range of uncertainty for each contribution.
 *
 * The `ReliabilityRiskScoreMlContribution` entity is specifically designed for capturing the contributions
 * made by individual features or components to the overall risk score in a machine learning model, with the
 * ability to track how the contribution evolves over time.
 *
 * This entity is valuable for analyzing the relative importance of different model features, assessing
 * model predictions, and ensuring that risk assessments are accurate and actionable.
 *
 * For more details on each field and its usage, refer to the documentation below.
 */
@db(datastore='cassandra',
    partitionKeyField='parent',
    persistenceOrder='start',
    persistDuplicates=false,
    compactType=true,
    shortIdReservationRange=100000,
    columnarStorage=false)
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskScoreMlContribution mixes TimedDataPoint<ReliabilityRiskScoreMlContributionHeader> schema name 'MD' {

  /**
   * Represents the contribution value of the model's prediction, typically a numerical value
   * indicating the influence of a particular feature or variable in the model's output.
   * The value of the contribution is essential for understanding how different factors
   * influence the overall risk score or prediction. This field provides a way to track
   * the impact of specific components on the model's results.
   * ts(treatmentPath='parent.treatment') specifies the treatment path for any necessary transformations or
   * adjustments to the contribution value, ensuring that any changes to the parent entity’s state are reflected here.
   */
  @ts(treatmentPath='parent.treatment')
  contribution: !double

  /**
   * The upper bound for the contribution score. This defines the maximum possible value
   * for the contribution and represents the highest level of influence or risk that a factor
   * can have according to the model.
   *
   * This field helps to identify the upper limit of the contribution for specific variables, providing
   * a safety threshold or margin of uncertainty in the prediction.
   */
  contributionUpperBound: double

  /**
   * The lower bound for the contribution score. This defines the minimum possible value
   * for the contribution and indicates the least amount of impact or risk that the factor can have
   * on the model's prediction.
   *
   * This lower bound can be used for validation, ensuring that the contribution does not fall below
   * a certain threshold, providing greater confidence in the stability of the risk score model.
   */
  contributionLowerBound: double
}
