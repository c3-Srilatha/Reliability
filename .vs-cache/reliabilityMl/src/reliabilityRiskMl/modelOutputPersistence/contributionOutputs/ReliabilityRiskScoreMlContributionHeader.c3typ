/**
 * A series keeping track of the "time series" contributions made for a {@link MlSubject} by a {@link MlModel}
 * for given feature name.
 * ## Description
 * It is recording contributions made by {@link MlModel} for a {@link MlSubject}.
 * Id of the series is generated automatically by `#setId` and will override any pre-existing when persisted to
 * database by {@link #beforeCreate}.
 */
@db(index=['parent'])
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskScoreMlContributionHeader mixes TimedDataHeader<ReliabilityRiskScoreMlContribution> schema name 'REL_RSMCH' {

  /**
   * The subject-model association related to this series header.
   */
  parent: !ReliabilityAssetToRiskModelRelation

  /**
   * The treatment to use for the timeseries.
   */
  treatment: string enum AggOp = AggOp.PREVIOUS

  /**
   * {@link TimedDataFields#timeZone} gets overridden by this field. If not set, the default value is 'UTC'.
   *
   * The timezone to use for the timeseries.
   */
  timeZone: string = 'UTC'
}
