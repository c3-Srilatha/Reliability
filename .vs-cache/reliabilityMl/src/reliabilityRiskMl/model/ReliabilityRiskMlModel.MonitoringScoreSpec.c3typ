/**
 * This spec is used to configure how to monitor a given {@link ReliabilityRiskMlModel}.
 */
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
type ReliabilityRiskMlModel.MonitoringScoreSpec mixes ReliabilityRiskMlModel.ClassificationScoreSpec {

  /**
   * Number of days between the start of monitoring time range and today.
   */
  lookbackDaysStart: !int

  /**
   * Number of days between the end of monitoring time range and today. The value should be smaller than {@link #lookbackDaysStart}.
   */
  lookbackDaysEnd: !int
}
