/**
 * This spec is used to pass in a new {@link MlPipe} that should be used to clone a given {@link MlPipeline}.
 */
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
type ReliabilityRiskMlModelCloningPipe mixes Spec {

  /**
   * The name of the pipe field in the  {@link MlPipeline} that should be updated. For example, `reconstructionPipe`,
   * `riskScoreNormalizationPipe`, `alertingPipe`.
   */
  name: !string

  /**
   * The {@link MlPipe} that should be used to clone an existing {@link ReliabilityRiskMl.Pipeline}
   */
  pipe: !MlPipe
}
