/**
 * This type represents an {@link MlPipe} template that calculates an alert based on a dataset of risk scores.
 * The pipe identifies if the risk score has crossed a threshold for a specified duration and raises an alert accordingly.
 *
 * The pipe allows configuration of various parameters to fine-tune the alerting mechanism based on risk scores,
 * such as percentile thresholds, duration above threshold, reminder span to avoid repeated alerts, and merge span
 * for distinguishing separate high-risk events. The final alert is determined by a combination of these factors,
 * making this a powerful tool for detecting prolonged high-risk events and avoiding alert fatigue.
 *
 * This alerting system is useful in monitoring systems where continuous and extended high-risk scores (e.g., for
 * security, fraud detection, or reliability) require immediate action, but repetitive alerts should be avoided.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.Alerting.PercentileDurationPipe extends ReliabilityRiskMl.Alerting.Pipe<{trainingFeatures: Data, inferenceFeatures: Data, scaledTrainingFeatures: Data, scaledInferenceFeatures: Data, residuals: Data, scaledResiduals: Data, reconstructions: Data, scaledReconstructions: Data, riskScore: Data, riskScoreNormalized: Data, alertContext: Data}, {alert: Data}> type key 'PDP' {

  /**
   * The name of the column in the input data that holds the risk score values. This field allows flexibility to
   * specify a custom name for the risk score column in the input dataset.
   * Default is 'riskScore'.
   */
  riskScoreColumnName: !string = 'riskScore'

  /**
   * A parameter to compute the percentile of the risk scores that will be used as an alert threshold. This is
   * useful when you want to trigger an alert when the risk score exceeds a certain percentile.
   * The percentile value must be between 0 and 100. If the `alertThreshold` is set, this will be overridden by it.
   */
  @ML(hyperparameter=true)
  alertPercentile: double = 99

  /**
   * The risk score threshold above which a risk score is considered "high" and could raise an alert.
   * If this threshold is set, it will override the `alertPercentile` calculation.
   */
  @ML(hyperparameter=true)
  @inferenceTypeDoc(isInferenceOnly=true)
  alertThreshold: double

  /**
   * The duration, in seconds, that the `riskScore` should continuously stay above the `alertThreshold` before
   * being considered as a candidate for raising an alert. This helps prevent triggering alerts based on transient spikes.
   */
  @ML(hyperparameter=true)
  @inferenceTypeDoc(isInferenceOnly=true)
  ignoreSpan: int = 14400

  /**
   * The reminder span, in seconds, specifies the period during which no new alert will be raised if an alert
   * has already been triggered. This prevents multiple alerts for the same event and is useful for avoiding
   * excessive alerts within a short period.
   */
  @ML(hyperparameter=true)
  @inferenceTypeDoc(isInferenceOnly=true)
  reminderSpan: int = 604800

  /**
   * The merge span, in seconds, is used to distinguish between two separate alert candidates. If two candidate
   * alerts occur more than `mergeSpan` seconds apart and in different high-risk periods, both will be raised.
   * This is useful for detecting multiple independent events, even if they occur within the `reminderSpan`.
   * The `mergeSpan` must be smaller than or equal to the `reminderSpan`.
   */
  @ML(hyperparameter=true)
  @inferenceTypeDoc(isInferenceOnly=true)
  mergeSpan: int = 86400

  /**
   * The minimum time interval, in seconds, that was inferred from the data the alerting pipe was trained on.
   * For example, if the pipe was trained on hourly data, this value should be 3600 (1 hour).
   * This interval helps determine how frequently the risk score data should be processed.
   */
  interval: private int

  /**
   * A boolean flag to specify whether the `mergeSpan` should be applied to the actual alert or to the alert candidate.
   * The default is false, meaning the merge span is applied to the alert candidates. When this field is set to false,
   * the `reminderSpan` will be ignored.
   */
  mergeOnActualAlert: private boolean = false

  /**
   * The `doTrain` function is responsible for training the alerting model using the provided training data.
   * This function is called during the training phase of the pipeline.
   */
  doTrain: ~ py-data

  /**
   * The `afterTrain` function is called after the training phase is completed.
   * It performs any post-training tasks such as storing results or preparing the model for inference.
   */
  afterTrain: ~ py

  /**
   * A flag that indicates whether the pipe is trainable. If true, it means that the model can be trained.
   */
  isTrainable: ~ py

  /**
   * The `isTrained` function checks if the pipe has been successfully trained based on the specified `alertThreshold`
   * and `interval` values. If both are set, it indicates that the pipe has undergone the training process.
   */
  isTrained: ~ py

  /**
   * The `doProcess` function is used to process the input data during inference. It checks the risk score values
   * and raises alerts based on the specified thresholds and conditions.
   */
  doProcess: ~ py-data

  /**
   * The `beforeCreate` function is called before the creation of the alerting entity. It can be used for
   * initialization or validation tasks.
   */
  beforeCreate: ~ py
}
