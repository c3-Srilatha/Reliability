/**
 * This type represents an {@link MlPipe} template for a data operation that scales and transforms features using a
 * Generalized Quantile Transformation (GQT) in a pipeline. The operation learns quantiles from the input features
 * during training and applies the learned transformation to both training and inference data.
 * This technique is useful for normalizing or transforming non-uniformly distributed data.
 *
 * The Generalized Quantile Transformation allows for transforming the input data to a more uniform or normal
 * distribution by discretizing the cumulative distribution function (CDF) and scaling the data accordingly.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.RiskScoreScaling.GeneralQuantileTransformerPipe extends ReliabilityRiskMl.RiskScoreScaling.Pipe<{features: Data, riskScore: Data, alertContext: Data}, {riskScoreNormalized: Data}> type key 'GQTP' {

  /**
   * The number of quantiles to compute during the transformation process.
   * This value corresponds to the number of discrete bins (or landmarks) used to discretize the cumulative distribution
   * function (CDF) of the input data. A higher value results in more granular transformation, while a lower value leads
   * to coarser discretization.
   */
  nQuantiles: int = 100

  /**
   * This function generates the quantile transformation pipeline using `py-sklearn`.
   * It sets up the necessary steps for applying the Generalized Quantile Transformation (GQT) to the input data.
   * The pipeline will be configured to discretize the cumulative distribution function (CDF) and scale the features
   * to follow the desired distribution.
   *
   * This method is typically called during the pipeline creation to set up the transformation procedure.
   */
  generatePipe: ~ py-sklearn

  /**
   * This method invokes the `fit()` function on the native model.
   * The `fit()` method learns the quantiles from the input data, essentially learning the distribution of the features
   * and determining how to transform the data. This transformation process prepares the model to apply the learned
   * transformation to both training and inference data.
   *
   * It should be called during the training phase to fit the model to the input data and learn the appropriate
   * transformation parameters.
   */
  doTrain: ~ py-sklearn

  /**
   * This method invokes the `transform()` function on the native model.
   * The `transform()` function applies the learned quantile transformation to the input features, using the quantiles
   * learned during training. This allows the model to apply the same transformation to both training data and new,
   * unseen data.
   *
   * It should be called when processing new or unseen data after the model has been trained.
   */
  doProcess: ~ py-sklearn
}
