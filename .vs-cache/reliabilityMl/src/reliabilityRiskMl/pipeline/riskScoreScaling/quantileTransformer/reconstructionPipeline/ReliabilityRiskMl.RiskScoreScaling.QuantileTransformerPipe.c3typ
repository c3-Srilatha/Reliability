/**
 * This type represents an {@link MlPipe} template that performs quantile-based transformation for risk scores.
 * It uses the QuantileTransformer from Scikit-learn to scale risk scores by transforming them into a uniform distribution
 * based on specified quantiles. The transformation is based on a dataset of features during training and is used to scale
 * new inference data in a consistent manner.
 *
 * The transformation process maps data into specified quantiles and applies the corresponding scaling during training and
 * inference. This technique is particularly useful in normalizing risk scores, making them easier to interpret and more
 * consistent for downstream modeling or decision-making processes.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.RiskScoreScaling.QuantileTransformerPipe extends ReliabilityRiskMl.RiskScoreScaling.Pipe<{trainingFeatures: Data, inferenceFeatures: Data, scaledTrainingFeatures: Data, scaledInferenceFeatures: Data, residuals: Data, scaledResiduals: Data, reconstructions: Data, scaledReconstructions: Data, riskScore: Data, alertContext: Data}, {riskScoreNormalized: Data}> type key 'QTP' {

  /**
   * The number of quantiles to be computed. This corresponds to the number of landmarks used to discretize the cumulative
   * distribution function (CDF) of the data. Increasing this number provides a finer resolution of the distribution, which
   * can lead to better scaling for datasets with a large variance.
   *
   * Default value: 100. This parameter can be adjusted during training to match the desired distribution precision.
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  nQuantiles: int = 100

  /**
   * This function generates the pipe that applies the quantile transformation. It uses the Scikit-learn implementation of
   * `QuantileTransformer` to process the training and inference data. The pipe ensures that risk scores are scaled according
   * to the quantiles specified by the `nQuantiles` parameter.
   */
  generatePipe: ~ py-sklearn

  /**
   * This method will invoke the `fit()` method on the native QuantileTransformer model. The `fit()` method computes the
   * transformation parameters (i.e., quantiles) from the training data, which are then applied to scale the data.
   *
   * After fitting, the transformer is ready to be applied to new (inference) data.
   */
  doTrain: ~ py-sklearn

  /**
   * This method will invoke the `transform()` method on the native QuantileTransformer model. The `transform()` method
   * applies the quantile-based scaling to the inference data using the parameters computed during the `fit()` step.
   *
   * The transformation scales the risk score data into a normalized range according to the learned quantiles, making it
   * suitable for further use in modeling or alert generation.
   */
  doProcess: ~ py-sklearn
}
