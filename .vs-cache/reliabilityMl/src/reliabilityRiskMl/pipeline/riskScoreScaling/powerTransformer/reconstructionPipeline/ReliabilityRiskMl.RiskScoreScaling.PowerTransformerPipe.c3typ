/**
 * This type defines a `PowerTransformerPipe` that applies a power transformation to input data to make it more
 * Gaussian-like, particularly useful for data that is not normally distributed. The transformation can either
 * use the 'yeo-johnson' or 'box-cox' method depending on the nature of the data.
 *
 * The `PowerTransformerPipe` is typically used in machine learning workflows to preprocess data by normalizing
 * features and transforming them to a more suitable range for certain algorithms that assume Gaussian-like data.
 * It also offers the ability to standardize the transformed data by applying zero-mean, unit-variance normalization.
 */

@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.RiskScoreScaling.PowerTransformerPipe extends ReliabilityRiskMl.RiskScoreScaling.Pipe<{trainingFeatures: Data, inferenceFeatures: Data, scaledTrainingFeatures: Data, scaledInferenceFeatures: Data, residuals: Data, scaledResiduals: Data, reconstructions: Data, scaledReconstructions: Data, riskScore: Data, alertContext: Data}, {riskScoreNormalized: Data}> type key 'PTP' {

  /**
   * The power transform method to be used for data transformation. The available methods are:
   * - 'yeo-johnson': Works with both positive and negative values.
   * - 'box-cox': Works only with strictly positive values.
   *
   * This hyperparameter controls which transformation is applied to the data during training and inference.
   *
   * default 'yeo-johnson'
   *
   * For example: 'yeo-johnson' - Suitable when the data contains both positive and negative values.
   * For example: 'box-cox' - Only applicable when all values in the data are strictly positive.
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  method: string enum('box-cox', 'yeo-johnson') = 'yeo-johnson'

  /**
   * A boolean flag that, when set to `true`, applies zero-mean, unit-variance normalization to the transformed data.
   * This standardization ensures that the output features have a mean of 0 and a variance of 1, which can help improve
   * the performance of certain machine learning algorithms that assume data is centered and normalized.
   *
   * default true
   *
   * For example: true - Applies standardization after the transformation.
   * For example: false - Does not apply any standardization after the transformation.
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  standardize: boolean = true

  /**
   * This method generates the necessary pipe for performing the power transformation using `py-sklearn`.
   * It sets up the appropriate transformation steps, which can either be 'yeo-johnson' or 'box-cox' as determined by
   * the {@link method} field.
   *
   * The `generatePipe` function is typically called during the pipeline creation phase to initialize the transformation
   * procedure.
   */
  generatePipe: ~ py-sklearn

  /**
   * This method calls the `fit()` function of the Power Transformer model, which learns the transformation parameters
   * (such as the optimal scaling for each feature) from the training data.
   * The `doTrain` function should be invoked when the model is being trained to learn the necessary transformation
   * to apply to the data.
   */
  doTrain: ~ py-sklearn

  /**
   * This method invokes the `transform()` function of the Power Transformer model, which applies the learned transformation
   * to both the training and inference data. This function adjusts the data to make it more Gaussian-like, based on the
   * learned transformation parameters.
   *
   * The `doProcess` function should be called when the model is being used to process new data (e.g., during inference).
   */
  doProcess: ~ py-sklearn
}
