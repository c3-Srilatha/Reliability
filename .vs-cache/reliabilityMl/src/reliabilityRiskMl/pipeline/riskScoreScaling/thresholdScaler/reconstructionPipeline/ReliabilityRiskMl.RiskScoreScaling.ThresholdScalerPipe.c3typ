/**
 * This is an implementation of {@link ReliabilityRiskMl.RiskScoreScaling.Pipe} for the
 * {@link ReliabilityRiskMl.ReconstructionPipeline#riskScoreNormalizationPipe} that normalizes risk scores based on how
 * close they are to the provided {@link #alertThreshold}. The normalized risk score is capped at 1.0.
 *
 * When using this pipe in conjunction with the {@link ReliabilityRiskMl.Alerting.PercentileDurationPipe}, the provided
 * {@link #alertThreshold} or {@link alertPercentile} must be the same as the {@link ReliabilityRiskMl.Alerting.PercentileDurationPipe}.
 *
 * riskScoreNormalized = min(1.0, riskScore / alertThreshold)
 *
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.RiskScoreScaling.ThresholdScalerPipe extends ReliabilityRiskMl.RiskScoreScaling.Pipe<{trainingFeatures: Data, inferenceFeatures: Data, scaledTrainingFeatures: Data, scaledInferenceFeatures: Data, residuals: Data, scaledResiduals: Data, reconstructions: Data, scaledReconstructions: Data, riskScore: Data, alertContext: Data}, {riskScoreNormalized: Data}> type key 'TSP' {

  /**
   * Parameter to compute risk scores percentile that will be used as alert threshold.
   * The computed alert threshold is stored on the field alertThreshold.
   * alertPercentile must be between [0, 100]. If alertThreshold is set, overrides alertPercentile.
   * This must be the same as {@link ReliabilityRiskMl.Alerting.PercentileDurationPipe#alertPercentile}
   */
  @ML(hyperparameter=true)
  alertPercentile: double = 99

  /**
   * Risk score threshold above which a risk score is considered "high" and could raise an alert.
   * If alertThreshold is set, overrides alertPercentile. The provided alertThreshold must be greater than 0.0.
   * This must be the same as {@link ReliabilityRiskMl.Alerting.PercentileDurationPipe#alertThreshold}
   */
  @ML(hyperparameter=true)
  @inferenceTypeDoc(isInferenceOnly=true)
  alertThreshold: double

  generatePipe: ~ py

  beforeCreate: ~ py

  doTrain: ~ py-data

  afterTrain: ~ py

  isTrainable: ~ py

  isTrained: ~ py

  doProcess: ~ py-data
}
