/**
 * Data generator used to create synthetic data for testing and training purposes.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
type ReliabilityRiskMl.Reconstruction.DataGenerator {

  /**
   * Generates indices for the given data, used to create windows of data for time-series models.
   * This function is typically used to create subsets of data that represent a fixed-size window
   * over the time series.
   *
   * @param x The input data (usually a time-series or sequential data).
   * @param windowSize The size of the window to be created for each batch of data.
   * @returns A native TensorFlow object representing the generated indices for batching.
   */
  generateIndices: inline function(x: native, windowSize: int): native py-tf

  /**
   * Initializes batches of data for training. This function slices the input data into smaller
   * windows or batches, which are used in iterative training of machine learning models.
   *
   * @param x The input data (e.g., time-series data).
   * @param batchSize The size of each batch to be processed during training.
   * @param windowSize The window size for each data slice.
   * @returns A native TensorFlow object representing the batched data ready for training.
   */
  initializeBatches: inline function(x: native, batchSize: int, windowSize: int): native py-tf

  /**
   * Creates a data generator that can be used in machine learning workflows to produce batches
   * of data for training over multiple epochs. This function encapsulates the logic for generating
   * windows of data and batching them according to the specified parameters.
   *
   * @param x The input data that will be used to generate batches.
   * @param epochs The number of epochs for which the data generator will run.
   * @param batchSize The size of the batches to be generated.
   * @param windowSize The size of the window for each batch.
   * @returns A native TensorFlow object representing the generator that produces batches of data.
   */
  makeGenerator: inline function(x: native, epochs: int, batchSize: int, windowSize: int): native py-tf
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
