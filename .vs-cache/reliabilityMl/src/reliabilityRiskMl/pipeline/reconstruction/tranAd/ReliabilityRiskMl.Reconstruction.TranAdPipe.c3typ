/**
 * This type represents an {@link MlPipe} template for a PyTorch-based transformer model.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.Reconstruction.TranAdPipe extends MlTemplate.AtomicPipe<Data, void, {reconstructions: Data, residuals: Data}> mixes ReliabilityMlDatasetPreparationRunResolvable type key 'TRADP' {

  /**
   * The lookback duration of this pipe. Used for internal data handling in the model
   * deployment framework.
   */
  lookbackDuration: private Duration

  /**
   * Training epochs
   */
  @ML(hyperparameter=true)
  epochs: !int = 10

  /**
   * Training batch size
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  batchSize: !int = 128

  /**
   * Number of features
   */
  @ML(hyperparameter=true)
  numFeatures: !int = 5

  /**
   * Size of time window in the input of the autoencoder.
   */
  @ML(hyperparameter=true)
  windowSize: !int = 6

  /**
   * Learning rate used to override the learning rate specified in the `optimizer` during training.
   * Will use optimizer's learning rate if `learningRateOverride` is unspecified.
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  learningRateOverride: float

  /**
   * Random seed used during model training. Use the same number for reproducible training results.
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  randomSeed: int = 0

  // py-huggingface-server-py4j
  generatePipe: ~ py-huggingface

  doTrain: ~ py-huggingface

  doProcess: ~ py-huggingface

  saveModel: ~ py-huggingface

  loadModel: ~ py-huggingface

  resolveForDatasetPreparationRun: ~ py
}
