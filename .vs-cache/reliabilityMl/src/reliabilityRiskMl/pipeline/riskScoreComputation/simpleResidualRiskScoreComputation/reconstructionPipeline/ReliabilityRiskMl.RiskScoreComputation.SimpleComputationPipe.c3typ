/**
 * This type represents an {@link MlPipe} template which outputs a `riskScore` based on a dataset of residuals as input.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.RiskScoreComputation.SimpleComputationPipe extends ReliabilityRiskMl.RiskScoreComputation.Pipe<{trainingFeatures: Data, inferenceFeatures: Data, scaledTrainingFeatures: Data, scaledInferenceFeatures: Data, residuals: Data, scaledResiduals: Data, reconstructions: Data, scaledReconstructions: Data, alertContext: Data}, {riskScore: Data}> type key 'SCP' {

  /**
   * `numpy` function to aggregate residual inputs.
   */
  @ML(hyperparameter=true)
  aggFunc: !string enum('mean', 'min', 'max', 'median') = 'mean'

  doProcess: ~ py-data
}
