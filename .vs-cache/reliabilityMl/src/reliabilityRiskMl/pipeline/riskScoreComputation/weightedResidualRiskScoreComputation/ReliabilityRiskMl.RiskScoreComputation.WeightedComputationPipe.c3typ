/**
 * This type represents an {@link MlPipe} template that outputs a `riskScore` that is a weighted average of the
 * input residuals.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.RiskScoreComputation.WeightedComputationPipe extends ReliabilityRiskMl.RiskScoreComputation.Pipe<{trainingFeatures: Data, inferenceFeatures: Data, scaledTrainingFeatures: Data, scaledInferenceFeatures: Data, residuals: Data, scaledResiduals: Data, reconstructions: Data, scaledReconstructions: Data, alertContext: Data}, {riskScore: Data}> type key 'WCP' {

  /**
   * A map of input column name to the weight to be applied to the absolute value in that column. All weights must be
   * positive and the default is 1. If a weight is negative, it will be automatically replaced with 1.
   * Note that when using the default reconstruction pipelines, the column names of the reconstruction pipe output
   * will have the template: `<NameOfFeature_ResidualSuffixFromConfig>`. The `ResidualSuffixFromConfig` refers to
   * {@link ReliabilityMLOutputConfig#residualColumnNameSuffix}.
   * As an example, if there is a feature that is reconstructed, with the name `INLET_PRESSURE` and the
   * {@link ReliabilityMLOutputConfig#residualColumnNameSuffix} is set to `_residual`, then this map object for
   * the weights will look like:
   * ```
   * {'INLET_PRESSURE_residual': 1.5}
   * ```
   */
  @ML(containsHyperparams=true)
  @inferenceTypeDoc(isInferenceOnly=true)
  weights: map<string, double>

  beforeCreate: ~ py

  doProcess: ~ py-data

  resolveForDatasetPreparationRun: ~ py
}
