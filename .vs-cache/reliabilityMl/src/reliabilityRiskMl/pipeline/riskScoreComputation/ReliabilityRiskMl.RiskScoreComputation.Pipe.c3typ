/**
 * This type represents an abstract {@link MlPipe} template for risk score computation pipes.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
abstract extendable entity type ReliabilityRiskMl.RiskScoreComputation.Pipe<DX, DO> extends MlTemplate.AtomicPipe<DX, void, DO> mixes ReliabilityMlDatasetPreparationRunResolvable type key 'RELRSCP'{

  /**
   * If set, then this pipe can be trained and must implement `doTrain`. Otherwise, this pipe will be treated as
   * process-only.
   */
  isTrainableOverride: boolean

  /**
   * Return the output name for risk scores according to the {@link ReliabilityMLOutputConfig}
   */
  outputName: private function(): string py

  /**
   * The lookback duration of this pipe. Used for internal data handling in the model
   * deployment framework.
   */
  lookbackDuration: private Duration

  generatePipe: ~ py

  generateTypeBindings: ~ py

  isTrainable: ~ py

  isTrained: ~ py
}
