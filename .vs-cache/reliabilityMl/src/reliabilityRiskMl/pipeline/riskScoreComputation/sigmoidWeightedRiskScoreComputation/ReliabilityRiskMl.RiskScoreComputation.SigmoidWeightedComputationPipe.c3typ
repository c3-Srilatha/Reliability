/**
 * This type represents an {@link MlPipe} template which outputs a `riskScore` that weigths the input residuals
 * using a sigmoid evaluation of the corresponding sensor values in addition to the directional weights.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.RiskScoreComputation.SigmoidWeightedComputationPipe extends ReliabilityRiskMl.RiskScoreComputation.Pipe<{trainingFeatures: Data, inferenceFeatures: Data, scaledTrainingFeatures: Data, scaledInferenceFeatures: Data, residuals: Data, scaledResiduals: Data, reconstructions: Data, scaledReconstructions: Data, alertContext: Data}, {riskScore: Data}> type key 'SWCP' {

  /**
   * A map of column name to a pair of weights to be applied to values in that column. The first weight in the pair will
   * be applied to the positive residuals, and the second will be applied to the negative residuals.
   * Note that when using the default reconstruction pipelines, the column names of the reconstruction pipe output
   * will have the template: `<NameOfFeature_ResidualSuffixFromConfig>`. The `ResidualSuffixFromConfig` refers to
   * {@link ReliabilityMLOutputConfig#residualColumnNameSuffix}.
   * As an example, if there is a feature that is reconstructed, with the name `INLET_PRESSURE` and the
   * {@link ReliabilityMLOutputConfig#residualColumnNameSuffix} is set to `_residual`, then this map object for
   * directional weights will look like:
   * ```py
   * {'INLET_PRESSURE_residual': c3.DoublePair(fst=0, snd=1)}
   * ```
   */
  @ML(hyperparameter=true)
  @inferenceTypeDoc(isInferenceOnly=true)
  directionalWeights: map<string, Pair<double, double>>

  /**
   * In addition to the directional weights applied to the residuals, the sensor values may also be used to influence
   * the risk score computation through a sigmoid evaluation of their values. The sigmoid value for each sensor is
   * calculated as:
   * ```
   * sigmoid_value = 1 / (1 + exp(-(x - a)/b))
   * ```
   * This field may be used to define the `a` and `b` parameters to calculate the sigmoid value for each sensor.
   * The string key defines the name of the feature. The value in the map defines the sigmoid parameters for the
   * feature as a `Pair`, where the first value in the pair is `a` and the second value is `b`. As an example:
   * ```py
   * {'INLET_PRESSURE': c3.DoublePair(fst=25, snd=2)}
   * ```
   * Here, `a = 25` and `b = 2`.
   */
  @ML(hyperparameter=true)
  @inferenceTypeDoc(isInferenceOnly=true)
  sigmoidParams: map<string, Pair<double, double>>

  doProcess: ~ py-data

  resolveForDatasetPreparationRun: ~ py-data
}
