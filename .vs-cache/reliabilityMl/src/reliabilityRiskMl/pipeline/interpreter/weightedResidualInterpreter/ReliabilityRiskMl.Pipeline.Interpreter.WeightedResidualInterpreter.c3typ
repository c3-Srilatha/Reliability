/**
 * This type represents an interpreter for computing and explaining weighted residuals within a machine learning pipeline.
 * The `WeightedResidualInterpreter` is used to interpret the residuals of a model, where the residuals are weighted based
 * on a certain criterion or parameter.
 *
 * The interpreter combines the `MlInterpreter` functionality and uses a specialized method for computing and explaining
 * weighted residuals. The weighted residuals provide insights into the model's performance by highlighting areas of error
 * that are most significant based on their assigned weights.
 *
 * This feature is in beta and may be subject to change.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.Pipeline.Interpreter.WeightedResidualInterpreter<DX, DO> mixes MlInterpreter<DX, DO> type key 'WRI' {

  /**
   * The explainer for the weighted residuals, providing a textual or visual explanation of how the weighted residuals
   * are computed and interpreted. This can help users understand why certain residuals are weighted more heavily than others.
   */
  explainer: ~ = 'WeightedResidual'

  /**
   * The function to create an explainer for the weighted residuals. This function generates a detailed explanation
   * based on the specific data and model used.
   *
   * For example:
   * The `makeExplainer` function is typically invoked to generate a customized explanation of the residuals.
   * The explanation could include visualizations, statistical measures, or descriptive analytics.
   */
  makeExplainer: ~ py-data

  /**
   * The function responsible for interpreting the weighted residuals based on the provided model and data.
   * This function computes the weighted residuals and provides insights into the model's errors and performance.
   */
  doInterpret: ~ py-data

  /**
   * @inheritdoc
   */
  fromExplainer: abstract ~
}
