/**
 * The `ReliabilityRiskMl.Pipeline.Interpreter.SimpleResidualToolkitInterpreter` is an extendable entity type
 * that extends the `ReliabilityRiskMl.Pipeline.Interpreter.SimpleResidualInterpreter`. It is used to handle
 * the interpretation of the residuals in the context of reliability risk machine learning pipelines. This interpreter
 * processes data and performs necessary transformations to evaluate the residuals generated from a model.
 *
 * The `doInterpret` method is implemented to perform the interpretation task using Python-based data science libraries
 * or models.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.Pipeline.Interpreter.SimpleResidualToolkitInterpreter<DX, DO> extends ReliabilityRiskMl.Pipeline.Interpreter.SimpleResidualInterpreter<DX, DO> type key 'SRTI' {

  /**
   * Method to interpret the residuals. It processes the input data and generates the necessary outputs
   * related to residuals in the context of reliability risk models.
   * The actual implementation relies on Python-based data processing to perform the required interpretation.
   *
   * @returns The result of the interpretation, typically a transformed version of the input data.
   */
  doInterpret: ~ py-data

  /**
   * @inheritdoc
   */
  fromExplainer: abstract ~
}
