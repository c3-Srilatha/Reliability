/**
 * This type represents an {@link MlInterpreter} that computes and interprets residuals with directionality weights.
 * The `DirectionallyWeightedResidualInterpreter` computes the residuals based on directional weighting, which can be
 * useful in situations where the magnitude of the residuals in certain directions needs to be adjusted.
 * This interpreter helps explain the model's predictions in terms of weighted residuals, making it more interpretable.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.Pipeline.Interpreter.DirectionallyWeightedResidualInterpreter<DX, DO> mixes MlInterpreter<DX, DO> type key 'DWRI' {

  /**
   * The explainer type associated with this interpreter. This specifies the method used to explain the residuals
   * based on directional weighting. The value is set to `DirectionallyWeightedResidual` to denote the specific
   * explanation method being applied.
   */
  explainer: ~ = 'DirectionallyWeightedResidual'

  /**
   * A method to create the explainer for the model's residuals.
   * This function sets up the necessary environment and parameters to calculate and interpret the directionally weighted residuals.
   * It may use the `py-data` runtime to implement the logic.
   */
  makeExplainer: ~ py-data

  /**
   * Executes the interpretation of the model's residuals using directional weights.
   * This method applies the logic to interpret how the residuals behave in different directions and helps explain
   * the influence of various input features on the model's output based on residuals.
   */
  doInterpret: ~ py-data

  /**
   * @inheritdoc
   */
  fromExplainer: abstract ~
}
