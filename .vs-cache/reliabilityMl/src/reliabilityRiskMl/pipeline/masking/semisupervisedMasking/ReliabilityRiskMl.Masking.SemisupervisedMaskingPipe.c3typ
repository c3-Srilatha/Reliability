/**
 * This type represents a semi-supervised masking pipeline used in the context of reliability risk management.
 * It extends the `MlTemplate.AtomicPipe` to apply masking techniques to the input features.
 *
 * The `SemisupervisedMaskingPipe` is part of a machine learning pipeline designed to preprocess data by
 * applying semi-supervised masking, where some of the input data features are masked (i.e., hidden or modified)
 * based on a predefined mask. This technique is useful in scenarios where certain features are either missing
 * or need to be artificially obscured for model training purposes. This allows the model to learn under incomplete
 * or noisy conditions, improving its robustness.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.Masking.SemisupervisedMaskingPipe extends MlTemplate.AtomicPipe<{features: Data, mask: Data}, void, {maskedFeatures: Data}> mixes ReliabilityMlDatasetPreparationRunResolvable type key 'SMP' {

  /**
   * Generates the pipeline for processing the input features with the semi-supervised masking technique.
   * This function sets up the necessary transformations and operations that will be applied to the input data
   * during the masking process. It uses the `py` runtime to leverage Python-based libraries or logic for the generation
   * of the pipeline.
   */
  generatePipe: ~ py

  /**
   * Processes the input features and applies the semi-supervised masking as defined by the pipeline.
   * The method applies the mask to the features and returns the masked features. It leverages the `py-data`
   * runtime for performing data manipulation and processing.
   */
  doProcess: ~ py-data

  /**
   * Indicates whether this pipeline is trainable or not. This function should return whether the model
   * can be trained based on the input data and the semi-supervised masking technique.
   * This is part of the setup for ensuring the model can adapt to the masked data during training.
   */
  isTrainable: ~ py

  /**
   * Checks if the object is empty, meaning there are no relevant data or parameters in the current pipeline.
   * This function helps in verifying whether the pipeline is properly initialized and ready for processing.
   */
  isEmptyObj: ~ py

  /**
   * Indicates whether the pipeline has been trained successfully. If the pipeline has already been trained,
   * this method will return `true`; otherwise, it will return `false`.
   */
  isTrained: ~ py
}
