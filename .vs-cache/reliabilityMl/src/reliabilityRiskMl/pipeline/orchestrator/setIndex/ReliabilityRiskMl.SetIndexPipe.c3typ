/**
 * This type represents an {@link MlPipe} template for a data operation that takes in a {@link Data} object
 * and returns a {@link Data} object with the `subject` and `timestamp` set as index columns, if they haven't
 * been set already.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.SetIndexPipe extends MlTemplate.AtomicPipe<Data, void, Data> type key 'SIP' {

  isTrainable: ~ py

  doProcess: ~ py-data

  generatePipe: ~ py
}
