/**
 * This type represents an {@link MlPipe} template for a data operation that concatenates the input datasets horizontally.
 * The user needs to provide `inputNames` which will be used to construct the input type bindings.
 *
 * The `DataConcatenationPipe` is a machine learning pipeline component that takes multiple input datasets and
 * concatenates them horizontally (i.e., along the columns). This operation is typically used to combine different
 * features or datasets with a shared set of rows, allowing them to be processed as a single dataset for further analysis
 * or model training.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.DataConcatenationPipe<DX> extends MlTemplate.AtomicPipe<DX, void, Data> type key 'DCP' {

  /**
   * A list of input names that are used to construct the input type bindings for the concatenation operation.
   * These names correspond to the columns or datasets that will be horizontally concatenated to form the final
   * output dataset. The operation will take these inputs and join them together side by side (along the columns).
   */
  inputNames: ![string]

  /**
   * Flag indicating whether the operation is trainable.
   * If `true`, the operation may require a training phase before it can be used for data processing.
   */
  isTrainable: ~ py

  /**
   * Method to process the concatenation of datasets.
   * This function will combine the datasets specified in `inputNames` along the columns and generate the resulting
   * concatenated dataset.
   *
   * Typically, this method will be invoked after the pipeline has been generated and the input datasets are ready
   * to be concatenated.
   */
  doProcess: ~ py-data

  /**
   * Method to generate the pipeline that includes the data concatenation operation.
   * This method is used to prepare the concatenation operation as part of a larger machine learning pipeline.
   * The generated pipeline will include the logic required to combine the input datasets horizontally.
   */
  generatePipe: ~ py

  /**
   * Method to generate type bindings for the concatenated data.
   * This method establishes the type definitions and bindings for the input datasets, ensuring that the datasets
   * being concatenated have compatible types and structures.
   */
  generateTypeBindings: ~ py
}
