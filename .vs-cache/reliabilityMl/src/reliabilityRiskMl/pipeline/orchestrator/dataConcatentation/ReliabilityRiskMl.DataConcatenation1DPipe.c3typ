/**
 * This type represents an {@link MlPipe} template for a data operation that concatenates multiple 1-dimensional
 * input datasets horizontally. It combines the provided datasets into a single dataset by aligning their rows
 * based on the key values (the column names) provided by the user. This operation is typically used when merging
 * several data sources with 1-D structures (like time series data or simple feature vectors) into a unified dataset.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.DataConcatenation1DPipe<DX> extends MlTemplate.AtomicPipe<DX, void, Data> type key 'DCODP' {

  /**
   * A list of column names (or keys) that will be used to bind the input datasets.
   * These column names will be assigned to the datasets in the resulting concatenated dataset.
   *
   * The input datasets are expected to have 1-D structures, and this field helps define the column names
   * for each dataset after they are concatenated horizontally. The user needs to specify these names for the
   * process to ensure the proper alignment of the datasets.
   */
  inputNames: ![string]

  /**
   * This field indicates whether the data operation can be trained. When set to true, it implies that the
   * concatenation operation can be adjusted or fine-tuned during the model training process. In the context of
   * the `DataConcatenation1DPipe`, it refers to the ability to modify the concatenation behavior based on the
   * training data.
   *
   * default false
   */
  isTrainable: ~ py

  /**
   * This method processes the data by concatenating the input datasets horizontally. It takes the 1-dimensional
   * datasets, aligns them based on the specified `inputNames`, and returns the concatenated dataset as the output.
   *
   * The `doProcess` function is called during data processing when new datasets need to be merged. It ensures
   * that the datasets are concatenated in the correct order with the appropriate column names.
   */
  doProcess: ~ py-data

  /**
   * This method generates the underlying pipe for performing the concatenation operation. It sets up the necessary
   * steps for the concatenation process based on the provided input datasets and column names.
   *
   * The `generatePipe` function is crucial for setting up the operation pipeline and should be invoked before
   * the actual processing occurs.
   */
  generatePipe: ~ py

  /**
   * This method generates the type bindings for the operation. It creates the necessary data bindings based on the
   * input datasets and ensures the proper data flow through the pipe. This method is important for setting up
   * the type system and defining how the input data will be transformed and outputted.
   *
   * The `generateTypeBindings` function is responsible for ensuring the correct type matching between input and
   * output datasets, allowing the system to manage the data structures effectively.
   */
  generateTypeBindings: ~ py
}
