/**
 * This type represents an {@link MlPipe} template for a data operation that selects specific columns from a dataset.
 * It enables the extraction of the specified columns for use in subsequent steps in a machine learning pipeline.
 * The `DataColumnSelectionPipe` is used for selecting features (columns) from a dataset based on a list of column names.
 *
 * This can be useful in scenarios where only a subset of columns is required for further processing or modeling.
 * It is typically used as a preprocessing step in a machine learning pipeline to narrow down the dataset to relevant features.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.DataColumnSelectionPipe
extends MlTemplate.AtomicPipe<Data, void, Data>
type key 'DCSP' {

  /**
   * A list of column names to be selected from the dataset.
   * This field specifies the exact columns to be included in the output dataset.
   * The selected columns will be returned in the resulting dataset, and any other columns will be excluded.
   */
  columns: ![string]

  /**
   * A flag that indicates whether the column selection operation is trainable.
   * This is useful for operations that require training or learning from data, such as feature selection techniques.
   *
   * default false
   *
   * For example: true - The column selection process can be trained.
   * For example: false - The column selection is a fixed operation.
   */
  isTrainable: ~ py

  /**
   * This function processes the input dataset by selecting the specified columns from the {@link columns} field.
   * It applies the column selection operation and returns the resulting dataset containing only the selected columns.
   * The `doProcess` method should be invoked when executing the pipeline, selecting the relevant columns for further processing.
   */
  doProcess: ~ py-data

  /**
   * This method generates the underlying pipeline for performing the column selection operation.
   * It sets up the necessary steps for extracting the selected columns from the input dataset.
   * The `generatePipe` function should be called when setting up the pipeline to ensure the correct steps are initialized.
   */
  generatePipe: ~ py
}
