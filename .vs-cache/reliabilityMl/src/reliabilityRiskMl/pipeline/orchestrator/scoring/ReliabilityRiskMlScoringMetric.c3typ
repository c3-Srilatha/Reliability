/**
 * This abstract type represents a template for {@link ReliabilityRiskMl.Pipeline.ScoringMetric} and
 * {@link ReliabilityRiskMl.ReconstructionPipeline.ScoringMetric}.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
abstract type ReliabilityRiskMlScoringMetric<DO, DY> mixes MlScoringMetric<DO, DY, {sampleWeights: Data}> {

  /**
   * The actual {@link MlScoringMetric} that computes a score based on the selected {@link outputsToSelect}
   * and {@link targetsToSelect}. The user can provide a custom scoring metric
   * that mixins {@link MlScoringMetric}.
   */
  actualScoringMetric: !MlScoringMetric

  /**
   * A list of model outputs to select for scoring.
   */
  outputsToSelect: ![string]

  /**
   * A list of model inputs or targets to select for scoring.
   */
  targetsToSelect: [string]

  doScore: ~ py-data

  noTarget: ~ py

  higherIsBetter: ~ py
}
