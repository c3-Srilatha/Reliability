/**
 * This type represents a {@link ReliabilityRiskMlScoringMetric} for scoring a {@link ReliabilityRiskMl.Pipeline}.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
type ReliabilityRiskMl.Pipeline.ScoringMetric mixes ReliabilityRiskMlScoringMetric<
  {riskScore: Data, riskScoreNormalized: Data, alert: Data},
  {features: Data, trainingMask: Data, inferenceMask: Data, alertContext: Data, target: Data}> {

  /**
   * A list of model outputs to select for scoring. The available options are `'riskScore'`,
   * `'riskScoreNormalized'`, and `'alert'`. The selected outputs will be passed to the `DO`
   * of {@link actualScoringMetric}.
   */
  outputsToSelect: ![string]

  /**
   * A list of model inputs or targets to select for scoring. The available options are `'features'`,
   * `'trainingMask'`, `'inferenceMask'`, `'alertContext'`, and `'target'`. The selected inputs will
   * be passed to the `DY` of {@link actualScoringMetric}.
   */
  targetsToSelect: [string]
}
