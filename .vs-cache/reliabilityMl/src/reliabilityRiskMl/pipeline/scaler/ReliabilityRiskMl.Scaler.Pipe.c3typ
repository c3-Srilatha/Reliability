/**
 * Abstract type for feature scaling pipes.
 * This type provides a framework for defining and implementing scaling operations (e.g., MinMaxScaler, StandardScaler)
 * that apply to a subset of features in a dataset.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
abstract extendable entity type ReliabilityRiskMl.Scaler.Pipe<DX, DO> extends MlTemplate.AtomicPipe<DX, void, DO> type key 'RELSP' {

  /**
   * Use this field to specify a subset of features to scale.
   * This is a list of feature names that need to be scaled within the input data (`DX`).
   * This field allows you to specify exactly which features you want to scale.
   *
   * Example: If you want to scale `temperature` and `humidity`, set this to ['temperature', 'humidity'].
   */
  targetsToScale: [string] schema suffix 'TTS'

  /**
   * Determines if this scaling pipe is trainable.
   * This method checks if the scaling operation involves training (i.e., calculating statistical parameters
   * such as mean, standard deviation, min, or max) from the provided dataset.
   * For example, for Min-Max scaling, it learns the `min` and `max` values for the selected features.
   *
   * @return boolean - Returns `True` if the pipe is trainable (requires fitting on data).
   */
  isTrainable: ~ py

  /**
   * Generates the scaling pipeline for transforming the features.
   * This function will generate the necessary operations to scale the features according to the specific scaling method.
   * The generated pipeline will apply the transformation to the subset of features specified in `targetsToScale`.
   *
   * Example: For Min-Max scaling, it will apply the transformation:
   * `(X - min) / (max - min)` for each feature in `targetsToScale`.
   */
  generatePipe: ~ py

  /**
   * Remix this `afterConvert` function to make the model input as non-necessary.
   * Given that this pipe does not contain `nativeModel`, this function can be remixed to process or adjust
   * the model input data if necessary. It allows you to customize the way the model input is handled after
   * data conversion.
   *
   * @param model - The model (if provided) to convert.
   * @param spec - The conversion specification, which defines how to transform the model data.
   * @return {ReliabilityRiskMl.Scaler.Pipe} - Returns the instance of the scaler pipe.
   */
  afterConvert: member function(model: native, spec: MlConvertSpec): mixing ReliabilityRiskMl.Scaler.Pipe py
}
