/**
 * Type to represent the cached hyperparameters for a {@link ReliabilityMlModel}.
 * These hyperparameters cannot be added to the {@link ReliabilityMlModel} directly as
 * models are inmutable (i.e. `createOnly` - `true`). Hyperparameters should be
 * cached once the model is trained.
 */
entity type ModelConfigCachedHyperparams mixes ModelConfigHyperparams, FilterableByFacility {
  /**
   * The {@link ReliabilityMlModel} for which the hyperparameters are cached.
   */
  model: ReliabilityMlModel

  /**
   * Whether the cached hyperparameters are for inference only.
   * It is expected that each {@link ReliabilityMlModel} has 2 entries of this type:
   * one with `inferenceOnly` = `false` and one with `inferenceOnly` = `true`.
   */
  inferenceOnly: boolean

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["model.currentAssetRelations.from.facility"]
}
