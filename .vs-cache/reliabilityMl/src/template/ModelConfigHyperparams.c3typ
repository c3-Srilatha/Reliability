/**
 * Type to represent key & additional hyperparameters for the underlying {@link MlPipeline}
 * for a {@link ModelTemplate} or the {@link MlPipeline} of a {@link ReliabilityMlModel}.
 */
type ModelConfigHyperparams {

  /**
   * Stores the result of `TypeMetaDocGetter#getFieldDocs` with `tmdFieldType` = `TypeMetaDocFieldType.KEY`
   */
  keyHyperparams: any

  /**
   * Stores the result of `TypeMetaDocGetter#getFieldDocs` with `tmdFieldType` = `TypeMetaDocFieldType.ADDITIONAL`
   */
  additionalHyperparams: any

  /**
   * Whether the {@link ModelTemplate} has hyperparameters that are configurable for `HPO`,
   * i.e. they accept multiple values, multiple models are trained with those values and
   * the best model is selected.
   */
  hpoConfigurable: boolean

  /**
   * Gets all the hyperparameters (including nested as a field on the pipeline can have additional hyperparameters)
   * associated with a particular pipeline.
   *
   * @param pipeline
   *        The {@link MlPipeline} to get hyperparameters from.
   * @param isForInferenceOnly
   *        Whether to get the hyperparameters relevant only for model inference.
   *
   * @return {ModelConfigHyperparams} with key and additional hyperparameters.
   */
  getHyperparamsFromPipeline: function(pipeline: !MlPipeline, isForInferenceOnly: boolean): ModelConfigHyperparams js-rhino

  /**
   * Update the {@link ModelConfigCachedHyperparams} related to the given models.
   * If no previous cached hyperparameters entries exist for the given models, new entries are created.
   * This is primarily used to update the hyperparameters after the models have been trained.
   * @param models
   *         The {@link ReliabilityMlModel}s to update the hyperparameters for.
   * @param modelFilter
   *         Optionally, a filter to get the models to update the hyperparameters for.
   *         At least one of `models` or `modelFilter` must be provided.
   */
  updateCachedHyperparameters: function(
    models: [ReliabilityMlModel],
    modelFilter: string serialized Filter
  ) js-rhino
}
