/**
 * The {@link ReliabilityMl.Project.ReliabilityRiskForControlValves} type is used for generating and managing
 * reliability risk assessments specifically for control valves within a project. 
 */
  type ReliabilityMl.Project.ReliabilityRiskForControlValves {

  /**
   * Generates a model report by comparing the outputs of a reference and comparison model. This function is
   * designed for evaluating control valve reliability by providing insights into the models' performance and
   * their predictive capabilities.
   * 
   * @param project
   *        The {@link ReliabilityMl.Project} instance under which the reliability risk evaluation is conducted.
   * 
   * @param model
   *        The {@link ReliabilityMlModel} used for generating the reliability risk report for control valves.
   * 
   * @param asset
   *        The {@link ReliabilityAsset} representing the control valve or asset for which the reliability
   *        risk assessment is being performed.
   * 
   * @param datasetPreparationRun
   *        The {@link ReliabilityMlDatasetPreparationRun} that was used to prepare the data for the model’s
   *        training or inference.
   * 
   * @param referenceModelOutput
   *        The output from the reference model, used as a baseline for comparison with the comparison model's output.
   * 
   * @param comparisonModelOutput
   *        The output from the comparison model, which will be evaluated against the reference model’s output.
   * 
   * @returns A {@link native py-data} object containing the generated model report with details about the
   *          performance of both models and their suitability for predicting control valve reliability risk.
   */
  generateModelReport: private inline function(
    project: !ReliabilityMl.Project,
    model: !ReliabilityMlModel,
    asset: !ReliabilityAsset,
    datasetPreparationRun: !ReliabilityMlDatasetPreparationRun,
    referenceModelOutput: !ReliabilityMl.ModelOutput,
    comparisonModelOutput: !ReliabilityMl.ModelOutput
  ): !native py-data
}
