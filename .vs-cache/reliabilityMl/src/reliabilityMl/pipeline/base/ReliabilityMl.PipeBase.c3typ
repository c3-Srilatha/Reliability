/**
 * The base type for {@link ReliabilityMl.CustomPipe} and {@link ReliabilityMl.Pipeline}.
 * Defines the common set of functionalities required by both Types.
 */
type ReliabilityMl.PipeBase {

  /**
   * Defined in number of seconds, this field represents the duration of historical data
   * required to run model inference for a timestamp `t`.
   * An example is a model which needs `t-4hours : t` duration of data to make a prediction
   * for timestamp `t`. In this example, {@link lookbackDuration} must be set to 14,400, i.e.,
   * 14,400 seconds = 4 hours.
   */
  lookbackDuration: !int = 0

  /**
   * Given a {@link ReliabilityMlDatasetPreparationRun}, this function will change certain parameters
   * of the resolvable instance to be in accordance with the datasets prepared in the
   * {@link ReliabilityMlDatasetPreparationRun}.
   * An example is if the `numFeatures` of the `Conv1dAutoencoder` {@link ReliabilityMl.CustomPipe} is set to
   * 5, by default, but the number of features prepared in the datasets of {@link ReliabilityMlDatasetPreparationRun}
   * is 23, then this function will change the parameter of the pipeline so that when it is trained, an error
   * will not be thrown.
   * This function is mainly used to automate the model training process, without the user having to provide
   * inputs that the system can evaluate, itself.
   * @param datasetPreparationRun
   *        The {@link ReliabilityMlDatasetPreparationRun} from which the dataset to train the pipeline on
   *        may be extracted
   * @returns a "resolved" {@link ReliabilityMl.PipeBase} instance
   */
  resolveForDatasetPreparationRun: member function(
    datasetPreparationRun: !ReliabilityMlDatasetPreparationRun | ReliabilityMlPopulationDatasetPreparationRun
  ): !mixing ReliabilityMl.PipeBase py
}
