/**
 * Defines all the functions that can only be run in jupyter. Contains helper functions to aid the
 * development of custom algorithms and their integration with the rest of the C3 AI Reliability framework.
 */
native py remix type ReliabilityMl.CustomPipe {

  /**
   * For a user wanting to develop their own python class, run this function to get
   * a skeleton implementation of a python class.
   */
  print_template_class_impl: function() py-client

  /**
   * After calling {@link listImplementations}, if one wishes to import one of the classes into
   * the jupyter kernel, run this function for one of the implementations.
   * To see documentation of the loaded module, python `help()` function may be used.
   */
  load_module: inline function(class_name: !string) py-client

  /**
   * Helper function to inspect the details of any function and return the function argument names
   * along with any default values they may take. Some examples of how to use this function:
   * ```py
   * c3.ReliabilityMl.CustomPipe.load_module("Conv1dAutoencoder")
   *
   * import sys
   * sys.path.append("/home/c3/jupyter_root_dir/models")
   * from Conv1dAutoencoder import Conv1dAutoencoder
   *
   * c3.ReliabilityMl.CustomPipe.get_function_args_with_defaults(Conv1dAutoencoder)
   * # The above line will print the names arguments to the `__init__` function of the class `Conv1dAutoencoder`
   *
   * c3.ReliabilityMl.CustomPipe.get_function_args_with_defaults(Conv1dAutoencoder.do_train)
   * # The above line will print the names arguments to the `do_train` function of the class `Conv1dAutoencoder`
   * ```
   */
  get_function_args_with_defaults: inline function(func: !native): map<string, any> py-client

  /**
   * This function will print the python class implementation backing this {@link ReliabilityMl.CustomPipe}.
   * This is very useful in cases where a user has already developed the class but runs into an error and needs
   * to debug the code.
   */
  print_implementation: member function() py-client
}
