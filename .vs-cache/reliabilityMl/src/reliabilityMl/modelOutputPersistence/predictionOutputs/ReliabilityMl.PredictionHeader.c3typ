/**
 * A series keeping track of the "time series" predictions made for a {@link MlSubject} by a {@link ReliabilityMlModel}.
 * All {@link ReliabilityMlModel} outputs to be retrieved in the application must be persisted under their respective header.
 *
 * For {@link ReliabilityMl.Project#primaryModelOutputs}, a {@link ReliabilityMl.PredictionHeader} should be created with
 * `name` set to the respective primary model output.
 *
 * For feature specific outputs, (defined as keys on the {@link ReliabilityMl.Project#featureOutputs} map),
 * a {@link ReliabilityMl.PredictionHeader} with `name` set to the {@link Feature#name} + the associated suffix should be created.
 * The suffix is retrieved through {@link ReliabilityMl.Project#featureOutputs}.
 */
@db(index=['parent'])
extendable entity type ReliabilityMl.PredictionHeader mixes TimedDataHeader<ReliabilityMl.Prediction>, FilterableByFacility schema name 'REL_MPH' {

  /**
   * The subject-model association related to this series header.
   */
  parent: !ReliabilityAssetToModelRelation

  /**
   * The treatment to use for the timeseries.
   */
  treatment: string enum AggOp = AggOp.AVG

  /**
   * The unit to use for the timeseries.
   */
  unitConstraint: Unit

  /**
   * {@link TimedDataFields#timeZone} gets overridden by this field. If not set, the default value is 'UTC'.
   *
   * The timezone to use for the timeseries.
   */
  timeZone: string = 'UTC'

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["parent.from.facility"]
}
