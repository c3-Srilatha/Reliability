/**
 * Spec used to create {@link ModelUserFeedback} or {@link ReliabilityAssetAlertFeedback} on form submit
 */
type SubmitModelUserFeedbackSpec mixes Spec {

  /**
   * The category of feedback that the user selected.
   */
  category: string enum ModelUserFeedbackCategory

  /**
   * A suggestion as to what to do with the model in response to the feedback.
   */
  suggestion: string enum ModelUserFeedbackSuggestion

  /**
   * Additional comments related to this feedback, possibly including a description of what might be the issue.
   */
  comment: string

  /**
   * The model this feedback belongs to.
   */
  model: !MlModel
}
