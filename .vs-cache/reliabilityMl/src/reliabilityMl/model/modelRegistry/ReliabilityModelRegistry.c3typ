/**
 * This type exposes the {@link ModelRegistry} APIs specific to Reliability.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
type ReliabilityModelRegistry {

  /**
   * Registers the {@link Feature}s that need to be migrated for a given {@link ReliabilityMlModel} in the source
   * environment.
   */
  registerFeatures: private function(xFeatures: !map<string, Feature.Set>, path: string): !ModelRegistry.Entry py

  /**
   * Registers the {@link ReliabilityMlDatasetPreparationRun} that needs to be migrated for a given
   * {@link ReliabilityMlModel} in the source environment.
   */
  registerDatasetPreparationRun: private function(datasetPreparation: !ReliabilityMlDatasetPreparationRun, path: string): !ModelRegistry.Entry py

  /**
   * Registers the {@link MlProject} and it's corresponding {@link MlModel.RelationRouter} that needs to be migrated
   * for a given {@link ReliabilityMlModel} in the source environment.
   */
  registerMlProject: private function(project: !MlProject, path: string): !ModelRegistry.Entry py

  /**
   * Registers the required {@link MlModel.Route} associated with the {@link ReliabilityMlModel},
   * so that it can be used to deploy the model in the target environment.
   */
  registerMlModelRoute: private function(model: !ReliabilityMlModel, path: string): !ModelRegistry.Entry py

  /**
   * Registers data and model predictions associated with the {@link ReliabilityMlModel} for a small dataset,
   * so that the model migration can be validated by comparing the source model's predictions with the migrated model
   * in the target environment.
   */
  registerMlModelPredictions: private function(model: !ReliabilityMlModel, path: string): !ModelRegistry.Entry py-data

  /**
   * Creates a single {@link ModelRegistry.Entry} that stores information about the {@link ModelRegistry.Entry}s
   * that have been created for all the artifacts that need to be migrated to the target environment.
   *
   */
  registerAllEntries: private function(
    entries: !map<string, ModelRegistry.Entry>,
    path: string,
    desc: string
  ): !ModelRegistry.Entry py

  /**
   * Registers a given {@link ReliabilityMlModel} and stores all the relevant model artifacts that needs to be migrated
   * to the target environment.
   *
   * @param model
   *        An instance of {@link ReliabilityMlModel} to be registered.
   * @param desc
   *        Optional description for the {@link ReliabilityMlModel} to be registered.
   *
   * @returns an instance of {@link ReliabilityModelRegistry.SourceEntry}, that contains the information
   *          required to migrate the underlying registered {@link ReliabilityMlModel}.
   */
  registerMlModel: function(model: !ReliabilityMlModel, desc: string): !ReliabilityModelRegistry.SourceEntry py

  /**
   * Loads the {@link Feature}s that need to be migrated for a given {@link ReliabilityMlModel} in the target
   * environment, if the {@link Feature} does not already exist in the target environment.
   */
  loadFeatures: private function(entry: !ModelRegistry.Entry) py

  /**
   * Loads the {@link ReliabilityMlDatasetPreparationRun} that needs to be migrated for a given
   * {@link ReliabilityMlModel} in the target environment.
   */
  loadDatasetPreparationRun: private function(entry: !ModelRegistry.Entry): ReliabilityMlDatasetPreparationRun py

  /**
   * Loads the {@link MlProject} and it's corresponding {@link MlModel.RelationRouter} that needs to be migrated
   * for a given {@link ReliabilityMlModel} in the target environment.
   */
  loadMlProject: private function(entry: !ModelRegistry.Entry) py

  /**
   * Loads and returns the {@link ModelRegistry.Entry}s corresponding to the different artifacts
   * that needed to be loaded for a given {@link ReliabilityMlModel} in the target environment.
   */
  loadAllEntries: private function(pathOrUri: !string, version: int): !map<string, ModelRegistry.Entry> py

  /**
   * Validates that the model predictions generated by the model in the target environment
   * are the same as the model's predictions in the source environment for a small sample dataset.
   */
  validateModelPredictions: private function(entry: !ModelRegistry.Entry, model: !ReliabilityMlModel): !boolean py-data

  /**
   * Loads the {@link ModelRegistry.Entry}s corresponding to the {@link MlModel.Route} artifact
   * for the model from the source environment, and uses the info to deploy the newly created
   * {@link ReliabilityMlModel} in the target environment.
   */
  deployModel: private function(
    entry: !ModelRegistry.Entry,
    model: !ReliabilityMlModel,
    hasValidPredictions:boolean,
    force: boolean=false
  ) py

  /**
   * Loads a given {@link ReliabilityMlModel} and it's corresponding artifacts that needs to be migrated
   * in the target environment.
   *
   * @param pathOrUri
   *        {@link ModelRegistry.Entry#uri} or path to read from.
   * @param version
   *        {@link ModelRegistry.Entry#ver} to read from.
   * @param id
   *        Optional id to persist {@link ReliabilityMlModel}. If an instance of {@link MlModel} exists with
   *        this id, an error is thrown. If no id is provided, DB generated id is used.
   * @param force
   *        Forces the deployment of the {@link ReliabilityMlModel} in the target environment, even if validation
   *        checks fail.
   *
   * @returns an instance of {@link ReliabilityModelRegistry.TargetEntry}, that contains the information
   *          about the loaded {@link ReliabilityMlModel} in the target environment..
   */
  loadMlModel: function(pathOrUri: !string, version: int, id: string, force: boolean = false): !ReliabilityModelRegistry.TargetEntry py
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
