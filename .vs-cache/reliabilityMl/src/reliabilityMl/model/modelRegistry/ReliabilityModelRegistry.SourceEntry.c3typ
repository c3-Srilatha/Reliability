/**
 * This type stores the information in the source environment required to migrate a {@link ReliabilityMlModel}
 */
@db(unique=['model'])
entity type ReliabilityModelRegistry.SourceEntry mixes FilterableByFacility schema name "RMRSE" {

  /**
   * The source {@link ReliabilityMlModel} that needs to be migrated to the target environment.
   */
  model: !ReliabilityMlModel

  /**
   * The {@link ModelRegistry.Entry} that holds all the information required to migrate the model to the
   * target environment.
   */
  entry: !ModelRegistry.Entry

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["model.currentAssetRelations.from.facility"]
}
