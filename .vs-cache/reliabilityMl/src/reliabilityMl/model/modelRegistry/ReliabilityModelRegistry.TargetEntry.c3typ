/**
 * This type stores the information in the target environment about the newly migrated {@link ReliabilityMlModel},
 * and it's corresponding model id in the source environment.
 */
entity type ReliabilityModelRegistry.TargetEntry mixes FilterableByFacility schema name "RMRTE" {

  /**
   * A new {@link ReliabilityMlModel} that has been created in the target environment.
   */
  model: !ReliabilityMlModel

  /**
   * The id of the {@link ReliabilityMlModel} in the source environment that corresponds to the migrated {@link #model}.
   */
  sourceModelId: string

  /**
   * Indicates whether the migrated {@link ReliabilityMlModel} generates the same predictions as it's corresponding model
   * from the source environment, by comparing their predictions and contributions on a small sample dataset.
   */
  hasValidPredictions: boolean

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["model.currentAssetRelations.from.facility"]
}
