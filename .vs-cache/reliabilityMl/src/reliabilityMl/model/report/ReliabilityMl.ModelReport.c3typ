/**
 * A single exportable PDF model report.
 */
extendable entity type ReliabilityMl.ModelReport mixes FilterableByFacility schema name 'REL_ML_RPRT' {

  /**
   * The {@link ReliabilityMlModel} to which this report belongs.
   */
  model: !ReliabilityMlModel

  /**
   * The {@link ReliabilityAsset} to which this report belongs.
   */
  asset: !ReliabilityAsset

  /**
   * The generated PDF as a {@link File} for this report.
   */
  file: !File

  /**
   * The {@link TimeRange} over which the reference model output was generated for the {#model}.
   */
  referenceTimeRange: !TimeRange

  /**
   * The {@link TimeRange} over which the comparison model output was generated for the {#model}.
   */
  comparisonTimeRange: !TimeRange

  /**
   * Deduced from the {@link ReliabilityMlDatasetPreparationRunCommon#interval} used during generating this report.
   */
  interval: string

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["asset.facility"]
}
