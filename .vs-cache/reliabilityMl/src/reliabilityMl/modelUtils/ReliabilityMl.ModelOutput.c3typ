/**
 * Type that holds the {@link TimeRange}, and the outputs of {@ReliabilityMlModel#process} and
 * {@ReliabilityMlModel#interpret} for that time range.
 */
type ReliabilityMl.ModelOutput {

  /**
   * The {@link TimeRange} for which {@ReliabilityMlModel#process} and {@ReliabilityMlModel#interpret} was run.
   */
  timeRange: !TimeRange

  /**
   * The outputs of {@ReliabilityMlModel#process} for the {@link #timeRange}
   */
  processOutputs: !Tuple

  /**
   * The outputs of {@ReliabilityMlModel#interpret} for the {@link #timeRange}, if any.
   */
  interpretOutputs: Tuple
}
