/**
 * @inheritdoc
 */
remix type ReliabilityAssetEvent {

  /**
   * The {@link ReliabilityAssetAlert} that corresponds to this event.
   */
  detectionAlert: ReliabilityAssetAlert

  /**
   * Represents whether the {@link ReliabilityAssetEvent} is user added.
   */
  userAdded: ?boolean = false
}
