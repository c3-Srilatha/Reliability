/**
 * Possible values for the alert user feedback category.
 */
enum type ReliabilityAssetAlertFeedbackCategory {

  /**
   * Enum value to indicate a true positive alert.
  */
  TRUE_POSITIVE = 'True Positive'

  /**
   * Enum value to indicate a false positive alert.
  */
  FALSE_POSITIVE = 'False Positive'

  /**
   * Enum value to indicate unclear reasoning for triggering an alert.
  */
  UNCLEAR = 'Unclear'
}
