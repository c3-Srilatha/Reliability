/**
 * A persisted type representing validation alerts triggered on a {@link ReliabilityAsset}.
 *
 * Validation alerts are alerts for testing purposes; they are not "real" alerts. They're used to check that the
 * {@link ReliabilityMlModel} we are defining is working as expected and are generated from training a model and
 * performing the validation workflow via the `ReliabilityRiskMlModel#processValidationAlertTimeseries` method triggered
 * by `ReliabilityOrchestrator.ReliabilityRisk.ModelValidationJob` for Risk and
 * {@link ReliabilityMl.Project#processValidationAlertsForAsset} triggered by `ReliabilityOrchestrator.PostTrainingJob` for Project Agnostic.
 */
entity type ReliabilityAssetValidationAlert mixes ReliabilityAssetAlertBase, FilterableByFacility schema name "RAVA" {

  /**
    * @inheritdoc
    */
  name: !~

  /**
   * The feedback that the user selected for this alert.
   */
  feedback: string enum ReliabilityAssetAlertFeedbackCategory

  /**
   * The reference to the relation that generated this alert.
   */
  relation: ReliabilityAssetToRiskModelValidationRelation

  /**
   * Whether this entity is a model validation type.
   */
  isValidationType: const boolean = true

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["parent.facility"]
}
