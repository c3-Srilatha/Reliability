/**
 * Spec used to create {@link ReliabilityAssetAlertFeedback} on form submit.
 */
type SubmitAlertFeedbackSpec mixes Spec {

  /**
   * The {@link ReliabilityAssetAlert}s that the user is providing feedback on.
   * For each {@link ReliabilityAssetAlert} given, a new {@link ReliabilityAssetAlertFeedback} is created.
   */
  alerts: ![ReliabilityAssetAlert]

  /**
   * The category of feedback that the user selected.
   */
  category: string enum ReliabilityAssetAlertFeedbackCategory

  /**
   * Additional comments related to this feedback, possibly including a description of what might be the issue.
   */
  comment: string
}
