/**
 * A persisted base type representing triggered alerts on {@link ReliabilityAsset}.
 * They're generated when a selected attribute shows values outside the expected defined previously when a
 * {@link ReliabilityMlModel} related a {@link ReliabilityAsset} is trained.
 */
entity extendable type ReliabilityAssetAlert mixes ReliabilityAssetAlertBase, FeatureEvaluatable, FilterableByFacility schema name "PAA" {

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["parent.facility"]
}
