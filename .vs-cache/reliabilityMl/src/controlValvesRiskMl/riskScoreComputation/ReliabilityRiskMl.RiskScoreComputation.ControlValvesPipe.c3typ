/**
 * A template {@link ReliabilityRiskMl.ReconstructionPipeline#riskScorePipe} that is used to model Control Valves.
 *
 * The {@link doTrain} and {@link doProcess} APIs of this pipe rely on the {@link ControlValvesModelableMethods#doTrainRiskScore #controlValvesModelable#doTrainRiskScore}
 * and the {@link ControlValvesModelableMethods#doProcessRiskScore #controlValvesModelable#doProcessRiskScore} APIs to provide concrete implementations for the
 * training and processing of this risk score computation pipe.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.RiskScoreComputation.ControlValvesPipe extends ReliabilityRiskMl.RiskScoreComputation.Pipe<{trainingFeatures: Data, inferenceFeatures: Data, scaledTrainingFeatures: Data, scaledInferenceFeatures: Data, residuals: Data, scaledResiduals: Data, reconstructions: Data, scaledReconstructions: Data, alertContext: Data}, {riskScore: Data}> mixes ReliabilityMlDatasetPreparationRunResolvable type key 'CVRSP' {

  /**
   * Do not set this field manually, this is set from the {@link ReliabilityRiskMl.ControlValvesReconstructionPipeline} to
   * point its corresponding {@link ReliabilityRiskMl.ControlValvesReconstructionPipeline#controlValvesModelable}.
   */
  controlValvesModelable: private ControlValvesModelableMethods

  /**
   * If set, then this pipe can be trained and must implement `doTrain`. Otherwise, this pipe will be treated as
   * process-only.
   */
  isTrainableOverride: ~ = true

  generatePipe: ~ py

  doTrain: ~ py-data

  doProcess: ~ py-data
}
