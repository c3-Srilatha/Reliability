/**
 * This type represents an {@link MlPipe} template for a ElasticNet regression model. This can be used as a regressor
 * in {@link ReliabilityRiskMl.Reconstruction.ControlValvesPipe#regressor}.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.Reconstruction.ElasticNetPipe extends MlTemplate.AtomicPipe<Data, Data, Data> type key 'ENP' {

  /**
   * Constant that multiplies the penalty terms. Defaults to 1.0.
   */
  @ML(hyperparameter=true)
  alpha: float = 1.0

  /**
   * The ElasticNet mixing parameter, with 0 <= l1_ratio <= 1. For l1_ratio = 0 the penalty is an L2 penalty.
   * For l1_ratio = 1 it is an L1 penalty. For 0 < l1_ratio < 1, the penalty is a combination of L1 and L2.
   */
  @ML(hyperparameter=true)
  l1Ratio: float = 0.5

  /**
   * Whether the intercept should be estimated or not. If False, the data is assumed to be already centered.
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  fitIntercept: boolean = true

  /**
   * The maximum number of iterations.
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  maxIter: int = 1000

  /**
   * The tolerance for the optimization: if the updates are smaller than tol, the optimization code checks the
   * dual gap for optimality and continues until it is smaller than tol.
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  tol: float = 0.0001

  /**
   * When set to True, forces the coefficients to be positive.
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  positive: boolean = false

  /**
   * The seed of the pseudo random number generator that selects a random feature to update
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  randomState: int = 0

  /**
   * If set to ‘random’, a random coefficient is updated every iteration rather than looping over features
   * sequentially by default.
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  selection: string enum ('cyclic', 'random') = 'cyclic'

  generatePipe: ~ py-sklearn

  doTrain: ~ py-sklearn

  doProcess: ~ py-sklearn
}
