/**
 * This type represents an {@link MlPipe} template for a RandomForest regressor. This can be used as a regressor
 * in {@link ReliabilityRiskMl.Reconstruction.ControlValvesPipe#regressor}.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.Reconstruction.RandomForestPipe extends MlTemplate.AtomicPipe<Data, Data, Data> type key 'RFP' {

  /**
   * The number of trees in the forest. Defaults to 100
   */
  @ML(hyperparameter=true)
  nEstimators: int = 100

  /**
   * The function to measure the quality of a split.
   */
  @ML(hyperparameter=true)
  criterion: string enum ('mse', 'mae') = 'mse'

  /**
   * The maximum depth of the tree. If None, then nodes are expanded until all leaves are pure or until all
   * leaves contain less than {@link #minSamplesSplit} samples.
   */
  @ML(hyperparameter=true)
  maxDepth: int

  /**
   * The minimum number of samples required to split an internal node. Defaults to 2
   */
  @ML(hyperparameter=true)
  minSamplesSplit: int = 2

  /**
   * The minimum number of samples required to be at a leaf node. Defaults to 1
   */
  @ML(hyperparameter=true)
  minSamplesLeaf: int = 1

  /**
   * The minimum weighted fraction of the sum total of weights (of all the input samples) required to be at a leaf node.
   * Defaults to 0
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  minWeightFractionLeaf: float = 0.0

  /**
   * The number of features to consider when looking for the best split
   */
  @ML(hyperparameter=true)
  maxFeatures: string enum ('auto', 'sqrt', 'log2') | float = 'auto'

  /**
   * Grow trees with max_leaf_nodes in best-first fashion.
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  maxLeafNodes: int

  /**
   * A node will be split if this split induces a decrease of the impurity greater than or equal to this value
   * Defaults to 0
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  minImpurityDecrease: float = 0.0

  /**
   * Whether bootstrap samples are used when building trees. If False, the whole dataset is used to build each tree.
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  bootstrap: boolean

  /**
   * The number of jobs to run in parallel for both fit and predict. If -1, then all processors are used.s
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  nJobs: int

  /**
   * The seed of the pseudo random number generator that selects a random feature to update
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  randomState: int = 0

  /**
   * Complexity parameter used for Minimal Cost-Complexity Pruning
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  ccpAlpha: float = 0.0

  /**
   * If {@link #bootstrap} is True, the number of samples to draw from X to train each base estimator.
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  maxSamples: float

  generatePipe: ~ py-sklearn

  doTrain: ~ py-sklearn

  doProcess: ~ py-sklearn
}
