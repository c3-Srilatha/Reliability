/**
 * This type represents an {@link MlPipe} template for a LightGBM regressor. This can be used as a regressor
 * in {@link ReliabilityRiskMl.Reconstruction.ControlValvesPipe#regressor}.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.Reconstruction.LightGBMPipe extends MlTemplate.AtomicPipe<Data, Data, Data> type key 'LGBP' {

  /**
   * The method to use for boosting. 'gbdt' uses traditional Gradient Boosting Decision Tree. 'dart' uses Dropouts
   * meet Multiple Additive Regression Trees. 'rf' uses Random Forest.
   */
  @ML(hyperparameter=true)
  boostingType: string enum ('gbdt', 'dart', 'rf') = 'gbdt'

  /**
   * Maximum tree leaves for base learners
   */
  @ML(hyperparameter=true)
  numLeaves: int = 31

  /**
   * Maximum tree depth for base learners, <=0 means no limit.
   */
  @ML(hyperparameter=true)
  maxDepth: int = -1

  /**
   * Learning rate to use for boosting
   */
  @ML(hyperparameter=true)
  learningRate: float = 0.1

  /**
   * The number of trees in the forest. Defaults to 100
   */
  @ML(hyperparameter=true)
  nEstimators: int = 100

  /**
   * Number of samples for constructing bins.
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  subsampleForBin: int = 200000

  /**
   * Minimum loss reduction required to make a further partition on a leaf node of the tree.
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  minSplitGain: float = 0.0

  /**
   * Minimum sum of instance weight (Hessian) needed in a child (leaf).
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  minChildWeight: float = 0.001

  /**
   * Minimum amount of data needed in a child (leaf).
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  minChildSamples: int = 20

  /**
   * Subsample ratio of the training instance.
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  subsample: float = 1.0

  /**
   * Frequency of subsample, <=0 means not enabled.
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  subsampleFreq: int = 0

  /**
   * Subsample ratio of columns when constructing each tree.
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  colsampleBytree: float = 1.0

  /**
   * L1 regularization term on weights.
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  regAlpha: float = 0.0

  /**
   * L2 regularization term on weights.
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  regLambda: float = 0.0

  /**
   * The seed of the pseudo random number generator that selects a random feature to update
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  randomState: int = 0

  /**
   * The number of jobs to run in parallel for both fit and predict. If -1, then all processors are used.
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  nJobs: int

  /**
   * The type of feature importance to be filled into feature_importances_
   */
  @ML(hyperparameter=true)
  @typeMetaDoc(isAdditional=true)
  importanceType: string enum ('split', 'gain') = 'split'

  generatePipe: ~ py-lightgbm

  doTrain: ~ py-lightgbm

  doProcess: ~ py-lightgbm
}
