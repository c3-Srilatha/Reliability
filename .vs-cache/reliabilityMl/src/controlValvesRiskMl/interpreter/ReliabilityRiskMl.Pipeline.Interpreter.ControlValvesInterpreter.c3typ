/**
 * A template {@link ReliabilityRiskMl.ReconstructionPipeline#interpreter} that is used to generate feature contributions for
 * Control Valves.
 *
 * The `doTrain` and `doProcess` APIs of this pipe rely on the
 * {@link ReliabilityRiskMl.Reconstruction.ControlValvesPipe#controlValvesModelable}'s doInterpret API to provide a concrete
 * implementation for generating feature contributions.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityRiskMl.Pipeline.Interpreter.ControlValvesInterpreter<DX, DO> mixes MlInterpreter<DX, DO> type key 'CVI' {

  /**
   * @inheritdoc
   */
  makeExplainer: ~ py-data-science-lightgbm

  /**
   * @inheritdoc
   */
  doInterpret: ~ py-data-science-lightgbm

  /**
   * @inheritdoc
   */
  fromExplainer: abstract ~
}
