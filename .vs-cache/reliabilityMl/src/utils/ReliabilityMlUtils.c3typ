/**
 * Type that contains common utility APIs for Reliability ML operations.
 */
type ReliabilityMlUtils {

  /**
   * Performs training of a machine learning model using a scikit-learn pipeline.
   *
   * @param beforeTrainResults - The data or results to be processed before training.
   * @param spec - The specifications for the ML operation.
   * @returns A native Python object representing the trained model or process.
   */
  doTrainSklearnPipe: inline function(beforeTrainResults: !native, spec: MlOperationSpec): !native py

  /**
   * Processes outputs from a scikit-learn pipeline after model training.
   *
   * @param beforeProcessOutputs - The data or results to be processed before final outputs.
   * @param spec - The specifications for the ML operation.
   * @returns A native Python object representing the processed output.
   */
  doProcessSklearnPipe: inline function(beforeProcessOutputs: !native, spec: MlOperationSpec): !native py

  /**
   * Retrieves evaluation results for a given model over a specified time range and period.
   *
   * @param model - The trained ML model to evaluate.
   * @param timeRange - The time range over which to evaluate the model.
   * @param period - The evaluation period, such as daily, weekly, etc.
   * @returns The persisted evaluation results as a data object.
   */
  @deprecated(
    finalVersion='21.0.0',
    details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
  getEvaluationResults: function(
    model: !ReliabilityRiskMlModel,
    timeRange: !TimeRange,
    period: !string
  ): Data.Persisted py-data

  /**
   * Computes feature drift between two time periods for a given model.
   *
   * @param model - The trained ML model for which to compute feature drift.
   * @param referencePeriod - The reference time range to compare against.
   * @param comparisonPeriod - The time range to compare with the reference period.
   * @returns A float representing the degree of feature drift.
   */
  @deprecated(
    finalVersion='21.0.0',
    details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
  computeFeatureDrift: function(
    model: !ReliabilityRiskMlModel,
    referencePeriod: !TimeRange,
    comparisonPeriod: !TimeRange
  ): float py-data-science

  /**
   * Computes the deviation percentile between two evaluation results.
   *
   * @param evaluationResultsRef - The reference evaluation results.
   * @param evaluationResultsComp - The comparison evaluation results.
   * @returns An integer representing the deviation percentile between the two sets of evaluation results.
   */
  computeDeviationPercentile: function(
    evaluationResultsRef: !Data.Persisted,
    evaluationResultsComp: !Data.Persisted
  ): int py-data

  /**
   * Computes the Mean Absolute Error (MAE) ratio between two evaluation results.
   *
   * @param evaluationResultsRef - The reference evaluation results.
   * @param evaluationResultsComp - The comparison evaluation results.
   * @returns A float representing the MAE ratio.
   */
  computeMAERatio: function(
    evaluationResultsRef: !Data.Persisted,
    evaluationResultsComp: !Data.Persisted
  ): float py-data

  /**
   * Retrieves classification notes based on classification scores and a given specification.
   *
   * @param classificationScoreInputs - A map of classification scores for different features.
   * @param spec - The specification defining the classification scoring process.
   * @returns A string containing notes or remarks based on the classification scores.
   */
  @deprecated(
    finalVersion='21.0.0',
    details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
  getClassificationNotes: function(
    classificationScoreInputs: map<string, float>,
    spec: !ReliabilityRiskMlModel.ClassificationScoreSpec
  ): string py

  /**
   * Deduplicates a time range by removing overlapping or specified time ranges.
   *
   * @param inputTimeRange - The time range to be deduplicated.
   * @param timeRangesToExclude - A list of time ranges that should be excluded from the result.
   * @returns A list of time ranges after exclusion of the specified ranges.
   */
  dedupTimeRange: inline function(inputTimeRange: !TimeRange, timeRangesToExclude: ![TimeRange]): [TimeRange] py

  /**
   * Converts a {@link Data} into a {@link Map} of {@link TimeRange}s for each data column.
   *
   * This function processes the provided mask data, where each key corresponds to a mask name
   * and the associated value is an array of 0/1 values (or boolean) over time, and returns a map
   * from each mask name to a list of contiguous time ranges where the mask is active (value is 1/true).
   *
   * Example:
   * ```
   * Input:
   *   dataMask = {
   *     "mask_IsAssetNotOperational": {
   *       "timestamps": ["2024-01-01T00:00:00Z", "2024-01-01T01:00:00Z", "2024-01-01T02:00:00Z", "2024-01-01T03:00:00Z"],
   *       "values": [0, 1, 1, 0]
   *     }
   *   }
   *
   * Output:
   *   {
   *     "mask_IsAssetNotOperational": [
   *       {
   *         "start": "2024-01-01T01:00:00Z",
   *         "end": "2024-01-01T03:00:00Z"
   *       }
   *     ]
   *   }
   * ```
   *
   * @param dataMask The {@link Data} containing mask arrays keyed by mask name.
   * @return A {@link Map} from mask name to an {@link Array} of {@link TimeRange} where the mask is active.
   *
   */
  convertMaskToTimeRanges: inline function(dataMask: !Data): map<string, [TimeRange]> py
}
