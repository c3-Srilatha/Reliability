/**
 * `ReliabilityUtils` provides utility functions for interacting with machine learning (ML) pipelines,
 * risk score generation, and other reliability-related tasks within a project context.
 * These methods are specifically designed to work with the C3 AI platform to manage and manipulate machine learning
 * pipelines, retrieve relations for asset-time ranges, and facilitate various other machine learning-related tasks.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
remix type ReliabilityUtils {

  /**
   * Retrieves relations between a given asset and an ML project over a specified time range.
   * This is typically used to retrieve a set of model relations for a particular time window, based on the given asset.
   *
   * @param asset The asset for which to retrieve relations.
   * @param project The ML project related to the asset.
   * @param timeRange The time range within which to retrieve relations.
   * @param statusLabels An optional list of status labels to filter the model relations by. Defaults to [MlModel.Route.Status.Label.CHAMPION].
   * @returns A list of pairs, where each pair consists of an `MlSubjectToModelRelation` and a `TimeRange`.
   */
  getRelationsForTimeRange: function(
    asset: !ReliabilityAsset,
    project: !MlProject,
    timeRange: !TimeRange,
    statusLabels: ![MlModel.Route.Status.Label] = [MlModel.Route.Status.Label.CHAMPION]
  ): [Pair<MlSubjectToModelRelation, TimeRange>] py

  /**
   * Replaces the `existingPipe` with the `updatedPipe`, and returns the updated `MlPipe` instance.
   * There are two options for replacing the pipe:
   * 1. Replace only the user-provided fields in the `updatedPipe`, while preserving the rest of the values from `existingPipe`. This is the default behavior.
   * 2. Completely replace the entire `existingPipe` with the `updatedPipe` (full override).
   *
   * @param existingPipe The existing `MlPipe` instance to be updated.
   * @param updatedPipe The new `MlPipe` instance to replace the existing pipe.
   * @param fullOverride Whether to fully replace the entire `existingPipe` or only update the fields provided in `updatedPipe`. Default is `false`.
   * @returns The updated `MlPipe` instance.
   */
  updatePipe: function(
    existingPipe: !MlPipe,
    updatedPipe: !MlPipe,
    fullOverride: boolean = false
  ): !MlPipe py

  /**
   * Generates a new pipeline instance from an existing trained pipeline, replacing the sub-pipes in the original pipeline with updated sub-pipes.
   * The replacement of sub-pipes can be done in two ways:
   * 1. Replace only the user-provided fields on the sub-pipes, cloning the rest of the sub-pipe. This is the default behavior and does not persist the provided sub-pipes to the database.
   * 2. Replace the entire sub-pipe with the user-provided sub-pipe. The updated sub-pipes must be trained before this action.
   *
   * The method generates a new `MlPipeline` with updated vertices but without modifying the original pipeline's other configurations.
   *
   * @param pipeline The trained pipeline instance to base the new pipeline on.
   * @param updatedPipes A map where keys are the names of pipeline vertices and values are the updated sub-pipes.
   * @param fullOverride Whether to replace the entire sub-pipe or just update specific fields. Default is `false`.
   * @returns A new `MlPipeline` with the updated vertices.
   */
  replacePipelineVertices: function(
    pipeline: !MlPipeline,
    updatedPipes: !map<string, any>,
    fullOverride: boolean = false
  ): !MlPipeline py

  /**
   * Converts the output of a `PartiallyAppliedAction` that returns a pandas DataFrame to a `Data.Persisted` object.
   * This function ensures that the result of an action can be persisted, which is useful for saving the processed data.
   *
   * @param action The partially applied action whose output should be converted to a persisted data object.
   * @returns A `Data.Persisted` object that holds the action's output.
   */
  convertOutputToDataPersisted: function(
    action: !PartiallyAppliedAction
  ): Data.Persisted py
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
