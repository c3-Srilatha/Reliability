remix type ReliabilityExpressionEngineFunction {

  /**
   * Used to get risk score timeseries header names. Wrapper for {@link MlProject.ReliabilityRisk#getRiskScoreHeaderName}.
   */
  @deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
  getRiskScoreHeaderName: function(): !string js-rhino

  /**
   * Retrieves the correct header name for feature contributions sum.
   */
  getFeatureContributionsSumHeaderName: function(): !string js-rhino

  /**
   * Used to get reconstruction timeseries header names. Wrapper for {@link MlProject.ReliabilityRisk#getReconstructionHeaderName}.
   */
  getReconstructionHeaderName: function(sensorId: !string, assetId: string): !string js-rhino

  /**
   * Helper function to fetch and organize training and validation periods for {@link ReliabilityMlModel#trainingValidationPeriods} field
   *
   * Returns a list where return[0] is a list of time ranges for Training Period and return[1] is for Validation Period
   */
  computeTrainingValidationPeriods: function(datasetPreparationRunId: !string): [[TimeRange]] js-rhino
}
