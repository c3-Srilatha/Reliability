/**
 * A relational type to represent timed relations between a {@link ReliabilityAsset} and a {@link ReliabilityRiskMlModel} for model validation.
 */
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityAssetToRiskModelValidationRelation mixes TimedIntervalRelation<ReliabilityAsset, ReliabilityRiskMlModel> schema name 'REL_RARMVR' {

  /**
   * If true, this relation contains model validation data for the
   * {@link ReliabilityRiskMlModel}'s training dataset (`to.datasetPreparationRun`).
   * Otherwise, the validation period for this relation was explicitly set.
   */
  isBasedOnDataset: boolean

  /**
   * The predictions generated by the {@link ReliabilityRiskMlModel}.
   */
  predictions: [ReliabilityRiskScoreMlValidationPredictionHeader] (parent)

  /**
   * The feature contributions used for the predictions.
   */
  contributions: [ReliabilityRiskScoreMlValidationContributionHeader] (parent)

  /**
   * The alerts generated by the {@link ReliabilityRiskMlModel} used for model validation.
   */
  alerts: [ReliabilityAssetValidationAlert] (relation)

  /**
   * A helper function which de-duplicates passed in validation period over all previously run validations for the given relation.
   */
  resolveValidationPeriod: function(relation: !ReliabilityAssetToRiskModelRelation, validationPeriod: !TimeRange): [TimeRange] py

  /**
   * Used to validate the given {@link ReliabilityRiskMlModel} against the {@link ReliabilityAsset} in this relation.
   * Contains logic to do the following things in that sequence:
   * 1. {@link ReliabilityMlModel#process}
   * 2. {@link ReliabilityMlModel#interpret}
   * 3. {@link ReliabilityRiskScoreMlValidationPredictionHeader#refreshNormalization}
   * 4. {@link ReliabilityRiskScoreMlValidationContributionHeader#refreshNormalization}
   * 5. `ReliabilityRiskMlModel#processValidationAlertTimeseries`
   */
  doValidate: member function(validationPeriod: !TimeRange) py
}
