/**
 * A relational type to represent timed relations between a {@link ReliabilityAsset} and a {@link ReliabilityMlModel} for model validation.
 */
extendable entity type ReliabilityAssetToModelValidationRelation mixes TimedIntervalRelation<ReliabilityAsset, ReliabilityMlModel>, FilterableByFacility schema name 'REL_RAMVR' {

  /**
   * The predictions generated by the {@link ReliabilityMlModel}.
   */
  predictions: [ReliabilityMl.ValidationPredictionHeader] (parent)

  /**
   * The feature contributions used for the predictions.
   */
  contributions: [ReliabilityMl.ValidationContributionHeader] (parent)

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["from.facility"]
}
