/**
 * Helper for shared logic in the Model Management Workflows.
 */
type ModelManagementHelper {

  /**
   * Generates a name string by combining a configForPrefix, separator, and suffix. Typically used to
   * produce a default or fallback name when none is explicitly provided.
   * **Note** that configForPrefix needs to be a valid configuration value in {@link ReliabilityMLConfig} to avoid
   * unexpected behaviors.
   *
   * @param configForPrefix
   *   The configForPrefix will access an specific configuration variable in {@link ReliabilityMLConfig}. If not provided,
   *   an exception will be raised.
   * @param suffix
   *   The string to append after the configForPrefix value. If not provided, a {@link Uuid}
   *   will be used as the default value.
   * @param separator
   *   The character or string used to separate the configForPrefix and suffix. If not provided, an
   *   empty space will be used as the default value.
   * @returns
   *   A formatted name string composed of the configForPrefix value, separator, and suffix.
   */
  generateFallbackName: inline function(configForPrefix: !string, suffix: string, separator: string): string py
}
