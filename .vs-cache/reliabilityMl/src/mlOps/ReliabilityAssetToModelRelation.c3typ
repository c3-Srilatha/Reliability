/**
 * A persisted abstract base type representing a timed relation between a {@link ReliabilityAsset} and a {@link ReliabilityMlModel}.
 */
extendable entity type ReliabilityAssetToModelRelation extends MlSubjectToModelRelation<ReliabilityAsset> mixes FeatureEvaluatable, FilterableByFacility type key "RAMR" {

  /**
   * The {@link ReliabilityMlModel} referenced by the relation
   */
  to: !ReliabilityMlModel

  /**
   * Timed predictions for this relation.
   */
  timedMlPredictions: [ReliabilityMl.PredictionHeader] (parent)

  /**
   * Timed contribution for this relation.
   */
  timedMlContributions: [ReliabilityMl.ContributionHeader] (parent)

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["from.facility"]
}
