/**
 * Allows the construction and execution of queries to get training and validation period for
 * {@link ReliabilityMlModel}.
 *
 * The query will return the data of type {@link ReliabilityTrainingAndValPeriodTimedQueryResult}.
 *
 * Usage Example:
 * ```
 * ReliabilityTrainingAndValPeriodTimedDataQuery.make({
 *   model: reliabilityMlModel,
 * }).execute({
 *   startTime: '2023-01-01T00:00:00Z',
 *   endTime: '2023-01-02T00:00:00Z',
 *   interval: 'QUARTER_HOUR',
 * })
 * ```
 */
type ReliabilityTrainingAndValPeriodTimedDataQuery mixes ReliabilityTimedDataSubquery<ReliabilityTrainingAndValPeriodTimedQueryResult> {

  /**
   * The {@link ReliabilityMlModel} from the dataset of which, the training and validation periods will be derived.
   */
  model: !ReliabilityMlModel

  execute: ~ js-rhino
}
