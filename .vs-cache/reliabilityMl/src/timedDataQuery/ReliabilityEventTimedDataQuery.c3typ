/**
 * A {@link ReliabilityTimedDataSubquery} for querying Reliability events. Reliability events are
 * entities that have a timestamp. By default, these entities are filtered by their `meta.created` field, but this can
 * be changed by remixing the {@link #timestampFieldMap}.
 *
 * Just like the timestamp field, the field to filter by asset can be changed by remixing the {@link #assetRefFieldMap}.
 * If not provided, the default field is `parent`.
 *
 *
 * Usage example:
 * ```
 * // Query alerts and work orders between 2010-01-01 and 2011-01-01.
 * ReliabilityEventTimedDataQuery.make({
 *   targetAsset: 'myAsset',
 *   fetchSpecMap: {
 *     'ReliabilityAssetAlert': {
 *       include: 'triggeringModel, parent',
 *       filter: 'triggeringModel.project == "myProject"'
 *     },
 *     'WorkOrder': {
 *       include: 'parent'
 *     }
 *   }
 * }).execute({start: '2010-01-01', end: '2011-01-01'})
 * ```
 * Note that this query can be done with other queries using {@link ReliabilityTimedDataQuery}.
 */
type ReliabilityEventTimedDataQuery mixes ReliabilityTimedDataSubquery<map<string serialized mixing Persistable, FetchResult<any>>> {

  /**
   * The asset to get events for. Used with the {@link #assetRefFieldMap} or
   * {@link #defaultAssetRefField} to filter events by asset.
   */
  targetAsset: !ReliabilityAsset

  /**
   * The initial specs to use to fetch each event type. Also determines the event types to fetch.
   * Additional filters will be added to these specs.
   * The key is the event type, and the value is the fetch spec to use.
   */
  fetchSpecMap: !map<string serialized mixing Persistable, FetchSpec>

  /**
   * The default limit of events of each type that should be fetched.
   * This is used when a given {@link FetchSpec} in {@link #fetchSpecMap} does not have a limit set.
   * Remix this type to change the default limit.
   */
  defaultLimit: const int = 10000

  /**
   * The default timestamp field to do time based filtering on.
   * If the event type is not in the {@link #timestampFieldMap} then this field will be used.
   */
  defaultTimestampField: const string = 'meta.created'

  /**
   * The map of event types to their timestamp fields.
   * This is used to determine the timestamp field to use for each event type.
   * This will be used to filter the events by time.
   * If not present, the {@link #defaultTimestampField} will be used. Remix this type to change the map.
   */
  timestampFieldMap: const map<string serialized Persistable, string> = {
    'ReliabilityAssetAlert': 'timestamp',
    'WorkOrder': 'creationDate',
    'ReliabilityAssetEvent': 'eventStartDatetime'
  }

  /**
   * The default asset reference field to do asset based filtering on.
   * If the event type is not in the {@link #assetRefFieldMap} then this field will be used.
   */
  defaultAssetRefField: const string = 'parent'

  /**
   * The map of event types to their asset reference fields.
   * This is used to determine the asset reference field to use for each event type.
   * This will be used to filter the events by asset.
   * If not present, the {@link #defaultAssetRefField} will be used. Remix this type to change the map.
   * For example, if the event type `Turbine` has value `turbine` in the map, then the query will filter by
   * `turbine == <asset id>`.
   */
  assetRefFieldMap: const map<string serialized Persistable, string> = {}

  execute: ~ js-rhino
}
