/**
 * This type is used for persisting the old lambda implementations during schema migrations so that previous implementations
 * can be referenced if needed.
 */
entity type ReliabilityMl.LegacyLambda {

  /**
   * Optional field to add a description to identify the instance.
   */
  description: string

  /**
   * Field to persist the previous implementation of the {@link Lambda} function.
   */
  previousLambda: !Lambda
}
