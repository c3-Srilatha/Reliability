/**
 * Represents a prediction made by a time-to-event (TTE) forecasting model
 * used to store the predicted time-to-event for a given asset, which is the predicted time until a specific event occurs.
 */
@db(datastore='cassandra',
    partitionKeyField='parent',
    persistenceOrder='start',
    persistDuplicates=false,
    compactType=true,
    shortIdReservationRange=100000)
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityTteForecastPrediction mixes TimedDataPoint<ReliabilityTteForecastPredictionHeader> schema name 'REL_TTEFP' {

  /**
   * The timestamp for which the forecast is generated.
   * This field represents the date and time when the time-to-event forecast was created.
   */
  forecastTimestamp: !datetime

  @ts(treatmentPath="parent.treatment")
  /**
   * The forecasted value for the time to event.
   * This is the predicted time or event occurrence, typically represented as a numeric value.
   */
  forecast: !double
  /**
   * The upper bound of the forecasted range.
   * This field represents the maximum predicted value within the forecast's confidence interval.
   */
  forecastUpperBound: double
  /**
   * The lower bound of the forecasted range.
   * This field represents the minimum predicted value within the forecast's confidence interval.
   */
  forecastLowerBound: double

  /**
   * A threshold against which the forecast is compared to estimate the time to event.
   * This threshold helps in determining whether the forecasted event will happen before or after a specific point in time.
   */
  forecastThreshold: double
}
