/**
 * {@link ReliabilityMlDatasetPreparationRun} refers to a dataset created for a single {@link ReliabilityAsset}.
 * This type represents a dataset created for a population of hierarchically similar {@link ReliabilityAsset}s.
 * A dataset created for a population essentially means that the individual datasets from each asset is vertically
 * stacked/concatenated to created a large enough dataset to train a machine learning model on.
 */
extendable entity type ReliabilityMlPopulationDatasetPreparationRun extends ReliabilityMlDatasetPreparationRunCommon type key 'PPR' {
  
  /**
   * The `assetFilter` is a serialized filter that defines which {@link ReliabilityAsset}s should be included
   * in the dataset for preparation. This filter allows the population of assets to be narrowed down based on 
   * specific criteria, such as asset attributes or statuses.
   */
  assetFilter: !string serialized Filter

  /**
   * This function refits the {@link ReliabilityMlDatasetPreparationRun} for a specific {@link ReliabilityAsset}.
   * It creates a new dataset that is tailored for the provided asset. This refitting may involve reprocessing or
   * restructuring the data to ensure it is specific and relevant to the asset in question. The refitted dataset is
   * then used to update the model's training data.
   *
   * @param assetId
   *        The ID of the {@link ReliabilityAsset} for which the dataset preparation run is being refitted.
   *
   * @returns A new instance of {@link ReliabilityMlDatasetPreparationRun} that is refitted for the specified asset.
   */
  refitForAsset: private member function(
    assetId: !string
  ): !ReliabilityMlDatasetPreparationRun py
}
