/**
 * Common mixin type for {@link ReliabilityMlDatasetPreparationRun} and
 * {@link ReliabilityMlPopulationDatasetPreparationRun}. This entity is not meant to be upserted directly. It exists
 * to produce a unified table for {@link ReliabilityMlDatasetPreparationRun} and
 * {@link ReliabilityMlPopulationDatasetPreparationRun}. {@link ReliabilityMlDatasetPreparationRun} and
 * {@link ReliabilityMlPopulationDatasetPreparationRun} are the entity types that should be upserted.
 */
extendable entity type ReliabilityMlDatasetPreparationRunCommon mixes WithReliabilityMlProject schema name 'RADPR'  {

  /**
   * The {@link ReliabilityMlDatasetPreparationSpec} that was used to
   * generate the datasets detailed in this {@link ReliabilityMlDatasetPreparationRun}.
   */
  spec: private ReliabilityMlDatasetPreparationSpec schema suffix 'SPEC'

  /**
   * The start timestamp of the datasets created as part of
   * {@link ReliabilityMlDatasetPreparationHelper#prepareMlDatasets}.
   */
  start: datetime

  /**
   * The end timestamp of the datasets created as part of
   * {@link ReliabilityMlDatasetPreparationHelper#prepareMlDatasets}.
   */
  end: datetime

  /**
   * The interval used in all the steps of the dataset preparation,
   * specified in {@link ReliabilityMlDatasetPreparationSpec#interval}.
   */
  interval: string enum Interval

  /**
   * This field will report the status of the feature creation step of the
   * overall {@link ReliabilityMlDatasetPreparationHelper#prepareMlDatasets}.
   */
  featurePreparation: ReliabilityMlDatasetPreparationStep schema suffix 'FP'

  /**
   * The dataset corresponding to the features that will be input to the {@link MlModel}.
   */
  featureDatasets: map<string, Feature.Set> schema suffix 'FDS'

  /**
   * The time range used to extract training data from {@link Feature.Set.Snapshot}.
   */
  trainFeatureTimeRanges: map<string, TimeRange> schema suffix 'TFTR'

  /**
   * The time range used to extract validation data from {@link Feature.Set.Snapshot}.
   */
  valFeatureTimeRanges: map<string, TimeRange> schema suffix 'VFTR'

  /**
   * This field will report the status of the masks creation step of the
   * overall {@link ReliabilityMlDatasetPreparationHelper#prepareMlDatasets}.
   */
  maskPreparation: ReliabilityMlDatasetPreparationStep schema suffix 'MP'

  /**
   * The dataset corresponding to the masks that will be input to the {@link MlModel}.
   *
   * The key of the map is a string descriptor for the mask feature set. One example is 'mask_AdHocTraining'.
   */
  maskDatasets: map<string, Feature.Set> schema suffix 'MDS'

  /**
   * The mask time range used to extract training data from {@link Feature.Set.Snapshot}.
   */
  trainMaskTimeRanges: map<string, TimeRange> schema suffix 'TMTR'

  /**
   * The mask time range used to extract validation data from {@link Feature.Set.Snapshot}.
   */
  valMaskTimeRanges: map<string, TimeRange> schema suffix 'VMTR'

  /**
   * This field will report the status of the alertContext creation step of the
   * overall {@link ReliabilityMlDatasetPreparationHelper#prepareMlDatasets}.
   */
  alertContextPreparation: ReliabilityMlDatasetPreparationStep schema suffix 'AP'

  /**
   * The dataset corresponding to the alertContext that will be input to the {@link MlModel}.
   */
  alertContextDatasets: map<string, Feature.Set> schema suffix 'ADS'

  /**
   * This field will report the status of the target creation step of the
   * overall {@link ReliabilityMlDatasetPreparationHelper#prepareMlDatasets},
   * if {@link ReliabilityMlDatasetPreparationSpec#evaluateTarget} is `true`.
   */
  targetPreparation: ReliabilityMlDatasetPreparationStep schema suffix 'TP'

  /**
   * The dataset corresponding to the targets that will be input to the {@link MlModel}.
   */
  targetDatasets: map<string, Feature.Set> schema suffix 'TDS'

  /**
   * The target time range used to extract training data from {@link Feature.Set.Snapshot}.
   */
  trainTargetTimeRanges: map<string, TimeRange> schema suffix 'TTTR'

  /**
   * The target time range used to extract validation data from {@link Feature.Set.Snapshot}.
   */
  valTargetTimeRanges: map<string, TimeRange> schema suffix 'VTTR'

  /**
   * This field will report the status of the dataset splitting step of the
   * overall {@link ReliabilityMlDatasetPreparationHelper#prepareMlDatasets}.
   */
  trainValSplit: ReliabilityMlDatasetPreparationStep schema suffix 'TVS'

  /**
   * Use this in `x` argument of {@link ReliabilityMlModel#createReliabilityModel}.
   * This field represents the feature sets that are used as input variables (`x`) for training the machine learning model.
   */
  xFeatures: map<string, Feature.Set>

  /**
   * The list of features that will be used in training an {@link MlModel}.
   * The list, and the order of feature names in this field will be the same
   * as if one were to fetch the feature names by keying into `features` in
   * {@link xFeatures}.
   */
  features: private [string] schema suffix 'FTRS'

  /**
   * A convenience field that represents the length of the {@link features}
   * array, giving the total number of features to be used in the model.
   */
  numFeatures: private int

  /**
   * Use this in `y` argument of {@link ReliabilityMlModel#createReliabilityModel}.
   * This field represents the target feature sets (`y`) for training the machine learning model.
   */
  yFeatures: map<string, Feature.Set>

  /**
   * Overall status of {@link ReliabilityMlDatasetPreparationHelper#prepareMlDatasets}.
   * This indicates whether the dataset preparation process is in progress, complete, or has failed.
   */
  status: string enum('IN PROGRESS', 'COMPLETE', 'FAILED')

  /**
   * The sensors included in the dataset preparation run.
   * This is a list of sensors that contributed to the dataset used for training.
   */
  includeSensors: [Sensor]

  /**
   * The sensors excluded from the dataset preparation run.
   * This is a list of sensors that were not considered in the dataset used for training.
   */
  excludeSensors: [Sensor]

  /**
   * The {@link Feature.Set.Snapshot} ids for the training period associated with this run,
   * for each {@link Feature.Set} in {@link #xFeatures} and {@link #yFeatures}.
   */
  trainSnapshots: map<string, map<string, string>>

  /**
   * The {@link Feature.Set.Snapshot} ids for the validation period associated with this run,
   * for each {@link Feature.Set} in {@link #xFeatures} and {@link #yFeatures}.
   */
  valSnapshots: map<string, map<string, string>>

  /**
   * Returns the subject filter used for this dataset preparation run.
   *
   * @return
   *    The subject filter used for this dataset preparation run.
   */
  subjectFilter: member function(): !string py

  /**
   * Creates a {@link Workflow} that creates {@link Feature.Set.Snapshot}s for the
   * {@link #xFeatures} and {@link #yFeatures}, for the train and validation periods.
   */
  createSnapshotsWorkflow: private member function(): !Workflow py

  /**
   * Creates and starts a {@link Workflow} that creates {@link Feature.Set.Snapshot}s for the
   * {@link #xFeatures} and {@link #yFeatures}, for the train and validation periods.
   */
  startSnapshotsWorkflow: member function(): !Workflow.Run py

  /**
   * Upon the successful creation of the snapshots, this method will update the {@link #trainSnapshots}
   * and {@link #valSnapshots} with the snapshot ids that were created. This is the final step of the
   * create snapshots workflow.
   */
  updateSnapshots: member function(
    trainSnapshotIds: map<string, map<string, string>>,
    valSnapshotIds: map<string, map<string, string>>
  ) py
}
