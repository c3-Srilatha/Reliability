/**
 * This spec is used to configure how to generate plots using the `ReliabilityMlDatasetPreparationRun#plot` API.
 */
type ReliabilityMlDatasetPreparationRunPlottingSpec mixes ReliabilityMlDatasetPreparationRunComputeDataSpec {

  /**
   * By default, the plots will be generated for all the masks that are applied during training. If the user wants to
   * plot the default masks that are applied during inference, the user can set this field to
   * ```
   * masksToUse = ['mask_IsAssetNotOperational', 'mask_AssetEvent', 'mask_PostAssetEvent', 'mask_AdHocInference']
   * ```
   *
   */
  masksToUse: ~ = [
    'mask_IsAssetNotOperational',
    'mask_AssetEvent',
    'mask_PreAssetEvent',
    'mask_PostAssetEvent',
    'mask_AdHocTraining',
    'mask_AlgorithmicallyComputed'
  ]

  /**
   * The time period for which the plots will be generated. By default, plots are generated for the  `training` period.
   */
  timePeriod: ~ = 'training'
}
