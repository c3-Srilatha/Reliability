/**
 * An implementation of the abstract type {@link AlgorithmicallyComputedTrainingMaskTechnique}, that implements
 * an Isolation Forest algorithm to compute anomalous periods to mask out training data, and can be used in
 * {@link ReliabilityMlDatasetPreparationHelper#prepareAlgorithmicallyComputedTrainingMask}.
 */
type IsolationForestTrainingMaskTechnique mixes AlgorithmicallyComputedTrainingMaskTechnique {

  /**
   * The contamination for the Isolation Forest algorithm. This is the amount of contamination
   * of the data set, i.e. the proportion of outliers contained in the data set
   */
  contaminationFactor: double = 0.01

  doPrepareMask: ~ py-sklearn
}
