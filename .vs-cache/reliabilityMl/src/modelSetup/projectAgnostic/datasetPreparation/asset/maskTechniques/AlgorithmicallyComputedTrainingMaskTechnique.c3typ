/**
 * Abstract type that users can extend and implement their own technique to compute anomalous periods within the
 * training data. A user can extend and implement the {@link doPrepareMask} method to mask out data corresponding
 * to anomalous periods.
 *
 * Here is a simple example to explain how the pipe can be extended and implemented. This example simply masks all data
 * before February 2023.
 *
 * type MyCustomMaskingTechnique mixes AlgorithmicallyComputedTrainingMaskTechnique {
 *
 * doPrepareMask: ~ py-sklearn
 *
 * }
 *
 * Python Implementation:
 * ```python
 * def doPrepareMask(this, featuresData, masks):
 *   from datetime import datetime
 *   features_data = featuresData.toPandas()
 *   features_data['Mask'] = [int(i < datetime(2023, 2, 1, 0, 0)) for i in features_data.index.get_level_values(level=1)]
 *   return c3.Data.from_pandas(features_data[['Mask']])
 * ```
 */
abstract type AlgorithmicallyComputedTrainingMaskTechnique {

  /**
  * After a list of anomalous periods are detected, if two periods are separated by less than `anomalousMergeSpan` time,
  * the two periods will be merged - the period between them is also masked. If set to null duration `"0h"`, this
  * transformation is not applied.
  */
  anomalousPeriodsMergeSpan: Duration = '24h'

  /**
   * Allows users to specify a list of masks that they want to apply to the input features data before computing the anomalous
   * periods in {@link AlgorithmicallyComputedTrainingMaskTechnique#doPrepareMask}
   * All masks in {@link ReliabilityMlDatasetPreparationMaskCategory} can be specified, except for `mask_AlgorithmicallyComputed`
   *
   * Note that if the {@link ReliabilityMlDatasetPreparationSpec#approach} is `sequential`, then the masks specified here
   * must be specified before the `mask_AlgorithmicallyComputed` mask. If not specified before `mask_AlgorithmicallyComputed`,
   * then these masks will not be applied to the input features data.
   */
  masksToUse: [string enum ReliabilityMlDatasetPreparationMaskCategory] = ['mask_IsAssetNotOperational', 'mask_AssetEvent']

  /**
   * This method creates a map of all the masks to their corresponding {@link Data} instances. This method then calls
   * doPrepareMask, and the map is passed to the `masksDataMap` parameter, which the user can use to mask data
   * before the anomalous periods computation.
   */
  prepareMask: member function(
    featuresData: Data,
    masks: map<string, Data>
    ): !Data py-data

  /**
   * A user can override this function in the concrete type that mixes {@link AlgorithmicallyComputedTrainingMaskTechnique},
   * to implement the logic to mask out anomalous periods in the features data.
   * The method should return a {@link Data} object that should contain timestamps corresponding
   * to the input data as index, and a single column output which contains 0s and 1s, with 0s corresponding to timestamps
   * that should be used for training, and 1s corresponding to timestamps that should be masked out during training.
   */
  doPrepareMask: abstract member function(
    featuresData: Data,
    masks: map<string, Data>
    ): !Data py-data

  /**
   * Helper method to convert a mask into the start end tuples of each masked period.
   * @param mask
   *     `pandas.Series` with `1` for masked data and `0` for unmasked data.
   * @return
   *     Array of `[start, end]`, describing the start and end of each masked period.
   */
  convertMaskIntoStartEndTuples: private inline function(
    mask: !native
    ): ![[datetime]] py-data

  /**
   * Helper method to merge anomalous periods based on {@link anomalousPeriodsMergeSpan}. Both input and output
   * are `pandas.Series` with `1` for masked data and `0` for unmasked data.
   */
  mergeAnomalousPeriods: private member function(
    mask: !native
    ): !native py-data

}
