/**
 * Type to run preliminary validation checks on data loaded into the Reliability Data Model.
 * If the data validations do not pass, then the user should not proceed to downstream ML tasks such
 * as model training.
 */
type ReliabilityAssetRules {

  /**
   * Get the number of associated {@link Sensor instrumented sensors} with this
   * {@link ReliabilityAsset}.
   * @param assetId
   *    The id of the asset to perform this check on.
   * @return
   *    Returns an int with the number of {@link Sensor instrumented sensors} linked to this
   *    {@link ReliabilityAsset}.
   */
  numberOfSensorsInstrumented: private function(assetId: !string): !int js-rhino

  /**
   * Get the number of associated {@link ReliabilityAssetEvent}s with this
   * {@link ReliabilityAsset}.
   * @param assetId
   *    The id of the asset to perform this check on.
   * @return
   *    Returns an int with the number of {@link ReliabilityAssetEvent}s linked to this
   *    {@link ReliabilityAsset}.
   */
  numberOfEvents: private function(assetId: !string): !int js-rhino

  /**
   * Checks if {@link ReliabilityAssetEvent}s exists for this {@link ReliabilityAsset}.
   * @param args
   *    Map that contain the assetid to perform this check on.
   * @return
   *    Returns a {@link DataValidationRuleResult} with `output` "COMPLETE" if
   *    {@link ReliabilityAssetRules#numberOfEvents} > 0, or `output` "FAILED" otherwise.
   */
  doEventsExist: function(args: map<string, any>): DataValidationRuleResult js-rhino

  /**
   * Get the number of associated {@link Sensor}s with this {@link ReliabilityAsset}.
   * @param assetId
   *    The id of the asset to perform this check on.
   * @return
   *    Returns an int with the number of {@link Sensor}s linked to this {@link ReliabilityAsset}.
   */
  numberOfSensorsForMl: private function(assetId: !string): !int js-rhino

  /**
   * Checks if {@link ExpectedSensor}s exists for this {@link ReliabilityAsset}
   * @param args
   *    Map that contain the assetid to perform this check on.
   * @return
   *    Returns a {@link DataValidationRuleResult} with `output` "COMPLETE" if at least exist one
   *    {@link Sensor} to this {@link ReliabilityAsset}, or `output` "FAILED" otherwise.
   */
  doSensorsExistForMl: function(args: map<string, any>): DataValidationRuleResult js-rhino

  /**
   * Get the list of associated {@link ExpectedSensor}s with this {@link ReliabilityAsset}
   * with their time series data Unnormalized.
   * @param assetId
   *    The sensor to perform this check on.
   * @return
   *    Returns a list of unnormalized {@link Sensor}s .
   */
  unnormalizedSensors: private function(assetId: !string): [Sensor] js-rhino

  /**
   * Checks if the {@link Sensor} have a time series data normalized
   * @param sensor
   *    The sensor to perform this check on.
   * @return
   *    Returns false if any unnormalized series exist, otherwise true
   */
  isSensorNormalized: private function(sensor: !Sensor): !boolean js-rhino

  /**
   * Get the number of associated {@link Sensor}s with this {@link ReliabilityAsset} with
   * their time series data unnormalized.
   * @param assetId
   *    The id of the asset to perform this check on.
   * @return
   *    Returns an int with the number of unnormalized {@link Sensor}s linked to this
   *    {@link ReliabilityAsset}.
   */
  numberOfUnnormalizedSensors: private function(assetId: !string): !int js-rhino

  /**
   * Checks if all associated {@link Sensor}s with this {@link ReliabilityAsset} has
   * their time series data.
   * @param args
   *    Map that contain the assetid to perform this check on.
   * @param limit
   *    Value retrieved from config file to limit number of sensors fetched
   * @return
   *    Returns a {@link DataValidationRuleResult} with `output` "COMPLETE" if all the
   *    {@link Sensor}s with their time series data normalized, or `output`
   *    "FAILED" otherwise.
   */
  doSensorsHasPointPhysicalMeasurementSeries: function(args: map<string, any>, limit: int): DataValidationRuleResult js-rhino

  /**
   * Checks if all associated {@link Sensor}s with this {@link ReliabilityAsset} with
   * their time series data normalized.
   * @param args
   *    Map that contain the assetid to perform this check on.
   * @return
   *    Returns a {@link DataValidationRuleResult} with `output` "COMPLETE" if all the
   *    {@link Sensor}s with their time series data normalized, or `output`
   *    "FAILED" otherwise.
   */
  areSensorsNormalized: function(args: map<string, any>): DataValidationRuleResult js-rhino

  /**
   * Get the {@link AssetClass} associated with this {@link ReliabilityAsset}.
   * @param asset
   *    The asset to perform this check on.
   * @return
   *    Returns an {@link AssetClass} if {@link ReliabilityAsset#assetClass} is
   *    set, or null otherwise.
   */
  getAssetClass: private function(asset: !ReliabilityAsset): AssetClass js-rhino

  /**
   * Checks if {@link AssetClass} exists for this {@link ReliabilityAsset}.
   * @param args
   *    Map that contain the assetid to perform this check on.
   * @return
   *    Returns a {@link DataValidationRuleResult} with `output` "COMPLETE" if
   *    {@link ReliabilityAsset#assetClass} is set, or `output` "WARNING" otherwise.
   */
  doesAssetClassExist: function(args: map<string, any>): DataValidationRuleResult js-rhino

  /**
   * Checks the {@link ExpectedSensor}s associated with this {@link ReliabilityAsset}.
   * @param asset
   *    The asset to perform this check on.
   * @return
   *    Returns an array of {@link ExpectedSensor}s.
   */
  getExpectedSensors: private function(asset: !ReliabilityAsset): [ExpectedSensor] js-rhino

  /**
   * Checks if {@link ExpectedSensor}s associated with this {@link ReliabilityAsset} have
   * a linked {@link Sensor}.
   * @param args
   *    Map that contain the assetid to perform this check on.
   * @return
   *    Returns a {@link DataValidationRuleResult} with `output` "COMPLETE" if at least exist
   *    one {@link ExpectedSensor} and all those {@link ExpectedSensor}s have a linked {@link Sensor},
   *    or `output` "WARNING" otherwise.
   */
  getExpectedSensorsWithoutSensor: function(args: map<string, any>): DataValidationRuleResult js-rhino

  /**
   * Checks if {@link Sensor}s associated with this {@link ReliabilityAsset} have a
   * linked {@link ExpectedSensor}.
   * @param args
   *    Map that contain the assetid to perform this check on.
   * @return
   *    Returns a {@link DataValidationRuleResult} with `output` "COMPLETE" if all
   *    {@link Sensor}s have a linked {@link ExpectedSensor}, or `output` "WARNING" otherwise.
   */
  getSensorsWithoutExpectedSensor: function(args: map<string, any>): DataValidationRuleResult js-rhino

  /**
   * Checks if {@link FailureModeLibrary} exists for this {@link ReliabilityAsset}.
   * @param args
   *    Map that contain the assetid to perform this check on.
   * @return
   *    Returns a {@link DataValidationRuleResult} with `output` "COMPLETE" if the linked
   *    {@link AssetClass#failureModeLibrary} is set, or `output` "WARNING" otherwise.
   */
  doesFailureModeLibraryExist: function(args: map<string, any>): DataValidationRuleResult js-rhino

  /**
   * Create a {@link Feature} for one {@link Sensor}.
   * @param sensor
   *    The sensor to create the Feature.
   * @param interval
   *    nterval for the feature creation.
   * @return
   *    Returns a {@link Feature}.
   */
  createFeature: private function(sensor: !Sensor, interval: !string enum Interval): !Feature js-rhino

  /**
   * This function returns the ids of all the instrumented sensors of the asset that does not have a ReliabilityAssetSensorRelation with the asset.
   * An instrumented sensor is a sensor related to an asset by a ReliabilityAssetSensorHierarchicalRelation.
   * @param assetId
   *    Asset id.
   * @return
   *    Returns an array of instrumented sensors.
   */
  getSensorsForMlNotInstrumentedIds: private function(assetId: !string): ![Sensor] js-rhino

  /**
   * This function returns all the sensors related to this asset that does not have a PointPhysicalMeasurementSeries.
   * @param assetId
   *    Asset id.
   * @return
   *    Returns a array of the ids of sensors.
   */
  sensorsWithoutPointPhysicalMeasurementSeries: private function(assetId: !string): ![Sensor] js-rhino
}
