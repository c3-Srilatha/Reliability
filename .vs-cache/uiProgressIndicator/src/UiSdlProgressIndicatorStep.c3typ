/**
 * A UI component type that displays a step
 * as part of a larger sequence of steps in a parent {@link UiSdlProgressIndicator} component
 */
@typeScript
 type UiSdlProgressIndicatorStep {

  /**
   * An id that can optionally be associated with this step.
   * Not used by the progress indicator, but can be useful for custom transforms/epics.
   */
  id: string

  /**
   * The main text describing what this step is about
   */
  title: UiSdlDynamicValueSpec | string

  /**
   * The smaller text below the main title for any additional information about the step
   */
  subtitle: UiSdlDynamicValueSpec | string

  /**
   * Title to show in banner above children. Only displayed if
   * {@link UiSdlProgressIndicatorChildrenContainerSettings} sets `showBanner` to true
   */
  bannerTitle: UiSdlDynamicValueSpec | string

  /**
   * Subtitle to show in banner above children. Only displayed if
   * {@link UiSdlProgressIndicatorChildrenContainerSettings} sets `showBanner` to true
   */
  bannerSubtitle: UiSdlDynamicValueSpec | string

  /**
   * Whether the step is disabled or not. If disabled it will appear at a dimmer opacity and have no pointer events.
   */
  isDisabled: boolean = false

  /**
   * The status of a step that will reflect in the step's left border color and icon. Will also show in the
   * banner if present.
   */
  status: string enum('complete', 'incomplete', 'warning', 'error')

  /**
   * Array of {@link UiSdlProgressIndicatorStep} substeps that are nested underneath a given step
   */
  substeps: [UiSdlProgressIndicatorStep]

  /**
   * A array of objects containing component Id strings used to render a NestedComponent for this step
   */
  children: [any]
}
