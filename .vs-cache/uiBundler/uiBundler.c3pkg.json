{
  "name": "uiBundler",
  "description": "Compile and deploy front-end projects using Webpack",
  "author": "studio <studio@c3.ai>",
  "version": "8.9.0",
  "compatibleToVersion": "8.7",
  "dependencies": {
    "testtools": "8.9",
    "esPackageContainer": "8.9"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@c3/c3-base",
      "plugin:@c3/typescript",
      "plugin:@c3/react",
      "plugin:jsx-a11y/recommended",
      "plugin:prettier/recommended"
    ],
    "plugins": [
      "@c3"
    ],
    "settings": {
      "react": {
        "version": "16.13.1"
      }
    }
  }
}
