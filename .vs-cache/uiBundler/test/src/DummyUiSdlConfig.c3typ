/**
 * This is a Test config to mimic @{link UiSdlConfig}
 */
type DummyUiSdlConfig mixes Config, DefaultInstance {

  inst: ~ js-server

  /**
   * Configs for the infrastructure of the Webpack Bundler.
   */
  infrastructure: DummyUiSdlInfrastructureConfig = {}

  /**
   * Gets the infrastructure webpack mode. If not set, fall back based on the App mode:
   * return 'development' for 'dev' and 'trial' App mode, or 'production' for 'prod' and 'test' mode.
   */
  getWebpackMode: function(): string js-server

 /**
  * Retrieves the bundler max memory by getting the infrastructure.bundlerMaxMem config value.
  */
  getBundlerMaxMem: function(): int js-server
}
