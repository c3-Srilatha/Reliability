/**
 * IMPORTANT: This is a test type and it doesn't extend {@link UiBundlerExtension} to avoid running
 * it when developers deploy with test files.
 *
 * This type is going to be used by our tests by mocking {@link UiTagMetadataStore#typesThatMixin}
 * and returning a TypeRef to this type.
 */
type DummyUiBundlerExtension {

  /**
   * Executed when all batches have successfully finished and before the generated
   * code bundles are stored in the tag's `TagMetadataStore`.
   *
   * @param job Reference to the corresponding {@link UiBundler} job.
   */
  onAllCompleteBeforeBundleDeployment: function(job: UiBundler) js-server
}
