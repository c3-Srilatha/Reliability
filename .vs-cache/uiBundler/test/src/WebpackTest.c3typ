/**
 * Test type to test {@link Webpack} type functionality.
 */
type WebpackTest {

  /**
   * Generate UI configuration used to run the webpack compiler.
   */
  generateUiConfig: function(namespace: !string) js-server

  /**
   * Generate test contents of a Webpack config.
   */
  configContents: private function(): [string] js-server
}
