/**
 * A custom {@link BatchJobStatus} for {@link UiBundler}. It adds fields to expose the webpack stats and performance profile.
 */
type UiBundlerStatus mixes BatchJobStatus {

  /**
   * A list of {@link BundleStatus} that contains the status of each batch for this job.
   */
  bundleStatuses: [BundleStatus]

  /**
   * The performance profile from {@link UiBundlerPerformanceProfile}.
   */
  performanceProfile: UiBundlerPerformanceProfile
}
