/**
 * Each entry is a method in the Webpack type.
 *
 * This enum is used in Webpack.sharedRuntimeExecutor to specify which method has to be run from
 * the shared runtime directory.
 */
enum type WebpackStep {

  /**
   * The step to call {@link Webpack#setupWorkingDirectory} function.
   */
  SETUP_WORKING_DIR

  /**
   * The step to call {@link Webpack#getConfigsCount} function.
   */
  GET_CONFIGS_COUNT

  /**
   * The step to call {@link Webpack#getConfigNames} function.
   */
  GET_CONFIG_NAMES

  /**
   * The step to call {@link Webpack#run} function.
   */
  RUN
}
