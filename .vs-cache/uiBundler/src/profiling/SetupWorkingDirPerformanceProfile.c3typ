/**
 * Used to report {@link WebpackBundler#setupWorkingDir} performance profiling results.
 */
entity type SetupWorkingDirPerformanceProfile schema name 'SPP' {

  /**
   * The {@link UiBundlerPerformanceProfile} this profile belongs to.
   */
  uiBundlerPerformanceProfile: !UiBundlerPerformanceProfile

  /**
   * Path to the config file for which the working dir was set up, e.g. c3/config/webpack.config.js
   */
  configPath: !string

  /**
   * The time it took in seconds for {@link WebpackBundler#setupWorkingDir} to execute.
   */
  setupWorkingDirTime: int
}
