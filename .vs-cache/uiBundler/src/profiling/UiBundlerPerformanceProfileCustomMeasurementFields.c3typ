/**
 * Used to report UiBundler performance profiling results.
 */
type UiBundlerPerformanceProfileCustomMeasurementFields {

  /**
   * The time spent setting up the shared runtime executor, in seconds.
   */
  sharedRuntimeExecutorSetupTime: float = 0

  /**
   * The total time spent processing batches, in seconds.
   */
  batchProcessingTime: float = 0

  /**
   * The time it took for {@link UiBundler#allComplete} to run, in seconds.
   */
  allCompleteTime: float = 0

  /**
   * The total duration of the job, in seconds.
   */
  totalTime: float = 0

  /**
   * Setup working directory total time, in seconds.
   */
  setupWorkingDirTimeSum: float = 0

  /**
   * Setup working directory average time, in seconds.
   */
  setupWorkingDirTimeAvg: float = 0

  /**
   * Setup working directory maximum time, in seconds.
   */
  setupWorkingDirTimeMax: float = 0

  /**
   * Setup working directory minimum time, in seconds.
   */
  setupWorkingDirTimeMin: float = 0

  /**
   * Setup working directory median time, in seconds.
   */
  setupWorkingDirTimeMedian: float = 0

  /**
   * Setup working directory 75th percentile of time, in seconds.
   */
  setupWorkingDirTimeP75: float = 0

  /**
   * Setup working directory 90th percentile of time, in seconds.
   */
  setupWorkingDirTimeP90: float = 0

  /**
   * Bundling batches total time, in seconds.
   */
  bundlingTimeSum: float = 0

  /**
   * Bundling batches average time, in seconds.
   */
  bundlingTimeAvg: float = 0

  /**
   * Bundling batches maximum time, in seconds.
   */
  bundlingTimeMax: float = 0

  /**
   * Bundling batches minimum time, in seconds.
   */
  bundlingTimeMin: float = 0

  /**
   * Bundling batches median time, in seconds.
   */
  bundlingTimeMedian: float = 0

  /**
   * Bundling batches 75th percentile of time, in seconds.
   */
  bundlingTimeP75: float = 0

  /**
   * Bundling batches 90th percentile time, in seconds.
   */
  bundlingTimeP90: float = 0

  /**
   * Webpack (subset of "Bundling batches" time) total time, in seconds.
   */
  webpackTimeSum: float = 0

  /**
   * Webpack (subset of "Bundling batches" time) average time, in seconds.
   */
  webpackTimeAvg: float = 0

  /**
   * Webpack (subset of "Bundling batches" time) maximum time, in seconds.
   */
  webpackTimeMax: float = 0

  /**
   * Webpack (subset of "Bundling batches" time) minimum time, in seconds.
   */
  webpackTimeMin: float = 0

  /**
   * Webpack (subset of "Bundling batches" time) median time, in seconds.
   */
  webpackTimeMedian: float = 0

  /**
   * Webpack (subset of "Bundling batches" time) 75th percentile time, in seconds.
   */
  webpackTimeP75: float = 0

  /**
   * Webpack (subset of "Bundling batches" time) 90th percentile time, in seconds.
   */
  webpackTimeP90: float = 0

  /**
   * Number of bundle batches.
   */
  batchNumber: float = 0

}
