/**
 * Used to report {@link Webpack} performance profiling results.
 */
entity type WebpackPerformanceProfile schema name 'WPP' {

  /**
   * The {@link UiBundlerPerformanceProfile} this profile belongs to.
   */
  uiBundlerPerformanceProfile: UiBundlerPerformanceProfile

  /**
   * The name of the entryPoint of the bundle if only one, otherwise null.
   */
  entryPointName: string

  /**
   * The config names corresponding to {@link WebpackBundler#run}
   */
  configNames: [string]

  /**
   * The time to run bundler, in seconds.
   */
  bundlerRunTime: int

  /**
   * The end-to-end time it took to run {@link WebpackBundler#run},
   * in seconds.
   */
  bundlingTime: int

  /**
   * The reported time from {@link Webpack}, in seconds.
   */
  webpackTime: int

  /**
   * The time it took to upload files to Pkg.Store.
   */
  fileUploadTime: int

  /**
   * The time it took to write contents to Pkg.Store
   */
  writeContentsTime: int

  /**
   * The number of files uploaded.
   */
  fileNumbers: int

  /**
   * The size of the uploaded files, in bytes.
   */
  fileUploadSize: int

  /**
   * The max memory for the bundle, in megabytes.
   */
  maxMemory: int
}
