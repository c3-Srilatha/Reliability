/**
 * Base type for all Webpack extensions.
 * Types mixing in WebpackExtension have to be annotated with `@webpack` and specify the ui
 * that they are applicable to.
 * @see Ann.Webpack
 */
type WebpackExtension {

  /**
   * Implementation for the webpack extension. Mixin types override this method to perform
   * extra steps before webpack is run.
   * This method will be run in a node js
   */
  run: abstract inline function(namespace: string, cwd: string)
}
