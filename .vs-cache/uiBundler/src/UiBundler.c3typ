/**
 * Generates code bundles for frontend code delivery to browsers.
 *
 * This bundler takes all the configuration files in the MetadataStore
 * under `/ui/NAMESPACE/config/webpack.config.js` and runs the
 * webpack compiler for each of them with {@link Webpack#runWithConfig}.
 *
 * When enabled, it will automatically run after provisioning is finished.
 */
@restful(endpoint='ui-bundler', serveContent=true)
entity type UiBundler extends BatchJob<UiBundler, BatchJobOptions, WebpackRunSpec> type key 'UiBNDLR' {

  /**
   * UiBundler jobs are not recoverable. To run the bundler use {@link UiBundler#generateBundles}.
   * @return null
   */
  recover: ~ js-server

  /**
   * The stats returned by webpack after processing batches.
   */
  bundleStatuses: [BundleStatus](job)

  /**
   * The performance profile of this UI Bundler job.
   */
  performanceProfile: UiBundlerPerformanceProfile(job)

  /**
   * Calls {@link Webpack#runWithConfig} for each `ui/NAMESPACE/config/webpack.config.js`
   * file as a {@link BatchJob}.
   */
  generateBundles: function() js-server

  /**
   * Retrieves the status of the latest run. It includes error messages and webpack bundle stats.
   *
   * Note that any errors reported by webpack will be exposed in each bundle stat.
   * Runtime errors happening outside of webpack, will be exposed in as a normal {@link BatchJob} error.
   */
  latestStatus: function(): UiBundlerStatus js-server

  /**
   * Preload {@link UiBundler} status page into tag's `TagMetadataStore`from a template file:
   * /repo/server/uiBundler/ui/content/bundler-status.html
   * This shows the {@link UiBundler} status page while UiBundler job is running.
   */
  upsertUiBundlerStatusPageToMetadataStore: function(overwriteExistingIndex: boolean = true) js-server

  /**
   * Finds the webpack config files and schedules a webpack run for each.
   */
  @action(authz='always')
  doStart: ~ js-server

  /**
   * Runs webpack for a given webpack configuration.
   */
  processBatch: ~ js-server

  /**
   * Uploads the generated files.
   */
  allComplete: ~ js-server

  /**
   * Cleans temporary generated files when bundling process fails.
   */
  failed: ~ js-server

  /**
   * Deletes the working directory used to run the bundler.
   *
   * @return true if deletion was successful.
   */
  cleanWorkDir: function(): boolean js-server

  /**
   * Returns a map of files generated by {@link UiBundler}.
   * @param rootPkgOnly Whether to only return bundles for the root package.
   */
  retrieveUiBundlerResults: function(rootPkgOnly: boolean): map<string, ContentValue> js-server

  /**
   * Returns a zip file that contains all files generated by {@link UiBundler}.
   * The zip file can be extracted and committed to the repository to skip bundling on provisioning.
   * Note-1: UiBundlerConfig.keepUiBundlerResults should be true otherwise the API returns an empty archive!
   * Note-2: Make sure the server has enough memory to hold all bundles otherwise this API will crush the server!
   *
   *   wget --user USERNAME --password PASSWORD -O bundles.tgz 'VANITY_URL/api/1/ui-bundler/bundles.tgz?rootPkgOnly=true'
   *   tar --strip-components=2 -zxvf bundles.tgz
   *   cp -r ui/content/c3/* PATH_TO_THE_PKG/ui/content/c3/
   */
  @restful(subPath='bundles.tgz')
  retrieveUiBundlerResultsAzTgz: function(@restful(paramsArg='rootPkgOnly')
                                          rootPkgOnly: boolean): !ContentValue js-server

  /**
   * Checks whether code coverage is enabled in the current tag.
   */
  isCodeCoverageEnabled: function(): boolean js-server

  /**
   * Creates batches for all configNames considering the bundler mode and configs.
   */
  batchConfigs: private function(configNames: [string], mode: string enum('development', 'production'), config: UiBundlerConfig): [[string]] js-server

  /**
   * Checks the app mode to see if it is in PROD mode
   * Throws an appropriate error if it is.
   */
  verifyAppMode: private function() js-server

  /**
   * Checks the {@link Pkg} to see if contents are be writable.
   * Throws an error if Pkg is not writable.
   */
  verifyPkgIsUpdatable: private function() js-server

  /**
   * Return all files in the app matching regex `.*\/ui/{namespace}/(?!content|meta).*`.
   *
   * @param namespace
   *           the UI namespace. This is used to separate different UI frameworks or standalone UI configurations.
   * @return key in the map are encodedSubPaths of the Pkg.Files, values are the file content as strings
   */
  produceUiFiles: function(namespace: !string): map<string, string>  js-server
}
