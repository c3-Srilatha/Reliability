/**
 * Provides extension points for {@link UiBundler}. When a type mixes {@link UiBundlerExtension},
 * it can provide implementation to any number of extension functions that will be
 * executed at various steps of the {@link UiBundler} job lifecycle.
 */
abstract type UiBundlerExtension {

  /**
   * Executed when all batches have successfully finished and before the generated
   * code bundles are stored in the tag's `TagMetadataStore`.
   *
   * @param job Reference to the corresponding {@link UiBundler} job.
   */
  onAllCompleteBeforeBundleDeployment: function(job: UiBundler)

  /**
   * Executed when the UiBundler batch job is starting.
   *
   * @param job Reference to the corresponding {@link UiBundler} job.
   */
  onStart: function(job: UiBundler)
}
