/**
 * Bundler status.
 */
entity type BundleStatus schema name 'BLST' {

  /**
   * Job.
   */
  job: !UiBundler

  /**
   * Namespace.
   */
  namespace: !string

  /**
   * Config path.
   */
  configPath: !string

  /**
   * Config names.
   */
  configNames: ![string]

  /**
   * {@link Webpack} working directory.
   */
  workingDir: string

  /**
   * Maximum memory usage in megabytes.
   */
  maxMemory: int

  /**
   * {@link Webpack} status.
   */
  webpackStatus: !WebpackStatus schema suffix 'WS'
}
