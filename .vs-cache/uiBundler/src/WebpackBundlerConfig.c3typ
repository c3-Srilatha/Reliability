/**
 * WebpackBundlerConfig provides the information for the webpack bundling Configurations when UiSdlConfig does not exist.
 * This is used when uiBundler is a dependent package and users do not want to include uiInfrastructure as a dependent package.
 */
type WebpackBundlerConfig mixes Config, DefaultInstance {

  inst: ~ js-server

  /**
   * The webpack mode to use when bundling. If not set, fall back based on the App mode:
   * return 'development' for 'dev' and 'test' App mode, or 'production' for 'prod' and 'trial' mode.
   */
  webpackMode: string enum('development', 'production')

  /**
   * The maximum memory to use when bundling. Default is 4096.
   */
  bundlerMaxMem: int = 4096

  /**
   * The handler used to switch between Configs when bundling.
   */
  handler: Type<Config> = "WebpackBundlerConfig"

  /**
   * Returns the bundler webpack mode.
   */
  getWebpackMode: function(): string js-server

  /**
   * Returns the maximum memory to use when bundling.
   */
  getBundlerMaxMem: function(): int js-server

  /**
   * Gets the webpack mode by webpackMode if it is set, otherwise fall back based on the App mode:
   * return 'development' for 'dev' and 'test' App mode, or 'production' for 'prod' and 'trial' mode.
   */
  findWebpackMode: private function(appMode: string, webpackMode: string): string js-server
}
