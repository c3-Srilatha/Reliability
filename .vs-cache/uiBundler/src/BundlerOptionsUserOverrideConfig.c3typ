/**
 * IMPORTANT: This config is for Platform UI team internal use only.
 *
 * Configuration to override options for VSCE bundler. This cannot be used for {@link UiBundler#generateBundles}.
 */
@config(maxOverride=APP)
@beta
type BundlerOptionsUserOverrideConfig mixes Config, DefaultInstance {
  inst: ~ js-server

  /**
   * Options to override bundler.
   */
  options: BundlerOptions
}
