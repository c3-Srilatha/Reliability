/**
 * Temporary store for {@link UiBundler}'s generated files.
 *
 * Each {@link UiBundler} batch may store one or more UiBundlerResults to deploy
 * them to the current Tag's `TagMetadataStore` via {@link UiBundler#uploadFiles}.
 */
entity type UiBundlerResult schema name 'UiBundlerResult' {

  /**
   * The {@link UiBundler} job associated to this result record.
   */
  job: UiBundler

  /**
   * The namespace used for this job run. This associates a result to a webpack
   * configuration file(webpack.config.js).
   */
  namespace: string

  /**
   * Associates the result to a particular config when using multi-configuration
   * webpack.config.js.
   *
   * Each config returned by webpack.config.js must have a different entryName.
   */
  entryName: string

  /**
   * The batch index. For a given entry name, multiple batches will be created to minimize size.
   */
  batch: int

  /**
   * The binary-encoded files generated by the bundler.
   */
  rawValue: map<string, binary> schema name 'RAW'

  /**
   * Retrieves all the {@link UiBundlerResult} records for the given {@link UiBundler} job.
   */
  forJob: function(job: UiBundler, include: string): [UiBundlerResult] js-server
}
