/**
 * Public API for the Webpack type.
 *
 * This type is separate from the Webpack type to provide a runtime-agnostic
 * interface to the webpack bundler.
 *
 * The Webpack type, being a NodeJS-specific implementation, can only run by
 * dispatching a node process and this interface serves as a dispatcher of
 * those actions without starting an ActionEngine directly. This is important
 * because this way we can use a single NodeJS action (Webpack.sharedRuntimeExecutor)
 * and reuse the installed dependencies between all these different actions.
 */
type WebpackBundler {

  /**
   * Returns the webpack mode based on the {@link Config} Type provided.
   */
  getWebpackMode: function(): string js-server

  /**
   * Returns the bundler max memory based on the {@link Config} Type provided.
   */
  getBundlerMaxMemory: function(): int js-server

  /**
   * Returns the webpack mode based on the Config provided.
   */
  getWebpackModeByConfigHandler: private function(handler: Type): string js-server

  /**
   * Returns the bundler max memory based on the Config provided if it exists, otherwise fall back to the
   * WebpackBundlerConfig to retrieve the bundler max memory.
   */
  getBundlerMaxMemoryByConfigHandler: private function(handler: Type): int js-server

  /**
   * Sets up the working directory for a given config and returns the path.
   *
   * @param configPath
   *          Path to the webpack config file, e.g. c3/config/webpack.config.js
   */
  setupWorkingDirectory: function(configPath: !string): string js-server

  /**
   * Sets up the working directory for a given working directory and config and returns the path.
   *
   * @param configPath
   *          Path to the webpack config file, e.g. c3/config/webpack.config.js
   */
  setupWorkingDirByPath: function(workDir: !string, configPath: !string): string js-server

  /**
   * NOTE: No longer used to drive UiBundler batching logic, getConfigNames is used for that now.
   *
   * Returns the number of configs exported by webpack.config.js.
   * The number is used to schedule batches in UiBundler.doStart.
   *
   * @param workDir
   *          The absolute path to the directory generated by Webpack.setupWorkingDirectory API.
   * @param configPath
   *          Path to the webpack config file, e.g. c3/config/webpack.config.js
   */
  getConfigsCount: function(workDir: !string, configPath: !string): int js-server

  /**
   * Returns the names of all configurations exported by webpack.config.js.
   *
   * @param workDir
   *          The absolute path to the directory generated by Webpack.setupWorkingDirectory API.
   * @param configPath
   *          Path to the webpack config file, e.g. c3/config/webpack.config.js
   */
  getConfigNames: function(workDir: !string, configPath: !string): [string] js-server

  /**
   * Runs the webpack compiler by using a ui configuration file in the metadata store.
   *
   * @param runSpec
   *          The specification to configure the webpack run.
   */
  run: function(runSpec: WebpackRunSpec): BundleStatus js-server
}
