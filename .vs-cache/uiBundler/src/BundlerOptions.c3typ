/**
 * Options for bundler.
 */
type BundlerOptions {
  /**
   * Enable Server Sent Events listener for repo watcher.
   * When this is true, repoWatcher listens to file changes made in server as opposed to local file system.
   */
  enableSse: boolean = false

  /**
   * If to run the work dir setup process.
   */
  setup: private boolean

  /**
   * If to run the repository watcher process.
   */
  watcher: private boolean

  /**
   * If to run the bundler process.
   */
  bundler: private boolean

  /**
   * If tos skip applying loaders during repo watcher setup.
   */
  skipInitialLoader: private boolean

  /**
   * The port on which the UI Development server will listen.
   */
  port: private boolean

  /**
   * The ui namespace to retrieve configurations for.
   */
  uiNamespace: private string

  /**
   * If to bundle tests.
   */
  withTests: private boolean

  /**
   * If to enable code coverage.
   */
  codeCoverage: private boolean

  /**
   * Webpack mode.
   */
  mode: private string

  /**
   * Minimum log level. Default is INFO.
   */
  minLogLevel: private string

  /**
   * Temporary directory where UI code and dependencies will be stored for bundling.
   */
  workDir: private string

  /**
   * A directory where generated files will be stored.
   */
  outDir: private string

  /**
   * A directory where logs will be stored.
   */
  logDir: private string

  /**
   * When enabled, all the emited files will be deployed to the environment URL.
   */
  emitToServer: private boolean

  /**
   * When provided, only the listed federated modules will be bundled.
   */
  configNames: private string

  /**
   * If true, enable webpack bundle analyzer plugin.
   */
  enableBundleAnalyzer: private boolean
}
