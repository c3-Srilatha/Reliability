/**
 * UI content server and router for a single page application.
 */
type UiContentHandler mixes UiService {

  getDefaultPathFromMode: private function(mode: string): !string js-server

  handle: ~ js-server

  /**
   * This method takes in the HTTP path, encodes it, and generates a pair whose first value is a HTTP response
   * based on if it can find the content in the c3 package directory structure, and second value indicates if the
   * HTTP path is the default content.
   */
  generateHttpResponseBasedOnHttpPath: private function(httpPath: !string, req: HttpRequest): Pair<HttpResponse, boolean> js-server

}
