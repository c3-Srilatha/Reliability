/**
 * The specification type to configure a {@link Webpack} compiler run.
 */
type WebpackRunSpec {

  /**
   * Batch job id.
   */
  jobId: !string

  /**
   * The absolute path to the directory generated by {@link Webpack#setupWorkingDirectory} API.
   */
  workDir: !string

  /**
   * Path to the config file, e.g. c3/config/webpack.config.js
   */
  configPath: !string

  /**
   * Config file contains an array of configs. This is the name of the configs to bundle.
   */
  configNames: ![string]

  /**
   * Whether to instrument code for code coverage.
   */
  codeCoverage: boolean
}
