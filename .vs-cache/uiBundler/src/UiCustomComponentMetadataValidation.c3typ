/***
 * Finds and handles instances of custom components that import custom components through @c3/ui/** import
 * and produces metadata warnings.
 */
type UiCustomComponentMetadataValidation {

  /**
   * Finds custom components that import other custom components through @c3/ui/** import and
   * generates metadata warnings to instruct developers to import through the @c3/app/ui/src/** path instead.
   */
  generateCustomComponentMetadataWarnings: function(inputs: json) js-server

  /**
   * Constructs a Pkg.Issue object for a given type name with line number, custom component directory path, file path, and app name.
   */
  constructPkgIssue: private function(typeNameWithLineNumber: json, customComponentDirectoryPath: string, filePath: string, appName: string): Pkg.Issue js-server

  /**
   * Generates the @c3/app/ui/src import path for a given file path. For example:
   * ui/c3/src/testFolder/MyComponent -> @c3/app/ui/src/testFolder/MyComponent
   */
  generateAppUiSrcFilePath: private function(filePath: string): string js-server

  /**
   * Finds the custom component directory path for a given file path. For example:
   * /ui/c3/src/testFolder/MyComponent.tsx -> /ui/c3/src/testFolder/MyComponent
   */
  extractDirectoryPathWithFileName: private function(filePath: string): string js-server

  /**
   * Extracts and returns the type name and line number from all the @c3/ui imports from the file contents.
   */
  getTypeNameAndLineNumberFromImports: private function(fileContents: string): [ImportWithNameAndLineNumber] js-server
}
