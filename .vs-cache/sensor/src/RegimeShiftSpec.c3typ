/**
 * Input spec to configure parameters of the regime shift calculations manually.
 * windowPast and windowFuture are associated with Wasserstein Distance
 * that calculates distance between two distributions.
 * windowSizeForPeakDetection is for computing peaks using scipy.signal package
 * on the distribution distance.
 */
type RegimeShiftSpec mixes Spec {

  /**
   * start: start date for the EvalMetrics call on the Sensor type
   */
  start: datetime

  /**
   * end: end date for the EvalMetrics call on the Sensor Type
   */
  end: datetime

  /**
   * interval: interval or granularity for the EvalMetrics call on the Sensor type
   */
  interval: string enum Interval = QUARTER_HOUR

  /**
   * windowPast: how many datapoints you would want to look into the past from current timestamp
   */
  windowPast: Duration = '180D'

  /**
   * windowFuture: how many datapoints you would want to look into the future from current timestamp
   */
  windowFuture: Duration = '60D'

  /**
   * windowSizeForPeakDetection: how many datapoints you would want to consider for calculating the peaks
   */
  windowSizeForPeakDetection: Duration = '60D'
}
