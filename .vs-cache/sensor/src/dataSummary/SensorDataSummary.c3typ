/**
 * A cached summary of sensor data statistics for a given time range and interval.
 *
 * **IMPORTANT: This type should never be populated directly, but rather created as-needed through the {@link createMissing} or
 * {@link getForSensors} APIs.**
 *
 * This ensures that several assumptions remain true:
 *    * Each summary entity represents the same time range (a week)
 *    * No two summary entities for the same {@link Sensor} and {@link Interval} overlap in time range (this is enforced
 *      by having each {@link start} be a Sunday midnight)
 *    * Within a queried time range, all summary entities are present before performing aggregation
 */
@db(index=['parent', 'start', 'end', 'interval'])
extendable entity type SensorDataSummary mixes TimedIntervalValue {

  /**
   * The sensor that this summary is for.
   */
  parent: !Sensor

  /**
   * Start timestamp for the summary.
   */
  start: !~

  /**
   * End timestamp for the summary.
   */
  end: !~

  /**
   * The interval for which average {@link flatlinePercentage} and {@link missingPercentage} were calculated.
   */
  interval: !Interval

  /**
   * The average percentage of time that the sensor was flatlined during the time range.
   * By default, a single timestamp is considered "flatlined" if the value has not changed for the prior 6 hours.
   */
  flatlinePercentage: !int

  /**
   * The average percentage of time that the sensor was missing during the time range.
   * Whether or not a timestamp is missing is determined by {@link Timeseries#missing} on the result of evaluating
   * the `QuantityRawPointSeries` metric.
   *
   * Note that with {@link AggOp#PREVIOUS} treatment for timeseries normalization (as is the default), data points
   * will have their values repeated in subsequent intervals until a new data point appears, as long as a future
   * data point exists. Those interpolated values are then not considered missing under this calculation.
   */
  missingPercentage: !int

  /**
   * Calculates continuous time ranges which are missing data summaries for each sensor.
   * Uses `dataSummariesMap` as source of truth for "existing" data summary entities.
   * If a refresh of all in-scope summaries is desired, pass in an empty map.
   */
  calculateMissingSummarySpecs: private function(spec: !SensorDataSummarySpec, dataSummariesMap: map<string, [SensorDataSummary]>): [SensorDataSummarySpec] py-jep

  /**
   * Calculates statistics for the entire time range.
   * Makes but does not return the resulting summary objects.
   * The given time range is assumed to already be "snapped" to weekly intervals as described in type-level documentation.
   * Should only ever be used by {@link createMissing}.
   */
  calculateForSpec: private function(spec: !SensorDataSummarySpec): [SensorDataSummary] py-jep

  /**
   * Calculates and persists missing data summaries for the given {@link SensorDataSummarySpec}.
   * If provided, uses `dataSummariesMap` as source of truth for "existing" data summary entities.
   * If a refresh of all in-scope summaries is desired, pass in an empty but defined map.
   * If a map is not provided at all, it will be created with all existing data summaries.
   */
  createMissing: function(spec: !SensorDataSummarySpec, dataSummariesMap: map<string, [SensorDataSummary]>, upsertSpec: UpsertSpec, removeExisting: boolean = true): ObjList<SensorDataSummary> py-jep

  /**
   * Returns a map of sensor ID to list of sensor data summaries for the given {@link SensorDataSummarySpec}.
   */
  getForSensors: function(spec: !SensorDataSummarySpec, createMissing: boolean = true): map<string, [SensorDataSummary]> py-jep
}
