/**
 * Represents of group of redundant sensors that are monitoring the same process and simultaneously having their
 * health evaluated as a group.
 */
entity type ProtectionLoop schema name 'PRTCTN_LP' {

  /**
   * The description of the {@link ProtectionLoop}.
   */
  description: string

  /**
   * The sensors inside this {@link ProtectionLoop}.
   */
  sensorRelations: [ProtectionLoopSensorRelation](from)

  /**
   * Alerts raised for this {@link ProtectionLoop}.
   */
  @db(order='descending(timestamp)')
  alerts: [ProtectionLoopAlert](parent)

  /**
   * Latest alert raised for this {@link ProtectionLoop}.
   */
  latestAlert: ProtectionLoopAlert stored calc exists(alerts) ? alerts[0] : null

  /**
   * High threshold which indicates a potential problem with the sensor.
   */
  highHighThreshold: double

  /**
   * Threshold representing the upper bound of sensor values indicating normal operations.
   */
  highThreshold: double

  /**
   * Threshold representing the lower bound of sensor values indicating normal operations.
   */
  lowThreshold: double

  /**
   * Low threshold which indicates a potential problem with the sensor.
   */
  lowLowThreshold: double
}
