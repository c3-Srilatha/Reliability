/**
 * Type that is created when a percentage of sensors fails and belongs to the same {@link ProtectionLoop} type.
 *
 */
entity type ProtectionLoopAlert mixes FeatureEvaluatable schema name 'LP' {

  /**
   * The parent {@link ProtectionLoop} this alert is on. TODO: REL-4645 remove field once dataAlerting migrated.
   */
  parent: !ProtectionLoop

  /**
   * The time the alert was triggered. TODO: REL-4645 remove field once dataAlerting migrated.
   */
  timestamp: !datetime

  /**
   * Current risk Status {@link ProtectionLoopRiskStatus}
   */
  risk: string enum ProtectionLoopRiskStatus

  /**
   * Unhealthy sensors in the protection loop.
   * {@link ProtectionLoop}
   */
  unhealthySensors: [Sensor] schema suffix 'SNR'
}
