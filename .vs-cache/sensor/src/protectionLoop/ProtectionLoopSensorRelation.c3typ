/**
 * Relation type between a {@link Sensor} and a {@link ProtectionLoop} which signifies the sensor
 * belongs to the protection loop.
 */
@db(unique=['from,to'])
entity type ProtectionLoopSensorRelation schema name 'PRTN_LP_SNR_RL' {

  /**
   * The {@link ProtectionLoop} in this relation.
   */
  from: !ProtectionLoop

  /**
   * The {@link Sensor} in this relation.
   */
  to: !Sensor
}
