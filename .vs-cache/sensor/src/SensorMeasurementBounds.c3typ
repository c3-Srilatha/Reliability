/**
 * A type to represent the upper and lower operational measurement bounds for
 * a {@link Sensor} time series.
 * Eg. A temperature sensor measuring data in Kelvin should never have values
 * less than zero (physically impossible). However, sometimes, there may be data
 * issues. In those cases, the user may set the upper and lower
 */
@db(unique=['sensor'], versionHistory='true')
extendable entity type SensorMeasurementBounds schema name 'SNSR_BNDS' {

  /**
   * The {@link Sensor} for which the bounds are being set.
   */
  sensor: !Sensor

  /**
   * This value determines a floor value below which the data will
   * be considered as invalid.
   * So, any `value < lowerBound` will be considered invalid.
   */
  lowerBound: double

  /**
   * This value determines a ceiling value beyond which the data will
   * be considered as invalid.
   * So, any `value > upperBound` will be considered invalid.
   */
  upperBound: double
}
