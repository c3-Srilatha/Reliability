/**
 * This type specifies an override of UiSdlSite that allows for the specification of configs to fetch.
 * It will also automatically fetch the configs on initial UI load.
 */
@typeScript
type UiConfigSite mixes UiSdlSite, UiConfigGetter {

  /**
   * A list of configs to fetch on initial UI load.
   */
  getConfigSpecs: [UiConfigGetSpec]

  /**
   * On site initial render (which happens on initial UI load) gets all the configs
   * specified on the field `getConfigSpecs`
   *
   * @param actionStream
   *          {@link UiSdlObservable} action stream.
   * @param stateStream
   *          The current {@link UiSdlReduxState} of the application.
   * @returns A {@link UiSdlObservable} action stream.
   */
  @uiSdlEpic(actionType='INITIAL_RENDER')
  getConfigsOnInitialRenderEpic: function(
    actionStream: UiSdlActionsObservable,
    stateStream: UiSdlStatesObservable
  ): UiSdlActionsObservable ts-client
}
