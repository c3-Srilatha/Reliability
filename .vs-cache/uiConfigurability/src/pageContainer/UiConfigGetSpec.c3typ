/**
 * Spec type to provide the config type and an optional action name to fetch the
 * configs required for conditional/config-based rendering on the UI.
 */
type UiConfigGetSpec mixes Spec {
  /**
   * The config type to fetch on initial UI load.
   */
  configType: !string

  /**
   * An optional action name to fetch the config on initial UI load.
   */
  actionName: string = 'getConfig'
}
