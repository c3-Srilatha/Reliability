/**
 * Type to add `UiSdlComponentRef` filtering abilities to `UiSdlComponent`s.
 *
 * *Note* - This type currently only works for components props defined at the top level of the component-prop tree,
 * i.e., doesn't work for nested props. See README.md on how to create new `UiConfigComponent`s.
 */
type UiConfigComponent {
  /**
   * Config to define the filtering logic for component refs.
   *
   * The configurations have be of shape:
   * ```json
   * "configFilteredRefs": {
   *   "<propName>": {
   *     "<componentRefId>"": UiConfigDynamicFilterSpecParam | [UiConfigDynamicFilterSpecParam]
   *   }
   * }
   * ```
   *
   * For instance, to filter out `UiConfigTabPanel.tabComponents`:
   * ```
   * "configFilteredRefs": {
   *   "tabComponents": {
   *    "uiConfigurability.DemoTabPanelComponent2": [
   *       {
   *        "configType": "<configType>",
   *         "path": "<path>"
   *       }
   *     ]
   *   }
   * }
   * ```
   */
  configFilteredRefs: map<string, map<string, UiConfigDynamicFilterSpecParam | [UiConfigDynamicFilterSpecParam]>>
}
