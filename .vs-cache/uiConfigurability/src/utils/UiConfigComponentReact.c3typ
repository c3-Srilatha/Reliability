/**
 * A high-order component to filter out [component refs](UiSdlComponentRef) that should be hidden based on an
 * application configuration before rendering a {@link UiSdlComponent}. To add component ref filtering capabilities to
 * a component, simply pass in the component's React type and props passed to the component.
 *
 * For instance, for `UiSdlTabPanelReact`:
 * ```
 * const UiConfigTabPanelReact: React.FunctionComponent<Props> = (
 *   props: Props
 * ) => {
 *   return UiConfigComponentReact(UiSdlTabPanelReact, props);
 * };
 * ```
 */
type UiConfigComponentReact mixes ReactFunction, UiSdlComponent<UiSdlNoData> {
  @typeScript(env="client")
  render: ~
}
