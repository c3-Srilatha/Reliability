/**
 * Render condition that can be configured through use of {@link UiSdlDynamicValueSpecParam}.
 * Returns the value of the given param.
 */

@typeScript
type UiDynamicValueRenderCondition mixes UiSdlRenderCondition {

  useCondition: ~

  /**
   * The metadata id of the component.
   * For use in populating {@link UiSdlParamExtractionContext#metadataId}
   */
  metadataId: string

  /**
   * The param to extract the value from and return as value of this condition.
   */
  param: !UiSdlDynamicValueSpecParam
}
