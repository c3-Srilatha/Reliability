/**
 * This type represents a class of UiSdlStateValueParam that gets data from a UiSdlSite instance.
 * In most cases, this UiSdlSite instance is 'SDL.DefaultSite'. It should not be used directly.
 */
@typeScript
abstract type UiSiteValueParam mixes UiSdlStateValueParam {

  /**
   * This field should usually not be set to anything else. Only change if
   * the configs are stored on a different {@link UiSdlSite}.
   */
  id: ~ = 'SDL.DefaultSite'
}
