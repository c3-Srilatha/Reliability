/**
 * Configuration type used for demo purposes to control the behavior of message suffix settings.
 */
type UiConfigurabilityDemoMsgSuffixSettings {
  /**
   * If `true` show the msgSuffix.
   * If `false` hide the msgSuffix.
   */
  useMsgSuffix: boolean

  /**
   * If `true` hide the msgSuffix.
   * If `false` show the msgSuffix.
   */
  doNotUseMsgSuffix: boolean

  /**
   * The path to the message suffix.
   */
  filterMsgSuffix: string
}
