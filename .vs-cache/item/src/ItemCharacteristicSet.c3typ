/**
 * Historical values for item characteristics. Holds value as of date defined by timestamp for
 * a characteristic defined by name.
 */
@db(index=['meta.timestamp'])
extendable entity type ItemCharacteristicSet mixes TimedCharacteristicHistory<Item>, Boxed<string> schema name 'ITMCHRCS'
