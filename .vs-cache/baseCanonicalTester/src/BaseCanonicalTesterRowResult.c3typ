/**
 * Represents an individual row comparison of actual vs expected data.
 */
type BaseCanonicalTesterRowResult schema name 'BCL_TST_RES_ROW' {

  /**
   * Actual row
   */
  actual: json schema suffix 'ACTL'

  /**
   * Expected row
   */
  expected: json schema suffix 'EXPCTD'

  /**
   * The name of the file being processed
   */
  fileName: string

  /**
   * The index of the row being processed from the original file
   */
  index: int

  /**
   * Field errors
   */
  fieldErrors: [BaseCanonicalTesterRowResultFieldError] schema suffix 'FLD_ERRORS'

  /**
   * Field errors
   */
  fieldSuccesses: [BaseCanonicalTesterRowResultFieldSuccess] schema suffix 'FLD_SUCCESS'

  /**
   * Critical processing error which occurred.
   */
  processingError: string

  /**
   * Process a pair of rows to produce an {@link BaseCanonicalTesterRowResult}.
   *
   * @param actual
   *           The actual value for the row
   * @param expected
   *           The expected value for the row
   * @param comparisonFields
   *           The fields to compare
   * @param errorMessage
   *           The error message to use if the comparison fails
   * @param fileName
   *           The name of the file being processed
   * @param index
   *           The index of the row being processed from the original file
   * @return The {@link BaseCanonicalTesterRowResult} for the row compared
   */
  processRow: private function(actual: any, expected: any, comparisonFields: [string], errorMessage: string, fileName: string, index: int): BaseCanonicalTesterRowResult js-server
}
