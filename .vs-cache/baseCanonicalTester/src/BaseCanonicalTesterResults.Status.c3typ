/**
 * Type to represent the status of a {@link BaseCanonicalTesterResults BaseCanonicalTesterResult}.
 */
enum type BaseCanonicalTesterResults.Status {

  /**
   * Enum to indicate that the test was run, non-empty and successful.
   */
  SUCCESS

  /**
   * Enum to indicate that the test was run, non-empty but unsuccessful.
   */
  FAIL

  /**
   * Enum to indicate that the test was disabled.
   */
  DISABLED

  /**
   * Enum to indicate that the test was empty, i.e., no row results are available.
   */
  EMPTY
}
