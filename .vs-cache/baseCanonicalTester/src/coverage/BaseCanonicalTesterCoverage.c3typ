/**
 * Test coverage for each Canonical This only validates that the canonical target types have an expected field for their
 * projections in the canonical transformation.  It does not validate custom transformers, or fields not defined within
 * the transform.
 */
private entity type BaseCanonicalTesterCoverage schema name 'BCL_TST_COV' {

  /**
   * The source type that we are validating coverage against.
   */
  sourceType: !string

  /**
   * The target type that we are validating coverage against.
   */
  targetType: !string

  /**
   * If test coverage is complete for the {@link transformName}.
   */
  testCoverageComplete: !boolean

  /**
   * If test coverage is complete for the {@link transformName}.
   */
  status: string enum BaseCanonicalTesterResults.Status

  /**
   * The fields that are missing from the test coverage.
   */
  transformName: !string

  /**
   * This is utilized by {@link BaseCanonicalTester#runCanonicalTests} to persist the test coverage results.
   *
   * @param results
   *            The return object call from {@link BaseCanonicalTester#testAllCanonicals} or
   *            {@link BaseCanonicalTester#testAllSources}.  The expected behavior is to concatenate the results.
   * @return
   *            The persisted test coverage results.
   */
  persistTestCoverage: private function(results: [BaseCanonicalTesterResults]): [BaseCanonicalTesterCoverage] js-server
}
