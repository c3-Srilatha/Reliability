/**
 * Test result produced by {@link BaseCanonicalTester#generateCanonicalTestResults}.
 * A test result applies to *one* specific canonical type/target Type combination.
 */
private entity type BaseCanonicalTesterResults schema name 'BCL_TST_RES' {

  /**
   * Set to `canonicalType.name()_targetType.name()_runTimestamp`.
   */
  id: ~

  /**
   * Status dependent on other properties of run.
   */
  status: string enum BaseCanonicalTesterResults.Status

  /**
   * Timestamp of test run.
   */
  runTimestamp: datetime

  /**
   * Critical error which occurred during test result generation.
   */
  criticalError: string

  /**
   * Canonical or Source type being tested.
   */
  canonicalOrSourceType: !Type

  /**
   * Target type being tested.
   */
  targetType: !Type

  /**
   * The name of the transform used.
   */
  transformType: string

  /**
   * Total expected rows - actual rows observed
   */
  totalExpectedMinusTotalActual: int

  /**
   * Number of successful target type rows.
   */
  totalSuccessful: int

  /**
   * Number of non-matching target type rows.
   */
  totalErrors: int

  /**
   * Comparison results for each target row.
   */
  rowResults: [BaseCanonicalTesterRowResult] schema suffix 'RW_RSLTS'

  /**
   * Fields being compared.
   */
  comparisonFields: [string] schema suffix 'CMP_FLDS'

  /**
   * Fields being ignored.
   */
  ignoreFields: [string] schema suffix 'IGNR_FLDS'

  /**
   * Fields to construct comparison primary key from.
   */
  comparisonKeyFields: [string] schema suffix 'CMPK_FLDS'

  /**
   * {@link SourceImportDataResult} generated by {@link BaseCanonicalTestRunner#processAndLoadCanonical}.
   */
  loadResult: SourceImportDataResult schema suffix 'LD_RSLTS'

  /**
   * A list of fetch results generated by {@link BaseCanonicalTestRunner#fetchLoadedCanonicalData}.
   */
  fetchResult: [BaseCanonicalTesterResults.FetchResults] schema suffix 'FTCH_RSLTS'

  /**
   * `map<string: Type.name(), int: removed objs count>` generated by {@link BaseCanonicalTestRunner#removeLoadedCanonicalData}.
   */
  removeResult: map<string, int> schema suffix 'RMV_RSLTS'

  /**
   * Summarize results to derive summary statistics on row results.
   */
  processSummaryStatistics: member function(): !BaseCanonicalTesterResults js-server

  /**
   * Generate a formatted summary of the errors within this result.
   */
  generateErrorSummary: member function(): string js-server
}
