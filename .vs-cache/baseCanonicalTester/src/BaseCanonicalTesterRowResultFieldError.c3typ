/**
 * Represents an individual row-field error for comparison of actual vs expected data.
 */
type BaseCanonicalTesterRowResultFieldError schema name 'BCL_TST_RES_FE' {

  /**
   * Field being compared
   */
  field: string

  /**
   * Actual value
   */
  actual: json schema suffix 'ACTL'

  /**
   * Expected value
   */
  expected: json schema suffix 'EXPCTD'
}
