/**
 * The spec that describes how a canonical test should be run.
 */
type BaseCanonicalTester.Spec {

  /**
   * The name of the canonical test.
   */
  name: string

  /**
   * Specify the dependency package Source types you wish to create Jasmine tests for.
   * If you do not specify this, then you cannot test dependency Source Types.
   */
  dependencySourceTypes: [Type]

  /**
   * Specify the dependency package Canonical types you wish to create Jasmine tests for.
   * If you do not specify this, then you cannot test dependency Canonical Types.
   */
  dependencyCanonicalTypes: [Type]

  /**
   * The spec for each source type.
   */
  sourceTypeSpecs: [BaseCanonicalTester.SourceTypeSpec]

  /**
   * The spec for each canonical type.
   */
  canonicalTypeSpecs: [BaseCanonicalTester.CanonicalTypeSpec]
}
