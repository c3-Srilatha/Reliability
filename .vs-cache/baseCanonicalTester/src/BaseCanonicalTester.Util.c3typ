/**
 * A utility type for running canonical tests and generating coverage summaries.
 */
private type BaseCanonicalTester.Util {

  /**
   * Function to get all the {@link Transform}s in a package.
   *
   * @param packageName
   *           The name of the package for which to get {@link Transform}s.
   * @returns the list of transforms in the package.
   */
  getPackageTransforms: function(packageName: !string): [Transform] js-server

  /**
   * A function that returns all the canonical test files in the package.
   *
   * @returns
   *    A list of all the canonical test files in the package.
   */
  findAllCanonicalTests: function(): [Pkg.File] js-server

  /**
   * A function that runs a given list of canonical test files.
   *
   * @param canonicalTestFiles
   *    A list of canonical test files.
   */
  runCanonicalTests: function(canonicalTestFiles: [Pkg.File]) js-server

  /**
   * A function that generates the coverage summary for all canonical tests in the package.
   *
   * @returns
   *    The coverage summary for all canonical tests in the package in JSON format.
   */
  runAllCanonicalsAndGenerateCoverageSummary: function(): json js-server
}
