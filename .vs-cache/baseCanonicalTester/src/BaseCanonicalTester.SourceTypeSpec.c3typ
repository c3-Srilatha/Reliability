/**
 * The spec that describes how to run a test for a source type.
 */
type BaseCanonicalTester.SourceTypeSpec {

  /**
   * The Source type to test.
   */
  sourceType: !Type

  /**
   * If true, the test will be skipped.
   */
  disabled: boolean
}
