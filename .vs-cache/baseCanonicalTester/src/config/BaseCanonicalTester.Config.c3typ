/**
 * Folder path configurations for BaseCanonicalTester.
 */
type BaseCanonicalTester.Config mixes Config, Singleton {

  /**
   * Relative path to the canonical test directory within the package.
   */
  pathToCanonicalDir: string = '/test/canonical/'

  /**
   * The input sub-folder name for the test canonical source files.
   */
  inputDirName: string = 'input'

  /**
   * The expected sub-folder for the test canonical target files.
   */
  expectedDirName: string = 'expected'
}
