/**
 * Example canonical type.
 */
type CanonicalExample mixes Canonical<CanonicalExample> {

  /**
   * Canonical ID.
   */
  canonicalId: string

  /**
   * Canonical name.
   */
  canonicalName: string

  /**
   * Canonical value.
   */
  canonicalValue: double

  /**
   * Canonical parent.
   */
  canonicalParent: string

  /**
   * Canonical children.
   */
  canonicalStrArray: [string]

  /**
   * Canonical children.
   */
  testEnum: string
}
