/**
 * The TargetExampleTDH type is a TimedDataHeader that represents a target.
 */
private entity type TargetExampleTDH mixes TimedDataHeader<TargetExampleTDP> {

  /**
   * The name of the target.
   */
  name: string

  /**
   * The unit of the target.
   */
  unitConstraint: Unit
}
