{
  "author": "C3 AI",
  "version": "6.188.1",
  "name": "genAiBase",
  "dependencies": {
    "jarvis": "8.8",
    "testtools": "8.8",
    "baseToolkit": "12.1",
    "uiComponentLibraryReact": "8.8",
    "genaiPlatform": "3.1"
  },
  "description": "C3 Generative AI Base Package",
  "eslintConfig": {
    "extends": ["plugin:@c3/c3-base", "plugin:@c3/typescript", "plugin:prettier/recommended"],
    "plugins": ["@c3"],
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^e$|^_",
          "ignoreRestSiblings": true
        }
      ],
      "import/prefer-default-export": "off"
    }
  }
}
