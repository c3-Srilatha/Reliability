/** Helper type which provides common test set-up, tear-down, and test running functionality for {@link Genai.UnstructuredQuery.Engine}. */
type Genai.UnstructuredQueryEngineTester {
   /**
    * Setup. Run in beforeAll.
    *
    * @param setupSpec
    *           The configuration for the test.
    */
   setupTest: function(setupSpec: Genai.UnstructuredQueryEngineTester.SetupSpec):
                         ![Genai.UnstructuredQuery.Engine.Config |
                           Genai.UnstructuredQuery.Engine.REA.RerankerConfig |
                           Genai.UnstructuredQuery.Engine.REA.ExtractorConfig |
                           Genai.UnstructuredQuery.Engine.REA.ContextualQaConfig |
                           Genai.UnstructuredQuery.Engine.REA.QuestionRewritingConfig] js-rhino

   /**
    * Teardown. Run in afterAll.
    * @param ctx
    *        The TestApiContext
    * @param otherConfigs
    *        The Configs returned by #setupTest
    */
   teardownTest: function(ctx: !TestApiContext,
                          otherConfigs:
                          [Genai.UnstructuredQuery.Engine.Config |
                           Genai.UnstructuredQuery.Engine.REA.RerankerConfig |
                           Genai.UnstructuredQuery.Engine.REA.ExtractorConfig |
                           Genai.UnstructuredQuery.Engine.REA.ContextualQaConfig |
                           Genai.UnstructuredQuery.Engine.REA.QuestionRewritingConfig]) js-rhino

   /**
    * Run the tests. Run directly in the test file.
    *
    * NOTE: `runTest` looks at {@link Genai.Llm.MockLlmConfig#mode} to determine how the test should be run. See
    * {@link Genai.Llm.MockLlmConfig#filePathForTest} for the specific file path used.
    *       * off: run normally, making real calls to the LLM
    *       * record: make real calls to the LLM, but record the calls and responses to a test-specific temporary file
    *       * playback: use the mock LLM to replay previously recorded responses
    */
   runTest: function(ctx: !TestApiContext, testConfig: !json) js

   /**
    * Runs tests cases for streaming tests.
    *
    * @param testSpec
    *          An optional spec detailing how the test should be run.
    *          If not specified, a default spec will be run.
    */
   runStreamingTest: function(testSpec: json) js
}
