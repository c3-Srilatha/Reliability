/** Helper type to test concurrent queries */
type Genai.ConcurrentQueryTester {

  /**
    * Tests
    * 1) more concurrent queries than handlers for target QE/QO
    * 2) concurrent queries with multiple handlers for the target QE/QO
    * Makes both normal query and chat query. Asserts queries complete successfully and answers match expected.
    */
   runConcurrencyTests: function(testConfig: !json) js-rhino

   /**
    * Sends a query to the target QE/QO and waits for the response.
    * Exposed directly for better visibility when debugging progress in the test.
    * @param query
    *    The initial query.
    * @param chatQuery
    *    The follow-up chat query.
    * @param targetTool
    *    The target tool for the query.
    */
   startSyncQueries: private function(query: !string, chatQuery: !string, targetTool: !string) js-rhino
}
