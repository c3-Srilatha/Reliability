/**
 * Expected values for the chunking a {@link Genai.SourceFile}. Used by {@link TestApi#checkChunking}.
 * All fields are optional and only values corresponding to those supplied will be checked.
 */
type Genai.ExpectedChunkingResult {
  /**
   * At least (inclusive) this many passages should have been produced.
   */
  minNumPassages: int

  /**
   * At most (inclusive) this many passages should have been produced.
   */
  maxNumPassages: int

  /**
   * This string should be in the first passage.
   */
  firstPassageSubstring: string

  /**
   * This string should be in the last passage.
   */
  lastPassageSubstring: string

  /**
   * If the input source file was a pdf, this is expected to be the page number (within the PDF) of the last passage.
   */
  lastPassagePageNum: int
}
