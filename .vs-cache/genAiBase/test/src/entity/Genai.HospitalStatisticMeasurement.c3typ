/**
 * This entity type is only for testing purposes.
 */
entity type Genai.HospitalStatisticMeasurement mixes TimedDataPoint<Genai.HospitalStatistic> {

  /**
   * The timestamp of the measurement.
   */
  timestamp: datetime

  /**
   * The hospital total patient count
   */
  totalPatients: int

  /**
   * The hospital total doctor count
   */
  totalDoctors: int

  /**
   * The hospital total nurse count
   */
  totalAppointments: int

  /**
   * The hospital total prescriptions count
   */
  totalPrescriptions: int

  /**
   * The hospital total lab tests count
   */
  totalLabTests: int

  /**
   * The hospital statistics for the hospital.
   */
  busiestDay: string

  /**
   * The hospital common condition
   */
  mostCommonCondition: string

  /**
   * The hospital most prescribed medication
   */
  mostPrescribedMedication: string

  /**
   * The hospital most performed test
   */
  mostPerformedTest: string
}
