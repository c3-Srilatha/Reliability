/**
 * This entity type represents measurements of a flower.
 */
entity type Genai.TestFileSourceCollectionType1 schema name 'GAI_FSC1' {

  /**
   * The id of the measurement.
   */
  idAlias: double

  /**
   * The length of the petal in centimeters.
   */
  petalLengthCm: double

  /**
   * The width of the petal in centimeters.
   */
  petalWidthCm: double

  /**
   * The length of the sepal in centimeters.
   */
  sepalLengthCm: double

  /**
   * The width of the sepal in centimeters.
   */
  sepalWidthCm: double

  /**
   * The species of the flower.
   */
  species: string

  /**
   * The encoding of the measurement.
   */
  encoded: string
}
