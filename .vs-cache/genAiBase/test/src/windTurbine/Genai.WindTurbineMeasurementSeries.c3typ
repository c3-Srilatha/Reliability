/**
 * A series of measurements taken from a single {@link Genai.WindTurbine}.
 */
entity type Genai.WindTurbineMeasurementSeries mixes TimedDataHeader<Genai.WindTurbineMeasurement> schema name "GEN_WT_MSRMNT_SRS" {

  /**
   * The {@link Genai.WindTurbine} for which measurements were taken.
   */
  windTurbine: Genai.WindTurbine

  /**
   * The aggregation/disaggregation treatment to use for the measurements.
   */
  treatment: string enum('previous', 'rate', 'integral')
}
