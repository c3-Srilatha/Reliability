/**
 * A single event that occurred to or about a single {@link Genai.WindTurbine}.
 */
entity type Genai.WindTurbineEvent mixes Obj schema name 'GEN_EVENT' {

  /**
   * The time at which this event started.
   */
  start: datetime

  /**
   * The time at which this event ended.
   */
  end: datetime

  /**
   * The {@link Genai.WindTurbine} connected to this event.
   */
  asset: Genai.WindTurbine

  /**
   * The code representing the event type.
   */
  eventCode: string
}
