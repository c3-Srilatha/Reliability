/**
 * Measurements of gear oil temperature, generator rotation speed, and active power at a point in time for a given wind turbine
 */
@db(datastore='cassandra',
    partitionKeyField='parent',
    persistenceOrder='start',
    persistDuplicates=false,
    compactType=true,
    shortId=true,
    shortIdReservationRange=100000)
entity type Genai.WindTurbineMeasurement mixes TimedDataPoint<Genai.WindTurbineMeasurementSeries> schema name 'GEN_WT_BLB_MSRMNT' {

  /**
   * The measured gear oil temperature in degrees celsius.
   */
  @ts(treatment='rate')
  gearOilTemperature: double

  /**
   * The measured generator rotation speed in revolutions per minute.
   */
  @ts(treatment='rate')
  generatorRotationSpeed: double

  /**
   * The measured active power in megawatts.
   */
  @ts(treatment='rate')
  activePower: double
}
