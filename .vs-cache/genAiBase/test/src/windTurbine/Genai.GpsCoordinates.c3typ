/**
 * Stores location as set of latitude and longitude coordinates.
 */
entity type Genai.GpsCoordinates schema name "GEN_GPSC" {

    /**
     * Latitude of the coordinate
     */
    latitude: double

    /**
     * Longitude of the coordinate
     */
    longitude: double
}
