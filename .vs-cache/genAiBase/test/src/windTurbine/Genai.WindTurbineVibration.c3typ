/**
 * The vibration of the wind turbine is a very complex, multi-coupling phenomenon.
 * Several types of vibrations affect the wind turbine. Nevertheless, the most important
 * ones are those of the blade that contribute and propagate to the other components as
 * the mechanical transmission chain and the tower.
 */
entity type Genai.WindTurbineVibration mixes Obj schema name 'GEN_SPARSE' {

  /**
   * The asset that this measurement belongs to.
   */
  asset: Genai.WindTurbine

  /**
   * Energy near the frequency corresponding to 2x rpm.
   */
  energyNear2xRpm: double

  /**
   * Energy near the frequency corresponding to 1x rpm.
   */
  energyNear1xRpm: double

  /**
   * Measurement date.
   */
  measurementDate: datetime
}
