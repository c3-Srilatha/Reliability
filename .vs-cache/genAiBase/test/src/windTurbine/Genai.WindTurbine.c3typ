/**
 * Wind turbines work on a simple principle: instead of using electricity to make wind—like
 * a fan—wind turbines use wind to make electricity. Wind turns the propeller-like blades of
 * a turbine around a rotor, which spins a generator, which creates electricity.
 */
entity type Genai.WindTurbine mixes Obj, MlSubject schema name 'GEN_WNDT' {

  /**
   * The id of the wind turbine.
   */
  turbineId: string

  /**
   * The location of the wind turbine.
   */
  location: string

  /**
   * Coordinates of the wind turbine.
   */
  coordinates: Genai.GpsCoordinates

  /**
   * Nominal power of the wind turbine in megawatts.
   */
  power: int

  /**
   * The manufacturer of the wind turbine.
   */
  manufacturer: Genai.Manufacturer

  /**
   * The {@link Genai.WindTurbineMeasurementSeries} belonging to the wind turbine.
   */
  turbineMeasurements: [Genai.WindTurbineMeasurementSeries](windTurbine)

  /**
   * The {@link Genai.WindTurbineEvent}s belonging to the wind turbine.
   */
   turbineEvents: [Genai.WindTurbineEvent](asset)

   /**
    * A description of a work order for the turbine.
    */
   workOrderDescription: string

   /**
    * A vector embedding of the work order description for the turbine. Used for similarity search.
    */
   @vector(dimension=384)
   emb: string
}
