/**
 * Test type used as the data point type for {@link Genai.TestTimedDataHeader}, explicitly testing
 * `load_metric_documentation_vectorstore.py`.
 */
entity type Genai.TestTimedDataPoint mixes TimedDataPoint<Genai.TestTimedDataHeader> {
  /**
   * The value at a given point in time.
   */
  @ts(treatment='previous')
  value: int
}
