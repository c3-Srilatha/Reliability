/** Helper type to run LLM tests and record call logs */
type Genai.TestRunner {
    /**
     * Run the specified tests with {@link Genai.Llm.MockLlmConfig#mode} set to 'record'.
     * @param testPaths
   *           The paths to the tests to run within the package (e.g. '/genAiBase/test/js-rhino/test_Foo.js').
     * @param callLogZipPath
   *           If set, then after running all tests, the call logs will be zipped into an archive and saved to this path.
     * @param downloadZip
   *           If set true, then the call log zip will be downloaded to the client. NOTE: This is only supported if called from js console.
     *                      The resulting zipfile can be simply unzipped in the `genai` directory of the repo and the individual log files should end up
     *                      in the correct subdirectories.
     */
    runAndRecordLlmTests: function(testPaths: ![string], callLogZipPath: string, downloadZip: boolean) js
}
