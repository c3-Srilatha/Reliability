/**
 * Used to test that the {@link Genai.App#syncDataModel} function is able to generate the whitelisted model
 * based on the {@link External} types added to the app. This test type represents cities to be rendered in a map.
 */
@action(group='selfservicedi-user')
entity type Genai.TestExternalType1 mixes External, NoSystemCols schema name 'GENAI.TEST1' {
  /**
  * The unique identifier of the city.
  */
  id: string schema name 'ID'

  /**
  * The latitude of the city.
  */
  latitude: double schema name 'LATITUDE'

  /**
  * The longitude of the city.
  */
  longitude: double schema name 'LONGITUDE'

  /**
  * The population of the city as of 2024.
  */
  population: int schema name 'POPULATION'

  /**
  * URL to an external bucket containing images of the city.
  */
  images: string schema name 'IMAGE'

  /**
  * The icon to be used in the marker for this city.
  */
  icon: string schema name 'ICON'
}
