/**
 * Used to test that the {@link Genai.App#syncDataModel} function is able to generate the whitelisted model
 * based on the {@link External} types added to the app. This test type represents employees of a company.
 */
@action(group='selfservicedi-user')
entity type Genai.TestExternalType2 mixes External, NoSystemCols schema name 'GENAI.TEST2' {
  /**
  * Id of the employee
  */
  @db(dataTypeOverride='IntType')
  id: string schema name 'ID'

  /**
  * First name of the employee
  */
  firstname: string schema name 'FIRSTNAME'

  /**
  * Middle name of the employee
  */
  middlename: string schema name 'MIDDLENAME'

  /**
  * Last name of the employee
  */
  lastname: string schema name 'LASTNAME'

  /**
  * Gender of the employee
  */
  gender: string schema name 'GENDER'

  /**
  * Birthdate of the employee, no timezone
  */
  birthdate: datetime no tz schema name 'BIRTHDATE'

  /**
  * Social security number of the employee
  */
  ssn: string schema name 'SSN'

  /**
  * Salary of the employee in USD
  */
  salary: int schema name 'SALARY'
}
