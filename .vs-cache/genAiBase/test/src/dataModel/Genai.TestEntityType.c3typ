/**
 * Used to test that both entities & non-entities are properly searched when building the Genai graph data model (cf.
 * {@link Genai.StructuredData.Config#makeDataModelGraph}).
 */
entity type Genai.TestEntityType {

    /**
     * An int representing the data stored in the entity type which is to be retrieved.
     */
    value: int

    /**
     * Refers to a non-entity type that we want to search & get values from.
     */
    nonEntityField: Genai.TestNonEntityType

    /**
     * Stored calc field.
     */
    storedCalcField: boolean stored calc exists(value)

    /**
     * Read calc field.
     */
    readCalcField: boolean calc exists(value)

    /**
     * A collection field of primitive string.
     */
    primitiveCollectionField: [string]

    /**
     * A collection of foreing key collections.
     */
    fkeyCollection: [Genai.TestEntityType](referredBy)

    /**
     * Foreign key.
     */
    referredBy: Genai.TestEntityType
}
