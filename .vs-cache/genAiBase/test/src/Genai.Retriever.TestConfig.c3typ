/**
 * Obj used for setting up and tearing down Retriever tests.
 */
type Genai.Retriever.TestConfig {
    /**
     * The base location used
     */
    baseLocation: !string

    /**
     * The source collections created
     */
    sourceCollections: ![Genai.SourceCollection]

    /**
     * The source files created
     */
    sourceFiles: ![Genai.SourceFile]

    /**
     * The retriever
     */
    retriever: Genai.Retriever

    /**
     * The test queries used by multiple tests
     */
    testQueries: map<string, json>
}
