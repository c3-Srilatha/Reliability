/**
 * Type for testing {@link Genai.Agent.Dynamic.Callback}.
 */
type Genai.Agent.Dynamic.Callback.TestType {

    /**
     * Valid OnStepStart Callback.
     */
    validOnStepStartCallback: function(agent: any, step: any): any py

    /**
     * Valid OnStepEnd Callback.
     */
    validOnStepEndCallback: function(agent: any, step: any): any py

    /**
     * Valid OnCallStepStart Callback.
     */
    validOnCallStepStartCallback: function(agent: any, call_step: any): any py

    /**
     * Valid OnCallStepEnd Callback.
     */
    validOnCallStepEndCallback: function(agent: any, call_step: any): any py

    /**
     * Valid OnStepStart Callback with configs.
     */
    validOnStepStartCallbackWithConfig: function(agent: any, step: any, config_num: int): any py

    /**
     * Valid OnStepEnd Callback with configs.
     */
    validOnStepEndCallbackWithConfig: function(agent: any, step: any, config_num: int): any py

    /**
     * Valid OnCallStepStart Callback with configs.
     */
    validOnCallStepStartCallbackWithConfig: function(agent: any, call_step: any, config_num: int): any py

    /**
     * Valid OnCallStepEnd Callback with configs.
     */
    validOnCallStepEndCallbackWithConfig: function(agent: any, call_step: any, config_num: int): any py

    /**
     * Invalid OnStepStart Callback with incorrect arguments.
     */
    invalidOnStepStartCallbackParams: function(step: any, config_num: int): any py

    /**
     * Invalid OnStepEnd Callback with incorrect arguments.
     */
    invalidOnStepEndCallbackParams: function(step: any, config_num: int): any py

    /**
     * Invalid OnCallStepStart Callback with incorrect arguments.
     */
    invalidOnCallStepStartCallbackParams: function(call_step: any, config_num: int): any py

    /**
     * Invalid OnCallStepEnd Callback with incorrect arguments.
     */
    invalidOnCallStepEndCallbackParams: function(call_step: any, config_num: int): any py

    /**
     * Invalid OnStepStart Callback with incorrect runtime. Runtime must be Python.
     */
    invalidOnStepStartCallbackJsRuntime: function(agent: any, step: any, config_num: int): any js

    /**
     * Invalid OnStepEnd Callback with incorrect runtime. Runtime must be Python.
     */
    invalidOnStepEndCallbackJsRuntime: function(agent: any, step: any, config_num: int): any js

    /**
     * Invalid OnCallStepStart Callback with incorrect runtime. Runtime must be Python.
     */
    invalidOnCallStepStartCallbackJsRuntime: function(agent: any, call_step: any, config_num: int): any js

    /**
     * Invalid OnCallStepEnd Callback with incorrect runtime. Runtime must be Python.
     */
    invalidOnCallStepEndCallbackJsRuntime: function(agent: any, call_step: any, config_num: int): any js
}
