/**
 * An aircraft sensor measurement.
 */
entity type Genai.AircraftMeasurement mixes TimedDataPoint<Genai.AircraftMeasurementSeries> schema name 'AIRM' {

  /**
   * The value of the sensor at a specific point in time
   */
  @ts (treatment='previous')
  value: double
}
