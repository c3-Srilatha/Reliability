/**
 * An aircraft component.  Could be an engine, turbine, generator, etc. Should be used to answer questions relating to aircraft components, such as component risk scores and component codes.
 */
entity type Genai.AircraftComponent schema name 'AC_COMP' {
  /**
   * The current risk score of this component. Should be used to answer questions about component risk scores e.g. questions relating to highest component risk score, lowest component risk score, average component risk score etc.
   */
  riskScore: double

  /**
   * The aircraft this component belongs to.
   */
  aircraft: !Genai.Aircraft

  /**
   * The alerts associated with this component.
   */
  @db(order='descending(triggeredTimestamp)')
  alerts: [Genai.AircraftComponentAlert] (component)

  /**
   * The maintenance cases associated with this component.
   */
  @db(order='descending(createdTimestamp)')
  cases: [Genai.AircraftComponentCase] (component)

  /**
   * Lookup for the component description.
   */
  code: Genai.AircraftComponentCode
}
