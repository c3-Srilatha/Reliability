/**
 * An aircraft entity. Can be used to answer questions related to aircraft.
 */
entity type Genai.Aircraft mixes FeatureEvaluatable schema name 'GEN_AIRCRFT' {
  /**
   * The current mission status of this aircraft.
   */
  status: Genai.AircraftStatus

  /**
   * Sensors on the aircraft
   */
  sensors: [Genai.AircraftMeasurementSeries] (aircraft)

  /**
   * The current risk score of this aircraft. This should be used to answer questions relating to aircraft risk scores e.g. questions relating to highest aircraft risk score, lowest aircraft risk score, average aircraft risk score etc.
   */
  riskScore: double stored calc max(components.riskScore)

  /**
   * The inner components belonging to this aircraft.
   */
  components: [Genai.AircraftComponent] (aircraft)

  /**
   * All the alerts associated with this aircraft.
   */
  @db(order='descending(triggeredTimestamp)')
  alerts: [Genai.AircraftComponentAlert] stored calc components.alerts

  /**
   * The single most recent alert for this aircraft. Can be used to access the latest alert on an aircraft, but cannot be used to provide further information about the alert itself. #latestAlert.triggeredTimestamp is the date when the alert was triggered.
   */
  latestAlert: Genai.AircraftComponentAlert stored calc exists(alerts) ? alerts[0] : null

  /**
   * All the maintenance cases associated with this aircraft.
   */
  @db(order='descending(createdTimestamp)')
  cases: [Genai.AircraftComponentCase] stored calc components.cases

  /**
   * The single most recent maintenance case for this aircraft. Can be used to access the latest maintenance case on an aircraft, but cannot be used to provide further information about the case itself.
   */
  latestCase: Genai.AircraftComponentCase stored calc exists(cases) ? cases[0] : null

  /**
   * The model of this aircraft.
   */
  model: Genai.AircraftModel

  /**
   * The current location of this aircraft. The location is an airport that is located in a city, country and state, each with latitudes and longitudes. An aircraft is always located at an airport.
   */
  location: Genai.Airport

  /**
  * Flag indicating if the aircraft is assigned to a pilot.
  */
  isAssignedToPilot: boolean

  /**
   * The descriptions for all the component codes in this aircraft.
   */
  componentCodesDescription: [string] stored calc components.code.description

  /**
   * The unique descriptions for all the component codes in this aircraft. Stored as set.
   */
  componentCodesDescriptionAsSet: set<string> stored calc unique(components.code.description)

  /**
   * Usage purpose of the Genai.Aircraft.
   */
  usage: string enum('Commercial', 'Military', 'Private', 'Cargo') = 'Military'

  /**
   * The type of engine.
   */
  engineType: string enum Genai.EngineType
}
