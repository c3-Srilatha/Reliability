/**
 * A maintenance case for a component. Use this to answer questions about aircraft component cases, which often relate to case details, case creation timestamps, case closing timestamps, statuses and case ages.
 */
entity type Genai.AircraftComponentCase schema name 'GEN_AC_COMP_CSE' {
  /**
   * The component this maintenance case has been generated for.
   */
  component: !Genai.AircraftComponent

  /**
   * The details about this maintenance case.
   */
  details: string

  /**
   * The date when this aircraft component maintenance case was created. Should be used to answer questions about the date when the maintenance case was created.
   */
  createdTimestamp: !datetime

  /**
   * The date when this aircraft component maintenance case was closed. Should be used to answer questions about the date when the maintenance case was closed.
   */
  closedTimestamp: datetime

  /**
   * The status of this aircraft component maintenance case.  The status progression is `Open` to `Assigned` to `Closed`,
   */
  status: string enum ('Open', 'Assigned', 'Closed')

  /**
   * The age of the maintenance case in days.
   */
  caseAge: int stored calc (status == 'Open' || status == 'Assigned') ? (now() - createdTimestamp) / (24 * 60 * 60 * 1000) : (closedTimestamp - createdTimestamp) / (24 * 60 * 60 * 1000)
}
