/**
 * Enum type to contain values for density categories - pertaining to UI components and layouts
 */
enum type Genai.EngineType {

    /**
     * A Jet engine.
     */
    JET = 'Jet'

    /**
     * A Turboprop engine.
     */
    TURBOPROP = "Turboprop"

    /**
     * A Piston engine.
     */
    PISTON = "Piston"

    /**
     * An Electric engine.
     */
    ELECTRIC = "Electric"
}
