/**
 * An airport facility where an aircraft can take off from and arrive at. Is the location for all aircraft.
 */
entity type Genai.Airport {
  /**
   * The city where this airport and aircraft in it are located
   */
  city: string

  /**
   * The state where this airport and aircraft in it are located
   */
  state: string

  /**
   * The country where this airport and aircraft in it are located
   */
  country: string

  /**
   * The latitude coordinate where this airport and aircraft in it are located
   */
  latitude: decimal

  /**
   * The longitude coordinate where this airport and aircraft in it are located
   */
  longitude: decimal
}
