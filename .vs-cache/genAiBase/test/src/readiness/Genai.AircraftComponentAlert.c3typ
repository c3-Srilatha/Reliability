/**
 * An alert for a component. Use this to answer questions about aircraft component alerts, including questions about triggered timestamps and alert details.
 */
entity type Genai.AircraftComponentAlert schema name "GEN_AC_COMP_ALRT" {
  /**
   * The component this alert has been generated for.
   */
  component: !Genai.AircraftComponent

  /**
   * The details about this alert. If the query is asking for aircraft component alerts mentioning, involved, or related
   * to specific keywords, use this field.
   */
  details: string

  /**
   * The date (timestamp) when this alert was triggered. Should be used to answer questions about the date when the component alert was triggered or thrown.
   */
  triggeredTimestamp: datetime
}
