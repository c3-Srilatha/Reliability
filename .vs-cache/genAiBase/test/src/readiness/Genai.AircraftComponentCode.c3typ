/**
 * Lookup for the aircraft component descriptions.
 */
entity type Genai.AircraftComponentCode schema name 'GEN_AC_COMP_CDE' {
  /**
   * Description of the aircraft component.
   * It can be used to identify what component is on an aircraft and should be used to filter on whenever an aircraft component is mentioned on the query. E.g. Is there a 'spark plug', on an aircraft.
   */
  description: string
}
