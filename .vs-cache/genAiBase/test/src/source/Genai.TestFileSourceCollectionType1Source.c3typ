/**
 * This source represents measurements of a flower.
 */
type Genai.TestFileSourceCollectionType1Source mixes Source {
  /**
   * The petal width in centimeters.
   */
  PetalWidthCm: double

  /**
   * The encoded value.
   */
  SepalWidthCm: double

  /**
   * The encoded value.
   */
  Encoded: double

  /**
   * The encoded value.
   */
  Id: double

  /**
   * The encoded value.
   */
  PetalLengthCm: double

  /**
   * The species of the flower.
   */
  Species: string

  /**
   * The encoded value.
   */
  SepalLengthCm: double
}
