/**
 * Mapping between a Retriever and all of the index actions run via AsyncAction
 */
@db(index='retriever', order='ascending(meta.created)')
extendable entity type Genai.Retriever.IndexAction {
  /**
   * The Retriever for which the action was created.
   */
  retriever: !Genai.Retriever

  /**
   * The AsyncAction
   */
  asyncAction: !AsyncAction

  /**
   * The {@link AsyncActionSpec}, necessary for submitting the action for the first time.
   */
  asyncActionSpec: !AsyncActionSpec

  /**
   * The number of times this indexing action has been attempted. An action will only be attempted
   * {@link Genai.Retriever.ConfigFields#maxTries} times before it is ignored in future runs of
   * #processQueues.
   */
  numTries: !int = 0

  /**
   * For a specific retriever, the index number of the action. This is used to determine the order in which
   * the actions are processed if two IndexActions have the same creation timestamp.
   */
  indexNumber: int

  /**
   * If the #asyncAction has completed with an {@link AsyncAction#error} populated onto the instance this would
   * most likely indicate a python process error such as out-of-memory. For these index actions the cron job will have to process them
   * on each run. These actions will not be retried but will have their source files transitioned to the `FAILED` state.
   *
   * This field indicates a index action has already been processed for a failure and should then be ignored by the next run of
   * the #processQueues cron job.
   */
  processedForFailure: boolean

  /**
   * The number of passages in this indexing action.
   */
  passageCount: int

  /**
   * The submit time of this indexing action.
   * Will be refreshed every new attempt.
   */
  startTime: datetime

  /**
   * Function called inside a {@link CronJob} to process the indexing actions. If no retrievers are provided, this will
   * process all current retrievers and their actions.
   */
  processQueues: private function(retrievers: [Genai.Retriever]) js-rhino

  /**
   * Checks if the {@link CronJob} action from #processQueues lasts more than 1800 seconds and returns the timeout message as a string
   */
  monitorLongRunningIndexAction: function(now: !DateTime, firstAction: !Genai.Retriever.IndexAction, retriever: !Genai.Retriever) js-rhino

  /**
   * Process the {@link AsyncAction}s launched by the retriever which have completed but have a {@link AsyncAction#error} persisted
   * onto them. This status most likely indicates the python process experienced a failure such as out-of-memory errors, and the action
   * is presumed to fail again if retried so the relevant files are sent to the `FAILED` state instead.
   */
  processFailedActions: private function(retriever: !Genai.Retriever) js-rhino

  /**
   * Check the number of running actions for a retriever.
   *
   * @param retriever
   *           The retriever to check
   * @param completed
   *           If true, will get the number of completed actions instead of the number of running actions.
   * @return the number of index actions running for a retriever
   */
  indexActionCount: function(retriever: !Genai.Retriever, completed: boolean): int js-rhino
}
