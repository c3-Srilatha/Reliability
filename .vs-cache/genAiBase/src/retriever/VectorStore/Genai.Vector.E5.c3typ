/**
 * Vectors from the E5 embedder ({@link Genai.Retriever.Dense.Embedder#E5}).
 * See genAiBase/resource/code/c3genai/retrieval/dense/embedders/e5.py for more details about the E5 embedder.
 */
@db(index = ['emb', 'retriever', 'inactive'])
entity type Genai.Vector.E5 mixes Genai.Vector {
  @vector(dimension=1024)
  emb: ~
}
