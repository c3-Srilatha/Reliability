/**
 * Allows configuration of Genai.Vector types.
 */
type Genai.Vector.Config mixes Config, Singleton {
  /**
   * The number of vectors to persist in each batch for the given vector type.
   */
  persistBatchSize: !int = 5000

  /**
   * The number of vectors to include in each batch when fetching or removing.
   * and filtering on id.
   */
  filterIdLimit: !int = 30000
}
