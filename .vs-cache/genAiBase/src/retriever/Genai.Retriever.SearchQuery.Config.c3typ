/**
 * All types that interact with a {@link Genai.Retriever} without direct user input for these values should
 * have a config that extends (or includes a field for) this config.
 */
type Genai.Retriever.SearchQuery.Config mixes Metadata, Named {

  /** The default number of results to return */
  defaultK: int = 5
  // TODO: GEN-9676 More fields for DS version (fuzzy match threshold et al)
}
