/**
 * Config to be used by a {@link Genai.Retriever.Elser}
 */
type Genai.Retriever.Elser.Config mixes Named, Config {
    /**
     * The apikey to access Elastic API endpoint.
     */
    @config(secret=true)
    apikey: string

    /**
     * The URL of the Elasticsearch endpoint.
     */
    url: string

    /**
     * The ELSER model to use.
     */
    elserModelId: string = ".elser_model_2"

    /**
     * The field to use for the ELSER model
     */
    elserModelField: string = "combined_field"

    /**
     * Additional configurations needed to be set in the instantiation of the elastic search client.
     *
     * Elastic documentation on allowable fields:
     * {@link https://elasticsearch-py.readthedocs.io/en/v8.14.0/api/elasticsearch.html#elasticsearch}
     */
    additionalClientParams: json
}
