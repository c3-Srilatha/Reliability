/** A result of similarity search containing the page content, test, rank, score, the {@link Genai.SourcePassage} from which it was created, amd any meta-data. */
type Genai.Retriever.SimilaritySearchResult {
    /**
     * The actual content of the result. The atypical (snake-case) field name is to maintain duck-type compatibility
     * with the langchain Document class.
     */
    page_content: !string

    /**
     * A property that accesses page_content so that the SimilaritySearchResult can be treated as a c3 Document
     * in addition to a langchain one.
     */
    text: property(): !string py

    /**
     * The rank given by the vector store search
     */
    rank: !int

    /**
     * The score given by the vector store search
     */
    score: !double

    /**
     * The SourcePassage from which this result is created.
     */
    sourcePassage: !Genai.SourcePassage

    /**
     * Optional additional metadata associated with the sourcePassage.
     */
     // TODO: GEN-9676 This should live on the passage
    additionalMetadata: json

    /**
     * Metadata associated with the sourcePassage
     */
    metadata: map<any, any>
}
