/**
 * Responsible for testing the indexing of {@link Genai.SourceFile}s
 */
@deprecated(finalVersion="6.1", details="Has not been used in a long time and is not expected to be used in the future.")
type Genai.Retriever.TestIndexing {
  /**
   * Removes the generated {@link Genai.SourceFile}, {@link Genai.SourceCollection} and {@link Genai.Retriever}
   */
  cleanUp: function() js-rhino

  /**
   * Creates instances of {@link Genai.SourceFile}, {@link Genai.SourceCollection} and {@link Genai.Retriever}
   */
  setUp: function() js-rhino

  /**
   * Executes a test indexing of a file, and evaluates the result
   */
  isIndexingSuccessful: function(): boolean js-rhino
}
