/**
 * Supported retrievers to use with Genai.Retriever.Dense
 */
enum type Genai.Retriever.Dense.RetrieverType {

    /** Faiss flat index */
    FAISS_FLAT_IP = 'faiss_flat_ip'

    /** Faiss hierarchical index */
    FAISS_HNSW = 'faiss_hnsw'

    /** Exact search */
    EXACT_SEARCH = 'exact_search'

    /** PG vector */
    C3_VECTOR_STORE = 'c3_vector_store'
}
