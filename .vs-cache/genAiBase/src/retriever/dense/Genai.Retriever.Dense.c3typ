/**
 * The Dense Genai.Retriever. Allows selecting the embedder and retriever to use.
 */
@db(unique=['name'])
@seed(userUpdatable=true)
entity type Genai.Retriever.Dense extends Genai.Retriever mixes Genai.Retriever.ConfigFields, Genai.ProjectAware type key 'DNS' {
  name: !~

  /**
   * The spec to pass to {@link Genai.Embedder#getEmbedder} to create a {@link GenaiCore.Embedder} for embedding
   * text such as passages or queries.
   *
   * If no spec is provided, {@link GenaiCore.Embedder.Hf} with "mixedbread-ai/mxbai-embed-large-v1" will be used.
   */
  embedderSpec: Genai.Embedder.Spec

  /**
   * The url of the zipfile containing the pre-indexed data to be searched by the engine
   *
   * This zipfile will contain the following:
   *  * docstore.tsv
   *  * config.json (if using FAISS)
   *  * index.faiss (if using FAISS)
   *  * codemap.json (if there are extracted code snippets)
   */
  indexZipUrl: ~

  /**
   * Maximum token length of a query to look for similar passages.
   * Longer queries will be truncated.
   */
  queryMaxlen: !int = 512

  /**
   * Ignored.
   */
  @deprecated(finalVersion='7.0', details='use embedderSpec.embedderModelName instead')
  embedderModelName: string enum Genai.Retriever.Dense.Embedder = MXBAI

  /**
   * The dense retriever to use.
   */
  denseRetrieverName: !string enum Genai.Retriever.Dense.RetrieverType = FAISS_FLAT_IP

  /**
   * Configuration for {@link Genai.Retriever.Dense.Engine.DeploySpec#threadPool}.
   * Any fields specified here will override the defaults.
   */
  engineThreadPoolSpec: App.Node.ThreadPool.Spec

  similaritySearch: ~ py
  purgeIndex: ~ py
  passageCount: ~ py
  indexedSourceFiles: ~ py
  indexedSourcePassages: ~ py
  indexPassagesFile: ~ py
  codemapFilePath: ~ py
  resultsForPassageIds: ~ py
  initialize: ~ py
  removePassages: ~ py
  supportsIncrementalIndexing: ~ py

  /**
   * Automatically set indexZipUrl when retriever created
   */
  beforeCreate: ~ py

  /**
   * Return the retriever for the given name.
   *
   * @param name
   *        The name of the retriever
   */
  forName: function(name: !string): Genai.Retriever.Dense py

  /**
   * Convenience method to check if the retriever engine is initialized (has set the native_retriever).
   */
  isInitialized: member function(): boolean py

  /**
   * Convenience function to map #embedderModelName to a Genai.Vector type.
   * @return the vector type
   */
  vectorType: private member function(): !Type py

  /**
   * Convenience function to get the Genai.Retriever.Dense.Engine.
   * @return the engine
   */
  engine: private member function(): !Genai.Retriever.Dense.Engine py

  /**
   * Convenience function to call {@link Genai.Retriever.Dense.Engine#terminate}.
   */
  terminateEngine: private member function() py

  /**
   * Convenience function to call {@link Genai.Retriever.Dense.Engine#terminate} on all running {@link Genai.Retriever.Dense.Engine}s.
   */
  terminateAllEngines: private function() py
}
