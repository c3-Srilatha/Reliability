/**
 * The Dense Genai.Retriever engine. Allows selecting the embedder and retriever to use.
 */
type Genai.Retriever.Dense.Engine mixes Genai.RetrieverActions,
  Engine<Genai.Retriever.Dense.Engine.Deployment, Engine.DeploySpec> {
  similaritySearch: ~ py-query_orchestrator-server-py4j
  purgeIndex: ~ py-query_orchestrator-server-py4j
  passageCount: ~ py-query_orchestrator-server-py4j
  indexedSourceFiles: ~ py-query_orchestrator-server-py4j
  indexedSourcePassages: ~ py-query_orchestrator-server-py4j
  indexPassagesFile: ~ py-query_orchestrator-server-py4j
  initialize: ~ py-query_orchestrator-server-py4j
  removePassages: ~ py-query_orchestrator-server-py4j
  codemapFilePath: ~ py-query_orchestrator-server-py4j
  resultsForPassageIds: ~ py-query_orchestrator-server-py4j

  /** See {@link Genai.Retriever.Dense#isInitialized} */
  isInitialized: private member function(): !boolean py-query_orchestrator-server-py4j

  // TODO: GEN-12779 An engine is not required after the migration to the GenaiCore.Embedder
}
