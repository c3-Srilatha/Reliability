/**
 * A retriever backed by pg-vector.
 */
@db(unique=['name'])
entity type Genai.Retriever.PgVector extends Genai.Retriever mixes Genai.Retriever.ConfigFields, Genai.ProjectAware type key 'PG' {
  /**
   * The spec to pass to {@link Genai.Embedder#getEmbedder} to create a {@link GenaiCore.Embedder} for embedding
   * text such as passages or queries.
   *
   * If no spec is provided, {@link GenaiCore.Embedder.Hf} with "mixedbread-ai/mxbai-embed-large-v1" will be used.
   */
  embedderSpec: Genai.Embedder.Spec

  /**
   * The embedder model to use.
   * It should either be the name of a model in the embedder service or one of the enum values from
   * {@link Genai.Retriever.Dense.Embedder}.
   *
   * This will be used to start a {@link GenaiCore.Embedder.Engine} for a {@link GenaiCore.Embedder.Hf} that
   * uses the HuggingFace Sentence Transformer model specified. See {@link GenaiCore.Embedder.Hf} for more
   * details about embedders.
   *
   * Except for when using {@link Genai.Retriever.Dense.Embedder#DPR}, the embedder model is used to embed
   * both source passages and queries. When using {@link Genai.Retriever.Dense.Embedder#DPR}, the embedder
   * for passages is "sentence-transformers/facebook-dpr-ctx_encoder-multiset-base" and
   * "sentence-transformers/facebook-dpr-question_encoder-multiset-base" for queries. If in the future,
   * other embedders use a separate embedder for queries, an additional field, embedderModelNameForQueries,
   * will be added to this type.
   */
  @deprecated(finalVersion="7.0", details="Use embedderSpec.embedderModelName instead")
  embedderModelName: !string = "mixedbread-ai/mxbai-embed-large-v1"

  /**
   * Optional {@link Engine.DeploySpec} to pass to {@link GenaiCore.Embedder.Engine#createFromEmbedder}.
   * May be useful if more parallelism is required for computing embeddings.
   */
  @deprecated(finalVersion="7.0", details="Use embedderSpec.deploySpec instead")
  embedderEngineDeploySpec: Engine.DeploySpec

  /**
   * Maximum token length of a query to look for similar passages.
   * Longer queries will be truncated.
   */
  queryMaxLen: !int = 512

  /**
   * Maximum concurrent batches of passages to index. This is used to limit the number of
   * concurrent IndexActions to processes for this retriever to avoid
   * exceeding the memory available on the task nodes.
   *
   * By default, it is set to 1, so it behaves like other retrievers and schedules
   * indexing jobs one at a time.
   *
   * On GPU-enabled environments, the number should be set to
   * at most the number of GPUs available on all task nodes. Overall indexing time will
   * decrease up to the total number of GPUs being used, but when the number of concurrent
   * IndexActions **exceeds** the number of GPUs, testing shows that computation will take much longer
   * than even scheduling one IndexAction at a time.
   */
  maxConcurrentIndexActions: int = 1

  /**
   * An optional custom spec to pass to the vectorDistance call in similaritySearch.
   * If none is provided, the defaults provided by the current server version will be used.
   */
  vectorDistanceSpec: Expr.DistanceSpec

  /**
   * The type of {@link Genai.Vector.SourcePassage} to use for this retriever.
   * If none is provided, the default {@link Genai.Vector.SourcePassage} will be used.
   */
  sourcePassageType: Type
  similaritySearch: ~ py-query_orchestrator
  /**
   * Returns the top k passages that are most similar to the query.
   * In the case of post-filtering, if fewer than k passages are retrieved,
   * the search is repeated until k passages are retrieved with parallel execution.
   */
  similaritySearchBatch: member function(specsBatch: ![Genai.Retriever.SearchSpec], maxWorkers: int = 10): ![Genai.Retriever.SimilaritySearchBatchResult] py-query_orchestrator

  indexPassagesFile: ~ py-query_orchestrator
  passageCount: ~ py-query_orchestrator
  indexedSourceFiles: ~ py-query_orchestrator
  indexedSourcePassages: ~ py-query_orchestrator
  removePassages: ~ py-query_orchestrator
  initialize: ~ py-query_orchestrator
  supportsIncrementalIndexing: ~ py-query_orchestrator

  /**
   * @inheritdoc
   *
   * Since there is no remote zip file for this retriever, purgeZipLocation
   * is treated as always true and thus file statuses are always updated
   * when purging.
   */
  purgeIndex: ~ py-query_orchestrator

  resultsForPassageIds: ~ py-query_orchestrator

  /**
   * All the source passages indexed by this retriever.
   */
  sourcePassages: [Genai.Vector.SourcePassage] (retriever.id)

  /**
   * Helper function to deterministically assign {@link Genai.Vector.SourcePassage#id} for a given passage and the
   * retriever the function is called on.
   */
  vectorIdForPassage: private inline member function(passage: !Genai.SourcePassage): !string py-query_orchestrator
  /**
   * Creates a new {@link Genai.Retriever.PgVector} with all pre-embedded {@link Genai.Vector.SourcePassage}s from the
   * given file.
   *
   * @param retrieverName
   *         The name (and id) of the retriever to create
   * @param file
   *         The file containing the already embedded {@link Genai.Vector.SourcePassage}s.
   *         The file should be a json file produced by simply serializing the {@link Genai.Vector.SourcePassage}s.
   *         e.g.
   *         ```
   *         vectors = c3.Genai.Vector.SourcePassage.fetch({"filter": ...}).objs
   *         with open('vectors.json', 'w') as f:
   *             json.dump(vectors, f, cls = c3.Genai.PyUtil.jsonEncoder())
   *         ```
   * @param embedderModelName
   *         The embedder model used to embed the passages from the file
   * @param throwIfRetrieverExists
   *         If true, throw an error if a retriever with the given name already exists.
   *         Otherwise, return the existing retriever.
   * @param sourcePassageType
   *         The type of {@link Genai.Vector.SourcePassage} to use for this retriever.
   *         If none is provided, the default {@link Genai.Vector.SourcePassage} will be used.
   * @return the newly created {@link Genai.Retriever.PgVector}
   */
  fromPreEmbeddedVectorSourcePassageFile: private function(retrieverName: !string,
    file: !File,
    embedderModelName: !string,
    throwIfRetrieverExists: boolean,
    sourcePassageType: Type): !Genai.Retriever.PgVector py-query_orchestrator

  /**
   * Applies maxQueryLen to similarity search calls
   */
  truncateQuery: private inline member function(searchString: !string): !string py-query_orchestrator
}
