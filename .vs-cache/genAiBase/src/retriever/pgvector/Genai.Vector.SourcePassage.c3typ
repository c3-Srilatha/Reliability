/**
 * A Genai.Vector subtype that stores the entire SourcePassage in postgres.
 * Used primarily by {@link Genai.Retriever.PgVector}
 */
@db(index += ['emb', 'retriever', 'inactive'])
extendable entity type Genai.Vector.SourcePassage mixes Genai.Vector {
  /**
   * The source from which the passage for the embedding was drawn. Used for filtering on source metadata.
   */
  source: Genai.Source calc sourcePassage.source

  /**
   * The passage whose contents are embedded in the vector.
   */
  sourcePassage: !Genai.SourcePassage

  @vector(dimension=1024)
  emb: ~
}
