/**
 * A version of Genai.Vector.SourcePassage that uses cosine similarity for nearest neighbor search.
 */
@db(index = [{fields:[{name:emb, opClass:COSINE}], neighborsCount:16, efConstruction: 64}, 'retriever', 'inactive'])
entity type Genai.Vector.SourcePassage.Cosine extends Genai.Vector.SourcePassage type key "COS"
