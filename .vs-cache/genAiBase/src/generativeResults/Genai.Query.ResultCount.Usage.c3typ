/**
 * This type is used to define the structure of a {@link FetchResult} object in {@link Genai.Query.ResultCount#usage}.
 */
type Genai.Query.ResultCount.Usage {
  /**
   * The user that made the queries. This will usually be the {@link User#email}. When the user's email is not found,
   * this field will use the {@link User#name}.
   */
  user: !string

  /**
   * The number of queries made by the user.
   */
  totalQueryCount: !int

  /**
   * The time when the user made their last query.
   */
  lastQueryTime: !datetime
}
