/**
 * Output object for the updateStatus operation on {@link Genai.Query.Result}.
 */
type Genai.Query.Result.UpdateStatusResponse {
  /**
   * {@link Genai.Query.Result} whose status was updated.
   */
  generativeAiResult: !Genai.Query.Result

  /**
   * Status added to the statusHistory field of the {@link Genai.Query.Result}.
   */
  updatedStatus: !Genai.Query.Result.InterimStatusHistory
}
