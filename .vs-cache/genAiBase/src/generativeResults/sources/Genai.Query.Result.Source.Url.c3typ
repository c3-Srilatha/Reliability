/**
 * A source URL that was used to get information during a query.
 */
entity type Genai.Query.Result.Source.Url extends Genai.Query.Result.Source.AbstractSourceType type key "URL" {

  /**
   * The domain from the URL source. Query params, etc. can be stripped off to allow a single domain to be a potential
   * source for multiple different queries.
   */
  domain: !string
}
