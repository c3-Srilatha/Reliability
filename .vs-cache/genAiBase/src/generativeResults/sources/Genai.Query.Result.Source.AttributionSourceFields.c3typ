/**
 * Fields used by UI attribution display section on source popup.
 */
type Genai.Query.Result.Source.AttributionSourceFields {

  /**
   * Corroboration indicator
   */
  corroborationIndicator: Genai.Agent.Tool.Util.Corroborator.Indicator

  /**
   * Relevance score indicator
   */
  relevanceScoreIndicator: !Genai.Agent.Tool.Util.Attributor.ScoreIndicator

  /**
   * Source credibility indicator
   */
  sourceCredibilityIndicator: Genai.Agent.Tool.Util.Attributor.ScoreIndicator
}
