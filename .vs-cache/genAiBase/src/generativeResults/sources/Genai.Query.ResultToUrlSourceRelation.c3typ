/**
 * Represents a relation between a query result and a source that was used to generate that result. This relation type
 * allows for a many-to-many relationship between query results and sources.
 */
entity type Genai.Query.ResultToUrlSourceRelation extends Genai.Query.ResultToSourceRelation type key "URL" {

  /**
   * The URL source that was used to generate the query result.
   */
  to: !Genai.Query.Result.Source.Url

  /**
   * The URL that can be visited to learn more about the source.
   */
  url: !string
}
