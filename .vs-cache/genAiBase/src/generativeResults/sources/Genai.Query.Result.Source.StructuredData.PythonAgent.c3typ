/**
 * Details of an information retrieval step that used {@link Genai.Agent.Tool.StructuredDataQueryPy}
 */
entity type Genai.Query.Result.Source.StructuredData.PythonAgent extends Genai.Query.Result.Source.StructuredData type key "PY_AGT" {
  /**
   * The structured query specs used.
   */
  structuredQuerySpecs: ![Genai.StructuredQuery.Spec]

  /**
   * The final data frame produced by the agent
   */
  persistedData: ~

  /**
   * The final source code generated by the agent.
   */
  sourceCode: string

  /**
   * A string representation of the agent's trajectory.
   */
  serializedTrajectory: string

  beforeRemove: ~ js-server

  /**
    * Creates a {@link Genai.Query.Result.Source.StructuredData.PythonAgent} and
    * Genai.Query.ResultToStructuredDataPythonAgentSourceRelation for the provided Result.
    *
    * This is used to persist the source for future use by the rest of the application (including display in the UI).
    */
  createPyAgentSourceAndRelation: function(agentOutput: !Genai.Agent.Tool.StructuredDataQueryPy.Output): Genai.Query.ResultToStructuredDataSourceRelationPythonAgent py-query_orchestrator

}
