/**
  * Base type for all relations.
  */
abstract type Genai.Source.Relation {
  /**
   * Stores the order in which cited passages appear in the UI.
   *
   * NOTE: this is 1-indexed
   */
  passageUiDisplayIndex: private int

  /**
   * Defines the relation for the UI.
   */
  sourceRelationsForUi: abstract function(relations: ![Genai.Source.Relation], step: !Genai.Agent.DynamicTrajectory.Step): ![Genai.Query.Result.Relation]
}
