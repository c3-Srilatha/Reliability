/**
 * An abstract representation of a source that was used during the generation of a {@link Genai.Query.Result}. This
 * type may be extended as new types of sources are defined.
 */
extendable abstract entity type Genai.Query.Result.Source.AbstractSourceType schema name "GENAIQRSRC" {

  /**
   * A fallback display name for a source. This will only be used if a {@link Genai.Query.ResultToSourceRelation} for a
   * {@link Genai.Query.Result} does not have its own {@link Genai.Query.ResultToSourceRelation#displayName}.
   */
  displayName: !string
}
