/**
 * Information about a structured data source used during a query.
 */
extendable entity type Genai.Query.Result.Source.StructuredData extends Genai.Query.Result.Source.AbstractSourceType mixes Genai.WithDataPersisted type key "STRC_QRY" {

  /**
   * In order to support sources that may be shared among multiple queries over time, the id should be generated
   * deterministically. For example, a hash of the source type name combined with the stringified
   * {@link Genai.StructuredQuery.Spec}. This is not a requirement, but could prove useful.
   */
  id: ~

  /**
   * The structured query spec that was used as the source during the query.
   */
  structuredQuerySpec: !Genai.StructuredQuery.Spec

  beforeRemove: ~ js-server

  /**
    * Creates a {@link Genai.Query.Result.Source.StructuredData} and {@link Genai.Query.ResultToStructuredDataSourceRelation}
    * for the provided Result.
    */
  createSourceAndRelation: function(structuredQuerySpec: !Genai.StructuredQuery.Spec, from: Genai.Query.Result | Genai.Agent.DynamicTrajectory.Step, data: Data.Persisted): !Genai.Query.ResultToStructuredDataSourceRelation js
}
