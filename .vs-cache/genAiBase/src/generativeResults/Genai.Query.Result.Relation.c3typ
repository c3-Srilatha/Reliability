/**
 * Parent type for relationships between a {@link Genai.Query.Result} and another entity used as part of a query result.
 */
abstract extendable entity type Genai.Query.Result.Relation schema name "GENAIRR" {

  /**
   * The {@link Genai.Query.Result} that this relation is associated with.
   */
  from: Genai.Query.Result

  /**
   * The {@link Genai.Agent.DynamicTrajectory.Step} that this relation is associated with.
   */
  fromStep: Genai.Agent.DynamicTrajectory.Step

  /**
   * Clones the relations from one {@link Genai.Query.Result} to another
   * @param srcResult
   *        The {@link Genai.Query.Result} to copy the passage relations from
   * @param destResult
   *        The {@link Genai.Query.Result} to copy the passage relations to
   * @return the cloned relations for the destResult
   */
  cloneTo: inline function(srcResult: !Genai.Query.Result, destResult: !Genai.Query.Result): ![mixing Genai.Query.Result.Relation] py

  /**
   * Helper function to clone and return all child relations to the parent query result
   * @param queryResult
   *           The {@link Genai.Query.Result} for which the relations from {@link Genai.Query.Result#childResults} have to be cloned
   * @return the list of relations for parent
   */
  cloneRelationsToParent: inline function(queryResult: !Genai.Query.Result): [mixing Genai.Query.Result.Relation] py

  /**
   * Helper function to clone the relations to the last {@link Genai.Agent.DynamicTrajectory.Step}.
   * Exposed only for testing purposes.
   * @param relations
   *        Array of {@link Genai.Query.Result.Relation}s to copy into the final step
   * @param step
   *        The {@link Genai.Agent.Trajectory.Step} for the final answer step
   * @param content
   *        The final answer string
   * @return
   *        A tuple containing the cloned relations and the updated final answer string
   */
  cloneRelationsToTrajectory: private inline function (relations: [!Genai.Query.Result.Relation], step: !Genai.Agent.Trajectory.Step, content: !string): Tuple py

  /**
   * Helper function to return all relations to the parent query result
   * @param queryResult
   *           The {@link Genai.Query.Result} for which the relations should be returned
   * @return the list of relations for parent
   */
  relationsForParent: inline function(queryResult: !Genai.Query.Result): [mixing Genai.Query.Result.Relation] py
}
