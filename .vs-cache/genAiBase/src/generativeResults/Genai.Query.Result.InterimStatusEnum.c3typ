/**
 * Represents a status of the {@link Genai.Query.Result} in the
 * process to answer a query (processing query, searching documents, generating final answer...)
 */
enum type Genai.Query.Result.InterimStatusEnum {

  /** The query is being completed */
  COMPLETED = 'Completed'

  /** The metric is being evaluated */
  EVALUATE_METRIC = 'EvaluateMetric'

  /** The answer is being generated */
  GENERATE_ANSWER = 'GenerateAnswer'

  /** The visualization is being generated */
  GENERATE_VISUALIZATION = 'GenerateVisualization'

  /** The follow-up queries are being generated */
  GENERATE_FOLLOW_UP_QUERIES = 'GenerateFollowUpQueries'

  /** The query tool is stale */
  EVAL_QUERY_TOOL_STALE = 'EvalQueryToolStale'

  /** The query tool is being initialized */
  INITIALIZE_EVAL_QUERY_TOOL = 'InitializeEvalQueryTool'

  /** The structured query tool is being initialized */
  INITIALIZE_STRUCTURED_QUERY_TOOL = 'InitializeStructuredQueryTool'

  /** The unstructured query tool is being initialized */
  INITIALIZE_UNSTRUCTURED_QUERY_TOOL = 'InitializeUnstructuredQueryTool'

  /** The multi-source query tool is being initialized */
  INITIALIZE_MULTI_SOURCE_QUERY_TOOL = 'InitializeMultiSourceQueryTool'

  /** Generating args for C3 method */
  C3_METHOD_GENERATE_ARGS = 'C3MethodGenerateArgs'

  /** Invoking C3 method */
  C3_METHOD_INVOKE_METHOD = 'C3MethodInvokeMethod'

  /** Processing C3 method result */
  C3_METHOD_PROCESS_RESULT = 'C3MethodProcessResult'

  /** Processing query */
  PROCESS_QUERY = 'ProcessQuery'

  /** Querying database */
  QUERY_DATABASE = 'QueryDatabase'

  /** Searching documents */
  SEARCH_DOCUMENTS = 'SearchDocuments'

  /** Retrieving data from all sources */
  RETRIEVE_DATA = 'RetrieveDataFromAllSources'

  /** The query tool is to be used next */
  USE_EVAL_QUERY_TOOL = 'UseEvalQueryTool'

  /** The structured query tool is to be used next */
  USE_STRUCTURED_QUERY_TOOL = 'UseStructuredQueryTool'

  /** The unstructured query tool is to be used next */
  USE_UNSTRUCTURED_QUERY_TOOL = 'UseUnstructuredQueryTool'

  /** The multi-source query tool is to be used next */
  USE_MULTI_SOURCE_QUERY_TOOL = 'UseMultiSourceQueryTool'

  /** The web search tool is to be used next */
  USE_WEB_SEARCH_TOOL = 'UseWebSearchTool'

  /** The multi-source query tool is stale */
  MULTI_SOURCE_QUERY_TOOL_STALE = 'MultiSourceQueryToolStale'

  /** Failed */
  FAILED = 'Failed'

  /** Initializing planner */
  INITIALIZE_PLANNER = 'InitializePlanner'

  /** Generating plan */
  GENERATE_PLAN = 'GeneratePlan'

  /** Generating plan completed */
  GENERATE_PLAN_COMPLETED = 'GeneratePlanCompleted'

  /** Executing plan */
  EXECUTE_PLAN = 'ExecutePlan'

  /** Initializing dynamic agent */
  INITIALIZE_DYNAMIC_AGENT = 'InitializeDynamicAgent'

  /** The dynamic agent is to be used */
  USE_DYNAMIC_AGENT = 'UseDynamicAgent'
}
