/**
 * Representation of the result from calling {@link Genai.Query.Result#getForUi}.
 */
type Genai.Query.Result.GetForUiResult mixes Genai.Query.Result.BaseResultForUi {

  /**
   * All {@link Genai.Query.Result.BaseResultForUi} for the direct children of this query.
   */
  childResultsForUi: [Genai.Query.Result.BaseResultForUi]

  /**
   * The {@link Genai.Query.ChatMessage} for this result. 
   */
  chatMessage: private Genai.Query.ChatMessage
}
