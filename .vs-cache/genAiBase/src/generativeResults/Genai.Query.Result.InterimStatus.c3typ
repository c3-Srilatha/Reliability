/**
 * Represents an intermediate status of a generative AI result while the query is being answered
 */
type Genai.Query.Result.InterimStatus mixes TimedValue {
  /**
   * The interim status of the generative AI result
   */
  status: Genai.Query.Result.InterimStatusEnum

  /**
   * Used internally to ensure the correct order of interim statuses
   */
  sortIndex: private int

  /**
   * If this status is part of a larger status update, this is its parent. {@see Genai.Query.Result#updateStatus}
   */
  statusParent: Genai.Query.Result.InterimStatusHistory
}
