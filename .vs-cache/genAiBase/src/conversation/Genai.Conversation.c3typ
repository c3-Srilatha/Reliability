/**
 * Represents a conversation a user has initiated in the app.
 * A conversation is comprised of a parent query and any follow up chats.
 */
entity type Genai.Conversation mixes Genai.WithSoftRemove, Genai.ProjectAware {
  /**
   * Title of the conversation.
   */
  title: string

  /**
   * The initial {@link Genai.Query.Result} of the conversation.
   */
  parentResult: !Genai.Query.Result

  /**
   * Follow up chat queries associated with the original #parentResult.
   */
  chatMessages: [Genai.Query.ChatMessage]

  /**
   * Foreign key to the {@link Genai.Query.Result}s in this conversation.
   */
  queryResults: private [Genai.Query.Result](conversation)

  /**
   * Creates a new {@link Genai.Conversation} entity with the given {@link Genai.Query.Result}.
   * @param queryResult
   *      The first {@link Genai.Query.Result} in the conversation.
   * @return
   *      The same {@link Genai.Query.Result} with an updated {@link Genai.Query.Result#conversation} field.
   */
  startConversation: function(queryResult: !Genai.Query.Result): !Genai.Query.Result js-rhino

  /**
   * Applies the {@link Genai.Conversation} from the parent {{@link Genai.Query.Result#conversation} to the follow-up
   * query's {@link Genai.Query.Result#conversation} field.
   * @param queryResult
   *      The follow-up {@link Genai.Query.Result} in the conversation.
   * @param parentQueryResult
   *      The original {@link Genai.Query.Result} that started the conversation.
   * @return
   *      The same {@link Genai.Query.Result} with an updated {@link Genai.Query.Result#conversation} field.
   */
  continueConversation: function(queryResult: !Genai.Query.Result, parentQueryResult: !Genai.Query.Result): !Genai.Query.Result js-rhino

  /**
   * Rename the conversation.
   * @param title
   *      The new title of the conversation.
   * @return
   *      The conversation entity with the new title.
   */
  rename: member function (title: !string): !Genai.Conversation js-rhino

  /**
   * Returns a {@link Genai.Conversation} with the appropriate #parentResult and #chatMessages.
   * @param queryResult
   *      The result of the query that initiated the conversation.
   * @param hideEditedResults
   *      Whether the conversation should hide edited results.
   * @param fullResult
   *     Whether the conversation should include all fields in the result or only the main ones needed in the feed.
   */
  forResult: function(queryResult: !Genai.Query.Result, hideEditedResults: boolean, fullResult: boolean): !Genai.Conversation js-rhino

  /**
   * Returns a string that include all the fields needs to be included in the query for UI.
   * @param fullResult
   *     Whether to include all fields in the result or only the main ones needed in the feed.
   */
  queryResultIncludeString: inline function(fullResult: boolean): !string js-rhino

  /**
   * Gets the fields needed for the definition list on the query detail page.
   */
  getFieldsForConversationDetailPage: private function(queryResult: !Genai.Query.Result): !json js-rhino

  /**
   * Calculates the latency for {@link Genai.Conversation}.
   */
  calculateLatency: private function(result: !Genai.Query.Result): double js-rhino

  /**
   * The timestamp of the last query from the conversation.
   */
  lastUpdated: datetime stored calc latest(parentResult.meta.updated, latest(parentResult.chatHistory.meta.updated))

  /**
   * Fetches conversations for a specific user, ensuring users only see their own conversations.
   * Overrides the ProjectAware implementation to add user-based filtering.
   * @param spec
   *         {@link FetchSpec} for fetching the conversations.
   * @param user
   *         {@link User} for whom to fetch the conversations.
   * @return filtered conversations for the user.
   */
  fetchForUser: function(spec: FetchSpec, user: User): !FetchResult js-rhino

  /**
   * Counts conversations for a specific user, ensuring users only see their own conversations.
   * Overrides the ProjectAware implementation to add user-based filtering.
   * @param spec
   *         {@link FetchSpec} for counting the conversations.
   * @param user
   *         {@link User} for whom to count the conversations.
   * @return count of filtered conversations for the user.
   */
  fetchCountForUser: function(spec: FetchSpec, user: User): number js-rhino
}
