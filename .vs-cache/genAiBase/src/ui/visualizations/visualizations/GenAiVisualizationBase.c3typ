/**
 * Root type to mixin to the different GenAiVisualization implementations.
 */
abstract type GenAiVisualizationBase {
  /**
   * Data retrieved by the {@link Genai.UnstructuredQuery.Engine} that is used to answer the original query.
   */
  data: Data not persistable

  /**
   * The {@link Genai.Agent.DynamicData} containing the data to be visualized
   */
  dynamicData: Genai.Agent.DynamicData

  /**
   * Only required if an #evalMetricsSpec or #evalSpec is provided. This target type will used for
   * those calls to populate the data to be visualized.
   */
  sourceType: string

  /**
   * Optional spec passed to the UI to generate the visualization from an `evalMetrics` call rather than from
   * #data. One of #data, #evalMetricsSpec, or #evalSpec must be set, with `data`
   * always taking precedence. The visualization generated by the `evalMetricsSpec` will always be a Line Chart.
   */
  evalMetricsSpec: EvalMetricsSpec

  /**
   * Optional spec passed to the UI to generate the visualization from an `evaluate` call rather than from #data.
   * One of #data, #evalMetricsSpec, or #evalSpec must be set, with `data` always taking
   * precedence.
   */
  evalSpec: EvalSpec | EvaluateSpec

  /**
   * An optional title to render above the visualization.
   */
  title: string

  /**
   * A JSON representation of a {@link UiSdlComponent} that will be rendered as part of a
   * {@link UiSdlDynamicComponentRenderer}.  The specific JSON will be set in #generateUiComponent.
   */
  visualizationConfiguration: private json

  /**
   * Function to be implemented by each type that mixes {@link GenAiVisualizationBase}.  If a visualization mixin does
   * not yet implement this function a {@link GenAiUiSearchResultGrid} will be returned.
   * @return A type that mixes {@link GenAiVisualizationBase} with the #visualizationConfiguration field set.
   */
  setVisualizationConfiguration: member function(): mixing GenAiVisualizationBase js-rhino

  /**
   * Function to be implemented by each type that mixes {@link GenAiVisualizationBase}.  If a visualization mixin does
   * not yet implement this function a {@link GenAiUiSearchResultGrid} will be returned.
   * @return A JSON representation of a {@link UiSdlComponent}.
   */
  generateUiComponent: private member function(): json js-rhino

  /**
   * Function to configure a JSON representation of a {@link UiSdlComponent} that will be rendered if any of the
   * #generateUiComponent APIs fail.
   * @return A JSON representation of a {@link UiSdlComponent} that will be rendered to communicate an error to the
   *          end User.
   */
  generateErrorComponent: final private member function(): json js-rhino

  /**
   * For each type mixing `GenAiVisualizationBase`, this function is called within #generateUiComponent to
   * return the base component configuration options needed by _all_ types of visualizations.
   */
  getBaseComponentConfiguration: private member function(): json js-rhino

  /**
   * Converts {@link Data} into the properties needed by the UI to render a visualization.
   *
   * @param dataFrame
   *           The {@link Data} to convert the data for.
   * @param columnNamesToUse
   *           If given, these column names will replace the ones they are associated with in the original dataframe.
   * @return A `GenAiVisualizationDataFrameProps` with the correctly named data and columns.
   */
  convertDataForVisualization: private function(dataFrame: !Data, columnNamesToUse: [string]): !GenAiVisualizationDataFrameProps js-rhino

  /**
   * For visualization configurations that are returned to the UI with a {@link GenAiUiVisualization#evalSpec} of type {@link EvalSpec} instead
   * of data, this helper will make the {@link Persistable#eval} for the `sourceType` to generate the data needed to
   * render the visualization.
   */
  getVisualizationDataFromEvalSpec: function(sourceType: !string, evalSpec: !EvalSpec): !GenAiVisualizationDataFrameProps js-rhino

  /**
   * For visualization configurations that are returned to the UI with a {@link GenAiUiVisualization#evalSpec} of type {@link EvaluateSpec} instead
   * of data, this helper will call {@link Evaluatable#evaluate} for the `sourceType` to generate the data needed to
   * render the visualization.
   */
  getVisualizationDataFromEvaluateSpec: function(sourceType: !string, evalSpec: !EvaluateSpec): !GenAiVisualizationDataFrameProps js-rhino

  /**
   * For visualization configurations that are returned to the UI with a {@link Genai.Agent.DynamicData} instead
   * of data, this helper will make the required call to generate the data needed to render the visualization.
   * @param dynamicData
   *           The {@link Genai.Agent.DynamicData} containing a reference to the dataframe data
   * @return with the correctly named data and columns.
   */
  getVisualizationDataFromDynamicData: function(dynamicData: !Genai.Agent.DynamicData): !GenAiVisualizationDataFrameProps py-query_orchestrator

  /**
   * For visualization configurations that are returned to the UI with a {@link GenAiUiVisualization#evalSpec} instead
   * of data, this helper will make the required call to generate the data needed to render the visualization. Depending on the type of
   * {@link GenAiUiVisualization#evalSpec}:
   *  - If it is an {@link EvalSpec}, call {@link Persistable#eval} for the `sourceType`
   *  - If it is an {@link EvaluateSpec}, call {@link Evaluatable#evaluate} for the `sourceType`
   *  Notice the `type` should be passed explicitly as part of the spec, otherwise it will default to {@link EvaluateSpec}
   * @param sourceType
   *           The name of the {@Type} representing the data
   * @param spec
   *           The {@link EvalSpec} or {@link EvaluateSpec} associated for the data
   * @param sourceRelationId
   *           The id of the {@link Genai.Query.ResultToSourceRelation} for this visualization
   * @return with the correctly named data and columns.
   */
  getVisualizationDataFromSpec: function(sourceType: !string, spec: !json, sourceRelationId: string): !GenAiVisualizationDataFrameProps js-rhino

  /**
   * Wraps {@link MetricEvaluatable#evalMetrics} and first checks that the type is in the list returned by
   * {@link Genai.StructuredData.Config#whiteListedMetrics}.
   */
  doEvalMetrics: function(sourceTypeName: !string, spec: !EvalMetricsSpec): !EvalMetricsResult js-rhino

  /*
   * IMPORTANT: Pandas dataframe serialization is not yet supported in the C3 Type System (PLAT-40360)
   * This function should only be used inside other python functions. Calling it across different runtimes
   * will result in a NotImplementedError from the serialization layer
   */

  /**
   * Given a Pandas dataframe, returns the most relevant visualization for it. This function is recommended
   * over #forData when the dataframe is already a Pandas dataframe.
   *
   * If the structuredQuerySpec is for eval, the GenAiVisualizationBase passes an evalSpec.
   * If the structuredQuerySpec is for evalMetric, the GenAiVisualizationBase passes an evalMetricsSpec.
   * Otherwise, the data is passed by value.
   *
   * Note: Currently we do not support pass-by-spec for evaluateSpec, so this parameter is ignored.
   *
   * @param df
   *         The Pandas dataframe to generate a visualization for
   * @param structuredQuerySpec
   *          The structured query spec to generate a visualization for
   * @return A GenAiVisualizationBase object that contains the visualization configuration
   */
  forPandas: function(df: !native, structuredQuerySpec: Genai.StructuredQuery.Spec): GenAiVisualizationBase py-query_orchestrator


  /**
   * Given a Pandas dataframe, returns the most relevant visualization for it. This function is similar to
   * #forPandas, but does not require a structuredQuerySpec and will not save the dataframe to the visualization
   * object.
   * @param df
   *         The Pandas dataframe to generate a visualization for
   * @param threshIntAsCat
   *         The threshold for the number of unique values in a column to be considered a categorical column
   * @param threshUsePie
   *         The threshold for the number of unique values in a column to be considered for a pie chart
   * @return A GenAiVisualizationBase object that contains the visualization configuration
   */
  generateVizSpec: function(df: !native, threshIntAsCat: int, threshUsePie: int): GenAiVisualizationBase py-query_orchestrator

  /**
   * Given a {@link Data} object, returns the most relevant visualization for it. Private function
   * that is only exposed for testing purposes.
   *
   * If the structuredQuerySpec is for eval, the GenAiVisualizationBase passes an evalSpec.
   * If the structuredQuerySpec is for evalMetric, the GenAiVisualizationBase passes an evalMetricsSpec.
   * Otherwise, the data is passed by value.
   *
   * Note: Currently we do not support pass-by-spec for evaluateSpec, so this parameter is ignored.
   *
   * @param data
   *         The C3 Data object to generate a visualization for
   * @param structuredQuerySpec
   *         The structured query spec used to generate #data
   * @return A GenAiVisualizationBase object that contains the visualization configuration
   */
  forData: private function(data: !Data,
                            structuredQuerySpec: Genai.StructuredQuery.Spec):
                                                              GenAiVisualizationBase py-query_orchestrator-server-py4j
  /**
   * The {@link Genai.Agent.Tool} that generated the spec to get the visualization.
   * This is used when {@link Genai.Agent.Tool.MultiSourceSynthesizer} is used to answer a query and {@link Genai.Query.Result#childResults} generates spec to render a visualization.
   */
  toolId: string

  /**
   */
   // TODO GEN-6330 Render visualizations using the structured sources in UI
  /**
   * The {@link Genai.Query.ResultToSourceRelation} created for the spec that this visualization is generated on.
   */
  sourceRelation: Genai.Query.ResultToSourceRelation
}
