/**
 * An abstract type with fields and mixins common to all Gen AI UI visualizations.
 */
abstract type GenAiUiVisualization mixes UiSdlComponent<UiSdlNoData>, UiSdlComponentTitle, UiSdlHeight, GenAiVisualizationDataFrameProps {

  @constraint(required=false)
  title: ~

  height: ~ = 400

  /**
   * Required if an #evalMetricsSpec or an #evalSpec is provided. Not required if #data is
   * provided.
   */
  sourceType: string

  /**
   * An alternative to passing in #data to the visualization. If an `evalMetricsSpec` is provided, the
   * visualization will make it's own `evalMetrics` call after initial render to populate the visualization. This
   * also requires a #sourceType to be provided.
   */
  evalMetricsSpec: EvalMetricsSpec

  /**
   * An alternative to passing in #data to the visualization. If an `evalSpec` is provided, the
   * visualization will make it's own `eval` call after initial render to populate the visualization. This
   * also requires a #sourceType to be provided.
   */
  evalSpec: EvalSpec | EvaluateSpec

  /**
   * The {@link Genai.Query.ResultToSourceRelation} created for the spec that this visualization is generated on.
   */
  sourceRelation: Genai.Query.ResultToSourceRelation

  /**
   * The {@link Genai.Agent.DynamicData} containing the data to be visualized.
   */
  dynamicData: Genai.Agent.DynamicData
}
