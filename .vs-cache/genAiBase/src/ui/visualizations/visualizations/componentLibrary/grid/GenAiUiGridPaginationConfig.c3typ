/**
 * A type that represents the pagination configuration of a {@link GenAiUiGrid}.
 * See {@link https://www.telerik.com/kendo-react-ui/components/grid/api/GridProps/#toc-pageable}
 */
type GenAiUiGridPaginationConfig {
  /**
   * Number of records to show per page.
   */
  pageSize: int enum(5, 10, 20, 30, 40) = 10

  /**
   * The list of page size options displayed in the page size dropdown.
   */
  pageSizes: private [int] = [5, 10, 20, 30, 40]

  /**
   * Sets the maximum numeric buttons count before the buttons are collapsed.
   */
  buttonCount: int = 3

  /**
   * Toggles the information about the current page and the total number of records.
   */
  info: boolean = true

  /**
   * Accepts the `numeric` (buttons with numbers) and `input` (input for typing the page number) values.
   */
  pageType: string enum('numeric', 'input') = 'numeric'

  /**
   * Toggles the Previous and Next buttons.
   */
  previousNext: boolean = true
}
