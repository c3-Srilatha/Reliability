/**
 * A presentational UI component used to render tabular data.
 */
@typeScript
type GenAiUiGrid mixes UiSdlComponent<UiSdlNoData> {
  /**
   * The data to show in the grid. Data should be an array of plain json objects.
   */
  data: [json]

  /**
   * The columns in the grid.
   */
  columns: [GenAiUiGridColumn]

  /**
   * The configuration for how to configure a pager for the grid.  `true` will use the defaults from KendoGrid while
   * `false` will not use a pager at all.
   */
  paginationConfig: GenAiUiGridPaginationConfig | boolean = true

  /**
   * Configures the style and density of the rows in the grid.
   */
  rowConfig: UiSdlDataGridRowConfig = {}
}
