/**
 * A single column configuration for a {@link GenAiUiGrid}.
 */
type GenAiUiGridColumn {
  /**
   * The name of the field from {@link GenAiUiGrid#data} for which this column is bound.
   */
  field: !string

  /**
   * The alignment of the corresponding column in the {@link GenAiUiGrid}.
   */
  alignment: string enum('LEFT', 'RIGHT', 'CENTER') = 'LEFT'

  /**
   * The name of the column, if one is not provided then #field will be used.
   */
  title: string

  /**
   * The text to show on a tooltip when hovering over the column header.
   */
  tooltipText: string
}
