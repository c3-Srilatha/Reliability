/**
 * A UI component used to render tabular data for a data visualization based on a Generative AI search result. The
 * downstream {@link GenAiUiGrid} will be rendered inside a {@link GenAiUiVisualizationContainer} that
 * provides support for a title and other actions.
 */
@typeScript
type GenAiUiSearchResultGrid mixes GenAiUiVisualization {
  /**
   * The data to show in the grid. Data should be plain json objects and will be treated as such in the TSX renderer.
   */
  data: ~
}
