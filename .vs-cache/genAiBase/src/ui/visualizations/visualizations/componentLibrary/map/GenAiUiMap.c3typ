/**
 * A presentational UI component used to render markers on a map.
 */
@typeScript
type GenAiUiMap mixes UiSdlComponent<UiSdlMapDataSpec>, UiSdlHeight {
  /**
   * See {@link GenAiVisualizationMap#data} for the expected shape. Keys in the data may be referenced within
   * dataSpec and tooltipConfig in order to render data in the map.
   */
  data: [json]

  /**
   * A configuration for various features of the map, such as the fields from data that represent the latitude
   * and longitude of each marker, and the fields that will be used to populate the tooltip that gets rendered on click
   * of each marker.
   */
  dataSpec: UiSdlMapDataSpec
}
