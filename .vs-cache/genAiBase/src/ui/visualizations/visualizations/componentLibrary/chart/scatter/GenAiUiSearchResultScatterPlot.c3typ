/**
 * A simple UI component used to render a scatter plot.
 */
@typeScript
type GenAiUiSearchResultScatterPlot mixes GenAiUiChart {

  /**
   * Optional reference to a field name within #data that should be used to group the data into series. This
   * can be used to add bubble colors and legends to the chart. If not provided, all data will be rendered as a single
   * series and a legend will not be rendered.
   */
  groupBy: string

  /**
   * Optional reference to a field name within #data that should be used to create the relative sizes of the
   * bubbles. If not provided, all bubbles will be the same size.
   */
  bubbleSizeBy: string
}
