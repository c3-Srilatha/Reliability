/**
 * A simple UI component used to render a line chart.
 */
@typeScript
type GenAiUiSearchResultLineChart mixes GenAiUiChart {

  /**
   * The field name to use for grouping. This is used to generate the series keyed on a specific column in the incoming
   * #data.
   *
   * See GenAiVisualizationLineChart#groupBy
   */
  groupBy: string

  /**
   * The field names to use for grouping. This is used to generate a series for each column name passed in.
   *
   * See GenAiVisualizationLineChart#groups
   */
  groups: [string]
}
