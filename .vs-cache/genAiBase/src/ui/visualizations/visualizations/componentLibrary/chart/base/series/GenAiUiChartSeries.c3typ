/**
 * Base common properties for a chart series.
 */
// Resolve commonalities with UiSdlChartEChartSeries
type GenAiUiChartSeries {
  /**
   * The type of series
   */
  seriesType: string enum('line', 'bar')

  /**
   * Series name used for displaying in tooltip and filtering with legend.
   */
  name: string

  /**
   * Unique identifier for the series
   */
  id: string

  /**
   * An array of data that will be charted. Each value must be an array with two elements: [x-value, y-value], where
   * <x-value> is of type string (including stringified dates) and <y-value> is of type double.
   */
  data: [[string | datetime | double | int]]
}
