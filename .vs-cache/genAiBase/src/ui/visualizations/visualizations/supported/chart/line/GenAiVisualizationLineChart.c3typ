/**
 * Type designed to dynamically render a {@link GenAiUiSearchResultLineChart} as a visualization for a
 * {@link Genai.Query.Result}.
 */
type GenAiVisualizationLineChart mixes GenAiVisualizationChart {

  /**
   * An alternative to using #groups. A field in the #data that should be used to group the data into
   * series.
   *
   * In an example data format like below, if `groupBy` is set to `"severity"`, then the chart will have 3 series.
   * In this case, #yAxes should be set to `["count"]`.
   *
   * ```
   * |-------|----------|-------|
   * | date  | severity | count |
   * |-------|----------|-------|
   * | Jan 1 | low      | 10    |
   * | Jan 1 | medium   | 5     |
   * | Jan 1 | high     | 3     |
   * | Jan 2 | low      | 8    |
   * | Jan 2 | medium   | 6     |
   * | Jan 2 | high     | 2     |
   * |-------|----------|-------|
   * ```
   */
  groupBy: string

  /**
   * An alternative to using #groupBy. A list of fields in the #data that will be used as the groups.
   *
   * In an example data format like below, if `groups` is set to `['low', 'medium', 'high']`, then the chart will have
   * 3 series. In this case, the #yAxes do not need to be references to columns in the data and should be
   * provided to populate the y-axis labels in the chart.
   *
   * ```
   * |-------|-----|--------|------|
   * | date  | low | medium | high |
   * |-------|-----|--------|------|
   * | Jan 1 | 10  | 5      | 3    |
   * | Jan 2 | 8   | 6      | 2    |
   * |-------|-----|--------|------|
   * ```
   */
  groups: [string]

  /**
   * If using #groupBy, this should be an array of length 1 containing the field in the #data that
   * should be used as the y-axis.
   * If using #groups, the labels for the y-axes.
   */
  yAxes: ~

  generateUiComponent: ~
}
