/**
 * Root type for dynamic chart visualizations
 */
abstract type GenAiVisualizationChart mixes GenAiVisualizationBase {
  /**
   * The field in the #data that maps to the x-axis
   */
  xAxis: !string

  /**
   * The fields in the #data that maps to the y-axes
   */
  yAxes: ![string]

  /**
   * @inheritdoc
   * If a title is not provided, a default title will be generated using the #xAxis and #yAxes fields.
   */
  title: ~
}
