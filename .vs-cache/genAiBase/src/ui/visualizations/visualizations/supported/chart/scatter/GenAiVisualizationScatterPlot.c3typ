/**
 * Type designed to dynamically render a {@link GenAiUiSearchResultScatterPlot} as a visualization for a
 * {@link Genai.Query.Result}.
 */
type GenAiVisualizationScatterPlot mixes GenAiVisualizationChart {

  /**
   * The name of the field to group the data by. This can be used to render multiple series on the same chart.
   */
  groupBy: string

  /**
   * The name of the field to use for the bubble size. This can be used to render bubbles in different sizes.
   */
  bubbleSizeBy: string

  generateUiComponent: ~
}
