/**
 * Spec for a standalone query used by the methods from {@link Genai.ChatBot}.
 */
type Genai.ChatBot.QueryResultSpec mixes Spec {
  /**
   * The result that should be used by the atomic chat interaction
   */
  inProgressResult: Genai.Query.Result

  /**
   * Whether the creation of passage relations should be skipped.
   */
  doNotCreateRelations: boolean

  /**
   * Whether the response for the query should be  streamed.
   */
  streamResponse: boolean

  /**
   * The type of the handler that should be used for the atomic chat interaction.
   */
  handlerTypeName: string enum ('Genai.UnstructuredQuery.Engine',
                                'Genai.Agent.QueryOrchestrator',
                                'Genai.Project.QueryRouter',
                                'Genai.MockUnstructuredQueryEngine') = 'Genai.UnstructuredQuery.Engine'
}
