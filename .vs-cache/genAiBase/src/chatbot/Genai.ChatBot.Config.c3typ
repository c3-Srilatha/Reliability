/**
 * Config type used for switching in and out fake chat in the UI
 */
type Genai.ChatBot.Config mixes Config, Singleton {

  /**
   * Where to send Genai.ChatBot requests
   */
  handlerTypeName: string enum ('Genai.UnstructuredQuery.Engine', 'Genai.MockUnstructuredQueryEngine', 'Genai.Agent.QueryOrchestrator',
                                'Genai.Project.QueryRouter') = 'Genai.Agent.QueryOrchestrator'

  /**
   * Whether Genai.ChatBot is using projects for handling queries
   */
  isUsingProjects: member function(): !boolean js-rhino
}
