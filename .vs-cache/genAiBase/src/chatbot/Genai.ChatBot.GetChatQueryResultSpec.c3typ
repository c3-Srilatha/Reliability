/**
 * Spec for an atomic query (either standalone or chat) used by {@link Genai.ChatBot}.
 */
type Genai.ChatBot.GetChatQueryResultSpec mixes Genai.ChatBot.QueryResultSpec, Spec {
  /**
   * For chat queries, the result corresponding to the initial query
   */
  originalAiResult: Genai.Query.Result

  /**
   * For chat queries, history of messages that will be used for the atomic chat interaction.
   * This messages will be used for producing a standalone rewritten query capturing the context of the chat.
   */
  chatHistory: [Genai.Query.ChatMessage]

  }
