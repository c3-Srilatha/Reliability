/**
 * A specific message inside a chat that a user sent to the generative model.
 */
entity type Genai.Query.ChatMessage schema name "CHTMSSG" {

  /**
   * The original query that the user made and then had a follow-up chat on.
   */
  parentAiResult: !Genai.Query.Result

  /**
   * The message sent by the user to the generative model.
   */
  message: !string

  /**
   * The time the message was sent in the UI.
   */
  sentTime: !datetime

  /**
   * {@link User} who sent the message.
   */
  user: !User

  /**
   * The {@link Genai.Query.Result} response from the model.
   */
  responseAiResult: !Genai.Query.Result
}
