/**
 * Project settings for the app.
 */
entity type Genai.Project.Settings mixes DefaultInstance {
  /**
   * The tutorial project for the app
   */
  tutorialProject: Genai.Project

  /**
   * The non-tutorial project for the app
   */
  defaultProject: !Genai.Project

  /**
   * Get the default (currently only supported) instance.
   */
  getDefaultSettings: function(): !Genai.Project.Settings js

  inst: ~ js

  /**
   * Initialize the #tutorialProject and #defaultProject
   */
  initializeProjects: member function() js

  // TODO GEN-3562 implement beforeUpdate
  // beforeUpdate: ~ js-rhino
}
