/**
 * The 'query handler'/router for Genai.ChatBot when the application
 * is using {@link Genai.Project}s.
 */
type Genai.Project.QueryRouter {

  /**
   * Get the correct {@link Genai.Query.Handler} to answer the current user's query.
   */
  handler: function(): !Genai.Query.Handler js-rhino
}
