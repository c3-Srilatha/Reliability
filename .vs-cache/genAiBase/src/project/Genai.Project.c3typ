/**
 * A Genai.Project encompasses a set of indexed (in the #retriever) documents and all configurations necessary to
 * answer queries based on those documents.
 *
 * NOTE: Genai.Projects currently only support the R(E)A query engine.
 */
@db(unique=['name'])
entity type Genai.Project mixes WithName, Genai.Query.Handler, AclEnabled {
  /**
   * The description of this project.
   */
  description: string

  /**
   * The type of this project.
   * Enum type: {@link Genai.Project.Type}.
   * Default to production project.
   */
  // This should be required, but introducing it as required causes errors with existing instances...
  projectType: Genai.Project.Type = PRODUCTION

  /**
   * The retriever which will be used to answer queries for this project. If this is not set and the desired retriever
   * is a subtype of {@link Genai.Retriever.Dense}, then it must be specified
   * on the #unstructuredQueryEngineConfigName as {@link Genai.UnstructuredQuery.Engine.Config#vectorStore}.
   */
  //TODO: GEN-5537 support projects that only have structured data (so no retriever)
  retriever: Genai.Retriever

  /**
   * Helper function to safely get the #retriever for this project. If the project's #retriever is not set, then the
   * retriever indicated by {@link Genai.UnstructuredQuery.Engine.Config} set as
   * #unstructuredQueryEngineConfigName will be used and set as the project's #retriever.
   */
  //TODO: GEN-5537 support projects that only have structured data (so no retriever)
  safeRetriever: private member function(): !Genai.Retriever js-rhino

  /**
   * All results from user queries for this project.
   */
  results: [Genai.Query.Result] (project)

  /**
   * All collections that have been indexed into the #retriever for this project.
   */
  collections: [Genai.SourceCollection] calc getCollections(id)

  /**
   * All files in all #collections that have been indexed into the #retriever for this project.
   */
  // files: property(): [Genai.SourceFile] js-rhino

  /**
   * Make this project read-only. This will be propagated to the #retriever.
   */
  // setReadOnly: member function()

  /**
   * Overridden to make sure that changes to readOnly, projectType, etc are handled consistently and propagated.
   *
   * e.g. if projectType is set TUTORIAL, then the retriever needs to be (a) readOnly and (b) migrated/copied to Genai.Retriever.Dense.Tutorial
   */

  // TODO GENAI-3127 Implement beforeUpdate
  // beforeUpdate: ~ js-rhino

  /**
   * Whether this project is read-only (and therefore cannot be modified)
   */
  readOnly: boolean

  /**
   * The chunker config used when indexing documents into the #retriever for this project.
   */
  chunkerConfig: !Genai.SourceFile.Chunker.UniversalChunker.Config

  /**
   * The groups with access to this project.
   */
  groups: [Role] = ['Genai.Common', 'C3.ClusterAdmin', 'C3.EnvAdmin', 'C3.AppAdmin']

  /**
   * Initialize this project by starting processes for the #retriever and queryEngine.
   */
  initialize: member function() js-rhino

  /**
   * The name of the {@link Genai.UnstructuredQuery.Engine.Config} for the {@link Genai.UnstructuredQuery.Engine} for this project.
   * Either this or #queryOrchestratorConfigName should be specified for the project
   */
  //TODO: GEN-5537 support projects that only have structured data (so no retriever)
  unstructuredQueryEngineConfigName: string

  /**
   * The name of the {@link Genai.Agent.Config} for the {@link Genai.Agent.QueryOrchestrator}
   * Either this or #unstructuredQueryEngineConfigName should be specified for the project
   */
  queryOrchestratorConfigName: string

  /**
   * Additional filters to apply on the documents in the #retriever when submitting queries to the project using #query
   * or #chatQuery. These filters are "AND'ed" with any existing filters on the {@link Genai.Query.Result} passed to the
   * querying functions.
   *
   * See Genai.Query#filters
   */
  sourceFilters: map<string, [Genai.Query.SourceFilter]>

  /**
   * Returns the handler that should be used for a query about this project
   */
  handler: member function(): !Genai.Query.Handler js-rhino

  /**
   * The name of the {@link Genai.Query.Handler} type to which this project's queries will be routed.
   *
   * Genai.Tutorial.REAEngine is deprecated and should not be used. Projects using Genai.Tutorial.REAEngine will
   * be migrated to use Genai.UnstructuredQuery.Engine instead.
   */
  // This should be required, but introducing it as required causes PG/SQL errors with existing entries...
  handlerTypeName: string enum ('Genai.UnstructuredQuery.Engine', 'Genai.UnstructuredQuery.Engine.REA.AnalysisEngine', 'Genai.Agent.QueryOrchestrator', 'Genai.Agent.QueryOrchestrator.AnalysisEngine', 'Genai.Tutorial.REAEngine')

  /**
   * Returns the active project for the specified user by looking at the corresponding {@link Genai.App.UserSettings#activeProject}
   */
  forUser: function(user: !User): !Genai.Project js-rhino

  /**
   * Internal function to add the project's #sourceFilters to `result`.
   */
  addProjectFilter: private member function(result: !Genai.Query.Result): !Genai.Query.Result js-rhino

  /**
   * This will add the project's #sourceFilters to the query result and if #handlerTypeName corresponds to a
   * {@link Genai.UnstructuredQuery.Engine}, ensure that it is initialized to #unstructuredQueryEngineConfigName before querying.
   *
   * See Genai.Query.Handler#chatQuery
   */
  //TODO: GEN-5537 figure out how to propagate the config through a QueryOrchestrator to the REA engine if the handler is a QO
  query: ~ js-rhino

  /**
   * This will add the project's #sourceFilters to the query result and if #handlerTypeName corresponds to a
   * {@link Genai.UnstructuredQuery.Engine}, ensure that it is initialized to #unstructuredQueryEngineConfigName before querying.
   *
   * See Genai.Query.Handler#chatQuery
   */
   //TODO: GEN-5537 figure out how to propagate the config through a QueryOrchestrator to the REA engine if the handler is a QO
  chatQuery: ~ js-rhino

  /**
   * Checks if the current user's project has #handlerTypeName set to Genai.Agent.QueryOrchestrator
   */
  isUsingQueryOrchestrator: inline private function(): boolean js-rhino

  beforeUpdate: ~ js-rhino
}
