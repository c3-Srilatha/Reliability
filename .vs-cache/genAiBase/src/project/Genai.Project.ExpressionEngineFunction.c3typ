/**
 * Custom {@link ExpressionEngineFunction}s used to calculate calc fields for {@link Genai.Project}
 */
type Genai.Project.ExpressionEngineFunction mixes ExpressionEngineFunction {
  /**
   * Function to obtain the {@link Genai.SourceCollection}s for the {@link Genai.Project}
   * @param id
   *        The ID of the {@link Genai.Project}.
   * @return The {@link Genai.SourceCollection}s
   */
  getCollections: function(id: !string): [Genai.SourceCollection] js-rhino
}
