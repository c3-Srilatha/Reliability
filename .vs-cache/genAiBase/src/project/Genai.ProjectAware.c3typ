/**
 * Simple type to mixin for all types/entities that can be linked to a {@link Genai.Project}.
 */
private abstract type Genai.ProjectAware {
  /**
   * The {@link Genai.Project} this instance is linked to.
   */
  projects: [Genai.Project]

  /**
    * Fetches the items mixing {@link Genai.ProjectAware}s for the active project of a given {@link User}
    * If the user has no active project, all items mixing {@link Genai.ProjectAware}s are returned. If no
    * user is provided, the user will default to the user performing the action.
    * @param spec
    *         {@link FetchSpec} for fetching the source files.
    * @param user
    *         {@link User}s for whom to fetch the source files.
    * @return filtered out items mixing {@link Genai.ProjectAware}s.
    */
  fetchForUser: function(spec: FetchSpec, user: User): !FetchResult js-rhino

  /**
    * Fetches the count of items mixing {@link Genai.ProjectAware}s for the active project of a given {@link User}
    * If the user has no active project, all items mixing {@link Genai.ProjectAware}s are counted.
    * @param spec
    *         {@link FetchSpec} for fetching the source files.
    * @param user
    *         {@link User}s for whom to fetch the source files.
    * @return count of items mixing {@link Genai.ProjectAware}s.
    */
  fetchCountForUser: function(spec: FetchSpec, user: User): !int js-rhino
}
