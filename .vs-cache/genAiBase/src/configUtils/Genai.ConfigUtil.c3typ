/**
 * Util to generate hashed keys based on the configs.
 * The key is used to set in {@link Genai.Query.Result#configKey}.
 */
type Genai.ConfigUtil {
  /**
   * Loads the following configs and returns a map of config name to config:
   *
   * {
   *     'chatBotConfig': {@link Genai.ChatBot.Config},
   *     'dynamicAgentTestConfig': {@link Genai.Agent.Dynamic.Config},
   *     'queryEngineConfigs': {@link Genai.UnstructuredQuery.Engine.Config},
   *     'reaConfigs': {@link Genai.UnstructuredQuery.Engine.REA.PipelineConfig},
   *     'structuredDataConfigs': {
   *         'stucturedDataConfig': {@link Genai.StructuredData.Config},
   *         'queryOrchestratorConfig': {@link Genai.Agent.Config},
   *         'plannerConfigs': [{@link Genai.Agent.Dynamic.Config}],
   *         'guidanceConfig': {@link Genai.Llm.Guide.Config}
   *     },
   *     'translatorConfig': {@link Genai.Translator.Config}
   * }
   *
   * If {@link Genai.ChatBot.Config#isUsingProjects} is true, the configs from a project will be loaded.
   * @param project
   *           (In project mode only) The {@link Genai.Project} to load the configs for. If not provided,
   *                  the user's active project will be used.
   */
  loadCommonConfigs: function(project: Genai.Project): !json js-rhino

  /**
   * Returns the default unstructured query engine pipeline config.
   * If {@link Genai.ChatBot.Config#isUsingProjects} is true, the configs from a project will be loaded.
   * @param project
   *           (In project mode only) The {@link Genai.Project} to load the configs for. If not provided,
   *                  the user's active project will be used.
   */
  reaConfigs: private function(project: Genai.Project): Genai.UnstructuredQuery.Engine.REA.PipelineConfig js-rhino

  /**
   * Returns the default query orchestrator config.
   * If {@link Genai.ChatBot.Config#isUsingProjects} is true, the configs from a project will be loaded.
   * @param project
   *           (In project mode only) The {@link Genai.Project} to load the configs for. If not provided,
   *                  the user's active project will be used.
   */
  queryOrchestratorConfig: private function(project: Genai.Project): Genai.Agent.Config js-rhino

  /**
   * Generate a hashed cache key for the given configs. If `configMap` is not supplied, then `loadCommonConfigs()` will
   * be called to generate the configs.
   *
   * @param project
   *           The {@link Genai.Project} to load the configs for.
   *
   * @return a hash of the configs
   */
  generateConfigKey: private function(configMap: json, project: Genai.Project): !string js-rhino

  /**
   * Returns the prompt config for the named {@link Genai.Agent.QueryOrchestrator}.
   *
   * @param configName
   *           Name of {@link Genai.Agent.QueryOrchestrator.Prompt.Config}
   *
   * @return for the given name
   */
  queryOrchestratorPromptConfig: private function(configName: !string): !Genai.Agent.QueryOrchestrator.Prompt.Config js-rhino

  /**
   * Returns the model config for the {@link Genai.UnstructuredQuery.Engine.ModelConfig}.
   *
   * @param modelConfigName
   *           Name of {@link Genai.UnstructuredQuery.Engine.ModelConfig}
   *
   * @return for the given name
   */
  queryEngineModelConfig: private function(modelConfigName: !string): !Genai.UnstructuredQuery.Engine.ModelConfig js-rhino

  /**
   * Returns the retriever config for the {@link Genai.UnstructuredQuery.Engine.REA.RetrieverConfig}.
   *
   * @param retrieverConfigName
   *           Name of {@link Genai.UnstructuredQuery.Engine.REA.RetrieverConfig}
   *
   * @return for the given name
   */
  retrieverConfig: private function(retrieverConfigName: !string): !Genai.UnstructuredQuery.Engine.REA.RetrieverConfig js-rhino

  /**
   * Returns the model inference config for the {@link Genai.UnstructuredQuery.Engine.REA.ModelInferenceConfig}.
   *
   * @param configName
   *           Name of {@link Genai.UnstructuredQuery.Engine.REA.ModelInferenceConfig}
   *
   * @return for the given name
   */
  modelInferenceConfig: private function(configName: !string): !Genai.UnstructuredQuery.Engine.REA.ModelInferenceConfig js-rhino

  /**
   * Returns the available query tool options for the current query orchestrator. This is used by the UI to provide
   * query tool options to the user.
   */
  uiQueryToolOptions: function(): [Genai.Agent.Tool.Config.UiOptions] js-rhino

  /**
   * Returns the available planner options for the current query orchestrator. This is used by the UI to provide
   * planner options to the user.
   */
  uiPlannerSelectionOptions: function(): [Genai.Agent.Persistable] js-rhino

  /**
   * Returns the whitelisted data model json for the current structured data query tools.
   */
  structuredDataWhitelistedTypes: function(): [json] js-rhino

  /**
   * Diffs the output of two calls to #loadCommonConfigs and returns an object with the keys/values for which they differ, if any.
   */
  diffCommonConfigs: function(config1: !json, config2: !json): json js-rhino

  /**
   * Diffs the provided config against the current config (as returned by #loadCommonConfigs}
   */
  diffCurrentConfig: function(config: !json, project: Genai.Project): json js-rhino

  /**
   * Returns the default config for the given type.
   */
  getDefaultConfig: function(defaultConfigType: !Type, configKeyFieldName: !string, configType: !Type): !Config js

  /**
   * Diffs two configs and returns an object with the keys/values for which they differ, if any.
   */
  diffConfigs: private inline function(configA: json, configB: json): json js-rhino

  /**
   * Returns the list of planners for the orchestrator, based on the active {@link Genai.Agent.Dynamic.Persistable}
   * belonging to that project.
   * @param filter Additional filter to apply to the list of active planners.
   *
   * @return The list of planners associated with this orchestrator's project.
   */
  activeAgents: private function(configName: !string, filter: Filter): [Genai.Agent.Persistable] js-rhino
}
