/**
 * A record of the config values corresponding to a given hash set in {@link Genai.Query.Result#configKey}.
 * Hashes and configMap are generated by {@link Genai.ConfigUtil#loadCommonConfigs}.
 */

@db(index='configKey')
entity type Genai.ConfigHistory {

  /**
   * The key for the configuration generated for {@link Genai.ConfigUtil#generateConfigKey}
   */
  configKey: !string

  /**
   * The configuration map for the given configKey in form of a string.
   */
  configMapString: !string

  /**
   * The configuration map for the given configKey.
   */
  configMap: property(): !json js

  /**
   * Add a {@link Genai.ConfigHistory} record for the given configKey and configMap
   * only if a record with the same key does not exist.
   *
   * @param configKey
   *           key of the configuration for the
   * @param configMapString
   *           Configuration map for the given configKey
   */
  addConfigHistory: function(configKey: string, configMapString: string) js-rhino
}
