/**
* Interface for the Azure language detection and translation apis.
*/

type Genai.Translator.Azure mixes Genai.Translator {

  detectLanguage: ~ py-translator
  translate: ~ py-translator
  translateBatch: ~ py-translator

  /**
   * Translate the content of the file to the target language.
   * 
   * @param filePath
   *            the path of the file to translate
   * @param targetLanguage
   *            the ISO-639 language code to translate the content to
   */
  // TODO: GEN-8636 (As all files are in English, this method returns the same file path)
  translateFile: function(filePath: !string, targetLanguage: !Genai.Translator.Language): !string py
}
