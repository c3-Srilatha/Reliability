/**
 * Base type for Genai supported translation models.
 */
type Genai.Translator {
  /**
   * Based on the {@link Genai.Translator.Config#translatorTypeName} it will switch to appropriate translator type.
   * e.g. if the {@link Genai.Translator.Config#translatorTypeName} is set to 'Genai.Translator.Google', then it would return {@link Genai.Translator.Google}
   * @param translatorType
   *            Returns the translator configured for query translation, document translation, or language detection on {@link Genai.Translator.Config}.
   *            If no translatorType specified, returns translator configured on {@link Genai.Translator.Config#translatorTypeName}
   */
  translator: function(translatorType: string enum('query', 'document', 'language-detection')): Type py

  /**
   * Identify the ISO-639 language code of the provided string and the confidence of that detection.
   * @param content
   *            identify the language code of the provided content string.
   */
  detectLanguage: abstract function(content: !string): !Genai.Translator.DetectedResponse py-translator

  /**
   * Translate content to other language based on the targetLanguage ISO-639 code.
   * @param content
   *            translate the content to the given targetLanguage code
   * @param targetLanguage
   *            the ISO-639 language code to translate the content to
   */
  translate: abstract function(content: !string, targetLanguage: !string): !string py-translator

  /**
   * Batch translate content to other language based on the targetLanguage ISO-639 code.
   * @param contents
   *            translate the contents to the given targetLanguage code
   * @param targetLanguage
   *            the ISO-639 language code to translate the content to
   */
  translateBatch: abstract function(contents: ![!string], targetLanguage: !string): ![string] py-translator

  /**
   * Get the list of unwanted strings added during translation by the translator.
   * E.g. Google Translator adds 'Machine Translated by Google' which should be removed from the {@link Genai.SourcePassage}s.
   */
  getUnwantedKeywords: cached function(): ![string] py
}
