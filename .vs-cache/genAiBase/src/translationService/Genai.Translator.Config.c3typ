/**
 * Config for the translation service.
 */
type Genai.Translator.Config mixes Singleton, Config {
  /**
   * Whether translation for multi-lingual support is enabled for the app.
   */
  enabled: boolean

  /**
   * The language translation type name to route the requests to.
   */
  translatorTypeName: string enum ('Genai.Translator.Google', 'Genai.Translator.Azure', 'Genai.Translator.Llm') = 'Genai.Translator.Llm'

  /**
   * The name of the Llm config to use for translation.
   * This will be used only when translatorTypeName is 'Genai.Translator.Llm'.
   */
  llmConfigName: string = 'azureGpt4o'

  /**
    * Specifies the translator type name used for routing document translation requests.
    *
    * - **File-level translation**: Translates entire documents before chunking.
    * - **Passage-level translation**: Translates passages after chunking.
    * - If no `documentTranslatorTypeName` is specified, it defaults to `{#translatorTypeName}`:
    *   - Uses passage-level translation for LLM-based services.
    *   - Uses file-level translation for other translation services.
    */
  documentTranslatorTypeName: string enum ('Genai.Translator.Google_file', 'Genai.Translator.Google_passage',  'Genai.Translator.Llm_passage', 'Genai.Translator.Azure_passage')

  /**
   * Translator Type name to route language detection requests to. If no name is specified, falls back to #translatorTypeName.
   */
  languageDetectionHandlerTypeName: string

  /**
   * Translator Type name to route query translation requests to. If no name is specified, falls back to #translatorTypeName.
   */
  queryTranslatorTypeName: string

  /**
   * List of supported file types for translation during the chunking process.
   */
  supportedFileTypes: [string] = ['pdf', 'doc', 'docx', 'ppt', 'pptx', 'html', 'txt', 'md', 'c3doc', 'rtf']

  /**
   * All unsupported ISO-639 language codes for the translation services, e.g. `gu` for Gujarati.
   */
  unsupportedLanguageCodes: [string]

  /**
   * The language confidence threshold for the translation service.
   * If the confidence of the detected language is below this threshold, the translation service will not translate the text.
   */
  languageConfidenceThreshold: !double = 0.6
}
