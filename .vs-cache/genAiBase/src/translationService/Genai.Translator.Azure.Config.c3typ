/**
* Configuration for the Azure Translator.
*/
type Genai.Translator.Azure.Config mixes Genai.Translator.Config {

  /**
   * The language translation type name to route the requests to.
   */
  translatorTypeName: !string = 'Genai.Translator.Azure'

  /**
   * The authentication key for the Azure API.
   */
  @config(secret=true)
  apiKey: !string

  /**
   * The Azure API endpoint.
   */
  endPoint: !string

  /**
   * The Azure API region.
   */
  region: !string

}
