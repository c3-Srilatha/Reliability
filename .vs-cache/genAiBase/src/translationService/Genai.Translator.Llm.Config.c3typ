/**
* Enter the Type purposes and use cases with code examples.
*/

type Genai.Translator.Llm.Config mixes Named, Config {

  /**
  * The name of the Llm config to use for translation.
  */
  llmModelName: !string

  /**
  * token limits for Llms
  */
  tokenLimit: int = 128000

  /**
  * Prompt for detecting language
  */
  detectLanguagePrompt: !Genai.Prompt = "default_detect_language_llm_prompt"

  /**
  * Prompt for translating text
  */
  translateTextPrompt: !Genai.Prompt = "default_translate_text_llm_prompt"

}
