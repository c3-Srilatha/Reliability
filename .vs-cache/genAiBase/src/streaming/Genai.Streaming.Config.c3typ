/**
 * Configuration type for the text streaming feature.
 */
type Genai.Streaming.Config mixes Config {
  /**
   * Whether text streaming to the UI should be enabled or disabled.
   */
  @deprecated(finalVersion='6.0', details='Use Genai.Streaming.Config#strategy instead')
  enabled: boolean

  /**
   * The frequency in milliseconds at which the UI should check for new stream chunks.
   */
  streamingFrequencyMs: int = 750

  /**
   * The interval in seconds between writes of the streaming data to the database
   */
  dbStreamingIntervalSeconds: double = 1

  /**
   * The amount of delay in milliseconds between each render when chunks are still being received.
   * A lower delay means there is less time between each render, but could lead to pauses in the stream,
   * since the the UI would spend more time waiting on the next stream chunk to be returned.
   */
  typewriterKeyDelayInProgress: int = 10

  /**
   * The amount of delay in milliseconds between each render when all chunks have been received.
   */
  typewriterKeyDelayFinished: int = 5

  /**
   * The number of characters used to establish context for sentence boundary detection while stream chunking.
   * Larger context improves sentence detection accuracy.
   */
  contextSize: int = 12

  /**
   * The minimum number of characters a returned sentence chunk must have.
   * Shorter sentences are concatenated with the following sentence.
   */
  minimumSentenceLength: int = 10

  /**
   * The strategy for streaming text to the UI.
   */
  strategy: string enum Genai.Streaming.Strategy = NATIVE
}
