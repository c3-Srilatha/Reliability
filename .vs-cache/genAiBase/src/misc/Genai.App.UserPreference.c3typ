/**
 * Specifies user preferences for the Genai app.
 */
@config(minOverride=USER, maxOverride=USER)
type Genai.App.UserPreference mixes Config, UserSingleton {
  /**
   * Set the value of a user preference.
   *
   * @param preferenceKey
   *           The user preference to update.
   *
   * @param preferenceValue
   *           The new value of the user preference.
   */
  setPreference: function(preferenceKey: !string, preferenceValue: !any): !Genai.App.UserPreference js-rhino
}
