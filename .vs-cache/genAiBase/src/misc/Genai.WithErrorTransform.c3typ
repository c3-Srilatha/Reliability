/**
 * Base type for Types that needed to transform error messages
 */
type Genai.WithErrorTransform {

    /**
     * Get the error translations for this error type
     * @return The error objects associated with this type
     */
    getErrors: member function(): [Genai.Error] py

    /**
     * Given the raw error string, parse it and return the transformed error string.
     *
     * @param errorMsg
     *         The raw error string to parse.
    * @param fallbackResponse
     *         The string to fallback to if no matches are found.
     *
     * @return The transformed error string or None if no matches and no fallback
     */
    transformErrorString: member function(errorMsg: !string, fallbackResponse: !string): string py

    /**
     * Text for transformed error, likely generated by the #transformErrorString method
     */
    transformedError: string
}
