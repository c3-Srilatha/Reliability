/**
 * Base utility to interact with tools in this config
 */
abstract type Genai.WithAllTools {
  /**
   * Abstract function for returning all the tools associated with this config
   */
  allTools: abstract member function(): ![Genai.Agent.Tool | Genai.Agent.Tool.FunctionCalling]
}
