/**
 * Mixin type for types mixing {@link Engine} to provide utility functions
 */
type Genai.WithEngine {
  /**
   * Returns all handlers that can be used for requests
   */
  @deprecated(finalVersion='7.0', details='Use `list` instead')
  allHandlers: function(): [mixing Genai.WithEngine] js-rhino

  /**
   * Stops all running handlers
   */
  stopAllHandlers: function(): [mixing Genai.WithEngine] js-rhino
}
