/**
 * Enum type for the possible values of a field from the application state. These fields typically need
 * synchronization between the app configuration and the python engines in charge of search.
 */
enum type Genai.App.State.FieldStatus {
  /**
   * The Gen AI data model is in sync with the Data Sources ({@link External} types) added to the app.
   */
  SYNCED = 'SYNCED',

  /**
   * The Gen AI data model is out of sync with the Data Sources added to the app.
   * To update, use {@link Genai.App#syncDataModel}.
   */
  STALE = 'STALE',

  /**
   * The Gen AI data model is being synced with the Data Sources added to the app.
   * This happens while {@link Genai.App#syncDataModel} is being executed.
   */
  SYNCING = 'SYNCING',
}
