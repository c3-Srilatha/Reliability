/**
* Server-side application state for the Gen AI app.
*/

entity type Genai.App.State mixes DefaultInstance {

  /**
   * Current state of the Gen AI Data Model
   */
  dataModelState: string enum Genai.App.State.FieldStatus = SYNCED

  /**
   * Current state of the Gen AI configs.
   * - SYNCED: The configs are in sync with all the python processes.
   * - STALE: The configs have been updated in the file system, but the python processes might have not been restarted to capture the new values.
   */
  configsState: string enum Genai.App.State.FieldStatus = SYNCED

  /**
   * Current state of the Gen AI agents.
   * - SYNCED: The agents are in sync with all the python processes.
   * - STALE: The agents have been updated, but the python processes might have not been restarted to capture the new values.
   */
  agentsState: string enum Genai.App.State.FieldStatus = SYNCED

  /**
   * Sets the current state of the Gen AI Data Model, protecting the update from version conflicts.
   * @param dataModelState
   *           The new state of the data model
   * @return The updated state of the Gen AI app
   */
  setDataModelState: function(dataModelState: !Genai.App.State.FieldStatus): !Genai.App.State js-rhino

  /**
   * Sets the current state of the Gen AI configs, protecting the update from version conflicts.
   * @param stateField
   *           The field to update
   * @param stateValue
   *           The new value of the field
   * @return The updated state of the Gen AI app
   */
  setState: function(stateField: !string, stateValue: !string): !Genai.App.State js-rhino

  inst: ~ js-rhino
}
