/**
 * Mixin type for Types that needed to be marked as removed without being deleted
 */
type Genai.WithSoftRemove {
  /**
    * Whether or not object has been marked removed. Note that using "removed" as the attribute instead will cause a
    * C3 package error, as it will override an existing method
    */
  softRemoved: boolean

  /**
    * Mark the object as removed
    * @return The object with the removed flag set to true
    */
  removeItem: member function(): mixing Genai.WithSoftRemove js-rhino
}
