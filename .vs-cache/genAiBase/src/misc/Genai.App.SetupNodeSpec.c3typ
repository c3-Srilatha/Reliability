/**
 * Spec that defines what {@link Genai.App#setupThisNode} should do.
 */
type Genai.App.SetupNodeSpec mixes Spec {
  /**
   * Validates this spec, throwing an error if it is invalid.
   */
  validate: member function() js

  /**
   * All runtimes in this list will be installed on the node if they are not already installed
   */
  runtimesToInstall: [string serialized Py.Runtime]

  /**
   * All {@link GenaiCore.Embedder.Hf} models in this list will be installed on the node if they are not already installed
   */
  embedderModelsToInstall: [string]

  /**
   * The `name` of the {@link Genai.Retriever} of type #retrieverTypeName to initialize.
   * Note that if #initializeDefaultProjectSettings is true, then the retrievers for
   * both projects will be initialized without needing to specify them here.
   */
  retrieverToInitialize: string

  /**
   * The name of the type of retriever to use.
   */
  retrieverTypeName: string = 'Genai.Retriever.PgVector'

  /**
   * If set true, then `initializeProjects` will be called on the default
   * {@link Genai.Project} for the app.
   */
  initializeDefaultProjectSettings: boolean

  /**
   * Compute a hash of the fields on an instance of the spec. Used to determine if a node has already been set up with
   * the same spec.
   */
  hash: property(): string js

  /**
   * Additional lambdas that should be executed. These should be idempotent.
   */
  setupLambdas: [Lambda]
}
