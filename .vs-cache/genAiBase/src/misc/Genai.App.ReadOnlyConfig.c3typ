/**
 * Feature configs for C3 Generative AI deployments.
 * These can be set up by the cluster administrator and will be read-only from the app
 */
type Genai.App.ReadOnlyConfig mixes Config, Singleton {

  /**
   * Whether the app should allow to copy credentials from an existing source system when creating a new one
   */
  isCopyCredentialsAllowed: boolean

  /**
   * Whether the app should allow users to manage external source directory operations.
   */
  disableSourceDirectoryControl: boolean

  /**
   * All streaming related configurations
   */
  streamConfig: Genai.Streaming.Config

  /**
   * The number of {@link Genai.SourceFile} to include in a batch for actions like
   * {@link Genai.SourceFile#beforeCreate}, {@link Genai.SourceFile#beforeUpdate}, and
   * {@link Genai.SourceFile#transitionFilesToStatus}.
   */
  sourceFileBatchSize: int = 500

  /**
   * Convenience function to access the values of the {@link Genai.App.ReadOnlyConfig}
   */
  getReadOnlyConfig: function(): !Genai.App.ReadOnlyConfig js-rhino
}
