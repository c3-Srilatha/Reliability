/**
 * A mixin type for types that use a pandas DataFrame that needs to be persisted for later use
 * or display in the UI. See the native remix type for Python usage.
 */
type Genai.WithDataPersisted {
  /**
   * The persisted data for this object.
   */
  persistedData: private Data.Persisted

  /**
   * Removes this instance's #persistedData files from the file system.
   */
  removePersistedData: member function() js-server

  /**
   * Removes all #persistedData files from the file system. Should be called by {@link Persistable#beforeRemove} in
   * all types that mix `Genai.WithDataPersisted`.
   */
  removePersistedDataBatch: private function(objs: ![Genai.WithDataPersisted]) js-server

  /**
   * Returns the {@link GenAiVisualizationDataFrameProps} for the data needed to render the visualization. This
   * function is called by {@link GenAiVisualizationBase#getVisualizationDataFromSpec} when the source is a
   * {@link Genai.Query.Result.Source.StructuredData.PythonAgent}.
   * @return A {@link GenAiVisualizationDataFrameProps} for the visualization data
   */
  getVisualizationDataFromDataFrame: member function(): !GenAiVisualizationDataFrameProps py-query_orchestrator
}
