/**
 * A mixin native remix type that allows for the use of a pandas DataFrame that needs to be persisted for later use.
 */
native py remix type Genai.WithDataPersisted mixes PyReprProtocol {
  /**
   * Sets the #persistedData field with a Data.Persisted instance created from the provided pandas DataFrame
   */
  with_df: member function (df: !native): !mixing Genai.WithDataPersisted py

  /**
   * Returns the native pandas DataFrame for this instance, using the in-memory `df` if set, and falling back to
   * #persistedData if not.
   */
  get_df: inline member function(): native py
}
