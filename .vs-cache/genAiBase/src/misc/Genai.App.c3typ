/**
 * Responsible for handling app-wide configuration and functions.
 */
type Genai.App {
  /**
   * Setup all specified nodePools according to the provided spec. Calls #setupThisNode on each running node in the
   * specified nodePools.
   */
  setupNodes: function(nodePools: ![string], spec: !Genai.App.SetupNodeSpec) js-rhino

  /**
   * Performs setup steps on a single node according to the spec parameters. If the node has already performed setup,
   * (i.e. #thisNodeHasBeenSetup returns true), this method does nothing.
   */
  setupThisNode: function(spec: !Genai.App.SetupNodeSpec) js-rhino

  /**
   * Returns whether the node on which this is called has already performed #setupThisNode with the provided spec.
   */
  thisNodeHasBeenSetup: private function(spec: !Genai.App.SetupNodeSpec): boolean js-rhino

  /**
   * Return all 'RUNNING' nodes in any of the specified nodePools.
   */
  runningNodesForPools: private function(nodePools: ![string]): [Server] js-rhino

  /**
   * Callback function for handling package updates, used by the #startPkgListener function.
   * It sets {@link Genai.App.State#dataModelState} to `STALE` when external types are added, updated, or removed.
   */
  handlePkgUpdate: private function(pkgEvent: !Pkg.Event) js-rhino

  /**
   * Starts a listener to package changes. Used for setting {@link Genai.App.State#dataModelState}
   * to `STALE` when changes have been made in external types of the root package.
   */
  startPkgListener: function() js-rhino

  /**
   * Performs all the operations needed to sync the Gen AI data model with the current data model
   * of the C3 root package. This includes:
   * - Generating whitelisted model with the data sources added to the app.
   * - Updating the data model graph of {@link Genai.Agent.Tool}s
   */
  syncDataModel: function() js-rhino


  /**
   * Tries to access the {@link TypeMeta} of a type and add its fields to the whiteListedDataModel. If the type cannot be accessed
   * it returns the whiteListedDataModel as is; otherwise, it adds the fields of the type to the whiteListedDataModel.
   * Only the fields explicitly declared in the type are added to the model, those inherited from the mixin types are not.
   */
  addWhiteListedDataModelEntry: private function(whiteListedDataModel: Map<string, json>, someType: Type): Map<string, json> js-rhino

  /**
   * Generates a whitelisted data model with the data sources added to the app. The output format is a JSON with
   * the following structure:
   * {
   *   EXTERNAL_TYPE_NAME_1: { fields: [FIELD NAMES]},
   *   EXTERNAL_TYPE_NAME_2: { fields: [FIELD NAMES]},
   *  ...
   *
   */
  generateWhiteListedDataModel: private function(): json js-rhino
}
