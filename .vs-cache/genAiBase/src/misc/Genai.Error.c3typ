/**
 * Base type for error field
 */
entity type Genai.Error {

    /**
     * The error code associated with this error
     */
    errorCode: int

    /**
     * The type that this error belongs to
    */
    typeName: string

    /**
     * The target string to search for in the larger error message
     */
    search: string

    /**
     * True if the search string is a regex otherwise false
     */
    isRegex: boolean

    /**
     * The UI-friendly interpretation of the error message
     */
    translation: string
}
