/**
 * Helper type to retrieve instances by name for types that enforce unique names.
 */
type Genai.ForNameHelperImpl {
  /**
   * Return an instance of this type.
   *
   * @param name
   *        The name of the instance.
   * @param failIfMissing
   *        If the instance does not exist, fail when this is true.
   */
  forName: function(name: !string, failIfMissing: boolean): any py
}
