/**
 * Utility type to assist with the migration to new tools, retrievers, and agents.
 */
type Genai.MigrationHelper {
  /**
   * Migrates eval query tools to the new structured DB agent tool in
   * - Query orchestrator toolkit
   * - MSS toolkits in query orchestor toolkit (one nested level)
   * - UI-selectable tools
   *
   * Copies the data model graph, fuzzy matcher spec, and UI options from the eval query config to a structured DB agent config.
   *
   * Returns mapping from old eval query tool IDs to new structured DB agent tool IDs. If more than 5 eval query tools, any new {@link Genai.Agent.Tool.StructuredDataQueryPy}s with toolNum greater than 5 will need to be added to application metadata in code.
   *
   * @param llmConfigName
   *           (optional)
   *        Specifies the {@link Genai.UnstructuredQuery.Engine.ModelConfig} name to use as the LLM for the structured DB agent.
   *        - Recommended values: "azureGpt4o" (default) or Claude Sonnet 3.5.
   *
   * @param qoName
   *           (optional)
   *        The Query Orchestrator {@link Genai.Agent.QueryOrchestrator} name for which eval query tools will be
   *        to structured DB agent tools. Defaults to 'QueryOrchestrator_default'.
   *
   * @return {json}
   *          A JSON mapping old eval query tool IDs to new structured DB agent tool IDs.
   */
  migrateEvalQueryToStructuredDbAgent: function(llmConfigName: string = 'azureGpt4o', qoName: string = 'QueryOrchestrator_default'): json js-server
}
