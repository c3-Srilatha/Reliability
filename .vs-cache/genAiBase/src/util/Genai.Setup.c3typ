/**
 * Util Type for simplified configuration of GenAi apps
 */
type Genai.Setup {
    /**
     * Sets unstructured configs and prompts to use specified model.
     *
     * @param modelConfigName
     *         Name of {@link Genai.UnstructuredQuery.Engine.ModelConfig} to use for all unstructured REA query configs
     */
    setUnstructuredConfig: function(modelConfigName: !string) js-rhino

    /**
     * It enables the `genai-test-indexing` {@link CronJob} to active state. Additionally it enables the alerts to be
     * emailed to the users when the indexing takes too long or fails, via the {@link Genai.Alert#alertLongRunningIndexAction}
     * and {@link Genai.Alert#alertFailedIndexAction}
     *
     * @param emailRecipients
     *        Array of email addresses that will recieve the alerts when indexing fails
     */
    enableAlerting: function(emailRecipients: [string]) js-rhino

    /**
     * Disables the `genai-test-indexing` {@link CronJob}. Additionally it disables the email alerts when the indexing takes too long or fails, via the {@link Genai.Alert#alertLongRunningIndexAction}
     * and {@link Genai.Alert#alertFailedIndexAction}
     */
    disableAlerting: function() js-rhino

    /**
     * Clears all Configs starting with `Genai.` at the specified override level
     *
     * @param override
     *           The override level to clear configs.
     * @param includeLlmConfigs
     *           If this is set to true, then all Genai.Llm types will be cleared as well.
     *           By default, unless running in Jarvis, we do not clear values and secrets on Genai.Llm types,
     *           since those Configs contain secrets that are needed for accessing LLMs,
     *           and clearing them would make re-running tests on development environments frustrating.
     *
     * @return the Config types that were cleared.
     */
    clearGenaiConfigs: function(
        override: ConfigOverride = ConfigOverride.APP,
        includeLlmConfigs: boolean
    ): [Type] js-rhino
}
