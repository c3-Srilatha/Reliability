/**
 * Schema Upgrade utils for types.
 */
type Genai.SchemaUpgradeUtil mixes SchemaUpgrade {
  /**
   * Migrate old Genai.ModelConfiguration.Template.UnstructuredQuery values to use type Genai.Translation.Values,
   * due to the v3.3 to v4 schema change.
   * Only migrate templates with old schema string values.
   * This batch migration function is meant to be ran right after v4 code deployment,
   * so that all customers template experience and LLM flows won't be broken.
   *
   * @param includeString
   *        what extra fields to include in returned migrated templates.
   *
   * @return migrated Genai.ModelConfiguration.Template.UnstructuredQuerys.
   */
  upgradeMultiLingualTemplates_1: function(includeString: string): [any] js-rhino

  /**
   * Migrate types with Genai.ProjectAware mixin to have a list of {@link Genai.Project}s and indicate the active project in {@link Genai.App.UserSettings} using `activeProject` field.
   * @param typesToUpdate
   *        A list of type names that you want to update the project reference for. This list will be concatenated with other types which mixin {@link Genai.ProjectAware}
   *        This param is added for testing purposes only
   */
  upgradeProjects_2: function(typesToUpdate: [string]) js-rhino

  /**
   * Migrate old {@link Genai.Project}s that have isTutorial field.
   * This migration will set the projectType field to 'tutorial' if isTutorial is true, and 'production' otherwise.
   * This batch migration function is meant to be run right after v4 code deployment,
   * so that all customers project experience won't be broken.
   * @param includeString
   *        what extra fields to include in returned migrated projects.
   *
   * @return migrated {@link Genai.Project}s.
   */
  upgradeProjectsIsTutorial_3: function(includeString: string): [Genai.Project] js-rhino

  /**
   * Migrates the old Genai.UnstructuredQuery.ModelConfiguration.Template type to the new
   * Genai.ModelConfiguration.Template.UnstructuredQuery type including its renamed nested types. This is meant
   * to be run when migrating from v4.2 to v5.0.
   */
  upgradeModelConfigurationTemplates_4: function() js-rhino

  /**
   * Migrates the old {@link Genai.UnstructuredQuery.Engine.REA.ModelInferenceConfig} to
   * {@link Genai.UnstructuredQuery.Engine.ModelConfig} type including
   * {@link Genai.UnstructuredQuery.Engine.REA.ModelInference.Prompt.Config} to {@link Genai.Prompt}.
   */
  upgradeModelInferenceConfigs_5: function(): json py-query_orchestrator

  /**
   * Migrates the fields from Genai.UnstructuredQuery.Engine.REA.PipelineConfig type to
   * Genai.UnstructuredQuery.Engine.Config.
   */
  reaPipelineConfigToEngineConfig_6: function() js-rhino

  /**
   * Migrates the Genai.Llm.*.Config credentials on GenaiCore.Llm.*.Auth
   */
  migrateAllCredentialsToGenaiCore_7: function() js-rhino

  /**
   * Migrates all {@link Genai.Retriever.PgVector}s to use the new {@link Genai.Retriever.PgVector#embedderSpec}
   * field.
   */
  retrieverPgVectorEmbedderSpec_8: function() js-rhino

  /**
   * Migrates all {@link Genai.Retriever.Dense}s to use the new {@link Genai.Retriever.Dense#embedderSpec}
   * field.
   */
  retrieverDenseEmbedderSpec_9: function() js-rhino

  /**
   * Migrates the engineThreadPoolSpec for all Genai.*.Engine to use deploySpec
   */
  migrateAllEnginesToUseDeploySpec_10: function() js-rhino

  /**
   * Migrates all {@link Genai.Agent.Dynamic.Tool}s and {@link Genai.Agent.Dynamic.Toolkit}s to
   * extend {@link GenaiCore.Tool}s and {@link GenaiCore.Toolkit}s respectively.
   */
  upgradeDynamicAgentToolsAndToolkits_11: function() js-rhino

  /**
   * Executes `DbAdmin.executeQuery` for a given input query
   */
  executeDbQuery: private function(query: !string, limit: int): DbAdminQueryResult js-rhino

  /**
   * Migrates all {@link Genai.UnstructuredQuery.Engine.ModelConfig}s to
   * {@link GenaiCore.Llm.Completion.Client}.
   */
  migrateAllModelConfigsToGenaiCore_12: private function() js-rhino

  /**
   * Removes ephemeral storage config from volumeSizeMapping in leader and task node pool configs
   */
  migrateNodePoolConfig_13: private function() js-rhino
}
