/**
 * A util type to help with local file methods.
 */
type Genai.LocalFilesUtil {

  /**
   * Zips a local directory to a byte stream.
   *
   * @param directoryPath
   *       The path to the directory to zip.
   */
  zipLocalDirectoryToBytes: function(directoryPath: !string): ByteStream py

  /**
   * Prints a recursive tree view of all files and folders under the given path.
   *
   * Useful for visual debugging and verifying module contents.
   *
   * @param startPath
   *        Root directory to walk; defaults to `localDirPath`.
   * @param indent
   *        Indentation string used for pretty-printing.
   */
  printFileTree: function(startPath: !?string, indent: string) py
}
