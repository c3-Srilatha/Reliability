/**
 * Util Type for prompt.
 */
type Genai.PromptUtil {
  /**
    * Get template input value to fill prompt for LLM.
    * This function is the guard to prevent empty values if template is not translated.
    *
    * @param translationValues
    *        {@link Genai.Translation.Values} from template input.
    *
    * @return if template was translated,
    *         or {@link Genai.Translation.Values#userLanguageValue} if not translated.
    */
  getTemplateValStr: inline function(translationValues: Genai.Translation.Values): string js-rhino
}
