/**
 * Util Type to simplify troubleshooting of GenAi apps
 */
type Genai.TroubleshootUtil {
    /**
     * Dumps and downloads file with environment info, retriever info, structured data configs, query engine configs, REA configs, and project configs in JSON format.
     */
    exportAppState: function(): json js

    /**
     * Dumps app state in JSON format to static console without downloading file.
     */
    dumpAppState: function(): json js-rhino

    /**
     * Returns configs and app state from genAiBase
     */
    baseConfigs: private function(): json js-rhino
}
