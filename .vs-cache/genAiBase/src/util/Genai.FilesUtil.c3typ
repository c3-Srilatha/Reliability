/**
 * A util type to help with {@link File} and {@link FileSystem} operations.
 */
type Genai.FilesUtil {
    /**
     * For large files (>2gb) we need to chunk before uploading. This function will take the file at `srcFilePath`,
     * break it into 1gb chunks, and upload all chunks to `dstFolderPath`.
     */
    chunkAndUploadFile: function(srcFilePath: !string, dstFolderPath: !string) py

    /**
     * For large files (>2gb) we need to chunk before uploading. This function will download the file chunks within
     * `srcFolderPath` and stitch them together into a single file at `dstFilePath`.
     *
     * NOTE: the folder at `srcFolderPath` should have been the `dstFolderPath` previously passed to
     * `chunkAndUploadFile`
     */
    downloadAndStitch: function(srcFolderPath: !string, dstFilePath: !string) py

    /**
     * This function will take the folder at `srcFolderPath`, convert it into a .tar or .tar.gz file (based on the `gzip` flag),
     * break it into 1gb chunks (if needed), and upload all chunks to `dstFolderPath`.
     *
     * NOTE: This method can be used for large folders (>2gb).
     */
    chunkAndUploadFolder: function(srcFolderPath: !string, dstFolderPath: !string, gzip: !boolean) py

    /**
     * This function will download the folder chunks within `srcFolderPath`, stitch them together into a single .tar or .tar.gz file
     * and extract it at `dstFolderPath`. No need to specify a `gzip` flag, it will be inferred automatically.
     *
     * NOTE: the folder at `srcFolderPath` should have been the `dstFolderPath` previously passed to
     * `chunkAndUploadFolder`
     *
     * NOTE: This method can be used for large folders (>2gb).
     */
    downloadAndStitchFolder: function(srcFolderPath: !string, dstFolderPath: !string) py
}
