/**
 * Type containing valid search query operators, used to filter search results.
 * OperatorTypes fields map to a filterable field in {@link Genai.SourceFile.Metadata}.
 *
 * All operator usage follows this format:
 * '{Operator}:{Target}' or '{Operator}:"{Target}"'
 * Double quotes must be used to target values containing spaces.
 *
 * Operator expressions can also be used augment the operator target.
 * Operator expressions can be used in the following format:
 * '{Operator}:{<Operator Expression>(...args)}'
 * More information on supported expressions and how to use them can be found in {@link Genai.Query.Operator.Expressions}.
 *
 * Example query:
 * 'What is an SDL Component? ext:any(pdf,txt) author:"John Smith"'
 * This will filter on files with a `pdf` OR `txt` fileType and an author of `John Smith`.
 *
 * These base fields are available in all apps.
 * Developers can remix this type and {@link Genai.SourceFile.Metadata}
 * to add their own custom operators and filterable fields.
 */

type Genai.Query.Operator.Types {
  /**
   * Filter based on {@link Genai.SourceFile.Metadata#fileName}.
   * Usage: "When did this deal close? file:previous-deals.pdf"
   * This will query only on files with the name previous-deals.pdf.
   *
   * Additionally, users may also use the wildcard character '*' in order to match all characters.
   * Usage: "What is an ML Pipe? file:*notes.doc" will query only on files with names that end with 'notes.doc',
   * i.e. 'release-notes.doc', 'notes.doc', '123notes.doc'
   */
  file: const !string = 'fileName'

  /**
   * Same as #file.
   */
  source: const !string = 'fileName'

  /**
   * Filter based on {@link Genai.SourceFile.Metadata#fileType}.
   * Usage: "What is an SDL Component? filetype:docx" will query only on files of type docx.
   * Period is not required with the extension type.
   */
  filetype: const !string = 'fileType'

  /**
   * Same as #filetype.
   */
  ext: const !string = 'fileType'

  /**
   * Filter based on {@link Genai.SourceFile.Metadata#author}.
   * The author represents the person who wrote the contents of the uploaded file,
   * NOT whoever uploaded the file (although they could be the same).
   * Usage: 'What is digital transformation? author:"Tom Siebel"' will query only on file contents authored by Tom Siebel.
   */
  author: const !string = 'author'

  /**
   * Filter based on if the file contents were created during a specified {@link Genai.SourceFile.Metadata#date}.
   * Can be combined with the use of the before(), after(), or between() {@link Genai.Query.Operator.Expressions} to filter
   * ranges before, after, or within specified dates, inclusive.
   * Date must be in YYYY-MM-DD format.
   * Before usage: "When did this deal close? date:before(2007-12-03)" will query on files created on or before December 3rd, 2007.
   * Single date usage: "When did this deal close? date:2009-11-02" will query on files created on November 2nd, 2009.
   */
  date: const !string = 'date'

  /**
   * Filter based on the {@link Genai.SourceFile.Metadata.Tag} set on a file.
   * Usage: 'What is my energy output this month? tags:"Energy Management"' will query only on files tagged with 'Energy Management'
   */
  tags: const !string = 'tags'
}
