/** Wrapper type defining (as constants) common operator expressions used in queries. */
type Genai.Query.Operator.Expressions {
  /**
   * The all() expression is used to filter on fields that contain all the specified items in the expression.
   * Usage: "Who is the CEO of C3 AI? tags:all("C3 AI","Information","People")"
   * This will query on all files that contain the tags "C3 AI", "Information", and "People"
   */
  all: const string = 'all'

  /**
   * any() is used as an *OR* expression for the provided values.
   * Usage: "Who is the CEO of C3 AI? filetype:any(pdf,txt,docx)"
   * This will query on all files with a filetype of pdf OR txt OR docx.
   */
  any: const string = 'any'

  /**
   * before() is used with the date operator to filter files created before a specified date, inclusive.
   * Usage: "Who is the CEO of C3 AI? date:before(2022-08-01)"
   * This will query on all files with dates on or before August 1st, 2022.
   * See {@link Genai.SourceFile.Metadata#date} for more info on the date field.
   */
  before: const string = 'before'

  /**
   * after() is used with the date operator to filter files created after a specified date, inclusive.
   * Usage: "Who is the CEO of C3 AI? date:after(2022-08-01)"
   * This will query on all files with dates on or after August 1st, 2022.
   * See {@link Genai.SourceFile.Metadata#date} for more info on the date field.
   */
  after: const string = 'after'

  /**
   * between() is used with the date operator to filter on a time range.
   * Usage: "Who is the CEO of C3 AI? date:between(2020-02-01,2022-06-25)"
   * This will query on all files with dates between February 1st, 2020 and June 25, 2022, inclusive.
   * See {@link Genai.SourceFile.Metadata#date} for more info on the date field.
   */
  between: const string = 'between'
}
