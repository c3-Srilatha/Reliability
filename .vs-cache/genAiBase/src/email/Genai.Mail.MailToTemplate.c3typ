/**
 * An email template that can be used to populate a `mailto` link in the UI.
 */
entity type Genai.Mail.MailToTemplate {

  /**
   * Who the email should be sent to
   */
  to: string

  /**
   * The email subject
   */
  subject: string

  /**
   * The email body
   */
  body: string

  /**
   * Generates the "mailto" link for the email
   */
  generateMailToLink: function(mailToTemplate: Genai.Mail.MailToTemplate): string js-rhino
}
