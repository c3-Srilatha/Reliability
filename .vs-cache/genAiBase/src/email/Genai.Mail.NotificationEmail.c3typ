/**
 * Represents an email notification that should be sent on a schedule. This type should be extended and a
 * {@link CronJob} should be configured where the API called by the CronJob fetches from the type. The extending type
 * should provide a way to determine whether to send the email.
 */
abstract extendable entity type Genai.Mail.NotificationEmail {

  /**
   * A description of the email and when/why it is sent.
   */
  description: string

  /**
   * The id of the {@link Genai.Mail.Template} to use for the email.
   */
  emailTemplateId: string

  /**
   * This can be used to filter on emails that have not yet been sent. If an email has been sent, this field will be
   * populated with the time the email was sent.
   */
  lastSent: datetime
}
