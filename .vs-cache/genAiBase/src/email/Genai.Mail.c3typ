/**
 * Email-related methods for Gen AI
 */
entity type Genai.Mail mixes DefaultInstance {

  /**
   * All admin group user emails.
   */
  adminEmails: [string] calc getUserEmailsForRoles(['Genai.AdminUser'])

  inst: ~ js-rhino

  /**
   * Sends an email using the given template to the given email addresses.
   *
   * @param emailTemplate
   *           The email template to send.
   * @param toEmails
   *           The email addresses to send the email to. This is not required if {@link Genai.Mail.Template#dynamicTo}
   *           is defined for the given `emailTemplate`.
   */
  sendEmailFromTemplate: function(emailTemplate: Genai.Mail.Template, toEmails: [string]): Mail js-rhino

  /**
   * Returns the content of the email template, with all tokens replaced.
   */
  getEmailTemplateContent: private function(emailTemplate: Genai.Mail.Template): string js-rhino

  /**
   * Given one of the common replace tokens, returns the value for that token.
   *
   * See Genai.Mail.Template#commonReplaceTokens
   */
  replaceCommonToken: private function(
    token: string enum Genai.Mail.Template.CommonReplaceTokenEnum
  ): string | [string] js-rhino
}
