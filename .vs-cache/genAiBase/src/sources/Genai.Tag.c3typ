/**
 * A Genai.Metadata.Tag is an arbitrary string label that a user can set on any object.
 */
 extendable entity type Genai.Tag schema name "TAG" {

  /**
   * The label that is the body of the Tag.
   */
  label: !string

  /**
   * The category of the Tag.
   */
  category: Genai.Tag.Category

 }
