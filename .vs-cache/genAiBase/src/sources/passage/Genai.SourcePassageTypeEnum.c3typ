/**
 * Enum type for {@link Genai.SourcePassage#sourceType}'s value.
 */
enum type Genai.SourcePassageTypeEnum {

    /** The source passage is a table */
    TABLE = 'table'

    /** The source passage is an image */
    IMAGE = 'image'

    /** The source passage is just text */
    TEXT = 'text'
}
