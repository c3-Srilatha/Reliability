/**
 * A SourcePassage is a passage of text, table, or image from a source file.
 */
type Genai.SourcePassage mixes Genai.SourcePassage.Table, Genai.SourcePassage.Image {
    /**
     * A unique identifier for the SourcePassage.
     */
    passageId: inline property(): string js | py

    /**
     * The source from which this passage came.
     */
    source: !Genai.Source

    /**
     * Bounding box of the SourcePassage
     */
    boundingBox: Genai.SourcePassage.BoundingBox

    /**
     * The id of this passage within its #source.
     */
    intraSourceId: !string

    /**
     * The chunking spec used to produce this passage from its #source.
     */
    chunkingSpec: Genai.SourceFile.Chunker.UniversalChunker.Spec

    /**
     * The content of the passage (the same as the description for vectorstore)
     */
    contentStr: private string

    /**
     * The original content of the passage with the {@link Genai.SourceFile.Metadata}
     * added into it.
     */
    indexedContentStr: private string

    /**
     * The page number the content begins on.
     * Page number is only supported for PDFs currently.
     */
    pageNumber: int

    /**
     * Optional metadata for source passage
     */
    metadata: json

    /**
     * Whether it's a table, image or text source type of {@link Genai.SourcePassageTypeEnum}.
     */
    sourceType: Genai.SourcePassageTypeEnum calc getSourceType(exists(imageFile), exists(dataFrameFile))

    /**
     * A mapping of  of <string id>: <code snippet> for all code snippets contained within the original
     * passage that are extracted before indexing.
     */
    codemap: json

    /**
     * Extra information for the associated text/image/table component,
     * such as bbox coordinates (original and scaled), page height/width, box class, etc.
     * Generated by mew3.
     */
    componentInfo: json

    /**
     * A JSON file in FileSystem storing the source document information,
     * such as file format, dpi, parsing specs, etc.
     * Generated by mew3.
     */
    documentInfoFile: File

    /**
     * Creates a SourcePassage from a langchain-style Document as defined in
     * genAiBase/resource/code/c3genai/retrieval/common/doc_store.py
     */
    fromDoc: private inline function(doc: !native): !Genai.SourcePassage py

    /**
     * Creates a langchain-style Document as defined in genAiBase/resource/code/c3genai/retrieval/common/doc_store.py
     * from a SourcePassage
     */
    toDoc: private inline member function(score: double, rank: int): !native py

    /**
     * Processes a source passage and returns a dictionary formatted for LLM.
     */
    toLlmMessage: private inline member function(useRawImages: boolean, treatTablesAsImages: boolean): !map<string, any> py
}
