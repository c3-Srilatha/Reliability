/**
 * Type containing Expression Engine Functions for {@link Genai.SourcePassage}.
 */
type Genai.SourcePassage.ExpressionEngineFunction mixes ExpressionEngineFunction {

  /**
   * Returns whether its a table, image or text of {@link Genai.SourcePassageTypeEnum}.
   *
   * @param isImageSource
   *          Whether {@link Genai.SourcePassage#imageFile} exists.
   * @param isTableSource
   *          Whether {@link Genai.SourcePassage#dataFrameFile} exists.
   */
  getSourceType: function(isImageSource: boolean, isTableSource: boolean): !Genai.SourcePassageTypeEnum js-rhino
}
