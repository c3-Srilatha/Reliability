/**
* The table representation of {@link Genai.SourcePassage}
*/
type Genai.SourcePassage.Table {
    /**
    * LLM-readable string version of the data in the table.
    */
    tableVerbalization: string

    /**
    * Extracted table file
    */
    tableFile: File

    /**
    * CSV version of the data frame of the table. Used for display purposes of the table
    */
    dataFrameFile: File

    /**
    * Url of the cropped table image (useful for facilitaing LLM answering in REA pipeline)
    */
    tableImageFile: File

    /**
    * Header for the table
    */
    header: string

    /**
    * The title of the table
    */
    title: string

    /**
     * Helper function to retrieve the table data from the #dataFrameFile.
     */
    @action(group='read')
    getData: member function(): !json py
}
