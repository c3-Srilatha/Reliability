// c3-analysis-disable c3-excessive-method-params -- functions must be refactored to use specs where possible

/**
 * `SourceFileChunker`s break the content of {@link Genai.SourceFile}s into {@link Genai.SourcePassage}s that
 * can be embedded and loaded, indexed, and searched in a Genai.Retriever.
 */
abstract type Genai.SourceFile.Chunker {
  /**
   * Subtypes of Genai.SourceFile.Chunker should implement `doChunkFilesBatch` to chunk each of a list of source files
   * that has already been downloaded locally. The input is given as an array of named tuples, each of which has
   * a `sourceFile` and the corresponding `localPath` to which the {@link Genai.SourceFile#originalFile} has been
   * downloaded.
   * @param localPaths
   *    The local tmp file paths for {@link Genai.SourceFile}
   *
   * The result should be a map of source file id to list of passages from that file.
   */
  doChunkFilesBatch: abstract function(sourceFiles: ![Genai.SourceFile], localPaths: ![string], chunkerSpec: Genai.SourceFile.ChunkerSpec): Genai.SourceFileIntermediateChunkerResult

  /**
   * Chunk the provided {@link Genai.SourceFile} into {@link Genai.SourcePassage}s.
   * Unless `doNotWrite` is `true`, then the produced passages will be written to file before they are returned.
   */
  chunkFile: function(file: !Genai.SourceFile, chunkerSpec: Genai.SourceFile.ChunkerSpec, doNotWrite: boolean): Genai.SourceFileChunkerResult py-chunker

  /**
   * Chunk the provided {@link Genai.SourceFile}s into {@link Genai.SourcePassage}s.
   * Unless `doNotWrite` is `true`, then the produced passages will be written to file before they are returned.
   * If omitPassagesInResult is `true`, then {@link Genai.SourceFileChunkerResult#passages} will be left empty,
   * requiring that the produced passages to be read afterwards.
   */
  chunkFilesBatch: function(files: ![Genai.SourceFile],
    chunkerSpec: Genai.SourceFile.ChunkerSpec,
    doNotWrite: boolean,
    omitPassagesInResult: boolean): Genai.SourceFileChunkerResult py-chunker

  /**
   * Helper to chunk the provided {@link Genai.SourceFile} into a map of source file IDs to lists of passages.
   * The inputs are an array of `sourceFile` and `localPath`, along with a custom document loader and splitter based on
   * file types. An optional argument for a custom source passage creator method is also available.
   *
   * @param localPaths
   *    The local temporary file paths for {@link Genai.SourceFile}s.
   * @param loader
   *    A required lambda function that uses subtypes of {@link Genai.SourceFile.Chunker} to load context and then applies a splitter from
   *    splitterHelper in the calling any custom loader lambda, from its subtype.
   * @param fileType
   *    A tuple of enum type {@link Genai.SourceFileTypes}.
   * @param chunkerSpec
   *    A {@link Genai.SourceFile.ChunkerSpec} used to specify which chunker, referencing to the attribute,
   *    fileExtToChunkerSpecMap in {@link Genai.SourceFile.Chunker.UniversalChunker.Config}, to use for chunking {@link Genai.SourceFile}.
   * @param createCustomSourcePassage
   *    A lambda function to create custom source passages {@link Genai.SourcePassage}s.
   * @return the intermediate chunker result that maintains the passagesMap of {@link Genai.SourceFileIntermediateChunkerResult}.
   */
  chunkFilesBatchHelper: private inline function(sourceFiles: ![Genai.SourceFile],
                                                 localPaths: ![string],
                                                 loader: !lambda(),
                                                 fileType: Tuple,
                                                 chunkerSpec: Genai.SourceFile.ChunkerSpec,
                                                 createCustomSourcePassage: lambda()): Genai.SourceFileIntermediateChunkerResult py

  /**
   * Helper to generalize creation of text splitter pipeline for a given file type(s).
   * The inputs are chunkerSpec and either an empty splitters list or non-langchain splitters list for each file type(s).
   */
  splitterHelper: private inline function(chunkerSpec: !Genai.SourceFile.ChunkerSpec, splitters: [lambda()]): lambda() py

  /**
   * Helper to read a file from `localPath` with the specified number of lines to be read in context.
   * The input is given as a `localPath` to read and `nLinesToRead` to specify how many lines to read.
   * The default is 5 lines. The output is a string containing the first N lines of the content.
   * Subtypes of {@link Genai.SourceFile.Chunker} should implement `readFirstNLines` method.
   *
   * @param localPath
   *    The required string path to the file to read.
   * @param nLinesToRead
   *    The number of lines to read from the file.
   * @return the required string containing the first N lines of the content.
   */
  readFirstNLines: function(localPath: !string, nLinesToRead: int = 5): !string py
}
