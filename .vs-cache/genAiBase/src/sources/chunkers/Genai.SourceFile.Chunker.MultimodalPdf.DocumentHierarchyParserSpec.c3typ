/**
 * Defines the spec for the Document Hierarchy used in {@link Genai.SourceFile.Chunker.MultimodalPdf}.
 */
type Genai.SourceFile.Chunker.MultimodalPdf.DocumentHierarchyParserSpec mixes Spec {

  /**
  * The name of the LLM config to use for document hierarchy parsing.
  */
  llmConfigName: !string = 'qa_inference_config_gpt4'

  /**
  * End page up to which the table of content detection should be done.
  */
  pageToStopTableOfContentDetection: int = 10

  /**
  * The minimum number of pages to be considered for table of content detection.
  */
  earlyStopTableOfContentDetectionIncrement: int = 3

  /**
  * If the header text contains these values, then only do table of content detection.
  */
  targetTableOfContentStrings: [string] = ['table of content', 'index']

  /**
  * Different modes to detect table of content. (conditional, full_sweep, disable)
  * conditional: Detect table of content only if the header text contains the #targetTableOfContentStrings.
  * full_sweep: Detect table of content for all pages.
  * disable: Disable table of content detection.
  */
  tableOfContentDetectionMode: string enum('conditional', 'full_sweep', 'disable') = 'conditional'

  /**
  * Threshold for fuzzy matching of header text with targetTableOfContentStrings.
  */
  fuzzyMatchThreshold: int = 80

  /**
  * The list of prefixes to be removed before fuzzy matching.
  */
  prefixesToRemove: [string] = ["section", "subsection", "item", "part", "article"]

  /**
  * The prompt to be used for table of content detection.
  */
  tableOfContentDetectionPrompt: !string = 'Table of Content'

}
