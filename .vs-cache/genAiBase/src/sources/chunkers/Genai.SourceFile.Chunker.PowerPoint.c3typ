/**
 * A {@link Genai.SourceFile.Chunker} for PPTX that uses UnstructuredPowerPointLoader
 * {@link https://python.langchain.com/en/latest/modules/indexes/document_loaders/examples/microsoft_powerpoint.html}
 */
type Genai.SourceFile.Chunker.PowerPoint mixes Genai.SourceFile.Chunker {
  doChunkFilesBatch: ~ py-chunker
  readFirstNLines: ~ py-chunker
}
