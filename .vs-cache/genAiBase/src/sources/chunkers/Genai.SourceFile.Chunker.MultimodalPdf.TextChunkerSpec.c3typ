/**
 * Defines the Text chunker spec for {@link Genai.SourceFile.Chunker.MultimodalPdf}.
 */
type Genai.SourceFile.Chunker.MultimodalPdf.TextChunkerSpec mixes Spec {
  /**
   * The maximum token length of a chunk
   */
  splitLength: int = 500

  /**
   * The overlapping token length of the sliding window
   */
  splitOverlap: int = 100

  /**
   * Add page number for the chunk
   */
  doNotAddPageNumber: boolean
}
