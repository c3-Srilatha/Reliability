/**
 * A {@link Genai.SourceFile.Chunker} for Pdfs with tables.
 */
type Genai.SourceFile.Chunker.TablePdf mixes Genai.SourceFile.Chunker {
    doChunkFilesBatch: ~ py-chunker

    /**
     * Default implementation of camelot table verbalizer.
     * If camelotTableVerbalizerLambda in {@link Genai.SourceFile.Chunker.TablePdf.Spec} is set, it will be used instead.
     */
    camelotTableVerbalizer: function(table: !native): string py-chunker
}
