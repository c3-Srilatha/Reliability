/**
 * Defines the spec for table detector used in {@link Genai.SourceFile.Chunker.MultimodalPdf}
 */
type Genai.SourceFile.Chunker.MultimodalPdf.TableDetectorSpec mixes Spec {
  /**
   * The threshold value for table detection confidence.
   */
  detectionThreshold: float = 0.75

  /**
   * The maximum batch size for processing tables.
   * Table parsing allocates ~55 MB per item in a batch, so 8 items requires
   * ~450 MB free to start the parsing process.
   */
  maxBatchSize: int = 8

  /**
   * Keyword arguments for page_to_image method.
   */
  pageImageKwargs: json = {"antilias": true}
}
