/**
 * Defines the spec for the image verbalizer (used by multimodal-VLMs).
 */
type Genai.SourceFile.Chunker.Image.BaseImageVerbalizerSpec mixes Spec {
  /**
   * The name of {@link Genai.UnstructuredQuery.Engine.REA.ModelInferenceConfig} for Image Verbalization.
   */
  llmConfigName: string

  /**
   * The name of the vision language model to use for verbalization.
   */
  modelName: string

  /**
   * The max length allowed for the generated chunk after verbalization.
   */
  maxLength: int
}
