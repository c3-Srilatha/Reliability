/**
 * Defines the spec for the Nougat text parser used in {@link Genai.SourceFile.Chunker.MultimodalPdf}.
 */
type Genai.SourceFile.Chunker.MultimodalPdf.NougatSpec mixes Spec {
  /**
   * Nougat model kwargs.
   * See {@link https://huggingface.co/docs/transformers/main/en/model_doc/nougat} for more keyword arguments.
   */
  nougatModelKwargs: json

  /**
   * The maximum batch size for nougat. The default is 64 which is approx 385MB w/ 640x400 sized RGB images.
   */
  nougatMaxBatchSize: int = 64

  /**
   * The threshold used in nougat stopping criteria.
   */
  nougatStoppingCriteriaThreshold: float = 0.015

  /**
   * The window size used in nougat stopping criteria.
   */
  nougatStoppingCriteriaWindowSize: int = 200
}
