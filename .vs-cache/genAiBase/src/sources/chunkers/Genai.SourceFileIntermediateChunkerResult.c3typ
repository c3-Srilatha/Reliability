/**
 * Intermediate chunker result that maintains the #passagesMap that allows for more effieicnt downstream
 * processing and file writing inside of {@link Genai.SourceFile.Chunker#chunkFilesBatch}.
 */
type Genai.SourceFileIntermediateChunkerResult {
  /**
   * The passages map for the successfully chunked files. Map is keyed by {@link Genai.SourceFile#id}
   * and values are the passages of the chunked file.
   */
  passagesMap: map<string, [Genai.SourcePassage]>

  /**
   * The successfully and unsuccessfully chunked files.
   */
  objList: ObjList<Genai.SourceFile>
}
