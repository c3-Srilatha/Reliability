/**
 * Defines the config for {@link Genai.SourceFile.Chunker.MsftX}.
 */
type Genai.SourceFile.Chunker.MsftX.Config mixes Config, Singleton {

    /**
     * The arguments to pass the to `unstructured` chunker
     * `chunking_strategy` can be `basic` or `by_title`
     * See <https://docs.unstructured.io/open-source/core-functionality/chunking#chunking-strategies>
     * Other chunking options: <https://github.com/Unstructured-IO/unstructured/blob/1f8030dd0ee76389c619603197fc5f7f4e546d09/unstructured/chunking/base.py#L63-L99>
     */
    unstructuredChunkingSpec: map<string, any>

    /** Defines the image verbalizer used to verbalize the tables. One of the {@link Genai.UnstructuredQuery.Engine.ModelConfig}s */
    imageVerbalizerModelConfig: !string

    /** Defines the table verbalizer used to verbalize the tables. One of the {@link Genai.UnstructuredQuery.Engine.ModelConfig}s */
    tableVerbalizerModelConfig: !string
}
