/**
 * An enhanced {@link Genai.SourceFile.Chunker} for c3 types. Note that it accepts a c3typ file but will actually use the type
 * metadata from the server on which it is running. The c3typ file is used only to get the type name.
 */

type Genai.SourceFile.Chunker.C3TypEnhanced mixes Genai.SourceFile.Chunker {
  doChunkFilesBatch: ~ py-chunker
}
