/**
 * Defines the config for {@link Genai.SourceFile.Chunker.MultimodalPdf}.
 */
type Genai.SourceFile.Chunker.MultimodalPdf.Config mixes Singleton, Config {
  /**
   * Defines the text parser spec
   */
  textParserSpec: !Genai.SourceFile.Chunker.MultimodalPdf.TextParserSpec

  /**
   * Defines the image parser spec (optional). If the param is not passed,
   * even if #disableImageParser is set to False, then the image parsing will be skipped.
   */
  imageParserSpec: Genai.SourceFile.Chunker.MultimodalPdf.ImageParserSpec

  /**
   * Defines the table parser spec (optional). If the param is not passed,
   * even if #disableTableParser is set to False, then the table parsing will be skipped.
   */
  tableParserSpec: Genai.SourceFile.Chunker.MultimodalPdf.TableParserSpec

  /**
   * Defines the layout parser spec
   */
  layoutParserSpec: !Genai.SourceFile.Chunker.MultimodalPdf.LayoutParserSpec

  /**
   * Enable the layout parser
   */
  enableLayoutParser: boolean

  /**
   * Disable the Image parser (default: False). If set to True, then the image parsing will be skipped.
   */
  disableImageParser: boolean

  /**
   * Disable the Table parser (default: False). If set to True, then the table parsing will be skipped.
   */
  disableTableParser: boolean
}
