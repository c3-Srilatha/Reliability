/**
 * Result from {@link Genai.SourceFile.Chunker#doChunkFilesBatch} that contains the passages of source files that were
 * successfully chunked and the source files that failed to chunk.
 */
type Genai.SourceFileChunkerResult {

  /**
   * The passages for the successfully chunked files.
   */
  passages: [Genai.SourcePassage]

  /**
   * The files that failed to chunk
   */
  objList: ObjList<Genai.SourceFile>
}
