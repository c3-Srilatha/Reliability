/**
 * The shared spec arguments used to create S3, Azure, GCS, etc, external file system mounts
 */
abstract type Genai.SourceSystem.CreateSpec mixes Spec {

  /**
   * Name of the source system
   */
  name: !string

  /**
   * Description of the source system
   */
  description: string

  /**
   * The name of the mount being created in the {@link FileSystem}
   */
  mountName: string

  /**
   * Name of the directory inside the external system mount
   */
  bucketName: !string
}
