/**
 * Spec to create an AWS S3 based external source system.
 */
type Genai.SourceSystem.S3.CreateSpec mixes Genai.SourceSystem.CreateSpec {
  /**
   * The access key for the S3 bucket.
   */
  accessKey: !string

  /**
   * The secret key for the S3 bucket.
   */
  secretKey: !string

  /**
   * The region of the S3 bucket.
   */
  region: !string
}
