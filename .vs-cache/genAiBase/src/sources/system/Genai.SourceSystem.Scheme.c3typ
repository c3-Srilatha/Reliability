/**
 * Type that represents an external source system for a {@link Genai.SourceSystem}
 */
enum type Genai.SourceSystem.Scheme {
  /**
   * An AWS S3 source. See {@link Genai.SourceSystem.S3}.
   */
  S3 = 'S3'

  /**
   * An Azure source. See {@link Genai.SourceSystem.Azure}.
   */
  AZURE = 'AZURE'

  /**
   * A GCS source. See {@link Genai.SourceSystem.Gcs}.
   */
  GCS = 'GCS'
}
