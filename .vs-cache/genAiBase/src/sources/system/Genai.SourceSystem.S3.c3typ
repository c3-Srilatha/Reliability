/**
 * Represents the root of an external AWS S3 file system.
 */
entity type Genai.SourceSystem.S3 extends Genai.SourceSystem<Genai.SourceSystem.S3.CreateSpec> type key "GENAI_S3" {

  /**
   * The type of the source system
   */
  sourceType: string = Genai.SourceSystem.Scheme.S3

  /**
   * Gets the url for the mount
   */
  getRootUrl: function(bucketName: string): !string js-rhino

  /**
   * Creates a {@link Genai.SourceSystem.S3} with its mount into the {@link FileSystem}
   * given a {@link Genai.SourceSystem.S3.CreateSpec}.
   */
  createSourceSystem: ~ js-rhino

  /**
   * Validates the connection for the S3 source system.
   */
  validateConnection: ~ js-rhino

  /**
   * Returns true if a source system has a unique name within existing S3 systems, false otherwise.
   */
  doesNameExist: ~ js-rhino


  /**
   * Verifies if the provided credentials can access the provided bucket.
   */
  testCredentials: private function(credentials: !CloudCredentials, bucketName: !string): !Genai.SourceSystem.ValidateConnectionResult js-rhino

  /**
  * Returns a unique mount name for the given bucket name.
  * If a mount with the name bucketName already exists and is used in a persisted Genai.SourceSystem.S3, a unique mount name is returned.
  * Otherwise, the existing mount name is returned for re-use.
  * In cases where the mount name is created, but the S3System is not persisted, the mount name will be re-used.
  */
  getNextMountName: private function(bucketName: !string): !string js-rhino
}
