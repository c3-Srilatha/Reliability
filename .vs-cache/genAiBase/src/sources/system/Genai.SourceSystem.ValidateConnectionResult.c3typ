/**
 * Type that represents the output of {@link Genai.SourceSystem#validateConnection}
 */
type Genai.SourceSystem.ValidateConnectionResult {
  /**
   * Whether the given {@link CloudCredentials} were able to access the {@link CloudResource}.
   */
  success: boolean

  /**
   * The error message if the {@link CloudResource} could not be accessed.
   */
  error: string

  /**
   * The name of the mount in {@link FileSystem#mounts} created for this source system if connection was a success.
   */
  mountName: string

  /**
   * The URL of the mount created for this source system if connection was a success.
   */
  mountUrl: string
}
