/**
 * Spec to create an Azure based external source system.
 */
type Genai.SourceSystem.Azure.CreateSpec mixes Genai.SourceSystem.CreateSpec {

  /**
   * Account ID for the Azure bucket.
   */
  accountId: !string

  /**
   * Account name for the Azure bucket.
   */
  accountName: !string

  /**
   * The region of the Azure bucket.
   */
  region: !string
}
