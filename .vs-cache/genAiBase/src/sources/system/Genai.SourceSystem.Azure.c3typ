/**
 * Represents the root of an external Azure file system.
 */
entity type Genai.SourceSystem.Azure extends Genai.SourceSystem<Genai.SourceSystem.Azure.CreateSpec> type key "GENAI_AZ" {


  /**
   * The type of the source system
   */
  sourceType: string = Genai.SourceSystem.Scheme.AZURE

  /**
   * The url for the mount
   */
  rootUrl: string calc "azure://" + bucketName

  /**
   * Creates a {@link Genai.SourceSystem.Azure} with its mount into the {@link FileSystem}
   * given a {@link Genai.SourceSystem.Azure.CreateSpec}.
   */
  createSourceSystem: ~ js-rhino

  /**
   * Validates the connection for the Azure source system.
   */
  validateConnection: ~ js-rhino
}
