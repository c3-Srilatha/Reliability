/**
 * Options passed to map reduce job for chunking.
 * Includes chunker spec, batch size, and whether to index files on job completion.
 */
type Genai.SourceFile.Job.ChunkMapReduceSpec {
  /**
   * Chunker config.
   */
  chunkerSpec: Genai.SourceFile.Chunker.UniversalChunker.Spec

  /**
   * All {@link Genai.SourceFile}s to be chunked
   */
  files: ![Genai.SourceFile]

  /**
   * In certain cases, it may be useful to directly chunk a set of files without actually adding them to the index yet.
   * When set to true, after chunking, automated metadata tagging and indexing will be skipped.
   */
  skipProcessChunkingCompletion: boolean

  /**
   * If #skipProcessChunkingCompletion is not true, adds metadata with tag categories to source files before indexing.
   */
  scanResult: Genai.SourceFile.Metadata.Tagging.ScanResult

  /**
   * If #skipProcessChunkingCompletion is not true, indexes chunked files in vector store.
   */
  vectorStore: Genai.Retriever

  /**
   * If #skipProcessChunkingCompletion is not true, sets the 'lastProcessedBy' field on source file to specified user.
   */
  lastProcessedBy: string
}
