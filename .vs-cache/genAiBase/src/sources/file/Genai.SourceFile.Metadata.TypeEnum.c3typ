/**
 * Represents how the metadata was generated the two options are MANUAL when the metadata was
 * created by a user and AUTOMATIC when the metadata was created by the process of automatic metadata tagging
 */
enum type Genai.SourceFile.Metadata.TypeEnum {

  /**
   * 'Manual' means the metadata was created by a user
   */
  MANUAL = "Manual"

  /**
   * 'Automatic' means the metadata was created by the process of automatic metadata tagging
   */
  AUTOMATIC = "Automatic"
}
