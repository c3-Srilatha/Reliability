/**
 * Data format for displaying number files indexed, new, failed, and modified
 */
type Genai.SourceFile.StatusCounts {

  /**
   * Number of {@link Genai.SourceFile}s in the indexed state
   */
  numIndexed: !int

  /**
   * Number of {@link Genai.SourceFile}s that were recently created
   */
  numNew: !int

  /**
   * Number of {@link Genai.SourceFile}s in the re-index required state
   */
  numModified: !int

  /**
   * Number of {@link Genai.SourceFile}s in the failed state
   */
  numFailed: !int

  /**
   * Number of {@link Genai.SourceFile} whose originalFiles have been deleted.
   */
  numDeleted: !int
}
