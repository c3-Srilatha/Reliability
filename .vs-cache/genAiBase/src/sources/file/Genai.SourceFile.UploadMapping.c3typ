/** Map between the files to be and uploaded and the collection to upload them to */
type Genai.SourceFile.UploadMapping {
    /**
     * The collection to upload the files to
     */
    collection: Genai.SourceCollection

    /**
     * List of files to be uploaded to the collection
     */
    files: ![File]
}
