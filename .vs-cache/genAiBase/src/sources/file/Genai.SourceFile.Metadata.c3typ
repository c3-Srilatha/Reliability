/**
 * Metadata associated with a {@link Genai.Source}.
 * Results from a similarity search can be filtered out based on a metadata field's value.
 * Filters can be passed in to a query via {@link Genai.Query.Operator.Types}
 * or through {@link Genai.Query#filters} field.
 */
type Genai.SourceFile.Metadata {
  /**
   * The name of the original file. Includes the file extension.
   */
  fileName: !string

  /**
   * The extension type of the original file.
   */
  fileType: !?string

  /**
   * The person who created the contents of the file.
   */
  author: string

  /**
   * When the contents of the file were created.
   */
  date: datetime

  /**
   * All {@link Genai.SourceFile.Metadata.Tag}s that have been set on a {@link Genai.Source}.
   */
  tags: [Genai.SourceFile.Metadata.Tag]

  /**
   * The {@link Genai.SourceFile.Metadata.Tag}s that have been banned from a {@link Genai.Source}.
   */
  bannedTags: [Genai.SourceFile.Metadata.Tag]
}
