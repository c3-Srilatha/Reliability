/**
 * This spec is used to define input required for {@link Genai.SourceFile.Metadata.Category#fromSpec} function.
 */
type Genai.SourceFile.Metadata.Category.Spec {
  /**
   * The name of the category.
   */
  label: !string

  /**
   * Examples to be included in the prompt of metadata extraction process
   */
  examples: [string]

  /**
   * This defines the way that the tag is created the two options MANUAL or AUTOMATIC.
   * by default {@link Genai.SourceFile.Metadata.Tag} has the value MANUAL.
   */
  metadataType: !string enum Genai.SourceFile.Metadata.TypeEnum = MANUAL
}
