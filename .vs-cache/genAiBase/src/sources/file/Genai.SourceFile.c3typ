// c3-analysis-disable c3-excessive-method-params -- functions must be refactored to use specs where possible
/**
 * A Genai.SourceFile represents a single file within a {@link Genai.SourceCollection}'s 'rootUrl`.
 */
@db(index+=['originalFile.url'])
entity type Genai.SourceFile extends Genai.Source mixes Genai.ProjectAware type key "FL" {
    /**
     * Implemented to ensure that all passages derived from this file are removed.
     */
    //TODO: GENAI-326 implement to remove passages and embeddings / passagesFile (depending on final storage format)
    beforeRemove: ~ js-rhino
    beforeUpdate: ~ js-rhino
    writePassages: ~ js-rhino
    readPassages: ~ js-rhino | py
    mergedPassages: ~ js-rhino

    /**
     * The current status of the source file with respect to data ingestion
     */
    @db(timedValueHistoryField='statusHistory')
    status: Genai.SourceFile.StatusTimedValue

    /**
     * The history of statuses for the source file
     */
    @db(order='descending(timestamp)')
    statusHistory: [Genai.SourceFile.StatusHistory](parent)

    /**
     * Checks if the #statusHistory is curently indexing, syncing, or being removed from index.
     */
    isProcessing: boolean calc (statusHistory[0].value == 'Indexing') || (statusHistory[0].value == 'Syncing') || (statusHistory[0].value == 'Removing') || (statusHistory[0].value == 'Chunking')

    /**
     * If set, this is the URL that should be used in the UI for any links to display the file contents. Otherwise,
     * #originalFile.url will be used.
     */
    displayUrl: string serialized Url

    /**
     * The collection that this file belongs to
     */
    collection: Genai.SourceCollection

    /**
     * The {@link Genai.Project}s, if any, that this file belongs to
     */
    projects: [Genai.Project] calc collection.projects

    /**
     * The file that this SourceFile represents
     */
    originalFile: !File

    /**
     * The file with all table parsing results
     */
    tablePassagesFile: File

    /**
     * The file with all image parsing results
     */
    imagePassagesFile: File

    /**
     * True if user uploaded this document through the application,
     * otherwise false
     */
    userUploaded: boolean

    /**
     * Triggers processing, chunking, and indexing of {@link Genai.SourceFile}s
     * @return the files processed
     */
    process: function(files: ![Genai.SourceFile],
                      vectorStore: Genai.Retriever,
                      chunkerSpec: Genai.SourceFile.Chunker.UniversalChunker.Spec,
                      scanResult: Genai.SourceFile.Metadata.Tagging.ScanResult,
                      lastProcessedBy: string): ObjList<Genai.SourceFile> js-rhino


    /**
     * Triggers automated metadata tagging and indexing of {@link Genai.SourceFile}s
     * @return the files processed
     */
    processChunkingCompletion: private function(chunkObjList: ObjList<Genai.SourceFile>,
                      files: ![Genai.SourceFile],
                      vectorStore: Genai.Retriever,
                      scanResult: Genai.SourceFile.Metadata.Tagging.ScanResult,
                      lastProcessedBy: string): ObjList<Genai.SourceFile> js-rhino

    /**
     * Triggers complete unprocessing/unindexing of {@link Genai.SourceFile}s
     * @param files
     *           {@link Genai.SourceFile}s to unindex
     * @param vectorStore
     *           {@link Genai.Retriever} used for unindexing
     * @param shouldTransitionToDeleted
     *           Transitions the {@link Genai.SourceFile#status} to {@link Genai.SourceFile.StatusEnum#DELETED} if set to true
     * @return the values returned from unindexFiles
     */
    unprocess: function(files: ![Genai.SourceFile],
                        vectorStore: Genai.Retriever,
                        shouldTransitionToDeleted: boolean): ObjList<Genai.SourceFile> js-rhino

    /**
     * Creates and optionally processes a SourceFile for each of the provided `sourceUrl`s.
     * If `chunkerSpec` is not provided, then SourceFiles will be created (and persisted) but not processed.
     *
     * Should only be called on sourceUrls which have no source files related to them. Throws an error
     * if such urls are passed into the function.
     */
    fromUrlsBatch: function(collection: !Genai.SourceCollection,
                            sourceUrls: ![string],
                            chunkerSpec: Genai.SourceFile.Chunker.UniversalChunker.Spec): [Genai.SourceFile] js-rhino


    /**
     * Creates and optionally processes a SourceFile for each of the provided `originalFile`s.
     * If `chunkerSpec` is not provided, then SourceFiles will be created (and persisted) but not processed.
     *
     * Should only be called on {@link File}s which have no {@link SourceFile} related to them. Throws an error
     * if such files are passed into the function.
     */
    fromFilesBatch: function(collection: !Genai.SourceCollection,
                            originalFiles: ![File],
                            chunkerSpec: Genai.SourceFile.Chunker.UniversalChunker.Spec,
                            userUploaded: boolean): [Genai.SourceFile] js-rhino

    /**
     * Sync {@link Genai.SourceFile}s according to the chunker spec provided.
     * This will execute synchronously for each unique collection to sync the source files provided.
     * If `chunkerSpec` is not provided, the {@link Genai.SourceFile}s will not be chunked into {@link Genai.SourcePassage}s.
     */
    syncFiles: function(sourceFiles: ![Genai.SourceFile],
                        chunkerSpec: Genai.SourceFile.Chunker.UniversalChunker.Spec) js-rhino

    /**
     * Sync {@link Genai.SourceFile}s according to the chunker spec provided.
     * This will trigger a batch job for each unique collection to sync the source files provided.
     * If `chunkerSpec` is not provided, the {@link Genai.SourceFile}s will not be chunked into {@link Genai.SourcePassage}s.
     */
    syncFilesBatch: function(sourceFiles: ![Genai.SourceFile],
                             chunkerSpec: Genai.SourceFile.Chunker.UniversalChunker.Spec) js-rhino

    /**
     * Helper function that checks if there is a {@link Genai.Retriever} provided to index and unindex files
     * or if the default Genai.UnstructuredQuery.Engine.Config has one. If not then an error is thrown and files are
     * transitioned to the {@link Genai.SourceFile.StatusEnum#FAILED} state.
     */
    checkVectorStore: function(files: ![Genai.SourceFile], vectorStore: Genai.Retriever, lastProcessedBy: string): !Genai.Retriever js-rhino

    /**
     * Transitions the provided {@link Genai.SourceFile}s to the provided {@link Genai.SourceFile.StatusEnum} at the current time
     * by creating related {@link Genai.SourceFile.StatusHistory} instances
     *
     * @param files
     *           {@link Genai.SourceFile}s which will have their status updated
     * @param status
     *           {@link Genai.SourceFile.StatusEnum} to update the files to
     * @param lastProcessedBy
     *           The {@link User#email} who last processed this source file
     *           This is used in {@link Genai.SourceFile#displayLastProcessedBy} to display the last processed activity in UI.
     *           The entire {@link User} is not persisted to avoid access issues with ACLs.
     * @param errorMessages
     *           String error messages to persist with the status histories on the files when the files are being transitioned
     *           to the {@link Genai.SourceFile.StatusEnum#FAILED} state. Needs to be the same length as the files param.
     */
    transitionFilesToStatus: function(files: !?[Genai.SourceFile],
                                      status: !string enum Genai.SourceFile.StatusEnum,
                                      lastProcessedBy: string,
                                      errorMessages: [string]): [Genai.SourceFile.StatusHistory] js-rhino

    /**
     * Transitions the {@link Genai.SourceFile}s in the {@link Genai.SourceCollection} to the provided
     * {@link Genai.SourceFile.StatusEnum}.
     *
     * @param collection
     *           {@link Genai.SourceFile}s in this {@link Genai.SourceCollection} will have their status updated
     * @param status
     *           {@link Genai.SourceFile.StatusEnum} to update the files to
     * @param lastProcessedBy
     *           The {@link User#email} who last processed this source file
     *           This is used in {@link Genai.SourceFile#displayLastProcessedBy} to display the last processed activity in UI.
     *           The entire {@link User} is not persisted to avoid access issues with ACLs.
     * @param filter
     *           Filter to be applied to {@link Genai.SourceFile} in this collection. Only the filtered {@link Genai.SourceFile}s will have their status updated
     * @param errorMessage
     *           String error message to also persist on
     */
    transitionCollectionToStatus: function(collection: !Genai.SourceCollection,
                                           status: !string enum Genai.SourceFile.StatusEnum,
                                           lastProcessedBy: string,
                                           filter: Filter,
                                           errorMessage: string): [Genai.SourceFile.StatusHistory] js-rhino


    /**
     * Transitions all files in `NOT_INDEXED` and 'NEEDS_REINDEXING' states to `CHUNKING` and returns those files.
     * Used by the Documents Page UI to kick off the the bulk "Add To Index" warning banner action and synchronizes
     * those files states with the UI via a `refreshCalcFields` API call.
     */
    transitionRelevantFilesToChunking: function(): [Genai.SourceFile] js-rhino

    /**
     * Handles the transition of a list of source files to the `INDEXED` state.
     */
    handleTransitionToIndexed: function(sourceFiles: [Genai.SourceFile]) js-rhino

    /**
     * Handles the transition of the source files inside a {@link Genai.SourceCollection} to the `INDEXED` state.
     */
    handleTransitionToIndexed: function(collection: Genai.SourceCollection) js-rhino

    /**
     * Handles the transition of a list of source files to the `NOT_INDEXED` state. Will `ARCHIVE` files which were previously in the state of `NEEDS_REMOVAL`.
     */
    handleTransitionToNotIndexed: function(sourceFiles: [Genai.SourceFile]) js-rhino

    /**
     * Handles the transition of all of the source files inside a {@link Genai.SourceCollection}
     * to the `NOT_INDEXED` state. Will `ARCHIVE` files which were previously in the state of `NEEDS_REMOVAL`.
     */
    handleTransitionToNotIndexed: function(collection: Genai.SourceCollection) js-rhino

    /**
     * Handles the transition of a list of source files to the `CHUNKED` state.
     */
    handleTransitionToChunked: function(sourceFiles: [Genai.SourceFile]) js-rhino

    /**
     * Handles the transition of the source files inside a {@link Genai.SourceCollection} to the `CHUNKED` state.
     */
    handleTransitionToChunked: function(collection: Genai.SourceCollection) js-rhino

    /**
     * Retrieves the status counts of {@link Genai.SourceFile}s over the last 24 hours
     */
    @action(group='read')
    getStatusCounts: function(): !Genai.SourceFile.StatusCounts js-rhino

    /**
     * Adds a list of {@link Genai.SourceFile.Metadata.Tag} to this SourceFile's @link Genai.SourceFile#metadata}.
     * Persists the tags if they are not already persisted.
     */
    @action(group='write')
    addTags: function(tagLabels: ![string], sourceFiles: ![Genai.SourceFile]) js-rhino

    /**
     * Adds a {@link Genai.SourceFile.Metadata.Tag} to this {@link Genai.SourceFile#metadata}.
     * Persists the tag if it is not already persisted.
     * @param sourceFile
     *         The source file to add the tag to.
     * @param tagLabel
     *         The label of the tag to add.
     * @param categoryLabel
     *         The category of the tag to add.
     */
    @action(group='write')
    addManualTag: function(sourceFile: !Genai.SourceFile, tagLabel: !string, categoryLabel: !string) js-rhino

    /**
     * updates a existing {@link Genai.SourceFile.Metadata.Tag} from a {@link Genai.SourceFile}.
     * @param sourceFile
     *         The source file to update the tag from.
     * @param oldTag
     *         The tag to update.
     * @param newTagLabel
     *         The new label of the tag.
     */
    @action(group='write')
    updateManualTag: function(sourceFile: !Genai.SourceFile, oldTag: !Genai.SourceFile.Metadata.Tag, newTagLabel: !string) js-rhino

    /**
     * Removes a {@link Genai.SourceFile.Metadata.Tag} from this {@link Genai.SourceFile#metadata}.
     * @param sourceFile
     *         The source file to remove the tag from.
     * @param tag
     *         The tag to remove.
     */
    @action(group='write')
    removeManualTag: function(sourceFile: !Genai.SourceFile, tag: !Genai.SourceFile.Metadata.Tag) js-rhino

    /**
     * Takes in a map which is keyed by source file Ids and has values which are the {@link Genai.SourceFile.Metadata.Tag}s
     * to add to each of those source files.
     */
    @action(group='write')
    addTagsByMap: function(sourceFileMap: !map<string, [string]>) js-rhino

    /**
     * Takes in a map which is keyed by source file Ids and has values which are maps of category to tags
     * to add to each of those source files.
     */
    @action(group='write')
    addTagsByCategoryMap: function(sourceFileMap: !map<string, map<string, [string]>>) js-rhino

    /**
     * Returns a {@link Genai.SourceFile.Metadata} for the #originalFile. Calls the
     * {@link Genai.SourceCollection#syncMetadataLambda} for the file if the lambda exists and populates
     * the metadata with the results of that function. If no lambda exists this function just attaches
     * default metadata fields such as file name and file type.
     */
    fileMeta: function(sourceFile: !Genai.SourceFile, collection: !Genai.SourceCollection): !Genai.SourceFile.Metadata js-rhino

    /**
     * Filter out {@link Genai.SourceFile}s based on {@link Genai.SourceFile.StatusEnum}.
     * @param sourceFiles
     *         {@link Genai.SourceFile}s that needs to be filtered out.
     * @param statuses
     *         sourceFiles to keep if their status matches the ones present in the statuses array.
     * @return filtered out {@link Genai.SourceFile}s.
     */
    filterSourceFilesBasedOnStatus: private function(sourceFiles: ![Genai.SourceFile], statuses: ![Genai.SourceFile.StatusEnum]): ![Genai.SourceFile] js-rhino

    /**
     * A formatted representation of #groups for easier readability.
     */
    displayGroups: string calc join(groups, ', ')

    /**
     * The {@link User#email} who processed the source file.
     */
    lastProcessedBy: private string calc exists(status.lastProcessedBy) ? status.lastProcessedBy : meta.updatedBy

    /**
     * Information about the user who processed the source file formatted for display in the UI
     *
     * See Genai.SourceFile.StatusTimedValue#lastProcessedBy
     */
    displayLastProcessedBy: string calc lastProcessedBy == 'worker@c3' ? 'Batch Job' : lastProcessedBy

    /**
     * Fetches the {@link Genai.SourceFile}s for the active project of a given {@link User}
     * If the user has no active project, all {@link Genai.SourceFile}s are returned.
     * @param spec
     *         {@link FetchSpec} for fetching the source files.
     * @param user
     *         {@link User}s for whom to fetch the source files.
     * @return filtered out {@link Genai.SourceFile}s.
     */
    @action(group='read')
    fetchForUser: function(spec: FetchSpec, user: User): FetchResult js-rhino

    /**
     * Fetches the count of {@link Genai.SourceFile}s for the active project of a given {@link User}
     * If the user has no active project, all {@link Genai.SourceFile}s are counted.
     * @param spec
     *         {@link FetchSpec} for fetching the source files.
     * @param user
     *         {@link User}s for whom to fetch the source files.
     * @return count of {@link Genai.SourceFile}s.
     */
    @action(group='read')
    fetchCountForUser: function(spec: FetchSpec, user: User): !int js-rhino

    /**
     * Fetches the count of non-deleted {@link Genai.SourceFile}s for the active project of a given {@link User}
     * If the user has no active project, all {@link Genai.SourceFile}s are counted.
     * @param spec
     *         {@link FetchSpec} for fetching the source files.
     * @param user
     *         {@link User}s for whom to fetch the source files.
     * @return count of {@link Genai.SourceFile}s.
     */
    @action(group='read')
    fetchNonDeletedCountForUser: function(spec: FetchSpec, user: User): !int js-rhino

    /**
     * Fetches the {@link Genai.SourceFile}s for the active project of a given {@link User}
     * If the user has no active project, all {@link Genai.SourceFile}s are returned.
     * @param spec
     *         {@link FetchSpec} for fetching the source files.
     * @param user
     *         {@link User}s for whom to fetch the source files.
     * @return stream filtered out {@link Genai.SourceFile}s.
     */
    @action(group='read')
    fetchObjStreamForUser: function(spec: FetchSpec, user: User): stream<Genai.SourceFile> js-rhino

    /**
     * Replace any characters in the {@link Genai.SourceFile#id} that are not allowed in file names with an underscore (_).
     * It uses regular expressions to match and replace characters such as /, ?, <, >, \, :, *, |, and ".
     *
     * @return string
     *         the sanitized source file id.
     */
    getSanitizedSourceFileId: private member function(): !string js-rhino

    /**
     * Unindexes the source files if they are indexed and transitions them to {@link Genai.SourceFile.StatusEnum#DELETED}
     * Files which are in transitory state (i.e. #isProcessing is true) are not deleted
     * @param files
     *         {@link Genai.SourceFile}s to transition to deleted
     * @param vectorStore
     *         {@link Genai.Retriever} used for unindexing if files are indexed
     */
    unprocessAndTransitionToDeleted: function(files: ![Genai.SourceFile], vectorStore: Genai.Retriever) js-rhino

    /**
     * Returns {@link Genai.SourceFile}s whose #status is not {@link Genai.SourceFile.StatusEnum#DELETED}
     * @param fetchSpec
     *        Used to fetch {@link Genai.SourceFile}s to check if its valid or not
     * @return the valid source files
     */
    getValidSourceFiles: private function(fetchSpec: !FetchSpec): [Genai.SourceFile] js-rhino

    /**
     * Returns {@link Genai.SourceFile}s whose #status is {@link Genai.SourceFile.StatusEnum#DELETED}
     * @param fetchSpec
     *        Used to fetch {@link Genai.SourceFile}s to check if its valid or not
     * @return the deleted source files
     */
    getDeletedSourceFiles: private function(fetchSpec: !FetchSpec): [Genai.SourceFile] js-rhino

    /**
     * Modifies the associated {@link File}, appending a timestamp and moving it to a "deleted" subfolder and then
     * merges the {@link File} changes back into the instance
     */
    renameAndMoveToDeletedFolder: function(files: ![Genai.SourceFile]) js-rhino
}
