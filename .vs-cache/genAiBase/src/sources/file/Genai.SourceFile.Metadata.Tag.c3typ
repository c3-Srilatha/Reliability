/**
 * A Genai.SourceFile.Metadata.Tag is an arbitrary string label that a user can set on any {@link Genai.SourceFile}.
 */
entity type Genai.SourceFile.Metadata.Tag mixes StringSerializable, Genai.SourceFile.WithMetadataType {

  /**
   * The unique identifier constructed from Str.safeId(label).
   */
  id: ~

  /**
   * The label that is the body of the Tag.
   */
  label: !string

  /**
   * The {@link Genai.SourceFile.Metadata.Category} of the Tag.
   */
  category: Genai.SourceFile.Metadata.Category

  /**
   * The user that created the {@link Genai.SourceFile.Metadata.Tag} if it's of type 'MANUAL'.
   */
  lastModifiedBy: private User(id, meta.updatedBy)

  /**
   * Function for the creation of a {@link Genai.SourceFile.Metadata.Tag}.
   * @param spec
   *           The spec to create the tag from.
   * @return the created tag.
   */
  fromSpec: function(spec: Genai.SourceFile.Metadata.Tag.Spec): !Genai.SourceFile.Metadata.Tag js

  fromString: ~ js
  toString: ~ js
  beforeRemove: ~ js-rhino
}
