/**
 * Custom {@link ExpressionEngineFunction}s used to set the {@link Genai.SourceFile.Metadata.Category#createdBy} and
 * Genai.SourceFile.Metadata.Category numberOfDocuments fields.
 */
type Genai.SourceFile.Metadata.Category.ExpressionEngineFunction mixes ExpressionEngineFunction {
  /**
   * Function to obtain the name of the user who created the {@link Genai.SourceFile.Metadata.Category}.
   * @param id
   *        The ID of the {@link Genai.SourceFile.Metadata.Category}.
   * @param user
   *        The ID of the user who created the {@link Genai.SourceFile.Metadata.Category}.
   * @return The name of the {@link User} who created the {@link Genai.SourceFile.Metadata.Category}.
   */
  generateCreatedBy: function(id: !string, user: !string): string js-rhino

  /**
   * Function to obtain the number of {@link Genai.SourceFile}s that are associated with
   * the {@link Genai.SourceFile.Metadata.Tag} associated with the {@link Genai.SourceFile.Metadata.Category}.
   * @param id
   *        The ID of the {@link Genai.SourceFile.Metadata.Category}.
   * @return The number of {@link Genai.SourceFile}s that are associated.
   */
  getNumberOfDocuments: function(id: !string): !int js-rhino
}
