/**
 * Supported file formats for source file ingestion
 */
enum type Genai.SourceFileTypes {
  /**
   * C3doc markdown file
   */
  C3DOC_MD = "c3doc.md"

  /**
   * C3doc markdown file
   */
  C3DOC = "c3doc"

  /**
   * Markdown file
   */
  MD = "md"

  /**
   * Jupyter notebook
   */
  IPYNB = "ipynb"

  /**
   * PDF file
   */
  PDF = "pdf"

  /**
   * C3typ file
   */
  C3TYP = "c3typ"

  /**
   * DOC file
   */
  DOC = "doc"

  /**
   * DOCX file
   */
  DOCX = "docx"

  /**
   * HTML file
   */
  HTML = "html"

  /**
   * PPTX file
   */
  PPTX = "pptx"

  /**
   * TXT file
   */
  TXT = "txt"

  /**
   * RTF file
   */
  RTF = "rtf"

  /**
   * PNG file
   */
  PNG = "png"

  /**
   * JPEG file
   */
  JPEG = "jpeg"

  /**
   * JPG file
   */
  JPG = "jpg"

  /**
   * XLSX file
   */
  XLSX = "xlsx"
}
