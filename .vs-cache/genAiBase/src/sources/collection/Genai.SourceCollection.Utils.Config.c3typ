/**
 * Configuration for functionality inside {@link Genai.SourceCollection.Utils}.
 */
type Genai.SourceCollection.Utils.Config mixes Singleton, Config {
  /**
   * Amount of time to wait for the syncing {@link FileSystemBatchJob}s and
   * {@link ObjBatchMapReduceJob}s to finish before moving onto the indexing and
   * unindexing of files.
   */
  jobWaitDuration: !Duration = '20m'

  /**
   * Default {@link Genai.SourceCollection} for files uploaded on Documents Page.
   */
  defaultCollection: Genai.SourceCollection
}
