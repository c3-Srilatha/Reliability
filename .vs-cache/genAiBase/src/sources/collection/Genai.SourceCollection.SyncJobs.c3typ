/**
 * The jobs kicked off by the {@link Genai.SourceCollection#sync} API.
 */
type Genai.SourceCollection.SyncJobs {
  /**
   * The {@link BatchJob} which runs core syncing logic
   */
  fileSystemJob: !Genai.SourceFile.Job.EachFileBatchJob

  /**
   * The {@link ObjBatchMapReduceJob} which checks for original files
   * that no longer exist
   */
  objBatchJob: ObjBatchMapReduceJob
}
