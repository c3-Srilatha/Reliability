/**
 * A Genai.SourceCollection.Utils includes functionality applicable to {@link Genai.SourceCollection}s.
 */
type Genai.SourceCollection.Utils {
  /**
   * Sync all {@link Genai.SourceCollection}s.
   * @param spec
   *   Specification of which {@link Genai.SourceCollection}s to sync
   */
  sync: function(spec: FetchSpec, shouldProcess: boolean) js-rhino

  /**
   * Processes, chunks, and indexes all files from the @{link Genai.SourceCollection}s that were synced.
   */
  /*
   */
   // TODO: GENAI-2505 Use new updateIndex API
  processJob: private function(collections: ![Genai.SourceCollection]) js-rhino

  /**
   * Enable scheduled sync for all {@link Genai.SourceCollection}s.
   * By default the sync would run every day, unless the {@link Genai.SourceCollection.SyncSourceSpec} is updated.
   * @param spec
   *    Consists of {@link Genai.SourceCollection.SyncSourceSpec#cronExpression} to set the cadence for the schedule.
   */
  enableSync: function(spec: !Genai.SourceCollection.SyncSourceSpec): CronJob js-rhino

  /**
   * Disable scheduled sync for all {@link Genai.SourceCollection}s.
   */
  disableSync: function(): CronJob js-rhino

  /**
   * Enable/Disable scheduled sync for all {@link Genai.SourceCollection}s.
   */
  modifySyncSchedule: function(spec: !Genai.SourceCollection.SyncSourceSpec): CronJob js-rhino

  /**
   * Uploads {@link File}s to {@link Genai.SourceCollection#rootUrl}s or the
   * {@link Genai.SourceCollection.Utils.Config#defaultCollection} if none provided.
   *
   * If `transitionToChunking` is true, will transition the uploaded files to the `CHUNKING`
   * state.
   */
  upload: function(collectionWithFilesMap: ![Genai.SourceFile.UploadMapping], transitionToChunking: boolean): ![Genai.SourceFile] js-rhino
}
