/** {@link Spec} specifying the sync behaviour for the {@link Genai.SourceCollection}.  TODO: GENAI-760 Add fields specific for the sync schedule modal. */
type Genai.SourceCollection.SyncSourceSpec mixes Spec {
   /**
    * A Quartz cron expression {@link CronSchedule#cronExpression}
    */
   cronExpression: !string

   /**
    * Whether to enable/disable the sync schedule.
    */
   enable: boolean

   /**
    * Whether to automatically chunk and index after the cron job finishes syncing.
    */
   shouldProcess: boolean
}
