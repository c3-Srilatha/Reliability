// c3-analysis-disable c3-excessive-method-params -- functions must be refactored to use specs where possible

/**
 * Type that stores a graph representation of a whitelisted data model. Wraps around a native Python graph and provides methods
 * for generic graph operations and documentation generation.
 */
@db(unique="name")
@seed(userUpdatable=true)
entity type Genai.StructuredData.DataModelGraph mixes Named, SeedData schema name "DMG" {
    /**
     * Fields to ignore when constructing the graph.
     */
    fieldsToIgnore: set<string>

    /**
     * The {@link File} storing the serialized `networkx.DiGraph` object.
     */
    graphFile: File

    /**
     * The hash of the string written to #graphFile. Useful to track whether a cached version of the graph is stale.
     */
    graphHash: private string

    /**
     * Whether or not to include collection fields in the graph (default False).
     */
    includeCollectionFields: boolean = false

    /**
     * The number of unique example values for each field that will be cached and stored in the graph.
     * Note that this is a maximum, since there may be fewer unique values for a field.
     *
     * When #buildDataModelDocumentation is called, then
     *   - If nExampleStringValues is less than or equal to numExampleValues, then the cached values will be used.
     *   - If nExampleStringValues is greater than numExampleValues, then new unique values will be retrieved.
     *     Note that the cached values will not be updated. To do that, use #updateCachedValues.
     */
    numExampleValues: int = 0

    /**
     * Retrieves new unique example values for each field and updates the persisted #graphFile and this entity
     * accordingly.
     *
     * @return the updated graph obj
     */
    updateCachedValues: member function(): !Genai.StructuredData.DataModelGraph py-query_orchestrator

    /**
     * The whitelisted data model that this graph is constructed from. The format is:
     * ```
     * {"srcType" : {"fields" : ["field1", "field2", ...],
     *              "metrics" : ["Metric1", "Metric2", ...]}}
     * ```
     */
    whitelistedDataModel: json

    /**
     * Create the `networkx.DiGraph` object from the #whitelistedDataModel and serialize it to the #graphFile before
     * persisting the instance.
     */
    beforeCreate: ~ py-query_orchestrator

    /**
     * Create the `networkx.DiGraph` object from the #whitelistedDataModel and serialize it to the #graphFile after
     * persisting the instance.
     */
    @dependency(include="this")
    afterUpdate: ~ py-query_orchestrator

    /**
     * Delete the {@link File} containing the serialized `networkx.DiGraph` object before removing the instance.
     */
    beforeRemove: ~ py-query_orchestrator

    /**
     * Builds the documentation for the data model.
     *
     * @param excludeDocumentation
     *        Flag indicating whether Field and Type documentation should be excluded.
     * @param nExampleStringValues
     *        Number of example instances to include in the documentation for string fields.
     *        {@see numExampleValues}
     * @return The generated documentation as a string.
     */
    buildDataModelDocumentation: member function(excludeDocumentation: boolean, nExampleStringValues: int = 0): !string py-query_orchestrator

    /**
     * Builds the documentation for the data model, with a native networkx graph.
     *
     * @param graph
     *        Native networkx graph of the data model
     * @param excludeDocumentation
     *        Flag indicating whether Field and Type documentation should be excluded.
     * @param overrideDocs
     *        A dictionary that stores documents to override. See #overrideDocumentation for usage. The format is
     *        { TYPE_NAME: {doc: NEW_DOCSTRING,
     *                      metrics: {METRIC_NAME: NEW_DOCSTRING},
     *                      fields: {FIELD_NAME: NEW_DOCSTRING}}}
     * @param nExampleStringValues
     *        Number of example instances to include in the documentation for string fields.
     *        {@see numExampleValues}
     * @return The generated documentation as a string.
     */
    buildDataModelDocumentationFromNative: private function(
        graph: !native, excludeDocumentation: boolean, overrideDocs: json, nExampleStringValues: int = 0
    ): !string py-query_orchestrator

    /**
     * Finds the reachable fields from a source type within a depth limit.
     *
     * @param srcType
   *           The source type.
     * @param depthLimit
   *           The depth limit for traversal (default: 3).
     * @returns
     *    set: Collection of names for the Types that are within the depthLimit from the srcType in
     *         the graph.
     *    set: All valid projections found, they are returned in the format `TypeName:ProjectionName`
     *         specifying what Type the projection field belongs to so to avoid issues with duplicate
     *         field names. E.g. id will be a filed on multiple Types.
     */
    findReachableFields: member function(srcType: !string, depthLimit: int = 3): ![set<string>] py-query_orchestrator

    /**
     * Fetch the {@link Genai.StructuredData.DataModelGraph} with the given #name.
     * For the name "default", an 'empty' instance will be created, persisted, and returned if no graph
     * with that name existed beforehand. For all other names, no instance will be created if there is
     * no graph with the given name.
     *
     * @param name
   *           The name of the DataModelGraph instance.
     * @return The DataModelGraph instance.
     */
    forName: ~ py-query_orchestrator

    /**
     * Return the underlying native Python object (networkx.DiGraph) for the graph.
     * @return The native networkx.DiGraph object representing the graph.
     */
    toNative: member function(): !native py-query_orchestrator

    /**
    * Combine multiple {@link Genai.StructuredData.DataModelGraph}s into a single {@link Genai.StructuredData.DataModelGraph}.
    * The function merges(Unions) the #whitelistedDataModel model and #overrideDocumentation for the given
    * instances into one single instance.
    * The function merges(union of all) the given whitelistedDataModels inside the input DataModelGraphs while
    * uses the last documentation in the list of DataModelGraphs having the same type.
    *
    * @param dataModelGraphs
   *           The list of {@link Genai.StructuredData.DataModelGraph} instances to combine.
    * @param mergedDataModelName
   *           The name of the merged DataModelGraph after combining the input DataModelGraphs.
    * If not provided, then the current date-time string is used as a name.
    * @return the combined {@link Genai.StructuredData.DataModelGraph} instance.
    */
    combineDataModelGraphs: function(dataModelGraphs: ![Genai.StructuredData.DataModelGraph], mergedDataModelName: string): !Genai.StructuredData.DataModelGraph py-query_orchestrator

    /**
     * Visualizes the DataModelGraph.
     *
     * @param figsize
     *           Dimensions of the output visualization. Default is (30, 30)
     * @param drawKwargs
     *           Arguments passed to `networkx.draw`. Defaults are:
     *           ```{"font_size": 8, "node_size": 1000, "with_labels": True, "node_color": "lightsteelblue"}```
     * @return the {@link Image} for the visualization.
     */
    visualize: member function(figsize: DoublePair, drawKwargs: map<string, any>, spiralLayoutLwargs: map<string, any>): !Image py-query_orchestrator

    /**
     * Loads the metrics documentation vectorstore.
     * @param overwriteExisting
     *           Flag indicating if we want to overwrite the existing vectorstore if it alerady exists.
     * @return The native vectorstore.
     */
    loadMetricsDocumentationVectorStore: member function(overwriteExisting: boolean): !native py-query_orchestrator

    /**
     * Build data model documentation with metric definitions.
     * @param excludeDocumentation
   *           Binary flag indicating if Type and metric documentation should be included.
     * @param metricsByType
   *           Allows to generate the documentation from a json rather than similarity search, should contain a json with the following
     *      format:
     *       {
     *           "TypeName": [ "metric_name1", "metric_name2", ...]
     *       }
     * @param overrideDocs
   *           A dictionary that stores documents to override. See #overrideDocumentation for usage. The format is
     * { TYPE_NAME: {doc: NEW_DOCSTRING,
     *               metrics: {METRIC_NAME: NEW_DOCSTRING},
     *               fields: {FIELD_NAME: NEW_DOCSTRING}}}
     */
    buildDataModelWithMetricsDocFromJson: function(excludeDocumentation: boolean, metricsByType: json, overrideDocs: json): !string py-query_orchestrator

    /**
     * Build data model documentation with metric definitions.
     * Prior to building the documentation, it runs a similarity search on the metrics documentation vectorstore to
     * find the most relevant metrics. These will be included in the documentation.
     * @param query
     *           A query to perform the similarity search for metrics on.
     * @param nMetricsToRetrieve
     *           The maximum number of metrics to retrieve and include in the documentation. Only used when `metricsByType` is empty.
     * @param excludeDocumentation
     *           Binary flag indicating if Type and metric documentation should be included.
     * @param overrideDocs
     *           A dictionary that stores documents to override. See #overrideDocumentation for usage. The format is
     *               { TYPE_NAME: {doc: NEW_DOCSTRING,
     *               metrics: {METRIC_NAME: NEW_DOCSTRING},
     *               fields: {FIELD_NAME: NEW_DOCSTRING}}}
     */
    buildDataModelWithMetricsDocumentation: function(query: !string, nMetricsToRetrieve: int = 20, excludeDocumentation: boolean, overrideDocs: json): !string py-query_orchestrator

    /**
     * Override documentations for the data model. Note that this takes precedence over type/field meta.
     * If the types/fields are not in this, original type/field meta will be used.
     * The format is
     * { TYPE_NAME: {doc: NEW_DOCSTRING,
     *               metrics: {METRIC_NAME: NEW_DOCSTRING},
     *               fields: {FIELD_NAME: NEW_DOCSTRING}}}
     */
    overrideDocumentation: json

    /**
     * Returns a json of the form {TYPE_NAME: [FIELD NAMES]} with all types that have at least one whitelisted field
     * @param overrideDataModel
     *           If not passed, it use use #whitelistedDataModel
     */
    whiteListedFields: member function(overrideDataModel: json): json py-query_orchestrator

    /**
     * Returns a json of the form {TYPE_NAME: [FIELD NAMES]} with all types that have at least one whitelisted field
     * @param whitelistedDataModel
     *      The data model to get the whitelisted fields from.
     *      The format is:
     *      ```
     *      {"srcType" : {"fields" : ["field1", "field2", ...],
     *                    "metrics" : ["Metric1", "Metric2", ...]}}
     *      ```
     */
    whiteListedFieldsFromModel: private inline function(whitelistedDataModel: !json): json py-query_orchestrator

    /**
     * Returns a filter expression for querying {@link Genai.FewShotExample} using the whitelisted types for the graph.
     */
    filterForWhiteListedTypes: private inline member function(): !Filter py
}
