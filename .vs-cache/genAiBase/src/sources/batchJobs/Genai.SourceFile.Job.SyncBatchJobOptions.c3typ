/**
 * Used by {@link Genai.SourceFile.Job.SyncBatchJob} to supply the {@link Genai.SourceFile}s, {@link Genai.SourceFile.Chunker.UniversalChunker.Spec}
 */
type Genai.SourceFile.Job.SyncBatchJobOptions {
  /**
   * All {@link Genai.SourceFile}s to be synced belonging to the same collection.
   */
  sourceFiles: ![Genai.SourceFile]

  /**
   * Chunker to use during processing. If no chunker is provided, {@link Genai.SourceFile.Chunker.Universal} will be used as default.
   */
  chunkerSpec: Genai.SourceFile.Chunker.UniversalChunker.Spec

  /**
   * The {@link User#email} who last processed this source file.
   * This is used in {@link Genai.SourceFile#displayLastProcessedBy} to display the last processed activity in UI.
   * The entire {@link User} is not persisted to avoid access issues with ACLs.
   * The refresh could either be triggered manually or by the cron job.
   */
  lastProcessedBy: string
}
