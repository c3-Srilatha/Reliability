/**
 * Options for EachFileBatchJob, controlling which files are processed
 * per batch and which lambda to invoke on each batch.
 */
type Genai.SourceFile.Job.EachFileBatchJobOptions {

  /** Root URL of the collection to list files from. */
  collectionUrl: !string serialized FileUrl

  /** Number of files per batch. */
  batchSize: !int

  /** Partially-applied lambda invoked with each batch (Array<File>). */
  lambda: !Lambda<function(files: ![File])>
}
