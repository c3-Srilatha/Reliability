/**
 * A Genai.Tag.Category is an arbitrary string label that a user can
 * set on any {@link Genai.Tag}.
 */
extendable entity type Genai.Tag.Category mixes Genai.ProjectAware schema name 'TAG_CAT' {
  /**
   * The label of the category.
   */
  label: !string

  /**
   * The {@link Genai.Tag}s that belong to this category.
   */
  tags: [Genai.Tag](category)

  /**
   * The {@link User} that created this category.
   */
  createdBy: string calc generateCreatedBy(id, meta.createdBy)
}
