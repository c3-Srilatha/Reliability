/**
 * Used to get a {@link GenaiCore.Embedder} for embedding text such as queries or passages.
 */
type Genai.Embedder {
  /**
   * Get or create an embedder.
   *
   * @param spec
   *    the spec for the embedder to create.
   * @return the embedder to use for embedding text such as queries or passages.
   */
  getEmbedder: function(spec: !Genai.Embedder.Spec): !GenaiCore.Embedder py-query_orchestrator
}
