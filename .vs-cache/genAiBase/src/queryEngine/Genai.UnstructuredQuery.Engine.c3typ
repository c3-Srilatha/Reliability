/**
 * Genai.UnstructuredQuery.Engine handles queries for unstructured data. For each query, it will use the R(E)A -
 * Read (Extract) Answer - pipeline to determine similar passages from the {@link Genai.Retriever} that is configured
 * for the engine, then will issue the query to the LLM along with the similar passages for context, then will
 * post-process the result.
 *
 * To be able to serve queries with relatively low latency (under 10 seconds), all datasets must be downloaded and
 * and models loaded into memory before the query is received. To make that possible, the Genai.UnstructuredQuery.Engine
 * is an {@link Engine}, meaning that it has a persistent Python process in which it can maintain global state (the
 * loaded models) between serving users' queries.
 */
type Genai.UnstructuredQuery.Engine mixes Genai.Query.Handler,
  Engine<Genai.UnstructuredQuery.EngineDeployment, Genai.UnstructuredQuery.EngineDeploySpec>,
  Configurable<Genai.UnstructuredQuery.Engine.Config>, Genai.WithEngine,
  DefaultInstance {
  onEngineThreadStart: ~ py-query_orchestrator-server-py4j

  inst: ~ js-rhino

  query: ~ py-query_orchestrator-server-py4j
  chatQuery: ~ py-query_orchestrator-server-py4j
  streamChatQuery: ~ py-query_orchestrator-server-py4j

  /**
   * Retrieves the deployed Engine for the given
   * {@link Genai.UnstructuredQuery.Engine.Config}, or
   * deploys it if it has not yet been started.
   *
   * Declared in py so we don't need to initialize any specific runtime
   *
   * @param config
   *   The config for which to get or start an Engine.
   * @return the deployed Engine.
   */
  forConfig: function(config: !Genai.UnstructuredQuery.Engine.Config): mixing Genai.UnstructuredQuery.Engine js-rhino

  /**
   * Initialize the engine
   */
  initialize: member function(forceReload: boolean): !mixing Genai.UnstructuredQuery.Engine py-query_orchestrator-server-py4j

  /**
   * Returns whether the engine has been initialized.
   */
  isInitialized: private member function(): boolean py-query_orchestrator-server-py4j

  /**
   * Returns the {@link Genai.UnstructuredQuery.Engine.Config} with which the engine was initialized.
   */
  activeConfig: private member function(): Genai.UnstructuredQuery.Engine.Config py-query_orchestrator-server-py4j

 /**
  * Post processor function used internally to get rationale, sources, and persist relations.
  * Doesn't return anything. Adds attribution, rationale, sources to pipelineOutput and persists relations.
  *
  * @param pipelineOutput
  *     The REA PipelineOutput class.
  *
  * @param genAiResultToProcess
  *     The {@link Genai.Query.Result} to be further processed
  */
  processResults: private member function(pipelineOutput: !json, genAiResultToProcess: !Genai.Query.Result) py-query_orchestrator-server-py4j
}
