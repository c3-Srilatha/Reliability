/**
 * Defines the specs for the cretion of {@link Genai.UnstructuredQuery.Engine.ModelConfig}.
 */
type Genai.ModelConfigSpec mixes Spec {

  /**
   * The name of the model config.
   */
  name: !string

  /**
   * The credential provider of the API key.
   */
  credential: !json

  /**
   * Arguments to pass to the native LLM's interface.
   */
  llmKwargs: !json

}
