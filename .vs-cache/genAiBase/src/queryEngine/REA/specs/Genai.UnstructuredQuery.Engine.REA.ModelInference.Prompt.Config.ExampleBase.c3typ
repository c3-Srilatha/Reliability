/**
 * A default example that may be injected into the prompt config if the active
 */
type Genai.UnstructuredQuery.Engine.REA.ModelInference.Prompt.Config.ExampleBase {
  /**
   * The ID of the that uniquely identifies it. This ID will be provided by the UI.
   */
  id: string

  /**
   * An example question, including its English version and original user language (if not English) strings of {@link Genai.Translation.Values}.
   */
  questionValues: Genai.Translation.Values

  /**
   * The source passages and documents that the model should use to answer the example question.
   * Each includes its English version and original user language (if not English) strings of {@link Genai.Translation.Values}.
   */
  extractsValues: Genai.Translation.Values

  /**
   * The expected answer to the example question.
   * It includes its English version and original user language (if not English) strings of {@link Genai.Translation.Values}.
   */
  answerValues: Genai.Translation.Values
}
