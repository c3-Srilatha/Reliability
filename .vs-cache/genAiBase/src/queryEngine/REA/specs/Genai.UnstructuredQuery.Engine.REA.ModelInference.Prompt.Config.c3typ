/**
 * Config for the prompt used in {@link Genai.UnstructuredQuery.Engine.REA.ModelInferenceConfig}.
 */
@deprecated(finalVersion="7.0", details="Use Genai.Prompt instead.")
type Genai.UnstructuredQuery.Engine.REA.ModelInference.Prompt.Config mixes Genai.UnstructuredQuery.Prompt.Config {
  /**
   * The prompt template for querying the model.
   */
  promptTemplate: !string

  /**
   * A list of default examples that will be injected into the prompt config at `{{EXAMPLES}}. If examples _are_ provided
   * within the model configuration template, those will be injected instead and the default examples defined here will
   * not be used.
   */
  defaultExamples: [Genai.UnstructuredQuery.Engine.REA.ModelInference.Prompt.Config.ExampleBase]

  /**
   * A list of examples that will _always_ be injected into the prompt config at `{{EXAMPLES}}`.
   */
  staticExamples: [Genai.UnstructuredQuery.Engine.REA.ModelInference.Prompt.Config.ExampleBase]

  /**
   * The type of prompt creator {@link Genai.UnstructuredQuery.Engine.REA.ModelInference.Prompt.Creator} to use when generating the prompt. This will be used to format custom
	 * examples for the prompt that will be passed to the model.
   */
  promptCreatorType: !string serialized Type = "Genai.UnstructuredQuery.Engine.REA.ModelInference.Prompt.Creator"

  /**
   * Generates prompt template from default and static examples.
   */
  generatePromptTemplate: member function(): !string js-rhino
}
