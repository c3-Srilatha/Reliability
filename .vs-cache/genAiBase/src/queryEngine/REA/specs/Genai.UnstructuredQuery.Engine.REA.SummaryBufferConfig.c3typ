/**
 * Describes the config for setting up the summary buffer.
 */
type Genai.UnstructuredQuery.Engine.REA.SummaryBufferConfig mixes Genai.UnstructuredQuery.Engine.REA.SummaryConfig {

  /**
   * The number of last conversations to be stored in the buffer.
   */
  bufferSize: int = 2

  /**
   * The prompt to be used for the summary buffer for the conversation.
   */
  summaryBufferPrompt: !string

}
