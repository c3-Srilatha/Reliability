/**
 * Default implementation of the examples which are passed to the model.
 * This is set in the {@link Genai.UnstructuredQuery.Engine.REA.ModelInference.Prompt.Config#promptCreatorType} and
 * can be mixed to provide a custom implementation for the `generateExampleString` function.
 */
type Genai.UnstructuredQuery.Engine.REA.ModelInference.Prompt.Creator {
  /**
   * Generates an example string to be passed to the llm.
   *  @param example
   *           The example to generate a string for.
   *  @param idx
   *           The index of the example in the list of examples.
   * @return The example string.
   */
  generateExampleString: function(example: !Genai.UnstructuredQuery.Engine.REA.ModelInference.Prompt.Config.ExampleBase, idx: int): !string js-rhino
}
