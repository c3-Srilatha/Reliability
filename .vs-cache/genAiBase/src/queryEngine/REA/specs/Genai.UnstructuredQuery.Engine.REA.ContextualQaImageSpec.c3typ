/**
 * The image spec for the contextual QA.
 * This is passed in the {@link Genai.UnstructuredQuery.Engine.REA.ContextualQaConfig#createLlmMessagesLambda} lambda.
 */
type Genai.UnstructuredQuery.Engine.REA.ContextualQaImageSpec {
    /**
     * The id to be used for the citation.
     */
    citationId: !string

    /**
     * The native image to be encoded.
     */
    nativeImage: !native

    /**
     * The verabalized content of the image.
     */
    contentStr: !string
}
