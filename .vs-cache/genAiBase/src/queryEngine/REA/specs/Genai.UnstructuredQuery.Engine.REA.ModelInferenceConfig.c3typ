/**
 *  Defines the specification used for running inference.
 */
@deprecated(finalVersion='6.0', details='Use Genai.UnstructuredQuery.Engine.ModelConfig instead.')
type Genai.UnstructuredQuery.Engine.REA.ModelInferenceConfig mixes Named, Config, Genai.ParentConfig {
  /**
   * If using other than the default {@link Genai.Llm.ExternalLlm.Config} for this model,
   * specifies the name of the config to use.
   */
  llmConfigName: string

  /**
   * The name of the model to be used. May be a path to a local model, a huggingface model name,
   */
  modelName: !string

  /**
   * Get the user friendly name for the LLM instance. This will be used in the UI.
   */
  userFriendlyName: Genai.Llm.UserFriendlyName

  /**
   * The name of the {@link Genai.UnstructuredQuery.Engine.REA.ModelInference.Prompt.Config} that should be used.
   */
  promptConfigName: !string

  /**
   * The name of the tokenizer to be used. Default is None. May be a path to a local tokenizer or a
   * hugginface tokenizer. If not provided, model_name is used to specify the tokenizer.
   * Not used for API-based and hosted models.
   */
  tokenizerName: string

  /**
   * The max length of the input and generated sequence tokens. This is to be set based on model specifications.
   * (Only used for the non-API-based models).
   */
  contextLength: int =  4096

  /**
   * The secret endpoint of the Hosted VLLM, only used if llmType is set to VLLM.
   */
  @config(secret=true)
  vllmEndpoint: string

  /**
   * The model route for the model inference service (MIS) hosted models
   */
  route: string

  /**
   * The temperature variable used for increasing randomness of predictions for the rewriting model (only used for the
   * API-based models for controlling determinism). The default is 0.0 (fully deterministic).
   */
  temperature: float = 0.0

  /**
   * The maximum number of generated sequence.
   */
  maxOutputTokens: int = 512

  /**
   * The limit for #maxOutputTokens, so it is not set too large when #maxOutputTokens is modified by users.
   * Default is based on https://docs.anthropic.com/claude/docs/models-overview and
   * {@link https://learn.microsoft.com/en-us/answers/questions/1356487/what-is-the-exact-maximum-input-tokens-of-azure-gp,}
   * although Gemini's documentation states they support a larger token limit -
   * {@link https://cloud.google.com/vertex-ai/generative-ai/docs/model-reference/gemini}
   */
  maxOutputTokensLimit: int = 4096

  /**
   * The threshold for the probability mass, used by the Nucleus sampling, with default 0.9. If not
   * using Nucleus sampling, it is ignored.
   */
  topP: float = 0.9

  /**
   * The parameter used for the Top_k sampling approach with default set to 5. If not using Top_k sampling,
   * it is ignored.
   */
  topK: int = 5

  /**
   * Whether to use beam search instead of sampling. Default is set to False.
   */
  useBeamSearch: boolean

  /**
   * The number of beams used by Beam search sampling, default set to 5. If not using Beam search, it is ignored.
   */
  nBeams: int = 5

  /**
   * A list of strings that is used to stop model's text generation.
   * Default is None. This is used for the question answering model.
   */
  stopSequences: [string] = []

  /**
   * Float that penalizes sequences based on their length. Used in beam search. Default is 1.0.
   */
  lengthPenalty: float = 1.0

  /**
   * Controls the stopping condition for beam search. It accepts the following values:
   * `True`, where the generation stops as soon as there are `n_beams` complete candidates;
   * `False`, where a heuristic is applied and the generation stops when is it very unlikely to find better candidates
   */
  earlyStopping: boolean

  /**
   * presence_penalty [float]: Penalizes new tokens based on whether they appear in the generated text so far.
   * Values > 0 encourage the model to use new tokens, while values < 0 encourage the model to repeat tokens.
   * The default value is 0.0.
   */
  presencePenalty: float = 0.0

  /**
   * frequency_penalty [float]: Penalizes new tokens based on their frequency in the generated text so far.
   * Values > 0 encourage the model to use new tokens, while values < 0 encourage the model to repeat tokens.
   * The default value is 0.0.
   */
  frequencyPenalty: float = 0.0

  /**
   * Whether to have a streaming output. Default is set to False.
   */
  streamResponse: boolean

  /**
   * The timeout parameter
   */
  timeout: int = 300

  /**
   * When the prompt needs to be truncated to fit the context size, whether to remove the entire prompt
   * or trim it so that it fits given the number of available tokens.
   */
  truncatePromptTotally: boolean

  /**
   * The API version to be used for the LLM. Currently, only applicable for AWS Bedrock Claude 3 models.
   */
  apiVersion: string

  /**
   * The type of llm pipe to use.
   */
  llmType: !Genai.UnstructuredQuery.Engine.REA.LlmType

  /**
   * Configuration for how this will be shown as a UI drop-down option.
   */
  uiOptions: Genai.UnstructuredQuery.Engine.REA.ModelInferenceConfig.UiOptions
}
