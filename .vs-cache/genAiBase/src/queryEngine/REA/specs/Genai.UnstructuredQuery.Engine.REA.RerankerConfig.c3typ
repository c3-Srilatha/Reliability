/**
 * Defines the Reranker Config for REA.
 */
type Genai.UnstructuredQuery.Engine.REA.RerankerConfig mixes Named, Config, Genai.ParentConfig.WithModelConfig {
  /**
   * {@link Genai.UnstructuredQuery.Engine.ModelConfig} name
   */
  modelInferenceConfigName: !string

  /**
   * Omit all extracts with a score below this value. Currently, the prompt generates scores 0-10.
   */
  scoreThreshold: !double = 0

  /**
   * Omit all extracts that are ranked lower than this value.
   * Default is 0, which is interpreted as a request to skip truncation.
   *
   * Ex. if set to 5, then only the top 5 ranked extracts will be even considered for question answering.
   */
  rankThreshold: !int = 0
}
