/**
 Describes the config for setting up the REA pipeline.
 */
@deprecated(finalVersion='6.0', details='Use Genai.UnstructuredQuery.Engine.Config instead.')
type Genai.UnstructuredQuery.Engine.REA.PipelineConfig mixes DefaultInstance, Named, Config,
  Genai.UnstructuredQueryHandler.BaseParams, Genai.ParentConfig {
  /**
   * The Retriever config {@link Genai.UnstructuredQuery.Engine.REA.RetrieverConfig} name.
   */
  @deprecated(finalVersion='6.0', details='Use Genai.UnstructuredQuery.Engine.Config#retrieverConfigName instead.')
  retrieverConfigName: !string

  /**
   * The Extractor config {@link Genai.UnstructuredQuery.Engine.REA.ExtractorConfig} name.
   * If empty, the extractor step will be skipped.
   */
  @deprecated(finalVersion='6.0', details='Use Genai.UnstructuredQuery.Engine.Config#extractionConfigName instead.')
  extractionConfigName: string

  /**
   * The Reranker config {@link Genai.UnstructuredQuery.Engine.REA.RerankerConfig} name.
   * If empty, the reranking step will be skipped.
   */
  @deprecated(finalVersion='6.0', details='Use Genai.UnstructuredQuery.Engine.Config#rerankerConfigName instead.')
  rerankerConfigName: string

  /**
   * The {@link Genai.UnstructuredQuery.Engine.REA.ContextualQaConfig} name.
   */
  @deprecated(finalVersion='6.0', details='Use Genai.UnstructuredQuery.Engine.Config#questionAnsweringConfigName instead.')
  questionAnsweringConfigName: !string

  /**
   * The Question Answerer Config {@link Genai.UnstructuredQuery.Engine.REA.QuestionRewritingConfig} name.
   */
  @deprecated(finalVersion='6.0', details='Use Genai.UnstructuredQuery.Engine.Config#questionRewritingConfigName instead.')
  questionRewritingConfigName: !string

  /**
   * Whether to use the full history of chat in REA question answering.
   * By default, a new standalone question (with sufficient context) is created (re-written) based on the chat history and passed to the LLM.
   * If this is set to true, the full chat history can be passed to the LLM, along with the latest (non-rewritten) question.
   */
  @deprecated(finalVersion='6.0', details='Use Genai.UnstructuredQuery.Engine.Config#chatWithFullHistory instead.')
  chatWithFullHistory: boolean

  /**
   * Spec for {@link Genai.Agent.Tool.Util.Attributor#attribute}.
   * If not set, new attribution with corroboration will not run.
   */
  @deprecated(finalVersion='6.0', details='Use Genai.UnstructuredQuery.Engine.Config#attributionSpec instead.')
  attributionSpec: Genai.Agent.Tool.Util.Attributor.Spec

  /**
   * Whether to invoke the question answering model if all extracts are none or not.
   * If True we return "I am unable to answer your question" and will not invoke question answering. The default is False.
   */
  @deprecated(finalVersion='6.0', details='No longer supported')
  noPredictionsWithNoneExtracts: boolean

  /**
   * The maximum output tokens to be generated
   *  (only used for the API-based models for controlling cost). The default is 1000.
   */
  maxOutputTokens: int = 1000

  /**
   * The temperature variable used for increasing randomness of predictions o
   * (only used for the API-based models for controlling determinism). The default is 0 (fully deterministic).
   */
  temperature: double = 0

  /**
   * If adding metadata before running the extractor into the contexts from the {@link Genai.SourceFile.Metadata}, the format to use e.g. `{page_content} filename:{fileName}`. If `{page_content}` is omitted, it will be prepended when formatting the contexts.
   */
  @deprecated(finalVersion='6.0', details='No longer supported')
  extractorMetadataFormat: string

  /**
   * If adding metadata before running the reranker into the contexts from the {@link Genai.SourceFile.Metadata}, the format to use e.g. `{page_content} filename:{fileName}`. If `{page_content}` is omitted, it will be prepended when formatting the contexts.
   */
  @deprecated(finalVersion='6.0', details='No longer supported')
  rerankerMetadataFormat: string

  /**
   * Whether to extract and remove tags before using the contexts for contextual QA
   */
  @deprecated(finalVersion='6.0', details='No longer supported')
  contextualQARemoveTags: boolean

  /**
   * If adding metadata before running the contextual question answerer into the contexts from the {@link Genai.SourceFile.Metadata}, the format to use e.g. `{page_content} filename:{fileName}`. If `{page_content}` is omitted, it will be prepended when formatting the contexts.
   */
  @deprecated(finalVersion='6.0', details='No longer supported')
  contextualQAMetadataFormat: string

  /**
   * Configuration for {@link Engine.DeploySpec#threadPool} for {@link Genai.UnstructuredQuery.Engine}.
   * Any fields specified here will override the defaults.
   */
  @deprecated(finalVersion='6.0', details='Use Genai.UnstructuredQuery.Engine.Config#deploySpec instead.')
  engineThreadPoolSpec: App.Node.ThreadPool.Spec

  /**
   * For any response that is streamed, consider it failed after this many seconds.
   */
  @deprecated(finalVersion='6.0', details='Use Genai.UnstructuredQuery.Engine.Config#streamTimeoutSeconds instead.')
  streamTimeoutSeconds: int = 90

  inst: ~ js

  childConfigFields: ~ js
}
