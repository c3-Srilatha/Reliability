/**
 * Describes the config for setting up the buffer.
 */
type Genai.UnstructuredQuery.Engine.REA.BufferConfig mixes Named, Config {

  /**
   * The number of last question/anwer pairs to be stored in the buffer.
   */
  bufferSize: int = 2

  /**
   * The prefix to be used for the question.
   */
  questionPrefix: !string

  /**
   * The prefix to be used for the answer.
   */
  answerPrefix: !string

}
