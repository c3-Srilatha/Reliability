/**
 * All llm deployments (with and without langchain) supported by Genai
 */
enum type Genai.Llm.Deployment {

    /** Azure OpenAI via Langchain */
    LangchainWrappedAzureOpenAI = "Genai.Llm.LangchainWrappedAzureOpenAI"

    /** Google Cloud Platform */
    Gcp = "Genai.Llm.Gcp"

    /** Azure OpenAI */
    AzureOpenAI = "Genai.Llm.AzureOpenAI"

    /** AWS Bedrock */
    AwsBedrock = "Genai.Llm.AwsBedrock"

    /** VLLM */
    VLLM = "Genai.Llm.Vllm"

    /** MIS */
    C3ModelInference = "Genai.Llm.C3ModelInference"
}
