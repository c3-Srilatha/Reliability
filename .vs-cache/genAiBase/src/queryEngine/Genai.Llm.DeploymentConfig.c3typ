/**
 * Provides configuration for {@link Genai.Llm} deployments.
 */
type Genai.Llm.DeploymentConfig mixes Named, Config, Genai.WithDeploySpec  {
  /**
   * Configuration for {@link Engine.DeploySpec#threadPool} for {@link Genai.Llm}.
   * Any fields specified here will override the defaults.
   */
  @deprecated(finalVersion='6.0', details='Use `deploySpec` instead.')
  engineThreadPoolSpec: App.Node.ThreadPool.Spec

  /**
   * Given the name of the {@link Genai.Llm} returns the key for its deployment config
   */
  getDeploymentConfigKey: function(typeName: !string): !string js-rhino
}
