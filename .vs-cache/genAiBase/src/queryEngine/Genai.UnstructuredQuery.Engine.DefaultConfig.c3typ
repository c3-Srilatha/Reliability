/**
 * Configuration to specify which {@link Genai.UnstructuredQuery.Engine.Config} should be used by the application.
 */
type Genai.UnstructuredQuery.Engine.DefaultConfig mixes Singleton, Config {

  /**
   * The name of the {@link Genai.UnstructuredQuery.Engine.Config} to use, for example, "default".
   */
  queryEngineConfigName: !string
}
