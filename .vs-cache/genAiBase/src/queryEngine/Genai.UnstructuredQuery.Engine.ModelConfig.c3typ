/**
 * Config for how {@link Genai.UnstructuredQuery.Engine} should use the llm model.
 */
@config(doNotDefaultIfMissing=true)
type Genai.UnstructuredQuery.Engine.ModelConfig mixes Named, Config {
  /**
   * Get the user friendly name for the LLM instance. This will be used in the UI.
   */
  userFriendlyName: Genai.Llm.UserFriendlyName

  /**
   * The name of the deployment to use for the llm model.
   */
  llmDeployment: !Genai.Llm.Deployment = Genai.Llm.Deployment.LangchainWrappedAzureOpenAI

  /**
   * The {@link Genai.Prompt} that can be used to generate prompts for the LLM.
   */
  prompt: Genai.Prompt

  /**
   * The type of LLM being used.
   */
  llmType: Genai.UnstructuredQuery.Engine.REA.LlmType

  /**
   * Keyword arguments to pass to the native LLM's interface.
   * Look at azureGpt35.json for an example.
   */
  llmKwargs: !json

  /**
   * Configuration for how this will be shown as a UI drop-down option
   */
  uiOptions: Genai.UnstructuredQuery.Engine.REA.ModelInferenceConfig.UiOptions

  /**
   * Generate text from the LLM instance according to the config's specification.
   *
   * @param llmInput
   *          Keyword arguments to pass to the model's interface. Either "prompt" or "messages" is expected to be one of the keys in llmInput.
   *          The "prompt" can be of type string or {@link Genai.Prompt}. The "messages" are expected to be list of json objects.
   *
   * @return the output from {@link Genai.Llm#generateResponse}.
   *         Is a generator if streaming is enabled, string otherwise.
   */
  generateText: member function(llmInput: !map<any, any>): !any py-llmguard

  /**
   * Generate text from the LLM instance according to the config's specification.
   *
   * @param llmInput
   *           Keyword arguments to pass to the model's interface.
   *
   * @return the {@link Genai.Llm.BatchRequestJob} from {@link Genai.Llm#generateResponseBatch}.
   */
  generateTextBatch: member function(llmInput: !map<any, any>): !Genai.Llm.BatchRequestJob py-llmguard

  /**
    * Suffix to append to configuration names for selecting the corresponding model.
    * Example: 'qa_inference_config' + '_gpt4o' (where '_gpt4o' is the configSuffix).
    * For new models, ensure that corresponding configurations for question-answering, question-rewriting, etc. are added with the config suffix.
    */
  configSuffix: string

  /**
   * Fetches data from unstructured query engine model configs.
   * @param spec
   *   The specification for the fetch.
   * @return
   *   The result of the fetch.
   */
  fetch: function(spec: FetchSpec): json js-rhino

  /**
   * Fetches data from unstructured query engine model configs and returns the count of the number of items fetched.
   * @param spec
   *   The specification for the fetch.
   * @return
   *   The count of the number of items fetched.
   */
  fetchCount: function(spec: FetchSpec): int js-rhino

  /**
   * Delete the config
   * @param credential
   *   The name of the config to delete.
   * @return
   *   The result of the delete operation.
   */
  deleteConfig: function(credential: !string): !Genai.Llm.ExternalLlm.DeleteResult js-rhino

  /**
   * function to create or update {@link Genai.UnstructuredQuery.Engine.ModelConfig} from a spec.
   * @param spec
   *   The {@link Genai.ModelConfigSpec} to create the model config.
   */
  setFromSpec: function(spec: !Genai.ModelConfigSpec, overwrite: boolean): string js-rhino

  /**
   * Function to convert {@link Genai.UnstructuredQuery.Engine.ModelConfig} llmKwargs to a liteLlmKwargs format.
   * @param deployment
   *   The deployment to use for processing the llmKwargs.
   * @param llmKwargs
   *   The llmKwargs to process.
   * @return the processed llmKwargs in liteLlmKwargs format.
   */
  processLlmKwargs: private function(deployment: string enum Genai.Llm.Deployment, llmKwargs: !json): !json js-rhino

  /**
   * Function to convert {@link Genai.UnstructuredQuery.Engine.ModelConfig} to a {@link GenaiCore.Llm.Completion.Client}.
   */
  modelConfigToCompletionClient: member function() js-rhino
}
