/**
 * Alerting functions to notify the user when a process fails or gets stuck.
 * Required {@link SendGridApi} to execute functions
 * eg)
 * var token = <'tokenNumber'>;
 *
 * SendGridApi.setApiUrlAndAuth(
 *   'https://api.sendgrid.com/v3',
 *   'Bearer ' + token,
 *    ConfigOverride.APP);
 */
type Genai.Alert {
  /**
   * Sends the submitted message as an alert {@link Genai.Mail} to configured end users, when {@link  Genai.Retriever.IndexAction#monitorLongRunningIndexAction} fails
   * @param logString
   *           Log string with the {@link  Genai.Retriever.IndexAction#monitorLongRunningIndexAction} information
   */
  alertLongRunningIndexAction: function(logString: !string): Mail js

  /**
   * Sends an error message as an alert {@link Genai.Mail} to configured end users, when the inputed indexPassages function fails
   * @param logString
   *           Log string with the {@link Genai.Retriever.IndexAction} that failed
   */
  alertFailedIndexAction: function(logString: !string): Mail js-rhino

  /**
   * Sends an error message as an alert {@link Genai.Mail} to configured end users, when the inputed {@link Genai.Query.Handler#doChatQuery} failed
   * @param logString
   *           Log string with the {@link Genai.Query.Handler} that failed
   * @param logError
   *           Log Error from the {@link Genai.Query.Handler} that failed
   */
  alertFailedQuery: function(logString: !json, logError: !json): Mail js-rhino
}
