/**
* Configuration for the Azure Content Moderation.
*/
type Genai.LlmGuardrails.Processor.AzureContentModeration.Config mixes Config, Singleton {

  /**
   * The authentication key for the Azure Moderation API.
   */
  @config(secret=true)
  apiKey: !string

  /**
   * The endpoint for Azure Moderation API.
   * Note: The endPoint ends with `/`. Example: https://<<endPoint>>.azure.com/ rather than https://<<endPoint>>.azure.com.
   */
  endPoint: !string

  /**
   * The region for Azure Moderation API.
   */
  region: !string

  /**
   * The API version for Azure Moderation API.
   */
  apiVersion: !string = '2024-09-01'
}
