/**
 * Note: The {@link Genai.LlmGuardrails.Processor.AzurePromptShield} guardrail is currently in beta and is not recommended for production use.
 * An input processor guardrail for performing prompt shielding from (jailbreaks and injections) through Azure Content Moderation API
 * {@link https://learn.microsoft.com/en-us/azure/ai-services/content-safety/quickstart-jailbreak}
 */
@beta
type Genai.LlmGuardrails.Processor.AzurePromptShield mixes Genai.LlmGuardrails.Processor {

  initialize: ~ py-llmguard
  processInput: ~ py-llmguard

}
