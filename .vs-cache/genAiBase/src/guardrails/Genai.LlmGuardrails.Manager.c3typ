/**
 * Manages {@link Genai.LlmGuardrails.Processor}s and applies them to
 * all LLM input and output.
 */
type Genai.LlmGuardrails.Manager mixes Singleton, Config {
  /**
   * All processors to apply in order to the input.
   */
  inputProcessors: [Genai.LlmGuardrails.Processor]

  /**
   * All processors to apply in order to the output.
   */
  outputProcessors: [Genai.LlmGuardrails.Processor]

  /**
   * Initialize all processors in #inputProcessors and #outputProcessors.
   * @param forceReload
   *           If true, will re-initialize.
   */
  initialize: member function(forceReload: boolean) py-llmguard

  /**
   * Processes an LLM prompt applying all #inputProcessors in order.
   *
   * @param inputPrompt
   *   The LLM input to process.
   * @return the processed LLM input.
   */
  processInput: member function(inputPrompt: !Genai.Prompt): !Genai.LlmGuardrails.Processor.Result py-llmguard

  /**
   * Processes an LLM response applying all #inputProcessors in order.
   *
   * @param outputPrompt
   *   The LLM output to process.
   * @return the processed LLM output.
   */
  processOutput: member function(outputPrompt: !string): !Genai.LlmGuardrails.Processor.Result py-llmguard
}
