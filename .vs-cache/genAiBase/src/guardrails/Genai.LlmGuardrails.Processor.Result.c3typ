/**
 * The output of a {@link Genai.LlmGuardrails.Processor#processInput} or
 * {@link Genai.LlmGuardrails.Processor#processOutput} call.
 */
type Genai.LlmGuardrails.Processor.Result {
  /**
   * The value that was supplied before any Processors were applied
   */
  originalValue: !Genai.Prompt

  /**
   * The value being processed by the processor.
   */
  currentValue: !Genai.Prompt

  /**
   * The value after processing.
   */
  updatedValue: !Genai.Prompt
}
