/**
 * Base type for prompts passed to LLMs
 */
extendable entity type Genai.Prompt mixes StringSerializable, PyReprProtocol schema name "GAIPRMPT" {
  /**
   * Description for the prompt containing information on how and when it should be used.
   */
  description: string

  /**
   * Reads the input file's string and parses its content.
   */
  fromFile: function(file: !File): !Genai.Prompt py

  /**
   * The string representation of the prompt, where parameters are not yet set. Parameters are conventionally
   * signalled with double brackets, i.e. {{parameter}}. If such parameters are in the input `template`,
   * they will be used as keys to #parameters.
   */
  rawTemplate: string

  /**
   * The file where the prompt is defined.
   */
  templateFile: File

  /**
   * This prompt's parameters. Parameters can be accessed with #params, set with #setParam and #setParams, reset
   * with #resetParams or renamed with #renameParam and #renameParams.
   */
  parameters: private json

  /**
   * Allows access to this prompt's parameters in an attribute-like syntax. Returns a native dictionary.
   */
  params: inline property(): !?native py

  /**
   * Sets the specified parameter with the specified value.
   */
  setParam: member function(name: !string, value: !string | json): !Genai.Prompt py

  /**
   * Sets the specified parameters with the specified values.
   */
  setParams: member function(params: !json): !Genai.Prompt py

  /**
   * Reset all values for the specified `params` in #parameters to null.
   */
  resetParams: member function(params: ![string]): !Genai.Prompt py

  /**
   * Rename the specified parameter with the specified new name.
   */
  renameParam: member function(oldName: !string, newName: !string): !Genai.Prompt py

  /**
   * Rename the specified parameters with the specified new names.
   */
  renameParams: member function(names: !json): !Genai.Prompt py

  /**
   * "Flatten" this prompt, i.e. replace all set parameters with their values. Only unset parameters will be
   * referenced in the returned prompt's parameters.
   */
  flatten: member function(): !Genai.Prompt py

  /**
   * This prompt's status:
   * - "INITIAL" if no parameter is set
   * - "COMPLETE" if all parameters are set
   * - "PARTIAL" otherwise
   */
  status: property(): !string enum("INITIAL", "PARTIAL", "COMPLETE") py

  /**
   * Instantiates a prompt from a string. Identifies parameters in the input template string, with the convention that
   * they are prefixed and suffixed by double brackets, e.g. {{param_name}}.
   */
  fromString: ~ py

  /**
   * Returns this prompt's flattened template.
   */
  toString: ~ py

  // reclaimed to show #toString as the default repr
  _repr_: ~ py

  /**
   * A list of default examples that will be injected into the prompt config at `{{EXAMPLES}}. If examples _are_ provided
   * within the model configuration template, those will be injected instead and the default examples defined here will
   * not be used.
   */
  defaultExamples: [Genai.UnstructuredQuery.Engine.REA.ModelInference.Prompt.Config.ExampleBase]

  /**
   * A list of examples that will _always_ be injected into the prompt config at `{{EXAMPLES}}`.
   */
  staticExamples: [Genai.UnstructuredQuery.Engine.REA.ModelInference.Prompt.Config.ExampleBase]

  /**
   * The type of prompt creator {@link Genai.UnstructuredQuery.Engine.REA.ModelInference.Prompt.Creator} to use when generating the prompt. This will be used to format custom
	 * examples for the prompt that will be passed to the model.
   */
  promptCreatorType: !string serialized Type = "Genai.UnstructuredQuery.Engine.REA.ModelInference.Prompt.Creator"

  /**
   * Generates prompt template from default and static examples.
   */
  generatePromptTemplate: member function(): !string js-rhino

  /**
   * Converts the prompt to a c3agents `PromptTemplate`.
   */
  toC3AgentsPromptTemplate: member function(): native py
}
