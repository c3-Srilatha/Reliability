/**
 * A data feature (metrics, ML features, etc.) with its embedding defined in pgvector.
 */
@db(index=[{fields:[{name: emb, opClass: COSINE}], neighborsCount: 16, efConstruction: 40}])
entity type Genai.DbFeature schema name "DFE" {
  /**
   * The name of the feature.
   */
  name: !string

  /**
   * The description of the feature.
   */
  description: string

  /**
   * An embedding of the feature representation.
   */
  @vector(dimension=1024)
  emb: string

}
