/**
 * A data sample with its embedding defined in pgvector.
 */
@db(index=[{fields:[{name: emb, opClass: COSINE}], neighborsCount: 16, efConstruction: 40}])
entity type Genai.FieldValueData schema name "FVD" {
  /**
   * The source type of the value.
   */
  sourceType: !string

  /**
   * The field name of the value.
   */
  fieldName: !string

  /**
   * The string representation of the data value.
   */
  dataValue: !string

  /**
   * The text content used to generate the embedding.
   */
  content: string

  /**
   * An embedding of the data value representation.
   */
  @vector(dimension=1024)
  emb: string

}
