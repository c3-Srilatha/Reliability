/**
 * Persists the EvalSpec, EvaluateSpec, or EvalMetricSpec for a given query.
 */
type Genai.StructuredQuery.Spec {
  /**
   * The source type used for evaluating the #spec.
   */
  sourceType: !Type

  /**
   * The EvalSpec, EvaluateSpec, or EvalMetricSpec for the query.
   */
  spec: !any //(EvalSpec | EvaluateSpec | EvalMetricsSpec) TODO: PLAT-71456 restore the anyof instead of any

  /**
   * Execute the #spec and return the resulting Data
   */
  execute: member function(): !Data py
}
