/**
 * Enum for {@link Genai.Query.Result.Source.AttributionSourceFields#corroborationIndicator},
 * representing the corroboration relationship shown on UI.
 */
enum type Genai.Agent.Tool.Util.Corroborator.Indicator {
  /**
   * Source corroboration entails the answer segment.
   */
  SUPPORTS = "Supports"

  /**
   * Source corroboration does not entail or contradict the answer segment, giving a neutral signal.
   */
  NEUTRAL = "Neutral"

  /**
   * Source corroboration contradicts with the answer segment.
   */
  CONTRADICTORY = "Contradictory"
}
