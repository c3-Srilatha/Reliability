/**
 * A helper tool to retrieve few-shot examples for a given query.
 */
type Genai.Agent.Tool.Util.FewShotRetriever {

  /**
   * The base prompt to fill in with the retrieved examples.
   */
  templatePrompt: !Genai.Prompt

  /**
   * Performs similarity search between the given query and all currently persisted examples, returning the top `nExamples`.
   *
   * @param spec The query for which to retrieve examples.
   * @return The {@link Genai.FewShotExample}s that are most similar to the given query.
   */
  similaritySearch: function(spec: !Genai.Agent.Tool.Util.FewShotRetriever.SimilaritySearchSpec): ![Genai.FewShotExample] py-query_orchestrator

  /**
   * Retrieves few-shot examples for the given query and constructs the new prompt.
   *
   * @param similaritySearchSpec The spec to use for the similarity search to get the few-shot examples for the prompt.
   * @return The prompt constructed from the few-shot examples.
   */
  buildPromptFromExamples: member function(
    similaritySearchSpec: !Genai.Agent.Tool.Util.FewShotRetriever.SimilaritySearchSpec
  ): !Genai.Prompt py-query_orchestrator

  /**
   * Deploys an embedding engine to be used for few shot retrieval.
   * @return the embedder.
   */
  getEmbedder: function(): !GenaiCore.Embedder py
}
