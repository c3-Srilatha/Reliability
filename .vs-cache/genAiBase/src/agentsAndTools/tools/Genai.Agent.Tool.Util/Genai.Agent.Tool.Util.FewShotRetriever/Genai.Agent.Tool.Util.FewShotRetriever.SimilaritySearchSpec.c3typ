/**
 * Spec used for {@link Genai.Agent.Tool.Util.FewShotRetriever#similaritySearch} calls.
 */
type Genai.Agent.Tool.Util.FewShotRetriever.SimilaritySearchSpec mixes Spec {

  /**
   * The query for which to retrieve examples.
   */
  query: !string

  /**
   * The maximum number of examples to retrieve.
   */
  nExamples: !int

  /**
   * The type of example to retrieve. It needs to be a mixin of {@link Genai.FewShotExample}
   */
  exampleTypeName: !string

  /**
   * A pre-retrieval filter to apply to the examples, passed directly as a {@link Filter} to the entity type containing the examples.
   */
  subjectFilter: Filter

  /**
   * Specifies which fields to bring back values for in the returned Obj instances. Same as {@link FetchSpec#include}
   */
  include: string

  /**
   * Specifies the minimum vector distance allowed for similarity search. If set to 0, then exact matches to #query are allowed.
   * Notice the few-shot retriever uses cosine distance to calculate vector dissimilarity (ranges from 0 to 2).
   */
  minVectorDistance: double

  /**
   * Specifies the maximum vector distance allowed for similarity search. The greater this value is, the higher
   * dissimilarity from #query is allowed. It's usually recommended to set a lower maxVectorDistance to ensure the retrieved
   * examples are relevant enough to the context.
   * Notice the few-shot retriever uses cosine distance to calculate vector dissimilarity (ranges from 0 to 2).
   */
  maxVectorDistance: double
}
