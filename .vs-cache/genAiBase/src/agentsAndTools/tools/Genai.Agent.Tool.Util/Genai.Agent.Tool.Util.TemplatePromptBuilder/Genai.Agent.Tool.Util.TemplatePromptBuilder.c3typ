// c3-analysis-disable c3-excessive-method-params -- functions must be refactored to use specs where possible

/**
 * Type to build template {@link Genai.Prompt}
 */
// TODO: GENAI-4469 Add buildLambda function to allow user override
type Genai.Agent.Tool.Util.TemplatePromptBuilder mixes Identified {
  /**
   * Type of the builder. This controls the behavior of the builder for different tools
   */
   // TODO: GENAI-4640 Make Genai.Agent.Tool.Util.TemplatePromptBuilder common accross EvalQuery and EvalMetricsQuery
   builderType: !string enum("EvalQuery", "EvalMetrics")

  /**
   * Builder function that returns an updated {@link Genai.Prompt}
   * @param templatePrompt
   *           a Genai.Prompt object with template to be built
   * @param graph
   *           a networkx.Graph
   * @param generationSpec
   *           spec for the template builder
   * @param overrideDocs
   *           a dictionary that contains overriding documentation
   */
   buildPrompt: member function(templatePrompt: !Genai.Prompt, graph: !native, generationSpec: Spec, overrideDocs: json): !Genai.Prompt py-query_orchestrator
}
