/**
 * A helper tool for generating suggested follow-up queries.
 */
type Genai.Agent.Tool.Util.SuggestedFollowUpQueries {

  /**
   * Generates a list of suggested follow-up queries based on the in-progress query result.
   *
   * @param spec
   *           The {@link Genai.Agent.Tool.Util.SuggestedFollowUpQueries.Spec} to generate the suggested queries.
   *
   * @return result containing the suggested queries.
   */
  generateSuggestedQueries: function(spec: !Genai.Agent.Tool.Util.SuggestedFollowUpQueries.Spec): !Genai.Query.Result py-query_orchestrator

}
