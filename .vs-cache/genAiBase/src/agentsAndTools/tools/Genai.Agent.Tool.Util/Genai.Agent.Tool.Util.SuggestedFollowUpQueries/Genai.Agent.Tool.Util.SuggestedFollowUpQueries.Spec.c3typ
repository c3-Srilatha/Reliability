/**
 * Spec of the SuggestedFollowUpQueries to generate follow-up queries based on the inProgressResult.
 */

type Genai.Agent.Tool.Util.SuggestedFollowUpQueries.Spec mixes Spec {

  /**
   * The {@link Genai.Agent.Tool.Util.FewShotRetriever} that should be used.
   */
  retriever: !Genai.Agent.Tool.Util.FewShotRetriever

  /**
   * The rewriter that that generates the follow-up queries.
   */
  rewriter: !native

  /**
   * The {@link Genai.Query.Result} that contains the most recent query.
   */
  inProgressResult: !Genai.Query.Result

  /**
   * The {@link Genai.SuggestedFollowUpQueriesConfig} for setting up the SuggestedFollowUpQueries.
   */
  config: !Genai.SuggestedFollowUpQueriesConfig

}
