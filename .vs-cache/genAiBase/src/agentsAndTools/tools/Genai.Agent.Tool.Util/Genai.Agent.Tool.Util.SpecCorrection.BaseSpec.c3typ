/**
 * Base Spec to be used in ReflexionAgent for correcting the spec.
 * It's used in {@link Genai.Agent.Tool.StructuredDataQuery.Base#generateSpec} and
 * {@link Genai.Agent.Tool.StructuredDataQuery.Base#processSpec}.
 */
type Genai.Agent.Tool.Util.SpecCorrection.BaseSpec mixes Spec {
  /**
   * If it's zero, the agent will not retry the target function.
   * If it's not zero, the failure of target function will initiate correcting the spec by LLM.
   * And it keeps retrying the correction and executing the target function until executing successfully
   * or reaching either this retry max or the #retryTimeoutSec.
   */
  retryMax: int = 1

  /**
   * When the retry was initiated, the agent will retry to execute and correct the spec until
   * executing successfully or reaching either the #retryMax or this timeout.
   *
   * NOTE: this time does not include the initial attempt.
   */
  retryTimeoutSec: int = 30

  /**
   * The prompt used to correct the eval spec during the retry process.
   */
  promptTemplateReflexionAgent: Genai.Prompt = "reflexion_agent_spec_correction_default_prompt"

  /**
   * The LLM model used to answer the question. Must correspond to a {@link Genai.UnstructuredQuery.Engine.ModelConfig}.
   */
  llmModelNameReflexionAgent: string = "azureGpt4"
}
