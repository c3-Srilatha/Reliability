/**
 * Spec for {@link Genai.Agent.Tool.Util#processSpec}
 */
type Genai.Agent.Tool.Util.ProcessSpec mixes Genai.Agent.Tool.Util.TableFromSpecSpec {

  /**
   * The input query for which the {@link Genai.StructuredQuery.Spec} is processed
   */
  input: !string

  /**
   * {@link Genai.Agent.Tool.Util.TableAnsweringModel.Spec} representing the arguments used in {@link Genai.Agent.Tool.Util.TableAnsweringModel}
   */
  tableAnsweringModelSpec: !Genai.Agent.Tool.Util.TableAnsweringModel.Spec

  /**
   * The native {@link Genai.StructuredData.DataModelGraph} used in table answering
   */
  nativeDataModelGraph: native

  /**
   * Whether Llm should be used in generating a natural language answer to the input query
   */
  doNotUseLlm: boolean

  /**
   * Whether the LLM response should be streamed. Is ignored if #doNotUseLlm is True.
   */
  streamResponse: boolean

  /**
   * Whether to attempt to answer the input query at all (as opposed to just executing the spec and generating a visualization)
   */
  doNotAnswer: boolean

  /**
   * The {@link Genai.Agent.Tool} used to process the spec
   */
  toolId: string
}
