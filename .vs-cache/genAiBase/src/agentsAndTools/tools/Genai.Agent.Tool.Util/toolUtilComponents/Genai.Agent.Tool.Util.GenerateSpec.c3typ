/**
 * Spec for {@link Genai.Agent.Tool.Util#generateSpec}
 */
type Genai.Agent.Tool.Util.GenerateSpec mixes Spec {
  /**
   * The input query for which the {@link Genai.StructuredQuery.Spec} is generated
   */
  input: !string

  /**
   * The {@link Genai.StructuredData.DataModelGraph} representing the data model
   */
  dataModelGraph: !Genai.StructuredData.DataModelGraph

  /**
   * The {@link Genai.Agent.Tool.Util.EvalQuery.SpecGenerationModel} used for spec generation
   */
  specGenerationType: !Type

  /**
   * {@link Genai.Agent.Tool.Util.EvalQuery.SpecGenerationModel.Spec} containing the relevant arguments for the spec generation
   */
  specGenerationSpec: !Genai.Agent.Tool.Util.EvalQuery.SpecGenerationModel.Spec

  /**
   * {@link Genai.Agent.Tool.Util.StringFuzzyMatcher} used to do the fuzzy matching if fuzzy matching is enabled.
   */
  fuzzyMatcher: Genai.Agent.Tool.Util.StringFuzzyMatcher
}
