/**
 * Output from {@link Genai.Agent.Tool.Util#processSpec}.
 */
type Genai.Agent.Tool.Util.ProcessSpec.Output {

  /**
   * Answer returned from table answering model.
   */
  answer: any

  /**
   * Visualization created using output of spec processor.
   */
  visualization: GenAiVisualizationBase

  /**
   * The {@link Genai.StructuredQuery.Spec} after the spec is processed
   */
  structuredQuerySpec: Genai.StructuredQuery.Spec

  /**
   * Pandas DataFrame generated by executing the validated spec.
   */
  table: native
}
