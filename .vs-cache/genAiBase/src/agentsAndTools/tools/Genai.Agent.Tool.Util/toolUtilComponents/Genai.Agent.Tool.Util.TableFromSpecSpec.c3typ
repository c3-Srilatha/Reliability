/**
 * Spec for {@link Genai.Agent.Tool.Util#tableFromSpecSpec}
 */
type Genai.Agent.Tool.Util.TableFromSpecSpec mixes Spec {
  /**
   * The {@link Genai.Agent.Tool.Util.EvalQuery.SpecProcessor} used to process the spec
   */
  specProcessorType: !Type

  /**
   * The {@link Genai.StructuredQuery.Spec} to execute
   */
  structuredQuerySpec: !Genai.StructuredQuery.Spec

  /**
   * The {@link Genai.StructuredData.DataModelGraph} that stores a graph representation of a whitelisted data model
   */
  dataModelGraph: !Genai.StructuredData.DataModelGraph

  /**
   * The {@link Genai.Agent.Tool.Util.EvalQuery.SpecProcessor.Spec} used by specProcessorType to execute the structuredQuerySpec
   */
  specProcessorSpec: Genai.Agent.Tool.Util.EvalQuery.SpecProcessor.Spec
}
