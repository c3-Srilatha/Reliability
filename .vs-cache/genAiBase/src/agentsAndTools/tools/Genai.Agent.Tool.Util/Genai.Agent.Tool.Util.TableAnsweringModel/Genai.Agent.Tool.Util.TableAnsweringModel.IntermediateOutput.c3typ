/**
 * A type to save the output for {@link Genai.Agent.Tool.Util.TableAnsweringModel#summarizeTable}.
 */
type Genai.Agent.Tool.Util.TableAnsweringModel.IntermediateOutput {

  /**
   * A pandas.DataFrame table after processing.
   * It is the input of {@link Genai.Agent.Tool.Util.TableAnsweringModel#verbalizeTable}.
   */
  processedTable: !native

  /**
   * A tuple that is the dimension / shape of the table, i.e., (row count, column count).
   * It is the input of {@link Genai.Agent.Tool.Util.TableAnsweringModel#verbalizeTable}.
   */
  tableDimension: native

  /**
   * A pandas.DataFrame table that has the summary statistics
   * It is the input of {@link Genai.Agent.Tool.Util.TableAnsweringModel#verbalizeTable}.
   */
  summaryTable: !native
}
