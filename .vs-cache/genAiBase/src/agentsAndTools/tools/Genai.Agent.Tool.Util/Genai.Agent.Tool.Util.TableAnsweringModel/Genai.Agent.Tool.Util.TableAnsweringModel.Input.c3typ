/**
 * A type to save the input for {@link Genai.Agent.Tool.Util.TableAnsweringModel}.
 */
type Genai.Agent.Tool.Util.TableAnsweringModel.Input {

  /**
   * A pandas.DataFrame table used to answer the query in the {@link Genai.Agent.Tool.EvalQuery} pipeline
   */
  table: !native

  /**
   * The networkx graph of the data model graph used to answer the query in the {@link Genai.Agent.Tool.EvalQuery} pipeline
   */
  graph: !native

  /**
   * The {@link Genai.StructuredQuery.Spec} used to generate the output
   */
  structuredQuerySpec: !Genai.StructuredQuery.Spec

  /**
   * The input query from inProgressResult->searchQuery->standaloneQuery used to generate the output
   */
  query: !string
}
