/**
 * Helps managing the initialization of globals used in the Genai package. This helper is mainly
 * for DS to quickly iterate on experiments without having to restart jupyter kernel. It is intended for
 * client-side state management, and is not for server-side.
 */
abstract type Genai.Agent.Tool.Util.GlobalVariableHelper {
  /**
   * Check if all global variables defined by typeGlobals are set.
   *
   * NOTE: This function is only valid when called within the same process whose globals are being checked.
   */
  areGlobalsSet: private function(): boolean py

  /**
   * Reset the global variables to None.
   *
   * NOTE: This function is only valid when called within the same process whose globals are being checked.
   */
  resetGlobals: private function() py

  /**
   * Returns a tuple of dict of global names that the type stores/uses and the type scope's globals.
   * Needs to be implemented per-subtype so that we can have generic implementations of the other functions.
   */
  typeGlobals: abstract private function(): !native

  /**
   * Filters globals dictionary based on relevant names.
   *
   * @param allGlobals
   *           Dictionary containing the globals
   * @param globalNames
   *           The names of the globals that we want to keep.
   *
   * @return The filtered dictionary.
   */
  filterGlobals: function(allGlobals: native, globalNames: [string]): !native py
}
