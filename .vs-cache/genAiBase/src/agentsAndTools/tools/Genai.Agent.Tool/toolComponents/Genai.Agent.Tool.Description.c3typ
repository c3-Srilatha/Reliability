/**
 * A formatted description of a {@link Genai.Agent.Tool}.
 */
type Genai.Agent.Tool.Description mixes Genai.Agent.Tool.DataRetriever.Description {

    /**
     * Id of the original {@link Genai.Agent.Tool} this description object is for.
     */
    id: !string

    /**
     * Semantic name for the tool. Retrieved from {@link Genai.Agent.Tool.Config#toolName}.
     */
    name: !string

    /**
     * Natural language description for the tool. Retrieved from {@link Genai.Agent.Tool.Config#toolDescription}.
     */
    description: !string

    /**
     * Natural language message appended prior to llm generation.
     * Helps prompt the agent to correctly format to tool input.
     * Ignored if not provided.
     * Retrieved from {@link Genai.Agent.Tool.Config#formattingMessage}.
     */
    formattingMessage: string
}
