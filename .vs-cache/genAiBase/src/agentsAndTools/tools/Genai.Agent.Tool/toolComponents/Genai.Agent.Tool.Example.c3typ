/**
 * A Tool example. Stored on {@link Genai.Agent.Tool.Config}. Returned by Genai.Agent.Tool toolExamples.
 */
type Genai.Agent.Tool.Example {
  /**
   * The user query of this example, e.g. "What is the risk score of my X84?"
   */
  userQuery: !string

  /**
   * The {@link Genai.Agent.Step} in this example. The final step must be stored on {@link Genai.Agent.Tool.Example#finalAnswerResult} or {@link Genai.Agent.Tool.Example#idkResult}.
   */
  intermediateSteps: [Genai.Agent.Step]

  /**
   * For examples resulting in a final answer, this field holds the {@link Genai.Agent.Step} finishing this example. The {@link Genai.Agent.Step#actionName} field is replaced with the finalAnswer tool used by the agent.
   */
  finalAnswerResult: Genai.Agent.Step

  /**
   * For examples resulting in "I am unable to answer your question", this field holds the {@link Genai.Agent.Step} finishing this example. The {@link Genai.Agent.Step#actionName} field is replaced with the finalAnswer tool used by the agent.
   */
  idkResult: Genai.Agent.Step
}
