/**
 * Spec for {@link Genai.Agent.Tool.DataRetriever#formatData}
 */
type Genai.Agent.Tool.DataRetriever.FormatDataSpec mixes Spec {
    /**
     * The retrieved data
     */
    retrieveDataOutput: !Genai.Agent.Tool.DataRetriever.Output

    /**
     * The result for which data was retrieved. Note that this is the childResult which was passed to the tool,
     * not the overall parent result corresponding to the user's query.
     */
    inProgressResult: !Genai.Query.Result

    /**
     * The string query for which the data was retrieved
     */
    input: !string

    /**
     * If there is a table to format, this specifies the maximum number of rows to keep when performing the formatting.
     */
    maxTableRows: !int = 50
}
