/**
 * Contains descriptions for data returned by {@link Genai.Agent.Tool.DataRetriever#retrieveData}, which are used by llm to answer the user query.
 */
type Genai.Agent.Tool.DataRetriever.Description {
  /**
   * Tool description used by {@link Genai.Agent.Tool.MultiSourceSynthesizer}
   */
  descriptionForMultiTool: string

  /**
   * Description for data returned by {@link Genai.Agent.Tool.DataRetriever.Output}
   */
  // TODO: GEN-9666 Make it a string instead of list
  retrievedDataDescription: [string]
}
