/**
 * Output from {@link Genai.Agent.Tool#run}.
 */
type Genai.Agent.Tool.Output {
  /**
   * The result that is in the process of getting generated.
   */
  inProgressResult: !Genai.Query.Result

  /**
   * The specific output from the {@link Genai.Agent.Tool}.
   * Used in tool post-processing to generate relevant visualizations or rationale if applicable.
   */
  output: any

  /**
   * The {@link Genai.StructuredQuery.Spec} used to generate `output` if the tool is a structured query tool.
   */
  structuredQuerySpec: Genai.StructuredQuery.Spec

  // TODO GEN-7228 Remove this field and update code to extract data from Tool.Output
  /**
   * Data retrieved when the tool was run
   */
  retrievedData: Genai.Agent.Tool.DataRetriever.Output
}
