/**
 * Configuration for a {@link Genai.Agent.Tool}
 */
type Genai.Agent.Tool.Config mixes Identified, Config, Genai.Agent.Tool.ConfigBase, Genai.ParentConfig {

  /**
   * If true, then the few-shot implementation of the tool will be used for spec generation. Currently only supported
   * for EvalQueryTool.
   */
  useFewShotSpecGeneration: boolean

  /**
   * Prompt used for getting a natural language answer to the question from structured data.
   */
  textAnswerFromDataPrompt: !string

  /**
   * If set to true, we do not generate a textual answer from llm.
   * The default is to generate a textual answer from llm using the prompt from #textAnswerFromDataPrompt.
   */
  doNotGenerateAnswerFromLlm: boolean

  /**
   * The number of rows that is passed to the LLM model for generating the natural language answer when #doNotGenerateAnswerFromLlm is enabled.
   * This config is only used in EvalQueryTool.
   */
  numRowsForLlm: int = 1

  /**
   * Name of {@link Genai.UnstructuredQuery.Engine.ModelConfig} that should be used for getting a natural language answer from structured data.
   */
  textAnswerFromDataModelConfigName: string

  childConfigFields: ~ js
}
