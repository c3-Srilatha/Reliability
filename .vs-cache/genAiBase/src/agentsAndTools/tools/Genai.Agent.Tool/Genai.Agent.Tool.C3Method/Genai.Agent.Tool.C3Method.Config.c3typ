/**
 * Config for an instance of {@link Genai.Agent.Tool.C3Method}
 */
type Genai.Agent.Tool.C3Method.Config mixes Identified, Config, Genai.Agent.Tool.ConfigBase {

  /**
   * The prompt used to generate the arguments for {@link Genai.Agent.Tool.C3Method#methodType} given a user's query.
   * The prompt will contain:
   *     1. General boilerplate and llm instructions
   *     2. Documentation of the method and its parameters (derived from the type documentation by default)
   *     3. (optional) Some few-shot examples
   *     4. One remaining parameter (`query`) for the user's query
   */
  generateArgsPrompt: !Genai.Prompt

  /**
   * Helper function to validate that a given prompt is valid for the {@link Genai.Agent.Tool.C3Method}.
   * Specifically, this method checks that the prompt has exactly one parameter: `query`.
   *
   * Throws an error if the prompt is invalid.
   *
   * @param prompt
   *           The prompt to validate
   */
  validatePrompt: private function(prompt: !Genai.Prompt) py

  /**
   * The {@link Genai.UnstructuredQuery.Engine.ModelConfig} to be used for generating the arguments for the method call
   */
  generateArgsLlmConfigName: !string

  /**
   * Optional override of {@link Genai.Agent.Tool.C3Method#fillPrompt} to customize the prompt generation.
   */
  fillPromptOverrideLambda:
    lambda(tool: !Genai.Agent.Tool.C3Method, query: !Genai.Query, inProgressResult: !Genai.Query.Result): !string

  /**
   * Optional override of {@link Genai.Agent.Tool.C3Method#generateArgs} to customize how the args are generated
   */
  generateArgsOverrideLambda:
    lambda(tool: !Genai.Agent.Tool.C3Method, prompt: !string, inProgressResult: !Genai.Query.Result): !?map<string, any>

  /**
   * Optional override of {@link Genai.Agent.Tool.C3Method#invokeMethod} to customize how the method is invoked
   * given the arguments from {@link Genai.Agent.Tool.C3Method}.
   */
  invokeMethodOverrideLambda:
    lambda(tool: !Genai.Agent.Tool.C3Method, argsMap: !?map<string, any>, inProgressResult: !Genai.Query.Result): !Genai.Agent.Tool.Output

  /**
   * Optional override of {@link Genai.Agent.Tool.C3Method#toolOutputFromMethodResult}
   */
  toolOutputFromMethodResultOverrideLambda:
    lambda(tool: !Genai.Agent.Tool.C3Method, result: any, inProgressResult: !Genai.Query.Result): !Genai.Agent.Tool.Output
}
