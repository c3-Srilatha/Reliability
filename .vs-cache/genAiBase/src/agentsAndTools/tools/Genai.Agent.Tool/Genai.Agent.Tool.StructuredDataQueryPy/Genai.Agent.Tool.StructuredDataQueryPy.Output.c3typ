/**
 * The output type for {@link Genai.Agent.Tool.StructuredDataQueryPy}.
 */
type Genai.Agent.Tool.StructuredDataQueryPy.Output {
  /**
   * The result that is in the process of getting generated.
   */
  inProgressResult: !Genai.Query.Result

  /**
   * The {@link Genai.StructuredQuery.Spec}'s used to generate `output` if the tool is a structured query tool.
   */
  structuredQuerySpecs: [Genai.StructuredQuery.Spec]

  /**
   * The final source code generated by the tool.
   */
  sourceCode: string

  /**
   * Dataframe computed when the tool was run.
   */
  data: native

  /**
   * Textual answer to the query based on the dataframe. Can be a string or a generator if the answer is streamed
   */
  answer: any

  /**
   * A string representation of the trajectory.
   */
  serializedTrajectory: string

  /**
   * The session id attached to the agent.
   * Will either be the session id specified by the user in {@link Genai.Agent.Tool.StructuredDataQueryPy#doRun} or
   * a randomly generated one.
   */
  session: GenaiCore.Session.Kv
}
