// c3-analysis-disable c3-excessive-method-params -- functions must be refactored to use specs where possible

/**
 * A tool that generates and executes eval spec and code for structured data queries.
 */
type Genai.Agent.Tool.StructuredDataQueryPy mixes Genai.Agent.Tool.StructuredDataQuery<Genai.Agent.Tool.StructuredDataQueryPy.Config>, Genai.Agent.Tool.DataRetriever {

  /**
   * Initialize the tool according to the provided spec.
   *
   * @param spec
   *        Initialization spec for the tool.
   * @param skipFuzzyMatcher
   *       If true, the fuzzy matcher initialization will be skipped.
   * @return The initialized tool.
   */
  doInitialize: private member function (spec: Genai.Agent.Tool.StructuredDataQueryPy.InitializationSpec, skipFuzzyMatcher: boolean): !Genai.Agent.Tool.StructuredDataQueryPy py-query_orchestrator

  initialize: ~ py-query_orchestrator

  /**
   * Internal implementation of the run method. This method is called by the public run method but can also be used directly when used as a top-level tool within
   * a planning agent.
   *
   * @param inProgressResult
   *        The {@link Genai.Query.Result} created for the input
   * @param query
   *        The query to answer.
   * @param maxRetries
   *        The maximum number of retries to attempt if the query fails.
   * @param session
   *        The {@link GenaiCore.Session.Kv} to use for the query.
  * @param streamResponse
   *        Whether or not to stream the response.
   * @return The output of the tool.
   */
  // GEN-9306: Integrate session management with UI
  doRun: private member function (inProgressResult: !Genai.Query.Result, query: !string, maxRetries: int, session: GenaiCore.Session.Kv, streamResponse: boolean): !Genai.Agent.Tool.StructuredDataQueryPy.Output py-query_orchestrator

  run: ~ py-query_orchestrator

  /**
   * Analyzes the syntax of any {@link EvalSpec} that is to be executed and generates an error message that
   * the LLM can understand. An example of this would be 'Select is not valid syntax'.
   *
   * @param sourceType
   *        The type of the data source being queried.
   * @param projection
   *        The fields or expressions to query.
   * @param filter
   *        The condition specified to filter out the rows in the resulting table.
   * @param group
   *        The fields specified to group by.
   * @param order
   *        The fields specified to order by.
   * @param limit
   *        The maximum number of records to retrieve.
   * @param having
   *        The condition specified to filter out the rows in the resulting table after aggregation is applied.
   * @return A string containing a summary of syntax errors found, or an empty string if no errors are detected.
   *         E.g. 'Select is not valid syntax'.
   */
  generateRelevantErrorMessage: member function(
    sourceType: !string,
    projection: !string,
    filter: string,
    group: string,
    order: string,
    limit: string,
    having: string
  ): string py-query_orchestrator

  /**
   * Returns the names of all types that have been loaded into memory.
   */
  typeGlobals: member function(): ![string] py-query_orchestrator

  /**
   * Returns true if the global variables have been set.
   */
  areGlobalsSet: member function(): !boolean py-query_orchestrator

  /**
   * Resets the global variables in the engine process.
   */
  resetGlobals: member function() py-query_orchestrator

  /**
   * Private function for internal developers to return an initialized native agent instance.
   */
  nativeAgent: private member function(): native py-query_orchestrator

  /**
   * Rewrite the last user query conversation into few shot example. Returns a tuple of
   * (is_rewritting_successful, rewritten query, rewritten code).
   * Private function for internal developers to get the rewritten few shot example.
   */
  writeFewShotFromLastUserQuery: private member function(): !native py-query_orchestrator

  /**
   * Private function for internal developers to add few-shot examples to the tool.
   */
  addFewShot: private member function(query: !string, code: !string, description: string=""): boolean py-query_orchestrator

  /**
   * Private function for internal developers to get the filter on the vector store for the
   * few shot examples configured for this agent.
   */
  filterForFewShot: private member function(): !Filter py-query_orchestrator

  /**
   * @return the id of {@link GenaiCore.SessionStore.Kv} is used (or will be used).
   */
  sessionStoreId: private function(): !string py-query_orchestrator

  retrieveData: ~ py-query_orchestrator

  formatData: inline ~ py-query_orchestrator
  getWhitelistedDataModel: ~ py-query_orchestrator
  postProcessQueryResult: ~ py
}
