/**
 * Light wrapper around {@link Genai.UnstructuredQuery.Engine} to give it a {@link Genai.Agent.Tool} interface.
 */
// TODO: GEN-9666 Eliminate the implementation of this type once we have Tools that can simply refer to
//       ActionRefs/MethodTypes
type Genai.Agent.Tool.UnstructuredDataQuery mixes Genai.Agent.Tool<Genai.Agent.Tool.UnstructuredDataQuery.Config>, Genai.Agent.Tool.DataRetriever,
  Genai.Agent.Tool.FunctionCalling.Wrapper {
  initialize: ~ py-query_orchestrator
  // input string will be the query. Simply call `Genai.UnstructuredQuery.Engine` and pack the result appropriately
  run: ~ py-query_orchestrator

  textAnswer: ~

  retrieveData: ~ py-query_orchestrator

  formatData: ~ py-query_orchestrator

  toolWrapperForAgent: ~ py

  /**
   * Isolates stream handling.
   * Simply calls `Genai.UnstructuredQuery.Engine` and packs the result appropriately
   * @param input
   *           The input query. Note that this may not be exactly the same as the user's query, as
   *           it may have been preprocessed by the {@link Genai.Agent} before being passed to the tool.
   * @param inProgressResult
   *           The {@link Genai.Query.Result} being processed.
   * @return The stream of strings.
   */
  runForStreaming: inline member function(input: !string,
                                          inProgressResult: !Genai.Query.Result,
                                          streamResponse: string enum Genai.Streaming.Strategy
                                          ): stream<string> py-query_orchestrator

}
