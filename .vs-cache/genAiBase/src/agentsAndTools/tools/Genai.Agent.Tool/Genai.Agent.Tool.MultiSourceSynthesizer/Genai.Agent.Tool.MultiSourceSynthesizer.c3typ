/**
 * The MultiSourceSynthesizer attempts to answer the query by retrieving data and/or answers from multiple sources
 * and then using one or more of them to produce a final answer. See {@link Genai.Agent.Tool.MultiSourceSynthesizer.Config}
 * for configuration options.
 */
type Genai.Agent.Tool.MultiSourceSynthesizer mixes Genai.Agent.Tool.StructuredDataQuery<Genai.Agent.Tool.MultiSourceSynthesizer.Config>, Genai.Agent.Tool.FunctionCalling.Wrapper {
  initialize: ~ py-query_orchestrator
  run: ~ py-query_orchestrator
  retrieveData: ~ py-query_orchestrator
  formatData: ~ py-query_orchestrator
  toolWrapperForAgent: ~ py
}
