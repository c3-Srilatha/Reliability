/**
 * Config for an instance of {@link Genai.Agent.Tool.WebSearch}
 */
type Genai.Agent.Tool.WebSearch.Config mixes Identified, Config, Genai.Agent.Tool.ConfigBase, Genai.Agent.Tool.DataRetriever.ConfigBase {
    /**
     * Lambda to initialize the tool and return the native instance of the client to perform the search.
     */
    initializeLambda: !lambda(config: !Genai.Agent.Tool.WebSearch.Config): !native

    /**
     * Lambda to search the web for information and return the results.
     */
    searchLambda: !lambda(client: !native, query: !string, filters: string): [Genai.Agent.Tool.WebSearch.Result]

    /**
     * The authentication key for search client.
     */
    @config(secret=true)
    apiKey: !string

    /**
     * The endpoint for the search client.
     */
    endpoint: !string

    /**
     * Parameters to use for the search API. Consult your API documentation for the supported parameters.
     */
    params: json

    /**
     * Name of the {@link Genai.UnstructuredQuery.Engine.ModelConfig} to use
     */
    llmConfigName: !string = "azureGpt4o"

    /**
     * The prompt to use for generating the answer to the user query
     */
    answerPrompt: !Genai.Prompt
}
