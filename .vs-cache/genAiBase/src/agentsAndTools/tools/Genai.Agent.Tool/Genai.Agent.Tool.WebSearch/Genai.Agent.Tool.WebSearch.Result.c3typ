/**
 * A search result from a web search.
 */
type Genai.Agent.Tool.WebSearch.Result {
    /**
     * The title of the search result.
     */
    title: string

    /**
     * The URL of the search result.
     */
    url: string

    /**
     * The text content of the search result.
     */
    text: string
}
