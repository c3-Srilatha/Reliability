/**
 * New eval query tool, that relies on a fine-tuned LLM to generate and execute {@link EvalSpec} instances from an
 * input query.
 */
type Genai.Agent.Tool.EvalQuery mixes Genai.Agent.Tool.StructuredDataQuery<Genai.Agent.Tool.EvalQuery.Config>, Genai.Agent.Tool.StructuredDataQuery.Base {
  initialize: ~ py-query_orchestrator

  run: ~ py-query_orchestrator

  retrieveData: ~ py-query_orchestrator

  formatData: inline ~ py-query_orchestrator

  statusEnums: ~ py

  postProcessQueryResult: ~ py
}
