/**
 * Module that generates C3 {@link EvalSpec} instances from input queries.
 */
type Genai.Agent.Tool.Util.EvalQuery.SpecGenerationModel mixes Genai.Agent.Tool.Util.GlobalVariableHelper {
  typeGlobals: ~ py-query_orchestrator

  /**
   * Generates the {@link EvalSpec} for the given input query
   */
  generateSpec: function(
      query: !string,
      evalGenerateSpec: Genai.Agent.Tool.Util.EvalQuery.SpecGenerationModel.Spec,
      dataModelGraph: !Genai.StructuredData.DataModelGraph
    ): !Genai.Agent.Tool.Util.Output py-query_orchestrator
}
