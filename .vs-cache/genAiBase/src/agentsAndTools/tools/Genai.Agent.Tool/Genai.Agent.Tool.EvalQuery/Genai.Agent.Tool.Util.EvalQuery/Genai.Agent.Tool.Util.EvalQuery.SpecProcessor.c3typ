// c3-analysis-disable c3-excessive-method-params -- functions must be refactored to use specs where possible

/**
 * Module to validate and execute an {@link EvalSpec}.
 */
type Genai.Agent.Tool.Util.EvalQuery.SpecProcessor mixes Genai.Agent.Tool.Util.GlobalVariableHelper {

  /**
   * Preprocesses the input {@link Genai.StructuredQuery.Spec}.
   */
  preProcess: function(
    structuredQuerySpec: !Genai.StructuredQuery.Spec,
    evalSpecProcessorSpec: Genai.Agent.Tool.Util.EvalQuery.SpecProcessor.Spec
  ): !Genai.StructuredQuery.Spec py-query_orchestrator

  /**
   * Validates the input {@link Genai.StructuredQuery.Spec}.
   */
  validate: function(
    structuredQuerySpec: !Genai.StructuredQuery.Spec,
    dataModelGraph: !Genai.StructuredData.DataModelGraph,
    removeInvalidFieldsInProjections: boolean
  ): !Genai.StructuredQuery.Spec py-query_orchestrator

  /**
   * Executes the input {@link Genai.StructuredQuery.Spec}. The step includes
   * retrieving the data table and applying the post-processing on table.
   */
  execute: function(
    validatedSpec: !Genai.StructuredQuery.Spec,
    evalSpecProcessorSpec: Genai.Agent.Tool.Util.EvalQuery.SpecProcessor.Spec
  ): !Genai.Agent.Tool.Util.Output.SpecProcessor py-query_orchestrator

  /**
   * Preprocesses, validates and executes the input {@link Genai.StructuredQuery.Spec}
   * If the generated eval spec fails post validation, the function will return {@link Genai.Agent.Tool.Util.Output} with a null output.
   */
  tableFromSpec: function(
      structuredQuerySpec: !Genai.StructuredQuery.Spec,
      dataModelGraph: !Genai.StructuredData.DataModelGraph,
      evalSpecProcessorSpec: Genai.Agent.Tool.Util.EvalQuery.SpecProcessor.Spec
  ): !Genai.Agent.Tool.Util.Output py-query_orchestrator

  typeGlobals: ~ py-query_orchestrator
}
