/**
 * Config for {@link Genai.Agent.Tool.FinalAnswer}
 */
type Genai.Agent.Tool.FinalAnswer.Config mixes Identified, Genai.Agent.Tool.FunctionCalling.Config, Genai.ParentConfig, Config {
  /**
   * Name of the {@link Genai.UnstructuredQuery.Engine.ModelConfig} to use
   */
  llmConfigName: !string

  /**
   * The prompt to use for generating the final answer
   */
  finalAnswerPrompt: !Genai.Prompt

  childConfigFields: ~ js
}
