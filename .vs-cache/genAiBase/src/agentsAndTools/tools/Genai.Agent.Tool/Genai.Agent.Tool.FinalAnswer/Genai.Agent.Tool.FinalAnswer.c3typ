/**
 * Tool to combine the outputs of previous steps and generate a final answer to a user query
 */
type Genai.Agent.Tool.FinalAnswer mixes Identified, Configurable<Genai.Agent.Tool.FinalAnswer.Config>, Genai.Agent.Tool.FunctionCalling {
    /**
     * See also {@link Genai.Agent.Tool#initialize}
     */
    initialize: member function(forceReload: boolean): native py-query_orchestrator

    pyFuncForAgent: ~ py-query_orchestrator
}
