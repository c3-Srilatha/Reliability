/**
 * Persists few-shot examples for structured query tools along with its embedding in pgvector.
 */
abstract extendable entity type Genai.FewShotExample.StructuredQuery extends Genai.FewShotExample type key "FSESQ" {
  /**
   * The {@link EvalSpec}, {@link EvaluateSpec} or {@link EvalMetricsSpec} that answers the query.
   */
  spec: !Genai.StructuredQuery.Spec

  // TODO GEN-6802 Move this to Genai.FewShotExample to be implemented for each example
  /**
   * Saves the specs generated by the provided query as FewShotExamples.
   * @param queryResult
   *      The {@link Genai.Query.Result} containing the structured query specs generated for the given user query.
   */
  addFewShots: function(queryResult: !Genai.Query.Result) js-rhino

  parseForTemplate: ~ py-query_orchestrator
}
