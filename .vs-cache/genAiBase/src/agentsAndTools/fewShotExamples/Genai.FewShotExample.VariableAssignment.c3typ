/**
 * Persists few-shot examples for FunctionCallStep execution kwargs with its embedding in pgvector.
 */
entity type Genai.FewShotExample.VariableAssignment extends Genai.FewShotExample type key "VA" {

    /**
     * Keyword arguments to be passed to the tool function during execution.
     */
    executionKwargs: !json

    /**
     * The name of the tool that this kwargs were used for.
     */
    toolName: !string
}
