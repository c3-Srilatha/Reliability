/**
 * Persists few-shot examples for a {@link Genai.Query.Result} pair. These are used for generating suggestions for follow-up queries
 */
entity type Genai.FewShotExample.QueryResultPair extends Genai.FewShotExample type key "QRP" {

  /**
   * The query result associated with the example.
   */
  result: !Genai.Query.Result

  /**
   * The result from the follow-up query to the #result.
   */
  followUpResult: !Genai.Query.Result

  /**
   * Convenience function to add a few shot example given a pair of {@link Genai.Query.Result}s, and the project to which the examples belong.
   */
  addFewShot: function(result: !Genai.Query.Result, followUpResult: !Genai.Query.Result, project: Genai.Project): !Genai.FewShotExample.QueryResultPair js-rhino


  parseForTemplate: ~ py-query_orchestrator
}
