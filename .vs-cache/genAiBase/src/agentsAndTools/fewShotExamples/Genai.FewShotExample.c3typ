/**
 * Persists a few-shot example along with its embedding in pgvector.
 */
@db(index=[{fields:[{name: emb, opClass: COSINE}], neighborsCount: 16, efConstruction: 40}])
abstract extendable entity type Genai.FewShotExample schema name "FSE" {
  /**
   * The query associated with the example.
   */
  query: !string

  /**
   * An E5 embedding of the query.
   */
  @vector(dimension=1024)
  emb: string


  /**
   * Flag indicating if this was added manually or by an automatic process.
   */
  manuallyAdded: boolean


  /**
   * Parses a few-shot example so that it is consumable by templates.
   * @param args
   *           The arguments to be used when parsing the example.
   * @return The stringified few-shot example.
   */
  parseForTemplate: abstract member function(args: json): !string

  /**
   * Embed the query before persisting the example.
   */
  beforeCreate: ~ py-query_orchestrator

  /**
   * The project this example belongs to. This can be used to filter out based on use case.
   * E.g. We might have few-shots for a reliability related use case and others for a process optimisation
   * use case. We might need to differentiate between both of these. The {@link Genai.Project}
   * can be used for this.
   */
  project: Genai.Project

  /**
   * The {@link User} who created the {@link Genai.FewShotExample}.
   */
  createdBy: User(id, meta.createdBy)

  /**
   * Adds embeddings to the given list of {@link Genai.FewShotExample} objects based on the provided queries.
   *
   * @param objs
   *     The list of {@link Genai.FewShotExample} objects to update with embeddings.
   * @param queries
   *     The list of query strings to generate embeddings from. Must be the same length as `objs`.
   * @return
   *     A list of updated {@link Genai.FewShotExample} objects, each with its corresponding embedding.
   */
  addEmbeddingsForQueries: private function(objs: ![Genai.FewShotExample], queries: ![string]): !ObjList<mixing Genai.FewShotExample>  py-query_orchestrator
}
