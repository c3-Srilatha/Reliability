/**
 * Persists few-shot examples for a python agent along with its embedding in pgvector.
 */
@db(index += ['specialization', 'query', 'project'])
entity type Genai.FewShotExample.PythonAgent extends Genai.FewShotExample type key "PTHAGNT" {

    /**
     * The code executed by the python agent.
     */
    code: !string

    /**
     * The description of what the code intends to do.
     */
    subQuery: string = ""

    /**
     * Description of the few-shot.
     */
    description: string = ""

    /**
     * The specialization of the python agent.
     * This distinguishes between different agent specializations within the same project. E.g. it is possible to
     * have a genericAnalysis agent that takes care of plotting graphs and pandas operations.
     * But we can also have a different agent that specialises in geospatialAnalysis. Which takes care of geospatial
     * analyses, we use this specialization to distinguish the examples.
     */
    specialization: !string = "genericAnalysis"

    /**
     * Embed the query before persisting the example.
     */
    beforeCreate: ~ py-query_orchestrator
}
