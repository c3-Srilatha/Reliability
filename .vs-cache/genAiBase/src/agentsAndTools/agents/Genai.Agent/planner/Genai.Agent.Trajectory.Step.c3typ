/**
 * A Type designed to represent a step taken in a {@link Genai.Agent.Trajectory} to answer a user query.
 * Example steps could be to retrieve some data, execute some code, create a visualization, etc.
 */
abstract type Genai.Agent.Trajectory.Step {

  /**
   * The id of the step.
   */
  stepId: string

  /**
   * The output of the step.
   */
  output: json | [Genai.Agent.DynamicData]

  /**
   * The status of the step
   */
  status: Genai.Agent.Trajectory.Step.Status

  /**
   * The logs for the step
   */
  logs: json
}
