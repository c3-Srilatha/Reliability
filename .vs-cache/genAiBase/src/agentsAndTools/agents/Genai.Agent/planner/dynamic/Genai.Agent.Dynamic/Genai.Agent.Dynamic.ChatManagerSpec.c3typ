/**
 * Spec containing arguments relevant to the internal ChatManager used by {@link Genai.Agent.Dynamic}.
 */
type Genai.Agent.Dynamic.ChatManagerSpec mixes Spec {

  /**
   * Prompt for the agent to answer the query.
   */
  systemPrompt: !Genai.Prompt

  /**
   * The prompt used to force a solution if the agent reaches {@link Genai.Agent.Dynamic.Config#maxSteps} or {@link Genai.Agent.Dynamic.Config#maxSeconds}.
   */
  forceSolutionPrompt: !Genai.Prompt

  /**
   * The maximum number of conversationsteps that we want to keep track of.
   */
  maxPreviousSteps: int = 10

  /**
   * If set to True, the images generated by the agent or as an output of its tools will be passed back to
   * the LLM as part of the conversation history.
   */
  includeGeneratedImages: boolean
}
