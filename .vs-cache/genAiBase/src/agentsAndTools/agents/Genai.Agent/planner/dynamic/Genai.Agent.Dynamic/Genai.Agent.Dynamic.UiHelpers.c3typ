/**
 * UI helper functionality for Genai.Agent.Dynamic.
 */
type Genai.Agent.Dynamic.UiHelpers {

    /**
     * Default fallback function called to create a UI artifact for the given object.
     */
    defaultForUiHelper: function(obj: !native, filePath: string): any py-query_orchestrator

    /**
     * Function called to create a UI artifact for the given pandas dataframe object.
     */
    pandasForUiHelper: function(obj: !native, filePath: string): any py-query_orchestrator

    /**
     * Function called to create a UI artifact for the given pillow object.
     */
    pilForUiHelper: function(obj: !native, filePath: string): any py-query_orchestrator

    /**
     * Function called to create a UI artifact for the given matplot object.
     */
    matplotForUiHelper: function(obj: !native, filePath: string): any py-query_orchestrator

    /**
     * Function called to create a UI artifact for the given plotly object.
     */
    plotlyForUiHelper: function(obj: !native, filePath: string): any py-query_orchestrator
}
