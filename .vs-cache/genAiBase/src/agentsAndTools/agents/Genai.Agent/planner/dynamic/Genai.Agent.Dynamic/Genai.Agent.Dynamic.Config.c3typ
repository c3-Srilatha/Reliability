/**
 * Config for {@link Genai.Agent.Dynamic}
 */
type Genai.Agent.Dynamic.Config mixes DefaultInstance, Named, Config, Genai.ParentConfig, Genai.Agent.Dynamic.ConfigParams, Genai.WithAllTools {
  inst: ~ js-rhino
  allTools: ~ js-rhino
  childConfigFields: ~ js

  /**
   * The name of the {@link Genai.Agent.Dynamic.Config} to use
   * for {@link Genai.Agent.Dynamic.Persistable#queryFromTestCase}
   */
  testAgentConfigName: string

  /**
   * Retrieve the {@link Genai.StructuredData.DataModelGraph#whitelistedDataModel} from each tool if
   * one is available
   * @return collection of whitelistedDataModels
   */
  getWhitelistedDataModels: member function(): [json] js-rhino

  /**
   * Update the system prompt with the data model documentation
   * @param dataModelGraph the data model graph to use for documentation
   */
  updateSystemPromptWithDataModel: member function(dataModelGraph: !Genai.StructuredData.DataModelGraph) js-rhino
}
