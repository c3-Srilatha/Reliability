/**
 * A step in a {@link Genai.Agent.DynamicTrajectory.StepSequence}.
 */
@db(index+=["agentName", "trajectory"])
entity type Genai.Agent.DynamicTrajectory.Step mixes Genai.Agent.Trajectory.Step type key "GADS" {

  /**
   * The agent that this step is associated to.
   */
  agentName: !string

  /**
   * The trajectory that this step is a part of.
   */
  trajectory: Genai.Agent.DynamicTrajectory

  /**
   * The llm-generated content of this step, which may include code, a plan, or the final answer.
   */
  content: string

  /**
   * The tag indicating the type of content in this step.
   */
  tag: Genai.Agent.DynamicTrajectory.Step.Tag

  /**
   * The query or command for this step.
   */
  query: string

  // TODO: GEN-8732
  // code_executor: native

  /**
   * Label used when printing the stdout of the code execution
   */
  stdoutLabel: string

  /**
  * The tools that were used in this step.
  */
  toolsUsed: [Genai.Agent.Dynamic.Tool.UiConfig]

  /**
   * The files were used as part of the rationale to generate the answer.
   */
  @db(filter="passageUiDisplayIndex != -1")
  rationaleSources: [Genai.Query.ResultToSourceFileRelation](fromStep)

  /**
   * Relation records that link this result to the sources that were used to generate it. There is a many-to-many
   * relationship, allowing sources to be used in multiple results and results to be generated from multiple sources.
   */
  sourceRelations: [Genai.Query.ResultToSourceRelation](fromStep)

  /**
   * Returns the step that was last create for the given agent, in a given trajectory.
   */
  lastStepForAgent: function(agentName: !string, trajectory: !Genai.Agent.DynamicTrajectory): Genai.Agent.DynamicTrajectory.Step py
}
