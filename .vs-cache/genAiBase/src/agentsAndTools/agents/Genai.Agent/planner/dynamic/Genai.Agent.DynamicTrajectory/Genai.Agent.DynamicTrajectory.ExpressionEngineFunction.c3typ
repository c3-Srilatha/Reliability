/**
 * Custom {@link ExpressionEngineFunction}s used to calculate complex calc fields for {@link Genai.Agent.DynamicTrajectory}
 */
type Genai.Agent.DynamicTrajectory.ExpressionEngineFunction mixes ExpressionEngineFunction {
  /**
   * Function to obtain the time in milliseconds that the query took to initialize the agent.
   * @param id
   *        The ID of the {@link Genai.Query.Result}.
   * @return The plan generation latency of the query in milliseconds.
   */
  getAgentInitializationLatency: function(id: !string): !int js-rhino

  /**
   * Function to obtain the time in milliseconds that the query took to execute the dynamic agent.
   * @param id
   *        The ID of the {@link Genai.Query.Result}.
   * @return The plan execution latency of the query in milliseconds.
   */
  getAgentExecutionLatency: function(id: !string): !int js-rhino
}
