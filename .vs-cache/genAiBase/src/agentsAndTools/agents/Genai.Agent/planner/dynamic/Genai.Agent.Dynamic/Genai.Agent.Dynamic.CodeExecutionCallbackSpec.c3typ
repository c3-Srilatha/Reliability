/**
 * Manages the lifecycle of `PythonAgentCodeExecutor` callbacks for code execution workflows.
 */
type Genai.Agent.Dynamic.CodeExecutionCallbackSpec {
  /**
   * A list of callbacks to execute during the code preprocessing stage. These callbacks can modify or
   * validate the code before execution.
   * Expected callback kwargs: `state`, `result`.
   */
  preprocessCodeCallbacks:  [Lambda<FunctionType> | Lambda<function(state: any, result: any): any>]

  /**
   * A list of callbacks to execute during the output handling stage. These callbacks can validate,
   * modify, or extract specific results from the code execution outputs.
   * Expected callback kwargs: `state`, `result`.
   */
  handleOutputCallbacks: [Lambda<FunctionType> | Lambda<function(state: any, result: any): any>]

  /**
   * Used to maintain state between the different callbacks.
   */
  state: native
}
