/**
 * Mutable series of steps for answering a user query.
 */
entity type Genai.Agent.DynamicTrajectory mixes Genai.Agent.Trajectory {

  afterRemove: ~ js-rhino

  /**
   * The steps to execute the plan.
   */
  @db(order="ascending(meta.created)")
  steps: [Genai.Agent.DynamicTrajectory.Step](trajectory)

  /**
   * Returns the time taken to generate the plan in milliseconds.
   */
  planGenerationLatency: int calc getAgentInitializationLatency(id)

  /**
   * Returns the time taken to execute the plan in milliseconds.
   */
  planExecutionLatency: int calc getAgentExecutionLatency(id)
}
