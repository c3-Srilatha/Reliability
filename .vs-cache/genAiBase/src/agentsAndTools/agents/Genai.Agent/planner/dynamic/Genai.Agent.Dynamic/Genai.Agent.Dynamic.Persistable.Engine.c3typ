/**
 * Engine for persisted agents. Allows running tests and saving configurations.
 */
type Genai.Agent.Dynamic.Persistable.Engine mixes Engine<Genai.Agent.Dynamic.Persistable.Engine.Deployment, Engine.DeploySpec> {

  /**
   * Initializes the agent, loading the configuration and setting it up.
   * @param forceReload
   *           If true, all configs and setup will be re-run (instead of reusing already-loaded values)
   * @return The native python globals set during initialization.
   */
  initialize: private member function(
    forceReload: boolean
  ): native py-query_orchestrator

  /**
   * Answers a user query using a specific agent configuration. It does not require the configuration to be saved,
   * and is useful for testing purposes.
   * @param spec
   *           The initialization spec that should be used to answer the query.
   * @param inProgressQueryResult
   *           The in-progress query result that should be used to answer the query.
   *
   * @return The query result.
   */
  queryFromTestCase: private member function(
    spec: !Genai.Agent.Dynamic.TestSpec,
    inProgressQueryResult: !Genai.Query.Result
  ): !Genai.Query.Result py-query_orchestrator

  onStop: ~ py
}
