/**
 * Initialization spec for {@link Genai.Agent.Dynamic}, to initialize the dynamic agent with a specific set of params without going through app configuration.
 */
type Genai.Agent.Dynamic.InitializationSpec mixes Spec, Genai.Agent.Dynamic.ConfigParams {
  /**
   * Matches the {@link Genai.Agent.Dynamic.Config} field so that we can pass that field value along to the `run` function when using `specFromConfig`
   */
  name: string

  /**
   * Creates a {@link Genai.Agent.Dynamic.InitializationSpec} from a {@link Genai.Agent.Dynamic.Config}
   */
  specFromConfig: function (config: !Genai.Agent.Dynamic.Config): Genai.Agent.Dynamic.InitializationSpec py
}
