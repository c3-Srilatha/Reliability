/**
 * A step in a {@link Genai.Agent.DynamicTrajectory}. May contain one or more {@link Genai.Agent.DynamicTrajectory.Step} substeps.
 */
type Genai.Agent.DynamicTrajectory.StepSequence mixes Genai.Agent.Trajectory.Step {

  /**
   * The sub-steps within this step.
   */
  steps: [Genai.Agent.DynamicTrajectory.Step]

  /**
   * The query or command for this step.
   */
  query: string
}
