/**
 * Test spec for {@link Genai.Agent.Dynamic}, used for test queries.
 */
type Genai.Agent.Dynamic.TestSpec mixes Genai.Agent.Dynamic.InitializationSpec {
  /**
   * Set of prompt param values that will be injected in the agent's system prompt for the
   * test query.
   */
  promptParamValues: map<!string, string>

  /**
   * Collection of tools that should be used for test query execution.
   * If specified, the agent will use the provided tools to create a toolkit
   * and use it instead of the saved toolkit.
   */
  tools: [Genai.Agent.Dynamic.Tool]

  /**
   * The name of the LLM client configuration to use for the test query.
   * Must be a {@link GenaiCore.Llm.Auth#name}.
   * If not specified, the default LLM client configuration will be used.
   */
  llmClientConfigName: string
}
