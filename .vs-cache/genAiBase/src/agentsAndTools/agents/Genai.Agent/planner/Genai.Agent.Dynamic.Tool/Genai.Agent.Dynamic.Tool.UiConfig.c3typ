/**
 * Type representing the UI configuration for a {@link Genai.Agent.Dynamic.Tool}.
 */
type Genai.Agent.Dynamic.Tool.UiConfig {
  /**
   * The icon that will be used to represent this tool in the UI.
   */
  icon: string

  /**
   * The name that will be used to represent this tool in the UI.
   */
  name: string

  /**
   * The description that will be used to represent this tool in the UI.
   * This is used in the summary card title for the result of the step.
   */
  description: string

  /**
   * Returns the tool's configuration for the UI.
   */
  forUi: function(toolName: !string): Genai.Agent.Dynamic.Tool.UiConfig py
}
