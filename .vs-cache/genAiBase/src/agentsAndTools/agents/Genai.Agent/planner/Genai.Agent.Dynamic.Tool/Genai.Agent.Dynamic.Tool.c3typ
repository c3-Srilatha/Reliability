/**
 * Type representing a tool in toolkit for a {@link Genai.Agent.Dynamic} agent.
 */
@db(unique=['name'])
@seed(userUpdatable=true)
entity type Genai.Agent.Dynamic.Tool extends GenaiCore.Tool mixes Genai.Agent.Tool.Util.GlobalVariableHelper, Genai.ForNameHelperImpl type key "DNTL" {

  /**
   * The name that we want to give the defined tool. Must match the name of the function in the source code.
   */
  name: ~
  func: ~ py-c3agents

  /**
  * The ui configuration for this tool.
  */
  uiConfigurationParams: Genai.Agent.Dynamic.Tool.UiConfig

  /**
   * Source code for this tool. This file must define a Python function (`call`) implementing the tool's logic.
   * The function signature and docstring will be exposed to the LLM.
   *
   * The Python file can also define the required tool hooks (`initialize`, `terminate`) as
   * Python functions matching the exact names specified in Genai.Agent.Dynamic.Tool.Hooks.
   * - `call` (required): Executes the primary action for the tool. It can take arbitrary arguments and
   *   can return any object or nothing.
   * - `initialize` (optional): Prepares the tool by setting up variables or resources. This function
   *   takes no arguments and returns nothing.
   * - `terminate` (optional): Cleans up any instances or contexts created by the tool. This function
   *   takes no arguments and returns nothing.
   *
   * Actions must follow the exact naming convention (`call`, `initialize`, `terminate`) and should
   * be implemented in the same Python file.
   */
  pySrc: !File

  // TODO: https://c3energy.atlassian.net/browse/GEN-9848: Improve internal tool configuration.
  /**
   * Used for internal configuration of the tool.
   * This object will be available within the context of the code in #pySrc as a variable `toolConfigurationParams`.
   * It can be used to configure parameters such as model name that we want to specify whithout having to hard code and change in the code.
   */
  toolConfigurationParams: json

  /**
   * @inheritdoc
   */
  initialize: ~ py-c3agents

  /**
   * Terminates the tool.
   */
  terminate: inline member function() py-c3agents

  /**
   * Returns the native PythonAgentTool instance.
   */
  pythonAgentTool: inline member function(): !native py-c3agents

  /**
   * Creates (and upserts) a Tool based on a {@link Genai.Agent.Dynamic.Tool.FromLocalFileSpec}
   *
   * @param spec
   *    Spec containing the definition of the tool
   * @param overrideIfExists
   *    A flag indicating if we should override an exisiting tool if a tool with the same name exists.
   *    If false and the new tool is a duplicate, an error will be thrown.
   *
   * @return The tool.
   */
  fromLocalFile: function(
    spec: !Genai.Agent.Dynamic.Tool.FromLocalFileSpec, overrideIfExists: boolean
  ): !Genai.Agent.Dynamic.Tool py-c3agents

  beforeCreate: ~ py-c3agents
  typeGlobals: ~ py-c3agents
}
