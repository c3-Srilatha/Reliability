/**
 * Type representing a toolkit for a {@link Genai.Agent.Dynamic} agent.
 */
@db(unique=['name'])
@seed(userUpdatable=true)
entity type Genai.Agent.Dynamic.Toolkit extends GenaiCore.Toolkit mixes Genai.Agent.Tool.Util.GlobalVariableHelper, Genai.ForNameHelperImpl type key "DYNTLKT" {

  /**
   * Description of this toolkit, targeted for user information. This is not shown to the agent.
   */
  descriptionForUser: string

  /**
   * Initializes the toolkit and its {@link Genai.Agent.Dynamic.Tool}s.
   */
  initialize: member function(forceReload: boolean): !native py-c3agents

  /**
   * Terminates the toolkit and its {@link Genai.Agent.Dynamic.Tool}s.
   */
  terminate: member function() py-c3agents

  /**
   * Returns the native PythonAgentToolkit instance.
   */
  pythonAgentToolkit: inline member function(): !native py-c3agents

  /**
   * Creates (and upserts) a Toolkit based on a list of {@link Genai.Agent.Dynamic.Tool.FromLocalFileSpec}
   *
   * @param name
   *    The name that we want to give the toolkit.
   * @param specList
   *    List of specs containing the definition of the tools in the toolkit.
   * @param overrideIfExists
   *    A flag indicating if we should override an exisiting tool if a tool with the same name exists.
   *    If false and the new tool is a duplicate, an error will be thrown.
   *
   * @return
   *    The toolkit.
   */
  fromLocalFileList: function(
    name: !string, specList: ![Genai.Agent.Dynamic.Tool.FromLocalFileSpec], overrideIfExists: boolean
  ): !Genai.Agent.Dynamic.Toolkit py-c3agents

  typeGlobals: ~ py-c3agents
}
