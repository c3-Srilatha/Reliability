/**
 * Wrapper for a planner agent.
 * Used to configure the planner agent to be used by other orchestrator agents by mixing {@link Genai.WithPlanners}.
 */
type Genai.Agent.Planner {
  /**
   * The type of planner to use.
   */
  plannerType: !Type

  /**
   * The config name of the planner to use.
   */
  plannerConfigName: !string

  /**
   * The UI options for the planner.
   */
  uiOptions: Genai.Agent.Planner.UiOptions
}
