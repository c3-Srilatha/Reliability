/**
 * Helper Type to configure agents in the context of a project. Provides methods to save
 * and test specific configurations, as well as to toggle the agent's active state.
 *
 * @param C The configuration type for the agent.
 * @param S The initialization spec type for the agent.
 */
@db(unique=['name'])
extendable entity type Genai.Agent.Persistable<C,S> mixes Genai.ProjectAware schema name "GAP" {

  /**
   * User friendly name of the agent. It must be unique.
   */
  name: !string

  /**
   * Initializes the agent, loading the configuration and setting it up.
   * @param forceReload
   *           If true, all configs and setup will be re-run (instead of reusing already-loaded values)
   * @return The native python globals set during initialization.
   */
  initialize: abstract member function(forceReload: boolean): native py

  /**
   * Set of prompt param values that will be injected in the agent's system prompt on initialization.
   * These values can be extended, as long as the prompt used in the agent's config also references them.
   * Currently, this is used for storing the "instructions" users can set from the UI for the agent.
   */
  promptParamValues: map<!string, string>

  /**
   * The configuration of the agent.
   */
  config: !C

  /**
   * The agent's active state. If inactive, the agent will not be displayed in the tool selector in the UI.
   */
  inactive: boolean

  /**
   * Configuration for how this will be shown as a UI drop-down option
   */
  uiOptions: Genai.Agent.Tool.Config.UiOptions

  /**
   * Helper method to toggle the agent's active state.
   */
  setActiveOrInactive: member function (active: !boolean) js-rhino

  /**
   * Saves a configuration for the agent.
   * @param spec The save spec that should be saved for the agent.
   *
   * @return The saved agent.
   */
  save: function(spec: !Genai.Agent.Persistable.SaveSpec<S>): !Genai.Agent.Persistable js-rhino

  /**
   * Returns the {@link Genai.Agent.Dynamic.Config} for the agent.
   * @param id
   *          The ID of the agent whose configuration should be fetched.
   * @return The agent's configuration.
   */
  @action(group='read')
  fetchFormData: function(id: string): !Genai.Agent.Persistable js-rhino

  /**
    * Returns the Tools for the agent.
    * @param id
    *          The ID of the agent whose tools should be fetched.
    * @return An array of Genai.Agent.Tool.Config.
    */
   @action(group='read')
   getTools: function(id: string): !json js-rhino
}
