// c3-analysis-disable c3-excessive-method-params -- functions must be refactored to use specs where possible
/**
 * Useful Callbacks for {@link Genai.Agent.Dynamic}.
 */
type Genai.Agent.Dynamic.Callback.Utils {

    /**
     * Add user context to the system prompt at the beginning of a call step.
     */
    addUserContext: function(agent: any, call_step: any, includeUserId: boolean = false, includeUserEmail: boolean = false): any py

    /**
     * Remove large variables from the agent's code execution context.
     * This is useful for cleaning up the context before storing to the session store,
     * reducing the latency of storing the context.
     */
    removeLargeVariables: function(agent: any, call_step: any, keepImages: boolean = false, keepBytes: boolean = false): any py

}
