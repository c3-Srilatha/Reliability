/**
 * Callbacks for {@link Genai.Agent.Dynamic} that set up and clean up logger for tool calls.
 */
type Genai.Agent.Dynamic.Callback.ToolLogger {

    /**
     * Setup tool logger for each tool available to the agent.
     */
    setup: function(agent: any, step: any): any py

    /**
     * Cleanup tool logger for each tool available to the agent.
     */
    cleanup: function(agent: any, step: any): any py

}
