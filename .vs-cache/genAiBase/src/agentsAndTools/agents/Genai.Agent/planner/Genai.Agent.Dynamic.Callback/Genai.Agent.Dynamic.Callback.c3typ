/**
 * Entity type for managing OnStepCallbacks for {@link Genai.Agent.Dynamic}.
 */
entity type Genai.Agent.Dynamic.Callback schema name "DNAC" {

  /**
   * Reference to a Type's method
   */
  callback: !ActionRef

  /**
   * Type of this callback. See {@link Genai.Agent.Dynamic.Callback.Type}.
   */
  callbackType: !Genai.Agent.Dynamic.Callback.Type

  /**
   * This is a JSON object that can be used to pass configuration parameters to the callback function.
   * This kwargs should match the signature of the callback function.
   * I.e. a callback function with the signature function(agent, step, dataModelGraph) should specify
   * configKwargs = {"dataModelGraph": dataModelGraph}.
   */
  configKwargs: map<string, any>

  /**
   * Description of this callback for observability purposes. This field does not affect the execution
   * of the callback but assists users in understanding the callback's purpose when fetching.
   */
  description: string

  /**
   * To validate the signature of the callback is as expected before upserting the callback.
   */
  beforeCreate: ~ py

}
