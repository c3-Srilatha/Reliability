/**
 * Callbacks for {@link Genai.Agent.Dynamic} that update the agent's trajectory.
 * These handle syncing content from the native `c3DynamicPythonAgent` to the UI-facing Type interface.
 *
 * Updates include:
 * 1. Step content: Text output generated by the LLM.
 * 2. Target outputs: Objects (e.g., DataFrames, Charts) produced during {@link Genai.Agent.DynamicTrajectory.Step.TagType}.EXECUTE steps.
 * 3. Citations: Sources used by the agent or tools during execution.
 */
type Genai.Agent.Dynamic.Callback.TrajectoryUpdate {

    /**
     * Initializes a new {@link Genai.Agent.DynamicTrajectory.Step} within the current
     * {@link Genai.Agent.DynamicTrajectory} associated with the given agent's run state..
     *
     * Specifically, it:
     * 1. Creates and persists a new {@link Genai.Agent.DynamicTrajectory.Step} entity linked to the current trajectory.
     * 2. Injects a shallow copy of the agent’s run state into the global context of each tool’s function,
     *    allowing tools to track sources independently during their execution.
     */
    setupCurrentAgentStep: function(agent: native, step: native) py


    /**
     * Updates the current {@link Genai.Agent.DynamicTrajectory.Step} in the agent’s trajectory.
     *
     * This function performs the following:
     * 1. Updates metadata fields such as content, tag, query, stdoutLabel, status, and logs.
     * 2. Transforms the output into a UI-compatible format and injects source references.
     * 3. Replaces source IDs in content with human-readable display indices.
     * 4. Aggregates source citations used by tools duriong prior steps and adds them to the final answer.
     */
    updateCurrentAgentStep: function(agent: native, step: native) py


    /**
     * Finalizes the {@link Genai.Query.Result} for the current agent trajectory.
     *
     * 1. Sets the final answer using the content from the last executed step.
     * 2. Aggregates and stores engine logs from all trajectory steps.
     */
    finalizeUpdateQueryResult: function(agent: native, call_step: native) py

    /**
     * Optional callback, not added by default.
     * Updates the stdout to contain descriptions of the dataframes in the current step.
     *
     * This function performs the following for each dataframe in the current step:
     * 1. Extracts the dataframe from the step's target_output.
     * 2. Performs df.describe() on it.
     * 3. Adds the dataframe into the step's stdout for the LLM to see.
     */
    addDataFrameDescriptions: function(agent: native, step: native) py
}
