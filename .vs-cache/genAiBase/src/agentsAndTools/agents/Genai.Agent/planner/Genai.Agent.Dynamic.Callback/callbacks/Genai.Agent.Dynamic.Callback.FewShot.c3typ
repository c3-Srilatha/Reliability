/**
 * Callbacks for {@link Genai.Agent.Dynamic} that set up few-shot examples in system prompt.
 */
type Genai.Agent.Dynamic.Callback.FewShot {

    /**
     * Add few-shot examples to the system prompt at the beginning of a call step.
     */
    setup: function(agent: any, call_step: any, n_few_shots: int = 3): any py

    /**
     * Cleanup few-shot examples in the system prompt at the end of a call step.
     */
    cleanup: function(agent: any, call_step: any): any py
}
