/**
 * Configuration to specify which {@linkGenai.Agent.QueryOrchestrator.DefaultConfig} should be used by the application.
 */
type Genai.Agent.QueryOrchestrator.DefaultConfig mixes Singleton, Config {
  /**
   * The name of the {@link Genai.Agent.Config} to use.
   */
  queryOrchestratorConfigName: !string
}
