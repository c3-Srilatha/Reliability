/**
 * Config for the prompts used in {@link Genai.Agent.QueryOrchestrator}
 */
type Genai.Agent.QueryOrchestrator.Prompt.Config mixes Genai.UnstructuredQuery.Prompt.Config, Genai.ParentConfig {
  /**
   * Instruction prompt used by the orchestrator to pick the next tool.
   */
  nextToolPrompt: !string

  /**
   * Name of {@link Genai.UnstructuredQuery.Engine.ModelConfig} used for picking the next tool by the orchestrator.
   */
  nextToolModelConfigName: !string

  childConfigFields: ~ js
}
