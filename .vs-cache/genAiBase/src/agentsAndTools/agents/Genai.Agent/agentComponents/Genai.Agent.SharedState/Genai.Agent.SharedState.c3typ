/**
 * Shared state, similar to c3.setVar and c3.getVar.
 * State can be scoped globally (accessible to all users) or per-user (isolated per user).
 * "Shared" means the state is persistent and accessible across agent runs and processes.
 */
entity type Genai.Agent.SharedState {

    /**
     * A logical key used to reference a particular state entry.
     */
    stateKey: !string

    /**
     * Value of the state entry.
     */
    state: !any
    /**
     * The scope of the state entry.
     */
    scope: !string enum("user","global")

    /**
     * Retrieves shared state for the key.
     * Scope can be "user" (default) or "global".
     */
    getSharedState: function(stateKey: !string, scope: string enum("user", "global")="user"): any py

    /**
     * Stores or updates shared state for the key.
     * Scope can be "user" (default) or "global". Natives such as native python objects, should be serialized before setting.
     */
    setSharedState: function(stateKey: !string, state: !any, scope: string enum("user", "global")="user"): Genai.Agent.SharedState py

    /**
     * Lists shared state keys for a given scope.
     * Scope can be "user" (default) or "global".
     */
    listSharedStates: function(limit: int=-1, scope: string enum("user", "global")="user"): [string] py
}
