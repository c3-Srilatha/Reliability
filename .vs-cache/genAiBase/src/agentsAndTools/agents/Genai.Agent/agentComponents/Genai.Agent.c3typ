/**
 * A Genai.Agent is responsible for answering a user query by using one or more of the tools
 * in its toolkit specified in {@link Genai.Agent.Config#toolkitName}.
 */
abstract type Genai.Agent<AC> mixes Named, Configurable<AC: Config> {
  /**
   * Initialize the agent.
   * @param forceReload
   *           If true, all configs and setup will be re-run (instead of reusing already-loaded values)
   * @return The native python globals set during initialization.
   */
  initialize: abstract member function(forceReload: boolean): native py

  /**
   * The main agent API, `run` takes both the input it is supposed to respond to and the 'in progress' result that will
   * be updated as the agent handles the input.
   * @param input
   *           The input query.
   * @param inProgressResult
   *           The {@link Genai.Query.Result} being processed.
   * @param streamResponse
   *           If true, the tool should stream its response to the client
   * @return The query result
   */
  // Question: should Agent be more abstract and the GAIR be part of an abstract subclass QueryAgent?
  run: abstract member function(input: !any,
                                inProgressResult: !Genai.Query.Result,
                                streamResponse: boolean
                              ): !stream<string> | !Genai.Query.Result py-query_orchestrator

  /**
   * The function to query from the planner. For {@link Genai.Agent.Dynamic} do {@link Genai.Agent.Dynamic#run}.
   */
  query: abstract member function(inProgressResult: !Genai.Query.Result, input: any): !Genai.Query.Result py-query_orchestrator
}
