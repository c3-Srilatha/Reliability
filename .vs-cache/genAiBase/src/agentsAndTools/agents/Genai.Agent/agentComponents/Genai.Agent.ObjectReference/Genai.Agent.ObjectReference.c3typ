/**
 * Framework for managing and serializing different types of Python objects—like data tables, text, arrays,
 * and charts—so they can be easily displayed, transferred, or combined. It allows objects to be identified,
 * formatted, and converted to JSON for easy sharing or integration, supporting efficient handling of
 * structured data across various formats.
 */
type Genai.Agent.ObjectReference {


    /**
     * Uses an ObjectReferenceManager to get data from each output {@link Genai.Agent.ObjectReference} and persist
     * the data for the UI.
     * @param targetOutput
     *     The output ObjectReferenceManager of the agent.
     * @param imageFilePath
     *    Optional parameter for path to save the image file.
     * @return A collection of persisted data entities
     */
    objectReferenceManagerToUi: function(targetOutput: !native, imageFilePath: string): ![Genai.Agent.DynamicData] py-query_orchestrator
}
