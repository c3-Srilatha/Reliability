/**
 * Enum type for supported filtering methods, i.e. methods when {@link EvalSpec#filter} is specified.
 */
enum type Genai.StructuredData.Spec.FilterOperationEnum {

    /** Not equal */
    NE = 'ne'

    /** Equal */
    EQ = 'eq'

    /** Less than */
    LT = 'lt'

    /** Greater than */
    GT = 'gt'

    /** Greater than or equal */
    GE = 'ge'

    /** Contains string */
    CONTAINS = 'contains'

    /** Starts with string */
    STARTS_WITH = 'startsWith'

    /** Ends with string */
    ENDS_WITH = 'endsWith'

    /** Some field exists */
    EXISTS = 'exists'
}
