/**
 * Enum type for supported ordering methods, i.e. methods when {@link EvalSpec#order} is specified.
 */
enum type Genai.StructuredData.Spec.OrderOperationEnum {

    /** Order return values in ascending order */
    ASCENDING = 'ascending'

    /** Order return values in descending order */
    DESCENDING = 'descending'
}
