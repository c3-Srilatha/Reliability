/**
 * Enum type for supported aggregation methods, i.e. methods when {@link EvalSpec#group} is specified.
 */
enum type Genai.StructuredData.Spec.AggregationEnum {

    /** Arithmetic sum */
    SUM = 'sum'

    /** Arithmetic average */
    AVG = 'avg'

    /** Maximum value */
    MAX = 'max'

    /** Minimum value */
    MIN = 'min'

    /** Mean value */
    MEAN = 'mean'

    /** Median value */
    MEDIAN = 'median'

    /** Count of values */
    COUNT = 'count'

    /** Aggregate by year */
    YEAR = 'year'

    /** Aggregate by month */
    MONTH = 'month'

    /** Aggregate by day */
    DAY = 'day'

    /** Aggregate by hour */
    HOUR = 'hour'
}
