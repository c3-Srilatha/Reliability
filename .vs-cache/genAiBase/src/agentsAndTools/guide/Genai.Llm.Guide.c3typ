// c3-analysis-disable c3-excessive-method-params -- functions must be refactored to use specs where possible

/**
 * Util functions for using the Guidance class to help constrain LLM outputs.
 * See genai/genAiBase/resource/code/c3genai/guidance/README.md for more details
 */
// TODO: GENAI-1440 add more functionality to this type
type Genai.Llm.Guide {
  /**
   * Returns an instance of the Guidance class configured for the standard configuration of
   * generate_next_token_with_logit_bias, generate_text, and tokenizer.
   *
   * @param generateTextKwargs
   *                    kwargs for generate_text
   * @param generateTokenKwargs
   *                    kwargs for generate_next_token_with_logit_bias
   * @param raiseErrorIfLogitBiasUsed
   *                    boolean flag indicating whether an error should be raised if logit biases are used.
   * @param modelConfigName
   *                     Name of {@link Genai.UnstructuredQuery.Engine.ModelConfig} that should be used
   */
  defaultEvalToolGuide: function(generateTextKwargs: map<string, any>,
                                generateTokenKwargs: map<string, any>,
                                raiseErrorIfLogitBiasUsed: boolean,
                                modelConfigName: string): !native py-query_orchestrator
}
