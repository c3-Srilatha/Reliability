/**
 * Config for {@link Genai.Llm.Guide} to define the model to use for guidance
 */
type Genai.Llm.Guide.Config mixes Named, DefaultInstance, Config, Genai.ParentConfig {

  inst: ~ js-rhino

  /**
   * Name of {@link Genai.UnstructuredQuery.Engine.ModelConfig} that should be used by the {@link Genai.Llm.Guide}.
   */
  modelConfigName: !string

  /**
   * Set the config with the specified name as the default for the app (via {@link Genai.Llm.Guide.DefaultConfig}).
   */
  setDefault: function(configName: !string) js-rhino

  childConfigFields: ~ js
}
