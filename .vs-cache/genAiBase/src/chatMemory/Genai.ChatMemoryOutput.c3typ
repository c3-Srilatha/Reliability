/**
 * This define the output of the chat memory that includes information for debugging.
 */
type Genai.ChatMemoryOutput {

  /**
   * The values of the spec used for the LLM model.
   */
  llmSpecUsed: map<string, any>

  /**
   * The values of the spec used for the LLM inference.
   */
  llmInferenceSpec: map<string, any>

  /**
   * The prompt filled with the values used for the LLM model.
   */
  promptFilled: string

  /**
   * The result of the chat memory method.
   */
  chatMemoryResult: !string
}
