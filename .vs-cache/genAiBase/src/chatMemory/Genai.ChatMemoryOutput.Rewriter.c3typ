/**
 * This defines the output of the chat memory that includes information for debugging and extra fields for rewriting.
 */
type Genai.ChatMemoryOutput.Rewriter mixes Genai.ChatMemoryOutput {

  /**
   * The original question.
   */
  originalQuestion: !string

  /**
   * The history of the conversation.
   */
  history: [string]
}
