/**
 * Feedback given to the linked {@link Genai.Query.Result}.
 */
entity type Genai.Query.Result.Feedback mixes Genai.Query.Result.BaseFeedback schema name 'GENAIRFDBK' {

  /**
   * The {@link Genai.Query.Result} the feedback is for.
   */
  generativeAiResult: !Genai.Query.Result
}
