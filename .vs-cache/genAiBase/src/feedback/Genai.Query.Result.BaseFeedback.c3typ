/**
 * Base feedback fields that are shared between {@link Genai.Query.Result.Feedback}
 * and {@link Genai.Query.Result.PassageFeedback}.
 */
type Genai.Query.Result.BaseFeedback {

  /**
   * Whether the {@link Genai.Query.Result} was helpful for the question asked.
   */
  helpful: !boolean

  /**
   * The user's comment, if any, about the result.
   */
  comment: string

  /**
   * Additional feedback options selected.
   */
  additionalFeedback: [string enum Genai.Query.Result.Feedback.Enum] schema name 'ADDFDBCK'

  /**
   * The step in the {@link Genai.Agent.DynamicTrajectory} that this feedback is associated with.
   */
  trajectoryStep: Genai.Agent.DynamicTrajectory.Step
}
