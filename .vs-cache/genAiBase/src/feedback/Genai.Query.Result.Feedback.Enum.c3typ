/**
 * Enum type for additional feedback options for a {@link Genai.Query.Result}.
 */
enum type Genai.Query.Result.Feedback.Enum {
  // positive options
  /**
   * Helpful status
   */
  HELPFUL = 'Helpful'

  /**
   * Accurate status
   */
  ACCURATE = 'Accurate'

  // negative options
  /**
   * Not helpful status
   */
  NOT_HELPFUL = 'Not Helpful'

  /**
   * Inacurate status
   */
  INACCURATE = 'Inaccurate'

  /**
   * Outdated status
   */
  OUTDATED = 'Outdated'

  /**
   * Harmful status
   */
  HARMFUL = 'Harmful'

  // common options
  /** With just a text summary */
  TEXT_SUMMARY = 'Text Summary'

  // options for unstructured query
  /** With an image */
  IMAGE = 'Image'

  /** With a table */
  TABLE = 'Table'

  // options for structured query
  /** From database */
  DATABASE_QUERY = 'Database Query'

  /** With a visualization */
  VISUALIZATION = 'Visualization'

  /** From an edited structured query spec */
  EDITED_STRUCTURED_QUERY_SPEC = 'Edited Structured Query Spec'
}
