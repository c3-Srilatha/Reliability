/**
 * Spec to persist feedback for a {@link Genai.Query.Result}.
 */
type Genai.Query.Result.Feedback.Spec {

  /**
   * The feedback for the generative model result.
   */
  feedback: string

  /**
   * The {@link Genai.Query.Result} the feedback is for.
   */
   // TODO: GEN-9667 should be `!boolean` (not an array)
  helpful: ![boolean]

  /**
   * The {@link Genai.Query.Result} the feedback is for.
   */
  result: Genai.Query.Result
}
