/**
 * A batch job for generating responses from an LLM.
 */
abstract extendable entity type Genai.Llm.BatchRequestJob {
  /**
   * The prompts passed to the LLM.
   */
  prompts: ![string]

  /**
   * The current state of the batch job.
   * @return the state as a string.
   */
  state: abstract member function(): !string py-query_orchestrator

  /**
   * Whether the batch job is done.
   * @return true if done, false otherwise.
   */
  completed: abstract member function(): !boolean py-query_orchestrator

  /**
   * Cancel the batch job.
   */
  cancel: abstract member function() py-query_orchestrator

  /**
   * Delete the LLM batch job. Use #remove to remove the entity.
   */
  delete: abstract member function() py-query_orchestrator

  /**
   * Retrieves the responses from the batch job when done. If the job is not done,
   * this will return an empty array of strings the length of the prompts.
   * @return the responses.
   */
  readResponses: abstract member function(): ![string] py-query_orchestrator

  /**
   * For debugging purposes, return a representation of the current state of the batch job.
   * @return details of the batch job as a string
   */
  details: abstract private member function(): string py-query_orchestrator
}
