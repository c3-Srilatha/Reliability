/**
 * Base type for configs for llm config from UI
 */
type Genai.Llm.CredentialConfig mixes Named, DefaultInstance, Config {
  /**
   * The default model name for Azure OpenAI.
   */
  azureDefaultModelName: !string

  /**
   * The default model name for AWS Bedrock.
   */
  awsDefaultModelName: !string

  /**
   * The default model name for Vertex AI.
   */
  vertexDefaultModelName: !string

  /**
   * The default timeout for LLM requests in seconds.
   */
  timeout: !int = 20

  inst: ~ js
}
