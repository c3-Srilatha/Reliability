/**
 * Configuration of OpenAI API.
 *
 * To configure the OpenAI API key:
 * cfg = Genai.Llm.OpenAI.Config.inst().getConfig()
 * cfg.setSecretValue('apiKey', <API_KEY_HERE>)
 */

type Genai.Llm.OpenAI.Config mixes Genai.Llm.ExternalLlm.Config {
    /**
     * The authentication key for the OpenAI API.
     */
    @config(secret=true)
    apiKey: !string

    /**
     * The API type.
     */
    apiType: !string

    /**
     * The API base.
     */
    apiBase: !string

    /**
     * The API version.
     */
    apiVersion: !string

    /**
     * Sets up openai credentials specified by this in two ways:
     *      1. the env variables for OPENAI_API_KEY, OPENAI_API_TYPE, OPENAI_API_BASE, and OPENAI_API_VERSION.
     *      2. on the openai python library (if it exists in the calling runtime)
     */
    setupCredentials: ~ py
}
