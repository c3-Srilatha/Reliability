/**
 * Defines the specs for the cretion of config base in {@link Genai.Llm.ExternalLlm.Config}.
 */
type Genai.Llm.CredentialSpec mixes Spec {

  /**
   * The name of the API key.
   */
  name: !string

  /**
   * The provider of the API key.
   */
  provider: !string enum Genai.Llm.CredentialProviderEnum

  /**
   * The configuration for the API key.
   * eg. {fielName: {value: "value", secret: false}}
   */
  authFields: !json

}
