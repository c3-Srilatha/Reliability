/**
 * A batch job for generating responses from a Azure OpenAI LLM.
 *
 * See {@link https://learn.microsoft.com/en-us/azure/ai-services/openai/how-to/batch?tabs=standard-input&pivots=programming-language-python#create-batch-job}
 *
 * Genai.Llm.AzureOpenAI.BatchRequestJob will use the credentials set on {@link Genai.Llm.OpenAI.Config}
 * `batch` if they are set instead of the credentials set on the default {@link Genai.Llm.OpenAI.Config#inst}.
 */
entity type Genai.Llm.AzureOpenAI.BatchRequestJob extends Genai.Llm.BatchRequestJob type key "AZURE" {
  /**
   * Called by process_batch, this function uses the py-llmguard runtime to create a Azure OpenAI batch job.
   */
  createBatchJob: private function(modelName: !string,
    maxTokens: !int,
    temperature: !double,
    prompts: ![string]): !Genai.Llm.AzureOpenAI.BatchRequestJob py-llmguard

  state: ~ py-llmguard
  completed: ~ py-llmguard
  cancel: ~ py-llmguard
  delete: ~ py-llmguard
  readResponses: ~ py-llmguard
  details: ~ py-llmguard

  @dependency(include="this")
  beforeRemove: ~ py-llmguard
}
