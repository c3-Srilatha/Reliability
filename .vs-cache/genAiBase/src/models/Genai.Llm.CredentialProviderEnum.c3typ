/**
 * This enum list the diferent llm providers
 */
enum type Genai.Llm.CredentialProviderEnum {

  /**
   * The type related to the configuration of AWS Bedrock.
   */
  AWS_BEDROCK = 'Genai.Llm.AwsBedrock.Config'

  /**
   * The type related to the configuration of Azure OpenAI Api.
   */
  AZURE = 'Genai.Llm.OpenAI.Config'

  /**
   * The type related to the configuration of GCP LLMs.
   */
  VERTEX_AI = 'Genai.Llm.Gcp.Config'

}
