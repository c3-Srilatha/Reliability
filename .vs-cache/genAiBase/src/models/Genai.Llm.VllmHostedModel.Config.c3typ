/**
 * Configuration of Vllm Hosted Model.
 *
 * To configre Vllm Hosted Model:
 * cfg = Genai.Llm.VllmHostedModel.Config.inst().getConfig()
 * cfg.setSecretValue('endpoint', <SECRET_ENDPOINT>)
 */

type Genai.Llm.VllmHostedModel.Config mixes Genai.Llm.ExternalLlm.Config {

    /**
     * The secret endpoint to send POST request to.
     */
    @config(secret=true)
    endpoint: !string
}
