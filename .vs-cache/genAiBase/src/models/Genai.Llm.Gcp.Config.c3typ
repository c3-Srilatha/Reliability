/**
 * Configuration of GCP LLMs.
 *
 * To configure:
 * cfg = Genai.Llm.Gcp.Config.inst().getConfig()
 * cfg.setConfigValue('project', '<PROJECT_ID>');
 * cfg.setConfigValue('location', '<REGION>');
 * cfg.setSecretValue('serviceAccountInfo', <SERVICE_ACCOUNT_INFO>)
 */

type Genai.Llm.Gcp.Config mixes Genai.Llm.ExternalLlm.Config {
    /**
     * The authentication key for the service account.
     */
    @config(secret=true)
    serviceAccountInfo: !string

    /**
     * The Google Cloud Project ID or number.
     */
    project: !string

    /**
     * The Vertex AI region.
     */
    location: !string

    /**
     * Optional safety settings override. See https://ai.google.dev/gemini-api/docs/safety-settings
     * Use the string values of the key and value, for example
     * ```
     * {
     *   'HARM_CATEGORY_HATE_SPEECH': 'BLOCK_LOW_AND_ABOVE',
     *   'HARM_CATEGORY_HARASSMENT': 'BLOCK_LOW_AND_ABOVE',
     * }
     * ```
     */
    safetySettings: json

    /**
     * Calls google.cloud.platform.init() with this config's credentials.
     */
    setupCredentials: ~ py

    /**
     * Constructs a Vertex AI client with this config's credentials.
     *
     * @param modelName
     *        The name of the model to instantiate the client for.
     */
    instantiateClient: member function(modelName: !string): any py

    /**
     * Constructs from #safetySettings (if specified) the dict to pass with requests. Used internally when making
     * requests to Google LLMs.
     */
    getSafetySettings: member function(): native py
}
