/**
 * Configuration of AWS Bedrock.
 *
 * To configre AWS Bedrock:
 * cfg = Genai.Llm.AwsBedrock.Config.inst().getConfig()
 * cfg.setSecretValue('secret_access_key', <SECRET_ACCESS_KEY>)
 */

type Genai.Llm.AwsBedrock.Config mixes Genai.Llm.ExternalLlm.Config {
  /**
   * The AWS region.
   */
  region: !string

  /**
   * The URL to use for the constructed boto3 client.
   */
  endpoint: !string

  /**
   * The access key id for the boto3 client.
   * Yes, we have a #secretAccessKey already, but it's best to also make this a secret.
   */
  @config(secret=true)
  accessKeyId: !string

  /**
   * The secret access key for the boto3 client.
   */
  @config(secret=true)
  secretAccessKey: !string

  /**
   * Constructs a boto3 client with this config's credentials.
   * The client is connected to the AWS Bedrock service.
   *
   * @param botoClientConfig
   *        This should be a botocore.config.Config object to override any defaults if desired.
   *        See {@link https://botocore.amazonaws.com/v1/documentation/api/latest/reference/config.html#botocore-config}
   */
  instantiateClient: member function(botoClientConfig: native): any py
}
