/**
 * Contains functions to help write UI tests.
 */
@typeScript
type ReliabilityUiTestUtil {

  /**
   * A test helper function that allows logging the outputted actions of an epic. It is meant to be utilized
   * with {@link UiSdlSpecHelper#expectObservable} to do snapshot testing of an epic. Utilizing this function
   * will log the outputted actions of the epic to the console in a format that can be copied and pasted into
   * the test file. Tests should not be pushed with this function being used.
   *
   * Usage instructions:
   * - Import this function into your test.
   * - Wrap the epic you are testing with this function. Don't worry about the output for now. See example below.
   * - Run the test, and open your console.
   * - Copy the last output as the output actions into your test. Note that this won't copy
   *   the fields that are set to `undefined`, so you will need to manually add those in, or utilize
   *   jasmine's `jasmine.objectContaining` to match the output.
   * - Remove the `logOutputActionMapForEpic` function from the epic.
   * ```
   * SpecHelper.expectObservable(
   *    done,
   *    {
   *      epic: logOutputActionMapForEpic(epic, 'c'),
   *      input: ['ab', { a: this.action }],
   *      output: ['--cde', {}],
   *    },
   *    {
   *      value: this.state,
   *    }
   * );
   *
   * ```
   *
   * @param epic
   *        The epic to log the outputted actions of.
   * @param startingChar
   *        The starting character that will be used to key the actions. For example, if your epic outputs 3 actions
   *        and your starting character is "c", the actions will be keyed to "c", "d", and "e" respectively.
   * @returns An epic that shares the same behavior as the inputted epic, but logs the outputted actions to the console.
   */
  logOutputActionMapForEpic: function(epic: UiSdlEpic, startingChar: string = 'b'): UiSdlEpic ts-client

  /**
   * A test helper function that allows extracting action objects from an observable.
   * It is meant to be used when testing functions which are not epics but still return an observable.
   * Utilizing this returns an array of actions.
   *
   * Usage Instructions -
   * - Import this function in your test.
   * - Get the observable and pass it to this function.
   * - Run the test.
   *
   * @param observable
   *        The observable to get the actions from.
   * @returns An array of actions
  */
  getActionsFromAnObservable: function(observable: UiSdlActionsObservable): Array ts-client

}
