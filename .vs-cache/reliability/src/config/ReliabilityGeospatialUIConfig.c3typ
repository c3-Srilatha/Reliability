/**
 * Configuration options for the Geospatial Assets Map Page.
 */
type ReliabilityGeospatialUIConfig mixes Singleton, Config {

  /**
   * Flag to determine if the UI should show the Geospatial Assets Map Page.
   */
  showGeospatialAssetsMapUIFlow: boolean = false

  /**
   * The access token for Google Photorealistic 3D tiles.
   */
  googlePhotorealisticAccessToken: string

  /**
   * If true, {@link UiGeospatialAssetsMap} will use #googlePhotorealisticAccessToken to enable Google Photorealistic
   * 3D tiles.
   */
  enableGooglePhotorealisticTiles: boolean = false

  /**
   * The style of the 2D map in the {@link UiGeospatialAssetsMap}.
   */
  geospatialMap2DStyle: string enum('dark', 'light')

  /**
   * The default visualization mode for the {@link UiGeospatialAssetsMap}.
   */
  defaultMapVisualizationMode: string serialized UiGeospatialAssetsMapVisualizationType = '3d'

  /**
   * The default enabled badge positions for the {@link UiGeospatialAssetsMap}.
   */
  defaultEnabledBadgePositions: [string] = ['bottom-right']
}
