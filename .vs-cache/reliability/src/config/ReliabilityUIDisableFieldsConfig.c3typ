/**
 * Configurations for Reliability application UI where we can set fields to be disabled and mark un-editable by users.
 * Here is an example of how you can set values within this config:
 *
 * ReliabilityUIDisableFieldsConfig.inst().setConfigValue(
 *     'disabledConfigFields',
 *         C3.Map.fromJson({
 *             "type": "map<string, any>",
 *             "ReliabilityMLConfig": ['reliabilityRiskMLProjectId']
 *           })
 *     )
 */
type ReliabilityUIDisableFieldsConfig mixes Singleton, Config {

  /**
   * The mapping for disabling fields in the UI for Implementation form configs
   * For each entry within map:
   * key = Form config name eg. 'ReliabilityMLConfig'
   * value = Collection of fields from this config which should be disabled on the UI eg. ['reliabilityRiskMLProjectId']
   */
  disabledConfigFields: map<string, [string]>
}
