/**
 * Configuration for one component in a {@link UiSdlProcessFlowDiagram}.
 */
entity type ProcessDiagramConfig schema name "PRCSDGMCFG" {

  /**
   * The parent asset that represents the whole process flow diagram.
   */
  parentAsset: PhysicalAsset

  /**
   * The component asset that represents one component in the process flow diagram.
   */
  componentAsset: PhysicalAsset

  /**
   * The X-coordinate (in percentage) of the left side of the tooltip bounding box.
   * 0% is the left of the image, 100% is the right of the image.
   */
  left: double

  /**
   * The Y-coordinate (in percentage) of the top side of the tooltip bounding box.
   * 0% is the top of the image, 100% is the bottom of the image.
   */
  top: double

  /**
   * The width (in percentage) of the tooltip bounding box.
   */
  width: double

  /**
   * The height (in percentage) of the tooltip bounding box.
   */
  height: double

  /**
   * The x-coordinate (in percentage) of the colored dot. 0% is the left of the image, 100% is the right of the image.
   */
  dotX: double

  /**
   * The y-coordinate (in percentage) of the colored dot. 0% is the top of the image, 100% is the bottom of the image.
   */
  dotY: double
}
