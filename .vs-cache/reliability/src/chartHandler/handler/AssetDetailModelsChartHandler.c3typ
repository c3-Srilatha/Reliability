/**
 * Handles query data and returning a chart configuration for the Asset Detail Models page.
 */
type AssetDetailModelsChartHandler {

  /**
   * Queries the data for the Asset Detail Models page and returns a chart configuration
   * to render a {@link UiApTimeseriesChart}.
   *
   * @param filterSpec The filter spec containing the selected values from the Asset Detail Models filter panel.
   * @param chartSpec The chart spec containing the configuration for the chart.
   * @returns A {@link UiApTimeseriesChartConfig} that can be used to render the chart.
   */
  getChartConfig: inline function (
    filterSpec: AssetDetailModelsChartSpec,
    chartSpec: UiApTimeseriesChartSpec
  ): UiApTimeseriesChartConfig js-rhino

  /**
   * Creates a render configuration for the {@link UiApTimeseriesChart} based on the provided chart spec
   * and query keys.
   *
   * @param chartSpec The chart spec containing the configuration for the chart.
   * @param queryKeys The keys used previously to query the data for the chart. This is stored on the chart
   *                 configuration to avoid having to query the data again.
   * @returns A {@link UiApTimeseriesChartRenderConfig} that can be used to render the chart.
   */
  createRenderConfig: inline function (
    chartSpec: UiApTimeseriesChartSpec,
    queryKeys: map<string, [string]>
  ): UiApTimeseriesChartRenderConfig js-rhino
}
