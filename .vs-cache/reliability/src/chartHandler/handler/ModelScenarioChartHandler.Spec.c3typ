/**
 * Query specifications for the {@link ModelScenarioChartHandler#getChartConfig}.
 */
type ModelScenarioChartHandler.Spec mixes Spec {

  /**
   * The {@link ReliabilityMlModel} for which the chart data is requested.
   */
  model: !ReliabilityMlModel

  /**
   * The start datetime for the chart data.
   */
  start: !datetime

  /**
   * The end datetime for the chart data.
   */
  end: !datetime

  /**
   * The {@link Interval} for the chart data.
   */
  interval: !Interval

  /**
   * The list of {@link Feature}s to be included in the chart.
   */
  selectedFeatures: ![string serialized Feature]

  /**
   * Map of overridden features and their value generators.
   * The key is the {@link Feature#id}, and the value is a {@link ReliabilityMlModelScenario.ValueGenerator}
   * that will generate the {@link Timeseries} data for it.
   */
  overriddenFeatures: map<string serialized Feature, ReliabilityMlModelScenario.ValueGenerator>
}
