/**
 * Handles query data and returning a chart configuration for the Analysis Page.
 */
type AnalysisChartHandler {

  /**
   * Queries the data for the Analysis Chart and returns a chart configuration
   * to render a {@link UiApTimeseriesChart}.
   *
   * @param filterSpec The filter spec containing the selected values from the Analysis page filter panel.
   * @param chartSpec The chart spec containing the configuration for the chart.
   * @returns A {@link UiApTimeseriesChartConfig} that can be used to render the chart.
   */
  getChartConfig: inline function (
    filterSpec: AnalysisPageFilterPanelSpec,
    chartSpec: UiApTimeseriesChartSpec
  ): UiApTimeseriesChartConfig js-rhino

  /**
   * Creates a render configuration for the {@link UiApTimeseriesChart} based on the provided chart spec
   * and query keys.
   *
   * Builds the render configuration for the analysis chart, including plots and series.
   *
   * Chart splitting and plotting logic:
   *
   * - If splitCharts is true:
   *     - For each asset:
   *         - Creates a model outputs plot (e.g., "asset1_modelOutputs") containing only non-feature-specific model outputs.
   *         - Creates a plot for each feature input (e.g., "asset1_feature1_inputs").
   *             - Plots the feature input value and any feature-specific model outputs (e.g., reconstructions) for that feature.
   *         - Event series for the asset are added to all plots for that asset (model outputs and feature input plots).
   *     - Separate plots are created for sensors ("sensors") and metrics ("metrics") if they exist.
   *     - If splitCharts is false, analysis chart contains a single plot with all series.
   *
   * - If splitCharts is false:
   *     - All series (model outputs, feature-specific outputs, feature inputs, sensors, metrics, and events) are plotted on the single analysis plot.
   *
   *
   * @param projectId The {@link ReliabilityMl.Project} to query for the chart data.
   * @param chartSpec The chart spec containing the configuration for the chart.
   * @param queryKeys The keys used previously to query the data for the chart. This is stored on the chart
   *                 configuration to avoid having to query the data again.
   * @returns A {@link UiApTimeseriesChartRenderConfig} that can be used to render the chart.
   */
  createRenderConfig: inline function (
    projectId: string serialized ReliabilityMl.Project,
    chartSpec: UiApTimeseriesChartSpec,
    queryKeys: map<string, [string]>
  ): UiApTimeseriesChartRenderConfig js-rhino

  /**
   * The color of the alert event.
   */
  ALERT_COLOR: const string = '#EB0202';

  /**
   * Calculates the appropriate interval based on time range and minimum data points.
   * Uses {@link ReliabilityUIConfig#minDataPointsForAutoInterval} as default for minDataPoints if not provided.
   * Selects the coarsest interval that still provides at least the minimum number of data points.
   *
   * @param start
   *        The start time of the range.
   * @param end
   *        The end time of the range.
   * @param minDataPoints
   *        The minimum number of data points desired. If not provided, defaults to
   *        {@link ReliabilityUIConfig#minDataPointsForAutoInterval}.
   * @returns
   *        The appropriate interval enum value.
   */
  calculateIntervalForMinDataPoints: function(start: !datetime, end: !datetime, minDataPoints: int): !string enum Interval js-rhino
}
