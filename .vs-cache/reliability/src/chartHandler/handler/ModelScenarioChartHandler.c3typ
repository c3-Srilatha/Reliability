/**
 * Handles query data and returning a chart configuration for the Model Scenario Chart.
 */
type ModelScenarioChartHandler {

  /**
   * The {@link Color} used to render the scenario shadow in the Model Scenario Chart.
   */
  SCENARIO_SHADOW_COLOR: const string = '#82B0FF1A'

  /**
   * Helper function that returns a chart configuration for the Model Scenario Chart.
   *
   * @param spec
   *        The query data specification, like {@link TimeRange}, {@link Feature}s, etc.
   * @return The chart configuration that can be used to render the chart.
   */
  getChartConfig: function (spec: ModelScenarioChartHandler.Spec): UiApTimeseriesChartConfig py-data

  /**
   * Helper function that retrieves {@link Feature}s data from the given {@link ReliabilityMlModel} and
   * {@link TimeRange} as a CSV string.
   *
   * Example of the CSV string returned:
   * ```
   * | timestamp           | feature1 | feature2 | feature3 |
   * |---------------------|----------|----------|----------|
   * | 2023-01-01T00:00:00 | 1.0      | 2.0      | 3.0      |
   * | 2023-01-01T00:01:00 | 1.1      | 2.1      | 3.1      |
   * | 2023-01-01T00:02:00 | 1.2      | 2.2      | 3.2      |
   * ```
   *
   * @param model The model for which to retrieve feature data.
   * @param timeInfo The {@link TimeRange} and {@link Interval} for which to retrieve feature data.
   *
   * @return A CSV string containing the feature data.
   */
  getFeatureDataAsCSV: function(model: !ReliabilityMlModel, timeInfo: !TimeInfo): string py-data

  /**
   * Helper function that converts the given CSV data into a map of {@link Feature}s and
   * {@link ReliabilityMlModelScenario.ValueGenerator.Manual}.
   *
   * Example of the input CSV string and the resulting map:
   * ```
   * | timestamp           | feature1 | feature2 | feature3 |
   * |---------------------|----------|----------|----------|
   * | 2023-01-01T00:00:00 | 1.0      | 2.0      | 3.0      |
   * | 2023-01-01T00:01:00 | 1.1      | 2.1      | 3.1      |
   * | 2023-01-01T00:02:00 | 1.2      | 2.2      | 3.2      |
   * ```
   *
   * The resulting map will look like this:
   * ```json
   * {
   *   "feature1": {
   *     "type": "ReliabilityMlModelScenario.ValueGenerator.Manual",
   *     "data": [1.0, 1.1, 1.2]
   *   },
   *   "feature2": {
   *     "type": "ReliabilityMlModelScenario.ValueGenerator.Manual",
   *     "data": [2.0, 2.1, 2.2]
   *   },
   *   "feature3": {
   *     "type": "ReliabilityMlModelScenario.ValueGenerator.Manual",
   *     "data": [3.0, 3.1, 3.2]
   *   }
   * }
   * ```
   *
   * **NOTE**: The input columns will be filtered to only include those that are present in the
   *           [model features](ModelFeaturesFetchHelper#getFeatureNamesForModel)
   *
   * @param csv_data The CSV data as a string.
   * @param interval The interval for which the data is being converted.
   *
   * @return A {@link Map} where the keys are the {@link Feature#id}s and the values are instances of
   *         {@link ReliabilityMlModelScenario.ValueGenerator.Manual}.
   *         **NOTE**: Using `json` as the value type to keep the `type` field in the UI.
   */
  convertCsvToValueGenerators: function(
    csv_data: !string,
    interval: !string serialized Interval): Pair<TimeRange, map<string serialized Feature, json>> py-data

  /**
   * Aligns the given {@link TimeInfo} to the specified interval, ensuring that the start and end times
   * are aligned to the interval boundaries.
   *
   * @param timeInfo The {@link TimeInfo} to align.
   * @return A new {@link TimeInfo} with the start and end times aligned to the specified interval.
   */
  alignTimeRangeToInterval: function(timeInfo: !TimeInfo): TimeInfo py

  /**
   * Private function that constructs a pandas `DataFrame` with the {@link Feature}s data for the given
   * {@link ModelScenarioChartHandler.Spec}.
   *
   * **NOTE**: It is ensured that the `DataFrame` contains the index `timestamp` column for the given start/end time.
   *           So if there are no feature data for the given time range, the `DataFrame` will be filled with zeros.
   *
   * @param spec
   *        The {@link TimeInfo} for which to retrieve feature data, including the time range and interval.
   * @param model
   *        The {@link ReliabilityMlModel} for which to retrieve feature data.
   * @param featureNames
   *        The list of {@link Feature#id}s to include in the `DataFrame`.
   * @return A pandas `DataFrame` containing the feature data.
   */
  getDataFrameData: private function (
    spec: !TimeInfo,
    model: !ReliabilityMlModel,
    featureNames: [string]): native py-data
}
