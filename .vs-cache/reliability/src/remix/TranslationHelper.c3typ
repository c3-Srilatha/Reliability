/**
 * Helper type that allows for the fetching/getting of backend data, while also returning translated text.
 * Intended to allow transforms access to translations. Additionally, it allows the creation of testing translations and
 * enables testing mode across the application. This feature is useful for validating how translations appear in the UI,
 * ensuring proper formatting, and verifying that all translatable elements are correctly localized.
 */
remix type TranslationHelper {

  /**
   * Generates a CSV file containing translations based on English source strings,
   * with each translation value wrapped in `<<` at the beginning and `>>` at the end.
   * The generated translations use a different locale (hindi locale - `hi`, only used for testing) to
   * simulate localized content.
   * To identify translated text, it must either include the specified prefix and suffix or be displayed
   * using the Hindi locale (this applies to dates and numbers).
   *
   * Example(s):
   *
   * 1.CSV translations:
   * - English: `en.Reliability.Example,en,Reliability.Example,Example`
   * - Testing: `hi.Reliability.Example,hi,Reliability.Example,<<Example>>`
   *
   * 2.JSON translations
   * - English:
   * ```json
   *  {
   *    "id": "en.Reliability.Example.text",
   *    "locale": "en",
   *    "key": "Reliability.Example.text",
   *    "value": "Example\n"
   *  },
   *  ```
   * - Testing
   *  ```json
   *  {
   *    "id": "hi.Reliability.Example.text",
   *    "locale": "hi",
   *    "key": "Reliability.Example.text",
   *    "value": "<<Example\n>>"
   *  }
   *  ```
   *
   * **Note:**: the generated file **must** be saved in the `/metadata/Translations` directory
   * to be recognized and used as testing translations by the system.
   *
   * Returns:
   * ```js
   * TranslationHelper.createTestingTranslations()
   * ```
   * ```json
   *  {
   *     "csv_translations": "<url of the generated csv translations file>",
   *     "json_translations": "<url of the generated json translations file>",
   *  }
   * ```
   *
   * @returns
   *   The URLs for the generated translation files in JSON (new line translations) and CSV formats.
   */
  createTestingTranslations: function(): json py

  /**
   * Enables or disables the translations testing mode across the application.
   *
   * **Note:** testing translations must already be defined using the corresponding
   * CSV translations file before enabling this mode.
   *
   * @param mode
   *   A flag indicating whether to enable (`true`) or disable (`false`) testing mode.
   */
  setTestingMode: function(mode: !boolean) js-rhino

  /**
   * Helper method that retrieves the {@link Translation} key that corresponds
   * to the value.
   *
   * The format of the key is as follows: `Reliability.TranslationValue`, where:
   * - `Reliability`: is the fixed package name.
   * - `value`: is the value to be converted to camel case, excluding spaces and underscore.
   *
   * **Note** that the key must be already defined in the translation files for "es", "en" and "pt"
   * {@link Locale}s.
   *
   * Examples:
   * ```js
   * getDynamicTranslationKey('CANDIDATE')
   * > 'Reliability.Candidate'
   *
   * getDynamicTranslationKey('FIVE_MINUTE')
   * > 'Reliability.FiveMinute'
   *
   * getDynamicTranslationKey('Five Minute')
   * > 'Reliability.FiveMinute'
   * ```
   *
   * @param value
   *   The value to match with an existing key in the translation files.
   *
   * @returns
   *   The {@link Translation} key associated with the value.
   */
  getDynamicTranslationKey: inline function(value: !string): !string js-rhino
}
