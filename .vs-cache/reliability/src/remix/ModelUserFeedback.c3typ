/**
 * Remix to get the translation on {@link ModelUserFeedback#category}, {@link ModelUserFeedback#suggestion} and
 * {@link ModelUserFeedback#validationStatus} fields that need translation on the UI depending on the
 * {@link Locale#language} selected
 */
remix type ModelUserFeedback {

  /**
   * **DISPLAY USE ONLY**
   *
   * The translated value of {@link #category}.
   */
  translatedCategory: string translate by category

  /**
   * **DISPLAY USE ONLY**
   *
   * The translated value of {@link #suggestion}.
   */
  translatedSuggestion: string translate by suggestion

  /**
   * **DISPLAY USE ONLY**
   *
   * The translated value of {@link #validationStatus}.
   */
  translatedValidationStatus: string translate by validationStatus
}
