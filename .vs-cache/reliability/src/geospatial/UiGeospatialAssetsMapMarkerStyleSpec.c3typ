/**
 * Definition on how to extract data to style {@link ReliabilityAsset} markers.
 */
@typeScript
type UiGeospatialAssetsMapMarkerStyleSpec mixes Spec {

  /**
   * Defines from where to extract the icon to use for the marker.
   *
   * **NOTE**: It should be part of `Font Awesome 6 Pro` icons.
   */
  iconField: string

  /**
   * Configuration for how to colorize the overlay of the marker.
   */
  overlayColorMappingConfig: UiGeospatialAssetsMapOverlayMappingSpec

  /**
   * Configuration for how to display badges on the marker.
   *
   * **NOTE:** The configuration will be applicable to all the markers.
   */
  badgesConfig: [UiGeospatialAssetsMapBadgesSpec]

  /**
   * Whenever to include 3D Models, this should be populated with the path to the model.
   */
  enable3DModels: boolean = false

  /**
   * Model path to use for the 3D model. (Use when `enable3DModels` is set to `true`)
   */
  modelField: string
}
