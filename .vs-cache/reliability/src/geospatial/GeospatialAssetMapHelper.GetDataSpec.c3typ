/**
 * Spec holding options for retrieving data for the geospatial asset map.
 */
type GeospatialAssetMapHelper.GetDataSpec mixes Spec {

  /**
   * Filter to apply to the assets.
   */
  assetsFilter: string serialized Filter

  /**
   * List of selected [facilities](Facility) as a string.
   *
   * **NOTE**: This is required since UI sends the selected facilities as a string.
   */
  selectedFacilities: string serialized Array<Facility>
}
