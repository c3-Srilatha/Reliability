/**
 * Enables Tooltip configuration when hovering a {@link ReliabilityAsset} marker.
 */
@typeScript
type UiGeospatialAssetsMapTooltipSpec mixes Spec {

  /**
   * Specific title label to use, if not provided it will use the `name` of the hovered [asset](ReliabilityAsset).
   */
  title: string

  /**
   * Subtitle label to use, if not provided it will show the {@link ReliabilityAsset#geoLocation}.
   */
  subtitle: string

  /**
   * List of [fields](UiGeospatialAssetsMapTooltipFieldSpec) to display as a collection of `label - field value`.
   */
  fields: [UiGeospatialAssetsMapTooltipFieldSpec]
}
