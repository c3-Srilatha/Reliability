/**
 * The specification of data retrieval for instances of the {@link UiGeospatialAssetsMap} component type.
 */
@typeScript
type UiGeospatialAssetsMapDataSpec mixes UiSdlComponentDataSpec {

  /**
   * [Tooltip](UiGeospatialAssetsMapTooltipSpec) configuration.
   */
  tooltipConfig: UiGeospatialAssetsMapTooltipSpec

  /**
   * [Clustering](UiGeospatialAssetsMapClusteringSpec) configuration.
   */
  clusteringConfig: UiGeospatialAssetsMapClusteringSpec

  /**
   * Geospatial [Markers](UiGeospatialAssetsMapMarkerStyleSpec) configuration.
   */
  markerStyleConfig: UiGeospatialAssetsMapMarkerStyleSpec

  /**
   * Map [legends](UiGeospatialAssetsMapLegendsSpec) configuration.
   */
  legendsConfig: UiGeospatialAssetsMapLegendsSpec
}
