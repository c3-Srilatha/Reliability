/**
 * Contains Util functions for Model Config UI.
 */
@typeScript
type MetricConfigUtil {

  /**
   * Helper function that builds the element that will be added to the code editor, according to the data type that it has.
   * There are three types of data that can be added to the code editor: Sensor, ReliabilityMetric and ReliabilityFunction.
   * For each type of data this is the way that the element will be built:
   * - Sensor: sensor('data')
   * - ReliabilityMetric: data
   * - ReliabilityFunction: data
   * @param data
   *        The value of the item that will be added to the code editor
   * @param dataType
   *        The type of the data that will be added to the code editor
   * @returns a string formatted according to the data type
   */
  buildElementByDataType: private function(
    data: !string,
    dataType: !string
  ): !string ts-client

  /**
   * Function that parse each item that will be added to the code editor, according to the data type that it has.
   * There are three types of data that can be added: {@link Sensor}, {@link ReliabilityMetric} and
   * {@link ReliabilityFunction}.
   * @param codeEditorValue
   *        The current value of the code editor
   * @param data
   *        The item or items that will be added to the code editor
   * @param dataType
   *        The type of the data that will be added to the code editor
   * @returns the new value of the code editor
   */
  addItemToCodeEditor: function(
    codeEditorValue: !string,
    data: !([string] | string),
    dataType: !string
  ): !string ts-client
}
