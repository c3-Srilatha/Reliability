/**
 * The input spec to {@link ReliabilityMockData#setupMlProjectAgnosticModel}.
 */
type ReliabilityMockDataSetupMlProjectAgnosticModelSpec {

  /**
   * The asset to create the model on
   */
  asset: ReliabilityAsset

  /**
   * The project to create the model for.
   */
  project: ReliabilityMl.Project

  /**
   * The template to use for the model.
   */
  template: ModelTemplate

  /**
   * The start of the dataset to train the model on.
   */
  datasetStart: datetime

  /**
   * The end of the dataset to train the model on.
   */
  datasetEnd: datetime

  /**
   * The interval of the dataset to train the model on.
   */
  datasetInterval: Interval

  /**
   * The start of the time range to perform inference and alert generation for.
   */
  inferenceStart: datetime

  /**
   * The end of the time range to perform inference and alert generation for.
   */
  inferenceEnd: datetime
}
