/**
 * This type specifies the configurable parameters available for {@link ReliabilityMockData}.
 * Note that introducing any new configurable fields should be done very thoughtfully as having
 * too many configurable options can make it difficult to understand which configuration
 * combination one should be using to load mock data.
 */
type ReliabilityMockDataSpec mixes Spec {

  /**
   * The number of {@link Facility} to generate data for.
   */
  numFacility: int = 1
}
