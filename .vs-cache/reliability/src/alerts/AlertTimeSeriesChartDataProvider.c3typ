/**
 * Implements the logic to retrieve the chart and filter panel data for a residual alert.
 */
type AlertTimeSeriesChartDataProvider {
  /**
   * Returns the chart configuration and filter panel field values for the specified residual alert.
   *
   * @param alertId The ID of the residual alert.
   * @param numFeaturesLimit The maximum number of features to include in the chart.
   * @param uiTimeZone The time zone to use for displaying times in the chart.
   * @return An {@link TimeSeriesChartAndFilterPanelData} object containing the chart configuration and filter panel field values.
   */
  getAlertChartAndFilterPanelData: inline function (alertId: string, numFeaturesLimit: int, uiTimeZone: string): AlertTimeSeriesChartAndFilterPanelData js-rhino;
}
