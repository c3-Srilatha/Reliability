/**
 * Condition used to determine whether the current value definition list in the edit Hyperparameter Modal
 * should be displayed or not. If the hyperparam type is 'json' then the current value definition list will not be shown.
 */
@typeScript
type EditHyperparamsDefinitionListConditionalRenderer mixes UiSdlRenderCondition {

  useCondition: ~
}
