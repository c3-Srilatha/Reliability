/**
 * Type to fetch chart config for `Reliability.CloningModelSensorPreviewChart`.
 */
type ModelCloningChartHelper mixes ChartHelper<ModelCloningChartHelperSpec> {
  /**
   * Gets the chart configurations for the `Reliability.CloningModelSensorPreviewChart`
   */
  getChartConfigs: ~

  /**
   * Obtains the {@link TimeRange}s to be excluded from model training given a set of conditions
   * or user-selected dates from the UI.
   *
   * **NOTE***: Overlapping time ranges will be combined.
   *
   * @param spec
   *           The specification containing conditions or user-selected dates for exclusion
   * @return An array of TimeRange objects to be excluded from model training
  */
  getExclusionTimeRanges: function(spec: ModelCloningChartHelperSpec): [TimeRange] py
}
