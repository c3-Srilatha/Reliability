/**
 * ChartHelper to optimize the charts of the AlertDetail page.
 */
type AlertDetailChartHelper mixes ChartHelper<json> {

  /**
   * Adds quantity metrics objects to the {@link UiSdlTimeseriesLineBarChartYAxisDataSpecSetting yAxisField}s
   * based on the given {@link Sensor#id}s
   *
   * Example of a {@link UiSdlTimeseriesLineBarChartYAxisDataSpecSetting yAxisField}s array.
   * ```json
   * [
   *   {
   *     "dataType": "Sensor",
   *     "legendLabel": "Sensor 1",
   *     "visualizationType": {
   *       "type": "UiSdlTimeseriesLineBarChartLineVisualization"
   *     },
   *     "entityId": "sensor1",
   *     "metricName": "Quantity"
   *   }
   * ]
   * ```
   *
   * @param sensorIds
   *    An array of {@link Sensor#id}s.
   *
   * @returns
   *    A {@link UiSdlTimeseriesLineBarChartYAxisDataSpecSetting yAxisField}s array for the {@link UiSdlTimeseriesLineBarChart}.
   */
  addSensorQuantityMetrics: function(sensorIds: ![string serialized Sensor]): [!UiSdlTimeseriesLineBarChartYAxisDataSpecSetting] js-rhino

  /**
   * Fetches training and validation periods for model, and formats y-axis fields for chart
   * return format is [trainingPeriodShading, validationPeriodShading]
   *
   * @param model
   *           The reliability ML model to get training and validation periods for
   * @return An array containing training period shading and validation period shading configurations
   */
  getTrainingValidationShading: function(model: ReliabilityMlModel): [json] js-rhino
}
