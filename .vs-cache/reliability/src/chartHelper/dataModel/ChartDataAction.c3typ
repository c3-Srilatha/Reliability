/**
 * Represents a partiallyAppliedAction that will be used to get data
 * for a set of charts.
 */
type ChartDataAction {

  /**
   * The action that will get data for the charts.
   */
  partiallyAppliedAction: PartiallyAppliedAction

  /**
   * The ids charts that will use the data fetched by the partially applied action.
   */
  chartIds: [string]
}
