/**
 * Chart and filter panel prepopulation data type.
 * This type contains the necessary information to prepopulate a chart and filter panel on page loads.
 */
type AlertTimeSeriesChartAndFilterPanelData mixes TimeSeriesChartAndFilterPanelData {
    /**
     * The ID of the asset associated with the alert.
     */
    assetId: string

    /**
     * The project associated with the residual alert.
     */
    project: ReliabilityMl.Project
}
