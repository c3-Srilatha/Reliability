/**
 * Abstract type to enforce the structure of a `getChartConfigs` function, to give an expected return for use
 * in {@link ChartInfoApplicationState}.
 */
abstract type ChartHelper<S> {

  /**
   * Types that implement {@link ChartHelper} must implement this function. This function should return
   * all the chart configs to render in a map of ID to configuration.
   * @param spec
   *    A spec that determines what chart configurations are returned
   * @returns
   *    An instance of {@link ChartConfigInfo} containing a map of chart ids to chart configs.
   *
   *    NOTE: chart ids should have the '.' after the module name removed from them
   *    (i.e. `Reliability.AlertDetailRiskScoreChart` -> `ReliabilityAlertDetailRiskScoreChart`).
   *    The ChartInfoApplicationState epic will add the '.' back to the chart id when it is rendered.
   */
  getChartConfigs: abstract function(spec: S): !ChartConfigInfo js-rhino

  /**
   * Gets the chart configs and data based on the provided spec and implementation of {@link #getChartConfigs}.
   * This function should be called through the {@link ChartInfoApplicationState#getChartInfo} function.
   *
   * Known limitations:
   *  1. All yAxisFields (from all charts) with same type, metric, and entity must use the same bindings.
   *  2. All charts must use the same xAxis configurations.
   *  3. yAxisField upper bound/lower bound metrics will not be evaluated.
   *  4. evalDataSpec is not evaluated.
   * @param spec
   *    A spec to pass to {@link #getChartConfigs}
   * @return the Chart configurations and chart data that can be used to render charts.
   */
  getChartInfo: function(spec: S): !ChartInfo js-rhino

  /**
   * Uses a hash algorithm in order to generate unique hashes for all the metrics and bindings pairs passed into an
   * {@link EvalMetricsSpec} for the dataSpec.
   *
   * @param expression
   *           The expression string to hash
   * @param values
   *           The map of values to hash
   * @return A unique hash string for the expression and values combination
   */
  generateEvalMetricResultKey: function(expression: string, values: map<string, any>): string js-rhino
}
