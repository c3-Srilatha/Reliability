/**
 * Determines how a current value for a cached rollup metric should be fetched. Must be used in conjuction with
 * {@link RollupMetricFromPersistedResultWithCurrentValue}. The `id` of the action should be passed as a
 * `currentValueAction` binding to {@link RollupMetricFromPersistedResultWithCurrentValue#rollupMetrics} spec
 */
type RollupCurrentValueAction mixes Metadata, Identified, PartiallyAppliedAction
