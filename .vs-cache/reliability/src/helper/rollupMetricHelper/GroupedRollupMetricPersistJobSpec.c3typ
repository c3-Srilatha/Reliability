/**
 * This type enables specifying additional information for persisting the rollup metric results.
 */
type GroupedRollupMetricPersistJobSpec mixes RollupMetricStartPersistenceJobSpec {

  /**
   * This field enables rollup metrics results to be cached at the {@link Facility} level.
   * The path is used to specify the reference to the {@link Facility} that a respective entity belongs to.
   */
  groupPath: string
}
