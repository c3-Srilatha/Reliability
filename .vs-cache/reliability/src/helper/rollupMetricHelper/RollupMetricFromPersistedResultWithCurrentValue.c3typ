/**
 * {@link RollupMetricFromPersistedResult} with the added functionality of being able to return the current value
 * calculated on the fly.
 */
type RollupMetricFromPersistedResultWithCurrentValue<S> mixes RollupMetricFromPersistedResult<S> {

  /**
   * Fetches cached values, and replaces the last value with a current value determined by the `currentValueAction`
   * binding. Expects bindings to come in as a map, not an array.
   * The currently supported bindings are `currentValueAction` and `currentValueActionFilter`.
   * Return timeseries will have modified `_data`, but actual `data()` will be unchanged.
   */
  rollupMetrics: ~

  /**
   * This function is called by the `PersistRollupMetricResultCronJob` to cache rollup metric
   * results at the {@link Facility} level.
   * @param specs
   *        The list of specifications used to cache the rollup metric results.
   * @return The list of {@RollupMetricBatchJob}s that are created to cache the rollup metrics.
   */
  startGroupedRollupMetricBatchJobs: function(
    specs: ![GroupedRollupMetricPersistJobSpec]
  ): ![RollupMetricBatchJob] js-rhino
}
