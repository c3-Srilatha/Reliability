/**
 * Specification for {@link DataPrepTrainValTimeRangesChart#getChartConfig} dynamic chart helper.
 */
type DataPrepTrainValTimeRangesChartSpec mixes Spec {

  /**
   * The assets which is undergoing data preparation for modeling purposes.
   */
  assets: ![ReliabilityAsset]

  /**
   * The user-selected proposed start time for model training.
   */
  windowStart: !datetime

  /**
   * The user-selected proposed end time for model training.
   */
  windowEnd: !datetime

  /**
   * Training data {@link TimeRange}s.
   */
  trainingDatasetTimeRanges: ![TimeRange]

  /**
   * Validation data {@link TimeRange}s.
   */
  validateDatasetTimeRanges: ![TimeRange]
}
