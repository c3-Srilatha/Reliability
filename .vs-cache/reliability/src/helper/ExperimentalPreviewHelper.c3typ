/**
 * Helper type to fetch data for Experimental Model Preview and generate the
 * dynamic chart component to plot that data.
 */
type ExperimentalPreviewHelper {

  /**
   * Using the model provided as base, we look on it for {@link ReliabilityMlModel#latestAdjustModelHyperparamsExperiment}
   * to retrieve the inference data to plot on the chart.
   *
   * Then reads the {@link ReliabilityMlModelExperiment#alertData}, {@link ReliabilityMlModelExperiment#algorithmData},
   * and {@link ReliabilityMlModelExperiment#baseModelAlgorithmData} to build data.
   *
   * @param model
   *          The base model to retrieve the experimental model data from.
   * @param interval
   *          Interval to resample the data to.
   * @returns The data to plot on the chart.
   */
  getData: function(model: ReliabilityMlModel, interval: string serialized Interval): ExperimentalPreviewHelper.ChartData py

  /**
   * Returns the data for the feature output of the model.
   *
   * It uses {@link ReliabilityMlModelExperiment#featureOutputData} to retrieve the data for the feature output.
   * Usually that {@link Data} composes the input {@link Feature} evaluated during the experiment time range, and the
   * feature model outputs (defined in {@link ReliabilityMl.Project#featureOutputs}).
   *
   * Return example:
   * ```
   * {
   *   "result": {
   *     [model.id]: {
   *       "Feature_Sensor1_DAY": c3.Timeseries(),
   *       "Feature_Sensor1_DAY_reconstruction": c3.Timeseries(),
   *       "Feature_Sensor1_DAY_residual": c3.Timeseries(),
   *     }
   *   }
   * }
   * ```
   *
   * @param model
   *          The model to retrieve the data from.
   * @param featureNames
   *          The names of the features output to retrieve the data from.
   * @param interval
   *          Interval to resample the data to.
   * @returns The data for the features output.
   */
  getFeatureOutputData: function(
    model: ReliabilityMlModel,
    featureNames: ![string],
    interval: string serialized Interval
  ): EvalMetricsResult py
}
