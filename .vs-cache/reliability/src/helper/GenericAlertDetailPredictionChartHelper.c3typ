/**
 * Type to fetch chart config for `Reliability.GenericAlertDetailPredictionChart`.
 */
type GenericAlertDetailPredictionChartHelper {

  /**
   * Generates chart configuration for `Reliability.GenericAlertDetailPredictionChart`.
   *
   * 1. Generates chart config based off of general model prediction chart in {@link ModelPredictionChartHelper#getChartConfig}.
   * 2. Order chart `yAxisFields` according to feature while maintaining the secondary order within the feature of:
   *    feature, reconstruction, and residual.
   * 3. Adds event trigger for chart synchronization.
   *
   * @param payload
   *           The payload object containing chart configuration data
   * @param alertId
   *           The ID of the alert for which to generate the chart configuration
   * @param spinnerId
   *           The ID of the spinner component
   * @return The generated chart configuration object
   */
  getChartConfig: function(payload: json, alertId: string, spinnerId: string): json js-rhino

  /**
   * Fetches the model output for a specific alert.
   *
   * @param alertId
   *           The ID of the alert for which to fetch the model output
   * @return The fetched model output as a JSON object
   */
  getModelOutputforAlert: function(alertId: string): FetchResult<json> js-rhino
  /**
   * Fetches the feature outputs for a specific alert.
   *
   * @param alertId
   *           The ID of the alert for which to fetch the feature outputs
   * @return The fetched feature outputs as a JSON object
   */
  getFeatureOutputs: function(alertId: string): FetchResult<json> js-rhino
}
