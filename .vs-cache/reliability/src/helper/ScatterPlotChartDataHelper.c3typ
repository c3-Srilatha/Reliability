/**
 * Type to fetch chart data for Global and Asset specific scatter plot.
 */
type ScatterPlotChartDataHelper {

  /**
   * Retrieves the data for the scatter plot based on the specified parameters.
   * @param spec
   *           The specification object containing parameters for retrieving scatter plot data
   * @return The data to be displayed in the scatter plot
   */
  getScatterPlotData: function(spec: !ScatterPlotChartDataSpec): FetchResult<ScatterPlotChartDataHelper> js-rhino

  /**
   * Id of the data point.
   */
  id: string

  /**
   * X-axis value of the data point if the point is not missing.
   */
  xAxis: float

  /**
   * Y-axis value of the data point if the point is not missing.
   */
  yAxis: float

  /**
   * X-axis value of the data point.
   */
  xAxisRaw: float

  /**
   * Y-axis value of the data point.
   */
  yAxisRaw: float

  /**
   * True if the x-axis value is missing
   */
  xAxisMissing: boolean

  /**
   * True if the y-axis value is missing
   */
  yAxisMissing: boolean

  /**
   * The size of the data point.
   */
  size: !int

  /**
   * The category of this data point that is used for coloring purposes.
   */
  category: string

  /**
   * Whether the data point should be displayed.
   */
  display: boolean

  /**
   * The average of the xAxis and yAxis missing metric values.
   */
  missingAvg: double

  /**
   * Whether the displayed data point is high risk or not.
   */
  highRisk: boolean

  /**
   * Selected {@link Sensor#name} at x-axis variable to display in the {@link UiSdlScatterPlotDataSpec#tooltipAdditionalFields}
   */
  xAxisName: string

  /**
   * Selected {@link Sensor#name} at y-axis variable to display in the {@link UiSdlScatterPlotDataSpec#tooltipAdditionalFields}
   */
  yAxisName: string

  /**
   * Selected {@link Sensor#description} at x-axis variable to display in the {@link UiSdlScatterPlotDataSpec#tooltipAdditionalFields}
   */
  xAxisDescription: string

  /**
   * Selected {@link Sensor#description} at y-axis variable to display in the {@link UiSdlScatterPlotDataSpec#tooltipAdditionalFields}
   */
  yAxisDescription: string

  /**
   * The specific timestamp at which each data point was computed.
   */
  timestamp: string
}
