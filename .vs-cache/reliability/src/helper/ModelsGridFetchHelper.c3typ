/**
 * Helper type to fetch data for Models Grid on Models Tab and Asset Models Page.
 */
type ModelsGridFetchHelper {

  /**
   * The id of the model
   */
  id: string

  /**
   * The name of the model.
   */
  name: string

  /**
   * The status of the model.
   */
  status: MlModel.Route.Status

  /**
   * The validation status for this model.
   */
  validationStatus: string

  /**
   * Number of {@link AbstractEvalMetricsMLDataSourceSpec#features} associated with the model.
   */
  numFeatures: int

  /**
   * Number of {@link ReliabilityAssetAlert}s associated with the model
   */
  numAlerts: int

  /**
   * Number of Closed {@link ReliabilityAssetAlert}s associated with the model.
   */
  numClosedAlerts: int

  /**
   * Number of {@link ReliabilityAssetCase}s associated with the model.
   */
  numCases: int

  /**
   * Number of {@link ModelUserFeedback}s associated with the model.
   */
  numFeedback: int

  /**
   * Training Period of the model.
   */
  trainingPeriod: string

  /**
   * Map of all the training scores for the model
   */
  trainingScores: map<string, double>

  /**
   * Days since the model is deployed.
   */
  daysDeployed: int

  /**
   * Deployment date of the model.
   */
  deploymentDate: datetime

  /**
   * Filler string for mask expression modal
   */
  maskExpression: string = 'Mask Expression'

  /**
   * {@link ReliabilityAsset} associated with the model.
   */
  subject: ReliabilityAsset

  /**
   * {@link MlProject} associated with the model.
   */
  project: MlProject

  /**
   *
   * Returns list of {@link ReliabilityMlModel}s linked to the {@link ReliabilityAsset} it is making predictions for, its asset hierarchy
   * and any related {@link ReliabilityAssetAlert}s and {@link ReliabilityAssetCase}s along with the fields specified here. Additionally formats and simplifies the data model behind the
   * {@link ReliabilityMlModel} for display in the UI.
   *
   * Any filtering performed in this fetch should conform to the custom filtering inside of the function. It currently only supports filtering which uses `intersects` on specified fields.
   *
   * @param spec
   *           The fetch specification containing filters and field selections
   * @param modelType
   *           This fetch is made by default on {@link ReliabilityMlModel}
   *           which may lead to miscalculations on calc fields customized by children model classes so,
   *           for those cases, passing this argument will make the fetch to be called on the specified model type
   * @return A list of reliability ML models with formatted data for UI display
   */
  fetch: function(spec: FetchSpec, modelType: Type): json js-rhino

  /**
   * Returns count of {@link ReliabilityMlModel}.
   *
   * @param spec
   *           The fetch specification containing filters
   * @return The count of reliability ML models
   */
  fetchCount: function(spec: FetchSpec): int js-rhino

  /**
   * Returns selected model information
   *
   * @param id
   *           The ID of the model to retrieve
   * @param include
   *           The include string specifying which fields to retrieve
   * @return The selected model information as JSON
   */
  get: function(id: string, include: string): json js-rhino

  /**
   * Transforms include string for ModelsGridFetchHelper to ReliabilityRiskMlModel
   * returns an includeString and a dictionary of fieldsToKeep
   *
   * @param includeString
   *           The include string to transform
   * @param fieldMapping
   *           The field mapping dictionary
   * @return A JSON object containing the transformed include string and fields to keep
   */
  transformIncludeFields: private function(includeString: !string, fieldMapping: !map<string, string>): !json js-rhino

  /**
   * Transforms a training period object to a string
   *
   * @param trainInput
   *           The training input object
   * @return The formatted training period string
   */
  formatTrainingPeriod: private function(trainInput: MlModel.Input): string js-rhino
}
