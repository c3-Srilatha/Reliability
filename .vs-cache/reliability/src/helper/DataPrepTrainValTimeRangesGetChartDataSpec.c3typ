/**
 * Specification for {@link DataPrepTrainValTimeRangesChart#getChartData} helper function.
 */
type DataPrepTrainValTimeRangesGetChartDataSpec mixes Spec {

  /**
   * Specification for dynamic chart.
   */
  spec: !DataPrepTrainValTimeRangesChartSpec

  /**
   * Start time for chart.
   */
  start: !DateTime

  /**
   * End time for chart.
   */
  end: !DateTime

  /**
   * The data {@link Interval} to analyze the data.
   */
  interval: !Interval
}
