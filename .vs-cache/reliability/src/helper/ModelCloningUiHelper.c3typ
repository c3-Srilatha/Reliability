/**
 * Helper type to get data related to the Unified Model Cloning Workflow.
 */
type ModelCloningUiHelper {
  /**
   * Obtains the {@link ReliabilityDataPreparationUiSettings} from a {@link ReliabilityMlDatasetPreparationJob}
   * given a {@link ReliabilityMlModel} id.
   *
   * @param modelId
   *          The id of the model for which {@link ReliabilityDataPreparationUiSettings} is being fetched.
   * @return The {@link ReliabilityDataPreparationUiSettings} object
   */
  getDataPreparationUiSettings: function(modelId: string): ReliabilityDataPreparationUiSettings js-rhino

  /**
   *
   * This function returns a list of objects prepared from {@link ReliabilityAssetSensorRelation}s for a given list of {@link ReliabilityAsset}s.
   *
   * @param assets
   *    List of {@link ReliabilityAsset} ids.
   * @param sensors
   *    Nested array containing [selected sensors ids, excluded sensors ids].
   * @param spec
   *    - A spec for the fetch call which will be called on {@link ReliabilityAssetSensorRelation}.
   *
   * @return {@link FetchResultWithTotalCount} with sensor details as json objs in the following format:
   *     ```json
   *      objs: {
   *         id: ...
   *         name: ...
   *         description: ...
   *       }
   *     ```
   */
   fetchFilteredSensorsForSelectedAssets: function(
    assets: ![string],
    sensors: ![ [string] ],
    spec: FetchSpec
   ): FetchResultWithTotalCount<json> js-rhino
}
