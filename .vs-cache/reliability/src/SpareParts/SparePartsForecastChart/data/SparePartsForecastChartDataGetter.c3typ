/**
 * Helper type to get {@link SparePartsForecastChartData} for the spare parts forecast chart in UI.
 */
type SparePartsForecastChartDataGetter {

  /**
   * Returns {@link SparePartsForecastChartData} for a given {@link InventorySeries#id} for a given timerange.
   * Executes in py4j runtime to ensure that all memory used is cleaned up after this function runs.
   *
   * @param partId
   *         The part whose inventory levels, forecasts, related work orders and purchase orders are returned.
   * @param timeRange
   *         The timeRange over which the part's forecasts, related work orders, purchase orders will be fetched.
   *
   * @returns An object of {@link SparePartsForecastChartData} containing all the data to be displayed in the UI.
   */
  getData: function(partId: string, timeRange: TimeRange): !SparePartsForecastChartData py-data-server-py4j
}
