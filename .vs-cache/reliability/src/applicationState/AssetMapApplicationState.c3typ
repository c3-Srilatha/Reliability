/**
 * Application state for the Asset Map page.
 */
type AssetMapApplicationState mixes SettableApplicationState {

  /**
   * The current asset that is "selected" by the user.
   * This field informs the side panel to display the details of the selected asset.
   */
  selectedAssetId: string serialized ReliabilityAsset

  /**
   * The current alert that has been selected by the user.
   * This field updates the side panel to show the alert detail panel
   */
  selectedAlertId: string serialized ReliabilityAssetAlert

  /**
   * The current work order that has been selected by the user.
   * This field updates the side panel to show the work order detail panel
   */
  selectedWorkOrderId: string serialized WorkOrder

  /**
   * The current similar spare part selected by the user
   * This field is required to show the add spare part modal
   */
  selectedPartId: string

  /**
   * The id of the specific {@link UiSdlSidePanel} component to show.
   */
  sidePanelToShow: string = 'Reliability.AllAssetsSidePanel'

  /**
   * Current open/closed state of the asset map filter panel
   */
  isFilterPanelOpen: boolean = true

  /**
   * The data spec for the asset map.
   */
  submittedFilterSpec: string serialized Filter
}
