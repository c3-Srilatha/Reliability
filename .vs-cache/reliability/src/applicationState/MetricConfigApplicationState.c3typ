/**
 * Application state for the {@link ReliabilityMetric} configuration workflow.
 */
@typeScript
type MetricConfigApplicationState mixes SettableApplicationState {

  /**
   * The id of the currently selected {@link ReliabilityMetric}  in the grid.
   */
  selectedMetricId: string

  /**
   * The row data of the currently selected {@link ReliabilityMetric} in the grid.
   * Useful populating data related a {@link ReliabilityMetric} in the side panel.
   */
  selectedMetricRowData: ReliabilityMetric

  /**
   * The values of the {@link ReliabilityMetric} in the current form.
   */
  metricFormValues: ReliabilityMetric

  /**
   * The list of {@link ReliabilityMetric}s that are associated with the current {@link ReliabilityMetric}.
   */
  childMetrics: [ReliabilityMetric]

  /**
   * The current {@link CreateMetricConfigurationPreviewChartHelperSpec} that is being used to plot the preview chart.
   */
  currentPlottedMetricSpec: CreateMetricConfigurationPreviewChartHelperSpec

  /**
   * Validation status of the expression entered in the expression editor.
   * If true, that means that the expression is valid.
   * If false, that means that either the expression is invalid or it has not been validated yet.
   * This is used on the UI, for enabling/disabling the button to create or update a {@link ReliabilityMetric}.
   */
  isExpressionValid: boolean = false

  /**
   * Flag to indicate if the metric being configured is a new metric or an existing metric.
   * If true, that means that the metric is new. So, the UI will not be pre-populated with the values of an existing
   * metric and the UI will be in the create mode.
   */
  isNewMetric: boolean = true

  /**
   * Stores where the user should be redirected to if they hit "exit anyway" in the exit modal
   */
  redirectTo: string

  /**
   * Epic to set the row data of a {@link ReliabilityMetric} in MetricConfigGrid to MetricConfigApplicationState.
   *
   * @param actionStream
   *           The observable stream of UI SDL actions
   * @param stateStream
   *           The observable stream of UI SDL states
   * @return An observable stream of UI SDL actions
   */
  @uiSdlEpic(actionType='SET_METRIC_ROW_DATA')
    setMetricRowDataEpic: function(
    actionStream: !UiSdlActionsObservable,
    stateStream: !UiSdlStatesObservable
  ): !UiSdlActionsObservable ts-client
}
