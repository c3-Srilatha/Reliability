/**
 * Application state for the Generative AI workflow in Reliability.
 */
 @typeScript
type GenerativeAiApplicationState mixes SettableApplicationState {

  /**
   * An array of sample questions to be displayed in the UI.
   */
   sampleQuestions: [string]

  /**
   * The query from the most recently selected prompts
   * If a new chat is opened, it's set to empty
   */
  selectedQuestion: string

  /**
   * Indicates whether the user clicked in the trash icon to clear the chat.
   *
   * This flag is set to false every time the user submits a query in the chat.
   * This value changes to true when the clear chat action is triggered.
   */
  isClearingChat: boolean
}
