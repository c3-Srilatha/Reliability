/**
 * Application state that holds the model scenario information.
 */
@typeScript
type ModelScenarioApplicationState mixes UiApTimeseriesDataStore, ComponentStateRemover {
  /**
   * The URL to redirect to when the user exits the model scenario.
   */
  redirectTo: string

  /**
   * The name to be used for the scenario process job.
   *
   * @see ReliabilityOrchestrator.ModelScenarioProcess.Spec#name
   */
  jobName: string

  /**
   * Holds the {@link ReliabilityMlModel#pipeline} `lookbackDuration` in seconds format.
   * Used to calculate the data window from the scenario window.
   *
   * ```
   * Scenario Window = [Start, End]
   * Data Window = [Start - lookbackDuration, End]
   * ```
   *
   * @see ReliabilityMl.Pipeline
   */
  lookbackDuration: string serialized UiSdlDuration

  /**
   * The {@link ReliabilityAsset} that is associated with the {@link ReliabilityMlModel} the
   * scenario is based on.
   */
  asset: ReliabilityAsset

  /**
   * The {@link Facility} that is associated from the #asset that the {@link ReliabilityMlModel} belongs to.
   */
  facility: Facility

  /**
   * The {@link Interval} the {@link ReliabilityMlModel#datasetPreparationRun} is configured to use.
   */
  dataInterval: string serialized Interval

  /**
   * The array of {@link Feature}s that are plotted in the chart.
   */
  selectedItems: [string serialized Feature]

  /**
   * This field captures the original time window that was selected by the user when they
   * uploaded CSV data containing feature overrides. It serves as a reference point for
   * comparison and restoration purposes.
   *
   * **Data Format:**
   * Array containing two {@link DateTime} values: `[startDate, endDate]`
   */
  scenarioWindowAtCSVUpload: [DateTime]

  /**
   * The most recent {@link TimeRange} used to request chart data.
   * It serves as a reference point for request optimization purposes.
   */
  lastPlottedTimeRange: TimeRange

  /**
   * Map of overridden features and their value generators.
   * The key is the {@link Feature#id}, and the value is a {@link ReliabilityMlModelScenario.ValueGenerator}
   * that will generate the {@link Data} for it.
   */
  overriddenFeatures: map<string serialized Feature, ReliabilityMlModelScenario.ValueGenerator>

  /**
   * Retrieves the current {@link ReliabilityMlModel#id}, the user selection for scenario time window, and model
   * data interval.
   *
   * @param state The current Redux state.
   * @return A JSON object containing `modelId`, `start`, `end`, and `interval` fields.
   */
  getModelAndDataTimeRange: function(state: !UiSdlReduxState): json ts-client

  /**
   * Builds the {@link ReliabilityOrchestrator.ModelScenarioProcess.Spec} for the scenario using the
   * current application state.
   *
   * @param state The current Redux state.
   * @return The {@link ReliabilityOrchestrator.ModelScenarioProcess.Spec} for the scenario
   */
  buildScenarioSpec: function(state: !UiSdlReduxState): ReliabilityOrchestrator.ModelScenarioProcess.Spec ts-client

  /**
   * Helper function that returns an observable that emits {@link UiSdlModalOpenCloseAction} if
   * {@link ReliabilityUIConfig#showUIModelScenarioFlow} is enabled else returns an `EMPTY` observable.
   *
   * @param state Redux state.
   * @return The {@link UiSdlModalOpenCloseAction} or `EMPTY`.
   */
  blockAccessIfFeatureFlagDisabled: inline function(state: !UiSdlReduxState): UiSdlActionsObservable ts-client
}
