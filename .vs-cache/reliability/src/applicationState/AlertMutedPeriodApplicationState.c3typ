/**
 * This application state manages the UI state and user interactions for configuring {@link AlertMutedPeriod}s.
 * It stores user selections for muting alerts on {@link ReliabilityAsset assets}, {@link ReliabilityMlModel models},
 * and {@link Sensor sensors}, including:
 * - Mute duration settings
 * - Alert scope configuration (which assets/models/sensors to mute)
 * - Override specifications for existing muted periods
 * - New muted period specifications
 * - Asset graph data for visualization
 *
 * The state is designed to work with the mute alert enhancement features, providing
 * a centralized way to manage all mute-related UI state and user interactions.
 */
@typeScript
type AlertMutedPeriodApplicationState mixes SettableApplicationState {

  /**
   * The date until which alerts should be muted.
   *
   * This field stores the user-selected end date for the mute period.
   * When alerts are muted, they will remain muted until this date is reached.
   * The date is used as the default end date for new muted periods and overrides.
   */
  muteDuration: datetime

  /**
   * Whether to apply the new mute duration to all {@link ReliabilityMlModel models} and {@link Sensor sensors}
   *
   * When true, the #muteDuration will be applied to all models and sensors with mute period enabled, either existing
   * or new - i.e. models and sensors in #newMutedPeriods and #mutedPeriodOverrides.
   * When false, the #muteDuration will only be applied to #newMutedPeriods.
   */
  applyNewMuteDurationToAll: boolean

  /**
   * Whether to mute alerts for child {@link ReliabilityAsset assets} as well.
   *
   * When true, alerts will be muted for the selected asset and all its child assets.
   * When false, only the selected asset itself will be affected.
   */
  muteChildAssets: boolean

  /**
   * All of the assets from currentAssetId {ReliabilityAsset#currentRelDenormDescendants} to get data
   * from if #muteChildAssets is true
   */
  allAssets: [string serialized ReliabilityAsset]

  /**
   * Whether to mute {@link ReliabilityAssetAlert}s on the {@link ReliabilityAsset asset}.
   *
   * When true, alerts generated by the CHAMPION {@link ReliabilityMlModel models} of the asset will be muted.
   * This includes alerts related to asset health, performance, and other asset-level issues.
   */
  muteAssetAlerts: boolean

  /**
   * Whether to mute {@link SensorHealthAlert}s on the {@link Sensor sensors} associated with the
   * {@link ReliabilityAsset asset}.
   *
   * When true, alerts generated by sensors associated with the {@link ReliabilityAsset asset} will be muted.
   * This includes alerts related to sensor readings, thresholds, and sensor-specific issues.
   */
  muteSensorAlerts: boolean

  /**
   * Map of specifications to update existing {@link AlertMutedPeriod}s.
   *
   * This map contains override specifications for existing muted periods. Each entry
   * specifies how to modify an existing muted period, typically by updating its end date
   * or changing its status.
   *
   * Key: {@link ReliabilityMlModel#id} or {@link Sensor#id}
   * Value: Override specification object with the following structure:
   * {
   *   "type": {@link ReliabilityAlertType} - The type of alert being muted
   *   "parent": {@link ReliabilityAsset} - The asset associated with this mute period
   *   "action": string enum ("MUTE", "UNMUTE") - The action to perform on the muted period
   *   "start": datetime - Start date of the muted period
   *   "end": datetime - End date of the muted period (defaults to #muteDuration if not specified)
   * }
   */
  mutedPeriodOverrides: map<string, any>

  /**
   * Map of existing {@link AlertMutedPeriod}s.
   */
  existingMutedPeriods: map<string, AlertMutedPeriod>

  /**
   * Map of specifications to create new {@link AlertMutedPeriod}s.
   *
   * This map contains specifications for creating new muted periods. Each entry
   * defines a new muted period that will be created when the user applies their changes.
   *
   * Key: {@link ReliabilityMlModel#id} or {@link Sensor#id}
   * Value: New muted period specification object with the following structure:
   * {
   *   "type": {@link ReliabilityAlertType} - The type of alert being muted
   *   "parent": {@link ReliabilityAsset} - The asset associated with this mute period
   *   "action": string enum ("MUTE", "UNMUTE") - The action to perform on the muted period
   *   "start": datetime - Start date of the muted period
   *   "end": datetime - End date of the muted period (defaults to #muteDuration if not specified)
   * }
   */
  newMutedPeriods: map<string, any>

  /**
   * Graph data from {@link AssetGraphHelper#getMuteAlertStatusAssetGraph}.
   *
   * This field stores the asset graph data returned by the {@link AssetGraphHelper} to avoid
   * refetching when updating the UI based on user selections. The graph data contains
   * vertices (assets) and edges (relationships) with mute status information.
   */
  assetGraphData: json

  /**
   * The {@link ReliabilityAsset#id} for which the graph data is currently stored.
   *
   * This field tracks which asset's graph data is currently loaded in #assetGraphData.
   * It is used to determine whether the graph data needs to be refreshed when
   * switching between different assets or when the asset context changes.
   */
  currentAssetId: string serialized ReliabilityAsset

  /**
   * The {@link Sensor#id}s that are currently selected in the sensors grid.
   *
   * This field tracks selected {@link Sensor#id}s. It is updated when the user
   * selects or deselects a {@link Sensor} in the grid.
   */
  selectedSensorsIds: [string serialized Sensor]

  /**
   * List of {@link Sensor} objects associated with the current {@link ReliabilityAsset}.
   *
   * This field stores the sensors that are available for muting alerts.
   * It is populated when the application state is initialized.
   */
  sensors: [Sensor]

  /**
   * List of {@link ReliabilityMlModel} objects associated with the current {@link ReliabilityAsset}.
   *
   * This field stores the CHAMPION models that are available for muting alerts.
   * It is populated when the application state is initialized.
   */
  models: [ReliabilityMlModel]

  /**
   * The {@link SensorHealthAlert#id}s that are currently selected in the Asset detail > Sensor Alerts grid.
   *
   * This field tracks selected {@link SensorHealthAlert#id}s. It is updated when the user
   * clicks on the `Mute Sensors` multiple row action in the grid.
   */
  selectedSensorHealthAlertsIds: [string serialized SensorHealthAlert]

  /**
   * An action to initialize the application state for Muting Alerts.
   *
   * @param assetId
   *        The ID of the asset for which to initialize the state.
   *
   * @return a Redux action of type `INITIALIZE_APP_STATE`.
   */
  @uiSdlActionCreator(actionType='INITIALIZE_APP_STATE')
  initializeAppState: private function(assetId: !string serialized ReliabilityAsset): !UiSdlReduxAction ts-client

  /**
   * Epic that processes `INITIALIZE_APP_STATE` actions and sets up initial values for {@link AlertMutedPeriod}s.
   *
   * This epic is triggered when the application state is initialized and sets up
   * default values for this application state, including:
   * - #assetGraphData: load full asset graph data including current asset and child assets.
   * - #existingMutedPeriods: store existing muted periods.
   *
   * @param actionStream
   *        The stream of actions that triggered this epic.
   * @param stateStream
   *        The stream of current application state.
   * @return a stream of actions that will be dispatched to update the state with initial values.
   */
  @uiSdlEpic(actionType='INITIALIZE_APP_STATE')
  initializeAppStateEpic: function(
    actionStream: !UiSdlActionsObservable,
    stateStream: !UiSdlStatesObservable
  ): !UiSdlActionsObservable ts-client

    /**
   * An action to update the application state for Muting Alerts.
   *
   * @param assetId
   *        The ID of the asset for which to initialize the state.
   *
   * @return a Redux action of type `UPDATE_APP_STATE`.
   */
  @uiSdlActionCreator(actionType='UPDATE_APP_STATE')
  updateAppState: private function(assetId: !string serialized ReliabilityAsset): !UiSdlReduxAction ts-client

  /**
   * Epic that processes `UPDATE_APP_STATE` actions and updates values for {@link AlertMutedPeriod}s.
   *
   * This epic is triggered when moving to step 2 on `Reliability.MuteAlertsModal` and sets up
   * default values for this application state, including:
   * - #existingMutedPeriods: store existing muted periods.
   *
   * @param actionStream
   *        The stream of actions that triggered this epic.
   * @param stateStream
   *        The stream of current application state.
   * @return a stream of actions that will be dispatched to update the state with initial values.
   */
  @uiSdlEpic(actionType='UPDATE_APP_STATE')
  updateAppStateEpic: function(
    actionStream: !UiSdlActionsObservable,
    stateStream: !UiSdlStatesObservable
  ): !UiSdlActionsObservable ts-client

  /**
   * An action to set mute duration related fields in the application state.
   *
   * This action is used to update fields related to mute duration configuration,
   * such as the mute duration itself or whether to apply it to all models/sensors.
   *
   * @param field
   *        The field name to be updated (e.g., 'muteDuration', 'applyNewMuteDurationToAll').
   * @param value
   *        The value to set for the specified field.
   * @return a Redux action of type `SET_MUTE_DURATION`.
   */
  @uiSdlActionCreator(actionType='SET_MUTE_DURATION')
  setMuteDuration: private function(field: !string, value: string): !UiSdlReduxAction ts-client

  /**
   * An action to set the selected sensors in the application state.
   *
   * This action is used to update the {@link Sensor#id}s that are currently selected in the
   * sensors grid.
   *
   * @return a Redux action of type `SET_SELECTED_SENSORS`.
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_SENSORS')
  setSelectedSensors: private inline function(): !UiSdlReduxAction ts-client

  /**
   * Listens for action of type `SET_SELECTED_SENSORS` and updates the #selectedSensorsIds field.
   *
   * @param state
   *        Redux state
   * @param action
   *        Redux action
   * @return a new Redux state
   */
  @uiSdlReducer(actionType='SET_SELECTED_SENSORS')
  setSelectedSensorsReducer: private inline function(
    state: !UiSdlReduxState,
    action: !UiSdlReduxAction
  ): !UiSdlReduxState ts-client

  /**
   * An action to update the #selectedSensorHealthAlertsIds based on rows selected in the grid with the given grid ID.
   *
   * @param gridId
   *        The ID of the grid that is triggering the action.
   * @return a Redux action of type `SET_SELECTED_SENSORS_ALERTS`.
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_SENSORS_ALERTS')
  setSelectedSensorsAlertsAction: private inline function(gridId: !string): !UiSdlReduxAction ts-client

  /**
   * Listens for action of type `SET_SELECTED_SENSORS_ALERTS` and updates the #selectedSensorHealthAlertsIds field.
   *
   * @param state
   *        Redux state
   * @param action
   *        Redux action
   * @return a new Redux state
   */
  @uiSdlReducer(actionType='SET_SELECTED_SENSORS_ALERTS')
  setSelectedSensorsAlertsReducer: private inline function(
    state: !UiSdlReduxState,
    action: !UiSdlReduxAction
  ): !UiSdlReduxState ts-client

  /**
   * Epic that processes `SET_MUTE_DURATION` actions and updates the application state.
   *
   * This epic listens for mute duration related actions and handles the logic for
   * updating the application state. It processes special cases like checkbox tree
   * values and ensures proper state updates.
   *
   * @param actionStream
   *        The stream of actions that triggered this epic.
   * @param stateStream
   *        The stream of current application state.
   * @return a stream of actions that will be dispatched to update the state.
   */
  @uiSdlEpic(actionType='SET_MUTE_DURATION')
  setMuteDurationEpic: function(
    actionStream: !UiSdlActionsObservable,
    stateStream: !UiSdlStatesObservable
  ): !UiSdlActionsObservable ts-client

  /**
   * An action to update alert scope settings in the application state.
   *
   * This action is used to update settings related to which alerts should be muted,
   * including alert scope (this asset only vs. child assets) and alert types
   * (asset alerts vs. sensor alerts).
   *
   * @param field
   *        The field name to be updated (e.g., 'alertScope', 'alertType').
   * @param value
   *        The value to set for the specified field.
   * @return a Redux action of type `SET_ALERT_SCOPE`.
   */
  @uiSdlActionCreator(actionType='SET_ALERT_SCOPE')
  setAlertScope: private function(field: !string, value: string): !UiSdlReduxAction ts-client

  /**
   * Epic that processes `SET_ALERT_SCOPE` actions and updates alert scope settings.
   *
   * This epic listens for alert scope related actions and handles the logic for
   * updating the application state. It processes different field types:
   * - 'alertScope': Updates #muteChildAssets and triggers graph refresh
   * - 'alertType': Updates #muteAssetAlerts and #muteSensorAlerts based on selected types
   *
   * @param actionStream
   *        The stream of actions that triggered this epic.
   * @param stateStream
   *        The stream of current application state.
   * @return a stream of actions that will be dispatched to update the state.
   */
  @uiSdlEpic(actionType='SET_ALERT_SCOPE')
  setAlertScopeEpic: function(
    actionStream: !UiSdlActionsObservable,
    stateStream: !UiSdlStatesObservable
  ): !UiSdlActionsObservable ts-client

  /**
   * An action to clear all muted period overrides.
   *
   * @returns a Redux action of type `CLEAR_MUTED_PERIOD_OVERRIDES`.
   */
  @uiSdlActionCreator(actionType='CLEAR_MUTED_PERIOD_OVERRIDES')
  clearMutedPeriodOverridesAction: private function(): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `CLEAR_MUTED_PERIOD_OVERRIDES` and clears all muted period overrides.
   *
   * @param state
   *        Redux state
   * @param action
   *        Redux action
   * @return a new Redux state
   */
  @uiSdlReducer(actionType='CLEAR_MUTED_PERIOD_OVERRIDES')
  clearMutedPeriodOverridesReducer: private inline function(
    state: !UiSdlReduxState,
    action: !UiSdlReduxAction
  ): !UiSdlReduxState ts-client

  /**
   * An action to clear all new muted periods.
   *
   * @returns a Redux action of type `CLEAR_NEW_MUTED_PERIODS`.
   */
  @uiSdlActionCreator(actionType='CLEAR_NEW_MUTED_PERIODS')
  clearNewMutedPeriodsAction: private function(): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `CLEAR_NEW_MUTED_PERIODS` and clears all new muted periods.
   *
   * @param state
   *        Redux state
   * @param action
   *        Redux action
   * @return a new Redux state
   */
  @uiSdlReducer(actionType='CLEAR_NEW_MUTED_PERIODS')
  clearNewMutedPeriodsReducer: private inline function(
    state: !UiSdlReduxState,
    action: !UiSdlReduxAction
  ): !UiSdlReduxState ts-client

  /**
   * An action to load the asset graph for a given {@link ReliabilityAsset}.
   *
   * This action triggers the loading of asset graph data using
   * {@link AssetGraphHelper#getMuteAlertStatusAssetGraph}. The graph data is then
   * stored in the application state for UI visualization.
   *
   * @param assetId
   *        The ID of the asset for which to load the graph data.
   * @return a Redux action of type `GET_ASSET_GRAPH`.
   */
  @uiSdlActionCreator(actionType='GET_ASSET_GRAPH')
  getAssetGraph: private function(assetId: !string serialized ReliabilityAsset): !UiSdlReduxAction ts-client

  /**
   * Epic that processes `GET_ASSET_GRAPH` actions and loads asset graph data.
   *
   * This epic handles the loading of asset graph data by calling
   * {@link AssetGraphHelper#getMuteAlertStatusAssetGraph}. It checks if the graph data
   * is already loaded for the requested asset and either returns cached data or fetches
   * new data from the server. The graph data is then stored in #assetGraphData.
   *
   * @param actionStream
   *        The stream of actions that triggered this epic.
   * @param stateStream
   *        The stream of current application state.
   * @return a stream of actions that will be dispatched to update the state with graph data.
   */
  @uiSdlEpic(actionType='GET_ASSET_GRAPH')
  getAssetGraphEpic: function(
    actionStream: !UiSdlActionsObservable,
    stateStream: !UiSdlStatesObservable
  ): !UiSdlActionsObservable ts-client

  /**
   * An action to update the #mutedPeriodOverrides, or #newMutedPeriods maps., either by extending the end date
   * or changing the action (MUTE/UNMUTE).
   *
   * @param dataItem
   *        The record that represents the row in the {@link UiSdlDataGrid grid}.
   * @return a Redux action of type `UPDATE_MUTED_PERIOD`.
   */
  @uiSdlActionCreator(actionType='UPDATE_MUTED_PERIOD')
  updateMutedPeriod: private function(dataItem: !json): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `UPDATE_MUTED_PERIOD` and updates the #mutedPeriodOverrides or
   * #newMutedPeriods maps.
   *
   * @param state
   *        Redux state
   * @param action
   *        Redux action
   * @return a new Redux state
   */
  @uiSdlReducer(actionType='UPDATE_MUTED_PERIOD')
  updateMutedPeriodReducer: private inline function(
    state: !UiSdlReduxState,
    action: !UiSdlReduxAction
  ): !UiSdlReduxState ts-client

  /**
   * An action to update all muted periods in the application state based on the current settings.
   * @return a Redux action of type `UPDATE_ALL_MUTED_PERIODS`.
   */
  @uiSdlActionCreator(actionType='UPDATE_ALL_MUTED_PERIODS')
  updateAllMutedPeriods: private function(): !UiSdlReduxAction ts-client

  /**
   * Epic that processes `UPDATE_ALL_MUTED_PERIODS` actions.
   * Applies #muteDuration to all #newMutedPeriods. Also, applies the same duration to all #mutedPeriodOverrides if
   * #applyNewMuteDurationToAll is true.
   *
   * @param actionStream
   *        The stream of actions that triggered this epic.
   * @param stateStream
   *        The stream of current application state.
   * @return a stream of actions that will be dispatched to update the state with new muted periods.
   */
  @uiSdlEpic(actionType='UPDATE_ALL_MUTED_PERIODS')
  updateAllMutedPeriodsEpic: function(
    actionStream: !UiSdlActionsObservable,
    stateStream: !UiSdlStatesObservable
  ): !UiSdlActionsObservable ts-client

  /**
   * An action to mute all the #models or #sensors.
   *
   * @param entityObjsKey
   *        The key (i.e. 'models' or 'sensors') of the entities to retrieve from the application state in order to mute them.
   * @return a Redux action of type `MUTE_ALL`.
   */
  @uiSdlActionCreator(actionType='MUTE_ALL')
  muteAll: private function(entityObjsKey: !string): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `MUTE_ALL` and mutes the specified entities (i.e. models or sensors) by
   * creating #newMutedPeriods or updating #mutedPeriodOverrides.
   *
   * @param actionStream
   *        The stream of actions that triggered this epic.
   * @param stateStream
   *        The stream of current application state.
   * @return a stream of actions that will be dispatched to mute the specified entities.
   */
  @uiSdlEpic(actionType='MUTE_ALL')
  muteAllEpic: private inline function(
    actionStream: !UiSdlActionsObservable,
    stateStream: !UiSdlStatesObservable
  ): !UiSdlReduxState ts-client

  /**
   * An action to unmute all the #models or #sensors.
   *
   * @param entityObjsKey
   *        The key (i.e. 'models' or 'sensors') of the entities to retrieve from the application state in order to unmute them.
   * @return a Redux action of type `UNMUTE_ALL`.
   */
  @uiSdlActionCreator(actionType='UNMUTE_ALL')
  unmuteAll: private function(entityObjsKey: !string): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `UNMUTE_ALL` and unmutes the specified entities (i.e. models or sensors) by
   * removing #newMutedPeriods or updating #mutedPeriodOverrides.
   *
   * @param actionStream
   *        The stream of actions that triggered this epic.
   * @param stateStream
   *        The stream of current application state.
   * @return a stream of actions that will be dispatched to unmute the specified entities.
   */
  @uiSdlEpic(actionType='UNMUTE_ALL')
  unmuteAllEpic: function(
    actionStream: !UiSdlActionsObservable,
    stateStream: !UiSdlStatesObservable
  ): !UiSdlActionsObservable ts-client
}
