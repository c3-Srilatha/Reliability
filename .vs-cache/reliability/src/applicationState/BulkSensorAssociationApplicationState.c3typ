/**
 * Application state that stores all the UI logic Build Sensor Association.
 */
type BulkSensorAssociationApplicationState mixes SettableApplicationState, ComponentStateRemover {

  /**
   * Settings set by users from the Bulk Sensor Association UI.
   */
  settings: BulkSensorAssociationUiSettings

  /**
   * If true, the bulk sensor association job is checking the validity of the selected assets.
   * Used to show a loader on the table actions.
   */
  checkingSensorAssociationValidity: boolean

  /**
   * The currently open {@link ReliabilityAssetSensorAssociationJob} in the Sensor Correlation Grid on the Model Management, Jobs Page
   */
   currentlyOpenSensorAssociationJob: ReliabilityAssetSensorAssociationJob


  /**
   * Indicates that the user is currently in this workflow. Used to prevent closing the modal without confirmation.
   */
  sensorAssociationWorkflowInProgress: boolean

  /**
   * Stores a count of the number of previously completed {@link ReliabilityAssetSensorAssociationJob}s.
   */
  numCompletedJobs: int

  /**
   * The id of the target tag that has been selected.
   */
  targetTagId: string

  /**
   * Stores error information for use in the validation model.
   */
  errorInfo: json

  /**
   * Returns an action that updates the bulk model config progress indicator.
   *
   * @param shouldGoNext
   *        When `false`, this indicates that the action is for the previous step, while `true`
   *        indicates that the action is for the next step.
   * @return A Redux action to change the step
   */
  @uiSdlActionCreator(actionType='CHANGE_STEP')
  changeStepAction: function(shouldGoNext: !boolean): !UiSdlReduxAction ts-client

  /**
   * When the `CHANGE_STEP` action is triggered, this epic updates the bulk model config progress indicator
   * based on the current step.
   *
   * @param actionStream
   *           The observable stream of UI SDL actions
   * @param stateStream
   *           The observable stream of UI SDL states
   * @return An observable stream of UI SDL actions
   */
  @uiSdlEpic(actionType='CHANGE_STEP')
  changeStepEpic: function(
    actionStream: !UiSdlActionsObservable,
    stateStream: !UiSdlStatesObservable
  ): !UiSdlActionsObservable ts-client

  /**
   * An action to start the bulk model configuration UI workflow.
   *
   * @return A Redux action of type `START_UI_WORKFLOW`.
   */
  @uiSdlActionCreator(actionType='START_UI_WORKFLOW')
  startUiWorkflowAction: function(): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `START_UI_WORKFLOW` and does the following:
   * 1. Sets {link BulkModelConfigApplicationState#loadingModelConfig} to `true`
   * 2. Sets object IDs in application state for data grids to display their data.
   * 3. Opens the applicable modal.
   * 4. Sets {link BulkModelConfigApplicationState#loadingModelConfig} to `false`.
   *
   * @param actionStream
   *        Observable action stream.
   * @param stateStream
   *        Observable state stream.
   *
   * @return An Observable action stream.
   */
  @uiSdlEpic(actionType='START_UI_WORKFLOW')
  startUiWorkflowEpic: function(
    actionStream: !UiSdlActionsObservable,
    stateStream: !UiSdlStatesObservable
  ): !UiSdlActionsObservable ts-client

  /**
   * An action to indicate leaving the bulk model configuration UI workflow.
   *
   * @return A Redux action to exit the UI workflow
   */
  @uiSdlActionCreator(actionType='EXIT_UI_WORKFLOW')
  exitUiWorkflowAction: function(): !UiSdlReduxAction ts-client

  /**
   * Closes the bulk model config modal, the associated confirmation modal, clears application state, except for
   * the `numCompletedJobs` field, which needs to be used outside the modal.
   *
   * @param actionStream
   *           The observable stream of UI SDL actions
   * @param stateStream
   *           The observable stream of UI SDL states
   * @return An observable stream of UI SDL actions
   */
  @uiSdlEpic(actionType='EXIT_UI_WORKFLOW')
  exitUiWorkflowEpic: function(
    actionStream: !UiSdlActionsObservable,
    stateStream: !UiSdlStatesObservable
  ): !UiSdlActionsObservable ts-client

  /**
   * If `sensorAssociationWorkflowInProgress` is true, shows the modal to confirm exit from the workflow.
   * Requires an effectTrigger on modal close that triggers this action.
   *
   * @param actionStream
   *           The observable stream of UI SDL actions
   * @param stateStream
   *           The observable stream of UI SDL states
   * @return An observable stream of UI SDL actions
   */
  @uiSdlEpic(actionType='SHOW_EXIT_MODAL')
  showExitModalEpic: function(
    actionStream: !UiSdlActionsObservable,
    stateStream: !UiSdlStatesObservable
  ): !UiSdlActionsObservable ts-client


  /**
   * Returns an action that shows a banner when `suppressBanner` is `false`.
   * The action also updates the {@link #numCompletedJobs} when the number of `completed` and `failed` {@link ModelConfigRun}s has changed.
   *
   * @param suppressBanner
   *        If true, the banner will not be shown.
   * @return A Redux action of type `CHECK_JOB_STATUS`.
   */
  @uiSdlActionCreator(actionType='CHECK_JOB_STATUS')
  checkJobStatusAction: function(suppressBanner: boolean): !UiSdlReduxAction ts-client

  /**
   * Updates {@link #numCompletedJobs} if the number of `completed` and `failed` {@link ModelConfigRun}s has changed.
   *
   * @param actionStream
   *           The observable stream of UI SDL actions
   * @param stateStream
   *           The observable stream of UI SDL states
   * @return An observable stream of UI SDL actions
   */
  @uiSdlEpic(actionType='CHECK_JOB_STATUS')
  checkJobStatusEpic: function(
    actionStream: !UiSdlActionsObservable,
    stateStream: !UiSdlStatesObservable
  ): !UiSdlActionsObservable ts-client

  /**
   * Requests data for nested grids on Model Configuration Jobs Grid by embedding
   * parent grid ids into nested grid data requests.
   *
   * @param actionStream
   *           The observable stream of UI SDL actions
   * @param stateStream
   *           The observable stream of UI SDL states
   * @return redux actions of type `DATA_REQUEST` on each of the nested grids.
   */
  @uiSdlEpic(actionType='REFRESH_NESTED_GRIDS')
  refreshNestedGridEpic: function(
    actionStream: !UiSdlActionsObservable,
    stateStream: !UiSdlStatesObservable
  ): !UiSdlActionsObservable ts-client

  /**
   * An action to start sensor association when the user clicks on the "Create New Correlation" button in the
   * "Confirm Sensor Correlation" modal.
   *
   * @return A Redux action of type `START_SENSOR_ASSOCIATION`.
   */
  @uiSdlActionCreator(actionType='START_SENSOR_ASSOCIATION')
  startSensorAssociationAction: function(): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `START_SENSOR_ASSOCIATION` and performs the following:
   * 1. Calls {@link BulkModelSetupUiSettings#startBulkModelSetup}.
   * 2. Redirects to the Bulk Jobs page.
   * 3. Displays a banner to inform the user that the sensor correlation job is running.
   *
   * @param actionStream
   *        Observable action stream.
   * @param stateStream
   *        Observable state stream.
   *
   * @return An Observable action stream.
   */
  @uiSdlEpic(actionType='START_SENSOR_ASSOCIATION')
  startSensorAssociationEpic: function(
    actionStream: !UiSdlActionsObservable,
    stateStream: !UiSdlStatesObservable
  ): !UiSdlActionsObservable ts-client
}
