/**
 * Implements the logic to go to the next step of the {@link BulkSensorAssociationStartUiWorkflow}
 */
@typeScript(sourceCodeType='Script')
type BulkSensorAssociationOnNext {

  /**
   * Returns a map of step id to function to execute on attempting to proceed to the next step.
   *
   * @return A map where keys are step IDs and values are functions to execute on next step
   */
  getOnNextMap: function(): map<string, any> ts-client
}
