/**
 * Implements the logic to go to the start the Bulk Sensor Association Workflow. Includes checking whether
 * the selected assets are valid for the workflow, and if not, displaying an error modal.
 */
@typeScript(sourceCodeType='Script')
type BulkSensorAssociationStartUiWorkflow {

  /**
   * Starts the Bulk Sensor Association Workflow. If the selected assets are valid for the workflow, the workflow
   * will be started. If the selected assets are not valid, an error modal will be displayed.
   *
   * @param action
   *           The UI SDL Redux action that triggered the workflow start
   * @param state
   *           The current UI SDL Redux state
   * @return An observable stream of UI SDL actions
   */
  startUiWorkflow: function (action: UiSdlReduxAction, state: UiSdlReduxState): UiSdlActionsObservable ts-client
}
