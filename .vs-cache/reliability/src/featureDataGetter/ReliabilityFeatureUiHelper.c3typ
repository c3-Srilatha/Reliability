/**
 * Helper type that allows UI charts to use `evalMetrics` function to get Reliability feature data.
 *
 * Allows the evaluation of the underlying {@link Feature}s with an `evalMetrics` abstraction
 */
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
type ReliabilityFeatureUiHelper {

  /**
   * Parses the given {@link EvalMetricsSpec} and returns the
   * result of calling {@link ReliabilityFeatureTimedDataQuery#execute} with the parsed parameters.
   *
   * The spec is expected to have `ids[0]` set to the asset id to get feature data for.
   * `bindings` in the spec should be an array of {@link FeatureFetchBase}. Only the id of each {@link FeatureFetchBase}
   * is required. These ids can also just be the names of {@link Feature}s. More specifically, each binding should
   * have the following format: `{id: <FeatureFetchBase id>}` or `{id: <Feature name>}`.
   *
   * Returns a {@link EvalMetricsResult} with the data for each {@link FeatureFetchBase}. A specific feature's data
   * can be found in the path `result.<assetId>.<featureId>`.
   *
   * @param spec
   *           The EvalMetricsSpec containing the asset id and feature bindings
   * @return An EvalMetricsResult with the feature data for the specified asset
   */
  evalMetrics: function(spec: EvalMetricsSpec): EvalMetricsResult js-rhino

  /**
   * Adds feature plotting to the given chart config. More specifically, adds a yAxisField that gets all the data
   * and sets yAxisFields to the value of a defined (non-dynamic) derivedProp.
   * This means this function ** must ** be run after all other yAxisFields have been set.
   *
   * Returns a copy of the chartConfig with the feature plotting added.
   *
   * @param chartConfig
   *           The chart configuration to add feature plotting to
   * @param spec
   *           Optional specification for reliability feature plotting
   * @return A copy of the chartConfig with the feature plotting added
   */
  addFeaturePlotting: inline function(chartConfig: !json, spec: !?ReliabilityFeaturePlotSpec): json js-rhino


  /**
   * Adds {@link ReliabilityAssetSensorRelation} plotting to the given chart config.
   * More specifically, adds yAxisFields plotting the quantity metric of the sensor in the given relations.
   * The sensor will be given tooltip with expected sensor name if
   * {@link ReliabilityUIConfig#showExpectedSensorOnSensorLegendLabelTooltip} is set to true.
   * @param chartConfig The chart config to add the plotting to.
   * @param assetSensorRelations
   *    The relations to plot. This function will NOT refetch relations,
   *    so ensure that the relations `to.id`, `to.expectedSensor.id` and `to.description` are set.
   *
   * @return a copy of the chartConfig with asset sensor relation plotting added.
   */
  addAssetSensorRelationPlotting: inline function(chartConfig: !json, assetSensorRelations: ![ReliabilityAssetSensorRelation]): json js-rhino

}
