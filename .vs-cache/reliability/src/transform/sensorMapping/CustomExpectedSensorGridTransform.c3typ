/**
* Transforms a JSON with new property `objs`and checks if the CustomExpectedSensors are mapped and not in AssetClass.ExpectedSensors
* This is used to show a green check mark for the mapped custom expected sensors.
*/
@typeScript
type CustomExpectedSensorGridTransform mixes UiSdlDataTransform<json, json> {

   transform: ~ ts-client
}
