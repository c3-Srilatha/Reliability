/**
 * Transforms ReliabilityMlModel's {@link EvaluateResult} with count into correct format
 * for Reliability.ModelSetupPopularMlScenarioDefinitionList.
 * The definition list displays the project name and the number of models.
 */
@typeScript
type MlModelEvaluateToScenarioJsonTransform mixes UiSdlDataTransform<EvaluateResult<ReliabilityMlModel>, json>{
  transform: ~ ts-client
}
