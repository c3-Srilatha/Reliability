 * isAssetsMapEnabled {Boolean} - Feature flag for Geospatial Assets Map.
 */
type AssetsPageTitleTabsTransform mixes UiSdlDataTransform<json, [UiSdlPageTab]> {

  /**
   * @inheritdoc
   */
  transform: ~
}
