/**
 * Transform for Reliability.DataValidationSensorNotNormalizationGrid and Reliability.DataValidationSensorNormalizationGrid.
 * Changes the status field on {@link Sensor} based on whether the its {@link PointPhysicalMeasurementSeries}s are normalized.
 */
@typeScript
type UiSdlTransformDataValidationSensorNormalizationGrids mixes UiSdlDataTransform<FetchResult<Sensor>, FetchResult<Sensor>> {

  transform: ~ ts-client
}
