/**
 * Enable or disable table actions in reports grid based on the user's role.
 * Actions with a suffix included in `ACTIONS_TO_DISABLE` will be disabled if the user
 * does not have the implementation role.
 */
type UiSdlTransformRiskReportsGridTableActions mixes UiSdlDataTransform<json, json>
