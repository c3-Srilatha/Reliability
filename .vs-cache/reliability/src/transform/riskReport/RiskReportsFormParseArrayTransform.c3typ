/**
 * A transform to convert the action's arguments by parsing the string value of `datasetIntervals`
 * from the submitted risk reports form.
 */
@typeScript
type RiskReportsFormParseArrayTransform mixes UiSdlDataTransform<[Interval], [Interval]> {

  transform: ~

   /**
    * A function to parse the string value of the argument `datasetIntervals` into an array of {@link Interval}s.
    */
  transformArgs: ~
}
