/**
 * Receives a set of arguments (filters) and builds a filter query from them.
 *
 * **NOTE**: This transform is expected to be used for {@link ReliabilityAssetAlert} fetch.
 *
 * Supports the following filters:
 * - `filterStates`: String array of [states](ReliabilityAssetAlertState) to filter by.
 *                   (operation used is {@link UiSdlFilter#intersects})
 * - `facilityIds`: String array of [facilities](Facility) ids to filter by.
 *                  (operation used is {@link UiSdlFilter#intersects})
 * - `timestamp`: String timestamp to filter by.
 *                (operation used is {@link UiSdlFilter#ge})
 *
 * These filters must be defined under `actionArgs.filters`.
 *
 * Use example:
 * ```json
 * "contextVars": {
 *   "facilityIds": {
 *     ...
 *   },
 *   "timestamp": {
 *     ...
 *   },
 * },
 * "dataTransforms": [
 *   "AlertsFetchArgsTransform",
 * ],
 * "actionArgs": {
 *   "filters": {
 *     "facilityIds": "${facilityIds}",
 *     "timestamp": "${timestamp}",
 *     "filterStates": ["Open"]
 *   },
 * }
 * ```
 *
 * The output of the transform is a new `spec` object with the filters applied but keeping other configurations
 * like `include`, `order`, etc.
 *
 * Output example:
 * ```json
 * {
 *   "spec": {
 *     "include": "name, facility",                               // Keeps previous include
 *     "filter": "intersects('currentState.id', ['Open']) && ..." // Generated filter query
 *   }
 * }
 * ```
 *
 * @see FetchSpec
 * @see WithDataTransforms#applyTransformArgs
 */
@typeScript
type AlertsFetchArgsTransform mixes UiSdlDataTransform<json, json> {

  transformArgs: ~
}
