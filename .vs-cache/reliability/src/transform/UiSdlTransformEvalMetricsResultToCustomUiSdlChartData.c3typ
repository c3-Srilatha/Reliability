/**
 * Transforms {@link EvalMetricsResult} to {@link UiSdlChartData}.
 */
@typeScript
type UiSdlTransformEvalMetricsResultToCustomUiSdlChartData mixes UiSdlDataTransform<EvalMetricsResult, UiSdlChartData> {
  /**
   * Overrides abstract function to transform {@link EvalMetricsResult} to {@link UiSdlChartData}.
   *
   * @param data
   *           The evaluation metrics result to transform
   * @return The transformed UI SDL chart data
   */
  @typeScript(env='client')
  transform: function(data: !EvalMetricsResult): UiSdlChartData ts-client

  /**
   * Generates a unique series id being used by SDLChart.
   * @param id
   *     the source id.
   * @param metricName
   *     the metric name the series is used for.
   * @return
   *     the unique series id used by SDLChart.
   */
  @typeScript(env='client')
  generateSeriesId: function(id: !string, metricName: !string): string
}
