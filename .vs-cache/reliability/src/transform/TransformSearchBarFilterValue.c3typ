/**
 * Combines the filter selected in the search bar with a persistent filter on {@link ReliabilityAssetAlert#parent}.
 * Used to construct the final filter applied when fetching {@link AlertComment}s.
 */
@typeScript
type TransformSearchBarFilterValue mixes UiSdlDataTransform<FetchResult<AlertComment>, FetchResult<json>> {

  transform: ~ ts-client

  @typeScript(env='client')
  transformArgs: ~
}
