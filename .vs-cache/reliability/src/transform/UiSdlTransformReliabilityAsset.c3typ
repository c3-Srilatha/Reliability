/**
 * Transform {@link ReliabilityAsset}s to new FetchResult<ReliabilityAsset> based on selected Report id on FilterPanel
 */
@typeScript
type UiSdlTransformReliabilityAsset mixes UiSdlDataTransform<FetchResult<ReliabilityAsset>, FetchResult<ReliabilityAsset>> {

  /**
   * Transform function to map assets to a simplified FetchResult<ReliabilityAsset>.
   *
   * @param data {FetchResult<ReliabilityAsset>} - The input data that contains a list of assets to be transformed.
   * @returns {FetchResult<ReliabilityAsset>} - The transformed result with only the `name` and `id` of each asset.
   */
  transform: function(data: !FetchResult<ReliabilityAsset>): FetchResult<ReliabilityAsset> ts-client
}
