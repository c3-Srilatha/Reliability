/**
 * Transforms Unit info received by `Reliability.AlertDetailsGrid` Grid.
 * Used to:
 *    - Add new field `displayTransformedValue` which is equal to {@link Unit#symbol} if that value exists,
 *      otherwise, the field defaults to name and finally to id
 */
@typeScript
type TransformUnitSymbol mixes UiSdlDataTransform<FetchResult<ReliabilityAssetAlert>, FetchResult<json>> {

   transform: ~
}
