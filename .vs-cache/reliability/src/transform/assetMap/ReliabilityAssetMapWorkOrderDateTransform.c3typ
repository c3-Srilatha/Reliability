/**
  * 1) Prepends "Due Date" to the work due date for readability
  * 2) Formats the work due date from iso to MM/dd/y, hh:mm a
  */
@typeScript
type ReliabilityAssetMapWorkOrderDateTransform mixes UiSdlDataTransform<json, json>{

  /**
   * Adds `formattedDateContent` field to display `workDueDate`
   *
   * @param data
   *           The work order data containing the work due date
   * @return The transformed data with formatted date content
   */
  transform: function(data: !json): json ts-client
}
