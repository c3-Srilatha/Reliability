/**
 * Transform to replace the {@link ReliabilityMlModel.ClassificationScore#value} with the {@link ReliabilityMlModel#classificationLabel}.
 * This enables sorting by score while still displaying the label.
 */
@typeScript
type TransformClassificationScoreToLevel mixes UiSdlDataTransform<FetchResult<any>, FetchResult<any>> {
  transform: ~ ts-client
}
