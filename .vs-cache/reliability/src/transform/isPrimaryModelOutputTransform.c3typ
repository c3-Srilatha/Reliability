/**
 * Receives a {@link FetchResult} and returns a boolean indicating if the model is primary.
 * The {@link FetchResult} is expected to contain a field named `isPrimary`.
 * The transform returns 'Yes' if the value of `isPrimary` is `true`, 'No' otherwise.
 */
@typeScript
type isPrimaryModelOutputTransform mixes UiSdlDataTransform<FetchResult<any>, UiSdlDynamicValueSpec> {

  transform: ~
}
