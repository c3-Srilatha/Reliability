/**
 * Helper transform that reads the `creationDate` and `workDueDate` fields from a {@link WorkOrder} and creates the `formattedCreationDate`
 * and `formattedWorkDueDate` fields in the same object.
 */
@typeScript
type TransformWorkOrderTimestamps mixes UiSdlDataTransform<json, json> {

  /**
   * Returns the {@link WorkOrder#creationDate} and {@link WorkOrder#workDueDate} formatted as 'MM/dd/y, hh:mm a',
   * converting both from ISO strings to the user's local timezone.
   *
   * @param data
   *           The work order data containing creation and due dates
   * @return The transformed data with formatted timestamp fields
   */
  transform: function(data: !json): json ts-client
}
