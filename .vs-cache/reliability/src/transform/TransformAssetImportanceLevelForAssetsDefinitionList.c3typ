/**
 * If the Asset has importanceLevel then return with the {@link ReliabilityAssetImportance#displayName}
 * else modify the assetImportanceLevel with '-' to display on the DefinitionList
 */
@typeScript
type TransformAssetImportanceLevelForAssetsDefinitionList mixes UiSdlDataTransform<json, json> {

  transform: ~ ts-client
}
