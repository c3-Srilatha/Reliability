/**
 * Transform for `FetchResult<AlertActivity>` for getting the `Comments`, `Files Uploaded`
 * and most recent`Feedback`.
 * The transform also creates a commentId field that is used by the epic to show the attached files.
 */
type AlertActivityFilesCountTransform mixes UiSdlDataTransform<FetchResult<AlertActivity>, FetchResult<json>> {

  transform: ~ ts-client
}
