/**
 * Recieves a { @link ReliabilityAsset} with correlation model setup data, such as:
 * ```
 * sensorAssociationStatus, lastCorrelationModelSetupUpdateDate, lastModelConfigUpdateDate
 * ```
 *
 * The given {@link ReliabilityAsset asset} must also contain a `translationMap` with the following keys:
 * ```
 * {
 *   sensorCorrelation: string,
 *   modelConfiguration: string,
 *   lastUpdated: string,
 * }
 * ```
 *
 * Generates a {@link FetchResult} with the following correlation model setup steps:
 * 1. Sensor Correlation
 * 2. Model Configuration
 *
 * Each of these steps contains the following properties:
 * ```
 * {
 *   id: string,
 *   stepNum: int,
 *   stepType: string,
 *   stepName: asset.translationMap.sensorCorrelation || asset.translationMap.modelConfiguration,
 *   runStatus: string,
 *   lastUpdated: asset.translationMap.lastUpdated + ': ' + datetime || 'N/A',
 * }
 * ```
 */
@typeScript
type CorrelationModelSetupAssetDetailStepsGridTransform mixes UiSdlDataTransform<ReliabilityAsset, FetchResult<json>> {
   transform: ~ ts-client
}
