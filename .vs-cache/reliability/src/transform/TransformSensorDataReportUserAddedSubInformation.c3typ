/**
 * Transforms {@link SensorDataReport}s displayed in selected and excluded sensors grids in single asset dataset preparation to
 * display subtext of whether the sensor was `User Added` or existing `Sensor Relationship` based on {@link SensorDataReport#userAdded} flag.
 */
type TransformSensorDataReportUserAddedSubInformation mixes UiSdlDataTransform<json, json>
