/**
 * Transform the fields on the definition list to add `valueIconMap` dynamically.
 * Additionally, validates the deployment status of the model and filters definition list fields based on it. E.g.
 * we can only manage the alerting status of `CHAMPION` models, thus, we should remove the field if the model has any
 * other deployment status different than `CHAMPION`.
 */
@typeScript
type TransformPerformanceClassificationDefinitionListField mixes UiSdlDataTransform<FetchResult<any>, FetchResult<any>> {

  transform: ~ ts-client
}
