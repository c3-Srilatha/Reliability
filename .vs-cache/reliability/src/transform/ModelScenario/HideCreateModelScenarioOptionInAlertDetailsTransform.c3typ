/**
 * Transform that filters out the `CREATE_MODEL_SCENARIO` action from {@link UiSdlTabPanel#iconActions}
 * when the {@link ReliabilityAssetAlert}'s [project](ReliabilityMl.Project) is 'reliabilityRisk'.
 *
 * **Functionality:**
 * - From the {@link ReliabilityAssetAlert#triggeringModel} it gets the [project](ReliabilityMl.Project) from
 *   `Reliability.AlertDetailTabPanel`.
 * - Filters out `CREATE_MODEL_SCENARIO` action when project is 'reliabilityRisk'
 * - Preserves all other actions regardless of project type
 *
 * @see UiSdlAction
 * @see UiSdlTabPanel
 */
type HideCreateModelScenarioOptionInAlertDetailsTransform mixes UiSdlDataTransform<[UiSdlAction], [UiSdlAction]> {

  /**
   * @inheritdoc
   */
  transform: ~ ts-client
}
