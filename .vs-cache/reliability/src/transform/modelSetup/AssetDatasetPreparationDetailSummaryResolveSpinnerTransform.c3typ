/**
 * Validates that a {@link UiSdlComponentDataSpecStateParam} is equal to the current {@link UiSdlPageParam}.
 * The returned value determines if the spinner is {@link UiSdlSpinner#isDataLoading loading} or not.
 * The spinner stops loading when the {@link UiSdlComponentDataSpecStateParam} id is equal to the
 * current {@link UiSdlPageParam}.
 *
 * - Expected input:
 * ```json
 * {
 *   "tabPanelData":{
 *     "type": "UiSdlComponentDataSpecStateParam",
 *     "id": "componentId",
 *   },
 *   "pageParamId": {
 *      "type": "UiSdlPageParam",
 *       "path": "pageParamId",
 *    },
 * }
 * ```
 *
 * - Expected output:
 * `true` if the {@link UiSdlComponentDataSpecStateParam} `id` is equal to the current
 * {@link UiSdlPageParam}, `false` otherwise.
 */
@typeScript
type AssetDatasetPreparationDetailSummaryResolveSpinnerTransform mixes UiSdlDataTransform<json, boolean> {

   transform: ~
}
