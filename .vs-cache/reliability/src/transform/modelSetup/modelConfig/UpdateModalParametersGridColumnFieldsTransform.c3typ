/**
 * Based on the {@link ModelConfigApplicationState#editingModelExperimentPreview} status, this transform hides/shows columns
 * - Hide 'Reliability.Value' when editing preview
 * - Show 'Reliability.ModifiedValue' and 'Reliability.OriginalValue' when editing preview
 */
@typeScript
type UpdateModalParametersGridColumnFieldsTransform mixes UiSdlDataTransform<json, json> {

  /**
   * @inheritdoc
   */
  transform: ~ ts-client
}
