/**
 * Given JSON object with properties `hyperparams` (array of hyperparameter data)
 * and `hyperparamOverrides` (map of hyperparameter field to override value)
 * returns JSON object with new property `objs` that represents `hyperparams` with `hyperparamOverrides` applied.
 */
@typeScript
type ModelConfigHyperparamOverridesTransform mixes UiSdlDataTransform<json, json> {

   transform: ~ ts-client
}
