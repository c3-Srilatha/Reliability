/**
 * Transforms the user information to be displayed in the UI flows involving `ReliabilityMlDatasetPreparationRun`. Returns user's email if one exists, else falls back on their `id`.
 */
@typeScript
type UserEmailDisplayValueTransform mixes UiSdlDataTransform<FetchResult<ReliabilityMlDatasetPreparationRun>, FetchResult<ReliabilityMlDatasetPreparationRun>> {

   transform: ~ ts-client
}
