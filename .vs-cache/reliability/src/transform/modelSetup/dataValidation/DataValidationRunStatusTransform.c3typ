/**
 * Transforms latestDataValidationRun.runStatus and latestValidationRun.validationStatus.category
 * to appear as a single field and transforms latestValidationRun.meta dateTime to MM/dd/yyyy.
 * Check if runStatus in ReliabilityAsset.latestDataValidationRun is 'Complete'.
 * If so, transform runStatus to validationStatus.category.
 */
@typeScript
type DataValidationRunStatusTransform mixes UiSdlDataTransform<FetchResult<ReliabilityAsset>, json> {

   transform: ~ ts-client

   /**
    * Helper function to transform runStatus and validationStatus.category to appear as a single field
    *  and transform meta dateTime to MM/dd/yyyy. If the dateTime is null, put a placeholder 'N/A'.
    * @param dataValidationRun
    *      The {@link DataValidationRun} requires the transformation
    * @return {@link DataValidationRun} after the transformation
    */
   transformDataValidationRun: function(dataValidationRun: DataValidationRun): DataValidationRun ts-client

   /**
    * Helper function to format date of last updated datetime to MM/dd/yyyy.
    * If the dateTime is null, puts a placeholder 'N/A'.
    * @param date
    *      The {@link datetime} to be formatted.
    * @return string that represents the datetime.
    */
   formatDate: function(date: datetime): string ts-client
}
