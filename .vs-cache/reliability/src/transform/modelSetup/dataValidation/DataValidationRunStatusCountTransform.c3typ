/**
 * Transforms ReliabilityAsset's {@link EvaluateResult} with `latestDataValidationRun.runStatus`
 * and `latestDataValidationRun.validationStatus` count into correct format for `Reliability.ModelSetupDataValidationDefinitionList`.
 * The definition list displays the 'Complete' and 'Failed' status count.
 */
@typeScript
type DataValidationRunStatusCountTransform mixes UiSdlDataTransform<EvaluateResult<ReliabilityAsset>, json> {

   transform: ~ ts-client
}
