/**
 * Based on {@link DataPreparationApplicationState}, set the filter argument for the given sensor data report grid.
 */
@typeScript
type SensorDataReportArgsTransform mixes UiSdlDataTransform<FetchResult<SensorDataReport>, FetchResult<SensorDataReport>> {

   /**
    * A function to parse the string value of the argument `datasetIntervals` into an array of {@link Interval}s.
    */
  transformArgs: ~
}
