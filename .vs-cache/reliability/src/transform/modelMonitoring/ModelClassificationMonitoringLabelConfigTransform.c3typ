/**
 * Transforms the default {@link ReliabilityUIConfig#modelMonitoringLabelConfig}s and {@link ReliabilityUIConfig#modelClassificationLabelConfig}s into
 * labels that updating the Model Monitoring and Model Classification supports.
 * Currently, users should not be able to set the labels that are equal to '-', which has a value of 0.
 */
@typeScript
type ModelClassificationMonitoringLabelConfigTransform mixes UiSdlDataTransform<[string], [string]> {

   transform: ~ ts-client
}
