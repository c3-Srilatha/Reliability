/**
 * Transform the date range for the Definition List to be formatted as "Start Date - End Date".
 * This transform is used for the {@link UiSdlDefinitionList} in the review step of Data Preparation and
 * the Bulk Model Config modal "Datasets for Selected Assets" empty state.
 */
@typeScript
type UiSdlTransformReviewDefinitionList mixes UiSdlDataTransform<json, json> {

   transform: ~ ts-client
}
