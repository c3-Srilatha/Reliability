/**
 * Transform for `ReliabilityRiskMlModel.fetch()` for the ModelDetailModelMonitoringDefinitionList
 * and Reliability.ModelMonitoringGridDefinitionList.
 */
@typeScript
type UiSdlTransformModelMonitoringDefinitionList mixes UiSdlDataTransform<json, json> {

  /**
   * Convert start and end within data to the configured timezone
   *
   * @param data
   *        The data returned by the server with timestamps.
   * @param context
   *.       The configured time zone obtained from the {@link ReliabilityApplicationState}.
   *
   * @returns The data with formatted time period in the configured timezone
   */
  transform: function(data: !json, context: !string): json ts-client
}
