/**
 * The transform function processes the fetchResult objects by appending " Days" to the daysOnHand and avgLeadTime fields.
 * And categorizing the dohOverLeadTimeRatio into various statuses. It also checks if currentStock is below reorderLevel,
 * assigning a status of "Inventory restocking efficiency" when restocking is needed.
 */
@typeScript
type TransformSparePartsGrid mixes UiSdlDataTransform<FetchResult<any>, FetchResult<any>> {
   transform: ~
}
