/**
 * Constructs Y Axes from the series of a chart, in order to enable dynamic charts without the use of
 * {@link UiSdlTimeseriesLineBarChart}. This transform should be applied in `derivedProps` for the
 * `dataSpec.yAxisFields` of the chart, with the chart series as input.
 *
 * There are several steps for using this transform.
 * 1. The chart must use `advancedDataSpec` to make a custom query. This query should return an EvalMetricsResult
 * with the following form
 * ```
 * {
 *   result: {
 *     <entity id>: {
 *       <stringified config 1>: { <some timeseries> },
 *       <stringified config 2>: { <some timeseries> }
 *     }
 *   }
 * }
 * ```
 * The stringified config should be a stringified {@link UiSdlTimeseriesLineBarChartYAxisDataSpecSetting}. Fields
 * that apply to querying data will be ignored.
 * 2. The chart needs to apply the following transforms.
 *
 * ```
 * [
 *   "UiSdlTransformEvalMetricsResultToUiSdlChartData",
 *   "UiSdlTransformEvalMetricDatesOffsetTimeZone", // This one is optional if timezone shifting is not necssary.
 *   "UiSdlTransformUiSdlChartDataToEChartConfig"
 * ]
 * ```
 *
 * 3. The chart needs to set `dataSpec.yAxisFields` in `derivedProps`.
 * ```
 * "derivedProps": {
 *   "dataSpec": {
 *     "yAxisFields": {
 *       "type": "UiSdlComponentDataSpecStateParam",
 *       "id": <Chart Component ID>
 *       "path": "series",
 *       "dataTransforms": ["YAxesFromChartSeriesTransform"]
 *     }
 *   }
 * }
 * ```
 *
 * After following these steps, it is not necessary to declare `yAxisFields` within the component JSON.
 */
type ExtractYAxesShadedRegionsFromDataTransform mixes UiSdlDataTransform<json, json> {
  transform: ~ ts-client
}
