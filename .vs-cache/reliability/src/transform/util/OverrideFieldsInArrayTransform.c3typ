/**
 * Overwrite specific fields on an array of objects. Arguments are specified as a JSON object.
 * The objs key must be the array of the objects.
 * Any other key will be mapped to a field with the same key on each object.
 * Returns an array containing the new modified objects.
 */
@typeScript
type OverrideFieldsInArrayTransform mixes UiSdlDataTransform<json, json>
