/**
 * Transform {@link User}s with updated user name.
 *
 * User's name is resolved as follows:
 * 1. Concatenate {@link User#firstName} and {@link User#lastName} if they exist.
 * 2. Else, use {@link User#email} if it exists.
 * 3. Else, use {@link User#name} which is guaranteed to exist.
 */
@typeScript
type UiSdlTransformReliabilityCreatedByUser mixes UiSdlDataTransform<json, json>{

  /**
   * Override abstract function to update the {@link User}'s name
   *
   * @param data
   *           The user data to transform
   * @return The transformed data with updated user name
   */
  transform: function(data: !json): json ts-client
}
