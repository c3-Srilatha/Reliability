remix type UiApTimeseriesChartTsDataset {
  /**
   * Creates a new {@link UiApTimeseriesChartTsDataset} from the given
   * {@link ReliabilityTimedDataQuery#execute} result. Does not populate the {@link #labelMap}, since
   * this is highly dependent on the specific chart being rendered.
   *
   * @param timedDataQueryResult The result of the {@link ReliabilityTimedDataQuery#execute} call.
   * @param project The project to use to determine the units of the feature outputs.
   *                If not provided, units will not be applied to the feature outputs.
   * @return A new {@link UiApTimeseriesChartTsDataset} with the given data.
   */
  create: inline function (timedDataQueryResult: !map<string, any>, project: ReliabilityMl.Project): UiApTimeseriesChartTsDataset js-rhino
}
