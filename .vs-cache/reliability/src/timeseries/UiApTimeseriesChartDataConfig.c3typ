remix type UiApTimeseriesChartDataConfig {

  /**
   * Creates a {@link UiApTimeseriesChartDataConfig} from the given timed data query result.
   * The resulting {@link UiApTimeseriesChartDataConfig} will contain full populated `eventDatasets` and
   * `queryKeys`. The `tsDataset` will be mostly populated, aside from the `labelMap` field, which should be populated
   * by the user of this function.
   *
   * If the `eventDatasets` are not populating well, the constants on `UiApTimeseriesChartEventDataset` may need
   * to be remixed.
   *
   * @param timedDataQueryResult The result of a {@link ReliabilityTimedDataQuery#execute} call.
   * @param project The project to use to determine the units of the feature outputs.
   *                If not provided, units will not be applied to the feature outputs.
   * @return A new {@link UiApTimeseriesChartDataConfig}
   *
   */
  create: inline function (timedDataQueryResult: !map<string, any>, project: ReliabilityMl.Project): UiApTimeseriesChartDataConfig js-rhino
}
