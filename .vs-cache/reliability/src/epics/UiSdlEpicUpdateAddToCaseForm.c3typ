/**
 * Epic to update form fields when a case is updated or selected.
 * This epic listens for actions with field name `caseId` and updates related form fields based on the case details.
 */
type UiSdlEpicUpdateAddToCaseForm mixes UiSdlEpic {

  epic: ~ ts-client
}
