/**
 * This epic listens for `LOADED_DATA_HANDLE` events of the General Model Experiment Form.
 * When a user is editing the preview, the form is pre-populated with the given model name and selected time frame.
 */
type GeneralModelAdjustParamFormPrePopulateEpic mixes UiSdlEpic {

  /**
   * @inheritdoc
   */
  epic: ~ ts-client
}
