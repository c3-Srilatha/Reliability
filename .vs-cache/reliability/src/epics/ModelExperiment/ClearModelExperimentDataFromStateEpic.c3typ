/**
 * This epic clears the model experiment data from the state.
 * When a user navigates to a different URL, the model experiment data is cleared.
 * This is useful to ensure that the model experiment data does not persist across different URLs.
 * This epic clears data from {@link ModelConfigApplicationState} and
 * {@link ModelExperimentApplicationState}.
 */
type ClearModelExperimentDataFromStateEpic mixes UiSdlEpic {

  /**
   * @inheritdoc
   */
  epic: ~ ts-client
}
