/**
 * This epic listens for `PRIMARY_BUTTON_CLICK` events of the General Model Experiment modal.
 * It validates the model name to ensure it is not duplicated among all {@link ReliabilityMlModel}s.
 * It also checks if the model name contains only valid characters.
 * If the name is duplicated, it shows an error modal.
 */
type ValidateDuplicatedModelNameEpic mixes UiSdlEpic {

  /**
   * @inheritdoc
   */
  epic: ~ ts-client
}
