/**
 * Epic that handles the state update for the Data Validation Tab Panel.
 * This epic listens for actions related to the Data Validation run status and updates the UI accordingly.
 * It updates the overview text and subtitle, either showing the status of the latest run or a default message
 * based on the current state of the application.
 */
@typeScript
type UiSdlDataValidationTabPanelUpdateEpic mixes UiSdlEpic {

  epic: ~ ts-client
}
