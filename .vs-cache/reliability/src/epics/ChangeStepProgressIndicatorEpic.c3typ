/**
 * Used to handle user changing step in progress indicator.
 * It expect to receive the following parameters as part of the action payload:
 *  - progressIndicatorId: The id of the progress indicator on which to perform the action.
 *  - shouldGoNext: If true, indicates that moving to the next step should be attempted. If false, moves to the previous step.
 */
@typeScript
type ChangeStepProgressIndicatorEpic mixes UiSdlEpic
