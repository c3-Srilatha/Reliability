/**
 * Gets the model summaries for the model setup asset detail page. This is necessary to prevent
 * {@link UiSdlConditionalRenderer} component `Reliablity.ModelSetupAssetDetailModelsContent`
 * from delaying the network call until the component is mounted. Saves 300-400 ms of load time
 * on a development env.
 */
@typeScript
type GetAssetModelSummaryEpic mixes UiSdlEpic {

  epic: ~ ts-client
}
