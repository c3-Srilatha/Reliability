/**
 * Epic used to prepopulate the `Reliability.SensorAssociationTargetAndTimeSelectorForm` with the `targetTag`.
 *
 * This epic reads from `BulkSensorAssociationUtil` - `ASSETS_GRID_ID` value to extract the selected objects,
 * and reads the `targetTag` from the first selected object.
 */
type TargetTagAndTimeRangeFormPrepopulationEpic mixes UiSdlEpic {

  epic: ~ ts-client
}
