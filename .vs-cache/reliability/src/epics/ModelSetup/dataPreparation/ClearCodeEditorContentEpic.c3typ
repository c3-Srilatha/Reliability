/**
 * Given a {@link UiSdlCodeEditor} in the payload, this epic clears its content.
 * Expects these arguments in the payload:
 * - codeEditorId: the {@link UiSdlCodeEditor} to clear
 */
type ClearCodeEditorContentEpic mixes UiSdlEpic {

  epic: ~ ts-client
}
