/**
 * Helper to handle the different steps on the Data preparation progress indicator.
 */
@typeScript
type DataPreparationOnNextHelper {

  /**
   * Function to save the data on the time window step.
   * It opens a modal when the selected sensor grid does not have any sensor.
   * It opens a modal when the form did not apply the time window.
   *
   * @param action
   *           The action object containing the step data
   * @param state
   *           The current UI SDL Redux state
   * @return The result of processing the time window step
   */
  timeWindowStep: function(action: !any, state: !UiSdlReduxState): !any ts-client

  /**
   * Function to save the data on the training mask step.
   *
   * @param action
   *           The action object containing the step data
   * @param state
   *           The current UI SDL Redux state
   * @return The result of processing the training mask step
   */
  trainingMasksStep: function(action: !any, state: !UiSdlReduxState): !any ts-client
}
