/**
 * This epic listens for `eliability.AssetDataPrepDateRangeMaskFormGrid_dataSpec_ds.DATA_MODIFY` action,
 * and validates the date range mask field value.
 * if the selected date range mask is not within the Training Window, it throws an error banner and disables the continue button.
 */
type DataPreparationDateRangeMaskValidationEpic mixes UiSdlEpic {

  /**
   * @inheritdoc
   */
  epic: ~ ts-client
}
