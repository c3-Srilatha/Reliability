/**
 * Epic to run data preparation job. Takes one param in the payload.
 * All other params are expected to be stored within Reliability.DataPreparationApplicationState.
 * - name: The name of the run to create from the job.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
@typeScript
type DataPreparationRunJobEpic mixes UiSdlEpic {

  /**
   * Function to run data validation job based on the given settings.
   * @param settings Settings to use to run data preparation job.
   * @param onJobStart Function to call when job starts. Gets passed the job as a param.
   * @param onJobEnd Function to call when job completes. Gets passed the job as a parm.
   * @param onJobError Function to call when job errors. Gets passed the error as a param.
   * @return Observable containing redux actions.
   */
  runDataPreparationJob: function(
    settings: ReliabilityDataPreparationUiSettings,
    onJobStart: any,
    onJobEnd: any,
    onJobError: any
  ): any ts-client
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
