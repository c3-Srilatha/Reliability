/**
 * Epic to update the content of a code editor when a sensor is selected in the Sensor Finder component.
 * This epic listens for actions related to the Sensor Finder component and updates the content of a code editor.
 */
@typeScript
type DataPreparationPopulateAdvancedEditorEpic mixes UiSdlEpic {

  epic: ~ ts-client
}
