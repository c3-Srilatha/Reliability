/**
 * Used to handle user navigating away from asset's model configuration.
 * The epic handles following things:
 * 1. Force redirect to asset's model config page: On 'Reliability.AssetModelConfigurationPageTitle.ACTIVE_TAB_SET', the epic
 *      - Starts listening to any GLOBAL_REDIRECT's happening and force redirects user back to asset's model config page via a {@link NavigationHelper#handleForceBackRedirect}.
 *      - The epic also stores the page user originally intended to navigate to in application state and opens a warning modal.
 *      - Stops helper from listening, when GLOBAL_REDIRECT is fired with payload having 'exitAnyway' parameter set to true.
 *
 * 2. Exit anyway from asset's model config page: On 'GLOBAL_REDIRECT' with 'exitAnyway' set to true, the epic
 *      Fires 'GLOBAL_REDIRECT' to page user originally intended to navigate to and clear relevant application and component state.
 */
@typeScript
type ExitModelConfigurationEpic mixes UiSdlEpic {

    epic: ~ ts-client
}
