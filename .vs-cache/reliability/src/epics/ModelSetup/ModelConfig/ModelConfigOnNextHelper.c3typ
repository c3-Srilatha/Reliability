/**
 * Helper to handle saving user selections and perform additional actions into state while the
 * progressing through the steps on the Model Configuration progress indicator.
 */
@typeScript
type ModelConfigOnNextHelper {

  /**
   * Function to save the data on the dataset selection step.
   *
   * @param action
   *           The action object containing the step data
   * @param state
   *           The current UI SDL Redux state
   * @return The result of processing the dataset selection step
   */
  datasetSelectionStep: function(action: !any, state: !UiSdlReduxState): !any ts-client
}
