/**
 * Opens the hyperparams modal and formats hyperparam value based on the given
 * hyperparam's type referenced in the payload.
 */
@typeScript
type ModelConfigOpenEditHyperparamsModal mixes UiSdlEpic {

  /**
   * Based on the given hyperparameter type name, this function returns a json
   * object that contains the props needed to render the correct form. These
   * props can also be used to retreive and validate the hyperparameter value being  edited.
   *
   * The returned json object contains the following properties:
   *
   * - `type`: string enum('json', 'string', 'number', 'enum')
   * - `componentId`: Id of the component that should be rendered to edit the hyperparameter value, e.g. `Reliability.EditEnumHyperparamsForm`.
   * - `componentIsForm`: boolean, whether the component is a form or not. This is helpful to determine how to retrieve the hyperparameter value.
   * - `path`: string, the path to the hyperparameter value in the component's state.
   *
   * @param hyperparamTypeName
   *        the name of the hyperparameter type, e.g. `Boolean`, `Integer`, `String`, `Map<String, String>`, etc.
   * @returns a json object that contains the props needed to render the correct form.
   */
  getCurrentHyperparamFormProps: function(hyperparamTypeName: string): json ts-client
}
