/**
 * If the interval options are updated and the previously selected interval is no longer in the list,
 * the selected interval in the risk reports form should be set to null.
 */
@typeScript
type RiskReportsFormUpdateIntervalEpic mixes UiSdlEpic {

  epic: ~ ts-client
}
