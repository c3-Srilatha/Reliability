/**
 * If all notifications are 'Off' for the Settings form, turn off the fields in the form that specify the frequency
 * with which notifications are sent.
 */
@typeScript
type UiSdlEpicSettingsCheckAllOff mixes UiSdlEpic {

  epic: ~ ts-client
}
