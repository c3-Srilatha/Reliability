/**
 * Sets the selectedName field in Application State. Can be used to update header field with the selectedName field.
 * Can also open a modal with the updated name when modalId is passed.
 */
@typeScript
type UiSdlEpicSetSelectedNameInState mixes UiSdlEpic {

    epic: ~ ts-client
}
