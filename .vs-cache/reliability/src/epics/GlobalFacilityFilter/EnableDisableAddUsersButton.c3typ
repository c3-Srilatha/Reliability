/**
 * Listens to 'INPUT_CHANGE' on 'Relibaility.AddUsersForm'.
 * If there are no users selected in the form, disables primary 'ADD' button on 'Reliability.AddUsersToFacilityModal', else enables it.
 */
@typeScript
type EnableDisableAddUsersButton mixes UiSdlEpic {

  epic: ~ ts-client
}
