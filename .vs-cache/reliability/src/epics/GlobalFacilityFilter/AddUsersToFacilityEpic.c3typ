/**
 * Listens to `VALIDATE_AND_SUBMIT` from Add Users form and does the following:
 * 1. Makes {@link Facility#addUserAccess} request with passed in users.
 * 2. Shows banner with information about users added.
 * 3. Updates the Facility and Additional users grid, as applicable.
 */
@typeScript
type AddUsersToFacilityEpic mixes UiSdlEpic {

  epic: ~ ts-client
}
