/**
 * Updates `title` and `subtitle` of `Reliability.GlobalFacilityFilterTopContent`.
 * `title` is updated to show number of facilities selected currently, for example, 2 of 3 Facilities Selected.
 * `subtitle` is updated either as comma separated facility names or `All Facilities`.
 */
@typeScript
type UpdateSelectedFacilitiesTitleEpic mixes UiSdlEpic {

  epic: ~ ts-client
}
