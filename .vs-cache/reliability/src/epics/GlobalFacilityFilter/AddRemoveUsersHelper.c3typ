/**
 * Helper type which houses functions that are commonly used by workflows Adding and Removing users from a facility
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
@typeScript
type AddRemoveUsersHelper {

  /**
   * Triggers the banner showing details about the users' whose access is being modified in the All Facilities grid.
   *
   * @param userInfo
   *           Information about the users being modified
   * @param facilityName
   *           The name of the facility
   * @param banner
   *           The banner message to display
   * @param modificationType
   *           The type of modification being performed
   * @return A banner show action to display the user modification details
   */
  showUsersModifiedBannerAction: function(userInfo: json, facilityName: string, banner: string, modificationType: string): !UiSdlBannerShowAction ts-client

  /**
   * If the row in All Facilities grid is expanded, refreshes the Additional Users grid as users' access is being modified.
   *
   * @param state
   *           The current UI SDL Redux state
   * @param facilityId
   *           The ID of the facility
   * @return The result of fetching additional users grid data
   */
  fetchAdditionalUsersGrid: function(state: UiSdlReduxState, facilityId: string): !any ts-client
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
