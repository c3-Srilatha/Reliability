/**
 * Listens to `CHECKBOX_PRIMARY_BUTTON_CLICK` and `ROW_ACTION_CLICK_REMOVE_USER` actions emitted from the nested users grid under facility grid.
 * This epic opens the modal to remove users from a facility and shows the selected users in a grid.
 */
@typeScript
type ShowRemoveUsersFromFacilityModal mixes UiSdlEpic {

  epic: ~ ts-client
}
