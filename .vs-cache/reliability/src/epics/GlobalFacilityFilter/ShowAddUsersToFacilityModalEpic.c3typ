/**
 * Listens to `ADD_USERS` action emitted from the All facilities grid in facility access tab.
 * This epic opens the modal to add users to a facility and gets unassigned users for a facility.
 */
@typeScript
type ShowAddUsersToFacilityModalEpic mixes UiSdlEpic {

  epic: ~ ts-client
}
