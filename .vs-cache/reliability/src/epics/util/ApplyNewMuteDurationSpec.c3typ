/**
 * Specification type for muting alerts in the client side.
 * This type holds all the fields applicable for applying a new mute duration.
 */
@typeScript
type ApplyNewMuteDurationSpec {

  /**
   * Indicates the objects to which the {@link ApplyNewMuteDurationSpec#newMuteDuration} should be applied.
   */
  objs: [ReliabilityAssetToModelRelation|Sensor]

  /**
   * Indicates whether all {@link ApplyNewMuteDurationSpec#objs} should be updated
   * with the specified {@link ApplyNewMuteDurationSpec#newMuteDuration}.
   */
  updateAll: !boolean

  /**
   * Indicates the new mute duration to apply to the specified {@link ApplyNewMuteDurationSpec#objs}.
   */
  newMuteDuration: !datetime

  /**
   * Indicates the {@link TimeZone} to use when interpreting the {@link ApplyNewMuteDurationSpec#newMuteDuration}.
   */
  targetTimezone: !string
}
