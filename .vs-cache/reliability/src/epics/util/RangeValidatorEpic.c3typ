/**
 * Epic that validates a range between two form fields, and sets
 * {@link UiSdlFieldSetFormFieldSetting#invalid} to `true` if the range is invalid and `false` otherwise.
 * ({@link UiSdlForm#updateFieldValidityAction})
 *
 * Expected payload:
 * - `fieldsToCheck`: Array of objects with the following properties:
 *   - `startField`: Field name of the start of the range.
 *   - `endField`: Field name of the end of the range.
 *   - `isDate`: Specifies if the range is a date range.
 * - `fieldName`: Name of the modified field (inherent from `INPUT_CHANGED` action).
 *
 * Usage example:
 * ```json
 * {
 *   "trigger": "INPUT_CHANGED",
 *   "effectType": "RangeValidatorEpic",
 *   "payloadStrategy": "MERGE",
 *   "payload": {
 *     "fieldsToCheck": [
 *       {
 *         "startField": "trainingStart",
 *         "endField": "trainingEnd",
 *         "isDate": true
 *       },
 *       {
 *         "startField": "minValue",
 *         "endField": "maxValue"
 *       }
 *     ]
 *   }
 * }
 * ```
 */
type RangeValidatorEpic mixes UiSdlEpic {

    epic: ~ ts-client
}
