/**
 * Listens to `Reliability.ModelDetailTabPane.ACTION_CLICK_PRIMARY` and sets the ml project id in the application state.
 * This is used later in order to identify which assets have the datasets relevant to the ml project.
 */
@typeScript
type SetMlProjectIdEpic mixes UiSdlEpic {

  epic: ~ ts-client
}
