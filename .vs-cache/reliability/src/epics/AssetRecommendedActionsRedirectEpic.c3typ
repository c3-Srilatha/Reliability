/**
 * Thsi epic is triggered when the user clicks on a recommended action from the Asset Detail page.
 * It redirects the user to the appropriate page/section of the application categorized by the type of the recommended action.
 */
@typeScript
type AssetRecommendedActionsRedirectEpic mixes UiSdlEpic {

  epic: ~ ts-client
}
