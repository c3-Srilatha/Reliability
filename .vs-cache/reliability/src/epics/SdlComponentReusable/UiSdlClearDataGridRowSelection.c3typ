/**
 * Epic will clear the selected rows from a {@link UiSdlDataGrid#selectRowAction}. This is done by retrieving the
 * selections from state and then calling selectRowAction. This is only for single row selections and not multi-select
 * checkboxes.
 *
 * Required payload is only the field `dataGridId` as a string.
 */
type UiSdlClearDataGridRowSelection mixes UiSdlEpic {

  epic: ~ ts-client
}
