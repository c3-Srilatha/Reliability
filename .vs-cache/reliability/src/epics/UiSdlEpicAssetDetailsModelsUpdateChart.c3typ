/**
 * - Gets {@link ReliabilityApplicationState#selectedAssetModelRelation}.
 * - Gets the `Reliability.AssetDetailModelsFeaturesGrid' {@link UiSdlBaseDataGrid#selectedItemIds}.
 * - Gets the dates that will be render on the chart from {@link ReliabilityApplicationState#selectedChartDate}.
 * - Dispatches the action to update arguments needed for the network call needed to update the given chart and a
 * `DATA_REQUEST` for the same component.
 *
 * Expected payload:
 * - `chartId`: The ID of the chart component that is updated.
 */
@typeScript
type UiSdlEpicAssetDetailsModelsUpdateChart mixes UiSdlEpic {

  epic: ~ ts-client
}
