/**
 * Epic that listens to the "ROW_TOGGLE" action on any of the grid elements in the Model Management - Jobs page.
 * depending on the grid, it will store the reference of the Job in its own ApplicationState and close all other.
 * open elements in the grid. Keeping track of the open one.
 */
@typeScript
type JobsGridStateModifierEpic mixes UiSdlEpic {

  /**
   * Function that changes the Application states and triggers "ROW_TOGGLE" actions.
   */
  epic : ~ ts-client
}
