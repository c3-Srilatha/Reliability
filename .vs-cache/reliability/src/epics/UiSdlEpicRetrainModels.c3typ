/**
 * The epic used to trigger the retraining of models from the BulkRetrainModelsModal and ConfirmRetrainModelsModal.
 * After model training has been kicked off, both modals will close, and the component provided in dataSourceId will be refreshed.
 */
@typeScript
type UiSdlEpicRetrainModels mixes UiSdlEpic {

  epic: ~ ts-client
}
