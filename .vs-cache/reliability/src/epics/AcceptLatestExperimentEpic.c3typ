/**
 * Epic that calls {@link ReliabilityMlModel#acceptLatestModelExperiment} in the model details page.
 * It accepts the base model for a model and optionally deploys it as the champion or candidate model.
 * It redirects to the model setup jobs page after the operation is complete.
 */
type AcceptLatestExperimentEpic mixes UiSdlEpic {

  /**
   * @inheritdoc
   */
  epic: ~ ts-client
}
