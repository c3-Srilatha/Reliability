/**
 * Listens for 'PRIMARY_BUTTON_CLICK' events on `Reliability.MetricConfigReviewAndConfirmModal`. Submits the information
 * required in order to create or update a {@link ReliabilityMetric}.
 * After the creation or update finishes, it redirects to the `Reliability.MetricConfiguration` page.
 */
@typeScript
type SubmitReliabilityMetricEpic mixes UiSdlEpic {

    epic: ~ ts-client
}
