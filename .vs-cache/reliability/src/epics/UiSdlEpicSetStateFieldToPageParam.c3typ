/**
 * Sets a specified field in the Application State to a page param if the field is not set.
 * Designed to prevent data loss in the Application State when the page is reloaded.
 */
@typeScript
type UiSdlEpicSetStateFieldToPageParam mixes UiSdlEpic {

  epic: ~ ts-client
}
