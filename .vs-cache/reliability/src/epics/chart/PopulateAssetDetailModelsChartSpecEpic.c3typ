/**
 * Epic triggered when user clicks on Plot Features/Plot Model Outputs button of the Asset Detail Models Page.
 *
 * This epic is used to populate the {@link AssetDetailModelsChartSpec} which is send to the charting APIs to plot charts
 * on Asset Detail Models page.
 */
@typeScript
type PopulateAssetDetailModelsChartSpecEpic mixes UiSdlEpic {
  /**
   * @inheritdoc
   */
  epic: ~ ts-client
}
