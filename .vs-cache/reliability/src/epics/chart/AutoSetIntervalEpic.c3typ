/**
 * Epic triggered to automatically set time intervals for reliability analysis components.
 * This epic handles automatic interval configuration based on user actions or data changes.
 * Needs to be triggered on:
 * - `SINGLE_INPUT_CHANGE` action
 * - `MULTIPLE_INPUTS_CHANGE` action
 * - `GLOBAL_SET_CURRENT_PAGE` action
 */
@typeScript
type AutoSetIntervalEpic mixes UiSdlEpic {

    /**
     * @inheritdoc
     */
    epic: ~ ts-client
}
