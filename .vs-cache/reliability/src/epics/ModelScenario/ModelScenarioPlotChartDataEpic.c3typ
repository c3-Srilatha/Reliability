/**
 * Epic that handles the retrieval of chart data for the Model Scenario Plot Chart, and updates
 * {@link ModelScenarioApplicationState#selectedItems}.
 *
 * Expected payload:
 * - `dataItems`: An array of {@link Feature#id}s to be plotted.
 */
type ModelScenarioPlotChartDataEpic mixes UiSdlEpic {

  /**
   * @inheritdoc
   */
  epic: ~ ts-client
}
