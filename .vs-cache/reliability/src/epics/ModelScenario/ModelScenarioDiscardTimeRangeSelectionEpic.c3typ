/**
 * Epic that restores the original time range from uploaded CSV data in the Model Scenario workflow.
 *
 * When users upload CSV data, the time range is stored in `scenarioWindowAtCSVUpload`. This epic
 * restores that original time range when users want to discard their subsequent time range changes.
 *
 * **Functionality:**
 * - Retrieves stored time range from {@link ModelScenarioApplicationState#scenarioWindowAtCSVUpload}
 * - Updates the filter panel's data range field with the stored values
 * - Hides inline notifications about time range mismatches
 *
 * @see ModelScenarioApplicationState
 * @see ModelScenarioUpdateTimeRangeHandlerEpic
 */
type ModelScenarioDiscardTimeRangeSelectionEpic mixes UiSdlEpic {

  /**
   * @inheritdoc
   */
  epic: ~ ts-client
}
