/**
 * Epic that handles the opening of the confirmation modal when starting a model scenario.
 *
 * This epic expects no `action.payload` and will:
 * - Validate the scenario name is populated, and the time range is selected.
 * - Then open the confirmation modal to start the scenario.
 */
type ModelScenarioOpenConfirmStartModalEpic mixes UiSdlEpic {

  /**
   * @inheritdoc
   */
  epic: ~ ts-client
}
