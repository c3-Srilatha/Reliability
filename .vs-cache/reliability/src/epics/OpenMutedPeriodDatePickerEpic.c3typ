/**
 * Epic that opens the muted period date picker when the `EDIT_MUTE_PERIOD` row action is triggered.
 *
 * Finds the date picker in the DOM and clicks the calendar icon button to open it.
 */
type OpenMutedPeriodDatePickerEpic mixes UiSdlEpic
