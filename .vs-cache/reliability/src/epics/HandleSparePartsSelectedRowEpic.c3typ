/**
 * This epic is used to handle SparePartsGrid ROW_SELECT action.
 * If the value for `payload.dataItem.selected` is `true`, the chart {@link SparePartsForecastChart} will be cleared.
 * Else, the chart {@link SparePartsForecastChart} will be loaded based on the selected part in the All Parts Grid.
 */
type HandleSparePartsSelectedRowEpic mixes UiSdlEpic {

  epic: ~ ts-client
}
