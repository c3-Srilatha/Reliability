/**
 * Formats the specified date using {@link UiSdlDateTimeParamKindFormatSpec} in conjunction with Intl.DateTimeFormat;
 * otherwise, renders the given {@link ReliabilityGridDateTimeCustomCell#emptyDateFallback} if the provided date value is undefined or null.
 */
type ReliabilityGridDateTimeCustomCell extends UiSdlDataGridCell {

  /**
   * Default text to display when the date value is missing or undefined.
   */
  emptyDateFallback: string

  /**
   * {@link UiSdlDateTimeParamKindFormatSpec} structure used to format the date when is present.
   */
  spec: !UiSdlDateTimeParamKindFormatSpec
}
