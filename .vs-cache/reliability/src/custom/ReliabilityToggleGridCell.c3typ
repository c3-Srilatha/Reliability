/**
 * Custom toggle button for {@link UiSdlDataGrid} cell.
 */
type ReliabilityToggleGridCell mixes UiSdlDataGridCell {
  /**
   * The text to display when the toggle is on.
   */
  onText: !string

  /**
   * The text to display when the toggle is off.
   */
  offText: !string
}
