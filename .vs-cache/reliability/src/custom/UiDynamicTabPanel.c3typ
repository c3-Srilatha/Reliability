/**
 * An extension of {@link UiSdlTabPanel} that allows for dynamic hiding and showing of tab components.
 *
 * This is necessary since the `tabComponents` prop consists of React elements, which are not settable
 * using `derivedProps`.
 */
type UiDynamicTabPanel mixes UiSdlTabPanel {
  /**
   * A map of tab component ids to boolean values indicating whether the tab component is visible.
   * If a tab component is not in the map, it is assumed to be visible.
   *
   * Currently, this can only be set using {@link UiSdlConnected#derivedProps}.
   */
  tabComponentVisibility: map<string, boolean>

  /**
   * If true, the tab panel will be rendered with a separate tab bar and tab components.
   * Normally, these are contained within the tab panel. This leads to performance gains since only parts of
   * the component tree are re-rendered when the tab is changed, and there is less dependency of the tab component
   * on the tab panel. This should achieve feature parity with the normal tab panel, but is disabled by default to avoid
   * regressions.
   */
  useSeparateTabComponent: boolean
}
