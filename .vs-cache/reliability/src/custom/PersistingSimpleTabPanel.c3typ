/**
 * Simplified tab panel that will not mount/unmount tab contents on active tab change. Instead,
 * it hides/shows them via styling. It also differs from {@link UiSdlTabPanel} in that it does
 * not have a header section with title, subtitle, or buttons. It only displays the tabs
 * and their content.
 */
type PersistingSimpleTabPanel extends UiSdlComponent<UiSdlNoData> {
  /**
   * Configurations of components to be rendered as child tabs.
   * Id is required, title is optional.
   */
  tabComponents: ![UiSdlTabComponentRef]
}
