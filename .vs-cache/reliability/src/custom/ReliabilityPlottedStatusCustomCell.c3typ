/**
 * Custom cell for displaying an action button that the plot or hide a {@link Sensor}.
 * It uses the {@link ReliabilityPlottedStatusCustomCellReact} to render the cell.
 */
type ReliabilityPlottedStatusCustomCell extends UiSdlDataGridCell{
  /**
   * The app state from which we get the array to determine if the sensor is plotted.
   */
  appState: string

  /**
   * The path to the array in the app state that contains the plotted sensors.
   */
  path: string

  /**
   * The icon to display in the cell.
   */
  icon: string
}
