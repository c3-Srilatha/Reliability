/**
 * Selectable Dropdown custom grid cell.
 */
type ReliabilityDropdownGridCell mixes UiSdlDataGridCell {

  /**
   * The id of the {@link UiSdlApplicationState} object that contains the options for the dropdown.
   */
  appStateId: string

  /**
   * The field name of the {@link ReliabilityDropdownGridCell#appStateId} that contains the options for the dropdown.
   */
  appStateFieldName: string
}
