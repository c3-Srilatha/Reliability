 * Condition used to determine whether to show the `Reliability.ChangeSensorSettingsModalOperationalStatusPermissionDeniedWarning` component
 * Checks the users assigned roles include Reliability.LimitedModelUser.Role, if it is not present, the warning is shown
 */
 @typeScript
 type UiSdlOperationalStatusPermissionDeniedRenderCondition mixes UiSdlRenderCondition {
   useCondition: ~
 }
