/**
 * Custom {@link UiSdlInlineNotification} component that supports line breaks in the given title and subtitle,
 * and automatically selects an icon based on the provided status.
 */
type ReliabilityInlineNotification mixes UiSdlInlineNotification {

  /**
   * The title of the inline notification.
   */
  title: !string

  /**
   * The subtitle of the inline notification.
   */
  subtitle: !string

  /**
   * The status of the inline notification. If omitted, it is displayed with a white background and no icon.
   */
  status: string enum('INFO', 'WARNING', 'ERROR', 'SUCCESS')
}
