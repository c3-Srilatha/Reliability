/**
 * This type stores all the data that will be shown in the Model Validation Chart in the UI.
 */
type ModelValidationChartData {

  /**
   * Map of series names to array of data points. Each data point is represented by a number. The data array
   * is aligned with the timestamps array.
   */
  seriesData: json

  /**
   * An array of stringified timestamps based on the interval and duration
   * of the model validation chart.
   */
  timestamps: [string]

  /**
   * Map of events and alerts. The key is 'event' or 'alert'.
   */
  eventData: map<string, FetchResult<any>>

  /**
   * Map of model output/input names to their respective thresholds
   */
  thresholds: map<string, [map<string, double>]>

  /**
   * The data configuration to use to plot the masks as EChart mark areas.
   */
  maskConfig: json

  /**
   * The column groups to plot in the chart. Each column group is a list of strings that correspond
   * to keys in the seriesData map.
   */
  columnGroups: json

  /**
   * A map of feature names to column groups. When a feature is selected in the ui, its column groups
   * will be plotted.
   */
  featureToColumnGroups: json

  /**
   * The interval used to determine whether the interval options should be displayed in the UI.
   */
  preparationInterval: string
}
