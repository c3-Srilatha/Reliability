/**
 * Used to render different component inside {@link UiSdlGridLayout} based on switch condition at runtime.
 * The switch condition is determined through the {@link UiSdlDynamicValueSpecParam param} extracted value.
 */
@typeScript
type UiDynamicComponentStateSwitchRenderer mixes UiSdlRenderSwitchCondition {

  /**
   * Param used to extract the value for the #useSwitchCondition.
   */
  param: UiSdlDynamicValueSpecParam

  useSwitchCondition: ~ ts-client
}
