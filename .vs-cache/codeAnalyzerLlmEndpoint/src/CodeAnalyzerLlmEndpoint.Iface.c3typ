/**
 * The interface for the llm endpoint service.
 */
abstract type CodeAnalyzerLlmEndpoint.Iface mixes Microservice.Iface, Singleton {

  /**
   * Gets the LLMs supported by the llm endpoint service, including a default.
   *
   * @return The available LLMs as a {@link CodeAnalyzerLlmEndpoint.AvailableLlmsResponse}.
   */
  availableLlms: abstract function(): CodeAnalyzerLlmEndpoint.AvailableLlmsResponse

  /**
   * A function that calls the LLM with the given query and gets the response.
   * If no LLM is specified, the service's default LLM will be used.
   * If the specified LLM is not supported, an exception will be thrown.
   *
   * @param spec The spec for calling the LLM.
   * @return The LLM used and the response as a {@link CodeAnalyzerLlmEndpoint.CallLlmResponse}.
   */
  callLlm: abstract function(spec: CodeAnalyzerLlmEndpoint.CallLlmSpec): CodeAnalyzerLlmEndpoint.CallLlmResponse

}
