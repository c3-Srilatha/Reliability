/**
 * Spec to be passed into the {@link CodeAnalyzerLlmEndpoint#callLlm} function.
 */
type CodeAnalyzerLlmEndpoint.CallLlmSpec {

  /**
   * The query string for the LLM.
   */
  query: string

  /**
   * The system prompt to call the LLM with.
   */
  systemPrompt: string

  /**
   * The LLM to call.
   */
  llm: string

  /**
   * The ID of the caller, e.g. a Jarvis build, for rate limiting.
   */
  callerId: string

  /**
   * The ID of the agent run, for rate limiting.
   */
  agentRunId: string

}
