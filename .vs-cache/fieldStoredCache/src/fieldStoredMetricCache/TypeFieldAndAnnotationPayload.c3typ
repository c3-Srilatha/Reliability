/**
 * Payload for the function {@link FieldStoredMetricCache#getFscAnnotatedTypeFieldPairs}.
 */
type TypeFieldAndAnnotationPayload mixes Spec, Result {

  /**
   * The type which has a field with the given annotation.
   */
  typeRef: !Type

  /**
   * The name of the field on the type which has the given annotation.
   */
  fieldName: !string

  /**
   * The {@link Ann.MetricCache} annotation with all fields populated.
   */
  annotation: !Ann.MetricCache
}
