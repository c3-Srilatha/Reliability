/**
 * Entity type `FieldStoredMetricCacheBatchJob` represents a batch job for updating metric fields in the 
 * `FieldStoredMetricCache` schema. It extends the `BatchJob` type and includes functionality for starting 
 * the job, processing batches, and evaluating metric values.
 */
entity type FieldStoredMetricCacheBatchJob extends BatchJob<FieldStoredMetricCacheBatchJob, FieldStoredMetricCacheBatchJobOptions, FieldStoredMetricCacheBatch> type key 'FSMCBJ' {

  /**
   * Starts a {@link FieldStoredMetricCacheBatchJob} to update the specified field in the provided options.
   * 
   * @param options The options for the batch job, including the field to be updated.
   * @return A started {@link FieldStoredMetricCacheBatchJob} instance.
   */
  startJob: function(options: FieldStoredMetricCacheBatchJobOptions): !FieldStoredMetricCacheBatchJob js-rhino

  /**
   * Starts the process to evaluate all relevant {@link FieldStoredMetricCache} (FSMC) instances for this batch job. 
   * It processes each FSMC one at a time and batches the evaluation into smaller {@link FieldStoredMetricCacheBatch} units.
   * 
   * See {@link FieldStoredMetricCacheBatchJobOptions} for more details on how batches are defined.
   */
  doStart: ~ js-rhino

  /**
   * Processes a single {@link FieldStoredMetricCache} (FSMC) for a subset of its `srcType` IDs.
   * Metrics for these IDs are evaluated, and the results are stored on the specified field within the FSMC.
   * 
   * See {@link FieldStoredMetricCacheBatch} for more information on how the batch processes the data.
   */
  processBatch: ~ js-rhino
}
