/**
 * This annotation does not automatically generate any seed data. It is used to simplify the process of creating an
 * {@link FieldStoredMetricCache} instance and provide self documenting code.
 *
 * Fields on entity types that have this annotation can easily generate the matching {@link FieldStoredMetricCache} and {@link CronJob}
 * objects, by calling the {@link FieldStoredMetricCache#generateSeedDataForAllAnnotations} function. See the documentation
 * on that function for more details.
 *
 * **Note:** If the seed data is updated, then this annotation will be invalid but there will be no indication of the difference.
 * This is similar to if you used normal documentation to describe how the field was updated.
 */
@beta
@annotation(appliesTo=['field'])
type Ann.MetricCache mixes Annotation {
  /**
   * The metric expression to evaluate and store on this field.
   * The metric will always be evaluated over the past day, but using window or other [aggregation functions](ExpressionEngineFunction)
   * allows for the value to be calculated over a larger time frame.
   */
  metricExpression: !string

  /**
   * The interval for which to evaluate the #metricExpression. Matches the field {@link FieldStoredMetricCache#interval}.
   */
  interval: !string enum Interval

  /**
   * The {@link CronSchedule#cronExpression} of how often this cached field should be updated.
   * A {@link CronJob} will be generated (but not upserted) with this expression and linked to the {@link FieldStoredMetricCache#cronJob} field.
   */
  cronExpression: string

  /**
   * This field matches {@link FieldStoredMetricCache#filter}.
   */
  filter: string = '1==1'

  /**
   * The opposite of {@link FieldStoredMetricCache#enabled}. By default, this cache will be enabled.
   */
  disabled: boolean = false

  /**
   * Function to generate the {@link FieldStoredMetricCache} and {@link CronJob} instances for this annotation.
   * These instances will not be upserted, but rather should be added to {@link SeedData}.
   * The inputs are the srcType and fieldName of the field that this annotation is on.
   * The output will be the {@link FieldStoredMetricCache} and {@link CronJob} instances represented by the annotation.
   *
   * See {@link FieldStoredMetricCache#generateSeedDataForAllAnnotations} for more information on how this is used.
   */
  generateFieldStoredMetricCache: member function(srcType: !Type, fieldName: !string): !Pair<FieldStoredMetricCache, CronJob> js-rhino

  /**
   * Create a cron job instance using the #cronExpression field.
   * This cron job will start a {@link FieldStoredMetricCacheBatchJob} that will update the
   * {@link FieldStoredMetricCache} instance generated by #generateFieldStoredMetricCache.
   *
   * The id of the {@link CronJob} will be defined by {@link generateAutomaticCronJobId}.
   * If there is no #cronExpression, then this will return null.
   */
  generateCronJob: member function(srcType: !Type, fieldName: !string): CronJob js-rhino

  /**
   * Generate a unique id for the srcType and fieldName pair. This ensures that future results will be consistent.
   */
  generateAutomaticCronJobId: member function(srcType: !Type, fieldName: !string): !string js-rhino
}
