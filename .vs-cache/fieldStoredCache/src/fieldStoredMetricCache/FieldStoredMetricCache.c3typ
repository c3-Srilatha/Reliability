/**
 * A way to configure a {@link FieldStoredMetricCacheBatchJob} to cache metric evaluations directly on a type's field.
 */
@db(unique=['srcType, fieldName'])
entity type FieldStoredMetricCache extends DataDiagnostic type key 'FLD_STR_MTRC_CCH' {
  /**
   * The field on {@link #srcType} to store the metric result.
   * If the field is a {@link Dimension}, it will also store the {@link Timeseries#unit} to the field.
   */
  fieldName: !string

  /**
   * The metric expression to evaluate. It will always evaluate over the last #interval.
   * The last result of the evaluation will be stored on the typeName's {@link #fieldName}.
   * Use window or other aggregation expressions to calculate over a larger range of time.
   */
  @constraint(condition='exists(metricExpression) && exists(interval)')
  metricExpression: !~

  /**
   * The period and interval should be the same because only the last data point of metric result is saved to the field.
   */
  period: ~ calc {unit: interval, count: 1}

  /**
   * Whether this instance was generated because of an {@link Ann.MetricCache} annotation.
   */
  generatedByAnnotation: boolean = false

  /**
   * Take an evalMetricsResult with data for multiple entities and store the last data point at
   * {@link #fieldName} of {@link #srcType}.
   */
  @dependency(include='id, srcType, fieldName')
  storeMetricsResult: member function(evalMetricsResult: !EvalMetricsResult) js-rhino

  /**
   * Refresh cache {@link #fieldName} on the {@link #srcType}.
   * Returns the batch job created to perform this refresh.
   */
  refreshCacheFields: member function(overrideFilterSpec: DataDiagnosticFilterSpec): !FieldStoredMetricCacheBatchJob js-rhino

  /**
   * Get a list of all types and fieldNames pairs that contain the annotation {@link Ann.MetricCache}.
   */
  getFscAnnotatedTypeFieldPairs: function(): [TypeFieldAndAnnotationPayload] js-rhino

  /**
   * Given an input list of {@link TypeFieldAndAnnotationPayload}s, call {@link Ann.MetricCache#generateFieldStoredMetricCache}
   * on each annotation and generate a list of {@link FieldStoredMetricCache} and {@link CronJob} pairs.
   */
  generateSeedDataForAnnotations: function(payload: [TypeFieldAndAnnotationPayload]): [Pair<FieldStoredMetricCache, CronJob>] js-rhino

  /**
   * Transform the output of {@link FieldStoredMetricCache#generateSeedDataForAnnotations}
   * into a pair containing two lists. One of {@link FieldStoredMetricCache} and one of {@link CronJob}.
   */
  transformListOfPairsToPairOfLists: function(listOfPairs: [Pair<FieldStoredMetricCache, CronJob>]): Pair<[FieldStoredMetricCache], [CronJob]> js-rhino

  /**
   * This function will create a list of {@link FieldStoredMetricCache} and {@link CronJob}s for all [annotations](Ann.MetricCache)
   * in this {@link Pkg}.
   *
   * This function alone will not change the data in the entities. The recommended method is to update the annotations in the package,
   * and then call this function. Then in static console, you can copy each of the two arrays and paste them into the
   * .json files in the metadata folder of this package.
   *
   * There are no filters applied to the annotations, but this function calls the following functions if
   * more control is needed:
   * - #getFscAnnotatedTypeFieldPairs
   * - #generateSeedDataForAnnotations
   * - #transformListOfPairsToPairOfLists (private function)
   */
  generateSeedDataForAllAnnotations: function(): Pair<[FieldStoredMetricCache], [CronJob]> js-rhino
}
