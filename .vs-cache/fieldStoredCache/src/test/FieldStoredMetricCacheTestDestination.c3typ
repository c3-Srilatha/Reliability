/**
 * This type is used by the tests for {@link FieldStoredMetricCache}.
 * It is placed in the src folder since we need to use meta data of this type in the function.
 */
entity type FieldStoredMetricCacheTestDestination mixes FeatureEvaluatable schema name 'FSMC_TST_DST' {

  /**
   * Average value of `metric1` over the past day.
   */
  metric1PastDay: double

  /**
   * Average value of `metric2` over the past day.
   */
  metric2PastDay: double

  /**
   * Average value of `metric3` over the past day.
   */
  metric3PastDay: Dimension
}
