/**
 * General options that apply to both {@link FieldStoredCalcCacheBatchJob} and {@link FieldStoredMetricCacheBatchJob}.
 */
abstract type FieldStoredCacheBatchJobOptions<FSC> mixes Spec {

  /**
   * The {@link CronJob} schedule calling the the {@link FieldStoredCalcCacheBatchJob}.
   * Used to retrieve the relevant, enabled {@link FieldStoredCalcCache#cronJob}s to evaluate.
   * Ignored if #fieldStoredCache is specified.
   */
  cronJob: !CronJob

  /**
   * The instance of the {@link FieldStoredCalcCache} that this batch job will evaluate.
   */
  fieldStoredCache: !FSC

  /**
   * Override the {@link FieldStoredCalcCache#filter} being applied on entities in the {@link FieldStoredCalcCache#srcType}.
   * The overridden filter will be applied to all {@link FieldStoredCalcCache}s.
   */
  overrideFilterSpec: DataDiagnosticFilterSpec

  /**
   * Number of records in {@link FieldStoredCalcCache#srcType} to evaluate per batch.
   * This is used if there is no {@link FieldStoredCalcCache#batchConfig} specified.
   */
  batchSize: int = 50

  /**
   * Function to get the list of field stored cache (FSC) instances for these batch job options.
   * The get or fetch will include the fields provided in fieldStoredCacheIncludeString.
   */
  getFieldStoredCacheInstances: member function(fieldStoredCacheType: !Type,
                                                fieldStoredCacheIncludeString: !string): [FSC] js-rhino

  /**
   * Generate a batch job ID based on the {@link FieldStoredCacheBatchJobOptions}.
   * Throw errors if the #fieldStoredCache is invalid or if there is neither a #cronJob
   * nor a #fieldStoredCache.
   */
  createBatchJobId: member function(fieldStoredCacheType: !Type): !string js-rhino
}
