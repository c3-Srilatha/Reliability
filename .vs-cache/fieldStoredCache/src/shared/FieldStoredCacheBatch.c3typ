/**
 * Data to indicate what to process in the current batch for the {@link FieldStoredMetricCacheBatchJob}
 * or {@link FieldStoredCalcCacheBatchJob}.
 */
abstract type FieldStoredCacheBatch<FSC> {

  /**
   * The instance of the FSC that this batch will be evaluating.
   */
  fieldStoredCache: !FSC

  /**
   * IDs of the {@link FieldStoredMetricCache#srcType} to be evaluated in this batch.
   */
  ids: [string]
}
