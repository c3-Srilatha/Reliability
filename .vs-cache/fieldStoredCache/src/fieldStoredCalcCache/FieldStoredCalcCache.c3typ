/**
 * A way to configure a {@link FieldStoredCalcCacheBatchJob} to cache read `calc` values directly on a persisted type's field.
 */
@db(unique=['srcType, fieldName'])
entity type FieldStoredCalcCache extends DataDiagnostic type key 'FLD_STR_CLC_CCH' {

  /**
   * The field on #srcType to store the metric result.
   */
  fieldName: !string

  /**
   * The read `calc` field defined on #srcType to read from and store on #fieldName.
   */
  calcField: !string

  /**
   * {@link DataDiagnostic#retrieveDiagnosticData} should only include the #calcField.
   */
  fetchInclude: ~ calc calcField

  /**
   * Take a `fetchResult` with data for multiple entities and store the value of #calcField onto #fieldName.
   */
  @dependency(include='id, srcType, fieldName, calcField')
  storeFetchResult: member function(fetchResult: !FetchResult<json>) js-rhino

  /**
   * Refresh cache #fieldName on the #srcType.
   * Returns the batch job created to perform this refresh.
   */
  refreshCacheFields: member function(overrideFilterSpec: DataDiagnosticFilterSpec): !FieldStoredCalcCacheBatchJob js-rhino
}
