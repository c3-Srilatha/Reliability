/**
 * This type is used by the tests for {@link FieldStoredCalcCache}.
 */
entity type FieldStoredCalcCacheTestDestination mixes MetricEvaluatable schema name "FSCC_TST_DST" {

  /**
   * Destination for caching #field1Calc.
   */
  field1: [string] schema name 'field1'

  /**
   * Destination for caching #fieldNullCalc.
   */
  field2: string

  /**
   * Sample `calc` field that needs to be stored.
   */
  field1Calc: [string] calc ['value1', 'value2']

  /**
   * Sample `calc` field that returns `null` and that needs to be stored.
   */
  fieldNullCalc: string calc null
}
