/**
 * Entity type `FieldStoredMetricCacheListenerTestRemoved` represents a schema named 'FSMC_TST_RMVD'.
 * It contains metric and non-metric fields. Metric fields use caching and are calculated based on
 * metric expressions with time intervals. Constraints can be applied to control when a metric field is
 * calculated.
 */
entity type FieldStoredMetricCacheListenerTestRemoved schema name 'FSMC_TST_RMVD' {

  /**
   * `nonMetricField`: A simple `double` field that does not use metric caching. 
   * This is for storing non-metric data.
   */
  nonMetricField: double

  /**
   * `metricField1`: A metric field cached using the expression 'identity(3)' and updated daily ('DAY').
   */
  @metricCache(metricExpression='identity(3)', interval='DAY')
  metricField1: double

  /**
   * `metricField2`: A metric field cached using the expression 'identity(4)' and updated daily ('DAY').
   * A constraint ensures that this field is only calculated when `metricField2 > 0`.
   */
  @metricCache(metricExpression='identity(4)', interval='DAY')
  @constraint(condition='metricField2 > 0')
  metricField2: double
}
