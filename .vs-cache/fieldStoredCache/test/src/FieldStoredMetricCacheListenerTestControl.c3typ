/**
 * Type with no annotations to test filtering within the test for FieldStoredMetricCacheMetadataListener.
 */
entity type FieldStoredMetricCacheListenerTestControl schema name "FSMC_TST_CNTRL" {

  /**
   * A regular field that is not a metric field, used to test that the listener
   * correctly filters out non-metric fields when processing field updates.
   */
  nonMetricField: double
}
