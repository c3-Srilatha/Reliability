/**
 * The {@link TimedValue} with the associated priority for a specific point in time.
 */
type ReliabilityPriorityTimedValue mixes TimedValue {

  /**
   * The priority value associated with this timed value.
   * Represents the priority level at a specific time.
   * Maps to the {@link ReliabilityPriorityEnum}.
   */
  value: !string enum ReliabilityPriorityEnum
}
