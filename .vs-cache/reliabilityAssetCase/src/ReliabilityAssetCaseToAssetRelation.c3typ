/**
 * Represents the relationship between a {@link ReliabilityAssetCase} and a {@link ReliabilityAsset}.
 * This type links a case to the specific asset being investigated or monitored, ensuring that all
 * investigations, alerts, and work orders are tied to the correct asset.
 */
@db(unique=['from, to'])
entity type ReliabilityAssetCaseToAssetRelation mixes FilterableByFacility schema name 'CS_ASST_RLTN' {

  /**
   * The {@link ReliabilityAssetCase} in this relation.
   */
  from: !ReliabilityAssetCase

  /**
   * The {@link ReliabilityAsset} in this relation.
   */
  to: !ReliabilityAsset

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["to.facility"]
}
