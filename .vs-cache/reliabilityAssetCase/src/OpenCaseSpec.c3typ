/**
 * Spec used to create or edit a case on Create/Edit ReliabilityAssetCase form submit.
 */
type OpenCaseSpec mixes Spec {

  /**
   * Name of the case to be added/Edited.
   */
  name: string

  /**
   * Id of the case to be edited EditCaseForm is invoked.
   */
  caseId: string

  /**
   * Id of the facility to which the case belongs to.
   */
  facilityId: string

  /**
   * A {@link User}'s description of the {@link ReliabilityAssetCase} information.
   */
  description: string

  /**
   * Id of the {@link ReliabilityAssetAlert} linked to the ReliabilityAssetCase
   * Populated from params Id.
   */
  alertId: string

  /**
   * The priority of case being created.
   */
  priority: string enum ReliabilityPriorityEnum

  /**
   * The ID of the assignee for the case.
   */
  assigneeId: string

  /**
   * Comment associated with the case.
   */
  comment: string

  /**
   * The estimated cost of unplanned downtime related to the {@link ReliabilityAssetCase}.
   */
  estimatedCostOfUnplannedDowntime: double

  /**
   * The estimated cost of unplanned maintenance related to the {@link ReliabilityAssetCase}.
   */
  estimatedCostOfUnplannedMaintenance: double

  /**
   * The {@link ReliabilityAsset}s directly associated to the {@link ReliabilityAssetCase}.
   */
  directAssets: [ReliabilityAsset]
}
