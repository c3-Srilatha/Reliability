/**
 * The {@link TimedValueHistory} for the assignee history of a {@link ReliabilityAssetCase}.
 */
@db(datastore='kv', partitionKeyField='parent', persistenceOrder='descending(timestamp)')
entity type CaseAssigneeHistory mixes TimedValueHistory<ReliabilityAssetCase>, ReliabilityAssigneeTimedValue schema name 'CASASGN' {

  /**
   * {@link CaseActivity} fetches on field `attachedFileName`, but there is no corresponding field for this type.
   * Therefore, this field should just be the empty string.
   */
  attachedFileName: string = ''
}
