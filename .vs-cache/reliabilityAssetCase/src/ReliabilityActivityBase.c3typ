/**
 * This type provides a common set of fields and methods for all types of reliability activities.
 */
type ReliabilityActivityBase<P> {
  /**
   * Timestamp indicating when the activity occurred.
   */
  timestamp: !datetime

  /**
   * Description of the activity, such as comments, state change, or value change.
   */
  description: string

  /**
   * The entity that this activity is associated with.
   */
  parent: !P

  /**
   * The type of this activity, categorized by {@link ReliabilityActivity}.
   */
  activityType: string enum ReliabilityActivityCategory
}
