/**
 * Spec used to close a {@link ReliabilityAssetCase} with additional details.
 */
type CloseWithDetailsSpec mixes Spec {

  /**
   * The comment to add when closing the case.
   */
  comment: string

  /**
   * The code to assign to the case.
   */
  caseCode: string enum CaseCodeEnum

  /**
   * The estimated downtime avoided by closing the case.
   */
  estimatedDowntimeAvoided: string enum CaseEstimatedDowntimeAvoidedEnum

  /**
   * The estimated economic impact of closing the case.
   */
  estimatedEconomicImpact: double

  /**
   * The state to transition the alerts to.
   */
  alertState: string
}
