/**
 * @inheritdoc
 */
remix type WorkOrder {
  /**
   * {@link ReliabilityAssetCase} associated with the work order.
   */
  assetCase: ReliabilityAssetCase

  /**
   * Display name for the {@link assignee}.
   * Calculated from assignee's `firstName` or `lastName`. If either exists, it trims and concatenates them to display the full name.
   * If neither `firstName` nor `lastName` exists, it checks if assignee.email exists, and if so, returns the email.
   * If email doesn't exist either, it falls back to returning `name` field of assignee.
   */
  assigneeName: string stored calc (exists(assignee.firstName) || exists(assignee.lastName)) ? trim(assignee.firstName + " " + assignee.lastName): (exists(assignee.email) ? assignee.email : assignee.name)

  /**
   * Create a new {@link WorkOrder} from a form.
   */
  createFromForm: function(formObject: !json): WorkOrder js-rhino

  /**
   * Modifies an existing {@link WorkOrder} from a form.
   */
  mergeFromForm: function(formObject: !WorkOrderSpec, mergeSpec: MergeSpec): WorkOrder js-rhino

  /**
   * Fetches a list of {@link WorkOrder}s and converts timestamps to the {@link ReliabilityTimezoneConfig#uiTimezone}.
   *
   * @returns A list of {@link WorkOrder}s matching the `uiTimezone`.
   */
  localizedFetch: function(spec: !FetchSpec): !FetchResult<WorkOrder> js-rhino

  /**
   * Generates a PDF with all the work orders specified by the given {@link FetchSpec}. Returns the URL to the PDF.
   */
  generatePdf: function(spec: !FetchSpec): !string js-rhino
}
