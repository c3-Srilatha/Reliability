/**
 * Spec used to create / update a {@link WorkOrder}.
 */
type WorkOrderSpec mixes Spec {

  /**
   * The ID of the work order.
   */
  id: string

  /**
   * The name of the work order.
   */
  name: string

  /**
   * The description of the work order.
   */
  description: string

  /**
   * {@link User} who has been assigned to perform this work order.
   */
  assignee: User

  /**
   * The {@link ReliabilityAsset} that is the parent of the work order.
   */
  parent: !ReliabilityAsset

  /**
   * The case associated with the work order.
   */
  assetCase: ReliabilityAssetCase

  /**
   * The priority of the work order.
   */
  priority: string

  /**
   * The status of the work order.
   */
  status: string enum WorkOrderStatusEnum

  /**
   * The Work Order number specified.
   */
  workOrderNumber: string

  /**
   * The type of the work order.
   */
  workOrderType: string

  /**
   * The timestamp on the work order.
   */
  timestamp: datetime

  /**
   * The date that the work order is due.
   */
  workDueDate: datetime
}
