/**
 * Type to track activities related to a parent entity (e.g., case, asset, etc.).
 * Each activity includes a timestamp, description, and associated user information.
 */
type ReliabilityActivity<P> mixes ReliabilityActivityBase<P> {
  /**
   * Name of the user who performed the activity.
   */
  updatedBy: !string

  /**
   * Files attached to this activity (if any).
   */
  files: [FileAttachment]

  /**
   * Fetch all activities for a case by combining Comment, StateMachineHistory,
   * assignee history and feedback history (if applicable).
   * @param spec
   *         Only filter by parent.id is supported
   * @return result will be ordered by descending timestamp
   */
  fetch: function(spec: FetchSpec): !FetchResult<ReliabilityActivity> js-rhino

  /**
   * Return the count of activities for a given parent.
   * Combines comments, state history, assignee history, and feedback history.
   */
  fetchCount: function(spec: FetchFilterSpec): !int js-rhino

  /**
   * Fetch activities based on a given spec.
   * @param spec
   *        The provided filter will be parsed to separate into:
   *        - The original filter by `parent.id` will be applied directly on fetching activities.
   *        - These search filters will be applied to the modified fields.
   * @returns A list of activities retrieved without applying any offset, limit, or ordering.
   */
  fetchActivities: private function(spec: FetchSpec): [ReliabilityActivity] js-rhino

  /**
   * Create a map from user IDs to their display names (first name, last name, or email).
   * If no name, returns the user ID or email.
   * @param users
   *        List of users to map.
   * @return Map of user IDs to display names.
   */
  fetchUserDisplayString: function(users: !?[User]): map<string, string> js-rhino

  /**
   * Change the filter string based on a field to change and a new value for that field. Returns a new filter string.
   *
   * Expects `filterStr` to be of the form:
   * `"<some string> && contains(lowerCase(string(<fieldA>)), <valueA>) || contains(lowerCase(string(<fieldB>)), ..."`
   *
   * If `fieldA === fieldToChange`, the return string will be of the form:
   * `"<some string> && contains(lowerCase(string(<fieldA>)), <newValue>) || contains(lowerCase(string(<fieldB>)), ..."`
   *
   * @param filterStr
   *           The value of the `filter` field of a {@link FetchSpec}
   * @param fieldToChange
   *           A field that `filterStr` is filtering on whose value needs to change.
   * @param newValue
   *           The new value for `fieldToChange` in `filterStr`.
   * @param ignoreFilter
   *            Ignores the filter that match `fieldA === fieldToChange` and it doesn't add to the final result.
   * @return a new filter string that is meant to be the value of the `filter` field of a {@link FetchSpec}.
   */
  editFilterValue: private function(filterStr: !string,
                                    fieldToChange: !string,
                                    newValue: !string,
                                    ignoreFilter: boolean): !string js-rhino

  /**
   * Fetch comments and convert it to {@link ReliabilityActivity}
   * @param spec
   *        The filter criteria for fetching comments.
   * @return List of ReliabilityActivity for comments.
   */
  fetchComment: private function(spec: FetchSpec): [ReliabilityActivity] js-rhino

  /**
   * Fetch {@link StateMachineHistory} and convert it to {@link ReliabilityActivity}
   * @param spec
   *        Filter criteria for fetching state machine history.
   * @return List of ReliabilityActivity for state history.
   */
  fetchStateHistory: private function(spec: FetchSpec): [ReliabilityActivity] js-rhino

  /**
   * Fetch {@link TimedValueHistory} for priority and convert it to {@link ReliabilityActivity}
   * @param spec
   *        Filter criteria for fetching priority history.
   * @return List of ReliabilityActivity for priority changes.
   */
  fetchPriorityHistory: private function(spec: FetchSpec): [ReliabilityActivity] js-rhino

  /**
   * Fetch {@link TimedValueHistory} for assignee and convert it to {@link ReliabilityActivity}
   * @param spec
   *        Filter criteria for fetching assignee history.
   * @return List of ReliabilityActivity for assignee changes.
   */
  fetchAssigneeHistory: private function(spec: FetchSpec): [ReliabilityActivity] js-rhino

  /**
   * Fetch {@link ReliabilityAssetAlertFeedback} for an alert and convert it to {@link ReliabilityActivity}.
   * @param spec
   *        Filter criteria for fetching feedback history.
   * @return List of ReliabilityActivity for feedback.
   */
  fetchFeedbackHistory: private function(spec: FetchSpec): [ReliabilityActivity] js-rhino

  /**
   * Fetch {@link ReliabilityAssetAlertToCaseRelationCaseActivity} and convert it to {@link ReliabilityActivity}.
   */
  fetchAlertToCaseActivity: private function(spec: FetchSpec): [ReliabilityActivity] js-rhino

  /**
   * The {@link Type}s associated with the current {@link ReliabilityActivity} implementation
   * @return A map of string to Type.
   */
  getTypes: abstract private inline function(): map<string, Type> js-rhino

  /**
   * Helper function to get the category of a comment {@link ReliabilityActivity}.
   * @param isFile
   *        Indicates whether the comment has attached files.
   * @return Category of the activity (e.g., comment, state change).
   */
  getCommentCategory: abstract private inline function(isFile: boolean): ReliabilityActivityCategory js-rhino
}
