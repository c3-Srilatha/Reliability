/**
 * Spec used to add a comment and tag users in AddCommentForm
 */
private type AddCommentSpec mixes Spec {

  /**
   * Id of the case for which the comment is added
   */
  id: !string

  /**
   * The list of users tagged in this comment
   */
  taggedUsers: [string]

  /**
   * Comment associated with the case
   */
  comment: !string

  /**
   * URL where file was uploaded, if any
   */
  fileUrls: [string]

  /**
   * The name of the uploaded file
   */
  filenames: [string]

  /**
   * URL where file was uploaded, if any
   * It could contain multiple files spearated by a semicolon
   */
  fileUrl: string

  /**
   * The name of the uploaded file
   * It could contain multiple files spearated by a semicolon
   */
  filename: string

  /**
   * The type of uploaded file
   */
  fileType: string

  /**
   * The flag to identifying comments on close case.
   */
  isCloseComment: boolean
}
