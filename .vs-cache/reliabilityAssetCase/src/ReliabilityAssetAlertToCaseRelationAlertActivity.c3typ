/**
 * Type to represent the action for a {@link ReliabilityAssetAlert} of adding or removing a {@link ReliabilityAssetAlert} to or from a {@link ReliabilityAssetCase}.
 */
entity type ReliabilityAssetAlertToCaseRelationAlertActivity mixes ReliabilityActivityBase<ReliabilityAssetAlert>, FilterableByFacility schema name 'ALRT_CS_ALRT_ACTVTY' {

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["parent.parent.facility"]
}
