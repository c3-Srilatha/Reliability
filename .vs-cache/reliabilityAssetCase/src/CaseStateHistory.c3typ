/**
 * The {@link StateMachineHistory} for tracking the state transitions of a {@link ReliabilityAssetCase}.
 */
entity type CaseStateHistory mixes StateMachineHistory<ReliabilityAssetCase, CaseState, CaseStateTransition> schema name 'CS_ST_HSTRY' {

  /**
   * {@link CaseActivity} fetches on field `attachedFileName`, but there is no corresponding field for this type.
   * Therefore, this field should just be the empty string.
   */
  attachedFileName: string = ''

  /**
   * Comment added on the state history.
   */
  comment: CaseComment

  /**
   * Brief explanation of what caused the {@link ReliabilityAssetCase}. It needs to be specified while closing the case.
   */
  caseCode: string enum CaseCodeEnum

  /**
   * The estimated downtime avoided by {@link ReliabilityAssetCase}. It can be specified while closing the case.
   */
  estimatedDowntimeAvoided: string enum CaseEstimatedDowntimeAvoidedEnum

  /**
   * Covers the production value gained from reduced downtime and the savings from avoiding the cost
   * of emergency maintenance repairs. It can be specified while closing the case.
   */
  estimatedEconomicImpact: double

}
