/**
 * Used to convert the timestamp offset from local timezone
 * to the timezone offset of {@link ReliabilityApplicationState#uiTimezone}.
 * Then convert the timestamp to the UTC format using {@link ReliabilityTimezoneUtils#convertTimestampsToZone}
 * so that backend calls are made in the correct timezone and timestamp.
 */

@typeScript
type UiSdlTransformFilterPanelToTimezone mixes UiSdlDataTransform<json, json> {
  transform: ~
  transformArgs: ~
}
