/**
 * This transform can be used by UI components whose inputs are {@link Timeseries} objects, such as {@link EvalMetricsResult}.
 */
@typeScript
type UiSdlTransformTimeseriesResultToTimeZone mixes UiSdlDataTransform<json, json> {

  /**
   * Convert timestamps within data to the configured timezone
   *
   * @param data
   *        The data returned by the server with timestamps.
   * @param context
   *.       The configured time zone obtained from the {@link ReliabilityApplicationState}.
   *
   * @returns The data with timestamps in the configured timezone
   */
  transform: function(data: !json, context: !string): json ts-client

  /**
   * Converts start and end within spec of args to UTC with correct timezone offset
   *
   * Example:
   * Timestamp in spec: `start('2023-05-01T09:30:00.000-07:00')`, selected timezone is 'Asia/Calcutta'
   * First, drop the wrong offset (-07:00) from local timezone and attach the offset '+05:30' from 'Asia/Calcutta',
   * the new timestamp is '2023-05-01T09:30:00.000+05:30'.
   * Next, convert the new timestamp to the UTC timestamp.
   * Finally, replace the timestamp in spec with the UTC timestamp: `start('2023-05-01T04:00:00.000+00:00')`.
   */
  transformArgs: ~
}
