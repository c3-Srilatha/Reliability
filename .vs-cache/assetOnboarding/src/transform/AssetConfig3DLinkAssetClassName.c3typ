/**
 * Transform to handle asset class names for 3D model linking functionality.
 *
 * This transform processes asset class data to ensure proper formatting and display
 * of asset class names in the 3D model linking interface. It may handle cases where
 * asset class names are missing or need to be formatted for display purposes.
 */
type AssetConfig3DLinkAssetClassName mixes UiSdlDataTransform<json, json> {

  transform: ~ ts-client
}
