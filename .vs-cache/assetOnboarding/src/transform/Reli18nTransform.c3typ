/**
 * Transforms {@link FetchResult}s by using {@link ReliabilityTransformUtil} to return both the original `value` and its `translatedValue`,
 * enabling UI components to access localized display values.
 *
 * Translation example for an {@link Interval}:
 * ```json
 * [
 *   {
 *      "value": "SECOND",
 *      "translatedValue": "Reliability.Second"
 *   },
 *   {
 *      "value": "MINUTE",
 *      "translatedValue": "Reliability.Minute"
 *   },
 *   {
 *      "value": "DAY",
 *      "translatedValue": "Reliability.Day"
 *   },
 * ]
 * ```
 */
type Reli18nTransform mixes UiSdlDataTransform<Array<json>, Array<Reli18nTransformResult>>
