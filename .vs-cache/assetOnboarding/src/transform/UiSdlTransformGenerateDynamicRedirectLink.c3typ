/**
 * This transform can be used to generate redirect link URL dynamically based on site url.
 * The transform is also used for setting the `timeZone` fields for either the {@link UiSdlDefinitionListDataSpec}
 * or {@link UiSdlDataGridDataSpec} components.
 */
@typeScript
type UiSdlTransformGenerateDynamicRedirectLink mixes UiSdlDataTransform<json, json> {

  /**
   * gets current path and generates a redirect link URL based on the site URL.
   *
   * @returns The dataspec of the component with the redirect link URL.
   */
  transform: ~ ts-client
}
