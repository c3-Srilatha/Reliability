/**
 * Represents the output type for {@link Reli18nTransform}.
 * This is used to display translated values in the UI.
 */
type Reli18nTransformResult {
  /**
   * Original value.
   */
  value: !string

  /**
   * Translated text for #value in {@link Locale}'s language.
   */
  translatedValue: !string
}
