 * The transform creates a `isVerified` field which that stores a string `Yes` or `No`.
 * `Yes` denotes the parsed sensor has been verified and `No` denotes that its not verified.
 */
@typeScript
type MasterSensorGridTransform mixes UiSdlDataTransform<FetchResult<MasterSensor>, json> {

   transform: ~ ts-client

   transformArgs: ~
}
