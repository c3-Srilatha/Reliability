/**
 * Custom [state value param](UiSdlStateValueParam) used to convert the
 * set the correct error message on `hinText` property on a `UiSdlForm`.
 * When adding a facility. If the facility already exists, the error message will be set to "Facility already exists".
 * Otherwise, the error message will be set to "Name is required".
 *
 * ```json
 * "hintText": {
 * "type": "UiSdlDynamicValueSpec",
 *    "dynamicValue": {
 *      "type": "AddFacilityErrorMessageParam",
 *        "id": "Reliability.FacilityDetailNewForm"
 *      }
 * }
 * ```
 */
type AddFacilityErrorMessageParam mixes UiSdlStateValueParam
