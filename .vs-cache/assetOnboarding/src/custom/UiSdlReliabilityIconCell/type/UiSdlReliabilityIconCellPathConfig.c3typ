/**
 * Configuration path for icon indicator.
 */
type UiSdlReliabilityIconCellPathConfig {

  /**
   * The path in the object from which the icon can be retrieved
   */
  iconPath: !string

  /**
   * The path in the object from which the icon color can be retrieved
   */
  colorPath: string = '#BBBBBB'
}
