/**
 * Type that provides functionality for individual steps of the import workflow
 */
type AssetOnboardingImportHelper {

  /**
   * Reads all files in the import files and returns True if the reading was successful
   */
  readAllFiles: function (unzipDirectoryPath: !string): string py

  /**
   * Removes all the data persisted by the running import if it fails.
   */
  removeImportPersistedData: function (trackingIdForImport: !string): boolean py

  /**
   * Extract files from zip and store them in the filesystem
   * @returns
   *        The path where the extracted file is stored
   */
  extractFilesFromZip: function (zipFilePath: !string, unzipDirectoryPath: !string): string py

  /**
   * Cleanup and remove all the files of current import
   */
  cleanupImportFiles: function (run: !WorkflowExecutorRun, unzipDirectoryPath: !string): string py
}
