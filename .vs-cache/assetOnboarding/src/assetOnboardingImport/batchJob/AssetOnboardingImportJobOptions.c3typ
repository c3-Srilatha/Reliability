/**
 * Options that can be provided when starting a {@link AssetOnboardingImportJob}.
 */
type AssetOnboardingImportJobOptions {

  /**
   * This specifies the path where all the extracted files are stored
   */
  unzipDirectoryPath: !string

  /**
   * The tracking Id used in the specific import job
   */
  trackingIdForImport: !string
}
