/**
 * Represents the result of each batch of {@link AssetOnboardingImportJob}.
 */
@db(index+=['entity','job','fileName'])
entity type AssetOnboardingImportJobBatchResult {

  /**
   * Entity type which was being upserted in the batch job
   */
  entityType: !string

  /**
   * The job that was executed to produce this result. This will always be the job with `id`
   * equal to {@link AssetOnboardingImportJob}, since this type is a singleton.
   */
  job: !AssetOnboardingImportJob

  /**
   * File used by the job to get the objects to upsert.
  */
  fileName: !string

  /**
   * Indicates whether the batch was successfully processed or not.
   */
  status: !string enum ('SUCCESS', 'FAILURE')

  /**
   * The tracking Id used in the specific import job
   */
  trackingIdForImport: !string

}
