/**
 * Given {@link AssetOnboardingImportJobOptions}, this job will add data from the given files to the asset onboarding application
 */
entity type AssetOnboardingImportJob extends BatchJob<AssetOnboardingImportJob, AssetOnboardingImportJobOptions, AssetOnboardingImportBatchJob> mixes Singleton type key 'ASS_ONB_EXP_DAT' {
  doStart: ~ py

  processBatch: ~ py

  /**
   * The results generated by each call of {@link #processBatch}.
   */
  results: [AssetOnboardingImportJobBatchResult](job)

  /**
   * Gets all the successful {@link #results} with a given trackingId.
   * @param trackingId
   *            Specifies the trackingIdForImport for each record added by the import
   */
  getSuccessResults: member function(trackingId: !string): [AssetOnboardingImportJobBatchResult] py

  /**
   * Gets all the failed {@link #results} with a given trackingId.
   * @param trackingId
   *            Specifies the trackingIdForImport for each record added by the import
   */
  getFailResults: member function(trackingId: !string): [AssetOnboardingImportJobBatchResult] py

  /**
   * Checks the succeeded and failed batch jobs and removes all the {@link AssetOnboardingImportJobBatchResult} for the given trackingId
   * @param trackingId
   *            Specifies the trackingIdForImport for each record added by the import
   */
  analyzeBatchJobResult: member function(trackingId: !string): string py
}
