/**
 * This type will schedule batch jobs with the necessary fields.
 */
type AssetOnboardingImportBatchJob {

  /**
   * Points to where the file is stored on the file system
   */
  fileUrl: !string

  /**
   * The file name for which a batch job will be scheduled
   */
  fileName: !string

  /**
   * Entity type for which batch job will be scheduled
   */
  entityType: !string

}
