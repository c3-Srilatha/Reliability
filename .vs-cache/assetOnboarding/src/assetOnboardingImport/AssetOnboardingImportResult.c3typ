/**
 * Type that provides functionality for individual steps of the import workflow
 */
type AssetOnboardingImportResult {

  /**
   * Represents the tracking id for the current import
   */
  trackingIdForImport: string

  /**
   * Represents the result of the workflow run
   */
  result: string enum('Failed', 'Success')
}
