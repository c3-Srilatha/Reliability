/**
 * Type that contains common utility APIs for Reliability
 */
remix type ReliabilityUtils {

  /**
   * This function will gather all the persisted {@link Translation}s and the keys cached in {@link TranslationCache} from the base code and calculate the difference,
   * in order to identify possible invalid translations added.
   *
   * A {@link Translation} might be considered invalid due to typos (incongruence between key and id), blank spaces inside the key or duplicity
   * This will return an array containing the invalid translations found if any, otherwise, will return an empty array.
   */
  getInvalidTranslations: function(): [Translation] js-rhino
}
