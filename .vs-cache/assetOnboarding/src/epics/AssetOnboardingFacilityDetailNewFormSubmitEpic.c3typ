/**
 * Custom Submit Form Epic for `Reliability.FacilityDetailNewForm`, this epic is used to check if the
 * {@link Facility#name} is unique. If it is not unique, throw an error into the form.
 * If it is unique, then the form will be submitted.
 */
@typeScript
type AssetOnboardingFacilityDetailNewFormSubmitEpic mixes UiSdlEpic {

  epic: ~ ts-client
}
