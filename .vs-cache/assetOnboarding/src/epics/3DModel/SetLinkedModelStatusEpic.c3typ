/**
 * Epic to determine if an AssetClass has a linked 3D model by fetching data using the assetClassId from the URL.
 * It sets the isLinked field in ReliabilityApplicationState based on the presence of a linked 3D model.
 */
type SetLinkedModelStatusEpic mixes UiSdlEpic {

  epic: ~ ts-client
}
