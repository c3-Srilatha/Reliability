/**
 * Helper to handle scenarios where we want to warn user navigating away from a given page.
 * Handle the navigation, when user opts to exit anyway.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
@typeScript
type NavigationHelper {

  /**
   * Handler for force redirecting user back to page, they were on originally.
   */
  handleForceBackRedirect: function(actionStream: !any, stateStream: !any, appStateId: string, redirectBackTo: !string, exitModal: string, exitBanner: string): !any ts-client

  /**
   * Handler for exiting anyway to the page, user originally intended to.
   */
  handleExitAnyway: function(appStateId: !string, stateStream: !any, componentsToClear: !any, defaultRedirect: string): !any ts-client
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
