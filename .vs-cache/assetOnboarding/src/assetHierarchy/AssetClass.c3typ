remix type AssetClass mixes UserGeneratable, AssetOnboardingImportTracking {

  /**
   * The parent of this asset class to be displayed in the UI.
   */
  displayParent: AssetClass stored calc exists(parentAssetClassRelations) ? parentAssetClassRelations[0].parent : null

  /**
   * This icon is used to represent assets that belongs to this class on "Asset Map" page.
   *
   * **NOTE**: This icon string should be a valid icon name from the SDL icon library, additionally if not icon is
   *           provided, the nodes in the map will be empty.
   */
  mapIcon: string

  /**
   * Ion Cesium Asset Model to use for this asset class.
   */
  mapModel: string
}
