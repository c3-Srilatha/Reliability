/**
 * Represents entities that can be created by users, but also need to be distinguished from entities created by
 * seed data or backend jobs.
 */
abstract entity type UserGeneratable {

  /**
   * This field indicates whether the data is generated by System or User.
   */
  notUserGenerated: boolean stored calc (meta.createdBy == "worker" || meta.createdBy == "provisioner") ? true: false

  /**
   * This field indicates the source of the data. `displaySource` should be fetched instead of this field.
   */
  source: string stored calc (meta.createdBy == "worker" || meta.createdBy == "provisioner")  ? "C3 AI" : "user"

  /**
   * This field is used by the UI to show the translated value of {@link source}.
   */
  displaySource: string stored calc getTranslationWithPostfix('UserGeneratable.displaySource.', notUserGenerated)

}
