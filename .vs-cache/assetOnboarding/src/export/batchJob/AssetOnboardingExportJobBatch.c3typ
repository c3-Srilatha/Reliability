/**
 * Given {@link AssetOnboardingExportJobOptions}, this job export all the data from asset onboarding application
 */
type AssetOnboardingExportJobBatch {

  /**
   * The Entity for the current batch.
   */
  entityType: !Type

  /**
   * The number of items to skip before starting to collect the result set.
   */
  offset: !int

  /**
   * The maximum number of items to return in the result set.
   */
  limit: !int

  /**
   * The directory where the export file will be located for the current batch.
   */
  typeDir: !string

  /**
   * The directory where the export file will be located for the current batch.
   */
  basePath: !string
}
