/**
 * Given {@link AssetOnboardingExportJobOptions}, this job export all the data from asset onboarding application
 */
entity type AssetOnboardingExportJob extends BatchJob<AssetOnboardingExport, AssetOnboardingExportJobOptions, AssetOnboardingExportJobBatch> mixes Singleton type key 'ASS_ONB_EXP_DAT' {
  doStart: ~ py

  processBatch: ~ py

  /**
   * The results generated by each call of {@link #processBatch}.
   */
  results: [AssetOnboardingExportJobBatchResult](job)

  /**
   * Gets all the successful {@link #results} with a given trackingId.
   */
  getSuccessResults: member function(trackingId: !string): [AssetOnboardingExportJobBatchResult] js-rhino

  /**
   * Gets all the failed {@link #results} with a given trackingId.
   */
  getFailResults: member function(trackingId: !string): [AssetOnboardingExportJobBatchResult] js-rhino

  /**
   * Removes all the {@link #results} with a given trackingId, removes files in filesystem and creates zip file
   */
  generateZipAndCleanUpFiles: member function(trackingId: !string): string js-rhino

  /**
   * List of entities to be exported
   */
  typesToExport : const [string] = [
        'Facility',
        'ReliabilityAsset',
        'FacilityReliabilityAssetHierarchicalRelation',
        'ReliabilityAssetHierarchicalRelation',
        'ReliabilityAssetSensorHierarchicalRelation',
        'ReliabilityAssetSensorRelation',
        'AssetClass',
        'AssetHierarchyTemplate',
        'MasterSensor',
        'Sensor',
        'ExpectedSensor',
        'FailureModeLibrary',
        'FailureMode',
        'FailureModeDiagnostic',
        'FailureModeLineItem',
        'FailureModePriority',
        'FailureModeRecommendation',
        'ParsableDiagram',
        'ParsedSensor',
        'AssetClassParentChildRelation'
    ]
}
