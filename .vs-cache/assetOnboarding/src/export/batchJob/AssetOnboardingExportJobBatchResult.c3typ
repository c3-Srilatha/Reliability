/**
 * Represents the result of each batch of {@link AssetOnboardingExportJob}.
 */
@db(index+=['status', 'trackingId', 'job', 'basePath'])
entity type AssetOnboardingExportJobBatchResult {

  /**
   * The job that was executed to produce this result. This will always be the job with `id`
   * equal to "AssetOnboardingExportJob", since this type is a singleton.
   */
  job: !AssetOnboardingExportJob

  /**
   * Indicates whether the batch was successfully processed or not.
   */
  status: !string enum AssetOnboardingExportJobBatchResultStatus

  /**
   * The basePath the files are created in.
   */
  basePath: !string

  /**
   * An identifier to give this result. Used to aggregate the result of the parser job
   * for a particular {@link Workflow.Run} of {@link AssetOnboardingExport}.
   */
  trackingId: !string

  /**
   * A zip file created by the batch job containing the exported data.
   */
  zipFile: string

  /**
   * The error message that occurred during the processing of this batch.
   */
  error: string
}
