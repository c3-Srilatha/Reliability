/**
 * This type enables specifying configurable parameters that will be used as inputs for the
 * workflow generated in {@link AssetOnboardingExport#start}.
 */
type AssetOnboardingExportSpec mixes Spec {
  /**
   * The base path for the export files to be located
   * If not specified, the default is "AssetOnboardingExport".
   */
  basePath: string

  /**
   * The batch size to be used for the export job.
   * If not specified, the default is 2000.
   */
  batchSize: int = 2000
}
