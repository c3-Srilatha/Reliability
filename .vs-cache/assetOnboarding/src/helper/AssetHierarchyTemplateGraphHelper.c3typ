/**
 * Helper type to fetch data for {@link UiSdlGraphVisualization} component from a {@link AssetHierarchyTemplate}.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
@action(group='asset-onboarding-read')
type AssetHierarchyTemplateGraphHelper {
  /**
   * Helper function to get necessary data for graph based on the {@link AssetHierarchyTemplate} selected.
   * @param template
   *        {@link AssetHierarchyTemplate} used in the graph
   * @param parentName
   *        name of the parent {@link ReliabilityAsset}
   *        when there is no parent {@link ReliabilityAsset}, name of the parent {@link Facility}
   * @param namePrefix
   *        optional name prefix in front of all node-names in the template
   * @return JSON object of graph edges and vertices
   */
  getAssetHierarchyTemplateDetailGraph: function(template: AssetHierarchyTemplate, parentName: string, namePrefix: string, parentIsFacility: boolean): json js-rhino
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
