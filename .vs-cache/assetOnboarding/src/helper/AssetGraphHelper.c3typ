/**
 * Helper type to fetch data for {@link UiSdlGraphVisualization} component.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
type AssetGraphHelper {

  /**
   * Function to return the asset information for the graph component.
   *
   * @param asset
   *      The asset whose information we want to display in a graph
   * @return JSON object of graph edges and vertices
   */
  getAssetDetailGraph: function(asset: ReliabilityAsset): json js-rhino

  /**
   * Function to return the asset information for the graph component
   * with data validation results of each {@link ReliabilityAsset}.
   *
   * @param asset
   *      The asset whose information we want to display in a graph
   * @return JSON object of graph edges and vertices
   */
  getModelSetupAssetDetailGraph: function(asset: ReliabilityAsset): json js-rhino

  /**
   * Function to return the asset information for the graph component
   * with mute alert status information for each {@link ReliabilityAsset}.
   * Shows the count of muted champion models for each asset.
   *
   * @param asset
   *      The asset whose information we want to display in a graph
   * @param includeChildAssetsAndSelf
   *      Whether to include the child assets and the current asset in the graph
   * @return JSON object of graph edges and vertices with mute alert status
   */
  getMuteAlertStatusAssetGraph: function(asset: !ReliabilityAsset, includeChildAssetsAndSelf: !boolean): json js-rhino

  /**
   * Function to generate the graph of {@link ReliabilityAsset} and {@link Sensor}.
   *
   * @param asset
   *      The asset whose information we want to display in a graph
   * @return JSON object of graph edges and vertices
   */
  getGraph: private function(asset: !ReliabilityAsset, include: string): json js-rhino

  /**
   * Function to generate the graph of {@link ReliabilityAsset} and {@link Facility}
   *
   * @param facilityIds
   *      IDs of the facilities for which the graph is to plotted.
   * @param depth
   *      The {@link ReliabilityAsset#depth} upto which the graph is to plotted.
   * @param assetNames
   *      The {@link ReliabilityAsset#name}s for which the graph is to plotted.
   * @param mappingStatuses
   *        The list of {@link SensorMappingStatus} values used to filter the list of {@link ReliabilityAsset}s.
   * @return JSON object for the graph visualization component (vertices and edges).
   */
  getAssetHierarchyGraph: function(
    facilityIds: [string],
    depth: int,
    assetNames: [string],
    mappingStatuses: [SensorMappingStatus]
  ): json js-rhino

  /**
   * Function to generate the graph data for {@link AssetGraphHelper#getAssetHierarchyGraph}.
   *
   * @param facilityIds
   *      IDs of the facilities for which the graph is to plotted.
   * @param depth
   *      The {@link ReliabilityAsset#depth} upto which the graph is to plotted.
   * @param assetNames
   *      The {@link ReliabilityAsset#name}s for which the graph is to plotted.
   * @param mappingStatuses
   *        The list of {@link SensorMappingStatus} values used to filter the list of {@link ReliabilityAsset}s.
   * @return JSON object of graph edges and vertices.
   */
  getAssetHierarchyGraphData: function(
    facilityIds: [string],
    depth: int,
    assetNames: [string],
    mappingStatuses: [SensorMappingStatus]
  ): json js-rhino
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
