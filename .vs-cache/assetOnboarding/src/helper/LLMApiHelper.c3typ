/**
 * Helper for LLM API calls.
 */
type LLMApiHelper {
  /**
   * Provides possible matches for sensors using fuzzy matching and LLM.
   *
   * @param sensor_list
   *        JSON of sensors to be matched.
   * @param expected_sensor_list
   *        JSON of expected sensors to match against.
   * @return JSON of possible matches for each sensor.
   */
  matchExpectedSensors: function(sensor_list: !json, expected_sensor_list: !json): !json py-fuzzyllm
}
