/**
 * Helper type for bulk operations on 3D model linking and Unlinking to assets and asset classes.
 */
type Asset3DHelper {

  /**
   * Links a 3D model to multiple assets or asset classes based on the provided IDs.
   *
   * @param source
   *      The source type: either "assetclass" or "reliabilityasset"
   * @param typeIds
   *      Array of IDs for the assets or asset classes to link the 3D model to
   * @param modelId
   *      The ID of the 3D model to link
   * @return Array of updated ReliabilityAsset or AssetClass objects
   */
  bulkLink3DModelById: function(source: string, typeIds: [string], modelId: string): [ReliabilityAsset | AssetClass] js-rhino

  /**
   * Unlinks a 3D model from multiple assets or asset classes based on the provided IDs.
   *
   * @param source
   *      The source type: either "assetclass" or "reliabilityasset"
   * @param typeIds
   *      Array of IDs for the assets or asset classes to unlink the 3D model from
   * @param modelId
   *      The ID of the 3D model to unlink
   * @return Array of updated ReliabilityAsset or AssetClass objects
   */
  bulkUnlink3DModelById: function(source: string, typeIds: [string], modelId: string): [ReliabilityAsset | AssetClass] js-rhino
}
