/**
 * Helper type to fetch data for the {@link ReliabilityAsset} Hierarchy.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
type AssetHierarchyHelper {

  /**
   * Fetches the {@link ReliabilityAsset}s and {@link Facility}s based on the assetId provided.
   *
   * @param assetId - The assetId for which the possible parents needs to be fetched.
   * The parent type can be both {@link ReliabilityAsset}s and {@link Facility}s.
   * @param facilityIds - The facilities to filter by
   * @param depth - The max depth to filter by
   *
   * @returns The assets and facilities fetched.
  */
  @action(group='asset-onboarding-read')
  fetchNonDescendantAssetsAndFacilities: function(assetId: !string, facilityIds: [string], depth: int): FetchResult<ReliabilityAsset| Facility> js-rhino

  /**
   * Applies the in-memory changes of the asset hierarchy done through Asset Onboarding UI and persists them.
   *
   * @param edits - The asset hierarchy edits done through Asset Onboarding UI.
   * Contains a map of persisted or pseudo asset ids to {@link AssetOnboardingEditInfo}.
   * "persisted" asset ids are asset ids that exists in the database,
   * while "pseudo" asset ids are the ids generated in the UI but not persisted.
   * @param createdFacilityNames - a map of pseudo ids to facility names, for facilities that are being created
   * @param renamedAssets - a map of persisted ids to names, for already existing assets or facilities that are being renamed
   *
   */
  @action(group='asset-onboarding-write')
  applyEdits: function(edits: map<string, AssetOnboardingEditInfo>, createdFacilityNames: map<string, string>, renamedAssets: map<string, string>) js-rhino

  /**
   * Creates facilities based on the facility name map.
   * The ids in the passed in map may not correspond to the persisted ids, so a pseudo-id to id mapping is returned.
   * @param facilityNameMap - The map of pseudo-ids to facility names.
   * @return The map of pseudo-ids to facility ids.
   */
  @action(group='asset-onboarding-write')
  createFacilities: function(facilityNameMap: map<string, string>): map<string, string> js-rhino

  /**
   * Produces the edits for the hierarchy template instantiation in a format that the Asset Onboarding UI can consume.
   */
  @action(group='asset-onboarding-read')
  getEditsForHierarchyTemplateInstantiation: function(parent: !(ReliabilityAsset | Facility), template: !AssetHierarchyTemplate, namePrefix: string): map<string, AssetOnboardingEditInfo> js-rhino


 /**
  * Constructs a graph from the given edits and ids of assets to be fetched.
  *
  * This function reconstructs a graph starting from a given node, using a set of
  * edit operations (`create` and `move`) and a collection of persisted assets fetched based
  * on specified asset IDs. The graph is built through a breadth-first traversal, adding edges
  * for both persisted assets and edits.
  *
  * The method assumes that each node in the graph will have children
  * that are either persisted (unmodified) or created/moved (modified).
  * At each step of BFS it it adds the modified and unmodified nodes to the queue and creates edges to its children.
  *
  * @param node -  The starting node for the graph traversal.
  *                This is the node from the `Reliability.AssetHierarchyViewerGraph`.
  *                Should have an `id` property.
  * @param edits - A map of edit operations where the key is the asset ID for which this edit is defined
  *                and the value is an object describing the edit. Each edit object may include:
  *                - `editType`: The type of edit ('create', 'move', etc.).
  *                - `parentId`: The ID of the parent node.
  *                - Refer {@link AssetOnboardingEditInfo}.
  * @param assetIdsToFetch - An array of asset IDs to fetch from the database.
  *                          This is calcuated on the frontend
  *                          using {@link AssetOnboardingApplicationState#nodeDescendantEditsMap} and passed to this method
  * @returns - An object representing the resulting graph with the following structure:
  *            - `nodes`: A `Set` of nodes that were visited during the traversal.
  *            - `edges`: An array of edges in the graph, where each edge is an object
  *                       with `from` and `to` properties representing node connections.
  *            - `maxDepth`: An integer denoting the maximium depth of the generated subtree.
  */
  @action(group='asset-onboarding-read')
  buildGraphFromEdits: function(node: json, edits: map<string, AssetOnboardingEditInfo>, assetIdsToFetch: [string]): json js-rhino

  /**
   * This is a helper function that calls {@link AssetHierarchyTemplate#createHierarchyTemplate}
   * to save a given subtree as a hierarchy template.
   * This function checks if the given subtree's data is availble on the UI,
   * if data is available, it creates a template fron the data
   * else, it calls `buildGraphFromEdits` to generate the graph data.
   *
   * @param isSubtreeFiltered - A boolean that denotes if the subtree to be saved is partially hidden
   * @param graphData - The graph data containing two keys `nodes` and `edges`.
   *                           - graphData.nodes is a list of asset/facility objects
   *                           - graphData.edges is a list of objects with a `from` and `to` field
   *                             each holding the ID of the asset/facility, representing the relation between two nodes
   * @param selectedNode - The currently selected node in the UI
   * @param templateName - The name of the new template to be created
   * @param edits - The in-memory edits in application state
   * @param assetIdsToFetch - A list of asset IDs that should be fetched to reconstruct any missing data in the graph
   */
  @action(group='asset-onboarding-write')
  saveAsHierarchyTemplate: function(
    isSubtreeFiltered: boolean,
    graphData: json,
    selectedNode: json,
    templateName: string,
    edits: map<string, AssetOnboardingEditInfo>,
    assetIdsToFetch: [string]
  ): json js-rhino
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
