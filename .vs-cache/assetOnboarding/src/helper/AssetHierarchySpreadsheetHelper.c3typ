/**
 * This is a helper type used by the Asset Hierarchy spreadsheet component to get the grid data.
 */
@action(group='asset-onboarding-read')
type AssetHierarchySpreadsheetHelper {

  /**
   * The background color for the cell with a dark theme.
   *
   * @see UiSdlThemedValue
   * @see UiCollapsibleGridTreeNodeDatum#color
   */
  CELL_DARK_BACKGROUND_COLOR: const string = '#1C1D1F'

  /**
   * The background color for the cell with a light theme.
   *
   * @see UiSdlThemedValue
   * @see UiCollapsibleGridTreeNodeDatum#color
   */
  CELL_LIGHT_BACKGROUND_COLOR: const string = '#FFFFFF'

  /**
   * This method is called by the Asset Hierarchy spreadsheet component to get the data to display in the grid.
   *
   * @param facilityIds
   *        The list of {@link Facility#id}s to filter the asset hierarchy.
   * @param depth
   *        The {@link ReliabilityAsset#depth} of the asset hierarchy to filter on.
   * @param mappingStatuses
   *        The list of {@link SensorMappingStatus} values used to filter the list of {@link ReliabilityAsset}s.
   * @return the {@link UiCollapsibleGridTree} containing the filtered asset hierarchy result.
   */
  getHierarchy: function(
    facilityIds: [string],
    depth: int,
    mappingStatuses: [SensorMappingStatus]
  ): !UiCollapsibleGridTree js-rhino

  /**
   * This helper method is used to fetch the [facilities](Facility) used to construct the asset hierarchy grid.
   *
   * @param facilityIds
   *        The list of {@link Facility#id}s to filter the asset hierarchy.
   * @return the list of {@link Facility} containing the filtered facilities.
   */
  getFacilities: private function(facilityIds: [string]): [Facility] js-rhino

  /**
   * This helper function gets the column definitions for the asset hierarchy grid.
   */
  getColumns: function(): [UiCollapsibleGridTreeNodeDatum] js-rhino
}
