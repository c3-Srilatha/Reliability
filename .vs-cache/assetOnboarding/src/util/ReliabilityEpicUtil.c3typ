/**
 * Utility type providing helper functions for epics in reliability.
 * This type includes methods for handling error displays, verifying user access, refreshing nested grids,
 * and interacting with URLs and field paths in the application state.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
@typeScript
type ReliabilityEpicUtil {

  /**
   * Add this function to the end of a pipe for which you want to show a banner if something in the pipe fails.
   * Returns a catchError operator that logs the error to console, and shows a banner based on the given params.
   */
  showBannerOnError: function(
    primaryText: string,
    secondaryText: string = "Reliability.TryAgainOrContactSupport",
    bannerId: string = "Reliability.Banner"
  ): any ts-client

  /**
   * Verify whether the current user's access is disabled, determined by their {@link Role}s.
   * @param state
   *          Current redux state
   * @param isDisabledForRole
   *          Map from {@link Role} to a boolean indicating whether their access is disabled.
   * @returns false if at least one of the user's roles exists in the `isDisabledForRole` map and is set to `false`,
   *          true otherwise.
   */
  checkIfDisabledForUser: function(state: !UiSdlReduxState, isDisabledForRole: !map<string, boolean>): !boolean ts-client

  /**
   * Helper function to update the nested grid on a given parent grid at Model Management > Jobs
   * @param state
   *          Current redux state
   * @param payload
   *          Action payload
   * @return observable
   *
   * **Payload structure**
   * - id: The component ID of the nested grid.
   * - parentGrid: The component ID of the parent grid.
   * - applicationStateId: The ID of the UiSdlApplicationState that stores the nested grid's data source
   * - applicationStatePath: The path (field name) of the nested grid's data source
   */
  refreshJobNestedGrid: function (state: !UiSdlReduxState, payload: json): any ts-client

  /**
   * Get the filename from a URL. Assumes the filename is within the last path segment of the URL.
   */
  getFilenameFromUrl: function(url: string): string ts-client

  /**
   * Get the file download path from a URL. Assumes the path is within the last path segment of the URL.
   * Url gets file system prefix trimmed if it exists
   *
   * @param url - The file generated URL
   * @returns The trimmed URL in case it contains file system prefix, or same url in other case.
   */
  getFileDownloadPathFromUrl: function(url: !string): !string ts-client

  /**
   * Helper function to get the full path to the fieldset that has the provided fieldName on the specified component.
   */
  getFieldPath: function(
    componentId: !string,
    fieldName: !string,
    state: !UiSdlReduxState,
    formatAsArray: boolean = false
  ): string | [string] ts-client

  /**
   * Checks if all objects in the array have identical values for the specified properties within the specified fields.
   *
   * @param array - The array of objects to check.
   * @param fieldPaths - The paths to the fields to compare for equality.
   * @returns - Returns true if all objects have identical values for the specified properties within the specified fields, otherwise false.
   */
  checkIdenticalFieldValues: function(array: ![json], fieldPaths: ![string]): boolean ts-client

  /**
   * Returns true if the `hpoFeatureEnabled` feature flag is enabled and if the selected model template contains {@link ModelTemplate#defaultHyperparamsForHpo} from the {@link UiSdlReduxState UI State}.
   */
  hpoFeatureAndConfigurableEnabled: function(state: !UiSdlReduxState): boolean ts-client

  /**
   * Returns the best available locale based on the user's preferred locale and the locales configured in the application.
   * The priority of the locales is as follows:
   * 1. User preferred locale (as configured in {@link UiSdlUserContext#preferredLocale})
   * 2. Application configured locale (as configured in {@link UiSdlI18nConfig#locales})
   * 3. Default fallback locale (English, 'en')
   * @param state
   *           The current Redux state.
   * @returns The best available locale.
   */
  getBestAvailableLocale: function(state: !UiSdlReduxState): string ts-client

  /**
  * Function that get all fields from a {@link UiSdlFilterPanel} stored in state and clears them.
  * This returns an array with the cleared fields. If the {@link UiSdlFilterPanel} hasn't been instatiated or modified, it returns and empty array.
  *
  * @param filterPanelId - ID of the filter panel to clear.
  *
  * @param state - {@link UiSdlReduxState} from which fields will be retrieved.
  *
  * @returns an array of objs with the cleared fields.
  */
  getClearedFilterPanelFields: function(filterPanelId: !string, state: !UiSdlReduxState): [json] ts-client

  /**
   * Gets the cleared {@link UiSdlFilterPanel}'s fields and returns a `MULTIPLE_INPUTS_CHANGE`
   * action to reset the panel. This function emulates the `Clear all` button behavior.
   *
   * @param filterPanelId
   *           The id of the {@link UiSdlFilterPanel} to clear.
   * @param state
   *           {@link UiSdlReduxState} where the modified fields are stored
   * @returns a Redux action of type `MULTIPLE_INPUTS_CHANGE`.
   */
  resetFilterPanel: function(filterPanelId: !string, state: !UiSdlReduxState): !UiSdlReduxAction ts-client

  /**
   * Given a redux state, componentId, and a filter panel field data spec string (e.g. 'Reliability.AnalysisFilterPanel_dataSpec_fieldSets_1_fields_2_filterElement_inputElement_dataSpec_ds'),
   * returns the field name by looking up the config in redux state.
   *
   * @param state The redux state
   * @param componentId The component id (e.g., 'Reliability.AnalysisFilterPanel')
   * @param dataSpecName The long path string (e.g., 'Reliability.AnalysisFilterPanel_dataSpec_fieldSets_1_fields_2_filterElement_inputElement_dataSpec_ds')
   * @returns The field, or null if not found
   */
  getFieldFromFilterPanelFieldDataSpecName: function(state: !UiSdlReduxState, componentId: !string, dataSpecName: !string): json ts-client

  /**
   * Helper function that waits for the specified components to be loaded in the state.
   *
   * @param stateStream The Redux State stream to observe.
   * @param componentIds The IDs of the components to wait for.
   * @returns An observable that emits the state when all specified components are loaded.
   */
  waitForComponentsToBeLoaded: function(stateStream: !UiSdlStatesObservable, componentIds: ![string]): any ts-client

  /**
   * Checks if the given time range is greater than the specified period.
   * The period can be defined as a string in the format of '2y', '1d', '2h', etc.
   *
   * @param startDate
   *        The start date of the time range.
   * @param endDate
   *        The end date of the time range.
   * @param period
   *        The period to compare against, in the format of '2y', '1d', '2h', etc.
   * @returns true if the time range is greater than the specified period, false otherwise.
   */
  isTimeRangeGreaterThanPeriod: function(startDate: !native, endDate: !native, period: !string serialized Period): boolean ts-client
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
