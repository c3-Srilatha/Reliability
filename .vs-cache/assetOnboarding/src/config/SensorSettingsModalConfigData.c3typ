/**
  * Modal data used when opening a Sensor Settings Modal
  * See {@link Sensor#updateMonitorSettings} and {@link Sensor#updateOperatingStatusSettings}.
  *
  * dataSourceIdToRefreshOnComplete7 - the source component dataSpec_ds where the SensorSettingsModal was opened from. Used to refresh grids after update
  * monitorSettingsEnabled - used in the cases where the call to operatingStatusUpdateRequest is needed only and the monitorSettingsUpdateRequest can be skipped
  */

type SensorSettingsModalConfigData {
  /**
  * The data source id of the component that opened the modal. Used to refresh component grid after backend functions complete.
  */
  dataSourceIdToRefreshOnComplete: string

  /**
  * Boolean used to determine if the Monitor Settings form will be displayed in the Sensor Settings Modal
  * Disables updates and hides collapsable drawer if set to false
  */
  monitorSettingsEnabled: boolean

  /**
  * A calculated field that does a comparison against the user's active roles. If 'Reliability.LimitedModelUser.Role' is found, the user is deemed to have permission
  * In the negative case this field is also used to determine the showing of warning banners and messages. Relevant operational status form fields will be disabled.
  */
  userHasPermission: boolean
}
