/**
 * Configurations for Reliability application UI.
 */
@typeScript
remix type ReliabilityUIConfig {

  /**
   * If true, feature contributions will be plotted on the alert detail sensor chart. If false, they will only
   * be plotted on the alert detail risk score chart.
   */
  plotFeatureContributionsOnAlertDetailSensorChart: boolean

  /**
   * If true, the sensor legend label tooltip will contain the name of the expected sensor
   * for the corresponding asset sensor relation. If false, the sensor legend label tooltip will
   * contain the description of the sensor.
   *
   */
  showExpectedSensorOnSensorLegendLabelTooltip: boolean

  /**
   * If false, reconstruction values will not be plotted in the same color as the actual feature values.
   * In addition, they will be plotted with a solid line.
   * If true, reconstruction values will be plotted in the same color as the actual feature values
   * using a dashed line.
   */
  matchReconstructionAndActualValueColor: boolean

  /**
   *  Flag controls whether the data zoom functionality is enabled for the Y-axis in the Model Validation chart.
  */
  showYAxisDataZoomForModelValidationChart: boolean = true

  /**
  * Defines the default number of {@link Interval}s to offset the start date from the end date in the `Reliability.ModelDetailFilterPanel`.
  * If the start date is provided, the start date will be set to the end date minus this number of #modelOutputDefaultInterval intervals.
  */
  modelOutputDefaultLookbackHorizon: int = 7

  /**
 * The default {@link Interval} for the `Reliability.ModelDetailFilterPanel`.
 * This specifies the granularity at which to display model outputs chart
 */
  modelOutputDefaultInterval: string serialized Interval = Interval.DAY

  /**
   * Gets #showModelSetupWithSensorAssociationUIFlows feature flag value from the {@link UiSdlReduxState UI State}.
   *
   * @param state
   *        The current state of the application.
   * @return `true` if the feature flag is enabled, `false` otherwise.
   */
  isShowModelSetupWithSensorAssociationUIFlowsEnabled: function(state: !UiSdlReduxState): boolean ts-client

  /**
   * Gets #showUserDefinedMetricsFeature feature flag value from the {@link UiSdlReduxState UI State}.
   *
   * @param state
   *        The current state of the application.
   * @return `true` if the feature flag is enabled, `false` otherwise.
   */
  isShowUserDefinedMetricsFeatureEnabled: function(state: !UiSdlReduxState): boolean ts-client

  /**
   * Feature flag to enable or disable the Hyperparameter Optimization (HPO) Beta feature.
   */
  hpoFeatureEnabled: boolean

  /**
   * Gets the value of the #hpoFeatureEnabled feature flag from the {@link UiSdlReduxState UI State}.
   */
  isHpoFeatureEnabled: function(state: !UiSdlReduxState): boolean ts-client

  /**
   * Feature flag to enable or disable access to the "To Do Alerts" page.
   */
  showToDoAlertsPage: boolean = true

  /**
   * Feature flag to enable or disable access to the Model Scenario UI flows.
   */
  showUIModelScenarioFlow: boolean = false

  /**
   * Feature flag to enable or disable access to the Model Scenario UI flows.
   *
   * @param state
   *        Redux state.
   * @return `true` if the feature flag is enabled, `false` otherwise.
   */
  isShowUIModelScenarioFlowEnabled: inline function(state: !UiSdlReduxState): boolean ts-client

  /**
   * ReliabilityModelGridColumnFlags defines boolean values determining column visibility on the model ops landing page.
   */
  modelGridColumnFlags: ReliabilityModelGridColumnFlags

  /**
   * If true, the alert threshold will be plotted for Reliability Risk models.
   * If false, the alert threshold will not be plotted for Reliability Risk models.
   * Currently, this option only affects the Model Validation chart.
   */
  plotReliabilityRiskAlertThresholds: boolean

  /**
   * Specifies the default time interval for the charts. To be used as a fallback value for intervals throughout the app.
   */
  defaultInterval: string = 'DAY'

  /**
   * Defines the default number of days to offset the start date from the end date.
   * If no specific start date is provided, the start date will be set to the end date minus this number of days.
   */
  defaultDaysOffset: int = 30

  /**
   * The default interval for the experimental model chart.
   *
   * see `ExperimentalPreviewHelper#getData` in the reliability package.
   */
  defaultPreviewExperimentalModelChartInterval: string serialized Interval

  /**
   * The default time period on "To Do Alerts" page.
   *
   * **NOTE**: This field is using `string` instead of {@link Period} because the `Period` type is not supported as a
   *           value in the {@link UiSdlSingleSearch}.
   */
  defaultToDoAlertsTimePeriod: string

  /**
   * Gets showWorkOrderForSparePartsUIFlows feature flag value from the {@link UiSdlReduxState UIState}.
   *
   * @param state
   *        The current state of the application.
   * @return `true` if the feature flag is enabled, `false` otherwise.
   */
  isShowWorkOrderForSparePartsUIFlowsEnabled: function(state: !UiSdlReduxState): boolean ts-client

  /**
   * Maps {@link ScatterPlotColorByEnum} options to defined buckets.
   * Numbers in the list represent the right (inclusive) bounds of buckets, with an implied left-most bound of 0.
   */
  scatterPlotGroupingBuckets: map<string, [double]>

  /**
   * The minimum height in pixels for plots in @link UiApTimeseriesChart}`s.
   * This values is read by the `useMinPlotHeight` hook in the `reliability` package.
   */
  minSplitChartHeight: int = 250

  /**
   * Feature flag to enable or disable sensor matching recommendations.
   * When enabled, users can get AI recommendations to match actual sensors
   * to expected sensors in the sensor mapping workflow.
   */
  enableSensorMatchingRecommendations: boolean = false
}
