/**
 * Type for removing component state and data from the Redux store.
 */
@typeScript
type ComponentStateRemover {
  /**
    * An action to remove a component's state by it's ID.
    *
    * @param componentId
    *        The id of the component, whose state needs to removed.
    * @param stateId
    *        The id of the state to be removed.
    *
    * @returns a Redux action of type `REMOVE_COMPONENT_STATE`.
    */
  @uiSdlActionCreator(actionType='REMOVE_COMPONENT_STATE')
  removeComponentStateAction: function(
    stateId: !string, componentId: !string
  ): !UiSdlReduxAction ts-client

  /**
    * Listens for actions of type `REMOVE_COMPONENT_STATE` and
    * removes state of the componentId passed in action's payload.
    *
    * @param state
    *           Redux state
    * @param action
    *           Redux action
    * @returns a new Redux state
    */
  @uiSdlReducer(actionType='REMOVE_COMPONENT_STATE')
  removeComponentStateReducer: inline function(
    state: !UiSdlReduxState,
    action: !UiSdlReduxAction
  ): !UiSdlReduxState ts-client

  /**
   * Function for clearing the state of components based on an array of Ids.
   */
  clearComponentState: function(componentsToClear: !any): !any ts-client

  /**
   * Function for clearing the data of components based on an array of Ids
   */
  clearComponentData: function(componentsToClear: !any): !any ts-client
}
