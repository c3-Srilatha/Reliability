/**
* The necessary metadata used to call {UpdateSensorSettingsEpic}.
* @see ReliabilityApplicationState
*/

type PendingSensorSettingsChanges {
  /**
  * Config data of the associated modal
  */
  modalConfig: SensorSettingsModalConfigData

  /**
  * The list of {@link Sensor#id}s that will be updated by the actions from {UpdateSensorSettingsEpic}.
  */
  sensorIds: [string]

  /**
  * The boolean toggle in the `Reliability.ChangeSensorMonitorSettingsModalForm` that indicates if monitorSettingsUpdateRequest should be called
  */
  doUpdateMonitorSettings: boolean

  /**
  * The list of selected {@link Sensor#monitoredAlertCategories} to update a {@link Sensor}
  */
  alertFlags: [SensorHealthCategory]

  /**
  * The {@link SensorOperationalStatusTimedValue#status} of the {@link Sensor} of type {@link SensorOperationalStatusEnum}
  */
  operationalStatus: string

  /**
  * The {@link SensorOperationalStatusTimedValue#endDate} to be added from DateTime.now() of type {@link Duration}
  */
  duration: Duration
}
