/**
 * Configurations for assetOnboarding application UI.
 */
@typeScript
type assetOnboardingUIConfig mixes Singleton, Config {

  /**
   * Get current locale as string, for example `en` or `pt`
   * The preference order is as follows:
   *   First: {@link UiSdlUserPreference#preferredLocale}
   *   Second: First language in the list {@link UiSdlConfig#i18n}
   *   Third: as a fallback default to `en` for English.
   *
   * @return the current locale as a string.
   */
  getLocale: function(): string js-rhino
}
