/**
 * Type used to represent the allowed options and {@link Duration} value when marking a sensor as {@link SensorOperationalStatusEnum#FAULTY}
 */
entity type SensorOperationalDurationOptions {
  /**
  * Translation string used as the display name
  */
  displayName: !string

  /**
  * The {@link Duration} a {@link Sensor} should be marked {@link SensorOperationalStatusEnum#FAULTY}. If null, the {@link Sensor} has no expiration date and will remain faulty indefinitely.
  */
  duration: Duration

  /**
  * Field used to maintain an ASCENDING sort order for display
  */
  order: int
}
