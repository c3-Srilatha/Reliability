/**
 * Application state for the target {@link FailureMode}.
 */
type AssetOnboardingFailureModeApplicationState mixes SettableApplicationState {

  /**
   * The target {@link FailureMode}.
   */
  targetFailureMode: FailureMode

  /**
   * The entity to be deleted.
   */
  entityToDelete: json

  /**
   * The name of the entity to be deleted.
   */
  entityToDeleteName: string

}
