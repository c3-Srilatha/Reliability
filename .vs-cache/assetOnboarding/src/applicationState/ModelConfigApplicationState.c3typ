/**
 * Application state for the model configuration workflow.
 */
@typeScript
type ModelConfigApplicationState mixes SettableApplicationState, ModelConfigUiSettings, ComponentStateRemover {

  /**
   * Contains hyperparameter data for the current model template selected.
   * Format is determined by {@link ModelTemplate#getHyperparams}
   */
  hyperparameterData: json

  /**
   * The #modelTemplateId for which the hyperparameterData has been populated for.
   */
  hyperparameterDataModelTemplateId: string

  /**
   * Determines if hyperparameters of `Reliability.ModelConfigHyperparameters` should be editable.
   * If true, a row action should be shown allowing editing. If false, this row action is not visible.
   */
  editableHyperparameters: boolean

  /**
   * Path of markdown file to render within model template selection grid side panel
   */
  markdownPathToRender: string

  /**
   * Stores information about the current hyperparameter that is being edited in the hyperparam grid edit modal.
   */
  currentHyperparameter: json

  /**
   * Stores the name of the current template being displayed in the side panel of the ModelTemplate selection step.
   */
  currentSidePanelTemplateName: string

  /**
   * Map of step id to button status that controls the status and hover message of the continue button.
   */
  stepButtonSettings: map<int, ModelConfigUiContinueButtonSetting>

  /**
   * Stores the url of the page user originally intended to navigate to when exiting asset's Model Configuration workflow.
   */
  redirectTo: string

  /**
   * Indicates if the call to create the trained model is being executed.
   */
  isCreateTrainedModelBeingCalled: boolean = false

  // Experimental model model fields

  /**
   * Boolean field that indicates if the experiment model is completed.
   */
  experimentModelStatus: string enum JobStatusEnum

  /**
   * {@link ReliabilityMlModel} used as a base during the experiment model creation.
   *
   * This field is used to populate the hyperparameters of the experiment model. ({ModelHyperparametersPopulateEpic})
   * if not populated, the id will be retrieved from {@link UiSdlPageParam} `configId`.
   */
  baseModelIdForExperiment: string serialized ReliabilityMlModel

  /**
   * This field is used to indicate if the date range for the latest model experiment preview is more than 2 years.
   * By default, it is set to `false`. If the date range exceeds 2 years time period, it is set to `true`.
   */
  isDateRangeTooLong: boolean = false

  /**
   * Indicates whether the polling process for the experiment model status is currently active.
   * This flag is used to prevent multiple concurrent polling streams from being initiated. It should be set to `true`
   * when polling for the experiment status begins (e.g., when the user navigates to or refreshes the experiment status page),
   * and set to `false` when polling ends (e.g., when the user navigates away, the experiment status reaches a terminal state,
   * or polling is otherwise canceled).
   */
  isPollingExperimentStatus: boolean

  /**
   * This field indicates if the user is currently editing the experimental model preview.
   */
  editingModelExperimentPreview: boolean = false

  /**
   * Stores the original model training and validation period for the given modelId.
   */
  originalTrainingValidationPeriods: json

  /**
   * Boolean flag indicating whether the save and continue button should be disabled in dataset preparation.
   * If the date range mask is out of training window, this is set to true and the user cannot proceed.
   */
  disableDataPrepSaveContinueButton: boolean = false

  /**
   * An action to set a key in hyperparameterOverrides
   *
   * @param field
   *            The field to be updated.
   * @param value
   *            The value to set
   * @returns a Redux action of type `SET_HYPERPARAM`.
   */
  @uiSdlActionCreator(actionType='SET_HYPERPARAM')
  setHyperparamAction: function(
    field: !string,
    value: string
  ): !UiSdlReduxAction ts-client


  /**
   * Listens for actions of type `SET_HYPERPARAM` and
   * updates {@link ModelConfigApplicationState#hyperparameterOverrides}.
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='SET_HYPERPARAM')
  setHyperparamReducer: inline function(
    state: !UiSdlReduxState,
    action: !UiSdlReduxAction
  ): !UiSdlReduxState ts-client

  /**
   * An action to set a key in `hyperparameterData`
   *
   * @param field
   *            The field to be updated.
   * @param path
   *            The hyperparameter path to update
   * @param value
   *            The value to set
   */
  @uiSdlActionCreator(actionType='SET_HYPERPARAMETER_DATA_FIELD')
  setHyperparameterDataFieldAction: function(
    field: !string,
    path: !string,
    value: !string
  ): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_HYPERPARAMETER_DATA_FIELD` and
   * updates {@link ModelConfigApplicationState#hyperparameterData}.
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='SET_HYPERPARAMETER_DATA_FIELD')
  setHyperparameterDataFieldReducer: inline function(
    state: !UiSdlReduxState,
    action: !UiSdlReduxAction
  ): !UiSdlReduxState ts-client

  /**
   * An action to enable or disable the HPO configuration on the #currentHyperparameter.
   * The HPO configuration is set on the `hpoEnabled` key on the #currentHyperparameter object.
   */
  @beta
  @uiSdlActionCreator(actionType='TOGGLE_HPO_CONFIG')
  toggleHpoConfigOnCurrentHyperparamAction: function(): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `TOGGLE_HPO_CONFIG` and
   * updates #currentHyperparameter values to specify if HPO is enabled or disabled.
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @beta
  @uiSdlReducer(actionType='TOGGLE_HPO_CONFIG')
  toggleHpoConfigOnCurrentHyperparamReducer: inline function(
    state: !UiSdlReduxState,
    action: !UiSdlReduxAction
  ): !UiSdlReduxState ts-client
}
