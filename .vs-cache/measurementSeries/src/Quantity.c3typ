/**
 * Defines a dimension that can be used with time series data points where
 * timereseries header holds unit and treatment
 */
type Quantity {

  /**
   * with numerical value and unit. unit refrenced from {parent.unitConstraint}
   */
  @ts(treatmentPath='parent.treatment', unitPath='parent.unitConstraint')
  @numerical(unitPath='parent.unitConstraint')
  quantity: ExactDimension
}
