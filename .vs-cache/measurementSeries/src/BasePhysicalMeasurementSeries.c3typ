/**
 * Base type for measurement series where they measurements are actually associated with the {@link MeasurementSeries}
 * directly. Sub-types mixin {@link TimeseriesHeaderInfo} or {@link TimedDataHeader} and are parameterized
 * with the type of {@link IntervalDataPoint} they parent.
 */
entity type BasePhysicalMeasurementSeries extends MeasurementSeries type key 'BPMS' {

  /**
   * Needed for backwards compatibility - some of the bytestreams in existing cassandra rows expect it.
   * Fixes error: Invalid field name kind for type structure.CompactPhysicalMeasurementSeries at ByteStream
   * at offset FFFFFFFFFFFFFFFF
   */
  kind: string not persistable

  /**
   * For those series that should have measurements in a specific {@link Unit}.
   */
  unitConstraint: Unit

  /**
   * How the measurement series should be treated. For example, rate values should not be interpolated or aggregated.
   * Individual fields will most often use this to determine the treatment for the fields in the series.
   */
  treatment: string enum('previous', 'rate', 'integral', 'avg')

  /**
   * Multiplier that would be applied to all readings for that meter (e.g. when 1 unit on a meter is actually 5 kWh)
   *
   * Currently this does not seem to be used anywhere
   */
  multiplier: decimal

  /**
   * A field to access this object as array. Used in some metric expression as a workaound to some limitations.
   */
  self: [BasePhysicalMeasurementSeries](id, id)
}
