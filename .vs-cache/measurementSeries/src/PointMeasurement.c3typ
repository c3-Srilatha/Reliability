/**
 * Each entry represents a discrete measurement for a specific point in time.
 *
 * Thus far, most of them have been specific register read values.
 */
@db(datastore='kv')
entity type PointMeasurement mixes TimedDataPoint<PointPhysicalMeasurementSeries>, Quantity schema name 'structure_PointMeasurement' {

  quantity: !~
}
