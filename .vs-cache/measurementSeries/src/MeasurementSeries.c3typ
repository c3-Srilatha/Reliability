/**
 * The basis of all measurement header series. This is the starting point to access measurements associated
 * with another logical entity.
 */
entity extendable type MeasurementSeries type key 'MS' schema name 'STRUCT_MSER' {

  /**
   * What is the type of the measurement?
   * ex: Consumption, Production, CapacitiveProduction, etc
   */
  measurementType: string

  /**
   * Who measured the data?
   * ex: MDM or HeadEnd
   */
  origin: string

  /**
   * What is the frequency of the data?
   * ex: QUARTER_HOUR, HOUR, DAY, MONTH, etc.
   */
  interval: string
}
