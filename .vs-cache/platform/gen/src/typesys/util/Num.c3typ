   * @param amount
   *        the value to be formatted
   * @param orig
   *        the unscaled (raw) value
   * @param fixed
   *        always use the same number of digits after the decimal point
   * @return configured NumberFormat instance
   */
  numberFormat3: function(amount: !double, orig: !double, fixed: boolean): any java | js

  /**
   * Returns a Java NumberFormat appropriate for formatting numbers to the specified `precision`.
   *
   * @param precision
   *        number of digits after decimal place
   */
  numberFormatCustom: function(precision: !int32): any java | js

  /**
   * Parse a formatted count string. This includes number and optional unit. For example, parsing "1.2K"
   * returns `1200`.
   *
   * The units supported are:
   *
   *  - "K": 1000 (thousand)
   *  - "M": 10⁶ (million)
   *  - "B": 10⁹ (billion)
   *  - "T": 10¹² (trillion)
   *  - "Q": 10¹⁵ (quadrillion)
   *
   *
   * Units are case insensitive.
   *
   * @see #formatCount(long, int, String, double)
   */
  parseCount: function(s: !?string, failIfInvalid: boolean): int

  /**
   * Parse an double representation into its natural Java form. This will return a `double`.
   * If the string is not an integer value, it will throw an exception.
   */
  parseDouble: function(s: !?string): number

  parseDouble: function(s: !?string, failIfInvalid: boolean): number

  /**
   * Parse an integer representation into its natural Java form. This will return a `int`, `long`
   * or `BigInteger`. If the string is not an integer value, it will throw an exception.
   */
  parseInt: function(s: !?string): number

  parseInt: function(s: !?string, failIfInvalid: boolean): number

  /**
   * Pick a byte size unit for formatting using base-10 units ("MB")
   *
   * @see #pickBytesUnit(long, int, boolean)
   */
  pickBytesUnit: function(bytes: !int, scaleDigits: !int32): string java | js

  /**
   * Pick a byte size unit for formatting.
   *
   * @param bytes
   *        size in bytes
   * @param scaleDigits
   *        adjust the values by 10⁻ⁿ to affect the chosen units
   * @param base2
   *        if true, use base 2 units ("MiB") rather than base 10 ("MB")
   * @return unit for formatting
   */
  pickBytesUnit: function(bytes: !int, scaleDigits: !int32, base2: boolean): string java | js

  /**
   * Given a unit, return the constant to scale the original value so that it can be displayed in terms of unit.
   *
   * @param unit
   *        byte size unit
   * @return scale for formatting
   */
  pickBytesScale: function(unit: !?string): !double java | js

  /**
   * Pick a byte size scale and unit for formatting, using base-10 units ("MB").
   *
   * @param bytes
   *        size in bytes
   * @param scaleDigits
   *        adjust the values by 10⁻ⁿ to affect the chosen units
   * @return scale and unit for formatting
   */
  pickBytesScaleAndUnit: function(bytes: !int, scaleDigits: !int32): Pair<double, string>

  /**
   * Pick a byte size scale and unit for formatting.
   *
   * @param bytes
   *        size in bytes
   * @param scaleDigits
   *        adjust the values by 10⁻ⁿ to affect the chosen units
   * @param base2
   *        if true, use base 2 units ("MiB") rather than base 10 ("MB")
   * @return scale and unit for formatting
   */
  pickBytesScaleAndUnit: function(bytes: !int, scaleDigits: !int32, base2: boolean): Pair<double, string>

  /**
   * Pick a counting number unit for formatting.
   *
   * @param count
   *        value
   * @param scaleDigits
   *        adjust the values by 10⁻ⁿ to affect the chosen units
   * @return unit for formatting
   */
  pickCountUnit: function(count: !int, scaleDigits: !int32): string java | js

  /**
   * Given a unit, return the constant to scale the original value so that it can be displayed in terms of unit.
   *
   * @param unit
   *        counting number unit
   * @return scale for formatting
   */
  pickCountScale: function(unit: !?string): !double java | js

  /**
   * Pick a counting number scale and unit for formatting.
   *
   * @param count
   *        value
   * @param scaleDigits
   *        adjust the values by 10⁻ⁿ to affect the chosen units
   * @return scale and unit for formatting
   */
  pickCountScaleAndUnit: function(count: !int, scaleDigits: !int32): Pair<double, string>

  /**
   * Pick a multiplier (ratio numerator) scale and unit for formatting.
   *
   * @param times
   *        value
   * @param scaleDigits
   *        adjust the values by 10⁻ⁿ to affect the chosen units
   * @return scale and unit for formatting
   */
  pickTimesUnit: function(times: !double, scaleDigits: !int32): Pair<double, string>

  /**
   * Pick a nanosecond duration unit for formatting.
   *
   * @param ns
   *        duration in nanoseconds
   * @param scaleDigits
   *        adjust the values by 10⁻ⁿ to affect the chosen units
   * @return unit for formatting
   */
  pickTimingUnitNs: function(ns: !int, scaleDigits: !int32): string java | js

  /**
   * Given a unit, return the constant to scale the original value so that it can be displayed in terms of unit.
   *
   * @param unit
   *        time duration unit
   * @return scale for formatting
   */
  pickTimingScaleNs: function(unit: !?string): !double java | js

  /**
   * Pick a nanosecond duration scale and unit for formatting.
   *
   * @param ns
   *        duration in nanoseconds
   * @param scaleDigits
   *        adjust the values by 10⁻ⁿ to affect the chosen units
   * @return scale and unit for formatting
   */
  pickTimingScaleAndUnitNs: function(ns: !int, scaleDigits: !int32): Pair<double, string>

  /**
   * Pick a second duration scale and unit for formatting.
   *
   * @param s
   *        duration in seconds
   * @param scaleDigits
   *        adjust the values by 10⁻ⁿ to affect the chosen units
   */
  pickTimingScaleAndUnitS: function(s: !double, scaleDigits: !int32): Pair<double, string>

  /**
   * Produce the sum of two double values, handling nulls.
   */
  sum: function(a: !?double, b: !?double): double

  /**
   * Produce the sum of two long values, handling nulls.
   */
  sum: function(a: !?int, b: !?int): int

  /**
   * Produce the sum and count of two Number values, handling nulls.
   */
  sumCount: function(a: !?Pair<number, int>, b: !?number): Pair<number, int>

  /**
   * Convert the arbitrary precision value to the most natural form of integer (either int32 or int).
   */
  toAnyInt: function(iv: !?double): number

  /**
   * Convert the arbitrary precision value to the most natural form of integer (int32, int or BigInteger).
   */
  toAnyInt: function(iv: !?double, boundToLongRange: boolean, failIfOutOfLongRange: boolean): number

  toBigInt:    function(num: !?number): double
  toBool:      function(num: !?number): boolean
  toByte:      function(num: !?number): byte
  toByteArray: function(value: !byte): [!byte]
  toByteArray: function(value: !int32): [!byte]
  toByteArray: function(value: !int): [!byte]
  toByteArray: function(value: !int16): [!byte]
  toBytes:     function(value: !int, compact: boolean): binary
  toChar:      function(num: !?number, failIfInvalid: boolean, for_: string): int32
  toDateTime:  function(num: !?number, failIfInvalid: boolean, for_: string): datetime

  /**
   * {@link java.math.BigDecimal#BigDecimal(String)} is the preferred method of instantiating a BigDecimal. See
   * comments in {@link java.math.BigDecimal#BigDecimal(double)} for an explanation. In short, BigDecimal translates a
   * double using "the exact decimal representation of the {@code double}'s binary floating-point value" which leads to
   * unpredictable results.
   */
  toDecimal: function(num: !?number): decimal java | js | py

  toDouble:     function(num: !?number): double java | js | py
  toFloat:      function(num: !?number): float java | js | py
  toInt:        function(num: !?number): int java | js | py
  toInt16:      function(num: !?number): int16 java | js | py
  toInt32:      function(num: !?number): int32 java | js | py
  toValue:      function(v: !?number, vt: !?ValueType, failIfInvalid: boolean, for_: string): any
  visitNumber:  function(value: !?number, visitor: !?any): any
  visitNumber:  function(value: !?number, arg: !?any, visitor: !?any): any
  visitNumbers: function(a: !?number, b: !?number, visitor: !?any): any
  clamp:        function(num: !int, min: !int, max: !int): !int
  clamp:        function(num: !double, min: !double, max: !double): !double
  toStr:        function(num: !int): string
  add:          function(num: !double, e: !?any): !double

  /**
   * Add two numbers and return result boxed in the first non-null argument from left to right. (a -> b)
   * Return null if both are null.
   */
  add: function(a: !?any, b: !?any): any

  /**
   * Add two numbers and return result boxed in the first non-null argument from left to right. (a -> b)
   * Return null if both are null.
   */
  sub: function(a: !?any, b: !?any): any

  /**
   * Produce the modulo of a Number value, handling null.
   */
  mod: function(v: !?any, d: !?any): any

  /**
   * Produce the floor division of a Number value, handling null.
   */
  floorDiv: function(v: !?any, d: !?any): any

  /**
   * Produce the multiplication of a Number value, handling null.
   */
  mul: function(v: !?any, d: !?any): any

  /**
   * Produce the power of a Number value, handling null.
   */
  pow: function(a: !?any, b: !?any): any

  abs:    function(a: !?any): any
  neg:    function(a: !?any): any
  round:  function(v: !?any): any
  invert: function(v: !?any): any
}
