   * @param failIfInvalid
   *        whether to throw error if the conversion fails.
   * @see {@link Ann.Java#runtimeClassName}
   */
  toJavaRuntime: function(vt: !?ValueType, v: !?any, failIfInvalid: boolean): any

  toJavaRuntime: function(vt: !?ValueType, v: !?any, converter: !?any, failIfInvalid: boolean): any
  toJson:        function(value: !?any): json

  /**
   * Return the JSON that provides the canonical serialization of the specified C3 value.
   */
  toTypedJson: function(value: !?any, actionRequirement: !?string): json

  /**
   * @return value converted to a single line json string
   */
  toJsonString: function(value: !?any): string

  /**
   * Convert a c3 value to Rhino Java Script runtime class
   */
  toJsRuntime: function(vt: !?ValueType, v: !?any): any

  /**
   * Convert a primitive value to JavaScript literal syntax.
   */
  toJsString: function(vt: !?ValueType, v: !?any): string

  /**
   * Convert a primitive value to Python literal syntax.
   */
  toPyString: function(vt: !?ValueType, v: !?any): string

  /**
   * Convert any value into its native equivalent. If this is an instance that mixes **WithToNative**, that
   * method is called, otherwise the existing value is returned.
   */
  @call(stayInEngine=true)
  toNative: function(value: !?any): any java | js | py

  /**
   * Convert any value into its native equivalent. If this is an instance that mixes **WithToNative**, that
   * method is called, otherwise the existing value is returned.
   *
   * In addition, instances of Obj are converted to plain JavaScript objects and Python dicts, containing only the
   * set field values.
   *
   *
   * In the case where that native representation would be unavoidably mutable, the `doNotCopy` flag may be passed to
   * access that internal state. _The caller must not modify this state._ By default, no sensitive state will be
   * exposed, copying if necessary.
   */
  @call(stayInEngine=true)
  toNative: function(value: !?any, doNotCopy: boolean): any java | js | py

  /**
   * Convert any value into a number. If the conversion is not possible, return `NaN` (double).
   */
  toNumber: function(value: !?any): number

  /**
   * Convert any value into a number. If the conversion is not possible, throw an exception if failIfInvalid is true
   * or return `NaN` (double) otherwise.
   */
  toNumber: function(value: !?any, failIfInvalid: boolean): number

  toObj: function(value: !?any,
                  ths: !?ReferenceType,
                  convertValue: boolean,
                  failIfInvalid: boolean,
                  for_: string): Obj

  toObj: function(value: !?any,
                  ths: !?ReferenceType,
                  convertValue: boolean,
                  failIfInvalid: boolean,
                  for_: string,
                  invalidFieldHandler: lambda(p1: any, p2: ObjBuilder)): Obj

  /**
   * @return value converted to a potentially multi-line json string with "pretty" indentation
   */
  toPrettyJsonSTring: function(v: !?any): string

  toPrimitive:   function(v: !?any, ths: !?PrimitiveType, failIfInvalid: boolean, for_: string): any
  valueToString: function(other: !?ValueType): string

  /**
   * Converts a value to its string representation. Returns "null" for null values.
   *
   * @see #formatValue(Object) for display-friendly formatting with number formatting
   */
  valueToString: function(value: !?native): string

  /**
   * Formats a value for display. Returns empty string for null values.
   * Numbers are formatted with locale-specific grouping (e.g., "1,234,567").
   *
   * @see #valueToString(Object) for raw string conversion (returns "null" for null)
   */
  formatValue: function(value: !?any): string

  unboxValue:      function(value: !?any, failIfNone: boolean): any
  unboxValue:      function(value: !?Obj, failIfNone: boolean): any
  unquote:         function(v: !?any): any
  validateThisArg: function(thisArg: !?any, method: !?Method, overload: !int32): any
  validateThisArg: function(thisArg: !?any, mt: !?MethodType): any
  validateArg:     function(arg: !?any, paramIndex: !int32): any
  validateSpec:    function(spec: !?any, dflt: !?lambda(): any): any

  /**
   * Prints provided values by prepending string with `prefix` and appending with `suffix` and by using `separator`
   * string to split the value text.
   */
  valuesToString: function(prefix: !?string,
                           separator: !?string,
                           suffix: !?string,
                           values: any ...): string java | js | py

  visitPrimitive: function(value: !?any, visitor: !?Primitive<any>): any
  visitValue:     function(value: !?any, visitor: !?any): any
  comparator:     function(): any
  abs:            function(a: !?any): any
  neg:            function(a: !?any): any
  invert:         function(a: !?any): any

  /**
   * @return sum of values while incrementing the count of values encountered
   */
  sumCount: function(a: !?any, b: !?any, spec: !?OpSpec): any

  all: function(a: !?any, b: !?any, rt: !?ValueType, spec: !?OpSpec): any
  and: function(a: !?any, b: !?any): any
  and: function(a: !?any, b: !?any, rt: !?ValueType): any

  and: function(a: !?any,
                b: !?any,
                rt: !?ValueType,
                spec: !?OpSpec,
                primFunc: !?lambda(p1: any, p2: any, p3: ValueType): any): any

  or: function(a: !?any, b: !?any): any
  or: function(a: !?any, b: !?any, rt: !?ValueType): any

  or: function(a: !?any,
               b: !?any,
               rt: !?ValueType,
               spec: !?OpSpec,
               primFunc: !?lambda(p1: any, p2: any, p3: ValueType): any): any

  add: function(a: !?any, b: !?any): any
  add: function(a: !?any, b: !?any, spec: !?OpSpec): any
  add: function(a: !?any, b: !?any, rt: !?ValueType): any
  add: function(a: !?any, b: !?any, rt: !?ValueType, spec: !?OpSpec): any

  add: function(a: !?any,
                b: !?any,
                rt: !?ValueType,
                spec: !?OpSpec,
                primFunc: !?lambda(p1: any, p2: any, p3: ValueType): any): any

  sub: function(a: !?any, b: !?any): any
  sub: function(a: !?any, b: !?any, spec: !?OpSpec): any
  sub: function(a: !?any, b: !?any, rt: !?ValueType): any
  sub: function(a: !?any, b: !?any, rt: !?ValueType, spec: !?OpSpec): any

  sub: function(a: !?any,
                b: !?any,
                rt: !?ValueType,
                spec: !?OpSpec,
                primFunc: !?lambda(p1: any, p2: any, p3: ValueType): any): any

  floorDiv: function(a: !?any, b: !?any): any
  floorDiv: function(a: !?any, b: !?any, rt: !?ValueType, spec: !?OpSpec): any

  /**
   * @return generic floor division between numeric, Collection, and Obj types.
   */
  floorDiv: function(a: !?any,
                     b: !?any,
                     rt: !?ValueType,
                     spec: !?OpSpec,
                     primFunc: !?lambda(p1: any, p2: any, p3: ValueType): any): any

  mod: function(a: !?any, b: !?any): any
  mod: function(a: !?any, b: !?any, spec: !?OpSpec): any
  mod: function(a: !?any, b: !?any, rt: !?ValueType, spec: !?OpSpec): any

  /**
   * @return generic modulo for numeric, Collection, and Obj types.
   */
  mod: function(a: !?any,
                b: !?any,
                rt: !?ValueType,
                spec: !?OpSpec,
                primFunc: !?lambda(p1: any, p2: any, p3: ValueType): any): any

  round: function(a: !?any): any
  div:   function(a: !?any, b: !?any): any
  div:   function(a: !?any, b: !?any, rt: !?ValueType): any
  div:   function(a: !?any, b: !?any, rt: !?ValueType, spec: !?OpSpec): any

  div: function(a: !?any,
                b: !?any,
                rt: !?ValueType,
                spec: !?OpSpec,
                primFunc: !?lambda(p1: any, p2: any, p3: ValueType): any): any

  /**
   * This is different from the default implementation of `div` such that `null` is returned when `a` is null/empty.
   * It is kept like that to correctly implement the higher order functions which uses div() internally.
   * The default implementation, although fast, gives incorrect results for `null / b`.
   */
  div: function(a: !?any, b: !int): any

  /**
   * @return "field count" of a provided value: primitives have 1 field, Obj has data fields and collection elements
   *         are considered fields.
   */
  fieldCount: function(v: !?any): !int

  /**
   * @return "field count" of a provided collection: primitives have 1 field, Obj has data fields and collection
   *         elements
   *         are considered fields. Returns number of unique fields in the entire collection.
   */
  collectionFieldCount: function(c: !?Iterable<any>): !int

  /**
   * @return field count at index in the provided value: primitives have only 1 field, Obj has data fields and
   *         collection elements are considered fields.
   */
  fieldAt: function(v: !?any, fieldIndex: !int): any

  mul: function(a: !?any, b: !?any): any
  mul: function(a: !?any, b: !?any, spec: !?OpSpec): any
  mul: function(a: !?any, b: !?any, rt: !?ValueType): any
  mul: function(a: !?any, b: !?any, rt: !?ValueType, spec: !?OpSpec): any

  mul: function(a: !?any,
                b: !?any,
                rt: !?ValueType,
                spec: !?OpSpec,
                primFunc: !?lambda(p1: any, p2: any, p3: ValueType): any): any

  pow:        function(a: !?any, b: !?any): any
  pow:        function(a: !?any, b: !?any, rt: !?ValueType): any
  pow:        function(a: !?any, b: !?any, rt: !?ValueType, spec: !?OpSpec): any
  isNum:      function(value: !?any): boolean java | js
  isBinary:   function(value: !?any): boolean java | js
  isString:   function(value: !?any): boolean java | js
  isBool:     function(value: !?any): boolean java | js
  isDateTime: function(value: !?any): boolean java | js | py
  isInt:      function(value: !?any): boolean

  /**
   * @return generic power(x, y) for numeric, Collection, and Obj types.
   */
  pow: function(a: !?any,
                b: !?any,
                rt: !?ValueType,
                spec: !?OpSpec,
                primFunc: !?lambda(p1: any, p2: any, p3: ValueType): any): any

  /**
   * @return function for computing given UnaryOp
   */
  opUnaryFunction: function(unaryOp: !?string, spec: !?OpSpec): lambda(p1: any): any

  /**
   * @return function for computing given AggOp
   */
  opAggFunction: function(aggOp: !?string, spec: !?OpSpec, rt: !?ValueType): lambda(p1: any, p2: any): any

  /**
   * @return return type of given aggregation operator to given operand types
   */
  opAggReturnType: function(avt: !?ValueType, aggOp: !?string, spec: !?AggSpec): ValueType

  /**
   * @return true if the value type is a reference type and all fields are primitives or fkey refs for optimizations
   *         for flat tables
   */
  refTypeHasOnlyPrimitiveFields: function(rt: !?ValueType): boolean

  /**
   * @return function for computing given BinaryOp
   */
  opBinaryFunction: function(binaryOp: !?string, rt: !?ValueType, spec: !?OpSpec): lambda(p1: any, p2: any): any

  /**
   * Recursively construct a map of column names to Value Type that represents the flatten
   * view of the provided Include Path and depth arguments.
   *
   * @param include
   *        The Include child currently being processed.
   * @param vt
   *        valueType of the current Field being traversed,
   * @param columnNamePrefix
   *        The current column name prefix at this level of traversal
   * @param depth
   *        The current depth value of the traversal
   * @param fieldnamesToValueType
   *        A mapping of column names to value type that will represent the final object flattened view
   */
  opFlattenReturnTypeRecursive: function(include: !?Include,
                                         vt: !?ValueType,
                                         columnNamePrefix: !?string,
                                         depth: !int,
                                         fieldnamesToValueType: !?MapBuilder<string, ValueType>)

  opFlattenReturnType: function(avt: !?ValueType, includeFields: !?string, depth: !int): ValueType

  /**
   * Apply cartesian product to the input Array and merge the inner map Objects.
   * ex: child 1 is a collection, stores all returned value in a single row
   * child1 : [ [ map ] , [ map1 ] , [ map1 ] ]
   * child2 : [ [ map ] ]
   * do cartesian product
   * [ [ map , map ] ],
   * [ map , map ] ],
   * [ map , map ] ]
   * ]
   * merge each row as one map
   * [ map, ,
   * map, ,
   * mapm
   * ]
   *
   * @param arr
   *        An Array of Array each containing a map of fieldNames to field Content
   * @return an Array of Map each being a merger of all maps grouped together after the
   *         cartesian product
   */
  mergeFlattenResults: function(arr: [any]): [map<string, any>]

  /**
   * The main data traversal function that will extract the data from each element recursively
   * and do the explode/flatten at every level. At each recursive step it returns an Array of
   * Map of field Name to Field Object value that contains new rows generated by the lower levels,
   * each flattened to match the object type created in opFlattenReturnType.
   *
   * @param include:
   *        The Include object currently being processed
   * @param vt:
   *        valueType of the current Field being traversed
   * @param fieldName:
   *        Field Name Being Traversed
   * @param e:
   *        Value of the FieldName with value type vt
   * @param columnNamePrefix:
   *        The current column name prefix at this level of traversal
   * @param depth
   *        The current depth value of the traversal
   * @return
   */
  opFlattenTraverseValues: function(include: !?Include,
                                    vt: !?ValueType,
                                    fieldName: !?string,
                                    e: !?Obj,
                                    columnNamePrefix: !?string,
                                    depth: !int): [map<string, any>]

  opFlattenReturnValue: function(et: !?ValueType,
                                 rt: !?ValueType,
                                 e: !?Obj,
                                 includeFields: !?string,
                                 depth: !int): [Obj]

  /**
   * @return return type of given binary operator application to given operand types
   */
  opBinaryReturnType: function(avt: !?ValueType, bvt: !?ValueType, spec: !?OpSpec, binaryOp: !?string): ValueType

  /**
   * @return new object that has value(s) replaced based on mask
   */
  replace: function(element: !?any, mask: !?any, other: !?any): any

  fillMissing: function(element: !?any, value: !?any, rt: !?ValueType): any

  /**
   * @return new object that has value(s) replaced based on mask
   */
  fillMissing: function(element: !?any, value: !?any, rt: !?ValueType, spec: !?OpSpec): any

  /**
   * @return primary key of a given value
   */
  primaryKey: function(v: !?any): any

  /**
   * @return true if provided value is "truthy"
   */
  isTrue: function(v: !?any): boolean

  /**
   * Return new instance of value with all references to old type replaced by new
   */
  replaceType: function(v: !?any, old: !?Type, new_: !?Type): any

  /**
   * Helper function for resolving final arguments of {@link Collection#slice(long, Long, Long)}.
   *
   * @param size
   *        a lambda that retrieves the size of the Collection to be operated on
   */
  sliceArgs: function(pkg: !?Pkg,
                      fromPos: !int,
                      toPos: !?int,
                      stride: !?int,
                      size: !?lambda(): int): Triple<int, int, int>

  /**
   * @return `true` if value is Boxed
   */
  isBoxed: function(v: !?any): boolean

  /**
   * @return unboxed return type
   */
  unboxReturn: function(v: !?any, returnType: !?ValueType): any

  /**
   * @return TypeMeta for a provided java value
   */
  toTypeMeta: function(t: !?any, pkg: !?Pkg, restriction: !?TypeMeta): TypeMeta

  toDouble:        function(v: !?any): !double
  toDouble:        function(v: !?any, dflt: !double): !double
  toFloat:         function(v: !?any): !float
  toFloat:         function(v: !?any, dflt: !float): !float
  toInt:           function(v: !?any): !int
  toInt:           function(v: !?any, dflt: !int): !int
  toInt32:         function(v: !?any): !int32
  toInt32:         function(v: !?any, dflt: !int32): !int32
  toInt16:         function(v: !?any): !int16
  toInt16:         function(v: !?any, dflt: !int16): !int16
  toByte:          function(v: !?any): !byte
  toByte:          function(v: !?any, dflt: !byte): !byte
  toDateTime:      function(v: !?any): datetime
  inRange:         function(value: !?any, minInclusive: !?any, maxExclusive: !?any): boolean
  versionIncMinor: function(versionStr: !?string, inc: !int32): string

  /**
   * Return a native object in the current runtime that cannot be remoted. It should always have a different pointer
   * and not be natively equal to any other object. It must not be a valid value for any value type (other than
   * `native`). Its string representation should be the seed value.
   */
  @call(stayInEngine=true)
  makeNative: function(seed: !int): any java | js | py

  eachValueRecursive: function(obj: !?Obj, action: !?lambda(p1: ValueType, p2: any))
}
