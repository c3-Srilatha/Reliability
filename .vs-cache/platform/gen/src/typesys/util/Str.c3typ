  toBigInt:   function(s: !?string, intType: !?IntType, failIfInvalid: boolean): double java | js | py
  toBinary:   function(s: !?string): binary java | js
  toBinary:   function(s: !?string, binType: !?BinaryType, failIfInvalid: boolean): binary java | js
  toBinary:   function(s: !?string, charset: !?string enum Charset): binary java | js
  toBool:     function(s: !?string, failIfInvalid: boolean): boolean java | js
  toBool:     function(s: !?string, failIfInvalid: boolean, for_: string): boolean java | js
  toBool:     function(s: !?string, boolType: !?BooleanType, failIfInvalid: boolean): boolean java | js
  toByte:     function(s: !?string, failIfInvalid: boolean): byte java | js
  toByte:     function(s: !?string, failIfInvalid: boolean, for_: string): byte java | js
  toChar:     function(s: !?string, failIfInvalid: boolean, for_: string): int32 java | js
  toChar:     function(s: !?string, charType: !?PrimitiveType, failIfInvalid: boolean): int32 java | js
  toDateTime: function(s: !?string, failIfInvalid: boolean, for_: string): datetime java | js
  toDateTime: function(s: !?string, dtType: !?DateTimeType, failIfInvalid: boolean): datetime java | js
  toDecimal:  function(s: !?string, failIfInvalid: boolean, for_: string): decimal java | js
  toDecimal:  function(s: !?string, decType: !?DecimalType, failIfInvalid: boolean): decimal java | js
  toDouble:   function(s: !?string, failIfInvalid: boolean, for_: string): double java | js
  toDouble:   function(s: !?string, dblType: !?DoubleType, failIfInvalid: boolean): double java | js
  toFloat:    function(s: !?string, failIfInvalid: boolean, for_: string): float java | js
  toFloat:    function(s: !?string, floatType: !?FloatType, failIfInvalid: boolean): float java | js
  toInt:      function(s: !?string, failIfInvalid: boolean, for_: string): int java | js
  toInt:      function(s: !?string, intType: !?IntType, failIfInvalid: boolean): int java | js
  toInt16:    function(s: !?string, failIfInvalid: boolean, for_: string): int16 java | js
  toInt16:    function(s: !?string, int16Type: !?Int16Type, failIfInvalid: boolean): int16 java | js
  toInt32:    function(s: !?string, failIfInvalid: boolean, for_: string): int32 java | js
  toInt32:    function(s: !?string, int32Type: !?Int32Type, failIfInvalid: boolean): int32 java | js
  toJson:     function(value: !?string, failIfInvalid: boolean): json java | js
  toJson:     function(value: !?string, failIfInvalid: boolean, for_: string): json java | js

  /**
   * @return Avoid encoding overhead by direct conversion from String to byte[]. Different Strings should always
   *         have different byte arrays. This is used in cases where you quickly want the 1:1 byte[] representation
   *         of a String for something such as hashing.
   */
  toUtf16ByteArray: function(s: !?string): [!byte] java | js

  toValue: function(s: !?string, vt: !?ValueType, failIfInvalid: boolean, for_: string): any java | js

  /**
   * Convert any Unicode string into something resembling a US English string that might have similar pronunciation.
   * Non-ASCII characters which have no transliteration are removed. ASCII (0-7F) characters remain as-is.
   *
   * This should only be used as a way to make Unicode strings 7-bit safe and with the understanding that not all
   * characters will be represented in the output. The result may also be confusing to a human, especially for
   * languages like Japanese that depend heavily on context.
   *
   * For example, "熊猫" maps to "Xiong Mao" and "गज" to "gj" (**not** "gaje").
   *
   * @param s
   *        string to transliterate
   * @param wordsOnly
   *        if true, punctuation and whitespace characters in transliteration are discarded
   */
  transliterate: function(s: !?string, wordsOnly: boolean): string

  /**
   * Remove any trailing whitespace from the string.
   */
  trimRight: function(s: !?string): string

  eachToken: function(value: !?string, action: !?lambda(p1: string, p2: double, p3: int32))

  /**
   * @return obfuscated string
   */
  obfuscate: function(value: !?string, seed: !?int): string

  /**
   * used for obfuscating a single word or number
   *
   * @return obfuscated word
   */
  obfuscateWord: function(wordOrNumber: !?string, seed: !?int): string

  /**
   * converts hyphenated string to camel case string
   */
  hyphenToCamelCase: function(str: !?string): string

  /**
   * Returns the longest common subsequence shared between the two provided strings.
   */
  longestCommonSubsequence: function(a: !?string, b: !?string): !int32

  /**
   * Truncates string to limit number of characters and replaces last character with ellipses (…) if actually
   * truncated.
   *
   * @param s
   *        string to be truncated
   * @param maximum
   *        length of resulting string
   */
  truncate: function(s: !?string, maximum: !int32): string java | js | py

  /**
   * Truncates string to limit number of characters and replaces last character with ellipses (…) if actually
   * truncated.
   *
   * @param s
   *        string to be truncated
   * @param maximum
   *        length of resulting string
   * @param appendEllipses
   *        replace last character with ellipses if true
   */
  truncate: function(s: !?string, maximum: !int32, appendEllipses: boolean): string java | js | py

  unescapeJava: function(str: !?string): string
  unquote:      function(s: !?string): string java | js | py
  unquote:      function(s: !?string, quoteChar: !int32): string java | js | py

  /**
   * Convert each character to upper-case. Non-letter characters are unchanged.
   *
   * @param str
   *        The string you want to process.
   * @return The string with all characters capitalized.
   */
  upperCase: function(str: !?string): string java | js

  /**
   * Check if a string is numeric
   */
  isNum: function(str: !?string): boolean

  /**
   * Generate a randomUuid string
   */
  randomUuid: function(): string

  /**
   * Is the given string a uuid
   */
  isUuid: function(uuid: !?string): boolean

  /**
   * Produce a UUID encoded in a shorter number of characters.
   * This is done by creating an ASCII string using base-64 encoding of the binary data rather
   * then hex with separators, making the result 22 characters long instead of 36
   * (for example "mNNYBo9jSjmm0Tsu3f6UaA" instead of "0433ed86-2f92-49d9-a706-9dac4363baf2").
   *
   * @return compact string encoding
   */
  compactUuid: function(): string

  /**
   * Encodes a value to replace the separator character such that the result does not contain any instances of that
   * character. Values can be decoded using decode.
   *
   * @param value
   *        value to be encoded
   * @param separator
   *        separator character to replace
   * @return input value encoded to not contain the separator character
   */
  encodeValue: function(value: !?string, separator: !int32): string

  /**
   * Decodes a value encoded with encodeValue.
   *
   * @param value
   *        value to be decoded
   * @param separator
   *        separator character indicated when the value was encoded
   * @return original value that was encoded
   */
  decodeValue: function(value: !?string, separator: !int32): string

  escapeAndQuote:     function(str: !?string): string
  needsEscape:        function(b: !int32): boolean
  lookupEscapeChar:   function(b: !int32): !int32
  lookupUnescapeChar: function(b: !int32): !int32
  escapeChar:         function(b: !int32): string

  /**
   * Convenience overload that defaults to a "f_" prefix because usually identifiers are used for field names.
   *
   * @param id
   *        possibly invalid Type System identifier
   * @return valid Type System identifier that can be parsed by DSL
   */
  identifier: function(id: !?string): string

  /**
   * Ensures that the provided identifier String is parsable by Type System DSL. A valid identifier is defined by
   * {@link Dsl#ID_RE}. Another way of describing a valid identifier is a letter or underscore followed by a possibly
   * empty sequence of letters, underscores, or digits.
   * ```
   * Str.identifier("2016-10-14T01:00:01", "c_") == "c_2016_10_14T01_00_01"
   * Str.identifier("985743-2314", "c_") == "c_985743_2314"
   * Str.identifier("567385147c4", "c_") == "c_567385147c4"
   * Str.identifier("validFieldName", "c_") == "validFieldName"
   * Str.identifier("F", "c_") == "F"
   * Str.identifier("f", "c_") == "f"
   * Str.identifier("_", "c_") == "_"
   * ```
   *
   * @param id
   *        possibly invalid Type System identifier
   * @param prefix
   *        if the provided field name needs to be prefixed to be valid
   * @return valid Type System identifier that can be parsed by DSL
   */
  identifier: function(id: !?string, prefix: !?string): string

  /**
   * @return extracted filename from a file system path
   */
  filename: function(path: !string): string java | js | py

  /**
   * @return extracted parent directory from a file system path
   */
  parentDirectory: function(path: !string): string

  /**
   * @return word at given index.
   * @param lineContent
   *        the string content of the line that need to find the word at indexed location.
   * @param index
   *        zero-based index for the word in the lineContent. As long as the index is within the range of the word,
   *        the same word will be returned.
   *        E.g., with lineContent 'hello world!', the word 'world' will be returned for index 6-10.
   */
  wordAt: function(lineContent: !?string, index: !int32): string

  /**
   * Return the start index (inclusive) and ending index (exclusive) of word at given index (0-based).
   * dot on the left side of a word is inclusive, dot on the right side of a word is exclusive.
   */
  wordRangeAt: function(lineContent: !?string, index: !int32): Pair<int32, int32>

  /**
   * Return the string with leading and trailing spaces removed. If the string is null, return null.
   */
  trim: function(s: !?string): string java | js | py

  /**
   * Return the string with any empty lines removed.
   */
  removeBlankLines: function(s: !?string): string

  /**
   * Produce the binary result of compressing this string as UTF-8 using the Snappy compression.
   *
   * @see Bin#uncompressSnappyString
   */
  compressSnappy: function(s: !?string): binary

  /**
   * Produce the binary result of compressing this string as UTF-8 using the Gzip compression.
   *
   * @see Bin#uncompressGzipString
   */
  compressGzip: function(s: !?string): binary
}
