        class Draft(DataValidation.Rule.Draft, DataValidation.Rule.WithLambda):
            """
            **DataValidation.Rule.Lambda.Draft** allows a Lambda "Draft" rule to be created for development.
            @see DataValidation.Rule.Lambda
            
            @remarks this represents a made instance of DataValidation.Rule.Lambda.Draft
            """
            
            lastSavedTimestamp: Optional[datetime]=None
            """
            Timestamp of the last saved version.  Subsequent updates to an instance will retain a `versionEdits` entry
            to get back to the state of the instance at this time.  If this is null, there has been no explicit save
            and no history will be retained until `updateAndSave` has been called.
            """

            numSavedVersions: Optional[int]=None
            """
            Number of saved versions.
            """

            savedVersion: Optional[int]=None
            """
            Maintains the saved version number.  If the latest version isn't saved, this will be `-1`.  As versions
            are saved they are assigned saved versions numbers starting at 1.  There will be no gaps between saved
            version numbers for saved versions.
            """

            versionEdits: Optional[Array[VersionEdit]]=None
            """
            Every update to types that mix this type in will retain `versionEdit` entries to enable going back to any
            previously saved version.
            
            Completely and automatically managed by the system.
            """

            name: Optional[str]
            """
            Name of the rule
            """

            id: Optional[str]
            """
            A unique identifier that can be manually assigned or generated automatically during object creation. This
            identifier cannot be altered after the object has been persisted.
            """

            meta: Optional[Meta]=None
            """
            Various system fields.
            """

            version: Optional[int]=None
            """
            Version number used for optimistic concurrency.  Automatically managed by the system.
            
            Updating an Obj with a null or 0 value for version will cause the concurrency check to be skipped and should only
            be done with great caution.
            """

            typeWithBindings: Optional[Type]=None
            """
            Persists concrete type with bindings for generic types where instance has parameter bindings
            """

            targetType: Optional[Type]=None
            """
            The type the rule is associated with. This association informs different parts of the platform to make informed
