            ```js
            var a = A.make({b: ['hello', 'goodbye'], d: {}});
            a.b[1] = 'World'; // 1
            a.c['hello'] = 'world'; // 2
            a.d.e = 'hello' // 3
            a.b.pop(); // 4
            ```
