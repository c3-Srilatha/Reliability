        ```type
        type A mixes MutableObj {
          onChange: ~
          b: [string]
          c: map<string, int>
          d: D
        }
        type D mixes MutableObj {
          onChange: ~
          e: string
        }
        ```
        ```js
        var a = A.make({b: ['hello', 'goodbye'], d: {}});
        a.b[1] = 'World'; // 1
        a.c['hello'] = 'world'; // 2
        a.d.e = 'hello' // 3
        a.b.pop(); // 4
        ```
