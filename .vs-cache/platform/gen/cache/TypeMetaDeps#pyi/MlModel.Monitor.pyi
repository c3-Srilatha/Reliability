    class Result(MlWorkflowCoordinatableResult):
        """
        Type for model monitoring results. Each instance of {@link MlModel.Monitor.Result} holds
        1) A model performance value resulting from {@link MlScoringMetric} calculation.
        2) Metadata on {@link MlModel.Monitor.Job} and {@link MlModel.Monitor.Group} that this result belongs to.
        3) Metadata on how the model performance was calculated such as - groupBy, MlModel, monitorTime etc,.
        
        @remarks this represents a made instance of MlModel.Monitor.Result
        """
        
        name: Optional[str]
        """
        The unique and required name of this instance.
        """

        typeIdent: Optional[str]=None
        """
        Indicates explicit sub-type of entry.  Composed of the concatenation of the typeKey of the instance's type and all
        of its base type's typeIdent
        """

        id: Optional[str]
        """
        A unique identifier that can be manually assigned or generated automatically during object creation. This
        identifier cannot be altered after the object has been persisted.
        """

        versionEdits: Optional[Array[VersionEdit]]=None
        """
        Tracks the version history of an object, which is only active if version history tracking is enabled. This field is
        crucial for accessing previous versions of an object and is entirely managed by the system.
        
        @see Ann.Db#versionHistory
        """

        meta: Optional[Meta]=None
        """
        Various system fields.
        """

        version: Optional[int]=None
        """
        Version number used for optimistic concurrency.  Automatically managed by the system.
        
        Updating an Obj with a null or 0 value for version will cause the concurrency check to be skipped and should only
        be done with great caution.
        """

        typeWithBindings: Optional[Type]=None
        """
        Persists concrete type with bindings for generic types where instance has parameter bindings
        """

        parentCoordinator: Optional[MlWorkflowCoordinatable[MlWorkflowCoordinatableResult]]
        """
        Parent {@link MlWorkflowCoordinatable} that this result belongs to.
        """

        statusForCoordinatable: Optional[str]
        """
        Helper field for filtering during the coordinator implementation.
        See {@link Workflow.Coordinatable} for status semantics.
        """

        canceledCount: Optional[int]=None
        """
        Number of times the {@link #parentCoordinator} has canceled this result.
        """

        isCanceled: Optional[bool]=None
        """
        True if the most recent execution of this result was canceled. This is used for quick filtering
        to focus on canceled results.
        """

        errorCount: Optional[int]=None
        """
        Stores the count of errors that would be returned from {@link #errors}. This is used for quick filtering
        to focus on results with errors.
        """

        run: Optional[WorkflowExecutorRun]=None
        """
        Reference to the {@link WorkflowExecutorRun} that executed the actions to execute this
        result.
        """

        durationSeconds: Optional[int]=None
        """
        Duration in seconds of the most recent {@link #run} that executed the actions pertaining to this result.
        This is used for quick filtering to focus on results with unexpected execution times (long or short).
        This field is null if this result has not been executed.
        """

        pastRuns: Optional[Array[WorkflowExecutorRun]]=None
        """
        Reference to all past {@link WorkflowExecutorRun}s that executed the actions pertaining to this
        result.
        """

        attemptedRecoveryCount: Optional[int]=None
        """
        Number of times the {@link #parentCoordinator} has attempted to recover this result.
        """

