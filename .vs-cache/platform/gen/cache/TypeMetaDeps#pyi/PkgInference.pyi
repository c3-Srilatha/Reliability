                                 '   |                   '
     + - - - - - - - - - - - - -     |                   '
     '                               v                   '
     ' +-------------------+       +-------------------+ '
     ' | field 2 ("field") | ----> |       pluck       | '
     ' +-------------------+       +-------------------+ '
     '                               |                   '
     + - - - - - - - - - - - - -     |                   '
                                 '   |                   '
                                 '   |                   '
                                 '   v                   '
                                 ' +-------------------+ '
