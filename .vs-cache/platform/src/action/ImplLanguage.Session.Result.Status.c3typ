/**
 * Values for {@link ImplLanguage.Session.Result#status result status}.
 *
 * @see ImplLanguage.Session.Result
 * @see https://jupyter-client.readthedocs.io/en/stable/messaging.html#request-reply
 */
enum type ImplLanguage.Session.Result.Status {

  OK = 'ok'

  ERROR = 'error'

  ABORTED = 'aborted'

  /**
   * Whether or not the status is exactly "ok".
   */
  isOK: function(status: !?string): boolean
}
