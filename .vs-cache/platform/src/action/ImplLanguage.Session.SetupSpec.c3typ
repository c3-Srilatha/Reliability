/**
 * Configuration for setting up a persistent session.
 *
 * @see ImplLanguage.Session#setup
 */
type ImplLanguage.Session.SetupSpec mixes Spec {

  /**
   * Any action requirement supported by the runtime. If unspecified, the basic runtime is used.
   */
  actionRequirement: string serialized Action.Requirement

  /**
   * Additional metadata passed from the client which may be used by the session implementation.
   */
  metadata: map<!string, any>
}
