/**
 * Specification for {@link App#actionDump}, {@link Server#actionDump}, and {@link Action#dump}
 */
type ActionsSpec mixes FetchSpecBase, FetchFilterSpecBase, Spec {

  offset: ~ = 0
  limit:  ~ = -1

  /**
   * See {@link FetchSpec#include}
   */
  include: string

  /**
   * Default sort order for {@link Action}s
   */
  order: ~ = 'descending(elapsed), descending(id)'

  /**
   * What kind of actions should be returned from the action hierarchy/tree.
   * root means the root nodes and current means the leaf nodes
   */
  kind: string enum Action.Kind = ROOT
}
