/**
 * The output from the <b>execute request</b>.
 *
 * @see ImplLanguage.Session#execute
 * @see ImplLanguage.Session.ExecuteSpec
 * @see https://jupyter-client.readthedocs.io/en/latest/messaging.html#execute
 */
abstract type ImplLanguage.Session.ExecuteResult mixes ImplLanguage.Session.Result {

  /**
   * The client-specified unique identifier of the cell, from the {@link ImplLanguage.Session.ExecuteSpec#cellId spec}.
   *
   * @see ImplLanguage.Session.ExecuteSpec#cellId
   */
  cellId: string

  /**
   * A counter that increases by one with each request that stores history. If the request did not store history,
   * this will be the current value of the counter.
   *
   * @see ImplLanguage.Session.ExecuteSpec#storeHistory
   */
  executionCount: !int

  /**
   * A map of names to results of the execution of the user expressions (`user_expressions` in the Jupyter protocol).
   *
   * @see ImplLanguage.Session.ExecuteSpec#userExpressions
   */
  userExpressions: map<!string, any>

  /**
   * Result data in various rendered formats.
   */
  data: [!Content]

  /**
   * Get result data for the specified format.
   */
  dataFor: member function(format: !string serialized ContentType, failIfMissing: boolean): Content java | js

  /**
   * The made value of the last statement in the block of code (if applicable). This will only be populated if
   * {@link ImplLanguage.Session.ExecuteSpec#returnValue} is set.
   *
   * @see #data
   */
  value: any

  /**
   * Any metadata that describes the data.
   */
  metadata: map<!string, any>

  /**
   * Optional transient data not to be persisted to a notebook or other document.
   */
  transient: map<!string, any>
}
