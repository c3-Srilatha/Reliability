/**
 * Reference to a C3 Action
 */
type ActionRef mixes StringSerializable {

  /**
   * Name of the target C3 type
   */
  typeName: !string

  /**
   * Name of the target C3 action
   */
  actionName: !string

  /**
   * Constructs reference to C3 Action
   */
  fromTypeAction: inline function(type: !Type, action: !string): !ActionRef

  /**
   * Calls target C3 Action
   */
  call: inline member function(args: map<string, any>): any

  /**
   * Return value type of a target C3 Action
   */
  returnType: inline member function(): ValueType

  /**
   * Type of a target C3 Action
   */
  toType: inline member function(): !Type

  /**
   * Return a new {@link ActionRef} with typeName replaced to the prototypeName of the typeName
   */
  toPrototype: inline member function(): !ActionRef

  toString:   ~
  fromString: ~
}
