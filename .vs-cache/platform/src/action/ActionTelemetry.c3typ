/**
 * Time-related statistics of an action execution.
 */
// TODO: PLAT-26359 add documentation for Action.c3typ changes
inline type ActionTelemetry {

  /**
   * Cpu time in nanoseconds
   */
  cpuNano: property(): !int

  /**
   * Total time in nanoseconds
   */
  timeNano: property(): !int

  /**
   * Total io time (sql / kv / other io) in nanoseconds
   */
  ioTimeNano: property(): !int

  /**
   * Sql time in nanoseconds
   */
  sqlTimeNano: property(): !int

  /**
   * Kv time in nanoseconds
   */
  kvTimeNano: property(): !int

  /**
   * Time spent in this action itself in nanoseconds (excluding child actions)
   */
  selfTimeNano: property(): !int

  /**
   * Cpu time spent in this action itself in nanoseconds (excluding child actions)
   */
  selfCpuNano: property(): !int

  /**
   * Io time spent in this action itself in nanoseconds (excluding child actions)
   */
  selfIoTimeNano: property(): !int

  /**
   * Sql time spent in this action itself in nanoseconds (excluding child actions)
   */
  selfSqlTimeNano: property(): !int

  /**
   * Key value store time spent in this action itself in nanoseconds (excluding child actions)
   */
  selfKvTimeNano: property(): !int

  /**
   * Sum of child action time in nanoseconds
   */
  childTimeNano: property(): !int

  /**
   * Sum of child action sql time in nanoseconds
   */
  childSqlTimeNano: property(): !int

  /**
   * Sum of child action kv time in nanoseconds
   */
  childKvTimeNano: property(): !int

  /**
   * Sum of child action obj count
   */
  childObjCount: property(): !int

  /**
   * Objs processed count
   */
  objCount: property(): !int

  /**
   * Script (e.g. javascript) time spent in this action itself in nanoseconds (excluding child actions)
   */
  scriptTimeNano: property(): !int

  /**
   * Total age in nanoseconds
   */
  ageNano: property(): !int

  /**
   * Paused time in nanoseconds
   */
  pausedNano: property(): !int

  /**
   * Total input bytes
   */
  bytesIn: property(): !int

  /**
   * Total output bytes
   */
  bytesOut: property(): !int

  /**
   * Total compressed output bytes
   */
  compressedBytesOut: property(): !int

  @ser(hidden=true)
  _timer: property(): @java(class='c3.platform.typesys.util.Timer') native

  /**
   * generate a log msg for the current telemetry
   */
  logMsg: member function(): string

  /**
   * Add to existing {@see selfSqlTimeNano}
   */
  addSelfSqlTimeNano: inline member function(nano: !int)

  /**
   * Add to existing {@see selfKvTimeNano}
   */
  addSelfKvTimeNano: inline member function(nano: !int)

  /**
   * Add to existing {@see childTimeNano}
   */
  addChildTimeNano: inline member function(nano: !int)

  /**
   * Add to existing {@see childSqlTimeNano}
   */
  addChildSqlTimeNano: inline member function(nano: !int)

  /**
   * Add to existing {@see childKvTimeNano}
   */
  addChildKvTimeNano: inline member function(nano: !int)

  /**
   * Add to existing {@see childObjCount}
   */
  addChildObjs: inline member function(objCount: !int)

  /**
   * Add to existing {@see objCount}
   */
  addObjs: inline member function(objCount: !int)

  /**
   * Add to existing {@see scriptTimeNano}
   */
  addScriptTimeNano: inline member function(nano: !int)

  /**
   * Add to existing {@see bytesIn}
   */
  addBytesIn: inline member function(bytes: !int)

  /**
   * Add to existing {@see bytesOut}
   */
  addBytesOut: inline member function(bytes: !int)

  /**
   * Add to existing {@see compressedBytesOut}
   */
  addCompressedBytesOut: inline member function(bytes: !int)

  pauseTiming:  member function()
  resumeTiming: member function()
  startTiming:  member function()
}
