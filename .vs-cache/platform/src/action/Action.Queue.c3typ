/**
 * A queue representing pending actions
 */
inline type Action.Queue mixes Stateful, Identified {

  /**
   * Put action at the end of the queue; will throw error if queue is at capacity
   */
  offer: member function(action: !Action)

  /**
   * @return instance of the Action at the top of the queue
   */
  take: member function(): !Action

  /**
   * @return instance of the Action at the top of the queue or `null` if queue is empty
   */
  poll: member function(waitTimeoutMs: int): Action

  /**
   * @return element at the front of the queue, without removing it
   */
  peek: member function(): Action

  /**
   * @return size of the queue
   */
  size: property(): !int32

  /**
   * @return `true` if queue is empty
   */
  isEmpty: member function(): boolean

  javaWorkQueue: private property(): @java(class='java.util.concurrent.BlockingQueue') native
}
