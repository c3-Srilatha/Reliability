/**
 * This instance contains information on a single persistent session implemented by script code.
 * Persistent sessions are used to implement script-based {@link Engine.Deprecated engines}, which allows the code to build and
 * maintain a cache between calls.
 *
 * @see Engine.Deprecated
 */
private type ExternalEngineSession {

  /**
   * The instance of the Engine.
   */
  inst: Engine.Deprecated

  /**
   * The child process running the external environment.
   */
  process: @java(class="java.lang.Process") native

  /**
   * The port number of the web server to service actions.
   */
  port: !int

  /**
   * @return session for the running engine.
   */
  forInst: function(inst: Engine.Deprecated): ExternalEngineSession

  /**
   * Get the current status of the child process. This will be either RUNNING or STOPPED.
   */
  state: member function(): !string enum Engine.State

  /**
   * Terminate the child process.
   */
  shutdown: member function()

  /**
   * remove any leftover external processes, due to unexpected server exits.
   */
  @action(group+='cluster-admin')
  clearOrphaned: function()
}
