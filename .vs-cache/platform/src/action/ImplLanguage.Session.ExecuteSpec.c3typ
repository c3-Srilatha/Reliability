/**
 * The input to the <b>execute request</b>.
 *
 * @see ImplLanguage.Session#execute
 * @see ImplLanguage.Session.ExecuteResult
 * @see https://jupyter-client.readthedocs.io/en/latest/messaging.html#execute
 */
abstract type ImplLanguage.Session.ExecuteSpec mixes Spec {

  /**
   * The client-specified unique identifier of the cell.
   */
  cellId: string

  /**
   * The source code to be executed, one or more lines.
   */
  code: string

  /**
   * Execute this code as quietly as possible. This also means #noHistory must be false.
   */
  silent: boolean

  /**
   * Whether to suppress populating history (not `store_history` in the Jupyter protocol). If #silent is true,
   * this must also be true, otherwise it should generally be false.
   */
  noStoreHistory: boolean

  /**
   * Return the actual execution value in {@link ImplLanguage.Session.ExecuteResult#value} instead of building the
   * various visualizations and returning them in {@link ImplLanguage.Session.ExecuteResult#data}.
   */
  returnValue: boolean

  /**
   * A map of names to expressions to be evaluated after execution (`user_expressions` in the Jupyter protocol).
   *
   * @see ImplLanguage.Session.ExecuteResult#userExpressions
   */
  userExpressions: map<!string, string>
}
