/**
 * Configuration for the ActionLogger.
 */
// TODO PLAT-120465 re-enable usages of ActionLogger.Config
private type ActionLogger.Config mixes Singleton, Config {

  /**
   * Maximum length of a action log message, in characters.
   * If a message is longer than this, it will be truncated, keeping the beginning portion of the message.
   */
  length: int = 10000

  /**
   * Logs action information if action fails or errors
   */
  logActionArgsOnFailure: boolean
}
