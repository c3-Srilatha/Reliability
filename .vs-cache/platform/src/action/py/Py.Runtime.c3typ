inline private type Py.Runtime mixes ImplLanguage.ResolvedRuntime, ImplLanguage.WithLibraries<Py.ResolvedLibrary> {

  dependencies: ~: !ImplLanguage.RuntimeDeps

  /**
   * @return new instance of Py.Runtime with appended extra pip dependencies
   */
  appendPipDependencies: member function(names: ![!string]): !Py.Runtime

  // Helper method for forName to dry code. Return {@link Py.Runtime} based on the name. This is for mac only.
  forNameWithEngineLibraries: private function(name: !?string, failIfMissing: boolean): Py.Runtime
}
