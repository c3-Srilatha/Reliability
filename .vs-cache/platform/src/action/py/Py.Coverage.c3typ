/**
 * Use Coverage.py to collect code coverage for Python code. See https://coverage.readthedocs.io/en/7.1.0/
 * Since `Coverage.py` is available in every runtime, all python methods in this type are declared with `py`.
 */
private type Py.Coverage {

  /**
   * @return the code snippet that initializes python code coverage by importing the coveragepy library
   */
  initCode: private function(directory: !string, executor: !string, hashCode: !int): string

  /**
   * @return the code snippet that starts python code coverage
   */
  startCode: private function(): string

  /**
   * @return the code snippet that stops python code coverage
   */
  stopCode: private function(): string

  /**
   * Combine all coverage files that match the inputPathGlob into a single coverage file at `outputPath` and keep the
   * original coverage files.
   */
  combine: function(inputPathGlob: !string, outputPath: !string) py

  /**
   * Generate an html report from the coverage file at given path.
   */
  htmlReport: function(inputPath: !string) py

  /**
   * Generate a json report from the coverage file at given path.
   *
   * @param inputPath the path to the coverage file
   * @param filePathsMap a map of relative file paths from the repository root to their corresponding external URLs
   */
  jsonReport: function(inputPath: !string, filePathsMap: map<string, string serialized FileUrl>): json py
}
