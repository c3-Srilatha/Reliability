/**
 * This provides support for a TurboJs-based persistent session within the C3 server.
 */
type Js.TurboJsSession mixes ImplLanguage.Session {

  setup:       ~
  isComplete:  ~
  saveGlobals: ~
  loadGlobals: ~
  _inst:       private @java(class="c3.platform.action.js.TurboJs") !native
  _scope:      private @java(class="org.mozilla.javascript.Scriptable") !native
}
