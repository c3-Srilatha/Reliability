/**
 * Input source files that get merged into a single minified line.
 */
type JsMinifier.SourceFile mixes WithName {

  /**
   * The file name.
   */
  name: !~

  /**
   * The JavaScript code in the file.
   */
  code: string

  /**
   * Create a source file from the file name and code.
   */
  of: function(name: !string, code: !?string): !JsMinifier.SourceFile
}
