/**
 * This type can be used to introspect the state of the JavaScript action engine.
 *
 * @see JavaScriptContextCache
 * @see JavaScriptTypeCache
 */
type JavaScriptInfo {

  runtime:       string
  version:       string
  compatibility: boolean
  makeValidate:  boolean
  executeCount:  int
  executeTotalS: double
  executeTotalF: string
  executeAvgS:   double
  executeAvgF:   string
  execute1sS:    double
  execute1sF:    string
  errorCount:    int
  retryCount:    int
  staticMemoryB: int
  staticMemoryF: string
  contextCount:  int
}
