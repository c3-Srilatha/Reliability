/**
 * Implementation of JavaScript minification and source map generation. This does *not* support transpilation and
 * allows invalid syntax to handle file fragments. Note that this doesn't really make the files smaller (other than
 * removing comments), but does allow multiple files to be delivered as a single script in a way that preserves
 * debuggability via source maps.
 *
 * @see https://en.wikipedia.org/wiki/Minification_(programming)
 * @see https://developer.chrome.com/blog/sourcemaps/
 */
type JsMinifier {

  /**
   * The source files to be minified.
   */
  sourceFiles: [!JsMinifier.SourceFile]

  /**
   * Prefix for all source files in the source map; output to the "sourceRoot" field.
   */
  sourceRoot: string

  /**
   * Produce the merged single-line script from the #sourceFiles.
   */
  minify: member function(): string

  /**
   * Produce the source map that allows debugging the minified script.
   */
  sourceMap: member function(): !json
}
