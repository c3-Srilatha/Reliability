/**
 * Ad-hoc MapReduce job for testing and admin purposes. Not intended for production use.
 *
 * Can be run against any persistable type (including ad-hoc JSData>. E.g.:
 */
entity type JSMapReduceJob extends MapReduce<Obj, string, Obj, Obj> type key 'JS' {

  context:      Obj
  mapLambda:    string
  reduceLambda: string
  map:          ~ js-server
  reduce:       ~ js-server
}
