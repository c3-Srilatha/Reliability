/**
 * Options for Ad-hoc MapReduce job.
 */
type JSMapReduceSpec mixes MapReduceOptions, Spec {

  /**
   * JS function code that implements map logic. (required)
   */
  map: !string

  /**
   * JS function code that implements reduce logic. (optional)
   */
  reduce: string

  /**
   * Optional context object if ad-hoc job needs additional options.
   */
  context: Obj

  /**
   * By default job will abort on errors. If you set this flag then on failure job will move into failing
   * state and will stay in the queue in failed state. It can then be recovered at a later point.
   */
  doNotAbortOnError: boolean
}
