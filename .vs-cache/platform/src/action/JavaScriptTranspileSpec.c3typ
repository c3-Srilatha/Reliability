/**
 * Return value from JavaScriptTranspiler#transpile.
 */
type JavaScriptTranspileSpec mixes Spec {

  /**
   * The version to process. Note that this is normally a JavaScript version, but may also be another format which
   * the transpiler knows how to handle, such as "TSX".
   *
   * @see https://babeljs.io/docs/en/6.26.3/babel-cli
   */
  inputVersion: string = 'ESNext'

  /**
   * Whether to skip transpilation and just parse the file. This is useful in conjunction with #ast when analyzing a
   * JavaScript source file.
   */
  parseOnly: boolean

  /**
   * Whether to produce a source map.
   */
  sourceMap: boolean

  /**
   * Whether to produce an abstract syntax tree.
   */
  ast: boolean
}
