/**
 * Abstract interface for describing action executor behavior.
 */
abstract type ActionRemoteExecutor mixes ActionStaticExecutor, Value {

  /**
   * Applies given lambda synchronously and optionally remotely.
   */
  exec: abstract function(action: !lambda(): any, spec: ActionTargetSpec): any

  /**
   * Submits given lambda for asynchronous and potentially remote execution.
   */
  async: abstract function(action: !lambda(): any, spec: ActionTargetSpec): Promise<any>
}
