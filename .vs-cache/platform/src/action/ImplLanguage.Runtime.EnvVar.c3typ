/**
 * Type used to define environment variables for a Runtime
 */
type ImplLanguage.Runtime.EnvVar mixes Nameable {

  /**
   * Name of the EnvVar
   */
  name: ~

  /**
   * The expression that generates the value of the `EnvVar`. Within the `Expr`, `this` refers to a `ImplLanguage.Runtime.Context` created for the `Runtime` the `EnvVar` lives upon.
   */
  value: string serialized Expr

  /**
   * This specifies how we modify the environment variable
   * REPLACE: replace the existing value with output from `value`
   *         "MY_ENVVAR":"A" becomes "MY_ENVVAR":"B"
   * APPEND: add the output from `value` to the end of the existing values
   *         "MY_ENVVAR":"A" becomes "MY_ENVVAR":"A" + divider + "B"
   * PREPEND: add the output from `value` to the start of the existing values
   *         "MY_ENVVAR":"A" becomes "MY_ENVVAR":"B" + divider + "A"
   * INHERIT_FROM_JVM: inherit the value from JVM
   *         "PATH" becomes JVM "PATH"
   */
  action: !string enum("REPLACE", "APPEND", "PREPEND", "INHERIT_FROM_JVM")

  /**
   * the divider used for 'APPEND' and 'PREPEND'.
   */
  divider: ?string = ''
}
