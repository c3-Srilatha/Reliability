// TODO: PLAT-26724 Implement and test Action methods
type ActionSecurityExtension {

  // @return value of `@action(authz=` annotation
  authz: private cached member function(): string

  /**
   * @return value of `@action(authzChildActions=` annotation
   */
  authzChildActions: private cached member function(): boolean

  /**
   * @return value of `@action(accessControlGroups=` annotation
   */
  accessControlGroups: private cached member function(): [string]
}
