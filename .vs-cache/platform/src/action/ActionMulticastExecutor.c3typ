/**
 * Abstract interface for describing action multicast executor behavior.
 */
abstract type ActionMulticastExecutor mixes Value {

  /**
   * Applies given lambda synchronously on multiple server nodes.
   */
  multicast: abstract function(action: !lambda(): any, spec: ActionMulticastTargetSpec): map<string, Pair<any, Error>>

  /**
   * Submits given lambda for asynchronous execution to multiple server nodes.
   */
  asyncMulticast: abstract function(action: !lambda(): any,
                                    spec: ActionMulticastTargetSpec): map<string, Promise<any>>
}
