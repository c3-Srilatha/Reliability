/**
 * Holds information of current action, used by {@link Api.Request} for propagating action related information to child
 * actions.
 */
inline type Action.Context {

  /**
   * Id of current {@link Action}.
   */
  actionId: !string

  /**
   * Root id of current {@link Action}.
   */
  rootId: !string

  /**
   * Parent id of current {@link Action}.
   */
  parentId: string

  /**
   * Id of the node that is executing this action.
   */
  nodeId: string serialized App.Node.Id

  /**
   * Depth of this action context
   */
  depth: int

  /**
   * Context that needs to be propagated to child actions
   */
  context: map<string, any>
}
