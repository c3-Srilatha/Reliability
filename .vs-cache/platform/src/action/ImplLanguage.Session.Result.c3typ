/**
 * Shared data in all responses from the server. Some requests may return no additional data as this includes the
 * standard status and error fields.
 *
 * @see ImplLanguage.Session
 * @see https://jupyter-client.readthedocs.io/en/stable/messaging.html#request-reply
 */
type ImplLanguage.Session.Result mixes Result {

  /**
   * The node which handled the request. Normally, {@link ImplLanguage.Session sessions} are sticky, but if the initial
   * node does, it will be handed over to a new node. Subsequent requests for this session should
   * {@link ImplLanguage.Session#appNode specify the new node} so they are correctly routed.
   */
  appNode: !string serialized App.Node.Id

  /**
   * The status of the request.
   */
  status: !string enum ImplLanguage.Session.Result.Status

  /**
   * The error code/exception name if #status is `error` (`ename` in the Jupyter protocol).
   */
  errorName: string

  /**
   * The exception string if #status is `error` (`evalue` in the Jupyter protocol).
   */
  errorValue: string

  /**
   * The stack backtrace if #status is `error` (`traceback` in the Jupyter protocol).
   */
  stackTrace: string
}
