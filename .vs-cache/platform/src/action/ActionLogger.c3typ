/**
 * Responsible for logging common metadata about the execution of every non-inline C3 action.
 * Sensitive information should not be logged.
 *
 * @see Log.Profile
 * @see Log.Entry
 * @see Log.Entry.Action
 */
type ActionLogger mixes Configurable<ActionLogger.Config> {

  /**
   * Logs summary of an executed action
   */
  log: inline function(action: !Action)

  /**
   * Action execution summary
   */
  logMsg: inline function(action: !Action): !string

  /**
   * Log entry built for an action. Helper function for {@link #logMsg}.
   */
  logEntry: inline function(action: !Action): !Log.Entry.Action
}
