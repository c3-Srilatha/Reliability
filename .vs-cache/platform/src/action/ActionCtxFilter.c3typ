/**
 * Represents C3 ActionCtx filter
 *      Ex: Used through DataPermission through _context
 */
type ActionCtxFilter {

  /**
   * Url used to access the current action. Can be null if this is not a Rest request.
   */
  url: string

  /**
   * Url serverId for Rest requests or hostname of the server where this action is being executed.
   */
  serverId: string

  /**
   * Env where the action is being executed.
   */
  env: string

  /**
   * App where the action is being executed.
   */
  app: string

  /**
   * Name of the Type for this action.
   */
  typeName: string

  /**
   * Name of this action.
   */
  action: string

  /**
   * User id of the user executing this action.
   */
  userName: string

  /**
   * User + UserGroups + Roles of the Principal executing this action.
   */
  accessControlEntities: [AccessControlEntity]
}
