/**
 * Details of an Action Group from Security and Access Control standpoint.
 */
type Action.Group mixes MetadataIdentified, StringSerializable {

  forId: ~

  /**
   * The security level of this Action Group.
   */
  securityLevel: int enum SecurityLevel = MAX

  /**
   * The role id that corresponds to this Action Group.
   */
  @ser(name='role')
  roleId: string serialized Role

  /**
   * The role that corresponds to this Action Group.
   */
  role: cached property(): Role

  /**
   * Compares the minimum security levels of two lists of Action.Groups.
   *
   * @return negative if first < (more restrictive than) second, zero if equal, positive if first > (less restrictive
   *         than) second
   */
  compareActionGroups: private function(first: Array<string serialized Action.Group>,
                                        second: Array<string serialized Action.Group>): !int
}
