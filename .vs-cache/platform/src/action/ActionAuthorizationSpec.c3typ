/**
 * This spec is used to adjust the results when getting authorization information for an action. Please also see
 * {@link Authorizer#actionAuthzRoles} and {@link Authorizer#actionAuthorization}
 */
type ActionAuthorizationSpec mixes Spec {

  /**
   * The target type for authorization information.
   */
  typeName: !string

  /**
   * The target action name for authorization information.
   */
  action: !string

  /**
   * If specified, authorization will be evaluated for the given user, otherwise all authorization information
   * that can be applied to the target action specified.
   */
  user: User

  /**
   * If true, filter out various admin roles and developer role.
   */
  skipDeveloperAndAdmins: boolean

  /**
   * If true, sort the results, putting the standard roles (prefixed by `C3.Role`) first.
   */
  sort: boolean
}
