/**
 * Specification for where action should be multi-casted.
 */
type ActionMulticastTargetSpec mixes HardwareProfileAware, TimeoutSpec {

  /**
   * If `true` then this action on only all worker nodes.
   */
  onlyWorkers: boolean

  /**
   * If `true` then this action on only all master nodes.
   */
  onlyMasters: boolean

  /**
   * If the server nodes is set then action will be sent to these nodes.
   */
  nodes: [string]

  /**
   * @return candidate server nodes based on this spec.
   */
  @action(group+='cluster-admin')
  candidateNodes: private member function(): [string]
}
