/**
 * We save the state of a session to the database periodically, and at least when it is dropped from memory so that
 * it can be auto-restored.
 *
 * @see ImplLanguage.Session
 * @see ImplLanguage.Session.Config
 */
@db(datastore="fs")
entity type ImplLanguage.SavedSession mixes Identified, AclEnabled {

  /**
   * The concrete type of the session being saved.
   */
  sessionType: !string serialized Type<<ImplLanguage.Session>>

  /**
   * The state used to initialize the session.
   */
  setupSpec: ImplLanguage.Session.SetupSpec

  /**
   * The execution counter.
   *
   * @see ImplLanguage.Session#nextCounter
   */
  counter: !int

  /**
   * The last time this session was accessed by the user.
   */
  touched: !datetime with millis

  /**
   * A map of serializations of global variables in the session at the time it was saved. This map is produced by
   * ImplLanguage.Session#saveGlobals and consumed by {@link ImplLanguage.Session#loadGlobals loadGlobals} so the
   * session can also the most natural data representation.
   *
   * This will be incomplete if the session state contains things we don't know how to serialize.
   */
  globals: map<!string, binary>
}
