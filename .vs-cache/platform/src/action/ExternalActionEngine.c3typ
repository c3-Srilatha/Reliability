/**
 * Handles actions implemented by external processes like nodejs or python.
 */
type ExternalActionEngine {

  /**
   * Starts session for an engine if it's implemented by external process like nodejs or python. Does nothing and
   * returns null otherwise.
   */
  startSession: function(engine: Engine.Deprecated): ExternalEngineSession
}
