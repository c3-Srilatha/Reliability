/**
 * This type is used to extend the ActionContext object (_context) at run time.
 */
@db(unique=['name'])
type ActionContextExtension mixes Metadata, Named {

  /**
   * Name of the context extension. This is the identifier used in the ActionExtension object
   * to access the extension value: _context.<name>
   */
  name: string

  /**
   * The expression is what determines the projection used when fetching the extension value.
   */
  expression: string

  /**
   * Type used to evaluate the filter to obtain the given projection.
   */
  typeName: string

  /**
   * Filter used to get the object to evaluate.
   */
  filter: string
}
