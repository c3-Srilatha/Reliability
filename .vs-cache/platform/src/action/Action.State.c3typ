/**
 * Enumeration of possible state for Action.
 */
enum type Action.State {

  /**
   * New action
   */
  NEW = 'New'

  /**
   * Action is waiting to be picked up by a thread
   */
  WAITING = 'Waiting'

  /**
   * Action is executing in one of the threads
   */
  RUNNING = 'Running'

  /**
   * Action is interrupting, meaning {@link Action#interrupt} was called
   */
  INTERRUPTING = 'Interrupting'

  /**
   * Action is stopped, meaning {@link Action#stop} was called
   */
  STOPPED = 'Stopped'

  /**
   * Action is complete.
   */
  COMPLETE = 'Complete'

  /**
   * Action has failed.
   */
  FAILED = 'Failed'
}
