/**
 * Return value from JavaScriptTranspiler#transpile.
 */
type JavaScriptTranspileResult mixes Result {

  /**
   * The transpiled JavaScript source.
   */
  output: string

  /**
   * True if the output is the same as the input (no transpilation necessary).
   */
  trivial: boolean

  /**
   * The produced source map (if requested).
   */
  sourceMap: json

  /**
   * Abstract syntax tree of the parsed file in {@link https://github.com/estree/estree ESTree format} (if requested).
   */
  ast: json

  /**
   * Errors and warnings encountered during parsing of the source.
   */
  issues: [Pkg.Issue]
}
