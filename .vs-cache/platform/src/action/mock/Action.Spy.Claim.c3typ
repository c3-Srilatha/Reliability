/**
 * Lambda based C3 Action spy.
 */
abstract private type Action.Spy.Claim extends Action.Spy {

  /**
   * Lambda that should return `true` if this instance spies action with provided arguments. Note if Action.Spy#args are
   * provided in this spy then this lambda is only called if those #args are matched first.
   *
   * If this is null, it will match everything.
   */
  claims: lambda(spy: !Action.Spy, args: map<string, any>): boolean

  checkClaim: ~
}
