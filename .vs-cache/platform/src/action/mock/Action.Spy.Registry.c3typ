/**
 * Holds all active action spies and mocks for a given target C3 Action.
 */
@db(unique=['targetAction.typeName, targetAction.actionName'])
@cache(include='this, {spies:[]}')
private entity type Action.Spy.Registry mixes Cached schema name 'ACTION_SPY_REG' {

  /**
   * Target C3 Action for this entry
   */
  targetAction: !ActionRef

  /**
   * All active spies and mocks for a target C3 Action
   */
  spies: ![Action.Spy] schema suffix 'SPIES'

  /**
   * Timestamp when first spy or spy was activated for this C3 Action
   */
  registeredAt: !datetime

  /**
   * @return all action spy registries.
   */
  all: function(group: string): [Action.Spy.Registry]

  /**
   * Lookup registry entry for a given spy
   */
  forSpy: inline function(spy: !Action.Spy): Action.Spy.Registry

  /**
   * Lookup registry entry for a given C3 Action
   */
  forAction: inline function(action: !ActionRef): Action.Spy.Registry

  /**
   * Register/activate all declared spies for a target C3 Action of this registry or just one provided as argument.
   */
  @action(group+='app-admin')
  register: member function(spy: Action.Spy)

  /**
   * Unregister/deactivate all active spies for a target C3 Action of this registry or just one provided as argument.
   */
  @action(group+='app-admin')
  unregister: member function(spy: Action.Spy)

  /**
   * Register action spy locally (on node executing action).
   */
  @action(group+='app-admin')
  registerLocal: private member function()

  /**
   * Unregister action spy locally (on node executing action).
   */
  @action(group+='app-admin')
  unregisterLocal: private member function()

  /**
   * Updates call count and call parameters for this action spy across all nodes in cluster.
   */
  updateCallStats: private inline member function(spy: !Action.Spy, args: map<string, any>)

  /**
   * Updates call count and call parameters for this action spy on node executing action.
   */
  updateCallStatsLocal: private member function(spy: !Action.Spy, args: map<string, any>)

  /**
   * Call history of the provided spy.
   */
  callHistory: member function(spy: !Action.Spy): [Action.Call]
}
