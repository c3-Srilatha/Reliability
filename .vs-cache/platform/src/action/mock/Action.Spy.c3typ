/**
 * Implements action spying. I.e. ability to listen to C3 Action invocation.
 *
 * @see Action.Mock
 * @see Action.Spy.Lambda
 */
@dependency(include="targetAction")
extendable entity type Action.Spy mixes SeedData type key 'SPY' schema name 'ACTION_SPY' {

  /**
   * Target action for this action spy.
   */
  targetAction: !ActionRef

  /**
   * Expected arguments of a target C3 Action call.
   *
   * If this is null, it will match any target C3 Action call.
   */
  args: map<string, any>

  /**
   * Group of action spies.
   */
  group: string

  /**
   * If provided determines order in which all registered action spies will be evaluated for claim of given C3 Action.
   */
  sequence: int

  /**
   * Tests if this spy is registered / active.
   */
  isRegistered: member function(): boolean

  /**
   * Register action spy across all nodes in cluster.
   */
  // TODO: PLAT-78075 - include "this"
  @dependency(include='args')
  register: member function()

  /**
   * Unregister action spy across all nodes in cluster.
   */
  unregister: member function()

  /**
   * Register all seeded action spies and mocks.
   */
  registerAll: function(group: string)

  /**
   * Unregister all action spies and mocks.
   */
  unregisterAll: function(group: string)

  /**
   * @return all registered action spies and mocks.
   */
  allRegistered: function(group: string): [Action.Spy]

  /**
   * @return all declared action spies and mocks.
   */
  allDeclared: function(group: string): [Action.Spy]

  /**
   * @return type ref for the target action
   */
  targetType: inline member function(): !Type

  /**
   * @return method type for the target action
   */
  targetMethod: inline member function(): !Method

  /**
   * Call history of this spy.
   */
  callHistory: member function(): [Action.Call]

  /**
   * Initialized to 0 when `register` is called, this counts the number of calls this Action.Spy has handled since this
   * Action.Spy was registered.
   */
  callCount: member function(): !int

  /**
   * All instances of call history of a target C3 Action with provided arguments
   */
  callsForArgs: member function(args: !?map<string, any>): [Action.Call]

  /**
   * Returns true if this Action.Spy has been called with the provided args since being registered, false otherwise.
   */
  hasBeenCalledWith: member function(args: !?map<string, any>): !boolean

  /**
   * @return registry for this action spy.
   */
  registry: private inline member function(): Action.Spy.Registry

  /**
   * @return true if this spy claims action with provided call arguments; since this is an `inline` action withing
   * implementation C3.Action will return target instance of C3 Action of this spy
   */
  checkClaim: private inline member function(args: !?map<string, any>): boolean

  /**
   * @return wrap a call to target C3 action thunk; since this is an `inline` action within implementation
   * C3.Action will return instance of target C3 Action of this spy
   */
  wrapCall: private inline member function(action: !?lambda(): any, c3Action: Action): any
}
