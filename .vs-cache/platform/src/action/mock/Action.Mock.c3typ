/**
 * Implements C3 Action mocking. I.e. ability to provide C3 Action implementation as a resulting value or a lambda that
 * produces the result.
 *
 * @see Action.Mock.Auto
 * @see Action.Mock.Result
 * @see Action.Mock.Lambda
 */
abstract type Action.Mock extends Action.Spy type key 'MOCK'
