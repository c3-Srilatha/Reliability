/**
 * Lambda based C3 Action spy.
 */
type Action.Spy.Lambda extends Action.Spy.Claim type key 'LAMBDA' {

  /**
   * Lambda that is called on completion of a call to target C3 Action.
   */
  spy: lambda(spy: !Action.Spy, action: !Action)

  checkClaim: ~ from Action.Spy.Claim
}
