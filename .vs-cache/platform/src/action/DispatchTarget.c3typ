/**
 * This type can be used to change the behavior of Action Dispatching. Types that mix {@link DispatchTarget} can
 * override `target*Func`s methods to set the targets for all non-inline methods of type and their
 * subtypes.
 */
type DispatchTarget {

  /**
   * @return lambda to calculate target {@link Server server node} for this function call with provided arguments.
   *
   * Used internally for dispatching.
   *
   * @see MethodType#targetNodeFunc
   */
  targetNodeFunc: optional inline function(methodType: !MethodType): lambda(args: map<string, any>)
                                                                       : !string serialized Server.Id

  /**
   * @return lambda to calculate target {@link App.ThreadPool thread pool} for this function call with provided arguments.
   *
   * Used internally for dispatching.
   *
   * @see MethodType#targetThreadPoolFunc
   */
  targetThreadPoolFunc: optional inline function(methodType: !MethodType): lambda(args: map<string, any>)
                                                                             : !string serialized App.Node.ThreadPool
}
