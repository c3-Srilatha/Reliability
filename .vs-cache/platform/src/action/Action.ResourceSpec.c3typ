/**
 * The resources required for executing a C3 {@link Action}
 */
type Action.ResourceSpec mixes Spec {

  /**
   * The number of (possibly virtual) CPUs
   */
  cpuCount: int

  /**
   * The memory size in MB
   */
  memoryMb: int

  /**
   * The number of GPUs
   */
  gpuCount: int

  /**
   * The GPU memory size in MB
   */
  gpuMemoryMb: int

  /**
   * The disk size in GB
   */
  diskGb: int
}
