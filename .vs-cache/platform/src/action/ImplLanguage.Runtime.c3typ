/**
 * An ImplLanguage Runtime specifies a specific {@link ImplLanguage}, a version of the language, a list of
 * {@link ImplLanguage.Library}, a list of repositories from which to install libraries
 * (e.g. [conda-forge](https://conda-forge.org/)), and a list of parent Runtimes from which this child runtime inherits
 * all libraries and repositories.
 *
 * Some examples:
 * ```ndjson
 * py-scipy: {name: "py-scipy", language: "python", "languageVersion": "3.9", libraries: ["conda scipy==1.6.2"]}
 * js-eslint: {name: "js-eslint", language: "JavaScript",  libraries: ["npm @eslint"]} (MyType.js + MyType.eslint.js)
 * ```
 */
inline type ImplLanguage.Runtime mixes ImplLanguage.RuntimeBase, ImplLanguage.WithLibraries<ImplLanguage.Library> {

  /**
   * Name of this language runtime; note that it is expected for name to start with implementation language
   * {@link ImplLanguage#dslName abbreviation). Other elements may be used following the language for custom runtimes.
   *
   * For example, the "js-browser" runtime has:
   *  - language: JavaScript
   *  - location: BROWSER
   *  - version: ES2015
   *
   * If type Foo wishes to have a custom implementation for this runtime, it is defined in `Foo.browser.js` instead of
   * or in addition to `Foo.js`.
   */
  name: ~

  forName: cached ~

  @merge(MERGE)
  libraries: ~

  /**
   * @return The suffix for the runtime. E.g. for "py-foo", suffix will be "foo".
   */
  suffix: cached member function(): string

  /**
   * @return true if the runtime is a custom runtime i.e. if the runtime's {@link suffix} is any value beyond null
   */
  isCustom: member function(): !boolean

  /**
   * List of parent runtimes for this runtime.
   */
  @merge(MERGE)
  parents: [string serialized ImplLanguage.Runtime]

  /**
   * @return an indexed set of all ancestors of a runtime (parents, parents of parents, and so on).
   */
  ancestors: cached member function(): @indexed set<ImplLanguage.Runtime>

  /**
   * @return set of all descendants of a runtime (children, children of children, and so on).
   */
  descendants: cached member function(): set<ImplLanguage.Runtime>

  /**
   * @return true if this runtime is a descendant of the specified runtime.
   */
  isDescendantOf: cached member function(runtime: ImplLanguage.Runtime): !boolean

  /**
   * @return an array of language versions supported for the {@link ImplLanguage.Runtime}
   */
  languageVersions: private cached property(): [string]

  /**
   * All additional libraries that are required for testing this runtime (but not executing in production)
   * Note:
   *    - For Python runtimes, `pytest` will always be installed for testing and therefore does not need to be
   *      declared here.
   */
  // TODO PLAT-50567 remove this field
  testLibraries: [ImplLanguage.Library]

  /**
   * @return `true` if underling language supports overloaded function
   */
  supportsOverloads: member function(): boolean

  /**
   * @return name of this language runtime as used in method declaration
   */
  dslName: cached member function(): !string

  /**
   * @return C3 type system implementation language runtime by dsl syntax as used in method declaration
   */
  forDslName: cached function(dsl: !?string, failIfMissing: boolean): ImplLanguage.Runtime

  /**
   * Return true if this runtime satisfies all requirements of the specified runtime. The languages must match
   * and any hardware or library requirements must be met.
   *
   * @param runtime an actual runtime
   */
  canRun: cached member function(runtime: !ImplLanguage.Runtime): boolean

  /**
   * Finds minimal common descendent {@link ImplLanguage.Runtime} for `runtimes`.
   *
   * @return runtime that {@link #canRun} `runtimes` or `null` if no such runtime exists.
   */
  minimumCommonDescendent: function(runtimes: !string serialized ImplLanguage.Runtime ...): !?ImplLanguage.Runtime

  /**
   * Finds minimal common descendent {@link ImplLanguage.Runtime} for `runtimes`, that is executable in a specified location, executor, and test mode (with or without `-test`).
   *
   * @return runtime that {@link #canRun} `runtimes` or `null` if no such runtime exists.
   */
  minimumCommonDescendent: function(location: !string enum ImplLanguage.RuntimeLocation,
                                    executor: !string enum ImplLanguage.Executor,
                                    isTest: !boolean,
                                    runtimes: !string serialized ImplLanguage.Runtime ...): !?ImplLanguage.Runtime

  /**
   * @return true if this is an instance of `java` implementation language runtime
   */
  isJava: cached member function(): !boolean

  fromString: ~
  toString:   ~

  /**
   * Regular expression that validates the runtime suffix. e.g. "py-ml"
   */
  regexPattern: private cached function(): !string

  /**
   * Regular expression that matches the runtime with language version. e.g. "py.3.10-ml"
   */
  regexPatternWithLangVersion: private cached function(): !string

  /**
   * Takes a runtime name as input and returns true if the name is a valid runtime name else false.
   */
  validateName: private cached function(name: !string): boolean

  /**
   * All libraries required to execute {@link Action}s in this runtime including those of parent runtimes.
   * Note that if multiple Libraries in this list ultimately provide for the same
   * `Library`, then the resolution will satisfy all specified library versions if possible, or fail otherwise
   * For example, one Library may specify `>=0.10` and another `==0.12` (since `==0.12` can satisfy both of
   * those requirements).
   * On the other hand, if one Library specifies `>=0.10`, a second may not specify `==0.9` since that cannot be
   * resolved.
   */
  allLibraries: cached property(): [ImplLanguage.Library]

  /**
   * @return a list of all repositories including those of parent runtimes.
   */
  allRepositories: cached property(): [string]

  /**
   * Sorts runtimes such that ancestor runtimes always come before runtimes which
   * {@link ImplLanguage.Runtime#isDescendantOf are a descendant of} those ancestors. This is useful in the context of
   * upserting runtimes, where parent runtimes must be upserted prior to child runtimes.
   */
  sortRuntimes: function(runtimes: ![ImplLanguage.Runtime]): ![ImplLanguage.Runtime]

  /**
   * @return whether this runtime defines library requirements for all resolved runtimes of a particular language and
   *   location. If true, this runtime will not be resolved when upserted via {@link ImplLanguage#upsertRuntime}.
   *   These runtimes are currently identified via naming convention `"{lang name}-{location name}_location"`:
   *   `"py-client_location"`
   *   `"js-server_location"`
   *
   * @see Action.Engine#runtimeForLocation
   */
  isLangLocationRuntime: private member function(): !boolean

  /**
   * @return whether this runtime defines library requirements for all resolved runtimes of a particular language and
   *   executor. If true, this runtime will not be resolved when upserted via {@link ImplLanguage#upsertRuntime}. These
   *   runtimes are currently identified via naming convention `"{lang name}-{executor name}_executor"`:
   *   `"py-py4j_executor"`
   *   `"js-node_executor"`
   *
   * @see Action.Engine#runtimeForExecutor
   */
  isLangExecutorRuntime: private member function(): !boolean

  /**
   * @return whether this runtime defines library requirements for all resolved runtimes of a particular language for
   *   testing. If true, this runtime will not be resolved when upserted via {@link ImplLanguage#upsertRuntime}. These
   *   runtimes are currently identified via naming convention `"{lang name}-testing"`:
   *   `"py-testing"`
   *
   * @see Action.Engine#runtimeForTester
   */
  isLangTestingRuntime: private member function(): !boolean

  /**
   * @return whether this runtime {@link isLangLocationRuntime}, {@link isLangExecutorRuntime}, or
   *   {@link isLangTestingRuntime}.
   */
  isSystemRuntime: private member function(): !boolean

  /**
   * @return {@link ImplLanguage.ResolvedRuntime}s corresponding to this ImplLanguage.Runtime.
   */
  resolvedRuntimes: private member function(): [ImplLanguage.ResolvedRuntime]

  compatibleWithLanguageVersion: private cached member function(version: !string): boolean

  /**
   * @return All libraries in this runtime including those of parent runtimes.
   */
  listLibraries: private member function(): [ImplLanguage.Library]

  /**
   * @param engineRuntimeName The name of the runtime used by the action engine
   * @param executor The executor that will run the engine runtime
   * @param targetRuntimeName The name of the runtime that needs to be run (from Action.Requirement)
   * @param languageVersion The language version of the action engine
   * @return true if the engine runtime can run the target runtime via the executor
   */
  canRunForExecutor: private function(engineRuntimeName: !string,
                                      executor: !string enum ImplLanguage.Executor,
                                      targetRuntimeName: !string,
                                      languageVersion: !string): !boolean
}
