/**
 * Specification for where as action should be executed.
 */
type ActionTargetSpec mixes App.NodePoolAware, TimeoutSpec {

  /**
   * If `true` then best effort will be made to execute this action on a worker node.
   */
  worker: boolean

  /**
   * If `true` then best effort will be made to execute this action on a master node.
   */
  master: boolean

  /**
   * If the server node is set then action will be sent to this node. If node is down action will fail.
   */
  node: string

  /**
   * @return candidate server node based on this spec.
   */
  @action(group+='cluster-admin')
  candidateNode: private member function(): !ServerNode
}
