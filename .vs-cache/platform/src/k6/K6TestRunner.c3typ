/**
 * This type allows developers to run k6 scripts for the purpose of performance load testing.
 * You can invoke this through {@link K6Tester} which will run any k6 scripts located in the
 * test/js-k6-server-node/** file path, or you can use this type directly to run your k6 scripts
 * for external use.
 */
@beta
type K6TestRunner {

  _statusCheckSuccessful: private const string = '✓ status is 200'
  _contentCorrectCheck:   private const string = '✓ content is correct'

  /**
   * Runs a k6 script and returns the contents of a k6 run. Pass in authToken and endpoint
   * if you want to authenticate against an external server, otherwise this script will run
   * against the current application it is run in through {@link K6TestRunner#runTestSuiteCode}.
   */
  @action(authz='always', group='developer')
  runK6Script: function(script: !string, authToken: string, endpoint: string): string js-server

  /**
   * Runs the k6 script and reports the metrics through {@link Microbench#measureKpi}.
   */
  @action(authz='always', group='developer')
  reportK6Kpi: function(script: !string, authToken: string, endpoint: string): string js-server
}
