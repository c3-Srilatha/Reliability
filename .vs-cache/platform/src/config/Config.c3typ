/**
 * Base type for all configurations.
 *
 * For quick reference guide scroll to the bottom of this chapter, but it is recommended to get familiar with nuances
 * of how config framework works in C3 AI Platform. See the topic, "Overview of C3 AI Configuration Framework"
 * (config-framework.c3doc.md).
 *
 * Different configurations can be classified in following buckets:
 *
 * * `Singleton` configuration - only one instance exists regardless of the context - for example, `DevEnvironmentConfig`
 *
 * * `Sub Type` configuration - an instance of a configuration exists per sub-type of this Config - typically none of
 *   the sub-types would be abstract but if one is then while it would not have a configuration instance other methods
 *   do still make sense. Note that this is not the same as `Singleton` - a type that is configured may not be a
 *   `Singleton` - for example, `KvStoreConfig`
 *
 * * `UserSingleton` configuration - a single instance per user - for example, `JupyterConfig`
 *
 * * `Identified` configuration - configured by `id` of what it is for - for example, `ServerConfig`
 *
 * * `Named` configuration - configured by `name` of what it is for - for example, `DatastoreConfig`
 *
 * * _--- custom ---_ - configured by custom logic - for example, `CloudResource`
 *
 * #isSingleInstance and #hasSubTypes methods can be used to identify specific kind of the Config type and
 * #listConfigKeys can be used for all existing configurations.
 *
 * Additionally, configuration instances are hierarchical. The final configuration is determined by merging instances
 * starting from `seed configuration` and following order defined by {@see ConfigOverride} enum.
 *
 * When merging configuration by default fields defined by more specific configuration replace ones defined by more
 * generic ones. However, Ann.Config#merge annotation can alter this behavior.
 *
 * Optional minimum and maximum configuration override levels are set per configuration type using
 * Ann.Config#minOverride and Ann.Config#maxOverride.
 *
 * Optional seed configuration can be authored as part of the application package under metadata path:
 * `<repo>/<pkg>/config/<config folder>/<config key>.json`.
 *
 * Config Folder name by default is configuration type name; however, it can be overridden using Ann.Config#folder.
 * See also #configFolder method.
 *
 * Config Key is determined by configuration kind as outlined above. That is, it is configuration type name in case of
 * `Singleton` and `Sub Type` configuration or `id` or `name` field values in case of `Identifiable` and `Nameable`.
 * See also #configKey method.
 *
 * Note that there is a reserved config key '_' which if present will be used as the bases of all other configuration values.
 * That is, if `_.json` config exists then it will be loaded first and then `<config key>.json` will be merged into it.
 *
 * Finally, configuration file content is actually a json {@link Template}. Merging of json templates based on rules
 * described above happens before formatting it and binding variables as defined by #templateBindings.
 *
 * Note that if configuration contains nested structure those types need to mixin ConfigChild.
 *
 * *Quick reference guide*: since recommended pattern is to use {@link Configurable} Type instead low level
 * {@link Config} examples below assume `myConfigurable` is an instance of `{@link Configurable}`.
 *
 * * Get a configuration or secret value:
 *   ```
 *   myConfigurable.config().configValue('path.to.my.value');
 *   myConfigurable.config().configValue('path.to.my.value', true);
 *   myConfigurable.config().configValue('arry[17].field');
 *   myConfigurable.config().secretValue('map['key'].field');
 *   myConfigurable.config().secretValue('arryWithUniqueId['<id value>'].field');
 *   myConfigurable.config().secretValue('arryWithUniqueName['<name value>'].field');
 *   ```
 *
 * * Set a configuration or secret value:
 *   ```
 *   myConfigurable.config().setConfigValue('path.to.my.value', '<my value>');
 *   myConfigurable.config().setSecretValue('path.to.my.value', '<my value>', ConfigOverride.CLUSTER);
 *   ```
 *
 * If you really think you need to use {@link Config} Type directly, then replace `myConfigurable.config()` with one of:
 *  - `MyConfig.inst`
 *  - `MyConfig.forId`
 *  - `MyConfig.forName`
 * based of the kind of MyConfig.
 *
 *
 * @see Configurable
 * @see ConfigChild
 *
 * @see Spec
 * @see SeedData
 * @see Metadata
 */
abstract type Config mixes Cached {

  /**
   * Return cached instance of configuration. For Identifiable configurations `id` field is required. For Nameable
   * configurations `name` field is required.
   *
   * Note that typical pattern is to use Configurable#config instead of this method.
   */
  getConfig: inline member function(): !mixing Config

  /**
   * @return cached config value for the provided field path if set or `null` or error otherwise depending on
   *         `failIfMissing`; note that will not return secret value.
   */
  configValue: inline member function(path: !string, failIfMissing: boolean): any

  /**
   * Return cached instance of configuration containing only secret values. For Identifiable configuration, `id` field
   * is required. For Nameable configurations `name` field is required.
   *
   * Note that typical pattern is to use Configurable#configWithSecrets instead of this method.
   */
  getSecret: member function(): !mixing Config

  /**
   * @return cached secret value for the provided field path in this Config object or `null` if not set or error
   *         depending on `failIfMissing`.
   */
  secretValue: member function(path: !string, failIfMissing: boolean): any

  /**
   * Reads and url decodes the content at the path.
   * Path must represent a string value.
   */
  decodedValue: private member function(path: !string, failIfMissing: boolean): string

  /**
   * @return `true` if this configuration instance was set at ConfigOverride.USER level.
   */
  isUserOverride: inline member function(): boolean

  /**
   * @return `true` if this configuration instance was set at ConfigOverride.APP level.
   */
  isAppOverride: inline member function(): boolean

  /**
   * @return `true` if this configuration instance was set at ConfigOverride.CLUSTER level.
   */
  isClusterOverride: inline member function(): boolean

  /**
   * @return `true` if this configuration instance was set at ConfigOverride.ENV level.
   */
  isEnvOverride: inline member function(): boolean

  /**
   * @return `true` if this configuration instance was set at ConfigOverride.ROOT level.
   */
  isRootOverride: inline member function(): boolean

  /**
   * @return `true` if this configuration has not been set and comes from seed / defaults.
   */
  isSeed: inline member function(): boolean

  /**
   * @return `true` if provided path is a secret.
   */
  isSecret: inline function(path: !string): boolean

  /**
   *  @return config key for this instance. The config key is a unique identifier for an instance of a config type.
   *  The config key varies based on whether the config is defined with:
   *     1. {@link Ann.Config#subfolder}
   *         In this case, the name of the subfolder will be included.
   *     2. {@link Ann.Config#minOverride} set to {@link ConfigOverride#USER}
   *         In this case, the ID of the {@link User} will be included.
   *     3. mixes in {@link Named} or {@link Identified}
   * In this case, the name or id of the config will be included. If the config does not mix Named or Identified,
   * the name of the config subtype will be used.
   *
   *  The config key includes the above three fields delimited by '/':
   *     {subfolder name if applicable}/{user ID if applicable}/{id or name or type name}
   *  ```
   *  | USER min Override | Identified or Named | Subfolder defined |      Example Config Key     |
   *  |-------------------|---------------------|-------------------|-----------------------------|
   *  |       no          |         no          |        no         |           MyConfType        |
   *  |       yes         |         no          |        no         |       myUserId/MyConfType   |
   *  |       no          |         yes         |        no         |             abc             |
   *  |       no          |         no          |        yes        |      folder1/MyConfType     |
   *  |       no          |         yes         |        yes        |          folder1/abc        |
   *  |       yes         |         yes         |        no         |          myUserId/abc       |
   *  |       yes         |         no          |        yes        | folder1/myUserId/MyConfType |
   *  |       yes         |         yes         |        yes        |     folder1/myUserId/abc    |
   *  ```
   *  Note that the config key is a computed value and is not set-able.
   *  For config subtypes that mixin both {@link Identifiable} and {@link Nameable}, the ID will be used as part of the key.
   */
  configKey: inline member function(): string

  /**
   * @return return cached config instance for provided config key.
   */
  forConfigKey: inline function(configKey: !?string): mixing Config

  /**
   * @return stream of all available Config keys for this type; #forConfigKey can be used to look up Config instance.
   */
  listConfigKeys: function(): stream<string>

  /**
   * @param
   *
   * @return stream of all available Config instances for this type.
   */
  listConfigs: function(parallel: boolean, filter: lambda(key: !string): boolean): stream<mixing Config>

  /**
   * @return all config template values by override.
   */
  allConfigValueOverrides: member function(path: !string): map<string, json>

  /**
   * @return all config template jsons by override.
   */
  allConfigOverrides: member function(): map<string, json>

  /**
   * @return all secret template values by override.
   */
  @action(authz='always')
  allSecretValueOverrides: member function(path: !string): map<string, json>

  /**
   * @return all secret templates by override.
   */
  @action(authz='always')
  allSecretOverrides: member function(): map<string, json>

  /**
   * Sets configuration field value at provided path in this Config object. Note will not set secret value.
   * If `embeddedFileName` parameter is provided, then config value will be stored in a separate embedded file.
   * @see clearConfigValue
   */
  @action(authz='always')
  setConfigValue: member function(path: !string,
                                  value: !?any,
                                  override: string enum ConfigOverride,
                                  embeddedFileName: string)

  /**
   * Sets multiple field values to those specified in the map. The map keys are the paths.
   * @see setConfigValue
   */
  @action(authz='always')
  setConfigValues: member function(from: !map<!string, any>, override: string enum ConfigOverride)

  /**
   * Sets multiple field values to be the same as the passed instance.
   * @see setConfigValue
   */
  @action(authz='always')
  setConfigValues: member function(from: !mixing Config, override: string enum ConfigOverride)

  /**
   * Sets configuration field value template at provided path in this Config object. Note will not set secret value.
   * If `embeddedFileName` parameter is provided, then config value will be stored in a separate embedded file.
   * @see clearConfigValue
   */
  @action(authz='always')
  setConfigValueTemplate: member function(path: !string,
                                          valueTemplate: !?string,
                                          override: string enum ConfigOverride)

  /**
   * Adds a single value at the specified index in a collection at provided path in this Config object.
   * Note this will merge based on the {@link Ann.Merge} collection value for the field.
   */
  insertConfigElementAt: member function(pathToCollectionField: !string,
                                         index: !int,
                                         value: !?any,
                                         override: string enum ConfigOverride)

  /**
   * Sets a single value at the specified index in a collection at provided path in this Config object.
   * Note this will merge based on the {@link Ann.Merge} collection value for the field.
   */
  setConfigElementAt: member function(pathToCollectionField: !string,
                                      index: !int,
                                      value: !?any,
                                      override: string enum ConfigOverride)

  /**
   * Adds a single value to a collection at provided path in this Config object.
   * Note this will merge based on the {@link Ann.Merge} collection value for the field.
   */
  addConfigElement: member function(pathToCollectionField: !string,
                                    value: !?any,
                                    override: string enum ConfigOverride)

  /**
   * Sets a key-value pair in specified map at provided path in this Config object.
   * Note this will merge based on the {@link Ann.Merge} collection value for the field.
   */
  setConfigMapValue: member function(pathToMapField: !string,
                                     key: !any,
                                     value: !?any,
                                     override: string enum ConfigOverride)

  /**
   * Removes a single value at the specified index in a collection at provided path in this Config object.
   * Note this will merge based on the {@link Ann.Merge} collection value for the field.
   */
  removeConfigElementAt: member function(pathToCollectionField: !string,
                                         index: !int,
                                         override: string enum ConfigOverride)

  /**
   * Removes a single value in a collection at provided path in this Config object.
   * Note this will merge based on the {@link Ann.Merge} collection value for the field.
   */
  removeConfigElement: member function(pathToCollectionField: !string,
                                       value: !?any,
                                       override: string enum ConfigOverride)

  /**
   * Removes a single key in a map at provided path in this Config object.
   * Note this will merge based on the {@link Ann.Merge} collection value for the field.
   */
  removeConfigMapKey: member function(pathToMapField: !string, key: !any, override: string enum ConfigOverride)

  /**
   * Url encodes the content at the path and returns new config object with the encoded value.
   * Path must represent a string value.
   */
  setEncodedValue: private member function(path: !string, value: !string, override: !string enum ConfigOverride)

  /**
   * Sets secret field value or secrets within value at provided path in this Config object.
   * @see clearSecretValue
   */
  @action(authz='always')
  setSecretValue: member function(path: !string,
                                  value: @value(secret=true) !?any,
                                  override: string enum ConfigOverride)

  /**
   * Sets multiple secret field values to those specified in the map. The map keys are the paths.
   * @see setSecretValue
   */
  @action(authz='always')
  setSecretValues: member function(from: !map<!string, any>, override: string enum ConfigOverride)

  /**
   * Sets multiple secret field values to be the same as the passed instance.
   * @see setSecretValue
   */
  @action(authz='always')
  setSecretValues: member function(from: !mixing Config, override: string enum ConfigOverride)

  /**
   * Sets secret field value template at provided path in this Config object.
   * @see clearSecretValue
   */
  @action(authz='always')
  setSecretValueTemplate: member function(path: !string,
                                          value: @value(secret=true) !?string,
                                          override: string enum ConfigOverride)

  /**
   * Clears configuration field value at provided path in this Config object at provided override level. Note will not
   * clear secret value.
   */
  @action(authz='always')
  clearConfigValue: member function(path: !string, override: string enum ConfigOverride)

  /**
   * Clears secret field value at provided path in this Config object at provided override level.
   */
  @action(authz='always')
  clearSecretValue: member function(path: !string, override: string enum ConfigOverride)

  /**
   * Clears configuration field value at provided path in this Config object at all override levels. Note will not
   * clear secret value.
   */
  @action(authz='always', group='cluster-admin')
  clearConfigValueAllOverrides: member function(path: !string)

  /**
   * Clears secret field value at provided path in this Config object at all override levels.
   */
  @action(authz='always', group='cluster-admin')
  clearSecretValueAllOverrides: member function(path: !string)

  /**
   * @return config or secret value for the provided config key, field path, and override if set
   */
  @action(authz='always')
  rawConfigOrSecretValue: function(configKey: !string,
                                   path: !string,
                                   override: string enum ConfigOverride,
                                   failIfMissing: boolean): json

  /**
   * Sets config or secret value for the provided config key, field path and override.
   */
  @action(authz='always')
  @deprecated(finalVersion='8.5', details='Use setConfigAndSecretValue instead')
  setConfigOrSecretValue: function(configKey: !string,
                                   path: !string,
                                   value: @value(secret=true) any,
                                   override: string enum ConfigOverride)

  /**
   * Sets config and secret value for the provided config key, field path and override. Equivalent to calling both
   * setConfigValue and setSecretValue
   */
  @action(authz='always')
  setConfigAndSecretValue: function(configKey: !string,
                                    path: !string,
                                    value: @value(secret=true) any,
                                    override: string enum ConfigOverride)

  /**
   * Sets config or secret value template for the provided config key, field path and override.
   */
  @action(authz='always')
  setConfigOrSecretValueTemplate: function(configKey: !string,
                                           path: !string,
                                           valueTemplate: @value(secret=true) string,
                                           override: string enum ConfigOverride)

  /**
   * @return `true` if this Config type has other sub types.
   */
  hasSubTypes: inline function(): boolean

  /**
   * @return true if this Config type has Ann.Config#secret annotation on the Config type of child config types
   */
  hasSecretField: cached inline function(): boolean

  /**
   * @return `true` if this Config type has only one instance.
   */
  isSingleInstance: inline function(): boolean

  /**
   * @returns `true` if this Config is user override-able.
   */
  isUserOverridable: inline function(): boolean

  /**
   * @return default configuration override level
   */
  dfltOverride: inline function(override: string enum ConfigOverride): !string enum ConfigOverride

  /**
   *  Loads config and secret by key if exists, default config, or `null` if `doNotDefaultIfMissing` config annotation is
   * true and config does not exist.
   *  Note that this skips caching and directly fetches config from the config store, and secret from vault.
   */
  @action(authz='always', group='cluster-admin')
  loadConfigAndSecret: private inline function(configKey: !string): mixing Config

  /**
   * Loads config override template json if exists or `null`. Will not include secrets.
   * Note that this skips caching and directly fetches config from the config store.
   */
  loadConfigOverride: private member function(override: !string enum ConfigOverride): json

  /**
   * Loads secret override template json if exists or `null`. Will not include non secrets.
   * Note that this skips caching and directly fetches secret from the vault.
   */
  @action(authz='always')
  loadSecretOverride: private member function(override: !string enum ConfigOverride): json

  /**
   * @return file for an embedded config value.
   */
  embeddedFile: private member function(embeddedFileName: !string, override: string enum ConfigOverride): !File

  /**
   * @return config folder name
   */
  configFolder: private final inline function(): !string

  /**
   * @return config sub folder name for this type
   */
  configSubFolder: private final inline function(): !string

  /**
   * @return config file encoded path for a given key and potentially user under the config dir for this type.
   */
  configFileEncodedPath: private final inline function(configKey: !string, userOverride: boolean): !string

  /**
   * @return pair of config and secret files for a given override; note that will always return instance of
   *         File even if physical file doesn't exist.
   */
  configAndSecretFiles: private member function(override: !string enum ConfigOverride): Pair<File, File>

  /**
   * @return the config file path for a config instance at a given override;
   */
  configFilePath: private member function(override: !string enum ConfigOverride): string

  /**
   * @return the secret file path for a config instance at a given override;
   */
  secretFilePath: private member function(override: !string enum ConfigOverride): string

  /**
   * @return pair of config and secret files for provided override / appId; note that will always return pair
   *         of Files even if physical file doesn't exist.
   */
  configAndSecretFilePair: private member function(override: !string enum ConfigOverride,
                                                   appId: !string): Pair<File, File>

  /**
   * @return map of pair of config and secret files by override; note that will always return instance of
   *         File even if physical file doesn't exist.
   */
  allConfigAndSecretFiles: private member function(): map<string, Pair<File, File>>

  /**
   * @return pair of config and secret template directories for override
   */
  configAndSecretDirs: private function(override: string enum ConfigOverride): Pair<File, File>

  /**
   * @return map of pair of config and secret template directories by override; note that will always return instance of
   *         File even if physical folder doesn't exist.
   */
  allConfigAndSecretDirs: private function(): map<string, Pair<File, File>>

  /**
   * @return pair of config and secret Base directories for the given override
   */
  configAndSecretOverrideBaseDirs: private function(override: string enum ConfigOverride): Pair<File, File>

  /**
   * @return config key for a given config or secret file. If file is not a valid config or secret then will return
   *         `null` or fail based on `failIfInvalid`
   */
  configKeyForFile: private inline function(file: !?File, failIfInvalid: boolean): string

  /**
   * @return config key for a given config or secret file url. If file is not a valid config or secret then will return
   *         `null` or fail based on `failIfInvalid`
   */
  configKeyForFileUrl: private cached inline function(fileUrl: !?string): string

  /**
   * @return Config sub-type for a config directory name.
   */
  configTypeForDir: private function(dir: !string, failIdInvalid: boolean): Type

  /**
   * Sets configuration. For Identifiable configurations `id` field is required. Does not set secret values. Use
   * #setSecret or #setSecretValue for that.
   */
  @action(authz='always')
  setConfig: private member function(override: string enum ConfigOverride)

  /**
   * Sets configuration. For Identifiable configurations `id` field is required. Does not set non secret values. Use
   * #setConfigValue or #setConfig for that.
   */
  @action(authz='always')
  setSecret: private member function(override: string enum ConfigOverride)

  /**
   * Executes actions on all config override levels (within a valid range) for a particular instance of config.
   */
  eachOverride: inline member function(action: lambda(config: !Config, override: !string enum ConfigOverride))

  /**
   * Executes actions on all config override levels (within a valid range) for the Type itself (not instance).
   */
  eachOverrideOnType: inline function(action: lambda(override: !string enum ConfigOverride))

  /**
   * Minimum configuration override level. Default is {@link ConfigOverride#APP}.
   */
  // TODO PLAT-131773 use defaults correctly
  minOverride: inline function(): !string enum ConfigOverride

  /**
   * Maximum configuration override level. Default is {@link ConfigOverride#ROOT}.
   */
  // TODO PLAT-131773 use defaults correctly
  maxOverride: inline function(): !string enum ConfigOverride

  /**
   * Clears specified configuration override including secrets for this instance.
   *
   * @param override
   *        Specifies the {@link ConfigOverride} level, of this config to clear.
   */
  @action(authz='always')
  clearConfigAndSecretOverride: private member function(override: !string enum ConfigOverride)

  /**
   * Clears specified configuration including secrets for this instance on all override levels.
   */
  @action(authz='always', group='cluster-admin')
  clearConfigAndSecretAllOverrides: private member function()

  /**
   * Clears every config and secret instance for this type and subtypes on all overrides lower than the specified
   * override (that is, Config#clearAllConfigAndSecretOverrides with App override parameter will clear all configs on
   * {@link ConfigOverride#APP} and {@link ConfigOverride#USER} level).
   *
   * @param override
   *        Specifies the {@link ConfigOverride} level of this config to clear. All overrides lower than this override
   *        will also be cleared.
   * @param confirm
   *        Confirmation from user that they understand and confirm deletion of this configuration.
   */
  @action(authz='always')
  clearAllConfigAndSecretOverrides: private function(override: !string enum ConfigOverride, confirm: boolean)

  /**
   * returns a list of all field paths that are secret
   */
  secretFieldPaths: private cached function(): [FieldPath]

  /**
   * @return this config without any secret values.
   */
  removeSecrets: private inline member function(): mixing Config

  /**
   * @return this config with only secret values.
   */
  removeNonSecrets: private inline member function(): mixing Config

  /**
   * Validates and alters fields in the configuration to fit specific requirements. sub-types can override to add custom
   * validation and setup.
   */
  validate: private inline member function(): !mixing Config

  /**
   * @return The cached and merged JSON of all defined configuration templates for this instance, including secrets.
   */
  @action(authz='always', group='cluster-admin')
  rawJson: private function(configKey: !?string): json

  /**
   * @return sets Json template for a specified override.
   */
  @action(authz='always')
  setJson: private function(configKey: !string,
                            json: !?json,
                            secret: boolean,
                            override: string enum ConfigOverride): !File

  /**
   * @return sets Json template field for a specified override.
   */
  @action(authz='always')
  setJsonValue: private function(configKey: !string,
                                 field: !string,
                                 json: !?json,
                                 override: string enum ConfigOverride): !File

  /**
   * @return sets Json template field for a specified override.
   */
  @deprecated(finalVersion="8.5", description="use Config#setJsonValue instead")
  @action(authz='always')
  setJsonField: private function(configKey: !string,
                                 field: !string,
                                 json: !?json,
                                 secret: boolean,
                                 override: string enum ConfigOverride): !File

  /**
   * Returns json containing configuration template bindings for a provided config key. Override this method to provide your
   * own list of template bindings
   */
  @action(authz='always')
  templateBindings: private function(configKey: !?string): json

  /**
   * Evaluate a given template by applying the default config bindings.
   * Default config bindings are:
   * 1. owner - owner of the config
   * 2. region - abbreviated region in which the cluster is
   * 3. cluster - current cluster id
   * 4. env - current env id
   * 5. app - current app id
   * 7. user - current user
   * 8. type - type on which this api is called
   * For example, "${owner}--${cluster}-${env}-${app}"
   *
   * @param template
   *            Template string that needs to be evaluated. For example, "${owner}--${cluster}-${env}-${app}-${schemaName}"
   * @param extraBindings
   *            Any additional binding params not included in the default config bindings
   * @return evaluated template
   */
  evalTemplate: function(template: !string, extraBindings: map<string, string>): !string

  /**
   * Returns count of cached raw Json.
   */
  rawJsonCacheSize: private inline function(): int

  /**
   * Returns instance of the cache for this type for raw Json.
   */
  rawJsonNativeCache: private inline function(): @java(class='c3.platform.cache.Cache') native

  configOverride: string enum ConfigOverride
  secretOverride: string enum ConfigOverride

  @action(authz='always', group='cluster-admin')
  getCached: private ~

  /**
   * Returns cached instance by key, with secrets removed.
   */
  @action(authz='always')
  forCacheKey: private final ~

  cacheKey: private final ~

  @action(authz='always', group='cluster-admin')
  produceAll: private ~

  @action(authz='always', group='cluster-admin')
  produce: private ~

  evictFromCache: private ~
  clearCache:     private ~

  /**
   * Captures any issues that occurred while deserializing from filesystem
   */
  @ser(hidden=true)
  issues: [string]
}
