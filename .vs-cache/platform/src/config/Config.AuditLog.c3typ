/**
 * Config.AuditLog is used to track each change to {@link Config}s. Each Config.AuditLog contains information about the
 * config, the changes, and the context of the operation (user, app, action, etc).
 */
// TODO: PLAT-102819 remove private @beta from Config.AuditLog c3typ
@db(datastore="fs-configAudit", partitionKeyField='auditLogKey')
@action(group='cluster-admin')
@beta
private entity type Config.AuditLog mixes Partitionable<string> {

  /**
   * partition key of the Config.AuditLog. configType + configKey
   */
  auditLogKey: !string

  /**
   * Type#name of the config being set
   */
  configType: !string serialized Type

  /**
   * The {@link ConfigOverride} of the config
   */
  configOverride: !string enum ConfigOverride

  /**
   * The {@link Config#configKey} of the config
   */
  configKey: !string

  /**
   * The id of the {@link App} on which the config action is being performed
   */
  appId: !string

  /**
   * The json of the root {@link Action} being performed
   */
  rootActionJson: !json

  /**
   * The config action being performed, e.g. "setConfig", "setSecretValue", "clearConfigValue"
   */
  configAction: !string

  /**
   * Whether the config action perform was for secrets
   */
  secret: boolean

  /**
   * The secret values should be securely hashed, so that they are not stored in plain text but it can still be known if the value has changed.
   */
  configJson: !json
}
