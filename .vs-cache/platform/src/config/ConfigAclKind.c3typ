/**
 * Type that represents the operations that can be performed on AclEnabled objects.
 */
enum type ConfigAclKind {

  /**
   * For read operations.
   */
  READ

  /**
   * For write / update operations.
   */
  WRITE

  /**
   * For ACL modifying operations.
   */
  MODIFY_ACL
}
