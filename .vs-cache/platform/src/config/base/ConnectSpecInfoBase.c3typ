/**
 * Base type for {@link ConnectSpecInfo}.
 */
abstract type ConnectSpecInfoBase mixes BasicCredentials {

  /**
   * The Url pointing to the database.
   */
  url: string

  /**
   * Server address: (ex: 'localhost', 'some.company.com')
   */
  serverEndpoint: string

  /**
   * Number of the listening port.
   */
  port: int
}
