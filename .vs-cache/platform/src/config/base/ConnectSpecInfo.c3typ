/**
 * Base type for holding connection info for connections
 */
abstract type ConnectSpecInfo mixes ConnectSpecInfoBase, Config, Identifiable {

  /**
   * Password of the user.
   */
  @action(authz='always')
  passwordSecret: inline member function(): string

  /**
   * Password of the user.
   */
  @action(authz='always')
  setPasswordSecret: member function(password: !?string)

  /**
   * Secret key of the user/account.
   */
  @action(authz='always')
  setSecretKey: member function(password: !?string)
}
