/**
 * Common base type for all child configuration types. It automatically maintains #parent field value.
 */
abstract type ConfigChild<P> {

  /**
   * Config type instance that contains this config child.
   */
  parent: private P

  /**
   * @return this child config without any secret values.
   */
  removeSecrets: private inline member function(): mixing ConfigChild

  /**
   * @return this child config with only secret values.
   */
  removeNonSecrets: private inline member function(): mixing ConfigChild

  /**
   * @return true if this ConfigChild type has Ann.Config#secret annotation
   */
  hasSecretField: cached inline function(): boolean
}
