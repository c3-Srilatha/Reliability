/**
 * Holds information about the boot configuration - "config of configs" - configuration for providing details where the
 * actual configuration lives
 */
@action(group='cluster-admin')
type BootConfig mixes Singleton {

  /**
   * Boot configuration for general configuration
   */
  config: !BootConfigInfo

  /**
   * Boot configuration for the vault
   */
  vault: !BootConfigInfo

  /**
   * Boot configuration for the Cluster C3 Env upon cluster installation
   */
  env: Env

  /**
   * Boot configuration for the Cluster C3 App upon cluster installation
   */
  app: App

  /**
   * Represents metadata for the cluster, providing configuration details
   * and properties that define the cluster's behavior and state.
   */
  clusterMetadata: ClusterMetadata = {}

  inst: ~
}
