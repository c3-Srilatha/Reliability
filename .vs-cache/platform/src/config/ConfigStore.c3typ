/**
 * Type representing store for config and secret content.
 */
@action(group+='cluster-admin')
private type ConfigStore {

  /**
   * The ID of the @{link User} the ConfigStore has context of.
   */
  userId: !string

  /**
   * The ID of the @{link App} the ConfigStore has context of.
   */
  appId: !AppId

  /**
   * The type of the @{link Config} object ConfigStore will read/write.
   */
  confType: !Type

  /**
   * @return ConfigStore with context initialized to the passed in parameters.
   */
  for: function(userId: !string, appId: !AppId, confType: !Type): ConfigStore

  /**
   * @return json representation of template binding information.
   */
  templateBindings: member function(): json

  /**
   * Reads from storage of config and merges all the overrides for the config of the provided key. Will read both secret
   * and non-secret values.
   *
   * @return json representation of the merged config.
   */
  loadConfigAndSecret: member function(key: !string): json

  /**
   * Reads storage of secret and merges all the overrides for the secret of the provided key.
   *
   * @return json representation of the merged secrets.
   */
  loadSecret: member function(key: !string): json

  /**
   * Reads storage of config and merges all the overrides for the config of the provided key.
   *
   * @return json representation of the merged config.
   */
  loadConfig: member function(key: !string): json

  /**
   * Reads from storage of config at the provided override level.
   * If secret is true, reads from vault, otherwise reads from default storage.
   *
   * @return json representation of the config.
   */
  loadFromOverride: member function(key: !string, override: !string, secret: !boolean): json

  /**
   * Writes to the storage the config json with the new value at the path to the provided override level.
   */
  setConfigValue: member function(key: !string,
                                  path: !string,
                                  value: !?any,
                                  override: !string enum ConfigOverride,
                                  secret: !boolean,
                                  clear: boolean)

  /**
   * Writes to the storage the config json specified by the value parameter to the provided override level.
   * All of the set config APIs in Config.c3typ should call this method.
   */
  setConfig: member function(key: !string, json: !?json, override: !string enum ConfigOverride, secret: !boolean)

  /**
   * Removes the content representing the config at the provided override.
   */
  clearConfig: member function(key: !string, override: !string enum ConfigOverride, secret: !boolean)

  /**
   * @return a pair of {@link Content}s for config and secret storage where the config of the provided key should be
   *         written to at the provided override.
   */
  // TODO:
  // configAndSecretContents: member function(key: !string, override: !string): Pair<Content, Content>
  configAndSecretFiles: member function(key: !string, override: !string): Pair<File, File>

  /**
   * Constructs pair of {@link Content}s for config and secret based on the parameter values of cluster, env, app, user
   * overrides and config key.
   *
   * @return a pair of {@link Content}s for a config and secret.
   */
  // TODO:
  // configAndSecretContents: member function(key: !string, cluster: !boolean, env: !boolean, app: !boolean, user: !boolean): Pair<Content, Content>
  configAndSecretFiles: member function(key: !string,
                                        cluster: !boolean,
                                        env: !boolean,
                                        app: !boolean,
                                        user: !boolean): Pair<File, File>
}
