/**
 * Enum for Config#setConfigValue.
 */
enum type ConfigOverride {

  USER

  APP

  ENV

  CLUSTER

  ROOT

  /**
   * @return next override or `null` if input is #ROOT.
   */
  next: inline function(configType: !Type, override: string enum ConfigOverride): string enum ConfigOverride

  /**
   * @return previous override or `null` if input is @config(override) of provided configType.
   */
  prev: inline function(configType: !Type, override: string enum ConfigOverride): string enum ConfigOverride

  /**
   * @return true if this override is higher than the other. E.g. #CLUSTER is higher than #APP.
   */
  higherThan: inline function(override: !string enum ConfigOverride, other: !string enum ConfigOverride): boolean
}
