/**
 * DO NOT create/upsert/update from this type.
 *
 * It is OK to remove entries from this type.
 */
@db(index=['job, actualTime'])
entity type JobHistory schema name 'CRON_HIST' {

  job: !CronJob

  /**
   * Number of times this instance of the job was run. Typically the value will be 1.
   *
   * If the value is > 1, a node executing the job died before the job was marked as completed and job was restarted
   *
   * on a different node
   */
  executionAttempts: !int

  /**
   * The time the job was scheduled to run
   */
  scheduledTime: !datetime

  /**
   * The actual time at which the job ran
   */
  actualTime: !datetime

  /**
   * Status will be SKIPPED if another instance of the job was ready to be triggered before this instance was restarted
   *
   * A job is restarted when the node executing the job dies.
   *
   * CANCELLED is not used at this time.
   */
  status: !string enum('COMPLETED', 'FAILED', 'SKIPPED', 'CANCELLED')

  /**
   * How long the action run
   */
  durationInMSecs: int

  /**
   * The result produced by the action, if any.
   *
   * result will be null if the action failed or if it did not produce any result
   *
   * If the result was an Arry or Mapp, it will be wrapped in a dynamic type and the field name will be value.
   */
  result: any

  /**
   * error will be set if the action failed.
   *
   * error is really C3Error, but due to a bug in the db engine?, this is declared as an Obj
   */
  @db(persistAllFields=true)
  error: Error

  versionEdits: ~ not persistable
}
