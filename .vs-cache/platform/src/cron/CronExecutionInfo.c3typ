type CronExecutionInfo {

  /**
   * Previous execution of the job
   */
  prevTriggerTime: datetime

  /**
   * Next schedule execution of the job
   */
  nextTriggerTime: datetime

  /**
   * Cron job
   */
  job: CronJob

  /**
   * The current status of the equivalent CronQueue entry.
   */
  currStatus: string

  /**
   * Various info about the last execution of the job
   */
  info: JobHistory
}
