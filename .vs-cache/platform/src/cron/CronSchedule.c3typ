type CronSchedule {

  /**
   * The date from which this schedule is effective
   *
   * If null, it is effective from the time of creation
   */
  startTime: datetime

  /**
   * The date till which this schedule is effective
   *
   * If null, it is effective till end of time
   */
  endTime: datetime

  /**
   * The schedule expression -- if null, the job will be triggered once
   *
   * Syntax for cron expressions -- [Quartz Tutorials - Lesson 6: CronTrigger](http://www.quartz-scheduler.org/documentation/quartz-2.3.0/tutorials/tutorial-lesson-06.html)
   */
  cronExpression: string

  /**
   * Time zone to use for any time of day based cron triggers.  Note that the queue entries will be shifted to GMT as
   * appropriate.
   *
   * @see TimeZone
   */
  timeZone: string serialized TimeZone

  /**
   * Only relevant when {@link CronJob.concurrent} is false.  If true, then upon completion of a job, the next trigger
   * time will be based on the current time.  If false, it will be based on the completed job's scheduled time.
   */
  skipOverdue: boolean

  /**
   * Validates a ChronSchedule.
   *
   * @param numExecutions
   *        The number of next executions times to return in the result.
   *
   * @return The result of the validation.
   */
  validate: member function(numExecutions: int = 5): CronValidation

  /**
   * Validates a cron expression.
   *
   * @param expr
   *        Cron expression to validate.
   *
   * @param numExecutions
   *        The number of next executions times to return in the result.
   *
   * @return The result of the validation.
   */
  validateExpr: function(expr: !string, numExecutions: int = 5): CronValidation

  /**
   * Generate a CronSchedule instance from the given cronExpression
   * @param cronExpression
   *        should be a cron expression @see #cronExpression for more details.
   * @return CronSchedule instance
   */
  fromString: function(cronExpr: !string): CronSchedule
}
