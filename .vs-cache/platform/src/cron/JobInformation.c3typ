@db(unique=['executionNumber'])
entity type JobInformation mixes SeedData<JobInformation> schema name 'CRON_JOBINFO' {

  modules:         ![string] schema name 'MOD'
  typeName:        !string
  checkMixin:      !boolean
  actionName:      !string
  executionNumber: !decimal
  retries:         int = 1
  versionEdits:    ~ not persistable
}
