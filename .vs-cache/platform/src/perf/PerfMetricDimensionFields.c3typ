type PerfMetricDimensionFields {

  /**
   * @return spec for current hardware and build.
   */
  forCurrentHardware: function(metric: !string): !PerfMetricDimension

  /**
   * The name of the performance metric.
   *
   * It should follow below format,
   *
   * {@link category} + . + {@link testSuite} + . + {@link testCase} + . + {@link shortName}
   */
  metric: string

  /**
   * The short name of the performance metric
   */
  shortName: string

  /**
   * The test case of the performance metric
   */
  testCase: string

  /**
   * The test suite of the performance metric
   */
  testSuite: string

  /**
   * Category of the performance metric
   */
  category: PerfMetricCategory

  /**
   * The hardware details of the machine that runs the performance metrics
   */
  instanceType: Hardware

  /**
   * The time when this server version is built
   */
  buildTime: datetime

  /**
   * The version of the server build
   */
  buildVersion: string

  /**
   * The build number from ci system
   */
  buildNumber: int

  /**
   * The version of the JVM used.
   */
  javaVersion: string

  /**
   * The GIT branch for the server build
   */
  gitBranch: string

  /**
   * The GIT commit id for the server build
   */
  gitRefSpec: string

  /**
   * The base GIT commit id for the server build verification
   */
  gitBaseRefSpec: string

  /**
   * clusterId of the cluster that runs the performance metrics
   */
  clusterId: string

  /**
   * The GIT branch for the apps build
   */
  appsGitBranch: string

  /**
   * The GIT commit id for the apps build
   */
  appsGitRefSpec: string

  /**
   * The repository version of the apps build
   */
  appsRepoVersion: string

  /**
   * The repository name of the apps build
   */
  appsRepoName: string
}
