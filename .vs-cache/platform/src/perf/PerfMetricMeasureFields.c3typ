type PerfMetricMeasureFields {

  /**
   * Elapsed time in seconds
   */
  time: double

  /**
   * CPU time in seconds
   */
  cpu: double

  /**
   * I/O time in seconds
   */
  io: double

  /**
   * Key and Value Store time in seconds
   */
  kv: double

  /**
   * SQL time in seconds
   */
  sql: double

  /**
   * File System time in seconds
   */
  fs: double

  /**
   * Retained memory
   */
  retainedMem: int

  /**
   * Total allocated (including freed) memory
   */
  allocatedMem: int

  /**
   * Number of total memory allocations (including memory that was freed)
   */
  memAllocations: int

  /**
   * Total garbage collection time (all generations) in seconds
   */
  gcTime: double

  /**
   * Old gen (Concurrent Mark/Sweep) garbage collection time in seconds
   */
  oldGenTime: double

  /**
   * Old gen usage percentage increase
   */
  oldGenPct: double

  /**
   * Elapsed time in seconds vs baseline
   */
  timeX: double

  /**
   * CPU time vs baseline
   */
  cpuX: double

  /**
   * I/O time vs baseline
   */
  ioX: double

  /**
   * Key and Value Store time vs baseline
   */
  kvX: double

  /**
   * SQL time vs baseline
   */
  sqlX: double

  /**
   * File System time vs baseline
   */
  fsX: double

  /**
   * Retained memory vs baseline
   */
  retainedMemX: double

  /**
   * Total allocated (including freed) memory vs baseline
   */
  allocatedMemX: double

  /**
   * Number of total memory allocations (including memory that was freed) vs baseline
   */
  memAllocationsX: double

  /**
   * Total garbage collection time (all generations) vs baseline
   */
  gcTimeX: double

  /**
   * Old gen (Concurrent Mark/Sweep) garbage collection time vs baseline
   */
  oldGenTimeX: double

  /**
   * Old gen usage percentage increase vs baseline
   */
  oldGenPctX: double

  /**
   * Number of runs of the test that produced these measurements
   */
  testRunCount: int

  /**
   * Total execution time of the test that produced these measurements (all runs)
   */
  testRunTime: double

  /**
   * If a condition was met successfully or not
   */
  success: boolean
}
