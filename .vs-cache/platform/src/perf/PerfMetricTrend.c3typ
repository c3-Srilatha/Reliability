/**
 * This type represents an analysis of changes over time.
 *
 * @see PerfMetric#trend
 */
type PerfMetricTrend {

  metric:  !string
  measure: !string

  /**
   * The range of time represented by the values used to calculate the trend.
   */
  time: TimeRange

  /**
   * The values used to calculate the trend.
   */
  values: [double]

  /**
   * The aggregated value. By default this is the arithmetic mean (simple average), but may also be another statistic
   * as specified by {@link PerfMetricTrendsSpec#aggregateBy}.
   */
  mean: !double

  /**
   * The overall change fraction of a line using linear regression.
   */
  change: !double

  /**
   * Interesting inflection points detected in the values (0-based indexes and corresponding dates).
   */
  changesDetected: [Pair<int, datetime>]
}
