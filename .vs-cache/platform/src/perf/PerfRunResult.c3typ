/**
 * single run results
 */
type PerfRunResult {

  run:     int
  name:    string
  threads: int

  /**
   * from PerfRunSpec.stepParam.opt
   */
  opt: Obj

  start: datetime
  end:   datetime

  /**
   * aggregate "wall" time of all the steps
   */
  totalTime: decimal

  /**
   * wall time of a run - if steps are running in multiple threads this time is going to be less then totalTime
   */
  time: decimal

  /**
   * approximate CPU time used across all JVM threads while test was running
   */
  totalCpu: decimal

  /**
   * aggregate cpu time as reported by test action
   */
  cpu: decimal

  /**
   * aggregate dbTime as reported by test action
   */
  dbTime: decimal

  /**
   * custom measurement aggregates from step() go here
   */
  measurements: map<string, decimal> schema suffix 'M'

  actionIds: [string] schema suffix 'AI'
}
