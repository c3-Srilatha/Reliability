/**
 * This type represents a change in a particular metric/measure between two queries.
 *
 * @see PerfMetric#changes
 */
type PerfMetricChange {

  metric:  !string
  measure: !string

  /**
   * The range of time represented by the values used to calculate the before average.
   */
  beforeTime: TimeRange

  /**
   * The values used to calculate the before average.
   */
  beforeValues: [double]

  /**
   * The aggregated value for the "before" query. By default this is the arithmetic mean (simple average), but may also
   * be another statistic as specified by {@link PerfMetricChangesSpec#aggregateBy}.
   */
  beforeMean: !double

  /**
   * The range of time represented by the values used to calculate the after average.
   */
  afterTime: TimeRange

  /**
   * The values used to calculate the after average.
   */
  afterValues: [double]

  /**
   * The aggregated value for the "after" query. By default this is the arithmetic mean (simple average), but may also
   * be another statistic as specified by {@link PerfMetricChangesSpec#aggregateBy}.
   */
  afterMean: !double

  /**
   * The change fraction, after vs. before mean, positive or negative.
   */
  change: !double
}
