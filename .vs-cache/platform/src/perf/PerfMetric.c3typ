type PerfMetric mixes PerfMetricFields, REST {

  /**
   * @return metric for current hardware and build.
   */
  forCurrentHardware: function(metric: !string): !PerfMetric

  /**
   * Send Performance Metric Information to all-env.
   */
  @rest(uri='PerfMetricStore?action=upsert', method='POST')
  upsert: abstract member function(@rest(header=true, headerName='X-C3-Type-Aware') typeAware: boolean = true)

  /**
   * @return measures for a metric with optional filter by hardware and build. Key in the result is a
   *         {@link PerfMetricMeasure} value.
   */
  @rest(uri='PerfMetricStore?action=measures', method='POST')
  measures: abstract function(spec: !PerfMetricDimension,
                              @rest(header=true, headerName='X-C3-Type-Aware')
                              typeAware: boolean = true): map<string, Timeseries<double>>

  /**
   * @return raw measures for a metric with optional filter by hardware and build.
   */
  @rest(uri='PerfMetricStore?action=rawMeasures', method='POST')
  @deprecated(finalVersion='7.8', details='use #rawMetrics instead')
  rawMeasures: abstract function(spec: PerfMetricDimension,
                                 @rest(header=true, headerName='X-C3-Type-Aware')
                                 typeAware: boolean = true): [PerfMetricFields]

  /**
   * @return raw metrics for a given specific specification.
   */
  @rest(uri='PerfMetricStore?action=rawMetrics', method='POST')
  rawMetrics: abstract function(spec: PerfMetricRawMetricsSpec,
                                @rest(header=true, headerName='X-C3-Type-Aware')
                                typeAware: boolean = true): !FetchResult<PerfMetricFields>

  /**
   * @return raw metrics evaluation results.
   */
  @rest(uri='PerfMetricStore?action=rawMetricsEval', method='POST')
  rawMetricsEval: abstract function(spec: EvaluateSpec,
                                    @rest(header=true, headerName='X-C3-Type-Aware')
                                    typeAware: boolean = true): !EvaluateResult

  /**
   * @return list of top N metrics by popularity.
   */
  @rest(uri='PerfMetricStore?action=metrics', method='POST')
  metrics: abstract function(limit: int = 100,
                             @rest(header=true, headerName='X-C3-Type-Aware')
                             typeAware: boolean = true): [string]

  /**
   * @return list of top N git branches by popularity.
   */
  @rest(uri='PerfMetricStore?action=gitBranches', method='POST')
  gitBranches: abstract function(limit: int = 100,
                                 @rest(header=true, headerName='X-C3-Type-Aware')
                                 typeAware: boolean = true): [string]

  /**
   * @return list of top N {@link Hardware} by popularity.
   */
  @rest(uri='PerfMetricStore?action=hardwareLabels', method='POST')
  hardwareLabels: abstract function(limit: int = 100,
                                    @rest(header=true, headerName='X-C3-Type-Aware')
                                    typeAware: boolean = true): [string]

  /**
   * @return list of top N build versions by popularity.
   */
  @rest(uri='PerfMetricStore?action=buildVersions', method='POST')
  buildVersions: abstract function(limit: int = 100,
                                   @rest(header=true, headerName='X-C3-Type-Aware')
                                   typeAware: boolean = true): [string]

  /**
   * @return list of top N metrics/measures that have changed the most over the query
   */
  @rest(uri='PerfMetricStore?action=trends', method='POST')
  trends: abstract function(query: !PerfMetricDimension, spec: PerfMetricTrendsSpec): [PerfMetricTrend]

  /**
   * @return list of top N metrics for which the specified measure changed the most over the query
   */
  @rest(uri='PerfMetricStore?action=measureTrends', method='POST')
  measureTrends: abstract function(query: !PerfMetricDimension, measure: !string, limit: int = 100): [PerfMetricTrend]

  /**
   * @return HTML table of top N metrics/measures that have changed the most over the query
   */
  @rest(uri='PerfMetricStore?action=trendsTable', method='POST')
  trendsTable: abstract function(query: !PerfMetricDimension, spec: PerfMetricTrendsTableSpec): !Content

  /**
   * @return list of top N metrics/measures that have changed the most between these two queries
   */
  @rest(uri='PerfMetricStore?action=changes', method='POST')
  changes: abstract function(beforeQuery: !PerfMetricDimension,
                             afterQuery: !PerfMetricDimension,
                             spec: PerfMetricChangesSpec): [PerfMetricChange]

  /**
   * @return list of top N metrics for which the specified measure changed the most between these two queries
   */
  @rest(uri='PerfMetricStore?action=measureChanges', method='POST')
  measureChanges: abstract function(beforeSpec: !PerfMetricDimension,
                                    afterSpec: !PerfMetricDimension,
                                    measure: !string,
                                    limit: int = 100): [PerfMetricChange]

  /**
   * @return HTML table of top N metrics/measures that have changed the most between these two queries
   */
  @rest(uri='PerfMetricStore?action=changesTable', method='POST')
  changesTable: abstract function(beforeQuery: !PerfMetricDimension,
                                  afterQuery: !PerfMetricDimension,
                                  spec: PerfMetricChangesTableSpec): !Content

  /**
   * @return HTML summary table for a given build as compared to a latest results of a base branch if specified or
   * as trends otherwise
   */
  buildSummary: abstract function(branch: !string, build: int, baseBranch: string): !Content js-server

  instanceType: !~
  buildTime:    !~
  buildVersion: !~
}
