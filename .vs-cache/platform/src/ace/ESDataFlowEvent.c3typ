/**
 * DFEs based on event conditions should mix in this type.
 */
type ESDataFlowEvent<ST> mixes DataFlowEvent<ST> {

  /**
   * start of period queried
   */
  start: datetime

  /**
   * end of period queried (exclusive)
   */
  end: datetime

  /**
   * whether or not the condition is triggered
   */
  triggered: boolean
}
