/**
 * Each call to process can produce zero or more output objects.  The ResultSet object is used
 * to communicate those results from processSource back to the invoking Java code.
 */
type ResultSet {

  /**
   * the input object, mixes DataFlowEvent
   */
  input: Obj

  /**
   * the result, single object or ObjMapp
   */
  result: Obj
}
