/**
 * Cache for analytics listeners
 */
type AnalyticsListenerCache mixes MetadataCacheOld<AnalyticsListenerCacheEntry>, Value {

  /**
   * @return the contents of the cache
   */
  info: function(): !AnalyticsListenerCacheEntry

  /**
   * @return true if there is a listener for the metric
   */
  hasListener: inline function(metricId: !string): !boolean

  /**
   * Gets the source types handled by a listener.
   *
   * @param listenerType
   *        Listener type to get the source types for.
   *
   * @return List of source types handled by the listener.
   */
  srcTypesForListener: inline function(listenerType: !string): [Type]
}
