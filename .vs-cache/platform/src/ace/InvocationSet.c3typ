/**
 * The loadContextAll and postProcessAll functions take an object that includes state about all the
 * calls to be made to this analytic.  This may be across multiple source objects and time intervals.
 */
type InvocationSet {

  /**
   * all source objects
   */
  sources: [Obj]

  /**
   * the invalidation start (not aligned)
   */
  start: datetime

  /**
   * the invalidation end (not aligned)
   */
  end: datetime

  /**
   * options passed in
   */
  options: TriggerAnalyticsOptions
}
