/**
 * Options to invalidateMetric, eventsOccured, loadDFE.
 *
 * This really belongs in the analyticsContainer module but it has to reside here for now so RefreshAnalyticsSpec can mix it in.  It
 * should be moved back once we migrate to the new type system.
 */
type TriggerAnalyticsOptions {

  /**
   * make the end date inclusive instead of exclusive
   */
  endInclusive: boolean = false

  /**
   * force redundant evaluations with same input data (ignore eval history)
   */
  forceReEval: boolean = false

  /**
   * set start-of-time point (if not beginning of data)
   */
  startOfTime: datetime

  /**
   * set end-of-time point (if not now)
   */
  endOfTime: datetime

  /**
   * analytics allowed to be invoked; if null/empty, all are allowed
   */
  analyticWhitelist: [string]

  /**
   * handling of metric/event evaluation errors
   * - immediate: abort on individual metric failures
   * - atEnd: collect all metric failures and fail at very end
   * - ignore: treat metric failures as empty (0% complete)
   */
  metricFailure: string enum TriggerAnalyticsFailureOption = IMMEDIATE

  /**
   * size of invalidation batches in map/reduce jobs
   */
  batchSize: int

  /**
   * When true, the action will not throw missing source exception.
   */
  ignoreMissingSource: boolean
}
