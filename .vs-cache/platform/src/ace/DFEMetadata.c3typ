/**
 * Meta-data for a single DataFlowEvent type.  These instances are produced by the analytics
 * container in response to query actions such as allDFEs.
 */
type DFEMetadata {

  /**
   * qualified type name
   */
  name: string

  /**
   * source type
   */
  sourceType: string

  /**
   * method of input data construction
   */
  kind: string

  /**
   * time interval of the DFE
   */
  interval: string

  /**
   * time period
   */
  period: string

  /**
   * window size period spec
   */
  windowSize: string

  /**
   * window offset period spec
   */
  windowOffset: string

  /**
   * frequency period spec
   */
  frequency: string

  /**
   * metric name for a metric DFE
   */
  metric: string

  /**
   * condition filter for an event DFE
   */
  condition: string

  /**
   * join type for a joined DFE
   */
  joinType: string

  /**
   * embedded types for a compound DFE
   */
  compoundTypes: [string]

  /**
   * analytics (transforms) which produce this DFE
   */
  producedBy: [string]

  /**
   * DFEs required for construction
   */
  requiredDFEs: [string]

  /**
   * whether this DFE is unneeded by all reachable analytics
   */
  unused: boolean
}
