/**
 * Various info for analytics listeners used internally for invalidation for metrics
 */
private type AnalyticsListenerCacheEntry {

  /**
   * Analytic groups grouped by metric.
   */
  groupsByMetric: map<string, [string]>

  /**
   * Metric source types grouped by listener
   */
  srcTypesByListener: map<string, [Type]>

  /**
   * Analytic groups grouped by listener.
   */
  groupsByListener: map<string, [string]>

  /**
   * Analytic groups grouped by source type.
   */
  groupsBySrcType: map<string, [string]>

  /**
   * All analytics listener types
   */
  listenerTypes: [Type]
}
