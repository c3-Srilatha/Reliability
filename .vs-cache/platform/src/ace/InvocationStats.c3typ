/**
 * value returned by invalidate* and eventsOccurred methods
 */
type InvocationStats {

  /**
   * number of source objects
   */
  sourceCount: int

  /**
   * maximum number of time intervals hit for any DFE
   */
  maxIntervals: int

  /**
   * number of DFEs evaluated
   */
  dfeEvalCount: int

  /**
   * number of DFEs loaded above threshold
   */
  dfeReadyCount: int

  /**
   * number of analytics executed
   */
  analyticCount: int

  /**
   * number of analytics outputs produced
   */
  outputCount: int

  /**
   * total running time in seconds
   */
  elapsedTime: double

  /**
   * effective options used for run
   */
  options: TriggerAnalyticsOptions
}
