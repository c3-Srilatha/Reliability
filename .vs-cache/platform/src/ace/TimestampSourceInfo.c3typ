/**
 * Debug info regarding the source of the start/end values in the time range.
 */
type TimestampSourceInfo {

  /**
   * Type id of the timeseries (or asTimeseries) header.
   */
  timeseriesTypeId: int

  /**
   * Id of the timeseries (or asTimeseries) header.
   */
  timeseriesId: string

  /**
   * Source file the value came from (comes from {@link Meta#sourceFile}).
   */
  sourceFile: string

  /**
   * ImportData/Upsert action that created the data.
   */
  actionId: string
}
