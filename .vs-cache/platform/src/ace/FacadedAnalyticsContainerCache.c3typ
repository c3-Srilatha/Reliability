/**
 * Cache for facaded TypeBackwardDep info
 */
private type FacadedAnalyticsContainerCache mixes Cached {

  /**
   * Analytic white list.
   */
  analyticWhiteList: [string]

  /**
   * Analytic group config
   *
   * @java(class='c3.engine.analytics.AnalyticGroups')
   */
  analyticGroupConfig: native

  /**
   * Analytic types set
   *
   * @java(class='c3.engine.analytics.AnalyticTypesSet')
   */
  analyticsTypesSet: native

  /**
   * Determines if a metric group is in the analytics white list.
   *
   * @param groupName
   *        Metric group name.
   * @param appCode
   *        App that is facading into the app.
   *
   * @return True if the metric group is in the analytics white list.
   */
  metricGroupInAnalyticWhitelist: inline function(appCode: !int, groupName: !string): boolean

  produce: ~
}
