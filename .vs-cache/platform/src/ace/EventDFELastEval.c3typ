/**
 * Each time we check a condition event DFE, we record the last time so that we don't check
 * too frequently.
 */
@db(unique=['dfeTypeId,start,end'])
entity type EventDFELastEval schema name 'ANALCON_EVELEVAL' {

  /**
   * DFE type ID
   */
  dfeTypeId: !int

  /**
   * start of the time range
   */
  start: !datetime

  /**
   * end of the time range (exclusive)
   */
  end: !datetime

  /**
   * required last evaluation time
   */
  evalTime: !datetime

  /**
   * required number of evaluations total
   */
  evalCount: !int
}
