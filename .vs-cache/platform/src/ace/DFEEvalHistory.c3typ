/**
 * Each time a DFE is constructed (evaluated) to check for analytics that should be
 * triggered, we keep a record of it.  This allows us to re-evaluate analytics as few
 * times as possible.
 * This log is stored in Cassandra.
 */
@db(datastore="kv", compactType=true)
entity type DFEEvalHistory schema name 'analyticsContainer_DFEEvalHistory' {

  /**
   * key: DFE type ID
   */
  dfeTypeId: !int

  /**
   * key: source object ID
   */
  srcId: !string

  /**
   * key: grain of the DFE
   */
  grain: string enum Interval

  /**
   * key: start of the time range
   */
  start: !datetime

  /**
   * key: end of the time range (exclusive)
   */
  end: !datetime

  /**
   * required last evaluation time
   */
  evalTime: !datetime

  /**
   * required number of evaluations total
   */
  evalCount: !int

  /**
   * hash of last time series
   */
  lastHash: string
}
