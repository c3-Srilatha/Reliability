/**
 * options for handling of metric/event evaluation errors when executing analytics.
 */
enum type TriggerAnalyticsFailureOption {

  /**
   * abort on individual metric failures
   */
  IMMEDIATE = 'immediate'

  /**
   * collect all metric failures and fail at very end
   */
  AT_END = 'atEnd'

  /**
   * treat metric failures as empty (0% complete)
   */
  IGNORE = 'ignore'
}
