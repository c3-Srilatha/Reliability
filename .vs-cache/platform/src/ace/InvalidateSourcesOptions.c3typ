/**
 * Options to invalidateSources.
 */
type InvalidateSourcesOptions mixes TriggerAnalyticsOptions {

  /**
   * Map of group names to one or more analytic names.
   *
   * ```
   * {
   *   "ami": "AMIMeterHealthAP",
   *   "revpro": [ "RevenueOpportunityAP", "RevenueOpportunitySC" ],
   *   "other": "*"
   * }
   * ```
   *
   * This overrides the "ACE-AnalyticGroups" tenant config setting.
   */
  analyticGroups: map<string, [string]>
}
