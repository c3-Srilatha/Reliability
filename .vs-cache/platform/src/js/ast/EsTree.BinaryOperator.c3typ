/**
 * ESTree BinaryOperator enum, introduced in ES5.
 *
 * @see EsTree
 * @see https://github.com/estree/estree/blob/master/es5.md#binaryoperator
 */
enum type EsTree.BinaryOperator {

  EQUAL = "=="

  NOT_EQUAL = "!="

  EXACT_EQUAL = "==="

  NOT_EXACT_EQUAL = "!=="

  LESS = "<"

  LESS_EQUAL = "<="

  GREATER = ">"

  GREATER_EQUAL = ">="

  LEFT_SHIFT = "<<"

  RIGHT_SHIFT = ">>"

  U_RIGHT_SHIFT = ">>>"

  PLUS = "+"

  MINUS = "-"

  TIMES = "*"

  DIVIDE = "/"

  MOD = "%"

  OR = "|"

  XOR = "^"

  AND = "&"

  IN = "in"

  INSTANCEOF = "instanceof"

  EXPONENT = "**"
}
