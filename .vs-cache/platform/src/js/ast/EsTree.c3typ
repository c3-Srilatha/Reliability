/**
 * The {@link https://github.com/estree/estree ESTree Spec} is the most widely used JavaScript abstract syntax tree
 * (AST) model. It is defined as the JSON into which parsers such as **Esprima** and **Acorn** parse JavaScript source
 * code into.
 *
 * This type is a wrapper for all the {@link EsTree.Node node types} which match the names defined in the spec:
 *  - {@link Estree.AnonymousDefaultExportedClassDeclaration AnonymousDefaultExportedClassDeclaration} (ES2015)
 *  - {@link Estree.AnonymousDefaultExportedFunctionDeclaration AnonymousDefaultExportedFunctionDeclaration} (ES2015)
 *  - {@link Estree.ArrayExpression ArrayExpression} (ES5)
 *  - {@link Estree.ArrayPattern ArrayPattern} (ES2015)
 *  - {@link Estree.ArrowFunctionExpression ArrowFunctionExpression} (ES2015)
 *  - {@link Estree.AssignmentExpression AssignmentExpression} (ES5)
 *  - {@link Estree.AssignmentOperator AssignmentOperator} (ES5)
 *  - {@link Estree.AssignmentPattern AssignmentPattern} (ES2015)
 *  - {@link Estree.AssignmentProperty AssignmentProperty} (ES2015)
 *  - {@link Estree.AwaitExpression AwaitExpression} (ES2017)
 *  - {@link Estree.BinaryExpression BinaryExpression} (ES5)
 *  - {@link Estree.BinaryOperator BinaryOperator} (ES5)
 *  - {@link Estree.BlockStatement BlockStatement} (ES5)
 *  - {@link Estree.BreakStatement BreakStatement} (ES5)
 *  - {@link Estree.CallExpression CallExpression} (ES5)
 *  - {@link Estree.CatchClause CatchClause} (ES5)
 *  - {@link Estree.Class Class} (ES2015)
 *  - {@link Estree.ClassBody ClassBody} (ES2015)
 *  - {@link Estree.ClassDeclaration ClassDeclaration} (ES2015)
 *  - {@link Estree.ClassExpression ClassExpression} (ES2015)
 *  - {@link Estree.ConditionalExpression ConditionalExpression} (ES5)
 *  - {@link Estree.ContinueStatement ContinueStatement} (ES5)
 *  - {@link Estree.DebuggerStatement DebuggerStatement} (ES5)
 *  - {@link Estree.Declaration Declaration} (ES5)
 *  - {@link Estree.Directive Directive} (ES5)
 *  - {@link Estree.DoWhileStatement DoWhileStatement} (ES5)
 *  - {@link Estree.EmptyStatement EmptyStatement} (ES5)
 *  - {@link Estree.ExportAllDeclaration ExportAllDeclaration} (ES2015)
 *  - {@link Estree.ExportDefaultDeclaration ExportDefaultDeclaration} (ES2015)
 *  - {@link Estree.ExportNamedDeclaration ExportNamedDeclaration} (ES2015)
 *  - {@link Estree.ExportSpecifier ExportSpecifier} (ES2015)
 *  - {@link Estree.Expression Expression} (ES5)
 *  - {@link Estree.ExpressionStatement ExpressionStatement} (ES5)
 *  - {@link Estree.ForInStatement ForInStatement} (ES5)
 *  - {@link Estree.ForOfStatement ForOfStatement} (ES2015)
 *  - {@link Estree.ForStatement ForStatement} (ES5)
 *  - {@link Estree.Function Function} (ES5)
 *  - {@link Estree.FunctionBody FunctionBody} (ES5)
 *  - {@link Estree.FunctionDeclaration FunctionDeclaration} (ES5)
 *  - {@link Estree.FunctionExpression FunctionExpression} (ES5)
 *  - {@link Estree.Identifier Identifier} (ES5)
 *  - {@link Estree.IfStatement IfStatement} (ES5)
 *  - {@link Estree.ImportDeclaration ImportDeclaration} (ES2015)
 *  - {@link Estree.ImportDefaultSpecifier ImportDefaultSpecifier} (ES2015)
 *  - {@link Estree.ImportNamespaceSpecifier ImportNamespaceSpecifier} (ES2015)
 *  - {@link Estree.ImportSpecifier ImportSpecifier} (ES2015)
 *  - {@link Estree.LabeledStatement LabeledStatement} (ES5)
 *  - {@link Estree.Literal Literal} (ES5)
 *  - {@link Estree.LogicalExpression LogicalExpression} (ES5)
 *  - {@link Estree.LogicalOperator LogicalOperator} (ES5)
 *  - {@link Estree.MemberExpression MemberExpression} (ES5)
 *  - {@link Estree.MetaProperty MetaProperty} (ES2015)
 *  - {@link Estree.MethodDefinition MethodDefinition} (ES2015)
 *  - {@link Estree.ModuleDeclaration ModuleDeclaration} (ES2015)
 *  - {@link Estree.ModuleSpecifier ModuleSpecifier} (ES2015)
 *  - {@link Estree.NewExpression NewExpression} (ES5)
 *  - {@link Estree.Node Node} (ES5)
 *  - {@link Estree.ObjectExpression ObjectExpression} (ES5)
 *  - {@link Estree.ObjectPattern ObjectPattern} (ES2015)
 *  - {@link Estree.Pattern Pattern} (ES5)
 *  - {@link Estree.Position Position} (ES5)
 *  - {@link Estree.Program Program} (ES5)
 *  - {@link Estree.Property Property} (ES5)
 *  - {@link Estree.RegExpLiteral RegExpLiteral} (ES5)
 *  - {@link Estree.RestElement RestElement} (ES2015)
 *  - {@link Estree.ReturnStatement ReturnStatement} (ES5)
 *  - {@link Estree.SequenceExpression SequenceExpression} (ES5)
 *  - {@link Estree.SourceLocation SourceLocation} (ES5)
 *  - {@link Estree.SpreadElement SpreadElement} (ES2015)
 *  - {@link Estree.Statement Statement} (ES5)
 *  - {@link Estree.Super Super} (ES2015)
 *  - {@link Estree.SwitchCase SwitchCase} (ES5)
 *  - {@link Estree.SwitchStatement SwitchStatement} (ES5)
 *  - {@link Estree.TaggedTemplateExpression TaggedTemplateExpression} (ES2015)
 *  - {@link Estree.TemplateElement TemplateElement} (ES2015)
 *  - {@link Estree.TemplateLiteral TemplateLiteral} (ES2015)
 *  - {@link Estree.ThisExpression ThisExpression} (ES5)
 *  - {@link Estree.ThrowStatement ThrowStatement} (ES5)
 *  - {@link Estree.TryStatement TryStatement} (ES5)
 *  - {@link Estree.UnaryExpression UnaryExpression} (ES5)
 *  - {@link Estree.UnaryOperator UnaryOperator} (ES5)
 *  - {@link Estree.UpdateExpression UpdateExpression} (ES5)
 *  - {@link Estree.UpdateOperator UpdateOperator} (ES5)
 *  - {@link Estree.VariableDeclaration VariableDeclaration} (ES5)
 *  - {@link Estree.VariableDeclarator VariableDeclarator} (ES5)
 *  - {@link Estree.WhileStatement WhileStatement} (ES5)
 *  - {@link Estree.WithStatement WithStatement} (ES5)
 *  - {@link Estree.YieldExpression YieldExpression} (ES2015)
 *
 * @see https://github.com/estree/estree
 * @see https://esprima.readthedocs.io/en/4.0/index.html
 * @see https://github.com/acornjs/acorn
 */
abstract type EsTree mixes Value {

  /**
   * Parse a JavaScript source file into an AST or return null on error.
   *
   * @param source valid JavaScript program or fragment
   * @param failIfInvalid if true, throw an error instead of returning null on parse failure
   */
  parse: function(source: !string, failIfInvalid: boolean): EsTree.Node

  /**
   * Parse a JavaScript source file to the JavaScript AST ("SpiderMonkey").
   *
   * @param source valid JavaScript program or fragment
   * @param failIfInvalid if true, throw an error instead of returning null on parse failure
   *
   * @see http://udn.realityripple.com/docs/Mozilla/Projects/SpiderMonkey/Parser_API
   */
  parseJson: function(source: !string, failIfInvalid: boolean): json

  /**
   * Print an AST as a JavaScript source file.
   */
  print: function(ast: !EsTree.Node): !string

  /**
   * Traverse (depth-first) the entire tree of nodes and call the visitor lambda for each one.
   *
   * @param ast node tree
   * @param visitor lambda to call on each node
   */
  visit: function(ast: !EsTree.Node, visitor: !lambda(node: !EsTree.Node))

  /**
   * Traverse (depth-first) the entire tree of nodes and call the visitor lambda for each one. If the lambda returns
   * false, do not descend into children of the current node (but continue with sibling nodes). The depth argument
   * passed to the visitor is relative to where in the AST **visit** was called, _not_ the absolute depth.
   *
   * @param ast node tree
   * @param visitor lambda to call on each node
   */
  visit: function(ast: !EsTree.Node, visitor: !lambda(node: !EsTree.Node, depth: !int): !boolean)

  /**
   * Traverse (depth-first) the entire tree of nodes and call the mapper lambda for each one. If the lambda returns a
   * different instance than passed to it, the parent node is updated with that new value. This allows one to modify
   * the AST, sharing all nodes that were not modified.
   *
   * The parent argument passed to the visitor is the immediate parent node or null for the root. The depth argument is
   * relative to where in the AST **map** was called, _not_ the absolute depth.
   *
   * If the mapper returns null, that field in the parent will be set to null. This may result in an invalid AST if
   * that node is logically required. If the mapper returns null for the root node, the whole method returns null.
   *
   * @param ast node tree
   * @param mapper lambda to map each node
   * @return mapped AST
   */
  map: function(ast: !EsTree.Node,
                mapper: !lambda(node: !EsTree.Node, parent: EsTree.Node, depth: !int): EsTree.Node): EsTree.Node

  /**
   * Load plain JSON from a parsed AST into Objs.
   */
  jsonToAst: function(json: !json): !EsTree.Node

  /**
   * Produce plain JSON of a parsed AST from Objs.
   */
  astToJson: function(ast: !EsTree.Node): !json

  /**
   * Parse the source code as JavaScript and return a string with nicely formatted syntax errors (if any).
   * This is mostly useful for helping with the display of scripts that failed to parse in environments too poor
   * to display good errors. If there are no errors, an empty string is returned.
   */
  parseErrors: function(source: !string): string
}
