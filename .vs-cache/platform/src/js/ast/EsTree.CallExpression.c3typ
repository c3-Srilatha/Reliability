/**
 * ESTree CallExpression node, introduced in ES5.
 *
 * @see EsTree
 * @see https://github.com/estree/estree/blob/master/es5.md#callexpression
 */
type EsTree.CallExpression mixes EsTree.Expression, EsTree.ChainElement {

  nodeType:  ~ = "CallExpression"
  callee:    !(EsTree.Expression | EsTree.Super)
  arguments: [EsTree.Expression | EsTree.SpreadElement]

  /**
   * creates a EsTree.CallExpression object from values passed into the function.
   *
   * @param caller_name
   *        The object that is calling the method. Ex. 'm'
   * @param method_name
   *        The name of the method that is being called from callerName. Ex `foo`
   * @param args
   *        A list of positional parameters to pass into the method. Ex: `arg1, arg2`
   * @return corresponding EsTree.CallExpression, corresponding to `m.foo(arg1, arg2)`
   */
  fromValues: function(callerName: !string, methodName: !string, args: [any]): !EsTree.CallExpression
}
