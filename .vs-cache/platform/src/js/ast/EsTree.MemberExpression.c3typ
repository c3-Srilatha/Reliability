/**
 * ESTree MemberExpression node, introduced in ES5.
 *
 * @see EsTree
 * @see https://github.com/estree/estree/blob/master/es5.md#memberexpression
 */
type EsTree.MemberExpression mixes EsTree.Expression, EsTree.Pattern, EsTree.ChainElement {

  nodeType: ~ = "MemberExpression"
  object:   !(EsTree.Expression | EsTree.Super)
  property: !EsTree.Expression
  computed: boolean
}
