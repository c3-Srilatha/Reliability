/**
 * ESTree MethodDefinition node, introduced in ES2015.
 *
 * @see EsTree
 * @see https://github.com/estree/estree/blob/master/es2015.md#methoddefinition
 */
type EsTree.MethodDefinition mixes EsTree.Node {

  nodeType: ~ = "MethodDefinition"
  key:      !EsTree.Expression
  value:    !EsTree.FunctionExpression
  kind:     !string enum("constructor", "method", "get", "set")
  computed: !boolean = false
  static:   !boolean = false
}
