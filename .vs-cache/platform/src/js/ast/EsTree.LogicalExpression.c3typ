/**
 * ESTree LogicalExpression node, introduced in ES5.
 *
 * @see EsTree
 * @see https://github.com/estree/estree/blob/master/es5.md#logicalexpression
 */
type EsTree.LogicalExpression mixes EsTree.Expression {

  nodeType: ~ = "LogicalExpression"
  operator: !string enum EsTree.LogicalOperator
  left:     !EsTree.Expression
  right:    !EsTree.Expression
}
