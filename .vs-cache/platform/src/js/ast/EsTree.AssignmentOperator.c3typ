/**
 * ESTree AssignmentOperator enum, introduced in ES5.
 *
 * @see EsTree
 * @see https://github.com/estree/estree/blob/master/es5.md#assignmentoperator
 */
enum type EsTree.AssignmentOperator {

  ASSIGN = "="

  PLUS_ASSIGN = "+="

  MINUS_ASSIGN = "-="

  TIMES_ASSIGN = "*="

  DIVIDE_ASSIGN = "/="

  MOD_ASSIGN = "%="

  LEFT_SHIFT_ASSIGN = "<<="

  RIGHT_SHIFT_ASSIGN = ">>="

  U_RIGHT_SHIFT_ASSIGN = ">>>="

  OR_ASSIGN = "|="

  XOR_ASSIGN = "^="

  AND_ASSIGN = "&="

  EXPONENT_ASSIGN = "**="
}
