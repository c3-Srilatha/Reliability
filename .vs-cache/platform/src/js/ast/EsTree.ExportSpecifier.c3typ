/**
 * ESTree ExportSpecifier node, introduced in ES2015.
 *
 * @see EsTree
 * @see https://github.com/estree/estree/blob/master/es2015.md#exportspecifier
 */
type EsTree.ExportSpecifier mixes EsTree.ModuleSpecifier {

  nodeType: ~ = "ExportSpecifier"
  exported: !EsTree.Identifier
}
