/**
 * ESTree Function node, introduced in ES5.
 *
 * @see EsTree
 * @see https://github.com/estree/estree/blob/master/es5.md#functions
 */
type EsTree.Function mixes EsTree.Node {

  @ser(name="id")
  id_: EsTree.Identifier

  params: [EsTree.Pattern]

  // FunctionBody is the spec, but parsers generate BlockStatement and Expression nodes here
  body: !(EsTree.FunctionBody | EsTree.BlockStatement | EsTree.Expression)

  generator: !boolean = false
  async:     !boolean = false
}
