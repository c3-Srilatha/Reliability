/**
 * ESTree UnaryExpression node, introduced in ES5.
 *
 * @see EsTree
 * @see https://github.com/estree/estree/blob/master/es5.md#unaryexpression
 */
type EsTree.UnaryExpression mixes EsTree.Expression {

  nodeType: ~ = "UnaryExpression"
  operator: !string enum EsTree.UnaryOperator
  prefix:   !boolean = false
  argument: !EsTree.Expression
}
