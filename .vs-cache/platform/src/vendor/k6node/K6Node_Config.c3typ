// TODO: PLAT-45616 Use . instead of _ issue with codegen
type K6Node_Config mixes CloudServiceConfig {

  id: ~
  forId: ~
  jsonCfg: ~
  releaseName: ~
  version:                          ~ = "0.0.1"

  /**
   * Image Repository to use for k6
   */
  k6ImageRepository: string = "c3ui/k6-node"

  /**
   * Image to use for k6 - concatenation of {@link CloudServiceConfig#logicalImageRegistry} and {@link K6Node_Config#k6ImageRepository}.
   *
   * NOTE: k6ImageName will be set by concatenating registry and repository. Setting this field directly will have no effect.
   */
  @ser(path="k6node.image")
  k6ImageName: string

  /**
   * Port that chrome selenium service will run on
   */
  @ser(path="k6node.service.port")
  k6Port:               int32 = 3000

  @ser(path="k6node.tag")
  k6ImageTag: string = "0.0.1"

  @ser(path="k6node.imagePullSecrets")
  imagePullSecrets: string = "docker-registry-secret"

  /**
   * Internal endpoint for c3 application server for kubernetes to access from within the cluster
   *
   * This field automatically populated by {@link K6Node.ensureConfig}.
   */
  @ser(path="k6node.c3.internalServerEndpoint")
  k6InternalServerEndpoint: string

  /**
   * CloudService tags should be set on an SNE and it's resources.
   *
   * This field automatically populated by {@link K6Node.ensureConfig}.
   */
  @ser(path="k6.c3.serviceTags")
  serviceTags: private map<string, string>
}
