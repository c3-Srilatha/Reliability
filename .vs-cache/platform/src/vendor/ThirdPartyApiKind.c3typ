/**
 * Enum type that indicates the type for a specific ThirdPartyAPI.
 */
enum type ThirdPartyApiKind {

  GITHUB = 'Github'

  SLACK = 'Slack'

  MICROSOFT = 'Microsoft'

  JENKINS = 'Jenkins'

  OPENAPI = 'OpenAPI'

  GODADDY = 'GoDaddy'

  SPLUNK = 'Splunk'

  JIRA = 'Jira'

  TWILIO = 'Twilio'
}
