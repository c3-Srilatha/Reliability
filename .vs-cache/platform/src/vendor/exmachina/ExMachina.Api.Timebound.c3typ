/**
 * Get a REST interface to the Spark server that times out API calls after 4 seconds. This avoids blocking c3server
 * resources when the service is starting up or under heavy load.
 */
type ExMachina.Api.Timebound mixes REST {

  /**
   * Get the details the Spark pod provides for active driver and executors.
   */
  @rest(uri='sparkPods/details', method='GET', skipThis=true, c3Context=true)
  getSparkPodDetails: abstract member function(): [ExMachinaSparkPodDetails]

  /**
   * Get a list of projects currently running
   *
   * @param onlyCurrentlyRunning
   *           If true, only return graphs that are currently running (not finished).
   *
   * @return array of project IDs
   */
  @rest(uri='getLoadedGraphs', method='POST', skipThis=true, c3Context=true)
  getLoadedGraphs: abstract member function(onlyCurrentlyRunning: boolean): json
}
