/**
 * To support sequence generation for ExMachina cloud service instances.
 */
entity type ExMachina_Seq mixes DefaultInstance<ExMachina_Seq> {

  /**
   * Tracking what the next sequence number will be.
   */
  seq: int

  inst: ~

  /**
   * Get the next sequence number.
   */
  nextSeq: member function(): int
}
