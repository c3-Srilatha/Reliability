type Twilio mixes REST {

  @rest(uri='Accounts', method='POST', bodyType='plain')
  postToMessages: abstract function(@rest(partOfURI=true, uriPrefix='/', uriSuffix='/Messages.json')
                                    accountSid: !string,
                                    To: !string,
                                    From: !string,
                                    Body: !string,
                                    MediaUrl: string): TwilioMessageResponse

  /**
   * Configures Twilio account credentials at given level.
   * @param url
   *          Twilio Rest endpoint url.
   * @param sid
   *          Twilio account sid.
   * @param token
   *          Twilio account token.
   * @param token
   *          Twilio account from phone number.
   */
  setConfiguration: function(url: !string,
                             sid: !string,
                             token: !string,
                             from: !string,
                             configOverride: string enum ConfigOverride) js-server

  /**
   * Sends a sms text to the specified number with the specified message
   * Example: `sms("5551234567", "Hello world!")`
   *
   * @param To
   *             Phone number to send the sms text to
   * @param Body
   *             The message to be sent
   */
  sms: function(to: !string, body: !string): TwilioMessageResponse js-server

  /**
   * Sends a mms text to the specified number with the specified message. Mms texts include a image.
   * Example: `mms("5551234567", "Hello world!", "https://www.google.com/image.jpg")`
   *
   * @param To
   *             Phone number to send the sms text to
   * @param Body
   *             The message to be sent
   * @param MediaUrl
   *             The url to the image to be included in the mms
   */
  mms: function(to: !string, body: !string, mediaUrl: !string): TwilioMessageResponse js-server
}
