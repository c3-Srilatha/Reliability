/**
 * The Issue Type. Examples are Bug, New Feature, Improvement, Outage, Task
 */
type JiraIssueType mixes WithId, WithName {

  /**
   * Whether it is a subtask or not
   */
  subtask: boolean

  /**
   * Icon URL for the issue type
   */
  iconUrl: string

  /**
   * Avatar ID for the issue type
   */
  avatarId: int

  /**
   * Hierarchy level of the issue type
   */
  hierarchyLevel: int

  /**
   * Description of the issue type
   */
  description: string
}
