type JiraUser mixes WithName, JiraKey {

  /**
   * user's atlassian account ID
   */
  accountId: string

  /**
   * user's email address
   */
  emailAddress: string

  /**
   * Display Name for user. What we see on Jira
   */
  displayName: string

  /**
   * Avatar URLs for different sizes
   */
  avatarUrls: JiraAvatarUrls

  /**
   * Whether the user is active
   */
  active: boolean

  /**
   * User's timezone
   */
  timeZone: string

  /**
   * Account type (e.g., "atlassian")
   */
  accountType: string
}
