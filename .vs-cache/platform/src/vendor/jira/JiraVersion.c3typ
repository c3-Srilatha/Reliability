/**
 * Represents a version in Jira
 */
type JiraVersion mixes WithId, WithName {

  /**
   * Self reference URL
   */
  self: string

  /**
   * Version ID
   */
  id: string

  /**
   * Version description
   */
  description: string

  /**
   * Version name
   */
  name: string

  /**
   * Whether the version is archived
   */
  archived: boolean

  /**
   * Whether the version is released
   */
  released: boolean

  /**
   * Release date
   */
  releaseDate: datetime

  /**
   * Whether the version is overdue
   */
  overdue: boolean

  /**
   * User release date
   */
  userReleaseDate: string

  /**
   * Project ID
   */
  projectId: int
}
