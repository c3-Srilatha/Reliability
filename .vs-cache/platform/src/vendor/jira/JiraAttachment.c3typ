/**
 * Represents an attachment in a Jira issue
 */
type JiraAttachment {

  /**
   * Self reference URL
   */
  self: string

  /**
   * Attachment ID
   */
  id: string

  /**
   * Filename
   */
  filename: string

  /**
   * Author of the attachment
   */
  author: JiraUser

  /**
   * Creation date
   */
  created: datetime

  /**
   * Size in bytes
   */
  size: int

  /**
   * MIME type
   */
  mimeType: string

  /**
   * Content URL
   */
  content: string

  /**
   * Thumbnail URL
   */
  thumbnail: string
}
