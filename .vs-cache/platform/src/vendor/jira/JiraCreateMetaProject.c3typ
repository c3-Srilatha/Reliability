/**
 * The metadata for creating Jira issues. This is specifically for the metadata within a specific project.
 */
type JiraCreateMetaProject mixes WithId, WithName, JiraKey {

  /**
   * Arry of JiraIssueType
   */
  @ser(name='issuetypes')
  issueTypes: [JiraIssueType]
}
