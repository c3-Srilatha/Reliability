/**
 * The Jira Project. Examples are Platform, DevOps, ML Engineering
 */
type JiraProject mixes WithId, WithName, JiraKey {

  /**
   * The array of Jira Version(s) associated with this Jira Project.
   */
  versions: [JiraVersion]

  /**
   * Project type key (e.g., "software")
   */
  projectTypeKey: string

  /**
   * Whether the project is simplified
   */
  simplified: boolean

  /**
   * Avatar URLs for the project
   */
  avatarUrls: JiraAvatarUrls

  /**
   * Project category information
   */
  projectCategory: JiraProjectCategory
}
