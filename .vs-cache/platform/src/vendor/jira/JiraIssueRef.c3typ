/**
 * A reference to a jira issue
 */
type JiraIssueRef mixes WithId {

  /**
   * Jira issue id
   */
  id: ~

  /**
   * Jira iussue key
   */
  key: string

  /**
   * Jira issue URL
   */
  self: string
}
