type JiraIssueFields<JI: JiraIssue> mixes JiraDescription {

  /**
   * Resolution of the Jira Issue
   */
  resolution: JiraResolution

  /**
   * Priority of Jira Ticket
   */
  priority: JiraPriority

  /**
   * Who the ticket is assigned to
   */
  assignee: JiraUser

  /**
   * What is the status of the ticket? (ie. Reopened, In Progress, etc)
   */
  status: JiraStatus

  /**
   * Who created the ticket
   */
  creator: JiraUser

  /**
   * Who you report the project to.
   */
  reporter: JiraUser

  /**
   * Array of components
   */
  components: [JiraComponent]

  /**
   * Tag. Can be platform version, customer name, or any arbitrary grouping.
   */
  @ser(name='customfield_10021')
  tag: string

  /**
   * Root Cause Assessment
   */
  @ser(name='customfield_13100')
  @db(persistAllFields=true)
  rca: JiraAdf

  /**
   * Root Cause Category
   */
  @ser(name="customfield_13104")
  rcc: [JiraRootCauseCategory]

  /**
   * Issue of the Project (ie. Bug, Task, etc)
   */
  @ser(name='issuetype')
  issueType: JiraIssueType

  /**
   * the time this issue was created
   */
  created: datetime

  /**
   * the time this issue was updated
   */
  updated: datetime

  /**
   * What Project (ie. Platform)
   */
  project: JiraProject

  /**
   * Jira sprints
   */
  @ser(name="customfield_10782")
  customSprint: [JiraSprint]

  /**
   * Custom Sprint gives a sprint as a non-parsed string. Sprint is not available as a JiraSprint type but as a
   * custom field in JiraApi {@link Jira}
   *
   * Sprint returns a JiraSprint object. Sprint is available as a JiraSprint type only when called by
   * JiraSoftwareApi {@link JiraSoftware}
   */
  sprint: JiraSprint

  /**
   * Custom Epic gives only the epic key. Epic is not available as a JiraEpic type but as a custom field in
   * JiraApi {@link Jira}
   */
  @ser(name='customfield_10783')
  customEpic: string

  /**
   * Epic returns a JiraEpic object. Epic is available as a JiraEpic type only when called by JiraSoftwareAPI
   * {@link JiraSoftware}
   */
  epic: JiraEpic

  /**
   * Summary of the ticket (AKA title of the ticket)
   */
  summary: string

  /**
   * Jira comments
   */
  comment: JiraCommentInfo

  @ser(name='timeoriginalestimate')
  originalEstimateSeconds: int

  @ser(name='timeestimate')
  remainingEstimateSeconds: int

  @ser(name='timespent')
  timeSpentSeconds: int

  @ser(name='timetracking')
  timeTracking: JiraTimeTracking

  /**
   * Jira labels
   */
  labels: [string]

  /**
   * Target Version eg: 7.x, 7.19, 8.0
   */
  @ser(name='customfield_12181')
  targetVersion: [JiraTargetVersion]

  /**
   * String returned by Jira containing pull requests count data
   */
  @ser(name='customfield_12480')
  pullRequestsCount: string

  /**
   * Jira team associated with this ticket (e.g. TM-X)
   */
  @ser(name="customfield_12500")
  team: JiraTeam

  /**
   * Parent issue reference
   */
  parent: JI

  /**
   * Fix versions for the issue
   */
  fixVersions: [JiraVersion]

  /**
   * Environment where the issue occurs
   */
  @db(persistAllFields=true)
  environment: JiraAdf

  /**
   * Due date for the issue
   */
  dueDate: datetime

  /**
   * Security level
   */
  security: JiraSecurity

  /**
   * Attachments on the issue
   */
  attachment: [JiraAttachment]

  /**
   * Issue links to other issues
   */
  @ser(name='issuelinks')
  issueLinks: [JiraIssueLink<JI>]

  /**
   * Subtasks of this issue
   */
  subtasks: [JI]

  /**
   * Votes information
   */
  votes: JiraVotes

  /**
   * Work ratio (percentage of work logged vs. original estimate)
   */
  workRatio: int

  /**
   * Issue restriction information
   */
  issueRestriction: JiraIssueRestriction

  /**
   * Watches information
   */
  watches: JiraWatches

  /**
   * Status category information
   */
  statusCategory: JiraStatusCategory

  /**
   * Aggregate time estimate in seconds
   */
  @ser(name='aggregatetimeestimate')
  aggregateTimeEstimateSeconds: int

  /**
   * Aggregate time spent in seconds
   */
  @ser(name='aggregatetimespent')
  aggregateTimeSpentSeconds: int

  /**
   * Aggregate progress information
   */
  aggregateProgress: JiraProgress

  /**
   * Progress information
   */
  progress: JiraProgress

  /**
   * Last time the issue was viewed
   */
  lastViewed: datetime

  /**
   * Status category change date
   */
  @ser(name='statuscategorychangedate')
  statusCategoryChangeDate: datetime

  /**
   * Resolution date
   */
  resolutionDate: datetime

  /**
   * Rank field for ordering
   */
  @ser(name='customfield_10787')
  rank: string

  /**
   * Last comment date
   */
  @ser(name='customfield_10788')
  lastCommentDate: datetime

  /**
   * Development environment
   */
  @ser(name='customfield_13110')
  developmentEnvironment: [JiraCustomFieldOption]

  /**
   * Size estimate
   */
  @ser(name='customfield_13115')
  sizeEstimate: JiraCustomFieldOption

  /**
   * Cloud environment
   */
  @ser(name='customfield_13108')
  cloudEnvironment: [JiraCustomFieldOption]

  /**
   * Version field
   */
  @ser(name='customfield_13180')
  version: [JiraCustomFieldOption]

  /**
   * Requirements status
   */
  @ser(name='customfield_10212')
  requirementsStatus: JiraCustomFieldOption

  /**
   * Priority tag
   */
  @ser(name='customfield_10220')
  priorityTag: JiraCustomFieldOption

  /**
   * Applicability field
   */
  @ser(name='customfield_10033')
  applicability: [JiraCustomFieldOption]

  /**
   * Services field
   */
  @ser(name='customfield_10016')
  services: JiraCustomFieldOption
}
