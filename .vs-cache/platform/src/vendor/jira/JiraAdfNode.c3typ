/**
 * Base ADF node type
 */
type JiraAdfNode {

  /**
   * Node type (paragraph, text, hardBreak, mention, codeBlock, etc.)
   */
  @ser(name="type")
  _type: string

  /**
   * Node content (for container nodes like paragraph, codeBlock)
   */
  content: [JiraAdfNode]

  /**
   * Text content (for text nodes)
   */
  text: string

  /**
   * Text marks (for formatting like bold, italic, links)
   */
  marks: [JiraAdfMark]
}
