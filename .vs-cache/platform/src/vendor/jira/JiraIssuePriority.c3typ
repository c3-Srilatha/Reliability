/**
 * Enum type that indicates the Jira issue priority.
 */
enum type JiraIssuePriority {

  /**
   * P0
   */
  BLOCKER = 1

  /**
   * P1
   */
  URGENT = 2

  /**
   * P2
   */
  CRITICAL = 3

  /**
   * P3
   */
  NICETOFIX = 4

  /**
   * P4
   */
  MINOR = 5
}
