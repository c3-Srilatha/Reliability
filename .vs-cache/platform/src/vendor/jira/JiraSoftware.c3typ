/**
 * Use {@link Jira} instead.
 *
 * {@link JiraSoftware} is a different api with a different endpoint from {@link Jira}.
 * {@link JiraSoftware} provides flexibility to edit sprints and epics that {@link Jira} does not provide
 * Updated for Jira API v3 compatibility
 */
private type JiraSoftware mixes REST, JiraSoftwareMethods, DefaultInstance<JiraSoftware> {

  @rest(uri='sprint', method='GET')
  sprint: abstract function(@rest(partOfURI=true, uriPrefix='/') sprintId: !int): JiraSprint

  @rest(uri='sprint', method='POST')
  updateIssueSprint: abstract function(@rest(partOfURI=true, uriPrefix='/', uriSuffix='/issue')
                                       sprintId: !int,
                                       issues: ![string])

  @rest(uri='board', method='GET')
  allSprints: abstract function(@rest(partOfURI=true, uriPrefix='/', uriSuffix='/sprint')
                                boardId: !int,
                                @rest(queryParameter=true)
                                state: string = 'active,future',
                                @rest(queryParameter=true)
                                startAt: int = 0,
                                @rest(queryParameter=true)
                                maxResults: int = 50): JiraQueryBase<JiraSprint>

  @rest(uri='epic', method='GET')
  epic: abstract function(@rest(partOfURI=true, uriPrefix='/') epicIdOrKey: !string): JiraEpic

  @rest(uri='epic', method='POST')
  updateIssueEpic: abstract function(@rest(partOfURI=true, uriPrefix='/', uriSuffix='/issue')
                                     epicIdOrKey: !string,
                                     issues: ![string])

  @rest(uri='board', method='GET')
  allEpics: abstract function(@rest(partOfURI=true, uriPrefix='/', uriSuffix='/epic')
                              boardId: !int): JiraQueryBase<JiraEpic>

  @rest(uri='board', method='GET')
  allBoards: abstract function(@rest(queryParameter=true, parameterName='type')
                               scrumKanbanType: string,
                               @rest(queryParameter=true)
                               name: string,
                               @rest(queryParameter=true)
                               projectKeyOrId: string,
                               @rest(queryParameter=true)
                               startAt: int = 0,
                               @rest(queryParameter=true)
                               maxResults: int = 50): JiraQueryBase<JiraBoard>

  @rest(uri='board', method='GET')
  board: abstract function(@rest(partOfURI=true, uriPrefix='/') boardId: !int): JiraBoard
}
