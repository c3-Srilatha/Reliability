/**
 * Atlassian Document Format (ADF) type for rich text content in Jira API v3
 * Used for description, environment, comment body, and other rich text fields
 */
type JiraAdf mixes StringSerializable {

  /**
   * ADF version
   */
  version: int = 1

  /**
   * ADF document type
   */
  @ser(name="type")
  _type: string = "doc"

  /**
   * ADF content as array of structured nodes
   */
  content: [JiraAdfNode]

  /**
   * Generates a {@link JiraAdfParagraph} ADF node with given text content
   */
  fromString: ~

  toString: ~
}
