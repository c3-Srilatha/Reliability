/**
 * The Jira Board. Examples are Apps Scrum, Platform Scrum, ML Engineering Scrum
 */
type JiraBoard mixes WithId, WithName {

  /**
   * Type of Jira Board
   */
  @ser(name='type')
  scrumKanbanType: string
}
