/**
 * Just defines a description field. Used as a mixin for many other types in Jira.
 * Uses Atlassian Document Format (ADF) in v3 API.
 */
type JiraDescription {

  /**
   * Description of a specific type in Jira (uses ADF format in v3)
   */
  @db(persistAllFields=true)
  description: JiraAdf
}
