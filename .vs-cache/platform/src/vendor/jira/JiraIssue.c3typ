type JiraIssue<JI: JiraIssue> mixes Identifiable, JiraKey, JiraExpand {

  /**
   * Where majority of Jira issue description are described here in another layer of json
   */
  @ser(name='fields')
  jiraIssueFields: JiraIssueFields<JI>

  /**
   * Reopens a Closed or Closed-Verified Issue. You cannot reopen an issue that's already opened
   */
  reopen: member function(): JiraIssue

  /**
   * Moves an issue to the current active sprint
   *
   * @param boardId
   *          The id of the board. By default the board that has the active sprint is Platform which has the id of 61
   */
  moveToActiveSprint: member function(boardId: int = 61)

  /**
   * Close an issue
   */
  close: member function()

  /**
   * Indicates if the issue is a flipper.
   */
  isFlipper: inline member function(): boolean

  /**
   * Indicates if the issue is a flipper that sometimes fails even after 3x retry.
   */
  isUnstable: inline member function(): boolean

  /**
   * Indicates if the issue is a regression.
   */
  isRegression: inline member function(): boolean

  /**
   * Indicates if the issue is closed.
   */
  isClosed: inline member function(): boolean

  /**
   * Indicates if the issue is closed-verified.
   */
  isClosedVerified: inline member function(): boolean
}
