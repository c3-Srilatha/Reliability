/**
 * Represents the type of link between Jira issues
 */
type JiraIssueLinkType {

  /**
   * Self reference URL
   */
  self: string

  /**
   * Link type ID
   */
  id: string

  /**
   * Link type name
   */
  name: string

  /**
   * Inward description
   */
  inward: string

  /**
   * Outward description
   */
  outward: string
}
