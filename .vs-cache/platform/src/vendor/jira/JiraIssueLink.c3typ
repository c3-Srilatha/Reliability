/**
 * Represents a link between Jira issues
 */
type JiraIssueLink<JI: JiraIssue> {

  /**
   * Self reference URL
   */
  self: string

  /**
   * Link ID
   */
  id: string

  /**
   * Type of link
   */
  @ser(name="type")
  type_: JiraIssueLinkType

  /**
   * Inward issue
   */
  inwardIssue: JI

  /**
   * Outward issue
   */
  outwardIssue: JI
}
