type JiraComment mixes WithId {

  /**
   * Author of the comment
   */
  author: JiraUser

  /**
   * The body of the comment. Good Idea to put any failed jenkins builds here
   * Uses Atlassian Document Format (ADF) in v3 API
   */
  @db(persistAllFields=true)
  body: JiraAdf

  /**
   * Author who updated the comment
   */
  updateAuthor: JiraUser

  /**
   * Time when comment was created
   */
  created: datetime

  /**
   * Time when comment was updated
   */
  updated: datetime
}
