/**
 * Avatar URLs for different sizes in Jira
 */
type JiraAvatarUrls {

  /**
   * 48x48 pixel avatar URL
   */
  @ser(name="48x48")
  size48x48: string

  /**
   * 24x24 pixel avatar URL
   */
  @ser(name="24x24")
  size24x24: string

  /**
   * 16x16 pixel avatar URL
   */
  @ser(name="16x16")
  size16x16: string

  /**
   * 32x32 pixel avatar URL
   */
  @ser(name="32x32")
  size32x32: string
}
