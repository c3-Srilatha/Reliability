type JiraSprint mixes WithId, WithName {

  /**
   * state of jira sprint. Whether this sprint is active, closed, or in the future
   */
  state: string

  /**
   * start date of sprint
   */
  startDate: datetime

  /**
   * end date of sprint
   */
  endDate: datetime

  /**
   * complete date of sprint
   */
  completeDate: datetime

  /**
   * board id
   */
  boardId: int

  /**
   * goal of sprint
   */
  goal: string

  /**
   * Parses string representation of Jira Sprint. E.g. result of
   */
  fromString: inline function(s: !?string): mixing JiraSprint
}
