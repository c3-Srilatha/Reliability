type JiraIssueHistoryItem {

  /**
   * The Jira field name
   */
  field: string

  /**
   * The Jira field type - either Jira or custom
   */
  fieldtype: string

  /**
   * The field ID
   */
  fieldId: string

  /**
   * The 'from' value of the history
   * This can be the initial resolution status of the ticket it is transitioning from
   */
  @ser(name="from")
  transitionFrom: string

  /**
   * The 'from' value in string
   */
  @ser(name="fromString")
  transitionFromString: string

  /**
   * The 'to' value of the history
   * This can be the resolution status of the ticket it is transitioning to
   */
  @ser(name="to")
  transitionTo: string

  /**
   * The 'to' value in string
   */
  @ser(name="toString")
  transitionToString: string
}
