/**
 * The base template for querying a list of epics, sprints, boards, and comments.
 * Updated for Jira API v3 with support for nextPageToken pagination.
 */
type JiraQueryBase<T> {

  /**
   * Maximum number of T to return per page. default 50.
   */
  maxResults: int = 50

  /**
   * Starting index of the returned T. base index 0.
   */
  startAt: int = 0

  /**
   * Token for pagination (v3 API alternative to startAt)
   */
  nextPageToken: string

  /**
   * Total number of items shown
   */
  total: int

  /**
   * Arry of T
   */
  values: [T]
}
