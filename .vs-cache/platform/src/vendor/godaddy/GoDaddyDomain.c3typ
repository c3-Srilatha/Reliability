/**
 * This type represents a domain in GoDaddy.
 */
@beta
@facade(tenant='c3', tag='c3')
type GoDaddyDomain mixes REST {

  /**
   * Unique identifier for Go Daddy Domain
   */
  domainId: string

  /**
   * Name of the domain
   */
  domain: string

  /**
   * Current status of domain
   */
  status: string enum GoDaddyDomainStatus

  /**
   * Date and time when this domain will expire
   */
  expires: datetime

  /**
   * Whether or not the domain is protected from expiration
   */
  expirationProtected: boolean

  /**
   * Whether or not the domain is on-hold by the registrar
   */
  holdRegistrar: boolean

  /**
   * Whether or not the domain is locked to prevent transfers
   */
  locked: boolean

  /**
   * Whether or not the domain has privacy protection
   */
  privacy: boolean

  /**
   * Whether or not the domain is configured to automatically renew
   */
  renewAuto: boolean

  /**
   * Whether or not the domain is eligble for renewal based on status
   */
  renewable: boolean

  /**
   * Whether or not the domain is protected from transfer
   */
  transferProtected: boolean

  /**
   * Date and time when this domain was created
   */
  createdAt: datetime

  /**
   * Authorization code for transferring the Domain
   */
  authCode: string

  /**
   * Reseller subaccount shopperid who can manage the domain
   */
  subaccountId: string

  /**
   * Retrieve a list of Domains
   *
   * @param limit
   *            Maximum number of domains to return
   * @param marker
   *            Marker Domain to use as the offset in results
   */
  @rest(uri='/v1/domains', method='GET')
  listResources: abstract function(@rest(parameterName='limit')
                                   limit: int,
                                   @rest(parameterName='marker')
                                   marker: string): [GoDaddyDomain]

  /**
   * Retrieve details for the specified Domain
   *
   * @param domain
   *            Domain name whose details are to be retrieved
   */
  @rest(uri='/v1/domains', method='GET')
  getResource: abstract function(@rest(parameterName='domain', partOfURI=true, uriPrefix='/')
                                 domain: string): GoDaddyDomain
}
