/**
 * Status of compaction job.
 */
type CassandraDB.CompactionStatus mixes CassandraDB.MaintenanceJobStatus {

  /**
   * The Spec of the compaction job
   */
  spec: CassandraDB.CompactionSpec

  /**
   * Returns a CassandraDB.CompactionStatus with 'running' state and batch error with message 'Already running'.
   *
   * @param {string} releaseName - The name of the release.
   * @return {CassandraDB.CompactionStatus} The compaction status indicating the job is already running.
   */
  alreadyRunning: private function(releaseName: string): !CassandraDB.CompactionStatus
}
