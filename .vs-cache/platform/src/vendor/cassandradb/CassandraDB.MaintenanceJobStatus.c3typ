/**
 * Status of maintenance job.
 */
type CassandraDB.MaintenanceJobStatus {

  /**
   * The Spec of the maintenance job
   */
  spec: CassandraDB.MaintenanceJobSpec

  /**
   * The state of the maintenance job
   */
  state: !CassandraDB.MaintenanceJobState

  /**
   * The time the maintenance job was created
   */
  lastExecution: datetime

  /**
   * The estimated time of completion for the job.
   */
  eta: datetime

  /**
   * The error message if any
   */
  error: Error

  /**
   * Checks if the job is in the "running" state.
   *
   * @return {boolean} true if the job is in the "running" state.
   */
  isRunning: private inline member function(): !boolean
}
