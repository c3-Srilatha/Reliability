/**
 * Specification for Compaction.
 */
type CassandraDB.CompactionSpec mixes CassandraDB.MaintenanceJobSpec {

  /**
   * Confirmation to run a full native Cassandra compaction
   */
  confirm: boolean

  /**
   * Name of The KeySpace
   */
  keyspace: string

  /**
   * Name of the tables
   */
  tables: [string]

  /**
   * Split output to SSTable files that are 50%-25%-12.5% and so on of the total size.
   */
  splitOutput: boolean

  /**
   * Token at which the compaction range starts (inclusive)
   */
  startToken: string

  /**
   * Token at which compaction range ends (inclusive)
   */
  endToken: string
}
