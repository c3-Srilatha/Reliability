/**
 * Specification for Repair.
 * @see https://cassandra-reaper.io/docs/configuration/reaper_specific/
 */
type CassandraDB.RepairSpec mixes CassandraDB.MaintenanceJobSpec {

  /**
   * Confirmation to run a native Cassandra repair.
   */
  confirm: boolean

  /**
   * Name of The KeySpace.
   */
  keyspace: !string

  /**
   * Name of the tables, If no tables given, then the whole keyspace is targeted.
   */
  tables: [!string]

  /**
   * Amount of segments per node to create for the repair run.
   * @see https://cassandra-reaper.io/docs/configuration/reaper_specific/#:~:text=is%20also%20supported.-,segmentCountPerNode,-Type%3A%20Integer
   */
  segmentCount: int

  /**
   * Type of parallelism to apply for the repair run.
   * @see https://cassandra-reaper.io/docs/configuration/reaper_specific/#:~:text=orders%20of%20magnitude.-,repairParallelism,-Type%3A%20String
   */
  repairParallelism: string enum('SEQUENTIAL', 'PARALLEL', 'DATACENTER_AWARE')

  /**
   * Repair intensity for the repair run.
   * Repair intensity defines the amount of time to sleep between triggering each repair segment while running a repair run.
   * Value between 0.0 and 1.0, but must never be 0.0.
   * @see https://cassandra-reaper.io/docs/configuration/reaper_specific/#:~:text=the%20Metrics%20section.-,repairIntensity,-Type%3A%20Float
   */
  intensity: double

  /**
   * Run incremental repair.
   * @see https://cassandra-reaper.io/docs/configuration/reaper_specific/#:~:text=repair%20run%20process.-,incrementalRepair,-Type%3A%20Boolean
   */
  incrementalRepair: boolean

  /**
   * List of nodes whose tokens should be repaired
   */
  nodes: [!string]

  /**
   * List of datacenters to repair.
   */
  datacenters: [!string]

  /**
   * The name of the tables that should not be repaired. Cannot be used in conjunction with the tables parameter.
   */
  blacklistedTables: [!string]

  /**
   * Number of threads to use for the repair run.
   * Repairs can be performed with up to 4 threads in order to parallelize the work on different token ranges
   * @see https://cassandra-reaper.io/docs/configuration/reaper_specific/#:~:text=to/shiro.ini%22%5D-,repairThreadCount,-Type%3A%20Integer
   */
  repairThreadCount: int

  /**
   * Force start a repair run.
   */
  force: boolean
}
