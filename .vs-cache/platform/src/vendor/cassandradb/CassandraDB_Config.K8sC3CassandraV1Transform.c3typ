/**
 * This type is used to transform an instance of CassandraDB_Config to a K8sC3Cassandra V1 operator K8s custom resource.
 * The K8s custom resource officially bears the API version "ops.c3.ai/v1" and Kind "C3Cassandra".
 */
type CassandraDB_Config.K8sC3CassandraV1Transform {

  fromConfig: function(cassConfig: !CassandraDB_Config): !CassandraDB_Config.K8sC3CassandraV1Transform
  resource:   member function(): !K8sC3CassandraV1

  @ser(path="apiVersion")
  apiVersion: string = 'ops.c3.ai/v1'

  /**
   * Cassandra version
   */
  @ser(path="spec.config.cassandra.serverVersion")
  serverVersion: string = "4.1.5"

  /**
   * For ensuring that datacenter is correctly formatted into array
   */
  @ser(path="spec.config.cassandra.datacenters", wrapInArray=true)
  datacenter: [string]

  /**
   * Cassandra datacenter name
   */
  @ser(path="spec.config.cassandra.datacenters.metadata.name")
  datacenterName: string

  /**
   * Number of rings for cassandra
   */
  @ser(path="spec.config.cassandra.datacenters.size")
  ringSize: int = 1

  /**
   * Type of pvc used. Leave it empty, and it will pick up the default storage class from cloud provider
   */
  @ser(path="spec.config.cassandra.datacenters.storageConfig.cassandraDataVolumeClaimSpec.storageClassName")
  storageClassName: string

  /**
   * Desired access modes for the volume
   */
  @ser(path="spec.config.cassandra.datacenters.storageConfig.cassandraDataVolumeClaimSpec.accessModes")
  accessModes: [string] = ["ReadWriteOnce"]

  /**
   * Size of pvc
   */
  @ser(path="spec.config.cassandra.datacenters.storageConfig.cassandraDataVolumeClaimSpec.resources.requests.storage")
  storageSize: string = "30Gi"

  /**
   * Size of heap in datacenters
   */
  @ser(path="spec.config.cassandra.datacenters.config.jvmOptions.heapSize")
  heapSize: string = "512M"

  /**
   * Size of the stargate data gateway
   */
  @ser(path="spec.config.cassandra.datacenters.stargate.size")
  stargateSize: int = 1

  /**
   * Size of the stargate's heap size
   */
  @ser(path="spec.config.cassandra.datacenters.stargate.heapSize")
  stargateHeapSize: string = "256M"

  /**
   * CPU limits
   */
  @ser(path="spec.resources.limits.cpu")
  cpuLimits: string = "8"

  /**
   * CPU requests
   */
  @ser(path="spec.resources.requests.cpu")
  cpuRequests: string = "8"

  /**
   * Memory limits
   */
  @ser(path="spec.resources.limits.memory")
  memoryLimits: string = "64Gi"

  /**
   * Memory requests
   */
  @ser(path="spec.resources.requests.memory")
  memoryRequests: string = "64Gi"

  /**
   * Cassandra reaper
   */
  @ser(path="spec.reaper.disabled")
  reaperDisabled: boolean = false

  /**
   * Automatic backup for this cassandra ring
   */
  @ser(path="spec.backup.disabled")
  backupDisabled: boolean = false

  /**
   * Cron schedule for automatic backup
   */
  @ser(path="spec.backup.cronSchedule")
  backupCronSchedule: string = "@daily"

  /**
   * Number of days after which the backups will be purged from the Cloud bucket
   */
  @ser(path="spec.backup.maxAgeDays")
  backupMaxAgeDays: int = 7

  /**
   * For internal cluster where c3aiops chart deployed as development mode,
   * set deleteChildResources to true will allow deleting any k8s resource associated created by the cass operator
   */
  @ser(path="spec.deleteChildResources")
  deleteChildResources: boolean = true
}
