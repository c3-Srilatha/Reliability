/**
 * This type is used to transform an instance of CassandraDB_Config to a K8sC3Cassandra V2 operator K8s custom resource.
 * The K8s custom resource officially bears the API version "ops.c3.ai/v2" and Kind "C3Cassandra".
 */
type CassandraDB_Config.K8sC3CassandraV2Transform {

  fromConfig: function(cassConfig: !CassandraDB_Config): !CassandraDB_Config.K8sC3CassandraV2Transform
  resource:   member function(): !K8sC3CassandraV2

  @ser(path="apiVersion")
  apiVersion: string = 'ops.c3.ai/v2'

  /**
   * Cassandra version
   */
  @ser(path="spec.serverVersion")
  serverVersion: string = "4.1.5"

  /**
   * For ensuring that datacenter is correctly formatted into array
   */
  @ser(path="spec.datacenters", wrapInArray=true)
  datacenter: [string]

  /**
   * Cassandra datacenter name
   */
  @ser(path="spec.datacenters.name")
  datacenterName: string

  /**
   * Indicates that the declared state of the Cassandra Cloud Service is stopped.
   */
  @ser(path="spec.hibernate.enabled")
  hibernateEnabled: boolean

  /**
   * Number of rings for cassandra
   */
  @ser(path="spec.datacenters.size")
  ringSize: int = 1

  /**
   * Type of pvc used. Leave it empty, and it will pick up the default storage class from cloud provider
   */
  @ser(path="spec.datacenters.storageConfig.cassandraDataVolumeClaimSpec.storageClassName")
  storageClassName: string

  /**
   * Desired access modes for the volume
   */
  @ser(path="spec.datacenters.storageConfig.cassandraDataVolumeClaimSpec.accessModes")
  accessModes: [string] = ["ReadWriteOnce"]

  /**
   * Size of pvc
   */
  @ser(path="spec.datacenters.storageConfig.cassandraDataVolumeClaimSpec.resources.requests.storage")
  storageSize: string = "30Gi"

  /**
   * Size of heap in datacenters
   */
  @ser(path="spec.datacenters.config.jvmOptions.heapSize")
  heapSize: string = "512M"

  /**
   * CPU limits
   */
  @ser(path="spec.resources.limits.cpu")
  cpuLimits: string = "8"

  /**
   * CPU requests
   */
  @ser(path="spec.resources.requests.cpu")
  cpuRequests: string = "8"

  /**
   * Memory limits
   */
  @ser(path="spec.resources.limits.memory")
  memoryLimits: string = "64Gi"

  /**
   * Memory requests
   */
  @ser(path="spec.resources.requests.memory")
  memoryRequests: string = "64Gi"

  /**
   * Cassandra reaper
   */
  @ser(path="spec.reaper.enabled")
  reaperEnabled: boolean = true

  /**
   * Automatic backup for this cassandra ring
   */
  @ser(path="spec.backup.enabled")
  backupEnabled: boolean = true

  /**
   * Cron schedule for automatic backup
   */
  @ser(path="spec.backup.cronSchedule")
  backupCronSchedule: string = "@daily"

  /**
   * Number of days after which the backups will be purged from the Cloud bucket
   */
  @ser(path="spec.backup.maxAgeDays")
  backupMaxAgeDays: int = 7

  /**
   * Controls whether storage resources (such as PVCs) should be cleaned up when the cassandra service is terminated.
   * This flag is propagated to the cassandra CRD which is used by the k8ssandra operator to decide
   * if storage resources need to be cleaned or not.
   */
  @ser(path="spec.cleanupOnTerminate")
  cleanupStorageOnTerminate: boolean
}
