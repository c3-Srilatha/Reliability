/**
 * Configuration for {@link JupyterHub.Api} that holds authentication info (based on {@link RestConfig}).
 *
 * Setting `minOverride`/`maxOverride` to {@link ConfigOverride.USER} level because config contains jupyter token issued for the concrete user.
 */
@config(minOverride=USER, maxOverride=USER)
private type JupyterHub.Api.Config mixes RestConfig {

  /**
   * Id of token created in JupyterHub by {@link JupyterHub#getUserToken}.
   *
   * Used to {@link JupyterHub#revokeUserToken revoke} token during {@link JupyterHub.Api#logout}.
   */
  tokenId: !string

  /**
   * Encoded id of the user for whom the authentication token was issued.
   *
   * The value is based on {@link User.email}, with encoding done by JupyterHub.
   * E.g: 'ba40c32eai'
   */
  userId: !string
}
