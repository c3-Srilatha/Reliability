type JupyterHub.Diagnostics {

  /**
   * List of pods that are part of the Jupyter Service deployment
   */
  pods: [K8sPod]

  /**
   * List of services that are part of the Jupyter Service deployment
   */
  services: [K8sService]

  /**
   * List of ingresses that are part of the Jupyter Service deployment
   */
  ingresses: [K8sIngress]

  /**
   * List of deployments that are part of the Jupyter Service deployment
   */
  deployments: [K8sDeployment]

  /**
   * List of persistent volumes claims that are part of the Jupyter Service deployment
   */
  persistentVolumeClaims: [K8sPersistentVolumeClaim]

  /**
   * List of config values driving the deployment of Jupyter Service
   */
  config: JupyterHub_Config

  /**
   * Last 200 lines of logs from the JupyterHub pod, if available.
   */
  hubLogs: string
}
