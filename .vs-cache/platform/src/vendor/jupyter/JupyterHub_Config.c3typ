// TODO: PLAT-45616 Use . instead of _ issue with codegen
type JupyterHub_Config mixes CloudServiceConfig {

  id:      ~
  version: ~
  forId:   ~

  // TODO: PLAT-85518 Remove the following overrides and add support for creating action groups for config/secret read and write
  @action(group+='app-admin')
  setConfig: ~ from super

  @action(group+='app-admin')
  setConfigValue: ~ from super

  @action(group+='app-admin')
  setConfigValues: ~ from super

  @action(group+='app-admin')
  setSecret: ~ from super

  @action(group+='app-admin')
  setSecretValue: ~ from super

  @action(group+='app-admin')
  setConfigValueTemplate: ~ from super

  @action(group+='app-admin')
  setSecretValueTemplate: ~ from super

  @action(group+='app-admin')
  setConfigOrSecretValue: ~ from super

  @action(group+='app-admin')
  setConfigOrSecretValueTemplate: ~ from super

  @action(group+='app-admin')
  clearConfigValue: ~ from super

  @action(group+='app-admin')
  clearSecretValue: ~ from super

  @action(group+='app-admin')
  clearConfigValueAllOverrides: ~ from super

  @action(group+='app-admin')
  clearSecretValueAllOverrides: ~ from super

  @action(group+='app-admin')
  clearConfigAndSecretOverride: ~ from super

  @action(group+='app-admin')
  clearConfigAndSecretAllOverrides: ~ from super

  @action(group+='app-admin')
  clearAllConfigAndSecretOverrides: ~ from super

  /**
   * CloudService tags that would be set on singleuser server and it's resources.
   *
   * This field automatically populated by {@link JupyterHub.ensureConfig}.
   */
  @ser(path="jupyterhub.custom.c3.serviceTags")
  serviceTags: private map<string, string>

  /**
   * Refresh period for authentication against c3 application server
   */
  @deprecated(details="This field is not being used, and will be removed in future release")
  @ser(path="jupyterhub.custom.c3.authRefreshPeriod")
  jupyterAuthRefreshPeriod: int

  /**
   * Prefix of the name for resources created for this {@link JupyterHub}.
   *
   * This field automatically populated by {@link JupyterHub.ensureConfig}.
   */
  @ser(path="jupyterhub.fullnameOverride")
  namePrefix: private string

  /**
   * Public endpoint for c3 application server
   *
   * This field automatically populated by {@link JupyterHub.ensureConfig}.
   */
  @ser(path="jupyterhub.custom.c3.externalServerEndpoint")
  jupyterExternalServerEndpoint: string

  /**
   * Internal endpoint for c3 application server for kubernetes to access from within the cluster
   *
   * This field automatically populated by {@link JupyterHub.ensureConfig}.
   */
  @ser(path="jupyterhub.custom.c3.internalServerEndpoint")
  jupyterInternalServerEndpoint: string

  /**
   * Authentication type against c3 application server
   *
   * This field automatically populated by {@link JupyterHub.ensureConfig}.
   */
  @deprecated(details="config is not used anymore")
  jupyterAuthType: string enum("basic", "idp")

  /**
   * Jupyterhub endpoint
   *
   * This field automatically populated by {@link JupyterHub.ensureConfig}.
   */
  @ser(path="jupyterhub.custom.c3.jupyterHubEndpoint")
  jupyterHubEndpoint: string

  /**
   * Image pull secret names
   */
  @ser(path="jupyterhub.imagePullSecrets")
  imagePullSecrets: [string]

  /**
   * JupyterHub Image Repository
   */
  jupyterHubImageRepository: string

  /**
   * JupyterHub Image Name - concatenation of  {@link JupyterHub_Config#jupyterImagesRegistry} and {@link JupyterHub_Config#jupyterHubImageRepository}.
   *
   * NOTE: Image name will be set by concatenating registry and repository. Setting this field directly will have no effect.
   */
  @ser(path="jupyterhub.hub.image.name")
  jupyterHubImageName: string

  /**
   * JupyterHub Image Tag
   *
   * E.g.: '1.1.3'. Will use image tag defined in jupyter helm chart if unset.
   */
  @ser(path="jupyterhub.hub.image.tag")
  jupyterHubImageTag: string

  /**
   * JupyterHub Proxy pod image repository
   */
  jupyterProxyImageRepository: string

  /**
   * JupyterHub Proxy pod image name - concatenation of {@link JupyterHub_Config#jupyterImagesRegistry} and {@link JupyterHub_Config#jupyterProxyImageRepository}.
   *
   * NOTE: Image name will be set by concatenating registry and repository. Setting this field directly will have no effect.
   */
  @ser(path="jupyterhub.proxy.chp.image.name")
  jupyterProxyImageName: string

  /**
   * JupyterHub Proxy pod image tag
   *
   * E.g.: '4.5.4'. Will use image tag defined in jupyter helm chart if unset.
   */
  @ser(path="jupyterhub.proxy.chp.image.tag")
  jupyterProxyImageTag: string

  /**
   * JupyterHub Proxy Traefik pod image name - concatenation of registry and repository
   *
   * Registry name is taken from {@link ContainerRegistry} and set by {@link JupyterHub.ensureConfig}.
   */
  @deprecated(details="traefik image is not being used. Will be removed in future release")
  @ser(path="jupyterhub.proxy.traefik.image.name")
  jupyterProxyTraefikImageName: string

  /**
   * JupyterHub Proxy SecretSync pod image name - concatenation of registry and repository
   *
   * Registry name is taken from {@link ContainerRegistry} and set by {@link JupyterHub.ensureConfig}.
   */
  @deprecated(details="Secret Syncs image is not being used. Will be removed in future release")
  @ser(path="jupyterhub.proxy.secretSync.image.name")
  jupyterProxySecretSyncImageName: string

  /**
   * JupyterHub scheduling.userScheduler to be deployed or not
   *
   * Should jupyterhub's userscheduler be deployed or not.
   * NOTE: `userscheduler` must be only disabled when the cluster doesn't allow creation of clusterwide namespaced resource
   */
  @deprecated(details="User Scheduler image is not being used. This config will be removed in future release")
  jupyterUserSchedulerEnabled: boolean

  /**
   * JupyterHub scheduling.userScheduler pod image name  - concatenation of registry and repository
   *
   * Registry name is taken from {@link ContainerRegistry} and set by {@link JupyterHub.ensureConfig}.
   */
  @deprecated(details="User Scheduler image is not being used. This config will be removed in future release")
  jupyterUserSchedulerImageName: string

  /**
   * JupyterHub scheduling.userScheduler pod image tag
   *
   * E.g.: '1.23.10'. Will use image tag defined in jupyter helm chart if unset.
   */
  @deprecated(details="User Scheduler image is not being used. This config will be removed in future release")
  jupyterUserSchedulerImageTag: string

  /**
   * JupyterHub scheduling.userPlaceholder pod image name - concatenation of registry and repository
   *
   * Registry name is taken from {@link ContainerRegistry} and set by {@link JupyterHub.ensureConfig}.
   */
  @ser(path="jupyterhub.scheduling.userPlaceholder.image.name")
  jupyterUserSchedulerPlaceholderImageName: string

  /**
   * Jupyter pre-puller container image name - concatenation of registry and repository
   *
   * Registry name is taken from {@link ContainerRegistry} and set by {@link JupyterHub.ensureConfig}.
   */
  @deprecated(details="Image prepullers have been disabled")
  @ser(path="jupyterhub.prePuller.hook.image.name")
  jupyterPrePullerImageName: string

  /**
   * Jupyter pre-puller pause container image name - concatenation of registry and repository
   *
   * Registry name is taken from {@link ContainerRegistry} and set by {@link JupyterHub.ensureConfig}.
   */
  @deprecated(details="Image prepullers have been disabled")
  @ser(path="jupyterhub.prePuller.pause.image.name")
  jupyterPrePullerPauseImageName: string

  /**
   * JupyterHub single user network tools container image name - concatenation of registry and repository
   *
   * Registry name is taken from {@link ContainerRegistry} and set by {@link JupyterHub.ensureConfig}.
   */
  @deprecated(details="Network tools image is not being used")
  @ser(path="jupyterhub.singleuser.networkTools.image.name")
  jupyterSingleUserProxyNetworkToolImageName: string

  /**
   * JupyterHub single user network tools container image tag
   *
   * E.g.: '2.0.0'. Will use image tag defined in jupyter helm chart if unset.
   */
  @deprecated(details="Network tools image is not being used")
  @ser(path="jupyterhub.singleuser.networkTools.image.name")
  jupyterSingleUserProxyNetworkToolImageTag: string

  /**
   * Size of the PVC for the single users
   * (See https://kubernetes.io/docs/concepts/configuration/manage-resources-containers/ for examples)
   */
  @ser(path="jupyterhub.singleuser.storage.capacity")
  jupyterSingleUserStorageCapacity: string

  /**
   * Size limit of the PVC for the single users
   */
  jupyterSingleUserStorageCapacityLimit: string

  /**
   * Should jupyterhub single user shared memory be enabled
   */
  jupyterSingleUserSharedMemoryEnabled: boolean

  /**
   * Single user shared memory size limit
   */
  jupyterSingleUserSharedMemorySizeLimit: string

  /**
   * Single user extra volumes
   * (See https://z2jh.jupyter.org/en/latest/jupyterhub/customizing/user-resources.html#modifying-user-shared-memory-size)
   */
  @ser(path="jupyterhub.singleuser.storage.extraVolumes")
  jupyterSingleUserExtraVolumes: [json]

  /**
   * Single user extra volume mounts
   * (See https://z2jh.jupyter.org/en/latest/jupyterhub/customizing/user-resources.html#modifying-user-shared-memory-size)
   */
  @ser(path="jupyterhub.singleuser.storage.extraVolumeMounts")
  jupyterSingleUserExtraVolumeMounts: [json]

  /**
   * Type of storage class for the PVC
   * (See https://kubernetes.io/docs/concepts/storage/storage-classes/ for reference)
   */
  @ser(path="jupyterhub.singleuser.storage.dynamic.storageClass")
  jupyterSingleUserStorageClass: string

  /**
   * Type of storage access mode
   * (See https://kubernetes.io/docs/concepts/storage/persistent-volumes/#access-modes for reference)
   */
  @ser(path="jupyterhub.singleuser.storage.dynamic.storageAccessModes")
  jupyterSingleUserStorageAccessMode: [string]

  /**
   * Name of the default resource profile to start single-user JupyterLab server
   */
  @ser(path="jupyterhub.custom.c3.defaultProfile")
  jupyterCustomC3Defaultprofile: string

  /**
   * Timeout (in seconds) after which a kernel is considered idle and ready to be culled
   */
  @ser(path="jupyterhub.custom.c3.kernelIdleTimeout")
  jupyterCustomC3KernelIdleTimeout: int

  /**
   * Interval (in seconds) for checking for idle servers, kernels, and terminals to cull. (default 300)
   */
  @ser(path="jupyterhub.cull.every")
  jupyterSingleUserCullInterval: int

  /**
   * Timeout (in seconds) after which singleuser servers and terminals are considered idle and ready to be culled (default 900)
   */
  @deprecated(details="Setting this field is no-op as it will be overriden by {@link JupyterHub_Config#jupyterCustomC3KernelIdleTimeout}. Please use {@link JupyterHub_Config#jupyterCustomC3KernelIdleTimeout}")
  @ser(path="jupyterhub.cull.timeout")
  jupyterSingleUserCullTimeout: int

  /**
   * Jupyterlab logs container repository
   */
  @deprecated(details="This field is not being used, and will be removed in future release")
  jupyterBusyboxRepo: string

  /**
   * Jupyterlab logs container tag
   */
  @deprecated(details="This field is not being used, and will be removed in future release")
  jupyterBusyboxTag: string

  /**
   * Jupyterlab logs container name - concatenation of {@link JupyterHub_Config#jupyterImagesRegistry} and {@link JupyterHub_Config#jupyterLogsContainerRepo}.
   *
   * NOTE: Image name will be set by concatenating registry and repository. Setting this field directly will have no effect.
   */
  @ser(path="jupyterhub.custom.c3.logs.image.name")
  jupyterLogsContainerImageName: string

  /**
   * Jupyterlab logs container repository
   */
  jupyterLogsContainerRepo: string

  /**
   * Jupyterlab logs container tag
   */
  @ser(path="jupyterhub.custom.c3.logs.image.tag")
  jupyterLogsContainerTag: string

  /**
   * Jupyterlab start command
   */
  @ser(path="jupyterhub.singleuser.cmd")
  jupyterSingleUserCmd: string

  /**
   * Jupyterlab image repository
   */
  jupyterSingleUserImageRepository: string

  /**
   * Jupyterlab image name - concatenation of {@link JupyterHub_Config#jupyterImagesRegistry} and {@link JupyterHub_Config#jupyterSingleUserImageRepository}.
   *
   * NOTE: Image name will be set by concatenating registry and repository. Setting this field directly will have no effect.
   */
  @ser(path="jupyterhub.singleuser.image.name")
  jupyterSingleUserImageName: string

  /**
   * Jupyterlab image tag
   */
  @ser(path="jupyterhub.singleuser.image.tag")
  jupyterSingleUserImageTag: string

  /**
   * Registry for images used by Jupyter deployments.
   *
   * Only use this config, if you want to use a custom registry for JupyterHub and JupyterLab images.
   * If the config is not set, we use the default `c3` configured registry.
   */
  jupyterImagesRegistry: string

  /**
   * The CPU memory limit, size in MB, in for the `minimum` seeded resource profile
   */
  @ser(path="jupyterhub.singleuser.memory.limit")
  jupyterSingleUserMemoryLimit: int

  /**
   * The CPU memory guarantee, size in MB, in for the `minimum` seeded resource profile
   * Default memory guarantee is same as `small` {@link Jupyter.ResourceProfile}
   */
  @ser(path="jupyterhub.singleuser.memory.guarantee")
  jupyterSingleUserMemoryGuarantee: int

  /**
   * Number of CPU guarantee for the `minimum` seeded resource profile
   * Default cpu limit is same as `small` {@link Jupyter.ResourceProfile}
   */
  @ser(path="jupyterhub.singleuser.cpu.guarantee")
  jupyterSingleUserCpuGuarantee: int

  /**
   * Number of CPU limit for `minimum` profile seeded in helm chart
   */
  @ser(path="jupyterhub.singleuser.cpu.limit")
  jupyterSingleUserCpuLimit: int

  /**
   * Jupyterlab spawn timeout in seconds
   */
  @ser(path="jupyterhub.singleuser.startTimeout")
  jupyterSingleUserStartTimeout: int

  /**
   * JupyterLab logging verbosity level
   */
  @ser(path="jupyterhub.singleuser.extraEnv.APP_LOG_LEVEL")
  jupyterSingleUserLogLevel: string

  /**
   * Should jupyterhub single user code assistant be enabled.
   * NOTE: the value for this field will be dictated by the  {@link AiAssistant.Config#enabled},
   * and changing this field directly will have no effect.
   */
  @ser(path="jupyterhub.custom.c3.aiAssistant.enabled")
  jupyterSingleUserAIAssistantEnabled: boolean

  /**
   * Should jupyterhub single user code assistant feedback be enabled.
   * NOTE: the value for this field will be dictated by the  {@link AiAssistant.Config#feedbackEnabled},
   * and changing this field directly will have no effect.
   */
  @ser(path="jupyterhub.custom.c3.aiAssistant.feedbackEnabled")
  jupyterSingleUserAIAssistantFeedbackEnabled: boolean

  /**
   * NOTE: the value for this field will be dictated by the {@link AiAssistant.Config#chatHistoryLimit},
   * and changing this field directly will have no effect.
   */
  @ser(path="jupyterhub.custom.c3.aiAssistant.chatHistoryLimit")
  jupyterSingleUserAIAssistantChatHistoryLimit: int

  /**
   * Configure JupyterHub proxy pods cpu resource `request` and `limits`. Setting the `limits` sets the `requests` to same value
   */
  @ser(path="jupyterhub.proxy.chp.resources.limits.cpu")
  jupyterProxyCpuRequests: string

  /**
   * Configure JupyterHub proxy pods memory resource `request` and `limits`. Setting the `limits` sets the `requests` to same value
   */
  @ser(path="jupyterhub.proxy.chp.resources.limits.memory")
  jupyterProxyMemoryRequests: string

  /**
   * Configure JupyterHub scheduling pods cpu resource `request` and `limits`. Setting the `limits` sets the `requests` to same value
   */
  @ser(path="jupyterhub.scheduling.userScheduler.resources.limits.cpu")
  jupyterSchedulingCpuRequests: string

  /**
   * Configure JupyterHub scheduling pods memory resource `request` and `limits`. Setting the `limits` sets the `requests` to same value
   */
  @ser(path="jupyterhub.scheduling.userScheduler.resources.limits.memory")
  jupyterSchedulingMemoryRequests: string

  /**
   * Should jupyterhub pre puller be enabled
   */
  @ser(path="jupyterhub.prePuller.continuous.enabled")
  jupyterPrePullerContinuousEnabled: boolean

  /**
   * Should jupyterhub pre puller hook be enabled
   */
  @ser(path="jupyterhub.prePuller.hook.enabled")
  jupyterPrePullerHookEnabled: boolean

  /**
   * Configure JupyterHub pods memory cpu resource `request` and `limits`. Setting the `limits` sets the `requests` to same value
   */
  @ser(path="jupyterhub.hub.resources.limits.cpu")
  jupyterHubCpuRequests: string

  /**
   * Configure JupyterHub pods memory resource `request` and `limits`. Setting the `limits` sets the `requests` to same value
   */
  @ser(path="jupyterhub.hub.resources.limits.memory")
  jupyterHubMemoryRequests: string

  /**
   * Jupyterhub baseUrl
   *
   * This field automatically populated by {@link JupyterHub.ensureConfig}.
   */
  @ser(path="jupyterhub.hub.baseUrl")
  jupyterHubBaseUrl: string

  /**
   * Jupyterhub endpoint context host
   *
   * This field automatically populated by {@link JupyterHub.ensureConfig}.
   */
  @ser(path="jupyterhub.ingress.hosts")
  jupyterHubHosts: [string]

  /**
   * Jupyterhub endpoint path.
   *
   * Full ingress path will be {@link #jupyterHubBaseUrl}/{@link #jupyterHubPath}.
   */
  @ser(path="jupyterhub.ingress.pathSuffix")
  jupyterHubPathSuffix: string

  /**
   * Switch on/off ingress for JupyterHub and JupyterLab
   */
  @ser(path="jupyterhub.ingress.enabled")
  jupyterIngress: boolean

  /**
   * Whether to enable metrics for Jupyter Service. Enabled by default
   */
  @ser(path="jupyterhub.custom.c3.metrics.enabled")
  jupyterMetricsEnabled: boolean

  /**
   * Time interval for metrics collection. Default interval is 60s
   */
  @ser(path="jupyterhub.custom.c3.metrics.interval")
  jupyterMetricsInterval: string

  /**
   * Threshold time, in seconds, to force re-authenticate the user before spawning JupyterLab.
   * Default value is 0, and means always force re-authenticate.
   */
  @ser(path="jupyterhub.custom.c3.auth.forceReauthenticateThresholdTime")
  jupyterForceReauthenticateOnSpawnThreshold: int

  /**
   * URL where Jupyter Service is deployed and accessible.
   */
  jupyterHubDeployedUrl: string

  /**
   * Configured c3 server version against which Jupyter service is deployed.
   * This field is automatically populated by {@link JupyterHub.config}.
   */
  @ser(path="jupyterhub.custom.c3.serverVersion")
  jupyterC3ServerVersion: string

  /**
   * UID used to run the JupyterHub proxy container entrypoint.
   */
  @ser(path="jupyterhub.proxy.chp.containerSecurityContext.runAsUser")
  jupyterProxyContainerRunAsUser: int

  /**
   * GID used to run the JupyterHub proxy container entrypoint.
   */
  @ser(path="jupyterhub.proxy.chp.containerSecurityContext.runAsGroup")
  jupyterProxyContainerRunAsGroup: int

  /**
   * UID used to run the JupyterHub hub container entrypoint.
   */
  @ser(path="jupyterhub.hub.containerSecurityContext.runAsUser")
  jupyterHubContainerRunAsUser: int

  /**
   * GID used to run the JupyterHub hub container entrypoint.
   */
  @ser(path="jupyterhub.hub.containerSecurityContext.runAsGroup")
  jupyterHubContainerRunAsGroup: int

  /**
   * Default UID applied at the JupyterHub hub pod level.
   * Applies to all containers unless overridden at the container level.
   */
  @ser(path="jupyterhub.hub.podSecurityContext.runAsUser")
  jupyterHubPodRunAsUser: int

  /**
   * Default GID applied at the JupyterHub hub pod level.
   * Applies to all containers unless overridden at the container level.
   */
  @ser(path="jupyterhub.hub.podSecurityContext.runAsGroup")
  jupyterHubPodRunAsGroup: int

  /**
   * Supplemental filesystem group applied to all containers in the JupyterHub hub pod.
   * Used to control shared volume file permissions.
   */
  @ser(path="jupyterhub.hub.podSecurityContext.fsGroup")
  jupyterHubPodFsGroup: int

  /**
   * Passthrough configuration for KubeSpawner.uid.
   * Sets the UID of the single-user notebook container.
   */
  @ser(path="jupyterhub.singleuser.uid")
  jupyterSingleUserUid: int

  /**
   * Passthrough configuration for KubeSpawner.fs_gid.
   * Sets the filesystem group for volumes mounted into the single-user pod.
   */
  @ser(path="jupyterhub.singleuser.fsGid")
  jupyterSingleUserFsGid: int

  /**
   * Passthrough configuration for KubeSpawner.extra_pod_config.
   * Allows arbitrary Kubernetes pod-level overrides for single-user pods.
   */
  @ser(path="jupyterhub.singleuser.extraPodConfig")
  jupyterSingleUserExtraPodConfig: json
}
