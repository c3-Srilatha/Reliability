/**
 * Represents Jupyter Hub [REST Api](https://jupyterhub.readthedocs.io/en/stable/reference/rest-api.html).
 */
// TODO PLAT-42951 Reimplement Jupyter*.Api types with OpenApi.generateType
// TODO PLAT-65209 Verify and fix other JupyterHub.API* and JupyterLab.Api* methods after upgrading helm chart
private type JupyterHub.Api mixes REST {

  /**
   * Create instance of {@JupyterHub.Api}.
   *
   * Internally calls {@link #hubLogin} followed by {@link #getUserToken}. Sets {@link #config} based on received token.
   */
  login: function(url: !string, cookie: !string): !JupyterHub.Api

  /**
   * Returns related {@link JupyterHub.Api.Config}.
   *
   * Default {@link RestConfig config} type is overridden by {@link JupyterHub.Api.Config} type to get extra field ({@link JupyterHub.Api.Config#tokenId tokenId}).
   */
  config: member function(secrets: boolean): !JupyterHub.Api.Config

  /**
   * Returns key for {@link JupyterHub.Api.Config} based on {@link App#name name} of current {@link App}.
   */
  configKey: ~

  /**
   * Checks if user's auth info is correct.
   *
   * If the token is not valid, need to login to get the new token by using {@link JupyterHub#api}.
   */
  @rest(uri='hub/is_user_authorized', skipThis=true, method='GET', acceptType='text/plain')
  verifyUserToken: abstract member function(@rest(queryParameter=true) user_id: !string): !string

  /**
   * Calls login endpoint on hub to properly create user session.
   *
   * Should be called before {@link #getUserToken}.
   * Required to set next parameter, otherwise will get circular redirect.
   */
  @rest(uri='hub/login', skipThis=true)
  hubLogin: abstract member function(@rest(header=true, headerName='cookie')
                                     cookie: !string,
                                     @rest(queryParameter=true)
                                     next: !string)

  /**
   * Calls login endpoint on hub to properly create user session using basic auth.
   *
   * Should be called before {@link #getUserTokenBasicAuth}.
   * Required to set next parameter, otherwise will get circular redirect.
   */
  @rest(uri='hub/login', method='POST', skipThis=true, contentType='application/x-www-form-urlencoded')
  hubBasicLogin: abstract member function(username: !string,
                                          password: !string,
                                          @rest(queryParameter=true)
                                          next: !string): HttpResponse

  /**
   * Produce JupyterHub token for an user using username and c3auth token.
   *
   * Should be called after {@link #hubLogin}
   */
  @rest(uri='hub/api/users', method='POST', skipThis=true)
  getUserToken: abstract member function(@rest(partOfURI=true, uriPrefix='/', uriSuffix='/tokens')
                                         encodedUserEmail: !string,
                                         @rest(header=true, headerName='cookie')
                                         cookie: !string,
                                         @rest(header=true, headerName='referer')
                                         referer: !string,
                                         scope: ![string]): json

  /**
   * Fetch the user id in the encoded format of JupyterHub
   */
  @rest(uri='hub/encoded_user_id', method='GET', skipThis=true, acceptType='text/plain')
  encodedUserId: abstract member function(@rest(queryParameter=true) user_id: !string): string

  /**
   * Produce JupyterHub token for an user using username and c3auth token.
   */
  @rest(uri='hub/api/users', method='POST', skipThis=true)
  listUserToken: abstract member function(@rest(partOfURI=true, uriPrefix='/', uriSuffix='/tokens')
                                          encodedUserEmail: !string): json

  /**
   * Revoke JupyterHub token created by {@link #getUserToken}.
   */
  @rest(uri='hub/api/users', method='DELETE', skipThis=true)
  revokeUserToken: abstract member function(@rest(partOfURI=true, uriPrefix='/', uriSuffix='/tokens')
                                            encodedUserEmail: !string,
                                            @rest(partOfURI=true, uriPrefix='/')
                                            tokenId: !string)

  /**
   * List all users and their {@link JupyterLab} servers.
   */
  @rest(uri='hub/api/users', method='GET', skipThis=true)
  listUsers: abstract member function(): !json

  /**
   * Ensure {@link JupyterLab} is running.
   *
   * Call this call is not blocking, so make sure {@link JupyterLab} is fully started before using it.
   *
   * @param profileName
   *          {@link Jupyter.ResourceProfile}'s name for spawning JupyterLab
   */
  @rest(uri='hub/api/users', method='POST', skipThis=true)
  spawnJupyterLab: abstract member function(@rest(partOfURI=true, uriPrefix='/', uriSuffix='/server')
                                            encodedUserEmail: !string,
                                            profileName: string): HttpResponse

  /**
   * Terminate {@link JupyterLab} instance.
   *
   * @param reason
   *          The reason behind stopping {@link JupyterLab}
   */
  @rest(uri='hub/api/users', method='DELETE', skipThis=true)
  terminateJupyterLab: abstract member function(@rest(partOfURI=true, uriPrefix='/', uriSuffix='/server')
                                                encodedUserEmail: !string,
                                                reason: string = "OTHER")

  /**
   * Returns json object with JupyterHub REST Api version.
   */
  @rest(uri='hub/api', skipThis=true)
  apiVersion: abstract member function(): !json

  /**
   * Gets JupyterHub logs.
   */
  @rest(uri='hub/tail_logs', skipThis=true, method='GET', acceptType='text/plain')
  logs: abstract member function(@rest(queryParameter=true) numLines: int): !string

  /**
   * Returns startup metrics
   *
   * @param userIds
   *          List of userIds for which metadata is fetched.
   */
  @rest(uri='hub/get_startup_metrics', method='POST', skipThis=true)
  startupMetrics: abstract member function(userIds: [!string]): !JupyterHub.Metrics

  /**
   * Returns JupyterLab image name, image version and storage Capacity for each user's JupyterLab Server.
   *
   * @param userIds
   *          List of userIds for which metadata is fetched.
   */
  @rest(uri='hub/get_lab_metadata', method='GET', skipThis=true)
  jupyterLabMetadata: abstract member function(): !json

  /**
   * Revoke token and clean configs.
   */
  logout: member function()
}
