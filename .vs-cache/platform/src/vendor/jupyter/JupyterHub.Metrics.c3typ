/**
 * Jupyter startup metrics for a given app
 */
private type JupyterHub.Metrics {

  /**
   * Time taken to finish {@link JupyterHub} spawning operation for the app, in seconds
   */
  hubStartDuration: float

  /**
   * Average time taken to allocate a node that meets the hardware resource requirements for all the {@link JupyterLab} instances in the app, in seconds
   */
  averageLabNodeAllocationDuration: float

  /**
   * Average time taken to pull the image for all the {@link JupyterLab}s in the app, in seconds
   */
  averageLabImagePullDuration: float

  /**
   * Average time taken to start the {@link JupyterLab} pods, in seconds
   */
  averageLabStartDuration: float

  /**
   * Average time taken to render the UI for the first time for the {@link JupyterLab} instances in the app, in seconds
   */
  averageLabFirstUiRenderDuration: float
}
