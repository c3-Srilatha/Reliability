/**
 * Python native helpers to make usage easier.
 */
native py remix type JupyterLab {

  /**
   * Returns python [context manager](https://book.pythontips.com/en/latest/context_managers.html) that
   * {@link JupyterLab#ensureRunning ensures} Jupyter Lab {@link JupyterLab service} on enter and will {@link JupyterLab#stopService stop} service when context is left.
   *
   * Will not modify {@link JupyterLab service} state if service already {@link JupyterLabLab#isRunning running}.
   */
  service: function(): !native py

  /**
   * Return python context manager that will start session and gracefully shut it down after usage.
   */
  session: member function(kernel_name: !string, name: string, path: string): !native py

  /**
   * Returns python [context manager](https://book.pythontips.com/en/latest/context_managers.html) that
   * {@link JupyterLab#installKernel installs} JupyterLab kernel on enter and will {@link JupyterLab#removeKernel remove} it when context is exited.
   *
   * If kernel already exists or it's a default kernel no changes will be made.
   *
   * @param runtime
   *          The runtime which would install/remove as kernel in JupyterLab.
   */
  // TODO: PLAT-42685 - Implement JupyterLab.removeKernel
  kernel: member function(runtime: !string serialized ImplLanguage.Runtime): !native py

  /**
   * Returns python [context manager](https://book.pythontips.com/en/latest/context_managers.html) that
   * syncs dependencies of the {@link JupyterNotebook}
   *
   * @param notebookPath
   *          The path of the notebook whose dependencies would be synced.
   */
  syncDependencies: member function(notebookPath: !string): !native py
}
