/**
 * Integration with PlantUML {@link https://plantuml.com/}
 */
type PlantUml {

  /**
   * Renders a PlantUML diagram from the given source string and saves it to the specified content.
   *
   * @param source
   *         The PlantUML source code.
   * @param content
   *         The content where the rendered diagram will be saved. e.g. {@link File} or {@link ContentBuffer}
   * @return description of the rendered diagram
   */
  renderDiagram: function(source: !string, content: !Content): string
}
