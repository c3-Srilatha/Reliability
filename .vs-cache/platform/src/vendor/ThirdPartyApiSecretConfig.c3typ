type ThirdPartyApiSecretConfig {

  /**
   * Obtain Developer Credentials for Testing
   *
   * @param type
   *        3rd party api type
   *
   * returns developer credentials for third party api
   *     ex: github, splunk, twilio... found in 'platform/src/vendor'
   */
  devCredentials: function(thirdPartyApiKind: !ThirdPartyApiKind): map<string, string>

  /**
   *   Obtain Ci Credentials for Testing
   *
   * @param type
   *          3rd party api type
   *
   *   returns ci credentials for third party api if cluster admin
   *       ex: GitHub, Splunk, Twilio... found in 'platform/src/vendor'
   */
  @action(group='cluster-admin')
  ciCredentials: function(thirdPartyApiKind: !ThirdPartyApiKind): map<string, string>
}
