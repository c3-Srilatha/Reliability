// TODO: PLAT-45616 Use . instead of _ issue with codegen
type Selenium_Config mixes CloudServiceConfig {

  id:          ~
  forId:       ~
  jsonCfg:     ~
  releaseName: ~
  version:     ~ = "4.19.1-20240402"

  /**
   * Cloud service timeout in minute.
   */
  waitForReadyTimeoutInMin: int = 30

  /**
   * Image Repository to use for chrome selenium
   */
  seleniumImageRepository: string = "selenium/standalone-chrome"

  @ser(path="c3Selenium.chrome.tag")
  seleniumImageTag: string = "4.19.1-20240402"

  /**
   * Image to use for chrome selenium - concatenation of {@link CloudServiceConfig#logicalImageRegistry} and {@link Selenium_Config#seleniumImageRepository}.
   *
   * NOTE: seleniumImageName will be set by concatenating registry and repository. Setting this field directly will have no effect.
   */
  @ser(path="c3Selenium.chrome.image")
  seleniumImageName: string

  @deprecated(details="Will be removed in the future. Keep it for backwards compatibility.")
  chromeImage: string

  /**
   * Port that chrome selenium service will run on
   */
  @ser(path="c3Selenium.chrome.service.seleniumPort")
  chromeSeleniumPort: int32 = 4444

  /**
   * imagePullSecrets used to authenticate for pulling the image
   */
  @ser(path="c3Selenium.chrome.serviceAccount.imagePullSecrets")
  imagePullSecrets: string = "docker-registry-secret"

  /**
   * Port that chrome selenium vnc will run on
   */
  @ser(path="c3Selenium.chrome.service.vncPort")
  chromeVncPort: int32 = 5900

  /**
   * Port that chrome selenium service debugging will run on
   */
  @ser(path="c3Selenium.chrome.service.chromeDebuggingPort")
  chromeDebuggingPort: int32 = 9222

  /**
   * The local filesystem directory that will be mounted by the selenium pod and projected as shared directory.
   */
  @ser(path="c3Selenium.sharedFileSystem.local")
  localfs: string = "/tmp"

  /**
   * The main path of the mounted local filesystem directory.
   */
  @ser(path="c3Selenium.sharedFileSystem.mountPath")
  mountPathfs: string = "/c3-cluster-shared"

  /**
   * The sub path of the mounted local filesystem directory.
   */
  @ser(path="c3Selenium.sharedFileSystem.subPath")
  subPathfs: string = "c3-cluster-shared"

  /**
   * CPU requests for the chrome selenium pod
   */
  @ser(path="c3Selenium.chrome.deployment.cpu")
  cpu: string = "2000m"

  /**
   * CPU limits for the chrome selenium pod
   */
  @ser(path="c3Selenium.chrome.deployment.cpuLimit")
  cpuLimit: string

  /**
   * Memory requests for the chrome selenium pod
   */
  @ser(path="c3Selenium.chrome.deployment.memory")
  memory: string = "6Gi"

  /**
   * Memory limits for the chrome selenium pod
   */
  @ser(path="c3Selenium.chrome.deployment.memoryLimit")
  memoryLimit: string = "6Gi"
}
