/**
 * A specialization of SplunkSearchSpec, adding fields relevant to storage (name, type)
 */
type SplunkSavedSearchSpec mixes SplunkSearchSpec {

  /**
   * The type of data being searched. See SplunkSearchType. Defaults to "Action"
   */
  searchType: !string enum SplunkSearchType = Action

  /**
   * A friendly name for this search. E.g. "Top actions by count", "Most expensive actions by host"
   */
  name: !string
}
