/**
 * The abstract base for specialized types which represent a result row from a Splunk search
 */
abstract type SplunkSearchResultRow {

  /**
   * The host that originated the Splunk event.  This data is present on all Splunk events, but may not be available in searches that use grouping (stats, timechart, etc.).  Grouped searches may include host, but often do not.
   */
  host: string

  /**
   * The structured data (pod, function, etc.) that is available when host is supplied.  This field is populated when host data is present in results.
   */
  cloudIdentity: CloudId
}
