type Splunk mixes Configurable<SplunkConfig> {

  /**
   * Execute one shot search query and return the result.
   *
   * @param splunkSearchSpec
   *           Input spec for search
   *
   * @return Result varies on the type search query.
   */
  @deprecated(finalVersion='7.10', details='Use {@link search}')
  oneShotSearch: function(splunkSearchSpec: !SplunkSearchSpec): !json

  /**
   * @param splunkSearchSpec
   *           Input spec for search
   *
   * @return The raw Json response from Splunk. This will be formatted as {"preview":false,"init_offset":0,"fields":[],"messages":[],"results":[]}
   */
  search: function(splunkSearchSpec: !SplunkSearchSpec): !json

  /**
   * @param splunkSearchSpec
   *           Input spec for search
   *
   * @return A SplunkSearchResult
   */
  savedSearch: function(splunkSearchSpec: !SplunkSavedSearchSpec): !SplunkSearchResult

  /**
   * @return search query for this cluster.
   */
  formatSearchForCluster: function(query: !string, excludeMasters: boolean, excludeWorkers: boolean): !string

  /**
   * @return name of the splunk server used in the cluster
   */
  _server: function(): !string

  /**
   * Checks if splunk is queryable
   */
  canQuery: function(): !boolean
}
