@db(partitionKeyField='searchEarliestTime',
    datastore="kv",
    defaultPartitionStrategy={type: 'PartitionBucketStrategy', maxHotSortKey: "1==1"})
entity type SplunkSearchResult mixes Partitionable<datetime> schema name 'SPSRT' {

  searchSpec:         !SplunkSearchSpec
  resultFields:       ![FieldType]
  resultRows:         ![SplunkSearchResultRow]
  searchEarliestTime: !datetime
  executionDuration:  !Duration
}
