/**
 * Represents a Splunk search specification
 */
type SplunkSearchSpec mixes Spec {

  /**
   * Specifies the earliest time in the time range to search.
   */
  earliestTime: !string = '-1h'

  /**
   * Specifies the latest time in the time range to search.
   */
  latestTime: !string = 'now'

  /**
   * Search query to execute on the splunk server. The field names returned by the search should align with the field names in the target SplunkSearchResultRow type for automated population
   */
  searchQuery: !string = 'search '

  /**
   * A number that indicates the maximum number of entities to return. Max Limit is 50000.  Defaults to 100.
   */
  count: !int = 100

  /**
   * Splunk server to execute the query upon. E.g "prod-splunk.c3-e.com", "dev-splunk.c3-e.com".
   */
  splunkServer: !string
}
