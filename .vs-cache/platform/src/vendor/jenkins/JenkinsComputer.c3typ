type JenkinsComputer {

  /**
   * Class name of the object (typically reflects the node type).
   */
  _class: string

  /**
   * A list of action objects, each with unique properties based on the action.
   */
  actions: [JenkinsAction]

  /**
   * Display name of the node.
   */
  displayName: string

  /**
   * Description of the node
   */
  description: string

  /**
   * List of executor objects, containing data about each job’s status and progress.
   */
  executors: [JenkinsExecutor]

  /**
   * Boolean indicating if the node is currently idle.
   */
  idle: boolean

  /**
   * Boolean indicating if the node connects via JNLP.
   */
  jnlpAgent: boolean

  /**
   * Indicates if launching is supported on this node.
   */
  launchSupported: boolean

  /**
   * Object containing load statistics like queue length and busy executors.
   */
  loadStatistics: JenkinsLoadStatistics

  /**
   * Boolean indicating if manual launch is allowed.
   */
  manualLaunchAllowed: boolean

  /**
   * Contains monitoring data for disk, memory, and response time.
   */
  monitorData: map<string, any>

  /**
   * Number of executors on this node.
   */
  numExecutors: int32

  /**
   * Node offline status and details.
   */
  offline: boolean

  /**
   * Cause of node being offline.
   */
  offlineCause: any

  /**
   * Reason for node being offline.
   */
  offlineCauseReason: string

  /**
   * Boolean indicating if the node is temporarily offline.
   */
  temporarilyOffline: boolean
}
