type JenkinsGithubCommit {

  /**
   * Files that were changed in this commit
   */
  affectedPaths: [string] schema suffix 'FI'

  /**
   * GitHub commit hash
   */
  commitId: string

  /**
   * timestamp when the git commit was made
   */
  timestamp: int

  /**
   * author of GitHub commit
   */
  author: JenkinsGithubCommitAuthor

  /**
   * email of committer
   */
  authorEmail: string

  /**
   * GitHub commit message
   */
  msg: string
}
