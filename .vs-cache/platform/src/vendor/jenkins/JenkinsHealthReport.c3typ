type JenkinsHealthReport {

  /**
   * The description of recent builds. Such as only 2 out of the last 5 builds were unsuccessful
   */
  description: string

  /**
   * The class name of the icon. Essentially gives the build the color (red, yellow, green). Possibly can be used for filtering
   */
  iconClassName: string

  /**
   * A png file of the icon. Essentially gives the build the color (red, yellow, green). Possibly can be used for filtering
   */
  iconUrl: string

  /**
   * The build score. Returns the percentage of the passing rate of recent builds
   */
  score: int
}
