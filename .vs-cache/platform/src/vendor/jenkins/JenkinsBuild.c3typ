/**
 * Information of a Jenkins Build
 */
type JenkinsBuild {

  /**
   * Other actions during Jenkins Build among which it shows whether a testReport exists.
   */
  actions: [JenkinsBuildAction] schema suffix 'ACT'

  /**
   * Whether the current build is building or not
   */
  building: boolean

  /**
   * The description of the build
   */
  description: string

  /**
   * Display name of the build. Usually "#${build_number}"
   */
  displayName: string

  /**
   * Actual duration to build in milliseconds.
   * Duration is 0 when building is True
   */
  duration: int

  /**
   * Estimated Duration to build in milliseconds.
   */
  estimatedDuration: int

  /**
   * Full display name of the build. Usually "test #${build_number}"
   */
  fullDisplayName: string

  /**
   * The build id.
   */
  id: string

  /**
   * The build number. Often the same as the id
   */
  number: int

  /**
   * Whether the build was a `SUCCESS`, `FAILURE`, `ABORTED`, `UNSTABLE`
   */
  result: string enum JenkinsBuildResult

  /**
   * The timestamp of when the build starts in milliseconds.
   * You can type `date +%s` in your terminal to see the current timestamp in seconds and compare
   */
  timestamp: int

  /**
   * The url that links to the Jenkins build
   */
  url: string

  /**
   * Information on GitHub commits made on this build
   */
  changeSets: [JenkinsGithub] schema suffix 'JG'
}
