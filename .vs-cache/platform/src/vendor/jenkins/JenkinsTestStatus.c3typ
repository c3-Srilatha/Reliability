/**
 * Information of a single test function within a test file.
 */
enum type JenkinsTestStatus {

  /**
   * An apps test not in c3server has failed
   */
  FAILED

  /**
   * A test in c3server has failed
   */
  REGRESSION

  /**
   * Test passed
   */
  PASSED

  /**
   * Test skipped
   */
  SKIPPED

  /**
   * Test that failed in the previous build is now passing
   */
  FIXED
}
