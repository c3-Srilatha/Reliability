/**
 * A list of all tests within a Test file.
 */
type JenkinsTestCases {

  /**
   * List of Tests that are that are in {@link JenkinsTestCases} name
   */
  cases: [JenkinsTestCase] schema suffix 'CSE'

  /**
   * Name of the Test File. (ie. "c3.analytics.integ.DateHierarchyPopulationTest")
   */
  name: string

  /**
   * Time it takes to run all tests within a Test file in seconds
   */
  duration: double
}
