/**
 * Jenkins job type
 */
type JenkinsJob {

  /**
   * Name of the job
   */
  name: string

  /**
   * Url of the job
   */
  url: string

  /**
   * Builds of the job
   */
  builds: [JenkinsBuild]

  /**
   * Nested jenkins jobs under existing jobs
   */
  jobs: [JenkinsJob]
}
