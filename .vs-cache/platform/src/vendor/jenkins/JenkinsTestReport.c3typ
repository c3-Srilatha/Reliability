/**
 * Test Report of a Jenkins build. Gives us a list of all tests and their failures and successes
 */
type JenkinsTestReport {

  /**
   * Duration to run all tests in Master or Stable in seconds.
   * As of this writing (11/7/2017) Master takes between 3-4 hours to run all tests. Stable takes on average about
   * 20 hours occasionally hitting single digit hours.
   */
  duration: double

  /**
   * Number of tests that failed
   */
  failCount: int

  /**
   * Number of tests that passed
   */
  passCount: int

  /**
   * Number of tests that were skipped
   */
  skipCount: int

  /**
   * List of Test Cases that are group together by test name such as "c3.analytics.integ.DateHierarchyPopulationTest"
   */
  suites: [JenkinsTestCases] schema suffix 'SUT'

  /**
   * @return a pair of all passed and skipped tests along with the associated test class.
   * Useful for repeated lookup based on the test class
   */
  passedAndSkipped: member function(): map<string, Pair<set<string>, set<string>>>
}
