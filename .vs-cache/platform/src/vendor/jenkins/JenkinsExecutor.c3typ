type JenkinsExecutor {

  /**
   * Details of the currently running job, if any.
   */
  currentExecutable: JenkinsCurrentExecutable

  /**
   * Boolean indicating if the executor is idle.
   */
  idle: boolean

  /**
   * Boolean indicating if the job is likely stuck.
   */
  likelyStuck: boolean

  /**
   * Executor ID.
   */
  number: int32

  /**
   * Current progress of the job (if applicable). This is a number between 0 and 100.
   */
  progress: int32
}
