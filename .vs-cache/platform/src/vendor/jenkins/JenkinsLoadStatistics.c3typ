type JenkinsLoadStatistics {

  /**
   * Class name of the object (typically reflects the node type).
   */
  _class: string

  /**
   * Number of executors currently in use.
   */
  busyExecutors: int32

  /**
   * Length of the build queue.
   */
  queueLength: int32

  /**
   * Total length of the build queue.
   */
  totalQueueLength: int32
}
