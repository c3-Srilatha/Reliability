/**
 * Information on build actions such as test failure counts in this build.
 */
// TODO: PLAT-105259 - Implement Ann.Rest#raw for capturing full content of the rest api response
// @rest(raw=true)
// raw: json
type JenkinsBuildAction {

  /**
   * Class of Action on Jenkins side. (ie. hudson.plugins.git.util.BuildData, hudson.tasks.junit.TestResultAction)
   */
  _class: string

  parameters:         [JenkinsBuildParameter] schema suffix 'PAR'
  causes:             json
  buildsByBranchName: json

  /**
   * Number of test failures
   */
  @ser(name='failCount')
  failedCount: int

  /**
   * Number of tests skipped
   */
  @ser(name='skipCount')
  skippedCount: int

  /**
   * total number of tests
   */
  totalCount: int

  /**
   * This field only exists for class name "hudson.tasks.junit.TestResultAction" and by default this value is
   * "testReport"
   */
  urlName: string

  /**
   * For class BadgeSummaryAction
   */
  iconPath: string

  /**
   * For class BadgeSummaryAction
   */
  text: string
}
