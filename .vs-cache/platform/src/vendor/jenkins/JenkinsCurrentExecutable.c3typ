type JenkinsCurrentExecutable {

  /**
   * Class name of the object (typically reflects the executable type).
   */
  _class: string

  /**
   * Indicates if the job is currently being built.
   */
  building: boolean

  /**
   * Duration of the build in seconds.
   */
  duration: int32

  /**
   * Estimated duration of the build in seconds.
   */
  estimatedDuration: int32

  /**
   * Executor ID.
   */
  number: int32

  /**
   * Timestamp of when the build started.
   */
  timestamp: int32

  /**
   * URL of the executable.
   */
  url: string
}
