/**
 * This c3typ represents configuration for  x12 document segment - single data row that consists of 'elements'.
 * The configuration is used to parse document rows (called 'segments') properly, including data integrity checks
 * and field naming for further marshalling to c3typ-ed objects.
 * Also segment schema contains set of element configs to
 * parse corresponding elements in the segment, see SegmentElement.c3typ.
 *
 * @see X12SegmentElement
 */
entity type X12Segment type key 'X12S' schema name 'X12_SEGMENT' {

  /**
   * segment human-readable name.
   */
  x12SegmentName: !string

  /**
   * segment usage in the transaction set/ loop.
   */
  usage: string enum X12ElementUsage

  /**
   * code that is used to distinguish specific segment in the transaction set.
   */
  tag: !string

  /**
   * segment may occur multiple times (one by one) in the same loop, this value defines how often it may happen.
   */
  segmentRepeat: int

  /**
   * segment contents.
   */
  elements: [string] schema suffix 'EL'
}
