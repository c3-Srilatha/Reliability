/**
 * Loop with ID 2000C.
 */
type X12Patient {

  /**
   * HL segment.
   */
  patientHierarchLevel: X12HierarchicalLevel

  /**
   * PAT segment.
   */
  patientInformation: !X12PatientInformation

  /**
   * nested Loop with ID 2010CA.
   */
  patientName: !X12PatientName

  /**
   * nested Loop with ID 2300.
   */
  claimInformation: [X12Claim] schema suffix 'SLN'
}
