/**
 * Loop ID 2310B.
 */
type X12RenderingProvider {

  /**
   * NM1 segment, rendering provider name.
   */
  theName: X12Name

  /**
   * REF segment, rendering provider secondary information.
   */
  secondaryIdentification: X12ReferenceInformation

  /**
   * PRV segment, rendering provider secondary information.
   */
  renderingProviderSpecialtyInformation: X12ProviderInformation
}
