/**
 * Loop with ID 2000B.
 */
type X12Subscriber {

  /**
   * HL segment, subscriber hierarchial level.
   */
  hierarchLevel: !X12HierarchicalLevel

  /**
   * SBR segment, subscriber information.
   */
  subscriberInformation: !X12SubscriberInformation

  /**
   * PAT segment, patient information.
   */
  patientInformation: X12PatientInformation

  /**
   * Nested loop with ID 2010BA, subscriber name.
   */
  subscriberDetails: !X12SubscriberDetails

  /**
   * Nested loop with ID 2010BB, payer name.
   */
  payer: !X12PayerDetails

  /**
   * Nested loop with ID 2300, claim information.
   */
  claimInformation: [X12Claim] schema suffix 'CLM'
}
