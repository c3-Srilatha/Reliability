/**
 * This c3typ represents configuration for  x12 document parser - all the adjustments that are too
 * specific to contain them into a separate type.
 *
 * @see X12Parser
 */
extendable entity type X12ParserProperties type key 'X12PARP' schema name 'X12_PARSER_PROP' {

  /**
   * the EDI document version of the properties set.
   */
  ediVersion: string

  /**
   * mappings on how to match date and time data entities.
   */
  dtpTimeMapping: map<string, string> schema suffix 'DTPM'

  /**
   * set of segments that explicitly state a new loop has started.
   */
  newLoopSegments: [string] schema suffix 'NLS'

  /**
   * set of segments that explicitly state a loop has ended.
   */
  loopTrailingSegments: [string] schema suffix 'LTS'

  /**
   * set of field names for the fields with DATE type.
   */
  dateTimePeriodNames: [string] schema suffix 'DTPS'

  /**
   * a name that object with document metadata should have
   */
  documentMetadataTag: string

  /**
   * a name that object with control data should have
   */
  controlHeaderTag: string

  /**
   * a name of a segment tag with a transaction set start
   */
  documentStartTag: string

  /**
   * a name of a segment tag with a transaction set end
   */
  documentEndTag: string

  /**
   * a name of a segment tag with a hierarchical transaction set start
   */
  beginningHierarchTransactionTag: string

  /**
   * a name of a segment tag with a new hierarchial level start
   */
  hierarchLevelTag: string

  /**
   * qualifier for a date format
   */
  dtpFormatQualifier: string

  /**
   * a preffix for the case the year in a date is represented in YY format not a YYYY
   */
  defaultYyFormatPreffix: string

  /**
   * a separator for the date in rd8, for example "-" is one for the "15111994-15112004" date.
   */
  rd8DtpSeparator: string

  /**
   * a name for a segment loop's key that states specific HL expected
   */
  currentHlTag: string

  /**
   * loop name for a custom rule #1.
   */
  customRule1Loop: string

  /**
   * first segment's name for a custom rule #1.
   */
  customRule1Segment1: string

  /**
   * second segment's name for a custom rule #1.
   */
  customRule1Segment2: string

  /**
   * third segment's name for a custom rule #1.
   */
  customRule1Segment3: string

  /**
   * fourth segment's name for a custom rule #1.
   */
  customRule1Segment4: string

  /**
   * names for date period boundaries when period occurs.
   */
  periodBoundariesNames: [string] schema suffix 'PER'
}
