/**
 * Loop with ID 2400.
 */
type X12ServiceLineNumber {

  /**
   * LX segment, service line number.
   */
  serviceLineNumber: X12ServiceLineNum

  /**
   * SV1 segment, professional service.
   */
  professionalService: X12ProfessionalService

  /**
   * SV2 segment, institutional service line.
   */
  institutionalService: X12InstitutionalService

  /**
   * SV2 segment, institutional service line.
   */
  durableMedicalEquipmentService: X12DurableMedicalEquipmentService

  /**
   * PWK segment, line supplemental information.
   */
  lineSupplementalInformation: X12Paperwork

  /**
   * PWK segment, durable medical equipment certificate of medical necessity indicator.
   */
  durMedEqSertifOfMedNecessInd: X12Paperwork

  /**
   * Segment CR1.
   */
  ambulanceTransportInformation: X12AmbulanceCertification

  /**
   * Segment CR3.
   */
  durableMedicalEquipmentCertification: X12DurableMedicalEquipmentCertification

  /**
   * Segment CRC.
   */
  ambulanceCertification: X12ConditionsIndicator

  /**
   * Segment CRC.
   */
  hospiceEmloyeeIndicator: X12ConditionsIndicator

  /**
   * Segment CRC, conditions indicator durable medical equipment
   */
  conditionsIndicatorDurMedEquipment: X12ConditionsIndicator

  /**
   * DTP segment.
   */
  serviceDate: X12DateTime | X12DateTimePeriod

  /**
   * DTP segment.
   */
  prescriptionDate: X12DateTime

  /**
   * DTP segment, certification revision / recertification date
   */
  certRevRecertDate: X12DateTime

  /**
   * DTP segment.
   */
  beginTherapyDate: X12DateTime

  /**
   * DTP segment.
   */
  lastCertificationDate: X12DateTime

  /**
   * DTP segment.
   */
  lastSeenDate: X12DateTime

  /**
   * DTP segment.
   */
  testDate: X12DateTime

  /**
   * DTP segment.
   */
  shippedDate: X12DateTime

  /**
   * DTP segment.
   */
  lastXRayDate: X12DateTime

  /**
   * DTP segment.
   */
  initialTreatmentDate: X12DateTime

  /**
   * QTY segment.
   */
  ambulancePatientCount: X12Quantity

  /**
   * QTY segment.
   */
  obstetricAnesthesiaAdditionalUnit: X12Quantity

  /**
   * MEA segment.
   */
  testResult: X12Measurements

  /**
   * Segment CN1.
   */
  contractInformation: X12ContractInformation

  /**
   * REF segment.
   */
  lineItemControlNumber: X12ReferenceInformation

  /**
   * REF segment.
   */
  repricedLineItemReferenceNumber: X12ReferenceInformation

  /**
   * REF segment.
   */
  adjustedRepricedLineItemReferenceNumber: X12ReferenceInformation

  /**
   * REF segment.
   */
  priorAuthorization: X12ReferenceInformation

  /**
   * REF segment.
   */
  mammographyCertificationNumber: X12ReferenceInformation

  /**
   * Segment REF, clinical laboratory improvement amendment (CLIA) number.
   */
  cliaNumber: X12ReferenceInformation

  /**
   * Segment REF, referring clinical laboratory improvement amendment (CLIA) facility identification.
   */
  referringCliaFacilityId: X12ReferenceInformation

  /**
   * Segment REF.
   */
  immunizationBatchNumber: X12ReferenceInformation

  /**
   * Segment REF.
   */
  referralNumber: X12ReferenceInformation

  /**
   * AMT segment.
   */
  salesTaxAmount: X12MonetaryAmountInformation

  /**
   * AMT segment.
   */
  postageClaimedAmount: X12MonetaryAmountInformation

  /**
   * AMT segment.
   */
  serviceTaxAmount: X12MonetaryAmountInformation

  /**
   * AMT segment.
   */
  facilityTaxAmount: X12MonetaryAmountInformation

  /**
   * Segment K3.
   */
  fileInformation: X12FileInformation

  /**
   * Segment NTE.
   */
  lineNote: X12NoteInstruction

  /**
   * Segment NTE.
   */
  thirdPartyOrganizationNotes: X12NoteInstruction

  /**
   * Segment HCP.
   */
  linePricingRepricingInformation: X12HealthcarePricing

  /**
   * Segment PS1.
   */
  purchasedServiceInformation: X12PurchaseService

  /**
   * Nested loop with ID 2410.
   */
  drugIdentification: X12DrugIdentification

  /**
   * Nested loop with ID 2420A for X223 revision.
   */
  operatingPhysician: X12NameInformation

  /**
   * Loop with ID 2420B for X222 revision.
   */
  purchaseServiceProvider: X12NameInformation

  /**
   * Nested loop with ID 2420B for X223 revision.
   */
  otherOperatingPhysician: X12NameInformation

  /**
   * Nested loop with ID 2420C for X223 revision or 2420A for X222 revision..
   */
  renderingProvider: X12NameInformation

  /**
   * Nested loop with ID 2420C for X222 revision.
   */
  serviceFacilityLocation: X12ServiceFacilityLocation

  /**
   * Nested loop with ID 2420D for X223 revision or 2420F for X223 revision.
   */
  referringProviders: [X12NameInformation]

  /**
   * Nested loop with ID 2420D for X222 revision
   */
  supervisingProvider: X12NameInformation

  /**
   * Nested loop with ID 2420E for X222 revision
   */
  orderingProvider: X12OrderingProviderContactInformation

  /**
   * Nested loop with ID 2420G for X222 revision
   */
  ambulancePickUpLocation: X12Location

  /**
   * Nested loop with ID 2420H for X222 revision
   */
  ambulanceDropOffLocation: X12Location

  /**
   * Nested loop with ID 2430.
   */
  lineAdjudicationInformation: [X12LineAdjudicationInformation] schema suffix 'LAI'

  /**
   * Nested loop with ID 2440.
   */
  formIdentificationCodes: [X12FormIdentificationCode] schema suffix 'FIC'
}
