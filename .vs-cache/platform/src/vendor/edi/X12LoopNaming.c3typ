/**
 * This c3typ represents configuration for x12 document loops' naming -
 * mappings between loops in the document and corresponding business entities.
 *
 * @see X12Loop
 */
entity type X12LoopNaming type key 'X12LN' schema name 'X12_LOOP_NMNG' {

  /**
   * EDI versions thst use the naming.
   */
  ediVersions: [string] schema suffix 'VER'

  /**
   * mappings - loop name to an entity name, like "1000A" : "submitter"
   */
  entityByLoopName: map<string, string> schema suffix 'MAP'
}
