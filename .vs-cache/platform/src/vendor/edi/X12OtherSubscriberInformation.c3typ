/**
 * Loop with ID 2320.
 */
type X12OtherSubscriberInformation {

  /**
   * SBR segment.
   */
  otherSubscriberInformation: X12SubscriberInformation

  /**
   * CAS segment.
   */
  claimLevelAdjustment: X12ClaimsAdjustment

  /**
   * AMT segment.
   */
  cobPayerPaidAmount: X12MonetaryAmountInformation

  /**
   * AMT segment.
   */
  remainingPatientLiability: X12MonetaryAmountInformation

  /**
   * AMT segment.
   */
  cobTotalNonCoveredAmount: X12MonetaryAmountInformation

  /**
   * OI segment.
   */
  otherInsuranceCoverageInformation: !X12OtherHealthcareInfo

  /**
   * MIA segment.
   */
  inpatientAdjudicationInformation: X12MedicareInpatientAdjudication

  /**
   * MOA segment.
   */
  outpatientAdjudicationInformation: X12MedicareOutpatientAdjudication

  /**
   * nested loop with ID 2330A.
   */
  otherSubscriber: X12OtherSubscriberName

  /**
   * nested loop with ID 2330B.
   */
  otherPayer: X12OtherPayerName

  /**
   * nested loop with ID 2330C.
   */
  otherPayerAttendingProvider: X12NameInformation

  /**
   * nested loop with ID 2330D.
   */
  otherPayerOperatingPhysician: X12NameInformation

  /**
   * nested loop with ID 2330E.
   */
  otherPayerOtherOperatingPhysician: X12NameInformation

  /**
   * nested loop with ID 2330F.
   */
  otherPayerServiceFacilityLocation: X12NameInformation

  /**
   * nested loop with ID 2330G.
   */
  otherPayerRenderingProvider: X12NameInformation

  /**
   * nested loop with ID 2330H.
   */
  otherPayerReferringProvider: X12NameInformation

  /**
   * nested loop with ID 2330I.
   */
  otherPayerBillingProvider: X12NameInformation
}
