/**
 * Loop 2300.
 */
type X12Claim {

  /**
   * Segment CLM.
   */
  claimInformation: !X12HealthClaim

  /**
   * Segment DTP.
   */
  dischargeHour: X12DateTime

  /**
   * Segment DTP.
   */
  statementDates: X12DateTimePeriod

  /**
   * Segment DTP.
   */
  admissionDateHour: X12DateTime

  /**
   * Segment DTP.
   */
  onsetOfCurrentIllnessOrSymptomDate: X12DateTime

  /**
   * Segment DTP.
   */
  initialTreatmentDate: X12DateTime

  /**
   * Segment DTP.
   */
  lastSeenDate: X12DateTime

  /**
   * Segment DTP.
   */
  acuteManifestationDate: X12DateTime

  /**
   * Segment DTP.
   */
  accidentDate: X12DateTime

  /**
   * Segment DTP.
   */
  lastMenstrualPeriodDate: X12DateTime

  /**
   * Segment DTP.
   */
  lastXRayDate: X12DateTime

  /**
   * Segment DTP.
   */
  hearingAndVisionPrescriptionDate: X12DateTime

  /**
   * Segment DTP.
   */
  disabilityDates: X12DateTimePeriod

  /**
   * Segment DTP.
   */
  lastWorked: X12DateTime

  /**
   * Segment DTP.
   */
  authorizedReturnToWork: X12DateTime

  /**
   * Segment DTP.
   */
  admissionDate: X12DateTime

  /**
   * Segment DTP.
   */
  dischargeDate: X12DateTime

  /**
   * Segment DTP.
   */
  assumedAndRelinquishedCareDates: [X12DateTime] schema suffix 'ARCD'

  /**
   * Segment DTP.
   */
  propertyAndCasualtyDateOfFirstContact: X12DateTime

  /**
   * Segment DTP.
   */
  repricerReceivedDate: X12DateTime

  /**
   * Segment CL1.
   */
  institutionalClaimCode: X12ClaimCodes

  /**
   * Segment PWK.
   */
  claimSupplementalInformation: X12Paperwork

  /**
   * Segment CN1.
   */
  contractInformation: X12ContractInformation

  /**
   * Segment AMT.
   */
  patientAmountPaid: X12MonetaryAmountInformation

  /**
   * Segment AMT.
   */
  patientEstimatedAmountDue: X12MonetaryAmountInformation

  /**
   * Segment REF.
   */
  serviceAuthorizationExceptionCode: X12ReferenceInformation

  /**
   * Segment REF, mandatory medicare (section 4081) crossover indicator.
   */
  mandatoryMedicareCrossoverInd: X12ReferenceInformation

  /**
   * Segment REF.
   */
  mammographyCertificationNumber: X12ReferenceInformation

  /**
   * Segment REF.
   */
  referralNumber: X12ReferenceInformation

  /**
   * Segment REF.
   */
  priorAuthorization: X12ReferenceInformation

  /**
   * Segment REF.
   */
  payerClaimControlNumber: X12ReferenceInformation

  /**
   * Segment REF, clinical laboratory improvement amendment (CLIA) number.
   */
  cliaNumber: X12ReferenceInformation

  /**
   * Segment REF.
   */
  repricedClaimNumber: X12ReferenceInformation

  /**
   * Segment REF.
   */
  adjustedRepricedClaimNumber: X12ReferenceInformation

  /**
   * Segment REF.
   */
  investigationalDeviceExemptionNumber: X12ReferenceInformation

  /**
   * Segment REF.
   */
  claimIdentifierForTransmissionIntermediaries: X12ReferenceInformation

  /**
   * Segment REF.
   */
  autoAccidentState: X12ReferenceInformation

  /**
   * Segment REF.
   */
  medicalRecordNumber: X12ReferenceInformation

  /**
   * Segment REF.
   */
  demonstrationProjectIdentifier: X12ReferenceInformation

  /**
   * Segment REF.
   */
  carePlanOversight: X12ReferenceInformation

  /**
   * Segment REF.
   */
  peerReviewOrganizationApprovalNumber: X12ReferenceInformation

  /**
   * Segment K3.
   */
  fileInformation: X12FileInformation

  /**
   * Segment NTE.
   */
  claimNotes: [X12NoteInstruction] schema suffix 'CLNT'

  /**
   * Segment NTE.
   */
  billingNote: X12NoteInstruction

  /**
   * Segment CR1.
   */
  ambulanceTransportInformation: X12AmbulanceCertification

  /**
   * Segment CR2.
   */
  spinalManipulationServiceInformation: X12ChiropracticCertification

  /**
   * Segment CRC.
   */
  ambulanceCertification: X12ConditionsIndicator

  /**
   * Segment CRC.
   */
  conditionsIndicator: X12ConditionsIndicator

  /**
   * Segment CRC.
   */
  homeboundIndicator: X12ConditionsIndicator

  /**
   * Segment CRC.
   */
  epsdtReferral: X12ConditionsIndicator

  /**
   * Segment HI.
   */
  principalDiagnosis: X12HealthcareInformation

  /**
   * Segment HI.
   */
  admittingDiagnosis: X12HealthcareInformation

  /**
   * Segment HI.
   */
  patientsReasonForVisit: X12HealthcareInformation

  /**
   * Segment HI.
   */
  externalCauseOfInjury: X12HealthcareInformation

  /**
   * Segment HI.
   */
  diagnosisRelatedGroupInformation: X12HealthcareInformation

  /**
   * Segment HI.
   */
  otherDiagnosisInformation: X12HealthcareInformation

  /**
   * Segment HI.
   */
  principalProcedureInformation: X12HealthcareInformation

  /**
   * Segment HI.
   */
  otherProcedureInformation: X12HealthcareInformation

  /**
   * Segment HI.
   */
  occurrenceSpanInformation: X12HealthcareInformation

  /**
   * Segment HI.
   */
  occurrenceInformation: X12HealthcareInformation

  /**
   * Segment HI.
   */
  valueInformation: X12HealthcareInformation

  /**
   * Segment HI.
   */
  conditionInformation: X12HealthcareInformation

  /**
   * Segment HI.
   */
  treatmentCodeInformation: X12HealthcareInformation

  /**
   * Segment HI.
   */
  anesthesiaRelatedProcedure: X12HealthcareInformation

  /**
   * Segment HCP
   */
  claimPricingRepricingInformation: X12HealthcarePricing

  /**
   * Loop with ID 2310A for X223 revision
   */
  attendingProvider: X12AttendingProvider

  /**
   * Loop with ID 2310B for X223 revision
   */
  operatingPhysician: X12NameInformation

  /**
   * Loop with ID 2310C for X223 revision
   */
  otherOperatingPhysician: X12NameInformation

  /**
   * Loop with ID 2310D for X223 revision or 2310B for X222 revision
   */
  renderingProvider: X12RenderingProvider

  /**
   * Loop with ID 2310E for X223 revision or 2310C for X222 revision
   */
  serviceFacilityLocation: X12ServiceFacilityLocation

  /**
   * Loop with ID 2310F for X223 revision or 2310A for X222 revision
   */
  referringProvider: X12NameInformation

  /**
   * Loop with ID 2310D for X222 revision
   */
  supervisingProviderName: X12NameInformation

  /**
   * Loop with ID 2310E for X222 revision
   */
  ambulancePickUpLocation: X12Location

  /**
   * Loop with ID 2310F for X222 revision
   */
  ambulanceDropOffLocation: X12Location

  /**
   * Loop with ID 2320
   */
  otherSubscriberInformation: [X12OtherSubscriberInformation] schema suffix 'SUB'

  /**
   * Loop with ID 2400
   */
  serviceLineNumbers: [X12ServiceLineNumber] schema suffix 'SLN'
}
