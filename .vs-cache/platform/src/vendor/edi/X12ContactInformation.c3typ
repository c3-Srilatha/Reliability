/**
 * Administrative communication contact is used to identify a person or office
 * to whom administrative communications should be directed.
 * PER segment.
 */
type X12ContactInformation {

  /**
   * Code identifying the major duty or responsibility of the person or group named.
   */
  informationContact: !string

  /**
   * A free-form name.
   */
  freeFormName: string

  /**
   * Code identifying the type of communication number.
   */
  communicationNumberQualifiers: [string] schema suffix 'CNQ'

  /**
   * Complete communications number including country or area code when applicable.
   */
  communicationNumbers: [string] schema suffix 'CN'

  /**
   * A contact inquiry reference.
   */
  contactInquiryReference: string
}
