/**
 * Loop with ID 2010CA.
 */
type X12PatientName {

  /**
   * NM1 segment, a patient name.
   */
  theName: !X12Name

  /**
   * N3/N4 segment, a patient address including city, state, and ZIP code.
   */
  address: !X12Address

  /**
   * DMG segment, patient demographic information.
   */
  demographicInformation: !X12DemographicInformation

  /**
   * REF segment.
   */
  propertyAndCasualtyClaimNumber: X12ReferenceInformation

  /**
   * REF segment.
   */
  propertyAndCasualtyPatientIdentifier: X12ReferenceInformation

  /**
   * PER segment, property and casualty patient contact information.
   */
  propertyAndCasualtyContactInformation: X12ContactInformation
}
