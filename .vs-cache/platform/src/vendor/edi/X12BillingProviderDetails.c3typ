/**
 * Loop 2010AA.
 */
type X12BillingProviderDetails {

  /**
   * Segment NM1.
   */
  theName: !X12Name

  /**
   * Segments N3 & N4.
   */
  address: !X12Address

  /**
   * Segment REF.
   */
  taxIdentification: !X12ReferenceInformation

  /**
   * Segment REF, a billing provider UPIN/ license information.
   */
  upinLicenseInformation: [X12ReferenceInformation] schema suffix 'UPIN'

  /**
   * Segment PER.
   */
  contactInformation: [X12ContactInformation] schema suffix 'CN'
}
