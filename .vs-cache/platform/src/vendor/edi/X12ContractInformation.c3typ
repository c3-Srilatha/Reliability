/**
 * Contract Information is used to specify basis data about the contract or contract line item.
 * CN1 segment.
 */
type X12ContractInformation {

  /**
   * Code identifying a contract type.
   */
  contractTypeCode: string

  /**
   * Monetary amount.
   */
  monetaryAmount: double

  /**
   * Percent given in decimal format.
   */
  percentDecimalFormat: double

  /**
   * Reference information as defined for a particular Transaction Set or s specified by the reference Identification Qualifier.
   */
  referenceIdentification: double

  /**
   * Trms discount percentage, expressed as a percent, available to the purchaserif an invoice is paid on or before the Terms Discount Due Date.
   */
  termsDiscountPercent: double

  /**
   * Revision level of a particular format, program, technique or algorithm.
   */
  versionIdentifier: string
}
