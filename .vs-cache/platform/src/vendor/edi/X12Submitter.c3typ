/**
 * Loop with ID 1000A.
 */
type X12Submitter {

  /**
   * NM1 segment, submitter name.
   */
  theName: !X12Name

  /**
   * PER segment, submitter EDI contact information.
   */
  contactInformation: !X12ContactInformation
}
