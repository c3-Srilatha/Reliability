/**
 * Composite element rule is a rule specifying how to process composite segment element of a specific segment.
 */
entity type X12CompositeElementRule type key 'X12CESR' schema name 'X12_COMP_EL_R' {

  /**
   * name of the element that is being checked by the rule.
   */
  el: string

  /**
   * aet of element values allowed by the rule.
   */
  values: [string] schema suffix 'VAL'

  /**
   * usage of every specific element. 'Not Used' if any record is present.
   */
  elementUsage: map<string, string> schema suffix 'USG'

  /**
   * c3typ name to map on in case the rule worked.
   */
  nm: !string

  /**
   * name of the segment.
   */
  segmentName: string
}
