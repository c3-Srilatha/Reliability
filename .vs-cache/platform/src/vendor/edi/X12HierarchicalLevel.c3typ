/**
 * HL - Patient hierarchal level
 * Identifies levels of detain information using a hierarchical structure.
 */
type X12HierarchicalLevel {

  /**
   * A unique number assigned by the sender to identify a particular data
   * segment in a hierarchical structure (HL01)
   */
  hierarchIdNumber: string

  /**
   * Identification number of the next higher hierarchical data segment that
   * the data segment being described is subordinate to (HL02)
   */
  hierarchParentId: string

  /**
   * Code defining the characteristic of a level in a hierarchical structure (HL03)
   */
  hierarchLevelCode: string

  /**
   * Code indicating if there are hierarchical child data segments
   * subordinate to the level being described (HL04)
   */
  hierarchChildCode: string
}
