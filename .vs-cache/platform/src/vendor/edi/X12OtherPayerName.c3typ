/**
 * Loop with ID 2330B.
 */
type X12OtherPayerName {

  /**
   * NM1 segment.
   */
  theName: !X12Name

  /**
   * N3/N4 segment.
   */
  address: X12Address

  /**
   * DTP segment.
   */
  claimCheckRemittanceDate: X12DateTime

  /**
   * REF segment.
   */
  secondaryIdentification: X12ReferenceInformation

  /**
   * REF segment.
   */
  priorAuthorizationNumber: X12ReferenceInformation

  /**
   * REF segment.
   */
  referralNumber: X12ReferenceInformation

  /**
   * REF segment.
   */
  claimAdjustmentIndicator: X12ReferenceInformation

  /**
   * REF segment.
   */
  controlNumber: X12ReferenceInformation
}
