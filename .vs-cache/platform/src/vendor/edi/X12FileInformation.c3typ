/**
 * File information transmits a fixed-format record or matrix contents.
 * K3 segment.
 */
type X12FileInformation {

  /**
   * A fixed file information.
   */
  fixedFormatInformation: string

  /**
   * A record format code.
   */
  recordFormatCode: string

  /**
   * A composite unit of measure.
   */
  compositeUnitOfMeasure: string
}
