/**
 * Medicare inpatient adjudication provides claim-level data related to the
 * adjudication of Medicare inpatient claims.
 * MIA segment.
 */
type X12MedicareInpatientAdjudication {

  /**
   * Numeric value of quantity.
   */
  quantities: [double] schema suffix 'Q'

  /**
   * A monetary amount.
   */
  monetaryAmounts: [double] schema suffix 'MA'

  /**
   * Reference information as defined for a particular Transaction Set
   * or as specified by the Reference Identification Qualifier.
   */
  referenceIdentifications: [string] schema suffix 'RI'
}
