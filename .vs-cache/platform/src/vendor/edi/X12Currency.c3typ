/**
 *   Foreign currency information is used to specify the currency used in a transaction - dollars, pounds, francs etc.
 * "  CUR segment.
 */
type X12Currency {

  /**
   * Code identifying an organization entity, a physical location, property or an individual.
   */
  entityIdentifierCodes: [string] schema suffix 'EIC'

  /**
   * Standard ISO code for country in whose currency the charges are specified.
   */
  currencyCodes: [string] schema suffix 'CC'

  /**
   * An exchange rate.
   */
  exchangeRate: double

  /**
   * A currency market exchange code.
   */
  currencyMarketExchangeCode: string
}
