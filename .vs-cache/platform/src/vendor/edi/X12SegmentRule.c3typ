/**
 * This c3typ represents configuration for  x12 document segment's rule - piece of data integrity information.
 * It defines either applicable values set for a specific segment's element or more context-dependent check, for
 * example based on values in control header (a document metadata).
 *
 * @see X12SegmentElement
 */
entity type X12SegmentRule type key 'X12SR' schema name 'X12_SEGM_RULE' {

  /**
   * rule name from the documentation. May be simply a segment element's reference.
   */
  ruleName: !string

  /**
   * code of the segment the rule defined for.
   */
  segmentName: !string

  /**
   * defines whether the rule is a conditional one.
   */
  conditional: string

  /**
   * rule type, that defines gow to apply the rule using its params.
   */
  ruleType: !string enum X12SegmentRuleType

  /**
   * parameters the rule is applied with.
   * Check out @SegmentRuleType to decode these.
   */
  ruleAttributes: [string] schema suffix 'ATTR'

  /**
   * set of sub-rules that are used as conditions for the parent rule, defined as a list of rule names.
   * Check out @SegmentRuleType to decode these.
   */
  conditions: [string] schema suffix 'COND'
}
