/**
 * A health care claim.
 */
type X12EdiDocument {

  /**
   * Document metadata from the document's property segments - ST, BHT and SE.
   */
  documentMetadata: !X12DocumentMeta

  /**
   * Document metadata from the control headers, including functional group and interchange.
   */
  controlHeader: !X12ControlHeader

  /**
   * Loop with ID 1000A.
   */
  submitter: !X12Submitter

  /**
   * Loop with ID 1000B.
   */
  receiver: !X12Receiver

  /**
   * Loop with ID 2000A.
   */
  billingProviders: [X12BillingProvider] schema suffix 'BP'

  /**
   * Loop with ID 2000B.
   */
  subscribers: [X12Subscriber] schema suffix 'SUB'

  /**
   * Loop with ID 2000C.
   */
  patients: [X12Patient] schema suffix 'PAT'
}
