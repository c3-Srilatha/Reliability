/**
 * Supplies demographic information.
 * DMG segment.
 */
type X12DemographicInformation {

  /**
   * Code indicating the date format, time format, or date and time format.
   */
  dateTimePeriodFormatQualifier: string

  /**
   * Expression of a date, a time, or range of dates, times or dates and times.
   */
  subscriberBirthDate: datetime

  /**
   * Code indicating the sex of the individual.
   */
  subscriberGenderCode: string

  /**
   * A marital status code.
   */
  maritalStatusCode: string

  /**
   * A composite race ethnicity information.
   */
  compositeRaceEthnicityInformation: string

  /**
   * A citizen status code.
   */
  citizenStatusCode: string

  /**
   * A country code.
   */
  countryCode: string

  /**
   * The basis of verification code.
   */
  basisOfVerificationCode: string

  /**
   * A numeric quantity.
   */
  quantity: double

  /**
   * A code list qualifier code.
   */
  codeListQualifierCode: string

  /**
   * An industry code.
   */
  industryCode: string
}
