/**
 * Conditions indicator, used to supply information on conditions.
 * CRC segment.
 */
type X12ConditionsIndicator {

  /**
   * Specifies the situation or category to which the code applies.
   */
  codeCategory: string

  /**
   * Code indicating a Yes ('Y') or No ('N') condition or response.
   */
  responseCode: string

  /**
   * Code indicating a condition.
   */
  conditionIndicators: [string] schema suffix 'CI'
}
