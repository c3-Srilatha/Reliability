/**
 * Health care code information sends health care codes and their associated dates, amounts and quantities.
 * A C022 composite segment element.
 */
type X12HealthCareInformationEntity {

  /**
   * Code identifying a specific industry code list.
   */
  codeListQualifierCode: string

  /**
   * Code indicating a code from a specific industry code list.
   */
  industryCode: string

  /**
   * Code identifying a Yes or No condition or response.
   */
  responseCode: string

  /**
   * A monetary amount.
   */
  monetaryAmount: double

  /**
   * Expression of a date, time or a date and a time.
   */
  dateTime: datetime

  /**
   * Expression of the start of a range of dates, times or dates and times.
   */
  periodStart: datetime

  /**
   * Expression of the end of a range of dates, times or dates and times.
   */
  periodEnd: datetime

  /**
   * A date format qualifier.
   */
  dateTimePeriodFormatQualifier: string
}
