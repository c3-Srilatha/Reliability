/**
 * Identifies one or more reference numbers or identification numbers as specified by the Reference Qualifier.
 * It is a composite segment element of a Reference Information segment (REF), data element C040.
 */
type X12CompositeReferenceIdentifier {

  /**
   * Code qualifying the reference identification.
   */
  referenceIdentificationQualifier: string

  /**
   * ReferenceInformation as defined for a particular Transaction Set
   * or as specified by the Reference Identification Qualifier.
   */
  referenceIdentification: string
}
