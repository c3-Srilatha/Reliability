/**
 * Institutional claim code supplies information specific to hospital claims.
 */
type X12InstitutionalClaimCode {

  /**
   * Code indicating the priority of this admission.
   */
  admissionTypeCode: string

  /**
   * Code indicating the source of this admission.
   */
  admissionSourceCode: string

  /**
   * Code indicating patient status as of the "statement covers through date".
   */
  patientStatusCode: string

  /**
   * A nursing home residential status code.
   */
  nursingHomeResidentalStatusCode: string
}
