/**
 * Item identification specifies basic item identification data.
 * LIN segment.
 */
type X12ItemIdentification {

  /**
   * An item identification.
   */
  assignedIdentification: string

  /**
   * Code identifying the type/source of the descriptive number used in Product/Service ID.
   */
  productServiceIdQualifiers: [string] schema suffix 'PS'

  /**
   * Identifying number of a product or service.
   */
  productServiceIds: [string] schema suffix 'PSI'
}
