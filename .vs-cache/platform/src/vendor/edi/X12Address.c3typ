/**
 * Geographic location.
 * N3 + N4 segments.
 */
type X12Address {

  /**
   * Address information, set of address lines.
   */
  addressInformation: [string] schema suffix 'AI'

  /**
   * Free-form for city name.
   */
  cityName: string

  /**
   * Standard state/province code as defined by appropriate government agency.
   */
  stateOfProvinceCode: string

  /**
   * Code defining international postal zone code excluding punctuation and blanks (zip code for the US).
   */
  postalCode: string

  /**
   * Code identifying the country.
   */
  countryCode: string

  /**
   * A location qualifier.
   */
  locationQualifier: string

  /**
   * A location identifier.
   */
  locationIdentifier: string

  /**
   * Represents administrative subdivisions.
   * Used for the cases territory is outside Canada or the USA (including territories).
   */
  countrySubdivisionCode: string
}
