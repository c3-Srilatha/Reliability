/**
 * Durable medical equipment certification supplies information regarding a physician's certification for durable
 * medical equipment.
 * CR3 segment.
 */
type X12DurableMedicalEquipmentCertification {

  /**
   * Code indicating the type of certification.
   */
  certificationTypeCode: string

  /**
   * Unit Or Basis For Measurement Code specifying the units in which a value is being expressed,
   * or manner in which a measurement has been taken.
   */
  unitBasisMeasurementCode: string

  /**
   * Numeric value of quantity.
   */
  durableMedicalEquipmentDuration: double

  /**
   * Corresponds to CR304.
   */
  insulinDependentCode: string

  /**
   * Corresponds to CR304.
   */
  description: string
}
