/**
 * Specifies information in response to a codified questionnaire document.
 * FRM segment.
 */
type X12SupportingDocumentation {

  /**
   * Alphanumeric characters assigned for differentiation within a transaction set.
   */
  questionNumberLetter: string

  /**
   * code indicating yes or no condition or response.
   */
  questionResponseCode: string

  /**
   * reference information as defined for a particular Transaction Set
   * or as specified by the Reference Identification Qualifier.
   */
  questionResponseReferenceIdentification: string

  /**
   * A date, corresponds to FRM04.
   */
  questionResponseDate: datetime

  /**
   * Percent given in decimal format, corresponds to FRM05.
   */
  percentDecimalFormatQuestionResponse: double
}
