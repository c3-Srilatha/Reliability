/**
 * This c3typ represents configuration for  x12 document segment's loop rule - a piece of business information
 * to define whether specific segment belongs to a specific rule.
 *
 * @see X12SegmentElement
 */
entity type X12SegmentLoopRule type key 'X12SLR' schema name 'X12_SEGM_L_RULE' {

  /**
   * loop name from the documentation.
   */
  loopName: !string

  /**
   * code of the segment the rule defined for.
   */
  segmentName: !string

  /**
   * name of the property that should be assigned if the rule worked.
   */
  nm: !string

  /**
   * segment element usage's override for the specific loop
   */
  usage: string

  /**
   * doc revision for the case the rule is applicable only for a specific set of EDI doc revisions.
   */
  ediVersions: ![string] schema suffix 'VER'

  /**
   * pre-conditions that must be met before applying the rule.
   */
  preConditions: map<string, string> schema suffix 'MPC'

  /**
   * segment element's reference.
   */
  el: int

  /**
   * list of applicable element values.
   */
  values: [string] schema suffix 'VAL'
}
