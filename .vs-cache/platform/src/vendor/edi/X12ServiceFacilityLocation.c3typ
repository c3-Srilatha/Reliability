/**
 * The Loop with ID 2310E.
 */
type X12ServiceFacilityLocation {

  /**
   * NM1 segment, a service facility location name.
   */
  theName: X12Name

  /**
   * N3/N4 segments, a service facility location address including city, state, and ZIP code.
   */
  address: !X12Address

  /**
   * REF segment, a service facility location secondary identification.
   */
  secondaryIdentification: X12ReferenceInformation
}
