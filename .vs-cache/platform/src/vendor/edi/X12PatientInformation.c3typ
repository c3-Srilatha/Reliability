/**
 * Supplies patient information.
 * PAT segment.
 */
type X12PatientInformation {

  /**
   * Specifies the patient's relationship to the person insured.
   */
  individualRelationshipCode: string

  /**
   * Corresponds to PAT02.
   */
  patientLocationCode: string

  /**
   * Corresponds to PAT03.
   */
  employmentStatusCode: string

  /**
   * Corresponds to PAT04.
   */
  studentStatusCode: string

  /**
   * Expression of a date.
   */
  patientDeathDate: datetime

  /**
   * Code indicating the date format, time format, or date and time format.
   */
  dateTimePeriodFormatQualifier: string

  /**
   * Corresponds to PAT07.
   */
  unitOfBasisForMeasurementCode: string

  /**
   * Corresponds to PAT08.
   */
  weight: double

  /**
   * Corresponds to PAT09.
   */
  responseCode: string
}
