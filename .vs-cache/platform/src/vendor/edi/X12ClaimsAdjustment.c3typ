/**
 * Claims adjustment is used to supply adjustment reason codes and amounts as needed for an entire claim or
 * for a particular service within the claim being paid.
 * CAS segment.
 */
type X12ClaimsAdjustment {

  /**
   * Code identifying the general category of payment adjustment.
   */
  claimAdjustmentGroupCode: string

  /**
   * Code identifying the detailed reason the adjustment was made.
   */
  claimAdjustmentReasonCodes: [string] schema suffix 'CA'

  /**
   * Monetary amount.
   */
  monetaryAmounts: [double] schema suffix 'MA'

  /**
   * Numeric value of quantity.
   */
  quantities: [double] schema suffix 'Q'
}
