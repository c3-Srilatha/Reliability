/**
 * Professional service specifies the service line item detail for a health care professional.
 * SV1 segment.
 */
type X12ProfessionalService {

  /**
   * Identifies a medical procedure by its standardized codes and applicable modifiers.
   */
  compositeMedicalProcedureIdentifier: X12CompositeMedicalProcedureIdentifier

  /**
   * The local charge amount for this service line. The amount is inclusive of the provider's charge and any
   * applicable tax and/or postage claimed amounts reported within this line's AMT segments.
   */
  lineItemChargeAmount: double

  /**
   * Code specifying the units in which a value is being expressed, or manner in which a measurement has been taken.
   */
  unitOrBasisForMeasurementCode: string

  /**
   * Numeric value of quantity.
   */
  serviceUnitCount: double

  /**
   * Code identifying where services were, or may be, performed; the first and second positions of
   * the Uniform Bill Type Code for Institutional Services or the Place of Service Codes
   * for Professional or Denial Services.
   */
  placeOfServiceCode: string

  /**
   * Corresponds to SV106.
   */
  serviceTypeCode: string

  /**
   * Corresponds to SV106.
   */
  compositeDiagnosisCodePointer: X12CompositeDiagnosisCodePointer

  /**
   * A monetary amount
   */
  monetaryAmounts: [double] schema suffix 'MA'

  /**
   * A yes/no condition or response code.
   */
  responseCodes: [string] schema suffix 'RC'

  /**
   * Corresponds to SV110.
   */
  multipleProcedureCode: string

  /**
   * Corresponds to SV113.
   */
  reviewCode: string

  /**
   * Corresponds to SV114.
   */
  nationalOrLocalAssignedReviewVaue: string

  /**
   * Code indicating whether or not co-payment requirements were met on a line by line basis.
   */
  copayStatusCode: string

  /**
   * Corresponds to SV116.
   */
  healthCareProfessionalShortageAreaCode: string

  /**
   * Corresponds to SV117.
   */
  referenceIdentifiation: string

  /**
   * Corresponds to SV118.
   */
  postalCode: string

  /**
   * Corresponds to SV120.
   */
  levelOfCareCode: string

  /**
   * Corresponds to SV121.
   */
  providerAgreementCode: string
}
