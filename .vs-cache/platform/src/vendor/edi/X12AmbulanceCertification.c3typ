/**
 * AmbulanceCertification supplies information related to the ambulance service rendered to a patient.
 */
type X12AmbulanceCertification {

  /**
   * Unit Or Basis For Measurement Code specifying the units in which a value is being expressed,
   * or manner in which a measurement has been taken.
   */
  unitBasisMeasurementCodes: [string] schema suffix 'UBMC'

  /**
   * Numeric value of weight.
   */
  weight: double

  /**
   * Corresponds to CR103.
   */
  ambulanceTransportCode: string

  /**
   * Code indicating the reason for ambulance transport.
   */
  ambulanceTransportReasonCode: string

  /**
   * Numeric value of quantity.
   */
  transportDistance: double

  /**
   * Corresponds to CR107 && CR108.
   */
  addressInformation: [string] schema suffix 'ADDR'

  /**
   * A free-form description to clarify the related data elements and their content.
   */
  descriptions: [string] schema suffix 'DESC'
}
