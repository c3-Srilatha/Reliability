/**
 * Professional service specifies the service line item detail for the durable medical equipment.
 * A SV2 segment.
 */
type X12DurableMedicalEquipmentService {

  /**
   * Identifies a medical procedure by its standardized codes and applicable modifiers.
   */
  compositeMedicalProcedureIdentifier: !X12CompositeMedicalProcedureIdentifier

  /**
   * Code specifying the units in which a value is being expressed, or manner in which a measurement has been taken.
   */
  unitOrBasisForMeasurementCode: !string

  /**
   * Numeric value of quantity.
   */
  lengthOfMedicalNecessity: double

  /**
   * Monetary amount.
   */
  lineItemChargeAmount: double

  /**
   * Monetary amount, line item denied charge or non-covered charge amount.
   */
  lineItemDeniedChargeAmount: double

  /**
   * Code identifying frequency or type of activities or actions being reported.
   */
  frequencyCode: string

  /**
   * Corresponds to SV507.
   */
  prognosisCode: string
}
