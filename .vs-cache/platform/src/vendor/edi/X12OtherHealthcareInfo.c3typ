/**
 * Other health insurance information specifies information associated with other health insurance coverage.
 * OI segment.
 */
type X12OtherHealthcareInfo {

  /**
   * A claim filling indicator case.
   */
  claimFillingIndicatorCase: string

  /**
   * A claim submission reason code.
   */
  claimSubmissionReasonCode: string

  /**
   * Code indicating a yes or no condition or response.
   */
  reportCode: string

  /**
   * A patient signature source code.
   */
  patientSignatureSourceCode: string

  /**
   * A patient agreement code.
   */
  providerAgreementCode: string

  /**
   * Code identificating whether the provider has on file a sugned statement
   * by the patient authorizing the release of medical data to other organization.
   */
  releaseOfInformationCode: string
}
