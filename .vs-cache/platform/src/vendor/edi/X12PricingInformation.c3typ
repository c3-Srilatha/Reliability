/**
 * Specifies pricing information.
 * CTP segment.
 */
type X12PricingInformation {

  /**
   * Corresponds to CTP01.
   */
  classOfTradeCode: string

  /**
   * Corresponds to CTP02.
   */
  priceIdentifierCode: string

  /**
   * Corresponds to CTP03.
   */
  unitPrice: double

  /**
   * Numeric value of quantity.
   */
  nationalDrugUnitCount: string

  /**
   * A code specifying the units in which a value is being expressed,
   * or manner in which a measurement has been taken.
   */
  compositeUnitOfMeasure: string

  /**
   * Corresponds to CTP06.
   */
  priceMultiplierQualifier: string

  /**
   * Corresponds to CTP07.
   */
  multiplier: double

  /**
   * Corresponds to CTP08.
   */
  monetaryAmount: double

  /**
   * Corresponds to CTP09.
   */
  basisOfUnitPriceCode: string

  /**
   * Corresponds to CTP10.
   */
  conditionValue: string

  /**
   * Corresponds to CTP11.
   */
  multiplePriceQuantity: int
}
