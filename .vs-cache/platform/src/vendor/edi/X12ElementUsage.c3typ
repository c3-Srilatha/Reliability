/**
 * Usage of segment element.
 *
 * @see X12SegmentElement
 */
enum type X12ElementUsage {

  /**
   * element value should be present in the segment (= not be empty).
   */
  REQUIRED = 'R'

  /**
   * element value may be present in the segment
   */
  SITUATIONAL = 'S'

  /**
   * element value is not used
   */
  NOT_USED = 'NU'
}
