/**
 * Subscriber information records information specific to the primary
 * insured and the insurance carrier for that insured.
 * SBR segment.
 */
type X12SubscriberInformation {

  /**
   * Code identifying the insurance carrier's level of responsibility for a payment of a claim.
   */
  payerResponsibilitySequenceNumberCode: string

  /**
   * Code indicating the relationship between two individuals or entities.
   */
  individualRelationshipCode: string

  /**
   * Reference information as defined for a particular Transaction Set
   * or as specified by the Reference Identification Qualifier.
   */
  referenceIdentification: string

  /**
   * Free-form name.
   */
  subscriberGroupName: string

  /**
   * Corresponds to SBR05.
   */
  insuranceTypeCode: string

  /**
   * Corresponds to SBR06.
   */
  coordinationOfBenefitsCode: string

  /**
   * Corresponds to SBR07.
   */
  responseCode: string

  /**
   * Corresponds to SBR08.
   */
  employmentStatusCode: string

  /**
   * Code identifying type of claim.
   */
  claimFillingIndicatorCode: string
}
