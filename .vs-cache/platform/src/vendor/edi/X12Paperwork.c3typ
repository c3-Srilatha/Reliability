/**
 * PWK - Claim supplemental information.
 * The type or transmission of both paperwork or supporting information
 */
type X12Paperwork {

  /**
   * Indicates the title or contents of a document, report or supporting
   * item (PWK01)
   */
  reportTypeCode: string

  /**
   * The timing, transmission method or format by which reports are to be
   * sent (PWK02)
   */
  reportTransmissionCode: string

  /**
   * Corresponds to PWK03
   */
  reportCopiesNeeded: string

  /**
   * Corresponds to PWK04
   */
  entityIdentifierCode: string

  /**
   * The system/method of code structure used for Identification Code (PWK05)
   */
  identificationCodeQualifier: string

  /**
   * Code identifying a party or other code (PWK06)
   */
  identificationCode: string

  /**
   * Corresponds to PWK07
   */
  description: string

  /**
   * Corresponds to PWK08
   */
  actionsIndicated: string

  /**
   * Corresponds to PWK09
   */
  requestCategoryCode: string
}
