/**
 * Monetary amount information indicates the total monetary amount.
 * AMT segment.
 */
type X12MonetaryAmountInformation {

  /**
   * Amount qualifier code is a code to qualify amount.
   */
  amountQualifierCode: string

  /**
   * A monetary amount.
   */
  monetaryAmount: double

  /**
   * A credit/debit flag code.
   */
  creditDebitFlagCode: string
}
