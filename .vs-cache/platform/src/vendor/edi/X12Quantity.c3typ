/**
 * Specifies quantity information
 * QTY segment.
 */
type X12Quantity {

  /**
   * code specifying the type of quantity.
   */
  quantityQualifier: string

  /**
   * numeric value of quantity.
   */
  quantity: double

  /**
   * corresponds to QTY03.
   */
  compositeUnitOfMeasure: string

  /**
   * corresponds to QTY04.
   */
  freeFormMessage: string
}
