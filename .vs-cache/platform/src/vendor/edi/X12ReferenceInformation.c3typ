/**
 * Reference information specifies identifying information.
 * REF segment.
 */
type X12ReferenceInformation {

  /**
   * Code qualifying the reference information.
   */
  referenceIdentificationQualifier: string

  /**
   * Reference information as defined for a particular Transaction Set
   * or as specified by the Reference Identification Qualifier.
   */
  referenceIdentification: string

  /**
   * Corresponds to REF03.
   */
  description: string

  /**
   * Identifies one or more reference numbers or identification numbers as specified by the Reference Qualifier.
   */
  referenceIdentifier: X12CompositeReferenceIdentifier
}
