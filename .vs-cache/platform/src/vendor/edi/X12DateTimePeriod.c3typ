/**
 * Date time period is used to specify date, either including date or not.
 * DTP segment.
 */
type X12DateTimePeriod {

  /**
   * Code specifying type of date or time, or both date and time.
   */
  dateTimeQualifier: string

  /**
   * Code indicating the date format, time format, or date and time format.
   */
  dateTimePeriodFormatQualifier: string

  /**
   * Expression of a start for range of dates.
   */
  periodStart: datetime

  /**
   * Expression of an end for range of dates.
   */
  periodEnd: datetime
}
