/**
 * Type of segment element value.
 *
 * @see X12SegmentElement
 */
enum type X12ElementType {

  /**
   * Identifier value.
   */
  ID

  /**
   * Real value (decimal), for example 3.14.
   */
  DECIMAL = 'R'

  /**
   * numeric value, for example 42.
   */
  NUMERIC = 'NO'

  /**
   * contains numbers, letters and spaces, for example 'Rule 34'.
   */
  ALPHANUMERIC = 'AN'

  /**
   * Date format.
   */
  DATE = 'DT'

  /**
   * Time format.
   */
  TIME = 'TM'
}
