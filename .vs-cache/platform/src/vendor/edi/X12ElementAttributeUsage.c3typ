/**
 * Usage of segment element's attribute. Supports same values as ElementUsage - but with different codes for them.
 *
 * @see X12ElementUsage
 */
enum type X12ElementAttributeUsage {

  /**
   * element value should be present in the segment (= not be empty).
   */
  MANDATORY = 'M'

  /**
   * element value may be present in the segment
   */
  OPTIONAL = 'O'

  /**
   * element value is not used
   */
  REDUNDANT = 'X'
}
