/**
 * Supplies the full name of individual or organization entity.
 * NM1 segment.
 */
type X12Name {

  /**
   * Code identifying an organizational entity, a physical location, property or an individual.
   */
  entityIdCode: string

  /**
   * Code qualifying the type of entity.
   */
  entityTypeQualifier: string

  /**
   * Individual last name or organizational name.
   */
  lastNameOrganizationName: string

  /**
   * Individual first name.
   */
  firstName: string

  /**
   * Individual middle name or initial.
   */
  middleName: string

  /**
   * A name prefix.
   */
  namePreffix: string

  /**
   * A name suffix.
   */
  nameSuffix: string

  /**
   * Code designating the system/method of code structure used for identification code.
   */
  idCodeQualifier: string

  /**
   * Code identifying a party or other code.
   */
  idCode: string

  /**
   * An entity relationship code.
   */
  entityRelCode: string

  /**
   * An entity identifier code.
   */
  entityIdCodeOld: string

  /**
   * Name last or organization name.
   */
  lastNameOrganizationNameOld: string
}
