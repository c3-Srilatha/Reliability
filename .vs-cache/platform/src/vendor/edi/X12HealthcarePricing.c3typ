/**
 * Health care pricing specifies pricing or repricing information about a health care claim or line item.
 * HCP segment.
 */
type X12HealthcarePricing {

  /**
   * Code specifying pricing methodology at which the claim or line item has been priced or repriced.
   */
  pricingMethodology: string

  /**
   * A monetary amount.
   */
  monetaryAmounts: [double] schema suffix 'MA'

  /**
   * Reference information as defined for a particular Transaction Set or as specified
   * by the Reference Identification Qualifier.
   */
  referenceIdentifications: [string] schema suffix 'RI'

  /**
   * Rate expressed in the standard monetary denomination for the currency specified.
   */
  rate: double

  /**
   * Identifying number for a product or service.
   */
  productServiceIds: [string] schema suffix 'PSI'

  /**
   * Qualifier of the identifying number for a product or service.
   */
  productServiceIdQualifier: string

  /**
   * Code specifying the units in which a value is being expressed, or manner in manner which a measurement has been taken.
   */
  unitOrBasisForMeasurementCode: string

  /**
   * Numeric value of quantity.
   */
  quantity: double

  /**
   * Code assigned by issuer to identify reason for rejection.
   */
  rejectReasonCode: string

  /**
   * Code specifying policy compliance.
   */
  policyComplianceCode: string

  /**
   * Code specifying the exception reason for consideration of out-of-network health care services.
   */
  exceptionCode: string
}
