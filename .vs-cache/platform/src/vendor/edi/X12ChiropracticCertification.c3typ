/**
 * Chiropractic Certification supplies information related to the chiropractic service rendered to a patient
 * CR2 segment.
 */
type X12ChiropracticCertification {

  /**
   * Unit Or Basis For Measurement Code specifying the units in which a value is being expressed,
   * or manner in which a measurement has been taken.
   */
  count: int

  /**
   * Corresponds to CR202, CR206, CR207
   */
  quantities: [double] schema suffix 'Q'

  /**
   * Corresponds to CR203, CR204
   */
  subluxationLevelCode: string

  /**
   * Unit Or Basis For Measurement Code specifying the units in which a value is being expressed,
   * or manner in which a measurement has been taken.
   */
  unitBasisMeasurementCode: string

  /**
   * Nature of condition code indicating the nature of a patient's condition.
   */
  natureOfConditionCode: string

  /**
   * Yes/No condition or Response code, corresponds to CR209, CR212
   */
  responseCodes: [string] schema suffix 'RESP'

  /**
   * A free-form description to clarify the related data elements and their content.
   */
  descriptions: [string] schema suffix 'DESC'
}
