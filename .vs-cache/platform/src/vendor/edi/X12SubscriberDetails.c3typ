/**
 * Loop with ID 2010BA.
 */
type X12SubscriberDetails {

  /**
   * NM1 segment, subscriber name.
   */
  theName: !X12Name

  /**
   * N3/N4 segments, subscriber address including city, state, and ZIP code.
   */
  address: X12Address

  /**
   * DMG segment, subscriber demographic information.
   */
  demographicInformation: X12DemographicInformation

  /**
   * REF segment, subscriber secondary identification.
   */
  secondaryIdentification: X12ReferenceInformation

  /**
   * REF segment, property and casualty claim number.
   */
  propertyAndCasualtyClaimNumber: X12ReferenceInformation

  /**
   * PER segment, property and casualty subscriber contact information.
   */
  propertyAndCasualtyContactInformation: X12ContactInformation
}
