/**
 * Identifies one or more related causes and associated state or country information.
 * It is a composite segment element of a X12HealthClaim segment (CLM), data element C024.
 * See @X12HealthClaim.
 */
type X12RelatedCausesInformation {

  /**
   * Code identifying an accompanying case of an illness, injury or an accident.
   */
  relatedCausesCode: [string]

  /**
   * Code as defined by appropriate government agency.
   */
  stateOrProvinceCode: string

  /**
   * Code identifying the country.
   */
  countryCode: string
}
