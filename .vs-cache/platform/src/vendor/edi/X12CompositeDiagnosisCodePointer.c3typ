/**
 * Composite diagnosis code pointer is used to identify one or more diagnosis code pointers.
 * It is a composite segment element of a Line Adjudication Information segment (SVD), data element C003.
 */
type X12CompositeDiagnosisCodePointer {

  /**
   * A pointer to the diagnosis code in the order of importance to this service.
   */
  diagnosisCodePointers: [string] schema suffix 'DCP'
}
