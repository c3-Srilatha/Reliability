/**
 * Conveys service line adjudication information for coordination of benefits
 * between the initial payers of a health care claim and all subsequent payers.
 */
type X12ServiceLineAdjudication {

  /**
   * Code identifying a party or other code.
   */
  otherPayerPrimaryIdentifier: string

  /**
   * A monetary amount.
   */
  monetaryAmount: double

  /**
   * Identifies a medical procedure by its standartized codes and applicable modifiers.
   */
  compositeMedicalProcedureIdentifier: X12CompositeMedicalProcedureIdentifier

  /**
   * Corresponds to SVD04.
   */
  serviceLineRevenueCode: string

  /**
   * Numeric value of quantity.
   */
  paidServiceUnitCount: double

  /**
   * Number assigned to differentation within a transaction set.
   */
  bundledLineNumber: int
}
