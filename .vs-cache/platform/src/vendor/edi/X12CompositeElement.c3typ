/**
 * Entity used for the cases segment's element is a composite entity itself (usually marked as C0001, C0002 etc.).
 */
entity type X12CompositeElement type key 'X12CES' schema name 'X12_COMP_EL' {

  /**
   * names of element components
   */
  schm: map<string, string> schema suffix 'NAME'

  /**
   * types of element components
   */
  schemaTypes: map<string, string> schema suffix 'TPS'

  /**
   * name of the segment element.
   */
  nm: !string

  /**
   * name of the segment.
   */
  segmentName: !string

  /**
   * names of fields in corresponding c3 type.
   */
  labelMappings: map<string, string> schema suffix 'LBL'

  /**
   * rules for the composite element.
   */
  rules: [string] schema suffix 'RLS'
}
