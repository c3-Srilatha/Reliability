/**
 * Loop with ID 2010BB.
 */
type X12PayerDetails {

  /**
   * NM1 segment, a payer name.
   */
  theName: !X12Name

  /**
   * N3/N4 segments, a payer address including city, state, and ZIP code.
   */
  address: X12Address

  /**
   * REF segment, a payer secondary identification.
   */
  secondaryIdentification: X12ReferenceInformation

  /**
   * REF segment, a billing provider secondary identification.
   */
  billingProviderSecondaryIdentification: X12ReferenceInformation
}
