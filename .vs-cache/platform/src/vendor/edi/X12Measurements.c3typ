/**
 * Physical measurements of counts, including dimensions, tolerances, variances, and weight.
 * MEA segment.
 */
type X12Measurements {

  /**
   * code identifying the broad category to which a measurement applies.
   */
  measurementsReferenceIdCode: string

  /**
   * code identifying a specific product or process characteristic to which a measurement applies.
   */
  measurementQualifier: string

  /**
   * the value of the measurement.
   */
  measurementValue: double

  /**
   * corresponds to MEA04.
   */
  compositeUnitOfMeasure: string

  /**
   * corresponds to MEA05.
   */
  rangeMinimum: double

  /**
   * corresponds to MEA06.
   */
  rangeMaximum: double

  /**
   * corresponds to MEA07.
   */
  measurementSignificanceCode: string

  /**
   * corresponds to MEA08.
   */
  measurementAttributeCode: string

  /**
   * corresponds to MEA09.
   */
  surfaceLayerPositionCode: string

  /**
   * corresponds to MEA10.
   */
  measurementMethodOrDevice: string

  /**
   * corresponds to MEA11.
   */
  codeListQualifierCode: string

  /**
   * corresponds to MEA12.
   */
  industryCode: string
}
