/**
 * Composite medical procedure identifier is used to identify a medical procedure by its standardized codes and applicable modifiers.
 * It is a composite segment element of a Line Adjudication Information segment (SVD), data element C003.
 */
type X12CompositeMedicalProcedureIdentifier {

  /**
   * Code identifying the type/source of the descriptive number used in Product/Service ID.
   */
  productServiceIdQualifier: string

  /**
   * Identifying number for a product or service.
   */
  productServiceId: string

  /**
   * This identifies special circumstances related to the performance of the service, as defined by trading partners.
   */
  procedureModifiers: [string] schema suffix 'MOD'

  /**
   * A free-form description to clarify the related data elements and their content.
   */
  description: string
}
