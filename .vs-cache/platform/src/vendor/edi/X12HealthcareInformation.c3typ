/**
 * Health care information codes supply information related to the delivery of health care.
 */
type X12HealthcareInformation {

  /**
   * Sends health care codes and their associated dates, amounts and quantities.
   */
  healthCareCodeInformation: ![X12HealthCareInformationEntity] schema suffix 'HC'
}
