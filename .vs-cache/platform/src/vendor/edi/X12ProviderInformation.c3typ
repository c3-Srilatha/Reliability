/**
 * Provider information specify the identifying characteristics of a provider.
 * PRV segment.
 */
type X12ProviderInformation {

  /**
   * Code identifying the type of provider.
   */
  providerCode: string

  /**
   * Code identifying the Reference identification.
   */
  referenceIdentificationQualifier: string

  /**
   * Reference information as defined for a particular Transaction Set or as
   * specified by the Reference Identification Qualifier.
   */
  referenceIdentification: string

  /**
   * Corresponds to PRV04.
   */
  stateOfProvinceCode: string

  /**
   * Corresponds to PRV05.
   */
  providerSpecialtyInformation: string

  /**
   * Corresponds to PRV06.
   */
  providerOrganizationCode: string
}
