/**
 * Medicare outpatient adjudication conveys claim-level data related
 * to the adjudication of Medicare claims not related to an impatient setting.
 * MOA segment.
 */
type X12MedicareOutpatientAdjudication {

  /**
   * Percentage expressed as a decimal (e.g., 0.0 through 1.0 represents 0% through 100%).
   */
  reimbursementRate: double

  /**
   * A monetary amount.
   */
  hcpcsPayableAmount: double

  /**
   * Reference information as defined for a particular Transaction Set
   * or as specified by the Reference Identification Qualifier.
   */
  claimPaymentRemarkCodes: [string] schema suffix 'CP'

  /**
   * A monetary amount.
   */
  endStageRenalDiseasePaymentAmount: double

  /**
   * A monetary amount.
   */
  nonPayableProfessionalComponentBilledAmount: double
}
