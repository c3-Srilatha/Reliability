// TODO: PLAT-45616 Use . instead of _ issue with codegen
type PostgresDB_Config mixes CloudServiceConfig {

  id:      ~
  forId:   ~
  version: ~ = "15.7-1"

  /**
   * Fully qualified registry to fetch postgres image
   * NOTE: the value for this field will be dictated by the {@link CloudServiceConfig#logicalImageRegistry},
   * and changing this field directly will have no effect.
   */
  @ser(path="image.registry")
  imageRegistry: string

  /**
   * Tag of the postgres image
   */
  @ser(path="image.tag")
  containerImageTag: string = "15.7-r1-202405292154"

  /**
   * Size of persistent volume
   */
  @ser(path="persistence.size")
  persistenceSize: string = "100Gi"

  /**
   * Maximum total connections.
   */
  @ser(path="postgresqlMaxConnections")
  maxConnections: int = 5000

  /**
   * Cpu requests for postgres resources
   */
  @ser(path="resources.requests.cpu")
  resourcesRequestsCpu: string = "400m"

  /**
   * Memory requests for postgres resources
   */
  @ser(path="resources.requests.memory")
  resourcesRequestsMemory: string = "4Gi"

  /**
   * Cpu limits for postgres resources
   */
  @ser(path="resources.limits.cpu")
  resourcesLimitsCpu: string = "400m"

  /**
   * Memory limits for postgres resources
   */
  @ser(path="resources.limits.memory")
  resourcesLimitsMemory: string = "4Gi"

  /**
   * Use managed Postgres by default
   */
  managed: ~ = true

  /**
   * Override to preserve storage on termination for PostgresDB.
   */
  doNotCleanupStorageOnTerminate: boolean = true

  /**
   * PostgreSQL user password
   */
  @ser(path="global.postgresql.postgresqlPassword")
  @config(secret=true)
  postgresqlPassword: string

  @ser(path="releaseAppendChartName")
  releaseAppendChartName: private boolean = true

  @ser(path="secretName")
  secretName: private string

  @ser(path="service.headless.name")
  serviceHeadlessName: private string

  @ser(path="service.name")
  serviceName: private string

  operatorResource: private member function(): K8sC3Postgres
}
