/**
 * Type used to configure various Microstrategy parameters.
 */
type MicrostrategyConfig mixes ConfigChild<ServerConfig> {

  mstrServerProtocol: string = 'http'
  mstrServerName:     string = 'dev-c3-isrv-01.c3-e.com'
  mstrServerPort:     int = 8080
  mstrServerPath:     string
  adminUser:          string = 'admin'
  adminPassword:      string = 'adminPassword'
  masterPassword:     string = 'mstrPassword'
  serverUrl:          string = 'https://dev-c3-isrv-01.c3-e.com:8080'
}
