@beta
native py remix type Ray {

  /**
   * Decorator for method implementations that ensures that a Ray connection is established before entering
   * implementation. This is needed because upon Python method invocation there is no guarantee that the
   * PySDK is invoking a method from a previously initialized interpreter.
   */
  init_decorator: private inline function(func: lambda(): any): lambda(): any py-modin-server
}
