/**
 * C3 Interface to a Ray Actor
 */
native py remix type RayActor {

  // The RayActor python handle for this C3 type
  actor: cached property(): native py-modin-server

  /**
   * Create a new Actor given the native python class and provided spec
   */
  create: function(name: !string, klass: !native, spec: RayActorSpec): RayActor py-modin-server

  /**
   * Get or create a Ray actor if the actor doesn't exist
   */
  getOrCreate: function(name: !string, klass: native, spec: RayActorSpec): RayActor py-modin-server

  /**
   * Gets the native Ray Actor object reference by the name
   */
  get: member function(): native py-modin-server
}
