/**
 * C3 Interface to a Ray Actor
 */
type RayActor mixes Named {

  /**
   * Get an existing actor by name
   */
  forName: ~: RayActor py-modin-server

  /**
   * Kills the current actor
   */
  kill: member function(): boolean py-modin-server

  /**
   * Dispatch a method to the Ray Actor class
   */
  dispatch: inline member function(method: !string,
                                   materialize: boolean,
                                   args: [native],
                                   kwargs: Map<string, native>): native py-modin-server
}
