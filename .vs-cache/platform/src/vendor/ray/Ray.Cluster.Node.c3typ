/**
 * Represents an individual Ray Node in a Ray Cluster
 */
type Ray.Cluster.Node mixes CloudCluster.Node<Ray.Cluster> {

  objectStoreSocketName: string
  metricsExportPort:     string
  nodeManagerPort:       string
  alive:                 boolean
  rayletSocketName:      string
  nodeManagerHostname:   string
  nodeID:                string
  nodeManagerAddress:    string
  objectManagerPort:     string
  resources:             Ray.Cluster.Node.Resources
}
