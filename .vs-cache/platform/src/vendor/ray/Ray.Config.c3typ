@beta
type Ray.Config mixes CloudServiceConfig {

  id:    ~
  forId: ~

  /**
   * Specifies the number of Ray worker nodes.
   */
  minWorkers: int = 1

  maxWorkers: int = 1

  /**
   * Specifies the resources for Ray nodes.
   */
  headNodeCpu: string = "4"

  headNodeGpu:      int = 0
  headNodeMemory:   string = "4Gi"
  workerNodeCpu:    string = "6"
  workerNodeGpu:    int = 0
  workerNodeMemory: string = "6Gi"

  /**
   * Specifies the fraction of memory on Ray nodes to allocate to the Plasma Store.
   * This fraction cannot be below 30%.
   */
  headNodeMemoryFraction: double = 0.3

  workerNodeMemoryFraction: double = 0.3

  /**
   * Specifies the credentials used for cloud blob storages.
   */
  serviceAccountName: string

  raySecretsId: string

  /**
   * Specifies certain behaviors in Ray.py.
   */
  shutdownEachConnection: boolean = false

  enableInitLogging: boolean = false
  enableProfiling:   int = 0

  /**
   * Specifies number of max client and server threads Ray can support.
   */
  maxThreads: int = 200

  /**
   * Specifies a criteria for which instance Ray should be scheduled to.
   */
  rayInstance: string

  /**
   * @param count
   *           Minimum number of Ray workers.
   */
  setMinWorkers: member function(count: int)

  /**
   * @param count
   *           Maximum number of Ray workers.
   */
  setMaxWorkers: member function(count: int)

  /**
   * @param size
   *           Size of CPU for Ray head node
   */
  setHeadNodeCpu: member function(size: string)

  /**
   * @param count
   *           Number of GPU for Ray head node
   */
  setHeadNodeGpu: member function(count: int)

  /**
   * @param size
   *           Size of RAM for Ray head node
   */
  setHeadNodeMemory: member function(size: string)

  /**
   * @param size
   *           Size of CPU for Ray worker node
   */
  setWorkerNodeCpu: member function(size: string)

  /**
   * @param count
   *           Number of GPU for Ray worker node
   */
  setWorkerNodeGpu: member function(count: int)

  /**
   * @param size
   *           Size of RAM for Ray worker node
   */
  setWorkerNodeMemory: member function(size: string)

  /**
   * @param fraction
   *           Fraction of Ray head memory to allocate as the Plasma Store
   */
  setHeadNodeMemoryFraction: member function(fraction: double)

  /**
   * @param fraction
   *           Fraction of Ray worker memory to allocate as the Plasma Store
   */
  setWorkerNodeMemoryFraction: member function(fraction: double)

  /**
   * @param shutdown
   *           Shutdown each Ray connection after it has been used
   */
  setShutdownEachConnection: member function(shutdown: boolean)

  /**
   * @param logging
   *           Enable logging when connecting to Ray
   */
  setEnableInitLogging: member function(logging: boolean)

  /**
   * @param profiling
   *           Enable Ray timeline visualization tool
   */
  setEnableProfiling: member function(profiling: boolean)

  /**
   * @param count
   *           Maximum number of client and server threads Ray can support
   */
  setMaxThreads: member function(count: int)

  /**
   * @param selector
   *           Selector for which instance Ray should be scheduled to.
   */
  setRayInstance: member function(selector: string)
}
