type Ray.ActorHandle mixes Value {

  id:      property(): !string
  call:    member function(func: !string, args: any ...): Ray.Ref
  call:    member function(func: !string, args: [any], kwargs: map<string, any>): Ray.Ref
  kill:    member function()
  restart: member function()
}
