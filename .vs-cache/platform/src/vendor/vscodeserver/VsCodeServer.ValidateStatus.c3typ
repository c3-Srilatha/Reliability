enum type VsCodeServer.ValidateStatus {

  /**
   * The tokens are valid, and no change is required
   */
  OK

  /**
   * The browser c3auth token is for a user that is not authorized to use the vscode server
   */
  INVALID_USER

  /**
   * The token that was provided is invalid, and needs to be refreshed.
   */
  NEW_TOKEN_REQUIRED
}
