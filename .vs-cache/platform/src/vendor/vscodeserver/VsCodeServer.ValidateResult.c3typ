type VsCodeServer.ValidateResult {

  /**
   * The status of the validation.
   */
  status: string enum VsCodeServer.ValidateStatus

  /**
   * The new token to use for the VsCode Server.
   * Will only be provided if the status is {@link VsCodeServer.ValidateStatus.NEW_TOKEN_REQUIRED}.
   */
  token: string
}
