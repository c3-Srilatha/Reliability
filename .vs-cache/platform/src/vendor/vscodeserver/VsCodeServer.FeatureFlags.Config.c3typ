/**
 * Code Server feature flags
 */
@beta
@config(minOverride='CLUSTER', maxOverride='CLUSTER')
type VsCodeServer.FeatureFlags.Config mixes Config {

  /**
   * Enable the code server on the cluster
   */
  enabled: boolean = true
}
