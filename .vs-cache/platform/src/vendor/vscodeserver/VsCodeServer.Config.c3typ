/**
 * Values used for overlay file that is used to start VS Code server
 */
@beta
@config(minOverride=ENV, maxOverride=CLUSTER)
type VsCodeServer.Config mixes CloudServiceConfig {

  /**
   * Host configuration for the VS Code server
   */
  @ser(path="ingress.hosts")
  host: [VsCodeServer.HostConfig]

  /**
   * Name of the VS Code server service, this name is used as a prefix
   * by all the resources created by the VS Code server helm chart
   */
  @ser(path="nameOverride")
  codeServerNameOverride: string

  /**
   * AppUrl of where `VsCodeServer.ensureService()` was called from, which should be env/c3.
   */
  @ser(path="APP_URL")
  appUrl: string

  /**
   * Image repository for the VS Code server
   */
  @ser(path="image.repository")
  imageRepository: string = "c3vsce/persona3-vscode-server"

  /**
   * Image tag for the VS Code server
   */
  @ser(path="image.tag")
  imageTag: string = "0.3.8"

  /**
   * Full Image name for the VS Code server
   * ex: us-west1-docker.pkg.dev/cicd-360621/docker/c3vsce/persona3-vscode-server:0.1.11
   *
   * NOTE: Image full name will be set by concatenating registry, repository, and tag. Setting this field directly will have no effect.
   */
  @ser(path="image.fullName")
  imageFullName: string

  /**
   * The path prefix is replaced by `/` when the request is proxied to the VS Code server. by default it is `envName/c3`.
   */
  @ser(path="PATH_PREFIX")
  pathPrefix: string

  /**
   * The token stored in the k8s secret and used to authenticate the VS Code server with C3.
   */
  @config(secret=true)
  @ser(path="authToken")
  token: string

  /**
   * The interval in minutes for periodic refresh of the C3 authentication token. Default is 10 hours.
   * Used by the extension to ensure that auth token expiration does not occur for browser VSCE.
   */
  authTokenRefreshInterval: int = 600

  /**
   * Version of VS Code server service. Ensure this matches with the version in chart.yaml.
   */
  version: ~ = "0.1.1"

  /**
   * The external endpoint for the VS Code server cloud service.
   */
  @ser(path="EXTERNAL_URL")
  externalEndpoint: string

  /**
   * Size of the Persistent Volume Claim (PVC) for the VS Code server.
   */
  @ser(path="persistence.size")
  pvcSize: string = "20Gi"

  id:    ~
  forId: ~
}
