/**
 * Conversation result type
 */
type OpenHands.ConversationResult {

  /**
   * Conversation ID
   */
  conversation_id: string

  /**
   * Conversation title
   */
  title: string

  /**
   * Last updated timestamp
   */
  last_updated_at: string

  /**
   * Created timestamp
   */
  created_at: string

  /**
   * Selected repository
   */
  selected_repository: string

  /**
   * Conversation status
   */
  status: OpenHands.ConversationStatus

  /**
   * Conversation trigger
   */
  trigger: OpenHands.ConversationTrigger
}
