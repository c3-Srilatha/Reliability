/**
 * Create conversation response type
 */
type OpenHands.CreateConversationResponse {

  /**
   * Status of the response
   */
  status: string

  /**
   * Conversation ID
   */
  conversation_id: string

  /**
   * Error message (only present in error responses)
   */
  message: string

  /**
   * Message ID (only present in error responses)
   */
  msg_id: string
}
