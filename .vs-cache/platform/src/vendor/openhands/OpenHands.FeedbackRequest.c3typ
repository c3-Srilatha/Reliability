/**
 * Feedback request type for submitting user feedback
 */
type OpenHands.FeedbackRequest {

  /**
   * User email address
   */
  email: string

  /**
   * Version information
   */
  version: string

  /**
   * Permissions for the feedback (default: private)
   */
  permissions: string

  /**
   * Polarity of the feedback
   */
  polarity: string

  /**
   * The feedback content
   */
  feedback: string
}
