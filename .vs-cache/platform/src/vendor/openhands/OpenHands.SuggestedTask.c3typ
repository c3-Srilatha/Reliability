/**
 * Suggested task type
 */
type OpenHands.SuggestedTask {

  /**
   * Task title
   */
  title: string

  /**
   * Task URL
   */
  url: string

  /**
   * Repository name
   */
  repository: string

  /**
   * Task type
   */
  @ser(name="type")
  _type: string

  /**
   * Created timestamp
   */
  created_at: string
}
