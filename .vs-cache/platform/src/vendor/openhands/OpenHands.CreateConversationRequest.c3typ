/**
 * Create conversation request type
 */
type OpenHands.CreateConversationRequest {

  /**
   * Full name of the repository (e.g., owner/repo)
   */
  repository: string

  /**
   * The Git provider (e.g., github or gitlab). If omitted, all configured providers are checked for the repository.
   */
  git_provider: string

  /**
   * Selected branch
   */
  selected_branch: string

  /**
   * Initial user message
   */
  initial_user_msg: string

  /**
   * Optional instructions the agent must follow throughout the conversation while addressing the user's initial task
   */
  conversation_instructions: string

  /**
   * Array of image URLs
   */
  image_urls: [string]

  /**
   * Replay JSON
   */
  replay_json: string
}
