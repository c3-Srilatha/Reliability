/**
 * Type represents C3 managed OpenHands service.
 * Provides All Hands development environment operations.
 * Based on https://docs.all-hands.dev/api-reference/
 */
@beta
@cloud(cloudFunc='k8soh')
@k8s(cloudServiceEndpoint='openhands')
type OpenHands mixes CloudService<OpenHands.Config>, Singleton {

  /**
   * Returns the API interface for this OpenHands service
   */
  api: property(): OpenHands.Api

  inst:            ~
  telemetryLabels: ~
  ensureConfig:    ~
}
