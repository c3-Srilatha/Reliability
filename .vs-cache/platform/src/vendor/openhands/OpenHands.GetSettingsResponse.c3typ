/**
 * Get settings response type
 */
type OpenHands.GetSettingsResponse {

  /**
   * User language preference
   */
  language: string

  /**
   * Agent setting
   */
  agent: string

  /**
   * Security analyzer setting
   */
  security_analyzer: string

  /**
   * Confirmation mode setting
   */
  confirmation_mode: boolean

  /**
   * LLM model setting
   */
  llm_model: string

  /**
   * Whether LLM API key is set
   */
  llm_api_key_set: boolean

  /**
   * LLM base URL
   */
  llm_base_url: string

  /**
   * Remote runtime resource factor
   */
  remote_runtime_resource_factor: number

  /**
   * Whether default condenser is enabled
   */
  enable_default_condenser: boolean

  /**
   * Whether sound notifications are enabled
   */
  enable_sound_notifications: boolean

  /**
   * Whether user consents to analytics
   */
  user_consents_to_analytics: boolean

  /**
   * Provider tokens set status
   */
  provider_tokens_set: json
}
