/**
 * REST API interface for the OpenHands service.
 * Provides endpoints for All Hands development environment operations.
 * Based on https://docs.all-hands.dev/api-reference/
 */
@beta
@rest(retryBaseSleep=20, retryHttpCodes=[403, 429, 500], retries=3)
type OpenHands.Api mixes REST, Identified {

  /**
   * Health check endpoint
   */
  @rest(skipThis=true, uri='health', method='GET')
  health: abstract member function(): string

  /**
   * Get runtime configuration for a specific conversation
   */
  @rest(skipThis=true, uri='api/conversations', method='GET')
  getConfig: abstract member function(@rest(skipThis=true, partOfURI=true, uriPrefix='/', uriSuffix="/config")
                                      conversationId: !string): OpenHands.RuntimeConfig

  /**
   * Get VSCode URL for a specific conversation
   */
  @rest(skipThis=true, uri='api/conversations', method='GET')
  getVscodeUrl: abstract member function(@rest(skipThis=true, partOfURI=true, uriPrefix='/', uriSuffix="/vscode-url")
                                         conversationId: !string): OpenHands.VscodeUrlResponse

  /**
   * Get runtime hosts for a specific conversation
   */
  @rest(skipThis=true, uri='api/conversations', method='GET')
  getRuntimeHosts: abstract member function(@rest(skipThis=true, partOfURI=true, uriPrefix='/', uriSuffix="/web-hosts")
                                            conversationId: !string): OpenHands.RuntimeHostsResponse

  /**
   * Submit user feedback for a specific conversation
   */
  @rest(skipThis=true, uri='api/conversations', method='POST')
  submitFeedback: abstract member function(@rest(skipThis=true,
                                                 partOfURI=true,
                                                 uriPrefix='/',
                                                 uriSuffix="/submit-feedback")
                                           conversationId: !string,
                                           @rest(skipThis=true, doNotUseParameterName=true)
                                           feedback: OpenHands.FeedbackRequest): json

  /**
   * List files in the specified path for a specific conversation
   */
  @rest(skipThis=true, uri='api/conversations', method='GET')
  listFiles: abstract member function(@rest(skipThis=true, partOfURI=true, uriPrefix='/', uriSuffix="/list-files")
                                      conversationId: !string,
                                      @rest(skipThis=true, partOfURI=false)
                                      path: string): [string]

  /**
   * Get file content for a specific conversation
   */
  @rest(skipThis=true, uri='api/conversations', method='GET')
  getFileContent: abstract member function(@rest(skipThis=true,
                                                 partOfURI=true,
                                                 uriPrefix='/',
                                                 uriSuffix="/select-file")
                                           conversationId: !string,
                                           @rest(skipThis=true, partOfURI=false)
                                           file: !string): OpenHands.FileContentResponse

  /**
   * Download workspace as zip for a specific conversation
   */
  @rest(skipThis=true, uri='api/conversations', method='GET')
  downloadWorkspace: abstract member function(@rest(skipThis=true,
                                                    partOfURI=true,
                                                    uriPrefix='/',
                                                    uriSuffix="/zip-directory")
                                              conversationId: !string): string

  /**
   * Get git changes for a specific conversation #
   */
  @rest(skipThis=true, uri='api/conversations', method='GET')
  getGitChanges: abstract member function(@rest(skipThis=true, partOfURI=true, uriPrefix='/', uriSuffix="/git/changes")
                                          conversationId: !string): OpenHands.GitChangesResponse

  /**
   * Get git diff for a specific file #
   */
  @rest(skipThis=true, uri='api/conversations', method='GET')
  getGitDiff: abstract member function(@rest(skipThis=true, partOfURI=true, uriPrefix='/', uriSuffix="/git/diff")
                                       conversationId: !string,
                                       @rest(skipThis=true, partOfURI=false)
                                       path: !string): OpenHands.GitDiffResponse

  /**
   * Get conversation trajectory
   */
  @rest(skipThis=true, uri='api/conversations', method='GET')
  getTrajectory: abstract member function(@rest(skipThis=true, partOfURI=true, uriPrefix='/', uriSuffix="/trajectory")
                                          conversationId: !string): OpenHands.TrajectoryResponse

  /**
   * Security analyzer API GET request
   */
  @rest(skipThis=true, uri='api/conversations', method='GET')
  getSecurityAnalyzer: abstract member function(@rest(skipThis=true,
                                                      partOfURI=true,
                                                      uriPrefix='/',
                                                      uriSuffix="/security")
                                                conversationId: !string,
                                                @rest(skipThis=true, partOfURI=true, uriPrefix='/')
                                                path: !string): json

  /**
   * Security analyzer API PUT request
   */
  @rest(skipThis=true, uri='api/conversations', method='PUT')
  putSecurityAnalyzer: abstract member function(@rest(skipThis=true,
                                                      partOfURI=true,
                                                      uriPrefix='/',
                                                      uriSuffix="/security")
                                                conversationId: !string,
                                                @rest(skipThis=true, partOfURI=true, uriPrefix='/')
                                                path: !string,
                                                @rest(skipThis=true, doNotUseParameterName=true)
                                                request: json): json

  /**
   * Security analyzer API POST request
   */
  @rest(skipThis=true, uri='api/conversations', method='POST')
  postSecurityAnalyzer: abstract member function(@rest(skipThis=true,
                                                       partOfURI=true,
                                                       uriPrefix='/',
                                                       uriSuffix="/security")
                                                 conversationId: !string,
                                                 @rest(skipThis=true, partOfURI=true, uriPrefix='/')
                                                 path: !string,
                                                 @rest(skipThis=true, doNotUseParameterName=true)
                                                 request: json): json

  /**
   * Security analyzer API DELETE request
   */
  @rest(skipThis=true, uri='api/conversations', method='DELETE')
  deleteSecurityAnalyzer: abstract member function(@rest(skipThis=true,
                                                         partOfURI=true,
                                                         uriPrefix='/',
                                                         uriSuffix="/security")
                                                   conversationId: !string,
                                                   @rest(skipThis=true, partOfURI=true, uriPrefix='/')
                                                   path: !string): json

  /**
   * Search conversations
   */
  @rest(skipThis=true, uri='api/conversations', method='GET')
  searchConversations: abstract member function(@rest(skipThis=true, partOfURI=false)
                                                pageId: string,
                                                @rest(skipThis=true, partOfURI=false)
                                                limit: int32): OpenHands.SearchConversationsResponse

  /**
   * Create new conversation
   */
  @rest(skipThis=true, uri='api/conversations', method='POST')
  createConversation: abstract member function(@rest(skipThis=true, doNotUseParameterName=true)
                                               request: OpenHands.CreateConversationRequest)
                                        : OpenHands.CreateConversationResponse

  /**
   * Get conversation details
   */
  @rest(skipThis=true, uri='api/conversations', method='GET')
  getConversation: abstract member function(@rest(skipThis=true, partOfURI=true, uriPrefix='/')
                                            conversationId: !string): OpenHands.GetConversationResponse

  /**
   * Delete conversation
   */
  @rest(skipThis=true, uri='api/conversations', method='DELETE')
  deleteConversation: abstract member function(@rest(skipThis=true, partOfURI=true, uriPrefix='/')
                                               conversationId: !string): boolean

  /**
   * Update conversation details
   */
  @rest(skipThis=true, uri='api/conversations', method='PATCH')
  updateConversation: abstract member function(@rest(skipThis=true, partOfURI=true, uriPrefix='/')
                                               conversationId: !string,
                                               request: OpenHands.UpdateConversationRequest): boolean

  /**
   * Get user repositories
   */
  @rest(skipThis=true, uri='api/user/repositories', method='GET')
  getUserRepositories: abstract member function(@rest(skipThis=true, partOfURI=false)
                                                sort: string): [OpenHands.UserRepository]

  /**
   * Get user information
   */
  @rest(skipThis=true, uri='api/user/info', method='GET')
  getUserInfo: abstract member function(): OpenHands.GetUserInfoResponse

  /**
   * Search repositories
   */
  @rest(skipThis=true, uri='api/user/search/repositories', method='GET')
  searchRepositories: abstract member function(@rest(skipThis=true, partOfURI=false)
                                               query: !string,
                                               @rest(skipThis=true, partOfURI=false)
                                               perPage: int32,
                                               @rest(skipThis=true, partOfURI=false)
                                               sort: string,
                                               @rest(skipThis=true, partOfURI=false)
                                               order: string): [OpenHands.UserRepository]

  /**
   * Get suggested tasks
   */
  @rest(skipThis=true, uri='api/user/suggested-tasks', method='GET')
  getSuggestedTasks: abstract member function(): [OpenHands.SuggestedTask]

  /**
   * Get user settings
   */
  @rest(skipThis=true, uri='api/settings', method='GET')
  getSettings: abstract member function(): OpenHands.GetSettingsResponse

  /**
   * Store user settings
   */
  @rest(skipThis=true, uri='api/settings', method='POST')
  storeSettings: abstract member function(@rest(skipThis=true, doNotUseParameterName=true)
                                          settings: OpenHands.StoreSettingsRequest): OpenHands.StoreSettingsResponse

  /**
   * Unset provider tokens in settings
   */
  @rest(skipThis=true, uri='api/unset-settings-tokens', method='POST')
  unsetSettingsTokens: abstract member function(): OpenHands.UnsetSettingsTokensResponse

  /**
   * Get all models supported by LiteLLM
   */
  @rest(skipThis=true, uri='api/options/models', method='GET')
  getModels: abstract member function(): [string]

  /**
   * Get all agents supported by OpenHands
   */
  @rest(skipThis=true, uri='api/options/agents', method='GET')
  getAgents: abstract member function(): [string]

  /**
   * Get all supported security analyzers
   */
  @rest(skipThis=true, uri='api/options/security-analyzers', method='GET')
  getSecurityAnalyzers: abstract member function(): [string]

  /**
   * Get current server configuration
   */
  @rest(skipThis=true, uri='api/options/config', method='GET')
  getServerConfig: abstract member function(): json
}
