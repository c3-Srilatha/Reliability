/**
 * Rest endpoints for Slack
 */
type Slack mixes REST, DefaultInstance<Slack> {

  /**
   * Post a message to a Slack channel or post to a thread of a message
   *
   * @param channel
   *          The name or ID of the channel eg: jarvis-test or C7832MX39
   * @param text
   *          The content of the message to be sent
   * @param thread_ts
   *          The time stamp or identifier (ts) of the message obtained
   *          from the SlackResponse of a successful message post: used to post to a thread/ reply
   *
   * @returns SlackResponse
   */
  @rest(uri='chat.postMessage', method='POST', contentType='application/json')
  postMessage: abstract function(channel: !string, text: !string, thread_ts: string): SlackResponse

  /**
   * Gets the information about a channel: id, name and topic
   *
   * @param channel
   *          The ID of the channel eg: C7832MX39
   *
   * @returns SlackChannelResponse
   */
  @rest(uri='conversations.info', method='GET', contentType='application/x-www-form-urlencoded')
  conversationInfo: abstract function(channel: !string): SlackConversationInfoResponse

  /**
   * Gets the list of channels
   *
   * @returns SlackChannelResponse
   */
  @rest(uri='conversations.list', method='GET', contentType='application/x-www-form-urlencoded')
  conversationList: abstract function(): SlackConversationListResponse

  /**
   * Gets information of a user
   *
   * @param user
   *          The ID of the User eg: U7832MX39
   *
   * @returns SlackChannelResponse
   */
  @rest(uri='users.info', method='GET', contentType='application/x-www-form-urlencoded')
  userInfo: abstract function(user: !string): SlackUserInfoResponse

  /**
   * Gets list of users
   *
   * @returns SlackChannelResponse
   */
  @rest(uri='users.list', method='GET', contentType='application/x-www-form-urlencoded')
  userList: abstract function(): SlackUserListResponse

  /**
   * Gets list of users who have sent messages
   *
   * @returns SlackConversationHistoryResponse
   */
  @rest(uri='conversations.history', method='GET', contentType='application/x-www-form-urlencoded')
  channelConversationHistory: abstract function(channel: !string,
                                                latest: string,
                                                oldest: string): SlackConversationHistoryResponse
}
