/**
 * Information about a slack channel
 */
type SlackChannel {

  /**
   * id of the slack channel
   */
  id: !string

  /**
   * Name of the slack channel
   */
  name: !string

  /**
   * Topic of the channel
   */
  topic: SlackChannelTopic
}
