/**
 * Response from slack api, for slack message
 */
type SlackMessage {

  /**
   * type of message
   */
  @ser(name='type')
  messageType: string

  /**
   * text of message sent
   */
  text: string

  /**
   * User id of user who sent the message
   */
  user: !string

  /**
   * List of user id of users who have replied to the message
   */
  @ser(name='reply_users')
  replyUsers: [string]
}
