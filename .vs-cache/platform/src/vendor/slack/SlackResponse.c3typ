/**
 * Defines the type of response received from Slack
 */
type SlackResponse {

  /**
   * Boolean value, True if Slack method was executed correctly, false otherwise
   */
  ok: !boolean

  /**
   * if ok == false, this shows what the error was
   */
  error: string

  /**
   * The identifier or time stamp of the message that was posted
   */
  ts: string
}
