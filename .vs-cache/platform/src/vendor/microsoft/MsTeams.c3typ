/**
 * Type for posting to Microsoft teams.
 * Incoming webhooks are used as an endpoint: https://docs.microsoft.com/en-us/microsoftteams/platform/webhooks-and-connectors/what-are-webhooks-and-connectors
 * The incoming webhooks need to be created for the team-channel and MsTeamsTeam needs to be updated
 */
type MsTeams mixes REST, Nameable, DefaultInstance<MsTeams> {

  /**
   * Post a message to a Teams channel
   *
   * @param webhook
   *          The webhook from MsTeamsteam for the channel: eg: MsTeamsTeam.forConfigKey("jarvis-test3").channels.channel2
   *          Here jarvis-test3 is the team name and channel2 is the channel
   * @param text
   *          The content of the message to be sent
   *
   * Example usage: MsTeams.postMessage(MsTeamsTeam.forConfigKey("jarvis-test3").channels.channel2, "hello", false)
   */
  @rest(uri='', method='POST', contentType='application/json')
  postMessage: abstract member function(@rest(partOfURI=true)
                                        webhook: !string,
                                        text: !string,
                                        markdown: !boolean): HttpResponse
}
