@beta
type GitUrlInterpreter {

  /**
   * The {@link SourceControlHost} for this Interpreter.
   */
  sourceControlType: string enum SourceControlHost

  /**
   * Parse the given {@link Url} to construct a {@link GitUrl}.
   *
   * The url string could be one provided by a source control host (something we can use with `git clone`, for example)
   * or one generated by {@link GitUrlInterpreter.toString}.  The base implementation (in GitUrlInterpreter)
   * parses strings generated by {@link GitUrlInterpreter.toString}.  Subtypes should override this method
   * to parse strings from their source control hosts.
   */
  parse: member function(url: !Url): GitUrl

  /**
   * Build a {@link GitUrl} from the given git-specific fields.  The login information, host, and port are
   * kept from the original url.  Any url parameters are removed (they are assumed to correspond to some
   * field in GitUrl).
   */
  gitUrlFrom: function(url: Url,
                       originalScheme: string enum FileSystemScheme,
                       sourceControlHost: string enum SourceControlHost,
                       owner: string,
                       project: string,
                       repository: string,
                       encodedReference: string,
                       encodedPath: string): GitUrl

  /**
   * Convert the {@link GitUrl} into a remote url that actually points to the resource.
   * Returns a url which can be successfully used by a `git clone url` call.
   */
  toCloneableUrl: abstract member function(gu: !GitUrl): string

  /**
   * Convert the given {@link GitUrl} to string.  This string will be in a generic format regardless of
   * the source control host:
   *
   *   `git://_gitUrl_header_/[original scheme]/[source control host]/[owner]/[project]/[repository]/[reference]/[path]`
   *
   * This generates an internally used string that is mainly used to identify the members of a git-based
   * {@link MetadataRepositoryStore}.  Use {@link toCloneableUrl} to generate url that can be used on the
   * git command line.
   */
  toString: final member function(gu: !GitUrl): string

  /*
   * Initialize a StringBuilder with scheme, authority (+ hostname), and port.  All
   * of the current git implementations use urls that begin this way.
   */
  initializeGitUrlString: private function(gu: !GitUrl, scheme: !string): string

  /**
   * Return the scheme of the given {@link GitUrl}
   */
  cloneableUrlScheme: private function(gu: !GitUrl): string
}
