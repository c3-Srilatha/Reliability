/**
 * GitHub based file system configuration.
 */
type GitHubFsConfig mixes FileSystemConfigChild, Config, Singleton {

  /**
   * GitHub key api url.
   */
  github_key_api_url: string = "github.api.url"

  /**
   * GitHub host address.
   */
  github_host_address: string = "github.host.address"

  /**
   * GitHub key api auth.
   */
  @config(secret=true)
  github_key_api_auth: string = "github.api.auth"

  /**
   * This contains the default access token for whichever git system is being used.
   */
  defaultToken: string

  /**
   * GitHub api workspace repository.
   */
  github_api_workspace_repository: string
}
