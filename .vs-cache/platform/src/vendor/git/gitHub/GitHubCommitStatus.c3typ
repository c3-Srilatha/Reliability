/**
 * C3 type mapping to GitHub API Status.
 * See https://docs.github.com/en/rest/reference/repos#statuses for more documentation.
 */
type GitHubCommitStatus {

  state:       !string enum("error", "failure", "pending", "success")
  description: string
  target_url:  string
  context:     string
  url:         string
  avatar_url:  string
  id:          string
  node_id:     string
  created_at:  datetime
  updated_at:  datetime
  creator:     GitHubUser
}
