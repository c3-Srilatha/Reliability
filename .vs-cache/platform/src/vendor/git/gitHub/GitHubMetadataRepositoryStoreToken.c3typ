/**
 * GitHub personal API access token for a MetadataRepositoryStore @see MetadataRepositoryStore
 * Token generated that can be used to access the GitHub API on behalf of a GitHub User
 */
@config(maxOverride=CLUSTER, minOverride=CLUSTER)
type GitHubMetadataRepositoryStoreToken mixes Config, Identifiable {

  /**
   * Override the secretValue to ensure only the user that matches the
   * token id is able to access the values.
   */
  getSecret: ~

  secretValue: ~

  /**
   * Token string
   */
  @config(secret=true)
  token: string
}
