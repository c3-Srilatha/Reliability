/**
 * Information for commits in a repository
 */
type GitHubRepoCommit {

  sha:       !string
  commit:    GitHubCommitInfo schema suffix '_CMT'
  url:       string
  author:    GitHubUser schema suffix '_AUTH'
  committer: GitHubUser schema suffix '_CMTR'
  html_url:  string
  parents:   [GitHubCommit] schema suffix '_PAR'
  files:     [GitHubFile] schema suffix '_FILE'
  stats:     GitHubStats schema suffix '_ST'
}
