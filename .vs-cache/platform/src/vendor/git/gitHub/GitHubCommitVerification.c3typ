/**
 * Describes the result of verifying the commit's signature.
 */
type GitHubCommitVerification {

  /**
   * Indicates whether GitHub consider the signature in this commit to be verified.
   */
  verified: boolean

  /**
   * The reason for verified value. Possible enumerated values can be found:
   * https://developer.github.com/v3/repos/commits/#list-commits-on-a-repository
   */
  reason: string

  /**
   * The signature that was extracted from the commit.
   */
  signature: string

  /**
   * The value that was signed.
   */
  payload: string
}
