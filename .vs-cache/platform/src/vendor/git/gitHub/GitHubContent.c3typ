type GitHubContent {

  /**
   * Describes the type of file this content is describing, ie 'dir, file, symlink, submodule, etc'.
   * See https://developer.github.com/v3/repos/contents/
   */
  @ser(name='type')
  kind: string

  encoding:     string
  size:         int
  name:         string
  path:         string
  content:      string
  sha:          string
  url:          string
  git_url:      string
  html_url:     string
  download_url: string

  /**
   * Decodes BASE64 encoded #content as string.
   *
   * @param charset
   *        character set for encoded string; default = UTF8
   */
  readString: member function(charset: string): string
}
