type GitHubCommitInfo {

  author:        GitHubCommitUser schema suffix '_A'
  committer:     GitHubCommitUser schema suffix '_C'
  message:       string
  tree:          GitHubTree schema suffix '_T'
  url:           string
  comment_count: int
  verification:  GitHubCommitVerification schema suffix '_V'
}
