/**
 * A type to store GitHub token for a user
 */
@deprecated(finalVersion='8.0', details='Use MetadataRepositoryStore.gitHubToken')
entity type GitHubToken mixes AclEnabled schema name 'GITHUBTOKEN' {

  /**
   * The user associated with the GitHub token
   */
  user: User

  /**
   * The GitHub token
   */
  token: !string

  /**
   * Sets the GitHub token for a user
   * @param token
   *         The token
   * @param user
   *         The user
   * @param skipValidation
   *         Whether to skip token validation, only useful for testing
   *
   * @return Whether setToken was successful
   */
  setToken: function(token: !string, user: User, skipValidation: boolean): boolean js-server

  /**
   * Gets the GitHub token for a user
   * @param user
   *
   * @return The token
   */
  getToken: function(user: User): string js-server

  /**
   * Checks if the GitHub token exists for a user
   * @param user
   *         The user
   * @param skipValidation
   *         Whether to skip token validation, only useful for testing
   *
   * @return Whether the token exists
   */
  tokenExists: function(user: User, skipValidation: boolean): boolean js-server

  /**
   * Checks if a GitHub token is valid
   * @param  token
   *
   * @return Whether the token is valid
   */
  isValidToken: function(token: !string): boolean js-server
}
