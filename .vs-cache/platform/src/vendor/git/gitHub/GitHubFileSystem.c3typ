/**
 * GitHub as a file system.
 */
@deprecated(finalVersion='8', details='Use GitFileSystem')
type GitHubFileSystem mixes FileSystem, FileSystemConfigurable<GitHubFsConfig> {

  /**
   * GitHub's full repository path. (e.g. `c3-e/c3server`)
   */
  repository: string

  /**
   * The name of the commit/branch/tag. Default: the repository’s default branch (usually `master`)
   */
  reference: string

  /**
   * Repository root path in GitHub.(e.g. `base`,`customer`)
   */
  root: string

  /**
   * url authority e.g username:password@github.com
   */
  authority: string

  /**
   * Returns a version of GitHubFileSystem for a given reference. Throws exception if reference is invalid or unknown.
   */
  forReference: abstract member function(reference: !string): !GitHubFileSystem

  mounts:               ~
  enabled:              ~
  fromUrlOrEncodedPath: ~

  /**
   * @param fullRepositoryName
   *           GitHub's full repository path (e.g. `c3-e/c3server`).
   * @param reference
   *           May be a branch, tag, or commit SHA.
   * @param token
   *           Token to use when accessing GitHub.
   * @param encodedPath
   *           Optional encodedPath (e.g. `base/myPackage/src/MyType.c3typ`).
   * @return the GitHubFileSystem constructed from the input.
   */
  fromRepoAndReference: function(fullRepositoryName: !string,
                                 reference: !string,
                                 token: !string,
                                 encodedPath: string): GitHubFileSystem

  /**
   * Cache the repo locally.
   * @param reset
   *           Forces the repo to be recloned.
   * @return the encodedPath
   */
  cache: member function(reset: boolean): string
}
