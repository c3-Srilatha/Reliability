/**
 * Enum type that describes the GitLab Merge Request state
 * See https://docs.gitlab.com/ee/api/merge_requests.html#list-merge-requests for more documentation.
 */
enum type GitLabMergeRequestState {

  OPENED = 'opened'

  CLOSED = 'closed'

  LOCKED = 'locked'

  MERGED = 'merged'
}
