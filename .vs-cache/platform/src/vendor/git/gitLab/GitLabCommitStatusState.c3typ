/**
 * Enum type for GitLab commit state.
 * See https://docs.gitlab.com/ee/api/commits.html#set-the-pipeline-status-of-a-commit for more documentation.
 */
enum type GitLabCommitStatusState {

  PENDING = 'pending'

  RUNNING = 'running'

  SUCCESS = 'success'

  FAILED = 'failed'

  CANCELED = 'canceled'
}
