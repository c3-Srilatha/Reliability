/**
 * C3 Type to encapsulate relevant fields from the GitLab Merge Request response
 * See https://docs.gitlab.com/ee/api/merge_requests.html for more documentation.
 */
type GitLabMergeRequest {

  id:            string
  iid:           string
  project_id:    string
  web_url:       string
  state:         string
  title:         string
  assignee:      json
  assignees:     [json]
  created_at:    datetime
  updated_at:    datetime
  closed_at:     datetime
  merged_at:     datetime
  prepared_at:   datetime
  user:          json
  head_pipeline: json
  diff_refs:     json
  merge_status:  string
}
