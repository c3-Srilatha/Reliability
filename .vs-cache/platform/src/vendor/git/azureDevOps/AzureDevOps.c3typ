/**
 * REST APIs for AzureDevOps git repositories.
 */
@rest(retries=3, timeout=300)
type AzureDevOps mixes REST {

  // NOTE: all REST functions here should have skipThis=true - some will fail without it.
  VISUAL_STUDIO_HOST_URL: const string = 'visualstudio.com'

  API_VERSION: const string = '7.0'

  /**
   * Will take an o-auth token and convert it into the proper format for AzureDevOps REST calls.
   * 'Basic ' + Base64.encodeString(':' + token)
   *
   * @param token
   *            AzureDevOps OAuth Token.
   * @return this with auth set to use OAuth token.
   */
  withToken: member function(token: !string): AzureDevOps

  /**
   * Grabs the content for a path. The path should point to a singular file.
   * See https://docs.microsoft.com/en-us/rest/api/azure/devops/git/items/get?view=azure-devops-rest-7.0.
   *
   * @param organization
   *    The organization of the AzureDevOps repository
   * @param project
   *    The project that the AzureDevOps repository belongs to
   * @param repositoryId
   *    The id (name) of the repository
   * @param versionType
   *    The type of versioning to filter by (ie 'branch')
   * @param versionId
   *    The id of the version to filter by (ie 'develop')
   * @param path
   *    The path to the item to get content for
   * @param recursionLevel
   *    Whether or not to include the paths content
   * @param apiVersion
   *    The REST api version to use
   */
  @rest(method='GET', skipThis=true)
  content: abstract member function(@rest(partOfURI=true, uriPrefix='/')
                                    organization: string,
                                    @rest(partOfURI=true, uriPrefix='/')
                                    project: string,
                                    @rest(partOfURI=true, uriPrefix='/_apis/git/repositories/', uriSuffix='/items')
                                    repositoryId: string,
                                    @rest(queryParameter=true, parameterName='versionDescriptor.versionType')
                                    versionType: string,
                                    @rest(queryParameter=true, parameterName='versionDescriptor.version')
                                    versionId: string,
                                    @rest(queryParameter=true)
                                    path: string,
                                    @rest(queryParameter=true)
                                    includeContent: string = 'true',
                                    @rest(queryParameter=true, parameterName='api-version')
                                    apiVersion: string = "7.0"): json

  /**
   * Grabs all of the items in a given path.
   * See https://docs.microsoft.com/en-us/rest/api/azure/devops/git/items/list?view=azure-devops-rest-7.0.
   *
   * @param organization
   *    The organization of the AzureDevOps repository
   * @param project
   *    The project that the AzureDevOps repository belongs to
   * @param repositoryId
   *    The id (name) of the repository
   * @param versionType
   *    The type of versioning to filter by (ie 'branch')
   * @param versionId
   *    The id of the version to filter by (ie 'develop')
   * @param scopePath
   *    The path to start listing from
   * @param recursionLevel
   *    The depth to search through. See azure documentation for options
   * @param apiVersion
   *    The REST api version to use
   */
  @rest(method='GET', skipThis=true)
  items: abstract member function(@rest(partOfURI=true, uriPrefix='/')
                                  organization: string,
                                  @rest(partOfURI=true, uriPrefix='/')
                                  project: string,
                                  @rest(partOfURI=true, uriPrefix='/_apis/git/repositories/', uriSuffix='/items')
                                  repositoryId: string,
                                  @rest(queryParameter=true, parameterName='versionDescriptor.versionType')
                                  versionType: string,
                                  @rest(queryParameter=true, parameterName='versionDescriptor.version')
                                  versionId: string,
                                  @rest(queryParameter=true)
                                  scopePath: string,
                                  @rest(queryParameter=true)
                                  recursionLevel: string = 'none',
                                  @rest(queryParameter=true, parameterName='api-version')
                                  apiVersion: string = "7.0"): json

  /**
   * Grabs all of the refs for a repository.
   * See https://docs.microsoft.com/en-us/rest/api/azure/devops/git/refs/list?view=azure-devops-rest-7.0.
   *
   * @param organization
   *    The organization of the AzureDevOps repository
   * @param project
   *    The project that the AzureDevOps repository belongs to
   * @param repositoryId
   *    The id (name) of the repository
   * @param filter
   *    A ref path to filter by, ie 'heads/develop'
   * @param apiVersion
   *    The REST api version to use
   */
  @rest(method='GET', skipThis=true)
  refs: abstract member function(@rest(partOfURI=true, uriPrefix='/')
                                 organization: string,
                                 @rest(partOfURI=true, uriPrefix='/')
                                 project: string,
                                 @rest(partOfURI=true, uriPrefix='/_apis/git/repositories/', uriSuffix='/refs')
                                 repositoryId: string,
                                 @rest(queryParameter=true)
                                 filter: string,
                                 @rest(queryParameter=true, parameterName='$top')
                                 top: int,
                                 @rest(queryParameter=true, parameterName='continuationToken')
                                 continuationToken: string,
                                 @rest(queryParameter=true, parameterName='api-version')
                                 apiVersion: string = "7.0"): json

  /**
   * Makes updates to refs in a repository.  This can create or delete branches, for example.
   * See https://docs.microsoft.com/en-us/rest/api/azure/devops/git/refs/update%20refs?view=azure-devops-rest-7.0
   *
   * @param organization
   *    The organization of the AzureDevOps repository
   * @param project
   *    The project that the AzureDevOps repository belongs to
   * @param repositoryId
   *    The id (name) of the repository
   * @param apiVersion
   *    The REST api version to use
   * @param updates
   *    The updates to make.  See the documentation on docs.microsoft.com for details, but generally, each update
   *    object can have three fields:
   *    - name: the name of the ref (branch, tag, etc.)
   *    - oldObjectId: the old SHA of the item
   *    - newObjectId: the new SHA of the item
   *
   *    To create a new branch, set oldObjectId to '0000000000000000000000000000000000000000' (40 zeroes) and
   *    newObjectId to the commit sha where the branch is being created from.  To delete a branch, set
   *    oldObjectId to the branch's SHA and newObjectId to '0000000000000000000000000000000000000000'.
   */
  @rest(method='POST', skipThis=true)
  updateRefs: abstract member function(@rest(partOfURI=true, uriPrefix='/')
                                       organization: string,
                                       @rest(partOfURI=true, uriPrefix='/')
                                       project: string,
                                       @rest(partOfURI=true, uriPrefix='/_apis/git/repositories/', uriSuffix='/refs')
                                       repositoryId: string,
                                       @rest(queryParameter=true, parameterName='api-version')
                                       apiVersion: string = "7.0",
                                       @rest(doNotUseParameterName=true)
                                       updates: json = []): json

  /**
   * Gets details about a commit
   * https://docs.microsoft.com/en-us/rest/api/azure/devops/git/commits/get?view=azure-devops-rest-7.0
   *
   * @param organization
   *    The organization of the AzureDevOps repository
   * @param project
   *    The project that the AzureDevOps repository belongs to
   * @param repositoryId
   *    The id (name) of the repository
   * @param commidId
   *    The commit SHA
   * @param apiVersion
   *    The REST api version to use
   */
  @rest(method='GET', skipThis=true)
  commit: abstract member function(@rest(partOfURI=true, uriPrefix='/')
                                   organization: !string,
                                   @rest(partOfURI=true, uriPrefix='/')
                                   project: !string,
                                   @rest(partOfURI=true, uriPrefix='/_apis/git/repositories/')
                                   repositoryId: !string,
                                   @rest(partOfURI=true, uriPrefix='/commits/')
                                   commitId: !string,
                                   @rest(queryParameter=true, parameterName='api-version')
                                   apiVersion: string = "7.0"): json

  /**
   * Gets details about a list of commits
   * https://docs.microsoft.com/en-us/rest/api/azure/devops/git/commits/get%20commits?view=azure-devops-rest-7.0
   *
   * @param organization
   *    The organization of the AzureDevOps repository
   * @param project
   *    The project that the AzureDevOps repository belongs to
   * @param repositoryId
   *    The id (name) of the repository
   * @param branchName
   *    The name of the branch to get the commits from
   * @param path
   *     The API will only get commits related to the file/folder path
   * @param author
   *     The author of the commits
   * @param apiVersion
   *    The REST api version to use
   */
  @rest(method='GET', skipThis=true)
  commits: abstract member function(@rest(partOfURI=true, uriPrefix='/')
                                    organization: !string,
                                    @rest(partOfURI=true, uriPrefix='/')
                                    project: !string,
                                    @rest(partOfURI=true, uriPrefix='/_apis/git/repositories/', uriSuffix='/commits')
                                    repositoryId: !string,
                                    @rest(queryParameter=true, parameterName='searchCriteria.itemVersion.version')
                                    branchName: !string,
                                    @rest(queryParameter=true, parameterName='searchCriteria.itemPath')
                                    path: string,
                                    @rest(queryParameter=true, parameterName='searchCriteria.author')
                                    author: string,
                                    @rest(queryParameter=true, parameterName='api-version')
                                    apiVersion: string = "7.0"): json

  /**
   * Gets the file changes for a commit
   * https://docs.microsoft.com/en-us/rest/api/azure/devops/git/commits/get%20changes?view=azure-devops-rest-7.0
   *
   * @param organization
   *    The organization of the AzureDevOps repository
   * @param project
   *    The project that the AzureDevOps repository belongs to
   * @param repositoryId
   *    The id (name) of the repository
   * @param commidId
   *    The commit SHA
   * @param apiVersion
   *    The REST api version to use
   */
  @rest(method='GET', skipThis=true)
  changes: abstract member function(@rest(partOfURI=true, uriPrefix='/')
                                    organization: !string,
                                    @rest(partOfURI=true, uriPrefix='/')
                                    project: !string,
                                    @rest(partOfURI=true, uriPrefix='/_apis/git/repositories/')
                                    repositoryId: !string,
                                    @rest(partOfURI=true, uriPrefix='/commits/', uriSuffix='/changes')
                                    commitId: !string,
                                    @rest(queryParameter=true, parameterName='api-version')
                                    apiVersion: string = "7.0"): json

  /**
   * Gets the details about a pull request
   * https://docs.microsoft.com/en-us/rest/api/azure/devops/git/pull%20requests/get%20pull%20request?view=azure-devops-rest-7.0
   * @param organization
   *    The organization of the AzureDevOps repository
   * @param project
   *    The project that the AzureDevOps repository belongs to
   * @param repositoryId
   *    The id (name) of the repository
   * @param pullRequestId
   *    The pull request number (typically found at the end of a url pointing to a pull request)
   * @param apiVersion
   *    The REST api version to use
   */
  @rest(method='GET', skipThis=true)
  pullRequest: abstract member function(@rest(partOfURI=true, uriPrefix='/')
                                        organization: !string,
                                        @rest(partOfURI=true, uriPrefix='/')
                                        project: !string,
                                        @rest(partOfURI=true, uriPrefix='/_apis/git/repositories/')
                                        repositoryId: !string,
                                        @rest(partOfURI=true, uriPrefix='/pullrequests/')
                                        pullRequestId: !int,
                                        @rest(queryParameter=true, parameterName='api-version')
                                        apiVersion: string = "7.0"): json

  /**
   * Returns all pull-request information under the queried repository.
   * Azure DevOps URI: `GET {organization}/{project}/_apis/git/repositories/{repositoryId}/pullrequests`
   * Example: `AzureDevOps.pullRequests("c3-e/c3server")`
   *
   * @param organization
   *    The organization of the AzureDevOps repository
   * @param project
   *    The project that the AzureDevOps repository belongs to
   * @param repositoryId
   *    The id (name) of the repository
   * @param state
   *    If set, search for pull requests that are in this state. Default to `active`
   * @param top
   *    The number of pull requests to retrieve
   * @param skip
   *    The number of pull requests to ignore (E.g. To retrieve results 101-150, set top to 50 and skip to 100)
   * @param apiVersion
   *    The REST api version to use
   */
  @rest(method='GET', skipThis=true)
  pullRequests: abstract member function(@rest(partOfURI=true, uriPrefix='/')
                                         organization: !string,
                                         @rest(partOfURI=true, uriPrefix='/')
                                         project: !string,
                                         @rest(partOfURI=true,
                                               uriPrefix='/_apis/git/repositories/',
                                               uriSuffix='/pullrequests')
                                         repositoryId: !string,
                                         @rest(queryParameter=true, parameterName='searchCriteria.status')
                                         state: AzureDevOpsPullRequestState,
                                         @rest(queryParameter=true, parameterName='$top')
                                         top: int,
                                         @rest(queryParameter=true, parameterName='$skip')
                                         skip: int,
                                         @rest(queryParameter=true, parameterName='api-version')
                                         apiVersion: string = "7.0"): json

  /**
   * Return all merge requests for a project as a stream.
   * Documentation: https://learn.microsoft.com/en-us/rest/api/azure/devops/git/pull-requests
   *
   * @param org
   *    The organization of the AzureDevOps repository
   * @param project
   *    The project that the AzureDevOps repository belongs to
   * @param repoId
   *    The id (name) of the repository
   * @param state
   *    If set, search for pull requests that are in this state. Default to `active`
   */
  streamPullRequests: member function(org: !string,
                                      project: !string,
                                      repo: !string,
                                      state: AzureDevOpsPullRequestState): stream<AzureDevOpsPullRequest>

  /**
   * Creates a pull request
   * https://docs.microsoft.com/en-us/rest/api/azure/devops/git/pull%20requests/create?view=azure-devops-rest-7.0
   *
   * @param organization
   *    The organization of the AzureDevOps repository
   * @param project
   *    The project that the AzureDevOps repository belongs to
   * @param repositoryId
   *    The id (name) of the repository
   * @param title
   *    The title for the pull request
   * @param targetRefName
   *    The name of the branch that contains all the commits for a pull request. The branch name should be prepended
   *    with `refs/heads/`
   * @param sourceRefName
   *    The name of the branch that the pull request should be merged into. The branch name should be prepended with
   *    `refs/heads/`
   * @param description
   *     The description for the pull request
   * @param apiVersion
   *    The REST api version to use
   */
  @rest(method='POST', skipThis=true)
  createPullRequest: abstract member function(@rest(partOfURI=true, uriPrefix='/')
                                              organization: !string,
                                              @rest(partOfURI=true, uriPrefix='/')
                                              project: !string,
                                              @rest(partOfURI=true,
                                                    uriPrefix='/_apis/git/repositories/',
                                                    uriSuffix='/pullrequests')
                                              repositoryId: !string,
                                              title: !string,
                                              targetRefName: !string,
                                              sourceRefName: !string,
                                              description: string,
                                              @rest(queryParameter=true, parameterName='api-version')
                                              apiVersion: string = "7.0"): json

  /**
   * Post a Git commit status
   * Documentation: https://learn.microsoft.com/en-us/rest/api/azure/devops/git/statuses
   *
   * @param organization
   *    The organization of the AzureDevOps repository
   * @param project
   *    The project that the AzureDevOps repository belongs to
   * @param repositoryId
   *    The id (name) of the repository
   * @param state
   *            The state of the status. Can be one of the following: errored, failed, notApplicable, notSet, pending, succeeded
   * @param targetUrl
   *            The target URL to associate with this status
   * @param description
   *            The short description of the status
   * @param context
   *            Context of the status. Can include `genre` and `name`, either of which can be null.
   */
  @rest(method='POST', skipThis=true)
  postCommitStatus: abstract member function(@rest(partOfURI=true, uriPrefix='/')
                                             organization: !string,
                                             @rest(partOfURI=true, uriPrefix='/')
                                             project: !string,
                                             @rest(partOfURI=true, uriPrefix='/_apis/git/repositories/')
                                             repositoryId: !string,
                                             @rest(partOfURI=true, uriPrefix='/commits/', uriSuffix='/statuses')
                                             commitId: !string,
                                             state: !AzureDevOpsCommitStatusState,
                                             description: string,
                                             targetUrl: string,
                                             context: json,
                                             @rest(queryParameter=true, parameterName='api-version')
                                             apiVersion: string = "7.0"): json

  /**
   * Get all the commit statuses of a commit.
   * Documentation: https://learn.microsoft.com/en-us/rest/api/azure/devops/git/statuses
   *
   * @param organization
   *    The organization of the AzureDevOps repository
   * @param project
   *    The project that the AzureDevOps repository belongs to
   * @param repositoryId
   *    The id (name) of the repository
   * @param state
   *            The state of the status. Can be one of the following: errored, failed, notApplicable, notSet, pending, succeeded
   * @param targetUrl
   *            The target URL to associate with this status
   * @param description
   *            The short description of the status
   * @param context
   *            Context of the status. Can include `genre` and `name`, either of which can be null.
   */
  @rest(method='GET', skipThis=true)
  commitStatuses: abstract member function(@rest(partOfURI=true, uriPrefix='/')
                                           organization: !string,
                                           @rest(partOfURI=true, uriPrefix='/')
                                           project: !string,
                                           @rest(partOfURI=true, uriPrefix='/_apis/git/repositories/')
                                           repositoryId: !string,
                                           @rest(partOfURI=true, uriPrefix='/commits/', uriSuffix='/statuses')
                                           commitId: !string,
                                           @rest(queryParameter=true, parameterName='api-version')
                                           apiVersion: string = "7.0"): json

  /**
   * Updates a pull request
   * https://docs.microsoft.com/en-us/rest/api/azure/devops/git/pull%20requests/update?view=azure-devops-rest-7.0
   *
   * @param organization
   *    The organization of the AzureDevOps repository
   * @param project
   *    The project that the AzureDevOps repository belongs to
   * @param repositoryId
   *    The id (name) of the repository
   * @param pullRequestId
   *    The id of the pull request
   * @param status
   *    The updated status of the pull request.  Ex. 'complete' to merge the pull request.
   * @param apiVersion
   *    The REST api version to use
   */
  @rest(method='PATCH', skipThis=true)
  updatePullRequest: abstract member function(@rest(partOfURI=true, uriPrefix='/')
                                              organization: !string,
                                              @rest(partOfURI=true, uriPrefix='/')
                                              project: !string,
                                              @rest(partOfURI=true, uriPrefix='/_apis/git/repositories/')
                                              repositoryId: !string,
                                              @rest(partOfURI=true, uriPrefix='/pullrequests/')
                                              pullRequestId: !string,
                                              status: !string,
                                              lastMergeSourceCommit: json,
                                              completionOptions: json,
                                              autoCompleteSetBy: string = '',
                                              @rest(queryParameter=true, parameterName='api-version')
                                              apiVersion: string = "7.0"): json

  /**
   * Creates commits on a branch with files
   * https://docs.microsoft.com/en-us/rest/api/azure/devops/git/pushes/create?view=azure-devops-rest-7.0
   *
   * @param organization
   *    The organization of the AzureDevOps repository
   * @param project
   *    The project that the AzureDevOps repository belongs to
   * @param repositoryId
   *    The id (name) of the repository
   * @param refUpdates
   *    Description about the branches where the changes will be committed to. Refer to the documentation linked above
   *    to get the latest JSON structure for this parameter
   * @param commits
   *    The list of commits to be committed on the refs specified in `refUpdates`. Refer to the documentation linked
   *    above to get the latest JSON structure for this parameter
   * @param apiVersion
   *    The REST api version to use
   */
  @rest(method='POST', skipThis=true)
  createContent: abstract member function(@rest(partOfURI=true, uriPrefix='/')
                                          organization: !string,
                                          @rest(partOfURI=true, uriPrefix='/')
                                          project: !string,
                                          @rest(partOfURI=true,
                                                uriPrefix='/_apis/git/repositories/',
                                                uriSuffix='/pushes')
                                          repositoryId: !string,
                                          refUpdates: [json],
                                          commits: [json],
                                          @rest(queryParameter=true, parameterName='api-version')
                                          apiVersion: string = "7.0"): json

  /**
   * Gets the diff between two branches
   * https://docs.microsoft.com/en-us/rest/api/azure/devops/git/diffs/get?view=azure-devops-rest-7.0
   *
   * @param organization
   *    The organization of the AzureDevOps repository
   * @param project
   *    The project that the AzureDevOps repository belongs to
   * @param repositoryId
   *    The id (name) of the repository
   * @param base
   *    The name of the base branch to compare to
   * @param head
   *    The name of the branch that will be compared with `base`
   * @param apiVersion
   *    The REST api version to use
   */
  @rest(method='GET', skipThis=true)
  compare: abstract member function(@rest(partOfURI=true, uriPrefix='/')
                                    organization: !string,
                                    @rest(partOfURI=true, uriPrefix='/')
                                    project: !string,
                                    @rest(partOfURI=true,
                                          uriPrefix='/_apis/git/repositories/',
                                          uriSuffix='/diffs/commits')
                                    repositoryId: !string,
                                    @rest(queryParameter=true, parameterName='baseVersion')
                                    base: !string,
                                    @rest(queryParameter=true, parameterName='targetVersion')
                                    head: !string,
                                    @rest(queryParameter=true, parameterName='api-version')
                                    apiVersion: string = "7.0"): json

  /**
   * Stream all branches of a repo in a project in a pagination manner.
   * @param organization
   *    The organization of the AzureDevOps repository
   * @param project
   *    The project that the AzureDevOps repository belongs to
   * @param repositoryId
   *    The id (name) of the repository
   */
  streamBranches: member function(org: !string, project: !string, repo: !string): stream<json>

  /**
   * Download a repository to the C3 File System by streaming the repository from the Azure DevOps endpoint
   * Documentation: https://learn.microsoft.com/en-us/rest/api/azure/devops/git/items/get?view=azure-devops-rest-7.0&tabs=HTTP
   *
   * @param organization
   *             The organization of the AzureDevOps repository
   * @param project
   *             The project that the AzureDevOps repository belongs to
   * @param repositoryName
   *             Azure DevOps's repository name
   * @param fileUrl
   *             The file url at which to store the downloaded repository. (e.g. `c3fs:///tmp` )
   * @param sha
   *             The commit SHA to download. A tag, branch reference, or SHA can be used. If not specified, defaults to the tip of the default branch.
   */
  downloadRepository: member function(organizationName: !string,
                                      projectName: !string,
                                      repositoryName: !string,
                                      fileUrl: !FileUrl,
                                      sha: string): FileUrl
}
