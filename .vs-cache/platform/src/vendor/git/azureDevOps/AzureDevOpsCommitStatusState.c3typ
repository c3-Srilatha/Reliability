/**
 * Enum type for Azure DevOps commit state.
 * See https://learn.microsoft.com/en-us/rest/api/azure/devops/git/statuses for more documentation.
 */
enum type AzureDevOpsCommitStatusState {

  ERROR = 'error'

  FAILED = 'failed'

  NOT_APPLICABLE = 'notApplicable'

  NOT_SET = 'notSet'

  PENDING = 'pending'

  SUCCEEDED = 'succeeded'
}
