/**
 * C3 Type to encapsulate relevant fields from the Azure DevOps Pull Request response
 * See https://learn.microsoft.com/en-us/rest/api/azure/devops/git/pull-requests for more documentation.
 */
type AzureDevOpsPullRequest {

  repository:            json
  pullRequestId:         int
  codeReviewId:          int
  status:                string
  isDraft:               boolean
  createdBy:             json
  creationDate:          datetime
  title:                 string
  description:           string
  sourceRefName:         string
  targetRefName:         string
  mergeStatus:           string
  mergeId:               string
  lastMergeTargetCommit: json
  lastMergeSourceCommit: json
  lastMergeCommit:       json
  completionOptions:     json
  reviewers:             [json]
  supportsIterations:    boolean
  url:                   string
}
