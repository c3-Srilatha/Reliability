/**
 * Config for {@link Git}
 */
@config(doNotDefaultIfMissing=true)
type Git.Config mixes Config, Named {

  /**
   * url for repository with auth token ex: https://github.com/c3-e/test-integration
   */
  repoUrl: !string serialized GitHubUrl

  /**
   * auth for accessing the repo example "token",
   */
  @config(secret=true)
  auth: private string
}
