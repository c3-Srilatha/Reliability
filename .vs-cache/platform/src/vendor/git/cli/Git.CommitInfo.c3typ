/**
 * Respresent Git commit log information.
 */
type Git.CommitInfo {

  /**
   * commit sha
   */
  sha: string

  /**
   * commit message.
   */
  message: string

  /**
   * author Full Name
   */
  authorName: string

  /**
   * email id of author
   */
  authorEmail: string

  /**
   * Date when commit is authored.
   */
  authorDate: datetime

  /**
   * commit user Full Name
   */
  committerName: string

  /**
   * email id of committer.
   */
  committerEmail: string

  /**
   * Date when commit applied
   */
  commitDate: datetime
}
