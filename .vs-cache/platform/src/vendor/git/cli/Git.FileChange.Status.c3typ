/**
 * Full list of all possible status codes attached to a git object when running `git status`.
 *
 * E.g. "modified" and "delete" in
 *    modified: path/to/file.ext
 *    deleted:  path/to/other/file.ext
 *
 * See {@link https://git-scm.com/docs/git-status#_short_format} for additional details.
 */
enum type Git.FileChange.Status {

  UNMODIFIED
  MODIFIED
  FILE_TYPE_CHANGED
  ADDED
  DELETED
  RENAMED
  COPIED
  UNMERGED
}
