/**
 * Options for {@link Git#clone} operation.
 */
type Git.CloneSpec mixes Spec {

  /**
   * Depth of the clone. The default is 1.
   */
  depth: int32 = 1

  /**
   * If true will delete any existing config & local dir and re-clone the repository.
   */
  force: boolean

  /**
   * Extra options for `git clone` command
   */
  extra: [string]

  /**
   * The auth token; e.g. personal access token scope at X-OAuth-Scopes
   */
  @value(secret=true)
  auth: string
}
