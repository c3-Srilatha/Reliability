/**
 * Represents a git file change.
 */
type Git.FileChange {

  /**
   * sha of the commit
   */
  sha: string

  /**
   * full local file paths in the repository, (not url encoded).
   * e.g
   * platform/zoo/src/main/c3/zoo/resource/pathsTesting/path with spaces.txt
   * platform/zoo/src/main/c3/zoo/resource/pathsTesting/path#with#pound#sign.txt
   * platform/zoo/src/main/c3/zoo/resource/pathsTesting/path+with+plus.txt
   */
  filePath: string

  /**
   * full local file path in repository if renamed from this to {@link Git.FileChange#filePath}, (not url encoded)
   */
  renamedFrom: string

  /**
   * Count of line additions. -1 if file is binary.
   */
  additions: int

  /**
   * Count of line deletions. -1 if file is binary.
   */
  deletions: int

  /**
   * changes/updates made
   */
  status: Git.FileChange.Status
}
