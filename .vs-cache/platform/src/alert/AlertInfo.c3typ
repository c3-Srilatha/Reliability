/**
 * Alert information.
 */
type AlertInfo {

  /**
   * Name of the alert. Used along with cluster or env/app to uniquely identify an alert.
   */
  name: string

  /**
   * Cluster Id
   */
  cluster: string

  /**
   * Name of the env
   */
  env: string

  /**
   * Name of the app
   */
  app: string

  /**
   * Severity of the alert.
   */
  severity: string enum('Critical', 'High', 'Normal')

  /**
   * Human readable message associated with the alert.
   */
  message: string
}
