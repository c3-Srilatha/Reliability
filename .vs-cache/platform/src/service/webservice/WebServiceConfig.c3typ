@seed(userUpdatable=true, userRemovable=true)
entity type WebServiceConfig mixes SeedData<WebServiceConfig> schema name 'WEBSRVC_CFG' {

  description:   string
  urls:          map<string, string> schema name 'URL'
  activeUrlName: !string
  properties:    map<string, string> schema name 'PROP'
  name:          !~
}
