/**
 * This type used map reduce to fetch weather data from type WeatherDataService{@link WeatherDataService}
 */
@invalidationQueueOptions(maxConcurrency=15)
entity type WeatherDataUpdater extends MapReduce<WeatherStation, int, int, int> mixes Value type key 'WTHRUPDTR' {

  /**
   * MapReduce job to update weather data for all the weatherStations.
   *
   * @param filter to apply to WeatherStation
   * @return The MapReduce job information.
   */
  updateWeatherData: function(filter: string): WeatherDataUpdater js-server

  /**
   * Check the status for running weather data job.
   *
   * @return The MapReduce job information.
   */
  updateWeatherDataStatus: function(): MapReduceStatus js-server

  batchSize: ~ = '10'
  include:   ~ = 'id'
  map:       ~ js-server
}
