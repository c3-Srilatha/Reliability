@invalidationQueueOptions(maxConcurrency=4)
entity type TimeZoneUpdater extends MapReduce<WeatherStation, int, int, int> mixes Value type key 'TZUPDTR' {

  /**
   * MapReduce job to update timeZone for all the weatherStations.
   *
   * @param filter
   *           Any filter.
   * @return The MapReduce job information.
   */
  updateTZ: function(): TimeZoneUpdater js-server

  /**
   * Check the status for running timezone updater job.
   *
   * @return The MapReduce job information.
   */
  updateTZStatus: function(): MapReduceStatus js-server

  batchSize: ~ = '100'
  include:   ~ = 'id'
  filter:    ~ = '!exists(timeZone)'
  map:       ~ js-server
}
