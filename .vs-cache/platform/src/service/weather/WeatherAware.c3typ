/**
 * Any entity type mixing WeatherAware will have its "beforeCreate" and "beforeUpdate" claimed
 * by this type. To create "weatherStation" and persist it in the entity that mixes WeatherAware
 * has to pass in the annotation "weather". If the "weather" annotation does not exist, the
 * "beforeCreate" and "beforeUpdate" will return the same object back without creating the
 * weatherStation on it.
 */
abstract type WeatherAware mixes MetricEvaluatable, PersistableWritable {

  weatherStation: WeatherStation

  /**
   * Create weatherStations on the type invoked, if the type mixes in WeatherAware.
   *
   * @return WeatherStationCreator mapr job information.
   */
  refreshWeatherStations: function(): WeatherStationCreator

  /**
   * Check the status for running refreshWeatherStations mapr job.
   *
   * @return The MapReduce job information.
   */
  refreshWeatherStationsStatus: function(): MapReduceStatus

  beforeCreate: ~
  beforeUpdate: ~
}
