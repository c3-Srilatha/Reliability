entity type WeatherDataResult schema name 'WEATHER_DATARSLT' {

  actionId:              string
  numAsyncActions:       int = 0
  numDaysRequested:      int
  numDataPoints:         int
  numZips:               int
  numZipsInvalid:        int
  numZipsNoData:         int
  numZipsRetrySucceeded: int
  numZipsNoTSHeader:     int
  totTimeMillis:         int
  dataPointsByZip:       map<string, int> schema name 'DPZ'
}
