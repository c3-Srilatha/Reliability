/**
 * weather sensor data timeseries data point
 * RAW data point
 */
@db(compactType=true,
    index+=['forecast'],
    datastore='kv',
    partitionKeyField='parent',
    persistenceOrder='start',
    persistDuplicates=false,
    shortId=true,
    shortIdReservationRange=100000)
entity type Observation mixes ObservationFields, TimedDataPoint<WeatherStation> schema name 'weather_Observation'
