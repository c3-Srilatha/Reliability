/**
 * Configuration for {@link WeatherDataService}
 */
type WeatherConfig mixes Config, Singleton {

  /**
   * Maximum history of weather data to fetch from today.
   */
  maxHistoryDays: string

  /**
   * Query interval to fetch weather data.
   */
  interval: string enum Interval

  /**
   * Api key from api.weather.com to use for weather data service.
   */
  @config(secret=true)
  apiKey: string
}
