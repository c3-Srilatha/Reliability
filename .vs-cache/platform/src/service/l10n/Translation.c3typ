/**
 * Type to hold translations for various objects. {@link Translation.c3doc See instructions for defining translations}
 */
// TODO: PLAT-85300 remove remixable
@typesys(remixable=true)
entity type Translation mixes Metadata schema name 'L10N_TRANS' {

  key:    string
  value:  ?string
  locale: Locale

  /**
   * Get the translated string for a given key & locale
   * @param key
   *          Key indicating which translation should be looked up. {@see Translation#makeKey}
   * @param locale
   *          Which locale is the translation desired in. If the translation is not found in the locale of your choice
   *          default fall back will be "en" and if not found in "en", then the original value will be returned
   * @return the translated string
   */
  getTranslationForLocale: function(key: !string, locale: string = 'en'): string

  /**
   * API to return a translation key for the given params
   * @param typeName
   *              Type for which translation has been defined
   * @param id
   *              Object id on which translation is desired (object id should of type `typeName`)
   * @param fieldName
   *              Filed name on which translation is desired (e.g. `id` or `name` or `description`)
   * @return key to be used to fetch the translation
   */
  makeKey: private inline function(typeName: !string, id: !string, fieldName: !string): !string

  /**
   * Replace type name in key of the translation with the base type name
   */
  keyWithBaseType: private inline function(key: string): string

  beforeCreate: ~
  beforeUpdate: ~
}
