entity type TranslationIssue extends DataIssue mixes Value type key 'TRANS' {

  /**
   * Adds an analytic issue to the list of issues.  Should be called by Analytic.process for any data related issues that arise, rather than throwing exceptions
   * that would otherwise end up accumulating as errors in the AnalyticsQueue.
   *
   * @param translation
   *           The Translation object which is having problems
   * @param errorMsg
   *           Error message indicating the nature of the issue.
   */
  addTranslationIssue: function(translation: !Translation, errorMsg: !string)
}
