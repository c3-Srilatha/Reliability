/**
 * Type used to keep track of Cluster events.
 */
entity type ClusterEventLog schema name 'ADMIN_CLSTRLOG' {

  /**
   * Type of event.
   */
  eventType: string enum ClusterEventType

  /**
   * Time when the event happened.
   */
  time: datetime

  /**
   * Who generated the event.
   */
  username: string

  /**
   * Event log.
   */
  event: string
}
