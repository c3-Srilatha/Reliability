/**
 * Represents c3 action execution statistics.
 */
type LogActionStat {

  /**
   * Target '<tenant>:<tag>' for this action.
   */
  tag: string

  /**
   * Target '<type>:<function>' for this action.
   */
  action: string

  /**
   * Status for this action.
   */
  st: string

  /**
   * Starting time of the first action invocation.
   */
  start: datetime

  /**
   * Ending time of the last action invocation.
   */
  end: datetime

  /**
   * Number of times action was invoked.
   */
  count: int

  /**
   * Aggregate time for this action in seconds.
   */
  time: double

  /**
   * Aggregate self time for this action in seconds.
   */
  self: double

  /**
   * Aggregate IO time for this action in seconds.
   */
  io: double

  /**
   * Aggregate SQL database IO time for this action in seconds.
   */
  sql: double

  /**
   * Aggregate KeyValue store IO time for this action in seconds.
   */
  kv: double

  /**
   * User name for this action.
   */
  user: string

  /**
   * Globally unique id for this action.
   */
  id: string

  /**
   * Globally unique parent action id.
   */
  pid: string

  /**
   * Globally unique root action id.
   */
  rid: string
}
