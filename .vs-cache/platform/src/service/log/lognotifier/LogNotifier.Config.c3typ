/**
 * Configuration for {@link LogNotifier} to filter out logs based on level.
 * Note that this configuration does not affect the log level of C3 Server logging itself.
 */
@config(minOverride=ENV, maxOverride=ENV)
type LogNotifier.Config mixes Config, Singleton {

  /**
   * Flag to indicate whether the server logs is disabled
   */
  disabled: boolean

  /**
   * The current logging level selected
   */
  logLevel: string enum Logger.Level = ERROR
}
