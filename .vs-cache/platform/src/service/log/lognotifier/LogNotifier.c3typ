/**
 * LogNotifier is used to orchestrate SSE event listeners for log messages.
 * @see LogNotifier.Config
 */
type LogNotifier mixes Configurable<LogNotifier.Config>, Singleton {

  /**
   * Registers a listener for log messages. All log events regardless of level will be sent via SSE.
   */
  listen: function(): !EventStream<LogNotifier.Event>
}
