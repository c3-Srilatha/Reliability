/**
 * LogNotifier events which contain only the required information from Log4j events.
 * @see https://logging.apache.org/log4j/2.x/javadoc/log4j-core/org/apache/logging/log4j/core/LogEvent.html
 */
type LogNotifier.Event {

  /**
   * Log level.
   */
  level: !Logger.Level

  /**
   * Name of the logger.
   */
  name: !string

  /**
   * Log message.
   */
  message: !string

  /**
   * Stack trace of errors. Only applicable when {@link level} is Logger.Level#ERROR
   */
  stackTrace: string
}
