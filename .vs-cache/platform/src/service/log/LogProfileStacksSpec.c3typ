/**
 * Specifications for LogProfiler.stacks action. The width of each node in the tree is calculated based on the
 * {@link #widthStat} (usually execution time) and ordered by action start time.
 */
type LogProfileStacksSpec mixes LogProfileSpec {

  /**
   * Grouping must be done by ID in order to reconstruct the trees.
   */
  group: ~ = 'id'

  /**
   * The default ordering of actions within a parent is by start time.
   */
  order: ~ = 'start'

  /**
   * Limit for results is increased to allow trees to be built completely.
   */
  limit: ~ = '10000'

  widthStat: string enum('time', 'io', 'sql', 'kv') = 'time'

  /**
   * Option to limit the depth of the trees built.
   */
  maxDepth: int

  /**
   * Ignore actions within the query period that are parented by an action not found within the query period.
   * If false, unrooted actions within the query period end up being placed into a final placeholder tree labeled
   * "(unrooted)".
   */
  ignoreUnrooted: boolean
}
