/**
 * Specifications for LogProfiler.profile action.
 */
type LogProfileSpec mixes Spec, StringSerializable {

  /**
   * Duration for how long in the past should log be analyzed.
   */
  duration: Duration

  /**
   * '<tenant>:<tag>' to be used as a filter.
   */
  tag: string

  /**
   * '<type>.<action>' to be used as a filter.
   */
  action: string

  /**
   * Field name for grouping results.
   */
  group: string enum('tag', 'action', 'id', 'pid', 'rid', 'user') = 'action'

  /**
   * Field name for order.
   */
  order: string enum('tag', 'action', 'id', 'pid', 'rid', 'user', 'count', 'time', 'self', 'io', 'sql', 'kv', 'start') = 'self'

  /**
   * If true then will also produce sql and kv times.
   */
  splitIo: boolean

  /**
   * Root action ID for filter.
   */
  rid: string

  /**
   * Parent action ID for filter.
   */
  pid: string

  /**
   * Limit for results.
   */
  limit: int = 25

  /**
   * Constructs this spec for a ' ' separated list of <field>=<value>; e.g. "duration=1s order=time"
   */
  fromString: ~
}
