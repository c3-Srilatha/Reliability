/**
 * Internal type keeping tack of all HealthCheck type polls.
 */
@db(datastore="fs")
private entity type HealthCheckLog schema name 'HLTH_CHK_LOG' {

  /**
   * Name of the HealthCheck type
   */
  id: ~

  /**
   * Last health check instances for a HealthCheckType
   */
  last: [HealthCheck] schema name 'LAST'

  /**
   * Last health check poll timestamp
   */
  lastPollTimestamp: datetime

  /**
   * If poll is in flight then it's action's id
   */
  activePollActionId: string

  /**
   * Polls HealthCheck and updates this instance
   */
  poll: private member function()
}
