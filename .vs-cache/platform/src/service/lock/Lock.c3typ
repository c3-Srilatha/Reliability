/**
 * A service to acquire a lock and synchronize an action. The scope of the lock will be at the cluster {@see Cluster} level
 * {@see Lock#key} to start building the lock instance
 */
abstract type Lock {

  /**
   * Internal use only : Fields associated with the Lock instance
   */
  spec: private LockSpec

  /**
   * Starting api to use to start building Lock instance. Indicates the lock key.
   * @param key
   *         Key to used to lock
   * @return updated lock instance
   */
  key: inline function(key: !string): !Lock

  /**
   * This is the timeout in milliseconds to wait for before throwing an exception based on {@link doNotThrowOnFailure}
   * @param timeout
   *         Timeout in milliseconds to wait for before throwing an exception based on {@link doNotThrowOnFailure}
   * @return updated lock instance
   */
  timeout: inline member function(timeout: !int): !Lock

  /**
   * Maximum number of times attempts to acquire a lock will be made . This means that it will run at most 1 + maxRetries
   * times including the initial attempt. If both maxRetries and timeout is specified, then whichever comes first will be
   * respected
   */
  maxRetries: inline member function(maxRetries: !int): !Lock

  /**
   * If set, no error will be thrown if failed to acquire lock in desired time {@link timeout}
   * @return updated lock instance
   */
  doNotThrowOnFailure: inline member function(): !Lock

  /**
   * If set, then attempt to lock will be tried exactly once and will neither wait for {@link #timeout} seconds nor {@link #maxRetries}
   * This will also set {@link #doNotThrowOnFailure} to true since it simulates a tryLock which returns true / false
   */
  doNotWait: inline member function(): !Lock

  /**
   * If set, then attempt to lock will be tried exactly once and will neither wait for {@link #timeout} seconds nor {@link #maxRetries}
   * Unlike {@link #doNotWait}, this will throw an exception if the lock is already taken. If customError is provided,
   * this message will override the default message.
   */
  failIfLocked: inline member function(customError: string): !Lock

  /**
   * Acquire the lock in the context of the cluster & execute the action
   * Failure to acquire the lock in the desired amount of time {@see timeout} will throw an exception depending on
   * {@see doNotThrowOnFailure} flag
   * @param action
   *            This function will be invoked if the lock is acquired. The system will ensure that only 1 action is active at the same time for a given key
   * @return Pair<Whether lock acquired (helpful when {@see doNotThrowOnFailure} flag is true), result of the action if any>
   */
  synchronize: abstract member function(action: !lambda(key: !string): any): !Pair<boolean, any>

  /**
   * This function will be called to perform periodic check to see if lock should continue to be held or cleaned up.
   * By default, the scope of the lock will be until the action calling to acquire the lock is alive
   * @param lambda
   *            heartbeat function to be invoked
   * @return updated lock instance
   */
  heartbeat: private member function(lambda: !lambda(entry: !RecoveryState): !boolean): !Lock
}
