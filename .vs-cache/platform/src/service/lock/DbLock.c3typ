/**
 * Acquire a database lock (Backed by relational db)
 */
private type DbLock mixes Lock {

  /**
   * @param obj
   *         instance to "lock".
   * @return a global database-implemented lock.
   */
  fromIdentifiable: function(obj: !Identifiable): !Lock
}
