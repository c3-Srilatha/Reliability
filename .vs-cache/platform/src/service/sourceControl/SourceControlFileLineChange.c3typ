/**
 * Changes for one line in the file
 */
type SourceControlFileLineChange {

  /**
   * File line change kind.
   */
  kind: !string enum('add', 'del')

  /**
   * The original line number before the change
   */
  ln1: int

  /**
   * The new line number after the change
   */
  ln2: int

  /**
   * The line number for the change if the line number remains the same after the change
   */
  ln: int

  /**
   * The content for the line change
   */
  content: string
}
