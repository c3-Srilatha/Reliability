/**
 * Show the changes between two versions of the same file in the Source Control System
 * @see https://en.wikipedia.org/wiki/Diff
 */
type SourceControlFileDiff {

  /**
   * The path of the file in the source control system
   */
  path: string

  /**
   * The additions in the file represented as a group of {@see SourceControlFileLineChange}s
   */
  fileAdditions: [SourceControlFileLineChange]

  /**
   * The deletions in the file represented as a group of {@see SourceControlFileLineChange}s
   */
  fileDeletions: [SourceControlFileLineChange]
}
