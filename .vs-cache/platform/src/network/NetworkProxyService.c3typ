/**
 * This is the base type for all network proxies. We can have proxies for various protocols and multiple proxy
 * implementations per protocol (e.g http proxy using netty, jetty)
 *
 * Each proxy service needs to have two components
 * 1. Proxy server: [netty, jetty], [http, tcp]
 * 2. Proxy Policy [Load balancing, routing, filtering]
 */
@db(unique=['name'], index+=['name'])
@action(group+='cluster-admin')
entity type NetworkProxyService mixes MultiTenantEngine, Nameable schema name 'NPS' {

  /**
   * Port where the service is listening to external requests
   */
  port: !int

  /**
   * The rules applied to figure out the destination server. The policy could be either rule-based or ML.
   */
  policy: !Type

  /**
   * The proxy server used by the service. It could be netty, jetty, vertx etc
   */
  server: !Type

  /**
   * Registers a network proxy. Only registered proxies can direct traffic.
   */
  register: member function()

  /**
   * lists all the network proxies registered with the control cluster
   */
  list: function(limit: int): stream<NetworkProxyService>

  /**
   * all active sessions
   */
  sessions: member function(): [NetworkProxySession]

  /**
   * status of the service
   */
  status: string enum NetworkProxyServiceStatus
}
