abstract type NetworkRoutePolicy<CF: NetworkRoutePolicyConfig> mixes Nameable, Configurable<CF> {

  /**
   * returns the packet with a new destination host/ip and optionally new payload. e.g a new payload may be created if the
   * original payload had headers which gets removed before forwarding the request.
   */
  proxyPkt: abstract member function(packet: !NetworkPacket): !NetworkPacket
}
