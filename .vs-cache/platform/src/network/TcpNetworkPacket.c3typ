/**
 * Type representing a tcp packet
 */
@network(protocol=TCP)
type TcpNetworkPacket mixes TcpConnectionInfo, NetworkPacket {

  /**
   * Is this tcp connect request
   */
  connect: boolean

  /**
   * packet payload
   */
  payload: ByteStream

  /**
   * Netty TCP packet is a combination of netty channel and the payload.
   */
  fromNetty: function(channel: @java(class="java.lang.Object") native,
                      nettyBuf: @java(class="java.lang.Object") native): TcpNetworkPacket
}
