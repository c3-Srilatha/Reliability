/**
 * The socket options are platform dependent. Here is the linux doc https://linux.die.net/man/3/setsockopt
 */
type SocketOptions {

  SO_BACKLOG:   int = 100
  SO_BROADCAST: boolean
  SO_KEEPALIVE: boolean = true
  SO_LINGER:    int
  SO_RCVBUF:    int
  SO_REUSEADDR: boolean
  SO_SNDBUF:    int
  SO_TIMEOUT:   int
  TCP_NODELAY:  boolean
}
