abstract type NetworkProxyServer<CF: NetworkServerConfig> mixes Named, Configurable<CF> {

  start: member function(port: int, policy: NetworkRoutePolicy)
  stop:  member function()

  /**
   * The port on which the proxy server listens. The cloud load balancer on top of the server should have a port
   * opened to route requests to this port.
   */
  port: int

  forName:  ~
  sessions: member function(): [NetworkProxySession]

  /**
   * returns the java server object
   */
  nativeServer: private member function(): @java(class="java.lang.Object") native
}
