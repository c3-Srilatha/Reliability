/**
 * Result type for CloudResource#listResources API.
 */
// TODO: PLAT-30830 use to be CloudListResourcesResult<R: CloudResource>. Revert when fixed.
type CloudListResourcesResult<R> mixes Result {

  /**
   * List of resources.
   */
  resources: [R]

  /**
   * Next marker that can be used to call CloudResource#listResources to get more results.
   */
  nextMarker: string

  /**
   * @return resources as stream.
   */
  stream: member function(): stream<R>

  /**
   * @return count of resources.
   */
  size: member function(): !int

  /**
   * @return first resource.
   */
  first: member function(): R

  /**
   * @return resource at specified index.
   */
  at: member function(index: !int): R java | js | py
}
