/**
 * Azure blob store based file system configuration.
 */
type AzureFsConfig mixes FileSystemConfigChild {

  /**
   * Number of retries due to rate limiting
   */
  maxRetries: ~ = 10

  /**
   * Initial Sleep time for first retry
   */
  initialSleepMillis: ~ = 20

  /**
   * The exponent to multiply the prior wait time in generating the next
   */
  exponent: ~ = 2
}
