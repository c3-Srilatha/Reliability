/**
 * Azure Data Lake Gen2 File System REST API.
 * Allows users to interact with Azure Blob containers through a file system-esk interface.
 * [Rest API definitions](https://docs.microsoft.com/en-us/rest/api/storageservices/datalakestoragegen2/filesystem)
 */
@beta
private type AzureAdlApi mixes REST {

  /**
   * return an instance of AzureAdlApi with auth token set based on credentials provided.
   */
  connect: function(credentials: !AzureCredentials): AzureAdlApi

  /**
   * create a new filesystem.
   */
  @rest(method='PUT')
  createFilesystem: abstract member function(@rest(partOfURI=true)
                                             accountEndpoint: !string,
                                             @rest(partOfURI=true, uriSuffix='?resource=filesystem')
                                             filesystem: !string,
                                             @rest(queryParameter=true)
                                             timeout: int,
                                             @rest(header=true, headerName='x-ms-date')
                                             xMsDate: string,
                                             @rest(header=true, headerName='x-ms-version')
                                             xMsVersion: string)

  /**
   * delete given filesystem.
   */
  @rest(method='DELETE')
  deleteFilesystem: abstract member function(@rest(partOfURI=true)
                                             accountEndpoint: !string,
                                             @rest(partOfURI=true, uriSuffix='?resource=filesystem')
                                             filesystem: !string,
                                             @rest(queryParameter=true)
                                             timeout: int,
                                             @rest(header=true, headerName='x-ms-date')
                                             xMsDate: string,
                                             @rest(header=true, headerName='x-ms-version')
                                             xMsVersion: string)

  /**
   * get metadata of given filesystem.
   */
  @rest(method='HEAD')
  getFilesystemProperties: abstract member function(@rest(partOfURI=true)
                                                    accountEndpoint: !string,
                                                    @rest(partOfURI=true, uriSuffix='?resource=filesystem')
                                                    filesystem: !string,
                                                    @rest(queryParameter=true)
                                                    timeout: int,
                                                    @rest(header=true, headerName='x-ms-date')
                                                    xMsDate: string,
                                                    @rest(header=true, headerName='x-ms-version')
                                                    xMsVersion: string): AzureAdlApiResponseBase

  /**
   * set metadata of given filesystem.
   */
  @rest(method='PATCH')
  setFilesystemProperties: abstract member function(@rest(partOfURI=true)
                                                    accountEndpoint: !string,
                                                    @rest(partOfURI=true, uriSuffix='?resource=filesystem')
                                                    filesystem: !string,
                                                    @rest(queryParameter=true)
                                                    timeout: int,
                                                    @rest(header=true, headerName='x-ms-date')
                                                    xMsDate: string,
                                                    @rest(header=true, headerName='x-ms-version')
                                                    xMsVersion: string)

  /**
   * list all filesystems available in given storage account.
   */
  @rest(method='GET')
  listFilesystems: abstract member function(@rest(partOfURI=true, uriSuffix='?resource=account')
                                            accountEndpoint: !string,
                                            @rest(queryParameter=true)
                                            prefix: string,
                                            @rest(queryParameter=true)
                                            continuation: string,
                                            @rest(queryParameter=true)
                                            maxResults: int,
                                            @rest(queryParameter=true)
                                            timeout: int,
                                            @rest(header=true, headerName='x-ms-date')
                                            xMsDate: string,
                                            @rest(header=true, headerName='x-ms-version')
                                            xMsVersion: string): AzureAdlFileSystemListApiResponse

  /**
   * create a new file or directory in the given filesystem with resource {@link AzureAdlRestResourceType.FILE}.
   * {@link AzureAdlRestResourceType.DIRECTORY}
   */
  @rest(method='PUT', skipThis=true)
  createPath: abstract member function(@rest(partOfURI=true)
                                       accountEndpoint: !string,
                                       @rest(partOfURI=true)
                                       filesystem: !string,
                                       @rest(partOfURI=true, uriPrefix='/')
                                       path: !string,
                                       @rest(queryParameter=true)
                                       resource: string enum AzureAdlRestResourceType,
                                       @rest(queryParameter=true)
                                       timeout: int)

  /**
   * delete the given file or directory from filesystem.
   */
  @rest(method='DELETE', skipThis=true)
  deletePath: abstract member function(@rest(partOfURI=true)
                                       accountEndpoint: !string,
                                       @rest(partOfURI=true)
                                       filesystem: !string,
                                       @rest(partOfURI=true, uriPrefix='/')
                                       path: !string,
                                       @rest(queryParameter=true)
                                       recursive: boolean,
                                       @rest(queryParameter=true)
                                       timeout: int)

  /**
   * get metadata for the given file or directory
   */
  @rest(method='HEAD', skipThis=true)
  getPathProperties: abstract member function(@rest(partOfURI=true)
                                              accountEndpoint: !string,
                                              @rest(partOfURI=true)
                                              filesystem: !string,
                                              @rest(partOfURI=true, uriPrefix='/')
                                              path: !string,
                                              @rest(queryParameter=true)
                                              timeout: int): AzureAdlApiResponseBase

  @rest(method='POST', skipThis=true)
  leasePath: abstract member function(@rest(partOfURI=true)
                                      accountEndpoint: !string,
                                      @rest(partOfURI=true)
                                      filesystem: !string,
                                      @rest(partOfURI=true, uriPrefix='/')
                                      path: !string,
                                      @rest(queryParameter=true)
                                      timeout: int): HttpResponse

  /**
   * list all paths in the given filesystem.
   */
  @rest(method='GET', skipThis=true)
  listPath: abstract member function(@rest(partOfURI=true)
                                     accountEndpoint: !string,
                                     @rest(partOfURI=true, uriSuffix='?resource=filesystem')
                                     filesystem: !string,
                                     @rest(queryParameter=true)
                                     recursive: !boolean,
                                     @rest(queryParameter=true)
                                     directory: string,
                                     @rest(queryParameter=true)
                                     continuation: string,
                                     @rest(queryParameter=true)
                                     maxResults: int,
                                     @rest(queryParameter=true)
                                     timeout: int): AzureAdlPathListApiResponse

  /**
   * read a file.
   */
  @rest(method='GET', skipThis=true)
  readPath: abstract member function(@rest(partOfURI=true)
                                     accountEndpoint: !string,
                                     @rest(partOfURI=true)
                                     filesystem: !string,
                                     @rest(partOfURI=true, uriPrefix='/')
                                     path: !string,
                                     @rest(queryParameter=true)
                                     timeout: int): HttpBinaryResponse

  /**
   * append content to a file content.
   */
  @rest(method='PATCH', skipThis=true)
  appendContent: abstract member function(@rest(partOfURI=true)
                                          accountEndpoint: !string,
                                          @rest(partOfURI=true)
                                          filesystem: !string,
                                          @rest(partOfURI=true, uriPrefix='/', uriSuffix='?action=append')
                                          path: !string,
                                          @rest(queryParameter=true)
                                          position: int,
                                          @rest(doNotUseParameterName=true)
                                          content: binary,
                                          @rest(header=true, headerName='x-ms-content-type')
                                          contentType: string,
                                          @rest(header=true, headerName='x-ms-content-encoding')
                                          contentEncoding: string,
                                          @rest(queryParameter=true)
                                          retainUncommittedData: boolean,
                                          @rest(queryParameter=true)
                                          timeout: int): AzureAdlApiResponseBase

  /**
   * commit the updates to file that were done with AzureAdlPathUpdateAction.APPEND {@link AzureAdlPathUpdateAction}.
   */
  @rest(method='PATCH', skipThis=true)
  flushPath: abstract member function(@rest(partOfURI=true)
                                      accountEndpoint: !string,
                                      @rest(partOfURI=true)
                                      filesystem: !string,
                                      @rest(partOfURI=true, uriPrefix='/', uriSuffix='?action=flush')
                                      path: !string,
                                      @rest(queryParameter=true)
                                      position: int,
                                      @rest(header=true, headerName='x-ms-content-type')
                                      contentType: string,
                                      @rest(header=true, headerName='x-ms-content-encoding')
                                      contentEncoding: string,
                                      @rest(queryParameter=true)
                                      close: boolean,
                                      @rest(queryParameter=true)
                                      timeout: int): AzureAdlApiResponseBase

  /**
   * update a content-type and content-encoding of a file.
   */
  @rest(method='PATCH', skipThis=true)
  updatePathContentTypeAndEncoding: abstract member function(@rest(partOfURI=true)
                                                             accountEndpoint: !string,
                                                             @rest(partOfURI=true)
                                                             filesystem: !string,
                                                             @rest(partOfURI=true,
                                                                   uriSuffix='?action=setProperties',
                                                                   uriPrefix='/')
                                                             path: !string,
                                                             @rest(header=true, headerName='x-ms-content-type')
                                                             contentType: string,
                                                             @rest(header=true, headerName='x-ms-content-encoding')
                                                             contentEncoding: string): AzureAdlApiResponseBase
}
