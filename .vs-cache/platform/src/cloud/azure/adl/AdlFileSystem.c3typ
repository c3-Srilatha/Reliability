/**
 * Azure Data Lake Generation 2.
 * Built on top of Azure Blob Store extends to Azure Data Lake Gen 1 functionality.
 * Note that AdlFileSystem can NOT access Azure Blob Service resources.
 */
@beta
type AdlFileSystem mixes BlobFileSystem<AdlFile>, FileSystemConfigurable<AdlFsConfig>
