/**
 * Azure AD token generation.
 */
@beta
private type AzureAdTokenGenerator mixes REST {

  @rest(method='POST', contentType='application/x-www-form-urlencoded')
  token: abstract function(@rest(partOfURI=true, uriSuffix='/oauth2/v2.0/token')
                           accountName: !string,
                           client_id: !string,
                           client_secret: !string,
                           scope: !string,
                           grant_type: !string): AzureTokenResponse
}
