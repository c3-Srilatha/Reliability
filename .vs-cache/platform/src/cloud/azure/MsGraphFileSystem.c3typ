/**
 * MsGraph based FileSystem implementation to interact with OneDrive and SharePoint.
 * Avoid using it directly - use {@link FileSystem.msgraph} instead.
 */
type MsGraphFileSystem mixes DriveFileSystem<MsGraphFile>, FileSystemConfigurable<MsGraphConfig> {

  doCreateDir:           ~
  capabilities:          ~
}
