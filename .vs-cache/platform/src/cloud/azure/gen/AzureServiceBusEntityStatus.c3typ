@java(runtimeClassName='com.microsoft.azure.management.servicebus.EntityStatus',
      runtimeFieldMapper='JavaEnumToC3EnumMapper')
enum type AzureServiceBusEntityStatus mixes Value {

  ACTIVE
  CREATING
  DELETING
  DISABLED
  RECEIVE_DISABLED
  RENAMING
  RESTORING
  SEND_DISABLED
  UNKNOWN
}
