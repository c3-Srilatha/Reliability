@java(runtimeClassName='com.microsoft.azure.management.storage.SkuName',
      runtimeFieldMapper='JavaStaticRefToC3EnumMapper')
enum type AzureStorageSkuName mixes Value {

  STANDARD_LRS
  STANDARD_GRS
  STANDARD_RAGRS
  STANDARD_ZRS
  PREMIUM_LRS
  PREMIUM_ZRS
  STANDARD_GZRS
  STANDARD_RAGZRS
}
