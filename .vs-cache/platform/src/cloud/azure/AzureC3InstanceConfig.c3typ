// TODO: PLAT-27188 Validate if AzureC3InstanceConfig are needed
type AzureC3InstanceConfig mixes Config, Singleton {

  vmType:             string = "STANDARD_F4"
  imageId:            string
  vmExtensionCommand: string = "sudo sh -c '/usr/bin/curl https://s3-us-west-2.amazonaws.com/c3--packagemanager/ops/bootstrap/public/c3azbootstrap -o /root/c3apibootstrap && export C3_PACKAGE_NAME=%%C3-PACKAGE-NAME%% && nohup sh /root/c3apibootstrap &'"
}
