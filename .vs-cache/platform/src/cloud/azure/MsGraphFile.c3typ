/**
 * MsGraphFile represents OneDrive/SharePoint content
 */
type MsGraphFile mixes DriveFile<MsGraphFileSystem> {

  /**
   * The ID of the drive where the file is stored
   */
  driveId: string

  /**
   * An eTag for the content of the item.
   * This eTag isn't changed if only the metadata is changed.
   * Note This property isn't returned if the item is a folder. Read-only.
   */
  cTag: string

  /**
   * Id of user / identity who created the file.
   */
  createdBy: string

  /**
   * The date and time at which the file was created.
   */
  createdDateTime: datetime
}
