/**
 * Microsoft Graph Service credentials used to access services through the Microsoft Graph Service Client
 */
type MsGraphCredentials mixes AzureCredentials {

  /**
   * Access Token for your MS Graph app.
   */
  @config(secret=true)
  accessToken: string

  /**
   * Refresh Token for your MS Graph app.
   */
  @config(secret=true)
  refreshToken: string

  /**
   * The date and time at which the refresh token expires.
   */
  refreshTokenExpiration: datetime

  /**
   * Scopes are the permissions that the application needs. These must be supplied to the client when it is created.
   */
  scopes: [string] = ["offline_access", "user.read", "files.read", "files.read.all", "files.readwrite", "files.readwrite.all"]

  /**
   * Gets access and refresh tokens from microsoft graph app using Authorization Code through HttpRequest.
   */
  acquireTokenFromAuthorizationCode: member function(authorizationCode: !string,
                                                     redirectUri: !string,
                                                     tenantId: string = "common"): json

  /**
   * Gets access and refresh tokens from microsoft graph app using Authorization Code through HttpRequest.
   */
  acquireTokenWithClientCredentials: member function(tenantId: string = "common"): json

  /**
   * Login endpoint to use when generating access token/refresh token
   */
  loginEndpoint: string = "https://login.microsoftonline.com/"

  client: private cached member function(): @java(class="c3.platform.cloud.azure.client.MsGraphClient") !native
}
