type AzureIoTHubRestIotHubProperties {

  authorizationPolicies:          [AzureIoTHubRestSharedAccessSignatureAuthorizationRule]
  ipFilterRules:                  [AzureIoTHubRestIpFilterRule]
  provisioningState:              string
  state:                          string
  hostName:                       string
  eventHubEndpoints:              map<string, AzureIoTHubRestEventHubProperties>
  routing:                        AzureIoTHubRestRoutingProperties
  storageEndpoints:               map<string, AzureIoTHubRestStorageEndpointProperties>
  messagingEndpoints:             map<string, AzureIoTHubRestMessagingEndpointProperties>
  enableFileUploadNotifications:  boolean
  cloudToDevice:                  AzureIoTHubRestCloudToDeviceProperties
  comments:                       string
  operationsMonitoringProperties: AzureIoTHubRestOperationsMonitoringProperties
  features:                       string
}
