type AzureIoTHubRest mixes REST {

  @rest(uri='/providers/Microsoft.Devices/operations', method='GET')
  Operations_List: abstract function(@rest(queryParameter=true, parameterName='api-version')
                                     apiVersion: string): AzureIoTHubRestOperationListResult

  @rest(method='GET')
  IotHubResource_Get: abstract function(@rest(partOfURI=true, uriPrefix='/subscriptions/')
