type AzureStorageCredentials mixes ConfigChild<AzureCredentials> {

  /**
   * Storage account name
   */
  @config(secret=true)
  accountName: !string

  /**
   * Storage account access key (one of accessKey and sasToken needs to be set, default to accessKey if both set)
   */
  @config(secret=true)
  accessKey: string

  /**
   * Account level SAS token (one of accessKey and sasToken needs to be set, default to accessKey if both set)
   */
  @config(secret=true)
  sasToken: string

  /**
   * @return true credentials have been properly configured. Note this does not mean the credentials are guaranteed
   * to be valid.
   */
  configured: inline member function(): boolean
}
