abstract type AzureSharedAccessResource<RF: AzureSharedAccessAuthorizationRuleResource> mixes AzureGenericResource {

  /**
   * Add a send rule into shared access policy.
   *
   * @param ruleName
   *           The name of the send rule that will be created
   * @param spec
   *           Parameters used to configure this rule upon creation
   */
  @action(group+='cluster-admin')
  addRule: final member function(ruleName: !string, claim: string enum AzureSharedAccessRuleClaim)

  /**
   * Remove a rule from the shared access policy.
   *
   * @param ruleName
   *           The name of the rule that will be removed
   */
  @action(group+='cluster-admin')
  removeRule: final member function(ruleName: !string)

  /**
   * List all the rules currently exist in the shared access policy.
   *
   * @return An array contains all the rules
   */
  @action(group+='cluster-admin')
  listRules: final member function(): [RF]
}
