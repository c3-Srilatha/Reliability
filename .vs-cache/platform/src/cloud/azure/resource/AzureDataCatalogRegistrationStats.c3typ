/**
 * Contains a summary of types registered with Azure Data Catalog
 */
type AzureDataCatalogRegistrationStats {

  /**
   * Collection of types provided by the user
   */
  requestedTypes: [string]

  /**
   * Types successfully registered with Azure Data Catalog
   */
  registeredTypes: [string]

  /**
   * Types that were unable to be registered. Refer to the log files to determine
   * why registration failed.
   */
  unregisteredTypes: [string]
}
