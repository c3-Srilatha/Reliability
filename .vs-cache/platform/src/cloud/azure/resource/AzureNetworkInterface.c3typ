@azure(client='networkInterfaces',
       cloudFunc='aznic',
       hasResourceArn=false,
       hasResourceId=true,
       hasResourceName=true,
       hasTags=true,
       identityRoleOptions=OPTIONAL)
type AzureNetworkInterface mixes AzureGenericResource, AzureNetworkInterfaceFields, AzureSubnetMember, AzureNetworkSecurityGroupMember {

  @azure(writeMapping={privateIPAllocationMethod: "'DYNAMIC'", subnet_: 'subnet', name_: "'ipConfig1'"})
  ipConfigurations: ~

  @azure(readMapping={this: 'ipConfigurations[0].subnet_'})
  subnet: ~

  @azure(readMapping={this: 'networkSecurityGroup_'})
  networkSecurityGroup: ~

  @azure(writeMapping={this: 'networkSecurityGroup'})
  networkSecurityGroup_: ~
}
