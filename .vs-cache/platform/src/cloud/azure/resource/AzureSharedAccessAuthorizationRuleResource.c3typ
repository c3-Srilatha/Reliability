abstract type AzureSharedAccessAuthorizationRuleResource<T, K: AzureSharedAccessAuthorizationKeysFields> mixes AzureGenericChildResource<T> {

  /**
   * Retrieves the key for this authorization rule.
   */
  @action(group+='cluster-admin')
  keys: member function(): K

  /**
   * Regenerates new access keys for this authorization rule.
   *
   * @param keyType
   *           Determines the key type (ie. primary or secondary) to regenerate.
   *           @see AzureSharedAccessAuthorizationKeyType
   */
  @action(group+='cluster-admin')
  regenerateKey: member function(keyType: AzureSharedAccessAuthorizationKeyType): K
}
