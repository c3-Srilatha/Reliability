/**
 * Azure Data Catalog REST API proxy and C3 IoT helper methods
 */
type AzureDataCatalogDataAssetRest mixes REST {

  /**
   * Searches over data assets based on the search terms provided.
   * Example: AzureDataCatalog.searchCatalogREST("DefaultCatalog", "2016-03-30", "*", null, 1, 10)
   * @param catalogName - Name of the catalog, or "DefaultCatalog" to use the default catalog.
   * @param apiVersion - The API version
   * @param searchTerms - Terms to search on
   * @param facets - A comma separated field names to facet the results on.
   * @param startPage - Start Page of the results used for pagination.   Must be a value greater than 0.
   * @param returnItemCount - Number of results wanted ina page.
   * @param view - Gets the view the client wants to see, for now the only supported option in DataSource.
   * @return HttpResponse
   */
  @rest(method='GET', uri='catalogs/', contentType='application/json')
  searchCatalog: private abstract function(@rest(partOfURI=true)
                                           catalogName: !string,
                                           @rest(partOfURI=true, uriPrefix='/search/search?api-version=')
                                           apiVersion: !string,
                                           @rest(partOfURI=true, uriPrefix='&searchTerms=')
                                           searchTerms: !string,
                                           @rest(partOfURI=true, uriPrefix='&facets=')
                                           facets: string,
                                           @rest(partOfURI=true, uriPrefix='&startPage=')
                                           startPage: int,
                                           @rest(partOfURI=true, uriPrefix='&count=')
                                           returnItemCount: int,
                                           @rest(partOfURI=true, uriPrefix='&view=')
                                           view: string): AzureDataCatalogSearchResults

  /**
   * Invokes the AzureDataCatalog create asset API to publish C3 Types as Azure Data
   * Catalog tables
   * @param catalogName - name of the Azure Data Catalog catalog
   * @param apiVersion - Azure Data Catalog version to use for the API call
   * @param roles - security principal to be used when creaating the asset
   * @param properties - system properties
   * @param annotations - represent types of metadata that can be assigned to other types within the catalog.
   * @return HttpResponse
   */
  @rest(method='POST', uri='catalogs/', contentType='application/json')
  createAsset: private abstract function(@rest(partOfURI=true, uriSuffix='/views/tables?')
                                         catalogName: !string,
                                         @rest(partOfURI=true, uriPrefix='api-version=')
                                         apiVersion: !string,
                                         roles: [AzureDataCatalogRole],
                                         properties: AzureDataCatalogProperties,
                                         annotations: AzureDataCatalogAnnotation): HttpResponse

  /**
   * Proxy of the Azure Data Catalog REST API.  Deletes an asset from the specified Azure Data Catalog
   * @param catalogName - Array of types to be published to Azure Data Catalog
   * @param viewName - Name of the data asset view
   * @param viewItemId - id of a view item
   * @param api-version - Azure Data Catalog API version
   * @returns HttpResponse
   */
  @rest(method='DELETE', uri='catalogs/', contentType='application/json')
  deleteAsset: private abstract function(@rest(partOfURI=true)
                                         catalogName: !string,
                                         @rest(partOfURI=true, uriPrefix='/views/')
                                         viewName: !string,
                                         @rest(partOfURI=true, uriPrefix='/')
                                         viewItemId: !string,
                                         @rest(partOfURI=true, uriPrefix='?api-version=')
                                         apiVersion: !string = '2016-03-30'): HttpResponse
}
