/**
 * Contains metadata of Azure Blob containers.
 */
@cloud(hasResourceArn=false,
       hasResourceId=false,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='azbc')
type AzureBlobContainer mixes CloudResource, AzureResourceGroupMember {

  /**
   * Full Azure container url with SAS authentication token. If set, this field overrides the container name and AzureConfig storage settings for this container
   *
   * SAS is shared access signature used by azure to grant limited access to objects in your storage account to other clients.
   * @see https://docs.microsoft.com/en-us/azure/storage/common/storage-dotnet-shared-access-signature-part-1
   */
  sasUrl: string

  /**
   * The eTag of this container
   */
  eTag: string

  /**
   * The last modified date of this container
   */
  lastModified: datetime

  /**
   * @return the #credentials of the cloud resource including azure specific credential fields
   */
  azureCredentials: member function(): !AzureCredentials

  /**
   * Creates this container in the cloud if it doesn't exist
   * @return true if the container did not already exist and was created; otherwise, false
   */
  upsertContainer: member function(): !boolean

  /**
   * Deletes this container in the cloud if it exists
   * @return true if the container existed and was deleted; otherwise, false
   */
  destroyContainer: member function(): !boolean

  /**
   * List Azure blobs in a particular container under this Azure service
   * @param path
   *            Relative path in this container to perform the list operation
   * @param limit
   *            The max number of results that will be returned in one list operation
   * @param marker
   *            String marker returned from previous listBlobs calls for continuing the list operation, set to null or empty for new operation
   * @param readMetadta
   *            Whether to read the metadata of the blobs while listing
   * @param shallow
   *            When set to true, do not list files in sub-directories
   * @return AzureListBlobResult contains a blob array and a next marker string. If no more result is available on the Azure Cloud, next marker will be set to null
   */
  listBlobs: member function(path: string,
                             limit: int,
                             marker: string,
                             readMetadata: boolean,
                             shallow: boolean): !AzureListBlobsResult

  /**
   * List all the Azure blobs in a particular container under this Azure service
   * @param path
   *          Relative path in this container to perform the list operation
   * @param readMetadta
   *          Whether to read the metadata of the blobs while listing
   * @param shallow
   *            When set to true, do not list files in sub-directories
   * @return AzureListBlobResult contains a blob array
   */
  listAllBlobs: member function(path: string, readMetadata: boolean, shallow: boolean): !AzureListBlobsResult

  hasTags:         ~
  upsertResource:  ~
  getResource:     ~
  destroyResource: ~
  listResources:   ~
  credentials:     AzureCredentials
}
