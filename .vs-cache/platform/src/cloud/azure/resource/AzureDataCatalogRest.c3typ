/**
 * Azure Data Catalog Admin REST API proxy and C3 IoT helper methods.
 */
type AzureDataCatalogRest mixes REST {

  id: string

  @ser(name='type')
  az_type: string

  tags:       map<string, string>
  name:       string
  location:   string
  properties: AzureDataCatalogCatalogProperties
  value:      [AzureDataCatalogRest]

  /**
   * Returns list of available catalogs.
   */
  @rest(method='GET', uri='subscriptions/', contentType='application/json')
  listCatalogs: abstract function(@rest(partOfURI=true)
                                  subscriptionId: !string,
                                  @rest(partOfURI=true,
                                        uriPrefix='/resourceGroups/',
                                        uriSuffix='/providers/Microsoft.DataCatalog/catalogs?api-version=2016-03-30')
                                  resourceGroup: !string): AzureDataCatalogRest

  @rest(method='GET', uri='subscriptions/', contentType='application/json')
  getCatalog: abstract function(@rest(partOfURI=true, uriPrefix='/')
                                subscriptionId: !string,
                                @rest(partOfURI=true, uriPrefix='/resourceGroups/')
                                resourceGroup: !string,
                                @rest(partOfURI=true,
                                      uriPrefix='/providers/Microsoft.DataCatalog/catalogs/',
                                      uriSuffix='?api-version=2016-03-30')
                                catalogName: !string): AzureDataCatalogRest

  @rest(method='PUT', uri='subscriptions/', contentType='application/json')
  createCatalog: abstract function(@rest(partOfURI=true)
                                   subscriptionId: !string,
                                   @rest(partOfURI=true, uriPrefix='/resourceGroups/')
                                   resourceGroup: !string,
                                   @rest(partOfURI=true,
                                         uriPrefix='/providers/Microsoft.DataCatalog/catalogs/',
                                         uriSuffix='?api-version=2016-03-30')
                                   catalogName: !string,
                                   @rest(doNotUseParameterName=true)
                                   catalogDefinition: AzureDataCatalogRest): AzureDataCatalogRest

  @rest(method='DELETE', uri='subscriptions/', contentType='application/json')
  deleteCatalog: abstract function(@rest(partOfURI=true)
                                   subscriptionId: !string,
                                   @rest(partOfURI=true, uriPrefix='/resourceGroups/')
                                   resourceGroup: !string,
                                   @rest(partOfURI=true,
                                         uriPrefix='/providers/Microsoft.DataCatalog/catalogs/',
                                         uriSuffix='?api-version=2016-03-30')
                                   catalogName: !string): HttpResponse
}
