@azure(client='eventHubNamespace',
       child='authorizationRules',
       childOnImpls=true,
       cloudFunc='azevhbnsar',
       hasResourceArn=false,
       hasResourceId=true,
       hasResourceName=true,
       hasTags=false,
       identityRoleOptions=OPTIONAL)
type AzureEventHubNamespaceAuthorizationRule mixes AzureSharedAccessAuthorizationRuleResource<AzureEventHubNamespace, AzureEventHubAuthorizationKeysFields>, AzureEventHubAuthorizationRuleFields {

  /**
   * List the Azure event hub namespace authorization rule in a event hub namespace.
   *
   * @param resourceGroupName
   *           Name of the Azure resource group that the Azure event hub namespace is in
   * @param namespaceName
   *           Name of the Azure event hub namespace
   * @param spec
   *           spec to list resources.
   * @return the list of Azure event hubs
   */
  listByNamespace: function(resourceGroupName: !string,
                            namespaceName: !string,
                            spec: CloudListResourcesSpec)
                     : !CloudListResourcesResult<AzureEventHubNamespaceAuthorizationRule>

  toImpl:          ~
  getResource:     ~
  destroyResource: ~
}
