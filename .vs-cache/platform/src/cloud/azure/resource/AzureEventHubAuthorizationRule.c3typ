@azure(client='eventHub',
       child='authorizationRules',
       childOnImpls=true,
       cloudFunc='azevhbar',
       hasResourceArn=false,
       hasResourceId=true,
       hasResourceName=true,
       hasTags=false,
       identityRoleOptions=OPTIONAL)
type AzureEventHubAuthorizationRule mixes AzureSharedAccessAuthorizationRuleResource<AzureEventHub, AzureEventHubAuthorizationKeysFields>, AzureEventHubAuthorizationRuleFields {

  /**
   * List the Azure event hub authorization rule.
   *
   * @param resourceGroupName
   *           Name of the Azure resource group that the Azure event hub is in
   * @param eventHubNamespace
   *           Namespace of the Azure event hub
   * @param eventHubName
   *           Name of the Azure event hub
   * @param spec
   *           spec to list resources.
   * @return the list of Azure event hubs
   */
  listByEventHub: function(resourceGroupName: !string,
                           eventHubNamespace: !string,
                           eventHubName: !string,
                           spec: CloudListResourcesSpec): !CloudListResourcesResult<AzureEventHubAuthorizationRule>

  parentResourceName: ~
  toImpl:             ~
  fromImpl:           ~
  getResource:        ~
  destroyResource:    ~
}
