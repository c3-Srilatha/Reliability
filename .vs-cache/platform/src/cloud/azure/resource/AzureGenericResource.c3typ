abstract type AzureGenericResource mixes CloudResource, AzureResourceGroupMember {

  /**
   * The state of this Azure resource.
   */
  state: string

  /**
   * @return the #credentials of the cloud resource including azure specific credential fields
   */
  azureCredentials: member function(): !AzureCredentials

  /**
   * Converts C3 cloud resource to Azure native implementations object.
   */
  toImpls: private member function(): @java(class="java.lang.Object") native

  /**
   * Converts C3 cloud resource to Azure native implementation object.
   *
   * @param isCreate
   *        specifies whether the object will be used to create a resource.
   */
  toImpl: private member function(isCreate: boolean): @java(class="java.lang.Object") native

  /**
   * Converts Azure native object to C3 cloud resource.
   *
   * @param impl
   *        The Azure native resource object on which to perform the conversion.
   */
  fromImpl: private function(impl: @java(class="java.lang.Object") native): mixing AzureGenericResource

  hasTags:              ~
  hasResourceArn:       ~
  hasResourceId:        ~
  hasResourceName:      ~
  hasResourceGroupName: ~
  identityRoleOptions:  ~
  upsertResource:       ~
  getResource:          ~
  destroyResource:      ~
  listResources:        ~
  credentials:          AzureCredentials
}
