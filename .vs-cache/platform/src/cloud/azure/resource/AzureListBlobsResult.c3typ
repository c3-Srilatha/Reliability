/**
 * This type is used to keep the result of listBlobs method
 */
type AzureListBlobsResult {

  /**
   * List of blobs
   */
  blobs: [AzureBlob]

  /**
   * If there are large number of blobs with path prefix that was used for listBlobs call then nextMarker
   * can be used to retrieve subsequent set of blobs. It's set to null if no more results available.
   */
  nextMarker: string
}
