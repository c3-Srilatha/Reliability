@azure(client='eventHubs',
       cloudFunc='azevhb',
       hasResourceArn=false,
       hasResourceId=true,
       hasResourceName=true,
       hasTags=false,
       identityRoleOptions=OPTIONAL)
@action(group+='app-admin')
type AzureEventHub mixes AzureSharedAccessResource<AzureEventHubAuthorizationRule>, AzureEventHubNamespaceMember, CloudStream<CloudStreamMessage>, AzureEventHubFields {

  RESOURCE_NAME_DELIMITER: const string = '/'

  /**
   * Represents the uniquely identifiable Event Hub resource in the format: <eventHubName>/<namespace>/<resourceGroupName>
   */
  resourceName: ~

  /**
   * Parses the #resourceName in the following format: "<eventHubName>/<namespace>/<resourceGroupName>" into a
   * triple where:
   * fst: event hub name
   * snd: event hub namespace
   * thd: event hub resource group
   */
  parseResourceName: private inline function(resourceName: !string): Triple<string, string, string>

  /**
   * Constructs the #resourceName in the following format: "<eventHubName>/<namespace>/<resourceGroupName>"
   *
   * @param eventHubName
   *           Name of the Azure event hub instance
   * @param namespace
   *           Name of the Azure event hub namespace
   * @param resourceGroupName
   *           Name of the Azure event hub resource group
   * @return the #resourceName in the format: "<eventHubName>:<namespace>:<resourceGroupName>"
   */
  makeResourceName: private function(eventHubName: !string, namespace: !string, resourceGroupName: !string): !string

  /**
   * List the Azure event hubs in a event hub namespace.
   *
   * @param resourceGroupName
   *           Name of the Azure resource group that the Azure event hub namespace is in
   * @param namespaceName
   *           Name of the Azure event hub namespace
   * @param spec
   *           spec to list resources.
   * @return the list of Azure event hubs
   */
  listByNamespace: function(resourceGroupName: !string,
                            namespaceName: !string,
                            spec: CloudListResourcesSpec): !CloudListResourcesResult<AzureEventHub>

  /**
   * Add an event consumer group.
   *
   * @param groupName
   *           The name of the consumer group that will be created
   */
  addConsumerGroup: member function(groupName: !string)

  /**
   * Remove an event consumer group.
   *
   * @param groupName
   *           The name of the consumer group that will be removed
   */
  removeConsumerGroup: member function(groupName: !string)

  /**
   * List all the consumer groups currently exist in this event hub.
   *
   * @return An array contains all the consumer groups
   */
  listConsumerGroups: member function(): [AzureEventHubConsumerGroupFields]

  /**
   * Determines whether consumer group exists.
   *
   * @param groupName
   *           The name of the consumer group to be checked.
   * @param failIfMissing
   *           Throws exception if group is missing.
   * @return whether the consumer group exists on this event hub resource.
   */
  consumerGroupExists: member function(groupName: !string, failIfMissing: boolean): !boolean

  toImpl:               ~
  fromImpl:             ~
  getResource:          ~
  upsertResource:       ~
  destroyResource:      ~
  generateResourceName: ~
  peekMessages:         ~
}
