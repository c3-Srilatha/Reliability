/**
 * Deployment result with the output from various deployments
 */
type AzureDeploymentResult {

  /**
   * Application gateways public ip address. This will be used to login to the console.
   */
  agPublicIpAddress: !string

  /**
   * Url to the C3 console. E.g. https://52.232.229.203/console/
   */
  consoleEndPoint: !string

  /**
   * Domain names of the master nodes. E.g. ["dev-podc-app-m-01"]
   */
  masterNodes: [string]

  /**
   * Domain names of the worker nodes. E.g. ["dev-podc-app-w-001"]
   */
  workerNodes: [string]

  /**
   * Domain names of the zookeeper nodes. E.g. ["dev-podc-zk-01", "dev-podc-zk-02", "dev-podc-zk-03"]
   */
  zkNodes: [string]

  /**
   * Domain names of the cassandra nodes. E.g. ["dev-podc-cass-001", "dev-podc-cass-129", "dev-podc-cass-257"]
   */
  cassNodes: [string]

  /**
   * Domain names of the pg node(s). E.g. ["dev-podc-pg-01"]
   */
  pgNodes: [string]

  /**
   * Public Ip address of the bastion node. This could be used to ssh into the bastion node for logging into any of the
   * other resources
   */
  bastionPublicIpAddress: !string

  /**
   * The resource group name
   */
  resourceGroupName: string

  /**
   * The C3 server package that was deployed e.g. c3-server-development-7.9.2.11-1.x86_64.rpm
   */
  package: string
}
