/**
 * Azure OAuth token. Extends the C3 Platform out of the box OAuthAccessTokenResponse type with
 * Azure specific properties.
 */
type AzureOAuthToken mixes OAuthAccessTokenResponse {

  ext_expires_in: int
  expires_in:     int
  expires_on:     int
  not_before:     int
  resource:       string
}
