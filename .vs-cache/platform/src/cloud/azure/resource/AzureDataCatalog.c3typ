@cloud(cloudFunc="azdc")
type AzureDataCatalog mixes AzureGenericResource, AzureResource {

  id:         string
  name:       string
  location:   string
  properties: AzureDataCatalogCatalogProperties

  /**
   * Implementation of abstract methods
   */
  cloudFunc: ~ js-server

  listResources:          ~ js-server
  destroyResource:        ~ js-server
  upsertResource:         ~ js-server
  destroyResourceBatch:   ~ js-server
  getResource:            ~ js-server
  hasResourceArn:         ~ js-server
  hasResourceId:          ~ js-server
  hasResourceName:        ~ js-server
  hasResourceGroupName:   ~ js-server
  upsertWithDependencies: ~ js-server
  waitForDestroy:         ~ js-server
}
