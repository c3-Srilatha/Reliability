type AzureOAuth mixes REST {

  /**
   * Refresh the expired OAuth token
   */
  refreshAccessToken: function(resource: !string) js-server

  /**
   * Invokes the Azure's OAuth refresh access token API.
   * @param client_id - the Azure client id.
   * @param grant_type - OAuth grant type. In this case, refresh_token.
   * @param refresh_token - the Azure OAuth refresh token
   * @param resource - the App Id URl of the target Azure service.  In this case Data Catalog.
   * @return Azure OAuth token response
   */
  @rest(method='POST', contentType='application/x-www-form-urlencoded')
  refreshAccessTokenRest: abstract function(client_id: !string,
                                            grant_type: !string,
                                            refresh_token: !string,
                                            resource: !string): AzureOAuthToken

  /**
   * Get the OAuth access token
   */
  getAccessToken: function(resource: string) js-server

  /**
   * Invokes the Azure's OAuth access token API to get a token.
   * @param client_id - the Azure client id.
   * @param grant_type - OAuth grant type. In this case, authorization_code.
   * @param code - Must be authorization_code.
   * @param redirect_uri - redirect uri used to acquire the authorization code.
   * @param resource - the App Id URl of the target Azure service.  In this case Data Catalog.
   * @return Azure OAuth token
   */
  @rest(method='POST', contentType='application/x-www-form-urlencoded')
  getAccessTokenRest: abstract function(client_id: string,
                                        grant_type: string,
                                        code: string,
                                        redirect_uri: string,
                                        resource: string): AzureOAuthToken
}
