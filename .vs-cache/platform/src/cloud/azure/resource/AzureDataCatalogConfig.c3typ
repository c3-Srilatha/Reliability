/**
 * Azure Data Catalog configuration parameters to enable REST API access to
 * the Azure Data Catalog service.
 */
type AzureDataCatalogConfig mixes Config, Singleton {

  /**
   * The access token to the desired resource
   */
  dataAssetAccessToken: string

  catalogAssetToken: string

  /**
   * The Azure OAuth refresh token.
   */
  dataAssetRefreshToken: string

  catalogAssetRefreshToken: string

  /**
   * The Azure API client id
   */
  clientId: string

  /**
   * The App Id URl of the target Azure service.  In this case
   * it is the Azure Data Catalog URI.
   */
  dataAssetResource: string

  catalogAssetResource: string

  /**
   * The user principal first name.
   */
  principalFirstName: string

  /**
   * The user principal last name
   */
  principalLastName: string

  /**
   * The user principal name
   */
  principalUpn: string

  /**
   * Azure data asset API authorization code
   */
  dataAssetAuthCode: string

  /**
   * Azure catalog management authorization code.
   */
  catalogAuthCode: string

  /**
   * The Azure application tenant
   */
  tenantId: string

  /**
   * The redirect_uri of the app.  The value is rn:ietf:wg:oauth:2.0:oob
   */
  redirectUri: string

  /**
   * The time when the access token expires. The date is represented as the number of
   * seconds from 1970-01-01T0:0:0Z UTC until the expiration time.
   * This value is used to determine the lifetime of cached tokens.
   */
  expiresOn: double

  expiresNotBefore: double

  /**
   * Indicates the token type value.
   */
  tokenType: string

  catalog:        string
  subscriptionId: string
  resourceGroup:  string
}
