/**
 * Enum type for Azure Blob Types
 */
enum type AzureBlobType {

  /**
   * Block blobs let you upload large blobs efficiently with streaming capability
   */
  BLOCK = 'BLOCK_BLOB'

  /**
   * Page blobs are collections of 512-byte pages optimized for random read and write operations
   */
  PAGE = 'PAGE_BLOB'

  /**
   * Append blobs are optimized for append operations, updating or deleting of existing blocks are not supported
   */
  APPEND = 'APPEND_BLOB'
}
