/**
 * Implements azure deployment templates e.g. cassandra, zookeeper, masters, workers, etc.
 */
@azure(cloudFunc='azdeploy',
       hasResourceArn=false,
       hasResourceId=false,
       hasResourceName=true,
       hasTags=false,
       identityRoleOptions=OPTIONAL)
type AzureDeployment mixes AzureGenericResource {

  /**
   * Template for the azure deployment
   */
  template: !json

  /**
   * Input values to the template
   */
  parameters: json

  /**
   * outputs as a result of this deployment
   */
  outputs: map<string, any>

  upsertResource:  ~
  getResource:     ~
  listResources:   ~
  destroyResource: ~
}
