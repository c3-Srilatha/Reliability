@azure(client='routeTables',
       cloudFunc='azrt',
       hasResourceArn=false,
       hasResourceId=true,
       hasResourceName=true,
       hasTags=true,
       identityRoleOptions=OPTIONAL)
type AzureRouteTable mixes AzureGenericResource, AzureRouteTableFields, AzureRoutesMember {

  /**
   * During upsert operations, the value of routes_ will be populated from the value in field {@link routes}
   */
  @azure(writeMapping={this: 'routes'})
  routes_: ~

  /**
   * During read operations, the value of routes will be populated from the value in field {@link routes_}
   */
  @azure(readMapping={this: 'routes_'})
  routes: ~
}
