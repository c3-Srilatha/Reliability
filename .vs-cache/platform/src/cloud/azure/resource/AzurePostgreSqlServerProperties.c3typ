type AzurePostgreSqlServerProperties {

  createMode: string enum('Default', 'GeoRestore', 'Replica')

  /**
   * Only used when createMode = 'GeoRestore' || 'Replica'
   */
  sourceServerId: string

  earliestRestoreDate:      string
  fullyQualifiedDomainName: string
  masterServerId:           string
  replicaCapacity:          int
  replicationRole:          string
  sslEnforcement:           string enum EnableAndDisable
  storageProfile:           AzurePostgreSqlServerStorageProfile
  userVisibleState:         string enum('Disabled', 'Dropping', 'Ready')
  version:                  string enum('10', '10.0', '10.2', '11', '9.5', '9.6')
}
