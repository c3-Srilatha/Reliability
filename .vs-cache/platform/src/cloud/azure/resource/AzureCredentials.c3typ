/**
 * Azure credentials used to access supported services through the Azure SDK .
 */
type AzureCredentials mixes CloudCredentials, StringSerializable {

  /**
   * Azure Subscription ID.
   */
  accountId: ~

  /**
   * Returns storage account name from storage credentials if configured otherwise system storage account name
   */
  accountName: inline member function(): string

  /**
   * Azure Managed Identity.
   * e.g: azmi:<subscription_id>:<rg_id>:<client_id>
   */
  cloudIdentity: ~

  /**
   * Active Directory ID. In some azure documents this is referred to as tenant id.
   */
  activeDirectoryId: string

  /**
   * Active Directory Client ID. This is the application id of the app registered in AD.
   */
  accessKey: ~

  /**
   * Active Directory Client Secret. This key is created during app registration.
   */
  secretKey: ~

  /**
   * The date and time at which the client secret expires.
   */
  secretKeyExpiration: datetime

  /**
   * The Azure sasBlobEndpoint. Default is blob.core.windows.net. For specific deployments, this may need to be set in
   * order to have the sasUrl populated in {@link AzureFile}
   */
  sasBlobEndpoint: string = 'blob.core.windows.net'

  /**
   * Azure Storage Credentials
   */
  storageCredentials: AzureStorageCredentials

  /**
   * Azure shared access policy name.
   */
  sharedAccessPolicyName: string

  /**
   * Azure shared access policy key.
   */
  @config(secret=true)
  sharedAccessPolicyKey: string

  /**
   * The administrator's login name of a server when it is required for resource creation.
   */
  adminUsername: string

  /**
   * The password of the administrator login, used together with #adminUsername for resource creation.
   */
  @config(secret=true)
  adminPassword: string

  /**
   * The partner id usually represented as a GUID/UUID that is registered with Azure to facilitate partner resource
   * usage attribution.
   * format: pid-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
   */
  partnerId: string

  /**
   * Azure Subscription ID; alias to CloudCredentials#accountId
   */
  subscriptionId: inline member function(): string

  /**
   * Active Directory Client ID. This is the application id of the app registered in AD; alias to CloudCredentials#accessKey
   */
  activeDirectoryClientId: inline member function(): string

  /**
   * Active Directory Client Secret. This key is created during app registration; alias to CloudCredentials#secretKey
   */
  activeDirectoryClientSecret: inline member function(): string

  /**
   * @return true if this instance has Azure Management Credentials (i.e. not just Azure Storage Credentials)
   */
  @deprecated(finalVersion="7", details="Use #configured")
  hasManagementCredentials: inline member function(): boolean

  /**
   * @return true if this instance has Azure Storage Credentials
   */
  @deprecated(finalVersion="7", details="Use #storageCredentialsConfigured")
  hasStorageCredentials: inline member function(): boolean

  /**
   * @return true if this instance has Azure Storage credentials configured
   */
  storageCredentialsConfigured: inline member function(): boolean

  /**
   * Azure application token credentials
   */
  tokenCredentials: private member function(): native

  /**
   * Parses managed identity and create map
   */
  managedIdentityAttributes: member function(): map<string, string>

  /**
   * Azure Msi Credentials
   */
  msiCredentials: member function(): native

  /**
   * true if msi is configured; false otherwise;
   */
  isMsi: member function(): boolean

  /**
   * Loads storage account access keys using MSI auth and cache them in memory
   */
  storageAccountAccessKeys: private member function(): AzureStorageCredentials

  /**
   * Prepares managed service identity id based on user/system managed identity.
   */
  msiId: member function(): string

  /**
   * Cached azure client for this instance of AzureCredentials - this is important since every azure operation should cached
   * azure client for the credentials
   */
  azureBlobClient: private cached member function(containerName: string)
                                           : @java(class="c3.platform.cloud.azure.client.AzureBlobContainerClient") !native
}
