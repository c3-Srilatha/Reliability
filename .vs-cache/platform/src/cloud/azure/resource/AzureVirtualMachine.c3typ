@azure(client='virtualMachines',
       cloudFunc='azvm',
       hasResourceArn=false,
       hasResourceId=true,
       hasResourceName=true,
       hasTags=true,
       identityRoleOptions='OPTIONAL',
       nonModifiableFields=['plan', 'osProfile.computerName'],
       stripNonModifiable=true)
type AzureVirtualMachine mixes AzureGenericResource, AzureVirtualMachineFields, CloudComputeInstance, AzureNetworkInterfaceMembers {

  applyExtensionCommand: private member function(command: !string)
  fromJava:              ~: mixing AzureVirtualMachine
  toJava:                ~

  @azure(writeMapping={'networkInterfaces_.id_': 'networkInterfaces.id_'})
  networkProfile: ~

  @azure(readMapping={resourceId: 'networkProfile.networkInterfaces_.id_'})
  networkInterfaces: ~
}
