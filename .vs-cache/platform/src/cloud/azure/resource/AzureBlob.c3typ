/**
 * C3 Azure Blob contains the metadata and content of a Azure Blob
 */
type AzureBlob mixes Content {

  /**
   * The container that this Azure Blob belongs to
   */
  container: string

  /**
   * Full Azure blob url with SAS authentication token. If set, this field overrides the container and AzureConfig storage settings for this blob
   *
   * SAS is shared access signature used by azure to grant limited access to objects in your storage account to other clients.
   * @see https://docs.microsoft.com/en-us/azure/storage/common/storage-dotnet-shared-access-signature-part-1
   */
  sasUrl: string

  /**
   * Type of the Azure Blob
   */
  blobType: string enum AzureBlobType

  /**
   * Delete this AzureBlob if exists
   * @param spec
   *          @see FileOperationSpec
   * @return true if the blob was deleted; otherwise, false
   */
  deleteBlob: member function(spec: DeleteFileOperationSpec): !boolean

  /**
   * Upsert the metadata of this blob to the Azure cloud (except for user defined metadata)
   * @param spec
   *           @see FileOperationSpec
   */
  upsertProperties: member function(spec: FileOperationSpec)

  /**
   * Convert this AzureBlob to AzureFile.
   * @param readMetadata
   *                 Whether to read metadata from the cloud when converting to AzureFile
   * @param spec
   *                 @see FileOperationSpec
   * @return instance of AzureFile
   */
  toFile: member function(readMetadata: boolean, spec: FileOperationSpec): !AzureFile

  /**
   * Create AzureBlob from provided File.
   */
  fromFile: function(file: !?File): AzureBlob
}
