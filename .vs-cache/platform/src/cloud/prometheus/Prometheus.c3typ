/**
 * Prometheus HTTP API abstraction.
 * https://prometheus.io/docs/prometheus/latest/querying/api
 */
@action(group='cluster-admin')
type Prometheus mixes REST<Prometheus.Config>, Named {

  /**
   * https://prometheus.io/docs/prometheus/latest/querying/api/#instant-queries
   */
  @rest(uri='api/v1/query',
        method='POST',
        contentType='application/x-www-form-urlencoded',
        skipThis=true,
        partOfURI=true)
  query: abstract member function(@rest(queryParameter=true)
                                  query: !string,
                                  @rest(queryParameter=true)
                                  time: datetime,
                                  @rest(queryParameter=true)
                                  timeout: string serialized Duration,
                                  @rest(queryParameter=true)
                                  limit: int,
                                  @rest(queryParameter=true)
                                  lookback_delta: double): Prometheus.Response<Prometheus.Response.QueryData>

  /**
   * https://prometheus.io/docs/prometheus/latest/querying/api/#alerts
   */
  @rest(uri='api/v1/alerts', method='GET', skipThis=true)
  alerts: abstract member function(@rest(queryParameter=true) query: !string): json

  /**
   * https://prometheus.io/docs/prometheus/latest/querying/api/#range-queries
   */
  @rest(uri='api/v1/query_range',
        method='POST',
        contentType='application/x-www-form-urlencoded',
        skipThis=true,
        partOfURI=true)
  queryRange: abstract member function(@rest(queryParameter=true)
                                       query: !string,
                                       @rest(queryParameter=true)
                                       start: !datetime,
                                       @rest(queryParameter=true)
                                       end: !datetime,
                                       @rest(queryParameter=true)
                                       step: !string serialized Duration,
                                       @rest(queryParameter=true)
                                       timeout: string serialized Duration,
                                       @rest(queryParameter=true)
                                       limit: int,
                                       @rest(queryParameter=true)
                                       lookback_delta: double)
                                : Prometheus.Response<Prometheus.Response.QueryRangeData>

  /**
   * https://prometheus.io/docs/prometheus/latest/querying/api/#finding-series-by-label-matchers
   */
  @rest(uri='api/v1/series',
        method='POST',
        contentType='application/x-www-form-urlencoded',
        skipThis=true,
        partOfURI=true)
  series: abstract member function(@rest(queryParameter=true, parameterName='match[]')
                                   match: !string,
                                   @rest(queryParameter=true)
                                   start: !datetime,
                                   @rest(queryParameter=true)
                                   end: !datetime): Prometheus.Response<[map<string, string>]>

  /**
   * Get all label names.
   * https://prometheus.io/docs/prometheus/latest/querying/api/#getting-label-names
   */
  @rest(uri='api/v1/labels', method='GET', skipThis=true)
  labels: abstract member function(@rest(queryParameter=true, parameterName='match[]')
                                   match: string,
                                   @rest(queryParameter=true)
                                   start: datetime,
                                   @rest(queryParameter=true)
                                   end: datetime,
                                   @rest(queryParameter=true)
                                   limit: int): Prometheus.Response<[string]>

  /**
   * Get label values for a specific label name.
   * https://prometheus.io/docs/prometheus/latest/querying/api/#querying-label-values
   */
  @rest(uri='api/v1/label', method='GET', skipThis=true, partOfURI=true)
  label: abstract member function(@rest(partOfURI=true, uriPrefix='/', uriSuffix='/values')
                                  labelName: !string,
                                  @rest(queryParameter=true, parameterName='match[]')
                                  match: string,
                                  @rest(queryParameter=true)
                                  start: datetime,
                                  @rest(queryParameter=true)
                                  end: datetime,
                                  @rest(queryParameter=true)
                                  limit: int): Prometheus.Response<[string]>

  /**
   * Get all metric names from Prometheus.
   * Equivalent to: GET /api/v1/label/__name__/values
   * https://prometheus.io/docs/prometheus/latest/querying/api/#querying-label-values
   */
  @rest(uri='api/v1/label/__name__/values', method='GET', skipThis=true)
  metricNames: abstract member function(@rest(queryParameter=true, parameterName='match[]')
                                        match: string,
                                        @rest(queryParameter=true)
                                        start: datetime,
                                        @rest(queryParameter=true)
                                        end: datetime,
                                        @rest(queryParameter=true)
                                        limit: int): Prometheus.Response<[string]>

  /**
   * Get metadata for all metrics.
   * https://prometheus.io/docs/prometheus/latest/querying/api/#querying-metric-metadata
   */
  @rest(uri='api/v1/metadata', method='GET', skipThis=true)
  metadata: abstract member function(@rest(queryParameter=true)
                                     metric: string,
                                     @rest(queryParameter=true)
                                     limit: int,
                                     @rest(queryParameter=true)
                                     limit_per_metric: int)
                              : Prometheus.Response<map<string, [Prometheus.MetadataEntry]>>

  /**
   * Get Prometheus configuration status.
   * https://prometheus.io/docs/prometheus/latest/querying/api/#config
   */
  @rest(uri='api/v1/status/config', method='GET', skipThis=true)
  statusConfig: abstract member function(): Prometheus.Response<Prometheus.StatusConfig>

  /**
   * Get Prometheus runtime information.
   * https://prometheus.io/docs/prometheus/latest/querying/api/#runtime-information
   */
  @rest(uri='api/v1/status/runtimeinfo', method='GET', skipThis=true)
  statusRuntimeInfo: abstract member function(): Prometheus.Response<Prometheus.StatusRuntimeInfo>

  /**
   * Get Prometheus build information.
   * https://prometheus.io/docs/prometheus/latest/querying/api/#build-information
   */
  @rest(uri='api/v1/status/buildinfo', method='GET', skipThis=true)
  statusBuildInfo: abstract member function(): Prometheus.Response<Prometheus.StatusBuildInfo>

  /**
   * Get TSDB (Time Series Database) head statistics.
   * https://prometheus.io/docs/prometheus/latest/querying/api/#tsdb-stats
   */
  @rest(uri='api/v1/status/tsdb', method='GET', skipThis=true)
  statusTsdb: abstract member function(): Prometheus.Response<Prometheus.StatusTsdb>

  /**
   * Get target discovery status.
   * https://prometheus.io/docs/prometheus/latest/querying/api/#targets
   */
  @rest(uri='api/v1/targets', method='GET', skipThis=true)
  targets: abstract member function(@rest(queryParameter=true) state: string): Prometheus.Response<Prometheus.Targets>

  /**
   * Get recording and alerting rules.
   * https://prometheus.io/docs/prometheus/latest/querying/api/#rules
   */
  @rest(uri='api/v1/rules', method='GET', skipThis=true)
  rules: abstract member function(@rest(queryParameter=true) type: string): Prometheus.Response<Prometheus.Rules>
}
