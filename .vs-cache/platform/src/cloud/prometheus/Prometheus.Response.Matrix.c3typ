// https://prometheus.io/docs/prometheus/latest/querying/api/#range-vectors
type Prometheus.Response.Matrix {

  metric: map<string, string>

  // [[unix_time, value as string]], tuple syntax does not work
  values: [[any]]

  // still experimental
  histograms: [any]
}
