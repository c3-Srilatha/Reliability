type Prometheus.Response.QueryData {

  resultType: string enum("matrix", "vector", "scalar", "string")

  /**
   * Structure changes depending on the resultType.
   * "matrix" - https://prometheus.io/docs/prometheus/latest/querying/api/#range-vectors: array of {@link Prometheus.Response.Matrix}
   * "vector" - https://prometheus.io/docs/prometheus/latest/querying/api/#instant-vectors: array of {@link Prometheus.Response.Vector}
   * "scalar" - https://prometheus.io/docs/prometheus/latest/querying/api/#scalars: array of unix_timestamp, value.
   * "string" - https://prometheus.io/docs/prometheus/latest/querying/api/#strings: array of unix_timestamp, value.
   */
  result: json
}
