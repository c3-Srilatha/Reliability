type Prometheus.Rule {

  name:           string
  query:          string
  duration:       double
  labels:         map<string, string>
  annotations:    map<string, string>
  alerts:         [Prometheus.Alert]
  health:         string enum Prometheus.RuleHealth
  evaluationTime: double
  lastEvaluation: datetime
  state:          string enum Prometheus.RuleState

  @ser(name='type')
  ruleType: string enum Prometheus.RuleType
}
