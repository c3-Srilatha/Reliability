/**
 * Result type for CloudServiceOrchestrator#services API.
 */
/*
 * TODO: PLAT-30830 use to be CloudListServiceResult<S: CloudServiceSession>. Revert back when fixed.
 * TODO: PLAT-15601 Refactor CloudListResourcesResult so that CloudListServiceResult can mix
 */
type CloudListServiceResult<S> mixes Result {

  /**
   * List of resources.
   */
  resources: [S]

  /**
   * Next marker that can be used to call CloudResource#listResources to get more results.
   */
  nextMarker: string

  /**
   * @return resources as stream.
   */
  stream: member function(): stream<S>

  /**
   * @return count of resources.
   */
  size: member function(): !int

  /**
   * @return first resource.
   */
  first: member function(): S

  /**
   * @return resource at specified index.
   */
  get: member function(index: !int): S
}
