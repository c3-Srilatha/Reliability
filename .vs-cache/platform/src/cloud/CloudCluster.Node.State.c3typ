/**
 * State of the Cloud Cluster Node
 */
enum type CloudCluster.Node.State {

  /**
   * Node is initializing
   */
  INITIALIZING

  /**
   * Node is starting
   */
  STARTING

  /**
   * Node is running
   */
  RUNNING

  /**
   * Node is not responding
   */
  UNREACHABLE

  /**
   * Node is stopping
   */
  STOPPING

  /**
   * Node is stopped
   */
  STOPPED

  /**
   * Node is gone
   */
  GONE

  /**
   * Node is busy
   */
  BUSY
}
