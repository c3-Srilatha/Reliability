/**
 * Canonical representation of a reference to a Cloud Resource.
 *
 * Cloud providers typically are not very consistent in the way references to cloud resources are managed. I.e. given
 * resource type may use field named `id`, `name` or alternative to identify the resource. Sometime more then one field
 * can uniquely identify the resource and what's worse different API can return different fields and values to identify
 * same resource.
 *
 * C3 is using CloudRef to remove this ambiguity.
 *
 * Additionally CloudRef implements consistent way to encode such references into string. This string then can be used
 * elsewhere like in a corresponding config file name.
 *
 * @see CloudRef
 * @see #toString
 * @see #fromString
 */
type CloudRef mixes StringSerializable {

  /**
   * Value of the reference.
   */
  value: !string

  /**
   * Name of the Cloud Resource field for this reference.
   */
  fieldName: !string enum CloudRefField

  /**
   * Returns string serialized representation of this reference based on `fieldName`:
   * - if it is "id" then returns "<id>" - i.e. just `id` field value of this reference
   * - if it is "resourceId" then returns string in the format of "#id: <id>"
   * - if it is "resourceSecondaryId" then returns string in the format of "#secondary-id: <resourceSecondaryId>"
   * - if it is "resourceName" then returns string in the format of "#name: <resourceName>"
   */
  toString: ~

  /**
   * Constructs instance of the Cloud Reference based on the provided string value that is expected to be in the format
   * described in #toString.
   */
  fromString: ~

  isId:                  inline member function(): boolean
  isResourceId:          inline member function(): boolean
  isResourceName:        inline member function(): boolean
  isResourceSecondaryId: inline member function(): boolean

  /**
   * Constructs instance of the Cloud Reference based on the provided Cloud Resource.
   */
  fromResource: inline function(resource: !CloudResourceKeyFields, failIfInvalid: boolean): CloudRef

  /**
   * Constructs instance of the Cloud Reference based on the provided C3 Cloud Identifier.
   */
  fromId: inline function(id: !?string, failIfInvalid: boolean): CloudRef

  /**
   * Constructs instance of the Cloud Reference based on the provided Cloud Resource Id.
   */
  fromResourceId: inline function(resourceId: !?string): CloudRef

  /**
   * Constructs instance of the Cloud Reference based on the provided Cloud Resource Name.
   */
  fromResourceName: inline function(resourceName: !?string): CloudRef

  /**
   * Constructs instance of the Cloud Reference based on the provided Cloud Resource Secondary Id.
   */
  fromResourceSecondaryId: inline function(resourceSecondaryId: !?string): CloudRef
}
