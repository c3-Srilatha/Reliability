/**
 * Spec for CloudServiceOrchestrator#stopService API.
 */
type CloudServiceStopSpec mixes CloudServiceSpec {

  /**
   * Maximum number of empty nodes to clean up when the service is stopped.
   * 0 effectively disables cleanup, -1 represents uncapped max.
   */
  maxNodeCleanUp: int = -1

  /**
   * Reason for stopping the service.
   */
  reason: string

  /**
   * If set to true {@link CloudService.terminate} would wait for resourced to be completely removed
   */
  waitForDestroy: boolean

  /**
   * Default is false, will block the termination of actively connected cloudService.
   * If set to true, will skip the check
   */
  forceTerminate: boolean

  /**
   * Default is false, will block the stop of actively connected cloudService.
   * If set to true, will skip the check
   */
  forceStop: boolean
}
