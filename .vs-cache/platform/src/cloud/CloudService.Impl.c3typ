/**
 * impl for the base type for all Cloud Services
 */
abstract private type CloudService.Impl<S: CloudService> {

  cloudService: !S

  /**
   * Specific type of cloud service
   */
  cloudServiceType: property(): Type<<S>>

  /**
   * Ensure the existence of a Cloud Service if it does not already exist.
   *
   * @param spec
   *         Specifications to start a Cloud Service.
   * @return created CloudService instance
   */
  doEnsureService: abstract member function(spec: CloudServiceStartSpec): mixing CloudService.Impl

  /**
   * Hibernate Cloud Service by releasing ephemeral resources but maintaining state as needed so it can be woken up at later time.
   *
   * @param spec
   *         Specifications to stop a Cloud Service.
   */
  doStop: abstract member function(spec: CloudServiceStopSpec)

  /**
   * Return a list of deployed {@link CloudService}s.
   *
   * @param tags
   *         List of {@link CloudTag}s to filter {@link CloudService}s returned by this api.
   * @return list of {@link CloudService}s that match {@link CloudTag} filters.
   */
  doList: abstract member function(tags: [CloudTag]): [CloudService]

  /**
   * Return a list of deployed {@link CloudService} IDs.
   *
   * @param tags
   *         List of {@link CloudTag}s to filter CloudService IDs returned by this api.
   * @return list of CloudService ID strings that match {@link CloudTag} filters.
   */
  doListKeys: abstract member function(tags: [CloudTag]): [string]

  /**
   * Abort and terminate Cloud Service and by default discard all state.
   *
   * @param spec
   *         Specifications to stop a Cloud Service.
   */
  doTerminate: abstract member function(confirm: boolean, spec: CloudServiceStopSpec)

  /**
   * @return `true` if this CloudService is currently deployed
   */
  isDeployed: abstract member function(): boolean
}
