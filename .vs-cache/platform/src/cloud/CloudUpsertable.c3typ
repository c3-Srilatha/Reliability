/**
 * Represents Cloud Resource that can be created, updated or destroyed.
 */
abstract type CloudUpsertable {

  /**
   * Create or update Cloud Resource.
   */
  upsertResource: abstract member function(spec: CloudResourceOperationSpec): !mixing CloudUpsertable

  /**
   * Create or update Cloud Resource with all of its configured dependencies.
   */
  upsertWithDependencies: abstract member function(spec: CloudResourceOperationSpec): !mixing CloudUpsertable

  /**
   * Destroy existing Cloud Resource.
   */
  destroyResource: abstract member function(spec: CloudResourceDestroySpec)

  /**
   * Wait until the resource is destroyed. Returns `false` on timeout by default - {@link WaitSpec#failOnTimeout}
   */
  waitForDestroy: abstract member function(spec: WaitSpec): boolean
}
