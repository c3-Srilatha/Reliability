type CloudStreamMessage mixes CloudMessage {

  /**
   * The cloud stream partition that this message belongs to
   */
  partition: string

  /**
   * The sequence number of the message in the cloud stream.
   * Here number is represented as string to support large number some cloud streams use e.g {@link AwsKinesis}
   * uses number which is string of digits up to 128.
   */
  sequenceNumber: string

  createFromString: ~
}
