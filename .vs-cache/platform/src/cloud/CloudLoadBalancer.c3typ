/**
 * Represents network or application load balancer.
 */
abstract type CloudLoadBalancer mixes CloudDefaultInstance {

  /**
   * To register a cloud {@link CloudComputeInstance} into a load balancer.
   *
   * @param instance
   *          The {@link CloudComputeInstance} to be registered.
   * @param port
   *          The listening port of the compute instance. If not specified
   */
  registerInstance: abstract member function(instance: !CloudComputeInstance, port: !int)

  /**
   * To deregister/remove a cloud {@link CloudComputeInstance} from a load balancer.
   *
   * @param instance
   *          The {@link CloudComputeInstance} to be registered.
   * @param port
   *          The listening port of the compute instance.
   */
  deregisterInstance: abstract member function(instance: !CloudComputeInstance, port: !int)
}
