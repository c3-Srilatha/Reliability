type CloudCluster.Meta {

  /**
   * Who started the resource
   */
  startedBy: User

  /**
   * When the CloudCluster was started
   */
  started: datetime

  /**
   * Who last updated the resource
   */
  lastUpdatedBy: User

  /**
   * When the CloudCluster was last updated
   */
  lastUpdated: datetime

  /**
   * Updates lastedUpdatedBy and lastUpdated to the latest time and user.
   */
  update: function(meta: !?CloudCluster.Meta): CloudCluster.Meta
}
