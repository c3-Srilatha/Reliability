/**
 * abstract type to represent AWS Resource which is associated with a aws vpn gateway.
 */
abstract type AwsVpnGatewayMember {

  /**
   * The id of the vpn gateway the resource is associated with.
   */
  vpnGateway: !AwsVpnGateway

  /**
   * Get the vpn gateway for the given resource
   */
  safeVpnGateway: member function(): AwsVpnGateway
}
