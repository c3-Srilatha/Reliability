/**
 * ECS task a instance of a task running on AWS ECS
 */
@cloud(hasResourceArn=true,
       hasResourceId=true,
       hasResourceName=false,
       hasResourceGroupName=false,
       identityRoleOptions='REQUIRED',
       cloudFunc='ecst')
type AwsEcsTask mixes CloudContainerDeployment, AwsResource, AwsEc2InstancesMember, AwsEcsTaskDefinitionMember, AwsEcsClusterMember, AwsSecurityGroupMember, AwsSubnetMember {

  /**
   * The version counter for the task
   */
  version: int

  /**
   * The Amazon Resource Name (ARN) of the container instances that host the task
   */
  containerInstanceArn: string

  /**
   * The containers associated with the task
   */
  containers: [AwsEcsDockerContainer]

  /**
   * The Unix timestamp for when the task was created (the task entered the PENDING state)
   */
  createdAt: datetime

  /**
   * The desired status of the task
   */
  desiredStatus: string enum AwsEcsTaskStatus

  /**
   * The name of the task group associated with the task
   */
  group: string

  launchType: string enum AwsEcsLaunchType

  /**
   * The last known status of the task
   */
  lastStatus: string enum AwsEcsTaskStatus

  /**
   * The Unix timestamp for when the task was started (the task transitioned from the PENDING state to the RUNNING state)
   */
  startedAt: datetime

  /**
   * The tag specified when a task is started
   */
  startedBy: string

  /**
   * The Unix timestamp for when the task was stopped (the task transitioned from the RUNNING state to the STOPPED state)
   */
  stoppedAt: datetime

  /**
   * The reason the task was stopped
   */
  stoppedReason: string

  /**
   * The reason for status change request
   */
  changeReason: string

  /**
   * The number of instantiations of the specified task to place on your cluster
   */
  count: int

  /**
   * Categorized state of this ECS task
   */
  state: string

  /**
   * The placement constraints for the tasks
   */
  placementConstraints: [AwsEcsPlacementConstraint]

  /**
   * The placement strategy that determines how tasks are placed
   */
  placementStrategy: [AwsEcsPlacementStrategy]

  /**
   * Container overrides that specify the overrides that containers should receive
   */
  overrides: AwsEcsTaskOverride

  /**
   * Network configuration needed when {@link AwsEcsTaskDefinitionNetworkMode} is awsvpc
   */
  networkConfiguration: AwsEcsTaskNetworkConfiguration

  hasTags: ~

  /**
   * Get the Endpoint for this ECS task
   * @param failIfMissing
   *            if true, then throw an error if there is no endpoint configured yet
   * @return the endpoint
   */
  endpoint: member function(failIfMissing: boolean): AwsEndpoint

  /**
   * Wait until the ECS task is not in PENDING status
   * @param spec
   *          The parameters that defines the wait length, strategy, number of retry, and etc.
   * @return the resource instance after the wait is completed
   */
  waitForNotPending: member function(spec: WaitSpec): AwsEcsTask

  /**
   * Returns the task definition revision of this task from template
   */
  taskDefinitionRevision: member function(): !string
}
