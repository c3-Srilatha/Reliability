/**
 * Enum for all possible instance group types in the Emr cluster
 */
enum type AwsEmrInstanceGroupType {

  /**
   * Master instance group of the Emr cluster
   */
  MASTER

  /**
   * Slave instance group of the Emr cluster
   */
  CORE

  /**
   * Task instance group of the Emr cluster
   */
  TASK
}
