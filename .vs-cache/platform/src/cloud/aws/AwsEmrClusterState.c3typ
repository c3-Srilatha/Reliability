/**
 * Enum for all possible states of the Emr cluster
 */
enum type AwsEmrClusterState {

  /**
   * The emr cluster is running bootstrap actions
   */
  BOOTSTRAPPING

  /**
   * The emr cluster is processing steps
   */
  RUNNING

  /**
   * The emr cluster is launching a new job flow
   */
  STARTING

  /**
   * The emr cluster is terminated in a normal way
   */
  TERMINATED

  /**
   * The emr cluster is terminated with errors. Often happens when starting fails
   */
  TERMINATED_WITH_ERRORS

  /**
   * The emr cluster is in the process of terminating
   */
  TERMINATING

  /**
   * The job flow of the emr cluster is waiting for instruction
   */
  WAITING
}
