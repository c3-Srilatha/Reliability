/**
 * AWS Relational Database SubnetGroup
 */
@cloud(hasResourceArn=true,
       hasResourceId=false,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='subgrp')
type AwsRdsSubnetGroup mixes AwsResource, AwsSubnetsMember {

  /**
   * The description for the DB subnet group.
   */
  description: string

  awsServiceName: ~
}
