/**
 * Enumeration of all available regions that health checkers will reside.
 */
enum type AwsHostedZoneHealthCheckRegion {

  US_EAST_1 = 'us-east-1'

  US_WEST_1 = 'us-west-1'

  US_WEST_2 = 'us-west-2'

  EU_WEST_1 = 'eu-west-1'

  AP_NORTHEAST_1 = 'ap-northeast-1'

  AP_SOUTHEAST_1 = 'ap-southeast-1'

  AP_SOUTHEAST_2 = 'ap-southeast-2'

  SA_EAST_1 = 'sa-east-1'
}
