/**
 * Input to {@link AwsCloudWatch#metricStatistics}.
 */
type AwsCloudWatchMetricStatisticsSpec mixes AwsCloudWatchMetricDimensions, Spec {

  /**
   * The time stamp that determines the first data point to return.
   */
  startTime: !datetime

  /**
   * The time stamp that determines the last data point to return.
   */
  endTime: !datetime

  /**
   * The granularity, in seconds, of the returned data points. A period can be as short as one minute (60 seconds) and
   * must be a multiple of 60. The default value is 300.
   */
  period: int = 300

  /**
   * The metric statistic types of interest and will be output in the AwsCloudWatchdataPoint. If empty then all
   * statistics will be retrieved
   */
  statistics: [string]
}
