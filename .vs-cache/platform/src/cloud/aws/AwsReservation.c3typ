/**
 * This type provides an interface to the AWS *Reservations*
 * Costs are returned per instance per hour
 */
abstract type AwsReservation {

  /**
   * type of instance
   */
  instanceType: string

  /**
   * The currency (in USD) of the Reserved Instance.
   */
  currencyCode: string

  /**
   * The Reserved Instance offering type.
   */
  offeringType: string enum AwsReservedInstanceOfferingTypeValues

  /**
   * The Reserved Instance product platform description.
   */
  productDescription: string

  /**
   * The number of reservations purchased.
   */
  instanceCount: int

  /**
   * The state of the Reserved Instance purchase.
   */
  state: string enum AwsReservedInstanceState

  /**
   * The upfront cost per reserved instance.
   */
  upfrontCostPerInstance: double = 0

  /**
   * Hourly cost per instance mapped
   */
  hourlyCostPerInstance: double = 0

  /**
   * Hourly Amortized Cost per instance
   */
  hourlyAmortizedCostPerInstance: double = 0

  /**
   * Hourly cost
   * hourlyCostPerInstance * instanceCount
   */
  hourlyCost: double

  /**
   * Hourly amortized cost
   * hourlyAmortizedCostPerInstance * instanceCount
   */
  hourlyAmortizedCost: double

  /**
   * Upfront cost
   * upfrontCostPerInstance * instanceCount
   */
  upfrontCost: double

  /**
   * The start date and time of the reservation
   */
  start: datetime

  /**
   * The duration of the reservation, in seconds.
   */
  durationSec: double

  /**
   * The expiration date of the reservation.
   */
  end: datetime

  /**
   * Returns timeseries of hourly cost for the calling reservation type.
   *
   * @param spec
   *        interval, start and end
   *
   * @return a Timeseries of cost based on spec
   */
  cost: function(spec: TimeInfo): !Timeseries<double>

  /**
   * Returns timeseries of amortized cost for the calling reservation type.
   *
   * @param spec
   *          interval, start and end
   * @return a Timeseries of amortized cost based on spec.
   */
  amortizedCost: function(spec: TimeInfo): !Timeseries<double>

  /**
   * Returns timeseries of amortized upfront cost for the calling reservation type.
   *
   * @param spec
   *          interval, start and end
   * @return a Timeseries of amortized upfront cost based on spec.
   */
  amortizedUpfrontCost: function(spec: TimeInfo): !Timeseries<double>

  /**
   * Returns a map of each reserved instance type and the timeseries for the instance
   *
   * @param spec
   *          interval, start and end
   * @return a map of Timeseries of amortized upfront cost for each instance type based on spec.
   */
  amortizedUpfrontCostByInstanceType: function(spec: TimeInfo): map<string, Timeseries<double>>
}
