/**
 * abstract type to represent AWS Resource which is associated with a hosted zone.
 */
abstract type AwsHostedZoneMember {

  /**
   * The id of the hosted zone the resource is associated with.
   */
  hostedZone: !AwsHostedZone

  /**
   * Get the aws hosted zone for the given resource
   */
  safeHostedZone: member function(): AwsHostedZone
}
