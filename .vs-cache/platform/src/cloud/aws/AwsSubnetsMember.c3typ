/**
 * abstract type to represent AWS Resource which is parent of a list of subnets.
 */
abstract type AwsSubnetsMember {

  /**
   * The ids of the child subnets of the resource.
   */
  subnets: [AwsSubnet]

  /**
   * get the child subnets of the resource
   */
  safeSubnets: member function(): [AwsSubnet]
}
