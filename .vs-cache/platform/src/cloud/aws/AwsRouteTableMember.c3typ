/**
 * abstract type to represent AWS Resource which is associated with a route table.
 */
abstract type AwsRouteTableMember {

  /**
   * Set of the route table the resource is associated.
   */
  setRouteTable: abstract member function(routeTable: !AwsRouteTable)

  /**
   * get the routetable associated with the resource
   */
  safeRouteTable: member function(): AwsRouteTable

  /**
   * The id of the route table the resource is associated.
   */
  routeTable: !AwsRouteTable
}
