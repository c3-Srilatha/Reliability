/**
 * This type provides an interface to the AWS *RouteTable*
 * see the [AWS documentation](http://docs.aws.amazon.com/AmazonVPC/latest/UserGuide/VPC_Route_Tables.html).
 */
@cloud(hasResourceArn=false,
       hasResourceId=true,
       hasResourceName=false,
       hasResourceGroupName=false,
       identityRoleOptions='REQUIRED',
       cloudFunc='rt')
type AwsRouteTable mixes AwsResource, AwsVpcMember, AwsSubnetsMember, AwsRoutesMember, AwsVpnGatewaysMember
