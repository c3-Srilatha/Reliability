type EmrEndpointSpec mixes Spec {

  /**
   * ELB name to use
   */
  elbName: string

  /**
   * Domain name. Used to construct url if not provided and also to check for SSL certificates while configuring ELB
   * listeners.
   */
  domain: string

  /**
   * URL registered with DNS pointing to ELB
   */
  url: Url

  /**
   * App running on EMR. For backward compatibility defaults to ex-machina
   */
  app: string

  /**
   * scheme to use for url. If http, ssl listeners
   */
  scheme: string

  /**
   * Port on which c3 application listens on. For backward compatibility defaults to exmachina's port
   */
  instancePort: int

  /**
   * Port on which the elb receives requests to be forwarded to instance port. For backward compatibility defaults to exmachina's port
   */
  elbPort: int

  /**
   * if true, listeners are not upserted
   */
  doNotUpsertListeners: boolean = false

  /**
   * list application for which elb listeners will be upserted. If not specified, then all the EMR application ports will be
   * added to listener. If doNotUpsertListeners is true, this list is ignored
   */
  listeners: [string]

  /**
   * If set to true, will not upsert health check
   */
  doNotUpsertHealthCheck: boolean = false
}
