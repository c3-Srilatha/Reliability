/**
 * AwsAthenaDatabase represents a database on Aws Athena.
 */
@cloud(hasResourceArn=false,
       hasResourceId=false,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='athena')
type AwsAthenaDatabase mixes AwsResource {

  /**
   * List all the {@link AwsAthenaTable tables} that belong to this database.
   *
   * @return
   *        all {@link AwsAthenaTable tables} under this database.
   */
  listTables: member function(): [string]

  /**
   * Retrieves {@link AwsAthenaTable table} with specified name from this database.
   *
   * @return {@link AwsAthenaTable table}
   */
  table: member function(name: !string): AwsAthenaTable

  awsServiceName: ~
}
