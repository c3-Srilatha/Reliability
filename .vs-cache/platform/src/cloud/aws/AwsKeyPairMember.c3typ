/**
 * abstract type to represent AWS Resource which is associated with a key pair.
 */
abstract type AwsKeyPairMember {

  /**
   * The name of the key pair the resource is associated with.
   */
  keyPair: !AwsKeyPair

  /**
   * Get the aws key pair for the given resource
   */
  safeKeyPair: member function(): !AwsKeyPair
}
