/**
 * The position in the stream where AWS Lambda should start reading.
 */
enum type AwsLambdaEventSourcePosition {

  /**
   * Start reading just after the most recent record, so that you always read the most recent data.
   */
  LATEST

  /**
   * Start reading at the last untrimmed record, which is the oldest data record.
   */
  TRIM_HORIZON
}
