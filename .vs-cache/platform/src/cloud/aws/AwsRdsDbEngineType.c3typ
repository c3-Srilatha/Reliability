  MYSQL = 'mysql'

  MARIADB = 'mariadb'

  ORACLESE1 = 'oracle-se1'

  ORACLESE2 = 'oracle-se2'

  ORACLESE = 'oracle-se'

  ORACLEEE = 'oracle-ee'

  SQLSERVEREE = 'sqlserver-ee'

  SQLSERVERSE = 'sqlserver-se'

  SQLSERVEREX = 'sqlserver-ex'

  SQLSERVERWEB = 'sqlserver-web'

  POSTGRES = 'postgres'

  AURORA = 'aurora'

  AURORA_POSTGRESQL = 'aurora-postgresql'
