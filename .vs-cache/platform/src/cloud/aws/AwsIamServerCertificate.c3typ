/**
 * Aws Iam Server Certificate.
 * When upsert iam server certificate, make sure you have certificate, certificate chain and certificate private key stored in following s3 path.
 * c3--secret/sslcerts/<domain>/<expirationDatetime>/certificate
 * c3--secret/sslcerts/<domain>/<expirationDatetime>/certificateChain
 * c3--secret/sslcerts/<domain>/<expirationDatetime>/certificatePrivateKey
 */
@cloud(hasResourceArn=true,
       hasResourceId=false,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='iamsvrcert')
type AwsIamServerCertificate mixes AwsResource {

  /**
   * resource name of aws iam server certificate. It's a required field and must follow the format <domain>!<expirationDatetime>
   */
  resourceName: !~

  /**
   * The date on which the certificate is set to expire.
   */
  expiration: datetime

  /**
   * The path to the server certificate. example: "/c3e", "/c3iot", and etc. It provides a context for the certificate.
   */
  path: string

  /**
   * The date when the server certificate was uploaded.
   */
  uploadDate: datetime

  hasTags:   ~
  hasRegion: ~

  /**
   * return the s3 url of certificate content. Certificate should be store at c3--secret/sslcerts/<domain>/<expirationDatetime>/certificate
   */
  certificateBodyUrl: member function(): string

  /**
   * return the s3 url of certificate chain. Certificate chain should be store at c3--secret/sslcerts/<domain>/<expirationDatetime>/certificateChain
   */
  certificateChainUrl: member function(): string

  /**
   * return the s3 url of certificate private key. Certificate private key should be store at c3--secret/sslcerts/<domain>/<expirationDatetime>/certificatePrivateKey
   */
  privateKeyUrl: member function(): string
}
