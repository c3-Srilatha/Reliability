type AwsRoute mixes CloudUpsertable, ConfigChild<AwsRoutesMember> {

  /**
   * The CIDR block used for the destination match.
   */
  destination: string

  /**
   * The ID of a target. It can be The ID of a NAT instance, Internet Gateway, instanceId or VPC peering connection.
   */
  targetId: string

  /**
   * Describes how the route was created.
   */
  origin: string enum AwsRouteOrigin = CREATE_ROUTE

  /**
   * The state of the route.
   */
  state: string enum AwsRouteState = ACTIVE

  /**
   * Type of a target. It can be The ID of a NAT instance, Internet Gateway, instanceId or VPC peering connection.
   */
  targetType: !string enum AwsRouteTargetType

  upsertWithDependencies: ~
  waitForDestroy:         ~
}
