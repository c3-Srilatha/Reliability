/**
 * The specification for creating one bootstrap in the Emr cluster
 */
type AwsEmrBootstrap mixes ConfigChild<AwsEmr> {

  /**
   * Action name chosen by the user
   */
  actionName: !string

  /**
   * Script location for executing the bootstrap
   */
  scriptURI: !string

  /**
   * Arguments for executing the bootstrap script
   */
  arguments: [string] schema name 'AR'
}
