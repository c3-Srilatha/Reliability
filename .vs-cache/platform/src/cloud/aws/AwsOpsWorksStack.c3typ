/**
 * This type provides an interface to the AWS *OpsWorks* service;
 * see the [AWS documentation](http://docs.aws.amazon.com/opsworks/latest/userguide/welcome.html).
 */
@cloud(hasResourceArn=true,
       hasResourceId=true,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='ow')
type AwsOpsWorksStack mixes AwsResource, AwsVpcMember, AwsEc2InstancesMember {

  /**
   * The default subnet to create instances.
   */
  defaultSubnetId: string

  /**
   * The agent version.
   */
  agentVersion: string

  /**
   * The stack's ARN.
   */
  arn: string

  /**
   * The stack's attributes.
   */
  attributes: map<string, string>

  /**
   * A ChefConfiguration object that specifies whether to enable Berkshelf and the Berkshelf version.
   * The Berkshelf version.
   */
  berkshelfVersion: string

  /**
   * A ChefConfiguration object that specifies whether to enable Berkshelf and the Berkshelf version.
   * Whether to enable Berkshelf.
   */
  isManageBerkshelf: boolean

  /**
   * The configuration manager name.
   */
  configurationManagerName: string enum AwsOpsWorksStackConfigurationManagerName

  /**
   * The configuration manager version.
   */
  configurationManagerVersion: string enum AwsOpsWorksStackConfigurationManagerVersion

  /**
   * The date when the stack was created.
   */
  createdAt: string

  /**
   * When included in a request, the parameter depends on the repository type.
   */
  customCookbooksSourcePassword: string

  /**
   * The application's version.
   */
  customCookbooksSourceRevision: string

  /**
   * In requests, the repository's SSH key.
   */
  customCookbooksSourceSshKey: string

  /**
   * The repository type.
   */
  customCookbooksSourceType: string enum AwsOpsWorksStackCustomCookbooksSourceType

  /**
   * The source URL.
   */
  customCookbooksSourceUrl: string

  /**
   * This parameter depends on the repository type.
   */
  customCookbooksSourceUsername: string

  /**
   * A JSON object that contains user-defined attributes to be added to the stack configuration and deployment attributes.
   */
  customJson: json

  /**
   * The stack's default Availability Zone.
   */
  defaultAvailabilityZone: string

  /**
   * The ARN of an IAM profile that is the default profile for all of the stack's EC2 instances.
   */
  defaultInstanceProfileArn: string

  /**
   * The stack's default operating system.
   */
  defaultOs: string enum AwsOpsWorksStackDefaultOs

  /**
   * The stack's default operating system.
   */
  defaultRootDeviceType: string enum AwsEc2InstanceRootDeviceType

  /**
   * A default Amazon EC2 key pair for the stack's instances.
   */
  defaultSshKeyName: string

  /**
   * The stack host name theme, with spaces replaced by underscores.
   */
  hostnameTheme: string enum AwsOpsWorksStackHostnameTheme

  /**
   * The stack AWS Identity and Access Management (IAM) role.
   */
  serviceRoleArn: !string

  /**
   * Whether the stack uses custom cookbooks.
   */
  isUseCustomCookbooks: boolean = false

  /**
   * Whether the stack automatically associates the AWS OpsWorks built-in security groups with the stack's layers.
   */
  isUseOpsworksSecurityGroups: boolean = true

  /**
   * The layers of opsworksStack
   */
  layers: [AwsOpsWorksLayer]

  /**
   * return the running registered ec2 instances of the stack. Aws keep all previously registered ec2 instances in
   * opsworks stack even though some of them are terminated. This method will only return running registered ec2 instances.
   */
  registeredEc2Instances: member function(): [AwsEc2Instance]

  /**
   * Get the status of a specific instance in the stack, eg. "registering", "running_setup", and "registered"
   * @param ec2InstanceId
   *        the ec2 instance id of the instance which you want to get the status
   */
  instanceStatus: member function(ec2InstanceId: !string): string enum AwsOpsWorksInstanceStatus

  userData: member function(): !string
  hasTags:  ~

  /**
   * add tags to opsWorks stack and its layers and ec2 instances.
   * @param tags
   *        tags to add
   */
  pushDownTags: member function(tags: map<string, string>)

  /**
   * Get the region of the OpsWorksStack endpoint.
   */
  apiEndointRegion: member function(): string
}
