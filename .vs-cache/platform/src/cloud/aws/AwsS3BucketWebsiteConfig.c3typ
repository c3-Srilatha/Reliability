/**
 * Represents a AWS S3 bucket's configuration as a static website.
 */
type AwsS3BucketWebsiteConfig {

  /**
   * A relative path of the S3 file in the bucket. This file serves for 4xx errors, or null if no error document has been specified.
   */
  errorDocument: string

  /**
   * The name of the S3 file at the root level of the bucket. This file serves as the home page of the hosting website.
   */
  indexDocument: string = 'index.html'
}
