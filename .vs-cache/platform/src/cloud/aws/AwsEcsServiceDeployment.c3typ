/**
 * Fields for a single ECS service deployment
 * The status of the deployment.
 * PRIMARY for the most recent deployment
 * ACTIVE for previous deployments that still have tasks running, but are being replaced with the PRIMARY deployment
 * INACTIVE for deployments that have been completely replaced
 */
type AwsEcsServiceDeployment mixes ConfigChild<CloudResource> {

  /**
   * The ID of the deployment
   */
  id: string

  /**
   * The Unix timestamp for when the service was created.
   */
  createdAt: datetime

  /**
   * The number of tasks in the deployment that are in the PENDING status
   */
  pendingCount: int

  /**
   * The number of tasks in the deployment that are in the RUNNING status
   */
  runningCount: int

  /**
   * The status of the deployment
   */
  status: string enum AwsEcsServiceDeploymentStatus

  /**
   * The most recent task definition that was specified for the service to use.
   */
  taskDefinition: string

  /**
   * The Unix timestamp for when the service was last updated.
   */
  updatedAt: datetime
}
