/**
 * Enum for all possible states of a step in the Emr cluster
 */
enum type AwsEmrStepState {

  /**
   * The step is cancelled
   */
  CANCELLED

  /**
   * The step is pending cancelled
   */
  CANCEL_PENDING

  /**
   * The step is completed
   */
  COMPLETED

  /**
   * The step fails
   */
  FAILED

  /**
   * The step is interrupted
   */
  INTERRUPTED

  /**
   * The step is waiting for execution
   */
  PENDING

  /**
   * The step is being executed
   */
  RUNNING
}
