/**
 * Enumeration of ebs volume type.
 */
enum type AwsEbsVolumeType {

  STANDARD = 'standard'

  PROVISIONED_IOPS_SSD = 'io1'

  GENERAL_PURPOSE_SSD = 'gp2'

  COLD_HDD = 'sc1'

  THROUGHPUT_OPTIMIZED_HDD = 'st1'
}
