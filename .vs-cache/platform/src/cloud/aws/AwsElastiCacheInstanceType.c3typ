/**
 * Enumeration of all known AWS ElastiCache Instance Types. For more information on each of the type visit
 * https://aws.amazon.com/elasticache/pricing/
 */
enum type AwsElastiCacheInstanceType {

  CACHE_T2_MICRO = 'cache.t2.micro'

  CACHE_T2_SMALL = 'cache.t2.small'

