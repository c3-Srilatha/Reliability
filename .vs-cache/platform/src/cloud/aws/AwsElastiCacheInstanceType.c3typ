  CACHE_M5_4XLARGE = 'cache.m5.4xlarge'

  CACHE_M5_12XLARGE = 'cache.m5.12xlarge'

  CACHE_M5_24XLARGE = 'cache.m5.24xlarge'

  CACHE_R5_LARGE = 'cache.r5.large'

