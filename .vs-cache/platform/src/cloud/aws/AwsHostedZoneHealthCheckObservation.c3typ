/**
 * A type contains the health check result of the end point as reported by one of the Amazon Route 53 health checkers.
 */
type AwsHostedZoneHealthCheckObservation {

  /**
   * The IP address of the Amazon Route 53 health checker, which will try to check the health of the endpoint.
   */
  ipAddress: string

  /**
   * The region of the Amazon Route 53 health checker.
   */
  region: string enum AwsHostedZoneHealthCheckRegion

  /**
   * A description of the status of the health check endpoint as reported by one of the Amazon Route 53 health checkers.
   */
  statusReport: string

  /**
   * The date and time that the health checker performed the health check in Coordinated Universal Time (UTC).
   */
  checkedTime: datetime
}
