/**
 * Enumeration of all status of Url Registration
 */
enum type AwsUrlRegistrationStatus {

  /**
   * The URL has been registered under the DNS of Amazon Route 53, and the DNS updates have been propagated.
   */
  OK = 'ok'

  /**
   * The URL has been registered under the DNS of Amazon Route 53.
   */
  REGISTERED = 'registered'

  /**
   * The URL has NOT been registered under the DNS of Amazon Route 53
   */
  UNREGISTERED = 'unregistered'

  /**
   * It is unknown whether the URL has been registered or not. It happens when the hosted zone of the domain is NOT
   * managed by the Aws accounts that we know.
   */
  UNKNOWN = 'unknown'
}
