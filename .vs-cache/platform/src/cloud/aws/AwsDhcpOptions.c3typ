/**
 * This type provides an interface to the AWS *DhcpOptions*
 * see the [AWS documentation](http://docs.aws.amazon.com/AmazonVPC/latest/UserGuide/VPC_DHCP_Options.html).
 */
@cloud(hasResourceArn=false,
       hasResourceId=true,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='NULL',
       cloudFunc='dopt')
type AwsDhcpOptions mixes AwsResource {

  /**
   * One or more DHCP options in the set.
   */
  dhcpConfigurations: ![AwsDhcpConfiguration]
}
