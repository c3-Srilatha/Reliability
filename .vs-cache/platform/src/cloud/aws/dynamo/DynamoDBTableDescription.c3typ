// TODO: PLAT-20430 change name to start with Aws, or else we cannot determine cloud provider
@cloud(hasResourceArn=true,
       hasResourceId=false,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='NULL',
       cloudFunc='dynamo')
type DynamoDBTableDescription mixes AwsResource {

  /**
   * Status of the table whether it is ACTIVE or not
   */
  status: string

  /**
   * Table creation date time
   */
  creationTime: datetime

  /**
   * Currently provisioned read capacity units
   */
  provisionedReadCapacity: int

  /**
   * Currently provisioned write capacity units
   */
  provisionedWriteCapacity: int

  /**
   * Estimate of number of items in the table
   */
  itemCount: int

  /**
   * Estimate of the table size
   */
  size: int

  /**
   * A map of attributes that describe the key schema for the table and indexes.
   */
  attributeDefinitions: @indexed map<string, string enum DynamoDBTableAttributeType>

  /**
   * Specifies the key schemas that make up the primary key for the table. The key value pair in KeySchema must
   * also be defined in {@link DynamoDBTableDescription#attributeDefinitions} when creating the dynamoDB table.
   * Minimum number of keySchemas is 1 item. Maximum number of keySchemas is 2 items.
   */
  keySchemas: @indexed map<string, string enum DynamoDBTableKeySchemaType>

  /**
   * Calculates the estimated number of partitions based on RCU, WCU
   * Remember once the partitions are increased internally by dynamo db, it never reduces the number of partitions
   * Hence this method only provides an estimate of the number of partitions based on the current
   * RCU & current WCU. It is possible that the number of partitions are higher than what is provided by this api
   */
  partitionsByThroughput: int

  /**
   * Calculates the estimated number of partitions based on the estimated table size
   * Remember once the partitions are increased internally by dynamo db, it never reduces the number of partitions
   * Hence this method only provides an estimate of the number of partitions based on the current
   * table size. It is possible that the number of partitions are higher than what is provided by this api
   */
  partitionsBySize: int

  generateResourceSecondaryId: ~
  waitForCreate:               ~
  waitForDestroy:              ~
}
