/**
 * The data type for the attribute for describing the key schema for the table and indexes. For more information :
 * https://docs.aws.amazon.com/AWSCloudFormation/latest/UserGuide/aws-properties-dynamodb-attributedef.html
 */
enum type DynamoDBTableAttributeType {

  STRING = 'S'

  NUMBER = 'N'

  BINARY = 'B'
}
