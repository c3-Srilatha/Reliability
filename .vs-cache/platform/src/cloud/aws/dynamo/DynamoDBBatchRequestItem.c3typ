/**
 * Type to construct item for a batch request. An item can be analogous to a row
 */
type DynamoDBBatchRequestItem {

  /**
   * Key and value that need to be added in the row
   */
  putRequest: map<string, any>

  /**
   * Key and value that need to be removed from the row
   */
  deleteRequest: map<string, any>
}
