/**
 * Lowest level type to interact with dynamo db
 */
type DynamoDB mixes KvStore<DynamoDBConfig> {

  /**
   * List dynamo db tables for this account
   * @param lastEvaluatedName
   *                     At a time dynamodb returns a list of 100 tables, and the lastEvaluatedName will be populated
   *                     with the marker for the next 100. Provide this param to fetch the next 100
   * @param count
   *                     Limit the number of tables to be returned
   * @return the list of dynamo db tables associated with the aws account
   */
  @action(group+='read')
  listTables: function(lastEvaluatedName: string, count: int): DynamoDBTables

  /**
   * Describe the current table. This will include the creation time, provisioned capacity etc.
   * @param table
   *          Name of the table that needs to be described
   * @return the table description
   */
  @action(group+='read')
  describeTable: function(table: !string): DynamoDBTableDescription

  /**
   * Create a new dynamo db table. Table will be created in the region that C3 server points to
   * @param table
   *          Name of the table to be created
   * @param withRangeKey
   *          Indicate whether range key should be created along with the row key (this will require you to provide the range during read, delete) but will get faster access to the data
   * @return if the table was created
   */
  @action(authz='always', group='write')
  createTable: function(table: !string, withRangeKey: boolean): boolean

  /**
   * Delete a particular dynamo db table
   * @param table
   *          Delete the given table
   */
  @action(authz='always', group='delete')
  deleteTable: function(table: !string, confirm: !boolean)

  /**
   * Update the dynamo db table with the appropriate read and write capacity units
   * @param table
   *           Name of the table for which capacity needs to be updated
   * @param readCapacityUnits
   *          No of reads per second required on this table
   * @param writeCapacityUnits
   *          No of writes per second required on this table
   */
  @action(group+='cluster-admin')
  updateTable: function(table: !string, readCapacityUnits: !int, writeCapacityUnits: !int)

  /**
   * Query data from a dynamo db table
   * @param table
   *          Name of the table to query the data from
   * @param spec
   *          Query spec to indicate which hash key and range key to get data from with other properties on the spec
   * @return the query result
   */
  @action(group+='read')
  query: function(table: !string, spec: !DynamoDBQuerySpec): DynamoDBQueryResult

  /**
   * Scan data from a dynamo db table. Use when you want to read data without knowing the hash key / range key.
   * Could be an expensive operation and can use all the provisioned capacity
   * @param table
   *          Name of the table to query the data from
   * @param spec
   *          Scan spec to indicate properties of the scan operation
   * @return the scan result
   */
  @action(group+='read')
  scanItems: function(table: !string, spec: DynamoDBScanSpec): DynamoDBQueryResult

  /**
   * The GetItem operation returns a set of attributes for the item with the given primary key in spec.
   * @param table
   *          Name of the table to get item from
   * @param spec
   *          The specification for getting items
   */
  @action(group+='read')
  getItem: function(table: !string, spec: DynamoDBGetItemSpec): DynamoDBGetItemResult

  /**
   * Insert 1 item in the dynamo db table
   * @param table
   *          Name of the table to insert data in
   * @param spec
   *          Spec object containing the data
   * @return result of the write operation indicating whether the write was successful. Indicates things like consumed capacity, collection metrics
   */
  @action(group+='write')
  putItem: function(table: !string, spec: !DynamoDBPutItemSpec): DynamoDBWriteResult

  /**
   * Update 1 item in the dynamo db table
   * @param table
   *          Name of the table to update the item on
   * @param spec
   *          Spec object containing the data to update the object
   * @return result of the update operation indicating whether the update was successful. Indicates things like consumed capacity, collection metrics
   */
  @action(group+='write')
  updateItem: function(table: !string, spec: !DynamoDBUpdateItemSpec): DynamoDBWriteResult

  /**
   * Delete 1 item in the dynamo db table
   * @param table
   *          Name of the table to delete the item on
   * @param spec
   *          Spec object containing the data to delete the object
   * @return result of the delete operation indicating whether the delete was successful. Indicates things like consumed capacity, collection metrics
   */
  @action(group+='delete')
  deleteItem: function(table: !string, spec: !DynamoDBDeleteItemSpec): DynamoDBWriteResult

  /**
   * Batch api to write item / delete items to dynamo db table. At 1 time only 25 objects can be created / deleted.
   * This batchWriteItem api assumes all the tables in the spec are within same account/credential.
   * @param spec
   *        Spec object indicating what items to be created / updated / deleted
   * @return the result of the batch operation. If provisioned capacity is less than will contain unprocessed items
   *         If the item is unprocessed, it has not been written / deleted
   */
  @action(group+='write')
  batchWriteItem: function(spec: !DynamoDBBatchWriteSpec): DynamoDBBatchWriteResult
}
