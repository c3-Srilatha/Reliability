/**
 * Information about the peered VPC
 */
type AwsVpcPeeringConnectionInfo {

  /**
   * The IPv4 CIDR block for the VPC
   */
  cidrBlock: !string

  /**
   * The IPv4 CIDR block for the VPC
   */
  ipv6CidrBlockSet: [string]

  /**
   * The AWS account ID of the VPC owner
   */
  ownerId: string

  /**
   * The ID of the requester VPC
   */
  vpcId: !string

  /**
   * Indicates whether a local VPC can resolve public DNS hostnames to private IP addresses
   * when queried from instances in a peer VPC
   */
  allowDnsResolutionFromRemoteVpc: boolean

  /**
   * Returns AwsVpcPeeringConnectionInfo from vpc details (cidrBlock, ipv6CidrBlockSet & ownerId)
   */
  forVpc: private function(vpc: !AwsVpc): AwsVpcPeeringConnectionInfo
}
