/**
 * The status of one instance group in the Emr cluster
 */
type AwsEmrInstanceGroup mixes ConfigChild<AwsEmr> {

  /**
   * Auto-generated id of the instance group
   */
  id: string

  /**
   * State of the instance group. Do not set as input.
   */
  state: string enum AwsEmrInstanceGroupState

  /**
   * Number of active instances currently running in the group. Do not set as input.
   */
  runningInstanceCount: int

  /**
   * Status of all instances inside this group. Do not set as input.
   */
  instances: [AwsEmrInstance]

  /**
   * The name of the instance group chosen by the user
   */
  groupName: !string

  /**
   * The type of the group.
   */
  groupType: !string enum AwsEmrInstanceGroupType

  /**
   * The type of all instances in the group. Note that all instances in the same group must have the same instance type
   */
  instanceType: !string

  /**
   * Number of requested instances in the group. Note that MASTER instance group only allows 1 instance.
   * CORE and TASK instance groups allow any number of instances.
   */
  requestedInstanceCount: !int
}
