enum type AwsLambdaRunTime {

  /**
   * The lambda function is written in Java 8
   */
  JAVA8 = 'java8'

  /**
   * The lambda function is written in Nodejs
   */
  NODEJS = 'nodejs'

  /**
   * The lambda function is written in Nodejs 4.3
   */
  NODEJS43 = 'nodejs4.3'

  /**
   * The lambda function is written in Nodejs 6.10
   */
  NODEJS610 = 'nodejs6.10'

  /**
   * The lambda function is written in Python 2.7
   */
  PYTHON27 = 'python2.7'

  /**
   * The lambda function is written in Python 3.6
   */
  PYTHON36 = 'python3.6'
}
