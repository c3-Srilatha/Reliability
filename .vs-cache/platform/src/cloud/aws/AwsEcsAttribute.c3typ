/**
 * The attribute set for the container instance
 */
type AwsEcsAttribute mixes ConfigChild<CloudResource> {

  /**
   * Name of the attribute
   */
  name: string

  /**
   * The ID of the target
   */
  targetType: string

  /**
   * The type of the target with which to attach the attribute
   */
  targetId: string

  /**
   * The value of the attribute
   */
  value: string
}
