/**
 * AWS Elastic Load Balancer
 */
@cloud(hasResourceArn=true,
       hasResourceId=false,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='REQUIRED',
       cloudFunc='elb')
type AwsElb mixes AwsLoadBalancer, AwsEc2InstancesMember {

  /**
   * Auto-generated DNS name of the ELB
   */
  dnsName: string

  /**
   * Scheme of the ELB, choose between "AwsElbScheme.INTERNET_FACING" and "AwsElbScheme.INTERNAL"
   */
  scheme: string enum AwsElbScheme

  /**
   * The listeners for the ELB.
   */
  listeners: [AwsElbListener]

  /**
   * Information about the health checks conducted on the ELB
   */
  healthCheck: AwsElbHealthCheck

  /**
   * idleTimeOut specifies the maximum period of time that the load balancer keeps the connection open when no data has
   * been sent over the period. By default, the idle timeout is set to 60 seconds by aws.
   */
  idleTimeOut: int = 60

  /**
   * The security groups for the ELB.
   */
  reportVpnSecurityGroups: member function(): !AwsVpnSecurityGroupReport

  defaultWhitelistCidrBlocks: [string]
}
