/**
 * Enum type to store Amazon cloud watch metrics for resource
 */
enum type AwsEmrCloudWatchMetrics {

  MEMORYRESERVEDMB = 'MemoryReservedMB'

  CONTAINERPENDING = 'ContainerPending'

  MEMORYAVAILABLEMB = 'MemoryAvailableMB'

  MRUNHEALTHYNODES = 'MRUnhealthyNodes'

  APPSPENDING = 'AppsPending'

  ISIDLE = 'IsIdle'

  APPSKILLED = 'AppsKilled'

  APPSFAILED = 'AppsFailed'

  CONTAINERALLOCATED = 'ContainerAllocated'

  MRACTIVENODES = 'MRActiveNodes'

  CONTAINERPENDINGRATIO = 'ContainerPendingRatio'

  HDFSBYTESWRITTEN = 'HDFSBytesWritten'

  APPSSUBMITTED = 'AppsSubmitted'

  MEMORYALLOCATEDMB = 'MemoryAllocatedMB'

  MEMORYTOTALMB = 'MemoryTotalMB'

  MRLOSTNODES = 'MRLostNodes'

  MRREBOOTEDNODES = 'MRRebootedNodes'

  YARNMEMORYAVAILABLEPERCENTAGE = 'YARNMemoryAvailablePercentage'

  HDFSBYTESREAD = 'HDFSBytesRead'

  MRDECOMMISSIONEDNODES = 'MRDecommissionedNodes'

  APPSRUNNING = 'AppsRunning'

  MRTOTALNODES = 'MRTotalNodes'

  APPSCOMPLETED = 'AppsCompleted'

  CONTAINERRESERVED = 'ContainerReserved'

  TOTALLOAD = 'TotalLoad'

  UNDERREPLICATEDBLOCKS = 'UnderReplicatedBlocks'

  HDFSUTILIZATION = 'HDFSUtilization'

  MISSINGBLOCKS = 'MissingBlocks'

  PENDINGDELETIONBLOCKS = 'PendingDeletionBlocks'

  CORENODESRUNNING = 'CoreNodesRunning'

  CAPACITYREMAININGGB = 'CapacityRemainingGB'

  LIVEDATANODES = 'LiveDataNodes'

  CORENODESPENDING = 'CoreNodesPending'

  CORRUPTBLOCKS = 'CorruptBlocks'

  S3BYTESREAD = 'S3BytesRead'

  S3BYTESWRITTEN = 'S3BytesWritten'

  DFSFSNAMESYSTEMPENDINGREPLICATIONBLOCKS = 'dfs.FSNamesystem.PendingReplicationBlocks'
}
