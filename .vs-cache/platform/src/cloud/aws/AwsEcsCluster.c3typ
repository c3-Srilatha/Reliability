/**
 * AWS ECS cluster
 */
@cloud(hasResourceArn=true,
       hasResourceId=false,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='REQUIRED',
       cloudFunc='ecsc')
type AwsEcsCluster mixes AwsResource, CloudServiceOrchestrator<AwsEcsCloudServiceSession> {

  /**
   * The status of the cluster
   */
  status: string enum AwsEcsTaskDefinitionAndClusterStatus

  /**
   * The number of services that are running on the cluster in an ACTIVE state
   */
  activeServicesCount: int

  /**
   * The number of tasks in the cluster that are in the RUNNING state
   */
  runningTasksCount: int

  /**
   * The number of tasks in the cluster that are in the PENDING state
   */
  pendingTasksCount: int

  instances: member function(): [AwsEcsContainerInstance]

  /**
   * The number of container instances registered into the cluster
   */
  registeredContainerInstancesCount: int

  hasTags: ~
  isOk:    ~
  isGone:  ~

  /**
   * Start a new EC2 instance in this cluster
   * @param spec
   *          @see CloudResourceOperationSpec
   * @return the started AWS EC2 instance
   */
  startNode: member function(spec: CloudResourceOperationSpec): AwsEc2Instance

  /**
   * Clean up any EC2 instances without tasks assigned in this cluster
   * @param max
   *            Maximum number of instances to clean up, -1 represents uncapped max, 0 effectively disables
   * @return the number of instances cleaned up
   */
  cleanUpInstances: member function(max: int = -1): int

  /**
   * Wait until the given EC2 instance is registered with this ECS cluster
   * @param instance
   *          The created EC2 instance that is registering with this ECS cluster
   * @param spec
   *          The parameters that defines the wait length, strategy, number of retry, and etc.
   */
  waitForInstance: member function(instance: !AwsEc2Instance, spec: WaitSpec)

  /**
   * Wait until this ECS cluster has at least 1 available EC2 instance
   * @param spec
   *          The parameters that defines the wait length, strategy, number of retry, and etc.
   */
  waitForOneInstance: member function(spec: WaitSpec)

  /**
   * @return the ECS-compliant name for the cluster id. @see CloudId
   */
  resourceNameFromId: private function(cid: !string): !string

  generateResourceName: ~
  ensureService:        ~
  stopService:          ~
  serviceById:          ~
  services:             ~
  containerLogs:        ~
  forOrchestratorId:    ~
  forServiceName:       ~
  inst:                 ~
  maxNodeMemory:        ~
  maxNodeCompute:       ~
  debugInfo:            ~
}
