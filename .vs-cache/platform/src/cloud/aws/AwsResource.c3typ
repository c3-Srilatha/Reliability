@cloud(hasResourceArn=true,
       hasResourceId=false,
       hasResourceName=true,
       hasRole=false,
       hasSubseq=false,
       hasResourceGroupName=false,
       identityRoleOptions=NULL)
abstract type AwsResource mixes CloudResource {

  /**
   * AWS provider generated unique name / secondary id.
   */
  resourceArn: inline member function(): string

  /**
   * AWS provider generated unique name / secondary id or short name whichever is available.
   */
  resourceArnOrName: inline member function(): string

  /**
   * Updated AWS provider generated unique name / secondary id.
   */
  withResourceArn: inline member function(resourceArn: !?string): mixing AwsResource

  awsCredentials:      member function(): !AwsCredentials
  ownerAwsCredentials: member function(): AwsCredentials

  /**
   * @return namespace for Amazon CloudWatch metric for this CloudResource.
   */
  cloudWatchNamespace: function(): !string enum AwsCloudWatchNamespace

  /**
   * @return the list of CloudWatch metric names associated to the CloudResource or AwsService
   */
  evalCloudWatchMetric: member function(spec: AwsEvalCloudWatchMetricSpec): Timeseries<double>

  /**
   * @return CloudWatch metric statistics.
   */
  cloudWatchMetricStatistics: member function(spec: AwsCloudWatchMetricStatisticsSpec): !AwsCloudWatchMetricStatistics

  /**
   * @return the service name given by AWS as it would appear in the ARN.
   */
  awsServiceName: function(): string

  typeForResourceSecondaryId: ~
  extraTemplateBindings:      ~
  credentials:                AwsCredentials
}
