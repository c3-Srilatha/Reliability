/**
 * Enumeration of S3 Notification Event
 */
enum type AwsS3EventType {

  OBJECT_CREATED = 's3:ObjectCreated:*'

  OBJECT_REMOVED = 's3:ObjectRemoved:*'

  OBJECT_CREATED_BY_COMPLETE_MULTIPART_UPLOAD = 's3:ObjectCreated:CompleteMultipartUpload'

  OBJECT_CREATED_BY_COPY = 's3:ObjectCreated:Copy'

  OBJECT_CREATED_BY_POST = 's3:ObjectCreated:Post'

  OBJECT_CREATED_BY_PUT = 's3:ObjectCreated:Put'

  OBJECT_REMOVED_DELETE = 's3:ObjectRemoved:Delete'

  OBJECT_REMOVED_DELETE_MARKER_CREATED = 's3:ObjectRemoved:DeleteMarkerCreated'

  REDUCED_REDUNDANCY_LOST_OBJECT = 's3:ReducedRedundancyLostObject'

  /**
   * @params event
   *            Event to be mapped to S3 event type
   * @return a mapping of generic file system event to S3 event type.
   */
  fromFileSystemEvent: function(event: !?string enum FileSystemEventType): string enum AwsS3EventType

  /**
   * @params events
   *            Events to be mapped to S3 events type
   * @params defaultEvents
   *            Default events to be mapped and returned if events is null or empty.
   * @return a mapping of generic file system events to S3 events type.
   */
  fromFileSystemEvents: function(events: !?[string enum FileSystemEventType],
                                 defaultEvents: [string enum FileSystemEventType]): [string enum AwsS3EventType]
}
