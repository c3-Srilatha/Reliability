/**
 * AWS Vpc Peering.
 */
@cloud(hasResourceArn=false,
       hasResourceId=true,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='pcx')
type AwsVpcPeering mixes AwsResource {

  /**
   * Information about the accepter VPC
   */
  accepterVpcInfo: AwsVpcPeeringConnectionInfo

  /**
   * The time that an unaccepted VPC peering connection will expire
   */
  expirationTime: datetime

  /**
   * Information about the accepter VPC
   */
  requesterVpcInfo: AwsVpcPeeringConnectionInfo

  /**
   * The status of the VPC peering connection
   */
  state: string enum CloudResourceState

  /**
   * Accept a VPC peering connection request
   */
  acceptConnection: private member function()

  /**
   * Reject a VPC peering connection request
   */
  rejectConnection: private member function()
}
