/**
 * This type provides an interface to the AWS *Ec2* service;
 * see the [AWS documentation](http://docs.aws.amazon.com/AWSEC2/latest/UserGuide/concepts.html).
 */
@cloud(cloudFunc='awsec2',
       hasResourceArn=false,
       hasResourceId=true,
       hasResourceName=false,
       hasResourceGroupName=false,
       hasRole=true,
       identityRoleOptions='OPTIONAL')
type AwsEc2Instance mixes AwsResource, AwsSubnetMember, AwsSecurityGroupsMember, AwsKeyPairMember, AwsIamInstanceProfileMember, AwsHostedZoneMember, AwsElbsMember, AwsEcsClusterMember, CloudComputeInstance {

  /**
   * The ID of the AWS account that owns the reservation.
   */
  ownerId: string

  /**
   * The ID of the requester that launched the instances on your behalf (for example, AWS Management Console or Auto Scaling).
   */
  requesterId: string

  /**
   * The ID of the reservation.
   */
  reservationId: string

  /**
   * Reference to the AWS Machine Image.
   */
  image: AwsAmi

  /**
   * The public ip address
   */
  publicIpAddress: string

  /**
   * The private ip address
   */
  privateIpAddress: string

  /**
   * The lifecycle
   */
  lifecycle: string

  /**
   * The root device type
   */
  rootDeviceType: string

  /**
   * The architecture
   */
  architecture: string

  /**
   * The platform
   */
  platform: string

  /**
   * The network interface ids
   */
  networkInterfaceId: string

  /**
   * Any block device mapping entries. Will request following 4 device mappings by default:
   *     device mapping 1: deviceName: "/dev/sdb", virtualName: "ephemeral0"
   *     device mapping 2: deviceName: "/dev/sdc", virtualName: "ephemeral1"
   *     device mapping 3: deviceName: "/dev/sdd", virtualName: "ephemeral2"
   *     device mapping 4: deviceName: "/dev/sde", virtualName: "ephemeral3"
   * Please don't request any of these device mappings again in your entry.
   */
  blockDeviceMappings: [AwsBlockDeviceMapping]

  /**
   * The launch time
   */
  launchTime: string

  /**
   * The vm state
   */
  state: string

  /**
   * Users can specify commands as user data to execute when the ec2 instance brings up.
   */
  m_userData: string

  /**
   * Get user data of the instance.
   */
  userData: member function(): string

  /**
   * Get availabilityZone of the instance
   */
  availabilityZone: member function(): !string enum AwsAvailabilityZone

  /**
   * Reports status of the instance. eg. "Initializing"
   */
  status: string enum AwsEc2InstanceStatus

  /**
   * Indicates whether to assign a public IPv4 address to an instance.
   */
  hasPublicIpAddress: boolean

  /**
   * create a image from current instance if the image doesn't exist.
   * If the image has already existed, will delete it and create a new image from current instance to update.
   * @param imageName
   *        the name of the image
   * @param imageDescription
   *        the description of the image
   * return the created image
   */
  upsertImage: member function(imageName: !string,
                               imageDescription: !string,
                               spec: CloudResourceOperationSpec): !AwsAmi

  afterCreate: ~
}
