/**
 * Type to hold the S3 event notification. All the commonly used fields have been extracted in this type and the entire
 * raw json is available via the field {@link AwsS3Event#raw}
 */
type AwsS3Event mixes FileSystemEvent, CloudInboundMessage<json> {

  /**
   * Region in which the event occurred. E.g. `us-east-1`
   */
  region: string

  /**
   * The time, in ISO-8601 format, for example, 1970-01-01T00:00:00.000Z, when file system finished processing the request
   */
  eventTime: !datetime

  /**
   * Event-type causing the trigger. E.g. ObjectCreated:Put
   */
  eventName: !string

  /**
   * Name of the bucket. E.g. `mybucket`
   */
  bucket: !string

  /**
   * Aws S3 object that triggered the event
   */
  object: AwsS3Object

  /**
   * Construct an event from Json
   *
   * @param obj
   *        json object
   */
  eventsFromJson: function(obj: json): [AwsS3Event]

  process: ~
}
