/**
 * Aws credentials used to access supported services through the Aws SDK.
 */
type AwsCredentials mixes CloudCredentials {

  /**
   * @return AWS IAM Role ARN - alias to CloudCredentials#cloudIdentity
   */
  iamRoleArn: inline member function(): string

  /**
   * @return true if this credential can be assumed by the current cluster, and false if not.
   */
  canAssumeCredentials: member function(): boolean

  /**
   * @return name of the AWS region for this credential.
   */
  regionName: inline member function(): string

  /**
   * Creates instance of AwsCredentials from AWS IAM Role ARN optional region override.
   */
  fromIamRoleArn: function(iamRoleArn: !string, region: string): !AwsCredentials

  /**
   * Cached s3 client for this instance of AwsCredentials - this is important since every s3 operation should cached
   * s3 client for the credentials
   */
  s3Client: private cached property(): @java(class="c3.platform.cloud.aws.client.AwsS3Client") !native

  authToken: ~
  account:   ~: !AwsAccount
}
