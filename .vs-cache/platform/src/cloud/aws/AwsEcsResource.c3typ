/**
 * Resource utilization of container instance in ECS
 */
type AwsEcsResource {

  /**
   * The name of the resource, such as cpu, memory, ports, or a user-defined resource
   */
  name: string

  /**
   * Set when valueType is DOUBLE
   */
  doubleValue: double

  /**
   * Set when valueType is INTEGER
   */
  integerValue: int

  /**
   * Set when valueType is LONG
   */
  longValue: int

  /**
   * Set when valueType is STRINGSET
   */
  stringList: [string]

  /**
   * The type of the resource
   */
  valueType: string
}
