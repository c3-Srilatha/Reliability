@cloud(hasResourceArn=false,
       hasResourceId=true,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='NULL',
       cloudFunc='nat')
type AwsNatGateway mixes AwsResource, AwsSubnetMember, AwsElasticIpMember {

  /**
   * The public address associated with the elastic ip
   */
  publicIpAddress: string

  /**
   * The private address associated with the elastic ip.
   */
  privateIpAddress: string

  /**
   * The ID of the network interface associated with the address.
   */
  networkInterfaceId: string

  /**
   * The state of the NAT gateway.
   */
  state: string enum CloudResourceState

  /**
   * The date and time the NAT gateway was created.
   */
  createTime: datetime
}
