@cloud(hasResourceArn=false,
       hasResourceId=false,
       hasResourceName=false,
       hasResourceGroupName=false,
       identityRoleOptions='NULL',
       cloudFunc='awsipperm')
type AwsIpPermission mixes AwsResource, ConfigChild<AwsSecurityGroup> {

  /**
   * The start of port range for the TCP and UDP protocols, or an ICMP type number.
   */
  fromPort: int = -1

  /**
   * The end of port range for the TCP and UDP protocols, or an ICMP code.
   */
  toPort: int = -1

  /**
   * The protocol.
   */
  ipProtocol: string enum AwsIpProtocol = ALL

  /**
   * One or more IP ranges.
   */
  ipRanges: [string]

  /**
   * One or more security group and AWS account ID pairs.
   */
  userIdGroupPairs: [AwsUserIdGroupPair]

  upsertWithDependencies: ~
  waitForDestroy:         ~
}
