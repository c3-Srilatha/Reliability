/**
 * This type provides an interface to the AWS *HostedZone* service;
 * see the [AWS documentation](http://docs.aws.amazon.com/Route53/latest/DeveloperGuide/Welcome.html).
 */
@cloud(hasResourceArn=true,
       hasResourceId=true,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='hz')
type AwsHostedZone mixes AwsResource, AwsVpcsMember, CloudHostedZone {

  /**
   * Number of resource record sets in hosted zone.
   */
  resourceRecordSetCount: int

  /**
   * An optional comment about your hosted zone.
   */
  comment: string

  /**
   * A value that indicates whether this is a private hosted zone. False by default.
   */
  isPrivateZone: boolean

  /**
   * The vpc that you want your private hosted zone to be associated with.
   */
  vpcs: [AwsVpc]

  /**
   * The vpc that you want your hosted zone to be associated with..
   */
  resourceRecordSets: [AwsHostedZoneResourceRecordSet]

  destroyChildren: ~
  hasRegion:       ~
  isEnabled:       ~
}
