/**
 * Aws Vpn Gateway.
 */
@cloud(hasResourceArn=false,
       hasResourceId=true,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='vgw')
type AwsVpnGateway mixes AwsResource, AwsVpcMember {

  /**
   * The Availability Zone where the virtual private gateway was created, if applicable.
   */
  availabilityZone: string enum AwsAvailabilityZone

  /**
   * The current state of the virtual private gateway.
   */
  state: string enum CloudResourceState

  /**
   * The type of VPN connection the virtual private gateway supports.
   */
  gatewayType: string enum AwsGatewayType

  /**
   * Any VPCs attached to the virtual private gateway.
   */
  vpcAttachments: [AwsVpcAttachment]
}
