/**
 * Enumeration for state of Aws Vpc peering
 */
enum type AwsVpcPeeringConnectionState {

  ACTIVE = 'active'

  DELETED = 'deleted'

  DELETING = 'deleting'

  EXPIRED = 'expired'

  FAILED = 'failed'

  INITIATING_REQUEST = 'initiating-request'

  PENDING_ACCEPTANCE = 'pending-acceptance'

  PROVISIONING = 'provisioning'

  REJECTED = 'rejected'
}
