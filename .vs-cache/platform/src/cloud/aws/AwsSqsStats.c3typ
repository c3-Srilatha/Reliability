type AwsSqsStats {

  /**
   * Approximate number of visible messages in a queue. For more information,
   * see Resources Required to Process Messages in the Amazon SQS Developer
   * Guide.
   */
  approximateNumberOfMessages: int

  /**
   * Approximate number of messages that are not timed-out and not deleted.
   * For more information, see Resources Required to Process Messages in the
   * Amazon SQS Developer Guide.
   */
  approximateNumberOfMessagesNotVisible: int

  /**
   * Approximate number of messages that are pending to be added to the queue.
   */
  approximateNumberOfMessagesDelayed: int
}
