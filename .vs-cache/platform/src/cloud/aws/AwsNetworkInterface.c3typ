/**
 * AWS Network Interface
 */
@cloud(hasResourceArn=false,
       hasResourceId=true,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='eni')
type AwsNetworkInterface mixes AwsResource, AwsSubnetMember {

  /**
   * The private address associated with the network interface .
   */
  privateIpAddress: string

  /**
   * A set of security groups
   */
  securityGroups: ![string]

  /**
   * Description of the network interface id
   */
  description: string

  /**
   * Attached Instance Id
   */
  instanceId: string

  /**
   * The Auto-assigned ID of the network interface attachment.
   */
  attachmentId: private string

  beforeDestroy: ~
}
