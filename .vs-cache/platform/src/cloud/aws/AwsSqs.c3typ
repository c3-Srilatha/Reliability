/**
 * This type provides an interface to the AWS *Simple Queue* service;
 * see the [AWS documentation](https://aws.amazon.com/documentation/sqs/).
 */
@cloud(hasResourceArn=true,
       hasResourceId=false,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='sqs')
type AwsSqs mixes AwsResource, CloudQueue<AwsSqsMessage> {

  /**
   * To filter by name prefix, use "QueueNamePrefix" as key of CloudListResourcesSpec.attributes
   */
  listResources: ~

  /**
   * The url of the queue
   */
  url: private string

  /**
   * The number of seconds for which the delivery of all messages in the queue is delayed. Valid values: An integer from 0 to 900 seconds (15 minutes). The default is 0 (zero).
   */
  delaySeconds: int = 0

  /**
   * The visibility timeout (seconds) for the queue. Valid values: An integer from 0 to 43,200 (12 hours). The default is 30.
   */
  visibilityTimeout: int = 30

  /**
   * The number of seconds for which Amazon SQS retains a message. Valid values: An integer from 60 seconds (1 minute) to 1,209,600 seconds (14 days).
   */
  messageRetentionPeriod: int = 345600

  /**
   * The limit of how many bytes a message can contain before Amazon SQS rejects it. Valid values: An integer from 1,024 bytes (1 KiB) to 262,144 bytes (256 KiB). The default is 262,144 (256 KiB).
   */
  maximumMessageSize: int = 262144

  /**
   * The number of seconds for which a ReceiveMessage action waits for a message to arrive. Valid values: An integer from 0 to 20 (seconds). The default is 0 (zero).
   */
  receiveMessageWaitTimeSeconds: int = 0

  /**
   * The approximate number of messages Available (Visible)
   */
  approximateNumberOfMessages: int

  /**
   * The approximate number of messages in Flight (Not Visible)
   */
  approximateNumberOfMessagesNotVisible: int

  /**
   * The approximate number of messages that are waiting to be added to the queue.
   */
  approximateNumberOfMessagesDelayed: int

  /**
   * The parameters for the dead letter queue functionality of the source queue.
   */
  redrivePolicy: json

  /**
   * Gets approximate statistics for the specified queue.
   */
  queueStats: member function(): AwsSqsStats

  /**
   * Gets attributes for the specified queue.
   */
  queueAttributes: member function(attributeNames: [string]): map<string, string>

  /**
   * policy of the queue. policy and services are mutually exclusive. You can only set one of them.
   */
  policy: json

  /**
   * services allowed to access the queue. By default, only the s3 service can access the queue with all queue actions.
   * If policy is not specified, then a default policy will be generated with all sqs actions and the services you specified.
   * e.g. ["ec2.amazonaws.com", "s3.amazonaws.com"]
   */
  services: [string]

  /**
   * @return the events for the queue.
   */
  events: member function(maxNumberOfEvents: int = 10): [AwsS3Event]

  /**
   * @return the url of the queue.
   */
  safeUrl: member function(): !string

  generateResourceName: ~
  awsServiceName:       ~

  /**
   * Same as {@link CloudMessageBroker#receiveMessages}.
   * However, batchSize cannot be more than 10 because of the limitation of AwsSqs library.
   * https://docs.aws.amazon.com/AWSSimpleQueueService/latest/APIReference/API_ReceiveMessage.html.
   */
  receiveMessages: ~(spec: @constraint(condition='$.batchSize() == null || $.batchSize() > 0 && $.batchSize() <= 10') ~)
}
