/**
 * This type provides an interface to the AWS *IAM* service;
 * see the [AWS documentation](http://docs.aws.amazon.com/IAM/latest/UserGuide/id_roles.html).
 */
@cloud(hasResourceArn=true,
       hasResourceId=false,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='iaminstpf')
type AwsIamInstanceProfile mixes AwsResource, AwsIamRolesMember {

  /**
   * The date when the instance profile was created.
   */
  createdAt: datetime

  /**
   * The path to the instance profile.
   */
  path: string

  hasTags:   ~
  hasRegion: ~
  forRole:   function(role: string): AwsIamInstanceProfile

  /**
   * Gets the instance profile rom the arn.
   */
  fromArn: function(arn: !string): AwsIamInstanceProfile
}
