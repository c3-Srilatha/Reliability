/**
 * ECS deployment configuration
 */
type AwsEcsDeploymentConfiguration mixes ConfigChild<CloudResource> {

  /**
   * The upper limit of the number of tasks that are allowed in the RUNNING or PENDING state in a service during a deployment
   */
  maximumPercent: int

  /**
   * The lower limit of the number of running tasks that must remain in the RUNNING state in a service during a deployment.
   */
  minimumHealthyPercent: int
}
