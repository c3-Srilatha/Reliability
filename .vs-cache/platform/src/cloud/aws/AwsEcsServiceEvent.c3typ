/**
 * Event of AWS ECS service
 */
type AwsEcsServiceEvent mixes ConfigChild<CloudResource> {

  /**
   * The Unix timestamp for when the event was triggered
   */
  createdAt: datetime

  /**
   * The ID string of the event
   */
  id: string

  /**
   * The event message
   */
  message: string
}
