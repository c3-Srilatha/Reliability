/**
 * AWS API.
 */
type Aws mixes CloudProvider {

  /**
   * Method to get abbreviation for aws region
   * E.g. use1 for us-east-1
   * @returns abbreviation for aws region
   */
  abbreviateAwsRegion: function(region: string): !string

  /**
   * Method to get aws region from abbreviation
   * E.g. us-east-1 from use1
   * @returns aws region
   */
  expandAwsRegionAbbreviation: function(regionAbb: string): !string

  /**
   * Method returns available zones in aws region
   * E.g. us-east-1a, us-east-1b, us-east-1c, us-east-1d, and us-east-1e from us-east-1
   * @returns aws availability zones
   */
  availabilityZones: function(region: !string): [string]

  internalDomain: ~
  taggingApi:     ~

  /**
   * Returns com.amazonaws.HttpMethod from the passed {@link HttpMethod}
   */
  httpMethod: private function(method: !?string serialized HttpMethod,
                               failIfInvalid: boolean): @java(class="com.amazonaws.HttpMethod") native
}
