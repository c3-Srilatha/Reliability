/**
 * Overrides AWS ECS task docker container configurations at run time
 */
type AwsEcsContainerOverride mixes ConfigChild<CloudResource> {

  /**
   * The command to send to the container that overrides the default command from the Docker image or the task definition
   */
  command: [string]

  /**
   * The number of cpu units reserved for the container, instead of the default value from the task definition
   */
  cpu: int

  /**
   * The environment variables to send to the container
   */
  environment: [AwsEcsKeyValuePair]

  /**
   * The hard limit (in MiB) of memory to present to the container, instead of the default value from the task definition
   */
  memory: int

  /**
   * The soft limit (in MiB) of memory to reserve for the container, instead of the default value from the task definition
   */
  memoryReservation: int

  /**
   * The name of the container that receives the override
   */
  name: string
}
