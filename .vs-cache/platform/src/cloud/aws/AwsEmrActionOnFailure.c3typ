/**
 * Enum for all possible actions to take when a step in the Emr cluster fails
 */
enum type AwsEmrActionOnFailure {

  /**
   * Cancel the remaining steps and cluster get into a Waiting status
   */
  CANCEL_AND_WAIT

  /**
   * Continue the execution of the remaining steps
   */
  CONTINUE

  /**
   * Terminate the cluster
   */
  TERMINATE_CLUSTER

  /**
   * Terminate the job flow
   */
  TERMINATE_JOB_FLOW
}
