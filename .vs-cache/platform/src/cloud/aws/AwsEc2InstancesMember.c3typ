/**
 * abstract type to represent AWS Resource which is parent of a list of ec2 instances.
 */
abstract type AwsEc2InstancesMember {

  /**
   * The ids of the child ec2 instances of the resource.
   */
  ec2Instances: [AwsEc2Instance]

  /**
   * get the child ec2 instances of the resource
   */
  safeEc2Instances: member function(): [AwsEc2Instance]
}
