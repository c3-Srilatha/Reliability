@cloud(hasResourceArn=true,
       hasResourceId=false,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='REQUIRED',
       cloudFunc='iotRule')
type AwsIotTopicRule mixes AwsResource {

  /**
   * Query is a simplified SQL syntax to filter messages received on an topic and push the data to the actions.
   * When using a query with multiple lines, be sure to escape the newline characters.
   */
  query: string

  /**
   * Specify whether the rule is disabled.
   */
  ruleDisabled: boolean

  /**
   * Actions that will be triggered by the messages passing the query filter.
   */
  actions: [AwsLambdaFunc]

  hasTags: ~
}
