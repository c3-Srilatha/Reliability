/**
 * Aws Vpn Connection.
 */
@cloud(hasResourceArn=false,
       hasResourceId=true,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='vpn')
type AwsVpnConnection mixes AwsResource, AwsCustomerGatewayMember, AwsVpnGatewayMember {

  /**
   * The configuration information for the VPN connection's customer gateway (in the native XML format).
   */
  customerGatewayConfiguration: string

  /**
   * Indicates whether the VPN connection uses static routes only.
   */
  hasStaticRoutesOnly: boolean

  /**
   * The static routes associated with the VPN connection.
   */
  routes: [AwsVpnStaticRoute]

  /**
   * The current state of the VPN connection.
   */
  state: string enum CloudResourceState

  /**
   * The type of VPN connection.
   */
  gatewayType: string enum AwsGatewayType

  /**
   * Information about the VPN tunnel.
   */
  vgwTelemetries: [AwsVgwTelemetry]
}
