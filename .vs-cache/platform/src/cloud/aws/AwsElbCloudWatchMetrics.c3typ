/**
 * Enum type to store Amazon cloud watch metrics for resource
 */
enum type AwsElbCloudWatchMetrics {

  LATENCY = 'Latency'

  ESTIMATEDPROCESSEDBYTES = 'EstimatedProcessedBytes'

  HEALTHYHOSTCOUNT = 'HealthyHostCount'

  BACKENDCONNECTIONERRORS = 'BackendConnectionErrors'

  REQUESTCOUNT = 'RequestCount'

  ESTIMATEDALBNEWCONNECTIONCOUNT = 'EstimatedALBNewConnectionCount'

  ESTIMATEDALBACTIVECONNECTIONCOUNT = 'EstimatedALBActiveConnectionCount'

  ESTIMATEDALBCONSUMEDLCUS = 'EstimatedALBConsumedLCUs'

  UNHEALTHYHOSTCOUNT = 'UnHealthyHostCount'

  HTTPCODE_BACKEND_3XX = 'HTTPCode_Backend_3XX'

  HTTPCODE_BACKEND_4XX = 'HTTPCode_Backend_4XX'

  HTTPCODE_BACKEND_2XX = 'HTTPCode_Backend_2XX'
}
