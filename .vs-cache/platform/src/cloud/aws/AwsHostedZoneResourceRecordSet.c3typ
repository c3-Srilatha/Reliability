type AwsHostedZoneResourceRecordSet {

  /**
   * Failover resource record sets only.Among resource record sets that have the same combination of DNS name and type,
   * a value that indicates whether the current resource record set is a primary or
   * secondary resource record set.
   */
  failover: string

  /**
   * Alias resource record sets only: Information about the AWS resource to which you are redirecting traffic.
   */
  aliasTarget: AwsHostedZoneAliasTarget

  /**
   * Health Check resource record sets only, An identifier that is used to identify health check associated with the resource record set.
   */
  healthCheckId: string

  /**
   * The domain name of the current resource record set.
   */
  name: string

  /**
   * Latency-based resource record sets only: Among resource record sets that have the same combination of DNS name and type,
   * a value that specifies the AWS region for the current resource record set.
   */
  region: string

  /**
   * Weighted, Latency, Geo, and Failover resource record sets only: An identifier that differentiates among multiple
   * resource record sets that have the same combination of DNS name and type.
   */
  identifier: string

  /**
   * The type of the current resource record set.
   */
  resourceType: string

  /**
   * The cache time to live for the current resource record set.
   */
  ttl: double

  /**
   * Weighted resource record sets only: Among resource record sets that have the same combination of DNS name and type, a value
   * that determines what portion of traffic for the current resource record set is routed to the associated location.
   */
  weight: double

  /**
   * Contains the resource records for the current resource record set.
   */
  values: [string]
}
