/**
 * abstract type to represent AWS Resource which is parent of an ec2 instance.
 */
abstract type AwsEc2InstanceMember {

  /**
   * The id of the child ec2 instance of the resource.
   */
  ec2Instance: AwsEc2Instance

  /**
   * get the child ec2 instance of the resource
   */
  safeEc2Instance: member function(): AwsEc2Instance
}
