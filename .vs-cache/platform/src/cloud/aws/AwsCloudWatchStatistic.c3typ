/**
 * Enum for all possible output statistics of a metric
 */
enum type AwsCloudWatchStatistic {

  /**
   * All values submitted for the matching metric added together. This statistic can be useful for determining the total
   * volume of a metric.
   */
  SUM = 'Sum'

  /**
   * The value of Sum / SampleCount during the specified period.
   */
  AVG = 'Average'

  /**
   * The lowest value observed during the specified period. You can use this value to determine low volumes of activity
   * for your application.
   */
  MIN = 'Minimum'

  /**
   * The highest value observed during the specified period. You can use this value to determine high volumes of
   * activity for your application.
   */
  MAX = 'Maximum'

  /**
   * The count (number) of data points used for the statistical calculation.
   */
  COUNT = 'SampleCount'
}
