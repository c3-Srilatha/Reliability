/**
 * AWS ElastiCache SubnetGroup
 */
@cloud(hasResourceArn=false,
       hasResourceId=false,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='ecsn')
type AwsElastiCacheSubnetGroup mixes AwsResource {

  /**
   * The Subnet IDs for the ElastiCache subnet group.
   */
  subnetIds: [string]

  /**
   * The description for the ElastiCache subnet group.
   */
  description: string

  hasTags: ~
}
