/**
 * abstract type to represent AWS Resource which is associated with a elb.
 */
abstract type AwsElbMember {

  /**
   * The id of the elb the resource is associated.
   */
  elb: !AwsElb

  /**
   * get the elb associated with the resource
   */
  safeElb: member function(): AwsElb
}
