/**
 * Aws Customer Gateway.
 */
@cloud(hasResourceArn=false,
       hasResourceId=true,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='cgw')
type AwsCustomerGateway mixes AwsResource, AwsElasticIpMember {

  /**
   * The customer gateway's Border Gateway Protocol (BGP) Autonomous System Number (ASN).
   */
  bgpAsn: int

  /**
   * The current state of the customer gateway
   */
  state: string enum CloudResourceState

  /**
   * The type of VPN connection the customer gateway supports.
   */
  gatewayType: string enum AwsGatewayType
}
