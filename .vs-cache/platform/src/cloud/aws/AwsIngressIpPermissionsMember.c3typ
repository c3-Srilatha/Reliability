/**
 * abstract type to represent AWS Resource which is a list of ipPermissions.
 */
abstract type AwsIngressIpPermissionsMember {

  /**
   * One or more inbound rules associated with the security group.
   */
  ingressIpPermissions: [AwsIpPermission]

  /**
   * Get the ingress ip permissions for the given resource
   */
  safeIngressIpPermissions: member function(): [AwsIpPermission]
}
