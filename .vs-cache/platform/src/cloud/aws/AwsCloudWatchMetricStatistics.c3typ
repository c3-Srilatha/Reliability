/**
 * AwsCloudWatch is a service that monitors AWS resources and the applications running in real-time. Use AwsCloudWatch
 * to collect and track metrics that you want to measure for resources and applications.
 */
type AwsCloudWatchMetricStatistics {

  /**
   * It contains the statistical data that Amazon CloudWatch computes from metric data.
   */
  data: [AwsCloudWatchDataPoint]

  /**
   * @return timeseries of sample sum metric.
   */
  sum: member function(spec: TimeInfo): !Timeseries<double>

  /**
   * @return timeseries of sample avg metric.
   */
  avg: member function(spec: TimeInfo): !Timeseries<double>

  /**
   * @return timeseries of sample min metric.
   */
  min: member function(spec: TimeInfo): !Timeseries<double>

  /**
   * @return timeseries of sample max metric.
   */
  max: member function(spec: TimeInfo): !Timeseries<double>

  /**
   * @return timeseries of sample count metric.
   */
  count: member function(spec: TimeInfo): !Timeseries<double>
}
