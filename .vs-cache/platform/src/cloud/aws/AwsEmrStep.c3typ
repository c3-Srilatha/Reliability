/**
 * The specification for creating one step in the Emr cluster
 */
type AwsEmrStep mixes ConfigChild<AwsEmr> {

  /**
   * Auto-generated id of the step
   */
  id: string

  /**
   * State of the step
   */
  state: string enum AwsEmrStepState

  /**
   * Creation time of the step
   */
  creationTime: datetime

  /**
   * Step name chosen by the user.
   */
  stepName: !string

  /**
   * Jar file location of this step
   */
  jarURI: !string

  /**
   * Input argument of the jar
   */
  arguments: [string] schema name 'AR'

  /**
   * Action to take when the execution of step fails.
   */
  actionOnFailure: string enum AwsEmrActionOnFailure = CONTINUE

  /**
   * Main class of the jar
   */
  mainClass: string
}
