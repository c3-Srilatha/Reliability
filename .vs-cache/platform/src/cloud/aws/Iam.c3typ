/**
 * This type provides an interface to the AWS *IAM* service;
 * see the [AWS documentation](https://aws.amazon.com/iam/).
 */
type Iam {

  /**
   * The Amazon Resource Name (ARN)
   */
  arn: string

  /**
   * Method to get C3 Canonical abbreviation
   * FOR Iam returns iam, Subnet return sn
   * @returns C3 Canonical abbreviation for aws resource
   */
  cloudFunc: abstract function(): !string
}
