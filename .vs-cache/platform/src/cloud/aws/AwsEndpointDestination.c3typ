type AwsEndpointDestination {

  /**
   * The the canonical name of the domain where the url will be directed. This is used for "CName" Record. Either
   * canonicalName or ipAddress must be must be provided.
   */
  cname: string

  /**
   * The IP addresses where the url will be directed. This is used for "A" Record. Either canonicalName or ipAddress
   * must be provided.
   */
  ipAddresses: [string]
}
