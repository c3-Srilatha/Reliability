/**
 * Docker container definition
 */
type AwsEcsDockerContainerDefinition mixes ConfigChild<CloudResource> {

  /**
   * The name of a container
   */
  name: string

  /**
   * The command that is passed to the container
   */
  command: [string]

  /**
   * The number of cpu units reserved for the container
   */
  cpu: int

  /**
   * When this parameter is true, networking is disabled within the container
   */
  disableNetworking: boolean

  /**
   * A list of DNS search domains that are presented to the container
   */
  dnsSearchDomains: [string]

  /**
   * A list of DNS servers that are presented to the container
   */
  dnsServers: [string]

  /**
   * A key/value map of labels to add to the container
   */
  dockerLabels: map<string, string>

  /**
   * A list of strings to provide custom labels for SELinux and AppArmor multi-level security systems
   */
  dockerSecurityOptions: [string]

  /**
   * Docker entry point
   */
  entryPoint: [string]

  /**
   * The environment variables to pass to a container
   */
  environment: [AwsEcsKeyValuePair]

  /**
   * If the essential parameter of a container is marked as true, and that container fails or stops for any reason,
   * all other containers that are part of the task are stopped
   */
  essential: boolean

  /**
   * A list of hostnames and IP address mappings to append to the /etc/hosts file on the container
   */
  extraHosts: [AwsEcsDockerContainerHostEntry]

  /**
   * The hostname to use for your container
   */
  hostname: string

  /**
   * The image used to start a container
   */
  image: string

  /**
   * The link parameter allows containers to communicate with each other without the need for port mappings
   */
  links: [string]

  /**
   * The hard limit (in MiB) of memory to present to the container
   */
  memory: int

  /**
   * The soft limit (in MiB) of memory to reserve for the container
   */
  memoryReservation: int

  /**
   * The mount points for data volumes in your container
   */
  mountPoints: [AwsEcsDockerContainerMountPoint]

  /**
   * The list of port mappings for the container
   */
  portMappings: [AwsEcsDockerContainerPortMap]

  /**
   * When this parameter is true, the container is given elevated privileges on the host container instance
   */
  privileged: boolean

  /**
   * When this parameter is true, the container is given read-only access to its root file system
   */
  readonlyRootFilesystem: boolean

  /**
   * A list of ulimits to set in the container
   */
  ulimit: [AwsEcsDockerContainerUlimit]

  /**
   * The user name to use inside the container
   */
  user: string

  /**
   * Data volumes to mount from another container
   */
  volumeFrom: [AwsEcsDockerContainerVolumeFrom]

  /**
   * The working directory in which to run commands inside the container
   */
  workingDirectory: string

  /**
   * Log configuration of the container.
   */
  logConfiguration: AwsEcsContainerLogConfig
}
