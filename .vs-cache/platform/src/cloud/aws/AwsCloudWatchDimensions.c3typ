/**
 * Entity type to store Amazon Cloud Watch dimensions for each resource type
 */
type AwsCloudWatchDimensions mixes Metadata, Named {

  /**
   * list of Amazon Cloud Watch dimensions
   */
  dimensions: ![string] schema name 'DIMLIST'

  /**
   * function returns the list of Amazon Cloud Watch dimensions
   * @param: namespace
   *        namespace associated to the CloudResource.
   */
  forNamespace: function(namespace: string enum AwsCloudWatchNamespace): [string]

  /**
   * function returns the list of Amazon Cloud Watch dimensions
   * @param: type
   */
  forResourceType: function(resourceType: Type): [string]
}
