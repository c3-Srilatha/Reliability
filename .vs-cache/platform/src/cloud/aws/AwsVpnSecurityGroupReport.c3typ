type AwsVpnSecurityGroupReport {

  accountId:        !string
  region:           !string
  env:              !string
  elbName:          !string
  securityGroupIds: [string]

  /**
   * indicate whether the cidrBlock is whitelist or not. eg. ("123.123.123.123/32",true) means "123.123.123.123/32" is whitelist by this elb.
   */
  hasWhitelist: [StrBoolPair]
}
