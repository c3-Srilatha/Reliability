/**
 * AWS VPC.
 */
@cloud(hasResourceArn=false,
       hasResourceId=true,
       hasResourceName=false,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='vpc')
type AwsVpc mixes AwsResource, AwsDhcpOptionsMember, AwsHostedZoneMember {

  /**
   * The CIDR block for the VPC.
   */
  cidrBlock: string

  /**
   * Indicates whether the VPC is the default VPC.
   */
  isDefault: boolean

  /**
   * Select whether instances launched into the VPC are run on shared or dedicated hardware.
   */
  instanceTenancy: string enum AwsVpcTenancy

  /**
   * The current state of the VPC.
   */
  state: string enum CloudResourceState

  /**
   * Indicates whether the instances launched in the VPC get DNS hostnames.
   */
  dnsHostnames: member function(): boolean

  /**
   * Enable the instances launched in the VPC get DNS hostnames.
   */
  enableDnsHostnames: member function(enable: boolean = true)

  /**
   * Indicates whether the DNS resolution is supported for the VPC.
   */
  dnsSupport: member function(): boolean

  /**
   * Enable the the DNS resolution is supported for the VPC.
   */
  enableDnsSupport: member function(enable: boolean = true)

  /**
   * The Vpcs that is peered with the current vpc.
   */
  peeredVpcs: member function(): [AwsVpc]

  /**
   * Find an available cidrblock that 1) do not overlap with cidrblocks of all peered Vpcs; and 2) have 16-bit route mask
   */
  freeCidrBlock: member function(): !string

  /**
   * upsert specific number of subnets with specific role and specific cidr to the vpc. Will try to put subnets in
   * different availability zones, but if the count is larger the number of availability zones, then put multiple
   * subnets in the same zone.
   * @param role
   *        the role of subnets. eg. cass, zk and etc.
   * @param count
   *        the number of subnets to upsert to the vpc.
   * @param cidrStart
   *        the start of third number of cidr block. eg. if you specify count = 2 and cidrStart = 3, then
   *        will upsert two subnets with xxx.xxx.3.xxx and xxx.xxx.4.xxx cidr blocks.
   */
  upsertSubnets: private member function(role: string, count: int = 1, cidrStart: int = 1): [AwsSubnet]

  /**
   * associate vpc with a specific hosted zone.
   * @param hostedZone
   *        the hosted zone to associate with.
   */
  associateWithHostedZone: private member function(hostedZone: !AwsHostedZone)

  /**
   * disassociate vpc from a specific hosted zone.
   * @param hostedZone
   *        the hosted zone to disassociate from.
   */
  disassociateFromHostedZone: private member function(hostedZone: !AwsHostedZone)
}
