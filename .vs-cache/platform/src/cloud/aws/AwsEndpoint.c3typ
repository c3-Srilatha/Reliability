/**
 * This type provides a high-level interface to manage the URL under the DNS registry of Amazon Route53. It is using the
 * underlying AwsHostedZone and AwsHostedZoneRecordSet to perform the actual action.
 */
private type AwsEndpoint mixes Endpoint {

  /**
   * A valid url. For example, "http://test.c3-test.com."
   */
  url: string

  /**
   * Indicate whether the url in the AwsEndpoint is a vanity url.
   */
  isVanityUrl: boolean

  /**
   * The Id of the C3 cluster where the URL is routed.
   */
  clusterId: string

  /**
   * The CNAME is a type of resource record in the Aws HostedZone Recordset. The cname
   * represents the domain where the url will be directed. Either CNAME or ipAddress must be must be provided.
   */
  cname: string

  /**
   * The IP addresses where the url will be directed. This is used for "A" Record. Either canonicalName or ipAddress
   * must be provided.
   */
  ipAddresses: [string]

  /**
   * Indicate whether it allows to add a DNS failover for re-routing this endpoint in case the site is down.
   */
  isDnsFailoverSupported: boolean

  /**
   * Upsert Url to the DNS registry of Amazon Route53.
   *
   * @param passIfNotManagedByAws
   *            A flag indicates whether an exception will be thrown if the domain is not managed by Aws.
   * @param doNotForceUpdate
   *            A flag indicates whether the record set of the Url in the DNS registry will be force updated if there
   *            already exists a different record set of the same Url in the DNS registry.
   */
  upsertUrl: member function(passIfNotManagedByAws: boolean,
                             doNotForceUpdate: boolean,
                             spec: CloudResourceOperationSpec)

  /**
   * Remove Url from the Dns registry of Amazon Route53.
   *
   * @param passIfNotManagedByAws
   *            A flag indicates whether an exception will be thrown if the domain is not managed by Aws.
   * @param doNotForceDelete
   *            A flag indicates whether the record set of the Url in the DNS registry will be force deleted,
   *            if the record set of the Url in the DNS registry does not match the cname or ipAddresses of the endpoint.
   */
  removeUrl: member function(passIfNotManagedByAws: boolean,
                             doNotForceDelete: boolean,
                             spec: CloudResourceDestroySpec)

  /**
   * Check if the Url has been added into the DNS registry of Amazon Route53.
   */
  urlRegistrationStatus: member function(): !AwsUrlRegistrationInfo

  /**
   * The Hosted Zone HealthChecks that is continuously monitoring the health of the url.
   */
  healthCheck: member function(): [AwsHostedZoneHealthCheck]

  /**
   * Get the AwsEndPoint information for a given URL.
   */
  forUrl: function(url: !string): AwsEndpoint

  /**
   * Upsert Dns Failover protection for the url. If the primary routing fails, the access to the url will be re-routed
   * to the failover destination.
   *
   * @param failoverDestination
   *            The destination where the request to the url will be re-routed when the primary destination fails.
   * @param passIfNotManagedByAws
   *            A flag indicates whether an exception will be thrown if the domain is not managed by Aws.
   */
  upsertDnsFailOver: member function(failoverDestination: !AwsEndpointDestination, passIfNotManagedByAws: boolean)

  /**
   * Remove Dns Failover protection for the url.
   *
   * @param passIfNotManagedByAws
   *            A flag indicates whether an exception will be thrown if the domain is not managed by Aws.
   */
  removeDnsFailOver: member function(passIfNotManagedByAws: boolean)

  /**
   * Get Dns Failover protection for the url.
   */
  dnsFailOver: member function(): AwsEndpointDestination

  /**
   * Compute url from member fields.
   *
   * @param scheme
   *            The http scheme to use in the url. HTTP by default
   * @return the computed url
   */
  safeUrl: inline member function(scheme: string): !string

  /**
   * Return hosted zone for this endpoint
   */
  hostedZone: private member function(passIfNotManagedByAws: boolean): AwsHostedZone
}
