/**
 * Enum for all possible states of Kinesis Shard
 */
enum type AwsKinesisShardState {

  /**
   * If a shard is in the OPEN state, data records can be both added to the shard and retrieved from the shard.
   */
  OPEN = 'open'

  /**
   * If a shard is in the CLOSED state, data records are no longer added to the shard. However, data records can still
   * be retrieved from the shard for a limited time.
   */
  CLOSED = 'closed'

  /**
   * If a shard is in the CLOSED state,, all the data records in the shard have expired and are no longer accessible.
   */
  EXPIRED = 'expired'
}
