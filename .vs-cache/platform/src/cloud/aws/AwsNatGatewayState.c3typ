/**
 * Enum for all possible states of the NAT Gateway
 */
enum type AwsNatGatewayState {

  /**
   * The NAT gateway is being created and is not ready to process traffic.
   */
  PENDING = 'pending'

  /**
   * The NAT gateway could not be created.
   */
  FAILED = 'failed'

  /**
   * The NAT gateway is able to process traffic.
   */
  AVAILABLE = 'available'

  /**
   * The NAT gateway is in the process of being terminated and may still be processing traffic.
   */
  DELETING = 'deleting'

  /**
   * The NAT gateway has been terminated and is no longer processing traffic.
   */
  DELETED = 'deleted'
}
