type AwsKinesisShard {

  /**
   * The unique identifier of the shard within the Amazon Kinesis stream.
   */
  id: string

  /**
   * The range of possible hash key values for the shard, which is a set of
   * ordered contiguous positive integers.
   */
  hashKeyRange: AwsKinesisRange

  /**
   * The range of possible sequence numbers for the shard.
   */
  sequenceNumberRange: AwsKinesisRange

  /**
   * The shard Id of the shard's parent.
   */
  parentShardId: string

  /**
   * The shard Id of the shard adjacent to the shard's parent.
   */
  adjacentParentShardId: string

  /**
   * In the process of resharding, a parent shard transitions from an OPEN state to a CLOSED state to an EXPIRED state.
   */
  state: string enum AwsKinesisShardState
}
