/**
 * List task definition family result
 */
type AwsEcsListTaskDefinitionFamiliesResult {

  /**
   * List of ECS task definition families in this account
   */
  families: [string]

  /**
   * The marker used for listing the next batch of task definition families
   */
  nextMarker: string
}
