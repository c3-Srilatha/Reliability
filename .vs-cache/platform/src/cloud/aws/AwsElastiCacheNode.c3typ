/**
 * AwsElastiCache node information
 */
type AwsElastiCacheNode {

  /**
   * Node identifier
   */
  nodeId: !string

  /**
   * Node endpoint. This should only be used for debugging. Cluster level endpoint should be used for normal operations.
   */
  endpoint: string

  /**
   * The node status
   */
  status: !string enum AwsElastiCacheStatus

  /**
   * The date and time when the node was created.
   */
  creationTime: datetime

  /**
   * The availability zone of the node.
   */
  availabilityZone: string enum AwsAvailabilityZone
}
