/**
 * Returns a certificate for a particular domain
 */
type AwsServerCertificate mixes Iam {

  /**
   * @parameter domain
   *              c3 domain e.g. c3-e or c3energy
   */
  domainName: !string

  /**
   * The date on which the certificate is set to expire.
   */
  expiration: datetime

  /**
   * The path to the server certificate.
   */
  path: string

  /**
   * The stable and unique string identifying the server certificate.
   */
  serverCertificateId: string

  /**
   * The name that identifies the server certificate.
   */
  serverCertificateName: string

  /**
   * The date when the server certificate was uploaded.
   */
  uploadDate: datetime

  /**
   * Lists the server certificates stored in IAM that have the specified path prefix. If none exist,
   * the action returns an empty list.
   *
   * @parameter pathPrefix
   *               The path prefix for filtering the results.
   *
   * @param cred
   *            This optional parameter should be provided along if you want the ec2 client to assume a different role.
   *
   * @return List of server certificates without its certificate body, certificate chain, and private key.
   */
  list: function(pathPrefix: string, cred: AssumedRoleCredentials): [AwsServerCertificate]

  /**
   * Returns a certificate for a particular domain
   * E.g. AwsServerCertificate.getDefault("c3-e.com"), AwsServerCertificate.getDefault("c3energy.com")
   *
   * @parameter domain
   *              c3 domain e.g. c3-e or c3energy
   *
   * @param cred
   *            This optional parameter should be provided along if you want the ec2 client to assume a different role.
   *
   * @return First valid server certificate for domain
   */
  getDefault: function(domain: !string, cred: AssumedRoleCredentials, failIfMissing: boolean): AwsServerCertificate
}
