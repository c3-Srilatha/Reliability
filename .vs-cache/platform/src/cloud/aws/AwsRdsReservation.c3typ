/**
 * This type provides an interface to the AWS RDS *ReservedInstance*
 * see the [AWS documentation](https://aws.amazon.com/rds/reserved-instances/).
 */
@cloud(hasResourceArn=true,
       hasResourceId=false,
       hasResourceName=false,
       hasResourceGroupName=true,
       identityRoleOptions='OPTIONAL',
       cloudFunc='awsrdsrsv')
type AwsRdsReservation mixes AwsResource, AwsReservation {

  /**
   * The instance type on which the Reserved Instance can be used.
   */
  instanceType: string

  /**
   * Indicates if the reservation applies to Multi-AZ deployments.
   */
  multiAZ: boolean

  /**
   * The offering identifier.
   */
  reservedDBInstancesOfferingId: string

  awsServiceName: ~
}
