/**
 * This type provides an interface to the AWS *Elastic Block Storage Volume* service;
 * see the [AWS documentation](http://docs.aws.amazon.com/AWSEC2/latest/UserGuide/AmazonEBS.html).
 */
@cloud(hasResourceArn=false,
       hasResourceId=true,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='ebs')
type AwsEbsVolume mixes AwsResource, AwsEc2InstanceMember, ConfigChild<CloudResource> {

  /**
   * The Availability Zone for the volume.
   */
  availabilityZone: !string

  /**
   * The time stamp when volume creation was initiated.
   */
  createTime: string

  /**
   * Indicates whether the volume will be encrypted.
   */
  isEncrypted: boolean

  /**
   * The number of I/O operations per second (IOPS) that the volume supports.
   */
  iops: int

  /**
   * The size of the volume, in GiBs.
   */
  size: int

  /**
   * The snapshot from which the volume was created, if applicable.
   */
  snapshotId: string

  /**
   * The volume state.
   */
  state: string enum CloudResourceState

  /**
   * The volume type.
   */
  volumeType: string

  /**
   * The volume attachment state.
   */
  attachmentState: string enum AwsAttachmentState

  /**
   * The device name.
   */
  deviceName: string

  /**
   * Indicates whether the EBS volume is deleted on instance termination.
   */
  isDeleteOnTermination: boolean

  /**
   * attach the volume to an ec2 instance.
   * @param instanceId
   *        the instance to attach to
   * @param deviceName
   *        the device name to attach. will automatically find an available device name if not set.
   */
  attachToEc2Instance: member function(instanceId: !string, deviceName: string): !AwsEbsVolume
}
