/**
 * ECS service is created to start and automatically control ECS tasks
 */
@cloud(hasResourceArn=true,
       hasResourceId=false,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='ecss')
type AwsEcsService mixes AwsResource, AwsEcsClusterMember {

  /**
   * Unique, case-sensitive identifier you provide to ensure the idempotency of the request
   */
  clientToken: string

  /**
   * The status of the service
   */
  status: string enum AwsEcsServiceAndContainerStatus

  /**
   * The task definition to use for tasks in the service
   */
  taskDefinition: string

  /**
   * The Amazon Resource Name (ARN) of the cluster that hosts the service
   */
  clusterArn: string

  /**
   * The Unix timestamp for when the service was created
   */
  createdAt: datetime

  /**
   * Optional deployment parameters that control how many tasks run during the deployment
   */
  deploymentConfiguration: AwsEcsDeploymentConfiguration

  /**
   * The current state of deployments for the service
   */
  deployments: [AwsEcsServiceDeployment]

  /**
   * The desired number of instantiations of the task definition to keep running on the service
   */
  desiredCount: int

  /**
   * The event stream for your service
   */
  events: [AwsEcsServiceEvent]

  /**
   * A list of Elastic Load Balancing load balancer objects
   */
  loadBalancers: [AwsEcsLoadBalancer]

  /**
   * The number of tasks in the cluster that are in the PENDING state
   */
  pendingCount: int

  /**
   * The number of tasks in the cluster that are in the RUNNING state
   */
  runningCount: int

  /**
   * The placement constraints for the tasks in the service
   */
  placementConstraints: [AwsEcsPlacementConstraint]

  /**
   * The placement strategy that determines how tasks for the service are placed
   */
  placementStrategy: [AwsEcsPlacementStrategy]

  /**
   * The Amazon Resource Name (ARN) of the IAM role associated with the service
   */
  roleArn: string

  hasTags: ~
}
