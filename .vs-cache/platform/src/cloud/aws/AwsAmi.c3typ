/**
 * This type provides an interface to the AWS *Ami* service;
 * see the [AWS documentation](http://docs.aws.amazon.com/AWSEC2/latest/UserGuide/AMIs.html).
 */
@cloud(hasResourceArn=false,
       hasResourceId=true,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='ami')
type AwsAmi mixes AwsResource {

  /**
   * The architecture of the image. It's a combination of device name, snapshotId, volume-size, delete-on-termination,
   * and volume-type. eg. "/dev/xvda=snap-7a30d6e4:20:true:gp2".
   */
  architecture: string enum AwsArchitectureType

  /**
   * Any block device mapping entries.
   */
  blockDeviceMappings: [AwsBlockDeviceMapping]

  /**
   * The date and time the image was created.
   */
  createdAt: datetime

  /**
   * The description of the AMI that was provided during image creation.
   */
  description: !string

  /**
   * Specifies whether enhanced networking with ENA is enabled.
   */
  isEnaEnabled: boolean

  /**
   * The hypervisor type of the image.
   */
  hypervisor: string enum AwsHypervisorType

  /**
   * The location of the AMI. It's a combination of the owner and name of the AMI. eg. "accountId/imageName"
   */
  imageLocation: string

  /**
   * The AWS account alias (for example, amazon, self) or the AWS account ID of the AMI owner.
   */
  imageOwnerAlias: string

  /**
   * The type of image.
   */
  imageType: string enum AwsAmiType

  /**
   * The kernel associated with the image, if any.
   */
  kernelId: string

  /**
   * The ID of the AWS account that owns the reservation.
   */
  ownerId: string

  /**
   * The value is Windows for Windows AMIs; otherwise blank.
   */
  platform: string enum AwsPlatformType

  /**
   * Indicates whether the image has public launch permissions.
   */
  isPublic: boolean

  /**
   * The RAM disk associated with the image, if any.
   */
  ramDiskId: string

  /**
   * The device name of the root device (for example, /dev/sda1 or /dev/xvda).
   */
  rootDeviceName: string

  /**
   * The type of root device used by the AMI.
   */
  rootDeviceType: string enum AwsEc2InstanceRootDeviceType

  /**
   * Specifies whether enhanced networking with the Intel 82599 Virtual Function interface is enabled.
   */
  sriovNetSupport: string

  /**
   * The current state of the AMI.
   */
  state: string enum CloudResourceState

  /**
   * The type of virtualization of the AMI.
   */
  virtualizationType: string enum AwsVirtualizationType

  /**
   * The source ec2 instance to create the ami
   */
  sourceEc2Instance: AwsEc2Instance

  /**
   * Initiates the copy of the image to specified region.
   *
   * @param targetRegion
   *        the target region to copy to
   * @param targetImageResourceName
   *        the name of the new copied image
   * @return the new copy image
   */
  copyImage: member function(targetRegion: !string, targetImageResourceName: string): !AwsAmi

  /**
   * Find the default image in the specified region and account
   *
   * @param region
   *        the region where to find the default image
   * @param accountId
   *        the id of an account where to find the default image
   */
  defaultImage: function(region: !string, accountId: string): !AwsAmi
}
