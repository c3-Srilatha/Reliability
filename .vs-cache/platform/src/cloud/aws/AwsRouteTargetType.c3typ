enum type AwsRouteTargetType {

  /**
   * A local route that enables communication within a VPC.
   */
  LOCAL

  /**
   * Internet Gateway.
   */
  INTERNET_GATEWAY

  /**
   * A NAT gateway.
   */
  NAT_GATEWAY

  /**
   * A NAT instance in VPC.
   */
  INSTANCE

  /**
   * VPC peering connection.
   */
  VPC_PEERING

  /**
   * Aws network interface.
   */
  NETWORK_INTERFACE
}
