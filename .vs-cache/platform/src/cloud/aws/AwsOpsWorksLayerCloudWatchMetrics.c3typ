/**
 * Enum type to store Amazon cloud watch metrics for resource
 */
enum type AwsOpsWorksLayerCloudWatchMetrics {

  PROCS = 'procs'

  MEMORY_TOTAL = 'memory_total'

  CPU_SYSTEM = 'cpu_system'

  CPU_NICE = 'cpu_nice'

  LOAD_5 = 'load_5'

  LOAD_1 = 'load_1'

  CPU_IDLE = 'cpu_idle'

  MEMORY_FREE = 'memory_free'

  MEMORY_USED = 'memory_used'

  MEMORY_CACHED = 'memory_cached'

  CPU_USER = 'cpu_user'

  MEMORY_SWAP = 'memory_swap'

  CPU_WAITIO = 'cpu_waitio'

  CPU_STEAL = 'cpu_steal'

  LOAD_15 = 'load_15'

  MEMORY_BUFFERS = 'memory_buffers'
}
