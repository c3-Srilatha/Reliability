/**
 * This type provides an interface to the AWS *Simple Queue Permission*;
 */
type AwsSqsPermission {

  /**
   * The action the client wants to allow for the specified principal. e.g. [AwsSqsActionType.SEND_MESSAGE, AwsSqsActionType.RECEIVE_MESSAGE]
   */
  // TODO: PLAT-6796 Make AwsSqsPermission.actions [AwsSqsActionType] after we have the ability to do - see PLAT-6739
  actions: [string]

  /**
   * The AWS account number of the principal who is given permission. e.g. [850572971111, 650572971112]
   */
  accountIds: [string]

  /**
   * The unique identification of the permission you're setting. e.g. AliceSendMessage
   */
  label: !string
}
