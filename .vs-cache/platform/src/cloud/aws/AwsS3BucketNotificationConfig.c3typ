/**
 * Represents a AWS S3 bucket's notification configuration.
 * The notification configuration is used to control reception of notifications for specific events
 * for Amazon S3 buckets. Notification can be set on the specific objects in S3 using filter.
 * On event trigger, notification will be sent to target Aws Resource. Currently, AWS S3 Service supports notification
 * to SNS, SQS, and Lambda.
 *
 * E.g. The following notification configuration contains a queue configuration identifying an Amazon SQS queue
 * for Amazon S3 to publish events to of the s3:ObjectCreated:Put type. The events will be published whenever
 * an object that has a prefix of images/ and a jpg suffix is PUT to a bucket.
 *
 * AwsS3BucketNotificationConfig.make({
 *  targetArn: "aws:snsus-west-2:1111111111:sns-topic",
 *  events: [AwsS3EventType.OBJECT_CREATED_BY_PUT],
 *  filters: [{
 *    name: "Prefix",
 *    value: "images/"
 *  }, {
 *    name: "Suffix",
 *    value: "jpg"
 *  }]
 * })
 */
type AwsS3BucketNotificationConfig mixes FileSystemNotificationConfig {

  /**
   * Filter criteria that allows for event notification filtering based on an S3 Object's key name
   */
  filters: [AwsS3KeyFilter]

  /**
   * Target Aws resource ARN where notification is sent
   */
  targetArn: string

  /**
   * Events for which notifications to be sent
   */
  events: [string enum AwsS3EventType]
}
