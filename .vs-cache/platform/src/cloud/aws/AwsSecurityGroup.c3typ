/**
 * This type provides an interface to the AWS *Security Groups*
 * see the [AWS documentation](http://docs.aws.amazon.com/AmazonVPC/latest/UserGuide/VPC_SecurityGroups.html).
 */
@cloud(hasResourceArn=false,
       hasResourceId=true,
       hasResourceName=false,
       hasResourceGroupName=false,
       identityRoleOptions='REQUIRED',
       cloudFunc='sg')
type AwsSecurityGroup mixes AwsResource, AwsVpcMember, AwsEgressIpPermissionsMember, AwsIngressIpPermissionsMember {

  /**
   * A description for the security group.
   */
  description: string

  /**
   * The AWS account ID of the owner of the security group.
   */
  ownerId: string

  /**
   * Add IP addresses to the white list of the security group.
   */
  addWhitelistIps: member function(ips: !?[string])

  /**
   * Remove IP addresses from the white list of the security group.
   */
  removeWhitelistIps: member function(ips: !?[string])

  /**
   * return default ip permissions egress for a security group.
   */
  defaultIpPermissionsEgress: function(): [AwsIpPermission]

  /**
   * @param cidrBlocks
   *        the cidrBlocks to whitelist
   * return ip permissions ingress, which whitelist all input cidrBlocks.
   */
  whitelistIpPermissionsIngress: function(cidrBlocks: [string]): [AwsIpPermission]

  beforeDestroy: ~
}
