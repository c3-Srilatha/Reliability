/**
 * A 2048-bit RSA key pair with the specified name. Amazon EC2 stores the public key and displays the private key
 * for you to save to a file.
 */
@cloud(hasResourceArn=false,
       hasResourceId=false,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='kp')
type AwsKeyPair mixes AwsResource {

  /**
   * An unencrypted PEM encoded RSA private key.
   */
  privateKey: string

  /**
   * Fingerprint of the key.
   */
  keyFingerprint: string

  hasTags: ~
}
