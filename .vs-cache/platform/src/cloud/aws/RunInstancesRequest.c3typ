type RunInstancesRequest {

  /**
   * The block device mapping.
   */
  blockDeviceMappings: [BlockDeviceMapping]

  /**
   * Unique, case-sensitive identifier you provide to ensure the idempotency of the request.
   */
  clientToken: string

  /**
   * If you set this parameter to true, you can't terminate the instance using the Amazon EC2 console, CLI, or API; otherwise, you can.
   */
  disableApiTermination: boolean

  /**
   * Indicates whether the instance is optimized for EBS I/O.
   */
  ebsOptimized: boolean

  /**
   * The IAM instance profile.
   */
  IamInstanceProfile: IamInstanceProfileSpecification

  /**
   * The ID of the AMI, which you can get by calling DescribeImages.
   */
  imageId: string

  /**
   * The instance type.
   */
  instanceType: string

  /**
   * The name of the key pair.
   */
  keyName: string

  /**
   * The kernel id.
   */
  kernelId: string

  /**
   * The maximum number of instances to launch.
   */
  maxCount: int

  /**
   * The minimum number of instances to launch.
   */
  minCount: int

  /**
   * One or more network interfaces.
   */
  networkInterfaces: [InstanceNetworkInterfaceSpecification]

  /**
   * The placement for the instance.
   */
  placement: AwsPlacement

  /**
   * The primary IP address.
   */
  privateIpAddress: string

  /**
   * The id of the RAM disk.
   */
  ramDiskId: string

  /**
   * One or more security group IDs.
   */
  securityGroupIds: [string]

  /**
   * One or more security group names.
   */
  securityGroups: [string]

  /**
   * One or more security group names.
   */
  subnetId: string

  /**
   * The Base64-encoded MIME user data for the instances.
   */
  userData: string
}
