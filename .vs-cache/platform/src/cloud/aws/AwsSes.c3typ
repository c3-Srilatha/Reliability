@cloud(hasResourceArn=false,
       hasResourceId=false,
       hasResourceName=false,
       hasResourceGroupName=false,
       identityRoleOptions='NULL',
       cloudFunc='ses')
type AwsSes mixes AwsResource {

  /**
   * Composes an email message based on input data, and then immediately queues the message for sending.
   * @param email
   *            The email to be send, including destination and the content
   */
  sendEmail: member function(email: !Mail)
}
