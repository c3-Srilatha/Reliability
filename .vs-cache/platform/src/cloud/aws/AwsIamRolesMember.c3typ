/**
 * abstract type to represent AWS Resource which is associated with a group of iam roles.
 */
abstract type AwsIamRolesMember {

  /**
   * The arn of the iam instance profile the resource is associated with.
   */
  iamRoles: [AwsIamRole]

  /**
   * Get the iam roles for the given resource
   */
  safeIamRoles: member function(): [AwsIamRole]
}
