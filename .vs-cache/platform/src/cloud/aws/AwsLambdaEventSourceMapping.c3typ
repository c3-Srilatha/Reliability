/**
 * AwsLambdaEventSourceMapping is an association between a stream source (Amazon Kinesis stream or Amazon DynamoDB)
 * and a Lambda function. AWS Lambda invokes the specified function when records are posted to the stream.
 */
@cloud(hasResourceArn=false,
       hasResourceId=true,
       hasResourceName=false,
       hasResourceGroupName=false,
       identityRoleOptions='NULL',
       cloudFunc='lambdaMap')
type AwsLambdaEventSourceMapping mixes AwsResource {

  /**
   * The Amazon Resource Name of the Amazon Kinesis or the Amazon DynamoDB stream that is the event source.
   */
  eventSourceArn: string

  /**
   * The Lambda function to invoke when AWS Lambda detects an event on the stream
   */
  funcName: string

  /**
   * The position in the stream where AWS Lambda should start reading.
   */
  startingPosition: string enum AwsLambdaEventSourcePosition

  /**
   * The largest number of records that AWS Lambda will retrieve from your event source
   * at the time of invoking your function.
   */
  batchSize: int

  /**
   * Indicates whether AWS Lambda should begin polling the event source.
   */
  enabled: boolean

  /**
   * The state of the event source mapping.
   */
  state: string

  hasTags: ~
}
