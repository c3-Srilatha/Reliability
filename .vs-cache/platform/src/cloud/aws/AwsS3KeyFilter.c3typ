/**
 * Filter criteria that allows for event notification filtering based on an S3 Object's key name
 * For example, to filter all jpg images filter rule will be
 * {
 *   name : "Suffix"
 *   value : "jpg"
 * }
 */
type AwsS3KeyFilter {

  /**
   * name for FilterRule.
   */
  name: string enum('Prefix', 'Suffix')

  /**
   * value for this FilterRule
   */
  value: string
}
