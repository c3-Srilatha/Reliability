/**
 * The status of one instance in an instance group
 */
type AwsEmrInstance {

  /**
   * Auto-generated id of the instance
   */
  id: string

  /**
   * Auto-generated instance id of the instance
   */
  ec2InstanceId: string

  /**
   * State of the instance.
   */
  state: string enum AwsEmrInstanceState

  /**
   * Auto-generated public DNS name of the instance
   */
  publicDnsName: string

  /**
   * Auto-generated private DNS name of the instance
   */
  privateDnsName: string

  /**
   * Auto-generated public IP address of the instance
   */
  publicIpAddress: string

  /**
   * Auto-generated private IP address of the instance
   */
  privateIpAddress: string
}
