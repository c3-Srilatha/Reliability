type BoxCredentials mixes CloudCredentials {

  /**
   * Client ID of the service account used to generate the publix private key pair.
   * Equivalent to com.box.sdk.BoxConfig clientId.
   */
  accountId: ~

  /**
   * Identifier of the secret key returned when creating a service account.
   * Equivalent to com.box.sdk.BoxConfig publicKeyId.
   */
  accessKey: ~

  /**
   * Service account secret key
   * Equivalent to com.box.sdk.BoxConfig privateKey.
   * A sample is provided below:
   * "-----BEGIN PRIVATE KEY-----\nMII...\n...\n...==\n-----END PRIVATE KEY-----"
   */
  secretKey: !~

  /**
   * The ID of the enterprise that the user is a part of
   */
  enterpriseId: !string

  /**
   * The secret password for OAuth authentication
   */
  @config(secret=true)
  clientSecret: string

  /**
   * Passphrase to access the public key (Optional)
   */
  @config(secret=true)
  privateKeyPassword: string

  /**
   * The ID of the user whose account is be authorized
   */
  userId: !string

  /**
   * Access Token for your Box app.
   */
  @config(secret=true)
  accessToken: string

  /**
   * Refresh Token for your Box app.
   */
  @config(secret=true)
  refreshToken: string

  /**
   * The time in milliseconds that the token was refreshed (used for OAuth).
   */
  lastRefresh: int

  /**
   * The time in milliseconds the access token will last after being refreshed (used for OAuth).
   */
  expires: int

  /**
   * Gets access and refresh tokens from Box app using Authorization Code.
   */
  acquireTokenFromAuthorizationCode: member function(authorizationCode: !string): json

  client: private cached member function(resourceName: !string)
                                  : @java(class="c3.platform.cloud.box.BoxClient") !native
}
