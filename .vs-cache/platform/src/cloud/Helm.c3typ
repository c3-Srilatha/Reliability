/**
 * Utility to invoke helm
 */
type Helm {

  registry: property(): !HelmRegistry

  /**
   * Locally renders templates of chart
   *
   * @param release
   *         Name os instance of chart generated
   * @param namespace
   *         Which namespace to generate the chart in, resources will not be created
   * @param chartPath
   *         local location of helm chart
   * @param overlayPath
   *         local location of overlay
   * @param skipTests
   *         Skip tests when rendering the chart
   * @return Helm Chart string of all resources to create
   */
  template: function(release: !string,
                     namespace: !string,
                     chartPath: !string,
                     overlayPath: !string,
                     skipTests: boolean): string

  /**
   * Gets list of all the cloud resources that are apart of a cloud service
   *
   * @param cloudService
   *         CloudService in k8s mode to determine all the resources for
   * @param id
   *         Optional: Id/Name of the config associated with the user created config if exists
   * @return Overlay in json
   */
  cloudResources: function(cloudService: !CloudService.Impl.K8s, id: string): [CloudResource]
}
