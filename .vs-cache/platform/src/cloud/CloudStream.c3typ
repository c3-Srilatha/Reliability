/**
 * Base type for cloud stream resources (AzureEventHub, AwsKinesis etc.), providing fields and interfaces
 */
abstract type CloudStream<M: CloudStreamMessage> mixes CloudMessageBroker<M, CloudStreamReceiveMessagesSpec> {

  /**
   * @return The number of partitions this cloud stream has
   */
  numPartitions: abstract member function(): !int

  /**
   * @return The identifiers of all the partitions in this cloud stream
   */
  partitions: abstract member function(): [string]

  /**
   * Peek an array of CloudMessage from the cloud stream
   * If sequence number is provided, this method is the same as {@link CloudMessageBroker#receiveMessages}
   * Otherwise, it returns messages within window [lastSequenceNumber-bathSize+1, lastSequenceNumber] (inclusive on both end)
   */
  peekMessages: abstract member function(spec: CloudStreamReceiveMessagesSpec): [M]

  processor: ~
}
