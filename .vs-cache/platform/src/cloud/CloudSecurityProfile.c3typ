/**
 * This is an abstract config type providing the mapping between the cloud identity and the k8s service account for enabling workload identity
 * This config controls the k8s serviceAccount tied to the apps based on the
 * cloudCluster hierarchy the config is present.
 */
@config(minOverride=APP, maxOverride=CLUSTER)
@action(group+='cluster-admin')
type CloudSecurityProfile mixes DefaultInstance, Config, Named {

  /**
   * inst() will return the instance for name `default`
   */
  inst: ~

  /**
   * Name of Service Account that backs the entity (Apps, Envs) for RBAC
   * Has to be pre-created
   */
  k8sServiceAccount: string

  /**
   * Provider type for this security profile. Used by {@link #inst} to determine which
   * CloudSecurityProfile subtype (Aws, Azure, Gcp, or OnPrem) to return.
   *
   * If set to a specific provider type (AWS, AZURE, GCP, or ONPREM), {@link #inst} will return
   * the corresponding subtype profile. If not specified, {@link #inst} will infer the provider type
   * from the Kubernetes cluster type (GKE, AKS, EKS).
   */
  providerType: string enum ProviderType

  forName:  ~
  validate: ~

  /**
   * Sets the provider type for the cluster by creating a Base CloudSecurityProfile config at CLUSTER level.
   *
   * @param providerType
   *        The provider type to set (AWS, AZURE, GCP, or ONPREM)
   */
  @action(group+='cluster-admin')
  setProviderTypeForCluster: final function(providerType: !string enum ProviderType): !CloudSecurityProfile

  /**
   * Clears the CloudSecurityProfile config at CLUSTER level.
   * Used to revert to default configuration.
   */
  @action(group+='cluster-admin')
  clearClusterConfig: function()

  /**
   * Creates the config at app level for the given appId. No changes to infrastructure are made.
   * @param appId
   *        {@link AppId#appId} of the app for which the security profile has to be set
   * @return the securityProfile created for the app
   */
  ensureSecurityProfileForApp: member function(appId: !string): !mixing CloudSecurityProfile

  /**
   * Creates the config at env level for the given envId. No changes to infrastructure are made.
   * @param envId
   *         {@link AppId#envId} of the env for which the security profile has to be set
   * @return the securityProfile created for the env
   */
  ensureSecurityProfileForEnv: member function(envId: !string): !mixing CloudSecurityProfile

  /**
   * Creates the config at cluster level for the clusterId. No changes to infrastructure are made.
   * @param clusterId
   *         {@link AppId#cluster} of the cluster for which the security profile has to be set
   * @return the securityProfile created for the cluster
   */
  ensureSecurityProfileForCluster: member function(clusterId: !string): !mixing CloudSecurityProfile

  /**
   * Removes the config at app level for the given appId. No changes to infrastructure is made.
   * Note: App will still have the old permissions until the infra is reconfigured
   * @param appId
   *         {@link AppId#appId} of the app for which the security profile has to be removed
   * @param confirm
   *         Confirmation from user that they understand and confirm deletion of the config
   */
  removeSecurityProfileForApp: member function(appId: !string, confirm: boolean)

  /**
   * Removes the config at the env level for the passed envId. No changes to infrastructure are made.
   * Note: Env and its apps will still have the old permissions until the infra is reconfigured
   * @param envId
   *         {@link AppId#envId} of the env for which the security profile has to be removed
   * @param confirm
   *         Confirmation from user that they understand and confirm deletion of the config
   */
  removeSecurityProfileForEnv: member function(envId: !string, confirm: boolean)

  /**
   * Remove the config at cluster level. No changes to infrastructure are made.
   * Note: Cluster, envs and apps will still have the old permissions until the infra is reconfigured
   * @param clusterId
   *         {@link AppId#cluster} of the cluster for which the security profile has to be removed
   * @param confirm
   *         Confirmation from user that they understand and confirm deletion of the config
   */
  removeSecurityProfileForCluster: member function(clusterId: !string, confirm: boolean)

  /**
   * Fetches the list of appIds whose infra needs to be updated based on a config change at the
   * {@link ConfigOverride.CLUSTER} level
   * @param clusterId
   *         {@link AppId#cluster} of the cluster for which the security profile was ensured
   *  @return list of appIds whose infra needs to be recreated
   */
  fetchAppsToBeReconfiguredForCluster: function(clusterId: !string): [string]

  /**
   * Fetches the list of appIds whose infra needs to be updated based on a config change at the
   * {@link ConfigOverride.ENVIRONMENT} level
   *
   * @param envId
   *         {@link AppId#envId} of the env for which the security profile was ensured
   * @return list of appIds whose infra needs to be recreated
   */
  fetchAppsToBeReconfiguredForEnv: function(envId: !string): [string]

  /**
   * Update Apps to use their new K8s Service Accounts.
   *
   * Note: Uses {@link App#updateAllNodePools} for each given app to perform the update.
   *
   * @param appIds
   *         appIds of the apps which need to be updated
   * @param spec
   *         Specifies the {@link CloudClusterOpSpec} to be used for subsequent {@link App#updateAllNodePools} action
   * @return {@link BatchError} if any, where an error is reported on per {@link App.NodePool} basis
   */
  reconfigureApps: function(appIds: [string], spec: CloudClusterOpSpec): !BatchError

  /**
   * Get the manual steps to patch the k8s SA and cloud config
   */
  getManualSteps: abstract optional member function(): string js-server
}
