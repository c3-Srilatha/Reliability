/**
 * Abstract type for all cloud orchestration platforms (e.g. ECS, Kubernetes - EKS/AKS, EMR).
 * Used to start external cloud services (e.g. {@link Jupyter}).
 * Note: all concrete subtypes of CloudServiceOrchestrator should mix CloudResource. CloudServiceOrchestrator,
 * however, does not mix CloudResource, since that causes a confusion in inheritance of the CloudResource Config.
 */
abstract type CloudServiceOrchestrator<S: CloudServiceSession> mixes DefaultInstance<CloudServiceOrchestrator<S>> {

  /**
   * Synchronously starts a service with the given id, if it does not already exist.
   *
   * @param id
   *          c3id of the service to start. @see ExternalCloudServiceId
   * @param spec
   *          custom parameters to start this service with (e.g. resource requirements, context auth token).
   * @return instance of the service started, with session information (e.g. status, endpoint).
   */
  ensureService: abstract member function(id: !string, spec: CloudServiceStartSpec): !S

  /**
   * Synchronously stops the service with the given id, if it exists.
   *
   * @param id
   *          c3id of the service to stop. @see ExternalCloudServiceId
   * @param failIfMissing
   *          throws an error instead of returning null if no service found before attempting stop.
   * @param spec
   *          custom parameters to stop this service with (e.g. reason, max node clean up...).
   * @return instance of the service stopped, null if no such instance exists
   *          (note: instance may not exist after successful stop).
   */
  stopService: abstract member function(id: !string, failIfMissing: boolean = false, spec: CloudServiceStopSpec): S

  /**
   * Finds the service with the given spec constraints, if one exists.
   *
   * @param id
   *          c3id of the service (exact match). @see ExternalCloudServiceId
   * @param useCached
   *          whether to first check the cache for the service.
   * @param failIfMissing
   *          throws an error instead of returning null if no service found.
   * @return instance of the service, null if no such instance exists.
   */
  serviceById: abstract member function(id: !string, useCached: boolean = true, failIfMissing: boolean = false): S

  /**
   * Lists the services satisfying the provided spec.
   *
   * @param spec
   *          filter parameters for the list operation.
   * @return list of {@link CloudServiceSession} instances matching the spec.
   */
  services: abstract member function(spec: CloudListServiceSpec): !CloudListServiceResult<S>

  /**
   * Lists the services for a given type of {@link ExternalCloudService} (e.g. jupyter).
   * NOTE: this method leverages the CloudTagKey.SERVICE_NAME cloud tag to filter the services, so
   * please make sure this is set in your service's template.
   *
   * @param serviceName
   *          the type of service (e.g. jupyter), see {@link CloudResourceRoles}.
   * @param spec
   *          filter parameters for the list operation.
   * @return list of {@link CloudServiceSession} instances of provided service type that match the spec.
   */
  servicesForServiceName: member function(serviceName: !string enum CloudResourceRoles,
                                          spec: CloudListServiceSpec): CloudListServiceResult<S>

  /**
   * @param id
   *          c3id of the service (exact match). @see ExternalCloudServiceId
   * @return logs of the container(s) representing the service, organized by container name, null if none available
   */
  containerLogs: abstract member function(id: !string): map<string, string>

  /**
   * Gives the instance of CloudServiceOrchestrator given its id.
   *
   * Note: this helper method exists because this type is unable to mixin CloudResource
   * (it would cause a double mixin on Config in the concrete types e.g. AwsEcsCluster)
   *
   * @param orchestratorId
   *          the {@link CloudId} of the orchestrator
   * @return appropriate instance of CloudServiceOrchestrator to use.
   */
  forOrchestratorId: abstract function(orchestratorId: !string): !mixing CloudServiceOrchestrator

  /**
   * Gives the instance of CloudServiceOrchestrator to use for the given service type.
   *
   * @param serviceName
   *          the name of the {@link ExternalCloudService} type (e.g. jupyter for Jupyter).
   * @return appropriate instance of CloudServiceOrchestrator to use.
   *          e.g. AwsEcsCluster.forServiceName returns an instance of AwsEcsCluster with id "dev-ml-ecsc-jupyter-01"
   */
  forServiceName: abstract function(serviceName: !string): !mixing CloudServiceOrchestrator

  /**
   * Gives the instance of CloudServiceOrchestrator to use for the given service.
   *
   * @param serviceId
   *          id of the {@link ExternalCloudService}. @see ExternalCloudServiceId
   * @return the orchestrator instance
   */
  forServiceId: function(serviceId: !string): !mixing CloudServiceOrchestrator

  inst: ~

  /**
   * @return maximum memory (in MB) value satisfiable by the service in its current configuration,
   * null if indeterminate.
   */
  maxNodeMemory: private abstract member function(): int

  /**
   * @return maximum compute (in vcpu) value satisfiable by the service in its current configuration,
   * null if indeterminate.
   */
  maxNodeCompute: private abstract member function(): int

  /**
   * @param serviceId
   *          id of the {@link ExternalCloudService}. @see ExternalCloudServiceId
   * @return a map containing commonly-needed debug information
   */
  debugInfo: private abstract function(serviceId: !string): map<string, any>

  /**
   * @param serviceId
   *          id of the {@link ExternalCloudService}. @see ExternalCloudServiceId
   * @param cloudFunc
   *          func of the {@link CloudResource} to get an id for (e.g. AwsEcsTask, K8sService).
   * @return the id for the CloudResource that maps to the serviceId. @see CloudId
   */
  cloudResourceIdFromServiceId: private function(serviceId: !string, cloudFunc: !string): !string

  /**
   * @param resourceId
   *          id of the {@link CloudResource}. @see CloudId
   * @return the id for the {@link ExternalCloudService} that maps to the given CloudResource id.
   *          @see ExternalCloudServiceId
   */
  serviceIdFromCloudResourceId: private function(resourceId: !string): !string

  /**
   * @param defaultEndpoint
   *          if specified, override cluster canonical url as the default return value.
   *          e.g. Jupyter prefers the non-canonical server endpoint
   * @return the server endpoint for which services using this orchestrator should connect to
   */
  serverEndpoint: private member function(defaultEndpoint: string): !string

  /**
   * @param bindings
   *         map of binding names to their values
   * @return the given bindings map as json.
   */
  jsonFromBindingsMap: private function(bindings: !map<string, string>): json

  /**
   * Returns the metrics usage data for all containerGroups (e.g. pod in K8s) within the given ExternalCloudService
   * @param serviceId
   *          id of the {@link ExternalCloudService}. @see ExternalCloudServiceId
   * @return the metrics data for all containerGroups for the given externalCloudService.
   *          key   - containerGroup name (e.g. pod name)
   *          value - map from container name to metrics data.
   *                  key   - container name
   *                  value - metrics data
   *                          key - metric name (e.g. "cpu"/"memory")
   *                          value - metric data
   * NOTE: memory is in bytes and compute is in cpus
   */
  containerGroupMetrics: optional member function(serviceId: !string): map<string, map<string, map<string, double>>>

  /**
   * Same as {@link #containerGroupMetrics}, except returns the resource limits instead of usage.
   */
  containerGroupLimits: optional member function(serviceId: !string): map<string, map<string, map<string, double>>>
}
