@beta
private type CloudMessage mixes Identifiable {

  /**
   * User defined metadata providing information about this queue message
   */
  metadata: map<string, string>

  /**
   * Cloud queue data in bytes
   */
  data: binary

  /**
   * Convert CloudMessage to ContentValue
   * If contentType specified in cloudMessage.metadata(), it will use contentType specified in cloudMessage.metadata().
   * Otherwise it takes defaultContentType as content type.
   * Same rule is applied to contentEncoding.
   */
  toContentValue: member function(defaultContentType: string, defaultContentEncoding: string): ContentValue

  /**
   * Convert CloudMessage to ContentValue
   * If contentTypeOverride is specified in spec, it will use contentTypeOverride to convert the value.
   * If contentTypeOverride is not specified in spec, it will use contentType specified in cloudMessage.metadata().
   * or use defaultContentType in spec if contentType is also missing in cloudMessage.metadata().
   * Same rule is applied to contentEncoding.
   */
  toContentValue: member function(spec: !?ContentTypeAndEncodingOverrideSpec): ContentValue

  /**
   * Convert CloudMessage content to String
   */
  readString: member function(): string

  /**
   * Create a CloudMessage from String
   */
  createFromString: function(metadata: map<string, string>, data: !string, partition: string): !mixing CloudMessage
}
