/**
 * CloudTagCompressor type used to compress cloud tags into a shorter representation using hashes
 * and to output the required compression artifacts for subsequent decompression
 * ]
 */
type CloudTagEncoder {

  /*
   * The compression algorithm used:
   * 1. Split by '-' into components
   * 2. In the order of decreasing component lengths, hash the biggest components until the string length is under maxLength.
   * 3. For each of the hashed components, leave the unencoded values wrapped by their encoded hashes.
   * Input : "c3-c3-aaabbbcccdddeeefff-ggghhhiiijjjkkklll-mmmnnnooopppqqqrrrsss" maxLength=25 hashSize=3
   * Output:
   *  "c3-c3-dpg-ooe-hgh",         // The compressed string
   *  "dpg-aaabbbcccdddeee-dpg",   // Compression artifact
   *  "ooe-fffggghhhiiijjj-ooe",   // Compression artifact
   *  "hgh-kkklllmmmnnnooopp-hgh"  // Compression artifact
   *  "hgh-pqqq-hgh"               // Compression artifact
   *
   *  @param str
   *      String that needs to be compressed
   *  @param maxLength
   *      Maximum length of each output string
   *  @param hashSize
   *      Length of the hash used to replace components
   *  @return An array of strings, the first of which is the compressed string,
   *          and the rest are compression artifacts required for decompression.
   */
  compress: function(str: string, maxLength: int32 = 63, hashSize: int32 = 3): [string]

  /*
   * Uses the compressed string and compression artifacts to decompress and recreate the original string
   *
   * @param [str]
   *     An array of strings, consisting of the compressed string and the artifacts in the same order they were created
   * @return the original string on which compression was performed
   */
  decompress: function(strs: [string]): string

  /**
   * Encodes the given input tags, into a set of resource labels.
   *
   * @param tags
   *              The array of {@link CloudTag}s that are required to be encoded.
   * @param forDeletion
   *              Indicates whether tags need to be encoded into labels for the purpose of deletion/creation of labels
   */
  encodeTags: function(tags: !?[CloudTag], forDeletion: boolean): Map<string, string>

  /**
   * Scans provided labels, collates the encoded labels, and reconstructs the actual cloud tags
   *
   * @param labels
   *              A map of labels that contains both encoded and un-encoded labels
   * @return The array of {@link CloudTag}s that corresponds to all the labels that were provided
   */
  decodeTags: function(labels: !?map<string, string>): [CloudTag]

  /**
   * Encodes tag keys into a set of resource label keys.
   * Used for key existence/absence checks (e.g., "myTagKey" or "!myTagKey" in selectors).
   *
   * @param keys
   *              Array of tag keys to encode
   * @return Array of encoded keys ready for use in label selectors.
   *         Reserved tags (c3__*) are returned in paginated format (e.g., "c3__service-0").
   *         Since, we do not know the length of the value, we only return the encoded key for the first chunk
   *         Non-reserved tags are validated and returned as-is.
   */
  encodeTagKeys: function(keys: !?[string]): [string]
}
