/**
 * Enumeration for cloud provider types.
 *
 * This enum represents the possible provider types that can be used for cluster deployments.
 * The string values for AWS, AZURE, and GCP match the corresponding constants in {@link CloudProvider}
 * (CloudProvider.AWS = 'aws', CloudProvider.AZURE = 'azure', CloudProvider.GCP = 'gcp').
 */
enum type ProviderType {

  /**
   * Amazon Web Services.
   */
  AWS = 'aws'

  /**
   * Microsoft Azure.
   */
  AZURE = 'azure'

  /**
   * Google Cloud Platform.
   */
  GCP = 'gcp'

  /**
   * On-premises deployment.
   * Used for on-premises deployment
   */
  ONPREM = 'onprem'
}
