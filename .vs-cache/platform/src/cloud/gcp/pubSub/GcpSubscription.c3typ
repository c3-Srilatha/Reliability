/**
 * This type provides an interface to the Gcp Topic service;
 * see the [GCP documentation](https://cloud.google.com/pubsub/docs/publish-message-overview).
 */
@cloud(hasResourceArn=false,
       hasResourceId=false,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='gscp')
type GcpSubscription mixes GcpResource, CloudQueue<GcpSubscriptionMessage> {

  /**
   * To filter by name prefix, use "QueueNamePrefix" as key of CloudListResourcesSpec.attributes
   */
  listResources: ~

  /**
   * The unique Id of the topic
   */
  topicId: !string

  /**
   * The unique Id of the subscription
   */
  subscriptionId: !string

  /**
   * Unlike other cloud resources, GcpSubscription requires the resource name to follow specific structure.
   * Use this function to generate valid resource name for this subscription.
   */
  getSubscriptionName: function(subscriptionId: !string, creds: GcpCredentials): !string

  getSubscriptionName: function(subscriptionId: !string, projectId: !string): !string
}
