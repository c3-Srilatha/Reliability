/**
 * Type to hold the GCP event notification. All the commonly used fields have been extracted in this type
 */
type GcpBucketEvent mixes FileSystemEvent, CloudInboundMessage<json> {

  /**
   * Region in which the event occurred. E.g. `us-east-1`
   */
  region: string

  /**
   * The time, in ISO-8601 format, for example, 1970-01-01T00:00:00.000Z, when file system finished processing the request
   */
  eventTime: datetime

  /**
   * Event-type causing the trigger. E.g. Object_Finalized
   */
  eventName: string

  /**
   * The object on which the event happens. E.g., test1/db.txt
   */
  name: string

  /**
   * Name of the bucket. E.g. `mybucket`
   */
  bucket: !string

  /**
   * Size of the change object
   */
  size: int

  /**
   * Construct an event from GcpSubscriptionMessage
   *
   * @param message
   *        GcpSubscriptionMessage
   */
  eventFromMessage: function(message: GcpSubscriptionMessage): GcpBucketEvent

  /**
   * Construct an event from Json
   *
   * @param obj
   *        json object
   */
  eventFromJson: function(obj: json): GcpBucketEvent
}
