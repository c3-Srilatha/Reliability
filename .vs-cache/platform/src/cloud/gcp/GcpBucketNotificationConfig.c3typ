/**
 * Represents a Gcp bucket's notification configuration.
 * The notification configuration is used to control reception of notifications for specific events
 */
type GcpBucketNotificationConfig mixes FileSystemNotificationConfig {

  /**
   * Events for which notifications to be sent
   */
  events: [string enum GcpBucketEventType]

  objectNamePrefix: !string
  payloadFormat:    string
  topicName:        string
  notificationId:   string
}
