/**
 * Google Cloud Storage based C3 file system configuration.
 */
type GcsFsConfig mixes FileSystemConfigChild {

  /**
   * Number of retries due to rate limiting
   */
  maxRetries: ~ = 6

  /**
   * GCS imposes a limit of 1 update per second per file, therefore the initial sleep is 1s
   */
  initialSleepMillis: ~ = 1000

  /**
   * The exponent to multiply the prior wait time in generating the next
   */
  exponent: ~ = 2

  /**
   * The maximum rate of writes to the same object name is one update per second,  therefore
   * we set the minimum sleep time to 1 second. See https://cloud.google.com/storage/quotas.
   */
  minSleepMillis: ~ = 1000

  /**
   * Rate limiting issues with GCS file system are most common, so ensure that wait times are increasing on average
   */
  jitter: ~ = "EQUAL"
}
