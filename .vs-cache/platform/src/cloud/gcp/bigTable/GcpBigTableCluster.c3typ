@cloud(hasResourceArn=false,
       hasResourceId=false,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='gbtc')
type GcpBigTableCluster mixes GcpResource {

  /**
   * The instance if of the instance that this cluster belongs to
   */
  bigTableInstanceId: !string

  /**
   * The zone of the cluster
   */
  zone: !string

  /**
   * Number of nodes in the cluster. Must be at least 1.
   */
  numNodes: !int32

  /**
   * The storage type for the cluster. Can either be SSD (flash storage) or HDD (magnetic disk)
   */
  storageType: !string enum('SSD', 'HDD')
}
