/*
 * The cloud resource which corresponds to a big table instance. The resource name represents the big table instance id.
 * The instance is the container for your data. Instances have one or more clusters,
 * located in different zones. Each cluster has at least 1 node. Each table belongs to an instance, not to a cluster
 * or node. The instance id must be between 6 and 33 characters.
 */
@cloud(hasResourceArn=false,
       hasResourceId=false,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='gbti')
type GcpBigTableInstance mixes GcpResource {

  /*
   * A cluster represents the bigtable service in a specific location. Each cluster belongs to a single instance and
   * every cluster must be in a unique zone. When you have more than one cluster, you are using replication.
   */
  clusters: ![GcpBigTableCluster]
}
