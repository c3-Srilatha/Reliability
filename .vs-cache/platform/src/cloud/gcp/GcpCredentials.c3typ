/**
 * GCP service account credentials.
 * See https://cloud.google.com/java/docs/reference/google-auth-library/latest/com.google.auth.oauth2.ServiceAccountCredentials.
 */
type GcpCredentials mixes CloudCredentials {

  /**
   * Client ID of the service account.
   * Equivalent to google.auth.oauth2.ServiceAccountCredentials clientId.
   */
  accountId: ~

  /**
   * Client email address of the service account.
   * Equivalent to google.auth.oauth2.ServiceAccountCredentials clientEmail.
   * Ex. "gcs-service-account@<CloudCredentials.cloudIdentity>.iam.gserviceaccount.com"
   */
  accountEmail: !~

  /**
   * Identifier of the secret key returned when creating a service account.
   * Equivalent to google.auth.oauth2.ServiceAccountCredentials privateKeyId.
   */
  accessKey: ~

  /**
   * Service account secret key in PKCS8 PEM base64-encoded format.
   * Equivalent to google.auth.oauth2.ServiceAccountCredentials privateKeyPkcs8.
   * A sample is provided below:
   * "-----BEGIN PRIVATE KEY-----\nMII...\n...\n...==\n-----END PRIVATE KEY-----"
   */
  secretKey: !~

  safeAccountId: ~

  /**
   * @return region associated with this credential or current region of the c3 node if {@link #region} not set.
   *
   * e.g: `us-west1`
   */
  safeRegion: member function(): string

  /**
   * Returns the id of the GCP project corresponding to these credentials.
   */
  projectId: cached member function(): !string

  /**
   * Cached gcp client for this instance of GcpCredentials - this is important since every gcp operation should cached
   * gcs client for the credentials
   */
  gcpClient: private cached property(): @java(class="c3.platform.cloud.gcp.sdk.GcpClient") !native

  /**
   * Constructs {@link GcpCredentials} from json key file.
   */
  fromKeyJsonFile: private function(file: !File): !GcpCredentials

  /**
   * Cached GCP BigTable InstanceAdmin client for this instance of GcpCredentials
   */
  gcpBigTableInstanceAdminClient: private cached property()
                                                   : @java(class="c3.platform.cloud.gcp.sdk.GcpBigTableClient") !native

  /**
   * Cached GCP topicAdmin client for this instance of GcpCredentials
   */
  gcpTopicAdminClient: private member function(): @java(class="c3.platform.cloud.gcp.sdk.GcpTopicClient") !native

  /**
   * Cached GCP subscriptionAdmin client for this instance of GcpCredentials
   */
  gcpSubscriptionClient: private member function()
                                          : @java(class="c3.platform.cloud.gcp.sdk.GcpSubscriptionClient") !native
}
