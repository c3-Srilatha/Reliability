type GcpVertexAICustomJob.MachineTypeSpec mixes Spec {

  machineType:      !string = "n1-standard-8"
  acceleratorType:  !string enum('ACCELERATOR_TYPE_UNSPECIFIED', 'NVIDIA_TESLA_K80', 'NVIDIA_TESLA_P100', 'NVIDIA_TESLA_V100', 'NVIDIA_TESLA_P4', 'NVIDIA_TESLA_T4', 'NVIDIA_TESLA_A100', 'TPU_V2', 'TPU_V3') = 'ACCELERATOR_TYPE_UNSPECIFIED'
  acceleratorCount: !int = 0
  toNative:         member function(): @java(class="com.google.cloud.aiplatform.v1.MachineSpec") !native

  fromNative: function(spec: @java(class="com.google.cloud.aiplatform.v1.MachineSpec") !native)
                : !GcpVertexAICustomJob.MachineTypeSpec
}
