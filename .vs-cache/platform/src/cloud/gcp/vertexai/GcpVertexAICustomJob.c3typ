@cloud(hasResourceArn=false,
       hasResourceId=false,
       hasResourceName=true,
       hasResourceGroupName=false,
       hasRole=true,
       hasTags=true,
       identityRoleOptions='OPTIONAL',
       seqLength=3,
       hasSubseq=false,
       cloudFunc='gcpvaicj')
type GcpVertexAICustomJob mixes GcpResource {

  forId:          ~
  jobSpec:        GcpVertexAICustomJob.Spec
  state:          string enum GcpVertexAICustomJob.Status
  createTime:     DateTime
  startTime:      DateTime
  endTime:        DateTime
  updateTime:     DateTime
  error:          GcpVertexAICustomJob.Error
  labels:         map<string, string>
  encryptionSpec: json
  webAccessUris:  map<string, string>
  cloudFunc:      ~
  upsertResource: ~
  waitForRunning: member function(spec: WaitSpec): boolean

  /**
   * https://cloud.google.com/vertex-ai/docs/reference/rest/v1/JobState
   */
  status: member function(): !string enum GcpVertexAICustomJob.Status

  cancelResource:  member function(spec: CloudResourceOperationSpec)
  waitForCancel:   member function(spec: WaitSpec): boolean
  destroyResource: ~
  waitForDestroy:  member function(spec: WaitSpec): boolean
  listResources:   ~

  /**
   * https://cloud.google.com/vertex-ai/docs/reference/rest/v1/projects.locations.customJobs
   */
  getResource: ~
}
