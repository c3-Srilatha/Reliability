type GcpVertexAICustomJob.WorkerPoolSpec mixes Spec {

  machineSpec:   !GcpVertexAICustomJob.MachineTypeSpec
  replicaCount:  !int = 1
  nfsMounts:     [GcpVertexAICustomJob.NfsMountSpec]
  diskSpec:      !GcpVertexAICustomJob.DiskSpec
  containerSpec: !GcpVertexAICustomJob.ContainerSpec
  toNative:      member function(): @java(class="com.google.cloud.aiplatform.v1.WorkerPoolSpec") !native

  fromNative: function(spec: @java(class="com.google.cloud.aiplatform.v1.WorkerPoolSpec") !native)
                : !GcpVertexAICustomJob.WorkerPoolSpec
}
