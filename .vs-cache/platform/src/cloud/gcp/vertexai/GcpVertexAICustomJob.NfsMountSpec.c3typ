type GcpVertexAICustomJob.NfsMountSpec mixes Spec {

  /**
   * Ip address of the server
   */
  server: !string

  /**
   * Path inside volume.
   *
   * e.g: `/vol1/c3-cf-vault`
   */
  path: !string

  /**
   * Name of dir inside /mnt/nfs/ where to mount this volume.
   *
   * e.g: `config`
   */
  mountPoint: !string

  toNative: member function(): @java(class="com.google.protobuf.ByteString") !native

  fromNative: function(spec: @java(class="com.google.protobuf.ByteString") !native)
                : !GcpVertexAICustomJob.NfsMountSpec
}
