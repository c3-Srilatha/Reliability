/**
 * Represents https://cloud.google.com/vertex-ai/docs/reference/rest/v1/CustomJobSpec
 */
type GcpVertexAICustomJob.Spec mixes Spec {

  workerPoolSpecs:       ![GcpVertexAICustomJob.WorkerPoolSpec]
  serviceAccount:        string
  network:               string
  reservedIpRanges:      [string]
  scheduling:            !GcpVertexAICustomJob.SchedulingSpec
  enableWebAccess:       boolean
  enableDashboardAccess: boolean
  toNative:              member function(): @java(class="com.google.cloud.aiplatform.v1.CustomJobSpec") !native

  fromNative: function(spec: @java(class="com.google.cloud.aiplatform.v1.CustomJobSpec") !native)
                : !GcpVertexAICustomJob.Spec
}
