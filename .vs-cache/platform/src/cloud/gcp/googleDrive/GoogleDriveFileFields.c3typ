/**
 * GoogleDriveFileFields represents fields that can be used for GoogleDrive content
 */
type GoogleDriveFileFields {

  /**
   * The identifier of the parent folder, if any.
   */
  parentId: string

  /**
   * The drive ID where the file is stored
   */
  driveId: string

  /**
   * The ID of the file (unique identifier)
   */
  fileId: string

  /**
    * Name of the resource of the credentials
    */
  resourceName: string

}
