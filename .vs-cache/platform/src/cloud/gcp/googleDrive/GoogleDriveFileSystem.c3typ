/**
 * GoogleDrive based FileSystem implementation to interact with GoogleDrive.
 * Avoid using it directly - use {@link FileSystem.googleDrive} instead.
 */
type GoogleDriveFileSystem mixes DriveFileSystem<GoogleDriveFile>, FileSystemConfigurable<GDriveFsConfig> {

  rootId: cached function(drive: @java(class='com.google.api.services.drive.Drive') !native): string

  /**
   * Exports a given file into a different contentType.
   *
   * @param file
   *          The file to be exported
   * @param contentType
   *          The contentType we want to export the file as
   */
  export: member function(file: !GoogleDriveFile,
                          contentType: !string,
                          contentEncoding: string,
                          spec: FileCompressSpec): !GoogleDriveFile

  cloudResourceTypeName: ~
  doOpenFile:            ~: GoogleDriveFile
  doCreateFile:          ~: GoogleDriveFile
  doCreateDir:           ~
  doTouchFilesBatch:     ~
  doTruncateFilesBatch:  ~
  capabilities:          ~
}
