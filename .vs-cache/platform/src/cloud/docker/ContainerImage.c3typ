/**
 * Image type for encapsulating an partially or fully specified image: [ [ <registry> : <port> ] <repo> : ] tag.
 */
type ContainerImage mixes WithToString {

  /**
   * ContainerRegistry
   * e.g. ContainerImage.builder().registry(ContainerRegistry.forId("c3")).build() or ContainerImage.builder().registry("c3").build() can be identified
   */
  registry: string serialized ContainerRegistry

  /**
   * Repository, e.g. 'c3server-lean'
   */
  repository: !string

  /**
   * Image Tag, e.g. '7.11.0.1234'
   */
  tag: !string

  toString: ~

  /**
   * See https://kubernetes.io/docs/concepts/containers/images/#image-names
   * If ContainerImage.registry is not specified, use the default Container Registry i.e. ContainerRegistry.forName("c3").
   * @return fully qualified image name without tags.
   */
  imageName: property(): string

  /**
   * Check if the image is available in the registry. (Contact the registry and
   * HTTP HEAD the image).
   *
   * @return true if the image is in the registry.
   *         Throws exception containing HTTP response code if the response was
   *         anything other than 200 OK (e.g. 404 NotFound, 401 Unauthorized).
   */
  checkAvailable: member function(): !boolean

  dockerImageTagToSemanticVersion: inline function(imageTag: !string,
                                                   failIfInvalid: boolean): string serialized SemanticVersion

  semanticVersionToDockerImageTag: inline function(serverVersion: !string serialized SemanticVersion,
                                                   failIfInvalid: boolean): string
}
