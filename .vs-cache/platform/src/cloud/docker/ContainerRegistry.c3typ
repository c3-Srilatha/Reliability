/**
 * Registry to store and retrieve docker images (C3 server and other C3 artifacts).
 */
// TODO: PLAT-60818 Config Framework Authorization
// TODO: PLAT-85438 ContainerRegistry type hierachy
@action(group+='cluster-admin')
type ContainerRegistry mixes Named, REST<ContainerRegistry.Config>, Registry {

  DEFAULT_NAME: const string = 'c3'
  inst:         ~
  forId:        ~

  @rest(uri="/v2", method='HEAD', skipThis=true)
  tagExist: abstract member function(@rest(partOfURI=true, uriPrefix='/')
                                     repository: !string,
                                     @rest(partOfURI=true, uriPrefix='/manifests/')
                                     imagetag: !string,
                                     @rest(header=true, headerName='Authorization')
                                     accessToken: !string): HttpResponse
}
