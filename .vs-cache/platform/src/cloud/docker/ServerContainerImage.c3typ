/**
 * Server container image to store and retrieve docker images (C3 server).
 */
// TODO: PLAT-86281: Rename ServerContainerImage to K8sServerContainerImage
type ServerContainerImage mixes ContainerImage {

  /**
   * Construct the container image given the semantic server version.
   *
   * @return container image
   */
  fromServerVersion: function(serverVersion: !string serialized SemanticVersion): !ContainerImage

  /**
   * Construct the semantic server version given the container image.
   *
   * @return semantic server version
   */
  toServerVersion: function(serverContainerImage: !ServerContainerImage): !string serialized SemanticVersion
}
