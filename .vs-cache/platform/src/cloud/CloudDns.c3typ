/**
 * Exposes helper functions to do various DNS lookup operations.
 */
abstract type CloudDns mixes CloudResource, DefaultInstance {

  /**
   * @param url
   *          url to look up
   * @return name of the name server that the url points to, if one is found, otherwise null
   */
  nameServerForUrl: private function(url: !string): string

  /**
   * @param nsName
   *          name of the name server
   * @return load balancer object that the url points to, if one is found, otherwise null
   */
  // TODO: PLAT-19636 currently only supports AWS
  loadBalancerForNameServer: private function(nsName: !string): CloudLoadBalancer

  /**
   * Retrieves an A record corresponding to the provided domain from the DNS registry.
   */
  getARecordForDomain: abstract member function(domain: !string): map<string, string>

  /**
   * Retrieves an A record corresponding to the provided IP from the DNS registry.
   */
  getARecordForIpAddr: abstract member function(ip: !string): map<string, string>

  /**
   * Registers an A record to the DNS registry.
   */
  registerARecord: abstract member function(spec: !ARecordOperationSpec)

  /**
   * Removes an A record from the DNS registry.
   */
  removeARecord: abstract member function(spec: !ARecordOperationSpec)

  /**
   * Lists A records from the DNS registry.
   */
  listARecords: abstract member function(): [map<string, string>]

  inst: function(): !mixing CloudDns
}
