/**
 * Name of the possible key field for Cloud Resource Reference.
 *
 * @see CloudRef
 */
enum type CloudRefField {

  ID = 'id'

  RESOURCE_ID = 'resourceId'

  RESOURCE_SECONDARY_ID = 'resourceSecondaryId'

  RESOURCE_NAME = 'resourceName'
}
