/**
 * Information of a specific {@link CloudService} endpoints
 *
 * @see App, CloudService
 */
type CloudServiceUrl {

  /**
   * Map of endPoint type and url
   *   Ex: dev-c3-c3-k8sjup-jupyter-001: "https://{host}/{app}/jupyter/"
   */
  urlMap: map<string serialized CloudId<<CloudService>>, string serialized Url>
}
