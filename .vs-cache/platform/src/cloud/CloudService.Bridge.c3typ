/**
 * This type is used to export the fields exposing the common attributes
 * that are shared by ALL {@link CloudService}s.
 */
type CloudService.Bridge mixes Identifiable {

  /**
   * The cloud service id.
   */
  id: !~

  /**
   * The name of the cloud service.
   */
  name: !string

  /**
   * The cloud service status, for e.g. starting, running, unavailable etc.
   */
  status: !string enum CloudService.Bridge.Status

  // The id of the cloud service parent app.
  parentAppId: !string

  /**
   * The app level of the cloud service parent app i.e. cluster, env or app.
   */
  override: string enum CloudService.ParentAppLevel

  /**
   * When the cloud service was started.
   */
  startedTime: DateTime

  /**
   * The user id for who started the cloud service.
   */
  startedBy: string

  /**
   * List all the cloud service instances for the given app (includes env/cluster app).
   *
   * @param appId
   *            The app id for which the cloud service instances are to be listed.
   */
  @cache(ttr='55m', ttl='60m')
  listForApp: private cached function(appId: !string serialized AppId): ?[CloudService.Bridge]

  /**
   * List all the errors while constructing the cloud service bridge.
   */
  errors: [string]

  /**
   * The cloud service details.
   */
  details: json

  /**
   * Fetches the cloud service details for each cloud service type.
   * This method should be implemented by each specific cloud service type.
   *
   * @param cloudServiceId
   *          The id of the cloud service for which details are to be fetched.
   * @return the cloud service details for side panels.
   */
  fetchDetails: abstract function(cloudServiceId: !string): json

  /**
   * @return the cloud service type for this bridge
   */
  cloudServiceType: abstract function(): Type

  /**
   * @return computed cached map of cloudService Type -> cloudService Bridge Type
   */
  bridgeTypeByCloudServiceType: private cached function(): map<Type, Type>
}
