type SendGrid mixes MailServiceProvider, Value {

  send:         ~ js-server
  isValidEmail: ~ js-server

  /**
   * Helper function to create a list of SendGrid-readable email identities
   */
  createSendGridIdentityList: private function(objs: [string | AccessControlEntity]): [SendGridMailIdentity] js-server

  /**
   * Helper function to create a SendGrid-readable email identities
   */
  createSendGridIdentity: private function(obj: string | AccessControlEntity): SendGridMailIdentity js-server
}
