/**
 * A message and its metadata. Each personalization object can be thought of as an envelope - it defines who should receive
 * an individual message and how that message should be handled.
 * @see https://sendgrid.com/docs/for-developers/sending-email/personalizations/
 */
type SendGridMailPersonalization {

  /**
   * The email address to perform email address validation
   */
  to: ![SendGridMailIdentity]

  /**
   * Email from
   */
  from: SendGridMailIdentity

  /**
   * Email cc
   */
  cc: [SendGridMailIdentity]

  /**
   * Email bcc
   */
  bcc: [SendGridMailIdentity]

  /**
   * Email subject
   */
  subject: string

  /**
   * A collection of JSON key/value pairs allowing you to specify specific handling instructions for your email.
   */
  headers: json

  /**
   * Substitutions allow you to insert data when not using Dynamic Transactional Templates.
   */
  substitutions: json

  /**
   * Dynamic template data is available using Handlebars syntax in Dynamic Transactional Templates
   */
  dynamic_template_data: json

  /**
   * Values that are specific to this personalization that will be carried along with the email and its activity data
   */
  custom_args: json

  /**
   * A unix timestamp allowing you to specify when you want your email to be delivered
   */
  send_at: int
}
