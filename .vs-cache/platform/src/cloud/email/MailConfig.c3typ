/**
 * Configuration The Mail type .
 */
type MailConfig mixes Config, Singleton {

  inst: ~

  /**
   * Reference to a type implementing {@link MailServiceProvider}. Optional, useful to send mail with a third party 
   * service
   */
  serviceProvider: Type

  /**
   * Mode to send mail
   */
  sendMode: string enum MailSendMode = NULL

  /**
   * maximum attachment size in Mb, by default set to 2
   */
  attachmentMaxSizeMb: int = 2

  /**
   * SMTP Host, default instance has host = 'localhost'
   */
  smtpHost: !string

  /**
   * SMTP Port, default instance has port = 25
   */
  smtpPort: !int
}
