private type K8sVolume {

  name: string

  // TODO PLAT-25603
  hostPath: K8sHostPathVolumeSource

  configMap:             K8sConfigMapVolumeSpec
  nfs:                   K8sNfsVolumeSpec
  emptyDir:              K8sEmptyDirVolumeSource
  secret:                K8sSecretVolumeSpec
  downwardAPI:           K8sDownwardApiVolumeSpec
  persistentVolumeClaim: K8sPersistentVolumeClaimVolumeSpec
  projected:             K8sProjectedVolumeSpec

  /**
   * @return whether the volume is a ephemeral volume or not.
   */
  isEphemeral: member function(): boolean

  /**
   * @return whether the volume is a pvc volume or not.
   */
  isPvc: member function(): boolean
}
