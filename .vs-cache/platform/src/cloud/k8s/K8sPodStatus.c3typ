@beta
private type K8sPodStatus mixes K8sResourceStatusBase {

  conditions:            [K8sPodCondition]
  containerStatuses:     [K8sContainerStatus]
  hostIP:                string
  initContainerStatuses: [K8sContainerStatus]
  message:               string
  nominatedNodeName:     string
  phase:                 string
  podIP:                 string
  qosClass:              string
  reason:                string
  startTime:             datetime

  /**
   * All the useful information within status will be return
   *
   * @return the status information map.
   */
  summary: member function(): map<string, any>

  /**
   * Represents the status of a user specified container for this podStatus. If the container is failing, a message will be
   * attached for why the container is in its current state.
   *
   * @param containerName
   *         Name of the container in this pod to inspect.
   * @return the current status of the container along with details elaborating on that state.
   */
  k8sContainerStatusToC3NodeState: member function(containerName: !string): Pair<string, string>

  /**
   * Finds a condition of the given type.
   *
   * @param conditionType
   *         The condition type to look up (e.g., "Ready", "DisruptionTarget").
   * @return the condition, or null if not found.
   */
  findCondition: private member function(conditionType: !string): K8sPodCondition

  /**
   * Gets the status value for a condition of the given type.
   *
   * @param type
   *         The condition type to look up.
   * @return the status value ("True", "False", "Unknown"), or null if condition not found.
   */
  conditionStatus: member function(conditionType: !string): string

  /**
   * Gets the reason for a condition of the given type.
   *
   * @param type
   *         The condition type to look up.
   * @return the reason string, or null if condition not found or has no reason.
   */
  conditionReason: member function(conditionType: !string): string

  /**
   * Checks if all containers are in the running state.
   *
   * @return true if all containers are running, false otherwise.
   */
  allContainersRunning: member function(): boolean

  /**
   * Inferred state of the pod based on status classification.
   * Uses priority-based classification where first matching condition wins.
   */
  @beta
  inferredState: property(): K8sPodInferredState

  /**
   * Finds the first container in a waiting state.
   * @return the container status, or null if no container is waiting.
   */
  findWaitingContainer: private member function(): K8sContainerStatus

  /**
   * Finds the first container in a terminated state.
   * @return the container status, or null if no container is terminated.
   */
  findTerminatedContainer: private member function(): K8sContainerStatus
}
