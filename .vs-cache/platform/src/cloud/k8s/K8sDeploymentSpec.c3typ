@beta
private type K8sDeploymentSpec mixes K8sWorkloadResourceSpecBase {

  minReadySeconds:         int = 0
  paused:                  boolean
  progressDeadlineSeconds: int = 600
  replicas:                int = 1
  revisionHistoryLimit:    int = 10
  strategy:                K8sDeploymentStrategy

  /**
   * Adds a {@link K8sVolume} to a deployment.
   * @param volume
   *         {@link K8sVolume) to add
   * @return an instance of {@link K8sDeploymentSpec}
   */
  addVolume: member function(volume: !K8sVolume): !K8sDeploymentSpec

  /**
   * Adds a {@link K8sVolumeMount} to a container of a deployment.
   *
   * @param containerName
   *         Specifies the container to add a volume mount to
   * @param volumeMount
   *         {@link K8sVolumeMount) to add
   * @return an instance of {@link K8sDeploymentSpec}
   */
  addVolumeMount: member function(containerName: !string, volumeMount: !K8sVolumeMount): !K8sDeploymentSpec

  /**
   * If strategy#type_ is not RollingUpdate, then sets strategy#rollingUpdate to null
   */
  resolveStrategy: member function(): !K8sDeploymentSpec

  /**
   * Check if the DeploymentSpec contains a specified volume.
   *
   * @param volumeName
   *       Name of the volume to check for.
   * @return true if the DeploymentSpec contains the volume, false otherwise.
   */
  containsVolume: member function(volumeName: string): boolean

  /**
   * Resolve the deploymentSpec's Linux capabilities and Seccomp annotations for a c3-server container.
   */
  resolveSecurityContextForC3ServerContainer: member function(spec: K8sDeploymentUpsertOperationSpec)
                                                       : !K8sDeploymentSpec

  /**
   * Resolve the deploymentSpec's image for containers.
   */
  resolveContainerImages: member function(spec: K8sDeploymentUpsertOperationSpec): !K8sDeploymentSpec

  /**
   * Finds and returns the container with the given name, if present within the Workload Resource Spec
   *
   * @param containerName
   *       Name of the container to find in the Workload Resource Spec
   * @return the K8sContainer object if the container is present, null otherwise.
   */
  findContainer: member function(containerName: string): K8sContainer

  /**
   * Resolve duplicate volumes among containers that is provided in {@link K8sDeploymentUpsertOperationSpec}
   *
   * @param spec
   *       {@link K8sDeploymentUpsertOperationSpec} that contains {@link K8sVolume} to be resolved.
   * @return the K8sDeploymentSpec
   */
  resolveDefaultVolumes: member function(spec: K8sDeploymentUpsertOperationSpec): !K8sDeploymentSpec

  /**
   * Validate volumes ( duplicate & null ) that is provided in {@link K8sDeploymentUpsertOperationSpec}
   *
   * @param spec
   *       {@link K8sDeploymentUpsertOperationSpec} that contains {@link K8sVolumeMount} to be resolved.
   * @return the K8sDeploymentSpec
   */
  resolveDefaultVolumeMounts: member function(spec: K8sDeploymentUpsertOperationSpec): !K8sDeploymentSpec

  /**
   * Resolve the c3-server container's readiness probe.
   *
   * @param spec
   *       {@link K8sDeploymentUpsertOperationSpec} that contains the readiness probe to be resolved.
   * @return the K8sDeploymentSpec
   */
  resolveK8sProbes: member function(spec: K8sDeploymentUpsertOperationSpec): !K8sDeploymentSpec
}
