/**
 * Rule describes an alerting or recording rule.
 * https://docs.openshift.com/container-platform/4.8/rest_api/monitoring_apis/prometheusrule-monitoring-coreos-com-v1.html
 */
private type K8sPrometheusAlertRule {

  /**
   * Alert rule name
   */
  alert: !string

  /**
   * Alert annotations
   */
  annotations: !map<string, string>

  /**
   * Prometheus query expression
   */
  expr: !string

  /**
   * Duration to wait for alert to fire
   */
  for: !string

  /**
   * Alert labels
   */
  labels: !map<string, string>
}
