/**
 * This type only defines the REST interface to the Kubernetes API Server and provides CRUD operations for
 * namespaces, services, pods and deployments. For Kubernetes API Server data model, see:
 * @see https://kubernetes.io/docs/reference/generated/kubernetes-api/v1.22/
 *
 * For Kubernetes metrics-server API calls (as methods below noted with need of 'metrics-server'), the response
 * type definitions can be found in the link:
 * https://github.com/kubernetes/metrics/blob/master/pkg/apis/metrics/types.go
 * Instruction for deploying metrics-server for Kubernetes:
 * https://github.com/kubernetes-sigs/metrics-server
 *
 * For Prometheus Operator (v0.53.1) API calls (i.e. Prometheus and ServiceMonitor related methods), the payload and response
 * definitions can be found here https://github.com/coreos/prometheus-operator/blob/v0.53.1/Documentation/api.md
 * Install Prometheus Operator with Helm: `helm install prometheus stable/prometheus-operator`
 *
 * NOTE: Stylistically, all arguments in this file should be either required or explicitly defaulted. This is for
 * consistency and because the order of arguments is defined by the external API. Therefore, it may not conform
 * to C3's standard of required arguments first and defaulted arguments after all non-defaulted arguments.
 */
@action(group='cluster-admin')
private type K8sApiServer mixes REST<K8sApiServer.Config> {

  isUrlExplicitlyConfigured: function(): boolean
  _exec:                     ~

  /**
   * Returns `true` if {@link K8sApiServer} accessible and ready to take requests.
   */
  isHealthy: function(): boolean

  @rest(uri='/', method='POST', skipThis=true)
  createK8sResourceInNamespace: abstract member function(@rest(partOfURI=true)
                                                         apiPrefix: !string,
                                                         @rest(partOfURI=true, uriPrefix='/')
                                                         apiVersion: !string,
                                                         @rest(partOfURI=true, uriPrefix='/namespaces/')
                                                         namespace: !string,
                                                         @rest(partOfURI=true, uriPrefix='/')
                                                         resourceKind: !string,
                                                         @rest(doNotUseParameterName=true)
                                                         spec: !K8sResourceModelBase,
                                                         @rest(queryParameter=true)
                                                         includeUninitialized: boolean = false,
                                                         @rest(queryParameter=true)
                                                         pretty: boolean = false): json

  @rest(uri='/', method='POST', skipThis=true)
  createK8sResource: abstract member function(@rest(partOfURI=true)
                                              apiPrefix: !string,
                                              @rest(partOfURI=true, uriPrefix='/')
                                              apiVersion: !string,
                                              @rest(partOfURI=true, uriPrefix='/')
                                              resourceKind: !string,
                                              @rest(doNotUseParameterName=true)
                                              spec: !K8sResourceModelBase,
                                              @rest(queryParameter=true)
                                              includeUninitialized: boolean = false,
                                              @rest(queryParameter=true)
                                              pretty: boolean = false): json

  @rest(uri='/', method='PUT', skipThis=true)
  replaceK8sResourceInNamespace: abstract member function(@rest(partOfURI=true)
                                                          apiPrefix: !string,
                                                          @rest(partOfURI=true, uriPrefix='/')
                                                          apiVersion: !string,
                                                          @rest(partOfURI=true, uriPrefix='/namespaces/')
                                                          namespace: !string,
                                                          @rest(partOfURI=true, uriPrefix='/')
                                                          resourceKind: !string,
                                                          @rest(partOfURI=true, uriPrefix='/')
                                                          name: !string,
                                                          @rest(doNotUseParameterName=true)
                                                          spec: !K8sResourceModelBase,
                                                          @rest(queryParameter=true)
                                                          pretty: boolean = false): json

  @rest(uri='/', method='PUT', skipThis=true)
  replaceK8sResource: abstract member function(@rest(partOfURI=true)
                                               apiPrefix: !string,
                                               @rest(partOfURI=true, uriPrefix='/')
                                               apiVersion: !string,
                                               @rest(partOfURI=true, uriPrefix='/')
                                               resourceKind: !string,
                                               @rest(partOfURI=true, uriPrefix='/')
                                               name: !string,
                                               @rest(doNotUseParameterName=true)
                                               spec: !K8sResourceModelBase,
                                               @rest(queryParameter=true)
                                               pretty: boolean = false): json

  @rest(uri='/', method='GET', skipThis=true)
  listK8sResourcesInNamespace: abstract member function(@rest(partOfURI=true)
                                                        apiPrefix: !string,
                                                        @rest(partOfURI=true, uriPrefix='/')
                                                        apiVersion: !string,
                                                        @rest(partOfURI=true, uriPrefix='/namespaces/')
                                                        namespace: !string,
                                                        @rest(partOfURI=true, uriPrefix='/')
                                                        resourceKind: !string,
                                                        @rest(queryParameter=true)
                                                        limit: int = 500,
                                                        @rest(queryParameter=true)
                                                        continue: string = '',
                                                        @rest(queryParameter=true)
                                                        labelSelector: string = '',
                                                        @rest(queryParameter=true)
                                                        timeoutSeconds: int = 10800,
                                                        @rest(queryParameter=true)
                                                        includeUninitialized: boolean = false,
                                                        @rest(queryParameter=true)
                                                        pretty: boolean = false): json

  @rest(uri='/', method='GET', skipThis=true)
  listK8sResources: abstract member function(@rest(partOfURI=true)
                                             apiPrefix: !string,
                                             @rest(partOfURI=true, uriPrefix='/')
                                             apiVersion: !string,
                                             @rest(partOfURI=true, uriPrefix='/')
                                             resourceKind: !string,
                                             @rest(queryParameter=true)
                                             limit: int = 500,
                                             @rest(queryParameter=true)
                                             continue: string = '',
                                             @rest(queryParameter=true)
                                             labelSelector: string = '',
                                             @rest(queryParameter=true)
                                             timeoutSeconds: int = 10800,
                                             @rest(queryParameter=true)
                                             includeUninitialized: boolean = false,
                                             @rest(queryParameter=true)
                                             pretty: boolean = false): json

  @rest(uri='/', method='GET', skipThis=true)
  getK8sResourceInNamespace: abstract member function(@rest(partOfURI=true)
                                                      apiPrefix: !string,
                                                      @rest(partOfURI=true, uriPrefix='/')
                                                      apiVersion: !string,
                                                      @rest(partOfURI=true, uriPrefix='/namespaces/')
                                                      namespace: !string,
                                                      @rest(partOfURI=true, uriPrefix='/')
                                                      resourceKind: !string,
                                                      @rest(partOfURI=true, uriPrefix='/')
                                                      name: !string,
                                                      @rest(queryParameter=true)
                                                      exact: boolean = false,
                                                      @rest(queryParameter=true)
                                                      export: boolean = false,
                                                      @rest(queryParameter=true)
                                                      pretty: boolean = false): json

  @rest(uri='/', method='GET', skipThis=true)
  getK8sResource: abstract member function(@rest(partOfURI=true)
                                           apiPrefix: !string,
                                           @rest(partOfURI=true, uriPrefix='/')
                                           apiVersion: !string,
                                           @rest(partOfURI=true, uriPrefix='/')
                                           resourceKind: !string,
                                           @rest(partOfURI=true, uriPrefix='/')
                                           name: !string,
                                           @rest(queryParameter=true)
                                           exact: boolean = false,
                                           @rest(queryParameter=true)
                                           export: boolean = false,
                                           @rest(queryParameter=true)
                                           pretty: boolean = false): json

  @rest(uri='/', method='DELETE', skipThis=true)
  deleteK8sResourceInNamespace: abstract member function(@rest(partOfURI=true)
                                                         apiPrefix: !string,
                                                         @rest(partOfURI=true, uriPrefix='/')
                                                         apiVersion: !string,
                                                         @rest(partOfURI=true, uriPrefix='/namespaces/')
                                                         namespace: !string,
                                                         @rest(partOfURI=true, uriPrefix='/')
                                                         resourceKind: !string,
                                                         @rest(partOfURI=true, uriPrefix='/')
                                                         name: !string,
                                                         @rest(doNotUseParameterName=true)
                                                         options: K8sDeleteOptions,
                                                         @rest(queryParameter=true)
                                                         gracePeriodSeconds: int = 30,
                                                         @rest(queryParameter=true)
                                                         pretty: boolean = false): json

  @rest(uri='/', method='DELETE', skipThis=true)
  deleteK8sResource: abstract member function(@rest(partOfURI=true)
                                              apiPrefix: !string,
                                              @rest(partOfURI=true, uriPrefix='/')
                                              apiVersion: !string,
                                              @rest(partOfURI=true, uriPrefix='/')
                                              resourceKind: !string,
                                              @rest(partOfURI=true, uriPrefix='/')
                                              name: !string,
                                              @rest(doNotUseParameterName=true)
                                              options: K8sDeleteOptions,
                                              @rest(queryParameter=true)
                                              gracePeriodSeconds: int = 30,
                                              @rest(queryParameter=true)
                                              pretty: boolean = false): json

  @rest(uri='/', method='DELETE', skipThis=true)
  deleteK8sResourceCollectionInNamespace: abstract member function(@rest(partOfURI=true)
                                                                   apiPrefix: !string,
                                                                   @rest(partOfURI=true, uriPrefix='/')
                                                                   apiVersion: !string,
                                                                   @rest(partOfURI=true, uriPrefix='/namespaces/')
                                                                   namespace: !string,
                                                                   @rest(partOfURI=true, uriPrefix='/')
                                                                   resourceKind: !string,
                                                                   @rest(doNotUseParameterName=true)
                                                                   options: K8sDeleteOptions,
                                                                   @rest(queryParameter=true)
                                                                   labelSelector: !string,
                                                                   @rest(queryParameter=true)
                                                                   fieldSelector: string = '',
                                                                   @rest(queryParameter=true)
                                                                   gracePeriodSeconds: int = 30,
                                                                   @rest(queryParameter=true)
                                                                   pretty: boolean = false): json

  @rest(uri='/', method='PATCH', contentType='application/merge-patch+json', skipThis=true)
  patchK8sResourceInNamespaceByMergePatch: abstract member function(@rest(partOfURI=true)
                                                                    apiPrefix: !string,
                                                                    @rest(partOfURI=true, uriPrefix='/')
                                                                    apiVersion: !string,
                                                                    @rest(partOfURI=true, uriPrefix='/namespaces/')
                                                                    namespace: !string,
                                                                    @rest(partOfURI=true, uriPrefix='/')
                                                                    resourceKind: !string,
                                                                    @rest(partOfURI=true, uriPrefix='/')
                                                                    name: !string,
                                                                    @rest(doNotUseParameterName=true)
                                                                    patch: !json,
                                                                    @rest(queryParameter=true)
                                                                    pretty: boolean = false): json

  @rest(uri='/', method='PATCH', contentType='application/merge-patch+json', skipThis=true)
  patchK8sResourceByMergePatch: abstract member function(@rest(partOfURI=true)
                                                         apiPrefix: !string,
                                                         @rest(partOfURI=true, uriPrefix='/')
                                                         apiVersion: !string,
                                                         @rest(partOfURI=true, uriPrefix='/')
                                                         resourceKind: !string,
                                                         @rest(partOfURI=true, uriPrefix='/')
                                                         name: !string,
                                                         @rest(doNotUseParameterName=true)
                                                         patch: !json,
                                                         @rest(queryParameter=true)
                                                         pretty: boolean = false): json

  @rest(uri='/', method='PATCH', contentType='application/json-patch+json', skipThis=true)
  patchK8sResourceInNamespaceByJsonPatch: abstract member function(@rest(partOfURI=true)
                                                                   apiPrefix: !string,
                                                                   @rest(partOfURI=true, uriPrefix='/')
                                                                   apiVersion: !string,
                                                                   @rest(partOfURI=true, uriPrefix='/namespaces/')
                                                                   namespace: !string,
                                                                   @rest(partOfURI=true, uriPrefix='/')
                                                                   resourceKind: !string,
                                                                   @rest(partOfURI=true, uriPrefix='/')
                                                                   name: !string,
                                                                   @rest(doNotUseParameterName=true)
                                                                   patch: !json,
                                                                   @rest(queryParameter=true)
                                                                   pretty: boolean = false): json

  @rest(uri='/', method='PATCH', contentType='application/json-patch+json', skipThis=true)
  patchK8sResourceByJsonPatch: abstract member function(@rest(partOfURI=true)
                                                        apiPrefix: !string,
                                                        @rest(partOfURI=true, uriPrefix='/')
                                                        apiVersion: !string,
                                                        @rest(partOfURI=true, uriPrefix='/')
                                                        resourceKind: !string,
                                                        @rest(partOfURI=true, uriPrefix='/')
                                                        name: !string,
                                                        @rest(doNotUseParameterName=true)
                                                        patch: !json,
                                                        @rest(queryParameter=true)
                                                        pretty: boolean = false): json

  /**
   * Services
   */
  @rest(uri='/api/v1', method='GET', skipThis=true)
  service: abstract member function(@rest(partOfURI=true, uriPrefix='/namespaces/')
                                    namespace: !string,
                                    @rest(partOfURI=true, uriPrefix='/services/')
                                    name: !string,
                                    @rest(queryParameter=true)
                                    exact: boolean = false,
                                    @rest(queryParameter=true)
                                    export: boolean = false,
                                    @rest(queryParameter=true)
                                    pretty: boolean = false): K8sApiServerServiceResult

  /**
   * Pods
   */

  /**
   * acceptType is set to text/plain because the response content of this call is text/plain, but the
   * handler for the request does not accept plain/text in the Accept header field. Thus, the acceptHeader wildcard
   * which influences the Accept header field to mirror what kubectl does.
   */
  @rest(uri='/api/v1', method='GET', skipThis=true, acceptType='text/plain', acceptHeader='*/*')
  logPod: abstract member function(@rest(partOfURI=true, uriPrefix='/namespaces/')
                                   namespace: !string,
                                   @rest(partOfURI=true, uriPrefix='/pods/', uriSuffix='/log')
                                   name: !string,
                                   @rest(queryParameter=true)
                                   container: string,
                                   @rest(queryParameter=true)
                                   limitBytes: int,
                                   @rest(queryParameter=true)
                                   sinceSeconds: int,
                                   @rest(queryParameter=true)
                                   tailLines: int,
                                   @rest(queryParameter=true)
                                   previous: boolean = false,
                                   @rest(queryParameter=true)
                                   timestamps: boolean = false,
                                   @rest(queryParameter=true)
                                   follow: boolean = false,
                                   @rest(queryParameter=true)
                                   pretty: boolean = false): string

  /**
   * Get CPU/memory metrics for a specific pod under given namespace. Note: needs metrics-server.
   */
  @rest(uri='/apis/metrics.k8s.io/v1beta1', method='GET', skipThis=true)
  podMetricsForPod: abstract member function(@rest(partOfURI=true, uriPrefix='/namespaces/')
                                             namespace: !string,
                                             @rest(partOfURI=true, uriPrefix='/pods/')
                                             name: !string): K8sPodMetrics

  /**
   * Returns verbose response from ready k8s health-check.
   *
   * @see https://kubernetes.io/docs/reference/using-api/health-checks/
   * @see isHealthy
   */
  @rest(uri='/readyz?verbose', method='GET', skipThis=true, acceptType='text/plain')
  ready: abstract member function(): HttpResponse

  /**
   * Get k8s detailed info.
   * example response:
   * {
   *    "major": "1",
   *    "minor": "27",
   *    "gitVersion": "v1.27.6-gke.1506000",
   *    "gitCommit": "0df9c4d6ac69ad53e985ad9526ca2dad916d6f13",
   *    "gitTreeState": "clean",
   *    "buildDate": "2023-10-04T09:38:18Z",
   *    "goVersion": "go1.20.8 X:boringcrypto",
   *    "compiler": "gc",
   *    "platform": "linux/amd64"
   * }
   */
  @rest(uri='/version', method='GET', skipThis=true)
  version: abstract member function(): json

  /**
   * Returns the major.minor kubernetes version.
   * @see version
   */
  fetchVersion: function(): string

  defaultCredentials: function(): CloudCredentials
}
