/**
 * To be mixed in by any CloudResource that has the K8sIngress resource as a dependency.
 */
abstract type K8sIngressMember {

  /**
   * The K8sIngress dependency
   */
  k8sIngress: K8sIngress

  /**
   * Get the k8s ingress associated with the resource
   */
  safeK8sIngress: member function(): K8sIngress
}
