/**
 * To be mixed in by any CloudResource that has the K8sSecret resource as a dependency.
 */
abstract type K8sSecretMember {

  /**
   * The ids of the K8sSecret dependency
   */
  k8sSecrets: ![K8sSecret]

  /**
   * Get the k8s secret associated with the resource
   */
  safeK8sSecrets: member function(): ![K8sSecret]
}
