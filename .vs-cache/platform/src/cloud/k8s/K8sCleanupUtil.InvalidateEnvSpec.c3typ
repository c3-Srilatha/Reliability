/**
 * This file contains the specification for invalidating envs in {@link K8sCleanupUtil}.
 */
type K8sCleanupUtil.InvalidateEnvSpec {

  /**
   * The number of hours after which the jarvis executors will be invalidated.
   * A Jarvis executor environment is considered as any env that
   * has an app with the jarvis executor pkg.
   */
  jarvisEnvsExpirationHours: int32 = 24
}
