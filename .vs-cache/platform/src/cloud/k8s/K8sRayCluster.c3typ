/**
 * Create and delete ray cluster as Kubernetes custom resource
 */
// TODO: PLAT-41150 - Add ApiVersion and K8sKind Enums
@cloud(cloudFunc='k8sray')
@k8s(nativeKind='raycluster',
     nativeKindPlural='rayclusters',
     apiPrefix='apis',
     crd=true,
     templateFieldTypes={
                          'spec.maxWorkers': 'int',
                          'spec.podTypes.minWorkers': 'int',
                          'spec.podTypes.maxWorkers': 'int'
                        })
private type K8sRayCluster mixes K8sResource, K8sResourceModelBase<json, json> {

  minWorkers:       int
  maxWorkers:       int
  headNodeCpu:      string
  headNodeGpu:      int
  headNodeMemory:   string
  workerNodeCpu:    string
  workerNodeGpu:    int
  workerNodeMemory: string
  apiVersion:       ~ = 'cluster.ray.io/v1'
  kind:             ~ = RAY_CLUSTER
}
