/**
 * Represents C3 Environment Membership and Discovery Service for Kubernetes.
 */
private type Env_Membership_K8s mixes Env.Membership, K8sMembershipCommon {

  canReachInternalUrl:  ~
  doDiscoverNodes:      ~
  doRestartNode:        ~
  doShutdownNode:       ~
  doFindCloudNamespace: ~
  doFetchClusterLogs:   ~
  doUpgradeApp:         ~
  doRestartApps:        ~

  /**
   * Returns the K8s Deployment representing a C3 env leader of the membership's env.
   * @return K8s Deployment if found, or null if not
   */
  leaderDeployment: member function(failIfMissing: boolean): K8sDeployment
}
