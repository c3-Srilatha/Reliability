/**
 * A very light daemon running on all nodes of the app to refresh k8s token.
 */
type K8sApiServer.RefreshTokenEngine mixes Engine.Periodic {

  /**
   * Refresh interval in seconds.
   */
  REFRESH_INTERVAL: const int = 180

  /**
   * Main execution loop
   */
  task: inline ~
}
