/**
 * BasicAuth allow an endpoint to authenticate over basic authentication More info: https://prometheus.io/docs/operating/configuration/#endpoints
 * See documentation https://coreos.com/operators/prometheus/docs/latest/api.html#basicauth
 */
@beta
private type K8sPrometheusBasicAuth {

  /**
   * The secret that contains the username for authenticate.
   */
  username: K8sSecretKeySelector

  /**
   * The secret that contains the password for authenticate.
   */
  password: K8sSecretKeySelector
}
