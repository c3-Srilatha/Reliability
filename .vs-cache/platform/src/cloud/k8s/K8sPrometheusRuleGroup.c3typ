/**
 * Content of Prometheus rule file
 */
private type K8sPrometheusRuleGroup {

  /**
   * Rule group name
   */
  name: !string

  /**
   * Rule describes an alerting or recording rule.
   */
  rules: [K8sPrometheusAlertRule]

  /**
   * Add a {@link K8sPrometheusAlertRule} in existing rule/s and resolve if duplicated
   * @param rule
   *        {@link K8sPrometheusAlertRule} to be added in {@link K8sPrometheusRuleGroup}
   */

  addRule: member function(rule: K8sPrometheusAlertRule): !K8sPrometheusRuleGroup

  /**
   * Remove a {@link K8sPrometheusAlertRule} from a rule group
   * @param rule
   *        {@link K8sPrometheusAlertRule} to be removed in {@link K8sPrometheusRuleGroup}
   */
  removeRule: member function(rule: K8sPrometheusAlertRule): !K8sPrometheusRuleGroup

}
