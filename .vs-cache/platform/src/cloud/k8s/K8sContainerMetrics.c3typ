/**
 * Type for field 'containers' in REST Api response type 'K8sPodMetrics'. This is in correspondence
 * with response type "ContainerMetrics" in
 * https://github.com/kubernetes/metrics/blob/master/pkg/apis/metrics/v1beta1/types.go
 */
@beta
private type K8sContainerMetrics {

  name:  string
  usage: map<string, string>
}
