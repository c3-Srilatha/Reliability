type K8sPriorityClassModel mixes K8sResourceModelBase<K8sPriorityClassSpec, K8sPriorityClassStatus> {

  apiVersion:       ~ = "scheduling.k8s.io/v1"
  kind:             ~ = PRIORITY_CLASS
  description:      string
  globalDefault:    boolean
  preemptionPolicy: string
  value:            int
}
