/**
 * To be mixed in by any CloudResource that has the K8sDeployment resource as a dependency.
 */
abstract type K8sDeploymentMember {

  /**
   * The K8sDeployment dependency
   */
  k8sDeployment: !K8sDeployment

  /**
   * Get the k8s deployment associated with the resource
   */
  safeK8sDeployment: member function(): !K8sDeployment
}
