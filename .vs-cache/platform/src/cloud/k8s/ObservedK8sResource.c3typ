/**
 * Meant to represent a {@link K8sResource} that was created out of a WATCH call and persisted into the DB.
 * @see K8sWatcher
 *
 * The Unique-Id for this object is meant to be: {@link K8sObjectMeta#metadata#uid} + '-' + {@link K8sObjectMeta#metadata#resourceVersion},
 * where the K8sObjectMeta belongs to the corresponding K8sResource that was being observed.
 */
abstract entity type ObservedK8sResource {

  /**
   * When was this unique K8sResource observed.
   * Is equivalent to the last added {@link K8sManagedFieldsEntry#time} in the resource's {@link K8sObjectMeta}.
   * If {@link K8sObjectMeta#managedFields} is null then this is equivalent to {@link K8sObjectMeta#creationTime}
   */
  observedAt: DateTime

  /**
   * {@link Server#serverId} of the App.Node that observed this unique K8sResource
   */
  observedBy: string

  /**
   * Operation that lead to creation of this unique K8sResource. One of: {"ADDED", "MODIFIED", "DELETED", "ERROR", "BOOKMARK"}
   */
  observedType: string

  /**
   * ResourceVersion of this unique K8sResource observed
   */
  observedResourceVersion: string
}
