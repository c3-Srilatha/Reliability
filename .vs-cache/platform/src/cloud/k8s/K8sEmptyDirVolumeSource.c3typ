/**
 * [EmptyDir](https://kubernetes.io/docs/reference/kubernetes-api/config-and-storage-resources/volume/#Local-Temporary-Directory) is a local, temporary directory that shares a pod's lifetime.
 */
private type K8sEmptyDirVolumeSource {

  /**
   * Type of storage medium to back this directory. The default is "", which means use the node's default medium.
   * Must be an empty string (default) or "Memory".
   */
  medium: string

  /**
   * Total amount of local storage required for this EmptyDir volume.
   */
  sizeLimit: string
}
