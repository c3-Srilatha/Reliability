private type K8sResourceModelBase<SP: K8sResourceSpecBase, ST: K8sResourceStatusBase> {

  apiVersion: string = 'v1'
  kind:       string enum K8sResourceModelKind
  metadata:   K8sObjectMeta
  spec:       SP
  status:     ST

  /**
   * Data contains the information data. Each key must consist of alphanumeric characters, '-', '_' or '.'.
   * The serialized form of the data is a base64 encoded string, representing the arbitrary
   * (possibly non-string) data value here. Described in https://tools.ietf.org/html/rfc4648#section-4
   */
  data: json

  /**
   * BinaryData contains the binary data. Follows same key format as data
   */
  binaryData: json

  /**
   * Holds references to the objects the role applies to
   */
  subjects: json

  /**
   * References a Role in the current namespace or a ClusterRole in the global namespace or error
   */
  roleRef: json

  /**
   * Holds all the PolicyRules for this Role
   */
  rules: json

  /**
   * Ensures that data stored cannot be updated (only metadata can be modified)
   */
  immutable: boolean
}
