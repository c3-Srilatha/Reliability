/**
 * A very light daemon running on all nodes of the app to refresh cloud token.
 */
type CloudTokenRefreshEngine mixes Engine.Periodic {

  /**
   * Refresh interval in seconds.
   * Note: GKE and Azure token default expiry is 1 hour
   * Note: AWS token is refreshed every 24 hours irrespective of token expiry (1yr now)!
   *
   * In seconds.
   */
  REFRESH_INTERVAL: const double = 180

  K8S_CLOUD_TOKEN_SECRET: private const string = 'c3cloudtoken'

  /**
   * Creates a k8s secret from c3-c3 containing the cloud token to be used by envs and apps other than c3-c3 for accessing system bucket
   */
  createSecret: private function(k8sCloudAccessToken: K8sToken)

  /**
   * Refreshes token and returns desired sleep duration.
   */
  task: ~
}
