/**
 * To be mixed in by any K8sResource that has the K8sNamespace resource as a dependency.
 */
@cloud(hasNamespace=true)
abstract type K8sNamespacedResource mixes K8sResource {

  /**
   * The id of the K8sNamespace dependency
   */
  k8sNamespace: property(): K8sNamespace

  /**
   * Returns all K8sNamespacedResource subtypes ordered by precedence.
   *
   * @param workloadResourcesOnly
   *        If true, only returns types annotated with @k8s(workloadResource=true)
   * @return Array of types ordered by precedence from K8sResource.defaultPrecedence(),
   *         followed by remaining types
   */
  orderedSubTypes: function(workloadResourcesOnly: boolean): [Type]
}
