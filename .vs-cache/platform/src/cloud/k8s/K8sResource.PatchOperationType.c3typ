/**
 * JSON patch operations supported for {@link K8sResource#patchResource}.
 */
enum type K8sResource.PatchOperationType {

  /**
   * Adds a new value to the specified path.
   * If the path does not exist, it is created.
   */
  ADD = 'add'

  /**
   * Removes the value at the specified path.
   * Returns 404 if the path does not exist.
   */
  REMOVE = 'remove'

  /**
   * Replaces the value at the specified path with a new value.
   * Equivalent to a remove followed by an add with the new value at that path.
   */
  REPLACE = 'replace'
}
