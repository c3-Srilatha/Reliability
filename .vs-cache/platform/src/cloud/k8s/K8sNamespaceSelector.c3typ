/**
 * A selector for selecting namespaces either selecting all namespaces or a list of namespaces.
 * See documentation https://coreos.com/operators/prometheus/docs/latest/api.html#namespaceselector
 */
@beta
private type K8sNamespaceSelector {

  /**
   * Whether all namespaces are selected in contrast to a list restricting them.
   */
  any: boolean

  /**
   * List of namespace names.
   */
  matchNames: [string]
}
