/**
 * Intercepts helm to generate kubernetes manifests and maintains the lifecycle of k8s resources
 */
private type CloudService.Impl.K8s<S: CloudService> mixes CloudService.Impl<S> {

  doEnsureService: ~
  doStop:          ~
  doTerminate:     ~
  isDeployed:      ~

  /**
   * Returns the K8s CR that represents the operator CR, in case the service is managed by an operator
   */
  operatorCustomResource: private member function(): K8sResource

  /**
   * Returns the K8s resource types that should be deleted when stopping cloud services.
   * Excludes:
   * - PersistentVolumeClaim as they should be preserved
   * - Cassandra CRDs as they are handled separately.
   */
  typesDeletedOnStop: function(): [Type]
}
