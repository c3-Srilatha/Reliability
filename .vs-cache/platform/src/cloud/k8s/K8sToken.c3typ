type K8sToken {

  EXPIRY_KEY: private const string = "expiry"
  TOKEN_KEY: private const string = "token"
  TOKEN_VALIDITY_KEY: private const string = "tokenValidity"
  CLOUD_KEY: private const string = "cloud"
  AWS_ACCESS_KEY_ID_KEY: private const string = "accessKeyId"
  AWS_SECRET_ACCESS_KEY: private const string = "secretAccessKey"

  /**
   * The k8s token mounted/linked to a pod
   */
  token: string

  /**
   * The expiry time of the token in milliseconds
   */
  expiry: int

  /**
   * The validity of the token in seconds
   */
  tokenValidity: int32

  /**
   * This is the private part of the key pair, used to sign requests for AWS
   */
  secretAccessKey: string

  /**
   * This is the public identifier for the temporary security credentials for AWS
   */
  accessKeyId: string

  /**
   * The cloud for which this k8s token belongs to
   */
  cloud: string
}
