@beta
private type K8sProbe {

  exec:                K8sExecAction
  failureThreshold:    int = 3
  httpGet:             K8sHttpGetAction
  initialDelaySeconds: int
  periodSeconds:       int = 10
  successThreshold:    int = 1
  tcpSocket:           K8sTcpSocketAction
  timeoutSeconds:      int = 1
}
