/**
 * Abstract type for implementing a synchronized watch/list for Kubernetes resources of type `R`.
 * Provides mechanisms for filtering, indexing and querying the synced list
 * The concrete classse must implement
 */
abstract private type K8sResourceWatch<R: K8sResource> mixes Singleton {

  /**
   * Returns the native indexer instance which maintains the synchronized list of Resources
   *
   * @returns Native io.kubernetes.client.informer.cache.Indexer object
   */
  indexer: private cached abstract property(): native

  /**
   * This function should return the set of label keys that are pre-indexed for fast lookup while querying.
   *
   * @returns Set of label keys indexed by the indexer.
   */
  indexerPreIndexedLabelKeys: private cached abstract member function(): set<string>

  /**
   * Returns the base label selector string used to filter resources in Kubernetes.
   * This selector is applied to the initial watch/list and queries.
   *
   * @returns Label selector string for resource filtering.
   */
  baseLabelSelector: private cached abstract member function(): string

  /**
   * Returns the {@link K8sResource} subtype that the Kubernetes objects should be casted into.
   *
   * @returns Type object representing the resource type.
   */
  cloudResourceType: private cached abstract member function(): Type

  /**
   * Queries the in-memory watch/list by the provided label map.
   * Returns an array of resources of type `R` that match the given labels.
   *
   * @param labels - Map of label key-value pairs to filter resources.
   */
  queryByLabels: member function(labels: map<string, string>): [R]
}
