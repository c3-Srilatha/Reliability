@beta
private type K8sContainerStatus {

  containerID:  string
  image:        string
  imageID:      string
  lastState:    K8sContainerState
  name:         string
  ready:        boolean
  restartCount: int
  state:        K8sContainerState

  /**
   * @return true if this container is in the running state.
   */
  isRunning: member function(): boolean

  /**
   * @return true if this container is in the waiting state.
   */
  isWaiting: member function(): boolean

  /**
   * @return true if this container is in the terminated state.
   */
  isTerminated: member function(): boolean

  /**
   * @return the reason for the waiting state, or null if not waiting.
   */
  waitingReason: member function(): string

  /**
   * @return the reason for the terminated state, or null if not terminated.
   */
  terminatedReason: member function(): string

  /**
   * @return the message for the terminated state, or null if not terminated.
   */
  terminatedMessage: member function(): string

  /**
   * @return the message for the waiting state, or null if not waiting.
   */
  waitingMessage: member function(): string

  /**
   * @return the exit code for the terminated state, or null if not terminated.
   */
  terminatedExitCode: member function(): int
}
