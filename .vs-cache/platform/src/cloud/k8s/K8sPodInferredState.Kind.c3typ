/**
 * High-level classification of Kubernetes pod status.
 * Each kind can have multiple specific reasons (see K8sPodInferredState.Reason).
 */
@beta
enum type K8sPodInferredState.Kind {

  // Pod in Pending phase
  PENDING

  // Pod is starting up (creating containers, mounting volumes, configuring network)
  STARTING

  // Pod is actively pulling container image
  PULLING_IMAGE

  // Pod has image-related issues
  IMAGE_ERROR

  // Pod is in Running phase, but can have unready reasons
  RUNNING

  // Pod has errors (crashes, OOM, container failures)
  ERROR

  // Pod is being terminated/disrupted
  TERMINATING

  // Pod was evicted (final state)
  EVICTED

  // Pod completed successfully
  COMPLETED

  // Cannot determine pod state
  UNKNOWN
}
