/**
 * K8sServiceMonitorSpec contains specification parameters for a k8s ServiceMonitor object.
 * See documentation https://coreos.com/operators/prometheus/docs/latest/api.html#servicemonitorspec
 */
@beta
private type K8sServiceMonitorSpec mixes K8sResourceSpecBase {

  /**
   * The label to use to retrieve the job name from.
   */
  jobLabel: string

  /**
   * A list of endpoints allowed as part of this ServiceMonitor.
   */
  endpoints: ![K8sEndpoint]

  /**
   * Selector to select Endpoints objects.
   */
  selector: !K8sLabelSelector

  /**
   * Selector to select which namespaces the Endpoints objects are discovered from.
   */
  namespaceSelector: K8sNamespaceSelector

  /**
   * Defines the labels which are transferred from the associated Kubernetes `Service` object onto the ingested metrics
   */
  targetLabels: [string]
}
