/**
 * A K8s cluster. Uses default static configuration information to connect to the K8s API server. In other
 * words, use this in cases where c3server does not create the cluster.
 */
@cloud(cloudFunc='k8scc', hasResourceName=false, identityRoleOptions=OPTIONAL)
type K8sCustomCluster mixes K8sResource, K8s {

  serverEndpoint:            ~
  serviceEndpointForService: ~
  forOrchestratorId:         ~
  forServiceName:            ~
  upsertResource:            ~
  getResource:               ~
  destroyResource:           ~
  listResources:             ~
}
