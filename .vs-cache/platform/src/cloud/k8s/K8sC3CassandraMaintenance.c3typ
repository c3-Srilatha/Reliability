@cloud(cloudFunc='k8sc3cassmaint')
@k8s(nativeKind='c3cassandramaintenance', nativeKindPlural='c3cassandramaintenances', apiPrefix='apis', crd=true)
private type K8sC3CassandraMaintenance mixes K8sNamespacedResource, K8sResourceModelBase<json, json> {

  apiVersion: ~ = 'ops.c3.ai/v1'
  kind:       ~ = C3_CASSANDRA_MAINTENANCE

  /**
   * Retrieves the compaction specification from the 'c3cassandramaintenance' custom resource.
   *
   * @returns {CassandraDB.CompactionSpec} The compaction specification.
   */
  compactionSpec: member function(): CassandraDB.CompactionSpec

  /**
   * Retrieves the repair specification from the 'c3cassandramaintenance' custom resource.
   *
   * @returns {CassandraDB.RepairSpec} The repair specification.
   */
  repairSpec: member function(): CassandraDB.RepairSpec

  /**
   * To convert c3typ {CassandraDB.RepairSpec} spec to 'c3cassandramaintenance' custom resource spec.
   * @returns custom resource spec json.
   */
  toCRSpec: function(releaseName: string, spec: CassandraDB.RepairSpec): json

  /**
   * To convert c3typ {CassandraDB.CompactionSpec} spec to 'c3cassandramaintenance' custom resource spec.
   * @returns custom resource spec json.
   */
  toCRSpec: function(releaseName: string, spec: CassandraDB.CompactionSpec): json

  /**
   * Retrieves the maintenance job status from the 'c3cassandramaintenance' custom resource.
   *
   * @returns {CassandraDB.MaintenanceJobStatus} The maintenance job status.
   */
  maintenanceJobStatus: member function(): CassandraDB.MaintenanceJobStatus
}
