// See https://v1-15.docs.kubernetes.io/docs/reference/generated/kubernetes-api/v1.15/#event-v1beta1-events-k8s-io
@beta
private type K8sEventModel mixes K8sResourceModelBase<K8sEventSpec, K8sEventStatus> {

  apiVersion: ~ = "events.k8s.io/v1beta1"
  kind:       ~ = EVENT

  /**
   * What action was taken/failed regarding to the regarding object.
   */
  action: string

  /**
   * Optional. A human-readable description of the status of this operation.
   */
  note: string

  /**
   * Why the action was taken.
   */
  reason: string

  /**
   * Name of the controller that emitted this Event, e.g. `kubernetes.io/kubelet`.
   */
  reportingController: string

  /**
   * ID of the controller instance, e.g. `kubelet-xyzf`.
   */
  reportingInstance: string

  /**
   * The object this Event is about. In most cases it's an Object reporting controller implements.
   */
  regarding: json

  /**
   * Type of this event (Normal or Warning).
   */
  @ser(name='type')
  type_: string
}
