@beta
private type K8sWorkloadResourceSpecBase mixes K8sResourceSpecBase {

  selector: K8sLabelSelector
  template: K8sPodTemplateSpec

  /**
   * Validates the volumes present on the pod spec.
   * @return an {@link BatchError} if there are any validation errors, null otherwise.
   */
  validateVolumes: member function(): !BatchError

  /**
   * Validates the volume mounts present on the containers against the volumes on the pod.
   * @return an {@link BatchError} if there are any validation errors, null otherwise.
   */
  validateVolumeMounts: member function(): !BatchError
}
