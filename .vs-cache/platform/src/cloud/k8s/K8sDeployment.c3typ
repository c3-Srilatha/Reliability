@cloud(cloudFunc='k8sdeploy', hasRole=true)
@k8s(nativeKind='deployment', nativeKindPlural='deployments', apiPrefix='apis', workloadResource=true)
type K8sDeployment mixes K8sDeploymentModel, K8sNamespacedResource, K8sSecretMember, CloudContainerDeployment {

  region: ~
  isOk:   ~

  /**
   * Replace the image tag of a specified container in a Deployment with another tag.
   *
   * @param containerName
   *         Name of the container in which the image will be swapped (e.g. c3-server).
   * @param imageTag
   *         Image tag to replace with (e.g. 0.6.0-SNAPSHOT).
   */
  replaceImage: member function(containerName: !string, imageTag: !string)
}
