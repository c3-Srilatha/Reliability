/**
 * Config for {@link K8sStorageMonitorEngine} that specifies the behaviour of the engine.
 */
@config(authz=ConfigAuthz.CLUSTER_ADMIN, minOverride=CLUSTER, maxOverride=CLUSTER)
private type K8sStorageMonitorEngineConfig mixes Config, Singleton {

  /**
   * Controls whether to enable the K8sStorageMonitorEngine or not.
   */
  disable: boolean

  /**
   * timeoutSecs that specifies the timeout period for each {@link Server#computeDirUsages} operation in {@link K8sStorageMonitorEngine#updateDirUsages}.
   */
  timeoutSecs: double

  /**
   * Specifies the refresh interval for the K8sStorageMonitorEngine in seconds.
   */
  refreshIntervalSecs: double
}
