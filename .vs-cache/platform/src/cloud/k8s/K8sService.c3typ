@cloud(cloudFunc='k8ssvc', hasRole=true)
@k8s(nativeKind='service', nativeKindPlural='services')
type K8sService mixes K8sServiceModel, K8sNamespacedResource, K8sDeploymentMember, K8sIngressMember {

  region: ~
  isOk:   ~

  /**
   * Specifies the ClusterIP of the service.
   * This is an internal IP address that provides a stable access point to backend {@link K8sPod}s.
   *
   * @return the ClusterIP address of the service.
   */
  clusterIP: property(): string

  /**
   * Maps the name of ports in the service to their corresponding {@link K8sServicePort}s.
   *
   * @return mapping of port names to their corresponding service ports.
   */
  ports: property(): map<string, K8sServicePort>
}
