/**
 * Specifies bindings to populate values specific to a given {@link K8sResource}.
 * Some examples are provided below:
 * * Deployment: image tags, volume mounts, JVM specifications
 * * Ingress:    ingress rules
 */
type K8sBindingsManager {

  /**
   * Applies bindings to a given {@link K8sDeployment} object.
   *
   * @param bindings
   *         Bindings that are used to map appropriate values such as image tags and volume mounts to JSON template
   * @param dep
   *         {@link K8sDeployment} object for which bindings will be applied to.
   * @param nodePool
   *         {@link App.NodePool} object to extract information from.
   */
  deploymentBindings: function(bindings: MapBuilder<string, any>, dep: K8sDeployment, nodePool: !App.NodePool)

  /**
   * @param bindings
   *         Bindings that are used to map appropriate {@link K8sIngressRule}s to JSON template
   * @param ingress
   *         {@link K8sIngress} resource to populate specific values for.
   * @param rules
   *         Array of rules the {@link K8sIngress} should have.
   */
  ingressBindings: function(bindings: MapBuilder<string, any>, ingress: K8sIngress, rules: [K8sIngressRule])

  /**
   * Name of the c3-server container in all K8sPods
   */
  C3_SERVER_CONTAINER_NAME: const string = 'c3-server'

  /**
   * Name of the c3-server-log container in all K8sPods
   */
  C3_SERVER_LOG_CONTAINER_NAME: const string = 'c3-server-log'

  /**
   * Toleration-Key to be used inside K8sContainers requesting GPUs
   */
  GPU_WORKLOAD_TOLERATION_KEY: const string = 'gpuWorkload'

  /**
   * Resource-Request-Key to be used inside K8sContainers to request Nvidia GPUs
   */
  NVIDIA_GPU_RESOURCE_REQUEST_KEY: const string = 'nvidia.com/gpu'

  /**
   * Node-Label-Key to be used by a K8sPod to select a node based on the kind of Nvidia Gpu it is running
   */
  NVIDIA_GPU_KIND_NODE_LABEL_KEY: const string = 'nvidia.com/gpu.product'

  /**
   * Toleration-Key to be used in K8sPodSpec for allowing scheduling on Azure SPOT VMs
   */
  AKS_SPOT_VM_TOLERATION_KEY: const string = 'kubernetes.azure.com/scalesetpriority'

  /**
   * Toleration-Value to be used in K8sPodSpec for allowing scheduling on Azure SPOT VMs
   */
  AKS_SPOT_VM_TOLERATION_VALUE: const string = 'spot'

  /**
   * Toleration-Key to be used in K8sPodSpec to tweak its scheduling based on {@link HardwareAvailability}
   */
  HARDWARE_AVAILABILITY_TOLERATION_KEY: const string = 'c3HardwareAvailability'

  /**
   * Toleration-Value to be used by K8sPodSpec requesting {@link HardwareAvailability}=LOW
   */
  HARDWARE_AVAILABILITY_LOW_TOLERATION_VALUE: const string = 'low'

  /**
   * Toleration-Value to be used by K8sPodSpec requesting {@link HardwareAvailability}=BALANCED
   */
  HARDWARE_AVAILABILITY_BALANCED_TOLERATION_VALUE: const string = 'balanced'

  /**
   * Node-Label-Key to be used in K8sPodSpec to tweak its scheduling based on {@link HardwareAvailability}
   */
  HARDWARE_AVAILABILITY_NODE_LABEL_KEY: const string = 'c3HardwareAvailability'

  /**
   * Node-Label-Value to be used by K8sPodSpec requesting {@link HardwareAvailability}=LOW
   */
  HARDWARE_AVAILABILITY_LOW_NODE_LABEL_VALUE: const string = 'low'

  /**
   * Node-Label-Value to be used by K8sPodSpec requesting {@link HardwareAvailability}=BALANCED
   */
  HARDWARE_AVAILABILITY_BALANCED_NODE_LABEL_VALUE: const string = 'balanced'

  /**
   * Creates key for GPU resource request based on {@link GpuVendor}.
   *
   * As example for {@link GpuVendor#NVIDIA Nvidia} it would be {@link #NVIDIA_GPU_RESOURCE_REQUEST_KEY}.
   */
  generateGpuVendorResourceRequestKey: function(gpuVendor: !string enum GpuVendor): !string

  /**
   * Creates key for selecting K8s Node by {@link HardwareRequirement#gpuKind}. It based on {@link GpuVendor}.
   *
   * As example for {@link GpuVendor#NVIDIA Nvidia} it would be {@link #NVIDIA_GPU_KIND_NODE_LABEL_KEY}.
   */
  generateGpuVendorNodeLabelKey: function(gpuVendor: !string enum GpuVendor): !string
}
