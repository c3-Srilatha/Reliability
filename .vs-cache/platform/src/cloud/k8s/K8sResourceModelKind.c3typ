/**
 * All possible kinds for a K8sResourceModel.
 */
enum type K8sResourceModelKind {

  NAMESPACE = 'Namespace'

  SERVICE = 'Service'

  POD = 'Pod'

  DEPLOYMENT = 'Deployment'

  NODE = 'Node'

  INGRESS = 'Ingress'

  SECRET = 'Secret'

  PROMETHEUS = 'Prometheus'

  SERVICE_MONITOR = 'ServiceMonitor'

  EVENT = 'Event'

  DAEMON_SET = 'DaemonSet'

  CLUSTER_ROLE = 'ClusterRole'

  ROLE = 'Role'

  PERSISTENT_VOLUME = 'PersistentVolume'

  PERSISTENT_VOLUME_CLAIM = 'PersistentVolumeClaim'

  POD_DISRUPTION_BUDGET = 'PodDisruptionBudget'

  JOB = 'Job'

  C3_POSTGRES = 'C3Postgres'

  CUSTOM_RESOURCE_DEFINITION = 'CustomResourceDefinition'

  RAY_CLUSTER = 'RayCluster'

  CONFIG_MAP = 'ConfigMap'

  PRIORITY_CLASS = 'PriorityClass'

  C3_CASSANDRA = 'C3Cassandra'

  C3_CASSANDRA_MAINTENANCE = 'C3CassandraMaintenance'

  C3_PROMETHEUS = 'C3Prometheus'

  PROMETHEUS_RULE = 'PrometheusRule'

  ROLE_BINDING = 'RoleBinding'

  CLUSTER_ROLE_BINDING = 'ClusterRoleBinding'

  STATEFUL_SET = 'StatefulSet'

  NETWORK_POLICY = 'NetworkPolicy'

  REPLICA_SET = 'ReplicaSet'

  HORIZONTAL_POD_AUTOSCALER = 'HorizontalPodAutoscaler'

  TOKEN_REVIEW = 'TokenReview'
}
