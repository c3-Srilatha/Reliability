@beta
private type K8sTokenReviewStatus mixes K8sResourceStatusBase {

  /**
   *  List of the identifiers that the resource server presented with the token identifies as
   */
  audiences: [string]

  /**
   *  Indicates whether the token was authenticated to the API server
   */
  authenticated: boolean

  /**
   *  Error associated with the token review
   */
  error: string

  /**
   *  The user info associated with the token
   */
  user: K8sUserInfo
}
