@cloud(cloudFunc='k8sc3prom')
@k8s(nativeKind='c3prometheus', nativeKindPlural='c3prometheuses', apiPrefix='apis', crd=true)
private type K8sC3Prometheus mixes K8sNamespacedResource, K8sResourceModelBase<json, json> {

  apiVersion: ~ = 'ops.c3.ai/v1'
  kind:       ~ = C3_PROMETHEUS
  isOk:       ~

  /**
   * Set URL to forward alerts from prometheus alertmanager.
   *
   * @param url
   *        URL to forward alerts to.
   */
  setAlertManagerForwarderUrl: member function(url: !string serialized Url): !K8sC3Prometheus
}
