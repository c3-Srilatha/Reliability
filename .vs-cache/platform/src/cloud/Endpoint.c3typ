/**
 * Endpoints are a means to establish network connections to a service.
 */
type Endpoint mixes StringSerializable {

  /**
   * The IP address or hostname of this endpoint.
   */
  address: string

  /**
   * The port of this endpoint.
   */
  port: int32
}
