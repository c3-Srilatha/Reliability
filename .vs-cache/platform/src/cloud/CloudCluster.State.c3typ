/**
 * Represents state of a CloudCluster.
 *
 * @see CloudCluster
 */
enum type CloudCluster.State {

  /**
   * Cluster is initializing
   */
  INITIALIZING

  /**
   * Cluster is starting
   */
  STARTING

  /**
   * Cluster has been started
   */
  STARTED

  /**
   * Cluster is running
   */
  RUNNING

  /**
   * Cluster is not responding
   */
  UNREACHABLE

  /**
   * Cluster is upgrading
   */
  UPGRADING

  /**
   * Cluster is stopping
   */
  STOPPING

  /**
   * Cluster is stopped
   */
  STOPPED

  /**
   * Cluster is terminating
   */
  TERMINATING

  /**
   * Cluster is being force terminating
   */
  FORCE_TERMINATING

  /**
   * Cluster has force terminated
   */
  FORCE_TERMINATED

  /**
   * Cluster is hibernating
   */
  HIBERNATING

  /**
   * Cluster has terminated
   */
  TERMINATED

  /**
   * Cluster is gone
   */
  GONE

  /**
   * Cluster does not match known config
   */
  INVALID

  /**
   * Cluster entered into an error state
   */
  ERROR
}
