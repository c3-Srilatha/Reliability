/**
 * Internal type to store pool of cloud credentials. This is useful to cache stuff on CloudCredentials objects
 */
@cache(maxSize=100)
private type CloudCredentials.Pool mixes Cached {

  /**
   * Cached copy of the cloud credentials
   */
  credentials: CloudCredentials

  /**
   * Get existing pooled credentials or set this CloudCredentials in the pool
   */
  getOrSet: private function(creds: !CloudCredentials): !CloudCredentials
}
