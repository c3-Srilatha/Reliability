type CloudReceiveMessagesSpec mixes Spec {

  /**
   * Number of messages to receive in each receiveMessages call
   * For AwsSqs, ensure this number is less than or equal to 10
   */
  batchSize: int

  /**
   * Time in milliseconds receiver waits for the next event before receiver stops listening.
   */
  timeoutMillis: int

  /**
   * Returns default or configured spec for given broker. Configuration is done with {@link CloudInboundMessage}
   * {@link CloudMessageSourceCollection}.
   */
  forBroker: function(broker: !CloudMessageBroker, cloudConsumer: string): mixing CloudReceiveMessagesSpec
}
