/**
 * Represents Compute Instance or Virtual Machine that is capable of hosting Operating System.
 */
@cloud(cloudFunc='app')
abstract type CloudComputeInstance mixes CloudResource, CloudInstance {

  /**
   * Optionally specifies the desired fully qualified domain name which should be registered for this instance in DNS.
   */
  dnsHostname: string serialized Url

  /**
   * @return `true` if provided instance type is valid for one of the Cloud Providers.
   */
  isValidInstanceType: function(instanceType: !?string): boolean
}
