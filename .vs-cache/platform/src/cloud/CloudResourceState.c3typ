/**
 * Enum for all possible states of Cloud Resources
 */
enum type CloudResourceState {

  /**
   * The Cloud Resource is pending in creation
   */
  PENDING_CREATE = 'pending'

  /**
   * The Cloud Resource is available for usage.
   */
  AVAILABLE = 'available'

  /**
   * The Cloud Resource is pending in update.
   */
  PENDING_UPDATE = 'updating'

  /**
   * The Cloud Resource is pending in deletion
   */
  PENDING_DELETE = 'deleting'

  /**
   * The Cloud Resource is not available, either due to deletion or failure in creation.
   */
  UNAVAILABLE = 'unavailable'
}
