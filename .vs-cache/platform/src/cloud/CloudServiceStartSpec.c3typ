/**
 * Request type for CloudServiceOrchestrator#ensureService API.
 */
type CloudServiceStartSpec mixes CloudServiceSpec {

  /**
   * Bindings used to configure the CloudResource templates used by the service orchestrator.
   * Key: template key
   * Value: binding value
   * Example: Jupyter passes a userAuthToken binding
   */
  configTemplateBindings: map<string, string>

  /**
   * Name of the {@link ResourceProfile} to use. Contains configurations such as memory and cpu usage.
   */
  resourceProfile: string

  /**
   * Decision to wait for service to be fully operational.
   */
  waitForReady: boolean

  /**
   * Service timeout in minutes.
   */
  idleTimeoutMinutes: int

  /**
   * Set to true to use the managed service
   */
  notManaged: boolean
}
