/**
 * Describes a CloudCluster.NodePool's allocatable resources and unique hardware.
 * @see CloudCluster.NodePool, ComputeResourceFields, ComputeResourceFields
 */
@action(group+='cluster-admin')
@config(maxOverride=CLUSTER, minOverride=CLUSTER, doNotDefaultIfMissing=true)
abstract type CloudCluster.NodePool.Config mixes Named, Config {

  forName: ~

  /**
   * Captures OEM compute details
   */
  compute: !ComputeResourceFields

  /**
   * Captures OEM hardware details
   */
  hardware: !HardwareResourceFields

  /**
   * Returns allocatable hardware. Recommended to use with ths.satisfiesConstraint()
   */
  // TODO PLAT-106025 move to CloudCluster.NodePool
  // Using `private` to ensure this API not used widely before it is moved to correct place
  allocatableCompute: private member function(): !ComputeResourceFields

  /**
   * Checks if this NodePool matching specified constraints.
   *
   * @param hardwareConstraint
   *           {@link HardwareConstraint} that are requested.
   * @return true iff there exists a node pool {@link CloudCluster.NodePool} that supports the requested
   *         hardware constraints.
   */
  // TODO PLAT-106025 move to CloudCluster.NodePool
  // Using `private` to ensure this API not used widely before it moved to correct place.
  satisfiesConstraint: private member function(hardwareConstraint: HardwareConstraint): boolean
}
