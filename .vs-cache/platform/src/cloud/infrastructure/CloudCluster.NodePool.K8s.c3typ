/**
 * Represents a group of {@link K8sNode}s whose membership is {@link K8sCloud} and C3-application usage constraints
 * are specified using {@link CloudCluster.NodePool.K8s.Config}
 * @see CloudCluster.NodePool
 */
type CloudCluster.NodePool.K8s mixes CloudCluster.NodePool<K8sCloud, CloudCluster.NodePool.K8s.Config>
