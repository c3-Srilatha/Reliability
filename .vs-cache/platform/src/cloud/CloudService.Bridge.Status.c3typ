/**
 * This type is used to export the fields exposing the common attributes
 * that are shared by ALL {@link CloudService}s.
 */
enum type CloudService.Bridge.Status {

  STARTING = 'starting'

  RUNNING = 'running'

  STOPPING = 'stopping'

  STOPPED = 'stopped'

  UNKNOWN = 'unknown'

  TERMINATING = 'terminating'
}
