/**
 * All cloud resources such as {@link AwsEc2Instance}, {@link AwsRds) and {@link AzureVirtualMachine} that have valid
 * instance type should mix this base type.
 */
abstract type CloudInstance {

  /**
   * Type of the instance such as aws instance type or azure instance vmSize
   */
  instanceType: string
}
