/**
 * Base type for cloud queue resources (TibcoJsmQueue, AwsSqs etc.), providing fields and interfaces
 */
abstract type CloudQueue<M: CloudMessage> mixes CloudMessageBroker<M, CloudReceiveMessagesSpec> {

  /**
   * Destroy an array of CloudMessage from the cloud queue
   */
  destroyMessages: abstract member function(messages: [M]): map<string, Error>

  /**
   * Release the lock of an array of CloudMessage from the cloud queue
   */
  releaseMessages: abstract member function(messages: [M]): map<string, Error>

  /**
   * Peek (receive and do not lock) an array of CloudMessage from the cloud queue
   */
  peekMessages: abstract member function(spec: CloudReceiveMessagesSpec): [M]

  processor: ~
}
