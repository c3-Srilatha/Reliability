/**
 * Name value pair used to tag resources in the Cloud.
 */
type CloudTag mixes ConfigChild<CloudResource> {

  /**
   * Name of the tag; @see CloudTagKey.
   */
  key: string

  /**
   * Value for this tag.
   */
  value: string

  /**
   * Convenience constructor.
   */
  makeTag: inline function(key: !string, value: !string): !CloudTag

  /**
   * @return true of other tag matches this one.
   */
  matches: inline member function(other: CloudTag): boolean

  fromTags: inline function(tagMap: map<string, string>): [CloudTag]
  tags:     inline function(cloudTag: [CloudTag]): map<string, string>
}
