/**
 * Registry to store and retrieve helm charts (Cloud Services).
 */
@action(group+='cluster-admin')
type HelmRegistry mixes Registry {

  DEFAULT_NAME: const string = 'DEFAULT'
  inst:         ~
  forId:        ~

  /**
   * Fetches helm chart from remote repository and stores it in a specific location
   *
   * @param location
   *         Location of the helm chart in remote repository
   * @param version
   *         Version of the helm chart
   * @return Temporary file that points to helm chart.
   */
  fetchAndStoreChart: member function(location: !string, version: !string): !File
}
