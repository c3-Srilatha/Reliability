type CloudStreamReceiveMessagesSpec mixes CloudReceiveMessagesSpec {

  /**
   * The partition of the cloud stream that receiveMessages reads data from
   */
  partition: !string

  /**
   * receiveMessages reads data starting from this sequence number.
   * If this field is not specified, receiveMessages reads from start of stream.
   * Here number is represented as string to support large numbers some cloud streams use e.g {@link AwsKinesis}
   * uses sequenceNumber which is string of digits up to 128.
   */
  sequenceNumber: string

  /**
   * Name of cloud consumer used to read messages
   */
  cloudConsumer: string

  /**
   * Name of cloud consumer used to read messages. Will return default value if one does not exist.
   */
  safeCloudConsumer: member function(): !string
}
