/**
 * A type in charge of making REST call to all-env to fetch data from AwsCost.
 */
private type EnvBillableRest mixes REST {

  /**
   *  REST call to all-env to return cost Timeseries of AwsCost.
   * @param spec
   *           BillEvalOptions containing interval,start,end & filter
   */
  @rest(uri='AwsCost?action=costTs', method='POST')
  cost: abstract function(spec: EnvBillEvalOptions,
                          @rest(header=true, headerName='X-C3-Type-Aware')
                          typeAware: boolean = true): Timeseries

  /**
   *  REST call to all-env to return amortizedCost Timeseries of AwsCost.
   * @param spec
   *           BillEvalOptions containing interval,start,end & filter
   */
  @rest(uri='AwsCost?action=amortizedCostTs', method='POST')
  amortizedCost: abstract function(spec: EnvBillEvalOptions,
                                   @rest(header=true, headerName='X-C3-Type-Aware')
                                   typeAware: boolean = true): Timeseries

  /**
   *  REST call to all-env to return gbs Timeseries of AwsCost.
   * @param spec
   *           BillEvalOptions containing interval,start,end & filter
   */
  @rest(uri='AwsCost?action=gbsTs', method='POST')
  gbs: abstract function(spec: EnvBillEvalOptions,
                         @rest(header=true, headerName='X-C3-Type-Aware')
                         typeAware: boolean = true): Timeseries

  /**
   *  REST call to all-env to return hours Timeseries of AwsCost.
   * @param spec
   *           BillEvalOptions containing interval,start,end & filter
   */
  @rest(uri='AwsCost?action=hoursTs', method='POST')
  hours: abstract function(spec: EnvBillEvalOptions,
                           @rest(header=true, headerName='X-C3-Type-Aware')
                           typeAware: boolean = true): Timeseries
}
