/**
 * This type provides APIs to generate and publish label mapping to a CSV for telemetry.
 */
type TelemetryMappingExporter {

  /**
   * API to publish telemetry mapping per App to the telemetry mount {@link TelemetryMappingExport.Config} as a CSV file.
   */
  exportAppTelemetryMapping: function()

  /**
   * API to publish cluster telemetry mapping to a CSV
   * Refer to {@link TelemetryMappingExporter.Config} for complete path of the exported file
   */
  @action(group+='cluster-admin')
  exportClusterTelemetryMapping: function()

  /**
   * Schedule a {@link CronJob} to publish cluster telemetry mapping to a CSV
   * @param cronSchedule
   *         The cron schedule for the cron job defaulted to (0 0 0/1 * * ?) every 1 hour
   * @return {@link CronJob} that is created
   */
  @action(group+='cluster-admin')
  scheduleClusterTelemetryMappingCron: function(cronSchedule: CronSchedule): !CronJob

  /**
   * Cancels the {@link CronJob} to publish cluster telemetry mapping to a CSV
   */
  @action(group+='cluster-admin')
  cancelClusterTelemetryMappingCron: function()

  /**
   * API to fetch latest telemetry CSV file generated by {@link TelemetryMappingExporter#fetchLatestCombinedTelemetryFile}
   */
  fetchLatestCombinedTelemetryFile: function(destinationPath: string = ""): File
}
