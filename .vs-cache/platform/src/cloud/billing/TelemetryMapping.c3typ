/**
 * Provides a type encompassing all the attributes related to the Telemetry Mapping Export feature.
 */
type TelemetryMapping {

  /**
   * Un-encoded Cluster name
   */
  clusterName: string

  /**
   * Un-encoded Env name
   */
  envName: string

  /**
   * Un-encoded App name
   */
  appName: string

  /**
   * Whether the Env is a SNE
   */
  singlenode: boolean

  /**
   * RootPkg of the deployed app
   */
  rootPkg: string

  /**
   * The labels that are compulsorily present on all resources belonging to the App, stored as json string
   */
  appLabels: string

  /**
   * Labels (in addition to {@link TelemetryMapping#appLabels}) present on C3Server compute resources, stored as json string
   */
  c3ServerLabels: string

  /**
   * Labels (in addition to {@link TelemetryMapping#appLabels}) present on all cloud services compute resources, stored as json string
   * Where key is cloudService and value is a json string of labels
   */
  csLabels: map<string, string>
}
