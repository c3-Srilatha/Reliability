/**
 * This type provides an interface return cost dimensions from all-env
 * to the Tenant, Tag and Cluster
 */
type EnvBillable mixes Value {

  /**
   * return cost timeseries from AwsCost
   * @param spec
   *           TSEvalOptions containing interval,start & end
   */
  cost: abstract function(spec: TimeInfo): Timeseries

  /**
   * return amortizedCost timeseries from AwsCost
   * @param spec
   *           TSEvalOptions containing interval,start & end
   */
  amortizedCost: abstract function(spec: TimeInfo): Timeseries

  /**
   * return gbs timeseries from AwsCost
   * @param spec
   *           TSEvalOptions containing interval,start & end
   */
  gbs: abstract function(spec: TimeInfo): Timeseries

  /**
   * return hours timeseries from AwsCost
   * @param spec
   *           TSEvalOptions containing interval,start & end
   */
  hours: abstract function(spec: TimeInfo): Timeseries

  /**
   * return EnvBillEvalOptions from AwsCost
   * @param spec
   *           TSEvalOptions containing interval,start & end
   */
  buildEnvBillEvalSpec: private abstract function(spec: TimeInfo): EnvBillEvalOptions
}
