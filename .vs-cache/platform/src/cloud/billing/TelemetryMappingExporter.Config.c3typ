/**
 * This type provides config related to Telemetry Mapping
 */
@config(authz=ConfigAuthz.CLUSTER_ADMIN, minOverride=CLUSTER)
type TelemetryMappingExporter.Config mixes Config, Singleton {

  /**
   * Indicates the intermediate file path, where the telemetry mapping per app csv will be published,
   */
  intermediatePath: string

  /**
   * Indicates the list of paths where the combined telemetry mapping csv will be published,
   */
  destPaths: [string]

  /**
   * Flag to control the enablement of the telemetry label mapping export feature.
   */
  enabled: boolean

  /**
   * Indicates the file name to which the combined csv data is published.
   * Final file structure will be {link @TelemetryMappingExporter.Config#baseDirPath}_<Time stamp>
   */
  clusterMappingExportPrefix: string = "combinedTelemetryMapping"

  /**
   * Indicates the most recent date suffixed file name to which the combined csv data is published.
   * Final file structure will be {link @TelemetryMappingExporter.Config#baseDirPath}_<Time stamp>
   */
  latestPublishedClusterMappingFileName: string = "combinedTelemetryMapping"
}
