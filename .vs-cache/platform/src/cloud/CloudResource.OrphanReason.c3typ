/**
 * Denotes reasons for a cloud resource to be considered an Orphan resource
 */
enum type CloudResource.OrphanReason {

  UNKNOWN_RESOURCE
  INVALID_C3_CLUSTER_ID
  INVALID_C3_ENV_ID
  INVALID_C3_APP_ID
  INVALID_C3_CS_ID
  UNACCOUNTED_C3_RESOURCE
}
