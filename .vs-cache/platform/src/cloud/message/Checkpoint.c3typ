/**
 * Convenient checkpoint type for anything that needs to keep a state in DB to extend to
 */
extendable entity type Checkpoint<E> schema name 'CKPT' {

  /**
   * The checkpoint value
   */
  value: E

  /**
   * Apply the Lambda and update the checkpoint
   * @return The updated checkpoint
   */
  applyAndCheckpoint: member function(action: !lambda(checkpoint: mixing Checkpoint): mixing Checkpoint)
                               : Checkpoint<E>

  /**
   * Return the latest version of this checkpoint
   */
  safeGet: member function(): Checkpoint<E>

  /**
   * Build the ID of this checkpoint.
   */
  generateId: private abstract optional member function(): string
}
