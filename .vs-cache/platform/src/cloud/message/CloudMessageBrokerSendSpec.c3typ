/**
 * Spec to send messages to a CloudMessageBroker
 */
@beta
type CloudMessageBrokerSendSpec mixes ContentMeta {

  /**
   * size by which the cloud messages are batched before sending to a broker.
   * for eg.
   * if batchSize = 1, then for n objects sent, n CloudMessage instances will be created and sent to the broker.
   * if batchSize = n, then for n objects sent, 1 CloudMessage instance will be created and sent to the broker.
   */
  batchSize: int

  /**
   * partition identified by the key to which to send the message to.
   */
  partitionKey: string

  /**
   * Converts spec to {@link CloudMessage#metadata}
   */
  toMetadata: member function(): map<string, string>
}
