type CloudMessageProcessor<M: CloudMessage, S: CloudReceiveMessagesSpec> {

  /**
   * The underline broker that this CloudMessageProcessor uses
   */
  broker: CloudMessageBroker<M, S>

  /**
   * @param spec
   *          The spec defining the behavior of processMessages
   */
  processMessages: abstract member function(spec: S)
}
