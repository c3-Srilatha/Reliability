/**
 * This type is used to store credentials for MQTT communication. To understand the meaning of each field, please
 * check the following example
 * http://docs.aws.amazon.com/iot/latest/developerguide/verify-pub-sub.html
 */
type MqttAuth {

  /**
   * This is the Url address for Broker at the Mqtt Server side.
   */
  brokerUrl: !string

  /**
   * The clientId is chosen by the user. But it must be unique for every client connecting to the same brokerUrl
   */
  clientId: !string

  /**
   * client private key
   */
  privateKey: !string

  /**
   * client certificate pem. Check https://en.wikipedia.org/wiki/Privacy-enhanced_Electronic_Mail for more information
   */
  certificatePEM: !string
}
