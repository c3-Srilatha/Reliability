/**
 * Registry tracking all cloud messages registered to receive messages from associated {@link CloudMessageBroker}.
 */
private entity type CloudMessageRegistry mixes Cached schema name 'CMR' {

  /**
   * The broker associated with this subscription.
   */
  brokerName: !string
}
