/**
 * Type for defining outbound cloud message broker publisher
 * CloudBrokerOutboundMessage is a singleton
 */
@beta
abstract private type CloudOutboundMessage<T> mixes Configurable<CloudMessageDispatcherConfig> {

  /**
   * Send message to backing cloud message broker
   *
   * @param msg
   *           message to be send.
   * @param partition
   *           if provided and backing cloud message broker supports, message will be published in specified partition.
   */
  send: function(msg: T, partition: string)

  /**
   * Send messages to backing message broker
   *
   * @param msgs
   *           messages to be send.
   * @param partition
   *           if provided and backing cloud message broker supports, message will be published in specified partition.
   * @return map of message id to error, if any exists.
   */
  sendBatch: function(msgs: [T], partition: string): map<string, Error>

  /**
   * set cloud message broker name and it's type.
   * ```
   *  TestOutboundMessage.setBrokerName("CanonicalTestAssetTopic", "ApacheKafkaTopic")
   * ```
   */
  setBrokerName: function(brokerName: !string, brokerType: !Type)

  /**
   * set batch size to receive messages from broker.
   * ```
   *  TestOutboundMessage.setBatchSize(1000)
   * ```
   */
  setBatchSize: function(batchSize: int)
}
