entity type CloudStreamCheckpoint extends Checkpoint<string> type key 'CSCKPT' {

  /**
   * The name of the cloud stream
   */
  stream: !string

  /**
   * The cloud stream partition identifier for this checkpoint
   */
  partition: !string

  /**
   * The consumer name of the cloud stream
   */
  consumer: !string

  generateId: ~
}
