// TODO PLAT-36658
type ClusterId mixes StringSerializable {

  /**
   * C3 Environment; e.g. dev, stage, prod.
   */
  env: string

  /**
   * C3 pod name; e.g. enel, bge, c3, srv.
   */
  pod: string

  /**
   * Cloud function abbreviation; e.g. emr, vpc, app.
   *
   * @see CloudResource#cloudFunc
   * @see CloudResource#allCloudFuncs
   */
  func: string

  fromString: ~
  toString:   ~
}
