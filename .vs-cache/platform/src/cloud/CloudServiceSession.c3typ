/**
 * An instance of a {@link CloudExternalService}.
 */
abstract type CloudServiceSession<O: CloudServiceOrchestrator> mixes ExternalServiceSession {

  /**
   * Cloud id of the {@link CloudServiceOrchestrator} that is responsible for this session.
   */
  orchestratorId: string

  /**
   * NOTE: #produce and #produceAll will only return sessions that have already been started/created by the session's
   * respective {@link CloudServiceOrchestrator} and will not actually invoke the platform to create a new session.
   */
  produce: ~

  produceAll: ~

  /**
   * Returns the {@link CloudServiceOrchestrator} that this session belongs to.
   * NOTE: For now, this just returns the default instance of the specific session type's CloudServiceOrchestrator.
   */
  orchestrator: member function(): !O
}
