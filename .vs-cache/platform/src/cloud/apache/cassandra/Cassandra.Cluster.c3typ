type Cassandra.Cluster mixes DefaultInstance, CloudCluster<Cassandra.Node> {

  /**
   * Named cassandra instance for this given cluster
   */
  parent: Cassandra

  /**
   * Gets all the Cassandra keyspaces in this cluster.
   * @return [{@link Cassandra.Keyspace}]
   */
  keyspaces: member function(): ![Cassandra.Keyspace]

  /**
   * Gets the specified keyspace in this cluster.
   * @param keyspaceName
   *           Name of {@link Cassandra.Keyspace} to return
   * @param failIfMissing
   *           If true and the specified keyspace doesn't exist an error will be thrown.
   * @return {@link Cassandra.Keyspace}
   */
  keyspace: member function(keyspaceName: !string, failIfMissing: boolean): !Cassandra.Keyspace

  /**
   * Gets all the tables belonging to this cluster.
   * @return [{@link Cassandra.Table}]
   */
  tables: member function(): ![Cassandra.Table]

  /**
   * @param cqlQuery
   *           String that specifies the CQL Query to execute.
   * @param bindVars
   *          Bind parameters will be used when values are provided here. Order of arguments is the order of the
   *          columns in insert / update statements. Only valid for insert / update statements where values need
   *          to be bound
   * @param spec
   *          Spec providing specification for this query.
   * @return results if sql query is select / null otherwise / exception on error. If spec.enableTracing is set, returns
   * materialized result CassandraResultSet else return stream<CassandraRow>. If spec.async is set, returns
   * Cassandra.Table.ResultSetFuture.
   */
  @action(group+='cluster-admin')
  executeQuery: member function(cqlQuery: !string,
                                bindVars: [any],
                                spec: Cassandra.Table.QuerySpec)
                         : stream<Cassandra.Table.Row> | Cassandra.Table.ResultSet

  /**
   * Truncates (deletes) the given {@link Cassandra.Table} from the provided keyspace.
   * Calling truncate results in actual deletion of all data in the cluster
   * under the given {@link Cassandra.Table} and it will fail unless all hosts are up.
   * All data in the given table will be deleted, but its definition
   * will not be affected.
   * @param spec
   *           Cassandra.Table.TableSpec which defines the keyspaceName.tableName to filter output by.
   *           Will throw an error if both keyspace and table are not specified.
   *           @see Cassandra.Table.TableSpec
   * @return boolean to indicate success of operation
   */
  @action(group+='cluster-admin')
  truncateColumnFamily: member function(spec: !Cassandra.Table.TableSpec): boolean

  /**
   * Create a new keyspace
   * Keyspace names can have up to 48 alpha-numeric characters and contain underscores; only letters and numbers are
   * supported as the first character. Cassandra forces keyspace names to lowercase when entered without quotes.
   * By default the keyspace will be created with replication strategy class : SimpleStrategy & replication factor of 3
   * if >= 3 nodes are available otherwise 1
   */
  @action(group+='cluster-admin')
  upsertKeyspace: member function(keyspaceName: !string, replicationFactor: int)

  /**
   * Delete the given keyspace
   * @param keyspaceName
   *            Name of the keyspace to be dropped
   * @param confirm
   *            Additional safety flag to be passed to confirm the deletion
   */
  @action(group+='cluster-admin')
  deleteKeyspace: member function(keyspaceName: !string, confirm: boolean)
}
