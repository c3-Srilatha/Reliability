/**
 * Result set from {@link Cassandra.Cluster#executeQueryAsync}
 */
type Cassandra.Table.ResultSetFuture mixes Cassandra.Table.ResultSet {

  future: @java(class='java.util.concurrent.CompletionStage<com.datastax.oss.driver.api.core.cql.AsyncResultSet>') native

  /**
   * Wait for and get the cassandra rows as a result of the query. Any exceptions that occur during the execution
   * of the cql query will be surfaced when you call this method.
   */
  get: member function(): stream<Cassandra.Table.Row>
}
