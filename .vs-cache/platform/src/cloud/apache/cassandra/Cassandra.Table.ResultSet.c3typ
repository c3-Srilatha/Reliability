/**
 * Result set from {@link Cassandra.Cluster#executeQuery}
 */
type Cassandra.Table.ResultSet {

  /**
   * Cassandra rows as a result of the query
   */
  rows: [Cassandra.Table.Row]

  /**
   * Cassandra execution info
   */
  executionInfo: Cassandra.Table.ExecutionInfo
}
