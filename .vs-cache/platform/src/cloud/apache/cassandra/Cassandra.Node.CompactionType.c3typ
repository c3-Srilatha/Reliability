/**
 * Enum type that identifies compaction type.
 * @see Cassandra.Node#flush
 */
enum type Cassandra.Node.CompactionType {

  COMPACTION
  VALIDATION
  CLEANUP
  SCRUB
  UPGRADE_SSTABLES
  VERIFY
  INDEX_BUILD
  TOMBSTONE_COMPACTION
  ANTICOMPACTION
  VIEW_BUILD
  INDEX_SUMMARY
  RELOCATE
  GARBAGE_COLLECT
}
