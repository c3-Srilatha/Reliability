/**
 * Stores read repair stats of {@link Cassandra.Node}
 */
type Cassandra.Node.PoolMessages mixes Result {

  /**
   * Number of active messages by thread pool size/type
   */
  activeMessageCountByPoolSize: !map<string enum Cassandra.Node.PoolSize, int>

  /**
   * Number of pending messages by thread pool size/type
   */
  pendingMessageCountByPoolSize: !map<string enum Cassandra.Node.PoolSize, int>

  /**
   * Number of completed messages by thread pool size/type
   */
  completedMessageCountByPoolSize: !map<string enum Cassandra.Node.PoolSize, int>

  /**
   * Number of dropped messages by pool size/type
   */
  droppedMessageCountByPoolSize: !map<string enum Cassandra.Node.PoolSize, int>
}
