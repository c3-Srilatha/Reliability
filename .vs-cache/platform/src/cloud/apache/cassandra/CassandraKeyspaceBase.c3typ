// TODO: PLAT-40472 - fix Cassandra type hierarchy
type CassandraKeyspaceBase mixes DefaultInstance, Named {

  /**
   * Gets all the tables for this keyspace
   * @return [{@link Cassandra.Table}]
   */
  tables: member function(): ![Cassandra.Table]

  /**
   * Gets the specified table in this keyspace
   * @param tableName
   *           Name of {@link Cassandra.Table} to return
   * @param failIfMissing
   *           If true and the specified table doesn't exist an error will be thrown.
   * @return {@link Cassandra.Table}
   */
  table: member function(tableName: string, failIfMissing: boolean): !Cassandra.Table

  /**
   * Function to execute logic on all tables in this keyspace.
   * @param action
   *           Lambda expression used to execute logic on each {@link Cassandra.Table}
   * @param filter
   *           String expression to only process {@link Cassandra.Table} objects which evaluate to true.
   *           @see FetchFilterSpec#filter
   * @return stream<E>
   */
  eachTable: abstract member function<E>(action: !lambda(t: Cassandra.Table): E, filter: string): !stream<E>

  /**
   * Cluster that this keyspace belongs to
   */
  cluster: property(): !Cassandra.Cluster
}
