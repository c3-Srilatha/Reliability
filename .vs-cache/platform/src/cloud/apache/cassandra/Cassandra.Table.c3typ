/**
 * Base type for Cassandra stats to inherit keyspace and table fields from.
 */
type Cassandra.Table mixes StringSerializable, Named {

  /**
   * Name of {@link Cassandra.Keyspace}
   */
  keyspaceName: !string

  /**
   * @return {@link Cassandra.Keyspace} this table belongs to
   */
  keyspace: member function(): !Cassandra.Keyspace
}
