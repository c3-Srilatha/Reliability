/**
 * Spec for holding different consistency levels for each Cassandra query.
 * for more info see https://docs.datastax.com/en/ddac/doc/datastax_enterprise/dbInternals/dbIntConfigConsistency.html
 */
enum type Cassandra.Table.QuerySpec.ConsistencyLevel {

  ALL
  EACH_QUORUM
  LOCAL_QUORUM
  LOCAL_ONE
  QUORUM
  SERIAL
  LOCAL_SERIAL
  ONE
  TWO
  THREE
}
