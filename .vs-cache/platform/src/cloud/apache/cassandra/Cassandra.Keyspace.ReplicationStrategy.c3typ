/**
 * Spec holding different replication strategy for a keyspace.
 */
enum type Cassandra.Keyspace.ReplicationStrategy {

  /**
   * Used for multi datacenter cluster.
   * for more info please see
   * https://docs.datastax.com/en/cassandra-oss/3.0/cassandra/architecture/archDataDistributeReplication.html?hl=networktopologystrategy#archDataDistributeReplication__nts
   */
  NetworkTopologyStrategy

  /**
   * Used for single node/ single datacenter default cluster.
   * for more info please see
   * https://docs.datastax.com/en/cassandra-oss/3.0/cassandra/architecture/archDataDistributeReplication.html?hl=networktopologystrategy#archDataDistributeReplication__simpleStrategy
   */
  SimpleStrategy
}
