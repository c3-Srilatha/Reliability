/**
 * Spec for applying {@link Cassandra.Node} admin functions on specific tables.
 */
type Cassandra.Table.TableSpec mixes Spec {

  /**
   * Name of {@link Cassandra.Keyspace}
   */
  keyspaceName: !string

  /**
   * Name of {@link Cassandra.Table}
   */
  tableName: string
}
