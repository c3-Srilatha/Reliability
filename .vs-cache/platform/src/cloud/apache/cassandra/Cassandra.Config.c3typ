/**
 * Spec holding connection details for cassandra
 */
type Cassandra.Config mixes KvStoreConfig {

  hostPrefix:                string = "local"
  knownNode:                 string = "localhost"
  nodeDownSuspensionMillis:  int = 10000
  maxConnectionWaitMillis:   int = 10000
  maxNumOpRetries:           int = 10
  schemaAgreementWaitMillis: int = 180000

  /**
   * INTERNAL - If set, then will bring up Embedded Cassandra - used for internal testing only
   */
  embedded: private boolean

  /**
   * Cassandra keyspace replication strategy.
   */
  replicationStrategy: string enum Cassandra.Keyspace.ReplicationStrategy

  /**
   * Replication factor for the keyspace.
   */
  replicationFactor: int32 = 3

  /**
   * Default consistency level for the overall cluster.
   */
  consistencyLevel: string enum Cassandra.Table.QuerySpec.ConsistencyLevel

  /**
   * Default serial consistency level for the overall cluster.
   * Ref https://docs.datastax.com/en/drivers/java/2.0/com/datastax/driver/core/Statement.html#setSerialConsistencyLevel-com.datastax.driver.core.ConsistencyLevel-
   */
  serialConsistencyLevel: string enum Cassandra.Table.QuerySpec.ConsistencyLevel

  /**
   * Overrides for each datacenter by replication factor
   * this is provided if replicationStrategy is NetworkTopologyStrategy and if different datacenters are provided
   */
  replicationFactorByDc: map<string, int>

  /**
   * Member method to return the replication json string
   */
  replicationJsonString: member function(): string

  /**
   * Name of the data center.
   * This field must be provided when Cassandra Cluster is not ensured by C3.
   * For Cassandra Cluster ensured by C3, we will populate the value retrieved from {@link CassandraDB_Config#datacenterName}.
   */
  datacenter: string
}
