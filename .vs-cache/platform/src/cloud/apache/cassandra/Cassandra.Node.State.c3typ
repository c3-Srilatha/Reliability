/**
 * Enum type that identifies the state of a {@link Cassandra.Node} in terms of availability.
 */
enum type Cassandra.Node.State {

  /**
   * {@link Cassandra.Node} is currently up.
   */
  UP

  /**
   * {@link Cassandra.Node} is currently down.
   */
  DOWN
}
