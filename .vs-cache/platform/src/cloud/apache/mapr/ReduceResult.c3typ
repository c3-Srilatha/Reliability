/**
 * Result of a singe reduce step in the MapReduce job.
 */
@db(datastore="kv", partitionKeyField='run', persistenceOrder='outKey', systemType=true, compactType=true)
entity type ReduceResult mixes Partitionable<MapReduceRun> schema name 'mapr_ReduceResult' {

  run:      !MapReduceRun
  outKey:   !string
  outValue: any schema suffix 'OV'
}
