/**
 * MapReduce job for Persistable#eachObjBatch.
 */
entity type ObjBatchMapReduceJob extends MapReduce<Obj, string, Obj, Obj> type key 'OBJ_BATCH' {

  action: !lambda(objs: ![Obj], context: any) schema suffix 'ACTN'

  @db(persistAllFields=true)
  context: any
}
