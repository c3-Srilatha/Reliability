@db(systemType=true, compactType=true)
entity type MapReduceRun mixes JobRun<MapReduceStatus> schema name 'MAPR_RUN' {

  /**
   * If true, the file system will be used for intermediate value storage.  Otherwise, the default KV store will
   * be used.
   */
  useFileSystemForInterVals: boolean

  /**
   * @see MapReduceOptions.useBatchIdsForReadInput
   */
  useBatchIdsForReadInput: boolean

  /**
   * Indicates the job is using random ordering (e.g. md5 hash/mod) for reading input
   */
  randomOrder: boolean

  /**
   * Value of the job's samplePct at the time the run is started
   */
  samplePct: int

  /**
   * Number of batches when randomOrder is true
   */
  numBatches: int

  /**
   * Batch size for the run (either copied from the job or computed if randomOrder is true and samplePct is specified)
   */
  batchSize: int

  /**
   * Results for the run.
   */
  results: [ReduceResult](run)
}
