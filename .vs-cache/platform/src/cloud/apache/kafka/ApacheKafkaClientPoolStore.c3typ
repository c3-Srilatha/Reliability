/**
 * Store for all kafka client pools. An instance of store will have initialized client pool for given Kafka cluster
 * and KafkaClient specific configs.
 * for generating cache key, use {@link ApacheKafkaClientFields#toString}
 */
type ApacheKafkaClientPoolStore mixes Configurable<ApacheKafkaClientStoreConfig>, Cached, Named {

  /**
   * pool for KafkaClients.
   */
  pool: ApacheKafkaClientPool

  produce: ~
}
