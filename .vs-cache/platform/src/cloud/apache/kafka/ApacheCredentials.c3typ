/**
 * Apache credentials used to access supported services through the Apache SDK .
 */
type ApacheCredentials mixes CloudCredentials {

  /**
   * If the authentication is done with Kerberos, set this field to provide Kerberos credentials.
   * Also make sure {@link KerberosConfig} has right config to get krb content.
   */
  kerberosCredentials: KerberosCredentials

  /**
   * If Kafka on cloud is used, set this with appropriate API key, API secret.
   * This uses SASL_SSl PLAIN JAAS mechanism.
   */
  apacheApiKeyCredentials: ApacheApiKeyCredentials

  /**
   * Additional connection configuration properties.
   * Example: {"sasl.mechanism", "SCRAM-SHA-512"} specifies the SASL authentication mechanism to use
   */
  properties: map<string, string>
}
