/**
 * Message type for Apache KafkaTopic
 */
type ApacheKafkaTopicMessage mixes CloudStreamMessage {

  /**
   * Field to represent native Apache Kafka message headers.
   * Headers are key-value pairs that can be attached to Kafka messages to provide metadata and additional information about the message.
   * Key is the header name while value is the corresponding value in the format of byte array. E.g., {"timestamp" : to_byte_array("1970-01-01 00:00:01")}
   */
  headers: map<string, binary>
}
