/**
 * This is an instance to Apache Kafka Topic.  The configuration required to read from or publish to
 * an Apache  kafka topic can be set.
 * To learn more about Apache Kafka refer to https://kafka.apache.org/.
 */
@cloud(hasResourceArn=false,
       hasResourceId=true,
       hasResourceName=true,
       hasResourceGroupName=false,
       identityRoleOptions='OPTIONAL',
       cloudFunc='kafka')
@action(group+='app-admin')
type ApacheKafkaTopic mixes ApacheResource, CloudStream<ApacheKafkaTopicMessage>, ApacheKafkaConfigFields {

  /**
   * If creating the topic, number of partitions to be created.
   */
  partitionCount: int

  /**
   * Corresponding ids of partitions in current topic
   */
  partitionIds: [int]

  /**
   * If creating the topic, number of copies of a topic partition that should be stored on different Kafka brokers.
   */
  replicationFactor: int16

  getResource:     ~
  upsertResource:  ~
  destroyResource: ~
  listResources:   ~
  peekMessages:    ~
}
