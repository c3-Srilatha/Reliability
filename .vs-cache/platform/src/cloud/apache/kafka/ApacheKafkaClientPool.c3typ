private type ApacheKafkaClientPool mixes ObjectPool<native> {

  /**
   * Initializes the client pool with the requested client configs and pool config.
   *
   * @param clientType
   *        type of kafka client.{@link ApacheKafkaClientType}.
   * @param clientConfigs
   *        configs to initialize the client for.
   * @param config
   *        Config for the pool.
   *
   * @return the requested client pool.
   */
  init: inline function(clientType: !string enum ApacheKafkaClientType,
                        clientConfigs: !map<string, native>,
                        poolConfig: !ObjectPoolConfig): ApacheKafkaClientPool

  /**
   * Borrows a client from the pool.
   */
  borrowClient: inline member function(): @java(class="java.lang.AutoCloseable") native

  /**
   * Returns a client to the pool.
   *
   * @param client
   *        Client to return.
   */
  returnClient: inline member function(client: @java(class="java.lang.AutoCloseable") native)

  /**
   * Destroys/closes a Client rather than returning it to the pool.
   *
   * @param client
   *        Client to destroy.
   */
  destroyClient: inline member function(client: @java(class="java.lang.AutoCloseable") native)
}
