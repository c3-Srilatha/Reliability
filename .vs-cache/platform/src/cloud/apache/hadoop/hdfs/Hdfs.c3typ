/**
 * Hdfs implementation.
 */
type Hdfs mixes BlobFileSystem<HdfsFile>, FileSystemConfigurable<HdfsConfig> {

  /**
   * Converts relative or fully qualified path to the format hdfs apis require as input.
   */
  hdfsPath: private inline function(path: !string): !string

  hostAndPathFromUrlOrEncodedPath: ~
  supportsContentType:             ~

  /**
   * List all Apache Hdfs file systems.
   *
   * @returns the list of HdfsClient
   */
  listClients: function(): [HdfsClient]

  /**
   * Stop all the underlying Apache FileSystem impls. The FileSystem instances will
   * be started up on the next access. Admin only function.
   */
  stopAllClients: function()

  /**
   * Stop the underlying Apache FileSystem impl. The FileSystem instance will
   * be started up on the next access. Admin only function.
   *
   * @param clientKey
   *           clientKey used in identifying the client
   * @returns the HdfsClient that's removed
   */
  stopClient: function(clientKey: !string): HdfsClient
}
