/**
 * HdfsClient, that contains information about the Apache HDFS FileSystem. This should be used only for diagnosis by admin.
 */
type HdfsClient {

  /**
   * Client key that uniquely identifies a client.
   */
  clientKey: string

  /**
   * fsDefaultName, usually the endpoint in cloud credentials
   */
  fsDefaultName: string

  /**
   * Hdfs config, usually combined from tenant/tag-wide hdfs config and cloud credentials
   */
  config: HdfsConfig

  /**
   * true if it's started
   */
  isStarted: boolean
}
