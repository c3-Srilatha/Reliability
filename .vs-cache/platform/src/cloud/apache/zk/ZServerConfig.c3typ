type ZServerConfig mixes ConfigChild<ZookeeperConfig> {

  clientPort: int

  /**
   * If dataDir is empty, $HOME/zk_dataDir is used
   */
  dataDir: string

  dataLogDir: string

  /**
   * number of milliseconds of each tick
   */
  tickTime: int

  /**
   * Number of ticks that the initial synchronization phase can take
   */
  initLimit: int

  /**
   * Number of ticks that can pass between sending a request and getting an ack
   */
  syncLimit: int

  /**
   * in milliseconds
   */
  minSessionTimeout: int

  /**
   * in milliseconds
   */
  maxSessionTimeout: int
}
