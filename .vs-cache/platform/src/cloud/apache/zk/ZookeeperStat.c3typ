/**
 * Type that maps a zookeeper the node Stat object. It will always be generated as a member of
 * the ZookeeperNode.
 */
type ZookeeperStat {

  /**
   * Transaction id that created this node.
   */
  createXid: string

  /**
   * Timestamp when this node was created.
   */
  createdAt: datetime

  /**
   * Transaction id of the last modification to this node.
   */
  modifyXid: string

  /**
   * Timestamp of the last modification to this node.
   */
  modifiedAt: datetime

  /**
   * Number of changes to the data of this node.
   */
  version: int

  /**
   * If this node is ephemeral, this is the session id of the creator.
   */
  ephemeralOwner: string

  /**
   * Size of this node's data.
   */
  dataLength: int

  /**
   * Number of children for this node.
   */
  numChildren: int

  /**
   * Transaction id of the last modification to a child of this node.
   */
  childrenXid: string

  /**
   * Number of changes to the children of this node.
   */
  childrenVersion: int

  /**
   * Number of changes to the ACL of this node.
   */
  aclVersion: int
}
