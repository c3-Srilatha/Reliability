/**
 * This type implements functions to interact with Zookeeper.
 * The functions will work only for the cluster where the commands are invoked,
 * that is, all the path specifications are relative to the cluster root.
 */
private type Zookeeper mixes Configurable<ZkConfig> {

  /**
   * port of the Zookeeper cluster, by default it's 2181
   */
  port: int = 2181

  /**
   * the id of the cluster where the zookeeper cluster belongs to, by default it's the cluster where the command is issued.
   */
  clusterId: string

  /**
   * array of instances created by createEnsemble
   */
  nodes: [CloudComputeInstance]

  /**
   * the number of servers to bring up when start zookeeper cluster. It must be larger or equal to 3. By default it's 3.
   */
  startNodeCount: int = 3

  /**
   * Return the CloudId for the node with the given sequence number.
   * @param seq The sequence number of the node: e.g., "01"
   * @return complete CloudId with sequence number
   */
  nodeId: member function(seq: string): !CloudId

  /**
   * Construct a Zookeeper cluster, but do not start instances.
   *
   * @param clusterId The cluster id
   * @return Zookeeper with clusterId set
   */
  fromClusterId: function(clusterId: string): !Zookeeper

  /**
   * Start a cluster of Zookeeper CloudComputeInstances.
   * @return Zookeeper with nodes populated
   */
  start: member function(spec: !ClusterStartSpec): !Zookeeper

  /**
   * Get zookeeper information on the given cluster node.
   *
   * @param nodeId
   *           c3 cluster node id
   * @return ZookeeperNode
   */
  node: function(nodeId: !string): ZookeeperNode

  /**
   * Get zookeeper information on the given zookeeper node.
   *
   * @param path
   *           path to the zookeeper node (relative to the cluster root)
   * @return ZookeeperNode
   */
  znode: function(path: !string): ZookeeperNode

  /**
   * Delete the given zookeeper node. If the node has children and the recursive
   * parameter is not true, the action will fail.
   *
   * NOTE: DON"T USE IT UNLESS YOU KNOW WHAT YOU ARE DOING!
   *
   * @param path
   *           path to the zookeeper node (relative to the cluster root)
   * @param recursive
   *           if true, will remove the full subtree. Default value is false.
   * @return true if success
   */
  @action(group+='cluster-admin')
  remove: function(path: !string, recursive: boolean): boolean

  /**
   * Create the given zookeeper node.
   *
   * NOTE: DON"T USE IT UNLESS YOU KNOW WHAT YOU ARE DOING!
   *
   * @param path
   *           path to the zookeeper node (relative to the cluster root)
   * @param data
   *           data that will be stored in the node (can be null).
   * @param ephemeral
   *           ephemeral if true, otherwise it will be persistent.
   */
  @action(group+='cluster-admin')
  create: function(path: !string, data: string, ephemeral: boolean = false)

  /**
   * Update the given zookeeper node.
   *
   * NOTE: DON"T USE IT UNLESS YOU KNOW WHAT YOU ARE DOING!
   *
   * @param path
   *           path to the zookeeper node (relative to the cluster root)
   * @param data
   *           data that will be stored in the node (can be null).
   */
  @action(group+='cluster-admin')
  update: function(path: !string, data: string)

  /**
   * Check zookeeper status
   * return the zookeeper cluster status
   */
  status: member function(): [ZookeeperServerStat]

  /**
   * adding servers to existing cluster.
   * @param count
   *        the number of servers to add to the existing cluster. By default it's 1.
   * @param sequences
   *        the sequences of the servers. If the size of specified sequences is less than count, will assign available
   *        sequences to remaining nodes. If size of specified sequences is larger than count, will ignore remaining
   *        sequences.
   *        eg. count = 3, sequences = ["03", "06"], will assign "03" and "06" to first two servers, and assign first
   *        available sequence to the third server.
   */
  startNodes: member function(count: int = 1, sequences: [string]): [AwsEc2Instance]

  /**
   * rebuild the failed node
   * @param nodeId
   *        the id of the failed node
   * return the rebuilt node
   */
  rebuildNode: member function(nodeId: !string): !AwsEc2Instance

  /**
   * terminate the node
   * @param nodeId
   *        the id of the node to terminate
   * return the terminated node
   */
  terminateNode: member function(nodeId: !string): !AwsEc2Instance

  /**
   * connect to a existing Zookeeper
   * @param url
   *        the url of any node in the Zookeeper cluster
   * return the connected Zookeeper instance
   */
  connect: function(url: !Url): Zookeeper

  /**
   * Retrieves the metrics exposed by each zookeeper node
   */
  metrics: function(): map<string, ZkServerMetrics>
}
