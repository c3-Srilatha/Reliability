/**
 * Type that represents a zookeeper node
 */
type ZookeeperNode {

  /**
   * zookeeper node's path (relative to the cluster root)
   */
  path: string

  /**
   * hex representation of node data
   */
  data: string

  /**
   * node data interpreted as a string
   */
  dataAsString: string

  /**
   * The zookeeper Stat information for this path.
   */
  stat: ZookeeperStat

  /**
   * children node names.
   */
  children: [string]

  /**
   * ClusterNode if applicable
   */
  clusterNode: ClusterNode
}
