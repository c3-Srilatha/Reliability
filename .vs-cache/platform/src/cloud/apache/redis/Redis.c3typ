/**
 * Redis is the interface to connect and perform read/write operations on an already provisioned Redis cluster.
 */
type Redis mixes DistributedMap<string, binary> {

  /**
   * The redis service endpoint
   */
  endpoint: !string

  /**
   * Connects to a redis cluster endpoint
   *
   * @param endpoint
   */
  connect: function(endpoint: !string): Redis

  /**
   * Lists keys as a stream of strings. Reads 100 keys per round-trip from Redis. Use \{@link DistributedMap scan} for
   * finer control over the parameters
   */
  keys: member function(): !stream<string>
}
