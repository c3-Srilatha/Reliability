/**
 * Type to provide spec for scanning rows in hbase table
 */
type HBaseScanSpec mixes Spec {

  /**
   * Data types of column families for the engine to deserialize data
   */
  columnFamilies: ![HBaseColumnFamily]

  /**
   * Start row at which you need to start scanning data
   */
  startRow: string

  /**
   * End row at which you need to end scanning data
   */
  stopRow: string

  /**
   * Prefix for row keys to filter on
   */
  rowPrefixFilter: string

  /**
   * Set whether blocks should be cached for this Scan.
   */
  setCacheBlocks: boolean
}
