/**
 * Configuration to make hbase point to a remote hbase cluster. There can be multiple instances of
 * HBaseConnectionConfig. Note that zkPort, zkHost, zkParentNode are required for establishing a basic connection to
 * HBase nodes. However, if you need to connect to a Kerberized HBase cluster, please setup additional configs through
 * {@link HadoopSpec}.
 *
 * Here're some common configurations that used in HBase for security related settings:
 * * hadoop.security.authentication: simple/kerberos
 * * hbase.security.authentication: simple/kerberos
 * * hbase.master.kerberos.principal
 * * hbase.regionserver.kerberos.principal
 * * hbase.client.retries.number: setup max retryable times to get in-general faster connection.
 *
 * An overview of the full HBase configurations can be found here at
 * [Apache HBase](https://github.com/apache/hbase/blob/master/hbase-common/src/main/resources/hbase-default.xml).
 */
@cache(maxSize=100)
@config(secretAuthz='tag-admin')
type HBaseConnectionConfig mixes KvStoreConfig, HadoopConfigFactory<HBaseConnectionConfig>, ServicePlugin {

  /**
   * hbase.zookeeper.property.clientPort configuration for hbase
   */
  zkPort: !int

  /**
   * hbase.zookeeper.quorum configuration for hbase
   */
  zkHost: !string

  /**
   * zookeeper.znode.parent configuration for hbase
   */
  zkParentNode: !string
}
