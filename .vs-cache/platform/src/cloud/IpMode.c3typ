/**
 * Enumeration for IP modes.
 *
 * This enum represents the possible IP modes for a Kubernetes cluster deployment.
 * It defines whether the cluster operates in IPv4 mode, IPv6 mode, or supports both (DualStack).
 */
enum type IpMode {

  /**
   * IPv4 only.
   */
  IPv4

  /**
   * IPv6 only.
   */
  IPv6

  /**
   * Dual stack (IPv4 and IPv6).
   */
  DualStack
}
