/**
 * Default configurations for CloudServiceOrchestrator
 */
@action(group='cluster-admin')
type CloudServiceOrchestratorConfig mixes Config {

  /**
   * System-wide default orchestrator to launch cloud services with.
   */
  defaultOrchestrator: Type

  /**
   * Default cluster to use for K8s-type orchestrator.
   */
  defaultK8sOrchestrator: Type

  /**
   * Set to specific namespace if using something other than "default" as the default namespace
   * for Kubernetes.
   */
  k8sDefaultNamespace: K8sNamespace

  /**
   * The resource id of the reference ec2 instance to use during CloudResourceFieldsMethods.hack
   */
  // TODO: PLAT-16777 remove workaround and create network resources from scratch
  referenceLocalEc2ResourceId: string

  referenceJenkinsEc2ResourceId: string
}
