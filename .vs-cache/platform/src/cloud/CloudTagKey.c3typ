/**
 * Well known CloudTag keys.
 */
enum type CloudTagKey {

  ID = 'c3__id'

  CLUSTER = 'c3__cluster'

  ENV = 'c3__env'

  ENV_ID = 'c3__env_id'

  APP = 'c3__app'

  APP_ID = 'c3__app_id'

  FUNC = 'c3__func'

  ROLE = 'c3__role'

  SEQ = 'c3__seq'

  CREATED = 'c3__created'

  CREATED_BY = 'c3__created_by'

  CREATED_FROM = 'c3__created_from'

  UPDATED = 'c3__updated'

  UPDATED_BY = 'c3__updated_by'

  UPDATED_FROM = 'c3__updated_from'

  SERVICE_NAME = 'c3__service_name'

  SERVICE = "c3__service"

  NAMESPACE = 'c3__namespace'

  SERVICE_CONFIG = 'c3__csconfig'

  APPLICATION_GROUP = 'applicationGroup'

  /*
   * When set to "1", denotes that the CloudResource is managed by a known component outside of the C3 platform.
   * Hence these resources will not be garbage collected during orphan resource cleanup.
   */
  EXTERNALLY_MANAGED = 'c3__externally_managed'

  SERVER_VERSION = 'c3__server_version'
}
