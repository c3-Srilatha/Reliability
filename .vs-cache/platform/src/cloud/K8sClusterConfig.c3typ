/**
 * Configuration for a K8s cluster deployment. Holds information that is required for deploying a cluster.
 */
@config(minOverride=CLUSTER)
type K8sClusterConfig mixes Config, Identified {

  /**
   * @return fetched config for the given id
   */
  forId: function(id: !?string, failIfMissing: boolean): K8sClusterConfig

  /**
   * Indicates whether istio is enabled in the cluster.
   * Set this to true for all future C3 infra resources to contain the necessary additions to be istio enabled.
   */
  istioEnabled: boolean = false
}
