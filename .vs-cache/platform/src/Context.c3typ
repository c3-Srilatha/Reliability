/**
 * Represents current context for C3 App and Action
 */
inline type Context mixes DefaultInstance {

  /**
   * Current server's URL, including application context (env/app) as needed
   */
  appUrl: !AppUrl

  /**
   * Current C3 application.
   */
  app: !App

  /**
   * Current C3 environment.
   */
  env: !Env

  /**
   * Current C3 cluster.
   */
  cluster: !Cluster

  /**
   * Mode of current application.
   */
  mode: !string enum AppMode

  /**
   * Current C3 user.
   */
  user: !User

  /**
   * Current C3 username.
   */
  username: !string

  /**
   * Current implementation language runtime
   */
  runtime: property(): !ImplLanguage.Runtime java | js | py

  /**
   * The action engine used by the current context
   */
  actionEngine: !Action.Engine

  /**
   * Current language (the default is "en-US"). This may be changed in client runtimes with #setLanguage.
   */
  language: property(): !string java | js | py

  @call(stayInEngine=true)
  inst: ~ java | js | py

  /**
   * Set this Context's language. If called on the default Context (e.g. used statically), then the new language will
   * be used for all subsequent type-system actions. The default language for a connection is "en-US".
   */
  setLanguage: member function(language: !string) java | js-client

  /**
   * Get the context from the server, even if executed in a client environment.
   */
  serverContext: private function(): !Context
}
