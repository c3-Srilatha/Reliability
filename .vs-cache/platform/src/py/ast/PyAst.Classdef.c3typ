/**
 * Python AST ClassDef node.
 *
 * @see PyAst
 * @see https://docs.python.org/3/library/ast.html
 */
type PyAst.Classdef mixes PyAst.Stmt, PyAst.Ast {

  nodeTyp:        const string = "ClassDef"
  name:           !string
  bases:          ![PyAst.Expr2]
  keywords:       ![PyAst.Keyword]
  body:           ![PyAst.Stmt]
  decorator_list: ![PyAst.Expr2]

  // type_params is only supported for python language version >=3.12
  type_params: ![PyAst.Type_param]
}
