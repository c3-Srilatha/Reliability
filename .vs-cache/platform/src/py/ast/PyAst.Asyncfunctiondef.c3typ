/**
 * Python AST AsyncFunctionDef node.
 *
 * @see PyAst
 * @see https://docs.python.org/3/library/ast.html
 */
type PyAst.Asyncfunctiondef mixes PyAst.Stmt, PyAst.Ast {

  nodeTyp:        const string = "AsyncFunctionDef"
  name:           !string
  args:           !PyAst.Arguments
  body:           ![PyAst.Stmt]
  decorator_list: ![PyAst.Expr2]
  returns:        PyAst.Expr2
  type_comment:   string

  // type_params is only supported for python language version >=3.12
  type_params: ![PyAst.Type_param]
}
