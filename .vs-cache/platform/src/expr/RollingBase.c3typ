/**
 * @inheritdoc CollectionWindow
 *
 * This subType is for operations on a rolling window.
 * For a general description and examples of what are rolling window operations, see
 * [pandas.DataFrame.rolling](https://pandas.pydata.org/pandas-docs/stable/reference/api/pandas.DataFrame.rolling.html)
 * Rolling operations return the same CollectionType as the original on which the rolling operation was performed.
 * @see Stdlib#rolling
 * @see Collection#rolling
 */
abstract type RollingBase<E> mixes WindowBase {

  /**
   * Minimum number of non-missing values in window for the final computed result for the window to have a value.
   * Otherwise, the final result for the window is null or NaN.  "Non-missing value" here refers to an
   * individual element field, not the entire element.
   *
   * If this field is not specified when {@link #window} is a {@link Period}, this field is treated as having value 1.
   * If this field is not specified when {@link #window} is an integer, this parameter is treated as if it were the
   * size of the window.
   * If this field is not specified when {@link #window} is an {@link WindowSpec}, this parameter is treated as if it
   * were the span of the window.
   *
   * Value should be between 0 and Window Size if {@link #window} is an Integer, or Window Span if {@link #window} is
   * a {@link WindowSpec}
   */
  minValues: ~

  /**
   * Size of the moving window.
   *
   * If this is an integer, this is the number of values used for calculating the statistic. Each window has a fixed
   * size.
   *
   * If this is a {@link Period}, it will be treated as a time period for windowing (e.g. an "offset" in Pandas).
   * A {@link Period} is only valid for datetime-like indexes and will cause an error if {@link #spec} for Timeseries
   * conversion is not specified.
   */
  window: !int | !Period | !WindowSpec

  /**
   * Spec to specify the column/expr to be used to create the rolling window, rather than the {@link Collection}’s
   * integer index. Timeseries will be constructed based on this, before running any rolling window aggregations.
   * A `null` spec assumes that there is no Timeseries nature to collection.
   */
  spec: DataTimeseriesSpec

  /**
   * The collection on which we want to apply the window.
   */
  _src: private ?(?Collection<E> | ?Data)

  /**
   * Based on {@link #window} and {@link #period}, provide a value which can be used as **span** of the rolling window.
   */
  safeWindowSpan: private member function(): !int

  /**
   * Based on {@link #window} and {@link #spec.period}, provide a value which can be used as **offset** of the rolling
   * window. This offset ensures that the **rolling** window ends at the current index and starts at
   * `(current position - span + 1)`.
   * Since the data is normalized when computing the timeseries, the windows will be of the same length.
   */
  safeWindowOffset: private member function(): !int

  /**
   * safe minValues as computed by:
   * If {@link #minValues} is not specified when {@link #window} is a {@link Period}, this field is treated as having value 1.
   * If {@link #minValues} is not specified when {@link #window} is an int, this parameter is treated as if it were the
   * size of the window.
   */
  safeMinValues: private member function(): !int
}
