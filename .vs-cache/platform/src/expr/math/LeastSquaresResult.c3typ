/**
 * The result of applying Ordinary Least Squares regression contains the intercept (α) and slope (β) as well as other
 * meta information.
 *
 * @see NumCollectionWithIndex#leastSquares
 * @see Timeseries#leastSquares
 */
type LeastSquaresResult mixes Result {

  /**
   * The number of points which were not entirely missing.
   */
  nPoints: !int

  /**
   * The Y intercept of the regression line (α).
   */
  intercept: !double

  /**
   * The slope of the regression line (β).
   */
  slope: !double

  /**
   * "R-squared", how close the data are to the fitted regression line (coefficient of determination).
   */
  rSquared: !double

  /**
   * "MSE", an average of the squares of the error of the points relative to the fitted regression line.
   */
  meanSquaredError: !double
}
