/**
 * Declared range of comparable values, usually numeric primitives. The range may be declared with a minimum and/or
 * a maximum, either of which may be inclusive or exclusive. By default minimum is inclusive and maximum is exclusive.
 * This should only be used for types that have natural comparisons.
 */
type Range<V> mixes StringSerializable, Obj {

  /**
   * Minimum value setting. Note that this will not be the effective minimum if minExclusive is set.
   */
  min: V

  /**
   * Maximum value setting. Note that this will be the effective maximum only if maxInclusive is set.
   */
  max: V

  /**
   * If true, treat the min value as outside the valid range.
   */
  minExclusive: boolean

  /**
   * If true, treat the max value as within the valid range.
   */
  maxInclusive: boolean

  /**
   * Return the minimum value setting, or the smallest reasonable value for numeric types. For non-numeric types, or
   * numeric types that are not fixed-size, returns null.
   *
   * @param failIfNone throw error instead of returning null
   */
  safeMin: inline member function(failIfNone: boolean): V

  /**
   * Return the maximum value setting, or the largest reasonable value for numeric types. For non-numeric types, or
   * numeric types that are not fixed-size, returns null.
   *
   * @param failIfNone throw error instead of returning null
   */
  safeMax: inline member function(failIfNone: boolean): V

  /**
   * Return the effective minimum value (inclusive) or the smallest reasonable value for numeric types.
   *
   * @param failIfNone throw error instead of returning null
   */
  safeMinInclusive: inline member function(failIfNone: boolean): V

  /**
   * Return the lower limit value (exclusive) or the smallest reasonable value for numeric types. Note that where
   * this conflicts with the representable range, the value will be clipped.
   *
   * @param failIfNone throw error instead of returning null
   */
  safeMinExclusive: inline member function(failIfNone: boolean): V

  /**
   * Return the effective maximum value (inclusive) or the largest reasonable value for numeric types.
   *
   * @param failIfNone throw error instead of returning null
   */
  safeMaxInclusive: inline member function(failIfNone: boolean): V

  /**
   * Return the upper limit value (exclusive) or the largest reasonable value for numeric types. Note that where
   * this conflicts with the representable range, the value will be clipped.
   *
   * @param failIfNone throw error instead of returning null
   */
  safeMaxExclusive: inline member function(failIfNone: boolean): V

  /**
   * Return true if the specified value falls within the declared range. Note that this handles the combinations of
   * min/max and minExclusive/maxInclusive settings.
   */
  contains: inline member function(v: !?V): boolean

  /**
   * Merge ranges that overlap and return the ones that don't as is. Note that this handles the combinations of
   * min/max and minExclusive/maxInclusive settings.
   */
  mergeOverlapping: inline function(r: ![Range<V>]): ![Range<V>]

  /**
   * Return true if the specified range overlaps with this one. Note that this handles the combinations of
   * min/max and minExclusive/maxInclusive settings.
   *
   *
   *                      |---------|
   *          |-------------| -> ths
   *     |---------|
   *     |--------------------------|
   */
  overlaps: inline member function(r: !Range<V>): boolean

  /**
   * Adjust the value so that it falls within the declared numeric range. Note that this handles the combinations of
   * min/max and minExclusive/maxInclusive settings.
   */
  clip: inline member function(v: !?V): !V

  /**
   * Fill in the missing min and/or max fields if necessary to the extent of the valid range for that numeric type.
   * The returned instance will have both #min and #max defined. Note that this will not change the behavior as
   * minimum/maximum values are automatically assumed by methods as as #contains if not specified.
   *
   * @see PrimitiveType#minValue
   * @see PrimitiveType#maxValue
   */
  withDefaults: ~ java

  /**
   * Generate an `int` value.
   */
  makeRndInt: inline function(rnd: !Rnd): Range<int>

  /**
   * Generate an `int` value within the specified range.
   * @param min minimum value (inclusive)
   * @param max maximum value (exclusive)
   */
  makeRndInt: inline function(rnd: !Rnd, min: int, max: int): Range<int>

  /**
   * Generate an `int` value within the specified range.
   * @param min minimum value (inclusive)
   * @param max maximum value (exclusive)
   */
  makeRndInt32: inline function(rnd: !Rnd, min: int32, max: int32): Range<int32>

  /**
   * Generate a `double` value within the specified range.
   * @param min minimum value (inclusive)
   * @param max maximum value (exclusive)
   */
  makeRndDbl: inline function(rnd: !Rnd): Range<double>
}
