/**
 * Result of a pseudo-random value generation, including the updated seed value.
 */
type RndResult<T> mixes Pair<T, int>, Result {

  /**
   * The generated random value.
   */
  fst: private !~

  /**
   * The updated seed.
   */
  snd: private !~

  /**
   * Return the generated random value.
   */
  val: inline member function(): !T

  /**
   * Return the updated seed.
   */
  seed: inline member function(): !int

  /**
   * Produce a result from the value and seed for a given type.
   */
  forType: inline function(t: !ValueType, v: !?any, seed: !int): RndResult<T>
}
