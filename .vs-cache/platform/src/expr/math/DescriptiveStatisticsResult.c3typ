/**
 * The result of descriptive statistics based on a normal distribution. Values which cannot be calculated are null.
 * For an empty population, only sum and count will be present.
 *
 * @see NumCollection#descriptiveStatistics
 */
type DescriptiveStatisticsResult mixes Result, WithToString {

  /**
   * Minimum value in the population.
   */
  min: double

  /**
   * Maximum value in the population.
   */
  max: double

  /**
   * Sum of all values in the population. If no values, this will be zero.
   */
  sum: !double

  /**
   * Number of valid values in the population.
   */
  count: !int

  /**
   * Arithmetic mean of the values, also called the "average."
   */
  avg: double

  /**
   * Measure of dispersion of the population values; the average of the squares of the differences from the mean
   * (using _n - 1_ in the denominator).
   */
  variance: double

  /**
   * Standard deviation, the square root of the variance (using _n - 1_ in the denominator).
   */
  stddev: double

  /**
   * Value separating the higher from the lower half of the population values.
   */
  median: double

  /**
   * Three points separating the population values into four ranges with an equal number of values.
   * The values in the array are:
   *  - point that only ¼ of the values are below (first quartile)
   *  - point that half the values are above and half below (median)
   *  - point that only ¼ of the values are above (third quartile)
   * Note that this means the index is one smaller than the rank, `quartiles[0]` is the _first_ quartile.
   */
  quartiles: [double]

  /**
   * Nine points separating the population values into ten ranges with an equal number of values. The first element is
   * the first decile and the last (ninth) value is the ninth decile. Note that this means the index is one smaller
   * then the rank, `deciles[0]` is the _first_ decile (point that only ⅒ of the values are below).
   */
  deciles: [double]

  /**
   * The population values separated into one hundred ranges with an equal number of values. The first element is
   * the first percentile and the last value is the hundreth percentile. Note that this means the index is one smaller
   * then the rank, `percentile[0]` is the _first_ percentile (point that only 1/100 of the values are below).
   */
  percentiles: [double]

  /**
   * Return a natural representation of the distribution of a size in bytes.
   */
  formatBytes: member function(): string

  /**
   * Return a natural representation of the distribution of fractional value as a percentage.
   */
  formatPercent: member function(): string

  /**
   * Return a natural representation of the distribution of a multiplier (ratio numerator).
   */
  formatTimes: member function(): string

  /**
   * Return a natural representation of the distribution of a duration in seconds with three significant digits.
   */
  formatTimingS: member function(): string

  /**
   * Return a natural representation of the distribution of a duration in milliseconds with three significant digits.
   */
  formatTimingMs: member function(): string

  /**
   * Return a natural representation of the distribution of a duration in nanoseconds with three significant digits.
   */
  formatTimingNs: member function(): string

  /**
   * Return a natural representation of the distribution using a custom formatter.
   */
  format: member function(formatter: !lambda(distribution: DescriptiveStatisticsResult, value: !number): string)
                   : string
}
