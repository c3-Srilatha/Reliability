/**
 * Built-in string formats. This is used to generate strings with different content for use in random data.
 *
 * @see Rnd#str
 */
enum type RndStrKind {

  /**
   * Typical ID values; generally a sequence of word characters and select punctuation.
   */
  ID

  /**
   * Typical names values; generally a sequence of word characters.
   */
  NAME

  /**
   * Typical prose values; generally a sequence of words.
   */
  SUMMARY

  /**
   * Typical prose values; generally a sequence of words.
   */
  DESCRIPTION

  /**
   * Letters only.
   */
  ALPHA

  /**
   * Letters and digits only.
   */
  ALPHANUMERIC

  /**
   * Hexadecimal digits only.
   */
  HEX

  /**
   * Typical domain name.
   */
  DOMAIN

  /**
   * Typical email address.
   */
  EMAIL

  /**
   * Typical URL.
   */
  URL

  /**
   * Semantic version.
   */
  VERSION

  /**
   * Local file path.
   */
  FILE_PATH

  /**
   * Local file URL.
   */
  FILE_URL

  /**
   * Expression.
   */
  EXPR

  /**
   * IPV4 address.
   */
  IP_ADDR

  /**
   * Language/region.
   */
  LOCALE

  /**
   * Content-Type.
   */
  MIME_TYPE

  /**
   * Datetime.
   */
  DATETIME

  lenRange: inline function(rnd: !Rnd, kind: !string enum RndStrKind, example: boolean): !Range<int32>
  dflt:     inline function(kind: string enum RndStrKind): !string enum RndStrKind
}
