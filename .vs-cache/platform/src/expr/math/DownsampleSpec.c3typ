/**
 * Spec indicating how elements should be downsampled
 */
type DownsampleSpec mixes Obj {

  /**
   * Indicating how elements needs to be aggregated
   */
  aggFunc: !AggOp

  /**
   * Factor by which you need to downsample. E.g. 0.5 will reduce the size of the array by 2. Value should be < 1
   */
  factor: !double
}
