/**
 * Abstract compiled C3 expression
 *
 * @see Expr
 */
abstract inline type Expr.Compiled<I, O> mixes WithToString {

  /**
   * Evaluate the compiled expression
   * @param in
   *        input object on which the compiled expression needs to be evaluated
   * @param timeInfo
   *        timing information for the evaluation
   * @param vars
   *        variable bindings
   * @return evaluation result
   */
  eval: abstract member function(in: I, timeInfo: TimeInfo, vars: map<string, any>): O

  /**
   * @return the ast for this compiled expr.
   */
  ast: property(): !Expr.Ast

  /**
   * @return Expr instance for this compiled C3 expression.
   */
  expr: !Expr

  /**
   * @return the consts for this compiled C3 expression.
   */
  consts: map<string, any>

  /**
   * @return compile options for this compiled C3 expression.
   */
  options: Expr.CompileOptions

  /**
   * @return return value of the input
   */
  inType: !ValueType

  /**
   * @return variable types
   */
  varTypes: map<string, ValueType>

  /**
   * List of variable names in the given expression ast
   */
  varNames: set<string>

  /**
   * @return output value type
   */
  outType: !ValueType

  /**
   * List of `.` separated field paths in the context of root C3 type used in this expression.
   */
  dependingFieldPaths: member function(): set<string>

  /**
   * @return predicate lambda based for this expression
   */
  filter: member function(): lambda(in: I): boolean

  /**
   * @return compiled projection lambda for transforming input by extracting result of the evaluation of provided
   *         expression
   */
  mapper: member function(): lambda(in: I): O

  /**
   * @return compiled comparator lambda based on key extracted by current expression for provided input value type
   */
  comparator: member function(): lambda(in1: I, in2: I): @comparator int32

  /**
   * @return compile internal representation of this expression
   */
  doCompile: private abstract member function(): !mixing Expr.Compiled

  toString: ~
}
