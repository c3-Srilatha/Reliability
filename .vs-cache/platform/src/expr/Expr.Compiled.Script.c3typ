/**
 * Base type for compiled C3 expression for scripting languages like Python and Java Script.
 *
 * @see Expr.Compiled
 */
abstract inline private type Expr.Compiled.Script<I, O> mixes Expr.Compiled<I, O> {

  /**
   * The name of the function declared in #script.
   */
  FUNC_NAME: const string = 'evaluate'

  /**
   * The script implementing C3 Expression. This is the source code for a function in the script language that has
   * the same signature as {@link Expr.Compiled#eval}:
   *
   * ```
   *  * Evaluate the compiled expression
   *  * @param in
   *  *        input object on which the compiled expression needs to be evaluated
   *  * @param timeInfo
   *  *        timing information for the evaluation
   *  * @param vars
   *  *        variable bindings
   *  * @return evaluation result
   * eval: member function(in: I, timeInfo: TimeInfo, vars: map<string, any>): O
   * ```
   *
   * @see #FUNC_NAME
   */
  script: !string

  /**
   * Attempt to compile the expression in the current language, Anything beyond the subset of {@link Expr} supported
   * will fall back to the Java implementation.
   *
   * This simplified form is intended to be cached. For full functionality, including {@link Expr.CompileOptions},
   * use the various overloads of {@link Expr#compile}. Note that the language may be specified using
   * {@link Expr.CompileOptions#language}.
   *
   * @param expr the expression string
   * @param inType the input value type (if any)
   * @param failIfInvalid if true, throw an error instead of returning null
   */
  parseCompile: abstract function(expr: !?string, inType: ValueType, failIfInvalid: boolean): Expr.Compiled

  /**
   * Attempt to compile the expression in the current language, Anything beyond the subset of {@link Expr} supported
   * will fall back to the Java implementation.
   *
   * This simplified form is intended to be cached. For full functionality, including {@link Expr.CompileOptions},
   * use the various overloads of {@link Expr#compile}. Note that the language may be specified using
   * {@link Expr.CompileOptions#language}.
   *
   * @param expr the expression string
   * @param inType the input type (required)
   * @param failIfInvalid if true, throw an error instead of returning null
   */
  parseCompile: abstract function(expr: !?string, inType: !Type, failIfInvalid: boolean): Expr.Compiled

  /**
   * Attempt to compile the expression in the specified language, Anything beyond the subset of {@link Expr} supported
   * will fall back to the Java implementation.
   *
   * This simplified form is intended to be cached. For full functionality, including {@link Expr.CompileOptions},
   * use the various overloads of {@link Expr#compile}. Note that the language may be specified using
   * {@link Expr.CompileOptions#language}.
   *
   * @param language the script language
   * @param expr the expression string
   * @param inType the input value type (if any)
   * @param failIfInvalid if true, throw an error instead of returning null
   */
  _parseCompile: private function(language: !string serialized ImplLanguage,
                                  expr: !?string,
                                  inType: !ValueType,
                                  failIfInvalid: boolean): Expr.Compiled

  /**
   * Evaluates this C3 expression using Java Compiled class for it.
   */
  evalJava: private member function(in: I, timeInfo: TimeInfo, vars: map<string, any>): O
}
