@beta
abstract type StreamStdLib<E> mixes Value {

  iter:              inline member function(): Iterator<E>
  _iter_:            private inline member function(): native
  _length_:          private inline member function(): !int
  size:              inline property(): !int
  isEmpty:           inline member function(): boolean
  collect:           member function(limit: int): [E]
  collectArrays:     member function<T>(limit: int): [[T]]
  abs:               member function(): Stream<E>
  aggImplementation: member function<R>(spec: !?AggSpec, op: !string enum AggOp): R
  aggImplementation: member function<R>(spec: !?AggSpec, aggregator: !lambda(a: R, b: E): R): R

  aggImplementation: member function<T, R>(spec: !?AggSpec,
                                           folder: !lambda(accumulator: T, e: E): T,
                                           aggregator: !lambda(aggregated: R, e: T): R): R

  sumDbl:            member function(): !double
  sumDiff:           member function(absoluteValues: boolean): !double
  cusum:             member function(threshold: double = 1, drift: double = 0): [int]
  normalize:         member function(): Stream<E>
  at:                member function(index: !int): E
  pluck:             member function<T>(fieldPath: !?string serialized FieldPath, vtOverride: ValueType): Stream<T>
  first:             member function(): E
  first:             member function(n: !int): Stream<E>
  first:             member function(test: !lambda(e: E): boolean): E
  firstNotNull:      member function(): !?E
  firstNotNull:      member function<T>(mapper: !lambda(e: E): T): !?T
  firstNotEmpty:     member function(): !E
  firstNotEmpty:     member function<T>(mapper: !lambda(e: E): T): !T
  last:              member function(): E
  last:              member function(n: !int): Stream<E>
  last:              member function(test: !lambda(e: E): boolean): E
  lastNotNull:       member function(): !?E
  lastNotNull:       member function<T>(mapper: !lambda(e: E): T): !?T
  lastNotEmpty:      member function(): !E
  lastNotEmpty:      member function<T>(mapper: !lambda(e: E): T): !T
  minImplementation: member function(spec: AggSpec): E
  minImplementation: member function(comparator: !lambda(a: E, b: E): @comparator int32): E
  minBy:             member function(value: !lambda(e: E): any): E
  maxImplementation: member function(spec: AggSpec): E
  maxImplementation: member function(comparator: !lambda(a: E, b: E): @comparator int32): E
  maxBy:             member function(value: !lambda(e: E): any): E
  count:             member function<R>(spec: AggSpec): R
  sumImplementation: member function<R>(spec: AggSpec): R
  allImplementation: member function<R>(spec: AggSpec): R
  prod:              member function<R>(spec: AggSpec): R
  avg:               member function<R>(): R
  avgDbl:            member function(): !double
  median:            member function<R>(): R
  medianDbl:         member function(): !double
  percentile:        member function<R>(percentile: !double): R
  percentileDbl:     member function(percentile: !double): !double
  stddev:            member function<R>(): R
  stddevDbl:         member function(): !double
  variance:          member function<R>(): R
  varianceDbl:       member function(): !double
  aggDbl:            member function(aggFunc: !string enum AggOp, percentile: double): !double
  round:             member function(decimals: int): Stream<E>
  invert:            member function(): Stream<E>
  only:              member function(failIfNotSingleton: boolean): E
  contains:          member function(element: !?any): boolean
  containsAll:       member function(elements: E ...): boolean
  containsAll:       member function(c: !?Collection<E>): boolean
  containsAll:       member function(predicate: !lambda(e: E): boolean): boolean
  containsAny:       member function(predicate: !lambda(e: E): boolean): boolean
  findAny:           member function(predicate: !lambda(e: E): boolean): E
  findAny:           member function(fields: !?map<string, any>): E
  anyNotNull:        member function(): !?E
  anyNotNull:        member function<T>(mapper: !lambda(e: E): T): !?T
  anyNotEmpty:       member function(): !E
  anyNotEmpty:       member function<T>(mapper: !lambda(e: E): T): !T
  each:              member function(action: !lambda(e: E))
  eachWhile:         member function(action: !lambda(e: E): boolean): boolean
  mapToSame:         member function(mapper: !lambda(e: E): E): Stream<E>
  map:               member function<T>(mapper: !lambda(e: E): T): Stream<T>
  mapToStr:          member function(mapper: !lambda(e: E): string): Stream<string>
  mapTo:             member function<T>(elementType: !ValueType, mapper: !lambda(e: E): T): Stream<T>
  flatMapToSame:     member function(mapper: !lambda(e: E): CollectionStdLib<E>): Stream<E>
  flatMap:           member function<T>(mapper: !lambda(e: E): CollectionStdLib<T>): Stream<T>

  flatMapTo: member function<T>(elementType: !ValueType, mapper: !lambda(e: E): CollectionStdLib<T>): Stream<T>

  flatMapRecursive: member function<I>(toInters: !lambda(e: E): CollectionStdLib<I>,
                                       fromInter: !lambda(i: I): E): Stream<E>

  fold:               member function<T>(folder: !lambda(e: E, accumulator: T): T): T
  fold:               member function<T>(initial: !?T, folder: !lambda(e: E, accumulator: T): T): T
  compact:            member function(): Stream<E>
  unique:             member function(): Stream<E>
  uniqueBy:           member function(key: lambda(e: E): any): Stream<E>
  filter:             member function(predicate: !lambda(e: E): boolean): Stream<E>
  filter:             member function(filter: !?string serialized Expr): Stream<E>
  filter:             member function(fields: !?map<string, any>): Stream<E>
  fillMissingBy:      member function(method: string enum FillMethod = PREVIOUS, spec: FillMissingSpec): Stream<E>
  fillMissing:        member function(value: !any, spec: FillMissingSpec): Stream<E>
  fieldNames:         member function(): [string]
  fieldValueType:     member function(field: !string): ValueType
  reject:             member function(predicate: !lambda(e: E): boolean): Stream<E>
  include:            member function(include: !?string serialized Include): Stream<E>
  include:            member function(positions: !Collection<int>): Stream<E>
  exclude:            member function(exclude: !?string serialized Include): Stream<E>
  replaceByPredicate: member function(e: !?E, predicate: !lambda(e: E): boolean): Stream<E>
  sorted:             member function(descending: boolean): Stream<E>
  sorted:             member function(comparator: !lambda(a: E, b: E): @comparator int32): Stream<E>

  sorted: member function(descending: !boolean, comparator: !lambda(a: E, b: E): @comparator int32): Stream<E>

  sorted:                  member function(order: !?string): Stream<E>
  sortedBy:                member function(key: !lambda(e: E): any): Stream<E>
  sortedBy:                member function(descending: !boolean, key: !lambda(e: E): any): Stream<E>
  sortedIndex:             member function(element: !E, value: !lambda(e: E): any): !int
  sortedIndex:             member function(element: !E, fieldName: !string): !int
  batch:                   @java(returnWildcardVarBindings=true) member function(batchSize: int): stream<Stream<E>>
  partition:               member function(partitioner: !lambda(e: E): boolean): map<boolean, [E]>
  countBy:                 member function(key: !lambda(e: E): string): map<string, int>
  countBy:                 member function<T>(keyType: !ValueType, key: !lambda(e: E): T): map<T, int>
  every:                   member function(predicate: !lambda(e: E): boolean): boolean
  elementCartesianProduct: member function<T>(): [[T]]
  flatten:                 member function<T>(shallow: boolean): Stream<T>
  flatten:                 member function<T>(depth: !int, include: string serialized Include): Stream<T>
  sample:                  member function(spec: SampleSpec): Stream<E>
  slice:                   member function(fromPos: !int, toPos: int, stride: int): Stream<E>
  slice:                   member function(positions: !?Collection<int>): Stream<E>
  sliceByKey:              member function(keys: !?Collection<any>): Stream<E>
  sliceByKey:              member function(secondaryIndex: !string, keys: !?Collection<any>): Stream<E>
  summarize:               member function(spec: DigestSpec): !Digest<any, Digest, DigestBuilder>
  downsample:              member function(spec: !DownsampleSpec): Stream<E>
  leastSquares:            member function(): !LeastSquaresResult
  rollingDiff:             member function(stride: int = 1): Stream<E>
  pctChange:               member function(stride: int = 1): Stream<E>
  unaryOp:                 member function(op: !string enum UnaryOp): Stream<E>
  shape:                   member function(): [int]
  toObj:                   member function(): Obj
  fetch:                   member function(spec: FetchSpec): Stream<E>

  largest: member function(n: !int, comparator: lambda(a: E, b: E): @comparator int32, keep: string enum KeepOp): [E]

  histogram:          member function(spec: HistogramSpec): !Histogram<any, any, HistogramBuilder>
  neg:                member function(): Stream<E>
  approxMostFrequent: member function(spec: CountMinSketchSpec): map<string, int>
  timeseries:         member function<R>(spec: DataTimeseriesSpec): Stream<R>

  timeseries: member function<R>(tsFieldSpec: !map<string, TimeseriesFieldSpec>, spec: TimeseriesSpec): Stream<R>

  elementType: member function(): !ValueType
  stream:      member function(): stream<E>
}
