@beta
abstract type CollectionStdLib<E> mixes Value {

  iter:              abstract inline member function(): Iterator<E> java | js
  _iter_:            private abstract inline member function(): native java | js
  _length_:          private abstract inline member function(): !int java | js
  size:              abstract inline property(): !int java | js
  isEmpty:           abstract inline member function(): boolean java | js
  collect:           abstract member function(limit: int): [E] java | js
  collectArrays:     abstract member function<T>(limit: int): [[T]] java | js
  abs:               abstract member function(): mixing CollectionStdLib<E> java | js
  aggImplementation: abstract member function<R>(spec: !?AggSpec, op: !string enum AggOp): R java | js
  aggImplementation: abstract member function<R>(spec: !?AggSpec, aggregator: !lambda(a: R, b: E): R): R java | js

  aggImplementation: abstract member function<T, R>(spec: !?AggSpec,
                                                    folder: !lambda(accumulator: T, e: E): T,
                                                    aggregator: !lambda(aggregated: R, e: T): R): R java | js

  sumDbl:    abstract member function(): !double java | js
  sumDiff:   abstract member function(absoluteValues: boolean): !double java | js
  cusum:     abstract member function(threshold: double = 1, drift: double = 0): [int] java | js
  normalize: abstract member function(): mixing CollectionStdLib<E> java | js
  at:        abstract member function(index: !int): E java | js

  pluck: abstract member function<T>(fieldPath: !?string serialized FieldPath,
                                     vtOverride: ValueType): mixing CollectionStdLib<T> java | js

  first:             abstract member function(): E java | js
  first:             abstract member function(n: !int): mixing CollectionStdLib<E> java | js
  first:             abstract member function(test: !lambda(e: E): boolean): E java | js
  firstNotNull:      abstract member function(): !?E java | js
  firstNotNull:      abstract member function<T>(mapper: !lambda(e: E): T): !?T java | js
  firstNotEmpty:     abstract member function(): !E java | js
  firstNotEmpty:     abstract member function<T>(mapper: !lambda(e: E): T): !T java | js
  last:              abstract member function(): E java | js
  last:              abstract member function(n: !int): mixing CollectionStdLib<E> java | js
  last:              abstract member function(test: !lambda(e: E): boolean): E java | js
  lastNotNull:       abstract member function(): !?E java | js
  lastNotNull:       abstract member function<T>(mapper: !lambda(e: E): T): !?T java | js
  lastNotEmpty:      abstract member function(): !E java | js
  lastNotEmpty:      abstract member function<T>(mapper: !lambda(e: E): T): !T java | js
  minImplementation: abstract member function(spec: AggSpec): E java | js
  minImplementation: abstract member function(comparator: !lambda(a: E, b: E): @comparator int32): E java | js
  minBy:             abstract member function(value: !lambda(e: E): any): E java | js
  maxImplementation: abstract member function(spec: AggSpec): E java | js
  maxImplementation: abstract member function(comparator: !lambda(a: E, b: E): @comparator int32): E java | js
  maxBy:             abstract member function(value: !lambda(e: E): any): E java | js
  count:             abstract member function<R>(spec: AggSpec): R java | js
  sumImplementation: abstract member function<R>(spec: AggSpec): R java | js
  allImplementation: abstract member function<R>(spec: AggSpec): R java | js
  prod:              abstract member function<R>(spec: AggSpec): R java | js
  avg:               abstract member function<R>(): R java | js
  avgDbl:            abstract member function(): !double java | js
  median:            abstract member function<R>(): R java | js
  medianDbl:         abstract member function(): !double java | js
  percentile:        abstract member function<R>(percentile: !double): R java | js
  percentileDbl:     abstract member function(percentile: !double): !double java | js
  stddev:            abstract member function<R>(): R java | js
  stddevDbl:         abstract member function(): !double java | js
  variance:          abstract member function<R>(): R java | js
  varianceDbl:       abstract member function(): !double java | js
  aggDbl:            abstract member function(aggFunc: !string enum AggOp, percentile: double): !double java | js
  round:             abstract member function(decimals: int): mixing CollectionStdLib<E> java | js
  invert:            abstract member function(): mixing CollectionStdLib<E> java | js
  only:              abstract member function(failIfNotSingleton: boolean): E java | js
  contains:          abstract member function(element: !?any): boolean java | js
  containsAll:       abstract member function(elements: E ...): boolean java | js
  containsAll:       abstract member function(c: !?Collection<E>): boolean java | js
  containsAll:       abstract member function(predicate: !lambda(e: E): boolean): boolean java | js
  containsAny:       abstract member function(predicate: !lambda(e: E): boolean): boolean java | js
  findAny:           abstract member function(predicate: !lambda(e: E): boolean): E java | js
  findAny:           abstract member function(fields: !?map<string, any>): E java | js
  anyNotNull:        abstract member function(): !?E java | js
  anyNotNull:        abstract member function<T>(mapper: !lambda(e: E): T): !?T java | js
  anyNotEmpty:       abstract member function(): !E java | js
  anyNotEmpty:       abstract member function<T>(mapper: !lambda(e: E): T): !T java | js
  each:              abstract member function(action: !lambda(e: E)) java | js
  eachWhile:         abstract member function(action: !lambda(e: E): boolean): boolean java | js
  mapToSame:         abstract member function(mapper: !lambda(e: E): E): mixing CollectionStdLib<E> java | js
  map:               abstract member function<T>(mapper: !lambda(e: E): T): mixing CollectionStdLib<T> java | js
  mapToStr:          abstract member function(mapper: !lambda(e: E): string): mixing CollectionStdLib<string> java | js

  mapTo: abstract member function<T>(elementType: !ValueType,
                                     mapper: !lambda(e: E): T): mixing CollectionStdLib<T> java | js

  flatMapToSame: abstract member function(mapper: !lambda(e: E): CollectionStdLib<E>): mixing CollectionStdLib<E> java | js

  flatMap: abstract member function<T>(mapper: !lambda(e: E): CollectionStdLib<T>): mixing CollectionStdLib<T> java | js

  flatMapTo: abstract member function<T>(elementType: !ValueType,
                                         mapper: !lambda(e: E): CollectionStdLib<T>): mixing CollectionStdLib<T> java | js

  flatMapRecursive: abstract member function<I>(toInters: !lambda(e: E): CollectionStdLib<I>,
                                                fromInter: !lambda(i: I): E): mixing CollectionStdLib<E> java | js

  fold:     abstract member function<T>(folder: !lambda(e: E, accumulator: T): T): T java | js
  fold:     abstract member function<T>(initial: !?T, folder: !lambda(e: E, accumulator: T): T): T java | js
  compact:  abstract member function(): mixing CollectionStdLib<E> java | js
  unique:   abstract member function(): mixing CollectionStdLib<E> java | js
  uniqueBy: abstract member function(key: lambda(e: E): any): mixing CollectionStdLib<E> java | js
  filter:   abstract member function(predicate: !lambda(e: E): boolean): mixing CollectionStdLib<E> java | js
  filter:   abstract member function(filter: !?string serialized Expr): mixing CollectionStdLib<E> java | js
  filter:   abstract member function(fields: !?map<string, any>): mixing CollectionStdLib<E> java | js

  fillMissingBy: abstract member function(method: string enum FillMethod = PREVIOUS,
                                          spec: FillMissingSpec): mixing CollectionStdLib<E> java | js

  fillMissing:    abstract member function(value: !any, spec: FillMissingSpec): mixing CollectionStdLib<E> java | js
  fieldNames:     abstract member function(): [string] java | js
  fieldValueType: abstract member function(field: !string): ValueType java | js
  reject:         abstract member function(predicate: !lambda(e: E): boolean): mixing CollectionStdLib<E> java | js
  include:        abstract member function(include: !?string serialized Include): mixing CollectionStdLib<E> java | js
  include:        abstract member function(positions: !Collection<int>): mixing CollectionStdLib<E> java | js
  exclude:        abstract member function(exclude: !?string serialized Include): mixing CollectionStdLib<E> java | js

  replaceByPredicate: abstract member function(e: !?E,
                                               predicate: !lambda(e: E): boolean): mixing CollectionStdLib<E> java | js

  sorted: abstract member function(descending: boolean): mixing CollectionStdLib<E> java | js

  sorted: abstract member function(comparator: !lambda(a: E, b: E): @comparator int32): mixing CollectionStdLib<E> java | js

  sorted: abstract member function(descending: !boolean,
                                   comparator: !lambda(a: E, b: E): @comparator int32): mixing CollectionStdLib<E> java | js

  sorted:   abstract member function(order: !?string): mixing CollectionStdLib<E> java | js
  sortedBy: abstract member function(key: !lambda(e: E): any): mixing CollectionStdLib<E> java | js

  sortedBy: abstract member function(descending: !boolean,
                                     key: !lambda(e: E): any): mixing CollectionStdLib<E> java | js

  sortedIndex:             abstract member function(element: !E, value: !lambda(e: E): any): !int java | js
  sortedIndex:             abstract member function(element: !E, fieldName: !string): !int java | js
  batch:                   @java(returnWildcardVarBindings=true) abstract member function(batchSize: int)
                                                                                   : stream<mixing CollectionStdLib<E>> java | js
  partition:               abstract member function(partitioner: !lambda(e: E): boolean): map<boolean, [E]> java | js
  countBy:                 abstract member function(key: !lambda(e: E): string): map<string, int> java | js
  countBy:                 abstract member function<T>(keyType: !ValueType,
                                                       key: !lambda(e: E): T): map<T, int> java | js
  every:                   abstract member function(predicate: !lambda(e: E): boolean): boolean java | js
  elementCartesianProduct: abstract member function<T>(): [[T]] java | js
  flatten:                 abstract member function<T>(shallow: boolean): mixing CollectionStdLib<T> java | js

  flatten: abstract member function<T>(depth: !int,
                                       include: string serialized Include): mixing CollectionStdLib<T> java | js

  sample:     abstract member function(spec: SampleSpec): mixing CollectionStdLib<E> java | js
  slice:      abstract member function(fromPos: !int, toPos: int, stride: int): mixing CollectionStdLib<E> java | js
  slice:      abstract member function(positions: !?Collection<int>): mixing CollectionStdLib<E> java | js
  sliceByKey: abstract member function(keys: !?Collection<any>): mixing CollectionStdLib<E> java | js

  sliceByKey: abstract member function(secondaryIndex: !string,
                                       keys: !?Collection<any>): mixing CollectionStdLib<E> java | js

  summarize:    abstract member function(spec: DigestSpec): !Digest<any, Digest, DigestBuilder> java | js
  downsample:   abstract member function(spec: !DownsampleSpec): mixing CollectionStdLib<E> java | js
  leastSquares: abstract member function(): !LeastSquaresResult java | js
  rollingDiff:  abstract member function(stride: int = 1): mixing CollectionStdLib<E> java | js
  pctChange:    abstract member function(stride: int = 1): mixing CollectionStdLib<E> java | js
  unaryOp:      abstract member function(op: !string enum UnaryOp): mixing CollectionStdLib<E> java | js
  shape:        abstract member function(): [int] java | js
  toObj:        abstract member function(): Obj java | js
  fetch:        abstract member function(spec: FetchSpec): mixing CollectionStdLib<E> java | js

  largest: abstract member function(n: !int,
                                    comparator: lambda(a: E, b: E): @comparator int32,
                                    keep: string enum KeepOp): [E] java | js

  histogram:          abstract member function(spec: HistogramSpec): !Histogram<any, any, HistogramBuilder> java | js
  neg:                abstract member function(): mixing CollectionStdLib<E> java | js
  approxMostFrequent: abstract member function(spec: CountMinSketchSpec): map<string, int> java | js
  timeseries:         abstract member function<R>(spec: DataTimeseriesSpec): mixing CollectionStdLib<R> java | js

  timeseries: abstract member function<R>(tsFieldSpec: !map<string, TimeseriesFieldSpec>,
                                          spec: TimeseriesSpec): mixing CollectionStdLib<R> java | js

  elementType: abstract member function(): !ValueType java | js
  stream:      abstract member function(): stream<E> java | js
}
