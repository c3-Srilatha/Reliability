/**
 * Cache for basic SimpleMetric info
 */
private type ListenerMetricsCache mixes MetadataCacheOld<ListenerMetricsCacheEntry>, Value {

  /**
   * @return All metrics used by analytics or metrics listener
   */
  metrics: function(): !ListenerMetricsCacheEntry

  /**
   * Gets a specific metric by its name and src type
   *
   * @param metricName
   *        Metric name.
   * @param srcType
   *        Source type.
   *
   * @return Requested metric.
   */
  metricForNameAndSrcType: inline function(metricName: !string, srcType: !string): string

  /**
   * Gets a specific metric by its name and src type id
   *
   * @param metricName
   *        Metric name.
   * @param srcTypeId
   *        Source type id.
   *
   * @return Requested metric.
   */
  metricForNameAndSrcTypeId: inline function(metricName: !string, srcTypeId: !int): string

  /**
   * @return Ids of all metrics that have listeners.
   */
  metricIds: inline function(): [string]

  /**
   * Gets ids of all metrics for a source type.
   *
   * @param srcType
   *        Source type to get metrics for.
   *
   * @return Ids of all metrics for a source type.
   */
  metricIdsForSrcType: inline function(srcType: !string): [string]

  /**
   * Gets requested metrics for a source type.
   *
   * @param srcType
   *        Source type to get metrics for.
   * @param metricIds
   *        If provided, only metrics matching the specified ids will be returned, otherwise, all will be.
   *
   * @return The requested metrics for a source type.
   */
  metricsForSrcType: inline function(srcType: Type, metricIds: [string]): [SimpleMetric]

  /**
   * Gets all backward metric deps for a type.
   *
   * @param type
   *        Type to get backward deps for.
   *
   * @return All backward metric deps for a type.
   */
  bwdDepsForType: inline function(type: !Type): [TypeBackwardDep]
}
