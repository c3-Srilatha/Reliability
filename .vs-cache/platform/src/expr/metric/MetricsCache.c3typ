/**
 * Type for caching metric results.  Each entry is for invalidating the metrics cache for a single source instance.
 */
@db(datastore="kv")
entity type MetricsCache schema name 'metric_MetricsCache' {

  /**
   * id is generated by pathId(METRIC_NAME)-INTERVAL-typeId(SRC_TYPE)-SRC_ID
   */
  result: Obj
}
