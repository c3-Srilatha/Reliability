/**
 * Type to indicate the cache size (memory) for the evaluator, normalized data and tsDecl data
 */
type EvalMetricsBatchCacheSize {

  /**
   * Cache size holding the evaluator instance which includes compiled exprs, parsed ASTs, simple metrics, compound metrics,
   * source type fetch results with hierarchies and other information to be used during evaluation
   */
  evaluator: double

  /**
   * Cache size holding normalized timeseries data. This will typically be a NormalizedTimeseries object
   */
  normalized: double

  /**
   * Cache size holding fetched data points to be used for tsDecl calculation
   */
  tsDecl: double
}
