/**
 * Various info for analytics listeners used internally for invalidation for metrics
 */
private type ListenerMetricsCacheEntry {

  /**
   * Metrics that have listeners.
   */
  metrics: map<string, SimpleMetric>

  /**
   * Listener metrics grouped by name + src type.
   */
  metricsByNameAndSrcType: map<string, string>

  /**
   * Listener metrics grouped by src type
   */
  metricsBySrcType: map<string, [string]>

  /**
   * Backward dependencies based on the metrics.
   */
  bwdDeps: map<string, [TypeBackwardDep]>
}
