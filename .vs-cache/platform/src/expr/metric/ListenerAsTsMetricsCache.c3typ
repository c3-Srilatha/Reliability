/**
 * Cache for basic SimpleMetric info
 */
private type ListenerAsTsMetricsCache mixes MetadataCacheOld<ListenerAsTsMetricsCacheEntry>, Value {

  /**
   * @return all metrics used by analytics or metrics listener
   */
  metrics: function(): !ListenerAsTsMetricsCacheEntry

  /**
   * Determines if a type is used as a logical timeseries header type in any AsTs metric.
   *
   * @param type
   *        Type to check
   *
   * @return True if the type is used as a logical timeseries header type in any AsTs metric.
   */
  isAsTsHeaderType: inline function(type: !Type): boolean
}
