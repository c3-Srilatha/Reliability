/**
 * Type for holding metrics statistics
 */
@db(systemType=true, compactType=true)
entity type MetricsStats schema name 'METRIC_MTST' {

  /**
   * srcId_pathId(srcTypeName)_pathId(interval)_pathId(metricName)
   */
  id: string

  /**
   * Timeseries stats for this source / metric combination
   */
  stats: TimeseriesStats

  /**
   * hash of all the fields in this type. This can be used to compare metric results when data changes
   */
  valueHash: int

  /**
   * src id for which the statistic is computed
   */
  srcId: string

  /**
   * metric id for which the statistic is computed. It is the pathId for the metric that gets stored here.
   */
  metricId: int
}
