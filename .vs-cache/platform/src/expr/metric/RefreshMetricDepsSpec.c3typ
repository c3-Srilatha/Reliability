/**
 * Options that control {@link SimpleMetric.refreshMetricDeps}.
 */
type RefreshMetricDepsSpec mixes ObjBatch, Spec {

  /**
   * List of metric ids to process.  If {@link} srcType is also specified, then only those metrics that have the same source type will be processed.  Others will
   * be ignored.  If this parameter is not specified then all metrics (or all metrics for the srcType) will be processed.
   */
  metricIds: [string]

  /**
   * Source type to process.  If specified, then only metrics for that source type will be processed.  If not specified, then metrics from multiple source types
   * will be processed.
   */
  srcType: Type

  /**
   * If true, all metrics/analytics for computed dependencies will be refreshed.  Note that no check is made to see if the dependency already exists.
   */
  refreshAnalytics: boolean
}
