/**
 * Computes the priorities for source objs and their metric groups/names to use for invalidation queue entries and stores the results in
 * MetricPriority.
 */
entity type MetricPriorityJob extends MapReduce<Obj, void, void, void> type key 'MTRCPRI' {

  /**
   * Name of concrete {@link MetricPriorityProvider} type to use for the job.
   */
  provider: !string

  /**
   * Computes the priorities for either a single {@link MetricPriorityProvider} or all that are defined.
   *
   * @param typeName
   *           If specified, the name of priority provider type (type that mixes {@link MetricPriorityProvider}) to call to get actual priorities.
   *           If not specified, then all providers will be processed.
   * @return the id of the mapReduce job performing the action if {@link typeName} was specified and null otherwise.
   */
  computePriorities: function(typeName: string): string
}
