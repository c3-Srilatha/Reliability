/**
 * Results from metric evaluation operations in the C3 AI Agentic Platform.
 *
 * In the C3 AI Agentic Platform, EvalMetricsResult contains the output from evaluating metrics
 * using {@link MetricEvaluatable#evalMetrics} or {@link MetricEvaluatable#evalMetricsWithMetadata}.
 * Provides structured access to {@link Timeseries} data, evaluation plans, error information,
 * and utilities for data transformation and visualization.
 *
 * Key Use Cases:
 * 1. Metric Analysis: Access computed metric values across multiple sources and time periods
 * 2. Data Visualization: Transform results for charts and dashboards using built-in renderers
 * 3. Error Handling: Track evaluation failures when using continueOnError option
 * 4. Performance Monitoring: Analyze evaluation plans and execution timing details
 * 5. Data Export: Convert results to various formats (DataTable, pandas DataFrame)
 *
 * Result Structure:
 * - Primary data organized as: sourceId -> resultKey -> {@link Timeseries}
 * - Alternative view available via {@link #byMetrics}: resultKey -> sourceId -> {@link Timeseries}
 * - Error tracking per source when evaluation failures occur
 * - Optional evaluation plan for performance analysis and debugging
 *
 * IMPORTANT: Result Key Customization
 * The inner map key in {@link #result} serves as the identifier for each evaluated metric.
 * By default, this key is the metric name from the expression. However, when 
 * {@link EvalMetricsSpec#resultKey} is specified in the evaluation specification,
 * this custom lambda function generates the result keys, allowing for dynamic key naming based
 * on expression names, bindings, and other evaluation context.
 *
 * Integration Patterns:
 * - Triggered by {@link MetricEvaluatable} implementations on entity Types
 * - Consumed by UI components for metric dashboards and analytics
 * - Processed by data pipelines for metric aggregation and reporting
 * - Used with {@link EvalMetricsSpec} for configuring evaluation parameters
 *
 * Performance Characteristics:
 * - Optimized for read access to metric data across multiple sources
 * - Supports efficient data flattening and transformation operations
 * - Memory-efficient storage of large metric result sets
 * - Built-in caching support through evaluation specifications
 *
 * Related Types:
 * - {@link EvalMetricsSpec} - Configuration for metric evaluation operations
 * - {@link MetricEvaluatable} - Interface for Types that support metric evaluation
 * - {@link Timeseries} - Individual metric value sequences with temporal data
 * - {@link EvalPlan} - Execution plan details for performance analysis
 *
 * @see EvalMetricsSpec
 * @see MetricEvaluatable
 * @see Timeseries
 * @see EvalPlan
 * @see metrics-evaluating-metrics.c3doc.md
 * @see metrics-bindings.c3doc.md
 * @see metrics-home.c3doc.md
 */
type EvalMetricsResult mixes HtmlRenderable, EvalMetricsResultBase {

  /**
   * Primary metric evaluation results organized by source and result identifiers.
   *
   * Structure: `map<sourceId, map<resultKey, Timeseries>>`
   * - Outer map key: ID of the source object on which metrics were evaluated
   * - Inner map key: Result identifier for each metric, which can be either:
   *   1. The original metric name from the expression (default behavior)
   *   2. A custom key generated by {@link EvalMetricsSpec#resultKey} lambda function
   *
   * When accessing specific metrics (e.g., via {@link #timeseries}), use the inner map key
   * as the identifier. This key may differ from the original metric name when 
   * {@link EvalMetricsSpec#resultKey} is specified in the evaluation specification.
   *
   * @see EvalMetricsSpec#resultKey
   * @see #timeseries
   * @see #byMetrics
   */
  result: map<string, map<string, any>>

  /**
   * Detailed evaluation plan containing execution metadata and performance analysis.
   *
   * Populated when {@link EvalMetricsSpec#explain} is set to true in the evaluation specification.
   * Contains information about expression parsing, metric resolution, execution timing, and
   * optimization details. Useful for debugging performance issues and understanding metric
   * evaluation behavior.
   *
   * @see EvalMetricsSpec#explain
   * @see EvalPlan
   */
  evalPlan: EvalPlan

  /**
   * Error information for failed metric evaluations by source object.
   *
   * Structure: sourceId -> error message
   * Populated only when {@link EvalMetricsSpec#continueOnError} is set to true, allowing
   * evaluation to continue despite failures for specific source/metric combinations.
   * Sources with successful evaluations will not appear in this map.
   *
   * @see EvalMetricsSpec#continueOnError
   */
  errors: map<string, string>

  /**
   * Provides an alternative view of evaluation results organized by result key rather than source.
   *
   * Transforms the default source-first organization from {@link #result} 
   * (`sourceId -> resultKey -> Timeseries`) into a result-key-first organization 
   * (`resultKey -> sourceId -> Timeseries`).
   *
   * Example transformation:
   * Original {@link #result} structure:
   * ```
   * {
   *   "srcId1": { "Metric1": Timeseries1, "Metric2": Timeseries2 },
   *   "srcId2": { "Metric1": Timeseries3, "Metric2": Timeseries4 }
   * }
   * ```
   *
   * Transformed byMetrics structure:
   * ```
   * {
   *   "Metric1": { "srcId1": Timeseries1, "srcId2": Timeseries3 },
   *   "Metric2": { "srcId1": Timeseries2, "srcId2": Timeseries4 }
   * }
   * ```
   *
   * This view is particularly useful for metric-centric analysis and visualization
   * where you want to compare the same metric across different sources.
   *
   * @return
   *    Results organized by result key, then by source ID.
   *
   * @see #result
   */
  byMetrics: member function(): map<string, map<string, any>>

  /**
   * Retrieves the {@link Timeseries} for a specific metric and source combination.
   *
   * @param metricName
   *    The result key for the desired {@link Timeseries}. This corresponds to the inner map key
   *    in {@link #result}. By default, this is the metric name from the original expression,
   *    but when {@link EvalMetricsSpec#resultKey} is specified in the evaluation specification,
   *    this should be the custom key generated by that lambda function.
   * @param srcId
   *    The source object ID for which the {@link Timeseries} is desired. Required.
   * @return
   *    The {@link Timeseries} for the specified metric and source combination.
   *
   * @see EvalMetricsSpec#resultKey
   * @see #result
   */
  timeseries: member function(metricName: !string, srcId: !string): TimeseriesBase

  /**
   * Extracts all {@link Timeseries} objects from the evaluation results as a flat array.
   *
   * Iterates through all source-metric combinations in {@link #result} and collects
   * every {@link Timeseries} into a single array. Useful for bulk operations, 
   * statistical analysis, or when you need to process all metric data regardless
   * of source or metric organization.
   *
   * @return
   *    Array containing all {@link Timeseries} objects from the evaluation results.
   *
   * @see #result
   * @see #timeseries
   */
  allTimeseries: member function(): [TimeseriesBase]

  /**
   * Client-side visualization component for rendering metric results as charts.
   *
   * Provides built-in charting capabilities to visualize all {@link Timeseries} 
   * from the evaluation results on a single chart. Automatically handles
   * time alignment, scaling, and legend generation for multiple metrics
   * and sources.
   *
   * @see #allTimeseries
   */
  renderer: ~ js-client

  /**
   * Localized display labels for metrics organized by result key.
   *
   * Structure: `map<resultKey, translatedLabel>`
   * Populated when {@link EvalMetricsSpec#locale} is specified in the evaluation
   * specification. Maps the same keys used in {@link #result} to their translated,
   * human-readable labels in the requested locale.
   *
   * Note: The keys in this map correspond to the inner map keys from {@link #result},
   * which may be customized by {@link EvalMetricsSpec#resultKey}, not necessarily 
   * the original metric names.
   *
   * @see EvalMetricsSpec#locale
   * @see EvalMetricsSpec#resultKey
   * @see Translation
   */
  translations: map<string, string>

  // / **
  // * Get Metric Evaluation Result as a pandas DataFrame.
  // *
  // * @param result
  // *            The result of the metric evaluation.
  // * @param expressions
  // *           A list of expressions to include in the pandas DataFrame.
  // * @return Metric Evaluation Result as a pandas DataFrame
  // * /
  // toPandas: inline function(result: !EvalMetricsResult, expressions: [string]): native py-mlutils_2_0_0
  // / **
  // * Convert Metric Evaluation Result to a native NdArray and corresponding metadata.
  // *
  // * @param result
  // *            The result of the metric evaluation.
  // * @param dimensions
  // *            A string in enum('2D', '3D') to specify the desired shape of the output.
  // * @param expressions
  // *           A list of expressions
  // * @return Pair of NdArray of Metric Evaluation Result data and its indices as metadata.
  // * /
  // toNdArray: inline function(result: !EvalMetricsResult,
  // dimensions: string enum('2D', '3D'),
  // expressions: [string]): NativeNdArray py-mlutils_2_0_0

  /**
   * Converts metric evaluation results into a flattened {@link Data} table format.
   *
   * Transforms the nested result structure into a tabular format where each row
   * represents a single time point for a source-metric combination. The resulting
   * table includes columns for sourceId, timestamp, and each metric value.
   *
   * Example output structure:
   * ```
   * | sourceId  | start      | TotalConsumption | AvgConsumption |
   * |-----------|------------|------------------|----------------|
   * | building1 | 2010-01-01 | 3                | 0.9            |
   * | building1 | 2010-01-02 | 4                | 1.1            |
   * | building1 | 2010-01-03 | 5                | 2.1            |
   * | building2 | 2010-01-01 | 13               | 10.9           |
   * | building2 | 2010-01-02 | 14               | 10.1           |
   * | building2 | 2010-01-03 | 15               | 13.1           |
   * ```
   *
   * @return
   *    Flattened {@link Data} representation with time-series data in tabular format.
   *
   * @see #flattenedType
   * @see #result
   */
  @deprecated(finalVersion="8.8", details="This method will be removed in future releases.")
  toData: member function(): Data

  /**
   * Generates a dynamic {@link Type} definition for flattened metric result data.
   *
   * Creates a {@link Type} schema that can be used to store the evaluation results
   * in a flattened, tabular format. The generated Type includes fields for source
   * identification, timestamps, and individual metric columns based on the specific
   * metrics present in the evaluation results.
   *
   * Generated Type structure:
   * ```
   * @db(partitionKeyField="sourceId")
   * type Obj_<DynamicTypeSuffix> mixes Partitionable<string> {
   *   sourceId: string
   *   start: datetime
   *   HeartRate: Timeseries<double>
   *   WbcCount: Timeseries<double>
   *   // ... additional fields for each metric in results
   * }
   * ```
   *
   * This Type can be used for persistent storage, data processing, or integration
   * with systems that require strongly-typed schemas for metric data.
   *
   * @return
   *    Dynamically generated {@link Type} definition suitable for storing flattened results.
   *
   * @see #toData
   * @see Partitionable
   */
  flattenedType: member function(): !Type

  /**
   * Determines the most commonly used interval across all {@link Timeseries} in the results.
   *
   * When evaluation results contain {@link Timeseries} with different temporal intervals
   * (e.g., some hourly, some daily), this method analyzes all series and returns the
   * interval that appears most frequently. Useful for determining a common temporal
   * resolution for data processing or visualization operations.
   *
   * @return
   *    The most frequently occurring {@link Interval} among all {@link Timeseries} in the results.
   *
   * @see #allTimeseries
   * @see Interval
   */
  mostFrequentInterval: private member function(): !string serialized Interval
}
