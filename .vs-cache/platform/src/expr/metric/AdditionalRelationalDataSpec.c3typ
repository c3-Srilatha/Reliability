/**
 * Spec for exporting data for individual types
 */
type AdditionalRelationalDataSpec mixes Metadata, Identified {

  /**
   * Foreign key to `AdditionalExportSpec`
   */
  exportSpec: AdditionalExportSpec

  /**
   * Type for which data needs to be exported
   */
  typeName: string

  /**
   * Include string on the type
   */
  include: string

  /**
   * Filter spec on the type
   */
  filter: string

  /**
   * Append source to the filter
   */
  doAppendSourceId: boolean
}
