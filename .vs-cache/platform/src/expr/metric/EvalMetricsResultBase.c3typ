/**
 * Helper functions for converting EvalMetricsResult and EvalMetricsResult Stream to streams.
 */
private type EvalMetricsResultBase {

  /**
   * Converts existing eval metrics result to a new one with the given interval and aggregation
   * @param interval
   *            The interval to convert to. If not provided, will choose the #mostFrequentInterval
   * @param agg
   *            Aggregation function per metric if we are merging features in this set by aggregating or disaggregating on time
   *            interval. If not provided, will choose default agg function of SUM
   * @return The new EvalMetricsResultBase with the given interval and aggregation
   */
  toInterval: member function(interval: string serialized Interval,
                              agg: map<string, string serialized AggOp> | string serialized AggOp)
                       : mixing EvalMetricsResultBase

  /**
   *  Converts existing eval metrics result to a new one with the given period and aggregation
   *
   *  For Example:
   *  ```
   *  emr.toPeriod("2W@5", "SUM") converts to biWeekly Period starting from Friday.
   *
   *  emr.toPeriod("Q@1", {"metric1": "SUM", "metric2": "AVG"}) converts to quarterly Period, with quarter starting from January
   *  metric1 is aggregated with SUM and metric2 is aggregated on AVG.
   *  ```
   *
   * For aggregation, all the data points in the period will be aggregated with the agg functions specified,
   * but for disaggregation, **the values are prorated depending on the data points in the interval** (in the below examples its the days in the interval)
   * ```js
   * ti = TimeInfo.from(DateTime.fromString("2023-04-01"), DateTime.fromString("2023-07-01"), Interval.DAY, TimeZone.NONE)
   * let arr = new Array(91);
   * arr.fill(1, 0, 30);
   * arr.fill(2, 30, 60);
   * arr.fill(3, 60, 91);
   * ts = Timeseries.fromValues(ti, arr).toDoubleTimeseries();
   * emr = C3.EvalMetricsResult.make({'result': {"source1": {"metric1": ts}}})
   * emr.toInterval('MONTH', 'SUM').toPeriod('W@2','SUM'))
   * ```
   *
   *  ```
   *  ----------------------------
   *     timestamp   |    value
   *     2023-03-28  |    3
   *     2023-04-04  |    7
   *         *       |    *
   *         *       |    *
   *     2023-04-25  |    8.03226
   *         *       |    *
   *         *       |    *
   *     2023-06-27  |    12
   *  ----------------------------
   *  ```
   * In the above example, the first data point will be for 2023-03-28, with value 3 as we only have 3 days of this week in the first month (30/30 * 3) = 3.
   * Week starting from 2023-04-25 has 6 days in the first month and 1 day in the next month, where the values are prorated depending on the days in the interval. (30/30 * 6) + (63/31 * 1) = 8.03226.
   * Week starting from 2023-06-27 only has 4 days in the interval with 4*(90/30) = 12
   *
   *  @param period
   *             The period to convert to.
   *  @param agg
   *             Aggregation function per metric if we are merging features in this set by aggregating or disaggregating on given
   *             period. If not provided, will choose default agg function of SUM
   *  @return The new EvalMetricsResultBase with the given period and aggregation
   */
  toPeriod: member function(period: !string serialized Period,
                            agg: map<string, string serialized AggOp> | string serialized AggOp)
                     : mixing EvalMetricsResultBase

  /**
   * Filter the results by the given as of or masked metric in the Feature.Set and return only the filtered rows
   * as a stream of Pair<subject, [Timestamp, FeatureName]>. Result is keyed by subject
   */
  toDataColumns: private member function(set: !Feature.Set): stream<Pair<string, [Data.Column]>>

  /**
   * Filter the results by the given asOf or masked metric in the array of features and return only the filtered rows
   * as a stream of Pair<subject, [Timestamp, FeatureName]>
   * @param keep
   *            If keep is set to true, then mask Timeseries will be inverse of the dates / time range passed in the filter
   * @param filterMetric
   *            the metric to be used for masking other eval metric results.
   * @see Timeseries#convertToMask
   */
  toDataColumns: member function(features: ![Feature],
                                 keep: boolean,
                                 filterMetric: string): stream<Pair<string, [Data.Column]>>

  /**
   * Find all the legacy features in the Feature.Set and include the Feature.Set's maskFeature or asOfFeature if it is not
   * declared in {@link Feature.Set#featureDecls}
   */
  allAndFilterFeatures: function(set: !Feature.Set): Pair<![Feature], string>

  /**
   * Merge multiple EvalMetricsResultBase together.
   */
  merge: member function(other: mixing EvalMetricsResultBase): mixing EvalMetricsResultBase
}
