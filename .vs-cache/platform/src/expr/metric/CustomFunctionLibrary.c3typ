/**
 * A singleton (to pkg) instance which will hold a (java) native instance of
 * **c3.platform.expr.metric.CustomFunctionLibrary** which has all the custom expression engine functions defined in
 * the pkg.
 */
private type CustomFunctionLibrary mixes Singleton {

  /**
   * @return a cached instance of the **c3.platform.expr.metric.CustomFunctionLibrary**
   */
  nativeLib: cached property(): @java(class="c3.platform.expr.CustomFunctionLibraryNative") native

  /**
   * @return a cached instance of the **c3.todo.expr.OldCustomFunctionLibrary**.
   * **This is to scheduled to be deleted. Please don't use.**
   */
  oldNativeLib: cached property(): @java(class="c3.todo.expr.OldCustomFunctionLibrary") native
}
