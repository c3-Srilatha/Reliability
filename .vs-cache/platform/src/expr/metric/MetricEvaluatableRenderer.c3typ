/**
 * Render the objects available for a source object to HTML.
 */
type MetricEvaluatableRenderer mixes HtmlRenderer {

  m_source: private MetricEvaluatable
  create:   inline function(arg: !MetricEvaluatable) js-client

  /**
   * Get the list of "sets" of metrics, which are logical groups the user might care about.
   */
  metricSets: inline function(): [string] js

  /**
   * Get all possible metrics for the specified type, for the given metric set.
   */
  listMetrics: inline function(type: !Type, set: string): [string]

  menuTitle: inline ~ js-client
  title:     ~ js-client
  render:    ~ js-client
  dispose:   ~ js-client
}
