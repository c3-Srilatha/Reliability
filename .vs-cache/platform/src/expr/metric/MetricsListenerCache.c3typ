/**
 * Cache for metrics listeners
 */
type MetricsListenerCache mixes MetadataCacheOld<MetricsListenerCacheEntry>, Value {

  /**
   * @return The contents of the cache
   */
  info: function(): !MetricsListenerCacheEntry

  /**
   * @return True if there is a listener for the metric
   */
  hasListener: function(metricId: !string): !boolean

  /**
   * @return A list of all metrics that have listeners.
   */
  metrics: inline function(): [string]

  /**
   * Gets the list of ids of metrics for a source type that have listeners.
   *
   * @param srcType
   *        Source type to check.
   *
   * @return A List of ids of metrics for the requested source type that have listeners.
   */
  metricsForSrcType: inline function(srcType: !Type): [string]
}
