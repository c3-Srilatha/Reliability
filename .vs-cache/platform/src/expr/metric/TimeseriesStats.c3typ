/**
 * Type for holding timeseries statistics
 */
type TimeseriesStats {

  /**
   * minimum value for the timeseries
   */
  min: double

  /**
   * maximum value for the timeseries
   */
  max: double

  /**
   * avg value for the timeseries
   */
  avg: double

  /**
   * median value for the timeseries
   */
  median: double

  /**
   * count of raw data points for the timeseries
   */
  count: int

  /**
   * earliest raw data point for the timeseries
   */
  earliest: datetime

  /**
   * latest raw data point for the timeseries
   */
  latest: datetime

  /**
   * missing percentage for the timeseries
   */
  missing: byte

  /**
   * 10th percentile of the timeseries
   */
  p10: double

  /**
   * 25th percentile of the timeseries
   */
  p25: double

  /**
   * 75th percentile of the timeseries
   */
  p75: double

  /**
   * 90th percentile of the timeseries
   */
  p90: double
}
