/**
 * Map reduce type for metric stats job
 */
entity type MetricsStatsJob extends MapReduce<Obj, int, int, int> type key 'MTRSJ' {

  /**
   * list of metrics for which stats need to be computed
   */
  metricNames: [string] schema name 'MN'

  /**
   * evaluation start date for computing metric stats
   * default: 5 years before the end date
   */
  startDate: datetime

  /**
   * evaluation end date for computing metric stats
   * default: 1st day of the current year
   */
  endDate: datetime

  /**
   * evaluation interval for computing metric stats
   */
  interval: string

  /**
   * This indicates that we need to compare values against the previously computed stats.
   * default: false
   */
  testHash: boolean

  /**
   * no of sources to be used in one batch
   */
  batchSize: ~ = '100'

  /**
   * fields to be included on the source type
   */
  include: ~ = 'id'

  map: ~ js-server
}
