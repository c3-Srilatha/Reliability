/**
 * A stream of EvalMetricsResult keyed by source object's ids.
 */
private type EvalMetricsResultStream mixes EvalMetricsResultBase, WithToString {

  /**
   * stream of pairs where the pair's first is the source object's id & value is a map of metric names to its {@link Timeseries} / {@link Timeseries.Raw}
   */
  result: stream<Pair<string, map<string, TimeseriesBase>>>
}
