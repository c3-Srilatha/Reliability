/**
 * Map Reduce job type for metric caching
 */
entity type MetricsCacheRefreshJob extends MapReduce<Obj, int, int, int> type key 'MTRCHC' {

  /**
   * list of metrics that need to be cached
   */
  metricNames: [string] schema name 'MN'

  /**
   * evaluation start date for caching metrics
   */
  startDate: datetime

  /**
   * evaluation end date for caching metrics
   */
  endDate: datetime

  /**
   * no of sources to be used in one batch
   */
  batchSize: ~ = '100'

  /**
   * fields to be included on the source type
   */
  include: ~ = 'id'

  map: ~ js-server
}
