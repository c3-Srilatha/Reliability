/**
 * Data structure to be available in expressions during metric evaluations.
 * Can be accessed in expressions via $metric.<fieldName>
 * e.g. Access srcId of the metric being evaluated: $metric.src.id
 */
type MetricContext {

  /**
   * Source object for which metric is being evaluated
   */
  src: Identifiable

  /**
   * Interval of evaluation
   */
  interval: string enum Interval

  /**
   * Time range for evaluation
   */
  range: TimeRange

  /**
   * Time zone for evaluation
   */
  timeZone: TimeZone
}
