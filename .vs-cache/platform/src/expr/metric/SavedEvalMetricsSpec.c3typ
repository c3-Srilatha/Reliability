/**
 * Saved spec to be used during evaluation
 */
@beta
entity type SavedEvalMetricsSpec mixes SeedData<SavedEvalMetricsSpec>, EvalMetricsSpec schema name 'SEMS' {

  // TODO: PLAT-89830: Remove @constraint and use a new mechanism to mimic this functionality
  @constraint(required=false)
  expressions: ~

  @constraint(required=false)
  interval: ~

  @constraint(required=false)
  start: ~

  @constraint(required=false)
  end: ~

  fun: string
}
