/**
 * Holds parsed expressions for an AsTs metric
 */
private type AsTsMetricExprs {

  /**
   * Map of parsed expressions.
   */
  exprs: !map<string, native>

  /**
   * Gets a parsed expression for the metric.
   *
   * @param key
   *        Key of the expression to get.
   *
   * @return The requested parsed expression for the metric.
   */
  get: inline member function(key: !string): @java(class="c3.platform.expr.ast.ExprNode") native

  /**
   * Determines if the {@linke exprs} contains the specified key.
   *
   * @param key
   *        Key to check for.
   *
   * @return True if the {@link exprs} contains the specified key.
   */
  containsKey: inline member function(key: !string): boolean
}
