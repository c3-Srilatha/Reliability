/**
 * Cache for best simple metric for a src type and metric name
 */
@cache(maxSize=100000)
private type BestSimpleMetricCache mixes MetadataCacheOld<string>, Value {

  /**
   * @param srcType
   *        Source type
   * @param metric
   *        Metric name
   * @return the best simple metric for a given source type and metric name
   */
  metric: function(srcType: !string, metric: !string): string
}
