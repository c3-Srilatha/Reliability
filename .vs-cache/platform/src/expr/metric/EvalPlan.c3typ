/**
 * Contains information regarding metric evaluation plan
 */
type EvalPlan {

  /**
   * Initial combined expression representing all input metrics and expression
   */
  expr: string

  /**
   * Final rewritten expression
   */
  rewrittenExpr: string

  /**
   * Include spec generated for pre-fetching sources (timed fetch)
   */
  srcTypeFetchSpec: FetchSpec

  /**
   * Hierarchy generated during evaluation of metrics
   * path -> srcId -> interval -> EndOfPathObjects
   */
  hierarchies: map<string, map<string, map<string, [Obj]>>>

  /**
   * Map of simple metric timeseries; key is "<metric> + <time-info>"
   */
  simpleMetrics: map<string, EvalPlanTimeseries>

  /**
   * Instrumentation of first phase of combined expression evaluation
   */
  evalInstrumentation: string

  /**
   * Instrumentation of second phase (lazy timeseries evaluation) of combined expression evaluation
   */
  tsEvalInstrumentation: string

  /**
   * Total elapsed time in seconds
   */
  time: double

  /**
   * Total IO time in seconds
   */
  ioTime: double

  /**
   * List of simple metric objects with tsDecl includes. Will be populated for use for metric data export
   */
  metricsMetadata: [EvalPlanMetricsMetadata]

  /**
   * List of includes when instrumentation is on.
   */
  includes: set<string>
}
