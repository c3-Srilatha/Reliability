/**
 * Various info for metrics listeners used internally for invalidation for metrics
 */
private type MetricsListenerCacheEntry {

  /**
   * List of metrics for all listeners.
   */
  metrics: [string]

  /**
   * Metrics grouped by listener.
   */
  metricsByListener: map<string, [string]>

  /**
   * Metrics grouped by source type.
   */
  metricsBySrcType: map<string, [string]>

  /**
   * All metrics listener types
   */
  listenerTypes: [Type]
}
