/**
 * Various info for analytics listeners used internally for invalidation for metrics
 */
private type ListenerAsTsMetricsCacheEntry {

  /**
   * AsTsMetricDeps grouped by metric
   */
  metricDeps: map<string, [AsTsMetricDep]>

  /**
   * AsTsMetricDeps grouped by header type.
   */
  metricDepsByHeaderType: map<string, [AsTsMetricDep]>
}
