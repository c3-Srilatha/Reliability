/**
 * Type for specifying configuration of MetricsCacheJob
 */
type MetricsCacheJobConfig mixes Config, Identifiable {

  /**
   * The source type for which metrics cache needs to be run
   */
  srcType: Type

  /**
   * The metrics to be cached. Only metrics specified here will be considered for caching
   */
  metricNames: [string]

  /**
   * Interval at which given metrics need to be cached
   */
  interval: string

  /**
   * Is metric caching enabled
   */
  enabled: boolean
}
