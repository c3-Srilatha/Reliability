/**
 * Cache for simple metrics.
 */
private type SimpleMetricCache mixes MetadataCacheOld<map<string, SimpleMetric>>, Value {

  /**
   * @return A map of metrics keyed by their id.
   */
  metrics: function(): map<string, SimpleMetric>

  /**
   * Reclaimed to clear all SimpleMetric related caches.
   *
   * @inheritdoc
   */
  @typesys(todo="PLAT-130533 - Remove MetadataCacheOld#clear override from SimpleMetricCache")
  clear: ~
}
