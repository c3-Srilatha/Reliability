// TODO mixes MetricFunctionLibrary
type WeatherNormalizerFunctionLibrary mixes Value {

  weatherNormalizeElectricity: function(electricityConsumption: @java(class="c3.platform.timeseries.Timeseries") native,
                                        consumptionMetricName: !string,
                                        eventDate: datetime): Timeseries

  weatherNormalizeNaturalGas: function(naturalGasConsumption: @java(class="c3.platform.timeseries.Timeseries") native,
                                       consumptionMetricName: !string,
                                       eventDate: datetime): Timeseries

  weatherInterpolateElectricity: function(electricityConsumption: @java(class="c3.platform.timeseries.Timeseries") native,
                                          consumptionMetricName: !string): Timeseries

  weatherInterpolateNaturalGas: function(naturalGasConsumption: @java(class="c3.platform.timeseries.Timeseries") native,
                                         consumptionMetricName: !string): Timeseries
}
