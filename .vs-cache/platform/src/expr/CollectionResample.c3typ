/**
 * An intermediate structure holding results of the various resampling operations on {@link Collection}, providing the
 * ability to perform various aggregations on the resampled result.
 *
 * @see StdLib#resample
 */
type CollectionResample<E> mixes CollectionResampleBase<E> {

  /**
   * Input collection for resample
   */
  _src: private ?Collection<E>
}
