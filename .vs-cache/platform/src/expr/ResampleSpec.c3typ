/**
 * Spec for performing resampling on Collection
 */
type ResampleSpec mixes TimeseriesSpec {

  /*
   * Convenience api to construct a ResampleSpec to resample the input
   *
   * @param period
   *           The offset string. e.g. '30S' for 30 seconds
   * @param on
   *           an element field to use instead of index for resampling. must be datetime-like
   */
  forFields: function(startExpr: !string, period: !string serialized Period): !ResampleSpec
}
