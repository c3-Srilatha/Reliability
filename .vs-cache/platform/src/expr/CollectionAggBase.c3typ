abstract type CollectionAggBase<E> {

  /**
   * Performs the aggregation operation on each group of elements (or element fields).
   *
   * @param agg
   *           Choice of an aggregation operation.
   * @param aggSpec
   *           specification of how to perform the aggregation operation (e.g. parameters to aggregation function).
   * @return collection resulting from the operation.
   */
  agg: abstract member function<R>(aggOp: AggOp, aggSpec: AggSpec): Collection<R>

  sum:        member function<R>(aggSpec: AggSpec): Collection<R>
  prod:       member function<R>(aggSpec: AggSpec): Collection<R>
  min:        member function<E>(aggSpec: AggSpec): Collection<E>
  max:        member function<E>(aggSpec: AggSpec): Collection<E>
  count:      member function<R>(aggSpec: AggSpec): Collection<R>
  avg:        member function<R>(aggSpec: AggSpec): Collection<R>
  median:     member function<R>(aggSpec: AggSpec): Collection<R>
  variance:   member function<R>(aggSpec: AggSpec): Collection<R>
  stddev:     member function<R>(aggSpec: AggSpec): Collection<R>
  percentile: member function<R>(percentile: double, aggSpec: AggSpec): Collection<R>
  previous:   member function<R>(aggSpec: AggSpec): Collection<R>
}
