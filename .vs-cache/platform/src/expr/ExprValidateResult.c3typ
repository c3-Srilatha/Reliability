/**
 * Result of the Expr#validate action.
 */
type ExprValidateResult mixes Result {

  /**
   * If false then #errors will provide details.
   */
  valid: boolean

  /**
   * Error message if expression is invalid.
   */
  error: string

  /**
   * @see ExprParseSpec#includeAst
   */
  ast: Expr.Ast
}
