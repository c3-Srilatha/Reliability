/**
 * Type to specify how C3 expressions should be compiled
 */
type Expr.CompileOptions mixes Spec {

  /**
   * Extract constants out while rewriting expression for evaluation
   */
  noConstantExtraction: boolean

  /**
   * Apply common sub expression elimination technique for expression evaluation
   */
  noCommonSubexpressionElimination: boolean

  /**
   * Cache intermediate computed results to be used in other parts of the expression
   */
  noCache: boolean

  /**
   * The language to generate code in.
   */
  language: string serialized ImplLanguage = JAVA

  /**
   * Collect instrumentation information for the evalMetrics call
   */
  instrumentation: boolean

  functionLibrary: private @java(class='c3.platform.expr.FunctionLibrary') native

  /**
   * @return options with all optimizations OFF.
   */
  notOptimized: inline function(): !Expr.CompileOptions

  /**
   * @return options with all optimizations OFF and caching disabled.
   */
  notOptimizedNorCached: inline function(): !Expr.CompileOptions
}
