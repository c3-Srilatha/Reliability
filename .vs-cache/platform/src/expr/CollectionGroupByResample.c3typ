/**
 * An intermediate structure holding results of the various resampling operations on {@link CollectionGroupBy},
 * providing the ability to perform various aggregations on the resampled result.
 *
 * @see CollectionGroupBy#resample
 */
type CollectionGroupByResample<E> mixes CollectionResampleBase<E> {

  /**
   * Grouped intermediate structure for resample
   */
  _src: private !CollectionGroupBy
}
