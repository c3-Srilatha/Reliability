/**
 * Abstract Syntax Tree for a C3 Expression.
 */
inline type Expr.Ast {

  /**
   * Expression source
   */
  src: !string

  /**
   * @return the parent expression
   */
  parent: !(Expr | Expr.Compiled)

  /**
   * @return input value type
   */
  inType: property(): !ValueType

  /**
   * @return variable types
   */
  varTypes: property(): map<string, ValueType>

  /**
   * List of variable names in the given expression ast
   */
  varNames: property(): set<string>

  /**
   * @return output value type
   */
  outType: property(): !ValueType

  /**
   * @return C3 package this expression belongs to
   */
  pkg: property(): !Pkg

  /**
   * List of `.` separated field paths in the context of root C3 type used in this expression.
   */
  dependingFieldPaths: property(): set<string>

  /**
   * Return the ExprNode corresponding to the given parsed expression on the input type
   */
  exprNode: private property(): @java(class="c3.platform.expr.ast.ExprNode") native
}
