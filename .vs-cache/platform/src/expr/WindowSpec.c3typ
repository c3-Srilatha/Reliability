/**
 * Spec for specifying the window for rolling/expanding/window operations
 */
type WindowSpec mixes WindowBase, Spec {

  /**
   * Offset is used to set the start point of the window and can be used to determine whether the window
   * include the elements of the future or the past.
   * offset == -1, Previous point will be the starting point of the window
   * offset == 0, Current point will be the starting point of the window.
   * offset == 1, Next point will be the starting point of the window.
   * e.g
   * ```js
   * d = [1,2,3,4]
   * // "lookback" rolling window of span 2
   * d.rolling({offset: -1, span:2})
   * // will generate
   * // [[1], [1,2], [2,3] [3,4]]
   *
   * // "lookahead" rolling window starting from current point, of span 2
   * d.rolling({offset: 0, span:2})
   * // will generate
   * // [[1,2], [2,3], [3,4] [4]]
   *
   * // "lookahead" rolling window starting from next point, of span 2
   * d.rolling({offset: 0, span:2})
   * // will generate
   * // [[1,2], [2,3], [3,4] [4]]
   * ```
   * As mentioned above, {@link #span} decides the span (size/length) of the __rolling__ window.
   * @see Stdlib#rolling
   * @see Collection#rolling
   * @see CollectionRolling.window
   */
  offset: !int

  /**
   * Span specifies the size/length of the __rolling__ window.
   * This works in conjunction with {@link #offset} which determines the start of the window.
   * ```js
   * d = [1,2,3,4]
   * // "lookback" rolling window of span 2
   * d.rolling({offset: -1, span:2})
   * // will generate
   * // [[1], [1,2], [2,3] [3,4]]
   *
   * // "lookahead" rolling window starting from current point, of span 2
   * d.rolling({offset: 0, span:2})
   * // will generate
   * // [[1,2], [2,3], [3,4] [4]]
   *
   * // "lookahead" rolling window starting from next point, of span 2
   * d.rolling({offset: 0, span:2})
   * // will generate
   * // [[1,2], [2,3], [3,4] [4]]
   * ```
   * @see Stdlib#rolling
   * @see Collection#rolling
   * @see CollectionRolling.window
   */
  span: !int

  /**
   * Indicates step of the window, which is 1 by default
   * ```
   * @see Stdlib#rolling
   * @see Collection#rolling
   * @see CollectionRolling.window
   */
  step: !int = 1

  /**
   * flips sign of operation, example front-back changes to back-front
   * ```
   * @see Stdlib#rolling
   * @see Collection#rolling
   * @see CollectionRolling.window
   */
  flipBoundaryDir: boolean
}
