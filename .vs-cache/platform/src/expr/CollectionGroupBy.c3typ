/**
 * An intermediate structure holding results of the various groupBy operations on {@link Collection}, providing the
 * ability to perform various aggregations on the grouped result.
 *
 * @var E
 *         Element Type of the collection. Collection Type to be  the same Type after doing the subsequent operation.
 *         (e.g.: If the collection which this operation is acting on is a DataTable, the output of the `agg` function
 *         should also be a DataTable.)
 *
 * @see StdLib#groupBy
 */
type CollectionGroupBy<E> mixes GroupByBase<E>, CollectionAggBase<E> {

  /**
   * Collects Group By operation results
   */
  collect: member function<R, K>(): Map<K, Collection<R>>

  by:         string
  percentile: ~

  /**
   * Convenience wrapper for converting numeric columns on the given grouped Collection to Timeseries. All numeric fields will have the
   * same aggregation function & same datetime field on which Timeseries is constructed
   *
   * Note: Timeseries will be constructed on the grouped Collections
   *
   * @param spec
   *        Spec indicating how to create Timeseries for the numeric columns. {@link DataTimeseriesSpec#forFields}
   * @return structure where only numeric columns are converted to Timeseries fields
   */
  timeseries: member function<R>(spec: DataTimeseriesSpec): Collection<R>

  /**
   * Converts the `numeric` columns on the given CollectionGroupBy into Timeseries columns. Currently non-numeric columns will be dropped from the
   * result
   *
   * Note: Timeseries will be constructed on the grouped Collections
   *
   * E.g.
   * ```js
   * g = { "group1" : [{ "a" : 0.9, "b" : 1, "c": "foo", "d": "2010-01-01", "e": true  },
   *        { "a" : 1.1, "b" : 2, "c": "bar", "d": "2010-01-02", "e": false  },
   *        { "a" : 2.1, "b" : 3, "c": "foo", "d": "2010-01-03", "e": false  }]
   *     }
   *
   * // timeseries using a period of 1 month on field "d" as the date index of the resulting Timeseries
   * r = g.timeseries({"a": { aggFunc: "SUM" }, "b": { aggFunc: "AVG" }}, { startExpr:"d", interval:"DAY"})
   * => [{ "a": {"_col":[0.9,1.1,2.1], "tsInfo": { start:"2010-01-01", end:"2010-01-03", interval:"DAY"} },
   *       "b": {"_col":[1,2,3], "tsInfo": { start:"2010-01-01", end:"2010-01-03", interval:"DAY"} }]
   *
   * @param tsFieldSpec
   *            Timeseries field level specification indicating how each Timeseries needs to be aggregated / created
   *            E.g. {"a": { aggFunc: "SUM" }}
   * @param spec
   *            Common time info & date fields indicating the bounds of the Timeseries
   * @return structure where only numeric columns are converted to Timeseries fields
   */
  timeseries: member function<R>(tsFieldSpec: !map<string, TimeseriesFieldSpec>,
                                 spec: TimeseriesSpecBase): Collection<R>

  /**
   * Resamples (normalizes the timeseries) on the grouped Collection. If element type is a reference then resampling happens on
   * only the numeric fields. Rules of normalization can be reviewed {@link normalization}
   *
   * E.g.
   * ```js
   * col = [{ "a" : 0.9, "b" : 1, "c": "foo", "d": "2010-01-01", "e": true  },
   *        { "a" : 1.1, "b" : 2, "c": "bar", "d": "2010-01-02", "e": false  },
   *        { "a" : 1.5, "b" : 2.5, "c": "bar", "d": "2010-01-02", "e": false  },
   *        { "a" : 2.1, "b" : 3, "c": "foo", "d": "2010-01-04", "e": false  }]
   *
   * // group by 'c' & resample by 1 month frequency on field "d"
   * r = col.groupBy("c").resample(ResampleSpec.forFields('d', '1m')).sum()
   * [{ "c": "foo", "d": "2010-01-01", "a" : 3.0, "b" : 4.0 },
   * [{ "c": "bar","d": "2010-01-01", "a" : 2.6, "b" : 4.5 }]
   *
   * // group by "e" & resample by 1 day frequency on field "d"
   * r = col.groupBy("e").resample(ResampleSpec.forFields('d', '1d')).max()
   * [{ "e": "true", "d": "2010-01-01", "a" : 0.9, "b" : 1.0 },
   * [{ "e": "false","d": "2010-01-02", "a" : 1.5, "b" : 2.5 },
   * [{ "e": "false","d": "2010-01-03", "a" : 0, "b" : 0 },
   * [{ "e": "false","d": "2010-01-04", "a" : 2.1, "b" : 3.0 }]
   * ```
   * @param spec
   *           Fields indicating how the Collection should be resampled. {@link ResampleSpec#forFields}
   * @return an intermediate structure that records the resample operation, for performing subsequent actions
   */
  resample: member function(spec: ResampleSpec): !CollectionGroupByResample<E>

  /**
   * Sums up evaluation result of a provided expression for each group of elements.
   */
  sum: member function<R, K>(projection: string serialized Expr): Map<K, R>
}
