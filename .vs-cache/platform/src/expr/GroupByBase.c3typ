/**
 * An intermediate structure holding results of the various groupBy operations on {@link Collection}, providing the
 * ability to perform various aggregations on the grouped result.
 *
 * @var E
 *         Element Type of the data. Collection Type to be  the same Type after doing the subsequent operation.
 *         (e.g.: If the collection which this operation is acting on is a DataTable, the output of the `agg` function
 *         should also be a DataTable.)
 *
 * @see StdLib#groupBy
 */
abstract type GroupByBase<E> {

  /**
   * Input for group by
   */
  // TODO:PLAT-37267 - change GroupByBase#_src to ?(?Data | ?Collection<E>)
  _src: private ?any

  /**
   * Represents a single element field (or integer position) or a list of element fields (or integer
   * positions), which allows us to group by the fields of the elements (equivalent to grouping by columns in
   * a 2D table).
   */
  // TODO: PLAT-25996 Include should mix StringSerializable, make this `serialized Include`
  _byFields: private property(): string

  /**
   * Function to compute the key from the element in the collection.
   */
  _byKey: private lambda(e: E): any

  /**
   * Type of the key by which to group by.
   */
  _keyType: private ValueType
}
