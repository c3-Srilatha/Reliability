/**
 * Base type for compiled C3 expression for JavaScript.
 *
 * @see Expr.Compiled.Script
 */
inline private type Expr.Compiled.Js<I, O> mixes Expr.Compiled.Script<I, O> {

  eval: ~ java | js
}
