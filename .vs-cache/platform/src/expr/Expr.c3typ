/**
 * Representation of C3 Expression
 */
inline type Expr mixes StringSerializable {

  @deprecated(finalVersion='8.4')
  parse: function(type: !Type, expr: !string serialized Expr): !Expr

  @deprecated(finalVersion='8.4')
  parse: function(type: !TypeMeta, expr: !string serialized Expr): !Expr

  @deprecated(finalVersion="8.4", description="Use Expr.Compiled#inType instead")
  inputType: member function(): !ValueType

  @deprecated(finalVersion="8.4", description="Use Expr.Compiled#outType instead")
  returnType: member function(): !ValueType

  @deprecated(finalVersion="8.4", description="Use Expr.parse(..).compile(..).eval instead")
  compileFilter: function<I>(filter: !string serialized Expr,
                             inType: !Type,
                             consts: map<string, any>): lambda(in: I): boolean

  @deprecated(finalVersion="8.4", description="Use Expr.parse(..).compile(..).eval instead")
  compileFilter: function<I>(filter: !string serialized Expr,
                             inType: !ValueType,
                             consts: map<string, any>): lambda(in: I): boolean

  /**
   * Expression source
   */
  src: !string

  /**
   * Evaluate the C3 expression
   *
   * @param expr
   *         C3 expression
   * @param in
   *         input value on which the expression needs to be evaluated
   * @param outType
   *         output value type
   * @return evaluation result
   */
  eval: function<O>(expr: !string serialized Expr, in: any, outType: ValueType): O

  /**
   * Evaluate the C3 expression
   *
   * @param expr
   *         C3 expression
   * @param in
   *         input value on which the expression needs to be evaluated
   * @param vars
   *         variable bindings
   * @param outType
   *         output value type
   * @param vars
   *         variable bindings
   * @return evaluation result
   */
  eval: function<O>(expr: !string serialized Expr, in: !?any, vars: !?map<string, any>, outType: ValueType): O

  /**
   * Evaluate the C3 expression
   *
   * @param expr
   *         C3 expression
   * @param in
   *         input value on which the expression needs to be evaluated
   * @param timeInfo
   *         timing information for the evaluation
   * @param vars
   *         variable bindings
   * @param outType
   *         output value type
   * @return evaluation result
   */
  eval: function<O>(expr: !string serialized Expr,
                    in: !?any,
                    timeInfo: !?TimeInfo,
                    vars: map<string, any>,
                    outType: ValueType): O

  /**
   * @return parsed C3 Expression without any type inference; basically underling AST will be un-typed. `null` if the
   *         expression is empty.
   */
  parse: function(expr: !?string serialized Expr): Expr

  /**
   * @return compiled expression for a given input value type and expected output type; note that expression return type
   *         needs to be convertible to the provided return type
   */
  compile: member function<I, O>(inType: !ValueType,
                                 outType: ValueType,
                                 consts: map<string, any>,
                                 options: Expr.CompileOptions): !Expr.Compiled<I, O>

  /**
   * @return compiled expression for a given input value type and expected output type; note that expression return type
   *         needs to be convertible to the provided return type
   */
  compile: member function<I, O>(inType: !Type,
                                 outType: ValueType,
                                 consts: map<string, any>,
                                 options: Expr.CompileOptions): !Expr.Compiled<I, O>

  /**
   * @return compiled expression for a given constant bindings to variables in the C3 expression.
   */
  compile: member function<I, O>(consts: !?map<string, any>, options: Expr.CompileOptions): !Expr.Compiled<I, O>

  /**
   * @return compiled expression.
   */
  compile: member function<I, O>(options: Expr.CompileOptions): !Expr.Compiled<I, O>

  /**
   * @return compiled comparator lambda based on provided C3 order expression, input type and constants used in the
   *         expression
   */
  compileOrder: function<I>(order: !string serialized Expr.Order,
                            inType: !Type,
                            consts: map<string, any>): lambda(in1: I, in2: I): @comparator int32

  /**
   * @return compiled comparator lambda based on provided C3 order expression, input value type and constants used in
   *         the expression
   */
  compileOrder: function<I>(order: !string serialized Expr.Order,
                            inType: !ValueType,
                            consts: map<string, any>): lambda(in1: I, in2: I): @comparator int32

  /**
   * @return compiled partitioner lambda based on provided C3 group expression, input type and constants used in
   *         the expression
   */
  compileGroup: function<I>(group: !string serialized Expr.Group,
                            inType: !Type,
                            consts: map<string, any>): lambda(in: Collection<I>): @indexed map<string, Collection<I>>

  /**
   * @return compiled partitioner lambda based on provided C3 group expression, input value type and constants used in
   *         the expression
   */
  compileGroup: function<I>(group: !string serialized Expr.Group,
                            inType: !ValueType,
                            consts: map<string, any>): lambda(in: Collection<I>): @indexed map<string, Collection<I>>

  /**
   * @return compiled mapper lambda for transforming input by removing fields that are not part of the provided include
   *         spec
   */
  compileInclude: function<I>(include: !string serialized Include,
                              inType: !Type,
                              consts: map<string, any>): lambda(in: I): I

  /**
   * @return compiled mapper lambda for transforming input by removing fields that are not part of the provided include
   *         spec
   */
  compileInclude: function<I>(include: !string serialized Include,
                              inType: !ValueType,
                              consts: map<string, any>): lambda(in: I): I

  /**
   * @return compiled mapper lambda for transforming input by removing fields that part of the provided exclude spec
   */
  compileExclude: function<I>(exclude: !string serialized Exclude,
                              inType: !Type,
                              consts: map<string, any>): lambda(in: I): I

  /**
   * @return compiled mapper lambda for transforming input by removing fields that part of the provided exclude spec
   */
  compileExclude: function<I>(exclude: !string serialized Exclude,
                              inType: !ValueType,
                              consts: map<string, any>): lambda(in: I): I

  /**
   * @return compiled mapper lambda for transforming input into output by evaluating provided expression
   */
  compileMapper: function<I, O>(projection: !string serialized Expr,
                                inType: !Type,
                                consts: map<string, any>): lambda(in: I): O

  /**
   * @return compiled projection lambda for transforming input by extracting result of the evaluation of provided
   *         expression
   */
  compileProjection: function<I, O>(projection: !string serialized Expr.Projection,
                                    inType: !Type,
                                    consts: map<string, any>): lambda(in: I): O

  /**
   * @return compiled projection lambda for transforming input by extracting result of the evaluation of provided
   *         expression
   */
  compileProjection: function<I, O>(projection: !string serialized Expr.Projection,
                                    inType: !ValueType,
                                    consts: map<string, any>): lambda(in: I): O

  /**
   * @return compiled projection lambda for transforming input by extracting result of the evaluation of provided
   *         expression
   */
  compileProjection: function<I, O>(projection: !string serialized Expr.Projection,
                                    inType: !ValueType,
                                    outType: !ValueType,
                                    consts: map<string, any>): lambda(in: I): O

  /**
   * @return compiled mapper lambda for transforming input into output by evaluating provided expression
   */
  compileMapper: function<I, O>(projection: !string serialized Expr,
                                inType: !Type,
                                consts: map<string, any>): lambda(in: I): O

  /**
   * @return compiled mapper lambda for transforming input into output by evaluating provided expression
   */
  compileMapper: function<I, O>(projection: !string serialized Expr,
                                inType: !ValueType,
                                consts: map<string, any>): lambda(in: I): O

  /**
   * @return compiled mapper lambda for transforming input into output by evaluating provided expression
   */
  compileMapper: function<I, O>(projection: !string serialized Expr,
                                inType: !ValueType,
                                outType: !ValueType,
                                consts: map<string, any>): lambda(in: I): O

  /**
   * Parses and validates given expression without resolving AST node types.
   */
  validate: function(expr: !string serialized Expr): !ExprValidateResult

  /**
   * Parses and validates given expression and resolves AST node types based on in & var types.
   */
  validate: function(expr: !string serialized Expr,
                     inType: !?ValueType,
                     outType: ValueType,
                     varTypes: map<string, ValueType>,
                     spec: ExprValidateSpec): !ExprValidateResult

  /**
   * @return true if this expression will always evaluate to constant value
   */
  isConst: member function(): boolean

  /**
   * @return value if this expression will always evaluate to constant
   */
  constValue: member function<O>(): O

  /**
   * @return quoted value used in C3 expressions. e.g. `datetime("2020-01-01T00:00:00Z")`, `["a","b"]`, `1`.
   */
  literal: function(value: !?any, quoteChar: !int32 = '"'): string

  /**
   * return value types inferred from vars
   */
  extractTypes: function(vars: map<string, any>): map<string, ValueType>

  /**
   * @return method name and args parsed into a C3 Expression; eg, 'methodName(arg1, arg2, arg3)'
   */
  forMethodCall: private function(name: !string, args: any ...): !Expr

  /**
   * Return the ExprNode corresponding to the given parsed expression on the input type
   */
  exprNode: private member function(inType: Type): @java(class="c3.platform.expr.ast.ExprNode") native

  /**
   * @return Abstract Syntax Tree of this expression
   */
  ast: private member function(inType: ValueType, outType: ValueType): !Expr.Ast
}
