/**
 * Invalidation queue for metric invalidation processing.
 *
 * @see MetricsQueueEntry
 */
@invalidationQueueOptions(grouping='targetObjId, context.metricName',
                          defaultReportGrouping='targetTypeId, status',
                          detailReportGrouping='targetTypeId, status',
                          defaultErrorReportGrouping='targetTypeId, errorCode, review',
                          detailErrorReportGrouping='targetTypeId, errorCode, review')
type MetricsQueue mixes InvalidationQueue<MetricsQueueEntry>, MergeableInvalidationQueue<MetricsQueueEntry>, Value {

  dataIssueTypes: ~
}
