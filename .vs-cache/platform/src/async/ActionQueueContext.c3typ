/**
 * Used to handle context for ActionQueue compute/invalidate.  This is not used as the physical context type in
 * the action queue entry.  Instead it is stringified as json and stored in the standard context field
 */
type ActionQueueContext {

  /**
   * Previously held the action name to invoke.  Now stored in {@link AnalyticsQueueEntry.entryType}.
   */
  @deprecated
  actionName: string

  /**
   * Arguments to invoke the action with.
   */
  arguments: map<string, any>
}
