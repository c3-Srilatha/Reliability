/**
 * Invalidation queue error review.  When errors are reviewed via {@link InvalidationQueue.setReviewed}, the reviewed
 * entries are tied to an instance of this type, which can be used for commenting/assigning tickets, etc.
 */
@db(shortId=true, shortIdPrefix='review', shortIdSuffixType='numeric', shortIdReservationRange=10)
entity type InvalidationQueueErrorReview schema name 'ASYNQ_IQEREV' {

  /**
   * Queue type that the review is for.
   */
  queueType: !string

  /**
   * Label for hyperlink to ticket (e.g. Jira or Zendesk) created for the review.
   */
  linkLabel: string

  /**
   * Url for hyperlink to ticket (e.g. Jira or Zendesk) created for the review.
   */
  linkUrl: string

  /**
   * All comments for the review, ordered by comment creation timestamp.
   */
  @db(order='meta.created')
  comments: [InvalidationQueueErrorReviewComment](review)

  /**
   * Adds a comment to the review.  The timestamp and user who created it will be automatically captured.
   */
  addComment: member function(comment: string)

  /**
   * Recovers the queue error entries associated with the review.
   */
  recover: member function()
}
