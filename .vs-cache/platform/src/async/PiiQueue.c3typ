/**
 * Invalidation queue for PII access audit.
 *
 * @see PiiQueueEntry
 */
@invalidationQueueOptions(defaultReportGrouping='targetTypeId, status',
                          detailReportGrouping='targetTypeId, status',
                          defaultErrorReportGrouping='targetTypeId, errorCode, review',
                          detailErrorReportGrouping='targetTypeId, errorCode, review')
type PiiQueue mixes InvalidationQueue<PiiQueueEntry>, Value {

  submitEvents: function(typeRef: !Type, events: ![PiiAccessEvent], autoCommit: boolean = true)
}
