/**
 * Invalidation queue for cloud queue processing. see the implementations of this
 *   e.g. {@link EventHubQueue}, {@link KinesisQueue}, {@link KafkaQueue}, {@link SqsQueue}.
 * This queue is a general purpose queue for all cloud (sqs, kinesis, event hub, ect.) queues in the system. In order
 * to create a custom cloud queue, do the following:
 * * Create a type that mixes in {@link CloudInboundMessage} or {@link CloudOutboundMessage}
 * * If type mixes {@link CloudInboundMessage}, then implement {@link CloudInboundMessage#process}.
 */
@invalidationQueueOptions(grouping='targetObjId',
                          defaultReportGrouping='targetTypeId, status',
                          detailReportGrouping='targetTypeId, targetObjId, status',
                          defaultErrorReportGrouping='targetTypeId, errorCode, review',
                          detailErrorReportGrouping='targetTypeId, targetObjId, errorCode, review')
abstract type CloudInvalidationQueue<Q: CloudMessageBroker, S: CloudQueueEntry> mixes InvalidationQueue<CloudQueueEntry>, Value {

  /**
   * Gives the specific {@link CloudInvalidationQueue} for the given {@link CloudMessageBroker}
   *
   * @param typeRef
   *           reference to {@link CloudMessageBroker} type
   * @return the {@link CloudInvalidationQueue} that supports the given {@link CloudMessageBroker}.
   */
  typeForCloudMessageBroker: private inline function(typeRef: !Type): Type

  /**
   * Create and update SQL entries to represent the queue and initialize metadata to allow it to be processed.
   *
   * @param brokerName
   *           Name of {@link CloudMessageBroker} for which the entry(s) are created.
   * @param cloudConsumer
   *           Name of the consumer group associated with this entry.
   */
  upsertEntries: private function(brokerName: !string, cloudConsumer: string)

  /**
   * Delete SQL entries for this broker.
   *
   * @param brokerName
   *           Name of {@link CloudMessageBroker} for which the entry(s) are destroyed.
   */
  removeEntries: private function(brokerName: !string): int

  /**
   * Determines if all required cloud invalidation queue entries exist for broker.
   * {@link CloudQueue} will have a single entry.
   * {@link CloudStream} will have an entry per partition.
   *
   * @param brokerName
   *           Name of {@link CloudMessageBroker} for which the entry(s) are present.
   */
  entriesExist: private function(brokerName: !string): !boolean

  compute: ~
}
