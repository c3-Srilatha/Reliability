/**
 * Base class for queue async processing of {@link Sources}
 */
@invalidationQueueOptions(grouping='targetObjId',
                          defaultReportGrouping='targetTypeId, status',
                          detailReportGrouping='targetTypeId, targetObjId, status',
                          defaultErrorReportGrouping='targetTypeId, errorCode, review',
                          detailErrorReportGrouping='targetTypeId, targetObjId, errorCode, review')
type SourceQueueBase<ET: InvalidationQueueEntry> mixes InvalidationQueue<ET>, Value {

  /**
   * submits a chunk/source file/status for async processing
   */
  submit: private inline function(obj: !Obj, spec: DataIntegSpec, doNotAutoCommit: boolean)
}
