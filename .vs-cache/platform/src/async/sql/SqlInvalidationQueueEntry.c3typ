/**
 * Base type for all sql invalidation queue entries.
 */
@db(systemType=true,
    compactType=true,
    shortId=true,
    shortIdPrefix='I',
    shortIdReservationRange=100000,
    index+=[
             'status, nodePool, priority, invalidatedAt',
             'status, priority, invalidatedAt',
             'status, nodePool, priority, invalidatedAt',
             'status, priority, invalidatedAt',
             'status, srcActionId',
             'targetTypeId, targetObjId',
             'targetTypeId, targetObjId, rescheduleKey',
             'lockHashKey'
           ],
    domain='queues')
type SqlInvalidationQueueEntry<C> mixes InvalidationQueueEntry<C> {

  /**
   * Hash key that uniquely identifies this invalidation request. Used to make sure that only one thread
   * is handling this invalidation request at a time.
   */
  lockHashKey: string schema name 'LOCK_HASH_KEY'

  lock:              InvalidationQueueLock(id, lockHashKey)
  targetTypeId:      ~ schema name 'TARGET_TYPE_ID'
  targetObjId:       ~ schema name 'TARGET_OBJ_ID'
  context:           ~ schema name 'CONTEXT'
  entryType:         ~ schema name 'ENTRY_TYPE'
  priority:          ~ schema name 'PRIORITY'
  nodePool:          ~ schema name 'NODE_POOL'
  invalidatedAt:     ~ schema name 'INVALIDATED_AT'
  invalidatedNodeId: ~ schema name 'INVALIDATED_NODE_ID'
  status:            ~ schema name 'STATUS'
  srcRootActionId:   ~ schema name 'SRC_ROOT_ACTION_ID'
  srcActionId:       ~ schema name 'SRC_ACTION_ID'
  depth:             ~ schema name 'DEPTH'
}
