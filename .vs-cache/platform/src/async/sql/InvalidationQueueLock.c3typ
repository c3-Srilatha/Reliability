/**
 * Invalidation queue locking table. This type is used to make sure that given invalidation queue entry is being
 * processed only by a single thread.
 */
@db(systemType=true, compactType=true, domain='queues', index=['queueTypeId, targetTypeId, targetObjId', 'queueTypeId, computingNodeId, targetTypeId, targetObjId', 'queueTypeId, computingSince'])
entity type InvalidationQueueLock schema name 'ASYNQ_INVQLOCK' {

  /**
   * Internal id of invalidation queue type for this lock.
   */
  queueTypeId: int schema name 'QUEUE_TYPE_ID'

  /**
   * C3 server node that holds the lock.
   */
  computingNodeId: string schema name 'COMPUTING_NODE_ID'

  /**
   * Timestamp when this lock was acquired.
   */
  computingSince: datetime schema name 'COMPUTING_SINCE'

  /**
   * System generated unique id that ties the lock entry to the dispatch action for it.  Used to detect/handle "stuck" invalidation action
   */
  actionKey: string schema name 'ACTION_KEY'

  /**
   * Target type the lock is for.  Used for grouped count() calls.
   */
  targetTypeId: int schema name 'TARGET_TYPE_ID'

  /**
   * Target obj the lock is for.
   */
  targetObjId: string schema name 'TARGET_OBJ_ID'

  version: ~ not persistable
}
