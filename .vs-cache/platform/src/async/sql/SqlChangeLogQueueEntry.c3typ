/**
 * Invalidation queue entry for implementing generic invalidation based on data changes.
 */
@db(index+=['targetTypeId, targetObjId, context.listenerTypeId'])
entity type SqlChangeLogQueueEntry mixes ChangeLogQueueEntry, SqlInvalidationQueueEntry<ChangeLogContext> schema name 'ASYNQ_CHGLOG' {

  version: ~ not persistable
}
