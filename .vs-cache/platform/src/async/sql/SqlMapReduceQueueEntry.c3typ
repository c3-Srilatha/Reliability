/**
 * Invalidation queue entry for implementing C3 MapReduce framework.
 *
 * targetTypeId and targetObjId will be set based on MapReduce job instance. context will be set to one of
 * run:<runId>:updateStatus:<n>, run:<runId>:map:<n> or run:<runId>:reduce:<n> where n is a sub-task id that is
 * used for coordination.
 */
@db(unique=['targetTypeId, targetObjId, context'],
    index+=['targetTypeId, targetObjId, status, priority', 'targetTypeId, targetObjId, priority'])
entity type SqlMapReduceQueueEntry mixes MapReduceQueueEntry, SqlInvalidationQueueEntry<string>, SqlHiAuthzQueueEntry schema name 'ASYNQ_MAPR' {

  version: ~ not persistable
}
