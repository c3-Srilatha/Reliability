/**
 * Invalidation queue for implementing automatic refresh of crons.
 */
@db(unique=['lockHashKey'])
entity type SqlCronQueueEntry mixes CronQueueEntry, SqlInvalidationQueueEntry<datetime> schema name 'ASYNQ_CRON' {

  /**
   * Fkey to access the `CronJob` for the queue entry
   */
  cronJob: CronJob(id, targetObjId)
}
