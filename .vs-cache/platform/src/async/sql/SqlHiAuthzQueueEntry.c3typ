/**
 * Mixin for invalidation queue entries that require cluster-admin authz for create/update/merge
 */
abstract entity type SqlHiAuthzQueueEntry {

  @action(group+='cluster-admin')
  update: ~

  @action(group+='cluster-admin')
  upsert: ~

  @action(group+='cluster-admin')
  merge: ~

  @action(group+='cluster-admin')
  updateBatch: ~

  @action(group+='cluster-admin')
  updateObjs: ~

  @action(group+='cluster-admin')
  upsertBatch: ~

  @action(group+='cluster-admin')
  upsertObjs: ~

  @action(group+='cluster-admin')
  mergeBatch: ~

  @action(group+='cluster-admin')
  mergeObjs: ~

  @action(group+='cluster-admin')
  mergeAll: ~

  @action(group+='cluster-admin')
  create: ~

  @action(group+='cluster-admin')
  createBatch: ~

  @action(group+='cluster-admin')
  createBatchObjStream: ~

  @action(group+='cluster-admin')
  replace: ~

  /**
   * Allows upserting entries to the queue but DOES NOT allow specifying a value for the `userToRun` field as that
   * requires calling the standard apis which require "cluster-admin" authz.
   */
  @action(group+='write')
  testUpsertBatch: private function(objs: !?[mixing SqlHiAuthzQueueEntry],
                                    srcObjs: [mixing SqlHiAuthzQueueEntry],
                                    spec: UpsertSpec): ObjList<mixing SqlHiAuthzQueueEntry>
}
