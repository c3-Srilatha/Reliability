/**
 * Invalidation queue entry for implementing C3 Workflow framework.
 *
 * targetTypeId and targetObjId will be set based on Workflow instance. context will be set to the WorkflowRun.id.
 */
entity type SqlWorkflowQueueEntry mixes WorkflowQueueEntry, SqlInvalidationQueueEntry<string> schema name 'ASYNQ_WKFLOW' {

  version: ~ not persistable
}
