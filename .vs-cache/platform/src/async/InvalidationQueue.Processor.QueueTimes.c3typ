/**
 * Keeps track of the total amount of time (since the last reset) used by each queue.
 */
type InvalidationQueue.Processor.QueueTimes mixes Mutable {

  /**
   * Time used by each queue in the app
   */
  timesByQueue: member function(): map<Type, int>

  /**
   * Adds time used for a queue
   *
   * @param queue
   *        Queue to add time for
   * @param timeMillis
   *        Time used, in milliseconds
   */
  addTimeMillis: member function(queue: !Type, timeMillis: !int)

  /**
   * Resets the accumulated times
   */
  reset: member function()

  _timesByQueue: private MapBuilder<Type, int>
}
