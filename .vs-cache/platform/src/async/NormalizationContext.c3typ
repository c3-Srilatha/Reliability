/**
 * Used to handle context for TimeseriesInvalidationQueue compute/invalidate
 */
type NormalizationContext {

  /**
   * If there was any change in the time range
   */
  isTimeRangeAffected: boolean

  /**
   * If the time range was updated
   */
  isTimeRangeUpdated: boolean

  /**
   * Start date time of the time range affected
   */
  start: datetime

  /**
   * End data time for the time range affected
   */
  end: datetime

  /**
   * Override interval for normalization
   */
  overrideGrain: string

  /**
   * If set, normalization will be forced to do interval detection to determine normalization interval
   */
  forceGrainDetection: boolean

  /**
   * If set, we will force fully normalize a series that has been previously normalized
   */
  force: boolean
}
