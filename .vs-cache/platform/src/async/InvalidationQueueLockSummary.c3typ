type InvalidationQueueLockSummary {

  /**
   * Queue the summary is for.
   */
  queue: string

  /**
   * Node that is computing the queue entries for this entry.
   */
  computingNodeId: string

  /**
   * Target type.
   */
  targetType: string

  /**
   * Target obj id.  Only populated when the queue type isn't grouped by targetObjId and the id is meaningful
   * (e.g. BatchQueue/MapReduceQueue).
   */
  targetObjId: string

  /**
   * Entry type.
   */
  entryType: string

  /**
   * Number of queue entries represented by the summary.
   */
  numEntries: int
}
