/**
 * Batch job definitions for batch jobs started from RefreshMetricDepsTask for asynchronous processing.
 */
@action(group+='data-admin')
entity type RefreshMetricDepsBatchJob extends RefreshBatchJob<RefreshMetricDepsBatchJob, RefreshMetricDepsSpec, RefreshMetricDepsSpec> mixes Value type key 'REFRMDEP' {

  scheduleBatchesForAppRebuilder: ~(appRebuilder: !AppRebuilder, spec: !RefreshMetricDepsSpec)
  refresh:                        ~(spec: !RefreshMetricDepsSpec)
  shouldHandle:                   ~(spec: !RefreshMetricDepsSpec)
  clearIssues:                    ~(spec: !RefreshMetricDepsSpec)
  doStart:                        ~
}
