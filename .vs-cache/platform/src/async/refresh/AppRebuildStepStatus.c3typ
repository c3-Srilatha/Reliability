type AppRebuildStepStatus {

  /**
   * When the step started.
   */
  started: datetime

  /**
   * Last time the status was updated.
   */
  updated: datetime

  /**
   * Upon completion, the number of minutes the step took.
   */
  durationMin: int

  /**
   * Current status of the step.
   */
  status: !string enum('pending', 'running', 'completed', 'skipped', 'canceled', 'failed')

  /**
   * Step specific progress information.
   */
  progress: string

  /**
   * Errors encountered processing the step.
   */
  errors: string

  /**
   * @return true if the job is in the "initial" state.
   */
  isPending: inline member function(): !boolean

  /**
   * @return true if the job is in the "running" state.
   */
  isRunning: inline member function(): !boolean

  /**
   * @return true if the job is in the "completed" state.
   */
  isCompleted: inline member function(): !boolean

  /**
   * @return true if the job is in the "failing" state.
   */
  isSkipped: inline member function(): !boolean

  /**
   * @return true if the job is in the "failing" state.
   */
  isFailed: inline member function(): !boolean

  /**
   * @return true if the job is in the "canceled" state.
   */
  isCanceled: inline member function(): !boolean
}
