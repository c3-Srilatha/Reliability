/**
 * Batch job definitions for batch jobs started from RunCreatedOrUpdatedTask for asynchronous processing.
 */
@action(group+='data-admin')
entity type RunCreatedOrUpdatedBatchJob extends RefreshBatchJob<RunCreatedOrUpdatedBatchJob, RunCreatedOrUpdatedSpec, RunCreatedOrUpdatedSpec> mixes Value type key 'RUNCORU' {

  refreshIds:   ~(type: !Type, spec: !RunCreatedOrUpdatedSpec, ids: [string])
  shouldHandle: ~(spec: !RunCreatedOrUpdatedSpec)
}
