/**
 * Batch job definitions for batch jobs started from RefreshNormalizationTask for asynchronous processing.
 */
@action(group+='data-admin')
entity type RefreshNormalizationBatchJob extends RefreshBatchJob<RefreshNormalizationBatchJob, RefreshNormalizationSpec, RefreshNormalizationSpec> mixes Value type key 'REFRNORM' {

  refreshIds:   ~(type: !Type, spec: !RefreshNormalizationSpec, ids: [string])
  isRefreshAll: ~(spec: !RefreshNormalizationSpec)
  issueType:    ~
}
