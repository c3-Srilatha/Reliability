/**
 * Maintains the state of all calc fields designated as either `periodic` or `scheduled`.  Each entry will represent
 * a single periodic or scheduled calc field and its id will be a "safeId" based on the qualified field path for the
 * field.
 */
entity type PeriodicCalcState mixes Cached, InvalidationDisabled {

  /**
   * Field path for the calc field represented by this entry
   */
  calcFieldPath: !string

  /**
   * The calc period specified if the field is a periodic calc
   */
  calcPeriod: string

  /**
   * True if the specified calc period for the field is invalid.  Refresh will be skipped.
   */
  calcPeriodInvalid: boolean

  /**
   * The calc schedule specified if the field is a scheduled calc
   */
  calcSchedule: string

  /**
   * True if the specified calc schedule for the field is invalid.  Refresh will be skipped.
   */
  calcScheduleInvalid: boolean

  /**
   * True if the specified calc schedule doesn't indicate any further refreshes.  Refresh will be skipped.
   */
  calcScheduleComplete: boolean

  /**
   * History entry for the last time the field was refreshed
   */
  lastRefresh: PeriodicCalcStateHistory

  /**
   * The next time the field will be refreshed based on when it was last refreshed and its defined period or schedule
   */
  nextRefresh: datetime

  /**
   * If the entry fails validation for any reason, the associated error message.  If this field is not null, processing
   * will be skipped for this entry until it is corrected.
   */
  validationError: string

  /**
   * Refresh history for the calc field
   */
  @db(order='descending(refreshedAt)', limit=10)
  history: [PeriodicCalcStateHistory](parent)

  /**
   * @return all calc fields that are designated to be refreshed with a fixed period
   */
  periodicCalcs: function(): set<FieldPath>

  /**
   * @return all calc fields that are designated to refreshed on a fixed schedule
   */
  scheduledCalcs: function(): set<FieldPath>

  /**
   * Function periodically called by a cron job to perform any necessary refreshes base on the last refresh time and
   * the period of schedule for each calc field.
   */
  refresh: function()

  /**
   * @return true if the app currently has any periodic calcs
   */
  hasPeriodicCalcs: function(): boolean

  /**
   * @return true if the app currently has any scheduled calcs
   */
  hasScheduledCalcs: function(): boolean

  /**
   * @return true if the app currently has any periodic or scheduled calcs
   */
  hasPeriodicOrScheduledCalcs: function(): boolean

  /**
   * @return true if the system cron job for processing periodic calcs exists and is active.
   */
  isCronJobActive: function(): boolean

  /**
   * Creates the system cron job for processing periodic calcs if it doesn't already exists and makes sure it is active.
   */
  activateCronJob: function()
}
