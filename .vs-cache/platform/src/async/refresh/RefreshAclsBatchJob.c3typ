/**
 * Batch job definitions for batch jobs started from RefreshAclsTask for asynchronous processing.
 */
@action(group+='data-admin')
entity type RefreshAclsBatchJob extends RefreshBatchJob<RefreshAclsBatchJob, RefreshAclsSpec, RefreshAclsSpec> mixes Value type key 'REFRACLS' {

  refreshIds: ~(type: !Type, spec: !RefreshAclsSpec, ids: [string])
  issueType:  ~
}
