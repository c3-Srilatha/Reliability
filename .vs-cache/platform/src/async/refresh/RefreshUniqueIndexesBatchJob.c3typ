/**
 * Batch job definitions for batch jobs started from RefreshUniqueIndexesTask for asynchronous processing.
 */
@action(group+='data-admin')
entity type RefreshUniqueIndexesBatchJob extends RefreshBatchJob<RefreshUniqueIndexesBatchJob, RefreshUniqueIndexesSpec, RefreshUniqueIndexesSpec> mixes Value type key 'REFRUNIQI' {

  refreshIds: ~(type: !Type, spec: !RefreshUniqueIndexesSpec, ids: [string])
}
