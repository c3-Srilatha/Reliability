/**
 * History entries for the {@link PeriodicCalcState} type.  Each entry will contain info about a refresh operation
 * performed for a single periodic or scheduled calc field.
 */
@db(compactType=true, systemType=true)
entity type PeriodicCalcStateHistory mixes InvalidationDisabled {

  /**
   * Periodic or scheduled calc field entry in {@link PeriodicCalcState} that this refresh was performed for.
   */
  parent: !PeriodicCalcState

  /**
   * When the refresh operation was performed
   */
  refreshedAt: !datetime

  refreshJob: !RefreshCalcFieldsBatchJob

  /**
   * If the entry fails validation for any reason, the associated error message.  If this field is not null, processing
   * will be skipped for this entry until it is corrected.
   */
  validationErrorMsg: string

  /**
   * If an error occurs launching the `refreshCalcFields` operation, this field will be set with the appropriate error
   * message.  If that occurs, the operation will be tried at the next scheduled time based on the period or schedule
   * defined for the field.
   */
  refreshError: string
}
