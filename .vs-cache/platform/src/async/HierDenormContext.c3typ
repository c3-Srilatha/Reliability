/**
 * Used to handle context for HierarchyDenormQueue compute/invalidate.
 */
type HierDenormContext {

  /**
   * Arry of ids that have been changed / altered.
   */
  invalidatedVertices: [string]

  /**
   * Hierarchy denorm type (Eg. OrganizationHierarchyDenorm).
   */
  hierDenormType: Type

  /**
   * Edge Type (Eg. OrganizationRollup).
   */
  edgeType: Type
}
