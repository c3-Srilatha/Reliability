/**
 * Kind of data in {@link DataLoadContext#content}
 */
enum type SourceQueueContextKind {

  /**
   * Use when the payload in the sources queue is sources
   */
  SRCS

  /**
   * Use when the payload in the sources queue is sources and only chunking is needed
   */
  SRCS_CHUNKING

  /**
   * Used to specify the status has to be updated on {@link Sources}
   */
  STATUS
}
