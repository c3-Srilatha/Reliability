/**
 * Used to handle context for {@link SourceQueue} compute/invalidate
 */
type SourceQueueContext {

  sourceCollectionName: string serialized SourceCollection

  /**
   * id of the DataIntegSpec
   */
  // TODO: PLAT-89516: Remove deprecated SourceQueueContext#runtimeSpec and make DataIntegSpec not mix StringSerializable
  @deprecated(finalVersion='8.4', details='use runtimeDataIntegSpec instead')
  runtimeSpec: string serialized DataIntegSpec

  /**
   * spec {@see DataIntegSpec}
   */
  runtimeDataIntegSpec: DataIntegSpec
}
