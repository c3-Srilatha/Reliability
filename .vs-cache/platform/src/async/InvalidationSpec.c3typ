/**
 * C3 type for arguments for InvalidationQueue functions.
 *
 * in the most generic sense all contexts apply to all ids
 *
 * however in real use cases there is either 1 id and a set of contexts or set of ids and a single context
 */
type InvalidationSpec mixes Spec {

  /**
   * Set of ids to be invalidated.
   */
  ids: [string]

  /**
   * Set of contexts for this invalidation. Context type depends on the invalidation queue.
   */
  contexts: [string | Obj]

  /**
   * @see InvalidationQueueEntry.entryType
   */
  entryType: string

  /**
   * Priority for invalidation queue entries.  If not specified, the default priority for the queue will be used.
   */
  priority: int

  /**
   * When non-null, the invalidation queue entries will only be processed by servers with a matching nodePool.
   * When null, the entries will only be processed by servers from default nodePool.
   */
  nodePool: string

  /**
   * If set to true, {@link Action.Context} will be propagated to invalidation queue entries.
   */
  propagateActionContext: boolean

  /**
   * If true, and invalidation is being done with autoCommit, then the state of the entries will be set to "disabled"
   * rather than "pending".
   */
  disabled: boolean

  /**
   * Makes an invalidation spec for a single id and context.
   *
   * @param id
   *           Target id to invalidate.
   * @param context
   *           Context to invalidate with.
   * @param entryType
   *           Entry type for the queue entry.
   * @param priority
   *           Priority for the invalidation queue entry.  If null, the default priority for the queue will be used.
   *
   * @return the requested invalidation spec.
   */
  makeSingleSpec: function(id: !string, context: any, entryType: string, priority: int): InvalidationSpec

  /**
   * Makes an invalidation spec for multiple ids/contexts.  When invalidated, an invalidation queue entry for every
   * id paired with every context will be created.
   *
   * @param ids
   *           Target ids to invalidate.
   * @param contexts
   *           Contexts to invalidate with.
   * @param entryType
   *           Entry type for the queue entry.
   * @param priority
   *           Priority for the invalidation queue entry.  If null, the default priority for the queue will be used.
   *
   * @return the requested invalidation spec.
   */
  makeMultiSpec: function(ids: !?[string], contexts: [any], entryType: string, priority: int): InvalidationSpec
}
