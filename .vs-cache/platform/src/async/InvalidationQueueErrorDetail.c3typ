/**
 * Details of the error for an InvalidationQueueError entry.
 */
type InvalidationQueueErrorDetail {

  /**
   * C3 Action id of the failed action. Can be used to lookup logs e.g. in Splunk.
   */
  failedActionId: string

  /**
   * Timestamp when this action processing has started.
   */
  processedAt: datetime

  /**
   * Short error message describing failure.
   */
  errorMsg: string

  /**
   * Concatenated error codes describing the error.
   */
  errorCodes: string

  /**
   * Detailed error message describing failure.
   */
  errorLog: string
}
