/**
 * Invalidation queue for mapReduce job processing.
 *
 * @see MapReduceQueueEntry
 */
@invalidationQueueOptions(defaultReportGrouping='targetTypeId, targetObjId, status',
                          detailReportGrouping='targetTypeId, targetObjId, priority, entryType, status',
                          defaultErrorReportGrouping='targetTypeId, errorCode, review',
                          detailErrorReportGrouping='targetTypeId, targetObjId, errorCode, review')
type MapReduceQueue mixes InvalidationQueue<MapReduceQueueEntry>, CancelableInvalidationQueue, Value
