/**
 * Invalidation queue for asynchronous action processing.  Each entry represents a single action invocation.
 *
 * @see ActionQueueEntry
 */
@invalidationQueueOptions(defaultReportGrouping='targetTypeId, entryType, status',
                          detailReportGrouping='targetTypeId, targetObjId, entryType, status',
                          defaultErrorReportGrouping='targetTypeId, entryType, errorCode, review',
                          detailErrorReportGrouping='targetTypeId, targetObjId, entryType, errorCode, review')
type ActionQueue mixes InvalidationQueue<ActionQueueEntry>, CancelableInvalidationQueue, Value {

  /**
   * Submits an action to the action queue for asynchronous processing.
   *
   * @param type
   *           Type to submit the action for.
   * @param action
   *           Name of action to submit.
   * @param context
   *           Context for submitting action with specific argument values {@see ActionQueueContext.arguments}.
   * @param autoCommit
   *           If true, the action queue entry will be committed, otherwise it will be left in the initial state and
   *           the caller is responsible for committing it.
   * @param nodePools
   *           Optional id for {@link App.NodePool} to run action on.
   * @return the {@link: ActionQueueEntry#targetObjId} for the queue entry created.  This can be used to locate the
   *         entry in subsequent processing (e.g. for {@link: AsyncAction#interrupt}).
   */
  submitAction: function(typeRef: !Type,
                         action: !string,
                         context: ActionQueueContext,
                         autoCommit: boolean = true,
                         nodePool: string = ''): !string

  /**
   * Sets the priority for action queue entries matching the specified type and action.
   *
   * @param type
   *           Target type to set priority for.
   * @param action
   *           Action name to set priority for.
   * @param priority
   *           New priority value (lower value is higher priority).
   *
   * @return the number of entries updated.
   */
  setPriority: function(type: !Type, action: !string, priority: !int): !int

  /**
   * Clears action queue entries matching the specified type and action.
   *
   * @param type
   *           Target type to clear entries for.
   * @param action
   *           Action name to clear entries for.
   */
  clear: function(type: !Type, action: !string)

  /**
   * Recovers failed action queue entries matching the specified type and action.
   *
   * @param type
   *           Target type to recover failed entries for.
   * @param action
   *           Action name to recover failed entries for.
   */
  recoverFailed: function(type: !Type, action: !string)

  /**
   * Returns action queue entries matching the specified type, action, and status.
   *
   * @param type
   *           Target type to find entries for.
   * @param action
   *           Action name to find entries for. If not specified, all actions are included.
   * @param status
   *           Status to filter entries by (e.g., "pending", "computing").
   * @param limit
   *           Maximum number of entries to return.
   *
   * @return array of matching entries.
   */
  @action(group+='monitor')
  entries: function(type: !Type, action: string, status: string, limit: int = 10): [ActionQueueEntry]

  /**
   * Returns pending action queue entries matching the specified type and action.
   *
   * @param type
   *           Target type to find entries for.
   * @param action
   *           Action name to find entries for. If not specified, all actions are included.
   * @param limit
   *           Maximum number of entries to return.
   *
   * @return array of matching entries.
   */
  @action(group+='monitor')
  pending: function(type: !Type, action: string, limit: int = 10): [ActionQueueEntry]

  /**
   * Returns computing action queue entries matching the specified type and action.
   *
   * @param type
   *           Target type to find entries for.
   * @param action
   *           Action name to find entries for. If not specified, all actions are included.
   * @param limit
   *           Maximum number of entries to return.
   *
   * @return array of matching entries.
   */
  @action(group+='monitor')
  computing: function(type: !Type, action: string, limit: int = 10): [ActionQueueEntry]

  /**
   * Returns action queue errors matching the specified type and action.
   *
   * @param type
   *           Target type to find errors for.
   * @param action
   *           Action name to find errors for.
   * @param limit
   *           Maximum number of errors to return.
   *
   * @return array of matching errors.
   */
  @action(group+='monitor')
  errors: function(type: !Type, action: string, limit: int = 10): [InvalidationQueueError]
}
