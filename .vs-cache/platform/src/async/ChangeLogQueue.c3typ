/**
 * Invalidation queue for generic invalidation of data changes.  Each entry represents a single change that a
 * {@link ChangeLogListener} reported as being interested in.
 *
 * @see ChangeLogQueueEntry
 */
@invalidationQueueOptions(grouping='targetObjId, entryType',
                          defaultReportGrouping='targetTypeId, status',
                          detailReportGrouping='targetTypeId, targetObjId, context.listenerTypeId, status',
                          defaultErrorReportGrouping='targetTypeId, errorCode, review',
                          detailErrorReportGrouping='targetTypeId, errorCode, review')
type ChangeLogQueue mixes InvalidationQueue<ChangeLogQueueEntry>, MergeableInvalidationQueue<ChangeLogQueueEntry>, Value {

  /**
   * Provides a summary of the current contents of the ChangeLogQueue.  The summary contains backward dependency
   * information, grouped by targetTypeId.  Note that the backward dependencies returned will
   * be the entire set for the target type, not limited to those that will be specifically triggered by any/all
   * of the entries.
   */
  summary: function(): [ChangeLogSummaryResult]

  dataIssueTypes: ~
}
