/**
 * Type for storing all histories of a queue.
 */
entity type InvalidationQueueReport mixes MetricEvaluatable schema name 'ASYNQ_INVQRPT' {

  /**
   * An array to store all the histories of a queue.
   */
  histories: [InvalidationQueueHistory](queueType)

  /**
   * Upsert the status of each invalidation queue into database with a timestamp.
   * This function is called by a cron job every 5 minutes to keep tracking the status of invalidation queues.
   */
  recordStats: function()

  /**
   * Remove Invalidation Queue Histories where its timestamp is older than 1 year ago.
   */
  removeOldStats: function()
}
