/**
 * Invalidation queue for stored calc processing.  Each entry is for invalidating one or more calc fields in one target
 * instance.
 *
 * @see CalcFieldsQueueEntry
 */
@invalidationQueueOptions(grouping='targetObjId',
                          defaultReportGrouping='targetTypeId, status',
                          detailReportGrouping='targetTypeId, targetObjId, status',
                          defaultErrorReportGrouping='targetTypeId, errorCode, review',
                          detailErrorReportGrouping='targetTypeId, errorCode, review')
type CalcFieldsQueue mixes InvalidationQueue<CalcFieldsQueueEntry>, MergeableInvalidationQueue<CalcFieldsQueueEntry>, Value {

  /**
   * Scans the queue, grouping by targetTypeId/context and, for every entry where the threshold is
   * reached, schedules a refreschCalcFields call in the action queue for the queue entries and the fields specified in
   * the context.  The calc field queue entries will be removed during the refreshCalcFields operation.
   *
   *
   * @param thresholdPct
   *           Percentage of entries (between 1 and 100) that should exist for a particular
   *           targetTypeId/context in comparison to the total number of entries in that target type
   *           that should trigger rescheduling.  A value of <= 0 will process all entries/types.  Default is 50%
   * @param batchSize
   *           Batch size to use for calls to refreshCalcFields.
   */
  rescheduleByType: function(thresholdPct: int = 50, batchSize: int = 1000)

  dataIssueTypes: ~
}
