/**
 * Spec for the @link{InvalidationQueueCompactor} job started from @link{InvalidationQueue.compact}.
 */
type InvalidationQueueCompactorOptions mixes BatchJobOptions {

  /**
   * Queue type name that an individual instance of the mapReduce job is being run for.
   */
  queueType: !string

  /**
   * Target type to be compacted.
   */
  targetTypeId: !int

  batchSize: int = 1000
}
