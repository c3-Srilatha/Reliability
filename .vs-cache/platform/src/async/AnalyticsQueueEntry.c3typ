/**
 * Invalidation queue entry for implementing automatic refresh of analytics.  Each entry contains information for one
 * analytic source type instance with a time range that it should be processed for.
 *
 * @see AnalyticsContainer.invalidateSources
 */
type AnalyticsQueueEntry mixes InvalidationQueueEntry<AnalyticsContext>
