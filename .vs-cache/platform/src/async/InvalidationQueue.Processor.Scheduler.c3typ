/**
 * Used to implement weighted priority scheduling for invalidation queues
 */
type InvalidationQueue.Processor.Scheduler mixes Mutable {

  iqp: InvalidationQueue.Processor

  /**
   * Accumulated time usage for each queue
   */
  queueTimes: InvalidationQueue.Processor.QueueTimes

  /**
   * Last time the accumulated usage was reset
   */
  lastReset: datetime

  /**
   * Last time an error was thrown while calling {@link checkRefresh}.  We only throw an error every 30 minutes.
   */
  lastErrorThrown: datetime

  /**
   * Factor to be applied to each queue's accumulated time based on the configured priority for the queue
   */
  priorityFactors: MapBuilder<Type, int>

  /**
   * Constructs scheduler in initial state
   *
   * @param iqp
   *        InvalidationQueue.Processor instance the scheduler is owned by
   */
  initialize: function(iqp: !InvalidationQueue.Processor): !InvalidationQueue.Processor.Scheduler

  /**
   * Adds time for the specifed app. Called when an active compute action completes.
   *
   * @param queue
   *        queue to add time for
   * @param appCode
   *        app to add time for
   * @param time
   *        time to add
   */
  addTimeMillis: inline member function(queue: !Type, time: !int)

  /**
   * Refreshes the list of queues that have queue entries
   *
   * @return true if there are any queues with entries to process.
   */
  checkRefresh: member function(): boolean

  /**
   * Orders the specified queues by priority based on accumulated usage and configured priorities
   */
  applyPriority: inline member function(queues: [Type]): [Type]

  /**
   * Resets the priority factors (to avoid accidental starvation)
   */
  resetPriorityFactors: inline member function()

  /**
   * Queues that currently have entries that need processing
   */
  queues: inline member function(): [Type]

  /**
   * Gets info about the running jobs for a queue.  Note that this is only relevant for {@link BatchQueue} and
   * {@link MapReduceQueue}.
   *
   * @param queueType
   *        Queue type to get running job info for
   *
   * @return info about the running jobs for a queue.
   */
  runningJobs: inline member function(queueType: !Type): [InvalidationQueueRunningJobInfo]

  _queues:                   private ?Map<Type, int>
  _lastRefresh:              private @java(class="java.util.concurrent.atomic.AtomicLong") native
  _batchJobs:                private ?[InvalidationQueueRunningJobInfo]
  _lastBatchJobsRefresh:     private @java(class="java.util.concurrent.atomic.AtomicLong") native
  _mapReduceJobs:            private ?[InvalidationQueueRunningJobInfo]
  _lastMapReduceJobsRefresh: private @java(class="java.util.concurrent.atomic.AtomicLong") native
}
