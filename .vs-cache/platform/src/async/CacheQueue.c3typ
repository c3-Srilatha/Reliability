/**
 * Invalidation queue for cache invalidation processing.  Each entry is for processing a single invalidation entry
 * {@link CacheQueueEntry}.
 */
@invalidationQueueOptions(grouping='targetObjId, context',
                          priority='urgent',
                          defaultReportGrouping='targetTypeId, targetObjId, status',
                          detailReportGrouping='targetTypeId, targetObjId, entryType, status',
                          defaultErrorReportGrouping='targetTypeId, entryType, errorCode, review',
                          detailErrorReportGrouping='targetTypeId, targetObjId, entryType, errorCode, review')
type CacheQueue mixes InvalidationQueue<CacheQueueEntry>, MergeableInvalidationQueue<CacheQueueEntry>, Value {

  /**
   * Submits an event to the cache queue for invalidation processing.
   *
   * @param message
   *           Message for submitting cache invalidation event with specific argument values {@see CacheMessage.arguments}.
   * @param autoCommit
   *           If true, the action queue entry will be committed, otherwise it will be left in the initial state and
   *           the caller is responsible for committing it.
   */
  submitCacheEvent: function(message: !CacheMessage, autoCommit: boolean = true)
}
