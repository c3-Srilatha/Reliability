/**
 * Comments for an {@link InvalidationQueueErrorReview}.
 */
@db(index+=['review, meta.created'])
entity type InvalidationQueueErrorReviewComment schema name 'ASYNQ_IQEREVC' {

  /**
   * Comment text
   */
  comment: !string

  /**
   * Review that the comment is for.
   */
  review: !InvalidationQueueErrorReview
}
