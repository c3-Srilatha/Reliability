/**
 * Configuration for handling invalidations.  The most common usage is to override this at the TAG level.
 */
@config(minOverride=APP, maxOverride=APP)
type InvalidationConfig mixes Config, Singleton {

  /**
   * Apps that will be invalidated for operations that support multi-app invalidation (e.g. stored calc).
   */
  appIds: [string serialized AppId]

  // @return the apps for the specified appIds.
  apps: function(): [App]

  /**
   * The probability used to determine how often to attempt to merge existing queue entries with existing ones (for
   * mergeable queues only.
   */
  defaultMergeProbability: int = 10

  /**
   * If true, upserts will not trigger async invalidation/processing (except for the async callbacks).
   */
  upsertAsyncProcessingDisabled: boolean
}
