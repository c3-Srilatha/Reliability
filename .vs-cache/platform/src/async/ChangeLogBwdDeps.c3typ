/**
 * Backward deps for the ChangeLog.  Returned as the result from {@link ChangeLogQueueEntry} or as the mixin type
 * of {@link ChangeLogResultSummary} which is returned from {@ChangeLogQueue.summary}.
 */
type ChangeLogBwdDeps {

  /**
   * Calc field backward dependencies.
   */
  calcBwdDeps: [TypeBackwardDep]

  /**
   * Metric dependency backward dependencies.
   */
  metricBwdDeps: [TypeBackwardDep]

  /**
   * ACL privilege backward dependencies.
   */
  aclBwdDeps: [TypeBackwardDep]
}
