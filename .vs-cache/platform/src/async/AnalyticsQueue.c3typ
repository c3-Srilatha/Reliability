/**
 * Invalidation queue for analytic invalidation processing.  Entries are added whenever data changes that a
 * {@link SimpleMetric} used by an analytic depends on.  The appropriate time range information is included in the
 * entry to enable the analytic to be processed for only the affected time range.
 *
 * @see AnalyticsQueueEntry
 */
@invalidationQueueOptions(grouping='targetObjId, context.metricGroup',
                          defaultReportGrouping='targetTypeId, status',
                          detailReportGrouping='targetTypeId, status',
                          defaultErrorReportGrouping='targetTypeId, errorCode, review',
                          detailErrorReportGrouping='targetTypeId, errorCode, review')
type AnalyticsQueue mixes InvalidationQueue<AnalyticsQueueEntry>, MergeableInvalidationQueue<AnalyticsQueueEntry>, Value {

  /**
   * Creates entries in the queue to invalidate analytics.  When processed, these entries will be used
   * to call {@link AnalyticsContainer.invalidateSources}.
   *
   * @param tag
   *           Target tag to invalidate analytics sources for
   * @param srcs
   *           Specification of the source objs to invalidate along with various parameters
   */
  invalidateSources: function(tag: Tag, srcs: [MetricGroupInvalidationSpec])

  dataIssueTypes: ~
}
