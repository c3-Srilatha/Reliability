/**
 * History of a queue's status at a certain timestamp.
 */
entity type InvalidationQueueHistory schema name 'ASYNQ_INVQHST' {

  /**
   * The timestamp of the history.
   */
  timestamp: !datetime

  /**
   * Name of the Queue type.
   */
  queueType: !string

  /**
   * If the queue is paused
   */
  paused: !boolean

  /**
   * Initial count of the queue.
   */
  initial: !int

  /**
   * Pending count of the queue.
   */
  pending: !int

  /**
   * Computing Actions count of the queue.
   */
  computingActions: !int

  /**
   * Computing Entries count of the queue.
   */
  computingEntries: !int

  /**
   * Count of entries awaiting compute.
   */
  awaitingCompute: !int

  /**
   * Number of actions required to process all pending entries.
   */
  pendingActions: !int

  /**
   * Failed counts of the queue.
   */
  failed: !int

  /**
   * Unreviewed failed count of the queue.
   */
  unreviewedFailed: !int
}
