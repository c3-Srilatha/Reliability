/**
 * Result returned from {@link InvalidationQueueStore.locked}
 */
type LockInfo {

  /**
   * Globally unique id for the lock (e.g. GUID) that was assigned by {@link InvalidationQueueStore.lock}.
   */
  id: string

  /**
   * Computing node id that acquired the lock and will perform the compute action on the locked queue entries associated with the lock.
   */
  computingNodeId: string
}
