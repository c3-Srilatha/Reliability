/**
 * Configuration for invalidation queues.
 */
@config(minOverride=APP, maxOverride=CLUSTER)
type InvalidationQueueConfig mixes Config, Singleton {

  /**
   * Delay in milliseconds before a worker will start processing invalidation queue requests.
   */
  initialScheduleDelay: !int = 1

  /**
   * Sleep time in milliseconds between invalidation queue sweeps when the last sweep found nothing to process.
   */
  idleSleep: !int = 3000

  /**
   * Maximum number of attempts to retry compute for queue entries when retryable errors occur.
   */
  retryCount: !int = 5

  /**
   * Time between sweeps for recovering stuck queue entries.
   */
  recoveryIntervalMinute: !int32 = 10

  /**
   * Maximum recursive depth limit for asynchronous processing.
   */
  depthLimit: !int32 = 100

  /**
   * The number of seconds that a queue that has entries will continue to be checked during the lock operation once it
   * no longer has entries.
   */
  emptyQueueCheckSeconds: !int32 = 5

  /**
   * Maximum number of parallel processing threads for cloud queues.
   */
  @beta
  maxConcurrentProcessingThreads: !int32 = 8

  /**
   * Backing store (e.g. handles queue entry persistence, locking, etc.) for the invalidation queues.
   */
  store: !string = 'SqlInvalidationQueueStore'

  @deprecated(details="This is currently ignored")
  maxSchedulingThreads: !int32 = 1

  /**
   * Interval for resetting the accumulated time consumed by tags for scheduling "fairness"
   */
  schedQueueTimesResetIntervalMinute: !int32 = 5

  /**
   * Queues to monitor. When included, {@link #statsToMonitor} will be included for the queue.
   * Do not include "Queue" at the end of each entry, example: use ["Cron", "CalcFields"] instead of
   * ["CronQueue", "CalcFieldsQueue"].
   */
  queuesToMonitor: [string]

  /**
   * {@link InvalidationQueueStats} (names of the fields) to monitor for the queues specified in {@link queuesToMonitor}.
   * {@link InvalidationQueueStats#pendingActions} will never be available.
   * example: use ["initial", "awaitingCompute", "failed"]
   */
  statsToMonitor: [string]

  /**
   * CacheQueue config
   */
  CacheQueue: InvalidationQueueConfigChild

  /**
   * ChangeLogQueue config
   */
  ChangeLogQueue: InvalidationQueueConfigChild

  /**
   * CalcFieldsQueue config
   */
  CalcFieldsQueue: InvalidationQueueConfigChild

  /**
   * NormalizationQueue config
   */
  NormalizationQueue: InvalidationQueueConfigChild

  /**
   * PopulateAclQueue config
   */
  PopulateAclQueue: InvalidationQueueConfigChild

  /**
   * HierarchyDenormQueue config
   */
  HierarchyDenormQueue: InvalidationQueueConfigChild

  /**
   * ActionQueue config
   */
  ActionQueue: InvalidationQueueConfigChild

  /**
   * MetricDepsQueue config
   */
  MetricDepsQueue: InvalidationQueueConfigChild

  /**
   * MetricsQueue config
   */
  MetricsQueue: InvalidationQueueConfigChild

  /**
   * AnalyticsQueue config
   */
  AnalyticsQueue: InvalidationQueueConfigChild

  /**
   * JmsDataLoadQueue config
   */
  JmsDataLoadQueue: InvalidationQueueConfigChild

  /**
   * SourceQueue config
   */
  SourceQueue: InvalidationQueueConfigChild

  /**
   * SourceStatusQueue config
   */
  SourceStatusQueue: InvalidationQueueConfigChild

  /**
   * SqsQueue config
   */
  SqsQueue: InvalidationQueueConfigChild

  /**
   * KinesisQueue config
   */
  KinesisQueue: InvalidationQueueConfigChild

  /**
   * EventHubQueue config
   */
  EventHubQueue: InvalidationQueueConfigChild

  /**
   * KafkaQueue config
   */
  KafkaQueue: InvalidationQueueConfigChild

  /**
   * CronQueue config
   */
  CronQueue: InvalidationQueueConfigChild

  /**
   * WorkflowQueue config
   */
  WorkflowQueue: InvalidationQueueConfigChild

  /**
   * Default queue config for any queues not specified above.
   */
  default: InvalidationQueueConfigChild

  /**
   * @return configuration of the specific file system.
   */
  childConfig: member function(queueTypeName: !string): !InvalidationQueueConfigChild
}
