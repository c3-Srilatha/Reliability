/**
 * Process invalidation queue entries for a single `App` execution environment.
 */
type InvalidationQueue.Processor mixes Configurable<InvalidationQueueConfig> {

  /**
   * Db.Engine that owns this processor
   */
  dbe: Db.Engine

  /**
   * Maximum job concurrency for batch/mapReduce jobs
   */
  maxJobConcurrency: inline member function()
                                     : @java(class="java.util.Map<String, c3.platform.typesys.value.Triple<c3.platform.typesys.value.datetime.DateTime, Long, Long>>") native

  /**
   * Node id
   */
  serverNodeId: string

  /**
   * Summary of time used by each queue
   */
  computeSummary: InvalidationQueue.Processor.ComputeSummary

  /**
   * Starts processing
   */
  start: inline member function()

  /**
   * @return the current status of the various functions/states of the processor
   */
  status: function(): !InvalidationQueue.Processor.Status

  getStatus: private member function(): !InvalidationQueue.Processor.Status

  /**
   * Makes new instance of InvalidationQueue.Processor
   */
  makeInitial: private inline function(dbe: !Db.Engine): !InvalidationQueue.Processor

  /**
   * Schedules queue entries for processing
   */
  scheduler: inline member function(): InvalidationQueue.Processor.Scheduler

  /**
   * Number of threads currently scheduling queue entries for processing
   */
  numThreadsScheduling: member function(): !int

  /**
   * Increments the number of threads currently scheduling queue entries for processing
   */
  incrementNumThreadsScheduling: member function(): !int

  /**
   * Increments the number of threads currently scheduling queue entries for processing
   */
  decrementNumThreadsScheduling: member function(): !int

  /**
   * All currently used queue types
   */
  allQueueTypes: member function(): [Type]

  /**
   * Current active compute actions
   */
  activeComputeActions: member function(): map<string, InvalidationQueue.Processor.ComputeDesc>

  /**
   * Recovers stuck invalidation queue entries
   *
   * @param forNode:
   *        If true, only queue entries for the current node will be recovered.  Otherwise entries for all nodes will
   *        be.
   */
  recoverStuck: private member function(forNode: boolean)

  /**
   * Locks and asynchronously dispatches actions for queue entries for the specified queue.
   *
   * @param queueType
   *        Queue to lock and dispatch for
   *
   * @param forLeader
   *        If true, the request is being made specifically for actions that are specified to be run on a leader node.
   *
   * @return True if any entries were dispatched.
   */
  lockAndDispatchComputesForQueue: private member function(queueType: !Type, forLeader: boolean): boolean

  /**
   * @return true if the specified queue is disabled
   */
  isQueueDisabled: private cached member function(queueType: !Type): boolean

  /**
   * @return true if the processor instance is currently processing entries (e.g. not stopped or terminated, etc.).
   */
  isProcessing: member function(): boolean

  /**
   * Timestamp of last pass through the main processing loop
   */
  lastProcessed: member function(): datetime

  /**
   * Timestamp of last successful dispatch of queue entries from main processing loop
   */
  lastDispatched: member function(): datetime

  /**
   * Timestamp when main processing loop was started
   */
  processingStarted: inline member function(): datetime

  /**
   * Timestamp when processing loop terminated
   */
  processingTerminated: inline member function(): datetime

  processingTerminatedCause: inline member function(): string
  setProcessingTerminated:   private inline member function(cause: !string)

  /**
   * The last error encountered during processing
   */
  lastError: inline member function(): @java(class="java.lang.Throwable") native

  lastErrorReportedAt:         inline member function(): datetime
  setLastError:                private inline member function(lastError: @java(class="java.lang.Throwable") !native)
  _scheduler:                  private @java(class="java.util.concurrent.atomic.AtomicReference<c3.platform.async.InvalidationQueue.Processor.Scheduler>") native
  _activeComputeActions:       private MapBuilder<string, InvalidationQueue.Processor.ComputeDesc>
  _numThreadsScheduling:       private @java(class="java.util.concurrent.atomic.AtomicLong") native
  _shouldProcess:              private @java(class="java.util.concurrent.atomic.AtomicBoolean") native
  _isProcessing:               private @java(class="java.util.concurrent.atomic.AtomicBoolean") native
  _processingStarted:          private @java(class="java.util.concurrent.atomic.AtomicReference<c3.platform.typesys.value.datetime.DateTime>") native
  _processingTerminated:       private @java(class="java.util.concurrent.atomic.AtomicReference<c3.platform.typesys.value.datetime.DateTime>") native
  _processingTerminatedCause:  private @java(class="java.util.concurrent.atomic.AtomicReference<java.lang.String>") native
  _lastEmptyQueueCheckRefresh: private @java(class="java.util.concurrent.atomic.AtomicReference<c3.platform.typesys.value.datetime.DateTime>") native
  _lastProcessed:              private @java(class="java.util.concurrent.atomic.AtomicReference<c3.platform.typesys.value.datetime.DateTime>") native
  _lastDispatched:             private @java(class="java.util.concurrent.atomic.AtomicReference<c3.platform.typesys.value.datetime.DateTime>") native
  _lastError:                  private @java(class="java.util.concurrent.atomic.AtomicReference<java.lang.Throwable>") native
  _lastErrorReportedAt:        private @java(class="java.util.concurrent.atomic.AtomicReference<c3.platform.typesys.value.datetime.DateTime>") native
  _maxJobConcurrency:          @java(class="java.util.concurrent.atomic.AtomicReference<java.util.Map<String, c3.platform.typesys.value.Triple<c3.platform.typesys.value.datetime.DateTime, Long, Long>>>") native
}
