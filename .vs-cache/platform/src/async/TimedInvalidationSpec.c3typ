/**
 * Generic invalidation spec for collecting/merging time ranges for InvalidationQueueEntries
 */
type TimedInvalidationSpec<T> mixes Spec {

  /**
   * Type id for spec.
   */
  typeId: int

  /**
   * Obj id for spec.
   */
  objId: string

  /**
   * Priority for InvalidationQueueEntries created from spec.
   */
  priority: int

  /**
   * List of time ranges for spec.
   */
  timeRanges: [TimeRangeWithSourceInfo]

  /**
   * Constructs TimedInvalidationSpec from a single time range
   *
   * This function is not implemented in this type.  All implementations must be implemented in types that mixin this type to properly
   * handle grouping, etc.
   *
   * @param typeId
   *           Type id for new spec.
   * @param objId
   *           Obj id for new spec.
   * @param timeRange
   *           Time range for new spec.
   * @param priority
   *           Priority for new spec.
   * @param group
   *           Value for group field.  Only valid for types that support grouping
   *
   * @return new spec based on input parameters.
   */
  fromTimeRange: inline function(typeId: !int,
                                 objId: !string,
                                 timeRange: TimeRangeWithSourceInfo,
                                 priority: int,
                                 group: string): !T

  /**
   * Constructs TimedInvalidationSpec from a single time range's fields
   *
   * This function is not implemented in this type.  All implementations must be implemented in types that mixin this type to properly
   * handle grouping, etc.
   *
   * @param typeId
   *           Type id for new spec.
   * @param objId
   *           Obj id for new spec.
   * @param start
   *           Time range start.
   * @param end
   *           Time range end.
   * @param startSourceInfo
   *           Time range start source info.
   * @param endSourceInfo
   *           Time range end source info.
   * @param priority
   *           Priority for new spec.
   * @param group
   *           Value for group field.  Only valid for types that support grouping
   *
   * @return new spec based on input parameters.
   */
  fromTimeRangeFields: inline function(typeId: !int,
                                       objId: !string,
                                       start: datetime,
                                       end: datetime,
                                       startSourceInfo: TimestampSourceInfo,
                                       endSourceInfo: TimestampSourceInfo,
                                       priority: int,
                                       group: string): !T

  /**
   * Coalesces time ranges in multiple specs.  Specs with the same {@link objId} and grouping will be merged. Time ranges within
   * specs will be merged/split according to the other input parameters.
   *
   * This function is not implemented in this type.  All implementations must be implemented in types that mixin this type to properly
   * handle grouping, etc.
   *
   * @param specs
   *           Specs to coalesce.
   * @param sot
   *           If specified, this represents the start of time and no time ranges will include fall earlier than that.
   * @param eot
   *           If specified, this represents the end of time and no time ranges will fall later than that.
   * @param maxTimeRangeDays
   *           If specified, no time range will exceed the maxTimeRangeDays number of days.  If not specified, or <= 0, all time ranges
   *
   * @return new list of specs, merged as appropriate.
   */
  coalesce: function(specs: !?[T], sot: datetime, eot: datetime, maxTimeRangeDays: int = -1): [T]

  /**
   * @return earliest value for start timestamp.
   */
  earliest: inline member function(): datetime

  /**
   * @return latest value for end timestamp
   */
  latest: inline member function(): datetime
}
