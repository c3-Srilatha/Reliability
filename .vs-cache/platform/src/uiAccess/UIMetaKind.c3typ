/**
 * UI Metadata file kind.
 */
enum type UIMetaKind {

  /**
   * UI Application file.
   */
  APPLICATION = 'application'

  /**
   * UI pages.
   */
  PAGES = 'pages'

  /**
   * components.
   */
  COMPONENTS = 'components'

  /**
   * templates.
   */
  TEMPLATES = 'templates'

  /**
   * stylesheets.
   */
  STYLESHEETS = 'stylesheets'

  /**
   * Data Sources
   */
  DATA_SOURCES = 'dataSources'

  /**
   * Content
   */
  CONTENT = 'content'

  /**
   * Transform file content to json based on file kind.
   */
  transformContent: function(file: Pkg.File): json
}
