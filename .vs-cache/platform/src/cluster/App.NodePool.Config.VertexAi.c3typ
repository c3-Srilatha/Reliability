/**
 * VertexAi specific configuration options.
 */
@config(folder='App.NodePool.Config', doNotDefaultIfMissing=true)
@beta
type App.NodePool.Config.VertexAi mixes App.NodePool.Config {

  hardwareProfile: !~
  forName:         ~
  listConfigKeys:  ~

  /**
   * Sub path in NFS volume for config.
   */
  configVolumeSubPath: string = '/vol1/c3-cf-config'

  /**
   * Ip of NFS server.
   *
   * Keep empty if {@link BootConfig} is used.
   */
  configVolumeNfsServer: string

  /**
   * Sub path in NFS volume for vault.
   */
  vaultVolumeSubPath: string = '/vol1/c3-cf-vault'

  /**
   * Ip of NFS server
   *
   * Keep empty if {@link BootConfig} is used.
   */
  vaultVolumeNfsServer: string

  /**
   * URI for c3server image (without tag) in ArtifactRegistry
   *
   * If not set uri would be constructed based on default {@link ContainerRegistry}.
   * e.g: `us-west1-docker.pkg.dev/local-test2-326015/vait2/c3`
   */
  imageUri: string

  /**
   * GCP service account to assign to VertexAICustomJobs
   *
   * If not set Service Account from {@link GcpCredentials} would be used (or current).
   * e.g: `vai-vait2@local-test2-326015.iam.gserviceaccount.com`
   */
  serviceAccountEmail: string

  /**
   * GCP VPC to use for VertexAI.
   *
   * If not set current VPC will be used.
   * e.g: `projects/779745890032/global/networks/vait2-vpc-1`
   */
  vpc: string

  /**
   * Name of reserved GCP ip range
   * IPs from this range should be able to access PG and Cass.
   */
  reservedIpRange: !string

  /**
   * Disabling creation of internal LoadBalancer to expose k8s running PG to VertexAI CustomJob.
   */
  skipInternalLoadBalancerForPG: boolean

  /**
   * Disabling creation of internal LoadBalancer to expose k8s running Cass to VertexAI CustomJob.
   */
  skipInternalLoadBalancerForCass: boolean

  /**
   * Default type of membership service for this config is {@link App.NodePool.Membership.VertexAI}.
   */
  membership: ~ = 'App.NodePool.Membership.VertexAI'

  /**
   * Currently {@link App.NodePool.Membership.VertexAI} only supports {@link Server.Role.TASK}.
   */
  roles: ~ = ['task']
}
