/**
 * State of the Server
 */
enum type Server.State mixes CloudCluster.Node.State {

  /**
   * Node is upgrading i.e. receiving new version of the software
   */
  UPGRADING

  /**
   * Node is terminating
   */
  TERMINATING

  /**
   * Node is terminated
   */
  TERMINATED

  /**
   * Node is in unknown state, needs further investigation
   */
  UNKNOWN

  /**
   * @return Server.State for provided cloud state
   */
  forCloudState: function(cloudState: !string): !string
}
