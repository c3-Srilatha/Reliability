/**
 * Updates running {@link App.Node.ThreadPool thread pools} for the current App's Node to respect any changes to their
 * {@link App.Node.ThreadPool.Config#minThreads}, {@link App.Node.ThreadPool.Config#maxThreads},
 * {@link App.Node.ThreadPool.Config#threadKeepAliveTime}, and {@link App.Node.ThreadPool.Config#defaultQueueTimeout}
 */
type App.Node.ThreadPool.Controller mixes Controller {

  ensure: ~
}
