/**
 * To keep track of state of App rootpkg deployment..
 */
entity type App.State mixes Singleton {

  /**
   * last deployed rootpkg fingerprint.
   */
  pkgFingerprint: int

  /**
   * package fingerprint the last time the schema was fully validated
   */
  valSchemaFingerprint: !int

  /**
   * package fingerprint the last time the schema upgrade migrations were successfully applied
   */
  upgSchemaFingerprint: !int

  /**
   * true indicates that all seed data has been upserted for an App
   */
  seeded: boolean

  /**
   * known issues with various seed data within the App.
   */
  seedDataIssues: [SeedData.Issue]
}
