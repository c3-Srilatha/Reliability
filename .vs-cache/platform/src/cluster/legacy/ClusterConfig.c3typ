/**
 * Type used to configure various Cluster parameters.
 * Parameters include monitoring, autoscaling, loadBalancing, and canonical url
 */
@action(group+='cluster-admin')
@config(minOverride=CLUSTER, maxOverride=CLUSTER)
type ClusterConfig mixes Config, Singleton {

  /**
   * Type implementing @link Cluster.Membership} for this cluster
   */
  membership: Type<<Cluster.Membership>>

  /**
   * ResourceName of the load balancers that this running c3 serer (only master) should be registered to. Currently the only
   * supporting load balancer is {@link AwsAlb}. This running c3 server will be registered to every ids of load balancers
   * in the array. If there is no ids specified in the array, this running c3 server will not be registered to any
   * load balancer. For more detail, please see {@link AwsAlb}
   */
  loadBalancers: [string]

  /**
   * The scheme to be used in Cluster.canonicalUrl(). Defaults to https if unspecified.
   */
  canonicalUrlScheme: string = "https"

  /**
   * The domain to be returned from Cluster.canonicalUrl(). Defaults to "c3-e.com" if unspecified
   */
  canonicalUrlDomain: string = "c3-e.com"

  /**
   * Optional override for the url host of Cluster.canonicalUrl(). NOTE: if set, then {@link #canonicalUrlDomain} will be ignored.
   */
  canonicalUrlHostOverride: string

  /**
   * Max number of nodes
   */
  maxNodes: int

  validateCluster:      boolean
  clusterAlertsEnabled: boolean

  /**
   * enables remote tag creation and tag specific async job provisioning
   */
  remoteTagEnabled: boolean

  /**
   * Configurations for cluster monitors
   */
  clusterMonitorConfig: ClusterMonitorConfig

  /**
   * Configurations for thread pools
   */
  threadPoolConfig: ThreadPoolConfig

  /**
   * Configurations for stats on cluster / db nodes
   */
  clusterMetricsConfig: ClusterMetricsConfig

  /**
   * HardwareProfile specifying defaults to be used if no instance size or hardware profile is specified
   * when starting a node; e.g., Autoscaling.
   */
  defaultHardwareProfile: HardwareProfile

  /**
   * Used for internal testing
   */
  rpmRepoUrl: private string

  /**
   * Gets the Cluster Monitor polling interval.
   *
   * @return the polling time in seconds.
   */
  @action(group+='monitor')
  monitorPollSeconds: function(): int

  @deprecated
  getMonitorPollSeconds: function(): int

  /**
   * Sets the Cluster Monitor polling interval.
   *
   * @param pollSeconds
   *           the polling time in seconds.
   */
  @action(authz='always')
  setMonitorPollSeconds: function(pollSeconds: !int)

  /**
   * Gets the Cluster Monitor 'house keeping' interval. Cluster house keeping
   * consists of AWS instance and spot request termination and zookeeper state
   * cleanup.
   *
   * @return the house keeping interval in seconds.
   */
  @action(group+='monitor')
  monitorHouseKeepingSeconds: function(): int

  getMonitorHouseKeepingSeconds: function(): int

  /**
   * Sets the Cluster Monitor 'house keeping' interval. Cluster house keeping
   * consists of AWS instance and spot request termination and zookeeper state
   * cleanup.
   *
   * @param houseKeepingSeconds
   *           the house keeping interval in seconds
   */
  @action(authz='always')
  setMonitorHouseKeepingSeconds: function(houseKeepingSeconds: !int)

  /**
   * Gets the time a node will be considered in failed state after being created or shutdown.
   * It is the time allowed between the REQUESTED and RUNNING states and between the RUNNING and
   * STOPPED/REQ_TERMINATE states.
   *
   * @return the maximum time in seconds before a node transitions to RUNNING or to STOPPED states
   */
  @action(group+='monitor')
  monitorFailureSeconds: function(): int

  @deprecated
  getMonitorFailureSeconds: function(): int

  /**
   * Sets the time a node will be considered in failed state after being created or shutdown.
   * It is the time allowed between the REQUESTED and RUNNING states and between the RUNNING and
   * STOPPED/REQ_TERMINATE states.
   *
   * @param failureSeconds
   *           the time in seconds a node will stay in a failed state before the Cluster Monitor cleans it up.
   */
  @action(authz='always')
  setMonitorFailureSeconds: function(failureSeconds: !int)

  /**
   * Gets the maximum time allowed for a node to shutdown. The Cluster Monitor will clean and
   * terminate (worker) or stop (master) nodes that take longer than this time.
   *
   * @return the maximum time in seconds allowed for a node to shutdown.
   */
  @action(group+='monitor')
  monitorShutdownSeconds: function(): int

  @deprecated
  getMonitorShutdownSeconds: function(): int

  /**
   * Sets the maximum time allowed for a node to shutdown. The Cluster Monitor will clean and
   * terminate (worker) or stop (master) nodes that take longer than this time.
   *
   * @param shutdownSeconds
   *           the maximum shutdown time in seconds allowed for nodes before the Cluster Monitor cleans them up.
   */
  @action(authz='always')
  setMonitorShutdownSeconds: function(shutdownSeconds: !int)

  /**
   * Gets the time the Cluster Monitor will wait before terminating a node that has requested it (REQ_TERMINATE).
   *
   * @return the time in seconds to wait before AWS instance termination.
   */
  @action(group+='monitor')
  monitorTerminateSeconds: function(): int

  @deprecated
  getMonitorTerminateSeconds: function(): int

  /**
   * Sets the time the Cluster Monitor will wait before terminating a node that has requested it (REQ_TERMINATE).
   *
   * @param terminateSeconds
   *           the time in seconds for nodes in REQ_TERMINATE state before the Cluster Monitor cleans them up.
   */
  @action(authz='always')
  setMonitorTerminateSeconds: function(terminateSeconds: !int)

  /**
   * Gets the maximum time an AWS Spot request can be active but not fulfilled.
   *
   * @return the time in seconds a AWS Spot request can remain active and not fulfilled.
   */
  @action(group+='monitor')
  monitorSpotRequestSeconds: function(): int

  @deprecated
  getMonitorSpotRequestSeconds: function(): int

  /**
   * Sets the maximum time an AWS Spot request can be active but not fulfilled.
   *
   * @param spotRequestSeconds
   *           the time in seconds for unfulfilled spot requests before Cluster Monitor cleans them up.
   */
  @action(authz='always')
  setMonitorSpotRequestSeconds: function(spotRequestSeconds: !int)

  /**
   * Gets the maximum time UNAVAILABLE nodes will exist before they are cleaned up and terminated (worker) or stopped (master).
   *
   * @return the time in seconds a a node can remain in UNAVAILABLE state before it is cleaned up.
   */
  @action(group+='monitor')
  monitorUnavailableSeconds: function(): int

  @deprecated
  getMonitorUnavailableSeconds: function(): int

  /**
   * Sets the maximum time UNAVAILABLE nodes will exist before they are cleaned up and terminated (worker) or stopped (master).
   *
   * @param unavailableSeconds
   *           the maximum time in seconds for UNAVAILABLE nodes before the Cluster Monitor cleans them up.
   */
  @action(authz='always')
  setMonitorUnavailableSeconds: function(unavailableSeconds: !int)

  /**
   * Gets the maximum time a node can remain in INITIALIZING state before it is cleaned up and terminated (worker) or stopped (master).
   *
   * @return the time in seconds a a node can remain in INITIALIZING state before it is cleaned up.
   */
  @action(group+='monitor')
  monitorInitSeconds: function(): int

  @deprecated
  getMonitorInitSeconds: function(): int

  /**
   * Sets the maximum time a node can remain in INITIALIZING state before it is cleaned up and terminated (worker) or stopped (master).
   *
   * @param initSeconds
   *           the maximum time in seconds for nodes to be INITIALIZING before the Cluster Monitor cleans them up.
   */
  @action(authz='always')
  setMonitorInitSeconds: function(initSeconds: !int)

  /**
   * Checks whether auto scaling is enabled in the cluster.
   *
   * @return true if auto scaling is enabled, false otherwise.
   */
  @action(group+='monitor')
  autoScaleEnabled: function(): boolean

  @deprecated
  getAutoScaleEnabled: function(): boolean

  /**
   * Enables/disables auto scaling in the cluster.
   *
   * @param enabled
   *           true to enable auto scaling, false to disable it.
   */
  @action(authz='always')
  setAutoScaleEnabled: function(enabled: !boolean)

  /**
   * Gets the minimum number of Worker Nodes that should be running in the cluster when auto scaling is enabled.
   *
   * @return minimum number of workers that must be running in the cluster.
   */
  @action(group+='monitor')
  autoScaleMinWorkerNodes: function(): int

  @deprecated
  getAutoScaleMinWorkerNodes: function(): int

  /**
   * Sets the minimum number of Worker Nodes that should be running in the cluster when auto scaling is enabled.
   *
   * @param minWorkerNodes
   *           the minimum number of workers that must be running in the cluster.
   */
  @action(authz='always')
  setAutoScaleMinWorkerNodes: function(minWorkerNodes: !int)

  /**
   * Gets the maximum number of Worker Nodes that should be running in the cluster when auto scaling is enabled.
   * This is the high watermark for auto scaling when the number of jobs in the invalidation queues is above the
   * "high threshold".
   *
   * @return maximum number of workers that can be running in the cluster.
   */
  @action(group+='monitor')
  autoScaleMaxWorkerNodes: function(): int

  @deprecated
  getAutoScaleMaxWorkerNodes: function(): int

  /**
   * Sets the maximum number of Worker Nodes that should be running in the cluster when auto scaling is enabled.
   * This is the high watermark for auto scaling when the number of jobs in the invalidation queues is above the
   * "high threshold".
   *
   * @param maxWorkerNodes
   *           the maximum number of workers that can be running in the cluster.
   */
  @action(authz='always')
  setAutoScaleMaxWorkerNodes: function(maxWorkerNodes: !int)

  /**
   * Gets the number of pending requests in the aggregated invalidation queues that will cause autoscaling to go from
   * maximum workers to minimum workers.
   *
   * @return the number of requests that cause auto scaling to throttle down the number of workers.
   */
  @action(group+='monitor')
  autoScaleReqsThresholdLow: function(): int

  @deprecated
  getAutoScaleReqsThresholdLow: function(): int

  /**
   * Sets the number of pending requests in the aggregated invalidation queues that will cause autoscaling to go from
   * maximum workers to minimum workers.
   *
   * @param reqsThresholdLow
   *           the number of pending + computing requests watermark to throttle down the number of workers.
   */
  @action(authz='always')
  setAutoScaleReqsThresholdLow: function(reqsThresholdLow: !int)

  /**
   * Gets the number of pending requests in the aggregated invalidation queues that will cause autoscaling to go from
   * minimum workers to maximum workers.
   *
   * @return the number of requests that cause auto scaling to throttle up the number of workers.
   */
  @action(group+='monitor')
  autoScaleReqsThresholdHigh: function(): int

  @deprecated
  getAutoScaleReqsThresholdHigh: function(): int

  /**
   * Sets the number of pending requests in the aggregated invalidation queues that will cause autoscaling to go from
   * minimum workers to maximum workers.
   *
   * @param reqsThresholdHigh
   *           the number of pending + computing requests watermark to throttle up the number of workers.
   */
  @action(authz='always')
  setAutoScaleReqsThresholdHigh: function(reqsThresholdHigh: !int)

  /**
   * Gets the number of seconds that the Cluster Monitor will wait when the Low Threashold for throttling down is reached
   * before the extra workers are terminated (to get down to minWorkers)
   *
   * @return the time in seconds before auto scaling throttles down the number of workers.
   */
  @action(group+='monitor')
  autoScaleStopTimeSeconds: function(): int

  @deprecated
  getAutoScaleStopTimeSeconds: function(): int

  /**
   * Sets the number of seconds that the Cluster Monitor will wait when the Low Threashold for throttling down is reached
   * before the extra workers are terminated (to get down to minWorkers)
   *
   * @param stopTimeSeconds
   *           the time in seconds before auto scaling throttles down the number of workers.
   */
  @action(authz='always')
  setAutoScaleStopTimeSeconds: function(stopTimeSeconds: !int)

  /**
   * Gets whether the auto scaling instances are 'on demand' or 'spot'
   *
   * @return true if using 'on demand' instances for auto scaling.
   */
  @action(group+='monitor')
  autoScaleOnDemand: function(): boolean

  @deprecated
  getAutoScaleOnDemand: function(): boolean

  /**
   * Sets whether the auto scaling instances are 'on demand' or 'spot'
   *
   * @param onDemand
   *           true to use on demand aws instances, false for spot instances.
   */
  @action(authz='always')
  setAutoScaleOnDemand: function(onDemand: !boolean)

  /**
   * Gets the number of seconds that the Cluster Monitor will backoff to check for auto scaling throttling
   * based on the following algorithm:
   *
   *    min((pending + computing requests in all queues) / BackoffReqNum) * BackofSeconds, BackoffMaxSeconds
   *
   * @return the time in seconds to backoff.
   */
  @action(group+='monitor')
  autoScaleBackoffSeconds: function(): int

  @deprecated
  getAutoScaleBackoffSeconds: function(): int

  /**
   * Sets the number of seconds that the Cluster Monitor will backoff to check for auto scaling throttling
   * based on the following algorithm:
   *
   *    min((pending + computing requests in all queues) / BackoffReqNum) * BackofSeconds, BackoffMaxSeconds
   *
   * @param backoffSeconds
   *           the time in seconds to backoff.
   */
  @action(authz='always')
  setAutoScaleBackoffSeconds: function(backoffSeconds: !int)

  /**
   * Gets the maximum number of seconds that the Cluster Monitor will backoff to check for auto scaling throttling
   * based on the following algorithm:
   *
   *    min((pending + computing requests in all queues) / BackoffReqNum) * BackofSeconds, BackoffMaxSeconds
   *
   * @return the maximum time in seconds to backoff.
   */
  @action(group+='monitor')
  autoScaleBackoffMaxSeconds: function(): int

  @deprecated
  getAutoScaleBackoffMaxSeconds: function(): int

  /**
   * Sets the maximum number of seconds that the Cluster Monitor will backoff to check for auto scaling throttling
   * based on the following algorithm:
   *
   *    min((pending + computing requests in all queues) / BackoffReqNum) * BackofSeconds, BackoffMaxSeconds
   *
   * @param backoffMaxSeconds
   *           the maximum time in seconds to backoff.
   */
  @action(authz='always')
  setAutoScaleBackoffMaxSeconds: function(backoffMaxSeconds: !int)

  /**
   * Gets the number of Invalidation Queue requests (pending + computing) that the Cluster Monitor use in calculating
   * the AutoScale backoff based on the following algorithm:
   *
   *    min((pending + computing requests in all queues) / BackoffReqNum) * BackofSeconds, BackoffMaxSeconds
   *
   * @return the number of pending + computing requests use to calculate the auto scaling backoff.
   */
  @action(group+='monitor')
  autoScaleBackoffReqNum: function(): int

  @deprecated
  getAutoScaleBackoffReqNum: function(): int

  /**
   * Sets the number of Invalidation Queue requests (pending + computing) that the Cluster Monitor use in calculating
   * the AutoScale backoff based on the following algorithm:
   *
   *    min((pending + computing requests in all queues) / BackoffReqNum) * BackofSeconds, BackoffMaxSeconds
   *
   * @param backoffReqNum
   *           the number of pending + computing requests use to calculate the auto scaling backoff.
   */
  @action(authz='always')
  setAutoScaleBackoffReqNum: function(backoffReqNum: !int)

  /**
   * Gets the maximum number of concurrent compute actions that worker should execute at once.
   */
  @action(group+='monitor')
  workerMaxConcurrentComputes: function(): map<string, int>

  /**
   * Sets the maximum number of concurrent compute actions that a worker should execute at once. `maxConcurrentComputes`
   * overrides `coreRatio`. Otherwise sets to `coreRatio` * `num-cpu-cores`.
   */
  @action(authz='always')
  setWorkerMaxConcurrentComputes: function(maxConcurrentComputes: int, coreRatio: double = 0.5): map<string, int>
}
