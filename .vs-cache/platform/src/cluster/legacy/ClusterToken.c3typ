/**
 * Type that persists tokens used to authenticate with other clusters. The id field contains the cluster id
 */
// TODO: PLAT-43223 Authentication mechanism for intra-cluster communication
@config(minOverride=CLUSTER, maxOverride=CLUSTER)
@action(group+='cluster-admin')
@deprecated(finalVersion='8', details='Use AppToken instead')
type ClusterToken mixes Config, Identifiable {

  @config(secret=true)
  token: string

  /**
   * token expiry time.
   */
  expiry: datetime
}
