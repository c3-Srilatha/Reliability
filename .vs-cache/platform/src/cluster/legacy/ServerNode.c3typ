/**
 * Represents a node in the C3 server cluster.
 */
type ServerNode mixes ActionExecutor {

  /**
   * C3 Server node id.
   */
  nodeId: !string

  /**
   * C3 Server node ip address.
   */
  ipAddress: !string

  /**
   * C3 Server node http port.
   */
  httpPort: !int

  /**
   * @return this server node.
   */
  me: function(): !ServerNode

  /**
   * @return true if instance is for this node.
   */
  isMe: member function(): boolean

  /**
   * @return list of tenant/tag assigned to this worker
   */
  tenantTagAllocation: member function(): [Pair<string, string>]
}
