type NodeSqlStatements {

  nodeId: string

  /**
   * timestamp based on node's local clock
   */
  timestamp: double

  /**
   * map of average concurrent active sql statements per database
   */
  activeStmts: map<string, double>

  /**
   * map of average pending sql statements per database
   */
  queuedStmts: map<string, double>
}
