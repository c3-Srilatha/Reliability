type CloudConfig mixes Config, Singleton {

  domain:                  string
  useDns:                  boolean
  dnsTtl:                  int
  packageRepositoryUrl:    string
  packageRepositoryRegion: string
  awsConfig:               AwsConfig
  azureConfig:             AzureConfig
  zookeeperConfig:         ZookeeperConfig
  microstrategyConfig:     MicrostrategyConfig
  jupyterConfig:           JupyterConfig
  k8sConfig:               K8sConfig
  provider:                CloudProvider
}
