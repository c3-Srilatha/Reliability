type InstanceConfig mixes ConfigChild<AwsConfig> {

  /**
   * Aws ec2 instance type
   */
  ec2Type: string

  /**
   * Azure instance type
   */
  vmType: string

  /**
   * AMI Id
   */
  amiId: string

  maxSpotPrice: double

  /**
   * Aws EC2 detailed monitoring on/off.
   */
  detailedMonitoring: boolean

  /**
   * Append user data to ami.
   */
  appendUserData: string
}
