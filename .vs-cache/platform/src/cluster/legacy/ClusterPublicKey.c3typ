/**
 * Type that persists public key for all pod's in an env. All pods in an env can read each other's public key.
 */
@config(minOverride=CLUSTER)
@deprecated(finalVersion='8', details='Use App.PublicKey instead')
type ClusterPublicKey mixes Config, Identifiable {

  /**
   * public key of a cluster
   */
  key: string
}
