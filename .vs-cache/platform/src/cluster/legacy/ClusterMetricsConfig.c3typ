type ClusterMetricsConfig mixes ConfigChild<ClusterConfig> {

  /**
   * time between stats collections
   */
  pollSeconds: int

  /**
   * enable collecting stats on db nodes
   */
  dbNodes: boolean

  /**
   * enable collecting stats on cluster nodes
   */
  clusterNodes: boolean

  sharedNodes: boolean

  /**
   * return true if any dbNodes/clusterNodes/sharedNodes is true
   */
  publishStats: member function(): boolean
}
