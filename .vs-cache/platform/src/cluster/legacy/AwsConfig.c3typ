@deprecated(finalVersion='7')
type AwsConfig mixes ConfigChild<CloudConfig> {

  useIAM:                  boolean
  secretKey:               string
  accessKey:               string
  region:                  string
  c3Instance:              InstanceConfig
  cassandraInstance:       InstanceConfig
  maxS3Connections:        int
  maxRetries:              int32
  secretS3Bucket:          string = "c3--secret"
  retryInitialSleepMillis: int32 = 500
}
