type App.NodePool.PyInterpreterPoolSpec mixes Spec {

  /**
   * The maximum number of interpreters that can be in the pool. -1 means no limit
   */
  maxPoolSize: int = 20

  /**
   * Interpreters exceeding this age are evicted from the pool on invalidation. -1 means never evict based on age.
   */
  maxAgeSeconds: int = -1

  /**
   * Interpreters whose last use was greater than this many seconds ago will be evicted on invalidation.
   * -1 means never evict based on time since last use.
   */
  maxTimeSinceLastUseSeconds: int = 7200

  /**
   * Interpreters using more than this amount of memory are evicted from the pool on invalidation.
   * -1 means never evict based on memory.
   */
  maxInterpreterMemoryMb: int = -1

  /**
   * If the total memory used by all interpreters is greater than this threshold, evict interpreters.
   * -1 means never evict based on memory
   */
  maxPoolMemoryMb: int = 2000

  /**
   * This policy dictates which interpreters are / are not pooled when the pool is saturated.
   */
  policy: string enum InterpreterPoolEvictionPolicy = EVICT_USED_LEAST_RECENTLY

  /**
   * This returns an App.NodePool.PyInterpreterPoolSpec with fields set to disable interpreter pooling
   */
  specWithPoolingDisabled: function(): App.NodePool.PyInterpreterPoolSpec
}
