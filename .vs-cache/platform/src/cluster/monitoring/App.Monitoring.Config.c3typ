/**
 * This is the config which specifies the list of apps to be monitored.
 */
@config(minOverride=CLUSTER, maxOverride=CLUSTER)
@action(group='cluster-admin')
type App.Monitoring.Config mixes Config, Singleton {

  /**
   * List of all {@link App#id}s to enable monitoring.
   * For {@link Env}, the `c3` {@link App} must be the representative App in this list.
   */
  appIds: [string serialized AppId]

  setConfig:      ~
  setConfigValue: ~

  /**
   * Check if monitoring is enabled for an {@link App}.
   */
  @action(inline=true)
  isEnabled: cached inline member function(appId: string): boolean

  /**
   * Check if monitoring is enabled in context of an {@link App}.
   */
  @action(inline=true)
  isEnabledInApp: cached inline member function(): boolean

  /**
   * Enable monitoring on all nodes of an {@link App}.
   * This propagates {@link App.Monitoring.Config} to all nodes of app.
   * @param appId
   *        The {@link App} to enable. If not specified, adds the current {@link App}.
   */
  enable: member function(appId: string)

  /**
   * Disable monitoring on all nodes of an {@link App}.
   * This propagates {@link App.Monitoring.Config} to all nodes of app.
   */
  disable: member function(appId: string)
}
