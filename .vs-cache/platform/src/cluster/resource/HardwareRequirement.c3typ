/**
 * Compute attribute is static which is design time constraint or recommendation for an action / code or job or runtime library
 */
type HardwareRequirement mixes HardwareResourceFields {

  /**
   * The identifier of the Kubernetes node pool that serves as the scheduling target for the C3 node pool.
   */
  computeKind: string
}
