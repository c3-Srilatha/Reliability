@beta
private type GpuResourceProfile {

  /**
   * Name of the GPU Vendor (ex. nvidia, amd, or intel)
   */
  gpuVendor: !string enum GpuVendor

  /**
   * The specific kind of GPU (ex. A100-SXM4-40GB)
   */
  gpuKind: string

  /**
   * The number of GPUs
   */
  gpuCount: int

  /**
   * The GPU memory size in MB
   */
  gpuMemoryMb: int
}
