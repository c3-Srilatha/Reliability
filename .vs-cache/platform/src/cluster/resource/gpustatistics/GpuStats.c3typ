/**
 * Live details of all available GPUs
 */
// TODO: PLAT-76286 When restricted parametric type is used as field as an ArrayValueType, v8 build fails.
// Once above is fixed we should change the below to GpuStats<T: mixing GpuStat>
abstract type GpuStats<T> {

  /**
   * @see GpuVendor
   */
  vendor: !string enum GpuVendor

  /**
   * Available Gpu Driver Version
   */
  driverVersion: string

  /**
   * Number of available GPUs
   */
  gpuCount: int

  /**
   * Individual details (@see GpuStat) on each of the available GPUs
   */
  gpus: [T]

  /**
   * Fetch the live details of all available GPUs
   */
  generate: private abstract function(): mixing GpuStats java | py-client
}
