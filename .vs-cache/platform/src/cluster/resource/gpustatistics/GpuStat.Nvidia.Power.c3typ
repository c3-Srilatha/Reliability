/**
 * Current power usage of the GPU in Watts
 */
type GpuStat.Nvidia.Power {

  /**
   * The software power limit
   */
  powerLimit: double

  /**
   * The last measured power draw for the entire board (available in <v.575)
   */
  powerDraw: ?double

  /**
   * The average power draw for the entire board for the last second (available v.575 and onwards)
   */
  averagePowerDraw: ?double

  /**
   * The last measured power draw for the entire board (available v.575 and onwards)
   */
  instantPowerDraw: ?double
}
