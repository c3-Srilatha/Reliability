/**
 * Live details of an available GPU
 */
abstract type GpuStat {

  /**
   * Unique identifier representing an accessible
   */
  gpuId: string

  /**
   * The official product name of the GPU. This is an alphanumeric string.
   * ex. "Nvidia L4" or "Tesla T4"
   */
  gpuName: string
}
