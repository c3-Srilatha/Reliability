/**
 * Memory information in Mebibytes (MiB)
 */
type GpuStat.Nvidia.Memory {

  /**
   * Total size of memory
   */
  total: !int

  /**
   * Reserved size of memory
   */
  reserved: !int

  /**
   * Used size of memory
   */
  used: !int

  /**
   * Available size of memory
   */
  free: !int
}
