/**
 * Live details of an available NVIDIA GPU
 */
type GpuStat.Nvidia mixes GpuStat {

  /**
   * Percent of maximum speed that the device's fan is currently intended to run at
   */
  fanSpeedPct: int

  /**
   * Core GPU temperature, in Celsius
   */
  gpuTempCelsius: int

  /**
   * @see GpuStat.Nvidia.Power
   */
  powerReadingsWatts: GpuStat.Nvidia.Power

  /**
   * @see GpuStat.Nvidia.Utilization
   */
  utilizationPct: GpuStat.Nvidia.Utilization

  // THIS WILL BE NULL FOR NOW
  // TODO: implement https://github.com/NVIDIA/nvidia-docker/issues/179#issuecomment-598059213
  processes: json

  /**
   * On-board frame buffer (FB) memory information
   * @see GpuStat.Nvidia.Memory
   */
  fbMemoryUsageMiB: GpuStat.Nvidia.Memory

  /**
   * Base Address Memory 1 (BAR1) memory information
   * @see GpuStat.Nvidia.Memory
   */
  bar1MemoryUsageMiB: GpuStat.Nvidia.Memory
}
