/**
 * Live details of all available NVIDIA GPUs
 */
type GpuStats.Nvidia mixes GpuStats<GpuStat.Nvidia> {

  vendor: ~ = GpuVendor.NVIDIA

  /**
   * Available CUDA version
   */
  cudaVersion: string

  /**
   * Runtime specific function to return nvidia-smi results in an XML string
   * See https://developer.download.nvidia.com/compute/DCGM/docs/nvidia-smi-367.38.pdf for more details
   */
  fetchNvidiaSmiStats: function(): string java | py-client

  /**
   * Converts xmlString output from nvidia-smi to json
   */
  buildFromXml: function(xmlString: string): GpuStats.Nvidia
}
