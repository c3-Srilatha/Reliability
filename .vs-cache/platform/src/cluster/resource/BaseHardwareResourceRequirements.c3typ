/**
 * Base type for {@link HardwareRequirement} and {@link ResourceRequirement} {@link Config}.
 *
 * This type provides validation logic.
 */
abstract private type BaseHardwareResourceRequirements mixes Nameable, Config, HardwareRequirement, ResourceRequirement {

  /**
   * Validates that all required fields are set properly.
   */
  validate: private inline member function(): !mixing BaseHardwareResourceRequirements

  validate: private inline member function(validatePartial: !?boolean): !mixing BaseHardwareResourceRequirements

  /**
   * Performs validation on all fields on a {@link BaseHardwareResourceRequirements} instance
   * @return a map of field names to an array of error strings
   * @example
   * ```js
   *     {
   *         "BaseHardwareResourceRequirements#cpu": [
   *            "Requires positive value for numbers of CPUs (`cpu`)."
   *         ],
   *         "BaseHardwareResourceRequirements#memoryMb": [
   *            "Requires positive value for memory allocation (`memoryMb`)."
   *         ]
   *     }
   * ```
   */
  isValid: inline member function(validatePartial: boolean): map<string, [string]>
}
