/**
 * Configuration type for {@link GpuDevice}. Holds basic information about ${@link GpuDevice device} such as
 * device name, vendor, or available memory.
 */
type GpuDevice.Config mixes HardwareAccelerator.Config {

  /**
   * Memory available on this {@link GpuDevice}.
   */
  memoryMb: !int

  /**
   * Higher rating, gives better (i.e., more powerful) {@link GpuDevice}.
   */
  rating: !int
}
