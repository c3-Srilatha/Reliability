/**
 * Record of a hardware profile, used to specify cloud node instances.
 * HardwareProfile should be used as the resource definition of cloud "hardware" or
 * instance type (e.g. used for c3server worker nodes).
 */
@beta
type HardwareProfile mixes BaseHardwareResourceRequirements, Named, HardwareProfile.AdminFields {

  forName: ~

  /**
   * Upserts a hardware profile into the config framework based on parameters specified.
   *
   * @param spec
   *         Specification for resources under {@link HardwareProfile.CreateSpec} to supply.
   * @return hardware profile object based on parameters specified.
   */
  upsertProfile: function(spec: !HardwareProfile.CreateSpec): !HardwareProfile

  /**
   * Checks if hardware with this {@link HardwareProfile} satisfy given {@link HardwareConstraint}.
   */
  satisfiesConstraint: member function(constraint: !HardwareConstraint): boolean
}
