/**
 * Type define resource requirements for {@link HardwareAccelerator}(s).
 */
type HardwareAcceleratorResourceAware {

  /**
   * The number of required {@Link HardwareAccelerator}s.
   */
  acceleratorCount: !int32 = 0

  /**
   * The specific kind of {@link HardwareAccelerator} (ex. A100-SXM4-40GB).
   *
   * This field is required if {@link #acceleratorCount} greater than 0.
   */
  acceleratorKind: string serialized GpuDevice
}
