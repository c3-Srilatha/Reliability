/**
 * Abstract type that represents {@link HardwareAccelerator}, such as {@link GpuDevice}.
 */
abstract type HardwareAccelerator<C: HardwareAccelerator.Config> mixes Named, Configurable<C> {

  forName: ~

  /**
   * @return {@link HardwareAccelerator}'s names known to C3.
   */
  listNames: abstract function(): [string]

  /**
   * Provides an ordered list of hardware accelerators from most to least powerful.
   * Any device at some index i in the returned array will meet
   * the needs of any device at some index j>i.
   *
   * @return a list of {@link HardwareAccelerator}s in order from most to least capable.
   */
  listDevices: abstract function<C>(): [mixing HardwareAccelerator<C>]

  /**
   * @return all {@link HardwareAccelerator}s.
   */
  all: function(): [mixing HardwareAccelerator<C>]
}
