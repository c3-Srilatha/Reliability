/**
 * Represents {@link InvalidationQueueStats} based {@link App.NodePool.AutoScaleStrategy.CronJob} App.NodePool scaling strategy
 */
type App.NodePool.AutoScaleStrategy.InvalidationQueues mixes App.NodePool.AutoScaleStrategy.CronJob {

  /**
   * Returns suggested target node count for the defined {@link App.NodePool} based on the provided [{@link InvalidationQueueStats}]
   * and the nodePool's {@link App.NodePool.Config}
   */
  getTargetNodeCount: member function(invalidationQueueStats: ![InvalidationQueueStats]): !int32

  /**
   * Returns the {@link InvalidationQueueFilterSpec} for the defined {@link App.NodePool}
   */
  invalidationQueueStatsFilterSpec: private member function(): !InvalidationQueueFilterSpec

  /**
   * Fetches the {@link InvalidationQueueStats} for the defined {@link App.NodePool} using {@link #invalidationQueueStatsFilterSpec}
   */
  fetchInvalidationQueueStats: private member function(): ![InvalidationQueueStats]
}
