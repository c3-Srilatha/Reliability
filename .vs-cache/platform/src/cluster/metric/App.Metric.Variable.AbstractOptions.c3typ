/**
 * Defines a variable that has options to choose from. Concrete types will define the actual
 * options (or how to retrieve them).
 */
@typeScript
@beta
abstract private type App.Metric.Variable.AbstractOptions extends App.Metric.Variable {

  /**
   * If defined, indicates the the user can choose multiple values from options and
   * specifies the the way to concatenate multiple values into a single string.
   * If undefined, implies that a user can only select a single option.
   */
  concatenationToken: string = "|"

  toValueString:   ~
  fromValueString: ~

  /**
   * Returns an input field to represent the {@link App.Metric.Variable}. Assumes usage of C3 UI Framework.
   */
  toInputFieldSetting: ~
}
