/**
 * Complete spec to evaluate an individual {@link App.Metric}.
 */
@beta
private type App.Metric.EvaluatableSpec mixes App.Metric.EvaluatableSpec.Partial, App.Metric.ValidateAndFillable {

  /**
   * The metrics to evaluate over given time period
   */
  metrics: ![App.Metric.Bound<App.Metric.EvaluateSpec>]

  /**
   * Validates the App.Metric.EvaluatableSpec for correctness.
   * If valid, fills in default values when necessary and ensures that all {@link #metrics} have
   * all their reference fields populated.
   * If invalid, throws error with why it is invalid.
   */
  validateAndFillImpl: ~

  /**
   * Populates unset values on {@link App.Metric.Evaluatable.Spec} with default values.
   * start - end().minusHours(1) or DateTime.now().minusHours(1) if end is not set
   * end - start().plusHours(1) or DateTime.now() if start is not set
   * interval - "5s", note that there is a limit to the number of data points returned per series
   *             Ex: 11,000 for App.Metric.Prometheus metrics
   */
  fill: private member function(): App.Metric.EvaluatableSpec
}
