/**
 * A {@link App.Metric.Variable} in which the variable is referencing the value of a {@link App.Meter#tag}.
 * When displayed in a UI, this variable will be a dropdown populated with values for this tag in the metric store.
 */
@typeScript
@beta
private type App.Metric.Variable.TagValue extends App.Metric.Variable.AbstractOptions type key 'TAGV' {

  /**
   * Generally is the {@link App.Meter#tag} this variable represents, however, if there are collisions
   * across metrics the {@link App.Meter#tag} can be supplied in {@link #tagName}.
   */
  id: ~

  /**
   * Optional value to specify the {@link App.Meter#tag} this variable represents. If not specified
   * will assume {@link #id} is the name of the tag.
   */
  tagName: string

  /**
   * All {@link App.Meter#registryMetricName} for {@link App.Metric.MeterRef} associated with the variable.
   * Should not be set directly and will be resolved.
   */
  metricNames: private [string] not persistable

  toInputFieldSetting: ~
}
