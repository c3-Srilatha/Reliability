/**
 * Spec for resolving the query of a {@link App.Metric}
 */
@beta
private type App.Metric.QuerySpec mixes App.Metric.ValidateAndFillable {

  /**
   * {@link App.Metric#variables} values to use for evaluation. The keys should be respective {@link App.Metric.Variable#id}
   * for the variables to set at runtime.
   *
   * {@link App.Metric#query} can potentially expose dynamic references to other {@link App.Metric} or {@link App.Meter}:
   * Variables with key "{@link App.Metric#APP_METER_DYNAMIC_REFERENCE meters_d}" (dynamic {@link App.Meter} references),
   * must have values of an array of{@link App.Metric.MeterRef}.
   *
   * Variables with key "{@link App.Metric#APP_METRIC_DYNAMIC_REFERENCE metrics_d}" (dynamic {@link App.Metric} references),
   * must have values of an array of{@link App.Metric.Bound<App.Metric.QuerySpec>}.
   * `string` valued variables defined at this {@link App.Metric.QuerySpec} level will be available for evaluation to the
   * {@link App.Metric.Bound<App.Metric.QuerySpec} as well.
   *
   * {@see App.Metric#APP_METRIC_DYNAMIC_REFERENCE}
   * {@see App.Metric#query}.
   * {@see App.Metric.QuerySpec#variables}
   */
  variables: map<string, any>

  /**
   * Merges the `incomingVariables` into the `targetVariables`. Keys already defined on `targetVariables` will not be overridden
   * unless they are variables related to the scoping of the app, ex: "cluster", "env", "app"
   */
  mergeVariables: private function(targetVariables: !?map<string, any>,
                                   incomingVariables: !?map<string, any>): !?map<string, any>

  /**
   * Merges the `incomingVariables` into the {@link App.Metric.QuerySpec#variables}. Follows the same rules as {@link #mergeVariables}.
   * @return updated instance of {@link App.Metric.QuerySpec}.
   */
  mergeVariables: private member function(incomingVariables: !?map<string, any>): !mixing App.Metric.QuerySpec

  /**
   * Validates that the {@link App.Metric.QuerySpec} fields are properly set. Throws error if not valid.
   * 1. `variables` for dynamic references must be typed properly
   *
   * If valid, returns an `App.Metric.QuerySpec` instance that has all of its reference values fully fetched.
   */
  validateAndFillImpl: ~

  /**
   * Validates that this {@link App.Metric.QuerySpec} is valid with the given {@link App.Metric}.
   * Assume that the {@link App.Metric} has been fully validated and filled.
   * Assume that the {@link App.Metric.QuerySpec} has been fully validated and filled.
   */
  validateMetricBinding: private member function(metric: App.Metric): mixing App.Metric.QuerySpec
}
