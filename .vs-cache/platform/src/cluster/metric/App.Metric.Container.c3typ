/**
 * Abstraction for concepts that contain references to {@link App.Metric} that are to be evaluated at runtime.
 */
abstract type App.Metric.Container mixes App.Metric.ValidateAndFillable {

  /**
   * {@link App.Metric.Variable} that are exposed to the user for dynamic evaluation at runtime of
   * the contained {@link App.Metric}s.
   * Unless {@link doNotInferExposedVariables} is set, if not defined on instance, {@link #validateAndFill} will
   * populate with output of {@link unresolvedVariables}. This is a convenience for instances that do not
   * need to explicitly exclude any {@link App.Metric.Variable} from being resolved at runtime.
   */
  exposedVariables: [App.Metric.Variable]

  /**
   * When true, {@link #validateAndFill} will not infer {@link #exposedVariables} if it is empty.
   * When false, {@link #validateAndFill} will set {@link #unresolvedVariables} into {@link #exposedVariables}
   * if {@link #unresolvedVariables} is not set.
   * This flag will be ignored if {@link #exposedVariables} is set.
   * This boolean is present because there is no type system distinguishment for entities between null
   * and empty arrays.
   */
  doNotInferExposedVariables: boolean

  /**
   * Populates {@link #exposedVariables} if undefined. If {@link #exposedVariables} is specified,
   * then validates that all required fields are present.
   */
  @dependency(include='this, exposedVariables.this')
  validateAndFillImpl: ~

  /**
   * Identifies which variables are available to be populated at runtime. This list may or may
   * not be the same as {@link #exposedVariables}. The instance must be valid.
   * @param requiredOnly
   *            Return only the {@link App.Metric.Variable} that are required to be populated at runtime.
   */
  unresolvedVariables: inline member function(requiredOnly: boolean): [App.Metric.Variable]

  /**
   * Returns all ids of {@link App.Metric.Variable} that can be populated at runtime.
   */
  unresolvedVariablesImpl: private abstract inline member function(): [App.Metric.Variable]

  /**
   * All metric names used by the referenced {@link App.Metric}s.
   */
  metricNames: private abstract inline member function(): [string]

  /**
   * Summarizes a {@link App.Metric.Container} with human readible descriptions and prepares it for
   */
  summarize: abstract inline member function(): App.Metric.Container.Summary
}
