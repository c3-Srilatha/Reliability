/**
 * Represents a dashboard to visualize metrics
 */
@beta
private entity type App.Metric.Dashboard mixes App.Metric.Container, WithDescription {

  /**
   * Name of the dashboard, can be a {@link Translation} key
   */
  name: ~

  /**
   * The tiles/charts to display in the dashboard
   */
  tiles: ![App.Metric.Dashboard.Tile]

  /**
   * Filter fields to be available at the top level of the dashboard.
   * When the metrics are evaluated, the values of {@link App.Metric.EvaluatableSpec#variables} will be
   * driven by the selected values in the UI. These fields should correspond to variables defined in
   * {@link App.Metric#variables}.
   */
  exposedVariables: ~

  /**
   * Categories of this dashboard
   */
  categories: [App.Monitoring.Category] = [{id: 'other'}]

  /**
   * Returns all the metric names being utilized in this dashboard
   */
  metricNames: ~

  /**
   * Validates the {@link App.Metric.Dashboard} and fills it with cross referenced fields.
   */
  validateAndFillImpl: ~

  unresolvedVariablesImpl: ~

  /**
   * Returns dashboards available for the app
   */
  @action(group='read')
  dashboardsForApp: function(appId: string serialized AppId, spec: FetchSpec): [App.Metric.Dashboard]
}
