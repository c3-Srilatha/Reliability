/**
 * A view of a specific {@link App.Metric.Dashboard.Tile}. The {@link #name} must be unique
 * within its parent {@link App.Metric.Dashboard.Tile}.
 */
@beta
private type App.Metric.Dashboard.View mixes WithName {

  /**
   * Name of the dashboard, can be a {@link Translation} key
   */
  name: ~

  /**
   * Font Awesome icon associated with this view
   */
  icon: string

  /**
   * The metrics to show when on this view
   */
  metrics: [App.Metric.Bound<App.Metric.EvaluateSpec>]
}
