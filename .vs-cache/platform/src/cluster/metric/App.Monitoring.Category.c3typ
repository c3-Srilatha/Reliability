/**
 * Categorizations of metadata related to Monitoring
 */
// TODO: PLAT-99088 type App.Monitoring.Category mixes Metadata, Identified, WithDescription {
entity type App.Monitoring.Category mixes WithDescription {

  /**
   * Font-awesome icon to display with the category
   */
  icon: string

  /**
   * Display name for the category
   */
  displayName: string translate by id

  /**
   * Description of the category
   */
  description: ~ translate by id

  fetch: inline ~ from super
}
