/**
 * A partial descriptor for evaluating {@link App.Metric} - everything but the metrics!
 */
private type App.Metric.EvaluatableSpec.Partial mixes TimeRange, App.Metric.WithGlobalVariables {

  /**
   * The interval between each data point in the resultant timeseries
   */
  interval: string serialized Period
}
