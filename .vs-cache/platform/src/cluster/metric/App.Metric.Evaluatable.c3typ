@beta
abstract type App.Metric.Evaluatable {

  /*
   * Queries metric store (eg Prometheus) and generates EvalMetricsResult.
   * Each {@link App.Metric#id} will be utilized in the {@link EvalMetricsResult#result} as metric names.
   * Each source id will be as specified by {@link App.Metric#sourceTemplate}.
   *
   * Errors that occur during the evaluation will be captured in {@link EvalMetricsResult#errors}.
   * If the error cannot be attributed to a source specified by {@link App.Metric#sourceTemplate}, the key will be
   * the associated {@link App#id}.
   *
   * @see EvalMetricsResult#result
   */
  @action(group+='monitor')
  evalAppMetrics: abstract member function(spec: !App.Metric.EvaluatableSpec): EvalMetricsResult

  /**
   * Evaluates the {@link App.Metric.Container.Summary} with the provided {@link #partialSpec} and returns its results.
   * The summaries are useful if needing to easily bind a description to the output.
   */
  @action(group+='monitor')
  evalAppMetricContainerSummary: member function(summary: App.Metric.Container.Summary,
                                                 partialSpec: App.Metric.EvaluatableSpec.Partial)
                                          : App.Metric.Container.Summary.Result

  /**
   * @see #evalAppMetrics
   * Hidden behind cluster admin because it accepts `cluster`, `env`, `app` variables as is and allows
   * for ability to query about any {@link App}. Executes the evaluation inside the calling {@link App}, which
   * may be different than the {@link App} under instrospection.
   */
  @action(group+='cluster-admin')
  doEvalAppMetrics: private final function(spec: !App.Metric.EvaluatableSpec): EvalMetricsResult
}
