/**
 * When operating with {@link App.Metric}, there is a need to traverse deep down its fields to fetch every reference.
 * This serves as an interface type for all types that may need that behavior.
 */
abstract private type App.Metric.ValidateAndFillable {

  /**
   * Whether or not this specific instance has been processed. Especially helpful when calls from the
   * front end require full resolution and serves as a marker for server to know entire instance has
   * been fully resolved.
   */
  filled: boolean not persistable

  /**
   * Fully populates the references of the object. If {@link #filled} is true, just returns the instance.
   * If not, fully fetches the entire type with deep references.
   */
  @action(group='read')
  validateAndFill: inline member function(): mixing App.Metric.ValidateAndFillable

  /**
   * Implementation to validate and fully fetch the instance.
   * Note that it is important that this not be "inline" so that super can be called on validateAndFillImpl
   * implementations.
   */
  @dependency(include='this')
  validateAndFillImpl: private abstract member function(): mixing App.Metric.ValidateAndFillable
}
