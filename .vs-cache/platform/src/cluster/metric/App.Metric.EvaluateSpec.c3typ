/**
 * Field spec for evaluating a single metric.
 */
@beta
private type App.Metric.EvaluateSpec mixes App.Metric.QuerySpec {

  /**
   * Name to assign this metric in {@link EvalMetricsResult}. If not specified, {@link #metric#id} is used.
   */
  name: string

  /**
   * The return scope of the evaluation.
   */
  return: !string enum App.Metric.Return

  /**
   * When specified, overrides the {@link #metric}'s `sourceTemplate'.
   * {@see App.Metric#sourceTemplate}.
   */
  sourceTemplate: string

  /**
   * The unit of measurement for the metric that can be specified if the {@link App.Metric#unit} is ambiguous.
   */
  unit: Unit

  /**
   * Validates that the {@link App.Metric.EvaluateSpec} fields are properly set. Throws error if not valid.
   * 1. `unit` is specified, validates that it exists
   *
   * If valid, returns an `App.Metric.EvaluateSpec` instance that has all of its reference values fully fetched.
   */
  validateAndFillImpl: ~

  /**
   * Validates that
   * 1. `return` must be listed in `metric#return`.
   */
  validateMetricBinding: ~
}
