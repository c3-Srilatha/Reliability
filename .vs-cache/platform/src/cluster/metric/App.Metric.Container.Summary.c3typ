/**
 * A summary of a {@link App.Metric.Metric.Container} that contains human readable descriptions.
 */
type App.Metric.Container.Summary mixes WithDescription {

  /**
   * All the {@link App.Metric.EvaluatableSpec} discoverable in the {@link App.Metric.Container}
   * and their descriptions.
   */
  boundSummaries: [App.Metric.Bound.Summary]
}
