/**
 * Binds a reference to {@link App.Meter} with an aggregate kind.
 * Together, this allows for the targeting of a single timeseries in the underlying metric provider.
 */
@beta
private type App.Metric.MeterRef mixes App.Metric.ValidateAndFillable {

  /**
   * The referenced meter.
   */
  meter: !App.Meter

  /**
   * The aggregate kind bound to this meter reference.
   * The {@link App.Meter.AggregateKind} must be a supported kind listed in {@link #meter}
   * type's `aggregateKinds`, ex: {@link App.Meter.TimeHistogram#aggregateKinds}.
   */
  aggregateKind: !string enum App.Meter.AggregateKind = NONE

  /**
   * The metrc name for this meter bound with its aggregate kind
   */
  registryMetricName: inline member function(): string

  validateAndFillImpl: ~
}
