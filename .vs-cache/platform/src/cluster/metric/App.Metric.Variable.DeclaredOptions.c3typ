/**
 * A {@link App.Metric.Variable} in which the consumer has a specific set of {@link #options}
 * to choose from when populating the variable at runtime.
 */
@typeScript
@beta
private type App.Metric.Variable.DeclaredOptions extends App.Metric.Variable.AbstractOptions type key 'DOPT' {

  /**
   * Explicit options that are available for the consumer to choose from to populate the variable
   */
  options: ![string]

  toInputFieldSetting: ~
}
