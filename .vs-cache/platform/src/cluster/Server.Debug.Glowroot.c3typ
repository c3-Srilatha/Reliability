/**
 * Represents Glowroot debug utility.
 */
@action(group+='app-admin')
abstract private type Server.Debug.Glowroot mixes Server.Debug {

  /**
   * Context path for Glowroot server that starts the server.
   */
  contextPath: string

  /**
   * Bind address for Glowroot server.
   */
  bindAddress: string

  start:    ~
  stop:     ~
  endpoint: ~

  /**
   * @return `true` if glowroot has been enabled in a server
   */
  running: member function(): !boolean

  /**
   * Jvm arguments that are required to enable glowroot
   */
  jvmArgsRequired: function(): string
}
