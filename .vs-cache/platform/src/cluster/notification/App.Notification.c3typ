/**
 * A representation of a notification.
 */
type App.Notification mixes Identified {

  /**
   * The title of the notification.
   */
  title: !string

  /**
   * The message of the notification.
   */
  message: !string

  /**
   * The time that the notification was triggered.
   */
  triggered: !datetime

  /**
   * The severity of the notification, which determines the icon to display.
   */
  severity: !int enum App.Notification.Severity

  /**
   * The ID of the app the notification is associated with, if any.
   */
  appId: string

  /**
   * The type this notification represents or is associated with.
   */
  source: string

  /**
   * Optional source attribution to attach to the notification for granular filtering
   */
  sourceId: string

  /**
   * Additional relevant information or fields that allow us to identify a source object, construct a link, etc.
   */
  metadata: json
}
