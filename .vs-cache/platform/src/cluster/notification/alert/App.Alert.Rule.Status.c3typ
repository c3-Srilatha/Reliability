/**
 * The cumulative status of the Rule, as calculated from its alerts.
 */
type App.Alert.Rule.Status {

  /**
   * Whether any alerts are currently triggered for this rule.
   */
  status: string enum("FIRING", "OK")

  /*
   * If value is "FIRING" - represents the earliest {@link App.Alert#start} of all alerts that dont have {@link App.Alert#end}.
   * If value is "OK" - represents the latest {@link App.Alert#end}.
   */
  statusSince: datetime
}
