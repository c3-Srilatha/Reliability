/**
 * Severity of an {@link App.Alert} as defined in its {@link App.Alert.Rule}
 */
enum type App.Alert.Severity {

  CRITICAL = 0

  ERROR = 1

  WARNING = 2

  labelToValues: inline ~ from super
}
