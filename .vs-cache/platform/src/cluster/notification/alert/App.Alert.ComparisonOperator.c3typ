/**
 * Possible operators for {@link App.Metric} `baseline`.
 */
enum type App.Alert.ComparisonOperator {

  GREATER = '>'

  LESS = '<'

  EQUAL = '=='

  GREATER_OR_EQUAL = '>='

  LESS_OR_EQUAL = '<='

  NOT_EQUAL = '!='
}
