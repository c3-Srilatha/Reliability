/**
 * A timestamped notification for a specific user that can be marked as read.
 */
type App.UserNotification mixes Identified {

  /**
   * Reference to the notification metadata.
   */
  notificationMeta: !App.Notification

  /**
   * The time this notification has been read by the user.
   */
  read: datetime

  /**
   * The ID of the user this notification belongs to.
   */
  userId: !string
}
