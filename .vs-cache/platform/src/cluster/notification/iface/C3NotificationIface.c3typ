/**
 * Iface for notificationService
 */
abstract type C3NotificationIface mixes C3Notification.AlertManager, Singleton {

  /**
   * Generates User-specific notifications based on the notification metadata passed in as a parameter.
   * @param notificationMeta
   *      The notification with only fields defined that are generic to all users.
   * @param userIds
   *      The IDs of the users to receive this notification.
   * @param userGroupIds
   *      The IDs of the user groups to receive this notification.
   */
  generateUserNotifications: abstract function(notificationMeta: !App.Notification,
                                               userIds: [string],
                                               userGroupIds: [string])

  /**
   * Fetches notifications for the current user.
   * @param spec
   *      The fetch spec.
   */
  fetchMyNotifications: abstract function(spec: FetchSpec): FetchResult<App.UserNotification>

  /**
   * Fetches notifications for the specified user.
   * @param userId
   *      The ID of the user whose notifications should be fetched.
   * @param spec
   *      The fetch spec.
   */
  @action(group+='cluster-admin')
  fetchUserNotificationsFor: abstract function(userId: !string, spec: FetchSpec): FetchResult<App.UserNotification>

  /**
   * Fetches notifications count for the current user.
   * @param spec
   *      The fetch spec.
   */
  fetchMyNotificationsCount: abstract function(spec: FetchSpec): int

  /**
   * Fetches notifications count for the specified user.
   * @param userId
   *      The ID of the user whose notifications count should be fetched.
   * @param spec
   *      The fetch spec.
   */
  @action(group+='cluster-admin')
  fetchUserNotificationsCountFor: abstract function(userId: !string, spec: FetchSpec): int

  /**
   * Set the read timestamp to the current time for the specified notifications.
   * @param notificationIds
   *      The IDs of the notifications to read. The notifications must belong to the calling user.
   */
  readMyNotifications: abstract function(notificationIds: [string])

  /**
   * Set the read timestamp to the current time for ALL notifications that have not been read yet for the calling user.
   */
  markAllMyNotificationsAsRead: abstract function()
}
