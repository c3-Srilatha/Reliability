/**
 * Type that defines the threshold for key metrics in queue rules-based Resource Governor
 */
type QueuesResourceGovernorConfig mixes ConfigChild, QueuesResourceGovernorConfig.AdminFields {

  /**
   * Throttle Queue action dispatching to avoid CPU utilization exceeding this number.
   */
  maxCpu: !int

  /**
   * Throttle Queue action by limiting total gc count in the time window specified by
   * {@link ResourceGovernorConfig#queues}
   */
  maxFullGcCount: !int

  /**
   * Throttle Queue action by limiting total gc time in the time window specified by
   * {@link ResourceGovernorConfig#queues}
   */
  maxFullGcTimeMillis: !int

  /**
   * Throttle Queue action by limiting minimum free disk space percentage in the range [0, 100] across all storage nodes
   */
  minFreeDatastoreDiskSpacePct: !int

  /**
   * Throttle Queue action by limiting maximum fragmentation int the range [0, 100] across all storage nodes
   */
  maxDatastoreFragmentationPct: !int

  /**
   * Throttle Queue action by limiting maximum number of queued tasks across all storage nodes
   */
  maxDatastoreQueuedTaskCount: !int

  /**
   * Throttle Queue actions by limiting maximum number of queue entries that will be processed concurrently
   * in a task node
   */
  // TODO: PLAT-32705 Obj.validateObj() no longer supports/applies Ann.Constraint.condition for field or type
  // once the ticket above is fixed, then @constraint should be commented out
  // @constraint(condition="maxConcurrentComputes >= 0")
  maxConcurrentComputes: !int = 8

  isValid: inline member function(validatePartial: boolean): map<string, [string]>
}
