/**
 *  * Represents helper retrieval APIs for:
 * - ClusterLogs Membership: OpenSearch
 * - OpenSearch Membership: K8s
 */
abstract private type ClusterLogs_OpenSearch_K8s mixes ClusterLogs_OpenSearch {

  /**
   * The @see{Opensearch} index to be queried against
   */
  index: ~ = "c3server*"

  /**
   * The JSON according to which filtered logs will be sorted
   */
  sort: ~ = [{"@timestamp":{"order":"desc"},"_score":{"order":"desc"}}]

  /**
   * The key of @see{ClusterLogs_OpenSearch_K8s.filterValue} on which the cluster logs are to be filtered
   */
  filterKey: string

  /**
   * The value of @see{ClusterLogs_OpenSearch_K8s.filterKey} on which the cluster logs are to be filtered
   */
  filterValue: string

  /**
   * Fetches first N @param size logs for a given @param logLevel (DEBUG/INFO/WARN/ERROR),
   * within the provided @param from @param to datetime range while the utilizing the member object's
   * @see{ClusterLogs_OpenSearch_K8s.index} and @see{ClusterLogs_OpenSearch_K8s.sort}
   */
  searchForLogLevel: final member function(loglevel: !string, from: !datetime, to: !datetime, size: !int): ![string]

  /**
   * Fetches first N @param size logs for a given set of @param tokens (OR-ed),
   * within the provided @param from @param to datetime range while the utilizing the member object's
   * @see{ClusterLogs_OpenSearch_K8s.index} and @see{ClusterLogs_OpenSearch_K8s.sort}
   */
  searchForTokens: final member function(tokens: ![string], from: !datetime, to: !datetime, size: !int): ![string]

  /**
   * Fetches first N @param size logs for a given @param phrase (exact-match) ,
   * within the provided @param from @param to datetime range while the utilizing the member object's
   * @see{ClusterLogs_OpenSearch_K8s.index} and @see{ClusterLogs_OpenSearch_K8s.sort}
   */
  searchForPhrase: final member function(phrase: !string, from: !datetime, to: !datetime, size: !int): ![string]

  /**
   * Get a deepLink of OpenSearchDashboard for the given filterKey and filterValue
   */
  getDeepLink: final member function(clusterUrl: !string, filterKey: !string, filterValue: !string): !string
}
