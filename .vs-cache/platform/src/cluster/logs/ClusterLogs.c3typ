/**
 * Represents Cluster-Logs retrieval APIs
 */
abstract private type ClusterLogs {

  /**
   * Fetches up to limit number of logs for a given log level (DEBUG/INFO/WARN/ERROR) within the provided datetime range
   */
  logs: abstract member function(level: !string, from: !datetime, to: !datetime, limit: !int = 1000): [string]

  /**
   * Fetches up to limit number of logs for a given set of tokens (OR-ed) within the provided datetime range.
   * Logs returned, are sorted first on their timestamp (desc) and then on their match-score (desc).
   */
  search: abstract member function(tokens: ![string], from: !datetime, to: !datetime, limit: !int = 1000): [string]

  /**
   * Fetches up to limit number of logs for a given match phrase (exact match) within the provided datetime range.
   * Logs returned, are sorted first on their timestamp (desc) and then their match-score (desc).
   */
  search: abstract member function(phrase: !string, from: !datetime, to: !datetime, limit: !int = 1000): [string]

  /**
   * Returns a link to a GUI discovery page
   */
  deepLink: abstract member function(): string
}
