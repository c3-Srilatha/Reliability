/**
 * Configuration options for autoscaling {@link App.NodePool}. This includes whether autoscaling should be enabled for
 * the node pool and on what criteria autoscaling should be triggered.
 */
@beta
type App.NodePool.AutoScaleSpec mixes Spec {

  /**
   * Refers to whether autoscaling is enabled for this {@link App.NodePool}. Note this defaults to true.
   */
  enabled: boolean = true

  /**
   * Refers to what scaling strategy this {@link App.NodePool} uses
   */
  strategy: App.NodePool.AutoScaleStrategy

  isValid: inline member function(validatePartial: boolean,
                                  forSingleNode: boolean,
                                  forServerVersion: !string): map<string, [string]>
}
