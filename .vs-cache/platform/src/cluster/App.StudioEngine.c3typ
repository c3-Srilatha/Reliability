/**
 * A very light daemon running on all nodes of the app to keep it in sync with studio.
 */
type App.StudioEngine mixes Engine.Periodic {

  /**
   * Main execution loop
   */
  task: ~

  /**
   * Runs callJson on every instance of Studio, based on the Studio microservice config
   */
  callJson: private function(typeName: !string, actionName: !string, thisArgs: json, args: json): json

  /**
   * Upserts the user to admin role of the app
   */
  upsertUserToApp: private function(user: User): boolean

  /**
   * Constructs args for calling {@link StudioEnv.refresh}
   */
  constructStudioEnv: private function(env: Env,
                                       isServerRestartSent: boolean,
                                       lastUserActivity: DateTime,
                                       nodeInferredState: App.StudioEngine.InferredState): json

  /**
   * Constructs args for calling {@link StudioApp.refresh}
   */
  constructStudioApp: private function(app: App,
                                       isServerRestartSent: boolean,
                                       lastUserActivity: DateTime,
                                       nodeInferredState: App.StudioEngine.InferredState): json

  /**
   * Upserts activities to the app
   */
  upsertActivities: private function(): json
}
