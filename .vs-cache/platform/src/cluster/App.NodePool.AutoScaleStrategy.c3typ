/**
 * Base type for all scaling strategies for {@link App.NodePool}
 *
 * Any change to the {@link #nodePool} such as {@link App.NodePool#start}, {@link App.NodePool#stop},
 * {@link App.NodePool#update}, {@link App.NodePool#terminate}) will automatically call {@link #doConfigure}
 * which should setup a system to execute the auto-scaling strategy.
 */
abstract private type App.NodePool.AutoScaleStrategy {

  /**
   * Name of the {@link App.NodePool} for which this App.NodePool.AutoScaleStrategy is responsible for
   */
  nodePoolName: !string

  /**
   * Returns the {@link App.NodePool} for which this App.NodePool.AutoScaleStrategy is responsible for.
   */
  nodePool: final member function(): !App.NodePool

  /**
   * Configures this {@link App.NodePool.AutoScaleStrategy} for the defined {@link App.NodePool} based on the given spec
   * @param spec:
   *         {@link App.NodePool.AutoScaleStrategy.ConfigurationSpec
   */
  configure: final member function(spec: App.NodePool.AutoScaleStrategy.ConfigurationSpec)

  /**
   * Configures this sub type of {@link App.NodePool.AutoScaleStrategy} for the defined {@link App.NodePool} based on the given spec
   *
   * @param spec:
   *         {@link App.NodePool.AutoScaleStrategy.ConfigurationSpec
   */
  doConfigure: abstract member function(spec: App.NodePool.AutoScaleStrategy.ConfigurationSpec)

  /**
   * Returns whether this {@link App.NodePool.AutoScaleStrategy} has been configured for the defined {@link App.NodePool}
   */
  exists: final member function(): boolean

  /**
   * Returns whether this sub type of {@link App.NodePool.AutoScaleStrategy} has been configured for the defined {@link App.NodePool}
   */
  doExists: abstract member function(): boolean

  /**
   * Returns whether this {@link App.NodePool.AutoScaleStrategy} is active or not.
   *
   * NOTE: Is automatically false if {@link App.NodePool.AutoScaleStrategy#exists} is false
   */
  running: final member function(): boolean

  /**
   * Returns whether this sub type of {@link App.NodePool.AutoScaleStrategy} is active or not.
   *
   * NOTE: Is automatically false if this sub type of {@link App.NodePool.AutoScaleStrategy#exists} is false
   */
  doRunning: abstract member function(): boolean
}
