/**
 * Summary of a C3 application
 */
type App.Summary mixes CloudCluster.Summary.C3, WithName {

  /**
   * ID of the parent env this app belongs to.
   */
  envId: !string

  /**
   * Name of the parent env this app belongs to.
   */
  envName: !string

  /**
   * The C3 package deployed in an app.
   */
  rootPkg: !string
}
