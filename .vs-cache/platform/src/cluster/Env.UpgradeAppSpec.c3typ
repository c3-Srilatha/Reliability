/**
 * Specification for updating a C3 Application
 */
type Env.UpgradeAppSpec mixes Spec {

  // New severVersion of the app, if any.
  serverVersion: string serialized SemanticVersion

  // New rootPkg of the app, if any.
  rootPkg: string

  // New rootPkgVersion of the app, if any.
  rootPkgVersion: string serialized SemanticVersion

  // If true, automatically resume the app after upgrade completes.
  autoResume: boolean
}
