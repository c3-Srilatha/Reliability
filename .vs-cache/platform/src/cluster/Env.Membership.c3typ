/**
 * Represents abstract C3 Environment Membership and Discovery Service.
 */
abstract private type Env.Membership mixes Mutable {

  /**
   * Env this membership is for
   */
  env: !Env

  /**
   * @return all discovered Applications for this Environment
   */
  apps: final member function(refresh: !?boolean): [App]

  /**
   * @return app this env is serving by given name or id; on cache-miss refreshes membership and tries again
   */
  app: final member function(appNameOrId: !string): App

  /**
   * Create the App instance if it does not exist  or restarts if it is not running and brings it into an operational
   * state as defined by spec and bring it into a fully operational state. This implies the initial deployment of the
   * root application package.
   *
   * @param spec
   *         Specifications for an App such as node count and server version.
   * @return created or restarted App instance
   */
  startApp: final member function(spec: !Env.StartAppSpec): !App

  /**
   * Stop App by shutting down underlying infrastructure to bare minimum with expectation that on call to #startApp
   * app can be brought back to fully operation state.
   *
   * @param app
   *         App to be terminated
   * @return updated App state
   */
  stopApp: final member function(app: !App): !App

  /**
   * Upgrade App by updating all its underlying nodepools based on the App's membership.
   *
   * @param app
   *        App (needs to exist) which is to be updated
   * @param spec
   *        Spec @see{Env.UpgradeAppSpec} according to which the upgrade is performed
   *
   * @return BatchError
   */
  upgradeApp: final member function(app: !App, spec: !Env.UpgradeAppSpec): BatchError

  /**
   * Restarts an app if it exist. Brings it into an operational state as defined by spec and bring
   * it into a fully operational state. This implies the initial deployment of the
   * root application package.
   *
   * @param app
   *         App to be restarted
   * @return updated App state
   */
  resumeApp: final member function(app: !App): !App

  /**
   * Abort and terminate App.
   *
   * @param app
   *         App to be terminated.
   * @param confirm
   *         Confirmation from user that they understand and confirm deletion of this App and all of its data and config.
   * @return updated App state
   */
  terminateApp: final member function(app: !App): !BatchError

  /**
   * Configure and upsert a {@link CloudProvider} specific routing implementation for a given {@link AppUrl}.
   *
   * @param url
   *         The AppUrl for which the routing implementation is for.
   */
  upsertAppRoute: abstract member function(url: !AppUrl)

  /**
   * Remove a {@link CloudProvider} specific routing implementation for a given {@link AppUrl}.
   *
   * @param url
   *         The AppUrl for which the routing implementation is for.
   */
  removeAppRoute: abstract member function(url: !AppUrl)

  /**
   * @return all {@link AppUrl}s in the given Env
   */
  urls: abstract member function(): ![AppUrl]

  /**
   * Checks to see if an App is in the same internal network as the target App per membership logic.
   *
   * @param src
   *         Source App in where internal url will be used to call target App.
   * @param dest
   *         Destination App in where internal url should reach.
   * @return true if the target App is reachable via an internal url
   */
  canReachInternalUrl: abstract optional member function(src: !App, dest: !App): !boolean

  /**
   * @return all discovered Environment Nodes
   */
  nodes: final member function(refresh: boolean, spec: CloudClusterOpSpec): [Server]

  /**
   * @return node by given id; on cache-miss refreshes membership and tries again
   */
  node: final member function(nodeId: !string): Server

  /**
   * Start C3 Task, Data, Proxy or Agent node(s) / server(s)
   */
  startNodes: final member function(env: !Env, spec: !Cluster.Membership.StartNodesSpec): ![Server]

  /**
   * Restart node
   */
  restartNode: final member function(node: !Server)

  /**
   * Issue graceful shutdown request to node
   */
  shutdownNode: final member function(node: !Server)

  /**
   * Abort and terminate node
   */
  terminateNode: final member function(node: !Server)

  /**
   * @return new instance of membership for a given environment
   */
  makeMembership: function(env: !Env): !mixing Env.Membership

  /**
   * @return new instance of membership for a given app
   */
  makeAppMembership: abstract member function(app: !App): !App.Membership

  /**
   * Create the App instance if it does not exist  or restarts if it is not running and brings it into an operational
   * state as defined by spec and bring it into a fully operational state. This implies the initial deployment of the
   * root application package.
   *
   * @param app
   *         App to start or re-start
   * @return created or restarted App instance
   */
  doStartApp: abstract member function(app: !App): !App

  /**
   * Upgrade App by updating all its underlying nodepools by delegating it to the App's Membership.
   *
   * @param app
   *        App (needs to exist) which is to be updated
   * @param spec
   *        Spec @see{Env.UpgradeAppSpec} according to which the upgrade is performed
   *
   * @return BatchError
   */
  doUpgradeApp: abstract optional member function(app: !App, spec: !Env.UpgradeAppSpec): BatchError

  /**
   * Stop App by shutting down underlying infrastructure to bare minimum with expectation that on call to #startApp
   * app can be brought back to fully operation state.
   *
   * @param app
   *         App to be stopped.
   * @return updated App state
   */
  doStopApp: abstract member function(app: !App): !App

  /**
   * Forcefully bring down an app's compute resources on a best effort basis
   *
   * @param app
   *         App whose compute resources are to be shut down.
   * @return {@link BatchError}
   *         object with any errors that may have occurred
   */
  doInfraShutdownApp: abstract member function(app: !App): !BatchError

  /**
   * Abort and terminate App.
   *
   * @param app
   *         App to be terminated.
   * @return updated App state
   */
  doTerminateApp: abstract member function(app: !App): !App

  /**
   * Forcefully Abort and terminate App and delete all the app's data on a best effort basis
   *
   * @param app
   *         App to be force terminated.
   * @return {@link BatchError} object with any errors that may have occurred
   */
  doInfraCleanupApp: abstract member function(app: !App): BatchError

  /**
   * [re-]discover all Nodes and their State for all application in this environment
   */
  doDiscoverNodes: abstract optional member function(): [Server]

  /**
   * Start Leader, Task, Data, Proxy, Agent or other node(s) / server(s) for provided Application
   */
  doStartNodes: abstract optional member function(app: !App, spec: !Cluster.Membership.StartNodesSpec): ![Server]

  /**
   * Restart node.
   *
   * @param node
   *         Node that will be restarted.
   */
  doRestartNode: abstract optional member function(node: !Server)

  /**
   * Issue graceful shutdown request to node.
   *
   * @param node
   *         Node that will be shutdown.
   */
  doShutdownNode: abstract optional member function(node: !Server)

  /**
   * Abort and terminate node.
   *
   * @param node
   *         Node that will be terminated.
   */
  doTerminateNode: abstract optional member function(node: !Server)

  /**
   * Timestamp to last call to #doDiscoverNodes
   */
  nodesLastRefreshTime: datetime

  /**
   * Cached state of application
   */
  nodesById: @sorted(keys=true) MapBuilder<string, Server> = {}

  /**
   * Cached state of known nodes by node id
   */
  nodeStates: MapBuilder<string, string enum CloudCluster.State> = {}

  /**
   * Returns Cloud Resource Namespace of this C3 Env
   *
   * @see #doFindCloudNamespace
   */
  cloudNamespace: final member function(): string

  /**
   * Finds and returns the membership specific Cloud Resource Namespace of this C3 Env
   */
  doFindCloudNamespace: optional member function(): string

  /**
   * Returns {@link ClusterLogs} for this Env.Membership
   */
  fetchClusterLogs: member function(): !ClusterLogs

  /**
   * Returns {@link ClusterLogs} for this Env.Membership based on its membership
   */
  doFetchClusterLogs: abstract optional member function(): !ClusterLogs

  /**
   * Restart all apps in this environment
   *
   * @param skipSelf
   *        A boolean flag, set to true to skip restarting the current node: the node the command runs on.
   *        Valid only when called from an app within the env. Not valid for singleNode {@link Env}
   * @return {@link BatchError} object with any errors occurred during the restart
   */
  doRestartApps: abstract optional member function(skipSelf: boolean): BatchError

  /**
   * Fetches and returns {@link CloudResource}s belonging to this {@link Env}, but not belonging to any currently running {@link App} within it.
   * @param parentCloudResourceType
   *         Parent C3 Type whose subtypes are listed. It will need to be {@link CloudResource} or any of its subtypes.
   * @return orphaned {@link CloudResource}s
   */
  orphanResources: member function(parentCloudResourceType: !Type): !map<string, [CloudResource]>
}
