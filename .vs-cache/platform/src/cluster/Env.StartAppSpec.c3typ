/**
 * Specification for creating and starting a C3 Application
 */
type Env.StartAppSpec mixes AppFields, WaitableSpec {

  /**
   * Name of C3 Application to create and start; if not provided then sanitized root package name will be used instead
   */
  name: string

  /**
   * Decision to wait for App to be ready to serve background tasks or internal calls.
   * If there are any critical issues found, startApp will throw error.
   */
  waitForReadyInternal: private boolean

  /**
   * Decision to wait for App to be ready to accept external API calls. If there are any critical issues found,
   * startApp will throw error.
   */
  waitForReady: boolean

  /**
   * If set to true, do not throw any critical seed issues found, when waiting for app to be ready.
   */
  doNotThrowOnIssues: boolean

  /**
   * Semantic version of the server that rootPkg depends on
   */
  serverVersion: string serialized SemanticVersion

  /**
   * Decision to start task nodes of a task node pool with autoscaling enabled
   */
  autoScale: boolean = true

  /**
   * Represents the number of {@link App.NodePool.Defaults#TASK} nodes to start for this App upon {@link Env#startApp}.
   */
  taskNodeCount: int32 = 0

  /**
   * Represents the number of {@link App.NodePool.Defaults#LEADER} nodes to start for this App upon {@link Env#startApp}.
   */
  leaderNodeCount: int32 = 1

  /**
   * List of {@link App.NodePool.Config} for an app. These {@link App.NodePool} config will get overridden
   * at app level upon app start. This allows configuration of {@link App.NodePool} before creation of app.
   */
  nodePoolConfig: [App.NodePool.Config]

  /**
   * Who started the app
   */
  startedBy: User
}
