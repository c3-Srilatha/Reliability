/*
 * This distinguishes the scope of metric.
 * For eg, metrics defined at app scope like invalidation queue uses App.Meter.Scope.APP
 */
@beta
private enum type App.Meter.Scope {

  /**
   * Meter scope of an app
   * * Example, invalidation queue, app health
   */
  APP = 'app'

  /**
   * Meter scope of a node
   * * Example, disk limit, directory size of a node, cassandra connectivity from a node
   */
  NODE = 'node'
}
