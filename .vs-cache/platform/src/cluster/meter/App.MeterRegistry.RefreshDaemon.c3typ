/**
 * A very light daemon running on all nodes and for all apps hosted by that node to discover and cleanup dynamic tags
 * values from {@link App.Meter.Gauge#tagsExpr}.
 */
type App.MeterRegistry.RefreshDaemon mixes Controller {

  /**
   * Main execution loop to update tags
   */
  ensure: ~

  /**
   * Cleanup all meters before stopping this Engine.Periodic
   */
  stop: inline member function()
}
