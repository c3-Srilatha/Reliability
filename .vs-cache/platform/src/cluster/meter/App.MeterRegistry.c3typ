/**
 * Creates and manages app's set of meters.
 * Exporters use the meter registry to iterate over the set of meters instrumenting this server,
 * and then further iterate over each meter's metrics, generally resulting in a time series in the
 * metrics backend for each combination of metrics and dimensions.
 */
@beta
private type App.MeterRegistry mixes Named {

  /**
   * Keeps tracks of all meters for this server
   */
  registry: @java(class="io.micrometer.prometheus.PrometheusMeterRegistry") native

  name:    cached !~
  forName: cached ~

  /**
   * @return map of the metric name to get count of tags
   *         For example [{"meterName": "server_health"}]
   */
  meterCountTags: private member function(): ![map<string, string>]

  /**
   * @return double
   *         number of metrics series for {@link App.Meter#name}
   */
  meterCountValue: private member function(appMeterTags: !map<string, string>): !double

  /**
   * @return count of all meters registered
   */
  @cache(ttr='1m', ttl='2m')
  meterCountValues: private cached function(): !map<string, !double>
}
