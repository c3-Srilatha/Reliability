/**
 * Used to run sanity checks after each upgrade to ensure that the Application or Environment is correctly configured.
 */
type ClusterSanityCheck {

  /**
   * Validate the app is reachable and using the right serverVersion
   *
   * @return an array of error messages
   */
  validateAppAndServerVersion: function(appId: !string,
                                        serverVersion: !string serialized SemanticVersion): ![string] js-server

  /**
   * Validate cluster-level PG setup is correct and the app is connecting the cluster-level PG
   *
   * @return an array of error messages
   */
  validatePG: function(appId: !string): ![string] js-server

  /**
   * Validate cluster-level Cass setup is correct and the app is connecting the cluster-level Cass
   *
   * @return an array of error messages
   */
  validateCass: function(appId: !string): ![string] js-server

  /**
   * Validate assertion is disabled
   *
   * @return an array of error messages
   */
  validateAssertionDisabled: function(appId: !string): ![string] js-server

  /**
   * Validate Xmx configuration is correct
   *
   * @return an array of error messages
   */
  validateXmx: function(appId: !string): ![string] js-server

  /**
   * Validate GC Settings are correct
   */
  validateGcSettings: function(appId: !string): ![string] js-server

  /**
   * Validate tasks nodes exists for this app
   *
   * @return an array of error messages
   */
  validateTaskNodesExistence: function(appId: !string): ![string] js-server

  /**
   * Validate all NodePool configs for this app
   *
   * @return an array of error messages
   */
  validateNodePoolConfigs: function(appId: !string): ![string] js-server

  /**
   * Validate NodePool config for this app
   *
   * @return an array of error messages
   */
  validateNodePoolConfig: function(nodePoolName: !string,
                                   minCpu: !int,
                                   minMemory: !int,
                                   jvmMaxMemoryPct: !double): ![string] js-server

  /**
   * Validate default file system is using cloud storage
   *
   * @return an array of error messages
   */
  validateFileSystemConfig: function(): ![string] js-server

  /**
   * Validate cluster level studio is configured
   *
   * @return an array of error messages
   */
  validateClusterLevelStudio: function(studioEnvName: string): ![string] js-server

  /**
   * Runs {@link Studio#sanityCheck}
   * @return an array of error messages
   */
  validateStudioCheck: function(): ![string] js-server

  /**
   * Validate cluster level url is configured
   *
   * @return an array of error messages
   */
  validateClusterLevelUrl: function(): ![string] js-server

  /**
   * Validate OpenSearch can be accessed
   *
   * @return an array of error messages
   */
  validateOpenSearch: function(): ![string] js-server

  /**
   * Validate Grafana can be accessed
   *
   * @return an array of error messages
   */
  validateGrafana: function(): ![string] js-server

  /**
   * Validate all essential cronJobs are enabled
   *
   * @return an array of error messages
   */
  validateRequiredCronJobs: function(): ![string] js-server

  /**
   * Validate kubernetes version
   *
   * @return an array of error messages
   */
  validateK8sVersion: function(): ![string] js-server

  /**
   * Validate K8s container config is not set at the cluster/env/app level
   *
   * @return an array of error messages
   */
  validateK8sContainerConfig: function(): ![string] js-server

  /**
   * Validate K8s deploy* configs are not set at the cluster/env/app level
   *
   * @return an array of error messages
   */
  validateK8sDeployConfigs: function(): ![string] js-server

  /**
   * Validate that tools for application monitoring are functional
   */
  validateAppMonitoringTools: function(): ![string] js-server

  /**
   * run all tests and return test result
   * See {@link ClusterSanityCheckOpSpec}.
   * @param spec Optional spec for specifying studioEnvName, etc.
   * @return a 2d array of error messages
   */
  runAllTests: function(spec: ClusterSanityCheckOpSpec): ![[string]] js-server

  /**
   * run all tests and print test result
   * See {@link ClusterSanityCheckOpSpec}.
   * @param spec Optional spec for specifying studioEnvName, etc.
   * @return a 2d array of error messages
   */
  runAllTestsAndPrint: function(spec: ClusterSanityCheckOpSpec): ![[string]] js-client
}
