/**
 * Represents abstract C3 App Membership and Discovery Service.
 */
abstract private type App.Membership mixes Mutable {

  /**
   * App this membership is for
   */
  app: !App

  /**
   * Lists all {@link App.NodePool}s for the App represented by this membership.
   * @param refresh
   *         Fetch after refreshing the cache in ClusterCtx
   */
  nodePools: member function(refresh: boolean): [App.NodePool]

  /**
   * Fetches specified {@link App.NodePool} for this App if available.
   *
   * @param nodePoolName
   *         Specifies the {@link App.NodePool#name}.
   * @param failIfMissing
   *         Fail if {@link App.NodePool} does not exist for the App.
   * @return {@link App.NodePool} based on the specified name.
   */
  nodePool: member function(nodePoolName: string, failIfMissing: boolean): App.NodePool

  /**
   * @return all discovered Application Nodes
   */
  nodes: final member function(refresh: !?boolean): [Server]

  /**
   * @return node in this app by provided id; on cache-miss refreshes membership and tries again
   */
  node: final member function(serverId: !string): Server

  /**
   * Represents the state of all individual nodes for all {@link App.NodePool}s in this App. Note that logic for
   * how {@link Server#lastMessage}s are displayed changes per membership logic.
   *
   * @param refresh
   *         If `refresh` parameter is true, ensure the state of all nodes are up to date.
   * @return mapping of all nodes to their corresponding state
   */
  nodeStates: member function(refresh: boolean): map<string, { state: !string, lastMessage: string }>

  /**
   * Start Leader, Task, Data, Proxy, Agent or other node(s) / server(s) for this Application
   */
  startNodes: final member function(spec: !Cluster.Membership.StartNodesSpec): ![Server]

  /**
   * Restart node.
   *
   * @param node Node that will be restarted.
   */
  restartNode: final member function(node: !Server)

  /**
   * Issue graceful shutdown request to node.
   *
   * @param node
   *         Node that will be shutdown.
   */
  shutdownNode: final member function(node: !Server)

  /**
   * Abort and terminate node.
   *
   * @param node Node that will be terminated.
   */
  terminateNode: final member function(node: !Server)

  /**
   * @return new instance of membership for a given app
   */
  makeMembership: function(app: !App): !mixing App.Membership

  /**
   * [re-]discover all Nodes and their State for this Application
   */
  doDiscoverNodes: abstract member function(): [Server]

  /**
   * Start Leader, Task, Data, Proxy, Agent or other node(s) / server(s) for this Application
   */
  doStartNodes: abstract optional member function(spec: !Cluster.Membership.StartNodesSpec): ![Server]

  /**
   * Restart node.
   *
   * @param node Node that will be restarted.
   */
  doRestartNode: abstract optional member function(node: !Server)

  /**
   * Issue graceful shutdown request to node.
   *
   * @param node
   *         Node that will be shutdown.
   */
  doShutdownNode: abstract optional member function(node: !Server)

  /**
   * Abort and terminate node.
   *
   * @param node Node that will be terminated.
   */
  doTerminateNode: abstract optional member function(node: !Server)

  /**
   * Timestamp of the previous time nodesById cache was updated.
   */
  lastRefreshTime: datetime

  /**
   * Cached state of nodes by application
   */
  nodesById: @sorted(keys=true) MapBuilder<string, Server>

  /**
   * Returns {@link ClusterLogs} for this App.Membership
   */
  fetchClusterLogs: member function(): !ClusterLogs

  /**
   * Constructs {@link ClusterLogs} for this App.Membership based on its membership
   */
  doFetchClusterLogs: abstract optional member function(): !ClusterLogs

  /**
   * Returns the internal {@link AppUrl} for the App based on its membership.
   *
   * @return {@link App#internalUrl} for this App if one exists
   */
  doInternalUrl: private abstract optional property(): AppUrl

  /**
   * Fetches and returns {@link CloudResource}s belonging to this {@link App}, but not belonging to the server or the currently active cloud services.
   * @param parentCloudResourceType
   *         Parent C3 Type whose subtypes are listed. It will need to be {@link CloudResource} or any of its subtypes.
   * @return orphaned {@link CloudResource}s
   */
  orphanResources: member function(parentCloudResourceType: !Type): !map<string, [CloudResource]>

  /**
   * Restart all nodes of this app
   * NOTE: operation is not supported for singleNode non c3 {@link App}s
   *
   * @param skipSelf
   *        A boolean flag, set to true to skip restarting self: the node the command runs on.
   *        Valid only when called from a node within the app. Not valid for singleNode {@link App}
   * @return {@link BatchError} object with any errors occurred during the restart
   */
  doRestartNodes: abstract optional member function(skipSelf: boolean): BatchError
}
