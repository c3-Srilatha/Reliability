/**
 * Returns the summary of the C3 cluster
 */
type Cluster.Summary mixes CloudCluster.Summary.C3 {

  /**
   * Summary of all {@link App}s belonging to this C3 cluster.
   */
  apps: [App.Summary]

  /**
   * Summary of all {@link Env}s belonging to this C3 cluster.
   */
  envs: [Env.Summary]
}
