/**
 * Type used to capture admin level permitted ranges and values for various fields in {@link App.NodePool.JvmSpec}
 */
@beta
type App.NodePool.JvmSpec.AdminFields {

  /**
   * The permitted range for the {@link App.NodePool.JvmSpec#jvmMaxMemoryPct}
   * Value of -1 indicates there are no limits.
   */
  jvmMaxMemoryPctAllowedRange: Pair<double, double> = { "fst": -1, "snd": -1 }
}
