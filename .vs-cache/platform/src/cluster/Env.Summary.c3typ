/**
 * Summary of a C3 environment
 */
type Env.Summary mixes CloudCluster.Summary.C3, WithName {

  /**
   * If true then this environment will only have a single node that will serve requests and execute jobs for every
   * App in this Env
   */
  singleNode: boolean

  /**
   * Id of the parent cluster that this env belongs to
   */
  clusterId: string

  /**
   * Total number of {@link App}s in this {@link Env}, excluding the c3 app
   */
  appCount: !int

  /**
   * Summary of all {@link App}s belonging to this {@link Env}.
   */
  apps: ![App.Summary]
}
