/**
 * C3 Server Debug
 */
type Server.Debug {

  /**
   * Start a debug utility.
   *
   * @return url to access debug utility.
   */
  start: abstract member function(): !string serialized Url

  /**
   * Stop a debug utility
   */
  stop: abstract member function()

  /**
   * @return an endpoint to access debug utility
   */
  endpoint: abstract member function(): !string serialized Url
}
