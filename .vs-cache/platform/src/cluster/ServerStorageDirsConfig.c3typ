/**
 * Config for {@link K8sStorageMonitor} that determines paths that users want to monitor for the node.
 */
@config(authz=ConfigAuthz.CLUSTER_ADMIN, minOverride=APP, maxOverride=CLUSTER)
private type ServerStorageDirsConfig mixes Config, Singleton {

  /**
   * Known writeable paths that are commonly used in c3server. These paths are also monitored via {@link K8sStorageMonitor}.
   */
  paths: [string]
}
