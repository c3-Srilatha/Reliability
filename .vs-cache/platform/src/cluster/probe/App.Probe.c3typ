/**
 * Represents an application-level boolean probe which can be configured to track a certain aspect of all
 * C3 {@link Server}'s health (ex: liveness, readiness) for an {@Link App}.
 *
 * Once configured, these probes run periodically, via a corresponding {@link App.Probe.Controller}
 * inside every C3 {@link Server}.
 *
 * A list of currently supported names for probes are available in {@link Probe}
 *
 * @see App.Probe.Controller
 * @see App.Probe.Controller.Readiness
 */
@action(group+="app-admin")
type App.Probe mixes Configurable<App.Probe.Config>, Named {

  /**
   * {@link App} this App.Probe is intended for.
   */
  app: !App

  /**
   * Gets the {@link App.Probe.Config} for this App.Probe
   */
  config: ~: App.Probe.Config

  /**
   * Returns the corresponding App.Probe.Controller.Subtype for this App.Probe
   */
  controller: private member function(): App.Probe.Controller

  /**
   *  Configures the config for this App.Probe.
   *  Once done, run (@link App.Probe#syncAll} to apply this change to all C3 {@link Server}s of the app.
   *
   *  @param config:
   * Specifies the {@link App.Probe.Config} to be configured
   *  @param spec
   *          Specifies the {@link CloudClusterOpSpec} to be used for configuring the App.Probe.
   *          If {@link CloudClusterOpSpec#doNotRemote} is true, then this action will not be remoted to the {@link #app}.
   */
  configure: member function(config: App.Probe.Config, spec: CloudClusterOpSpec)

  /**
   * Removes the {@link App.Probe.Config} for this App.Probe.Controller.SubType, if one exists.
   * Once done, run (@link App.Probe#syncAll} to apply this change to all C3 {@link Server}s of the app.
   *
   * @param spec
   *         Specifies the {@link CloudClusterOpSpec} to be used for configuring the App.Probe.
   *         If {@link CloudClusterOpSpec#doNotRemote} is true, then this action will not be remoted to the {@link #app}.
   */
  remove: member function(spec: CloudClusterOpSpec)

  /**
   * Updates the current App.Node to use the latest {@link App.Probe.Config}(s).
   */
  sync: member function()

  /**
   * Updates the all App.Nodes belonging to the App to use the latest {@link App.Probe.Config}(s).
   *
   * @return {@link BatchError} if any, where an error is reported per C3 {@link Server} basis
   */
  syncAll: member function(): !BatchError
}
