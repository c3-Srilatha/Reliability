/**
 * {@link Controller} responsible for tracking an {@link App.Probe} in a given app
 */
abstract type App.Probe.Controller mixes Controller {

  /**
   * Gets the {@link App.Probe} this controller is tracking.
   * Returns null, if no App.Probe.Config doesn't exist.
   */
  probe: abstract member function(): App.Probe

  /**
   * Checks if this App.Probe.Controller.SubType has been configured or not
   */
  enabled: member function(): boolean

  /**
   * Configures an App.Probe.Controller.Subtype for the given {@link Controller.Config#syncIntervalMilliSeconds}
   */
  @action(group+='cluster-admin')
  configure: member function(syncIntervalMilliSeconds: int)

  /**
   * Removes the {@link Controller.Config} for this App.Probe.Controller.SubType, if one exists.
   */
  @action(group+='cluster-admin')
  remove: member function()
}
