/**
 * Configuration options for {@link App.Probe}
 */
@config(doNotDefaultIfMissing=true, maxOverride=APP, minOverride=APP)
@action(group+="cluster-admin")
@cache(cacheNulls=true) // This is needed so App.Probe.Controller doesn't keep reading from ConfigStore for App that have no App.Probe defined
type App.Probe.Config mixes Config, Named {

  name: ~: string enum Probe

  /**
   * Boolean {@link PartiallyAppliedAction} that tracks the desired indicator of the {@link App.Node}.
   */
  action: !PartiallyAppliedAction

  /**
   * Timeout specification for the {@link #action}.
   * If the action does not complete within this time, the probe will be considered as unsuccessful.
   */
  timeout: TimeoutSpec

  /**
   * How often (in seconds) to perform the probe.
   */
  periodSeconds: int32 = 1

  validate: ~
}
