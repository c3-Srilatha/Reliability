/**
 * Type to capture main activities in the app.
 */
type App.Activity {

  /**
   * Id of the app reporting activity.
   */
  appId: string serialized AppId

  /**
   * Id of the server reporting activity.
   */
  serverId: string serialized Server.Id

  /**
   * Version of the server reporting activity.
   */
  serverVersion: string serialized SemanticVersion

  /**
   * Timestamp of when the activity occurred.
   */
  timestamp: datetime

  /**
   * Activity message.
   */
  message: string

  /**
   * Activity level.
   */
  level: string enum App.Activity.Level

  /**
   * Source of the activity.
   */
  source: string enum App.Activity.Source
}
