type App.Wip {

  /**
   * @return AppAutoscaler service for this Application
   */
  autoscaler: private member function(): !App.Autoscaler

  /**
   * Upgrade the App to the specified version.
   *
   * @param serverVersion
   *           Server version to upgrade to.
   * @return map that keys Node-specific errors to the Node ID.
   */
  upgrade: private member function(serverVersion: string): map<string, Error>

  /**
   * @return all task nodes in this app; if `refresh` parameter is set then ensure that app membership is up to
   *         date.
   */
  tasks: member function(refresh: boolean): [App.Task]

  /**
   * @return all data nodes in this app; if `refresh` parameter is set then ensure that app membership is up to
   *         date.
   */
  data: member function(refresh: boolean): [App.Data]

  /**
   * @return all leader nodes in this app; if `refresh` parameter is set then ensure that app membership is up to
   *         date.
   */
  leaders: member function(refresh: boolean): [App.Leader]
}
