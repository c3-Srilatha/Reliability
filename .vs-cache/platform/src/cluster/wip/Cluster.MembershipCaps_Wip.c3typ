/**
 * Capabilities of C3 Cluster Membership and Discovery Service
 */
type Cluster.MembershipCaps_Wip {

  /**
   * Supports start and shutdown of nodes
   */
  startNodes: boolean

  /**
   * Supports restart of a node
   */
  restartNode: boolean

  none: private cached function(): !mixing Cluster.MembershipCaps_Wip
  all:  private cached function(): !mixing Cluster.MembershipCaps_Wip
}
