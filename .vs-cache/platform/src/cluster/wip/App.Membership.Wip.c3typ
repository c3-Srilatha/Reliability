/**
 * WIP ideas for future enhancements / changes
 */
abstract private type App.Membership.Wip {

  /**
   * @return capabilities of this Application Membership and Discovery Service
   */
  capabilities: abstract member function(): App.MembershipCaps_Wip

  /**
   * @return autoscaler for this application
   */
  autoscaler: cached abstract member function(): !App.Autoscaler

  /**
   * @return C3 id this server / JVM [ aka `I` or `me` ] should use
   */
  @action(local=true)
  myServerId: final member function(role: string, requestedId: string, seedLeaderEndpount: string): !string

  /**
   * Update state and telemetry of this server / JVM [ aka `I` or `me` ] and send heartbeat to our leader if any
   */
  @action(local=true)
  myServerHeartbeat: final member function(refreshTelemetry: !boolean)

  /**
   * @return Leader and Worker nodes of cluster this environment belongs to
   */
  @action(local=true)
  myClusterNodes: final member function(): MapBuilder<string, Server>

  /**
   * Allocates available id for a optionally provided node role
   */
  allocateId: final function(role: string, requestedId: string, seedLeaderEndpount: string): !string

  /**
   * Receive heartbeat from a Cluster Leader or Worker node in this Cluster and respond back with our state
   */
  heartbeat: final function(node: !Server): !Server
}
