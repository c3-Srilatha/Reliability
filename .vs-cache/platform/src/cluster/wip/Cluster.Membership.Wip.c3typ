/**
 * Some WIP ideas regarding future enhancements / changes in Cluster.Membership
 */
abstract private type Cluster.Membership.Wip {

  /**
   * @return capabilities of this Cluster Membership and Discovery Service
   */
  capabilities: abstract member function(): Cluster.MembershipCaps_Wip

  /**
   * Start Leader or Worker node(s) / server(s)
   */
  startNodes: abstract member function(spec: !Cluster.Membership.StartNodesSpec): ![Server]

  /**
   * Restart node
   */
  restartNode: abstract member function(node: !Server)

  /**
   * Issue graceful shutdown request to node
   */
  shutdownNode: abstract member function(node: !Server)

  /**
   * Abort and terminate node
   */
  terminateNode: abstract member function(node: !Server)

  /**
   * @return autoscaler for this cluster
   */
  autoscaler: cached abstract member function(): !Cluster.Autoscaler
}
