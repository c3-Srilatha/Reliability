/**
 * WIP ideas for future enhancements / changes
 */
abstract private type Env.Membership.Wip {

  /**
   * @return capabilities of this Environment Membership and Discovery Service
   */
  capabilities: abstract member function(): Env.MembershipCaps_Wip

  /**
   * @return autoscaler for this environment
   */
  autoscaler: cached abstract member function(): !Env.Autoscaler

  /**
   * @param app
   *         The app that the hostname will be retrieved from.
   * @param serverVersion
   *         The semantic version of the C3 server to upgrade to.
   * @return map that keys Node-specific errors to the Node ID.
   */
  upgrade: abstract member function(app: !App, serverVersion: string): map<string, Error>

  /**
   * Hibernate environment by releasing resources but maintaining full state so it can be woken up.
   *
   * @param env
   *           Env to be hibernated.
   */
  hibernateEnv: abstract member function(env: !Env)

  /**
   * Wake up hibernated environment.
   */
  activateEnv: abstract member function(env: !Env)
}
