/**
 * Represents an agent node. I.e. one responsible for managing a single compute instance and monitoring health of the
 * software running on it.
 *
 * @see Cluster.Leader
 * @see Cluster.Worker
 */
type Env.Agent mixes Server {

  /**
   * Leader node managing this node
   */
  leader: Cluster.Leader
}
