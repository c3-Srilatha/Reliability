/**
 * Represents an edge devices managed by this environment.
 */
type Env.Edge {

  // TODO: mixes Server {
  id: string

  ipAddress:          string
  ipPort:             int
  deviceId:           string
  deviceManufacturer: string
  deviceModel:        string
  deviceModelFamily:  string
  cpuUsage:           double
  gpuUsage:           double
  memoryUsage:        double
  app:                string
  mlModel:            string
  uploadMlModel:      function(appName: !string, name: !string, url: string serialized FileUrl)
}
