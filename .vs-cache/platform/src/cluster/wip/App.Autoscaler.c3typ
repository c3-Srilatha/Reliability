/**
 * Represents abstract C3 Application Autoscaler Service.
 */
abstract private type App.Autoscaler mixes Mutable {

  /**
   * @return capabilities of this Application Autoscaler Service
   */
  capabilities: abstract member function(): Cluster.AutoscalerCaps

  /**
   * Sets target number of C3 Application nodes
   */
  setNodeCountTarget: abstract member function(app: !App, role: !string enum Server.Role, count: !int32)
}
