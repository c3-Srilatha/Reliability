/**
 * Capabilities of C3 Application Membership and Discovery Service
 */
type App.MembershipCaps_Wip mixes Cluster.MembershipCaps_Wip {

  /**
   * Supports creation and hibernation/termination of an application
   */
  startStopApp: boolean

  /**
   * Supports the upgrade of an application
   */
  upgradeApp: boolean

  /**
   * Supports Glowroot instrumentation
   */
  glowroot: boolean

  all: ~
}
