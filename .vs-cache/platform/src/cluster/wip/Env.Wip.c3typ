private type Env.Wip {

  /**
   * @return all agent nodes in this env; if `refresh` parameter is set then ensures that cluster membership is up to
   *         date, otherwise last known state is returned.
   */
  agents: member function(refresh: boolean): [Env.Agent]

  /**
   * @return all task nodes in this env; if `refresh` parameter is set then ensure that cluster membership is up to
   *         date.
   */
  tasks: member function(refresh: boolean): [Env.Task]

  /**
   * @return all data nodes in this env; if `refresh` parameter is set then ensure that cluster membership is up to
   *         date.
   */
  data: member function(refresh: boolean): [Env.Data]

  /**
   * @return all proxy nodes in this env; if `refresh` parameter is set then ensure that cluster membership is up to
   *         date.
   */
  proxies: member function(refresh: boolean): [Env.Proxy]

  /**
   * @return all edge devices managed by this env; if `refresh` parameter is set then ensure that cluster membership is
   *         up to date.
   */
  edges: member function(refresh: boolean): [Env.Edge]

  /**
   * @return result of the call of provided action on each Task node and return result or error by node id
   */
  callTasks: member function(type: !string,
                             action: !string,
                             thisArg: json,
                             args: [json],
                             spec: TimeoutSpec): map<string, Pair<json, Error>>

  /**
   * @return result of the call of provided lambda on each Task node and return result or error by node id
   */
  callTasks: member function<T>(action: !lambda(): T, spec: TimeoutSpec): map<string, Pair<T, Error>>

  /**
   * @return error by node id if any of the calls of provided lambda on each Task node fails
   */
  callTasks: member function(action: !lambda(), spec: TimeoutSpec): map<string, Error>

  /**
   * @return promise of result of the call of provided action on each Task node and return result or error by node id
   */
  callTasksAsync: member function(type: !string,
                                  action: !string,
                                  thisArg: json,
                                  args: [json],
                                  spec: TimeoutSpec): map<string, Promise<json>>

  /**
   * @return promise of result of the call of provided lambda on each Task node and return result or error by node id
   */
  callTasksAsync: member function<T>(action: !lambda(): T, spec: TimeoutSpec): map<string, Promise<T>>

  /**
   * @return promise of execution of the call of provided lambda on each Task node and error by node id if any
   */
  callTasksAsync: member function(action: !lambda(), spec: TimeoutSpec): map<string, Promise<boolean>>

  /**
   * @return result of the execution of shell script on each Task node and return result or error by node id
   */
  sshTasks: member function(script: !string, spec: TimeoutSpec): map<string, Pair<string, Error>>

  /**
   * @return promise of result of the execution of shell script on each Task node and return result or error by node id
   */
  sshTasksAsync: member function(script: !string, spec: TimeoutSpec): map<string, Promise<string>>

  /**
   * Restarts all task for this env by ssh-ing to each node.
   */
  sshRestartTasks: member function(): map<string, Error>

  /**
   * Restarts all nodes for this env by ssh-ing to each node.
   */
  sshRestartAll: member function(): map<string, Error>

  /**
   * Authorize c3 user's ssh key on all task nodes and return potential errors by node id
   */
  authorizeSshKeyOnTasks: member function(): map<string, Error>

  /**
   * Start nodes for this env
   */
  startNodes: member function(spec: !Cluster.Membership.StartNodesSpec): ![Server]

  /**
   * Restarts all JVM processes for all task nodes in this env by exiting JVM. OS then will start a new JVM process
   * picking up any potential changes in startup args.
   */
  exitTasks: member function(exitCode: int32, shutdownTimeout: Duration)

  /**
   * Restarts all task nodes for this env. Unless shutdownTimeout is provided restarts nodes immediately otherwise
   * issues Jvm process shutdown request and waits up to shutdownTimeout for all pending tasks to complete.
   */
  restartTasks: member function(shutdownTimeout: Duration)

  /**
   * Issues graceful shutdown request to every task node
   */
  shutdownTasks: member function()

  /**
   * Abort and terminate every task node
   */
  terminateTasks: member function(confirm: boolean)

  /**
   * @return JVM args of each task node in this env
   */
  taskJvmArgs: member function(configured: boolean): map<string, [string]>

  /**
   * Add one or more JVM args for every task node in this env
   */
  addTaskJvmArgs: member function(args: string ...)

  /**
   * Remove one or more JVM args for every task node in this env
   */
  removeTaskJvmArgs: member function(args: string ...)

  /**
   * Enables CPU and Memory profiling for all task nodes in this env
   */
  enableTaskJvmProfiler: member function()

  /**
   * Disables CPU and Memory profiling for all task nodes in this env
   */
  disableTaskJvmProfiler: member function()

  /**
   * Enables Java debugging for all task nodes in this env
   */
  enableTaskJvmDebug: member function(suspend: boolean)

  /**
   * Disables Java debugging for all task nodes in this env
   */
  disableTaskJvmDebug: member function()

  /**
   * Upgrade all server nodes in the C3 environment to latest stable version
   */
  upgrade: private member function(): map<string, Error>

  /**
   * @return Env.Autoscaler service for this Environment
   */
  autoscaler: private member function(): !Env.Autoscaler
}
