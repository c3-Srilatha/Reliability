/**
 * This c3 type is used to represent the summary of a thread. {@link App.Node.Thread#summary}
 */
type App.Node.Thread.Info {

  /**
   * The id of the {@link App.Node node} that this thread is running on.
   */
  nodeId: string

  /**
   * The name of the {@link App.Node.ThreadPool thread pool} that this thread is running in.
   */
  threadPoolName: string

  /**
   * The name of the {@link Engine engine} that this thread is running in.
   */
  engineName: string

  /**
   * The {@link App.Node.Thread#name} of the thread.
   */
  threadName: string

  /**
   * Whether the thread is ready to take tasks.
   */
  isReady: boolean

  /**
   * {@link Duration} since the thread was started.
   */
  uptime: Duration

  /**
   * The {@link DateTime} when the thread was started.
   */
  started: DateTime

  /**
   * The {@link Action} that is currently running on this thread, null if no action is running.
   */
  currentAction: json
}
