/**
 * Type used to capture admin level permitted ranges and values for various fields in {@link HardwareProfile}
 */
type HardwareProfile.AdminFields {

  /**
   * The permitted range for {@link HardwareProfile#cpu}
   */
  cpuAllowedRange: Pair<int, int> = { "fst": -1, "snd": -1 }

  /**
   * The permitted range for {@link HardwareProfile#memoryMb}
   */
  memoryMbAllowedRange: Pair<int, int> = { "fst": -1, "snd": -1 }

  /**
   * The permitted range for {@link HardwareProfile#diskGb}
   */
  diskGbAllowedRange: Pair<int, int> = { "fst": -1, "snd": -1 }

  /**
   * The permitted range for {@link HardwareProfile#acceleratorCount}
   */
  acceleratorCountAllowedRange: Pair<int, int> = { "fst": -1, "snd": -1 }
}
