/**
 * Configuration options for shared storage for c3 Node {@link App.NodePool}.
 */
@beta
type App.NodePool.Config.SharedStorage mixes Spec, App.NodePool.Config.SharedStorage.AdminFields {

  /**
   * Allows {@link App.NodePool} to enable shared storage for an env. Note this defaults to false.
   */
  enabled: !boolean

  /**
   * Size of shared storage for an env.
   */
  sizeGb: string = '30Gi'

  /**
   * StorageType for an env, e.g. disk or nfs
   */
  storageType: string = 'disk'
}
