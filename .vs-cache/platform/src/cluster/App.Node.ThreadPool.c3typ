/**
 * C3 App.Node Thread Pool
 */
inline type App.Node.ThreadPool mixes Identified, Configurable<App.Node.ThreadPool.Config>, StringSerializable {

  /**
   * Start the thread pool on the node that this api is called on.
   */
  start: member function()

  /**
   * Stop the thread pool on the node that this api is called on.
   */
  stop: member function()

  /**
   * @return `true` if this thread pool is running
   */
  isRunning: member function(): boolean

  /**
   * @return instance for the current thread pool where this action is executing
   */
  current: function(): !App.Node.ThreadPool

  /**
   * @return {@link App.Node.ThreadPool#config config} for {@link current} thread pool
   */
  currentConfig: function(): !App.Node.ThreadPool.Config

  /**
   * @return {@link App.Node.ThreadPool.Config# Python config} for {@link current} thread pool
   */
  currentPyConfig: function(): !App.Node.ThreadPool.Config.Py

  /**
   * Name of this {@link App.Node.ThreadPool}, unique within the {@link App}.
   */
  name: cached property(): !string

  /**
   * Parent {@link App.Node.Id} where this {@link App.Node.ThreadPool} is hosted.
   */
  nodeId: cached property(): !string serialized App.Node.Id

  /**
   * Parent {@link App.Node} where this {@link App.Node.ThreadPool} is hosted.
   */
  @cache(platPkg=true)
  node: cached property(): !App.Node

  /**
   * An {@link AppId Id} of the {@link App} where this {@link App.Node.ThreadPool} is configured.
   */
  appId: cached property(): !string serialized AppId

  /**
   * An {@link App} where this {@link App.Node.ThreadPool} is configured.
   */
  @cache(platPkg=true)
  app: cached property(): !App

  /**
   * @return action queue for this thread-pool; actions that are suppose to execute on this thread-pool will be
   *         dispatched via this queue
   */
  actionQueue: cached property(): !Action.Queue

  /**
   * @return {@link Engine} if this {@link App.Node.ThreadPool} is dedicated some, otherwise `null`.
   *
   * @see Engine
   * @see Engine.DeploySpec#dedicatedThreadPool
   */
  engine: cached property(): Engine

  /**
   * Calls C3 Action on one of the available threads in this thread pool and throws exception or return result
   */
  call: member function<T>(action: !Action): T

  /**
   * Calls Lambda on one of the available threads in this thread pool and throws exception or return result
   */
  call: member function<T>(lambda: !Lambda): T

  /**
   * Runs C3 Action on one of the available threads in this thread pool
   */
  run: member function<T>(action: !Action)

  /**
   * Runs Lambda on one of the available threads in this thread pool
   */
  run: member function<T>(lambda: !Lambda)

  /**
   * Dispatches C3 Action on one of the available threads in this thread pool and updates state of the action.
   * note: will not throw exception action call fails, only updates state & error of the action.
   */
  dispatch: member function<T>(action: !Action)

  /**
   * Encoded identifier for this thread pool
   */
  id: !~

  /**
   * @param nameOrId
   *         name or id of the thread pool
   * @param failIfMissing
   *         if `true` will throw exception if thread pool is not found, otherwise will return `null`
   * @return thread pool with the given name or id, or `null` if not found and `failIfMissing` is `false`
   */
  forNameOrId: function(nameOrId: !string, failIfMissing: boolean): !App.Node.ThreadPool

  /**
   * Utility to generate consistent thread pool id
   */
  generateId: private function(nodeId: !string, threadPoolName: !string): !string

  // TODO: PLAT-61143 code-gen produces invalid java code for `DataGen.Profile.Type`
  // containsThread: private member function(thread: @java(class='java.lang.Thread') !native): boolean
  containsThread: private member function(thread: !native): boolean

  /**
   * The running c3 threads corresponding to this thread pool.
   */
  runningThreads: member function(): [App.Node.Thread]

  /**
   * Number of threads in the thread pool that are ready (finished initialization and ready to execute actions)
   */
  readyThreadCount: property(): !int

  /**
   * Wait until all initial threads in the thread pool are initialized. Return true if there are
   * initialThreads number of threads available in the thread pool before the timeout hits,
   * otherwise return false.
   * If timeout is not specified, will use a default timeout of 5 minutes.
   */
  waitForInitialThreads: member function(timeout: string serialized Duration = "5min"): !boolean

  /**
   * Return whether the thread pool is healthy, i.e. whether the # of initialized threads
   * (that are ready to take actions) >= minThreads
   */
  isHealthy: property(): !boolean

  /**
   * Return the last 10 errors that occurred during a thread's initialization or teardown.
   */
  errors: property(): [Error]

  /**
   * The status of the thread pool.
   *
   * {@link App.Node.ThreadPool} is considered
   * STARTING: When thread(s) are created, but there are less than {@link App.Node.ThreadPool.Config#minThreads} healthy threads.
   * HEALTHY: There are more or equal than {@link App.Node.ThreadPool.Config#minThreads} healthy threads.
   * UNHEALTHY: There are less than {@link App.Node.ThreadPool.Config#minThreads} healthy threads, due to occurred {@link #errors}.
   * STOPPED: When no internal components were initialized.
   *
   * @see #isRunning
   * @see #isHealthy
   * @see #errors
   * @see App.Node.ThreadPool.Config
   */
  state: property(): !string enum("STARTING", "UNHEALTHY", "HEALTHY", "STOPPED")

  /**
   * Constructs a user-friendly message that explains the status and potential reasons for the unhealthiness of {@link App.Node.ThreadPool}.
   *
   * @return A user-friendly, explanatory message or null if {@link App.Node.ThreadPool} is healthy.
   *
   * @see #state
   * @see #isRunning
   * @see #isHealthy
   * @see #errors
   */
  unhealthyHint: member function(): ?string

  /**
   * This supports {@link #name} as well as {@link #id}.
   */
  fromString: ~ java

  /**
   * @return regex pattern to validate ID. Should be <App.Node.id>[<name>],
   *        where <App.Node.id> is the id of the App.Node where this thread pool is hosted, and <name> is the name of the thread pool.
   */
  regexPatternForId: private cached function(): @java(class='java.util.regex.Pattern') !native

  /**
   * Return a Data of an array of {@link App.Node.Thread.Info} of the {@link App.Node.Thread threads} in
   * this {@link App.Node.ThreadPool}.
   * If there is no thread in this thread pool, return null.
   */
  summarizeThreads: member function(): Data
}
