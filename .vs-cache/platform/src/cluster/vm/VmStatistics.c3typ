type VmStatistics {

  nodeId:          string
  instanceId:      string
  nodeType:        string
  startTime:       datetime
  endTime:         datetime
  periodSeconds:   int
  cpuUtilization:  [VmStatsData]
  readThroughput:  [VmStatsData]
  writeThroughput: [VmStatsData]
  readIOPS:        [VmStatsData]
  writeIOPS:       [VmStatsData]
  networkInBytes:  [VmStatsData]
  networkOutBytes: [VmStatsData]
}
