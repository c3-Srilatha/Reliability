type VmInstance mixes AzureVirtualMachineFields {

  instanceId:         !string
  instanceType:       string
  hostName:           string
  launchTime:         string
  vmState:            string
  tags:               map<string, string>
  imageId:            string
  publicDnsName:      string
  publicIpAddress:    string
  privateDnsName:     string
  privateIpAddress:   string
  subnetId:           string
  vpcId:              string
  lifecycle:          string
  rootDeviceType:     string
  architecture:       string
  platform:           string
  availabilityZone:   string
  keyName:            string
  securityGroupIds:   [string]
  securityGroupNames: [string]
  ebsVolumeIds:       [string]
  isLowPriority:      inline member function(): boolean
}
