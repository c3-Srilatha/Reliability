/**
 * Lambda based {@link App.NodePool} scaling strategy
 */
private type App.NodePool.AutoScaleStrategy.Lambda mixes App.NodePool.AutoScaleStrategy.CronJob {

  /**
   * The lambda function that returns the target node count for the given {@link App.NodePool.AutoScaleStrategy.Lambda}
   * The execution of the lambda should finish within the given {@link #timeout}
   *
   * It's possible to pass other arguments to the lambda (e.g. an engine) by using the {@link Lambda#partiallyApply}.
   */
  scalingLambda: !lambda(strategy: !App.NodePool.AutoScaleStrategy.Lambda): !int32

  /**
   * The timeout for the {@link #scalingLambda} execution.
   * If not specified, the default {@link TimeoutSpec} will be used.
   */
  timeoutSpec: TimeoutSpec
}
