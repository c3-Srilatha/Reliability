/**
 * Fields common to every App.
 */
abstract type AppFields mixes Taggable {

  // Display label for App
  label: string

  /*
   * The C3 package deployed in an app.
   * It may not be specified which suggests that the user wants to start an app without any pkg.
   * Depending on the {@link AppMode}, a default pkg will be chosen if an action is performed in this app.
   * @see pkg
   */
  rootPkg: string

  /*
   * The semantic version of the C3 package deployed in an app.
   * It may not be specified which suggests that the user wants to start an app with a rootPkgVersion == serverVersion
   * (MajorMinorPatch only) of its env.
   * @see rootPkg
   */
  rootPkgVersion: string serialized SemanticVersion

  /**
   * This defines what pkg contents are available for App and how pkg content can modified. see {@link AppMode} options.
   */
  mode: string enum AppMode
}
