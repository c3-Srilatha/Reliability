type JavaToC3TypeMeta mixes Spec {

  /**
   * The methods in the class to exclude. Format is <Class>.<method> eg. Subnet.getAz
   */
  excludeMethods: [string]

  /**
   * Canonical name of classes/interfaces to ignore while generating the C3 type. Also supports regex.
   */
  excludeReferences: [string]

  /**
   * Specifies the mapper type to use for mapping the field. `C3.typesThatMixin(JavaToC3FieldMapper.myType())` gives the
   * list of mappers
   */
  mapperType: string

  /**
   * C3 type name
   */
  c3TypeName: !string
}
