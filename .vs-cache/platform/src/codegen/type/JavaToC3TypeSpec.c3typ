type JavaToC3TypeSpec mixes Spec {

  /**
   * Java class to map
   */
  className: !string

  /**
   * Type sub path under which the c3typ is written. e.g subPath = aws will write the type under
   * /repo/server/platform/src/aws
   */
  subPath: !string

  classMeta: JavaToC3TypeMeta
}
