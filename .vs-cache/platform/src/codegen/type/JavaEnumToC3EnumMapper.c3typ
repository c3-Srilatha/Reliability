/**
 * JavaEnumToC3EnumMapper helps to extract java enum labels and create a C3 enum type. The mapper is also responsible
 * for runtime conversion between c3 enum string and java enum object.
 */
type JavaEnumToC3EnumMapper mixes JavaToC3EnumMapper {

  c3FieldTypes: ~
  toJava:       ~
  fromJava:     ~
  canMap:       ~
}
