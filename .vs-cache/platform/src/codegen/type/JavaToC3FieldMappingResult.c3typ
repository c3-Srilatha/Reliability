type JavaToC3FieldMappingResult mixes Result {

  /**
   * fields mapped from the java class
   */
  fieldTypes: [FieldType]

  /**
   * canonical names of new references found in the java class
   */
  // TODO: set<string>
  newReferences: [string]

  /**
   * unresolvable arguments/return types. Pair of field name and method name.
   */
  unresolved: [Pair<string, string>]
}
