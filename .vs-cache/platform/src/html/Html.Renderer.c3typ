/**
 * Rendering of Hypertext Markup Language (HTML) content.
 *
 * @see Html
 */
type Html.Renderer mixes HtmlRenderer, StringSerializable {

  /**
   * The HTML to be rendered.
   */
  value: string serialized Html

  menuTitle:  ~ java | js | py
  render:     ~ js
  fromString: ~ java | js | py
  toHtml:     ~ java | js | py
  toString:   ~ java | js | py
}
