/**
 * Type to parse and validate Hypertext Markup Language (HTML) content.
 *
 * @see https://en.wikipedia.org/wiki/HTML
 */
type Html mixes StringSerializable, HtmlRenderable {

  /**
   * The contents when boxing a block of HTML.
   */
  value: string serialized Html

  /**
   * Extracts DOM element value from given html string.
   *
   * @param html
   *           HTML string.
   *
   * @param selector
   *           HTML/CSS selector, e.g, input[name=email].
   *
   * @return null string if not a valid html or extraction failure.
   */
  elementValue: function(html: !string, selector: !string): string

  /**
   * Sanitize HTML to prevent XSS attacks.
   *
   * @param dirtyHtml
   *           HTML string.
   *
   * @return sanitized HTML.
   */
  sanitize: function(dirtyHtml: !string): string

  renderer:   ~ java | js | py
  fromString: ~ java | js | py
  toString:   ~ java | js | py
}
