/**
 * Render an array of renderers in a grid layout
 */
type MultiplexRenderer mixes HtmlRenderer {

  /**
   * Instantiate with a list of renderables or built renderers. There must be at least two elements in the array.
   */
  create: inline function(renderables: ![HtmlRenderable | HtmlRenderer]) js

  m_embed:   private [HtmlRenderer]
  menuTitle: ~ js-client
  title:     ~ js-client
  render:    ~ js-client
  dispose:   ~ js-client
}
