/**
 * A spec for requesting available versions of {@link WithSemanticVersion}s in a {@link SemanticVersionRange}.
 */
type SemanticVersionRangeFilterSpec {

  /**
   * A map of {@link WithSemanticVersion.name}s to Semantic Version ranges to filter by.
   * ```
   * {
   *    "platform": "8.1",
   *    "foundation": "8.1"
   * }
   * ```
   */
  ranges: map<string, string serialized SemanticVersionRange>
}
