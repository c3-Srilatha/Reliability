/**
 * A spec for recursively resolving exact dependency versions for {@link WithDependencies}.
 */
type DependencyResolutionSpec mixes SemanticVersionRangeFilterSpec {

  /**
   * A map of {@link WithDependencies.name}s to Semantic Version ranges which can be used as viable dependencies.
   * ```
   * {
   *    "platform": "8.1",
   *    "foundation": "8.1"
   * }
   * ```
   */
  ranges: ~

  /**
   * Whether or not to include versions backwards compatible to the requirements in the rest of the
   * spec.
   */
  includeBackwardsCompatible: boolean

  /**
   * Versions of dependencies that should be chosen during resolution no matter what.
   */
  preResolvedVersions: map<string, string serialized SemanticVersion>

  /**
   * List of versions available by default.
   */
  defaultAvailableVersions: [WithResolvableDependencies]
}
