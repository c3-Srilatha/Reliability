/**
 * Represents the vector/text similarity search performance tuning parameters for the HNSW index.
 */
type Db.Index.Hnsw.SimilaritySearchPerfParams mixes Db.Index.SimilaritySearchPerfParams {

  /**
   * This parameter specifies the size of the dynamic list of candidate neighbors during the nearest neighbor search
   * process. A larger value of EfSearch can improve the quality of search results but may also increase search time and
   * memory usage.
   */
  efSearch: !int
}
