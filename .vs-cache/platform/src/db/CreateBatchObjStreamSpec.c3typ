/**
 * Controls various aspects of the {@link Persistable#createBatchObjStream} operation.
 */
type CreateBatchObjStreamSpec mixes UpsertSpec {

  /**
   * If true, the objs will be present in the returned ObjList and not otherwise.  Since the size of the incoming
   * stream is unbounded, the default is false.
   */
  includeObjsInResults: boolean
}
