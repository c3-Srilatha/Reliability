/**
 * ChangeLogListener for db engine
 */
type DbChangeLogListener mixes ChangeLogListener<DbChangeLogInfo>, Value {

  shouldLog: ~
  logInfo:   ~

  /**
   * Gets the backward deps that will be invalidated based on the change log queue entry.
   *
   * @param entry
   *        Change log queue entry to be used to evaluate the affected backward dependencies.
   *
   * @return the backward deps that will be invalidated based on the provided change log queue entry.
   */
  bwdDeps: function(entry: !ChangeLogQueueEntry): !ChangeLogBwdDeps

  mergeEntries: ~
}
