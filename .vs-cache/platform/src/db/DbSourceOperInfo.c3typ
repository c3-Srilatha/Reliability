/**
 * Info about the source upsert operation
 */
type DbSourceOperInfo {

  /**
   * Source operation
   */
  sourceOper: !string enum DbSourceOper

  /**
   * Upsert spec for upsert operation causing the changes.
   */
  upsertSpec: UpsertSpec
}
