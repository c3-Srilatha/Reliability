/**
 * Status for a single Db.Engine instance.
 */
type Db.Engine.Status {

  /**
   * Time status request was made
   */
  currentTime: !datetime

  /**
   * Appid for the processor
   */
  appId: string

  /**
   * Node id
   */
  serverNodeId: string

  /**
   * Processor was started
   */
  isStarted: boolean

  /**
   * Db.Engine instance is currently running
   */
  isRunning: boolean

  /**
   * Db.Engine instance has been terminated
   */
  isTerminated: boolean

  /**
   * Server is currently running
   */
  isServerRunning: boolean

  /**
   * Instance is current Db.Engine instance
   */
  isCurrent: boolean

  /**
   * @true if the node is a leader node
   */
  isLeaderNode: boolean

  /**
   * @true if the node is a task node
   */
  isTaskNode: boolean

  /**
   * Keys in the internal datastore map
   */
  datastoreKeys: [string]

  /**
   * Timestamp when main processing loop was started
   */
  monitoringStarted: datetime

  /**
   * Timestamp when main processing loop terminated
   */
  monitoringTerminated: datetime

  /**
   * What caused the processing to be terminated
   */
  monitoringTerminatedCause: string

  /**
   * Timestamp of last pass through monitor loop
   */
  lastMonitored: datetime

  /**
   * Timestamp of last termination of blocked statements
   */
  lastTerminatedBlockedStmts: datetime

  /**
   * Timestamp of last call to {@link DbLockDoctor#recover}
   */
  lastDbLockDoctorRecover: datetime

  /**
   * Timestamp of last call to {@link InvalidationQueue#recoverStuck}
   */
  lastRecoverStuck: datetime

  /**
   * Timestamp of last call to {@link Cron.Processor.syncJobs}
   */
  lastCronSyncJobs: datetime

  /**
   * Timestamp of last time cron jobs that were specified to `runOnLeader` were run
   */
  lastCronRunOnLeaderJobs: datetime

  /**
   * Last error message encountered by processing loop
   */
  lastErrorMsg: string

  /**
   * Stack trace of last reported error
   */
  lastErrorStackTrace: string

  /**
   * Timestamp when last error was reported
   */
  lastErrorReportedAt: datetime

  /**
   * Status of the {@link InvalidationQueue.Processor}
   */
  queueProcessorStatus: InvalidationQueue.Processor.Status
}
