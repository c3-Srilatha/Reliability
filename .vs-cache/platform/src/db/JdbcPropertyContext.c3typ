/**
 * All source of information for setting Jdbc property.
 */
private type JdbcPropertyContext {

  /**
   * The name of the property
   */
  name: string

  /**
   * The final JDBC URL constructed from templates, credentials, and input config.
   */
  url: string

  /**
   * Credential fields such as database, schemaName, etc.
   */
  creds: JdbcCredentialsFields

  /**
   * The JDBC driver and connection specification, including driver info and datastore metadata.
   */
  spec: JdbcConnectSpec

  /**
   * User-supplied and system-evaluated configuration for the JDBC store.
   */
  cfg: JdbcStoreConfig

  /**
   * The fully resolved set of properties to be used when initializing the JDBC connection.
   */
  props: map<string, any>

  /**
   * Returns the resolved secret key associated with this connection from credentials and connect spec
   */
  secretKey: private member function(): string

  /**
   * If the property exists in Jdbc url or jdbc property map.
   */
  exist: private member function(): boolean

  /**
   * Determines if the authentication scheme is OAuth based on properties or JDBC URL.
   */
  isAuthSchemeOAuth: private member function(): boolean

  /**
   * Determines if the authentication scheme is OAuthJWT based on properties or JDBC URL.
   */
  isAuthSchemeOAuthJwt: private member function(): boolean

  /**
   * Returns the native private key by fetching the nativePrivateKey from the privateKeyAuth.
   */
  privateKey: private member function(): @java(class="java.security.PrivateKey") native
}
