/**
 * Defines the set of configurable JDBC properties for a specific SQL engine,
 * including metadata and optional compatibility overrides.
 * Example:
 * {
 *   "InitiateOAuth": {
 *     "description": "Set this property to initiate the process to obtain or refresh the OAuth access token when you connect.",
 *     "required": false,
 *     "possibleValues": ["OFF", "GETANDREFRESH", "REFRESH"],
 *     "value": "OFF",
 *     "category": "OAuth"
 *   }
 * }
 */
type SqlEngine.PropertyInfo mixes Nameable {

  /**
   * A human-readable explanation of what the property does.
   */
  description: string

  /**
   * Whether this property is required for connection to succeed.
   */
  required: string serialized Expr

  /**
   * Whether this property is a secret.
   */
  secret: boolean

  /**
   * List of allowed values for this property, if applicable.
   */
  possibleValues: [string]

  /**
   * Logical category this property belongs to (e.g., "OAuth", "Connection").
   */
  category: string

  /**
   * An optional expression (e.g., "existInJdbcPropertyContext()") that computes the final value
   * for this property. If present, this will always override any existing value, including user-provided ones.
   */
  value: string serialized Expr

  /**
   * An optional expression (e.g., "secretKey()") that provides a fallback default value
   * to be used only if no value is supplied by the user or other logic.
   */
  default: string serialized Expr

  /**
   * An optional expression (e.g., "shouldDelete()") that evaluates
   * whether this property should be excluded from the final configuration.
   */
  delete: string serialized Expr

  /**
   * Whether this property should be placed in the JDBC url only.
   */
  urlOnly: boolean
}
