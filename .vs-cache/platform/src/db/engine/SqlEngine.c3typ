/**
 * Config of a specific sql engine
 * This defines the engine’s driver metadata, SQL behavior, and supported properties.
 */
// TODO: PLAT-118359: Turn doNotDefaultIfMissing into false after full migration
@config(doNotDefaultIfMissing=true)
type SqlEngine mixes Config, Named {

  /**
   * The unique name of the SQL engine (e.g., "servicenow", "databricks").
   */
  name: ~

  /**
   * SQL-related capabilities and behaviors specific to this engine,
   * such as support for EXPLAIN statements or offset handling rules.
   */
  sql: SqlEngine.SqlInfo

  /**
   * Driver-level configuration, including JDBC driver class name and URL patterns.
   */
  driver: SqlEngine.DriverInfo

  /**
   * Property definitions and customization rules for this engine,
   * including metadata, defaults, and backward compatibility adjustments.
   */
  properties: @indexed map<string, SqlEngine.PropertyInfo>

  /**
   * Checks whether the given engine name exists in the configured engine list.
   */
  exists: private cached function(engineName: string): boolean

  /**
   * Checks whether the underlying driver is based on CData.
   */
  isCDataBased: private cached function(engineName: string): boolean

  /**
   * Generates a full JDBC URL string using the provided connection parameters.
   * The format and inclusion of parameters may vary depending on the JDBC driver.
   */
  jdbcUrl: private member function(serverEndpoint: string, port: int, database: string, schemaName: string): string

  /**
   * Infers the SQL engine and returns the engine's name from the given connection URL.
   */
  guessEngineNameByUrl: private cached function(url: string): string

  /**
   * Infers the SQL engine and returns the engine's name from the given driver class name.
   */
  guessEngineNameByDriverName: private cached function(driverName: string): string

  /**
   * List all SqlEngine configs in order
   */
  allEngines: function(): [SqlEngine]
}
