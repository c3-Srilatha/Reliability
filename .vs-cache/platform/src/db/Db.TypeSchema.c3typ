/**
 * System type used to hold the latest fingerprint for a type.  Used to detect that schema changes are necessary due to
 * a type definition changing.
 */
@db(compactType=true, systemType=true, domain='system')
final private entity type Db.TypeSchema mixes Cached, InvalidationDisabled {

  // Fingerprint for the type
  typeFingerprint: int

  /**
   * Current saved fingerprint for the type.
   */
  fingerprintForType: inline function(type: !Type): int

  /**
   * Saves the new fingerprint for the type.
   */
  updateFingerprint: function(type: !Type, fingerprint: !int)

  /**
   * Id of the instance containing the fingerprint for the type.
   */
  idForType: cached inline function(type: !Type): string

  /**
   * Validates the schema (e.g. calls {@link Persistable#upsertCollection} for all relational entity types.
   *
   * @param checkFingerprints
   *        If true, then upsertCollection will only be called if it is detected that the fingerprint for the type
   *        doesn't match what the fingerprint was when upsertCollection was last called for the type.  If false, then
   *        it will be called for every type, regardless of the fingerprint matching or not.
   */
  validateSchemas: inline function(checkFingerprints: boolean)

  produce: ~
}
