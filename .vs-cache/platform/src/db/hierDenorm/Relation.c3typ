/**
 * Type containing fields to explain the relationship between vertices. Can also be considered as an edge in the graph
 */
type Relation<T> mixes RelationFields<T> {

  /**
   * From vertex for this edge
   */
  from: ~

  /**
   * To vertex for this edge
   */
  to: ~

  /**
   * Relationship between the from vertex and the to vertex. E.g. Edge-coloring problem where different edges between the
   * same nodes can have different colors a.k.a 'relationships'
   */
  relationship: ~

  /**
   * Additional info for the 'from' vertex can be stored here
   */
  fromInfo: ~

  /**
   * Additional info for the 'to' vertex can be stored here
   */
  toInfo: ~

  /**
   * Placeholder field. Not used in regular computation
   */
  involvement: ~
}
