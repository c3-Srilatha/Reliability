/**
 * Type used in the @denorm annotation which indicates the meta information about how to extract the relationships in data
 */
type DenormSource {

  /**
   * Edge type
   */
  source: Type

  /**
   * Field on Vertex's Type that points to edges of this source (EdgeType)
   */
  parentFieldName: string

  /**
   * Field on Vertex's Type that is pointed to by edges of this source (EdgeType)
   */
  childFieldName: string

  /**
   * Field on the Edge's Type that represents the start date of the edge
   */
  startFieldName: string

  /**
   * Field on the Edge's Type that represents the end date of the edge
   */
  endFieldName: string
}
