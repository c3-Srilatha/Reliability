/**
 * Type to be mixed when we have a timed graph structure that needs to be denormalized (flattened)
 * When using this type, the denorm annotation must have startFieldName and endFieldName.
 * e.g.
 * @denorm(sources=[DenormSource(source = TypeRef(typeName = 'PhysicalAssetHierarchyRelation'), parentFieldName = 'parentRelations', childFieldName = 'childRelations', startFieldName = 'start', endFieldName = 'end')])
 */
type TimedIntervalHierarchyDenorm<T> mixes HierarchyDenorm<T>, TimedIntervalValue
