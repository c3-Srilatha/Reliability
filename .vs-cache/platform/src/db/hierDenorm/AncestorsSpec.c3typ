/**
 * Defines a spec to fetch ancestors using the hierarchy denorm table
 */
type AncestorsSpec mixes Spec {

  /**
   * Relationship between the 'from' and the 'to' nodes
   */
  relationship: string

  /**
   * If set, we only return results whose 'name' _startsWith_ the search string
   */
  searchString: string

  /**
   * If true, include information about the node (E.g. 'fromInfo', 'toInfo')
   */
  includeInfo: boolean
}
