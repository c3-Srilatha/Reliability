/**
 * Option type passed during hierarchy denorm batch job. This contains properties about how the hierarchy needs to be
 * denormalized
 */
type HierarchyDenormOption {

  /**
   * Indicating if the hierarchy is a strict hierarchy
   */
  isStrict: boolean

  /**
   * Vertex type
   */
  vertexType: Type

  /**
   * Name of the field that refers to parents on vertexType
   */
  parentFieldName: string

  /**
   * Name of the field that refers to children on vertexType
   */
  childFieldName: string

  /**
   * Edge Type
   */
  edgeType: Type

  /**
   * Hierarchy Denorm Type on which denormalize hierarchy is called
   */
  hierarchyDenormType: Type

  /**
   * Specifies relationship between the edges. Null for strict hierarchies
   */
  relationship: string

  /**
   * Max number node (with lineage) in memory per schedule batch
   */
  batchWeight: int = 1000

  /**
   * Max number nodes allowed in a particular schedule batch
   */
  batchSize: int = 100

  /**
   * Ids of vertices that are in the working set for incremental denorm
   */
  workingSet: [string]

  /**
   * To specify whether it is incremental denorm or not
   */
  isIncremental: boolean

  /**
   * If there were any edges removed in this batch
   */
  edgesRemoved: boolean

  /**
   * Field on the Edge's Type that represents the start date of the edge
   */
  startFieldName: string

  /**
   * Field on the Edge's Type that represents the end date of the edge
   */
  endFieldName: string
}
