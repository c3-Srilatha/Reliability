/**
 * Config for HierarchyDenorm type to tune different properties influencing the Hierarchy denormalization.
 */
type HierarchyDenormConfig mixes Config, Identifiable {

  /**
   * Disable the Hierarchy De-normalization for the current type.
   */
  disabled: boolean

  /**
   * Specify the Invalidation batchsize for the hierarchy Denorm job
   */
  invalidationBatchSize: int

  /**
   * Max number node (with lineage) in memory per schedule batch for denormalization.
   * @see HierarchyDenormOption
   */
  scheduleBatchSize: int

  /**
   * Max number nodes allowed in a particular schedule batch for denormalization.
   *
   * @see HierarchyDenormOption
   */
  scheduleBatchWeight: int
}
