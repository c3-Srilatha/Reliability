/**
 * Used in {@link HierarchyDenormNode} to capture a node's parent and time interval
 */
type HierarchyDenormNodeParent mixes TimedIntervalValueHistory<HierarchyDenormNode> {

  /**
   * The parent node
   */
  parent: ~

  /**
   * The start time of the timed interval relation between the current node and the {@link parent} node
   */
  start: ~

  /**
   * The end time of the timed interval relation between the current node and the {@link parent} node
   */
  end: ~
}
