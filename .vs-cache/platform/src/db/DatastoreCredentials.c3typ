/**
 * Abstract type for datastore credentials
 */
abstract type DatastoreCredentials<C> mixes ConfigChild<C>, ConnectSpecInfoBase {

  /**
   * @return The tls specific properties to use with the connection.
   */
  tlsProperties: inline function(datastoreKind: !Datastore.Kind,
                                 configName: !string,
                                 sslMode: !TlsConnectionModeKind,
                                 datastoreType: !DatastoreType,
                                 tls: TlsCertificate): map<string, any>

  /**
   * Tls Certificate if the datastore associated with these credentials needs a secure connection to be accessed
   */
  certs: TlsCertificate

  /**
   * Validate the credential according to pre-seeded configs
   * Extract all JDBC parameters from JDBC url and put them into properties/ secret properties accordingly
   * @param failIfMissing
   *           If true, throw an error if the credentials miss the required fields
   * @return
   */
  preprocess: optional member function(failIfMissing: boolean): Pair<DatastoreCredentials, [string]>

  /**
   * Private key authentication for key-pair authentication with the datastore
   */
  privateKeyAuth: PrivateKeyAuth
}
