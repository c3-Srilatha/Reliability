/**
 * Adds additional controls to the {@link MergeSpec} for the {@link Persistable#mergeAll} operation.
 */
type MergeAllSpec mixes MergeSpec {

  /**
   * Filter expression that indicates which objs should be merged.  The filter expression may be an valid {@link FetchSpec#filter} expression.
   */
  filter: string
}
