/**
 * Return value for {@link Jdbc.listTableNames}.
 */
type JdbcListTableNamesResult {

  /**
   * Table names (unqualified) that were found via the jdbc connection.
   */
  names: [string]

  /**
   * Table names (qualified with schema) that were found via the jdbc connection.
   */
  qualifiedNames: [string]

  /**
   * Table names (unqualified) that were found via the jdbc connection, grouped by schema name.
   */
  namesBySchema: map<string, [string]>

  /**
   * If limit was specified > 0 and there were more table names to return than permitted by the limit, this will be
   * this will be true and will be false otherwise.
   */
  hasMore: boolean
}
