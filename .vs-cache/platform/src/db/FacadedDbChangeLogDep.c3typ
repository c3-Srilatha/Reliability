/**
 * Backward dep info for a FacadedDbChangeLogInfo
 */
type FacadedDbChangeLogDep {

  /**
   * Boundary node from the original facaded app.  Used by the facading app to get the affected target objs.
   */
  boundaryNode: !TypeBackwardDepNode

  /**
   * Target id field to filter on.
   */
  keyField: string

  /**
   * If not empty, list of affected fields in the target type for the dep.
   */
  targetFields: [string]
}
