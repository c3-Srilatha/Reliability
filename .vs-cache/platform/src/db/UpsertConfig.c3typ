@config(minOverride=APP, maxOverride=APP)
type UpsertConfig mixes Config {

  /**
   * If false, then during updates, if no values have changed, other than `meta.updated`, then the update operation will
   * be a no-op and the new `meta.updated` will not be retained.  If true, then the obj will be updated with the new
   * `meta.updated` value in this case.
   */
  retainLatestTimestamp: boolean
}
