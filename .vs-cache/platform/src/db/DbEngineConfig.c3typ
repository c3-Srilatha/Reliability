/**
 * Configuration for Db engine.
 */
@config(minOverride=APP, maxOverride=CLUSTER)
type DbEngineConfig mixes Config {

  /**
   * True if we should save the stack trace when tracking open iterators.
   */
  saveOpenIteratorsStackTrace: boolean

  /**
   * True if sql should be suppressed from any errors thrown by the database
   */
  hideSqlErrors: boolean

  /**
   * Frequency to log various database/query statistics.
   */
  statsLoggingFrequencySeconds: int = 60

  /**
   * Frequency to run the monitor loop.
   */
  monitorLoopFrequencySeconds: int = 60

  /**
   * The monitor loop sweeps for blocked PG statements.  This is the frequency that the check will be made.
   */
  blockedPgStmtTerminateFrequencyMinutes: int32 = 30

  /**
   * The monitor loop sweeps for blocked PG statements.  During that sweep, any statements that have been blocked longer
   * than this will have their connection terminated.
   */
  blockedPgStmtTerminateThresholdMinutes: int = 10
}
