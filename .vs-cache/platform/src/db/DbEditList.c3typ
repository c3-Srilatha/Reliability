/**
 * Wrapper for EditList used throughout the db engine
 */
type DbEditList {

  /**
   * Edit list being wrapped
   */
  @deprecated
  editList: EditList

  /**
   * Edited field paths.
   */
  fieldPaths: ![string]

  /**
   * Id corresponding to Obj for editList.
   */
  id: !string

  /**
   * For extendable types only, the typeIdent associated with the Obj for the editList
   */
  typeIdent: string

  /**
   * For Cassandra types with partition keys only, the partition key associated with the Obj for the editList.
   */
  partitionKey: string

  /**
   * For TimedCharacteristicHistory and TimedIntervalCharacteristicHistory types, the characteristic name
   * associated with the Obj for the editList.
   */
  characteristicName: string
}
