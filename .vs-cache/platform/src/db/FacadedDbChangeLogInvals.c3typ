/**
 * Invalidations for `FacadedDbChangeLog`.
 */
private type FacadedDbChangeLogInvals {

  /**
   * Id of app where invalidations should be sent to
   */
  appId: string

  /**
   * Invalidations for the CalcFieldsQueue
   */
  calcDeps: private @java(class="c3.platform.typesys.value.col.ArrayTable<String, String, FacadedDbChangeLogDep>") !?native

  /**
   * Invalidations for the PopulateAclQueue
   */
  aclDeps: private @java(class="c3.platform.typesys.value.col.ArrayTable<String, String, FacadedDbChangeLogDep>") !?native

  /**
   * Invalidations for the MetricDepsQueue
   */
  metricDeps: private @java(class="c3.platform.typesys.value.col.ArrayTable<String, String, FacadedDbChangeLogDep>") !?native

  /**
   * Current number of invalidations that need to be pushed to the ChangeLogQueue for
   */
  numInvals: @java(class="java.util.concurrent.atomic.AtomicLong") native

  /**
   * Creates/initializes instance for the app
   */
  init: function(appId: !string): FacadedDbChangeLogInvals

  /**
   * Adds a dependency to be invalidated for the app
   *
   * @param invalSrcType
   *        Name of type in facading app that will be invalidated
   * @param invalSrcId
   *        Id in facading app that will be invalidated
   * @param queueType
   *        Queue type that the invalidation is ultimately intended for
   * @param boundaryNode
   *        Node in the dependency that is the first node in the facaded app (e.g. data lake).  Prior nodes will be in
   *        the facading app
   * @param targetFields
   *        Target fields that will ultimately be invalidated
   * @param fkeyField
   *        If not empty, the fkey field for the boundary node
   */
  addDep: member function(invalSrcType: !string,
                          invalSrcId: !string,
                          queueType: !Type,
                          boundaryNode: !TypeBackwardDepNode,
                          targetFields: ![string],
                          fkeyField: string)

  /**
   * Performs the invalidations (e.g. creates ChangeLogQueue entries) in the appropriate app
   */
  invalidate: member function()
}
