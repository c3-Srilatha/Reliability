type JdbcStore mixes SqlStore<JdbcConnectionPool, JdbcStoreConfig, JdbcCredentials> {

  /**
   * @return the credentials for the user and datastore (including secrets).  Note that retrieving the secrets requires
   *         cluster-admin authz.
   */
  fullCredentials: private member function(): JdbcCredentials

  /**
   * @return the user credentials for the datastore (if any).  Note that retrieving the secrets requires cluster-admin
   *         authz.
   */
  userCredentials: private member function(): UserJdbcCredentials

  closeSslSocketFactory:  private member function()
  canShareReadConnection: ~
  prepConnForReturn:      ~
  poolKey:                ~
  config:                 ~
}
