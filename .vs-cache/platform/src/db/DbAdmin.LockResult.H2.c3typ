/**
 * Result row returned from {@link DbAdmin.getLocks}.
 */
type DbAdmin.LockResult.H2 mixes DbAdmin.LockResult {

  /**
   * Type of lock
   */
  lockType: string

  /**
   * Schema name
   */
  schemaName: string

  /**
   * Table name lock is for.
   */
  tableName: string

  /**
   * Process id owning the lock.
   */
  sessionId: int

  /**
   * Client ip address of lock owner.
   */
  clientAddr: string

  /**
   * Client info of lock owner.
   */
  clientInfo: string
}
