/**
 * Info for a ChangeLogEntry for the DbChangeLogListener
 */
type DbChangeLogInfo {

  /**
   * Edit list containing the data that changed.
   */
  editList: !DbEditList

  /**
   * True if the self dependencies (e.g. dependencies where the source/target objs are the same) for stored calcs are
   * being ignore for this operation.
   */
  ignoreStoredCalcSelfDeps: boolean
}
