/**
 * Info for a ChangeLogEntry for the FacadedDbChangeLogListener
 */
type FacadedDbChangeLogInfo {

  /**
   * Calc field backward deps to be processed.
   */
  calcDeps: [FacadedDbChangeLogDep]

  /**
   * Acl backward deps to be processed.
   */
  aclDeps: [FacadedDbChangeLogDep]

  /**
   * Metric dep backward deps to be processed.
   */
  metricDeps: [FacadedDbChangeLogDep]
}
