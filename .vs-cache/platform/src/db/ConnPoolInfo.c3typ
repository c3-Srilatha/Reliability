/**
 * Result row returned from {@link DbAdmin.getDbConnConnPoolInfo}.
 */
type ConnPoolInfo {

  /**
   * Key uniquely identifying the pool
   */
  key: string

  /**
   * Number of current active (e.g. borrowed) connections
   */
  numActive: !int

  /**
   * Number of idle connections in the pool
   */
  numIdle: !int

  /**
   * Maximum combined total of active/idle connections.
   */
  maxTotal: !int

  /**
   * Maximum number of idle connections in the pool.
   */
  maxIdle: !int

  /**
   * Minimum number of idle connections maintained in the pool.
   */
  minIdle: !int

  /**
   * Maximum amount of time to wait for an available connection before throw an exception.
   */
  maxWaitMillis: !int

  /**
   * Minimum amount of time a connection will be idle before it can be evicted.
   */
  minEvictableIdleTimeMillis: int
}
