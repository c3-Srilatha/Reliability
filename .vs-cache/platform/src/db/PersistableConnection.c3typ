/**
 * Wrapper type for a C3 java connection.
 */
private type PersistableConnection {

  /**
   * C3 java connection
   */
  conn: !native

  /**
   * If true, the connection is owned by the calling action.  If false, it is a shared connection from a parent
   * action.
   */
  ownedByAction: boolean

  /**
   * Releases a connection obtained from {@link PersistableConnectable.connection}.
   */
  release: private inline member function()
}
