/*
 * A B-tree index creates a multi-level tree structure that breaks a database down into fixed-size blocks or pages.
 * Each level of this tree can be used to link those pages via an address location, allowing one page (known as a
 * node, or internal page) to refer to another with leaf pages at the lowest level. One page is typically the starting
 * point of the tree, or the "root". This is where the search for a particular key would begin, traversing a path that
 * terminates in a leaf. Most pages in this structure will be leaf pages which ultimately refer to specific table rows.
 */
type Db.Index.BTree mixes Db.Index {

  method: ~ = B_TREE
}
