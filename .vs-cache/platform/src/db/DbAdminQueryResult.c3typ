type DbAdminQueryResult {

  /**
   * The first Tuple in results will be the column names returned by the query
   *
   * and the remaining Tuples will be the data rows returned from the result
   * set.
   */
  results: [CellTuple]

  /**
   * Set to true if the row limit has been reached and there are remaining
   * rows in the result set.
   */
  hasMore: boolean
}
