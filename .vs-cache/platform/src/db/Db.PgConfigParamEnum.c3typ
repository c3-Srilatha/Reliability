/**
 * Enum for the Pg configuration
 */
enum type Db.PgConfigParamEnum {

  // hnsw.ef_search specifies the number of vectors to examine in order to find the top k nearest neighbors for hnsw index
  HNSW_EF_SEARCH = "hnsw.ef_search"

  // ivfflat.probes defines how many clusters (inverted lists) are checked during the search process for ivfflat index .
  IVFFLAT_PROBES = "ivfflat.probes"
}
