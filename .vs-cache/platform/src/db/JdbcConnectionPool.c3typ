/**
 * Generic object pool
 */
type JdbcConnectionPool mixes ObjectPool<native> {

  /**
   * Borrows a connection from the pool.
   */
  borrowConnection: inline member function(): @java(class="java.sql.Connection") native

  /**
   * Returns a connection to the pool.
   *
   * @param connection
   *        Connection to return.
   */
  returnConnection: inline member function(connection: @java(class="java.sql.Connection") native)

  /**
   * Destroys a connection rather than returning it to the pool.
   *
   * @param connection
   *        Connection to destroy.
   */
  destroyConnection: inline member function(connection: @java(class="java.sql.Connection") native)

  initForDs: ~
}
