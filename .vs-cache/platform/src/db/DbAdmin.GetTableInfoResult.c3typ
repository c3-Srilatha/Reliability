/**
 * Result row returned from {@link DbAdming.getTableInfo}.
 */
type DbAdmin.GetTableInfoResult {

  /**
   * Table name.
   */
  tableName: string

  /**
   * Number of tuples in the table.
   */
  numTuples: double

  /**
   * Disk space used by the table itself (units included in the value).
   */
  tableSize: string

  /**
   * Disk space used by the table and all indexes defined on it (units included in the result).
   */
  totalSize: string
}
