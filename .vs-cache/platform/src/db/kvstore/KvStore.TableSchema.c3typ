/**
 * Schema info for a kv store table
 */
type KvStore.TableSchema mixes SchemaInfo {

  /**
   * name of the database e.g. keyspace in cassandra (may be empty for other kv stores e.g. InMemoryKvStore)
   */
  databaseName: string

  /**
   * Name of the table e.g. column family in cassandra
   */
  tableName: !string
}
