/**
 * Cache for in-memory kv store items
 * key: tablename
 * values: map<string, map<string,any>>
 */
type InMemoryKvStoreCache mixes Cached {

  /**
   * values for the given table in the in memory cache
   * key: id
   * value: columns (key-value)
   */
  values: private MapBuilder<string, MapBuilder<string, any>>
}
