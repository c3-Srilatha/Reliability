private type MigrateColdDataSpec mixes Spec {

  /**
   * Where to move the cold data files to. If not set, will use the default filesystem mount.
   */
  destDir: string

  /**
   * If true, will only modify the reference to the cold storage locations, and will not move the files.
   */
  changeColdPtrOnly: boolean

  /**
   * If true, will delete the old cold data files after moving them to the new location.
   */
  deleteExistingColdFiles: boolean
}
