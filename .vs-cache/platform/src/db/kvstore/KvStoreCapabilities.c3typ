/**
 * Capabilities of a {@link KvStore}.
 */
type KvStoreCapabilities mixes Spec {

  /**
   * If set then data for key value store will only persist in this node.
   */
  singleNode: boolean

  /**
   * Maximum object count key value store should hold.
   */
  maxSize: int
}
