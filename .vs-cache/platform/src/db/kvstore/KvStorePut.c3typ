/**
 * Type to hold information about the column
 */
type KvStorePut mixes KvStorePutSpec {

  /**
   * id of the row to put data into
   */
  id: !string

  /**
   * Map of columns to be updated with key as column name / namespaced column name
   * and value as the value to be inserted into the column
   */
  updatedColumns: map<string, any>

  /**
   * Array of column names/ namespaced column names to be removed from the row
   */
  removedColumns: set<string>
}
