/**
 * Indicates specification on how get batch is performed
 */
@beta
type KvStoreAsyncGetSpec mixes Spec {

  /**
   * If true, execute cql query asynchronously. This may be faster if CPU is not overloaded.
   */
  async: boolean

  /**
   * Batch size for get query which determines the number of ids in one query. -1 disables batching.
   */
  batchSize: int = -1
}
