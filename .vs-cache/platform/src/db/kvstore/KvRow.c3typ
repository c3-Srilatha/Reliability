/**
 * Represents single key value store row
 */
type KvRow mixes KvRowMeta {

  /**
   * Kv row id
   */
  id: !string

  /**
   * column values for the given row
   */
  cols: [KvCol]

  /**
   * Tracing / debugging info regarding this queried row
   */
  plan: KvRowExplainPlan

  /**
   * Get column value for the given column
   */
  col: inline member function(name: !string): any

  /**
   * @return cols in the KvRow by name
   */
  colsByName: inline member function(): map<string, any>

  /**
   * Construct KvRow from id and columns by name
   */
  fromIdAndColsByName: inline function(id: !string, colsByName: map<string, any>): !KvRow

  /**
   * @return an array of KvContent instances from this KvRow, of which each KvContent is from each KvCol.
   */
  toContents: member function(): [KvContent]
}
