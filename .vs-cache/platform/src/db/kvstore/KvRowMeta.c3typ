/**
 * The meta fields of the {@link KvRow}. These fields can extracted from the KvRow without having to read the KvRow.
 */
type KvRowMeta {

  /**
   * table associated with the content
   */
  tableName: !string

  /**
   * rowId associated with the content
   */
  rowId: !string

  /**
   * store associated with the content
   */
  store: !KvStore
}
