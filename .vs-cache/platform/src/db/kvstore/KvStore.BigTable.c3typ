/**
 * Uses Google BigTable as a KvStore. History of data is not preserved.
 */
type KvStore.BigTable mixes KvStore<BigTableConfig> {

  /**
   * Client that provides APIs for reading and writing data to tables
   */
  dataClient: private cached member function()
                                      : @java(class='com.google.cloud.bigtable.data.v2.BigtableDataClient') !native

  /**
   * Client that provides APIs for creating tables and deleting tables
   */
  adminClient: private cached member function()
                                       : @java(class='com.google.cloud.bigtable.admin.v2.BigtableTableAdminClient') !native
}
