/**
 * Holds properties to determine how to write objs for a given {@link DataPartition}
 */
type DataPartitionWriteSpec mixes PartitionBucketStrategy {

  /**
   * If set, default merge strategy is applied while merging objects. In order to specify a custom merge strategy, set
   * {@link mergeLambda}
   */
  merge: boolean

  /**
   * If specified, uses this lambda function to merge existing objects in partition with the new objects. If not specified,
   * default merge strategy will be chosen
   */
  mergeLambda: lambda(existing: stream<Partitionable>, objs: stream<Partitionable>): stream<Partitionable>
}
