type KvStoreScanSpec mixes KvStoreGetSpec {

  /**
   * Offset to use for paged reads.
   */
  offset: int = 0

  /**
   * Total number of elements to scan. Use -1 for no limit.
   * The meaning of an element depends on the underlying database. For Cassandra see {@link Cassandra#scan}.
   */
  limit: int = -1

  /**
   * Internal limit for reading columns from kv rows
   */
  kvColLimit: private int = -1

  /**
   * If true, KvRows will be constructed with IDs only and no data will be read. This is set by passing an
   * include string with just 'id'.
   */
  idOnly: inline property(): boolean

  batchSize: ~ = 10
}
