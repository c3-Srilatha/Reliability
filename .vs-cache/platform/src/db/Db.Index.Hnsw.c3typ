/*
 * Hnsw index is used for approximate nearest neighbor search (ANN). Hierarchical Navigable Small Worlds (HNSW)
 * is a graph-based index that combines the advantages of skip lists and navigable small worlds.
 * HNSW is a good choice for applications that require high speed and good accuracy.
 * It is also a good choice for applications where the vectors are high-dimensional, but
 * that it has large memory usage.
 */
type Db.Index.Hnsw mixes Db.Index {

  method: ~ = HNSW

  /**
   * This parameter specifies the maximum number of edges per node in the graph structure. It influences the
   * connectivity of the graph and affects the trade-off between search accuracy and efficiency.
   */
  @constraint(condition="neighborsCount >= 1")
  neighborsCount: int = 16

  /**
   * This parameter controls the size of the dynamic list of candidate neighbors during the index construction process.
   * A larger value of EfConstruction generally leads to better quality indexes but requires more computational
   * resources during construction.
   */
  @constraint(condition="efConstruction >= 2 * neighborsCount")
  efConstruction: int = 64
}
