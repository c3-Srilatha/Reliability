/**
 * Used to collect table access statistics for db operations for "root" actions.  The "root" action is the
 * highest parent action that isn't an {@link InvalidationQueue.compute} action.
 */
type DbAccessListener {

  /**
   * Type name for the action being logged for.
   */
  typeName: !string

  /**
   * Action being logged for.
   */
  action: !string

  /**
   * Map of entries containing statistics about each table accessed.
   */
  tablesAccessed: map<string, DbAccessListenerEntry>

  /**
   * Logs the statistics for a table access operation on the "root" action.
   *
   * @param appId
   *        App that accessed the table.
   * @param tableName
   *           Table that was accessed.
   * @param datastoreName
   *        Name of the datastore the table was accessed in.
   * @param datastoreKind
   *        The kind of datastore the table was accessed in.
   * @param count
   *        Number of times the table was accessed
   * @param read
   *        True if the operation was a read operation.  False if it was an update operation.
   * @param timeMillis
   *        Time spent by the operation.
   */
  logOperation: inline function(appId: !string,
                                tableName: !string,
                                datastoreName: !string,
                                datastoreKind: !string,
                                count: !int,
                                read: !boolean,
                                timeMillis: !int)

  /**
   * Generates the messages that will be logged at the end of the operation.
   */
  generateLogMsgs: inline member function(): [string]
}
