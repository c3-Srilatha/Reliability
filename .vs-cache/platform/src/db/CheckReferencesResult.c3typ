/**
 * Result type for the {@link Persistable#checkReferences} function.
 */
type CheckReferencesResult {

  /**
   * Only used for  identifying test results for verification.  Otherwise, not used by the system at all.
   */
  id: string

  /**
   * Detailed results for the request.  Each entry will contain the details for one reference field path.
   */
  details: [CheckReferencesDetail]
}
