/**
 * Parameter values to set in {@link DbAdmin.setAutoVacuumParameters}.  See
 * https://www.postgresql.org/docs/10/runtime-config-autovacuum.html for details for each parameter.
 */
type DbAdmin.SetAutoVacuumParametersSpec {

  autovacuum_vacuum_scale_factor:  double = 0.0
  autovacuum_vacuum_threshold:     int = 10000
  autovacuum_analyze_scale_factor: double = 0.0
  autovacuum_analyze_threshold:    int = 10000
  autovacuum_vacuum_cost_delay:    int = 0
}
