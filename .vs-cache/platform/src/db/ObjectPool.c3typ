/**
 * Generic object pool
 */
type ObjectPool<T> {

  /**
   * Backing GenericObjectPool
   */
  pool: @java(class=" org.apache.commons.pool.impl.GenericObjectPool") native

  /**
   * Initializes the connection pool for a datastore.
   *
   * @param config
   *        DatastoreConfig to initialize the connection pool for.
   * @param creds
   *        Credentials to initialize the connection pool for.  ALL secret values must be present.
   * @param poolConfig
   *        Config for the pool.
   *
   * @return the requested connection pool.
   */
  initForDs: optional inline function(config: !DatastoreConfig,
                                      creds: !DatastoreCredentials,
                                      poolConfig: !ObjectPoolConfig): mixing ObjectPool

  /**
   * Initializes the pool with the specified config and lambdas.
   *
   * @param params
   *        Parameters to initialize the pool with.
   * @param creator
   *        Lambda used to create objects.
   * @param destroyer
   *        Lambda used to destroy objects.
   * @param tester
   *        Optional lambda uses to test if objects are safe to be returned.
   *
   * @return The pool initialized as requested.
   */
  initWithLambdas: function(params: @java(class="c3.platform.db.ObjectPoolParams") !native,
                            creator: !lambda(): T,
                            destroyer: !lambda(object: !any),
                            tester: lambda(object: !any): boolean): !mixing ObjectPool

  /**
   * Resets the various pool parameters based on the config.
   *
   * @param config
   *        Config to set the parameters from.
   */
  resetParams: inline member function(config: !ObjectPoolConfig)

  /**
   * Borrows an object from the pool.
   */
  borrowObject: inline member function(): T

  /**
   * Returns an object to the pool.
   */
  returnObject: inline member function(object: !T)

  /**
   * Destroys an object without returning it to the pool.
   */
  destroyObject: inline member function(object: !T)

  /**
   * Destroys and removes all idle instances.
   */
  clear: member function()

  /**
   * Closes the pool.
   */
  close: member function()

  /**
   * Minimum number of idle instances in the pool.
   */
  minIdle: inline member function(): !int32

  /**
   * Maximum number of idle instances in the pool.  Default is number of cores for master node and half of
   * the number of worker threads for workers.
   */
  maxIdle: inline member function(): !int32

  /**
   * Maximum total number of instances (idle and active). Default is number of cores for master node and half of
   * the number of worker threads for workers.
   */
  maxTotal: inline member function(): !int32

  /**
   * Maximum amount of time borrow will wait if an instance is not available before throwing an exception.
   */
  maxWaitMillis: inline member function(): !int

  /**
   * Minimum amount of time an instance can remain idle before being considered for eviction.
   */
  minEvictableIdleTimeMillis: inline member function(): !int

  /**
   * Time between eviction runs.
   */
  timeBetweenEvictionRunsMillis: inline member function(): !int

  /**
   * Number of currently idle instances.
   */
  numIdle: inline member function(): !int32

  /**
   * Number of currently active instances.
   */
  numActive: inline member function(): !int32
}
