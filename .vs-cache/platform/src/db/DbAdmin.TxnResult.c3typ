/**
 * Result row returned from {@link DbAdmin.getLocks}.
 */
type DbAdmin.TxnResult {

  /**
   * Timestamp when the transaction was started.
   */
  txnStart: datetime

  /**
   * Timestamp when the connection holding the transaction was started.
   */
  connStart: datetime

  /**
   * Current state of the transaction (Postgres defined).
   */
  state: string

  /**
   * Database name.
   */
  dbName: string

  /**
   * Timestamp when the last query in the transaction was started.
   */
  queryStart: datetime

  /**
   * Last query executed for the transaction.
   */
  query: string

  /**
   * Client ip address of txn owner.
   */
  clientAddr: string

  /**
   * Client host name of txn owner.
   */
  clientHostname: string

  /**
   * Client port of txn owner.
   */
  clientPort: int
}
