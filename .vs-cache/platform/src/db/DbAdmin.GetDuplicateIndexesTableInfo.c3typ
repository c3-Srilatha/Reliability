/**
 * Result returned for a single table as part of the result from {@link DbAdmin#getDuplicateIndexes} and
 * {@link DbAdmin#removeDuplicateIndexes}.
 */
type DbAdmin.GetDuplicateIndexesTableInfo {

  /**
   * Name of table containing indexes
   */
  tableName: !string

  /**
   * Total number of duplicates found/processed for this table
   */
  totalDuplicates: !int

  /**
   * Indexes with duplicates for this table, along with info about the duplicates
   */
  indexes: [DbAdmin.GetDuplicateIndexesIndexInfo]
}
