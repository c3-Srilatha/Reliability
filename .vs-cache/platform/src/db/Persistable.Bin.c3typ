/**
 * Identifies a "bin" (a logical grouping) of the {@link Persistable} ids.
 */
type Persistable.Bin {

  /**
   * id of {@link Persistable.Bin.Strategy} associated with the current bin
   */
  strategyId: !string

  /**
   * Bin containing the ids
   */
  bin: !int

  /**
   * ids present in the bin.
   * Please note that, when non-empty, nothing may be assumed about the exhaustive-ness of this set i.e it may/may not
   * contain ALL the subjects which may be grouped / present in the bin.
   */
  ids: set<string>

  /**
   * id associated with the current bin.
   */
  binId: property(): !string

  /**
   * @return an array of {@link Persistable.Bin} subtype instances from the provided strategy and the id to bin mapping
   */
  fromStrategyAndMapping: function(strategy: !Persistable.Bin.Strategy,
                                   mapping: !map<string, int>): ![mixing Persistable.Bin]
}
