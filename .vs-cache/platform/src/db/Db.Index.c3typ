/**
 * Represents a database index.
 */
type Db.Index {

  // Name of the index.
  name: string

  // The index method.
  method: !string enum Db.Index.Method

  // Fields defined in the index.
  fields: ![Db.Index.Field]

  /**
   * True if the index is a unique index.
   */
  unique: boolean

  /**
   * @param meta
   *        TypeMeta of the type on which index is being created.
   * @param string
   *        String from which Db.Index instance needs to be created.
   * @return instance of Db.Index created.
   */
  fromString: function(meta: !TypeMeta, str: !string): Db.Index

  /**
   * Filter expression for creating partial indexes. Filter expressions must evaluate to a value type of
   * Boolean.  They support basic comparison operators (e.g. "==", "<", "<=", ">", ">=", "!="), arithmetic operators
   * (e.g. "+", "-", "*", "/"), "&&", "||" and "most" non-timeseries functions supported by the C3 expression engine.
   */
  filter: string serialized Filter
}
