/**
 * Spec for the {@link Persistable#checkReferences} function.
 */
type CheckReferencesSpec mixes Spec {

  /**
   * List of reference field paths to check for validity.  If not specified, all references to entity types will be
   * validated.
   */
  refFieldPaths: [string]

  /**
   * Number of objs with invalid references to fetch/report on for each reference field path.
   */
  limit: int = 100

  /**
   * Filter expression to specify which objs to validate references for.  Valid filters follow the same rules as those
   * in {@link FetchSpec#filter}.
   */
  filter: string
}
