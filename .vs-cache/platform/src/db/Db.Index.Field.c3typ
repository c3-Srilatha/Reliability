/**
 * Represents the field or column on which the index applies.
 */
type Db.Index.Field mixes SortColumn, SortField {

  /**
   * Specifies the operator class for the field.
   */
  opClass: string enum Db.Index.Field.OpClass

  /**
   * Specifies the expressions to be applied on the field.
   */
  expression: string
}
