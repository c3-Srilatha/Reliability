/**
 * Remote invalidator for `FacadedDbChangeLog`.
 */
private type FacadedDbChangeLogInvalidator {

  /**
   * Id of app where invalidations should be sent to
   */
  appId: string

  /**
   * Invalidations for the CalcFieldsQueue
   */
  calcDeps: private map<string, map<string, [FacadedDbChangeLogDep]>>

  /**
   * Invalidations for the PopulateAclQueue
   */
  aclDeps: private map<string, map<string, [FacadedDbChangeLogDep]>>

  /**
   * Invalidations for the MetricDepsQueue
   */
  metricDeps: private map<string, map<string, [FacadedDbChangeLogDep]>>

  /**
   * Performs the invalidations (e.g. creates ChangeLogQueue entries) in the appropriate app
   */
  @call(app='this.appId')
  invalidate: member function()
}
