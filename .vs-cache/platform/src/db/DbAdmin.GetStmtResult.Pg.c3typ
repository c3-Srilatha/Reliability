/**
 * Result row returned from various functions that return information about current or past statements (e.g. {@link DbAdmin.getActiveStmts}).
 */
type DbAdmin.GetStmtResult.Pg mixes DbAdmin.GetStmtResult {

  /**
   * Database name.
   */
  databaseName: string

  /**
   * Postgres pid (Postgres only).
   */
  pid: int

  /**
   * User name of session owning the statement.
   */
  userName: string

  /**
   * Application name
   */
  applicationName: string

  /**
   * Client ip address of statement owner.
   */
  clientAddr: string

  /**
   * Client host name of statement owner.
   */
  clientHostname: string

  /**
   * Client port of statement owner.
   */
  clientPort: int

  /**
   * Time when connection for statement was initiated.
   */
  backendStart: datetime

  /**
   * Elapsed time since connection for statement was initiated.  Note that if the statement has already completed or this wasn't the first statement for the connection,
   * this will be larger than the elapsed time for executing the statement.
   */
  backendElapsedSec: double

  /**
   * Time when transaction was started for the statement.
   */
  xactStart: datetime

  /**
   * Elapsed time since db started executing the statement.  Note that if the statement has already completed or this wasn't the first statement for the transaction,
   * this will be larger than the elapsed time for executing the statement.
   */
  xactElapsedSec: double

  /**
   * Time when db started executing the statement.
   */
  queryStart: datetime

  /**
   * Elapsed time since db started executing the statement.  Note that if the statement has already completed
   * this will be larger than the elapsed time for executing the statement.
   */
  queryElapsedSec: double

  /**
   * Time when state changed for the statement.
   */
  stateChange: datetime

  /**
   * Elapsed time since state changed for the statement.
   */
  stateChangeElapsedSec: double

  /**
   * State for the statement
   */
  state: string

  /**
   * True if the statement is waiting (e.g. blocked due to lock being held by other session).
   *
   * Present only for Postgres version earlier than 9.6
   */
  waiting: boolean

  /**
   * Wait event name if backend is currently waiting, otherwise NULL.  For further information, go to:
   * https://www.postgresql.org/docs/9.6/static/monitoring-stats.html
   *
   * Present only for Postgres version 9.6 and later.
   */
  waitEvent: string

  /**
   * The type of event for which the backend is waiting, if any; otherwise NULL.  For further information, go to:
   * https://www.postgresql.org/docs/9.6/static/monitoring-stats.html
   *
   * Present only for Postgres version 9.6 and later.
   */
  waitEventType: string

  /**
   * Query/statement sql text.
   */
  query: string
}
