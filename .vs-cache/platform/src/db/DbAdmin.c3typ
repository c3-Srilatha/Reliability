type DbAdmin mixes DefaultInstance<DbAdmin> {

  /**
   * Type from parent action when {@link inst} is called, if there is a parent action.  This is used to get the proper
   * connection for other functions requiring a connection.  If there is no parent action, this will be null and the
   * type used for the connection will be the current context type at the time of any function call through the
   * instance.
   */
  parentType: private Type

  /**
   * Datastore to get connection for in non-default instance.
   */
  datastore: private string

  /**
   * Environment to get connection for in non-default instance
   */
  env: private string

  /**
   * App to get connection for in non-default instance
   */
  app: private string

  /**
   * Execute a query statement.  For non-query statements, use {@link executeStmt}.
   *
   * See {@link db-admin-code-examples.c3doc} for a code example on how to loop to retrieve and process all rows in the
   * table matching the query specification.
   *
   * @param stmt
   *           Query statement (must start with "SELECT ").
   * @param rowLimit
   *           Maximum number of rows to return for the query.  Defaults to 100 rows.  Use -1 to indicate fetching
   *           all rows.
   * @param bindVars
   *           Bind variable values as json obj literal.
   *
   * @return result of query.
   */
  @action(group+='cluster-admin')
  executeQuery: member function(stmt: string, rowLimit: int, bindVars: json): DbAdminQueryResult

  /**
   * Execute a query statement.  For non-query statements, use {@link executeStmt}.
   *
   * @param stmt
   *           Query statement (must start with "SELECT ").
   * @param rowLimit
   *           Maximum number of rows to return for the query.  Defaults to 100 rows.  Use -1 (or null) to indicate
   *           fetching all rows.
   * @param bindVars
   *           Bind variable values as json obj literal.
   * @param includeColNames
   *           If true, the first returned tuple will contain the column names for the columns in the result set.
   *           Otherwise, only the data rows will be returned.
   *
   * @return result of query as a stream of tuples.
   */
  @action(group+='cluster-admin')
  executeQueryTuples: member function(stmt: string,
                                      rowLimit: int,
                                      bindVars: json,
                                      includeColNames: boolean): stream<CellTuple>

  /**
   * Create a query plan for a statement.
   *
   * @param stmt
   *           Sql statement to explain.
   * @param bindVars
   *           Bind variable values as json obj literal.
   *
   * @return db explain plan for the statement.
   */
  @action(group+='cluster-admin')
  explainStmt: member function(stmt: string, bindVars: json): string

  /**
   * Execute a query (e.g. non-query) statement.  For query statements, use {@link executeQuery}.
   *
   * @param stmt
   *           Sql statement.
   * @param bindVars
   *           Bind variable values as json obj literal.
   * @param useAdminConn
   *           If true, the admin connection (e.g. JDBC connection in the admin db for the datasource) will be used.
   *           Bind variables are not currently supported when using the admin connection.
   *
   * @return number of rows affected by the statement (e.g. number of rows updated).
   */
  @action(group+='cluster-admin')
  executeStmt: member function(stmt: !string, bindVars: json, useAdminConn: boolean): int

  /**
   * Gets all active statements
   *
   * @param pid
   *           Process id.  In Postgres, pid.  If specified, only statements for that process id will be returned,
   *           otherwise all will be returned.
   * @param includeIdle
   *           If true includes statements that are "idle in transaction" (Postgres only).
   * @param allColumns
   *           If true includes all columns, false includes most relevant columns.
   * @return list of requested statements.
   */
  @action(group+='monitor')
  getActiveStmts: member function(pid: int, includeIdle: boolean, allColumns: boolean): [DbAdmin.GetStmtResult]

  /**
   * Gets all current database locks held (Postgres only).
   * @return list of all database locks held.
   */
  getLocks: member function(): [DbAdmin.LockResult]

  /**
   * Gets statistics for all executed db statements (https://www.postgresql.org/docs/9.4/pgstatstatements.html)
   * (Postgres only).
   *
   * @param db
   *           If specified, only statements for that db will be returned.  Otherwise, statements from all
   *           dbs will be returned (except the postgres db itself).
   * @param allColumns
   *           If true includes all columns, false includes most relevant columns.
   */
  getStmtStats: member function(db: string, allColumns: boolean): [DbAdmin.StmtStatResult]

  /**
   * Gets all current database transactions (Postgres only).
   * @return list of all database transactions.
   */
  getTxns: member function(): [DbAdmin.TxnResult]

  /**
   * Gets all currently blocked statements along with the statement that is blocking them (Postgres only).
   *
   * @param waitingForSec
   *           Number of seconds elapsed since the lock was requested.  Default is 15 seconds.
   *
   * @return list of all blocked statements.
   */
  @action(group+='monitor')
  getBlockedStmts: member function(waitingForSec: int = 15): [DbAdmin.BlockedStmtResult]

  /**
   * Cancels the currently running statement for a connection.
   *
   * @param pid
   *           Process id of the connection.  In Postgres, pid.
   * @return true if the statement was successfully cancelled.
   */
  @action(authz='always')
  cancelStmt: member function(pid: !int): boolean

  /**
   * Terminates a database connection.
   *
   * @param pid
   *           Process id of the connection.  In Postgres, pid
   * @return true if the connection was successfully terminated.
   */
  @action(authz='always')
  terminateConnection: member function(pid: !int): boolean

  /**
   * Performs vacuum/analyze in Postgres for the current datastore.
   *
   * @param table
   *           If specified, only that table will be vacuumed/analyzed. If not specified, all tables will be
   *           vacuumed/analyzed.
   * @param column
   *           Only valid if table is specified. If specified then only that column will be vacuumed/analyzed. If not
   *           specified, then all columns in the table will be vacuumed/analyzed.
   * @param full
   *           Performs "full" vacuum (Postgres only), which can reclaim more space, but takes much longer and
   *           exclusively locks the table.  This method also requires extra disk space, since it writes a new copy of
   *           the table and doesn't release the old copy until the operation is complete.  Usually this should only be
   *           used when a significant amount of space needs to be reclaimed from within the table.
   * @param analyze
   *           Updates statistics used by the planner to determine the most efficient way to execute a query.
   */
  @action(authz='always')
  vacuum: member function(table: string, column: string, full: boolean, analyze: boolean)

  /**
   * Performs vacuum/analyze in Postgres for all datastores.
   *
   * @param table
   *           If specified, only that table will be vacuumed/analyzed. If not specified, all tables will be
   *           vacuumed/analyzed.
   * @param column
   *           Only valid if table is specified. If specified then only that column will be vacuumed/analyzed. If not
   *           specified, then all columns in the table will be vacuumed/analyzed.
   * @param full
   *           Performs "full" vacuum (Postgres only), which can reclaim more space, but takes much longer and
   *           exclusively locks the table.  This method also requires extra disk space, since it writes a new copy of
   *           the table and doesn't release the old copy until the operation is complete.  Usually this should only be
   *           used when a significant amount of space needs to be reclaimed from within the table.
   * @param analyze
   *           Updates statistics used by the planner to determine the most efficient way to execute a query.
   */
  @action(authz='always')
  vacuumAll: member function(table: string, column: string, full: boolean, analyze: boolean)

  /**
   * Performs analyze function for the current datastore.
   *
   * @param table
   *           If specified, only that table will be analyzed. If not specified, all tables will be analyzed.
   * @param column
   *           Only valid if table is specified. If specified then only that column will be analyzed. If not specified,
   *           then all columns in the table will be analyzed.
   */
  @action(group+='monitor')
  analyze: member function(table: string, column: string)

  /**
   * Performs analyze function for all datastores.
   *
   * @param table
   *           If specified, only that table will be analyzed. If not specified, all tables will be analyzed.
   * @param column
   *           Only valid if table is specified. If specified then only that column will be analyzed. If not specified,
   *           then all columns in the table will be analyzed.
   */
  @action(group+='monitor')
  analyzeAll: member function(table: string, column: string)

  /**
   * Loads table data or index into PostgreSQL's shared buffer.
   *
   * @param tableOrIndexName
   *           Name of the table or index that needs to be pre-warmed.
   * @return the number of blocks pre-warmed. Default block size is 8192 bytes.
   */
  @action(authz='always')
  pgPrewarm: member function(tableOrIndexName: !string): !int

  /**
   * Gets usage statistics for one or more tables.
   *
   * @param table
   *           Table to get  usage statistics for.  If not specified, statistics for all tables will be retrieved.
   * @param mostUsedFirst
   *           If true, the most used indexes will appear first in the list, if false (default), the least utilized
   *           indexes will appear first.
   * @param limit
   *           Maximum number of tables to return statistics for (default is 100).
   * @return the requested index usage statistics.
   */
  @action(group+='monitor')
  getTableUsageStats: member function(table: string,
                                      mostUsedFirst: boolean,
                                      limit: int = 100): [DbAdmin.GetTableUsageStatsResult]

  /**
   * Gets usage statistics for the indexes of one or more tables.
   *
   * @param table
   *           Table to get index usage statistics for.  If not specified, statistics for all indexes for all tables
   *           will be retrieved.
   * @param mostUsedFirst
   *           If true, the most used indexes will appear first in the list, if false (default), the least utilized
   *           indexes will appear first.
   * @param limit
   *           Maximum number of indexes to return statistics for (default is 100).
   * @return the requested index usage statistics.
   */
  @action(group+='monitor')
  getIndexUsageStats: member function(table: string,
                                      mostUsedFirst: boolean,
                                      limit: int = 100): [DbAdmin.GetIndexUsageStatsResult]

  /**
   * Gets vacuum statistics for tables, ordered descending by number of dead tuples.
   *
   * @param limit
   *          Maximum number of tables to return statistics for. If not specified or <= 0, then statistics will be
   *          returned for all tables.
   * @param table
   *          If specified, then statistics will only be returned for that table, otherwise statistics for all tables
   *          will be returned (up to the number specified in limit).
   * @return vacuum statistics for one or more tables.
   */
  @action(group+='monitor')
  getVacuumStats: member function(limit: int, table: string): [DbAdmin.GetVacuumStatsResult]

  /**
   * Gets analyze statistics for tables, ordered by last autoVacuum time.
   *
   * @param limit
   *          Maximum number of tables to return statistics for. If not specified or <= 0, then statistics will be
   *          returned for all tables.
   * @param table
   *          If specified, then statistics will only be returned for that table, otherwise statistics for all tables
   *          will be returned (up to the number specified in limit).
   * @return analyze statistics for one or more tables.
   */
  @action(group+='monitor')
  getAnalyzeStats: member function(limit: int, table: string): [DbAdmin.GetAnalyzeStatsResult]

  /**
   * Gets the indexes defined for a table.
   *
   * @param table
   *          Table to get index definitions for.
   * @return list of index definitions for a table.
   */
  @action(group+='monitor')
  getTableIndexes: member function(table: !string): [DbAdmin.GetTableIndexesResult]

  /**
   * Gets duplicate indexes defined for a table (or all tables)
   *
   * Note that this only works for C3 defined tables (e.g. names start with "C3_2_").
   *
   * @param table
   *          If specified, the table to get the duplicate indexes for, otherwise the duplicates will be returned for
   *          all tables
   * @return the duplicate indexes for a table (or all tables).
   */
  @action(group+='monitor')
  getDuplicateIndexes: member function(tableName: string): !DbAdmin.GetDuplicateIndexesResult

  /**
   * Removes duplicate indexes defined for a table (or all tables)
   *
   * Note that this only works for C3 defined tables (e.g. names start with "C3_2_").
   *
   * @param table
   *          If specified, the table to get the remove indexes for, otherwise the duplicates will be removed for
   *          all tables
   * @return the duplicate indexes removed for a table (or all tables).
   */
  @action(group+='cluster-admin')
  removeDuplicateIndexes: member function(tableName: string): !DbAdmin.GetDuplicateIndexesResult

  /**
   * Gets various information about a table or tables.
   *
   * @param limit
   *           Maximum number of tables to get information for.  Ignored if {@link table} is specified.
   * @param table
   *           Table to get information for
   * @return the requested information for the tables.
   */
  @action(group+='monitor')
  getTableInfo: member function(limit: int, table: string): [DbAdmin.GetTableInfoResult]

  /**
   * Rebuilds an index (or all indexes) for a table.
   *
   * @param table
   *           Table owning index.
   * @param index
   *              Index to rebuild.  If not specified, all indexes for the table will be rebuild.
   */
  @action(authz='always')
  rebuildIndex: member function(table: !string, index: string)

  /**
   * Creates an index for a given type if similar one does not exist already.
   *
   * @param type
   *        The type for which to create/update the index
   * @param index
   *        The index definition as a string serialized Db.Index
   */
  // TODO: PLAT-128427 - Implement Persistable#dbAdmin(): DbAdmin.Entity
  @action(authz='always')
  upsertIndex: member function(type: !Type<<Persistable>>, index: !string serialized Db.Index)

  /**
   * Checks if an index exists for a given type and index definition.
   *
   * @param type
   *        The type for which to check the index
   * @param index
   *        The index definition as a string serialized Db.Index
   * @return true if the index exists, false otherwise
   */
  @action(group+='monitor')
  indexExists: member function(type: !Type<<Persistable>>, index: !string serialized Db.Index): boolean

  /**
   * Verifies that indexes used by fkey/calc fields are present and creates them if they are missing.
   *
   * @return number of indexes created
   */
  @action(authz='always')
  verifyDefaultIndexes: member function(): !int

  /**
   * Gets the stats of one (or all) databases on the db server.
   *
   * @param database
   *           Name of database to get the size of.  If null, the stats of all databases will be returned
   *
   * @return a list of entries containing the requested db size info.
   */
  getDbStats: member function(database: string): [DbAdmin.GetDbStatsResult]

  /**
   * @return the server version for the database.
   */
  getDbServerVersion: member function(): !SemanticVersion

  /**
   * @return the postgres vector plugin extension version for the database.
   */
  getPgVectorVersion: member function(): SemanticVersion

  getDbConnPoolInfo: member function(): [ConnPoolInfo]

  /**
   * @return current setting of run-time parameters.
   */
  params: member function(): [DbParam]

  /**
   * @return current setting of a run-time parameter.
   */
  param: member function(param: !?string): string

  /**
   * Sets SQL Optimizer Mode: supported values are ALL_ROWS, FIRST_ROWS, CHOOSE &
   * RULE
   */
  setSqlOptimizerMode: function(mode: string)

  /**
   * Gets SQL Optimizer Mode
   */
  @action(group+='monitor')
  getSqlOptimizerMode: function(): string

  /**
   * Refreshes all connections in all datasources. Existing available
   * connections are replaced with new ones and borrowed ones are replaced upon
   * return to the connection pool
   */
  refreshAllConnections: function()

  /**
   * Purges all connections (both available and borrowed) in all datasources.
   */
  purgeAllConnections: function()

  /**
   * Sets the parameters for autoVacuum to use for a Postgres table
   *
   * @param table
   *        Table to set the autoVacuum parameters for
   * @param spec
   *        Parameter values to set
   */
  @action(authz='always')
  setAutoVacuumParameters: member function(table: !string, spec: DbAdmin.SetAutoVacuumParametersSpec)

  /**
   * Gets a list of all databases in the instance
   */
  @action(group+='cluster-admin')
  databases: member function(): [string]

  /**
   * Sets run-time configuration parameters for Pg databases globally (at the database level).
   * @param params
   *        Map of Pg config parameters and values to be set
   */
  setPgConfigParams: member function(params: !map<string enum Db.PgConfigParamEnum, string>)
}
