/**
 * An entry in {@link DbAccessListener} for a single table accessed in an action.
 */
type DbAccessListenerEntry {

  /**
   * App that accessed the table.
   */
  appId: !string

  /**
   * Table that was accessed.
   */
  tableName: !string

  /**
   * Name of the datastore the table was accessed in.
   */
  datastoreName: !string

  /**
   * The kind of datastore the table was accessed in.
   *
   * @See DatastoreType
   */
  datastoreKind: !string

  /**
   * Number of times the table was accessed for read operations.
   */
  readCount: !int = 0

  /**
   * Number of times the table was accessed for write operations.
   */
  writeCount: !int = 0

  /**
   * Time spent executing read operations.
   */
  readTimeMillis: int = 0

  /**
   * Time spent executing write operations.
   */
  writeTimeMillis: !int = 0

  /**
   * Updates the appropriate count/time values for an operation.
   *
   * @param count
   *        Number of times the table was accessed. for the operation.
   * @param read
   *        True if the operation was a read operation.  False if it was an update operation.
   * @param timeMillis
   *        Time spent by the operation.
   */
  logOperation: inline member function(count: !int, read: !boolean, timeMillis: !int): !DbAccessListenerEntry
}
