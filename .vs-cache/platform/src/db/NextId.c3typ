/**
 * system type used by data engine to generate short ids of the types annotated as @db(shortId=true).
 *
 * id of the object is corresponding type's id (as defined by metadata.TypeId type) and nextId field
 * holds next available sequence number for that type.
 */
@db(systemType=true, compactType=true)
entity type NextId schema name 'DB_NEXTID' {

  nextId:  !decimal schema name 'NEXT_ID'
  version: ~ not persistable
}
