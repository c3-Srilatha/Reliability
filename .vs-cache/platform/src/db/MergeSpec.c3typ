/**
 * Adds additional controls to the {@link UpsertSpec} for the {@link Persistable#merge} and
 * {@link Persistable#mergeBatch} operations.
 */
type MergeSpec mixes UpsertSpec {

  /**
   * Overrides {@link UpsertSpec#include} and is used to control which fields from the input obj(s) are merged.  If it
   * is not specified then only non-null fields will be merged.  Nullness of fields is considered at every level for
   * fields with a value type of an included (e.g. non-entity) type.  If specified then only the fields indicated in the
   * include will be merged (both null and non-null).
   *
   * Has the same structure/rules as {@link FetchSpec#include}.  However, fields that wouldn't be persisted as part of
   * the operation are ignored.
   */
  @deprecated(details='Use mergeInclude')
  include: string

  /**
   * Used to control which fields from the input obj(s) are merged.  If it is not specified then only non-null fields
   * will be merged.  Nullness of fields is considered at every level for fields with a value type of an included
   * (e.g. non-entity) type.  If specified then only the fields indicated in the include will be merged
   * (both null and non-null).
   *
   * Has the same structure/rules as {@link FetchSpec#include}.  However, fields that wouldn't be persisted as part of
   * the operation are ignored.
   */
  @deprecated(finalVersion='7.7', details='Use function version with mergeInclude parameter')
  mergeInclude: string

  /**
   * Performs the same function as {@link include}.  However, its syntax must be valid as a csv header.  This is used by
   * data load for merging input values coming from a csv file, for example.
   */
  @deprecated(finalVersion='7.7',
              details='Use function version with mergeInclude parameter using normal include syntax')
  csvInclude: string

  /**
   * If true, non-existing entries will not be created.  If false, they will be created.
   */
  ignoreNonExisting: boolean
}
