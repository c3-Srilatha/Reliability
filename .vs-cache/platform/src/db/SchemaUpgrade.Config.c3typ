/**
 * Configuration for C3 managed vacuuming of Postgres tables.
 */
@config(minOverride='APP', maxOverride='APP')
type SchemaUpgrade.Config mixes Config, Singleton {

  /**
   * Number of minutes to wait during schema upgrade while starting an app before the operation is aborted and an
   * exception is thrown
   */
  dbLockTimeoutMinutes: !int = 20

  /**
   * Disables schema upgrade for the app.
   *
   * IMPORTANT: ONLY USE IN CASE OF EMERGENCY
   */
  disabled: boolean
}
