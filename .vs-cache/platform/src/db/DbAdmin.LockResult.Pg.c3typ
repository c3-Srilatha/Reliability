/**
 * Result row returned from {@link DbAdmin.getLocks}.
 */
type DbAdmin.LockResult.Pg mixes DbAdmin.LockResult {

  /**
   * Type of lock
   */
  lockType: string

  /**
   * Database name
   */
  database: string

  /**
   * Table name lock is for.
   */
  relation: string

  /**
   * Page that is locked.
   */
  page: int

  /**
   * Tuple that is locked.
   */
  tuple: int

  /**
   * Virtual transaction id holding the lock.
   */
  virtualXid: string

  /**
   * Transaction id holding the lock.
   */
  transactionId: string

  /**
   * Postgres class name for locked object.
   */
  class: string

  /**
   * Postgres oid of the table being locked.
   */
  objId: string

  /**
   * Postgres oid of the column in the table being locked.
   */
  objSubId: int

  /**
   * Virtual transaction owning the lock.
   */
  virtualTransaction: string

  /**
   * Process id owning the lock.
   */
  pid: int

  /**
   * Lock mode
   */
  mode: string

  /**
   * True if lock has been granted, false if it is waiting to be granted.
   */
  granted: boolean

  /**
   * True if lock was taken via Postgres fastpath.
   */
  fastpath: boolean

  /**
   * Client ip address of lock owner.
   */
  clientAddr: string

  /**
   * Client host name of lock owner.
   */
  clientHostname: string

  /**
   * Client port of lock owner.
   */
  clientPort: int
}
