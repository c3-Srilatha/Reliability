/**
 * Credentials configuration for Jdbc connection.
 */
type JdbcCredentials mixes DatastoreCredentials<JdbcStoreConfig>, JdbcCredentialsFields {

  /**
   * If not null, the name of the {@link SqlSourceSystem} that created the credentials.  Used to allow verification that
   * only SqlSourceSystem that created credentials can remove them.
   */
  sqlSourceSystem: string

  /**
   * Used to override the default admin db (e.g. "postgres"/"redshift")
   */
  adminDatabase: string

  /**
   * Used to override the default admin username.
   */
  adminUsername: string

  /**
   * Used to override the default admin password.
   */
  @config(secret=true)
  adminPassword: string

  /**
   * Customized description for the JdbcCredential.
   */
  description: string

  preprocess: ~
}
