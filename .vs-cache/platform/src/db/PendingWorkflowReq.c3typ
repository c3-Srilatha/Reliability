/**
 * Pending workflow scheduled during provisioning.
 */
entity type PendingWorkflowReq extends PendingJobReq mixes Value type key 'WORKFLOW' {

  /**
   * Map of input values to be used for the workflow execution.  The key of the map must be the name of a vertex that
   * mixes Workflow.Input.
   */
  inputs: map<string, any>

  /**
   * An instance of WorkflowExecutionSpec to specify details on how the workflow execution will happen.
   */
  spec: WorkflowExecutionSpec

  doRefresh: ~
}
