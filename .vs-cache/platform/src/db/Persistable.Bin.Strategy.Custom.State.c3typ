@db(datastore="kv")
private entity type Persistable.Bin.Strategy.Custom.State mixes Cached, ParentPartitionable<Persistable.Bin.Strategy> {

  /**
   * A binary columnar blob of the bin mapping with "subjectHash" -> "binNumber". This is the most efficient/compact
   * way of storing this information.
   */
  binMap: !binary

  /**
   * Reads the data, deserializes it into a map of subject hash to bin number.
   * If a subjectHashes set is provided, then only these subjects will be returned.
   */
  binHashs: private function(strategyId: !string, subjectHashes: set<int>): map<int, int>

  /**
   * Retrieve the bins of the provided subjects. You may provide the lambda for the hash function if you choose to.
   * Please note that this should be the same hash function which was used for {@link #upsertBins} and should guarantee
   * ensure that the hash should remain stable and not have any collisions. (or the probability of the collision is
   * super low.)
   */
  bins: function(strategyId: !string, subjects: !set<string>, hashFunc: lambda(v: string): int): map<string, int>

  /**
   * Transform the binMap into the columnar/binary content and upsert. If a binMap already exists for the given strategy,
   * then, it will override the previously present binMap.
   */
  upsertBinHashs: private function(strategyId: !string, binMap: !map<int, int>)

  /**
   * Upsert the bin mapping for this strategy.
   * If a bin mapping already exists for the given strategy, then it will override the previously present binMap.
   * Please note that by default {@link Fingerprint#longHashCode} is used but no such assumption is made here.
   */
  upsertBins: function(strategyId: !string, binMap: !map<string, int>, hashFunc: lambda(v: string): int)

  /**
   * {@inheritDoc}
   * Changing the cacheKey to be **parent.id**
   */
  @dependency(include="parent.id")
  cacheKey: ~

  /**
   * {@inheritDoc}
   * Updating the implementation to call `fetch` with a `parent.id` filter instead of the default `.get`.
   */
  produce: ~
}
