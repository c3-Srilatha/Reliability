/**
 * Manages connections for `Persistable` types for a single `App` execution environment.
 */
type Db.Engine mixes Singleton {

  /**
   * App id this engine is servicing
   */
  appId: !string

  /**
   * App code this engine is servicing
   */
  appCode: !int

  /**
   * If true, the datastore is using the H2 db as the default relation datastore (e.g. JdbcStore with name "sql").
   */
  useH2Db: inline member function(): boolean

  /**
   * Sets the state of this instance to use H2 in place of Postgres
   */
  setUseH2Db: member function(useH2Db: boolean)

  /**
   * True if the engine has been started.  Note that the Db.Engine will only be started once.  Subsequent calls to
   * stop/start will change the `isRunning` state only.
   */
  isStarted: inline member function(): boolean

  /**
   * True if the engine is currently running.
   */
  isRunning: inline member function(): boolean

  /**
   * True if the engine/app has been terminated.
   */
  isTerminated: inline member function(): boolean

  /**
   * True if the engine/app has been stopped.
   */
  isStopped: inline member function(): boolean

  /**
   * Sets the started state of this engine instance
   */
  setIsStarted: member function(isStarted: !boolean)

  /**
   * Sets the running state of this engine instance
   */
  setIsRunning: member function(isRunning: !boolean)

  /**
   * Check if the node is a leader node
   *
   * @param checkServerRunning
   *        If true, then this will only return true if the server state is verified to be running.  If false, this will
   *        return true if called before the server is fully running to avoid short circuiting processing loops
   *        prematurely.
   *
   * @return true if the node is a leader node
   */
  isLeaderNode: member function(checkServerRunning: boolean): boolean

  /**
   * Check if the node is a task node
   *
   * @param checkServerRunning
   *        If true, then this will only return true if the server state is verified to be running.  If false, this will
   *        return true if called before the server is fully running to avoid short circuiting processing loops
   *        prematurely.
   *
   * @return true if the node is a task node
   */
  isTaskNode: member function(checkServerRunning: boolean): boolean

  inst: cached ~

  /**
   * Starts the db engine for the current app if it isn't already running.
   */
  start: member function()

  /**
   * @return the current status of the various functions/states of the processor
   */
  status: function(): !Db.Engine.Status

  getStatus: private member function(): !Db.Engine.Status

  /**
   * Stops the monitoring, queue processing and cron processing for the app.  The instance will still support basic
   * db functionality.  Once stopped, the monitoring, queue processing and cron processing can only be restarted by
   * calling {@link: start).
   */
  stop: member function()

  /**
   * Terminates/stops the db engine for the current app.  Terminating causes the following to occur:
   *
   * 1. An error will be thrown for any subsequent attempts to get a database connection.
   * 2. Invalidation queue/cron/monitor processing will end.  Note that in flight operations may continue but any that
   *    require a new database connection will fail.
   *
   * Note that once terminated for an app, any new instance of a db engine for that app will be instantiated in the
   * terminated state.
   */
  terminate: member function()

  /**
   * Cache the config on the instance to avoid constantly getting from the config framework
   */
  config: cached member function(): !DbEngineConfig

  /**
   * @return the datastore name that will be used to access the type
   */
  datastoreName: inline function(type: !Type, dontFailOnError: boolean): string

  /**
   * @return any override for the "sql" datastore in the specified domain
   */
  sqlDsNameForDomain: cached member function(domainName: !string): string

  /**
   * Gets the full jdbc credentials that will be used for the database connection that is used to access this type.
   * This includes any user credentials defined for the specified user, if provided.  Note that this is only valid for
   * relational entity types (e.g. backed by JdbcStore) and that are not facaded outside of the current
   * {@link Db.Domain}.
   *
   * @param type
   *        Type to get the credentials for
   */
  @action(group+='cluster-admin')
  getFullJdbcCredentials: function(type: !Type, user: User): JdbcCredentials

  /**
   * Gets a database connection from the appropriate datastore for the specified type
   *
   * @param type
   *        Type to get the connection for
   * @param readOnly
   *        If true, a read only connection will be returned.  Otherwise a connection suitable for updates will be
   *        returned
   *
   * @return the requested database connection
   */
  getConnection: member function(type: !Type,
                                 readOnly: boolean): @java(class="c3.platform.db.ds.ConnectionBase") native

  /**
   * Gets new database connection for the type's secondary connection that can be used to access provided type.
   *
   * @param type
   *        c3 type for which to get the connection for.
   * @param isReadOnly
   *        if connection will only be access to read the data.
   *
   * @return new database connection that when not needed any more should be released.
   */
  getSecondaryDsConnection: member function(type: !Type,
                                            readOnly: boolean): @java(class="c3.platform.db.ds.ConnectionBase") native

  /**
   * Gets a database connection from the specified datastore
   *
   * @param datastore
   *        Datastore to get the connection from
   * @param readOnly
   *        If true, a read only connection will be returned.  Otherwise a connection suitable for updates will be
   *        returned
   *
   * @return the requested database connection
   */
  getConnectionFromDatastore: member function(datastore: @java(class="c3.platform.db.DatastoreBase") !native,
                                              readOnly: boolean)
                                       : @java(class="c3.platform.db.ds.ConnectionBase") native

  /**
   * Gets a database connection based on the credentials defined in a specified SqlSourceSystem
   *
   * @param sys
   *        SqlSourceSystem to get a connection for
   *
   * @return the requested connection
   */
  getSqlSourceSystemConnection: member function(sys: !SqlSourceSystem)
                                         : @java(class="c3.platform.db.ds.ConnectionBase") !native

  /**
   * Gets the appropriate datastore for the specified type
   *
   * @param type
   *        Type to get the datastore for
   *
   * @return the requested datastore
   */
  getDatastore: member function(type: !Type): @java(class="c3.platform.db.DatastoreBase") !native

  /**
   * Gets the specified datastore
   *
   * @param name
   *        Name of datastore to get
   *
   * @return the requested datastore
   */
  getDatastore: member function(name: !string): @java(class="c3.platform.db.DatastoreBase") !native

  /**
   * Gets an ad-hoc datastore based on a jdbc spec. The datastore is assumed to be external (e.g. not managed by c3).
   *
   * @param spec
   *        jdbc spec
   * @return the requested datastore
   */
  getAdHocDatastore: member function(spec: !JdbcConnectSpec): @java(class="c3.platform.db.jdbc.JdbcDatastore") !native

  /**
   * @return the datastore for the specified type, but only if it has already been loaded into the db engine.  Otherwise
   *         return null
   */
  getDatastoreFromCache: member function(type: !Type): @java(class="c3.platform.db.DatastoreBase") native

  /**
   * @return all of the currently loaded datastores for the app
   */
  getDatastores: member function(): !?[@java(class="c3.platform.db.DatastoreBase") native]

  /**
   * @return all of the currently loaded external datastores for the app
   */
  getExternalDatastores: member function(): !?[@java(class="c3.platform.db.jdbc.JdbcDatastore") native]

  /**
   * Gets the short id generator for a type that specifies the {@link Ann.Db#shortId} annotation
   *
   * @param type
   *        Type to get the short id generator for
   * @param numReserved
   *        Number of ids to reserve.  Specifying a higher value reduces the number of db accesses required to generate
   *        multiple ids.  However, doing so can cause large gaps of unused ids if the reserved ids are not used up
   *        up before this db engine instance is closed.
   *
   * @return the requested short id generator for the type
   */
  shortIdGenerator: inline member function(type: !Type,
                                           numReserved: !int)
                                    : @java(class="c3.platform.db.sql.ShortIdGenerator") native

  /**
   * Unique integer id within the app for the specified type.
   *
   * @param type
   *        Type to get the id for
   *
   * @return the requested type id.
   */
  typeId: member function(type: !Type): !int

  /**
   * Unique integer id within the app for the specified type.
   *
   * @param typeName
   *        Name of type to get the id for
   *
   * @return the requested type id.
   */
  typeId: member function(typeName: !string): !int

  /**
   * Type for the specified type id within the app.
   *
   * @param typeId
   *        Type id to get the type for.
   *
   * @return the requested type.
   */
  typeFromId: cached inline member function(typeId: !int): Type

  /**
   * Type name for the specified type id within the app.
   *
   * @param typeId
   *        Type id to get the type name for.
   *
   * @return the requested type name.
   */
  typeNameFromId: member function(typeId: !int): string

  /**
   * Unique integer id within the app for the specified path (e.g. field path).
   *
   * @param path
   *        Path to get the id for
   *
   * @return the requested path id.
   */
  pathId: member function(path: !string): !int

  /**
   * Path for the specified path id within the app.
   *
   * @param pathId
   *        Path id to get the path for.
   *
   * @return the requested path.
   */
  pathFromId: member function(pathId: !int): string

  /**
   * Sets the sql optimizer mode
   *
   * @param mode
   *        New sql optimizer mode
   */
  setSqlOptimizerMode: member function(mode: !string)

  /**
   * @return the current sql optimizer mode
   */
  @action(group+='monitor')
  getSqlOptimizerMode: member function(): string

  /**
   * Refreshes all connections in the data store. All available connections will be replaced with new ones. Borrowed
   * connections will be replaced upon return to the connection pool
   */
  refreshAllConnections: member function()

  /**
   * Purges all connections (available and borrowed) in the datastore
   */
  purgeAllConnections: member function()

  /**
   * Attempts to ping/connect to each loaded datastore for the db engine
   */
  ping: member function()

  /**
   * Determines if 2 entity types are in the same datastore.  An error is thrown if either type is not an entity
   * type.
   *
   * @param type1: Type 1 to check.
   * @param type2: Type 2 to check.
   *
   * @return True if both types are in the same datastore.
   */
  typesAreInSameDatastore: member function(type1: !Type, type2: !Type): boolean

  /**
   * Determines if 2 entity types are in the same database.  An error is thrown if either type is not an entity
   * type.  The types are determined to be in the same database if the datastore for each is using the same
   * connection pools.
   *
   * @param type1: Type 1 to check.
   * @param type2: Type 2 to check.
   *
   * @return True if both types are in the same database.
   */
  typesAreInSameDatabase: member function(type1: !Type, type2: !Type): boolean

  /**
   * @return true if the specified type is federated in the given context (e.g. its data is persisted in an app that is
   *         different than the current context's app.
   */
  typeIsFederated: function(type: !Type): boolean

  /**
   * @return the AppId of the app the specified type is federated to if {@link typeIsFederated} returns true and null
   *         otherwise.
   */
  federatedAppId: function(type: !Type): AppId

  /**
   * @return true if the queue processor is currently processing (e.g. not stopped, terminated, etc.).
   */
  isQueueProcessing: member function(): boolean

  /**
   * @return overall status of invalidation queue processor
   */
  queueProcessorStatus: function(): !InvalidationQueue.Processor.Status

  /**
   * Timestamp of last pass through the main processing loop
   */
  lastMonitored: member function(): datetime

  /**
   * Timestamp of last termination of blocked statements
   */
  lastTerminatedBlockedStmts: member function(): datetime

  /**
   * Timestamp of last call to {@link DbLockDoctor#recover}
   */
  lastDbLockDoctorRecover: member function(): datetime

  /**
   * Timestamp of last call to {@link InvalidationQueue#recoverStuck}
   */
  lastRecoverStuck: member function(): datetime

  /**
   * Timestamp of last call to {@link Cron.Processor.syncJobs}
   */
  lastCronSyncJobs: member function(): datetime

  /**
   * Timestamp of last time cron jobs that were specified to `runOnLeader` were run
   */
  lastCronRunOnLeaderJobs: member function(): datetime

  getCassandraConfig:     member function(): !Cassandra.Config
  incrementDatastoreLock: private member function(): !int
  decrementDatastoreLock: private member function(): !int
  deleteTestData:         private member function(dsName: string = "sql")

  /**
   * Deletes datastore's that is configured for this app if it is dedicated and if it is shared removes data.
   */
  @action(group+='app-admin')
  terminateDatastores: private member function(): BatchError

  /**
   * Pauses the operation of the {@link DbLockDoctor#recovery) in the monitor loop for the app
   */
  pauseDbLockDoctor: function()

  /**
   * Resumes the operation of the {@link DbLockDoctor#recovery) in the monitor loop for the app
   */
  resumeDbLockDoctor: function()

  /**
   * @return true if the {@link DbLockDoctor} is paused for the app
   */
  isDbLockDoctorPaused: function(): boolean

  /**
   * Timestamp when main processing loop was started
   */
  monitoringStarted: inline member function(): datetime

  /**
   * Timestamp when monitoring loop terminated
   */
  monitoringTerminated: inline member function(): datetime

  monitoringTerminatedCause: inline member function(): string
  setMonitoringTerminated:   private inline member function(cause: !string)

  /**
   * The last error encountered during processing
   */
  lastError: inline member function(): @java(class="java.lang.Throwable") native

  lastErrorReportedAt:         inline member function(): datetime
  setLastError:                private inline member function(lastError: @java(class="java.lang.Throwable") !native)
  emptyShortIdGeneratorsCache: private member function()
  startQueueProcessing:        private inline member function()
  startCronProcessing:         private inline member function()
  startMonitor:                private member function()
  enableDbStmtCountLogging:    member function(enable: boolean)
  logDbStmtCounts:             member function(): string
  dbStmtExecuted:              inline function()
  queueProcessor:              private inline member function(): InvalidationQueue.Processor
  cronProcessor:               private inline member function(): Cron.Processor
  sqlCache:                    private inline member function(): @java(class="c3.platform.db.sql.SqlCache") !?native
  executor:                    private @java(class="c3.Executor") native
  datastores:                  private @java(class="java.util.Map<String, c3.platform.db.DatastoreBase>") native
  dsInfos:                     private @java(class="java.util.Map<String, c3.platform.db.JdbcStoreInfo>") native
  sqlStmtLog:                  private @java(class="c3.platform.db.sql.SqlStmtLog") !?native
  _queueProcessor:             private @java(class="java.util.concurrent.atomic.AtomicReference<c3.platform.async.InvalidationQueue.Processor>") native
  _cronProcessor:              private @java(class="java.util.concurrent.atomic.AtomicReference<c3.platform.cron.Cron.Processor>") native
  _sqlCache:                   private @java(class="java.util.concurrent.atomic.AtomicReference<c3.platform.db.sql.SqlCache>") native
  _datastoreLock:              private @java(class="java.util.concurrent.atomic.AtomicLong") !?native
  _useH2Db:                    @java(class="java.util.concurrent.atomic.AtomicBoolean") native
  _isStarted:                  @java(class="java.util.concurrent.atomic.AtomicBoolean") native
  _isRunning:                  @java(class="java.util.concurrent.atomic.AtomicBoolean") native
  _shouldMonitor:              @java(class="java.util.concurrent.atomic.AtomicBoolean") native
  _isMonitorRunning:           @java(class="java.util.concurrent.atomic.AtomicBoolean") native
  _monitoringStarted:          private @java(class="java.util.concurrent.atomic.AtomicReference<c3.platform.typesys.value.datetime.DateTime>") native
  _monitoringTerminated:       private @java(class="java.util.concurrent.atomic.AtomicReference<c3.platform.typesys.value.datetime.DateTime>") native
  _monitoringTerminatedCause:  private @java(class="java.util.concurrent.atomic.AtomicReference<java.lang.String>") native
  _lastDbStmtCountLogged:      @java(class="java.util.concurrent.atomic.AtomicLong") native
  _lastMonitored:              private @java(class="java.util.concurrent.atomic.AtomicReference<c3.platform.typesys.value.datetime.DateTime>") native
  _lastTerminatedBlockedStmts: private @java(class="java.util.concurrent.atomic.AtomicReference<c3.platform.typesys.value.datetime.DateTime>") native
  _lastDbLockDoctorRecover:    private @java(class="java.util.concurrent.atomic.AtomicReference<c3.platform.typesys.value.datetime.DateTime>") native
  _lastRecoverStuck:           private @java(class="java.util.concurrent.atomic.AtomicReference<c3.platform.typesys.value.datetime.DateTime>") native
  _lastCronSyncJobs:           private @java(class="java.util.concurrent.atomic.AtomicReference<c3.platform.typesys.value.datetime.DateTime>") native
  _lastCronRunOnLeaderJobs:    private @java(class="java.util.concurrent.atomic.AtomicReference<c3.platform.typesys.value.datetime.DateTime>") native
  _numDbStmtsExecuted:         @java(class="java.util.concurrent.atomic.AtomicLong") native
  _lastError:                  private @java(class="java.util.concurrent.atomic.AtomicReference<java.lang.Throwable>") native
  _lastErrorReportedAt:        private @java(class="java.util.concurrent.atomic.AtomicReference<c3.platform.typesys.value.datetime.DateTime>") native
}
