type DbUtil mixes Value {

  /**
   * generated entity relationship diagram based on c3 metadata
   */
  erDiagram: function(spec: ErDiagramSpec): string

  /**
   * generated entity relationship diagram based on c3 metadata
   */
  dataErDiagram: function(spec: DataErDiagramSpec): DataErDiagramResult

  /**
   * generated database information spreadsheet based on metadata
   */
  schemaSpreadsheet: function(spec: SchemaSpreadsheetSpec): SchemaSpreadsheetResult
}
