/**
 * Specification of parameters for {@link Fetchable#scanArrow} call.
 */
private type ScanArrowSpec mixes Spec {

  /**
   * Specifies which fields should be included in result. Currently only primitive fields are supported.
   */
  include: ![string]

  /**
   * Filter expression which defines which rows should be returned.
   */
  filter: string serialized Filter

  /**
   * Maximum number of rows in single batch.
   */
  batchSize: !int32
}
