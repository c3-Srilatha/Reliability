type RecursiveFetchResult {

  /**
   * A serialized array of all relational (not in cassandra) data found during recursion
   */
  data: ObjArry

  /**
   * A record of all the traversed references. Helpful for visualizing how things are related.
   */
  model: json

  /**
   * recursiveFetch does not fetch any Cassandra types but instead collects all the Cassandra-type + partition keys here.
   * You can use to this information fetch the cassandra objects on your own.
   */
  cassandraKeys: json
}
