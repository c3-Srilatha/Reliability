/**
 * Specification of how the `batchIds` operation should work.
 */
type BatchIdsSpec mixes Spec {

  /**
   * Filter expression to apply to qualify matching objs.
   */
  filter: string serialized Filter

  /**
   * Suggested number of batches to return ids for.
   */
  numBatches: int

  /**
   * The fixed number of objs to be included in each batch.
   */
  batchSize: int
}
