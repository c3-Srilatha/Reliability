/**
 * Specification of which Objs to bring back and which fields to bring back in them for a
 * {@link Persistable#fetchObjStream} call.
 */
type FetchStreamSpec mixes FetchSpec {

  /**
   * Ids that will be added to the filter.  If {@link idsField} is specified they will be applied as a filter to that
   * field, otherwise they will be applied to the "id" field.
   */
  ids: stream<string>

  /**
   * If {@link ids} is specified, the field that the ids will be applied to as a filter.  Default is "id".
   */
  idsField: string

  /**
   * Maximum number of Objs to return (starting from {@link offset}).  If there are fewer rows than were requested, only those will be returned.  If there are
   * additional rows beyond what was requested, then {@link FetchResult.hasMore} will be set to true.
   *
   * -1 returns all.
   */
  limit: ~ = -1
}
