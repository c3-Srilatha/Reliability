/**
 * Base type for results of validating the path for whatever is being validated (e.g. fetch filter, order, include, etc.)
 *
 * @see validatePath
 */
type ValidatePathEntry {

  /**
   * Is true if the path was determined to be valid.
   */
  isValid: boolean

  /**
   * Error code if the path is determined to be invalid and null otherwise.
   */
  errCode: string

  /**
   * Error message if the path is determined to be invalid and null otherwise.
   */
  errMsg: string
}
