entity type SchemaSpreadsheetResult schema name 'DB_SCSPRSLT' {

  /**
   * document MIME type
   */
  contentType: !string

  /**
   * encoding into a CLOB
   */
  encoding: string

  /**
   * spreadsheet contents
   */
  content: string

  /**
   * tables produced (on per type)
   */
  moduleCount: int

  typeCount: int
}
