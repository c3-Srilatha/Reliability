/**
 * Keeps track of which schema migrations have been performed for each app
 */
private entity type SchemaMigrationVersion mixes InvalidationDisabled {

  /**
   * Id will be the name of the migration type.
   */
  id: ~

  /**
   * Name of last migration function that was successfully applied for the migration type.
   */
  lastMigration: !string

  /**
   * Gets the next migration function that needs to be applied (if any) for an migration type.
   *
   * @param type
   *        Migration type to check
   *
   * @return the next migration function that needs to be applied (if any) for a migration type.
   */
  nextMigration: function(type: !Type): string

  /**
   * Gets the next migration version number that needs to be applied (if any) for an migration type.
   *
   * @param type
   *        Migration type to check
   *
   * @return the next migration version number that needs to be applied (if any) for a migration type.  If no
   *         migration is pending, -1 will be returned.
   */
  nextMigrationVersion: function(type: !Type): !int

  /**
   * Sets the migration state as completed for a migration function.
   *
   * @param type
   *        Migration type to set the status for
   *
   * @param func
   *        Migration function that was completed
   *
   * @return the next migration step that needs to be applied (if any) for the migration type.
   */
  migrationCompleted: function(type: !Type, func: !string): string

  /**
   * Called during first start of an app.  Sets all of the migration functions as completed to avoid applying them.
   */
  initialize: function()

  /**
   * @return true if the app has been initialized for schema migrations.  False means that the app is being
   *         deployed/started for the first time and no schema migrations are required.
   */
  isInitialized: function(): boolean

  /**
   * @return true if any {@link PlatformSchemaMigration} functions need to be applied.
   */
  needsPlatformSchemaMigration: function(): boolean

  /**
   * @return true if any {@link SchemaUpgrade} functions need to be applied.
   */
  needsAppMigration: function(): boolean

  /**
   * Applies all pending app level {@link SchemaUpgrade} functions.
   */
  applyAppMigrations: function()
}
