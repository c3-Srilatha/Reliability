/**
 * Spec for the @link{InsertNewBaseTypeBatchJob} started from @link{SchemaUpgrade.insertNewBaseType}.
 */
type InsertNewBaseTypeOptions mixes BatchJobOptions {

  /**
   * The root table name for the old base type.
   */
  oldRootTableName: !string

  /**
   * Mapp of sql insert statements keyed by old table name
   */
  sqlInsertStmts: map<string, string>

  /**
   * Mapp of sql delete statements keyed by old table name
   */
  sqlDeleteStmts: map<string, string>

  /**
   * True if data should be removed from the old tables after being copied to the new tables.
   */
  removeOldData: boolean
}
