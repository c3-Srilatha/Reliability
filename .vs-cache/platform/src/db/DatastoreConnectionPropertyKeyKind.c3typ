/**
 * Enum for different "kinds" of datastore connection keys that are used for properties  (e.g. currently "c3.db" or "c3.datastore.kind")
 */
enum type DatastoreConnectionPropertyKeyKind {

  /**
   * C3 Database
   */
  C3_DATABASE

  /**
   * C3 Datastore Kind
   */
  C3_DATASTORE

  /**
   * C3 Datastore Config Name
   */
  C3_DATASTORE_CONFIG_NAME

  /**
   * TLS JAVA KEYSTORE
   */
  TLS_JAVA_KEYSTORE = "javax.net.ssl.keyStore"

  /**
   * TLS JAVA KEYSTORE.PASSWORD
   */
  TLS_JAVA_KEYSTORE_PASSWORD = "javax.net.ssl.keyStorePassword"

  /**
   * TLS JAVA TRUSTSTORE
   */
  TLS_JAVA_TRUSTSTORE = "javax.net.ssl.trustStore"

  /**
   * TLS JAVA TRUSTSTORE.PASSWORD
   */
  TLS_JAVA_TRUSTSTORE_PASSWORD = "javax.net.ssl.trustStorePassword"

  /**
   * TLS cert hash string, used for verifying if the cert has changed. See {@link TlsCertificate}
   */
  CERT_HASH
}
