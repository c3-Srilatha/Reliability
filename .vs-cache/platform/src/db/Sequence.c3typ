/**
 * To support sequence generation that is consistent in cluster.
 * e.g: Pkg.Store.Seq, ExMachina.Seq
 */
abstract entity type Sequence mixes DefaultInstance {

  /**
   * Tracking what the prev sequence number used.
   */
  seq: private int

  inst: ~

  /**
   * Get the next sequence number by incrementing the prev used sequence number.
   */
  next: member function(): int
}
