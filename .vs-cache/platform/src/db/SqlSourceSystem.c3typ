/**
 * Type store information of the live source system which uses a jdbc connection
 */
@cache(dependencies=['SourceSystem'], all=true)
@db(domain='system')
type SqlSourceSystem mixes ExternalSourceSystem {

  /**
   * Infers/creates the {@link TypeMeta} for multiple collections.  Equivalent to calling {@link inferSourceType2} for
   * each of the collections plus the creation of refs/fkey refs inferred from the underlying metadata between the
   * input collections.
   *
   * Note that all input collections must be for this source system.  An error will be returned if that is not the case.
   *
   * @return the requested types
   */
  inferSourceTypes: member function(colls: [SqlSourceCollection]): [TypeMeta]

  /**
   * get a jdbc connection to SqlSourceSystem
   */
  connect: member function(): !Jdbc

  /**
   * Preview specified table.
   *
   * @param tableName
   *        name of the table to preview tuples. The name may be qualified or unqualified.
   * @param limit
   *        number of rows to return.
   * @return
   *        Array of CellTuple. First CellTuple is a tuple of column names.
   */
  @beta
  previewTable: member function(tableName: !string, limit: int = 20): PreviewTableResult

  ping: ~

  /**
   * Sets the credentials (app level) for the JdbcStore matching the name of this instance and sets the associated
   * `JdbcStore` to be external.  Note that this will return an error if the datastore for
   * this instance is in use by any entity type (e.g. name matches the datastore name of the entity type specified
   * by @db(datastore) or @db(domain)).
   *
   * @param creds
   *        Credentials to set
   */
  setCredentials: ~

  /**
   * Removes the credentials (e.g. app level config) for the JdbcStore matching the name of this instance if those
   * credentials were set via {@link setCredentials}.  If credentials exist and they are not app level or were not set
   * via {@link setCredentials}, then an error will be returned.  Also note that this will return an error if the
   * datastore for this instance is in use by any entity type (e.g. name matches the datastore name of the entity type
   * specified by @db(datastore) or @db(domain)).
   */
  removeCredentials: ~

  credentials:            ~
  credentialsWithSecrets: ~
}
