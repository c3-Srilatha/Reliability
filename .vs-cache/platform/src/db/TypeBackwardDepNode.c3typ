/**
 * Node in a {@link TypeBackwardDep}.  A node is s step in the backward dependency path indicating a type and a field
 * path in that type that will be traversed when processing invalidations involving the path.
 */
type TypeBackwardDepNode {

  /**
   * Name of type for the node.
   */
  nodeTypeName: string

  /**
   * Field path for the node
   */
  field: string

  /**
   * Field path for the node in the including stored type for the node
   */
  fieldPathInIncludingStoredType: string

  /**
   * @return true if the node is for an fkey field.
   */
  isFkeyNode: boolean

  /**
   * If the node is an fkey node, the name of the type referenced by the fkey field
   */
  fkeyTypeName: string

  /**
   * Name of the fkey field in the referenced type for an fkey node
   */
  fkeyRefFkeyField: string

  /**
   * Name of the key field for an fkey node
   */
  fkeyRefKeyField: string

  /**
   * Next step in the path to the target field paths.  If null, then this is the final node in the path.
   */
  parent: TypeBackwardDepNode

  /**
   * Type for the node.
   */
  nodeType: inline member function(): Type

  /**
   * @return the java FieldPath for the node.
   */
  fieldPath: inline member function(): @java(class="c3.platform.typesys.type.FieldPath") native

  /**
   * @return the java FieldPaths to use for a join for the node.
   */
  joinFieldPaths: inline member function(): [@java(class="c3.platform.typesys.type.FieldPath") native]

  /**
   * @return the fkey "fkey" field path if the node is an fkey field.
   */
  fkeyFkeyFieldPath: inline member function(): @java(class="c3.platform.typesys.type.FieldPath") native

  /**
   * @return the cols in the referenced type for the fkey "fkey" field path if the node is an fkey field.
   */
  fkeyFkeyCols: inline member function(): [string]

  /**
   * @return the fkey "key" field path if the node is an fkey field.
   */
  fkeyKeyFieldPath: inline member function(): @java(class="c3.platform.typesys.type.FieldPath") native

  /**
   * @return the columns for the "key" field path if the node is an fkey field.
   */
  fkeyKeyCols: inline member function(): [string]

  /**
   * @return the root node (e.g. the node on the target end of the path).
   */
  rootNode: inline member function(): TypeBackwardDepNode

  /**
   * @return a stringified representation of the node.
   */
  toString: inline member function(): !string
}
