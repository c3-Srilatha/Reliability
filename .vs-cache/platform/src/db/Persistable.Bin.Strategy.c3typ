/**
 * Strategies for binning ids into "logical groups" or bins.
 * A bin "number" (or referred to as **bin**) is an int which uniquely identifies the "bin" within a strategy.
 * Please note that it is guaranteed that an id MUST belong to a specific bin and MUST NOT change once initialized. A
 * mapping of an existing id may only change using an explicit action {@link #init}.
 * Please note that {@link Fingerprint.longHashCode} will be used for hashing the {@link #id} to a **int** value and in the remote case where we actually encounter a collision in the wild, its recommended to change the id of the instance.
 */
extendable entity type Persistable.Bin.Strategy type key 'PBS' {

  /**
   * @return **true** after initializing the current strategy from the input strategy. **false** will be returned and nothing will happen if the current strategy is already initialized.
   */
  initSame: member function(strategy: !Persistable.Bin.Strategy): boolean

  /**
   * @return **true** if the strategy is already initialized or not.
   */
  isInitialized: member function(): boolean

  /**
   * Initialize the strategy with an explicit mapping of subject to bin. This is the only way to add a "custom mapping".
   */
  init: member function(binMap: !map<string, int>): boolean

  /**
   * @return the state instance of the current strategy if its initialized, null otherwise.
   */
  state: private property(): Persistable.Bin.Strategy.Custom.State

  /**
   * @return the bin for the provided **id**
   */
  bin: member function(id: !string): int

  /**
   * @return a map of id to bin for the given strategy
   */
  bins: member function(subjectIds: !set<string>): map<string, int>

  /**
   * @return a map of bin to the set of subjects belonging to that bin.
   */
  groupedBins: member function(subjectIds: !set<string>): map<int, set<string>>

  beforeRemove: ~

  /**
   * Remove any state associated with the concrete (to be removed) strategy instances.
   */
  doRemoveState: private function(objs: !?[mixing Persistable.Bin.Strategy])
                           : !ObjList<mixing Persistable.Bin.Strategy>
}
