/**
 * Result returned from {@link DbAdmin#getDuplicateIndexes} and  {@link DbAdmin#removeDuplicateIndexes}.
 */
type DbAdmin.GetDuplicateIndexesResult {

  /**
   * Total number of duplicates found/processed for all tables
   */
  totalDuplicates: !int

  /**
   * Duplicate index info map, keyed by table name
   */
  byTable: map<string, DbAdmin.GetDuplicateIndexesTableInfo>
}
