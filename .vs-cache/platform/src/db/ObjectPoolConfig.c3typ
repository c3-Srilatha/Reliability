type ObjectPoolConfig {

  /**
   * Minimum number of idle instances in the pool.
   */
  minIdle: !int32 = 0

  /**
   * Maximum number of idle instances in the pool.  Default is
   * 'org.apache.commons.pool.impl.GenericObjectPool.DEFAULT_MAX_IDLE' (e.g. 8).  This is  not specified as a
   * post default to allow overrides to know whether it has been manually set or not.
   */
  maxIdle: int32

  /**
   * Maximum total number of instances in the pool.  Default is
   * 'org.apache.commons.pool.impl.GenericObjectPool.DEFAULT_MAX_ACTIVE' (e.g. 8).  This is  not specified as a
   * post default to allow overrides to know whether it has been manually set or not.
   */
  maxTotal: int32

  /**
   * Maximum amount of time borrow will wait if an instance is not available before throwing an exception.
   */
  maxWaitMillis: !int = -1

  /**
   * Minimum amount of time an instance can remain idle before being considered for eviction.
   */
  minEvictableIdleTimeMillis: !int = 30000

  /**
   * Time between evicition runs.
   */
  timeBetweenEvictionRunsMillis: !int = 15000

  /**
   * Maximum age of shared connection that can still be shared by additional threads.
   */
  maxSharableAgeMinutes: !int32 = 5

  /**
   * @return a java class containing the parameters to be set on the underlying GenericObjectPool
   */
  getJavaParams: member function(): @java(class="c3.platform.db.ObjectPoolParams") !native
}
