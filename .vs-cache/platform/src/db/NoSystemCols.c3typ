/**
 * Persistable types that mixin this type will have no system columns (e.g. APP_CODE, CREATED, etc.).  They will
 * by default have the ID column but that can be overridden by either changing the schema name for the id field or
 * mixing in a CompositeKey type
 */
abstract type NoSystemCols {

  name:             string not persistable
  meta:             Meta not persistable
  version:          int32 not persistable
  versionEdits:     private [VersionEdit] not persistable
  typeWithBindings: private Type not persistable
}
