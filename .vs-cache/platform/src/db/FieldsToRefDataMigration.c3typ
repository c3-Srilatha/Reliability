/**
 * configuration for generating data migration sql for creating refs to new or existing objects based on fields
 *
 * in source entity
 */
type FieldsToRefDataMigration {

  /**
   * name of the target entity type
   */
  targetEntityType: Type

  /**
   * configuration for generating data migration sql for fields of the new entity
   */
  targetFields: [FieldDataMigration]
}
