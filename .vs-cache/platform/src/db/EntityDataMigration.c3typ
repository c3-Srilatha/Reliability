/**
 * configuration for generating data migration sql for a single entity type
 */
type EntityDataMigration {

  /**
   * entity type name in current release
   */
  entityType: Type

  /**
   * entity type name in previous release; if not set then new type will be used instead
   */
  oldEntityType: Type

  /**
   * if this is a primary type mapping for oldEntityType
   */
  isPrimary: boolean

  /**
   * arry or map field name in the old entity type; this is only used when new entity type is migrated from an old array or map
   */
  oldFieldPath: string

  /**
   * custom sql where clause to add to source entry type query
   */
  whereSql: string

  /**
   * configuration for generating data migration sql for fields
   */
  fieldMigrations: [FieldDataMigration]

  /**
   * optional name of the sql stored procedure that will be invoked for every old record after
   *
   * they have been successfully migrated; proc should have 2 IN param: appCode and srcId;
   */
  afterSqlProcName: string
}
