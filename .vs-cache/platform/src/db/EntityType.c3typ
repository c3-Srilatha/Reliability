/**
 * A node in the type hierarchy for an instance of an extended type. Used as the return type for
 * {@link Persistable#typeOf} and the {@link Meta#typeHierarchy} field.
 *
 * WARNING - EntityType must never be used in any persistable field as it is inherently
 *           recursive and that is not well supported.
 */
type EntityType {

  /**
   * Type for this hierarchy node.
   */
  typeRef: Type

  /**
   * Immediate base EntityType node.
   */
  base: EntityType

  /**
   * Immediate extension EntityType node.  Since we only support a strict type hierarchy
   * at the instance level, there is at most one extension type for a node.
   */
  extension: EntityType

  /**
   * Gets the type leaf type for an entity type node instance.  The leaf type is the
   * type specified in the {@link typeRef} field for the node that has a null
   * {@link extension}.
   *
   * @param entityTypeObj
   *          node instance to get the leaf type for.
   * @return the leaf type for the node
   */
  @deprecated
  leafType: function(entityTypeObj: Obj): Type js

  /**
   * @return the type leaf type for an entity type node instance.  The leaf type is the
   * type specified in the {@link typeRef} field for the node that has a null
   * {@link extension}.
   */
  leaf: member function(): Type
}
