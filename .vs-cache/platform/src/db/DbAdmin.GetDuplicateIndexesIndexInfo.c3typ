/**
 * Info returned for a single index that has duplicates as part of the return result from
 * {@link DbAdmin#getDuplicateIndexes} and {@link DbAdmin#removeDuplicateIndexes}.
 */
type DbAdmin.GetDuplicateIndexesIndexInfo {

  /**
   * Table on which the indexes are defined
   */
  tableName: string

  /**
   * Number of duplicates found/processed for this index
   */
  numDuplicates: !int

  /**
   * Index definition that has one or more duplicates
   */
  index: DbAdmin.GetTableIndexesResult

  /**
   * Names of indexes that are duplicates of {@link index}.  A duplicate index has the same column definitions and
   * uniqueness
   */
  duplicates: [string]
}
