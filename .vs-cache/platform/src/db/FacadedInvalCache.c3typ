/**
 * Cache for facaded TypeBackwardDep info
 */
type FacadedInvalCache mixes Cached {

  /**
   * Map of type names to their base TypeRefs.
   */
  baseTypeMap: map<string, Type>

  /**
   * Map of type names to their extension TypeRefs.
   */
  extensionTypeMap: map<string, [Type]>

  /**
   * Listener metrics grouped by name + src type.
   */
  metricsByNameAndSrcType: map<string, string>

  /**
   * Metrics that have listeners.
   */
  listenerMetrics: [string]

  /**
   * Simple metric names keyed by id.
   */
  metricNamesById: map<string, string>

  /**
   * Analytic listener metric groups, keyed by metric id.
   */
  analyticsListenerMetricGroups: map<string, [string]>

  /**
   * Simple metric source types keyed by metric id
   */
  metricSrcTypes: map<string, Type>

  /**
   * As timeseries metric dep info
   */
  asTsMetricDeps: ListenerAsTsMetricsCacheEntry

  /**
   * As timeseries metric exprs, keyed by metric id
   */
  asTsMetricExprsByMetricId: map<string, AsTsMetricExprs>

  /**
   * Gets the base type TypeRef for a TypeRef.
   *
   * @param appCode
   *        App code for app that facades into this app.
   * @param type
   *        TypeRef to get the base TypeRef for.
   *
   * @return the requested base type TypeRef.
   */
  baseTypeForType: inline function(appCode: !int, type: !Type): Type

  /**
   * Gets the root type TypeRef for a TypeRef.
   *
   * @param appCode
   *        App code of app that facades into this app.
   * @param type
   *        TypeRef to get the root TypeRef for.
   *
   * @return the requested base type TypeRef.
   */
  rootTypeForType: inline function(appCode: !int, type: !Type): Type

  /**
   * Gets the extension type TypeRefs for a TypeRef.
   *
   * @param appCode
   *        App code for app that facades into this app.
   * @param type
   *        TypeRef to get the extension TypeRefs for.
   *
   * @return the requested extension type TypeRefs.
   */
  extensionTypesForType: inline function(appCode: !int, type: !Type): [Type]

  /**
   * Gets a specific metric by its name and src type
   *
   * @param appCode
   *        App code that facades into this app.
   * @param metricName
   *        Metric name.
   * @param srcType
   *        Source type.
   *
   * @return Requested metric.
   */
  metricForNameAndSrcType: inline function(appCode: !int, metricName: !string, srcType: !string): string

  /**
   * Gets a specific metric by its name and src type id
   *
   * @param appCode
   *        App code for app that facades into this app.
   * @param metricName
   *        Metric name.
   * @param srcTypeId
   *        Source type id.
   *
   * @return Requested metric.
   */
  metricForNameAndSrcTypeId: inline function(appCode: !int, metricName: !string, srcTypeId: !int): string

  /**
   * Determines if a metric has any listeners
   *
   * @param appCode
   *        App code for app that facades into this app.
   * @param metricId
   *        Metric id.
   *
   * @return True if the metric has any listeners.
   */
  metricHasListener: inline function(appCode: !int, metricId: !string): boolean

  /**
   * Gets the name of a metric by its id
   *
   * @param appCode
   *        App code for app that facades into this app.
   * @param metricId
   *        Metric id.
   *
   * @return The name of the SimpleMetric with the specified id.
   */
  metricName: inline function(appCode: !int, metricId: !string): string

  /**
   * Gets the name of a metric by its id
   *
   * @param appCode
   *        App code for app that facades into this app.
   * @param metricId
   *        Metric id.
   *
   * @return The metric groups for the analytic.
   */
  analyticMetricGroups: inline function(appCode: !int, metricId: !string): [string]

  /**
   * Gets the source type for a metric
   *
   * @param appCode
   *        App code for app that facades into this app.
   * @param metricId
   *        Metric id.
   *
   * @return The metric groups for the analytic.
   */
  metricSrcType: inline function(appCode: !int, metricId: !string): Type

  /**
   * Gets the as timeseries metric deps for a type.
   *
   * @param appCode
   *        App code for app that facades into this app.
   * @param type
   *        Type to get the deps for
   *
   * @return The as timeseries metric deps for the type
   */
  asTsDepsForType: inline function(appCode: !int, type: !Type): [AsTsMetricDep]

  /**
   * Gets the as timeseries metric exprs for a metric.
   *
   * @param appCode
   *        App code for app that facades into this app.
   * @param metricId
   *        Metric id to get exprs for
   *
   * @return The as timeseries metric dep exprs for the metric.
   */
  asTsMetricExprs: inline function(appCode: !int, metricId: !string): AsTsMetricExprs

  produce: ~
}
