abstract type Db mixes Value {

  /**
   * removes c3 schema from the database
   */
  wipe: function()

  /**
   * generates sql script that can be used for data migration
   */
  genDataMigrationSql: function(spec: DataMigrationSpec, oldTag: TagRef, execute: boolean): [SqlScript]

  /**
   * migrates data stored in oracle as xml documents
   */
  migrateXmlDocs: function(spec: DataMigrationSpec, oldTag: TagRef): map<string, [ObjError]>

  /**
   * flushes and discards data-store caches - only needed for performance testing to emulate cold run
   */
  flushDbCaches: function()

  upgradeColumn:         function(typeRef: Type, fieldName: string): int
  locHierDenorm:         function()
  defaultDatastoreName:  function(): !string
  datastoreKindFromType: function(typeInstance: !Type): !string

  /**
   * RDBMS endpoint
   */
  @action(group+='cluster-admin')
  datastoreEndpoint: private function(): Url

  /**
   * Cassandra endpoints
   */
  @action(group+='cluster-admin')
  cassandraEndpoint: private function(): [Url]

  /**
   * c3 db properties
   */
  @action(group+='cluster-admin')
  c3DbUser: private function(): !string

  @action(group+='cluster-admin')
  c3DbPass: private function(): !string

  @action(group+='cluster-admin')
  c3DbName: private function(): !string

  /**
   * Secondary db properties
   */
  @action(group+='cluster-admin')
  secDbUser: private function(): !string

  @action(group+='cluster-admin')
  secDbPass: private function(): !string

  @action(group+='cluster-admin')
  secDbName: private function(): !string

  /**
   * returns sql for creating a postgres user
   */
  createUserSqlPg: private function(user: !string, password: !string): string

  /**
   * returns sql for creating a redshift user
   */
  createUserSqlRedshift: private function(user: !string, password: !string): string

  /**
   * returns sql for querying the databases in postgres
   */
  selectDatabaseSqlPg: private function(dbName: !string): string

  /**
   * returns sql for querying the databases in redshift
   */
  selectDatabaseSqlRedshift: private function(dbName: !string): string

  /**
   * returns sql to create a database in postgres
   */
  createDatabaseSqlPg: private function(dbName: !string, owner: !string): string

  /**
   * returns sql to create a database in redshift
   */
  createDatabaseSqlRedshift: private function(dbName: !string, owner: !string): string

  /**
   * Internal method used by nodes to update each other on their sql statements
   */
  updateNodeSqlStatements: function(stmts: [NodeSqlStatements]): [NodeSqlStatements]

  /**
   * Returns all known nodes sql statements
   */
  @action(group+='monitor')
  nodeSqlStatements: function(): [NodeSqlStatements]
}
