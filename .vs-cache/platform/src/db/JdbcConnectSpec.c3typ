/**
 * Spec for Jdbc connection configuration.
 */
@deprecated(finalVersion='7', details='Use JdbcCredentials')
type JdbcConnectSpec mixes ConnectSpecInfo, Spec, JdbcCredentialsFields {

  /**
   * @return JdbcStore compatible credentials.
   */
  credentials: inline member function(): !JdbcCredentials

  /**
   * @return a JdbcConnectSpec based on JdbcStore compatible credentials.
   */
  fromCredentials: inline function(creds: !JdbcCredentials): !JdbcConnectSpec
}
