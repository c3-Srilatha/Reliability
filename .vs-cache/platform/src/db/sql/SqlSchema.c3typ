/**
 * Schema returned from {@link Persistable#schema} for sql based types.
 */
type SqlSchema mixes SchemaInfo {

  /**
   * Root table name.
   */
  rootTableName: string

  /**
   * @return tables used by the type.
   */
  tables: member function(): [SqlTable]

  /**
   * @return all tables used by the type and any of its extension types.
   */
  allTables: member function(): [SqlTable]

  /**
   * Gets the subset of the type's schema for the specified field path. If the field path is
   * for a non-collection field in the root type, this will be a single table/column.  If it
   * traverses non-fkey child collections, then it will contain all tables/columns that would
   * be returned with that field path as an include spec.
   *
   * Note that traversal outside of the type is not supported (e.g. only tables/columns "owned" by
   * the type will be included and any field path that traverses outside of the type will throw an error).
   *
   * @param fieldPath
   *        Field path to get the schema for.
   *
   * @return The requested schema.
   */
  fieldSchema: member function(fieldPath: !string): !SqlFieldSchema
}
