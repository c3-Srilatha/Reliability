/**
 * Components of a duration.  Can be used to go to/from {@link Duration} instances for apis that require components
 * (e.g. Native DB persistence as INTERVAL values)
 */
type DurationComponents {

  /**
   * Combines seconds, milliseconds and microseconds
   */
  secondsWithMicroseconds: property(): !double

  days:         !int
  hours:        !int
  minutes:      !int
  seconds:      !int
  milliseconds: !int
  microseconds: !int

  /**
   * Create a new instance from the individual component values
   */
  fromValues: inline function(days: !int,
                              hours: !int,
                              minutes: !int,
                              seconds: !int,
                              milliseconds: !int,
                              microseconds: !int): !DurationComponents

  /**
   * Create a new instance from an instance of {@link Duration}
   */
  fromDuration: inline function(duration: !Duration): DurationComponents

  /**
   * Create a new instance from an instance of {@link Duration}
   */
  toDuration: inline member function(): Duration
}
