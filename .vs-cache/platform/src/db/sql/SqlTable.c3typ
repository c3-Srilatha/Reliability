/**
 * Table returned in {@link SqlSchema.allTables} and {@link SqlSchema.allExtensionTables}.
 */
type SqlTable {

  /**
   * Name of the table.
   */
  name: string

  /**
   * Schema the table exists in.
   */
  schema: string

  /**
   * Type that first defines the table (e.g. defines an arry/mapp field using the table).
   */
  ownerType: Type

  /**
   * Type of the table itself (e.g. root, mapp, etc.)
   */
  tableType: string enum SqlTableTypeEnum

  /**
   * Collection field that uses the table.  Will be null for non-collection tables.
   */
  collectionField: string

  /**
   * All of the columns defined in the table.
   */
  columns: [SqlColumn]

  /**
   * Indexes defined on the table.
   */
  indexes: [Db.Index]

  /**
   * The primary key index defined on the table.
   */
  primaryKey: Db.Index

  /**
   * Foreign keys defined on the table.
   */
  foreignKeys: [SqlForeignKey]

  /**
   * Foreign keys defined on other tables that refer to this tables primary key
   */
  foreignKeyRefs: [SqlForeignKey]
}
