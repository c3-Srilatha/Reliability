/**
 * Database query plan returned in {@link FetchResult#queryPlans} if {@link FetchSpec#explain} is set to true.
 */
type QueryPlan mixes SqlStmt {

  /**
   * Connection string for the data source that issued the database request.
   */
  connection: string

  /**
   * Elapsed time (in milliseconds) for the query to be executed by the database (does not include retrieving any results).
   */
  time: int

  /**
   * Query execution plan returned by the backend database for the issued statement.
   */
  plan: string

  /**
   * For those datastores that support it, the estimated number of rows that will be returned by the query.
   */
  estimatedRowCount: int = -1
}
