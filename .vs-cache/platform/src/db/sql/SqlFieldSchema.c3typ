/**
 * Schema returned from {@link SqlSchema.fieldSchema} .
 */
type SqlFieldSchema mixes SchemaInfo {

  /**
   * Field path the schema is for.
   */
  fieldPath: string

  /**
   * Columns used by the schema, keyed by table name.
   */
  columnsByTable: map<string, [SqlFieldSchemaCol]>

  /**
   * Only used for  identifying test results for verification.  Otherwise, not used by the system at all.
   */
  id: private string
}
