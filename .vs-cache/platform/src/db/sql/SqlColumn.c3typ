/**
 * Column returned in {@link SqlTable.columns}
 */
type SqlColumn {

  /**
   * Name of the column.
   */
  name: !string

  /**
   * Data type (from java.sql.types)
   */
  dataType: int

  /**
   * Vendor specific data type.
   */
  vendorDataType: string

  /**
   * Length as reported by the db.
   */
  length: int

  /**
   * Precision, where appropriate, as reported by the db.
   */
  precision: int

  /**
   * Scale, where appropriate, as reported by the db.
   */
  scale: int
}
