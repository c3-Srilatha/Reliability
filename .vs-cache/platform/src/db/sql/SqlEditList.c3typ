/**
 * Db engine/sql edit list types - FOR INTERNAL USE Only
 */
type SqlEditList mixes EditList {

  /**
   * list of edits
   */
  fieldEdits: !map<string, SqlFieldEdit>

  /**
   * Obj containing fields not defined in the declared field's type (e.g. for heterogeneous included refs)
   */
  mixinObj: Obj

  /**
   * If true, the serialized ref (e.g. for heterogeneous included refs) should be removed.
   */
  removeMixinObj: boolean

  /**
   * Type of actual ref if field's value type is a heterogeneous non-included ref with the field's reference type being
   * abstract or extendable.
   */
  mixinType: private Type

  /**
   * If true, the type for the heterogeneous non-included ref should be removed
   */
  removeMixinType: private boolean
}
