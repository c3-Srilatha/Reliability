/**
 * Holds data in binary format under a specific key for SQL systems. Types that mix KvStore can use this in the case of an
 * only SQL environment to effectively mimic the functionality of a NoSql datastore.
 */
@db(unique=['table, key'], index=["table,key"])
entity type SqlKvStoreData schema name 'KV' {

  /**
   * Represents the type that is being stored for this object
   */
  table: !string

  /**
   * Should represent a unique id for each persisted entity for the type specified in table
   */
  key: !string

  /**
   * A "blob" store that is designed to hold Mapp<String, Object> where the key is the column name
   */
  // TODO: PLAT-60118 remove h2UseClobCol annotation
  @db(h2UseClobCol=true)
  @deprecated(finalVersion="8.11", details="Use jsonValue instead")
  value: any

  /**
   * A "blob" store that is designed to hold json where the key is the column name.
   */
  // TODO: PLAT-60118 remove h2UseClobCol annotation
  @db(h2UseClobCol=true)
  jsonValue: json
}
