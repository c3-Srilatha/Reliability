/**
 * Foreign key definition for a table
 */
type SqlForeignKey {

  /**
   * Name of the foreign key
   */
  name: string

  /**
   * Table owning the foreign key
   */
  fkTable: string

  /**
   * Table owning the primary key referenced by the foreign key
   */
  pkTable: string

  /**
   * Columns the foreign key is made up of
   */
  columns: [SqlForeignKeyColumn]
}
