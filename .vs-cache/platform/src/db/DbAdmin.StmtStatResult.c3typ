/**
 * Result row returned from {@link DbAdmin.getStmtStats}.
 */
type DbAdmin.StmtStatResult {

  /**
   * Name of user who executed the statement
   */
  userName: string

  /**
   * Name of database in which the statement was executed
   */
  dbName: string

  /**
   * Text of a representative statement
   */
  query: string

  /**
   * Number of times executed
   */
  numCalls: int

  /**
   * Total time spent in the statement, in milliseconds
   */
  totalTimeMillis: double

  /**
   * Total number of rows retrieved or affected by the statement
   */
  numRows: int

  /**
   * Total number of shared block cache hits by the statement
   */
  numSharedBlkCacheHits: int

  /**
   * Total number of shared blocks read by the statement
   */
  numSharedBlksRead: int

  /**
   * Total number of shared blocks dirtied by the statement
   */
  numSharedBlksDirtied: int

  /**
   * Total number of shared blocks written by the statement
   */
  numSharedBlksWritten: int

  /**
   * Total number of local block cache hits by the statement
   */
  numLocalBlksHit: int

  /**
   * Total number of local blocks read by the statement
   */
  numLocalBlksRead: int

  /**
   * Total number of local blocks dirtied by the statement
   */
  numLocalBlksDirtied: int

  /**
   * Total number of local blocks written by the statement
   */
  numLocalBlksWritten: int

  /**
   * Total number of temp blocks read by the statement
   */
  numTempBlksRead: int

  /**
   * Total number of temp blocks written by the statement
   */
  numTmpBlksWritten: int

  /**
   * Total time the statement spent reading blocks, in milliseconds (if track_io_timing is enabled, otherwise zero)
   */
  blkReadTimeMillis: double

  /**
   * Total time the statement spent writing blocks, in milliseconds (if track_io_timing is enabled, otherwise zero)
   */
  blkWriteTimeMillis: double
}
