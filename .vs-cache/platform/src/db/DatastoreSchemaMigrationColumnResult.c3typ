/**
 * Single column result returned in {@link DatastoreSchemaMigrationTableResult#columns}
 */
type DatastoreSchemaMigrationColumnResult {

  /**
   * Name of the migrated column
   */
  name: string

  /**
   * Original name of the migrated column
   */
  origName: string

  /**
   * Data type of the migrated column
   */
  dataType: string

  /**
   * Original data type of the migrated column
   */
  origDataType: string

  /**
   * True if the column with the new name already existed and therefore the data from the column with the original name
   * was merged into that column, rather than renaming.
   */
  merged: boolean
}
