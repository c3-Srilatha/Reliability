/**
 * Credentials configuration for Jdbc connection.
 */
abstract type JdbcCredentialsFields mixes ConnectSpecInfoBase, KerberosSpec, ServicePlugin {

  /**
   * The Url pointing to the database. The valid format is "jdbc:<dataStore>://<serverEndPoint:port>/<database>
   * Url could also be built from {@link JdbcConnectSpec#dataStore}, {@link JdbcConnectSpec#serverEndPoint}, {@link JdbcConnectSpec#port},
   * {@link JdbcConnectSpec#database} by following the above format. This url field will be preferred if the rest variables
   * in the spec are provided as well when establishing Jdbc connection.
   *
   * Example: "jdbc:postgresql://localhost/testdb" for connection to testdb in a postgresSql instance.
   */
  url: ~

  /**
   * Kind of the {@link Datastore datastore}
   */
  datastore: string enum DatastoreType

  /**
   * Name of the database going to be connected. (ex: 'my_database_name')
   */
  database: string

  /**
   * For datastores that support it (e.g. currently only snowflake), the schema to be used for accessing tables
   * in the database.  If not specified then the default schema for the database/user will be used if one exists.
   * Otherwise, the table schema names should be fully qualified.
   */
  schemaName: string

  /**
   * Driver class name of the database.  If not provided, this will be inferred from the other parameters.
   *
   * Ex: 'org.postgresql.Driver' for Postgres.
   */
  driverClassName: string

  /**
   * Role used when auto-creating the db.
   */
  role: string

  /**
   * @return The url to use for connection via jdbc.  If a url is provided in the spec, that will be returned.
   *         Otherwise the url will be constructed from the components.
   */
  safeUrl: inline member function(): string

  /**
   * return The datastore to use with the connection.  If the `datastore` field is set, it will return that.
   *        Otherwise it will infer the value from the url.
   */
  safeDatastoreType: inline member function(): string enum DatastoreType

  /**
   * @return The properties to use with the connection.  It will combine any specified in the spec, in both the
   *         properties and secretProperties fields, with datastore specific defaults.
   */
  safeProperties: inline member function(): map<string, any>

  /**
   * @return either the `driverClassName` specified in the spec, or inferred from the other parameters if not.
   */
  safeDriverClassName: inline member function(): !string

  /**
   * @return either the `database` specified in the spec, or '<unspecified>' if only a url is specified.  Note
   *   that specifying a url, calling {@link fromServerEndpoint} is preferred.
   */
  safeDatabase: inline member function(): !string

  /**
   * Constructs (but doesn't persist) an instance from a url.
   *
   * @param url
   *        Url to construct instance from.
   * @param username
   *        Username to connect with.
   * @param password
   *        Password to connect with.
   *
   * @return The constructed instance.
   */
  @deprecated(finalVersion='7', details='Use {@link fromEndpoint')
  fromUrl: function(url: !string, username: string, password: string): !mixing JdbcCredentialsFields

  /**
   * Constructs (but doesn't persist) an instance from a url.
   *
   * @param serverEndpoint
   *        Server endpoint to connect to.
   * @param port
   *        Port to connect to.
   * @param datastoreType
   *        Datastore type to connect to.
   * @param database
   *        Name of the database going to be connected. (ex: 'my_database_name')
   * @param schemaName
   *        For datastores that support it (e.g. currently only snowflake), the schema to be used for accessing tables
   *        in the database.  If not specified then the default schema for the database/user will be used if one exists.
   *        Otherwise, the table schema names should be fully qualified.
   * @param username
   *        Username to connect with.
   * @param password
   *        Password to connect with.
   *
   * @return The constructed instance.
   */
  fromServerEndpoint: function(serverEndpoint: !string,
                               port: !int,
                               datastoreType: !string enum DatastoreType,
                               database: string,
                               schemaName: string,
                               username: string,
                               password: string): mixing JdbcCredentialsFields
}
