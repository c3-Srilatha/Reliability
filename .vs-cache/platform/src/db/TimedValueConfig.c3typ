@config(minOverride=APP, maxOverride=APP)
type TimedValueConfig mixes Config {

  /**
   * If false, then during upserts of types that mixin `TimedValueHistory`, entries will be automatically de-duped and
   * new entries won't be created if the current state contains the specified value at the specified time.  If true,
   * no de-duping will be done in this case.
   */
  retainAllTimestamps: boolean
}
