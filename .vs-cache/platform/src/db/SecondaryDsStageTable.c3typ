/**
 * Stage information for tables in a secondary datastore update operation.
 */
type SecondaryDsStageTable {

  /**
   * Physical table that data is being staged for.
   */
  tableName: !string

  /**
   * Columns defined in the table.
   */
  colNames: [string] schema suffix 'CN'

  /**
   * Name of id column in the table being staged.
   */
  idColName: !string

  /**
   * True if the table being staged is the root table for the type.
   */
  isRoot: boolean

  /**
   * Name of key column if the table being staged is a child table
   */
  keyColName: string

  /**
   * Number of key/parent key columns if the table being staged is a child table.
   */
  numKeyCols: int = 0

  /**
   * Key associated with the overall {@link SecondaryDsUpsert.upsertObjs} operation.
   */
  upsertKey: !string

  /**
   * Directory that will contain all of the individual files staged for the table.
   */
  dir: !string

  /**
   * Staged files for the table.
   */
  fileList: FileList schema suffix 'FL'
}
