/**
 * Pending newly created/modified stored calcs that require refreshing found in provisioning.
 */
entity type PendingRefreshStoredCalcReq extends PendingRefreshReq type key 'CALC' {

  /**
   * Calc fields to refresh
   */
  calcFields: [string] schema name 'CF'

  doRefresh: ~
}
