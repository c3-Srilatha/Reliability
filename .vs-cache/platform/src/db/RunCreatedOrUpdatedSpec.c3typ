/**
 * Spec passed to {@link Persistable#runCreatedOrUpdated} to control its behavior.
 */
type RunCreatedOrUpdatedSpec mixes ObjBatch, Spec {

  /**
   * If set to true, then only the created function will be called if it exists.  If set to false, then whichever function exists will be called or only updated
   * will be called if both exist.
   */
  createdOnly: boolean = false

  /**
   * If true, then the function will only be called if it is defined/overridden on the type itself.  If false, then it will be called if any base type defines/overrides it.
   */
  excludeBaseTypeFunctions: boolean = false
}
