/**
 * Health check of all configured datastores use by the server. The #name is the official name of the underlying
 * database system.
 */
type DatastoreHealthCheck mixes HealthCheck {

  /**
   * Check whether PostgreSQL is healthy. This is one of the checks performed by {@link poll}.
   */
  checkPostgresHealth: function(): boolean
}
