/**
 * configuration for generating data migration sql for a single primitive field
 */
type FieldDataMigration {

  /**
   * dot separated path of the field in root entity
   */
  path: string

  /**
   * old path of the field if field was renamed or moved
   */
  srcPath: string

  /**
   * optional column value transform sql
   */
  columnSql: string

  /**
   * custom sql where clause to add to source entry map table; only valid for array and map fields
   */
  whereSql: string

  /**
   * optional external ref specification if given field value should be replaced with a reference to a new
   *
   * or existing external ref
   */
  newRef: FieldsToRefDataMigration
}
