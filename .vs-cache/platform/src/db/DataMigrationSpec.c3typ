/**
 * configuration for generating data migration sql via Db.genDataMigrationSql
 */
type DataMigrationSpec mixes Spec {

  /**
   * list of sql scripts that should be executed before the data migration;
   *
   * e.g. you can defined stored procedures or functions here
   */
  beforeSqls: [string]

  /**
   * configuration for generating data migration sql for a single entity type
   */
  migrations: [EntityDataMigration]

  /**
   * list of seed data entity types in current release that used to be reference data
   */
  seedDataEntities: [Type]

  /**
   * list of sql scripts that should be executed after the data migration;
   *
   * you can performs cleanup or additional data population here
   */
  afterSqls: [string]
}
