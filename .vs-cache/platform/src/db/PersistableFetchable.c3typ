/**
 * Type containing functions for all fetch operations
 */
type PersistableFetchable mixes Fetchable {

  /**
   * Used internally to fetch as a stream (e.g. FetchResultOvi)
   */
  fetchOvi: private inline function(spec: FetchSpec): @java(class="c3.platform.typesys.value.ObjValueIterator") native

  batchIds:            ~
  fetch:               ~
  fetchCountEstimated: ~
  fetchMultiLocale:    ~
  scan:                ~
  exists:              ~
  scanArrow:           ~
}
