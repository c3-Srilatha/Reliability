/**
 * Used by {@link Datastore} for managing shared read connections.
 */
private type ReadOnlyConnRef {

  /**
   * If true, when the connection was originally borrowed, it was indicated that the connection could be shared with
   * other actions that required a read only connection that could be shared.
   */
  isSharable: boolean

  /**
   * Native connection.
   */
  conn: !native

  /**
   * Time when ref was created.  Used to check for exceeding max lifetime
   */
  startedTimestamp: datetime

  /**
   * Current number of holders of the connection.
   */
  refCount: @java(class="java.util.concurrent.atomic.AtomicInteger") native

  /**
   * Pool of write connections.
   */
  recycle: @java(class="java.util.concurrent.atomic.AtomicBoolean") native

  /**
   * Constructs a new instance for a native connection.
   */
  forConnection: inline function(conn: !native, isSharable: !boolean): !ReadOnlyConnRef
}
