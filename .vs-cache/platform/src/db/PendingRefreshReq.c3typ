/**
 * Pending refresh requests due to changes found in provisioning.
 */
extendable entity type PendingRefreshReq type key 'PENDING' schema name 'DB_PNDRFRSH' {

  /**
   * Type to refresh.
   */
  refreshType: Type

  /**
   * Processes all pending refresh requests and removes them from the db.  If called on a type that extends this type,
   * then only requests from that type will be refreshed.  Otherwise requests from all extension types will be.
   */
  refreshAll: function()

  /**
   * Processes a single pending refresh request and removes it from the db.
   */
  refresh: member function()

  /**
   * Implemented by individual refresh types to perform actual refresh.
   */
  doRefresh: private abstract member function()
}
