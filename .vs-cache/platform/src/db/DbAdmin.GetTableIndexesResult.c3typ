/**
 * Result row returned from {@link DbAdmin.getTableIndexes}.
 */
type DbAdmin.GetTableIndexesResult {

  /**
   * Index name.
   */
  indexName: string

  /**
   * True if index is unique.
   */
  unique: boolean

  /**
   * True if index is the primary key for the table.
   */
  primaryKey: boolean

  /**
   * Comma separated list of index col definitions (e.g. includes descending modifier).
   */
  indexCols: string

  /**
   * Index type (e.g. btree, gin, gist, etc.)
   */
  indexType: string

  /**
   * Partial index filter sql, if any
   */
  filterSql: string

  /**
   * Size of the index in pretty format. Example: 40 kB.
   * Currently only supported for postgres datastore.
   */
  indexSize: string
}
