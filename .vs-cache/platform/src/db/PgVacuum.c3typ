/**
 * Performs automatic vacuuming on tables based on the current configuration
 */
type PgVacuum mixes Configurable<PgVacuumConfig> {

  /**
   * Vacuums all tables in all Postgres datastores indicated by the current configuration.
   */
  vacuum: function()

  /**
   * Sets the polling interval for automatic vacuuming.
   */
  setPollIntervalMinutes: function(minutes: !int)
}
