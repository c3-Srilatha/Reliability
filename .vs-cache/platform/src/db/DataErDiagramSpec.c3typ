type DataErDiagramSpec mixes Spec {

  /**
   * if module and/or type is specified then ER diagram will be built around that type or module
   */
  moduleName: string

  typeName: string

  /**
   * size of the font
   */
  fontSize: int = 10

  /**
   * output format of diagram
   */
  outputFormat: string enum('dot', 'csv', 'json') = 'dot'

  /**
   * async processing related
   */
  async: boolean = true

  /**
   * set during async call to tie results to persisted result object.
   */
  resultId: string
}
