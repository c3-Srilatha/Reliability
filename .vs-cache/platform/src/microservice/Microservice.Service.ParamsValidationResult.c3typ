/**
 * Holds validation result after validation of {@link Microservice.Service.ParamGroup} by
 * {@link Microservice.Service.Manager#validateParams}.
 *
 * @example
 * ```json
 * {
 *   "result": {
 *     "TestMicroserviceService#00000": {
 *       "errors": {
 *         "echoPrefix": "Cannot start from whitespace character"
 *       }
 *     }
 *   }
 * }
 * ```
 */
@beta
type Microservice.Service.ParamsValidationResult {

  /**
   * Per-group validation results, grouped by {@link Microservice.Service.ParamGroup#generatedId}.
   *
   * @example
   * ```json
   * {
   *   "TestMicroserviceService#00000": {
   *     "errors": {
   *       "echoPrefix": "Cannot start from whitespace character"
   *     }
   *   }
   * }
   * ```
   */
  result: map<!string, !Microservice.Service.ParamGroup.ValidationResult>

  /**
   * Next form to show to user with filled defaults.
   *
   * Generated by {@link Microservice.Service.ParamGroup#fillDefaults} and converted to json using
   * {@link Microservice.Service.ParamGroup#toForm}.
   *
   * Will be empty if error recorded in {@link #result} or all parameters filled.
   */
  next: json
}
