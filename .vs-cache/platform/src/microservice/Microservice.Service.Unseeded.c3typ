/**
 * Values that could not be seeded by {@link Microservice.Service#seedServiceParams}
 *
 * @see Microservice.Service
 */
private type Microservice.Service.Unseeded {

  /**
   * The {@link App.NodePool.Config}s that should be used when starting the app in {@link Microservice.DeployedService#start}.
   */
  nodePoolConfigs: [!App.NodePool.Config]

  /**
   * Any {@link Config}s that were not able to be seeded.
   */
  unseededConfigs: [!Config]
}
