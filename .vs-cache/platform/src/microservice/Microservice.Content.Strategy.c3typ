/**
 * Describes the type of "protocol" that should be used when reading or writing content from or to a {@link Microservice}.
 */
enum type Microservice.Content.Strategy {

  /**
   * Uses HTTP streaming to perform the operation.
   */
  STREAM

  /**
   * Uses multiple HTTP requests to perform the operation.
   */
  MULTI_PART

  /**
   * Uses an {@link Url} that contains the authn/authz information required to perform the operation.
   * See {@link FileSystem#generatePresignedUrl} for more information.
   */
  PRESIGNED

  /**
   * Signifies that the client has direct access to the file system hosting the real backing bytes.
   */
  SHARED
}
