/**
 * Base type of micro services implementation.
 *
 * @see Microservice
 */
abstract type Microservice.Service mixes Microservice {

  /**
   * Allow access to this service from a given proxy app. Note that proxy App can potentially be running in a remote
   * cluster. Once this step is done then app id of this service should be set in the provided proxy app using
   * {@link Microservice#setServiceAppId}.
   *
   * @param proxyAppId
   *       app id of the proxy App
   * @param proxyAppPublicKey
   *       app public key of the proxy App if it is a remote app; optional if proxy App is in the same cluster
   *
   * @see App#publicKeyContent
   * @see Microservice#setServiceAppId
   */
  @action(group+='app-admin')
  allowAccess: final member function(proxyAppId: !string serialized AppId, proxyAppPublicKey: string)

  /**
   * Removes access to this service from a given proxy app. Note that proxy App can potentially be running in a remote
   * cluster.
   *
   * @param proxyAppId
   *       app id of the proxy App
   *
   * @see #allowAccess
   */
  @action(group+='app-admin')
  revokeAccess: final member function(proxyAppId: !string serialized AppId)

  /**
   * Returns the list of app ids that are allowed to access this service.
   */
  appsAllowed: final member function(): [!string serialized AppId]

  /**
   * Returns the Role that is required for calling app to use this service.
   */
  serviceRole: final member function(failIfMissing: boolean): Role

  /**
   * Returns the Role name that is required for calling app to use this service.
   */
  serviceRoleId: final member function(): !string

  /**
   * List instances of the Service.
   *
   * For services that has {@link #listServiceParams}.
   *
   * Returns
   *  * `[inst]` for {@link Singletons}
   *  * `fetch` result for {@link Metadata}
   *  * `listConfigKeys()` for {@link Configurable}
   *
   * Can be overridden if default logic not matches desired behaviour.
   */
  listServices: inline function(): [!mixing Microservice.Service] js-server

  /**
   * List interfaces provided by this Service, including inherited.
   *
   * For example:
   *  * {"ModelInference[NarwhalV8]": '1.1.1-rc1'}
   *  * {"MyAttributionService": '1.1.0', "AttributionService": '5.5.5'}
   *
   * Can be overridden if default logic not matches desired behaviour.
   *
   * @return Mapping form the name of the interface to the {@link SemanticVersion SemanticVersion} of pkg where interface is defined
   */
  providesServices: private member function(): map<!string, !string serialized SemanticVersion> js-server

  /**
   * Creates name of the service based on type and name (if it has any).
   *
   * For example: "ModelInference[NarwhalV8]", "MyAttributionService".
   *
   * Can be overridden if default logic not matches desired behaviour.
   *
   * @return return user-friendly name of the service
   */
  displayName: member function(): string js-server

  /**
   * The type which includes all of the configuration details needed for this service.
   *
   * @return list {@link Microservice.Service.ParamGroup} that need to be filled for this service.
   */
  listServiceParams: private optional function(): [!Microservice.Service.ParamGroup]

  /**
   * The type which includes all of the configuration details needed for this service.
   *
   * @param params
   *            list of params to seed or turn to {@link Config configs}
   * @return list {@link Config configs} that cannot be seeded. For example if configs has secrets.
   */
  validateServiceParams: private optional function(filled: [!Microservice.Service.ParamGroup])
                                            : Microservice.Service.ParamGroup.ValidationResult

  /**
   * Updates given package with seed data according to given parameters.
   *
   * @param pkg
   *            pkg that need to be updated
   * @param params
   *            list of params to seed or turn to {@link Config configs}
   * @return list {@link Config configs} that cannot be seeded. For example if configs has secrets.
   */
  // TODO PLAT-112468 typesystem issue, return type should be [!Config]
  seedServiceParams: private optional function(pkg: !Pkg,
                                               params: [!Microservice.Service.ParamGroup])
                                        : Microservice.Service.Unseeded
}
