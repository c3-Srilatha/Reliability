/**
 * Allows clients to specify retry behavior for failed requests.
 */
type Microservice.RetrySpec mixes ExponentialBackoff, RetrySpec {

  /**
   * HTTP status codes to retry on.
   */
  statusCodesToRetry: [int]

  /**
   * Set of regexes which if found an error message will trigger a retry.
   */
  errorRegexesToRetry: [string]
}
