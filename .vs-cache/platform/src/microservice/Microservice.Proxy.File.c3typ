/**
 * A {@link Microservice.Proxy} that provides APIs for downloading and uploading files between the service and client application.
 */
@beta
type Microservice.Proxy.File mixes Microservice.Proxy {

  /**
   * @returns /file/ API endpoint for `filePath` representing a {@link File} in service App.
   *
   * @param filePath
   *           Path of {@link File} in service App. This file path should be accessible from the service App.
   * @return /file/ API endpoint for the input filePath.
   */
  @reClaim(inherit=true)
  fileEndpoint: private member function(filePath: !string): !string

  /**
   * Downloads file from service App. Downloads the file located at `src` within the service application to the destination `dest` within the client application.
   *
   * @param src
   *           url of the file to download. It should be accessible from the service App.
   * @param dest
   *           destination url to download the file to. It should be accessible from the client App i.e proxy.
   * @param spec
   *           the {@link FileOperationSpec}. Set a `retrySpec` with `maxTotalMillis` if uploading a large file.
   * @return the {@link HttpResponse}.
   */
  @reClaim(inherit=true)
  downloadFile: private member function(src: !string serialized FileUrl,
                                        dest: !string serialized FileUrl,
                                        spec: FileOperationSpec): HttpResponse

  /**
   * Uploads file to service app. Uploads the file located at `src` within the client application to the destination `dest` within the service application.
   *
   * @param src
   *           url of the file to upload. It should be accessible from the client App i.e proxy.
   * @param dest
   *           destination url to upload the file to. It should be accessible from the service App.
   * @param spec
   *           the {@link FileOperationSpec}. Set a `retrySpec` with `maxTotalMillis` if uploading a large file.
   * @return the {@link HttpResponse}.
   */
  @reClaim(inherit=true)
  uploadFile: private member function(src: !string serialized FileUrl,
                                      dest: !string serialized FileUrl,
                                      spec: FileOperationSpec): HttpResponse
}
