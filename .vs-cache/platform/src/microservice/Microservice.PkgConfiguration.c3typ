/**
 * The base configuration for starting a {@link Microservice} from UI.
 */
@beta
private type Microservice.PkgConfiguration {

  /**
   * The base {@link Pkg} which should be modified to start the service.
   */
  basePkgName: !string

  /**
   * The version of the base pkg.
   *
   * Optional for Server defined pkgs.
   */
  basePkgVersion: string serialized SemanticVersion

  /**
   * The type(s) corresponding to the service(s) that should be configured. Note that these types must exist in the
   * {@link basePkg}. The key corresponds to the {@link Microservice.Service} type name, and the value is the json of
   * the corresponding {@link Microservice.Service#configurationType}.
   */
  configurationParams: !json

  /**
   * The {@link Env} to start the service(s) in. If not defined, the service will be deployed to the default
   * "microservice" environment.
   */
  env: string serialized Env = "microservice"

  /**
   * Register Pkg created by {@link #createPkgFromPkgConfiguration} to the {@link Pkg.Store}.
   *
   * @returns description of created pkg
   */
  registerPkg: member function(): !Microservice.PkgConfiguration.Defs

  /**
   * Parse input to {@link Microservice.PkgConfiguration} and call {@link #registerPkg}
   *
   * @param pkgName
   *           The {@link Pkg pkg} to call into.
   * @returns description of created pkg
   */
  registerPkgFromStr: function(conf: !string): !Microservice.PkgConfiguration.Defs

  /**
   * Given the package configuration, create a {@link Pkg} that can start the service.
   */
  createPkgFromPkgConfiguration: private member function(): !Pair<Pkg, Microservice.Service.Unseeded>

  /**
   * Get the microservice details from another {@link Pkg pkg}, using {@link Microservice.Service.Manager#listParams}.
   *
   * @param pkgName
   *           The {@link Pkg pkg} to call into.
   * @returns The params for the {Microservice.Service service} defined in the specified {@link Pkg pkg}.
   */
  listParamsFromPkg: function(pkgName: !string): [json]

  /**
   * Validates parameters for a Microservice in another {@link Pkg pkg}, using {@link Microservice.Service.Manager#validateParams}.
   * @param pkgName
   *           The {@link Pkg pkg} to call into.
   * @param params
   *           The list of {@link Microservice.Service.ParamGroup params} that need to be validated.
   * @returns validation result.
   */
  validateParamsFromPkg: function(pkgName: !string, params: json): !Microservice.Service.ParamsValidationResult
}
