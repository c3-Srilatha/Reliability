/**
 * Holds validation result after validation of {@link Microservice.Service.ParamGroup ParamGroup} by
 * {@link Microservice.Service.ParamGroup#validateWithPrevParams}.
 */
@beta
type Microservice.Service.ParamGroup.ValidationResult {

  /**
   * Validation errors per field of {@link Microservice.Service.ParamGroup}
   *
   * @example
   * ```json
   * { "echoPrefix": "Cannot start from whitespace character" }
   * ```
   */
  errors: map<string, !string>

  /**
   * Validation warnings per field of {@link Microservice.Service.ParamGroup}
   *
   * @example
   * ```json
   * { "echoPrefix": "Recommended to end with whitespace character" }
   * ```
   */
  warnings: map<string, !string>
}
