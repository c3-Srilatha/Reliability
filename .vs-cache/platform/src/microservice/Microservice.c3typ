/**
 * Base type of micro services. A C3 Microservice is a separately deployed Infra (a full-blown App) with a well-defined
 * interface (iface) for client Apps to use and develop against. A few examples of “Client App"(s) are CRM,
 * Supply Chain Optimization, Production Schedule Optimization (PSO), etc. It allows C3 Application developers to
 * develop and deploy specialized "infra" which performs very specialized functions and can be scaled and maintained
 * "separately" from C3 Applications.
 *
 * @Microservice.Iface
 * @Microservice.Proxy
 * @Microservice.Service
 */
abstract type Microservice mixes Named {

  /**
   * @return version of this micro service; server version by default
   */
  version: member function(): !string

  forName: ~
}
