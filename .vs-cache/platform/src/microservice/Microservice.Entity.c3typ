/**
 * Defines and implements constructor, lookup and converter from/to Interface type for Service entity type
 */
abstract type Microservice.Entity {

  /**
   * Constructs new instance of a Service entity type from an Interface instance
   */
  fromIface: function(ifaceInst: !Identified): !mixing Microservice.Entity

  /**
   * Looks up an existing Service entity for a given Interface instance
   */
  forIface: function(ifaceInst: !Identified, failIfMissing: boolean): mixing Microservice.Entity

  /**
   * Converts this Service entity to corresponding Interface instance
   */
  toIface: member function(): !Identified

  /**
   * Corresponding Interface type for this type
   */
  ifaceType: function(): !Type

  /**
   * Entity type for a given Interface type
   */
  entityTypeFor: function(ifaceType: !Type): !Type<<Microservice.Entity>>
}
