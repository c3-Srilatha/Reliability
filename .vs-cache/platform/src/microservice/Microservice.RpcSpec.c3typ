/**
 * Acts as a context provider for {@link Microservice.Proxy}.
 * Also provides the ability to manipulate {@link Microservice} RPC calls at runtime.
 */
@beta
type Microservice.RpcSpec {

  /**
   * The name of the {@link Microservice} used to determine where to send the request.
   */
  serviceName: string serialized Microservice

  /**
   * The name of the interface {@link Type} used when interacting with the target service.
   * Needed to get the correct {@link Microservice.Config} for determining the target service.
   */
  ifaceTypeName: string

  /**
   * The name of the interface {@link Method} used when interacting with the target service.
   * Needed to determine what {@link Method} to call on {@link Microservice.Proxy#serviceTypeName}.
   */
  ifaceActionName: string

  /**
   * Part of the HTTP request body. JSON serialized representation of {@link #thisArg}.
   */
  thisArgJson: json

  /**
   * Part of the HTTP request body. JSON serialized representation of {@link #args}.
   */
  argsJson: json

  /**
   * The retry specification used to control automatic retries when the call to the service fails.
   */
  retrySpec: Microservice.RetrySpec
}
