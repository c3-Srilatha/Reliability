/**
 * Represents group of parameters that will be filled together on one page.
 */
@beta
abstract type Microservice.Service.ParamGroup {

  /**
   * Autofilled link to a {@link Microservice.Service service} that asked for this parameter.
   *
   * Used in {@link Microservice.Service.Manager} to match parameter group returned from UI with
   * {@link Microservice.Service} that issued this parameter group.
   *
   * Should be passed by UI as is without modifications.
   */
  generatedId: private string

  /**
   * Name of this group that will be displayed on the UI.
   */
  groupName: !string

  /**
   * Validates this parameter group using previously entered parameter groups.
   *
   * Default implementation only ensures that required parameters are filled.
   *
   * Framework guarantees that `filledParams` are parameters defined in {@link Microservice.Service#listServiceParams}
   * and supplied in the same order. `filledParams` do not include the current parameter group.
   *
   * @param filledParams
   *            Parameter(Group)s filled by user and supplied in same order as they are defined by {@link Microservice.Service#listServiceParams}.
   * @return errors and warnings for each field.
   *
   * @see #fillDefaults
   */
  validateWithPrevParams: member function(filledParams: [Microservice.Service.ParamGroup])
                                   : !Microservice.Service.ParamGroup.ValidationResult

  /**
   * Updates fields based on parameters filled by user previously.
   *
   * Default implementation uses `withDefault` with no parameters.
   *
   * Framework guarantees that `filledParams` are parameters defined in {@link Microservice.Service#listServiceParams}
   * and supplied in the same order. `filledParams` do not include the current parameter group.
   *
   * This API is called by {@link Microservice.Service.Manager manager} on the current
   * {@link Microservice.Service.ParamGroup parameter group} when user clicks `next` button on the UI.
   *
   * @param filledParams
   *            Parameters filled by user and supplied in same order as they are defined by {@link Microservice.Service#listServiceParams}.
   * @return copy of current instance with updated fields based on previous parameters.
   *
   * @see #validateWithPrevParams
   */
  fillDefaults: member function(filledParams: [Microservice.Service.ParamGroup])
                         : !mixing Microservice.Service.ParamGroup

  /**
   * Convert this parameter group to data that can be understand by the Form.
   *
   * @return json-serialize instance of {@link Microservice.Service.ParamGroup} with additional details.
   *
   * @see #fromForm
   */
  toForm: private member function(): !json

  /**
   * Construct the parameter group based on data received from the Form.
   *
   * @param jsn
   *            Deserialize instance of {@link Microservice.Service.ParamGroup} from json.
   * @return json-serialize instance of  with additional details.
   *
   * @see #toForm
   */
  fromForm: private function(jsn: !json): !mixing Microservice.Service.ParamGroup
}
