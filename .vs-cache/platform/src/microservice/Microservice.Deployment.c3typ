/**
 * A specification describing how to deploy a {@link Microservice}.
 */
@beta
type Microservice.Deployment {

  /**
   * The name of the {@link Microservice.Iface} to deploy.
   */
  name: string

  /**
   * The name of the {@link Microservice} {@link Env} to deploy.
   */
  envName: string

  /**
   * The name of the {@link Microservice} {@link App} to deploy.
   */
  appName: string

  /**
   * The mode in which to deploy the {@link Microservice} {@link App}.
   */
  appMode: string enum AppMode

  /**
   * The name of the {@link Microservice} {@link Pkg} to deploy.
   */
  rootPkg: string

  /**
   * The max amount of time to wait for the {@link #envName} or {@link #appName} to start.
   */
  waitTimeMillis: int

  /**
   * The version of the server to use when starting the {@link Microservice} {@link App}.
   */
  serverVersion: string

  /**
   * The number of task nodes the {@link Microservice} needs to function.
   */
  taskNodeCount: int

  /**
   * The optional {@link Type#name} passed to {@link #configure}.
   * If not present, {@link #configure} will not be called.
   */
  configureType: string

  /**
   * The optional action passed to {@link #configure}.
   * If not present, {@link #configure} will not be called.
   */
  configureAction: string

  /**
   * The optional "this" argument passed to {@link #configure}.
   */
  configureThisArg: ?json

  /**
   * The optional argument array passed to {@link #configure}.
   */
  configureArgs: json

  /**
   * The optional keyword argument map passed to {@link #configure}.
   */
  configureKwargs: json

  /**
   * Helper function for starting the {@link App} to which the {@link Microservice} will be deployed.
   */
  startMicroservice: member function(): App

  /**
   * Helper function for deploying/updating the {@link Microservice} described by {@link #name}.
   */
  deploy: member function()
}
