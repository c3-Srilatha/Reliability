/**
 * Configuration for Microservice
 */
// TODO: PLAT-88377 replace direct use of `Microservice.Config#` & `App#allowAccess` in ArtifactHub related code
// with `Microservice.Proxy#setServiceAppId` & `Microservice.Service#allowAccess`
// @config(doNotDefaultIfMissing = true)
type Microservice.Config mixes Config, Named {

  /**
   * The id of the {@link App} the {@link Microservice} is running in.
   */
  serviceAppId: string serialized AppId

  @deprecated(finalVersion='8.8', details='Use #serviceAppId instead')
  appId: string serialized AppId

  /**
   * The {@link AppUrl} of the {@link App} the {@link Microservice.Service} is running in.
   */
  serviceAppUrl: string serialized AppUrl

  /**
   * The type name of the service that actions should be redirected to, if exists.
   */
  serviceTypeName: string

  /**
   * Allows overriding retry thresholds for all actions.
   * Order of precedence from lowest to highest is
   * - Type Annotation
   * - {@link #serviceRetrySpec}
   * - Function Annotation
   * - {@link #actionRetrySpecs}
   */
  serviceRetrySpec: Microservice.RetrySpec

  /**
   * Allows the client to configure retry thresholds for certain {@link Microservice} methods.
   */
  actionRetrySpecs: map<string, Microservice.RetrySpec>
}
