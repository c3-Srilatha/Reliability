/**
 * Represent information about configured and registered microservice Pkg.
 */
@beta
private type Microservice.PkgConfiguration.Defs mixes Microservice.Service.Unseeded {

  /**
   * The name of registered pkg.
   */
  pkgName: string

  /**
   * The version of registered pkg.
   */
  pkgVersion: string serialized SemanticVersion
}
