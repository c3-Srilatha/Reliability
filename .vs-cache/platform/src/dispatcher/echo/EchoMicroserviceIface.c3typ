abstract type EchoMicroserviceIface mixes Microservice.Iface, DefaultInstance {

  echo:             abstract member function(msg: !string): string
  echoArray:        abstract function(a: [string]): [string]
  echoClientAppId:  abstract member function(): string
  echoClientUserId: abstract member function(): string
  info:             abstract function(): string
  echoBytes:        abstract member function(bytes: !ByteStream): !ByteStream
  pushBytes:        abstract member function(id: !string): !BytePushStream
  popBytes:         abstract member function(id: !string): !ByteStream
  alwaysFail:       abstract function(msg: string): string
  halfFail:         abstract function(msg: string): string
  neverFail:        abstract function(msg: string): string
}
