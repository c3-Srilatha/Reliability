/**
 * A hub for discovering, managing, and delivering {@link ArtifactHub.Artifact}s to distributed {@link App}s.
 */
type ArtifactHub mixes ArtifactHubIface, Microservice.Proxy {

  serviceAppId:    ~
  serviceTypeName: ~

  @reClaim(inherit=true)
  @typesys(todo="PLAT-130528 - Remove Microservice.Proxy#proxyApp overrides from proxy types")
  proxyApp: ~

  @reClaim(inherit=true)
  @deprecated(finalVersion="8.10", description="Replace with {@link #artifactForId}, which now retries by default")
  artifactForIdWithRetry: function(artifactId: !string): ArtifactHub.Artifact

  @reClaim(inherit=true)
  @deprecated(finalVersion="8.10",
              description="Replace with {@link #artifactForVersion}, which now retries by default")
  artifactForVersionWithRetry: function(name: !string,
                                        version: !string serialized SemanticVersion): ArtifactHub.Artifact

  @reClaim(inherit=true)
  @deprecated(finalVersion="8.10",
              description="Replace with {@link #availableArtifacts}, which now retries by default")
  availableArtifactsWithRetry: function(spec: ArtifactHub.EvaluateSpec): [string]

  @reClaim(inherit=true)
  @deprecated(finalVersion="8.10", description="Replace with {@link #availableVersions}, which now retries by default")
  availableVersionsWithRetry: function(spec: ArtifactHub.FetchSpec): [ArtifactHub.Artifact]

  @reClaim(inherit=true)
  @deprecated(finalVersion="8.10", description="Replace with {@link #bestVersions}, which now retries by default")
  bestVersionsWithRetry: function(spec: ArtifactHub.FetchSpec): map<string, ArtifactHub.Artifact>

  @reClaim(inherit=true)
  @deprecated(finalVersion="8.10",
              description="Replace with {@link #resolveDependencies}, which now retries by default")
  resolveDependenciesWithRetry: function(spec: ArtifactHub.DependencyResolutionSpec): [ArtifactHub.Artifact]

  @reClaim(inherit=true)
  @deprecated(finalVersion="8.10", description="Replace with {@link #registerArtifacts}, which now retries by default")
  registerArtifactsWithRetry: function(artifacts: [ArtifactHub.Artifact]): [ArtifactHub.Artifact]

  @reClaim(inherit=true)
  @deprecated(finalVersion="8.10", description="Replace with {@link #registerResources}, which now retries by default")
  registerResourcesWithRetry: function(resources: [ArtifactHub.Artifact.Resource]): [ArtifactHub.Artifact.Resource]

  @reClaim(inherit=true)
  @deprecated(finalVersion="8.10", description="Replace with {@link #bestVersion}, which now retries by default")
  bestVersionWithRetry: function(shas: ![string], filter: string serialized Filter): string
}
