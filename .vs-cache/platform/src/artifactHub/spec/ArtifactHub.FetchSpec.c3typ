/**
 * Provides additional information to {@link ArtifactHub} when fetching available {@link ArtifactHub.Artifact}s.
 */
type ArtifactHub.FetchSpec mixes SemanticVersionRangeFilterSpec, ArtifactHub.FetchSpecBase {

  /**
   * The subtype of {@link ArtifactHub.Artifact} to filter by if any.
   */
  artifactType: string serialized Type = "ArtifactHub.Artifact"

  /**
   * If set to true, only return artifacts for which you can read the backing content.
   */
  filterOnEntitlements: boolean
}
