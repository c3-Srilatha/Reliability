/**
 * A base spec of {@link ArtifactHub} APIs that inform {@link ArtifactHub} how to navigate between hubs and spokes when
 * not all requested information is available in the local spoke.
 */
type ArtifactHub.SpecBase {

  /**
   * Maintains a list of visited {@link ArtifactHub}s that are federated across network hops to prevent infinite loops.
   */
  visited: [string]

  /**
   * The server version of the client making the request. Used to help {@link ArtifactHub} return data in
   * a compatible format.
   */
  clientVersion: string

  /**
   * Whether or not this request should go upstream to a central hub.
   */
  doNotGoUpstream: boolean
}
