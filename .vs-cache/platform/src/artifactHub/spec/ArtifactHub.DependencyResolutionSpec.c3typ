/**
 * A spec for requesting {@link ArtifactHub.Artifact#dependencies}.
 */
type ArtifactHub.DependencyResolutionSpec mixes DependencyResolutionSpec, ArtifactHub.FetchSpec {

  defaultAvailableVersions: [ArtifactHub.Artifact]

  /**
   * Specifies whether or not {@link ArtifactHub.Artifact#resolvedDependencies} (versions included in
   * {@link ArtifactHub.Artifact#content}) should be used during dependency resolution instead of those
   * declared in {@link ArtifactHub.Artifact#dependencies} (version ranges specified as viable by the publisher).
   */
  useResolvedDependencies: boolean
}
