/**
 * Provides a way to serve content through {@link ArtifactHub.RestfulContentHandler} for a given path.
 * If {@link #shouldServe} returns true for a given path, then this content provider will be used to serve the content.
 */
type ArtifactHub.ContentProvider {

  /**
   * Whether or not this subtype should handle serving the content for the given path.
   * @param path
   *           The path that comes after "/artifact/""
   * @return true if this content provider should serve the content for the given path
   */
  shouldServe: function(path: !string): !boolean

  contentFor:   function(path: !string): !Content
  artifactFor:  function(path: !string): !ArtifactHub.Artifact
  pullAndCache: function(path: !string): !ArtifactHub.Artifact
}
