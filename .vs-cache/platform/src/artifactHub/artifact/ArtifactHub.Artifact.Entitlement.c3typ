/**
 * Describes entitlements managed by {@link ArtifactHub}.
 * These determine whether or not {@link ArtifactHub.Artifact#content} is readable.
 */
type ArtifactHub.Artifact.Entitlement mixes Identified {

  /**
   * The name of the {@link ArtifactHubService.Artifact} for which content read access is being granted.
   */
  namespace: !string

  /**
   * The date when the entitlement expires. After this date, the entitlement will no longer be valid.
   */
  expirationDate: datetime
}
