/**
 * Enumeration of {@link ArtifactHub.Artifact.Resource} categories.
 */
@deprecated(finalVersion='8.11', details='Replaced by ArtifactHub.ArtifactKind')
enum type ArtifactHub.Artifact.Resource.Category {

  /**
   * An application package refers to a package that is used directly as an application.
   */
  @deprecated(finalVersion='8.11', details='Replaced by ArtifactHub.ArtifactKind#APPLICATION')
  APPLICATION = 'Application'

  /**
   * A plugin package refers to a package that is mainly used as a dependency.
   */
  @deprecated(finalVersion='8.11', details='Replaced by ArtifactHub.ArtifactKind#PLUGIN')
  PLUGIN = 'Plugin'

  /**
   * A quickstart package is an instructional package, which users can modify and play around with.
   */
  @deprecated(finalVersion='8.11', details='Replaced by ArtifactHub.ArtifactKind#QUICKSTART')
  QUICKSTART = 'Quickstart'
}
