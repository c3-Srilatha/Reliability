/**
 * {@link ArtifactHub} type used to distribute and receive resources efficiently.
 */
@deprecated(finalVersion='8.11', details='Replaced by ArtifactHub.Artifact')
type ArtifactHub.Artifact.Resource mixes Identified, Nameable {

  /**
   * A unique identifier used by {@link ArtifactHub} to identify the correct resource.
   */
  @deprecated(finalVersion='8.11', details='Replaced by ArtifactHub.Artifact#id')
  id: ~

  /**
   * The name of the resource.
   */
  @deprecated(finalVersion='8.11', details='Replaced by ArtifactHub.Artifact#name')
  name: ~

  /**
   * The name of the package that the resource belongs to.
   */
  @deprecated(finalVersion='8.11', details='Replaced by ArtifactHub.Artifact#parent#name')
  pkgName: string

  /**
   * The path of the file, which will be used to write the content of the resource.
   */
  @deprecated(finalVersion='8.11', details='Replaced by ArtifactHub.Artifact#dataMap.get("path")')
  path: string serialized UrlPath

  /**
   * The content for the resource.
   */
  @deprecated(finalVersion='8.11', details='Replaced by ArtifactHub.Artifact#content')
  content: ArtifactHub.Artifact.Content

  /**
   * The category that the resource belongs to.
   */
  @deprecated(finalVersion='8.11', details='Replaced by ArtifactHub.Artifact#kind')
  category: string enum ArtifactHub.Artifact.Resource.Category

  /**
   * The {@link ArtifactHub.Artifact} this resource is associated with.
   */
  @deprecated(finalVersion='8.11', details='Replaced by ArtifactHub.Artifact#parent')
  artifact: ArtifactHub.Artifact

  /**
   * The display name for the resource.
   */
  @deprecated(finalVersion='8.11', details='Replaced by ArtifactHub.Artifact#dataMap.get("displayName")')
  displayName: string

  /**
   * A brief description to attach to the resource.
   */
  @deprecated(finalVersion='8.11', details='Replaced by ArtifactHub.Artifact#dataMap.get("description")')
  description: string

  /**
   * The relative path from the resource to the icon to display (e.g. `img/icon.png` where the `img` folder
   * is inside the `doc` folder of `rootPkgName/src/doc/rootPkgName.c3doc.md`).
   */
  @deprecated(finalVersion='8.11', details='Replaced by ArtifactHub.Artifact#dataMap.get("iconPath")')
  iconPath: string

  /**
   * The publisher of the resource.
   */
  @deprecated(finalVersion='8.11', details='Replaced by ArtifactHub.Artifact#dataMap.get("publisher")')
  publisher: string

  /**
   * Maintain a reference to metadata.
   */
  @deprecated(finalVersion='8.11', details='Field has no replacement')
  meta: Meta

  toArtifact: member function(): !ArtifactHub.Artifact
}
