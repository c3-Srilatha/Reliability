/**
 * Allows for streaming and uploading {@link ArtifactHub.Artifact.Content} in a low memory way.
 */
@restful(endpoint='artifact')
type ArtifactHub.RestfulContentHandler mixes Restful {

  handle: ~

  @action(authz='always')
  doGet: private function(path: !string): HttpResponse

  @action(authz='always')
  doPost: private function(path: !string, req: !HttpRequest): HttpResponse

  @action(authz='always')
  doPut: private function(path: !string, req: !HttpRequest): HttpResponse
}
