/**
 * {@link ArtifactHub} type used to distribute and receive content efficiently. Inherited {@link Content} APIs can
 * be used like they normally would for other subtypes (ex. {@link File}).
 */
type ArtifactHub.Artifact.Content mixes Microservice.Content {

  /**
   * A unique identifier used by {@link ArtifactHub} to identify the correct content.
   */
  id: ~

  /**
   * The name of the content. During {@link ArtifactHub.Artifact#register}, this field will be used as a
   * {@link File#name} by the service.
   */
  name: ~

  serviceIface: ~

  /**
   * The {@link AppId} of ArtifactHub that hosts this content.
   * This field is used to let the ArtifactHub service know if content should be read from an upstream source.
   */
  sourceHub: string serialized AppId

  /**
   * The date at which the artifact expires.
   */
  expiresAt: datetime

  /**
   * Whether to keep the artifact forever.
   */
  keepForever: boolean
}
