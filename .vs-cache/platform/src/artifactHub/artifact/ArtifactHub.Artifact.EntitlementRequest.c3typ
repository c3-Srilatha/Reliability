/**
 * A request to create a new {@link ArtifactHub.Artifact.Entitlement} in the service.
 * If approved, this will grant the client access to the content of {@link ArtifactHub.Artifact}s within
 * the specified namespace and version range.
 */
type ArtifactHub.Artifact.EntitlementRequest mixes C3RequestFields, Identified {

  /**
   * The name of {@link ArtifactHub.Artifact}s that access is being requested for.
   */
  namespace: !string

  /**
   * The version range of {@link ArtifactHub.Artifact}s that access is being requested for.
   */
  versionRange: !string serialized SemanticVersionRange

  /**
   * Whether or not access should be granted to dependencies of the requested {@link #namepsace} upon approval.
   */
  includeDependencies: boolean
}
