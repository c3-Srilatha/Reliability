/**
 * render monetary amounts and physical quantities by showing the corresponding currency or unit of measurement
 */
@annotation(appliesTo=['field'])
type Ann.Numerical mixes Annotation {

  /**
   * Field rendered as a monetary amount. Identifies a related field that holds the currency to be shown for this field
   */
  currencyPath: string

  /**
   * Identifies a related field that holds the unit to be shown for this field
   */
  unitPath: string

  /**
   * specifies the unit to be used for recording data in the annotated field
   */
  requiredUnit: Unit
}
