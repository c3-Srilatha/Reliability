/**
 * Configuration options related to the {@link ReClaim} type for methods.
 */
/*
 * TODO: PLAT-44030 method: ~ from Type on ReClaim subtype inherits method implementation from given type
 *       Delete this annotation
 */
@annotation(appliesTo=['function'])
type Ann.ReClaim mixes Annotation {

  /**
   * If true, decorated non-abstract method will have its implementation inherited by subtypes that mix {@link ReClaim},
   * as opposed to dispatching to {@link ReClaim#_exec}.
   */
  inherit: boolean
}
