/**
 * Timeseries extensions for Fields
 */
@annotation(appliesTo=['field'])
type Ann.Normalization mixes Annotation {

  /**
   * enum ("SECOND", "MINUTE", "QUARTER_HOUR", "HOUR", "DAY", "WEEK", "MONTH", "YEAR", "ALL")
   */
  grain: string

  /**
   * enum ("LINEAR_INTERPOLATOR")
   */
  interpolator: string
}
