/**
 * Persistence extensions for Modules
 */
@annotation(appliesTo=['type'])
type Ann.InvalidationQueueOptions mixes Annotation {

  /**
   * enum ("targetObj", "none") = targetObj
   */
  grouping: string

  /**
   * enum("normal", "high", "urgent") = normal
   */
  priority: string

  maxConcurrency: int

  /**
   * Comma separated list of fields to group by in the default report for the queue.
   *
   * @format(formatter = "InvalidationQueueGroupSpec")
   */
  defaultReportGrouping: string

  /**
   * Comma separated list of fields to group by in the detail report for the queue.
   *
   * @format(formatter = "InvalidationQueueGroupSpec")
   */
  detailReportGrouping: string

  /**
   * Comma separated list of fields to group by in the default report for the queue errors.
   *
   * @format(formatter = "InvalidationQueueErrorGroupSpec")
   */
  defaultErrorReportGrouping: string

  /**
   * Comma separated list of fields to group by in the detail report for the queue errors.
   *
   * @format(formatter = "InvalidationQueueErrorGroupSpec")
   */
  detailErrorReportGrouping: string
}
