@annotation(appliesTo=['type', 'field'])
type Ann.Azure mixes Ann.Cloud, Annotation {

  /**
   * The name of the method in Azure.java to get the client for the particular Azure resource
   */
  client: !string

  /**
   * The name of the method in parent's impl class to get the client for the child resource
   */
  child: string

  /**
   * Usually children are defined on the parent impl class but there are rare and inconsistent cases where the child is
   * instead defined on the impls class and this need to be handled.
   */
  childOnImpls: boolean

  /**
   *  If set, azure API request field value will be computed based on this expression
   *  Format: fieldName -> expression to calculate value
   *  Currently the expressions are limited to literals & field names on the existing type. It doesn't allow full c3
   *  expression language syntax yet
   *  E.g. See {@link AzureRouteTable.routes_}
   * ```js
   *     //During upsert operations, the value of routes_ will be populated from the value in field {@link routes}
   *     @azure(writeMapping={"this" : "routes"})
   *    routes_: ~
   * ```
   */
  writeMapping: map<string, string>

  /**
   *  If set, c3 CloudResource field value will be computed from the Azure API returned values based on this expression
   *  Format: fieldName -> expression to calculate value
   *  Currently the expressions are limited to literals & field names on the existing type. It doesn't allow full c3
   *  expression language syntax yet
   *  E.g. See {@link AzureRouteTable.routes}
   * ```js
   *     //During upsert operations, the value of routes_ will be populated from the value in field {@link routes}
   *     @azure(readMapping={"this" : "routes_"})
   *    routes: ~
   * ```
   */
  readMapping: map<string, string>
}
