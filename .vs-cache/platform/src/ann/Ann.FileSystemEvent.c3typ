@annotation(appliesTo=['type'])
type Ann.FileSystemEvent mixes Annotation {

  /**
   * Path prefix on which notifications should be generated. E.g. "data" in the default bucket on this environment or
   * the fully qualified file system url.
   */
  urlOrEncodedPathPrefix: !string
}
