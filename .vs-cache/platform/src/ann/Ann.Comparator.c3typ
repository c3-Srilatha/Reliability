/*
 * The @comparator annotation indicates that lambda return value has a Comparator semantic - i.e. 0 means equals; -1
 * means less then; and 1 means greater then.
 */
@annotation(appliesTo=['valueType'])
type Ann.Comparator mixes Annotation
