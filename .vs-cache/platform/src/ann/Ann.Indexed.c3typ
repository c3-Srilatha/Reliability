/**
 * Annotation for {@link CollectionType collections} that requests the insertion order be preserved.
 *
 * By default, {@link ArrayType arrays} preserve insertion order, but for performance {@link MapType maps} and
 * {@link SetType sets} do not. If desired, order preservation can be specified by annotating the collection:
 * `@indexed set<string>`.
 *
 * @see Ann.Sorted
 * @see Ann.Unique
 */
@annotation(appliesTo=['valueType'])
type Ann.Indexed mixes Annotation
