/**
 * Special annotations for DSL printing of metadata structure (types and default UI).
 */
@annotation
type Ann.Dsl mixes Annotation {

  /**
   * The DSL keyword (or other syntax) for this option or specification value. If unspecified, the field name is used,
   * with camel case mapped to space-separated words.
   */
  syntax: string

  /**
   * If true, this field isn't emitted as part of DSL printing. This represents something calculated from declared
   * fields or other state.
   */
  suppress: boolean

  /**
   * Boolean fields are usually printed as prefixes, but this puts them in suffix position instead.
   */
  suffix: boolean

  /**
   * String values are usually printed as literal strings, but this prints them as identifiers instead.
   */
  ident: boolean

  /**
   * If true, any non-null value in this field causes the keyword to be printed and the value itself is ignored.
   */
  flag: boolean

  /**
   * If true, the value is assumed to be an expression (string) and printed without additional quoting as would be
   * done for a normal literal.
   */
  expr: boolean
}
