/**
 * Annotation for specifying the file system configuration for dynamically reading from it
 */
@annotation(appliesTo=['type'])
type Ann.KvFs mixes Annotation {

  /**
   * name of the KvStore.FileSystem.Config to look up for rootUrl & other properties
   */
  name: string

  /**
   * name of the table field in the type which will be used to append table name to rootUrl. If specified will be
   * appended to the rootUrl before partitionKey & after {@link KvStore.FileSystem.Config#rootUrl}
   */
  tableField: string

  /**
   * name of the partition key field in the type which will be used to append partition key to rootUrl
   */
  partitionKeyField: !string

  /**
   * File operation specification to use for reading from the file system
   */
  fileSpec: FileObjsOperSpec
}
