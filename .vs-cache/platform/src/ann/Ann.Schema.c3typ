/**
 * Persistence extensions for Modules
 */
@annotation(appliesTo=['type', 'field'])
type Ann.Schema mixes Annotation {

  /**
   * Overrides for schema names for fields within an included type.
   */
  @annotation(allowsRemixOverride=false)
  fieldOverrides: map<string, string>
}
