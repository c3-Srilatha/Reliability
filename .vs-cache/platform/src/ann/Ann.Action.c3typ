/**
 * Annotations used by the action authorization framework.
 *
 * @see Authorizer
 */
@annotation(appliesTo=['type', 'function'],
            docPills={'always authz': 'authz == "always"', 'child authz': 'authzChildActions'})
type Ann.Action mixes Annotation {

  AUTHZ_ALWAYS: const string = 'always'

  /**
   * Group this action belongs to from Permissions and Access Control purposes. An action can belong to more than one
   * group.
   */
  group: [string serialized Action.Group]

  /**
   * If `true`, force authorization evaluation of all the child actions invoked by the given parent action.
   * This annotation should only be applied on the method not the type.
   */
  @annotation(appliesTo=['function'])
  authzChildActions: boolean

  /**
   * If `always`, this action authorization must be evaluated even if the parent has the authzChildActions annotation
   * set to false.
   */
  authz: string enum('always')

  /**
   * If `true` action should never be remoted
   */
  @deprecated
  local: boolean

  // TODO: PLAT-105628 Remove Ann.Action#inline
  @deprecated
  inline: private boolean
}
