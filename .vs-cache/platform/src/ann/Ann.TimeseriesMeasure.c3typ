@annotation(appliesTo=['field'])
type Ann.TimeseriesMeasure mixes Annotation {

  /**
   * One of the following 3 should be defined
   */
  expr: string

  /**
   * We don't support timeseries measures having external action refs but not based on mvExprGroups yet
   */
  evalSpec: ActionRef

  mvEvalSpec:           ActionRef
  unitAttribute:        string
  scopedBy:             string
  grainScopedBy:        string
  timeRange:            TimeRangeExpr
  hierarchyAggregation: string

  /**
   * 1-based index of Extract.passes
   */
  pass: int
}
