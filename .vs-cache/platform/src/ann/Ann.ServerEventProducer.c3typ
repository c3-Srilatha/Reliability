@annotation(appliesTo=['function'])
type Ann.ServerEventProducer mixes Annotation {

  /**
   * Duration between calls to the producer, regulating the rate of new events.
   * This should balance timeliness with wasted processing and tend toward larger durations.
   * If unspecified, the default duration is one minute.
   */
  pollingInterval: !Duration
}
