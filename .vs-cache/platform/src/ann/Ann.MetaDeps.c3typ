/**
 * Annotation to control how {@link TypeMetaDeps} & {@link MetadataDeps} get persisted
 */
@annotation(appliesTo=['field'])
type Ann.MetaDeps mixes Annotation {

  /**
   * If set forward dependency will be persisted as a single file with a given extension
   */
  fileExt: string

  /**
   * If true, annotated field will not be used for backward deps computation.
   */
  skipForBackwardDeps: boolean
}
