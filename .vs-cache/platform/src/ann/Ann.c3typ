/**
 * Outer type holding all C3 type-system annotation types as inner (nested) types.
 *
 * To create an annotation, declare a type as an inner type of this type and annotate it. See {@link Ann.Annotation}
 * (an annotation type itself) for more info.
 *
 * @see Ann.Annotation
 */
abstract type Ann mixes Value
