/**
 * @obj annotation can be used to influence implicit Obj behavior.
 */
type Ann.Obj mixes Annotation {

  /**
   * If `true` then instances of the target type will have a simple but optimized implementation by not supporting some
   * of the Obj default semantics like keeping track of set and missing fields.
   */
  @annotation(appliesTo=['type'])
  simple: boolean
}
