/**
 * //TODO PLAT-82421: Natively support vector as a data type. Once done, Remove this annotation and update its usages.
 * Annotation for specializing the datatype of a field declared as array of double in a c3 type as vector.
 */
@annotation(appliesTo=['field'])
type Ann.Vector mixes Annotation {

  /**
   * Number of elements in the vector.
   */
  dimension: int

  /**
   * Whether the vector is sparse or dense.
   */
  sparse: boolean

  /**
   * Source field path in the parent type. If set this vector field becomes read only
   * and will be maintained by Db.Engine. Similar to `stored calc` field.
   */
  sourceField: string

  /**
   * Embedder for this vector. If specified then {@link #dimension} should be blank
   */
  embedder: string serialized Entity.Embedder
}
