/**
 * miscellaneous type system attributes
 */
@annotation(appliesTo=['type', 'field', 'function'])
type Ann.Typesys mixes Annotation {

  /**
   * If true, attempt to cache the value of the default instance.
   * Otherwise, a new default instance is constructed for each call.
   * @see DefaultInstance
   */
  cacheDefaultInstance: boolean

  /**
   * If true, marked platform type will be allowed to be remixed,otherwise a platform type is not allowed to be remixed.
   */
  remixable: boolean

  /**
   * Indicates that this method/field has a known issue that needs to be addressed.
   * When set on a final method, allows overriding with a warning instead of an error.
   * The value should point to a JIRA ticket or issue tracking the fix.
   */
  todo: string
}
