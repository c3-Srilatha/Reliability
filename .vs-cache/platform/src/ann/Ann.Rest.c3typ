/**
 * The @rest annotation is used for specifying various properties for generic REST api proxy. To capture the complete
 * response use {@link HttpResponse} as the method return type.
 * In order to set specific url and auth for your REST type, {@see RestConfig}
 */
@annotation(appliesTo=['field', 'function'], configurable=true)
type Ann.Rest mixes Annotation {

  /**
   * Relative URI that will be appended to host
   */
  uri: string

  /**
   * HTTP request method
   */
  method: string

  // TODO: PLAT-23390 Remove this post big bang migration
  @deprecated(details="Use `acceptType` for expected response type and `contentType` for the request body type. Skipped if acceptType is defined")
  bodyType: string enum('json', 'xml', 'plain')

  /**
   * The response type expected from the REST endpoint, used for deserialization. If {@link acceptHeader} is not set,
   * then this value will also be set as the 'Accept' header in the HTTP request.
   * To have a custom deserializer mix {@link XML} and implement {@link XML#fromXml}. For text/plain, the method return
   * type should only be string.
   */
  acceptType: string enum MediaType

  /**
   * The value to be set as the 'Accept' header in the HTTP request. This field takes precedence over {@link acceptType}.
   */
  acceptHeader: string enum MediaType

  /**
   * The request type expected by the REST endpoint. This value is set as 'Content-Type' header in the HTTP request.
   * To have a custom serializer mix {@link XML} and implement {@link XML#toXml}
   */
  contentType: string enum MediaType

  /**
   * The XML root element name which will enclose all the post parameters to form the request body. To specify a
   * hierarchy use '/' delimiter. Example: Users/user will serialize the body as
   * `<Users><User><request body goes here/></User></Users>`
   */
  xmlRoot: string

  /**
   * If true then action input value will be added to query string (instead of the request body)
   */
  queryParameter: boolean

  /**
   * Excludes parameter name from the request body
   */
  doNotUseParameterName: boolean

  /**
   * Override for request parameter name
   */
  parameterName: string

  /**
   * If true then action input value will be added to uri (if no prefix is specified a '/' will be prefixed)
   */
  partOfURI: boolean

  /**
   * If partOfURI is true, this prefix will be added before the input value (note that '/'s must be added to the prefix as needed)
   */
  uriPrefix: string

  /**
   * If partOfURI is true, this suffix will be appended after the input value
   */
  uriSuffix: string

  /**
   * If skipThis is set for a member method then `this` argument will not be included in the HTTP payload.
   */
  skipThis: boolean

  /**
   * If true then action input value will be added as HTTP request header
   */
  header: boolean

  /**
   * Override for HTTP header name
   */
  headerName: string

  /**
   * If true, we send a request with HTTP header X-C3-Context which contains jsonified C3 Context (user, env, app)
   */
  c3Context: boolean

  /**
   * List of scopes that are required to access the desired resources if OAuth2 configuration is used.
   * https://datatracker.ietf.org/doc/html/rfc6749#section-3.3
   */
  oAuth2Scope: [string]

  /**
   * When true, the client will attempt to deserialize the body according to `acceptType`
   * even if the response `Content-Type` header is different or missing.
   *
   * Example: acceptType = "json"; Response: Content-Type: text/plain, Body: '{"ok":true}'
   * We will still try to json parse.
   *
   * Intended for APIs that sometimes mislabel response content type.
   * Disable this to strictly enforce content negotiation.
   */
  acceptMislabeledContentType: boolean
}
