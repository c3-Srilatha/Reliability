/**
 * Annotation for seed data behavior
 *
 * @see SeedData
 */
@annotation(appliesTo=['type', 'field'])
type Ann.Seed mixes Annotation {

  /**
   * If set to `true` then the type can be modified by users and the modifications will be preserved even after upgrade
   * of the application.
   */
  @annotation(appliesTo=['type'])
  userUpdatable: boolean

  /**
   * By default fields are user updatable if the type is user updatable.  Set this field to true to "opt out" to
   * disallow user updates for the field if the type allows userUpdates.
   */
  @annotation(appliesTo=['field'])
  notUserUpdatable: boolean

  /**
   * If set to `true` then instance of type of application Seed Data can be removed / hidden by users.
   */
  userRemovable: boolean

  /**
   * If set to true then new instances of this type can not be created by users.
   */
  notUserCreatable: boolean
}
