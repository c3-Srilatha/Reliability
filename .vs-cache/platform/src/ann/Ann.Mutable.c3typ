/**
 * Annotation to define behavior for {@link MutableObj} instances on field change.
 */
@annotation(appliesTo=['field'])
type Ann.Mutable mixes Annotation {

  /**
   * When set true on a field, the {@link MutableObj#onChange} will be skipped. Similar to wrapping
   * {@link MutableObj#withoutChangeEvent} on the field change statement.
   */
  skipOnChange: boolean
}
