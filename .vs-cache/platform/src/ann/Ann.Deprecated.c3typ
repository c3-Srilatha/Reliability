/**
 * Annotate type or field as deprecated.
 */
@annotation(noInherit=true)
type Ann.Deprecated mixes Annotation {

  /**
   * Version number after which this type or field will cease to exist.
   */
  finalVersion: !string

  /**
   * Message describing steps how to remove usage of deprecated API.
   */
  details: !string
}
