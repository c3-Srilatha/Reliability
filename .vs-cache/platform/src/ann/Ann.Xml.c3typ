// The @xml annotation is used for specifying properties for generic XML type
@annotation(appliesTo=['type'])
type Ann.Xml mixes Annotation {

  /**
   * XSD Attachment id
   *    The attachment id to the C3 Attachment that contains the xsd to be used for xml validation
   */
  schema: string

  /**
   * if true, cache the schema in memory (there is no eviction mechanism)
   */
  cacheSchema: boolean

  /**
   * override for root xml element name
   */
  rootElement: string

  /**
   * if true don't use <k> and <v> elements for arrys and mapps and use attributes for primitives
   */
  compact: boolean
}
