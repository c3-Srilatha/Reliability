/**
 * Annotation for customizing value types in fields and function params.
 */
@annotation(appliesTo=['field', 'param'])
type Ann.Value mixes Annotation {

  /**
   * Expression for calculating possible values. For field and member method parameters the
   * scope is instance of the C3 type. For constants and static method parameters the scope is the C3 type.
   */
  possibles: string serialized Expr

  /**
   * If true, the value is a secret.
   */
  secret: boolean
}
