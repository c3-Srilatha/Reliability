/**
 * The @merge annotation is used to specify merge behaviors for C3 Type | Fields
 */
@annotation(appliesTo=['type', 'field'])
type Ann.Merge mixes Annotation {

  /**
   * Indicates merge behavior for collection fields
   */
  @annotation(value=true)
  collection: string enum CollectionMerge = REPLACE

  /**
   * Indicates merge behavior for reference fields
   */
  reference: map<string serialized FieldPath, string enum ReferenceMerge | string enum CollectionMerge> | string enum ReferenceMerge = REPLACE

  /**
   * merge behavior for fields valueType of json.
   */
  json: string enum ReferenceMerge = REPLACE
}
