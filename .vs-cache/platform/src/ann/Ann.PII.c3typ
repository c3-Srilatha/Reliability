/*
 * The @PII annotation is used to mark fields that are Personally Identifiable Information.
 * the fields marked with this annotation can be masked when exported if necessary.
 * ex: phone-number, address, name etc.
 */
@annotation(appliesTo=['field'])
type Ann.PII mixes Annotation {

  obfuscate: boolean
  category:  string enum('name', 'phone', 'dob', 'email', 'address')

  /**
   * Encrypt the field's value before persisting to the db.
   */
  encrypt: boolean
}
