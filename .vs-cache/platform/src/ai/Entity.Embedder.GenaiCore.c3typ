/**
 * Demonstration of GenaiCore integration.
 */
entity type Entity.Embedder.GenaiCore extends Entity.Embedder type key 'GENAI' {

  /**
   * The kwargs for this embedder when encoding source value.
   */
  sourceKwargs: map<string, any>

  /**
   * The kwargs for this embedder when encoding similarity search query value.
   */
  queryKwargs: map<string, any>

  /**
   * Base embedder with actual implementation.
   */
  // FIXME !GenaiCore.Embedder
  baseEmbedder: native
}
