/**
 * This type contains all the relevant C3 Server information passed to an external service {@link ExternalService} for
 * it to be able to fully identify the context under which it was invoked and also for it to be able to call back into
 * the C3 server.
 */
type ExternalServiceContext {

  /**
   * Action id bound to the External service request.
   */
  actionId: !string

  /**
   * Tenant under which the External Service request is invoked.
   */
  tenant: !string

  /**
   * Tag under which the External Service request is invoked.
   */
  tag: !string

  /**
   * Authenticated User id under which the External Service request is invoked.
   */
  userId: !string

  /**
   * c3auth token of authenticated user that can be used by External Service to call back into the C3 server.
   */
  authToken: string

  /**
   * C3 server endpoint.
   */
  c3ServerEndpoint: !string
}
