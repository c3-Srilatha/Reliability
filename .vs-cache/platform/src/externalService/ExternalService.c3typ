/**
 * Abstract type for "External Services".
 *
 * External Services run outside of the C3 Server process and expose their functionality through http endpoints.
 * Requests to these services are proxied through the C3 server so authentication and authorization is applied as any
 * other C3 type request.
 *
 * The C3 server proxies the requests to the External Service based on the value in the first component of the URL path.
 *
 * The External Service will be started on-demand when the first request to it is received by the C3 server.
 */
@deprecated(finalVersion='8.9')
abstract type ExternalService<T: ExternalServiceSession, C: Config> mixes Engine.Deprecated, Configurable<C> {

  /**
   * Get the ExternalServiceSession entry for this ExternalService instance
   * @param failIfMissing
   *                   Whether to throw error if the cache entry doesn't exist
   * @return The ExternalServiceSession entry for this ExternalService instance
   */
  session: member function(failIfMissing: boolean): T

  /**
   * Generates the ID of the ExternalServiceSession entry of this ExternalService
   * @return The external service session ID of this instance
   */
  sessionId: member function(): !string

  /**
   * Get the URL endpoint of this external service
   * @return The external service URL
   */
  endpoint: member function(): !string serialized Url

  /**
   * Passes the context to this External Service instance.
   */
  setContext: private abstract member function(context: !ExternalServiceContext)

  /**
   * Starts the external service with an overriding configuration.
   * @param config
   *         configuration to override when starting the external service
   */
  startWithConfig: private abstract member function(config: C)

  /**
   * Returns the config that this service was started with.
   *
   * @return the config
   */
  startConfig: private abstract member function(): C

  /**
   * Called in HttpProxyServlet.onProxyResponseFailure, this function should clean up stale state (e.g. cached session
   * endpoints) that may be causing the connection problem.
   */
  onConnectionFailure: private member function()

  /**
   * Alternative constructor to #inst that avoids the need to execute with context. Used to bypass C3.withTargetTenant
   * during provisioning.
   */
  fromUserContext: private abstract function(tenantName: !string,
                                             tagName: !string,
                                             userName: !string): !mixing ExternalService
}
