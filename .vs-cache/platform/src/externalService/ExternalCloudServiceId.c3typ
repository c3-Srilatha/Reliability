/**
 * Canonical C3 Identifier for {@link ExternalCloudService} types.
 */
type ExternalCloudServiceId mixes CloudId {

  /**
   * External cloud service abbreviation (e.g. jupyter, exmac).
   */
  serviceName: string

  /**
   * @returns C3 service name value for this instance based on available fields.
   */
  safeServiceName: inline member function(): !string

  toString:      ~ java
  fromString:    ~ java
  withDefaultId: ~
}
