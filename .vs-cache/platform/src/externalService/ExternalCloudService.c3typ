/**
 * An external cloud service (e.g. {@link Jupyter}, Single Tag Cluster, Ex Machina).
 */
abstract type ExternalCloudService<C: Config> mixes ExternalService<CloudServiceSession<any>, C>, Identifiable {

  sessionId:               ~
  session:                 ~
  doNotStopOnCacheRelease: ~

  /**
   * @return all service instances.
   */
  services: abstract member function(): CloudListServiceResult

  /**
   * @return the orchestration platform to be used to start this service
   */
  orchestrator: abstract member function(): CloudServiceOrchestrator

  /**
   * @return logs of the container(s) representing the service, organized by container name, null if none available
   */
  containerLogs: abstract member function(): map<string, string>
}
