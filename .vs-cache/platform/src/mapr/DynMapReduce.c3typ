/**
 * Dynamically run a {@link MapReduce} job without having to create a dedicated type and provision it.
 * Good use cases includes experiments and one off executions.
 * For production purposes, please create a dedicated type extending {@link MapReduce}.
 * Mixing different lambda languages is supported.
 *
 * Basic usage with JavaScript lambdas:
 *
 * ```javascript
 * var job = DynMapReduce.make({
 *   targetType: "User",
 *   mapLambda: Lambda.fromJsFunc(function (batch, objs, job) {
 *     return { key: objs.length };
 *   }),
 *   reduceLambda: Lambda.fromJsFunc(function (key, interValues, job) {
 *     return [interValues.pluck('value').sum()];
 *   })
 * }).create();
 * job.start();
 * // wait for completion
 * job.results();
 * ```
 *
 * Basic usage with Python lambdas:
 *
 * ```python
 * mapper = lambda batch, objs, job, subBatch: {'key': len(objs)}
 * reducer = lambda key, interValues, job: [sum(interValues)]
 * job = c3.DynMapReduce(
 *     targetType="User",
 *     mapLambda=c3.Lambda.fromPyFunc(mapper),
 *     reduceLambda=c3.Lambda.fromPyFunc(reducer)
 * ).create()
 * job.start()
 * ```
 */
entity type DynMapReduce extends MapReduce<any, string, any, any> mixes DynMapReduceLambda type key 'DYN' {

  /**
   * Create an instance of {@link DynMapReduce} from a spec and start the job.
   *
   * @param spec
   *        spec that defines the job
   * @return the instance of the job that has been started
   */
  startFromSpec: function(spec: !DynMapReduceSpec): !DynMapReduce

  map:          ~
  mapCompleted: ~
  reduce:       ~
  completed:    ~
  failed:       ~
}
