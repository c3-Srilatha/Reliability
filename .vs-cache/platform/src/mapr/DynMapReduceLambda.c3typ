/**
 * Shared fields to define a {@link DynMapReduce} and {@link DynMapReduceSpec}.
 */
type DynMapReduceLambda {

  targetType: !Type

  /**
   * Context on the job that can be used in the functions {@link #map} and {@link #reduce}.
   */
  context: Obj

  /**
   * Lambda to define the "map" part of the job.
   * The signature must match the one of {@link DynMapReduce#map}.
   */
  mapLambda: !Lambda<function(batch: int,
                              objs: [any],
                              job: DynMapReduce<any, string, any, any>,
                              subBatch: int): map<string, any>>

  /**
   * Lambda to execute after the "map" part of the job is completed.
   * The signature must match the one of {@link DynMapReduce#mapCompleted}.
   */
  mapCompletedLambda: Lambda<function(job: DynMapReduce<any, string, any, any>)>

  /**
   * Lambda to define the "reduce" part of the job.
   * The signature must match the one of {@link DynMapReduce#reduce}.
   */
  reduceLambda: Lambda<function(outKey: string, interValues: [any], job: DynMapReduce<any, string, any, any>): [any]>

  /**
   * Lambda to execute after the "reduce" part of the job is completed.
   * The signature must match the one of {@link DynMapReduce#completed}.
   */
  completedLambda: Lambda<function(job: DynMapReduce<any, string, any, any>): string>

  /**
   * Lambda to execute when the job fails.
   * The signature must match the one of {@link DynMapReduce#failed}.
   */
  failedLambda: Lambda<function(job: DynMapReduce<any, string, any, any>,
                                status: MapReduceStatus,
                                options: MapReduceOptions)>
}
