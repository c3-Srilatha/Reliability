/**
 * Represents a unique url mapping of a {@link urlPath} to its destination, or {@link targetModuleName} and
 * {@link targetPageName}.
 */
@db(unique=['urlPath'])
type UiSdlRoute mixes Metadata, Named {

  /**
   * The url path defining the route.
   *
   * Requirements:
   * - Must NOT end with `/`, exception for root route
   * - Can contain route variables, denoted by a variable identifier surrounded by `{{` and `}}` characters.
   *
   * Examples:
   * - `/home`
   * - `facilities/{{facilityId}}/edit`
   * - `/` (i.e. the "default" or "root" route)
   */
  @constraint(condition='!endsWith(urlPath, "/") || length(urlPath) == 1')
  urlPath: !string serialized UrlPath

  /**
   * The UI module to which the {@link targetPageName} belongs. When concatenated with {@link targetPageName}, this
   * forms the component's metadata id, e.g. `'MyApp.HomePage'`.
   * PascalCase format is recommended with no dashes.
   */
  targetModuleName: private string

  /**
   * The name of the {@link UIViewPage} or {@link UIReactPage} to which the url leads. When concatenated with
   * {@link targetModuleName}, this forms the component's metadata id, e.g. `'MyApp.HomePage'`.
   * PascalCase format is recommended with no dashes.
   */
  targetPageName: !string

  /**
   * The component's metadata id, e.g. `'MyApp.HomePage'`.
   * Note: we are using a token of two hyphens so that a user may enter a `targetPageName` value with
   * empty spaces or hyphens (it's extremely unlikely they would have a page name with two hyphens).
   * We need to be able to convert back and forth between the targetPageId and the targetPageName, because
   * when we create a new route for a page, we force a page name that is derived from the page id.
   */
  targetPageId: string stored calc concat(targetModuleName, ".", replace(targetPageName, " ", "--"))

  /**
   * The {@link Role} that is required to access this route. If not specified, the route is accessible to all users.
   */
  role: string serialized Role

  /**
   * The name of the document you'd like to be able to open at this route.
   * For example, to show `example-document.c3doc.md`, the `inAppDoc` would be `example-document`.
   */
  inAppDoc: string

  /**
   * Returns a list of pairs of {@link UiSdlRoute}s with {@link Role}s that can access the route in the target application.
   * If the route has no roles associated to it, it returns all the available roles as page is accessible to all the roles.
   * @param spec
   *           The fetch spec used when fetching the {@link UiSdlRoute}s in the application
   * @return
   *           The list of pairs
   */
  @action(group='user-admin')
  allRolesPerRoute: private function(spec: FetchSpec): [Pair<UiSdlRoute, [Role]>] js-server

  /**
   * Fetch all the routes that belongs to a role and any roles associated to it.
   * @return
   *           The list of retrieved {@link UiSdlRoute}s.
   */
  @action(group='user-admin')
  fetchRoutesForRole: function(spec: FetchSpec, role: Role): FetchResult<UiSdlRoute> js-server
}
