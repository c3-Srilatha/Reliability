/**
 * Type source code loader (non-React *.c3typ annotated with @typescript)
 */
@deprecated(finalVersion='8.7', details='Use UiSdlTsTypesSourceCodeLoader in uiInfrastructure instead')
private type UiSdlTypesSourceCodeLoader mixes UiSdlFileLoader {

  /**
   * Generates source code for each type
   */
  produceAll: ~

  /**
   * Adds imports and exports for epics, reducers, action creators and default values.
   *
   * @param code
   *           The raw code that will have imports/exports added
   * @param componentType
   *           The typeRef that refers to the type that is getting migrated
   * @return The modified code
   */
  addImportsAndExports: function(code: string, componentTypeMeta: TypeMeta): string

  /**
   * Calls {@link addImportsAndExports} for each input
   * @param inputs
   *            Pair.fst represents `code` parameter in addImportsAndExports;
   *            Pair.snd represents `componentType` parameter in addImportsAndExports
   * @return outputs from {@link addImportsAndExports} in the same order as the inputs parameter
   */
  addImportsAndExportsBatch: function(inputs: [Pair<string, Type>]): [UiSdlMetadataLoaderResult]

  /**
   * Adds a defaultValues export, if the type is not *React
   *
   * @param typeRef
   *           The typeRef whose type will have defaultValues added
   * @return export statement
   */
  addDefaultValuesExport: function(typeMeta: TypeMeta): string

  /**
   * Returns a map of {@link Type#name}s to {@link MetadataFileValue} for a given set of types and
   * extension with proper source code implementation.
   *
   * Our .ts and .tsx implementations (ESM modules) cannot easily include duplicate code and
   * the current C3 platform APIs that retrieve code for a type, concatenate all the implementations
   * of the type's hierarchy.
   *
   * @param types
   *           The array of {@link TypeMeta}s to get the gien extension source code for
   * @param extension
   *           The extension/ implementation language to fetch source code for
   * @returns A of {@link Type#name}s to {@link UiSdlMetadataFile} whose content is the source code for
   *           the given extension.
   */
  // TODO UI-11523: don't expose this function
  filesForTypeMetas: function(types: [TypeMeta], extension: string): map<string, UiSdlMetadataFile>
}
