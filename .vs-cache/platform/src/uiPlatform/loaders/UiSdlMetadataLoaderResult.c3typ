/**
 * Output for {@link UiSdlMetadataLoader.addImportsAndExportsBatch} and
 * {@link UiSdlMetadataLoader.generateUiSdlComponentSourceCodeBatch}
 */
type UiSdlMetadataLoaderResult {

  /**
   * Transpiled code
   */
  content: string

  /**
   * Error when transpiling the file
   */
  error: string

  /**
   * Indicate the file should be ignored.
   */
  ignore: boolean
}
