/**
 * Represents a metadata file that contains code or other metadata for the UI.
 *
 * Used in UiSdlMetadataLoader as a wrapper for the files that are generated by it.
 */
type UiSdlMetadataFile {

  /**
   * The content of this file
   */
  file: Pkg.File

  /**
   * Used to find its Federated Module in the corresponding mapping.
   *
   * 'core' means it is part of the c3ui_core Federated Module
   * 'all' means any Federated Module can contain it
   */
  category: string enum UiSdlMetadataFileCategory = CORE

  /**
   * The name of the ESM module this file represents. Default: file.fileNameNoExt().
   *
   * This is used to find the containing federated module in combination with the category.
   */
  moduleName: string

  /**
   * Converts a MetadataFile into a UiSdlMetadataFile.
   */
  fromFile: function(file: !Pkg.File,
                     category: string enum UiSdlMetadataFileCategory,
                     moduleName: string): UiSdlMetadataFile

  /**
   * Creates a UiSdlMetadataFile from text. A valid path and content type have to be provided.
   */
  fromText: function(pathOrUrl: !string,
                     contentType: !string,
                     text: !?string,
                     category: string enum UiSdlMetadataFileCategory,
                     moduleName: string): UiSdlMetadataFile

  /**
   * Creates a UiSdlMetadataFile from TypeScript code. A valid path has to be provided.
   */
  fromTsCode: function(pathOrUrl: !string,
                       code: !?string,
                       category: string enum UiSdlMetadataFileCategory,
                       moduleName: string): UiSdlMetadataFile
}
