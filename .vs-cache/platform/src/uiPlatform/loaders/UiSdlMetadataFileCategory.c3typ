/**
 * Categories for UiSdlMetadataFile.
 *
 * These are used to find their corresponding federatedModule when generating manifests by
 * using the known mappings (see {@link UiSdlMetadataFileManifestCache#generateManifest}) and other module mapping
 * methods like {@link UiSdlMetadataLoader#generateComponentToFederatedModuleMapping}.
 */
enum type UiSdlMetadataFileCategory {

  /**
   * Type source code
   */
  TYPE = 'type'

  /**
   * Type DataSpec TS source code generated from type metadata.
   */
  TYPE_DATA_SPEC = 'typeDataSpec'

  /**
   * Component TSX source code generated from JSON.
   */
  COMPONENT = 'component'

  /**
   * Test files
   */
  TEST = 'test'

  /**
   * Files in the shared core federated module ('c3ui_core').
   */
  CORE = 'core'

  /**
   * Files that affect all federated modules, they invalidate all caches when they change.
   * The manifests will not mention any federated module for them since they are not tied to
   * a subset of them.
   */
  ALL = 'all'
}
