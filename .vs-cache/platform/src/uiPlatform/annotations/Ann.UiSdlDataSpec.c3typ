/**
 * A {@link UiSdlComponentDataSpec} should specify both a component's data configuration as well
 * as how the data is to be displayed in the component. This type represents a mapping between a
 * component's {@link UiSdlComponentDataSpec} and the destination field at which the data will live
 * at runtime.
 *
 * Example:
 *      type MyMapComponent extends UiSdlComponent {
 *          title: string
 *
 *          // UiSdlComponent will find the DS created from the dataSpec, load it, put the data in 'mapDataPoints'
 *          @uiSdlDataSpec(dataDestinationField="mapDataPoints")
 *          mapDataPointsDataSpec: MyMapComponent.DataSpec
 *
 *          // here is where the actual data will eventually be stored; should be private
 *          mapDataPoints: private [any]
 *      }
 */
@annotation(appliesTo=['field'])
@typeScript
type Ann.UiSdlDataSpec mixes Annotation {

  /**
   * The target field to hold data retrieved by the annotated data spec.
   */
  dataDestinationField: !string
}
