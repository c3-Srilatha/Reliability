/**
 * A UI Epic is a function that returns a Rx observable used in the redux store epicStream for a given action type.
 *
 * The signature of the function has to be: (actionStream: UiSdlActionsObservable, stateStream: UiSdlStatesObservable) => UiSdlActionsObservable.
 *
 * Example:
 *      function requestData(actionStream, stateStream) {
 *          return actionStream.map(function (action) {
 *              return {type: dataSource.id + '.DATA_RECEIVE', payload: data, meta: {dataSource: action.meta.dataSource} error: false}
 *          })
 *      }
 */
@annotation(docPills={Epic: 'true'})
type Ann.UiSdlEpic mixes Ann.UiSdlReducer, Annotation
