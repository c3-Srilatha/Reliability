/**
 * A UI reducer is a function that will be used in the redux store for a given action type.
 *
 * The signature of the function has to be: (state: UiSdlReduxState, action: UiSdlReduxAction) => UiSdlReduxState.
 *
 * It is important to always include a valid {@link UiSdlReduxState} object as the return value.
 *
 * Example:
 *      function receiveData(state, action) {
 *          return state.putAt("entities['" + action.meta.dataSource.id+ "']'", action.payload)
 *      }
 */
@annotation(appliesTo=['function'], docPills={Reducer: 'true'})
type Ann.UiSdlReducer mixes Annotation {

  /**
   * The redux action type to be handled by the annotated function. Preferred format: NOUN_VERB
   * You can capture multiple action types by passing an array.
   */
  actionType: [string] | string

  /**
   * The name of the function being annotated
   */
  functionName: private string
}
