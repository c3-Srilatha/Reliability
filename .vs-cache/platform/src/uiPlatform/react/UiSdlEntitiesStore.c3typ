/**
 * Stores the data retrieved from C3 Platform.
 */
type UiSdlEntitiesStore mixes UiSdlImmutableJS<any> {

  /**
   * A map containing all data source's data.
   * Key: Data Source id.
   * Value: The data retrieved from C3 Platform.
   */
  original: UiSdlImmutableJS<map<string, any>>

  /**
   * If data source is editable, all edits will be reflected here.
   * Has the same structure as {@link original}
   */
  modified: UiSdlImmutableJS<map<string, any>>
}
