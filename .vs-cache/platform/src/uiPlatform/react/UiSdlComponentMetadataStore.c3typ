/**
 * Page, component and data source configuration values.
 */
type UiSdlComponentMetadataStore mixes UiSdlImmutableJS<any> {

  /**
   * Contains all the component and page metadata.
   */
  components: UiSdlMetadataEntries

  /**
   * Contains all the application state metadata
   */
  applications: UiSdlMetadataEntries

  /**
   * Contains all the data source metadata.
   */
  dataSources: UiSdlMetadataEntries
}
