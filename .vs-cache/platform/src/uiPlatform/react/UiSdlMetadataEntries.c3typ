/**
 * Collection of metadata entries in a normalized way for easy access.
 * Each entry contains the metadata (configuration values) for an instance
 * of a component, page or data source.
 */
type UiSdlMetadataEntries mixes UiSdlImmutableJS<map<string, map<string, any>>> {

  /**
   * Contains the stored metadata entries. Indexed by id.
   */
  byId: UiSdlImmutableJS<map<string, map<string, any>>>

  /**
   * Identifiers of all the stored metadata entries.
   */
  ids: [string]
}
