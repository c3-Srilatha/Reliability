abstract duck type MutableObjEventSource mixes EventSource, MutableObj {

  /**
   * If the tracked `changes` are for MutableObjEventSource type fields on this instance, update the listeners for
   * those fields.
   */
  updateChangeListeners: private member function(changes: ![string]) js-client

  /**
   * @inheritDoc MutableObj.onChange
   * Triggers {@link FieldChangeEvent} on {@link EventSource}
   */
  onChange: ~ java | js
}
