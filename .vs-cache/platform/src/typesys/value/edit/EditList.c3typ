/**
 * External edit list types
 */
type EditList {

  /**
   * list of edits
   */
  fieldEdits: !map<string, FieldEdit>

  mixinObj:              private Obj
  removeMixinObj:        private boolean
  mixinType:             private Type
  removeMixinType:       private boolean
  hasFieldEditAtPath:    private inline member function(type: !Type, fieldPath: !string, objPath: [any]): boolean
  fieldEditAtPath:       private inline member function(type: !Type, fieldPath: !string, objPath: [any]): FieldEdit
  removeFieldEditAtPath: private inline member function(type: !Type, fieldPath: !string, objPath: [any]): EditList
  putFieldEditAtPath:    private inline member function(type: !Type,
                                                        fieldPath: !string,
                                                        objPath: [any],
                                                        value: any): !EditList

  putFieldEditsAtPath: private inline member function(type: !Type,
                                                      parentPath: string,
                                                      fieldValues: map<string, any>): !EditList

  appendArryValueAtPath: private inline member function(type: !Type,
                                                        fieldPath: !string,
                                                        objPath: [any],
                                                        value: any): !EditList

  applyTo:    private inline member function(obj: !Obj, baseType: !?Type): !Obj
  fieldPaths: private inline member function(parentField: string): [string]
}
