/**
 * Obj that has a single field that is an arry of "any".  Useful for boxing arrys.
 */
@deprecated(finalVersion='8.0.0')
type ArryObj mixes Boxed<[any]> {

  /**
   * Creates an ArryObj from an Arry.
   */
  fromArry: function(arry: !?[any]): ArryObj

  /**
   * Returns the Arry in {@link value}.
   */
  toArry: member function(): [any]
}
