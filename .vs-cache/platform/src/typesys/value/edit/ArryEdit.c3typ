/**
 * @see CollectionUpdate
 */
type ArryEdit mixes CollectionEdit {

  /**
   * list of arry edit operations
   */
  valueEdits: [ArryValueEdit]

  /**
   * Iterates over objArray1 and objArray2, diffs it and returns the array of EditList for each of the objs
   * If objArray1 and objArray2 are of different length, the "missing" elements from the shorter one are treated as
   * null.
   *
   * @param objArray1
   *           an array of objs that compare against objs in objArray2
   * @param objArray2
   *           an array of objs to compare objs in objArray1
   *
   * @return ArryEdit containing the diff of objs at each index
   */
  fromDiff: private function(objArray1: !?[Obj], objArray2: !?[Obj]): ArryEdit
}
