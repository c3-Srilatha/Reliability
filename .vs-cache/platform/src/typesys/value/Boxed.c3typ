/**
 * For serialization of any C3 values, we can specify the type using this generic class.
 * This is only necessary if a value being passed in a context where the receiver doesn't know the type, for example a
 * function parameter declared as `any`, or when the receiver is expecting a parent type of the actual instance.
 *
 * By convention, we omit `"Boxed<>"` in the `type` field of serialized Boxed instances.  For example, a boxed int has
 * type `"Boxed<int>"`, but would normally be serialized as `{'type': "int", value: 42}` instead of
 * `{'type': "Boxed<int>", value: 42}`.
 *
 * **NOTE** Because `WithType` instances have a natural serialization that includes their type information,
 * they should **never** be explicitly boxed. For example, `{'type': "Dog", 'value': {'name': "Fido"}}` is incorrect and
 * `{'type': "Dog", 'name': "Fido"}` is correct.
 *
 * @see serdeser.c3doc
 */
type Boxed<V> mixes Obj {

  // TODO: schema suffix 'VAL'
  value: V

  /**
   * Return value type of a boxed value
   */
  valueType: function(): !ValueType

  /**
   * Return boxed value
   * @param includeConvertibleTypes @see ValueType#guessType
   * @param preserveEmpty if true, applies PRESERVES_EMPTY modifier to the value type
   */
  box: function<T>(v: !?T, includeConvertibleTypes: boolean, preserveEmpty: boolean): Obj
}
