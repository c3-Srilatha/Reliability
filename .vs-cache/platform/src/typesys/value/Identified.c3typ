/**
 * Type describing identified objects. E.g. database entities that have primary key or a person with SSN.
 * This ID is expected to be unique within its domain; for logical labels see the #Named type.
 *
 * @see Named
 */
@constraint(unique='id')
abstract type Identified mixes WithUniqueId, Identifiable, StringSerializable {

  /**
   * The unique and required id of this instance.
   */
  id: !~

  /**
   * @return single instance of this Identified type by id.
   */
  forId: abstract inline function(id: !?string, failIfMissing: boolean): mixing Identified

  fromString: ~ java | js | py
  toString:   ~ java | js | py
}
