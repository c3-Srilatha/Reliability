/**
 * Builder of maps.
 *
 * @see Map#buidlerOf
 * @see MapType#makeBuidler
 * @see Map#toBuidler
 */
type MapBuilder<K, E> mixes CollectionBuilder<E>, Value {

  /**
   * Puts new element in this map builder.
   */
  e: member function(k: !?K, e: !?E): !mixing MapBuilder<K, E> java | js | py

  /**
   * Puts new element in this map builder specifying if the given value should be converted or not
   */
  e: member function(k: !?any, e: !?any, doNotConvert: !boolean): !mixing MapBuilder<K, E> java | js | py

  /**
   * Returns true if this map builder contains a mapping for the specified key.
   */
  containsKey: member function(k: !?K): boolean java | js | py

  /**
   * Puts new element in this map builder.
   */
  put: member function(k: !?K, e: !?E): !mixing MapBuilder<K, E> java | js | py

  /**
   * Puts new entry in this map builder.
   */
  put: member function(entry: !Pair<K, E>): !mixing MapBuilder<K, E> java | js | py

  /**
   * Puts new entry in this map builder if it does not exists or modifies value of an existing entry.
   */
  put: member function(k: !?K, initial: !lambda(): E, agg: !lambda(e: E): E): !mixing MapBuilder<K, E> java | js | py

  /**
   * Puts new element collection builder in this map builder. Assumes this is a builder of map or collections
   */
  putCollection: member function(k: !?K,
                                 elemBuilder: !lambda(b: CollectionBuilder<any>)): !mixing MapBuilder<K, E> java | js | py

  /**
   * Puts new element reference builder in this map builder. Assumes this is a builder of map or collections
   */
  putRef: member function(k: !?K, elemBuilder: !lambda(b: ObjBuilder<Obj>)): !mixing MapBuilder<K, E> java | js | py

  /**
   * Puts new element to this builder if key is not already present and return true if element was added
   */
  putIfKeyMissing: member function(k: !?K, e: !?E): boolean java | js | py

  /**
   * Puts  new element to this builder if key is not already present based on provided predicate and return true if
   * element was added
   */
  putIfMissing: member function(k: !?K, e: !?E, predicate: !lambda(e: E, k: K): boolean): boolean java | js | py

  /**
   * Puts all elements from provided map in this map builder.
   */
  putAll: member function(keyElements: !?map<K, E>): !mixing MapBuilder<K, E> java | js | py

  /**
   * Puts all key and elements from provided arguments where first argument is a key second is an element and so on.
   */
  putKeyElements: member function(keyElements: any ...): !mixing MapBuilder<K, E> java | js | py

  /**
   * Gets element for key and if missing puts new one based on provided default.
   */
  get: member function(k: !?K, dflt: lambda(): E): E java | js | py

  /**
   * Removes key from this map builder and returns `true` if existed
   */
  removeKey: member function(k: !?K): boolean java | js | py

  /**
   * Removes keys from this map builder and returns count of keys actually removed
   */
  removeKeys: member function(keys: !?Collection<K>): !int java | js | py

  /**
   * Retrieves value for the key if exists or puts new one
   */
  upsert: member function(key: !?K, value: !lambda(): E): E

  /**
   * Build new map with keys sorted in a natural order.
   */
  sortKeys: member function(): !mixing MapBuilder<K, E> java | js

  /**
   * Build new map with keys sorted based on provided comparator.
   */
  sortKeys: member function(comparator: !lambda(a: K, b: K): @comparator int32): !mixing MapBuilder<K, E> java | js

  /**
   * Clears contents of this map builder.
   */
  clear: ~: !mixing MapBuilder<K, E> java | js | py

  /**
   * @return value type of the key.
   */
  keyType: member function(): !ValueType java | js | py

  addIfMissing:   ~ java | js | py
  collectionType: ~: !MapType java | js | py
  current:        ~: map<K, E> java | js | py
  build:          ~: map<K, E> java | js | py
  elementType:    ~ java | js | py
  fromJson:       ~ java | js | py
  merge:          ~ java | js | py
  replace:        ~ java | js | py
  make:           ~ java | js | py
  type:           ~ java | js | py
}
