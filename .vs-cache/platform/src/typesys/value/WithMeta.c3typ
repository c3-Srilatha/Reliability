/**
 * Base type for object with `meta` field.
 */
abstract type WithMeta {

  /**
   * The meta information of this instance.
   */
  // TODO: PLAT-82341 WithMeta tech debt
  // Meta
  meta: any

  /**
   * @returns Whether or not the specific field name is an internal field.
   */
  isSystemField: function(name: !string): boolean java | js | py
}
