/**
 * Convenient box for two related values. This is useful for packaging multiple values without having to define a
 * custom type.
 *
 * The usual way to create these is with the #of method, but many specialized methods exist to create a pair with
 * specific types (such as #ofStr).
 *
 * @see Triple
 */
inline type Pair<T1, T2> mixes WithToString {

  /**
   * First value of pair.
   */
  fst: T1

  /**
   * Second value of pair.
   */
  snd: T2

  /**
   * Create an instance where #fst and #snd are set to the two specified values. The returned instance will be of a
   * type bound to `any` if the original type is generic.
   *
   * @param fst value to be used for the #fst field
   * @param snd value to be used for the #snd field
   * @return Pair instance
   */
  of: final function<V1, V2>(fst: V1, snd: V2): !Pair<V1, V2> java | js

  /**
   * Create an instance where #fst and #snd are set to the two specified values. If `guessType` is true, the returned
   * instance will be of a type bound as appropriate for the values, otherwise bound to `any`.
   *
   * @param fst value to be used for the #fst field
   * @param snd value to be used for the #snd field
   * @param guessType if true, the returned instance will be of a type bound to the actual values
   * @return Pair instance
   */
  of: final function<V1, V2>(fst: V1, snd: V2, guessType: boolean): !Pair<V1, V2> java | js

  /**
   * Create an instance with both values of type `string`.
   *
   * @see #of
   */
  ofStr: final function(fst: string, snd: string): !Pair<string, string> java | js

  /**
   * Create an instance with both values of type `boolean`.
   *
   * @see #of
   */
  ofBool: final function(fst: boolean, snd: boolean): !Pair<boolean, boolean> java | js

  /**
   * Create an instance with both values of type `int`.
   *
   * @see #of
   */
  ofInt: final function(fst: int, snd: int): !Pair<int, int> java | js

  /**
   * Create an instance with both values of type `int16`.
   *
   * @see #of
   */
  ofInt16: final function(fst: int16, snd: int16): !Pair<int16, int16> java | js

  /**
   * Create an instance with both values of type `int32`.
   *
   * @see #of
   */
  ofInt32: final function(fst: int32, snd: int32): !Pair<int32, int32> java | js

  /**
   * Create an instance with values of types `int` and `string`.
   *
   * @see #of
   */
  ofIntStr: final function(fst: int, snd: string): !Pair<int, string> java | js

  /**
   * Create an instance with both values of type `float`.
   *
   * @see #of
   */
  ofFloat: final function(fst: float, snd: float): !Pair<float, float> java | js

  /**
   * Create an instance with both values of type `double`.
   *
   * @see #of
   */
  ofDbl: final function(fst: double, snd: double): !Pair<double, double> java | js

  /**
   * Create an instance with values of types `double` and `string`.
   *
   * @see #of
   */
  ofDblStr: final function(fst: double, snd: string): !Pair<double, string> java | js

  /**
   * Create an instance with both values of type `Obj`.
   *
   * @see #of
   */
  ofObj: final function(fst: Obj, snd: Obj): !Pair<Obj, Obj> java | js

  /**
   * Create an instance with values of types {@link Obj} and `string`.
   *
   * @see #of
   */
  ofObjStr: final function(fst: Obj, snd: string): !Pair<Obj, string> java | js

  /**
   * Create an instance with values of types {@link Obj} and `int`.
   *
   * @see #of
   */
  ofObjInt: final function(fst: Obj, snd: int): !Pair<Obj, int> java | js

  /**
   * Create an instance with values of types {@link Obj} and `int32`.
   *
   * @see #of
   */
  ofObjInt32: final function(fst: Obj, snd: int32): !Pair<Obj, int32> java | js

  /**
   * Create an instance with values of types {@link Obj} and `double`.
   *
   * @see #of
   */
  ofObjDbl: final function(fst: Obj, snd: double): !Pair<Obj, double> java | js

  /**
   * Create an instance with both values of type `any`.
   *
   * @see #of
   */
  ofAny: final function(fst: any, snd: any): !Pair<any, any> java | js

  /**
   * Create an instance with both values of the specified value type.
   *
   * @see #of
   */
  ofTwin: final function<V>(valueType: !ValueType, fst: V, snd: V): !Pair<V, V> java | js

  /**
   * Return the value type of the generic binding for the #fst field. If the type is generic, this will throw an error.
   */
  fstType: final member function(): !ValueType

  /**
   * Return the value type of the generic binding for the #snd field. If the type is generic, this will throw an error.
   */
  sndType: final member function(): !ValueType

  typeOf:         final function(fstType: !ValueType, sndType: !ValueType): !Type
  typeOfStr:      cached final function(): !Type
  typeOfBool:     cached final function(): !Type
  typeOfInt:      cached final function(): !Type
  typeOfInt16:    cached final function(): !Type
  typeOfInt32:    cached final function(): !Type
  typeOfIntStr:   cached final function(): !Type
  typeOfFloat:    cached final function(): !Type
  typeOfDbl:      cached final function(): !Type
  typeOfDblStr:   cached final function(): !Type
  typeOfSame:     cached final function(valueType: !ValueType): !Type
  typeOfAny:      cached final function(): !Type
  typeOfObj:      cached final function(): !Type
  typeOfObjStr:   cached final function(): !Type
  typeOfObjInt:   cached final function(): !Type
  typeOfObjInt16: cached final function(): !Type
  typeOfObjInt32: cached final function(): !Type
  typeOfObjDbl:   cached final function(): !Type
  toString:       ~ java | js
}
