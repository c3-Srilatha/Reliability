/**
 * Base type for common collection constructor methods.
 */
abstract type CollectionConstructors<E> mixes Value {

  /**
   * @return collection of provided element type and values.
   */
  of: abstract function<T>(elementType: !ValueType, elements: T ...): mixing CollectionConstructors<T>

  /**
   * @return collection of any with provided elements.
   */
  ofAny: abstract function<T>(elements: T ...): mixing CollectionConstructors<T>

  /**
   * @return collection of provided booleans.
   */
  ofBool: abstract function(elements: boolean ...): mixing CollectionConstructors<boolean>

  /**
   * @return collection of provided 64 bit integers.
   */
  ofInt: abstract function(elements: int ...): mixing CollectionConstructors<int>

  /**
   * @return collection of provided 32 bit integers.
   */
  ofInt32: abstract function(elements: int32 ...): mixing CollectionConstructors<int32>

  /**
   * @return collection of provided 16 bit integers.
   */
  ofInt16: abstract function(elements: int16 ...): mixing CollectionConstructors<int16>

  /**
   * @return collection of provided floats.
   */
  ofFloat: abstract function(elements: float ...): mixing CollectionConstructors<float>

  /**
   * @return collection of provided doubles.
   */
  ofDbl: abstract function(elements: double ...): mixing CollectionConstructors<double>

  /**
   * @return collection of provided doubles.
   */
  ofByte: abstract function(elements: byte ...): mixing CollectionConstructors<byte>

  /**
   * @return collection of provided datetime.
   */
  ofDateTime: abstract function(elements: datetime ...): mixing CollectionConstructors<datetime>

  /**
   * @return collection of provided string.
   */
  ofStr: abstract function(strs: string ...): mixing CollectionConstructors<string>

  /**
   * @return collection of generic obj and provided instances.
   */
  ofObj: abstract function(objs: Obj ...): mixing CollectionConstructors<Obj>

  /**
   * @return collection of provided C3 type and provided instances.
   */
  ofObj: abstract function<O: Obj>(type: !Type, objs: Obj ...): mixing CollectionConstructors<O>

  /**
   * @return collection of provided integers in a range.
   */
  ofIntInRange: abstract function(min: !int, max: !int, step: int): mixing CollectionConstructors<!int>

  /**
   * @return collection of provided integers in a range.
   */
  ofInt32InRange: abstract function(min: !int32, max: !int32, step: int32): mixing CollectionConstructors<!int32>
}
