/**
 * A path between points (2D).
 */
type GeoLineString mixes ComposedGeo<GeoPoint> {

  /**
   * Constructs a GeoLineString from a Google encoded polyline object.
   *
   * @param polyline
   *           Google encoded polyline
   *
   * @return GeoLineString created from the Google encoded polyline.
   */
  fromGoogleEncodedPolyline: function(polyline: !string): GeoLineString
}
