native py remix type Set {

  /**
   * Returns whether two sets have a intersection or not
   */
  isdisjoint: member function(that: !?native): !boolean py

  /**
   * Returns whether another set contains this set or not
   */
  issubset: member function(that: !?native): !boolean py

  /**
   * Returns whether this set contains another set or not
   */
  issuperset: member function(that: !?native): !boolean py
}
