type JMS {

  /**
   * @return list of queues.
   */
  @action(group+='monitor')
  listQueues: function(): [JMSQueue]

  /**
   * @param name - the queue name
   * @return the queue that matches given name
   */
  getQueue: function(name: string): JMSQueue

  /**
   * Upserts the given queue
   * @param queue - the queue that needs to be created
   * @return the queue that is created
   */
  upsertQueue: function(queue: JMSQueue): JMSQueue

  /**
   * Purges all entries in the given queue
   * @param name - the queues that needs to be purged
   */
  purgeQueue: function(name: string)

  /**
   * Removes given queue with all its messages
   * @param name - the queues that needs to be removed
   */
  removeQueue: function(name: string)

  /**
   * Reset all JMS Connections (producers/consumers) that are cached earlier in all nodes part of the cluster
   */
  resetAllConnectionsAtClusterLevel: function()

  /**
   * Reset all JMS Connections (producers/consumers) on the node where it is issued.
   */
  resetAllConnections: function()
}
