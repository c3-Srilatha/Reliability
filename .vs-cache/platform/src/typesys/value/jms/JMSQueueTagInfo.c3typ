/**
 * Tenant/tag/type and JMS queue info for a tenant/tag.
 */
private type JMSQueueTagInfo mixes Result {

  /**
   * Tenant the queue is for.
   */
  tenant: string

  /**
   * Tag that the queue is for.
   */
  tag: string

  /**
   * TenantTagId that must match the one for the tenant/tag.
   */
  appCode: int

  /**
   * Info for all queues for the tenant/tag.
   */
  queues: [JMSQueueTypeInfo]
}
