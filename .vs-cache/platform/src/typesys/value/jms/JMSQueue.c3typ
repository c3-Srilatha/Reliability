type JMSQueue {

  /**
   * This denotes the Queue Name
   */
  name: string

  /**
   * Maximum number of bytes that can be persisted. 0 indicates NO Upper bound
   */
  maxBytes: int = 0

  /**
   * Maximum number of messages that can be persisted. 0 indicates NO Upper bound
   */
  maxMessages: int = 0

  /**
   * Indicates what needs to be done, when either of maxBytes (or) maxMessages is reached
   */
  overflowPolicy: string enum('OVERFLOW_DISCARD_OLD', 'OVERFLOW_REJECT_INCOMING') = "'OVERFLOW_REJECT_INCOMING'"

  pendingMsgCount:    int
  pendingMsgAckCount: int
  pendingMsgSize:     int

  /**
   * The below returns whether the queue is exclusive or not. In exclusive mode, only one consumer gets the
   * messages and no parallelization of consumption is done.
   * @param queue - reference to queue
   * @return whether queue is exclusive or not
   */
  isExclusive: function(queue: JMSQueue): boolean

  /**
   * Indicates whether the queue needs to be exclusive or not.
   * In exclusive mode, the messages gets delivered sequentially to only one consumer
   * And it is highly recommended to turn this off unless it is absolutely needed as you would see performance
   * degradation as things would be consumed by only one consumer if it is turned on.
   * @param queue - reference to queue object
   * @param exclusive - indicates whether the queue needs to be exclusive or not.
   */
  setExclusive: function(queue: JMSQueue, exclusive: boolean)

  /**
   * Purges all messages from a given queue
   * @param queue - reference to queue object
   */
  clear: function(queue: JMSQueue)

  /**
   * Publishes the given message to the queue
   * @param queue - reference to queue object
   * @param msg - JMSMessage that needs to be published
   */
  publish: function(queue: JMSQueue, msg: JMSMessage)

  /**
   * Returns the message if available
   * @param queue - reference to queue object
   * @return the message is available
   */
  receiveNoWait: function(queue: JMSQueue): JMSMessage

  /**
   * Returns the messages in the queue without removing the messages from the queue
   * @param this_ - reference to queue object
   * @param limit - number of messages, default is 10
   * @return messages from the queue
   */
  peek: function(this_: JMSQueue, limit: int): [JMSMessage]
}
