type JMSMessage {

  /**
   * Message Id
   */
  id: string

  /**
   * Message text in string format
   */
  text: string

  /**
   * Holds all the application defined properties as <name,value> pairs
   */
  properties: map<string, string>

  /**
   * Acknowledges the message
   * @param msg - Acknowledges the given JMSMessage
   */
  ack: function(msg: JMSMessage)
}
