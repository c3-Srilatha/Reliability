/**
 * C3 Type for implementing lambda based push stream.
 */
type LambdaPushStream<V> mixes PushStream<V>, Value {

  /**
   * callback lambda on write to this stream
   */
  onWrite: private lambda(v: V, s: PushStream<V>)

  // TODO PLAT-18839 code gen should figure to call childs method in inline way
  write: inline ~

  writeBatch:  inline ~
  writeStream: inline ~
}
