/**
 * Base type for common collection builder constructor methods.
 */
abstract type CollectionBuilderConstructors<B: CollectionBuilder> mixes Value {

  /**
   * @return collection of provided element type and values.
   */
  builderOf: abstract function<T>(elementType: !ValueType, elements: T ...): !B<T>

  /**
   * @return collection of any with provided elements.
   */
  builderOfAny: abstract function<T>(elements: T ...): !B<T>

  /**
   * @return collection of provided 64 bit integers.
   */
  builderOfInt: abstract function(elements: int ...): !B<!int>

  /**
   * @return collection of provided 32 bit integers.
   */
  builderOfInt32: abstract function(elements: int32 ...): !B<!int32>

  /**
   * @return collection of provided 16 bit integers.
   */
  builderOfInt16: abstract function(elements: int16 ...): !B<!int16>

  /**
   * @return collection of provided floats.
   */
  builderOfFloat: abstract function(elements: float ...): !B<!float>

  /**
   * @return collection of provided doubles.
   */
  builderOfDbl: abstract function(elements: double ...): !B<!double>

  /**
   * @return collection of provided string.
   */
  builderOfStr: abstract function(strs: string ...): !B<string>

  /**
   * @return collection of provided byte.
   */
  builderOfByte: abstract function(bytes: byte ...): !B<byte>

  /**
   * @return collection of provided booleans.
   */
  builderOfBool: abstract function(bools: boolean ...): !B<boolean>

  /**
   * @return collection of provided byte.
   */
  builderOfDateTime: abstract function(datetimes: datetime ...): !B<datetime>

  /**
   * @return collection of generic obj and provided instances.
   */
  builderOfObj: abstract function(objs: Obj ...): !B<Obj>

  /**
   * @return collection of provided C3 type and provided instances.
   */
  builderOfObj: abstract function<O: Obj>(type: !Type, objs: Obj ...): !B<O>
}
