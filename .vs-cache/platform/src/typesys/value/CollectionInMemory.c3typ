/**
 * Base type and common methods for collections that reside in memory.
 */
abstract type CollectionInMemory<E> mixes WithSize, InMemory, Value {

  /**
   * @return collection with elements reversed. The first element becomes the last, and the last element becomes the
   *         first.
   */
  reversed: abstract member function(): mixing CollectionInMemory<E>

  /**
   * @return new collection with new element added to it if it is not already present.
   */
  withIfMissing: abstract member function(e: !?E): !mixing CollectionInMemory<E>

  /**
   * @return new collection with new element added to it if it is not already present based on provided predicate.
   */
  withIfMissing: abstract member function(e: !?E, predicate: !lambda(e: E): boolean): !mixing CollectionInMemory<E>

  // TODO: PLAT-22837 - :V8: - `mixing` in method overload causes `Unsupported operation build for InheritedValueType`
  // toInMemory: abstract ~: mixing CollectionInMemory<E>
  toInMemory: abstract member function(): mixing CollectionInMemory<E>
}
