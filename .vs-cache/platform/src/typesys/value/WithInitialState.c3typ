/**
 * Base type signifying that an initial state can be precomputed. {@link #loadInitialState} specifies how the initial
 * state should be computed, and will be called from e.g. {@link WithInitialState.Engine} to keep the
 * precomputed state in memory of a persisted interpreter.
 */
abstract type WithInitialState mixes Fingerprinted {

  /**
   * Precomputes an initial state.
   */
  loadInitialState: private abstract member function()

  /**
   * Clears the state that was loaded in {@link loadInitialState}.
   */
  clearState: private abstract optional member function()

  /**
   * Helper to remove identity if obj is {@link Persistable}.
   */
  withoutIdentity: member function(): !mixing WithInitialState

  /**
   * Fetches the object if it exists in database and returns the fingerprint. Note that this method does not use the
   * {@link Persistable#id}, {@link Persistable#version}, or {@link Persistable#meta} fields when calculating the
   * fingerprint.
   */
  fingerprint: ~

  /**
   * Returns {@link HardwareConstraint} that {@link Hardware hardware} must satisfy to {@link loadInitialState load}
   * this object.
   *
   * Property will return empty `null` if constrains are unknown.
   *
   * This property expected to be reimplemented by concrete types.
   */
  @beta
  deploymentHardwareConstraint: cached property(): HardwareConstraint
}
