type BytePushStream mixes BlockPushStream<byte, binary>, Value {

  /**
   * Creates a new instance based on the native output/write stream:
   *  - Java: `java.io.OutputStream`
   *  - JavaScript: `WritableStream`
   */
  fromNative: function(out: @java(class='java.io.OutputStream') !native): !BytePushStream java | js

  /**
   * Creates new byte push stream that will compress data on write.
   */
  compress: abstract member function(contentEncoding: !?string): !BytePushStream

  /**
   * @return character push stream on top of this byte stream.
   */
  toCharPushStream: abstract member function(contentType: string, contentEncoding: string): !CharPushStream

  /**
   * @return java.io.OutputStream if this push stream is backed by it.
   */
  asOutputStream: member function(failIfNot: boolean): @java(class='java.io.OutputStream') native

  write:       abstract inline ~
  writeStream: abstract inline ~
  writeBatch:  abstract inline ~
  writeBlock:  abstract inline ~
  doClose:     abstract inline ~
  createBlock: ~ java | js
}
