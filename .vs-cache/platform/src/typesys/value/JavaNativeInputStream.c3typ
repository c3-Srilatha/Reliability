/**
 * Native byte stream based on a Java input stream.
 */
type JavaNativeInputStream mixes ByteStream, Value {

  inputStream: @java(class='java.io.InputStream') native

  make: function(inputStream: @java(class='java.io.InputStream') !native,
                 onClose: lambda(r: mixing Closable)): !JavaNativeInputStream
}
