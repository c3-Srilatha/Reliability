/**
 * Native character stream based on a Java Reader.
 */
type JavaNativeReader mixes CharStream, Value {

  reader: @java(class='java.io.Reader') native

  make: function(reader: @java(class='java.io.Reader') !native,
                 onClose: lambda(r: mixing Closable)): !JavaNativeReader
}
