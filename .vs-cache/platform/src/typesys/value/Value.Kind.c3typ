/**
 * Kind of value
 */
enum type Value.Kind {

  /**
   * if the value has been validated
   */
  VALIDATED

  /**
   * if the value is assignable
   */
  ASSIGNABLE

  /**
   * if the value is convertable
   */
  CONVERTABLE
}
