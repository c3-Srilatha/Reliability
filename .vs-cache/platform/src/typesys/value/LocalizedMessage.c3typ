/**
 * A parametrized message that may have been localized. These are typically used in error and warnings or similar
 * formatted strings produced in code.
 */
abstract type LocalizedMessage {

  /**
   * Formatted and localized message.
   */
  message: string

  /**
   * Unlocalized, parameterized error message string.
   */
  template: string

  /**
   * Parameters applied to {@link template} to produce error message.
   */
  parameters: [string]

  /**
   * Format and potentially localize #template with #parameters.
   */
  formatMessage: inline member function(): !string

  /**
   * Fills in the {@link #message} field if unset by using the template and parameters.
   */
  withFormattedMessage: inline member function(): !mixing LocalizedMessage
}
