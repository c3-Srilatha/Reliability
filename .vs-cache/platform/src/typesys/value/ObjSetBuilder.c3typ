/**
 * Builder of set of Objs.
 */
type ObjSetBuilder<O, OB: ObjBuilder<O>> mixes SetBuilder<O>, Value {

  /**
   * Adds new element Obj builder that can be used up until building of this set is done.
   */
  e: member function(): !OB java | js | py

  build: ~ java | js | py
}
