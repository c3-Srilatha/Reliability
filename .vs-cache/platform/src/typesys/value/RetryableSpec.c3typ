/**
 * Common type for spec parameter to action that has a retry behavior.
 */
type RetryableSpec mixes Spec {

  /**
   * Specifies various parameters for automatic retry that occurs in upsert due to retryable errors.
   */
  retrySpec: RetrySpec

  /**
   * @return new instance of this spec with `retrySpec` set
   */
  withRetry: member function(maxRetries: int, initialSleepMillis: int, exponent: double): mixing RetryableSpec

  /**
   * @return instance of this spec with `retrySpec`'s `maxTotalMillis` set
   */
  timeoutSeconds: function(secs: !?double): !mixing RetryableSpec
}
