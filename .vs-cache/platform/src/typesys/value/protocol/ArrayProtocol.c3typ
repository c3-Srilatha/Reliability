/**
 * Marker type indicating support for implementation language native array semantics e.g. indexed access via []
 */
// TODO: PLAT-26180 Remove this in favor of using CollectionProtocol to implement `[ ]`
abstract type ArrayProtocol mixes ImplLanguageProtocol, WithType, Value {

  /**
   * @return element at index
   */
  _at: private abstract inline member function(index: int): !native

  /**
   * @return count of elements
   */
  _size: private abstract inline member function(index: int): !int32
}
