/**
 * Note that this is missing divideModulo, leftShift, rightShift, as well as reflected versions.
 */
abstract type ArithmeticProtocol mixes Value {

  addition:                private abstract member function(other: !any): !any
  subtract:                private abstract member function(other: !any): !any
  multiply:                private abstract member function(other: !any): !any
  matrixMultiply:          private abstract member function(other: !any): !any
  trueDivision:            private abstract member function(other: !any): !any
  floorDivision:           private abstract member function(other: !any): !any
  modulo:                  private abstract member function(other: !any): !any
  power:                   private abstract member function(other: !any, modulus: any): !any
  reflectedAddition:       private abstract member function(other: !any): !any
  reflectedSubtract:       private abstract member function(other: !any): !any
  reflectedMultiply:       private abstract member function(other: !any): !any
  reflectedMatrixMultiply: private abstract member function(other: !any): !any
  reflectedTrueDivision:   private abstract member function(other: !any): !any
  reflectedFloorDivision:  private abstract member function(other: !any): !any
  reflectedModulo:         private abstract member function(other: !any): !any
  reflectedPower:          private abstract member function(other: !any, modulus: any): !any
}
