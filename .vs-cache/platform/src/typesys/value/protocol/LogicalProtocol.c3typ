abstract type LogicalProtocol mixes Value {

  logicalAnd:          private abstract member function(other: !any): !any
  logicalOr:           private abstract member function(other: !any): !any
  logicalXor:          private abstract member function(other: !any): !any
  reflectedLogicalAnd: private abstract member function(other: !any): !any
  reflectedLogicalOr:  private abstract member function(other: !any): !any
  reflectedLogicalXor: private abstract member function(other: !any): !any
}
