native py remix type ArrayLikePyProtocol {

  /**
   * @param dtype is an optional element data type.  This is taken by numpy's __array__() (and used by some
   * machine learning libraries when converting internally to a numpy array).
   */
  _array_: private abstract member function(dtype: native): native
}
