/**
 * Builder of map of Objs.
 */
type ObjMapBuilder<K, O, OB: ObjBuilder<O>> mixes MapBuilder<K, O>, Value {

  /**
   * Puts new element Obj builder at provided key; note that new child obj builder can be used up until building of
   * this map is done.
   */
  k: member function(k: !?K): !OB java | js | py

  build: ~ java | js | py
}
