/**
 * Result of an object validation.
 */
type ValidateObjResult mixes Result {

  /**
   * All errors discovered during validation. If this is empty, the object is valid.
   */
  errors: map<string serialized FieldPath, Error>

  /**
   * Whether or not the object is valid (no issues were discovered).
   */
  isValid: member function(): boolean

  /**
   * Throws formatted error if invalid
   */
  failIfInvalid: member function()

  /**
   * Build an Error object from the validation issues. If there are multiple issues, a BatchError is produced.
   */
  toError: member function(): Error

  /**
   * Throws error if invalid
   */
  throwError: member function()
}
