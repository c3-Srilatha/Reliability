/**
 * This is a base type that every type of Distributed Map will mix, such as Redis, EhCache, and so on. It provides functions
 * and fields common to every type of Distributed Map.
 */
type DistributedMap<K, V> {

  /**
   * Get a value from the map.
   *
   * @param key
   *            the name of the key
   */
  get: abstract member function(key: !K): V

  /**
   * Put a value in the map for the given key
   *
   * @param key
   *            the name of the key
   * @param value
   *            the value associated with the key
   */
  put: abstract member function(key: !K, value: !V)

  /**
   * Remove the value for a given key from the map.
   *
   * @param key
   *            the name of the key
   */
  remove: abstract member function(key: !K)

  /**
   * Get the number of key-value pairs in the map.
   */
  size: abstract member function(): !int

  /**
   * Iterate through the map to find a set of keys matching the filter pattern.
   *
   * @param filter
   *            filter expression to apply to qualify matching objs.
   * @param offset
   *            the index to start with when iterating entries in the map.
   * @param limit
   *            the number of elements returned at every SCAN call
   */
  scan: abstract member function(filter: string, offset: !int, limit: int = 10): !stream<K>
}
