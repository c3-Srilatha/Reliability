  remakeAs: final inline member function<O: Obj>(type: !Type): !O

  /**
   * Optional override that will be called every time instance of this type is created.
   *
   *
   * Note that it introduces additional overhead so should only be implemented for low volume data.
   */
  beforeMake: private optional inline function(fields: !?map<FieldType, any>): map<FieldType, any>

  /**
   * Optional override that will be called after every instance creation.
   *
   * Note that it introduces additional overhead so should only be implemented for low volume data.
   */
  afterMake: private optional inline member function(): !mixing Obj

  /**
