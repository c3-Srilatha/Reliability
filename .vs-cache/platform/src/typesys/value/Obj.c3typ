  myMapTypeOf:     final inline function(keyType: !ValueType): !MapType
  myMapType:       final inline function(): !MapType
  myArrayType:     final inline function(): !ArrayType
  mySetType:       final inline function(): !SetType
  myStreamType:    final inline function(): !StreamType

