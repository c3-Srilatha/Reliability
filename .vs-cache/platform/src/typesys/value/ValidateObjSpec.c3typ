/**
 * How to validate the object. If all fields are false, validations are chosen based on the mixin types.
 *
 * Several distinct types of validation are supported:
 *  - required fields (conditional on mixins)
 *  - values match enumeration (always validated)
 *
 * @see Obj.validateObj
 * @see ValidateObjResult
 */
type ValidateObjSpec mixes Spec {

  /**
   * Apply rules for persistable objects:
   *  - required fields of this and embedded objects must be specified
   */
  asPersistable: boolean

  /**
   * Apply rules for spec objects:
   *  - required fields must be specified of this Obj and any members which mixes Spec
   */
  // TODO: why is this flag needed?
  // asSpec: boolean

  /**
   * Apply rules for result objects:
   *  - required fields must be specified of this Obj and any members which mixes Result
   */
  // TODO: why is this flag needed?
  // asResult: boolean

  /**
   * Only validate constraint deps from annotations.  If true, the `as...` flags will be ignored.
   */
  // TODO: evaluate need and better document this flag e.g. refer to exact annotation
  // This is definitely being used but it needs to be clearly documented what it does.
  depsOnly: boolean

  /**
   * Throw an error that contains all the validation failures if any occur.
   */
  failIfInvalid: boolean

  /**
   * Recurse into object and validate all fields.
   */
  deep: boolean

  /**
   * If this is true, a reference of WithGlobalKey will be validated deep for all fields, not just key field.
   * Applicable only, when `deep` is true.
   * e.g Persistable/Named/Identified etc will be validated for more than 'id'/'name' fields.
   */
  validateRefsWithGlobalKey: boolean

  /**
   * Returns ValidateObjSpec with failIfInvalid field set
   */
  withFailIfInvalid: cached function(): !ValidateObjSpec
}
