/**
 * The options for merging arrays, sets and maps (collections) when calling Value#mergeValues.
 */
enum type CollectionMerge {

  /**
   * Indicates the object is replaced wholesale (other object wins).
   */
  REPLACE = 'REPLACE'

  /**
   * Indicates the elements in the other array or set are added after the original values. Note that in case of array
   * of types mixing one of {@link WithUniqueId} or {@link WithUniqueName} will replace existing elements with same
   * `id` or `name` from elements of other collection.
   */
  CONCAT = 'CONCAT'

  /**
   * Indicates fields or map elements are merged individually.
   */
  MERGE = 'MERGE'
}
