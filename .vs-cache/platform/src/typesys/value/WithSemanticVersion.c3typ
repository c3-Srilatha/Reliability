/**
 * Base type for objects with a {@link SemanticVersion}.
 */
abstract type WithSemanticVersion {

  /**
   * The {@link SemanticVersion} of this instance.
   */
  semanticVersion: string serialized SemanticVersion

  /**
   * A string sortable version of {@link #semanticVersion}.
   * See {@link SemanticVersion#toSortableString}.
   */
  sortableSemanticVersion: string

  /**
   * A lambda for sorting WithSemanticVersion objects with latest version first
   */
  comparator: cached function(): !lambda(v1: !mixing WithSemanticVersion, v2: !mixing WithSemanticVersion): !int32 java
}
