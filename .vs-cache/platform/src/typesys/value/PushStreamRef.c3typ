/**
 * Reference to a push-stream sent over Server-Sent Events (SSE)
 */
type PushStreamRef<E> mixes Identified {

  /**
   * Unique ID of the push-stream that Server uses for Server-Sent Events (SSE)
   */
  id: !~

  /**
   * Closes this push-stream
   */
  close: member function()
}
