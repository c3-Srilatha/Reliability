/**
 * The `Taggable` type defines the `tags` field and is used as a mixin for any type that requires associated of the
 * object with a map of tags.
 */
type Taggable mixes WithTags {

  /**
   * Adds a tag to this object
   * @param key
   *         key of the tag to add
   * @param value
   *         value of the tag to add
   * @return object with the tag added
   */
  addTag: member function(key: string, value: any): mixing Taggable

  /**
   * Removes a tag from this object
   * @param key
   *         key of the tag to remove
   * @return object with the tag removed
   */
  removeTag: member function(key: string): mixing Taggable
}
