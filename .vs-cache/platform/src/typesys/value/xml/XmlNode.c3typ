/**
 * DOM representation of XML. Used for querying values in XML. For converting XML to C3 Types, see {@link XML}.
 */
// TODO: This should mix Value not Obj PLAT-22585
type XmlNode {

  /**
   * Set at creation time by `fromXmlString`
   */
  element: private native

  /**
   * Serialize the given object to xml.
   */
  toXmlString: ~

  /**
   * Deserialize the given xml to an object
   * @param xml
   *           The xml string representation.
   * @return the root node of the XML.
   */
  /*
   * TODO Fix this: when uncommented this conflicts with Obj
   * fromXmlString: function(xml: !string): XmlNode
   */

  /**
   * Get elements by tag name
   *
   * @param elementName
   *           the name of the tag to match
   * @return all the matched elements
   */
  elementsByTagName: member function(elementName: !string): [XmlNode]

  /**
   * Get value of first matching element by tag name
   *
   * @param elementName
   *           the name of the tag to match
   * @return the text value first matching element, or undefined if not matched
   */
  valueByTagName: member function(elementName: !string): string

  /**
   * Get value of attribute of first matching element by tag name
   *
   * @param elementName
   *           the name of the tag to match
   * @param attribName
   *           the name of the tag to match
   * @return the text value first matching element, or undefined if not matched
   */
  attributeByTagName: member function(elementName: !string, attribName: !string): string

  /**
   * Get elements by XPath
   *
   * @param xPathStr
   *           the name of the tag to match
   * @return all the matched elements
   */
  elementsByXPath: member function(xPathStr: !string): [XmlNode]

  /**
   * Get value of first matching element by XPath
   *
   * @param xPathStr
   *           the name of the tag to match
   * @return the text value first matching element, or undefined if not matched
   */
  valueByXPath: member function(xPathStr: !string): string

  /**
   * Get value of attribute of first matching element by tag name
   *
   * @param xPathStr
   *           the name of the tag to match
   * @param attribName
   *           the name of the tag to match
   * @return the text value first matching element, or undefined if not matched
   */
  attributeByXPath: member function(xPathStr: !string, attribName: !string): string

  /**
   * Get value of the current top-level tag in the DOM
   *
   * @return the text value root tag, or null if there is no text value
   */
  value: member function(): string

  /**
   * Get value of attribute of first matching element by tag name
   *
   * @param attribName
   *           the name of the tag to match
   * @return the text value first matching element, or null if not matched
   */
  attribute: member function(attribName: !string): string
}
