/**
 * Base type for types that have a conceptual "parent". Note that the #parent field is likely to cause cycles and
 * code which traverses the hierarchy recursively should be very careful not to recurse infinitely.
 * See {@link ValueSpec} for ways to tune the behavior of the Obj field traversal methods.
 */
abstract type WithParent<P> {

  /**
   * The parent reference. Note that if the parent also refers to its children, one or both references should be
   * suppressed in serialization to avoid cycles in the JSON.
   */
  @db(include='id')
  parent: P

  /**
   * Finds the closest instance of Type in the `WithParent` hierarchy. Once a #parent is not a {@link WithParent},
   * the traversal for searching stops.
   *
   * @param type The Type reference to search for
   * @param validator If an instance of Type is found, validator serves as a callback to validate the found instance.
   *           If returns false, traversal continues. Default validator always returns true.
   * @return the found instance, if any
   */
  findAncestor: member function(type: !Type, validator: lambda(found: Value): boolean): Value java | js

  /**
   * Finds the closest instance that matches the validator in the `WithParent` hierarchy. Once a #parent is not a
   * {@link WithParent}, the traversal for searching stops.
   *
   * @param validator validator serves as a callback to validate the found instance.
   *           If returns false, traversal continues.
   * @return the found instance, if any
   */
  findAncestor: member function(validator: !lambda(found: Value): boolean): Value java | js
}
