type Dimension mixes DimensionBase<?double> {

  convert: ~

  /**
   * return as BigDecimal
   */
  asBigDecimal: inline member function(): !decimal

  /**
   * Dimension with value 1
   */
  trueDim: inline function(): Dimension

  /**
   * Dimension with value 0
   */
  falseDim: inline function(): Dimension

  /**
   * convert to boolean dimension
   */
  not: inline member function(): Dimension

  /**
   * Is the given Dimension 0 valued or not
   */
  isZero: inline member function(): boolean

  /**
   * Get conversion factor for the given unit
   */
  conversionFactor: inline member function(desiredUnit: !Unit): double

  /**
   * Multiply two dimensions
   *
   * @param other
   *        the dimension to multiply with this one. In keeping with the commutative property of multiplication, the
   *        unit of the result is deterministic, but as with all arithmetic operations, may very easily not be
   *        useful to the caller. An explicit {@link #convert} call should be used to ensure the result is in the
   *        desired units.
   * @return a new dimension which is this * other.
   */
  multiply: inline member function(dim: !Dimension): !Dimension

  /**
   * Divide two dimensions
   *
   * @param other
   *        the divisor dimension to divide from this one (the dividend). Division is not commutative, so the unit
   *        of the result is nondeterministic, and as with all arithmetic operations, may very easily not be useful
   *        to the caller. An explicit {@link #convert} call should be used to ensure the result is in the desired
   *        units. desired units.
   * @return a new dimension which is this / other
   */
  divide: inline member function(dim: !Dimension): !Dimension

  /**
   * Add two dimensions
   *
   * @param other
   *        the dimension to add to this one
   * @return a new dimension which is this + other. In keeping with the commutative property of addition, the unit of
   *         the result is deterministic, but as with all arithmetic operations, may very easily not be useful to the
   *         caller and may not be known ahead of time. An explicit {@link #convert} call should be used to ensure the
   *         result is in the desired units.
   */
  add: inline member function(dim: !Dimension): !Dimension

  /**
   * Subtract two dimensions
   *
   * @param other
   *        the dimension to subtract from this one. Subtraction is not commutative, so the unit of the result is
   *        nondeterministic, and as with all arithmetic operations, may very easily not be useful to the caller. An
   *        explicit {@link #convert} call should be used to ensure the result is in the desired units.
   * @return a new dimension which is this - other.
   */
  subtract: inline member function(dim: !Dimension): !Dimension

  /**
   * Negate this dimension
   *
   * @return a new dimension which is this with a value of opposite sign
   */
  negate: inline member function(): !Dimension

  /**
   * Modulus of two dimensions
   *
   * @param other
   *        the dimension to modulo this by. Modulo is not commutative, so the unit of the result is
   *        nondeterministic, and as with all arithmetic operations, may very easily not be useful to the caller. An
   *        explicit {@link #convert} call should be used to ensure the result is in the desired units.
   * @return a new dimension which is this % other
   */
  remainder: inline member function(dim: !Dimension): !Dimension

  /**
   * Rounds this dimension to its integer value according to the provided rounding mode.
   *
   * @param mode
   *        the rounding mode of the operation
   * @return a new Dimension which is this Dimension with rounded value with the same units as this Dimension.
   */
  round: inline member function(scale: !int32, mode: string): !Dimension

  /**
   * Compares two dimensions. The "correct" way to do this is to do significant figures calculation on all conversions,
   * carrying the accuracy of the unit in the BigDecimal in the unit's "value" field. Since this is a lot of work, for
   * now, we just use a predefined epsilon within which two dimensions are considered equal.
   *
   * @param other
   *        the unit to compare this to
   * @return this unit is (-1 for less than, 0 for equal, 1 for greater than) other
   * @see <a href="http://en.wikipedia.org/wiki/Significant_figures">Wikipedia's discussion on significant figures</a>
   */
  compare: inline member function(dim: !Dimension): !int32

  /**
   * Creates a new dimension which is this dimension cast/treated into the desired units.
   *
   * @param desiredUnits
   *        The units to which this dimension will be cast to
   * @return a new dimension with units in desiredUnits
   */
  treatAs: inline member function(unit: !Unit): !Dimension

  /**
   * Absolute this dimension
   *
   * @return a new dimension which has the same value but positive sign
   */
  abs: inline member function(): !Dimension

  /**
   * Compares two dimensions for equality. Two dimensions that have the same unit and value (within an epsilon - see
   * {@link #compareTo(Dimension)}) are equal. Two units that are convertible are not considered equal unless they are
   * in the exact same unit.
   *
   * @return true if this is equal to other
   */
  equivalentTo: inline member function(other: !Dimension): boolean
}
