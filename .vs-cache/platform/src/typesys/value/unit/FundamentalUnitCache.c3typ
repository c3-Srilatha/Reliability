/**
 * The fundamental unit cache saves us from having to traverse the graph on
 * cache hits. Make this a rather deep cache, because this operation is
 * ridiculously expensive on misses, and the data cached is not that big.
 */
type FundamentalUnitCache mixes Cached {

  fundamentalUnit: Unit
}
