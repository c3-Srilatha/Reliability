/**
 * A library of units offered for use with calculations
 */
// TODO: PLAT-85299 remove remixable
// TODO PLAT-104838: decide if Unit mixes Metadata or keep it as SeedData with additional write restrictions.
@cache(include='this, {components:[unit,order,multiplier]}', all=true)
@seed(userUpdatable = true, userRemovable = true)
@typesys(remixable=true)
entity type Unit mixes SeedData schema name 'UNITS_UNIT' {

  // mixes Metadata

  /**
   * symbol of the given unit
   */
  symbol: string

  /**
   * Components comprised in the unit
   */
  components: [UnitComponent] schema name 'CMP'

  /**
   * Custom converters from current Unit to other Unit(s).
   * These converters include custom unit transformation logic in the form of expressions.
   */
  customConverters: [CustomUnitConvertor] schema name 'CCNV'

  /**
   * Translated name.
   */
  translatedName: string translate by name

  /**
   * Translated symbol.
   */
  translatedSymbol: string translate by symbol

  /**
   * A concept identifies the physics quantity being measured,
   * such as volume, mass, etc.
   */
  concept: string

  /**
   * This method will check whether unit will introduce any new cycle.
   * If yes, true returned
   */
  hasCycles: inline function(unit: !Unit): boolean

  /**
   * validate the graph
   */
  validateGraph: inline function(): string

  /**
   * Get units that the given unit can be converted to
   */
  getConvertableUnits: function(unit: !Unit): [Unit]

  /**
   * Is the unit convertible to the other unit
   */
  isConvertable: inline function(unit: !Unit, desiredUnit: !Unit): boolean

  /**
   * Is the unit convertible to the other unit
   */
  isConvertible: inline member function(other: !Unit): boolean

  /**
   * Conversion factor in between the two units
   */
  conversionFactor: inline member function(other: !Unit): double

  /**
   * Conversion factor in between the two units
   */
  getConversionFactor: inline function(unit: !Unit, desiredUnit: !Unit): double

  /*
   * Retrieve custom conversion logic (lambda function) from current unit (source unit) to the desired unit
   * (destination unit), if such logic exists.
   *
   * @param desiredUnit
   *    destination unit
   * @return compiled function for the conversion
   */
  customConverter: inline member function(destinationUnit: !Unit): lambda(srcValue: double): double

  /*
   * Check if current unit (source unit) has custom conversion logic (CustomUnitConvertor) to the desired unit.
   *
   * @param desiredUnit
   *    destination unit
   * @return true or false depending on whether such logic exists
   */
  hasCustomConverter: cached member function(destinationUnit: !Unit): boolean

  /**
   * Get the relationship between this unit and the desired unit.
   *
   * @param desiredUnit
   * @return
   * @throws UnitsException
   */
  relationship: inline member function(desired: !Unit): Unit

  /**
   * Is the given unit equivalent to the other unit
   */
  equivalentTo: inline member function(other: !Unit): boolean

  /**
   * Determines at runtime whether this node is unitless by checking whether its fundamental equivalency form (with
   * edges pointing only to leaf nodes) has at least one outgoing edge with non-zero order.
   */
  isUnitless: inline member function(): boolean

  /**
   * Invert the current unit
   */
  invert: inline member function(): Unit

  /**
   * Combine with other unit
   */
  combine: inline member function(other: !Unit): Unit

  /**
   * apply the given power to the unit
   */
  pow: inline member function(power: !int32): Unit

  /**
   * An "intelligent" printer of this unit's name. This is more expensive than "{@link #toString}", which is fairly
   * dumb, but fast.
   *
   * @return A string that is formatted to fit <a href="http://microformats.org/wiki/measure">the measure
   *         microformat</a>
   * @throws MalformedUnitException
   *         if the unit cannot be expressed as a string
   */
  prettyPrint: inline member function(): string

  /**
   * To its fundamental form: mmbtu-per-unit => mmbtu-per-unit^-1
   */
  toFundamentalUnit: inline member function(): Unit

  /**
   * Determines at runtime whether this is a sink node by checking whether the node has outgoing edges or not.
   */
  isTerminalNode: inline member function(): boolean

  /**
   * Determines at runtime whether this is a forced sink node by checking whether it uses custom conversion logic.
   * If true, we will force this node to be a sink node. Hence, we will not recurse into any outgoing edges.
   * Currently, only 1-step custom transformations are supported via the use of a conversion function, i.e.,
   * CustomUnitConvertor#conversionExpr. As there is no systematic mathematical way to invert an arbitrary function,
   * in these cases, we will need to know the forward and the backward conversion formula. One example would be
   * temperature conversions (which are affine) such as:
   *    Celsius to Fahrenheit: F = 1.8 * C + 32
   *    Fahrenheit to Celsius: C = (F - 32) / 1.8
   * Hence, all units that require custom conversion logic should be terminal to avoid cycles in the graph.
   */
  isForcedTerminalNode: private inline member function(): boolean

  /**
   * Is unit a combination of its components containing * or ^
   */
  isDynamic: inline member function(): boolean

  /**
   * Creates and id or synthetic id for the given unit
   */
  safeId: inline member function(): string

  /**
   * Creates safe name for unit if it doesn't exist based on safeId
   */
  safeName: inline member function(): string

  /**
   * Creates safe symbol for unit if it doesn't exist based on safeId
   */
  safeSymbol: inline member function(): string

  /**
   * Returns null unit
   */
  nullUnit: inline function(): !Unit

  // TODO: PLAT-22973
  // dependencies: ~: UnitDeps
  produce: ~

  beforeCreate: ~
  beforeUpdate: ~
}
