native py remix type Iterable {

  /**
   * This method should return a <a href="https://wiki.python.org/moin/Iterator">Python iterator</a>. The default implementation of
   * this method calls {@Link Iterable#iter} on a C3 {@Link Iterable} to get a C3 {@Link Iterator}  and then uses
   * {@Link Iterator#next} and {@Link Iterator#hasNext} on the C3 {@Link Iterator} to implement a Python iterator.
   */
  _iter_: ~ py
}
