/**
 * Obj that has a single field that is a mapp of objs.  Used for boxing mapps
 */
@deprecated(finalVersion='8.0.0')
type ObjMapp mixes Boxed<map<string, Obj>> {

  /**
   * Creates an ObjMapp from a Mapp, boxing elements as needed.
   */
  fromMapp: function(mapp: !?map<string, any>): ObjMapp

  /**
   * Returns the Mapp in {@link value} with unboxed elements.
   */
  toMapp: member function(): map<string, any>
}
