/**
 * Errors returned for a single obj in the {@link ObjList.errors} array for various operations on {@link Persistable}.
 */
type ObjSourceError mixes ObjError {

  /**
   * Target id of obj that the error(s) was/were encountered for.
   */
  @constraint(required=false)
  targetId: ~

  /**
   * fieldErrors are not to be persisted in PG
   */
  fieldErrors: ~ not persistable
}
