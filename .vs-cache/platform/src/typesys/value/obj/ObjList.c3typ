/**
 * List of objs, errors and stats from a number of functions that update data in any data datastore  (e.g.
 * {@link Persistable#upsert}).
 */
type ObjList<T> mixes ObjStats {

  /**
   * List of returned objs.
   */
  objs: [T]

  /**
   * @return the number of objs.
   */
  count: member function(): !int

  /**
   * @return the first obj in objs, if any, and null otherwise.
   */
  first: member function(): T

  /**
   * @return combined ObjList.
   */
  concat: member function(other: !ObjList<T>): !ObjList<T>
}
