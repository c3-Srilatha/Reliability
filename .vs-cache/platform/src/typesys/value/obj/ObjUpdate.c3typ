/**
 * This object is a tuple of old and new values of the same type, used to represent a change.
 * Either parts of object itself, or some of its substructure has changed, but the object
 * is still identified by the same unique key.
 */
type ObjUpdate<T> {

  /**
   * The new instance (after the change).
   */
  new: T

  /**
   * The old instance (before the change).
   */
  old: T
}
