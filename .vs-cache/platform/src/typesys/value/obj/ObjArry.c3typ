/**
 * Obj that has a single field that is an arry of objs.  Useful when an Obj is required but the value is really an Arry of objs.
 */
@deprecated(finalVersion='8.0.0')
type ObjArry mixes Boxed<[Obj]> {

  /**
   * Creates an ObjArry from an Arry, boxing elements as needed.
   */
  fromArry: function(arry: !?[any]): ObjArry

  /**
   * Returns the Arry in {@link value} with unboxed elements.
   */
  toArry: member function(): [any]
}
