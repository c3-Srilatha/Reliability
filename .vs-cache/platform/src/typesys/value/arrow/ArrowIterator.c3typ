// TODO: PLAT-96586: Consolidate Arrow Stream into ArrowIterator
@beta
private type ArrowIterator mixes Value, Iterator<Arrow> {

  /**
   * Construct a new ArrowIterator by reading Arrow column batches from given channel.
   */
  read: function(type: !Type, stream: !?ByteStream): !ArrowIterator java

  /**
   * Construct a new ArrowIterator by reading Arrow column batches from connection. This method is called is used in py-client
   * run-times to de-serialize data in Arrow format.
   */
  makeValue: function(connection: native, response: native): ArrowIterator py

  /**
   * Construct a new ArrowIterator by turning rows given by C3 objects into columnar batches with size given by batchSize.
   */
  fromObjs: function(rows: !?stream<Obj>,
                     include: string serialized Include,
                     batchSize: !int32,
                     flatten: boolean): !ArrowIterator java

  /**
   * Construct a new ArrowIterator from given sequence of Arrow batches.
   */
  fromElements: function(batches: !Array<Arrow>, schema: !TupleType): !ArrowIterator java

  /**
   * Construct empty ArrowIterator with given schema.
   */
  empty: function(schema: !TupleType): !ArrowIterator java

  /**
   * Serialize content of this iterator into given output stream using Arrow File IPC format.
   */
  write: abstract member function(stream: !?push stream<byte>): int

  /**
   * Convert content of this arrow iterator back to rows represented as C3 objects.
   */
  toRows: abstract member function<O: any>(): !Iterator<O>

  /**
   * Return TupleType representation of schema for this iterator in C3 ValueType format. See {@link Arrow #type}
   */
  schema: abstract property(): !TupleType

  /**
   * Return native Arrow schema for this iterator.
   */
  arrowSchema: abstract property(): @java(class='org.apache.arrow.vector.types.pojo.Schema') native

  /**
   * Return native Arrow allocator used by this iterator.
   */
  allocator: abstract property(): @java(class='org.apache.arrow.memory.BufferAllocator') native

  /**
   * Return number of rows.
   */
  count: abstract member function(): int

  hasNext: ~ py
  next:    ~ py
  close:   ~ py
}
