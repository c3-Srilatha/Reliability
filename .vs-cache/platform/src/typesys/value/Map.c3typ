/**
 * A {@link Map} is an unordered set key/value pairs. It does not allow null or duplicate keys, but does allow
 * duplicate elements. All elements are kept in memory.
 *
 * Maps are unique among {@link Collection collections} in that they have two different inner value types:
 *  - "key type" defines the type of the keys
 *  - "element type" defines the type of the elements (values)
 *
 * By default, maps do not allow null keys nor values. The "allows empty" syntax can be used to change this behavior
 * for either or both inner value types: `map<?string, ?FixedAsset>`.
 *
 * So a map declared as `map<datetime, int>` uses datetime values as the keys and integer values as the
 * elements. Only primitive types may be used for the keys, but any type may be used for the values.
 */
type Map<K, E> mixes Collection<E>, CollectionInMemory<E>, Value {

  collectionType: ~: !MapType java | py

  /**
   * @return value type of keys in this map
   */
  keyType: member function(): !ValueType java | py | js

  /**
   * @return specific bound type of Pair
   */
  // TODO: <<Pair<K, E>>>
  entryType: member function(): !Type java | js

  /**
   * @return true if this map can have null keys
   */
  hasNullKeys: member function(): boolean

  /**
   * @return element under provided key or `null`
   */
  get: member function(key: !?K): E java | js | py-client

  /**
   * @return element under provided key or result of ifMissing lambda application if key is missing
   */
  get: member function(key: !?K, ifMissing: lambda(key: !K): E): E java | js | py-client

  /**
   * @return `true` if this map has element for given key even if such element value is `null`
   */
  containsKey: member function(key: !?K): boolean java | js

  /**
   * @return `true` if every element in this collection satisfies provided predicate.
   */
  containsAll: member function(predicate: !lambda(element: E, key: K): boolean): boolean java | js

  /**
   * @return `true` if every element in this collection satisfies provided predicate.
   */
  containsAll: member function(predicate: !lambda(element: E, key: K, index: int): boolean): boolean java | js

  /**
   * @return true if this collection contains any elements satisfying provided condition.
   */
  containsAny: member function(predicate: !lambda(element: E, key: K): boolean): boolean java | js

  /**
   * @return true if this collection contains any elements satisfying provided condition.
   */
  containsAny: member function(predicate: !lambda(element: E, key: K, index: int): boolean): boolean java | js

  /**
   * Return stream of all the elements in this map.
   */
  elements: member function(): stream<E>

  /**
   * @return elements in this collection that satisfy provided predicate.
   */
  elements: member function(predicate: !lambda(e: E): boolean): stream<E>

  /**
   * @return elements in this collection that satisfy provided predicate.
   */
  elements: member function(predicate: !lambda(e: E, k: K): boolean): stream<E>

  /**
   * @return elements in this collection that satisfy provided predicate.
   */
  elements: member function(predicate: !lambda(e: E, k: K, index: int): boolean): stream<E>

  /**
   * Return all the keys in this map.
   */
  keys: member function(): stream<K> java | js

  /**
   * @return keys for elements in this collection that satisfy provided predicate.
   */
  keys: member function(predicate: !lambda(e: E): boolean): stream<K> java | js

  /**
   * @return keys for elements in this collection that satisfy provided predicate.
   */
  keys: member function(predicate: !lambda(e: E, k: K): boolean): stream<K> java | js

  /**
   * @return keys for elements in this collection that satisfy provided predicate.
   */
  keys: member function(predicate: !lambda(e: E, k: K, index: int): boolean): stream<K> java | js

  /**
   * Return stream of all the entries in this map.
   */
  entries: member function(): stream<Pair<K, E>> java | js

  /**
   * @return entries in this collection that satisfy provided predicate.
   */
  entries: member function(predicate: !lambda(e: E): boolean): stream<Pair<K, E>> java | js

  /**
   * @return entries in this collection that satisfy provided predicate.
   */
  entries: member function(predicate: !lambda(e: E, k: K): boolean): stream<Pair<K, E>> java | js

  /**
   * @return entries in this collection that satisfy provided predicate.
   */
  entries: member function(predicate: !lambda(e: E, k: K, index: int): boolean): stream<Pair<K, E>> java | js

  /**
   * Finds some element in this map satisfying provided condition.
   */
  findAnyElement: abstract member function(predicate: !lambda(e: E): boolean): E

  /**
   * Finds some element in this map satisfying provided condition.
   */
  findAnyElement: abstract member function(predicate: !lambda(e: E, k: K): boolean): E

  /**
   * Finds some element in this map satisfying provided condition.
   */
  findAnyElement: abstract member function(predicate: !lambda(e: E, k: K, index: int): boolean): E

  /**
   * Finds some element in this collection satisfying provided condition.
   */
  findAnyEntry: abstract member function(predicate: !lambda(element: E): boolean): Pair<K, E>

  /**
   * Finds some element in this collection satisfying provided condition.
   */
  findAnyEntry: abstract member function(predicate: !lambda(element: E, key: K): boolean): Pair<K, E>

  /**
   * Finds some element in this collection satisfying provided condition.
   */
  findAnyEntry: abstract member function(predicate: !lambda(element: E, key: K, index: int): boolean): Pair<K, E>

  /**
   * @return key for element in this map that satisfies provided predicate.
   */
  findAnyKey: member function(predicate: !lambda(e: E): boolean): K java | js

  /**
   * @return key for element in this map that satisfies provided predicate.
   */
  findAnyKey: member function(predicate: !lambda(e: E, k: K): boolean): K java | js

  /**
   * @return key for element in this map that satisfies provided predicate.
   */
  findAnyKey: member function(predicate: !lambda(e: E, k: K, index: int): boolean): K java | js

  /**
   * @return new map with the provided key/value added/updated to it.
   */
  with: member function(k: !?K, e: !?E): map<K, E> java | js

  /**
   * @return new map with a all provided keys/values added/updated to it.
   */
  withAll: member function(elements: !?map<K, E>): map<K, E> java | js

  /**
   * @return new collection without elements/keys satisfying provided predicate.
   */
  withoutAny: member function(predicate: !lambda(e: E, k: K): boolean): map<K, E> java | js

  /**
   * @return new map with key removed.
   */
  withoutKey: member function(key: !?K): map<K, E> java | js

  /**
   * @return new map with all provided keys removed.
   */
  withoutKeys: member function(keys: !?Collection<K>): map<K, E> java | js

  /**
   * @return new map with only elements with the provided keys.
   */
  pickKeys: member function(keys: !?Collection<K>): map<K, E>

  /**
   * Execute the specified lambda against each value of the map. The first argument to lambda is the value and the
   * second is the key.
   */
  each: member function(action: !lambda(value: E, key: K)) java | js

  /**
   * Execute the specified lambda against each value of the map. The first argument to lambda is the value, the
   * second is the key and third is the counter of how many elements have been handled so far (zero-based index).
   */
  each: member function(action: !lambda(value: E, key: K, counter: int)) java | js

  /**
   * @return new map with same keys by evaluating provided expression over each element.
   */
  mapToSame: member function(mapper: !lambda(e: E, k: K): E): Map<K, E> java | js

  /**
   * @return new map with same keys by evaluating provided expression over each element.
   */
  map: member function<T>(expr: !string serialized Expr): Map<K, T> java | js

  /**
   * @return new map with values from matching keys merged with provided expression. Values that do not have matching
   * keys are added to the final map as provided.
   * @param merger
   *        if provided will be used as logic for merging shared keys, otherwise defaults to @see Val.merge
   */
  // TODO: can't guarantee that other has the same collection type
  merge: member function(other: !Map<K, E>, merger: lambda(v: E, k: K, otherV: E): E): Map<K, E>

  /**
   * @return new map with same keys by evaluating provided expression over each element.
   */
  map: member function<T>(mapper: !lambda(e: E, k: K): T): Map<K, T> java | js

  /**
   * @return new generic `map<any, any>` with mapped keys and elements.
   */
  mapEntries: member function<T, U>(mapper: !lambda(e: E, k: K): Pair<T, U>): Map<T, U> java | js

  /**
   * @return new strongly typed map of provided key and element types with mapped keys and elements.
   */
  mapEntries: member function<T, U>(keyType: !ValueType,
                                    elementType: !ValueType,
                                    mapper: !lambda(e: E, k: K): Pair<T, U>): Map<T, U> java | js

  /**
   * Filters elements from this map based on evaluation result of the provided filter predicate.
   */
  filter: member function(predicate: !lambda(e: E, k: K): boolean): mixing Map<K, E> java | js

  /**
   * Filters elements from this map based on evaluation result of the provided filter predicate.
   */
  filter: member function(predicate: !lambda(e: E, k: K, counter: int): boolean): mixing Map<K, E> java | js

  /**
   * @return single value that is a result of aggregation of all elements by provided lambda.
   */
  fold: member function<T>(folder: !lambda(e: E, k: K, accumulator: T): T): T java | js

  /**
   * @return single value that is a result of aggregation of all elements by provided lambda and initial value.
   */
  fold: member function<T>(initial: !?T, folder: !lambda(e: E, k: K, accumulator: T): T): T java | js

  /**
   * @return single value that is a result of aggregation of all elements by provided lambda and initial value.
   */
  fold: member function<T>(initial: !?T, folder: !lambda(e: E, k: K, counter: int, accumulator: T): T): T java | js

  /**
   * @return new map with keys as elements of this map and corresponding element as key of that element in this map.
   */
  invertEntries: member function(): map<E, K>

  /**
   * @return new map with keys sorted in a natural order.
   */
  sortKeys: member function(): map<K, E> java | js

  /**
   * @return new map with keys sorted based on provided comparator.
   */
  sortKeys: member function(comparator: !lambda(a: K, b: K): @comparator int32): map<K, E> java | js

  /**
   * @return new instance of MapBuilder with current map's content as initial content
   */
  toBuilder: member function(): MapBuilder<K, E> java | js | py

  /**
   * @return new map of provided type and key/element pairs
   */
  of: function<T1, T2>(mapType: !MapType, keyElements: any ...): map<T1, T2> java | js

  /**
   * @return new map of provided key and element types and key/element pairs
   */
  of: function<T1, T2>(keyType: !ValueType, elementType: !ValueType, keyElements: any ...): map<T1, T2> java | js

  /**
   * @return new map with provided key element pairs
   */
  ofAny: function<T1, T2>(keyElements: any ...): map<T1, T2> java | js

  /**
   * @return new map with string key and with provided key element pairs
   */
  ofStrToStr: function(keyElements: string ...): map<string, string> java | js | py-client

  /**
   * @return new map with string key and with provided key element pairs
   */
  ofStrToAny: function<T>(keyElements: any ...): map<string, T> java | js

  /**
   * @return new map with string key and provided key element pairs
   */
  ofStrTo: function<T>(elementType: !ValueType, keyElements: any ...): map<string, T> java | js

  /**
   * @return new map with an integer key and provided key element pairs
   */
  ofIntToStr: function(keyElements: any ...): map<int, string>

  /**
   * @return new map with an integer key and provided key element pairs
   */
  ofIntToAny: function<T>(keyElements: any ...): map<int, T>

  /**
   * @return new map with an integer key and provided element type and  key element pairs
   */
  ofIntTo: function<T>(elementType: !ValueType, keyElements: any ...): map<int, T>

  /**
   * @return new map with an integer key and provided key element pairs
   */
  ofInt32ToStr: function(keyElements: string ...): map<int32, string>

  /**
   * @return new map with an integer key and provided key element pairs
   */
  ofInt32ToAny: function<T>(keyElements: any ...): map<int32, T>

  /**
   * @return new map with an integer key and provided element type and  key element pairs
   */
  ofInt32To: function<T>(elementType: !ValueType, keyElements: any ...): map<int32, T>

  /**
   * @return new map builder of provided type and key/element pairs
   */
  builderOf: function<T1, T2>(mapType: !MapType, keyElements: any ...): !MapBuilder<T1, T2> java | js

  /**
   * @return new map builder of provided key and element types and key/element pairs
   */
  builderOf: function<T1, T2>(keyType: !ValueType,
                              elementType: !ValueType,
                              keyElements: any ...): !MapBuilder<T1, T2> java | js

  /**
   * @return new map builder with provided key element pairs
   */
  builderOfAny: function<T1, T2>(keyElements: any ...): !MapBuilder<T1, T2> java | js

  /**
   * @return new map builder with string key and with provided key element pairs
   */
  builderOfStrToStr: function(keyElements: string ...): !MapBuilder<string, string> java | js

  /**
   * @return new map builder with string key and  with provided key element pairs
   */
  builderOfStrToAny: function<T>(keyElements: any ...): !MapBuilder<string, T> java | js

  /**
   * @return new map builder with string key and  with provided key element pairs
   */
  builderOfStrToObj: function<O: Obj>(type: !Type, keyElements: any ...): !MapBuilder<string, O> java | js

  /**
   * @return new map builder with string key and provided key element pairs
   */
  builderOfStrTo: function<T>(elementType: !ValueType, keyElements: any ...): !MapBuilder<string, T> java | js

  /**
   * @return new map builder with an integer key and provided key element pairs
   */
  builderOfIntToStr: function(keyElements: any ...): !MapBuilder<int, string> java | js

  /**
   * @return new map builder with an integer key and provided key element pairs
   */
  builderOfIntToAny: function<T>(keyElements: any ...): !MapBuilder<int, T> java | js

  /**
   * @return new map builder with an integer key and provided element type and key element pairs
   */
  builderOfIntTo: function<T>(elementType: !ValueType, keyElements: any ...): !MapBuilder<int, T> java | js

  /**
   * @return new map builder with an integer key and integer element type and key element pairs
   */
  builderOfIntToInt: function<T>(keyElements: any ...): !MapBuilder<int, int> java | js

  /**
   * @return new map builder with an integer key and provided key element pairs
   */
  builderOfInt32ToStr: function(keyElements: any ...): !MapBuilder<int32, string> java | js

  /**
   * @return new map builder with an integer key and provided key element pairs
   */
  builderOfInt32ToAny: function<T>(keyElements: any ...): !MapBuilder<int32, T> java | js

  /**
   * @return new map builder with an integer key and provided element type and key element pairs
   */
  builderOfInt32To: function<T>(elementType: !ValueType, keyElements: any ...): !MapBuilder<int32, T> java | js

  /**
   * @return new map builder with an integer key and integer element type and key element pairs
   */
  builderOfInt32ToInt: function<T>(keyElements: any ...): !MapBuilder<int32, int> java | js

  /**
   * @return new instance of map of provided type by applying builder lambda.
   */
  build: function<T1, T2>(mapType: !MapType, builder: !lambda(b: !MapBuilder<T1, T2>)): map<T1, T2>

  /**
   * @return new instance of map of provided key and element type by applying builder lambda.
   */
  build: function<T1, T2>(keyType: !ValueType,
                          elementType: !ValueType,
                          builder: !lambda(b: !MapBuilder<T1, T2>)): map<T1, T2>

  /**
   * @return new instance of map of any by applying builder lambda.
   */
  buildAny: function<T1, T2>(builder: !lambda(b: !MapBuilder<T1, T2>)): map<T1, T2>

  /**
   * @return new instance of map of int to int by applying builder lambda.
   */
  buildIntToInt: function(builder: !lambda(b: !MapBuilder<int, int>)): map<int, int>

  /**
   * @return new instance of map of int to int by applying builder lambda.
   */
  buildInt32ToInt: function(builder: !lambda(b: !MapBuilder<int32, int>)): map<int32, int>

  /**
   * @return new instance of map of int to string by applying builder lambda.
   */
  buildIntToStr: function(builder: !lambda(b: !MapBuilder<int, string>)): map<int, string>

  /**
   * @return new instance of map of int to string by applying builder lambda.
   */
  buildInt32ToStr: function(builder: !lambda(b: !MapBuilder<int32, string>)): map<int32, string>

  /**
   * @return new instance of map of integers to provided element type by applying builder lambda.
   */
  buildIntTo: function<T>(elementType: !ValueType, builder: !lambda(b: !MapBuilder<int, any>)): map<int, any>

  /**
   * @return new instance of map of integers to provided element type by applying builder lambda.
   */
  buildInt32To: function<T>(elementType: !ValueType, builder: !lambda(b: !MapBuilder<int32, any>)): map<int32, any>

  /**
   * @return new instance of map of string by applying builder lambda.
   */
  buildStrToStr: function(builder: !lambda(b: !MapBuilder<string, string>)): map<string, string>

  /**
   * @return new instance of map of string to any by applying builder lambda.
   */
  buildStrToAny: function<T>(builder: !lambda(b: !MapBuilder<string, T>)): map<string, T>

  /**
   * @return new instance of map of provided C3 type by applying builder lambda.
   */
  buildStrToObj: function<O: Obj>(type: !Type, builder: !lambda(b: !MapBuilder<string, O>)): map<string, O>

  /**
   * @return new instance of map of string to provided element type by applying builder lambda.
   */
  buildStrTo: function<T>(elementType: !ValueType, builder: !lambda(b: !MapBuilder<string, T>)): map<string, T>

  hasSameElements: ~
  isEmpty:         ~ java | py
  fromJson:        ~ java | js | py-client
  mapToSame:       ~ java | js
  mapTo:           ~ java | js
  mapToStr:        ~ java | js
  replaceType:     ~
  toInMemory:      ~: map<K, E>
  toString:        ~ java | js
  zip:             ~
  size:            ~ java | py-client
  valueTypeOf:     ~ java | js | py
}
