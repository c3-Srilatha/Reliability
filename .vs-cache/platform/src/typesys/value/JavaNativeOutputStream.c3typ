/**
 * Native byte push stream based on a Java output stream.
 */
type JavaNativeOutputStream mixes BytePushStream, Value {

  outputStream: @java(class='java.io.OutputStream') native

  make: function(outputStream: @java(class='java.io.OutputStream') !native,
                 onClose: lambda(r: mixing Closable)): !JavaNativeOutputStream

  // TODO PLAT-18839 code gen should figure to call childs method in inline way
  write: inline ~

  writeBlock: inline ~
}
