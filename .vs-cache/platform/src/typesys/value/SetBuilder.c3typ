/**
 * Builder of sets.
 *
 * @see Set#buidlerOf
 * @see Set#toBuidler
 * @see SetType#makeBuidler
 */
type SetBuilder<E> mixes CollectionBuilder<E>, Value {

  addIfMissing:   ~ java | js | py
  build:          ~: set<E> java | js | py
  collectionType: ~: !SetType java | js | py
  current:        ~: set<E> java | js | py
  elementType:    ~ java | js | py
  fromJson:       ~ java | js | py
  merge:          ~ java | js | py
  replace:        ~ java | js | py
  make:           ~ java | js | py
  type:           ~ java | js | py
}
