/**
 * Base type for Fingerprintable instances with a cached default fingerprint
 *
 * @see Fingerprintable
 */
abstract type Fingerprinted mixes Obj, Fingerprintable {

  fingerprint:       ~
  cachedFingerprint: private cached member function(): @js(bigInt=true) !int
}
