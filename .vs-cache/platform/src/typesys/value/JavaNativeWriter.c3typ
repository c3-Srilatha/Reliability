/**
 * Native character push stream based on a Java Writer.
 */
type JavaNativeWriter mixes CharPushStream, Value {

  writer: @java(class='java.io.Writer') native

  make: function(writer: @java(class='java.io.Writer') !native,
                 onClose: lambda(r: mixing Closable)): !JavaNativeWriter

  // TODO PLAT-18839 code gen should figure to call childs method in inline way
  write: inline ~
}
