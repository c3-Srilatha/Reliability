/**
 * Abstract Geometric object (2D).
 */
// TODO: remove type with name Geometry from apps and rename this guy to Geometry!
type Geom {

  /**
   * Coordinate system for points stored in geometry column.
   *
   * Interesting SRIDS:
   *    0 (Unknown)
   *    4326 (e.g. WGS84 Lat/Long - Used by Google Earth)
   *    3857 (e.g. Spherical Mercator - Used by Google Maps)
   */
  srid: int32
}
