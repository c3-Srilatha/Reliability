/**
 * Point in space (2D).
 */
type GeomPoint mixes Geom {

  /**
   * The X coordinate of the point. In most long/lat systems, this is the longitude.
   */
  x: double

  /**
   * The Y coordinate of the point. In most long/lat systems, this is the latitude.
   */
  y: double
}
