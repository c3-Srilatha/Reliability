/**
 * Stateful Obj instances allow their fields to be changed by adding the #setField as well as a setter method for each
 * declared field. For example, the field "name" would have a `setName` method.
 *
 * Changes to this {@link Obj Obj instance} are tracked through #onChange method calls.
 */
@deprecated
abstract duck type StatefulObj mixes Mutable, Obj
