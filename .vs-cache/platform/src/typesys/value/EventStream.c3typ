/**
 * Stream of events. It is parameterized by the event type.
 */
type EventStream<E> mixes Closable, Serializable, Mutable, Value {

  /**
   * Unique id of this even stream.
   */
  id: property(): string java | js-client

  /**
   * Type of the events in this stream.
   */
  eventType: member function(): ValueType java | js-client

  /**
   * Register a callback for the next value from this event stream.
   */
  onNext: member function(callback: !lambda(event: E)) java | js | py

  /**
   * Creates a new event stream also returning push stream for publishing events.
   */
  create: function<T>(eventType: !ValueType): Pair<EventStream<T>, EventStream.PushStream<T>>

  toJson:      ~ java | js
  toTypedJson: ~ java | js
  fromJson:    ~ java | js
}
