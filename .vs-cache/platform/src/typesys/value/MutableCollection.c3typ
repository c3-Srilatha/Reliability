/**
 * Mutable Collection instances allow their content to be changed.
 */
abstract type MutableCollection<E> mixes Collection<E>, Mutable, Value {

  /**
   * Add provided elements to this collection
   */
  addAll: abstract member function(elements: !?Collection<E>): mixing MutableCollection<E>
}
