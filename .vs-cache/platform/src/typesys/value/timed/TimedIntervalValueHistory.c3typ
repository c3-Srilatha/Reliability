/**
 * The historical values over time for a timed interval value.
 */
@db(index+=['parent, descending(start), descending(end)'])
type TimedIntervalValueHistory<P> mixes TimedIntervalValue, PersistableUpsertHelper {

  /**
   * Parent/owning obj instance.
   */
  parent: !P

  // TODO: PLAT-32705 - :v8 Obj.validateObj() no longer supports/applies Ann.Constraint.condition
  // Uncomment to test and when fixed
  // @constraint(condition='!exists(start) || !exists(end) || start <= end')
  start: ~

  // TODO: PLAT-32705 - :v8 Obj.validateObj() no longer supports/applies Ann.Constraint.condition
  // Uncomment to test and when fixed
  // @constraint(condition='!exists(start) || !exists(end) || start <= end')
  end: ~
}
