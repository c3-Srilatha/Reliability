/**
 * Ties a timestamp to a relationship between 2 entities.
 */
type TimedRelation<F, T> mixes TimedValue, PersistableUpsertHelper {

  /**
   * The from side of the relation.
   */
  from: F

  /**
   * The to side of the relation.
   */
  to: T
}
