/**
 * Ties a start and end timestamp to an object's field values in a type that mixes this type in.
 */
type TimedIntervalValue {

  /**
   * Start timestamp for the value.  If null, assumed to be beginning-of-time (BOT).
   */
  start: datetime

  /**
   * End timestamp for the value.  If null, assumed to be end-of-time (EOT).
   */
  end: datetime
}
