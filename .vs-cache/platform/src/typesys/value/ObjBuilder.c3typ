/**
 * Builder of Obj i.e. instances of C3 Type.
 *
 * @see Obj.builder
 * @see Type.objBuilder
 */
abstract type ObjBuilder<O: Obj> mixes MethodsProtocol, WithType, Mutable, Value, Serializable {

  /**
   * Adds a new field to this builder.
   */
  v: member function(field: !string, value: !?any, doNotConvert: boolean): !mixing ObjBuilder<O> java | js | py

  /**
   * Adds a new field to this builder.
   */
  v: member function(field: !FieldType, value: !?any, doNotConvert: boolean): !mixing ObjBuilder<O> java | js | py

  /**
   * Adds a new reference field builder.
   */
  r: member function(field: !string): !ObjBuilder<O> java | js | py

  /**
   * Adds a new reference field builder.
   */
  r: member function(field: !FieldType): !ObjBuilder<O> java | js | py

  /**
   * Adds a new element in an array field for this builder. The array is automatically created on first call.
   */
  a: member function(field: !string, element: !?any, doNotConvert: boolean): !mixing ObjBuilder<O> java | js | py

  /**
   * Adds a new element in an array field for this builder. The array is automatically created on first call.
   */
  a: member function(field: !FieldType, element: !?any, doNotConvert: boolean): !mixing ObjBuilder<O> java | js | py

  /**
   * Creates a new array builder for a given array field.
   */
  a: member function<E>(field: !string): ArrayBuilder<E> java | js | py

  /**
   * Creates a new array builder for a given array field.
   */
  a: member function<E>(field: !FieldType): ArrayBuilder<E> java | js | py

  /**
   * Adds a new key/value pair in a map field for this builder. The map is automatically created on first call.
   */
  m: member function(field: !string,
                     key: !?any,
                     element: !?any,
                     doNotConvert: boolean): !mixing ObjBuilder<O> java | js | py

  /**
   * Adds a new key/value pair in a map field for this builder. The map is automatically created on first call.
   */
  m: member function(field: !FieldType,
                     key: !?any,
                     element: !?any,
                     doNotConvert: boolean): !mixing ObjBuilder<O> java | js | py

  /**
   * Creates a new map builder for a given map field.
   */
  m: member function<K, E>(field: !string): !MapBuilder<K, E> java | js | py

  /**
   * Creates a new map builder for a given map field.
   */
  m: member function<K, E>(field: !FieldType): !MapBuilder<K, E> java | js | py

  /**
   * Adds a new element in a set field for this builder. The set is automatically created on first call.
   */
  s: member function(field: !string, element: !?any, doNotConvert: boolean): !mixing ObjBuilder<O> java | js | py

  /**
   * Adds a new element in a set field for this builder. The set is automatically created on first call.
   */
  s: member function(field: !FieldType, element: !?any, doNotConvert: boolean): !mixing ObjBuilder<O> java | js | py

  /**
   * Creates a new set builder for a given set field.
   */
  s: member function<E>(field: !string): SetBuilder<E> java | js | py

  /**
   * Creates a new set builder for a given set field.
   */
  s: member function<E>(field: !FieldType): SetBuilder<E> java | js | py

  /**
   * Unsets a field, meaning that the field will become not {@link isFieldSet set} in the built `Obj`.
   */
  unsetField: final member function(field: !string): !mixing ObjBuilder<O> java | py | js

  /**
   * Unsets a field, meaning that the field will become not {@link isFieldSet set} in the built `Obj`.
   */
  unsetField: member function(field: !FieldType): !mixing ObjBuilder<O> java | py | js

  /**
   * Removes a field, meaning that the field will become {@link isFieldMissing missing} in the built `Obj`.
   */
  removeField: member function(field: !string): !mixing ObjBuilder<O> java | py | js

  /**
   * Removes a field, meaning that the field will become {@link isFieldMissing missing} in the built `Obj`.
   */
  removeField: member function(field: !FieldType): !mixing ObjBuilder<O> java | py | js

  /**
   * Sets provided fields into this builder.
   */
  setFields: member function(fields: !?map<string, any>, doNotConvert: boolean): !mixing ObjBuilder<O> java | js | py

  /**
   * Unsets provided fields into this builder.
   */
  unsetFields: member function(fields: !?set<string>): !mixing ObjBuilder<O> java | py | js

  /**
   * Removes provided fields from this builder.
   */
  removeFields: member function(fields: !?set<string>): !mixing ObjBuilder<O> java | py | js

  /**
   * Merges all field from other into this builder.
   */
  mergeObj: member function(other: !?Obj): !mixing ObjBuilder<O> java | js | py

  /**
   * Merges all fields of otherFieldsFilter type from other into this builder.
   */
  mergeObj: member function(other: !?Obj, otherFieldsFilter: !Type): !mixing ObjBuilder<O> java | js | py

  /**
   * Merges all json fields into this builder.
   */
  mergeJson: member function(json: !?json, failIfInvalid: boolean): !mixing ObjBuilder<O> java | js | py

  /**
   * Clears all field values.
   */
  clear: member function(): !mixing ObjBuilder<O> java | js | py

  /**
   * Enforce constraints when building final Obj.
   */
  constrain: member function<E>(): !mixing ObjBuilder<E> java | js | py

  /**
   * Enforces that resulting `Obj` built from this builder will not have default values applied to fields. This is
   * the default behavior of `ObjBuilder` and is implicitly opted into.
   * @see ObjSpec#withoutDefaults
   */
  withoutDefaults: member function(): !mixing ObjBuilder java | js | py

  /**
   * Enforces that resulting `Obj` built from this builder will have default values applied to fields. This is
   * not the default behavior of `ObjBuilder` and must be explicitly opted into.
   */
  withDefaults: member function(): !mixing ObjBuilder java | js | py

  /**
   * set the state field to the {@link BitSet}
   */
  _setFieldState: private member function(state: !BitSet): !mixing ObjBuilder java

  /**
   * Enforces that all fields on the resulting `Obj` which were not set on this builder (including fields on the `Obj`
   * from which this builder was produced) are {@link Obj#isFieldMissing missing}. This is not the default behavior of
   * `ObjBuilder` and must be explicitly opted into. If this method is called on an `ObjBuilder`, calling
   * {@link withoutDefaults} will have no effect.
   *
   * @see ObjSpec#withMissing
   */
  withMissing: member function(): !mixing ObjBuilder java | py | js

  /**
   * Enforces that resulting `Obj` from this builder will have no {@link Obj#isFieldMissing missing fields}.
   * This is the default behavior of `ObjBuilder` and is implicitly opted into. This reverts the effect of
   * {@link withMissing}
   */
  withoutMissing: member function(): !mixing ObjBuilder java | py | js

  /**
   * True if no field values are set.
   */
  isEmpty: member function(): boolean java | js | py

  /**
   * Builds temporary instance of Obj representing current state of the builder. Unlike #build Obj instance may not be
   * packed / optimized. It is recommended to use #current in the process of building the collection and only call
   * #build once done.
   */
  current: member function(): !O java | js | py

  /**
   * Builds final optimized instance of Obj for this builder. While it is allowed to call #build more than once if there
   * is such need then #current is more advisable.
   */
  build: member function(): !O java | js | py

  /**
   * @return type which this builder builds.
   */
  objType: member function(): !Type java | js | py

  /**
   * @return the current value of the field.
   */
  fieldValue: member function(field: !string): any

  /**
   * @return the current value of the field.
   */
  fieldValue: member function(field: !FieldType): any
}
