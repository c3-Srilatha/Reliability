/**
 * Type describing identifiable object. E.g. database entities that have primary key or a person with SSN.
 * This ID is expected to be unique within its domain; for logical labels see the #Nameable type.
 *
 * @see WithUniqueName
 */
type WithUniqueId mixes WithGlobalKey, StringSerializable {

  /**
   * Unique identifier for the logical object that instance of this type represents.
   */
  id: string
}
