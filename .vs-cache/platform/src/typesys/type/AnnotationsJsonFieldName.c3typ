/**
 * The names of the fields within the individual annotation field elements of the JSON-serialized declared annotations.
 *
 * @see AnnotationsJson
 */
enum type AnnotationsJsonFieldName {

  /**
   * The name of the JSON field that holds the field name of a single annotation value.
   */
  NAME = "name"

  /**
   * The name of the JSON field that holds the field value of a single annotation value.
   */
  VALUE = "value"

  /**
   * The name of the JSON field that holds the field assignment operator of a single annotation value.
   */
  OP = "op"

  /**
   * The name of the JSON field that holds whether or not the field value is an identifier.
   */
  VALUE_IS_ID = "valueIsId"

  /**
   * The source line number.
   */
  SRC_LINE = "declaredSrcLine"

  /**
   * The source character number (within the line).
   */
  SRC_CHAR = "declaredSrcCharInLine"
}
