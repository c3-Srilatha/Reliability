/**
 * An event-stream is a notification mechanism or communication channel that event producer [ e.g. server process ] is
 * using for delivering new events to caller / client.
 *
 * Event Streams are declared in DSL using `event stream<E>` syntax:
 * ```
 *
 * @see EventStream
 */
type EventStreamType mixes ValueType {

  /**
   * The value type for the events of this event-stream.
   */
  eventType: !ValueType

  instanceType: ~
}
