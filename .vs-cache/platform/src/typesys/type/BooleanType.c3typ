/**
 * The boolean value typically is just `true` or `false`.
 *
 * However using the `?boolean` declaration, the value can be set as `null` (for a tri-state).
 *
 * There are no fields (other than #modifier), so this is normally accessed with {@link PrimitiveType#ofBool}.
 */
type BooleanType mixes PrimitiveType {

  validateValue:      ~
  isConvertibleValue: ~
  valueConverter:     ~
  makeValue:          ~ java | py | js
  valueFromJson:      ~ java | py | js
  valueFromString:    ~ java | py
  isSamePredicate:    ~
}
