/**
 * The DateTime value type has inner structure (fields):
 *  - precision: seconds / milliseconds / microseconds / nanoseconds
 *  - time zone: arbitrary / force UTC / no time zone
 *  - no time (logical date only)
 *
 * Note that when parsing `datetime` values, excess precision beyond that declared in the value type will be discarded.
 * If sub-second precision is desired for a value, it must be declared that way.
 *
 * Varions methods on **PrimitiveType** produce the most common variants:
 *  - {@link PrimitiveType#ofDateTime ofDateTime}
 *  - {@link PrimitiveType#ofDateOnly ofDateOnly}
 *  - {@link PrimitiveType#ofDateTimeMillis ofDateTimeMillis}
 *  - {@link PrimitiveType#ofDateTimeMicros ofDateTimeMicros}
 *  - {@link PrimitiveType#ofDateTimeNanos ofDateTimeNanos}
 */
type DateTimeType mixes PrimitiveType {

  /**
   * For datetime fields, forces input values to be converted/persisted in UTC only, losing any time zone offset
   * information that was present.
   */
  @dsl(syntax="utc")
  forceUtc: boolean

  /**
   * For datetime fields, ignores any timezone offset information present.
   */
  @dsl(syntax="no tz", suffix=true)
  noTimeZone: boolean

  /**
   * For datetime values, ignores any time information and persists only the date portion of any input value.
   */
  @dsl(suppress=true)
  noTime: boolean

  /**
   * For datetime values, saves the milliseconds in the time, creating a time with higher precision than the default
   * of seconds.
   */
  @dsl(suffix=true)
  withMillis: boolean

  /**
   * For datetime values, saves the microseconds in the time, creating a time with higher precision than the default
   * of seconds.
   */
  @dsl(suffix=true)
  withMicros: boolean

  /**
   * For datetime values, save the nanoseconds in the time, creating a time with higher precision than the default
   * of seconds. This may reduce to a coarser granularity of storage of the underlying database does not have support
   * for nanoseconds.
   */
  @dsl(suffix=true)
  withNanos: boolean

  /**
   * The inherent sub-second precision of this DateTime instance as decimal digits. For example, 0 indicates only
   * seconds and 3 indicates milliseconds.
   */
  subSecondPrecision: member function(): !int32 java | js

  /**
   * If this DateTimeType can represent an arbitrary time zone.
   */
  isArbitraryZone: member function(): boolean java | js

  // TODO PLAT-25462 Implement in java
  valueToJson: ~ java | py | js

  valueToTypedJson: ~ java | py | js
  makeValue:        ~ java | py | js
  valueFromJson:    ~ java | py | js
  valueFromString:  ~ java | py
  isSamePredicate:  ~
  toString:         ~ java | js | py
  toLabel:          ~ java | js
  instanceType:     ~
  valueConverter:   ~
}
