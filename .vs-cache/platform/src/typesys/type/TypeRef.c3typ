/**
 * The TypeRef holds a reference to an existing type. It is invalid to construct TypeRef from non-existing type. Use
 * string and refer to type by name in those cases.
 */
@deprecated
type TypeRef mixes Obj, StringSerializable {

  @deprecated
  moduleName: string

  typeName: !string

  // Get the actual type information for the type referenced by name.
  toType: inline member function(failIfInvalid: boolean): Type

  // Construct a type ref from an actual type
  fromType: inline function(inst: !Type): mixing TypeRef
}
