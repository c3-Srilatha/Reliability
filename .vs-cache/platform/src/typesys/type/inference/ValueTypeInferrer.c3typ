/**
 * Performs inference on a generic digest which could result in an Obj-like result or primitive ValueType. To ensure
 * that strings are parsed for their content make sure that the input digest is built using a ParsingDigestBuilder.
 *
 * @see Digest
 * @see ObjDigest
 * @see ParsingDigestBuilder
 * @see InferValueTypeResult
 */
type ValueTypeInferrer mixes Inferrer<Digest<any, any, any>, InferValueTypeResult>
