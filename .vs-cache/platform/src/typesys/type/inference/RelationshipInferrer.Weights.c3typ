/**
 * See FKInference.ipynb for training data / logistic regression fit.
 */
type RelationshipInferrer.Weights {

  /**
   * Similarity between column names.
   */
  w1: const double = 0.80889244

  /**
   * Similarity between fk column name and pk table name.
   */
  w2: const double = 1.08344806

  /**
   * The ratio of cardinality between fk and pk.
   */
  w3: const double = 0.75302812

  /**
   * The offset value in logistic regression.
   */
  b: const double = -1.02982885

  /**
   * The minimum value the scoring function must be to classify a Fk-Pk relationship.
   */
  threshold: const double = 0.5

  /**
   * Evaluates the logistic regression equation with the provided features.
   */
  score: function(s1: double, s2: double, s3: double): double

  /**
   * Returns score >= threshold.
   */
  classify: function(s1: double, s2: double, s3: double): boolean
}
