/**
 * A representation of a processed {@link Data}. This type contains helper methods to evaluate the primary keys
 * and foreign keys in a schema.
 */
type RelationshipInferrer.DataFrame {

  /**
   * The Data that this DataFrame represents.
   */
  data: ?Data

  /**
   * Name of the target type represented by this DataFrame
   */
  tableName: string

  /**
   * Return the columns {@link RelationshipInferrer.Column} that make up this DataFrame.
   */
  columns: member function(): [RelationshipInferrer.Column]

  /**
   * Return the best guess on which column is the primary key. Returns null if there are no feasible candidates.
   */
  primaryKey: member function(): RelationshipInferrer.Column
}
