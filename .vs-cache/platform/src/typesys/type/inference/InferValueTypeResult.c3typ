/**
 * Result of a ValueType inference.
 */
type InferValueTypeResult mixes Result {

  /**
   * ValueType of the final result.
   */
  valueType: !ValueType

  /**
   * Helper method for extracting TypeMeta from the result.
   * @param failIfInvalid
   *                throw error if result does not contains a TypeMeta
   */
  typeMeta: member function(failIfInvalid: boolean): TypeMeta

  /**
   * Generates an InferValueTypeResult instance from an ObjDigest. Saves the generated TypeMeta to the specified pkg in
   * @see InferTypeSpec.
   */
  fromObjDigest: function(objDigest: !ObjDigest, spec: InferTypeSpec): !InferValueTypeResult

  /**
   * Generates an InferValueTypeResult instance from an stream of json objects.
   */
  fromJsonStream: function(jsons: !stream<json>, spec: InferTypeSpec): !InferValueTypeResult

  /**
   * Generates an InferValueTypeResult from a TypeMeta.
   */
  fromTypeMeta: function(meta: !TypeMeta, spec: InferTypeSpec): !InferValueTypeResult

  /**
   * Generates an InferValueTypeResult from a ValueType.
   */
  fromValueType: function(vt: !ValueType, spec: InferTypeSpec): !InferValueTypeResult

  /**
   * Generates an InferValueTypeResult from a map of declared value types
   */
  fromMap: function(valueMap: !map<string, ValueType>, spec: InferTypeSpec): !InferValueTypeResult

  /**
   * Saves the provided TypeMeta to the specified pkg in @see InferTypeSpec. If {@link Pkg#isUpdatable}
   * then type meta is also written directly to file system as a .c3typ file.
   */
  upsertMeta: member function(spec: !InferTypeSpec): !InferValueTypeResult
}
