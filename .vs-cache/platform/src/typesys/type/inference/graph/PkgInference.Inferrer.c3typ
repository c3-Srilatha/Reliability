/**
 * Type which performs {@link Dataset#createPkg}. Accepts a Dataset, which is analyzed to produce a mapping from sink
 * {@link Data} -> {@link PkgInference.Metadata} as output.
 */
@beta
type PkgInference.Inferrer mixes Inferrer<Dataset, [PkgInference.Metadata]>
