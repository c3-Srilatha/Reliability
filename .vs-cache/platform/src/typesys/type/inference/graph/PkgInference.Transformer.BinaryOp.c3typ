/**
 * Transforms {@link Workflow.Action} vertices that are binary ops into {@link PkgInference.Vertex.Transform} vertices
 */
@beta
type PkgInference.Transformer.BinaryOp mixes PkgInference.Transformer.ActionReplacer {

  methods:                   const ~ = "[add, sub, mul, div, mod, eq, ne, lt, le, gt, ge, or, and, equalTo, notEqualTo, lessThan, lessThanEqualTo, greaterThan, greaterThanEqualTo, radd, rdiv, rfloordiv, rmod, rmul, rpow, rsub, rtruediv, pow, floordiv]"
  otherPortNames:            const ~ = "[other]"
  replacementFromOneParent:  ~
  replacementFromTwoParents: ~
}
