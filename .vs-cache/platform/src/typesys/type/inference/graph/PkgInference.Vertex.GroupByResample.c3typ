/**
 * Represents a groupby -> resample -> agg operation. Inferred from a call to {@link Data#groupby}, followed by a call
 * to {@link Data.GroupBy#resample}, followed by an aggregation operation.
 */
@beta
type PkgInference.Vertex.GroupByResample mixes PkgInference.Vertex.UnevaluatedMetric {

  /**
   * Actual {@link Data.Resample} used in this operation
   */
  groupByResample: !Data.Resample

  /**
   * Aggregation operation used after the groupby -> resample operation.
   */
  aggOp: !AggOp

  /**
   * Returns an array of column names: the column which was grouped by and the column which was resampled on,
   * corresponding to the "by" parameter for {@link Data#groupby} and the "on" parameter for
   * {@link Data.GroupBy#resample}.
   *
   * @see PkgInference.Vertex.UnevaluatedMetric#excludedFieldNames
   */
  excludedFieldNames: ~
}
