/**
 * Base type for all vertices representing metric operators. Each subtype essentially represents a different
 * {@link ExpressionEngineFunction} which will be used when this vertex is later transformed into a
 * {@link PkgInference.Vertex.Metric}.
 *
 * @see PkgInference#metricMethods
 */
@beta
abstract type PkgInference.Vertex.UnevaluatedMetric mixes PkgInference.Vertex.WithToExpr, PkgInference.Vertex.Processed {

  doFromParent: ~

  /**
   * Returns an array of column names which should be excluded from having a metric computed over them for this metric
   * operation. By default, returns an empty array; to be overridden by any subtypes which exclude fields.
   */
  excludedFieldNames: member function(): [string]

  /**
   * Return the prefix which should be prepended to the name of the metric for this metric operation.
   * eg, Interpolate -> "ForwardFill"
   */
  metricNamePrefix: abstract member function(): string

  /**
   * Produces a {@link TSDecl} from this vertex, which is used in building {@link SimpleMetric}s in
   * {@link PkgInference.Transformer.UnevaluatedMetric}.
   */
  toTSDecl: abstract member function(value: !string): TSDecl
}
