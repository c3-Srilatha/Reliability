/**
 * Represents a FillMissing expression. Inferred from a call to {@link Data#fillna} which uses the "value" parameter.
 * Produces a {@link ExpressionEngineFunction#fillMissing} expression.
 */
@beta
type PkgInference.Vertex.FillMissing mixes PkgInference.Vertex.UnevaluatedMetric {

  /**
   * The value to fill holes with.
   */
  fillerValue: any
}
