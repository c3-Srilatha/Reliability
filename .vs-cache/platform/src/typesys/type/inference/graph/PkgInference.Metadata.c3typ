/**
 * Result type that encapsulates results from various {@link Workflow} transformers.
 */
@beta
type PkgInference.Metadata {

  /**
   * Inferred {@link SourceCollection}s
   */
  // TODO: PLAT-40185 remove <any> restriction
  sourceCollections: [SourceCollection<any>]

  /**
   * Inferred {@link Transform}s
   */
  transforms: [Transform]

  /**
   * Inferred {@link Metric}s
   */
  metrics: [Metric]

  /**
   * Inferred {@link EvalMetricsSpec}s
   */
  evalMetricsSpecs: [EvalMetricsSpec]

  /**
   * Inferred {@link FetchSpec}s
   */
  fetchSpecs: [FetchSpec]

  /**
   * Timestamp when package inference finished
   */
  created: datetime = now()

  /**
   * Executes inferred data integration pipeline and fetches integrated Obj values from C3.
   *
   * @param fetchSpec
   *        the {@link FetchSpec} to use when fetching integrated data
   * @return map of name of {@link SourceCollection} to map of name of target type to fetched Obj values
   */
  processSourceCollections: cached member function(fetchSpec: FetchSpec): map<string, map<string, [Persistable<Obj>]>>

  /**
   * Helper method to query all inferred Types
   */
  types: member function(): map<string, Type>

  /**
   * Helper method to query all inferred TypeMetas
   */
  typeMetas: member function(): map<string, TypeMeta>

  /**
   * Helper method to query all inferred source Types
   */
  sourceTypes: member function(): map<string, Type>

  /**
   * Helper method to query all inferred source TypeMetas
   */
  sourceTypeMetas: member function(): map<string, TypeMeta>

  /**
   * Helper method to query all inferred target Types
   */
  targetTypes: member function(): map<string, Type>

  /**
   * Helper method to query all inferred target TypeMetas
   */
  targetTypeMetas: member function(): map<string, TypeMeta>

  /**
   * Helper method to query all inferred {@link External} Types
   */
  externalTypes: member function(): map<string, Type>

  /**
   * Helper method to query all inferred {@link External} TypeMetas
   */
  externalTypeMetas: member function(): map<string, TypeMeta>

  /**
   * Helper method to evaluate all inferred metrics and return their results
   *
   * @return map with name of inferred Metric as key and value as evaluated {@link Timeseries} data
   */
  evaluateMetrics: member function(): map<string, Timeseries>
}
