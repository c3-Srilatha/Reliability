/**
 * Abstract base type for a vertex that holds a reference to a {@link Data}
 */
@beta
abstract type PkgInference.Vertex.WithDataReference {

  /**
   * Reference to {@link DataImpl}.
   * This reference may be **outdated** if vertex replacement happens inside {@link PkgInference}, in which case
   * use {@link Data#fromDataFlow} to create updated instance
   * @see PkgInference#replaceActionAndArgs
   * @see FlowGraph#replaceVertices
   */
  data: ?DataImpl

  /**
   * Overload function to compare the WithDataReference instances by comparing the json string of the two instances
   * without the `data` field.
   * @return
   *        Return true if the two instances have the same content.
   */
  // TODO: PLAT-41722: Remove DataToWorkflowVisitorCtx#_attachData
  isSame: ~
}
