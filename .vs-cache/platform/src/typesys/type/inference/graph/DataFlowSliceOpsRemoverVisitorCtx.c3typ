/**
 * Context for DataFlowSliceOpsRemoverVisitor
 *
 * @see DataVisitable, @see DataFlowSliceOpsRemoverVisitor
 */
@beta
private type DataFlowSliceOpsRemoverVisitorCtx {

  /**
   * PkgInference used to find the nextVertices.
   */
  dataFlow: !PkgInference

  /**
   * The filter ops to be removed
   */
  filterNames: !set<string>

  /**
   * The columns that will have their filter ops removed. Additional names could be added to this set if there are
   * rename operations.
   */
  columnNames: !SetBuilder<string>
}
