/**
 * Abstract base type for a {@link PkgInference.Transformer} that replaces a single {@link Workflow.Action} vertex with
 * another vertex. Depending on the context, dispatches to replacementFromOneParent or replacementFromTwoParents method
 * overridden and implemented by subtypes.
 */
@beta
abstract type PkgInference.Transformer.ActionReplacer mixes PkgInference.Transformer.Default {

  action: ~

  /**
   * String serialized array of method names which are {@link Data} operators. Any {@link Workflow.Action} whose
   * {@link Workflow.Action#actionName} is contained in this array is a candidate to be replaced. To be overridden by
   * subtypes to specify which Data methods they should act on.
   */
  methods: const string = "[]"

  /**
   * String serialized array of port names for the action vertex's other parents; to be overridden by subtypes
   * which transform action vertices that may have multiple {@link Data} arguments. Note that any type that overrides
   * this field by providing a single port name is claiming to support
   * {@link PkgInference.Transformer.ActionReplacer#replacementTwoParents}. If a type overrides this field with multiple
   * port names, it is claiming to support {@link PkgInference.Transformer.ActionReplacer#replacementMultipleParents}.
   */
  otherPortNames: const string = "[]"

  /**
   * @param action
   *        {@link Workflow.Action} vertex to replace
   * @param parent
   *        Direct parent of the action vertex, corresponding to the "data" in-port
   * @return the vertex to replace the {@link Workflow.Action} vertex with
   *
   * To be overridden by subtype that replaces action vertices which only have a single parent. Will be dispatched to
   * only if {@link PkgInference.Transformer.ActionReplacer#otherPortName} is not specified or if it is specified and
   * the vertex at that port is a {@link Workflow.Const}.
   */
  replacementFromOneParent: function(action: !Workflow.Action,
                                     parent: !PkgInference.Vertex.Processed,
                                     pi: !PkgInference): !PkgInference.Vertex.Processed

  /**
   * @param action
   *        {@link Workflow.Action} vertex to replace
   * @param parent
   *        Direct parent of the action vertex, corresponding to the "data" in-port
   * @param other
   *        Second parent of the action vertex, corresponding to the
   *        {@link PkgInference.Transformer.ActionReplacer#otherPortName} in-port
   * @return the vertex to replace the {@link Workflow.Action} vertex with
   *
   * To be overridden by subtype that replaces action vertices which have two {@link Data} parents. Will be dispatched
   * to if otherPortName is specified and the vertex at that port is a {@PkgInference.Vertex.Processed}.
   */
  replacementFromTwoParents: function(action: !Workflow.Action,
                                      parent: !PkgInference.Vertex.Processed,
                                      other: !PkgInference.Vertex.Processed,
                                      pi: !PkgInference): !PkgInference.Vertex.Processed

  /**
   * @param action
   *        {@link Workflow.Action} vertex to replace
   * @param parent
   *        Direct parent of the action vertex, corresponding to the "data" in-port
   * @param others
   *        Map of port names to other parents of the action vertex, corresponding to the
   *        {@link PkgInference.Transformer.ActionReplacer#otherPortName} in-port
   * @return the vertex to replace the {@link Workflow.Action} vertex with
   *
   * To be overridden by subtype that replaces action vertices which have more than two {@link Data} parents. Will be dispatched
   * to if otherPortName is specified with multiple ports and at least one vertex at that ports is
   * a {@PkgInference.Vertex.Processed}.
   */
  replacementFromMultipleParents: function(action: !Workflow.Action,
                                           parent: !PkgInference.Vertex.Processed,
                                           others: !map<string, PkgInference.Vertex.Processed>,
                                           pi: !PkgInference): !PkgInference.Vertex.Processed
}
