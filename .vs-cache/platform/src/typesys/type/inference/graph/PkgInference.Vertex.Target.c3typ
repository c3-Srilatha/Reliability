/**
 * Base type for vertices which have been marked as a target type during the PkgInference algorithm.
 */
@beta
abstract type PkgInference.Vertex.Target mixes PkgInference.Vertex.Processed {

  /**
   * Generate a transform from this vertex, which includes a populated {@link Transform#target} field
   */
  transform: cached abstract member function(): !Transform

  /**
   * Helper method to return the name of the target type from the produced transform.
   * @see PkgInference.Vertex.Target#transform
   */
  targetTypeName: member function(): !string
}
