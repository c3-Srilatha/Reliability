/**
 * Transforms {@link Data#setFieldValue} and {@link Data#addField} vertices into
 * {@link PkgInference.Vertex.FieldMutation} vertices.
 */
@beta
type PkgInference.Transformer.FieldMutation mixes PkgInference.Transformer.ActionReplacer {

  methods:                   const ~ = "[setItem]"
  otherPortNames:            const ~ = "[value]"
  replacementFromOneParent:  ~
  replacementFromTwoParents: ~
}
