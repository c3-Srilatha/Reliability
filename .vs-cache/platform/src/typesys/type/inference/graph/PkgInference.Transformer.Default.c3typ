/**
 * A {@link PkgInference.Visitor} that has a default implementation for every type of vertex.
 */
// TODO: PLAT-38564 This Type is a workaround the fact that reflection looks for the wrong signature.
@beta
abstract type PkgInference.Transformer.Default mixes PkgInference.Visitor<PkgInference>, Workflow.Optimization {

  /**
   * Type-level boolean field which determines whether subtypes will run in the main Pkg Inference transformer loop
   * until the graph reaches steady state. Defaults to true - to be overridden by subtypes which should not run in
   * every loop, eg {@link PkgInference.Transformer.Source}.
   *
   * @see PkgInference#optimizer
   */
  runInMainLoop: const boolean = true

  optimize:          ~
  action:            ~
  const:             ~
  primitive:         ~
  source:            ~
  target:            ~
  transform:         ~
  external:          ~
  unevaluatedMetric: ~
  metric:            ~
  fetchSpec:         ~
}
