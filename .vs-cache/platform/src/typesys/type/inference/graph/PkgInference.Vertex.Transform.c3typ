/**
 * Represents a {@link Transform} in a {@link PkgInference} FlowGraph. Every {@link Workflow.Action} vertex which
 * is not used as part of the Data Integration context (ie, not used for a {@link Metric}) will be transformed into
 * this.
 */
@beta
type PkgInference.Vertex.Transform mixes PkgInference.Vertex.Processed {

  doFromParent: ~

  /**
   * Name of the action on the {@link Workflow.Action} from which this vertex was transformed.
   */
  actionName: !string
}
