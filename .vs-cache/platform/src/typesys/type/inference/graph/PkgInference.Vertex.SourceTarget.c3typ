/**
 * A {@link PkgInference.Vertex.Source} which has been marked to be evaluated as a Target type. This is a special case
 * where we will produce an "identity Transform", as no operations have been performed on this source which can be
 * captured as part of a DI pipeline.
 */
@beta
type PkgInference.Vertex.SourceTarget mixes PkgInference.Vertex.Source, PkgInference.Vertex.Target {

  /**
   * Generates an {@link Transform} from this {@link PkgInference.Vertex.Source} vertex that produces an identical
   * Target type for this vertex's Source {@link Type}.
   */
  transform: ~
}
