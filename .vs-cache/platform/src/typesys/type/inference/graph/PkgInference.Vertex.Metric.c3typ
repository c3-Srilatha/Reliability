/**
 * Vertex which contains {@link Metrics} computed over the data.
 */
@beta
type PkgInference.Vertex.Metric mixes PkgInference.Vertex.Processed {

  /**
   * Map from column name to simple or compound metric evaluated over the column.
   */
  metrics: map<string, Metric>
}
