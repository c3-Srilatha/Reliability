/**
 * A {@link PkgInference.Vertex.Transform} which was produced from a {@link Data#rename} {@link Workflow.Action}
 * vertex. Preserves additional information which is required for
 * {@link PkgInference.Vertex.Processed#parentMetricName}.
 */
@beta
type PkgInference.Vertex.Rename mixes PkgInference.Vertex.Transform {

  /**
   * Inverted version of {@link Data#rename}'s rename map argument. Maps from new column name -> original column name.
   */
  renameMap: !map<string, string>

  /**
   * Helper function which applies the renameMap to a given column. If the column exists as a key in the rename map,
   * return the associated value. Otherwise, return the given column name unchanged.
   */
  renamedColumn: member function(column: !string): !string
}
