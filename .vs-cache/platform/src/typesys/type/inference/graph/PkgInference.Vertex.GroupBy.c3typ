/**
 * Represents a groupby -> agg operation. Inferred from a call to {@link Data#groupby},
 * followed by an aggregation operation.
 */
@beta
type PkgInference.Vertex.GroupBy mixes PkgInference.Vertex.UnevaluatedMetric {

  /**
   * Actual {@link Data.GroupBy} used in this operation
   */
  groupBy: !Data.GroupBy

  /**
   * Aggregation operation used after the groupby operation.
   */
  aggOp: !AggOp

  /**
   * Returns the column which was grouped by, corresponding to the "by" parameter for {@link Data#groupby}.
   * @see PkgInference.Vertex.UnevaluatedMetric#excludedFieldNames
   */
  excludedFieldNames: ~
}
