/**
 * Represents a rolling -> agg operation. Inferred from a call to {@link Data#rolling} followed by an aggregation
 * operation. Produces a {@link ExpressionEngineFunction#window} expression.
 */
@beta
type PkgInference.Vertex.Rolling mixes PkgInference.Vertex.UnevaluatedMetric {

  /**
   * Actual {@link Data.Rolling} used in this operation
   */
  rolling: !Data.Rolling

  /**
   * Aggregation operation used after the rolling operation.
   */
  aggOp: !AggOp

  /**
   * Returns a singleton array of the column corresponding to the "on" parameter for {@link Data#rolling}, if it was
   * provided; else, an empty array.
   *
   * @see PkgInference.Vertex.UnevaluatedMetric#excludedFieldNames
   */
  excludedFieldNames: ~
}
