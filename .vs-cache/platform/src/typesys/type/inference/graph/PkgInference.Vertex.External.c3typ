/**
 * Represents an external data source in a {@link PkgInference} FlowGraph. Created from a {@link Workflow.Action} vertex
 * representing a {@link Data#read_sql_query} call.
 */
@beta
type PkgInference.Vertex.External mixes Workflow.Vertex {

  /**
   * Inferred {@link SourceCollection} pointing to external datastore.
   */
  sourceCollection: SourceCollection<any>
}
