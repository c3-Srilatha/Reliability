/**
 * A {@link PkgInference.Vertex.Transform} which has been marked to be evaluated as a Target type.
 */
@beta
type PkgInference.Vertex.TransformTarget mixes PkgInference.Vertex.Transform, PkgInference.Vertex.Target {

  /**
   * Build and return a Transform with the target type populated using the information from
   * {@link PkgInference.Vertex.Processed}. Also modifies the Source type to mixin {@link Source}. As a side effect
   * this function will upsert the generated Source and Target types to the current {@link Pkg}.
   */
  transform: ~
}
