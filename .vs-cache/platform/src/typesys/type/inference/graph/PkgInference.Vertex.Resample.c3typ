/**
 * Represents a resample -> agg operation. Inferred from a call to {@link Data#resample} followed by an aggregation
 * operation.
 */
@beta
type PkgInference.Vertex.Resample mixes PkgInference.Vertex.UnevaluatedMetric {

  /**
   * Actual {@link Data.Resample} used in this operation
   */
  resample: !Data.Resample

  /**
   * Aggregation operation used after the resample operation.
   */
  aggOp: !AggOp

  /**
   * Returns a singleton array of the column name corresponding to the "on" parameter for {@link Data.GroupBy#resample}
   *
   * @see PkgInference.Vertex.UnevaluatedMetric#excludedFieldNames
   */
  excludedFieldNames: ~
}
