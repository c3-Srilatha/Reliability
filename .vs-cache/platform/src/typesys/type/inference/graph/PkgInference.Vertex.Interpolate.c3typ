/**
 * Represents an Interpolate expression. Inferred from a call to {@link Data#fillna} which uses the "method"
 * parameter. Produces a {@link ExpressionEngineFunction#interpolate} expression.
 */
@beta
type PkgInference.Vertex.Interpolate mixes PkgInference.Vertex.UnevaluatedMetric {

  /**
   * The kind of interpolation technique to apply
   */
  interpolatorType: string

  /**
   * the kind of data interpolation should be applied on. Should be one of DATA/MISSING
   */
  performOn: string
}
