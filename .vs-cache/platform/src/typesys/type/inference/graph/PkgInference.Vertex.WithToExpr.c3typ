/**
 * A vertex which is able to yield an {@link Expr}
 */
@beta
abstract type PkgInference.Vertex.WithToExpr mixes Workflow.Vertex {

  /**
   * @return the C3 Expression that this vertex represents.
   */
  toExpr: cached abstract member function(): !Expr

  /**
   * Helper to return the C3 Expression that this vertex represents as a string.
   */
  exprString: member function(): !string
}
