/**
 * A graph visitor that trims a tabular data action graph ({@link PkgInference}) for all edges and nodes
 * unrelated to selected table column names
 * @see DataVisitable
 * @see FlowGraph#visit
 */
@beta
type DataFlowColumnSelectorVisitor mixes Workflow.Visitor<Pair<PkgInference, [string]>>
