/**
 * Context for DataFromPkgInferenceVisitor
 *
 * @see DataFromPkgInferenceVisitor
 */
@beta
private type DataFromDataFlowVisitorCtx {

  /**
   * PkgInference used to find the nextVertices.
   */
  dataFlow: !PkgInference

  /**
   * Caches the Data in previously visited {@link PkgInference.Vertex.ActionWithData} based on the action's id.
   */
  actionIdToData: MapBuilder<string, DataImpl.Lazy>

  /**
   *  Additional filter operation on the data in the Action Vertex. For example, take out id/timeRange filters out of Args
   * @see Data#fromDataFlow
   */
  actionFilter: lambda(ths: !DataImpl.Lazy): !DataImpl.Lazy
}
