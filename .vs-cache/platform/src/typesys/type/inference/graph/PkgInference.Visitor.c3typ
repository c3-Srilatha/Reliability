/**
 * A {@link Workflow.Visitor} for visiting a PkgInference FlowGraph. Defines visitor methods for
 * {@link PkgInference}-specific vertices.
 */
@beta
abstract type PkgInference.Visitor<C> mixes Workflow.Visitor<C> {

  /**
   * {@link PkgInference.Vertex.Primitive} visitor to be overridden by subtype
   */
  primitive: abstract function(primitive: !?PkgInference.Vertex.Primitive, ctx: C): C

  /**
   * {@link PkgInference.Vertex.Source} visitor to be overridden by subtype
   */
  source: abstract function(source: !?PkgInference.Vertex.Source, ctx: C): C

  /**
   * {@link PkgInference.Vertex.Target} visitor to be overridden by subtype
   */
  target: abstract function(t: !?PkgInference.Vertex.Target, ctx: C): C

  /**
   * {@link PkgInference.Vertex.Transform} visitor to be overridden by subtype
   */
  transform: abstract function(transform: !?PkgInference.Vertex.Transform, ctx: C): C

  /**
   * {@link PkgInference.Vertex.External} visitor to be overridden by subtype
   */
  external: abstract function(external: !?PkgInference.Vertex.External, ctx: C): C

  /**
   * {@link PkgInference.Vertex.UnevaluatedMetric} visitor to be overridden by subtype
   */
  unevaluatedMetric: abstract function(um: !?PkgInference.Vertex.UnevaluatedMetric, ctx: C): C

  /**
   * {@link PkgInference.Vertex.Metric} visitor to be overridden by subtype
   */
  metric: abstract function(metric: !?PkgInference.Vertex.Metric, ctx: C): C

  /**
   * {@link PkgInference.Vertex.FetchSpec} visitor to be overridden by subtype
   */
  fetchSpec: abstract function(metric: !?PkgInference.Vertex.FetchSpec, ctx: C): C

  input:  ~
  output: ~
  make_:  ~
  field:  ~
}
