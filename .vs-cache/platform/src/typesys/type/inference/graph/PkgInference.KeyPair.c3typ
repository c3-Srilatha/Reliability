/**
 * Represents a single primary key - foreign key relationship inferred by {@link PkgInference.ForeignKeyInferrer}
 */
@beta
type PkgInference.KeyPair {

  /**
   * Primary key table/type name
   */
  pkTable: string

  /**
   * Primary key column name
   */
  pkColumn: string

  /**
   * Foreign key table/type name
   */
  fkTable: string

  /**
   * Foreign key column name
   */
  fkColumn: string
}
