/**
 * Represents a source collection in a {@link PkgInference} FlowGraph. Created from either a {@link Workflow.Const}
 * vertex representing a {@link DataTable}, or a {@link Workflow.Action} vertex representing a {@link Data#read_csv}
 * call.
 */
@beta
type PkgInference.Vertex.Source mixes PkgInference.Vertex.Processed {

  /**
   * A {@link SourceCollection} for a data integration pipeline.
   */
  // TODO: PLAT-40185 remove <any> restriction
  sourceCollection: SourceCollection<any>
}
