/**
 * The result of a Foreign Key Inference.
 * @see ForeignKeyInferrer
 */
type InferForeignKeyResult mixes Result {

  // TODO: PLAT-27325 Explicitly connect TypeMetas to better express the result of a ForeignKeyInference

  /**
   * Array of all candidate pairs that were not pruned out during the Foreign Key Inference process. Each item
   * represents a single Primary Key-Foreign Key pair.
   * @see InferredKeyPair
   */
  inferredKeyPairs: [InferredKeyPair]
}
