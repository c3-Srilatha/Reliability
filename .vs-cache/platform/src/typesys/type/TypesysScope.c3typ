/**
 * Interface representing C3 Type System scope for resolving types and generic variables.
 *
 * @see Type#scope
 */
private type TypesysScope mixes Typesys {

  type:               member function(name: !?string, failIfMissing: boolean): Type java | py | js
  var:                member function(name: !?string, failIfMissing: boolean): VarReferenceType
  isVar:              member function(name: !?string): boolean
  withAdditionalVars: member function(vars: ![VarReferenceType]): TypesysScope
  typ:                !TypeMeta
  pkg:                !Pkg
  _vars:              private map<string, VarReferenceType>
}
