/**
 * Structure holding important cached methods memoized for a specific C3 Type for an efficient loading at execution
 * time.
 *
 * @see Typesys.Json
 */
inline final private type Typesys.Json.PrecomputedMethods mixes Serializable, Value {

  /**
   * Parent json these methods belong to.
   */
  parent: property(): !Typesys.Json

  /**
   * `true` if there is a memoized method result for a given method.
   */
  hasResult: member function(name: !string): boolean

  /**
   * Memoized method result.
   */
  result: member function(method: !Method): any

  /**
   * Memoized method result for a specific input.
   */
  result: member function(method: !Method, key: !any): any

  /**
   * Construct instance for a given parent {@Typesys.Json} from methods json.
   */
  fromJson: function(parent: !Typesys.Json, json: !?json): !Typesys.Json.PrecomputedMethods
}
