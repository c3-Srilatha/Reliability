/**
 * Script-based implementations of methods specify the implementation language, the required runtime along with the
 * source code. This allows the system to set up the correct language environment to execute the code.
 *
 * @see MethodType
 */
type SourceCode mixes Typesys {

  /**
   * The formal name of the scripting language, such as "JavaScript" or "Python".
   */
  language: !string

  /**
   * The runtime necessary for the source code. These runtimes are configured in the declaring package.
   */
  runtime: string

  /**
   * The source code of the implementation, declaring a function that matches the expected signature.
   */
  implementation: !string
}
