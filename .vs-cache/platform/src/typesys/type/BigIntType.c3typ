/**
 * The arbitrary-length integer value type. The semantics in languages other than Python are more or less torturous,
 * but there _is_ support in all languages. Note that `bigint` values will be significantly slower than values stored
 * in machine words that have hardware support.
 *
 * Java (not primitives):
 * ```java
 * BigInteger.TWO.pow(50).equals(new BigInteger("1125899906842624"))
 * BigInteger.TWO.pow(100).equals(new BigInteger("1267650600228229401496703205376"))
 * ```
 *
 * JavaScript (cannot intermix with regular `number` values):
 * ```js
 * 2n ** 50n === 1125899906842624n
 * 2n ** 100n === 1267650600228229401496703205376n
 * ```
 *
 * Python (natural `int` behavior):
 * ```py
 * 2 ** 50 == 1125899906842624
 * 2 ** 100 == 1267650600228229401496703205376
 * ```
 *
 * There are no fields (other than #modifier), so this is normally accessed with {@link PrimitiveType#ofBigInt}.
 *
 * @see IntType
 * @see DecimalType
 */
type BigIntType mixes NumberType {

  visitPrimitive: ~

  // TODO: PLAT-41138 Implement in JavaScript and Python
  valueFromString: ~ java

  valueFromJson:     ~ java | py | js
  defaultEmptyValue: ~ java | js | py
  isSamePredicate:   ~
  valueConverter:    ~
}
