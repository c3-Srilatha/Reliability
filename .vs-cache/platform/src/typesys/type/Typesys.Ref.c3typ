/**
 * A structure that represents string reference to a sub-type of {@link Typesys.WithRef} such as {@link FieldType} or
 * {@link Method} or {@link TypeMeta}.
 *
 * @see Typesys.WithRef
 */
abstract inline final private type Typesys.Ref mixes StringSerializable {

  /**
   * Lookup instance of the type system element this is referring to. If #parentTypeMeta is provided and this is a
   * reference to child of that type, then lookup in the provided type instead of from #pkg.
   */
  toTypesys: abstract member function<T: Typesys>(pkg: !?Pkg, parentTypeMeta: !?TypeMeta, failIfMissing: boolean): T

  fromString: ~
}
