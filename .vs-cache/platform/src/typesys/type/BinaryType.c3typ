/**
 * The `binary` value type contains any sequence of bytes (raw data). This should be used only for data that does
 * not have a natural representation as on of the other value types. In particular, text values should always use
 * the {@link StringType string type}.
 *
 * There are no fields (other than #modifier), so this is normally accessed with {@link PrimitiveType#ofBinary}.
 */
type BinaryType mixes PrimitiveType {

  isConvertibleValue: ~
  valueToString:      ~
  valueToJson:        ~ java | py | js
  valueToTypedJson:   ~ java | py | js

  // TODO: PLAT-65943 implement convertValue
  // convertValue: ~ java | py | js
  makeValue: ~ java | py | js

  valueFromJson:   ~ java | py | js
  valueFromString: ~ java | py | js
  valueConverter:  ~
}
