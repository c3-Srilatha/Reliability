/**
 * Options for DSL printing. The defaults implement the standard C3 style, but there is some leeway for varying
 * the printing to match slightly different styles.
 *
 * @see DslWriter
 */
type DslPrintSpec mixes Spec {

  /**
   * The text used for indentation. If this value is set to null, no indentation will be done.
   */
  indent: ?string = "  "

  /**
   * The text used for newline. Cannot be null.
   */
  newline: ?string = "\n"

  /**
   * The text used for a single white space. Cannot be null.
   */
  space: ?string = " "

  /**
   * The maximum width of a line, after which longer lines will wrap to the next. If this value is set to null, no
   * wrapping will be done.
   */
  wrapColumn: int32 = 120

  /**
   * Whether to output multi-word keywords (`schema name`) by replacing the spaces with underscores.
   */
  multiWordKwSnakeCase: boolean

  /**
   * Whether to suppress all comments (including documentation).
   */
  skipComments: boolean

  /**
   * Whether to output non-documentation comments, such as to-do and other internal ones.
   */
  nonDocComments: boolean

  /**
   * Whether to suppress annotations.
   */
  skipAnnotations: boolean
}
