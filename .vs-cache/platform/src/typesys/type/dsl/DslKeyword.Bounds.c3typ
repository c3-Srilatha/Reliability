/**
 * The bounds of a DSL keyword in a line.
 *
 * @see DslKeyword#findKeyword
 */
type DslKeyword.Bounds mixes Result {

  /**
   * The keyword matched.
   */
  keyword: !DslKeyword

  /**
   * The starting character offset (inclusive) in the line, 0-based.
   */
  startOffset: !int

  /**
   * The character offset after the keyword (exclusive) in the line, 0-based.
   */
  endOffset: !int
}
