/**
 * We support two flavors of DSL for declaring types (`.c3typ`) and default UIs (`.c3ui`).
 */
enum type DslLanguage {

  /**
   * `.c3typ` files for declaring types themselves.
   */
  TYPE

  /**
   * `.c3ui` files for declaring default UI for types.
   */
  UI
}
