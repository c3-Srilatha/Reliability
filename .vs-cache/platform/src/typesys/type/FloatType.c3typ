/**
 * The numeric double value type.
 *
 * There are no fields (other than #modifier), so this is normally accessed with {@link PrimitiveType#ofFloat}.
 */
type FloatType mixes NumberType {

  epsilon:        ~
  visitPrimitive: ~

  // TODO: PLAT-41138 Implement in JavaScript and Python
  valueFromString: ~ java

  valueFromJson:     ~ java | py | js
  defaultEmptyValue: ~ java | js | py
  maxValue:          ~
  minValue:          ~
  isSamePredicate:   ~
  valueConverter:    ~
}
