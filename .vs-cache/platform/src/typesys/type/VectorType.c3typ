/**
 * A vector is a fixed-size array of `float`s. This is used for large arrays of numeric values.
 *
 * Vectors are declared in DSL using brackets containing the _size_:
 * ```type
 * samples: [10_000]
 * ```
 *
 * Note that this syntax is similar to the {@link ArrayType array} syntax, but distinct because a literal integer value
 * replaces the element type between the brackets. Vectors are also arrays so all the array operations work on them.
 * The instance type is {@link Vector}, which extends **Array**.
 *
 * Unlike other collection types, vectors will _not_ have a default empty value, so will either be null or have the
 * full set of values. Note that the #size must be positive, so there are no non-null empty vectors.
 *
 * @see Vector
 * @see ArrayType
 */
@beta
type VectorType mixes ArrayType<<!float>> {

  /**
   * The declared size of the vector.
   */
  @dsl(suppress=true)
  size: !int

  /**
   * Create a vector type with the specified size.
   */
  ofSize: function(size: !int): VectorType

  /**
   * Return a vector of all zero values.
   */
  zeroVector: member function(): ![!float] java | js | py-client

  /**
   * Return a vector of all NaN values.
   */
  nanVector: member function(): ![!float] java | js | py-client

  cacheKey:             ~
  convertToJavaRuntime: ~
  convertValue:         ~ java | py
  defaultEmptyValue:    ~ java | js | py-client
  hasDefaultEmptyValue: ~ java | js | py-client
  instanceType:         ~
  isAssignableFrom:     ~
  isEmptyValue:         ~ java | js | py-client
  isSame:               ~ java | js | py-client
  isVector:             ~ java | js | py-client
  of:                   ~ java | js | py
  ofAny:                ~ java | js | py
  ofBinary:             ~ java | js | py
  ofBool:               ~ java | js | py
  ofByte:               ~ java | js | py
  ofDateTime:           ~ java | js | py
  ofDecimal:            ~ java | js | py
  ofDbl:                ~ java | js | py
  ofFloat:              ~ java | js | py
  ofInt:                ~ java | js | py
  ofInt16:              ~ java | js | py
  ofInt32:              ~ java | js | py
  ofJson:               ~ java | js | py
  ofNative:             ~ java | js | py
  ofStr:                ~ java | js | py
  visitCollectionType:  ~
}
