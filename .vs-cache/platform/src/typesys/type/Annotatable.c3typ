/**
 * Metadata objects can be annotated to specify additional behavior or constraints. Annotations are themselves types
 * that mix {@link Annotation} and are marked with `@annotation`.
 *
 * ```c3typ
 * @annotation
 * type Ann.Ser mixes Annotation {
 * ```
 *
 * Annotations are a way of creating custom metadata for purposes not supported directly by the type system itself.
 * For example, the core metadata for a type is maintained as fields of {@link TypeMeta}, but often there are
 * extra things that can be specified about types, and those can be done with annotations.
 *
 * For example, extra information on serialization can be added to a field definition:
 * ```type
 *   @ser(name='type')
 *   kind: string enum WidgetType
 * ```
 *
 * This in effect extends the type system. These annotations can appear in any package.
 *
 * @see Type
 * @see Ann.Annotation
 */
abstract type Annotatable mixes Typesys {

  /**
   * The set of annotations defined on this element of metadata represented as json value.
   */
  // TODO: serialized AnnotationsJson
  annotationsJson: json

  /**
   * Override this method to return the merged set of annotations from itself and its hierarchy
   * E.g.
   * ```type
   *   @config(folder="x")
   *   type A {
   *   }
   *   @config(secret=true)
   *   type B mixes A
   * ```
   * => return config(secret=true, folder="x") for type B
   * If not overridden, by default this returns #annotationJson
   */
  mergedAnnotationsJson: abstract member function(): json

  /**
   * The declared annotations for this metadata element.
   */
  declaredAnnotations: cached member function(): !Annotations

  /**
   * The annotations for this metadata element.
   */
  annotations: cached member function(): !Annotations

  /**
   * Whether this metadata element has any annotation.
   */
  hasAnnotations: member function(): boolean java | js | py

  /**
   * Whether this metadata element has annotation with provided name.
   */
  hasAnnotation: member function(ann: !?string): boolean java | js | py

  /**
   * Whether this metadata element has annotation field value.
   */
  hasAnnotationValue: member function(ann: !?string, annField: !?string): boolean java | js

  /**
   * @return annotation with provided name
   */
  annotation: member function(ann: !?string, failIfMissing: boolean): Annotation java | js

  /**
   * @return annotation value for provided annotation name and annotation field
   */
  annotationValue: member function(ann: !?string, annField: !?string): any java | js | py

  /**
   * Add an annotation to the given metadata
   */
  withAnnotation: member function(ann: !Annotation): !mixing Annotatable

  /**
   * Add an annotation to the given metadata
   * @param ann
   *         annotation to add
   * @param annField
   *         which field on the annotation needs to be set
   * @param value
   *         value for the field
   */
  withAnnotation: member function(ann: !string, annField: string, value: any): !mixing Annotatable

  /**
   * Whether the specified instances have same annotations.
   */
  haveSameAnnotations: function(a1: !?Annotatable, a2: !Annotatable): boolean

  /**
   * Return the JSON for annotations that can be inherited by children of this element of metadata. Annotations are
   * normally inherited, but ones marked with {@link Annotation#noInherit} will not be.
   */
  inheritableAnnotationsJson: member function(): json
}
