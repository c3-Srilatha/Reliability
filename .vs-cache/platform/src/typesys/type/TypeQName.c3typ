/**
 * Parsed representation of C3 Type qualified name; i.e. `package.name`
 *
 * @see TypeMeta
 */
type TypeQName mixes StringSerializable {

  /**
   * The name of the type
   */
  name: !string

  /**
   * The name of the C3 package this type belongs to; note this is not necessarily package where type was originally
   * declared
   */
  package: string

  toString:   ~ java | js
  fromString: ~ java | js
}
