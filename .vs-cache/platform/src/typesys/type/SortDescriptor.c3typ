/**
 * Sort field/column attribute descriptor. This specifies sort ordering in general and of nulls in particular.
 */
type SortDescriptor {

  /**
   * True if the sort is descending. (The default is ascending.)
   */
  descending: boolean

  /**
   * True if nulls sort the opposite of the default of last for ascending and first for descending
   *
   * Note that the sense of #nullsReversed is opposite to {@link Val#compareValues Val's} `nullIsGreater`.
   */
  nullsReversed: boolean
}
