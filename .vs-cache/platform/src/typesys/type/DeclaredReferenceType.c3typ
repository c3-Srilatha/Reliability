type DeclaredReferenceType mixes ReferenceType {

  /**
   * The list of type variable bindings associated with the named type if it is parametric.
   * Reference bindings are expected to be in the same order as the variables declared on the parametric type.
   */
  @dsl(suppress=true)
  refVarBindings: [ValueType]

  /**
   * If the variable reference has a restriction, that will limit the types that can be bound.
   * For example: `type Foo<X: Mammal>` can only be bound to a type that `isA(Mammal)`.
   *
   * @see VarReferenceType#restriction
   */
  restriction: ValueType

  /**
   * If the reference has a _meta_ restriction, that will limit the type of values to which it can be set.
   * Note that this sort of restriction is on the type of the value itself, not on its generic bindings.
   * For example: `Type<<Mammal>>` reference instances can only be sub types of `Mammal`.
   *
   * @see TypeMeta#metaRestriction
   */
  metaRestriction: ValueType

  /**
   * Whether this reference has generic variable bindings. This may not make the reference type fully bound if some of
   * the bindings are to variables.
   */
  hasRefVarBindings: member function(): boolean

  /**
   * Look up the referenced C3 type and return it. For unbound variables or invalid type references, null is returned.
   *
   * @return loaded type
   */
  dereferenceMeta: member function(scope: !TypesysScope,
                                   bindAll: !boolean,
                                   failIfMissing: !boolean): TypeMeta java | js

  dereferenceMeta:       ~ java | js
  dereference:           ~ java | js | py
  build:                 ~
  isBuilt:               ~
  buildReferenceType:    ~
  buildVarReferenceType: ~
  prototypeName:         ~
  cacheKey:              ~
  fromTypeMeta:          ~
  fromString:            ~
}
