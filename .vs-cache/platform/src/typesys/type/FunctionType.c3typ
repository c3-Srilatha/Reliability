/**
 * A function is the declaration of a calling signature without an implementation. It represents an interface that can
 * be called from any language and implemented by a {@link MethodType method} or {@link LambdaType lambda}. It is not
 * bound to a type, nor does it necessarily have an implementation.
 *
 * The main information is the set of arguments and the return type, defining the function signature or contract.
 * Parameters are {@link FunctionParam} instances and the return value is a {@link ValueType value type}.
 *
 * Parameters have both names and positions.  Language bindings use the natural convention for function calling.
 * Java and JavaScript use position calling and Python using named arguments.
 *
 * Functions are declared using the "function" keyword with the parameters in parenthesis and the return value at the
 * end.  For example the typical "pow" function:
 * ```
 * function(base: double, exponent: double): double
 * ```
 *
 * Parameters can be declared as non empty by preceding the name with an exclamation point. This will prevent the
 * function from being called without a specified value so the implementation does not need to validate it. Similarly,
 * the return value can be marked as non empty which indicates that the function must return an actual value (or throw
 * an error).
 * ```
 * function(base: !double, exponent: !double): !double
 * ```
 *
 * Collections and boolean are assumed to be "non optional"; if no value is specified an empty collection of the
 * appropriate type is passed and unspecified boolean parameters are false. This helps simplify the implementation by
 * removing the necessity for extra checks.
 *
 * Function parameters can have default values.  If a parameter is declared with "`=` *value*", that indicates the
 * declared value will be used if the parameter is not specified.
 * ```
 * function(loudness: int = 5)
 * ```
 * This indicates a function which will pass the value `5` to the parameter loudness if the caller does not specify a
 * value.
 *
 * Functions can take variable numbers of arguments.  If the last parameter is declared with `...`, zero or more
 * arguments of that type are allowed. The receiver will get an array of that type (which may be empty). The typical
 * "format" function takes a string plus zero or more values of any type:
 * ```
 * function(template: !string, values: any ...)
 * ```
 * In this case, the implementation will receive two actual arguments: template and values. The values parameter will
 * be an array of zero or more objects to plug into the template.
 *
 * Member functions are methods where the first implicit parameter is of the containing type and is named "this":
 * ```type
 * type Cat {
 *   meow: member function(loudness: int)
 * }
 * ```
 * Note that the "this" parameter is implicit, and comes from the `member` declaration. This matches many
 * object-oriented languages that have a concept of an implicit instance on which a method is called.
 *
 * ```js
 * function meow(loudness) {
 *   // this is the instance of Cat
 * }
 * ```
 *
 * ```py
 * def meow(this, loudness):
 *   # this is the instance of Cat
 * ```
 *
 * @see MethodType
 * @see LambdaType
 * @see FunctionParam
 */
type FunctionType mixes ValueType, Generic {

  /**
   * The list of variable declarations and any restrictions on them.
   */
  genericVars: [VarReferenceType]

  /**
   * The formal parameters accepted by this function.
   */
  @dsl(suppress=true)
  params: [FunctionParam]

  /**
   * An ordered list of parameter names.
   */
  paramNames: cached member function(): [string]

  /**
   * The return type of the function.
   */
  @dsl(suppress=true)
  returnType: ValueType

  /**
   * If this function is not a "pure" function of its arguments, it should be marked as such. A stateful function
   * return value cannot be cached. For example it is not valid to call it using HTTP GET. By default, it is assumed
   * all functions are pure (state and side-effect free).
   */
  stateful: boolean

  /**
   * Get the single formal parameter by name.
   *
   * @param name parameter name
   */
  param: member function(param: !string, failIfMissing: boolean): FunctionParam

  /**
   * Whether the function has the named formal parameter.
   *
   * @param name parameter name
   */
  hasParam: member function(param: !string): boolean

  /**
   * Get the single formal parameter by index.
   *
   * @param i parameter index
   */
  paramAt: member function(paramIndex: !int32, failIfMissing: boolean): FunctionParam

  /**
   * Get the canonical number of arguments. Note that varargs functions may accept more arguments than this, but they
   * will be collected into the last argument array.
   *
   * @return number of parameters
   */
  paramCount: member function(): !int32

  /**
   * Get the minimum number of arguments for a valid call. This counts parameters with modifier `!` or `!?` and no
   * default value.
   *
   * @return number of non-optional parameters
   */
  nonOptionalParamCount: member function(): !int32

  /**
   * Get the index of the specified parameter by name. If not found, this returns -1, unless the failIfMissing
   * argument is specified.
   *
   * @param param parameter name to find
   * @param failIfMissing throw error instead of returning -1 if not found
   * @return 0-based index of parameter
   */
  paramIndex: member function(param: !string, failIfMissing: boolean): !int32

  /**
   * Get the index of the specified parameter instance. If not found, this returns -1, unless the failIfMissing
   * argument is specified.
   *
   * @param param parameter instance to find
   * @param failIfMissing throw error instead of returning -1 if not found
   * @return 0-based index of parameter
   */
  paramIndex: member function(param: !FunctionParam, failIfMissing: boolean): !int32

  /**
   * @return index of the only kwargs parameter, typically a Spec.
   */
  kwargsParamIndex: private cached property(): int32

  /**
   * Get the type of a single parameter value by name.
   * @param name parameter name
   * @return parameter value type
   */
  paramType: member function(param: !string, failIfMissing: boolean): ValueType

  /**
   * Get the type of a single parameter value type by index.
   * @param name parameter name
   * @return parameter value type
   */
  paramTypeAt: member function(paramIndex: !int32, failIfMissing: boolean): ValueType

  /**
   * @return list of parameter value types in the declaration order
   */
  paramTypes: member function(): [ValueType]

  /**
   * @return true if the function has a streamable parameter; this is typically only parameter that can stream values
   */
  hasStreamableParam: member function(): boolean

  /**
   * @param withoutDefault whether to apply default for parameter {@link FunctionParam#convertAndValidateArg}
   * @return converted value based on parameter type
   */
  convertArg: member function<T>(param: !string, v: native, failIfInvalid: boolean, withoutDefault: boolean): T

  /**
   * @param withoutDefault whether to apply default for parameter {@link FunctionParam#convertAndValidateArg}
   * @return converted value based on parameter type
   */
  convertArgAt: member function<T>(paramIndex: !int32, v: native, failIfInvalid: boolean, withoutDefault: boolean): T

  /**
   * @return converted values based on parameter types; note if value is not convertible replaces it to `null`
   */
  convertArgs: member function<T>(args: [any], kwargs: map<string, any>, failIfInvalid: boolean): [any]

  /**
   * Get the default value of a single parameter by name.
   *
   * @param name parameter name
   * @return argument default value
   */
  paramDefaultValue: member function(param: !string): any

  /**
   * Whether the provided parameter has a default value.
   *
   * @param name parameter name
   * @return has default or not
   */
  paramHasDefault: member function(param: !string): boolean

  /**
   * Whether the parameter with the provided name is non empty.
   *
   * @param name name of the argument
   */
  paramIsNonEmpty: member function(param: !string): boolean

  /**
   * Whether the parameter can be omitted. Note that param may not be non empty but may be not be optional either. i.e.
   * declared using `!?`.  Also if parameter has a default value then it is always optional.
   *
   * @param name name of the argument
   */
  paramIsOptional: member function(param: !string): boolean

  /**
   * Produces the list of non empty arguments on this method.
   *
   * @return list of non empty arguments
   */
  nonEmptyParams: cached member function(): [FunctionParam]

  /**
   * Produces the list of names non empty arguments on this method.
   *
   * @return list of non empty parameter names
   */
  nonEmptyParamNames: member function(): [string]

  /**
   * Whether or not the function has no return value.
   * @return true if void function
   */
  returnsVoid: member function(): boolean

  /**
   * Whether a return value will always be non empty.
   */
  returnIsNonEmpty: member function(): boolean

  /**
   * @return true if the function returns a stream of values
   */
  returnIsStreamable: member function(): boolean

  /**
   * Whether the last argument allows multiple values.
   */
  isVarArgs: cached member function(): boolean java | py

  /**
   * Whether or not there are any unbound generic variables in this instance.
   */
  isGeneric: member function(): boolean

  /**
   * Whether or not this is a match-anything function signature: `function(args: any ...): any`.
   */
  isAnySignature: member function(): boolean

  /**
   * Calculates "distance" between parameters of this function and provided argument types:
   * * 0 - means exact match as far as number of and value types of arguments vs parameters
   * * _positive integer_ - means that it is possible to convert all arguments - lower number means fewer conversions
   * * -1 - means totally incompatible call
   *
   * @see argsDistance
   * @see ValueType#distance
   * @see ValueType#valueDistance
   */
  argTypesDistance: member function(argTypes: !?[ValueType]): !int32

  /**
   * Calculates "distance" between parameters of this function and provided argument types:
   * * 0 - means exact match as far as number of and value types of arguments vs parameters
   * * _positive integer_ - means that it is possible to convert all arguments - lower number means fewer conversions
   * * -1 - means totally incompatible call
   *
   * @see argsDistance
   * @see ValueType#distance
   * @see ValueType#valueDistance
   */
  argTypesDistance: member function(argTypes: !?map<string, ValueType>): !int32

  /**
   * Calculates "distance" between parameters of this function and provided argument values:
   * * 0 - means exact match as far as number of and value types of arguments vs parameters
   * * _positive integer_ - means that it is possible to convert all arguments - lower number means fewer conversions
   * * -1 - means totally incompatible call
   *
   * @see argTypesDistance
   * @see ValueType#distance
   * @see ValueType#valueDistance
   */
  argsDistance: member function(args: !?[native]): !int32

  /**
   * Calculates "distance" between parameters of this function and provided argument values:
   * * 0 - means exact match as far as number of and value types of arguments vs parameters
   * * _positive integer_ - means that it is possible to convert all arguments - lower number means fewer conversions
   * * -1 - means totally incompatible call
   *
   * @see argTypesDistance
   * @see ValueType#distance
   * @see ValueType#valueDistance
   */
  argsDistance: member function(args: !?map<string, native>): !int32

  /**
   * Calculates "distance" between parameters of this function and provided argument values:
   * * 0 - means exact match as far as number of and value types of arguments vs parameters
   * * _positive integer_ - means that it is possible to convert all arguments - lower number means fewer conversions
   * * -1 - means totally incompatible call
   *
   * @see argTypesDistance
   * @see ValueType#distance
   * @see ValueType#valueDistance
   */
  argsDistance: member function(args: !?[any], kwargs: !?map<string, any>): !int32

  /**
   * Converts map of arguments to array of arguments where position of arg in result matches position of the
   * corresponding parameter. If input contains key that does not match any parameter then returns `null` or throws
   * exception based on `failOnExtra`. If input is missing a parameter put `null` at corresponding index i.e. resulting
   * array size always matches parameter count.
   *
   * @return null if extra arguments otherwise positionally mapped array of arguments
   */
  argsMapToArray: member function(args: !?map<string, any>, failOnExtra: boolean): ?[?any]

  /**
   * Converts map of argument types to array of argument types where position of arg in result matches position of the
   * corresponding parameter. If input contains key that does not match any parameter then returns `null` or throws
   * exception based on `failOnExtra`. If input is missing a parameter put `null` at corresponding index i.e. resulting
   * array size always matches parameter count.
   */
  argTypesMapToArray: member function(args: !?map<string, ValueType>): ?[?ValueType]

  /**
   * Combines positional args and keyword args into a single array of arguments in which the position of arg in result
   * matches position of the corresponding keyword args and the relative order of positional args. Note that if there's
   * any parameter that can be passed as kwargs param, the fields for that kwargs param will be rolled up into one
   * object and passed as one argument.
   * If input contains key that does not match any parameter or conflicts with the positional args, then returns `null`
   * or throws exception based on `failOnExtra`. If input is missing a parameter put `null` at corresponding index i.e.
   * resulting array size always matches parameter count.
   */
  mergeArgs: member function(args: !?[any], kwargs: !?map<string, any>, failOnExtra: boolean): ?[?any]

  /**
   * Checks if this function shadows i.e. has same parameters not considering all optional ones as provided function.
   */
  shadows: member function(other: !?FunctionType): boolean

  /**
   * Merge other function type into this one by merging params and return type.
   */
  mergeFunctionType: member function(other: !?FunctionType): !FunctionType

  /**
   * Determine the function signature of the specified functional value. If the value is not a lambda or other
   * callable instance, null is returned.
   *
   * @param failIfNot if true, throw an exception instead of returning null
   */
  extractSignature: function(value: !?any, failIfNot: boolean): FunctionType

  /**
   * Determine whether the specified function has exactly the same parameter value types as this one. It does not
   * consider parameter names, nor does it consider the return type. This is useful when matching calling signatures
   * for overload references, but not the same as callability matching such as {@link Method#findOverloadForArgTypes}.
   */
  isSameParamTypes: member function(other: !?FunctionType): boolean

  /**
   * Uses {@link ValueType#javaJType} along with the provided spec to return an array of native JavaTypes corresponding
   * to this FunctionType's parameters. This is used when code-genning types to ensure that no overloads of a method
   * will have a signature clash; see TypeCodeInterface.java
   */
  paramJavaJTypes: private member function(spec: @java(class=c3.platform.typesys.type.JTypeSpec) native)
                                    : [@java(class='c3.platform.java.model.JavaType') native]

  isA:                ~(other: ValueType) java | js
  isEmptyValue:       ~ java | js | py
  isSame:             ~(other: !ValueType) java | js
  bindAllGenericVars: ~
  visit:              ~
}
