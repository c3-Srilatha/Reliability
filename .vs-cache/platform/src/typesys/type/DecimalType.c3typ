/**
 * The decimal number value type. This is an arbitrary precision decimal number that supports only exact arithmetic.
 * It is not available in all languages. Note that `decimal` values will be significantly slower than IEEE floating
 * point values that have hardware support.
 *
 * There are no fields (other than #modifier), so this is normally accessed with {@link PrimitiveType#ofDecimal}.
 *
 * @see DoubleType
 * @see BigIntType
 */
type DecimalType mixes NumberType {

  epsilon:        ~
  visitPrimitive: ~

  // TODO: PLAT-41138 Implement in JavaScript and Python
  valueFromString: ~ java

  valueFromJson:     ~ java | py | js
  defaultEmptyValue: ~ java | js | py
  maxValue:          ~
  minValue:          ~
  isSamePredicate:   ~
  valueConverter:    ~
}
