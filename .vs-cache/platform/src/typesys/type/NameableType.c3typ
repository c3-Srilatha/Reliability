/**
 * Represents a type system type with name.
 */
abstract private type NameableType mixes Annotatable, Documentable, Nameable, Fingerprinted {

  /**
   * @return identifier that can safely be used in the code for provided language
   */
  identifier: member function(lang: string serialized ImplLanguage): !string
}
