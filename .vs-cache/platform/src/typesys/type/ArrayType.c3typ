/**
 * An array is a vector of a single value type, accessed by index. Null values and duplicates are allowed.
 *
 * Arrays are declared in DSL using bracket notation:
 *
 * ```type
 * // zero or more primitive integers
 * counts: [int]
 *
 * // Cat objects or any type that mixes Cat, or nulls
 * herd: [Cat]
 * ```
 *
 * Instances can be created programmatically using these convenience methods:
 *  - #of
 *  - #ofAny
 *  - #ofBinary
 *  - #ofBool
 *  - #ofByte
 *  - #ofDateTime
 *  - #ofDecimal
 *  - #ofDbl
 *  - #ofFloat
 *  - #ofInt
 *  - #ofInt16
 *  - #ofInt32
 *  - #ofJson
 *  - #ofNative
 *  - #ofStr
 *
 * @see Array
 */
type ArrayType mixes CollectionType {

  /**
   * @return collection built by provided lambda
   */
  buildArray: member function<E>(builder: !lambda(b: !ArrayBuilder<E>)): [E] java | js | py

  /**
   * @return builder of array of this type.
   */
  makeBuilder: member function<E>(initial: [E]): !ArrayBuilder<E> java | js | py

  /**
   * @return builder of array of this type.
   */
  makeBuilder: member function<E>(size: !int): !ArrayBuilder<E> java | js | py

  /**
   * @return instance of array of this type from provided elements.
   */
  makeArray: member function<E>(elements: E ...): [E] java | py | js

  /**
   * @return instance of empty array of this type.
   */
  emptyArray: member function<E>(): [E] java | js | py

  /**
   * @return {@link #emptyArray}
   */
  emptyCollection: ~ java | js | py

  /**
   * @return true if instance should use specialized java primitive array; e.g. `[!double]` or `[boolean]`
   */
  isJavaPrimitiveArray: cached member function(): boolean

  /**
   * @return cached instance of `[!double]`
   */
  ofNonEmptyDbl: cached function(): !ArrayType

  /**
   * @return cached instance of `[!int]`
   */
  ofNonEmptyInt: cached function(): !ArrayType

  isAnyCollection:      ~ java | js | py
  isArray:              ~ java | js | py
  isIndexed:            ~ java | js | py
  of:                   ~ java | js | py
  ofAny:                ~ java | js | py
  ofBinary:             ~ java | js | py
  ofBool:               ~ java | js | py
  ofByte:               ~ java | js | py
  ofDateTime:           ~ java | js | py
  ofDecimal:            ~ java | js | py
  ofDbl:                ~ java | js | py
  ofFloat:              ~ java | js | py
  ofInt:                ~ java | js | py
  ofInt16:              ~ java | js | py
  ofInt32:              ~ java | js | py
  ofJson:               ~ java | js | py
  ofNative:             ~ java | js | py
  ofStr:                ~ java | js | py
  instanceType:         ~
  convertToJavaRuntime: ~
  cacheKey:             ~
  convertValue:         ~ java | py
  hasDefaultEmptyValue: ~
  defaultEmptyValue:    ~ java | js | py
  valueFromJson:        ~ java | js | py
}
