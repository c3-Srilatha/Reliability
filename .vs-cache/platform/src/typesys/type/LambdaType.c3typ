/**
 * Value type for `lambda` i.e. function as a value. The structure of the lambda signature comes from
 * {@link FunctionType}. The implementation carried as data is what makes it a **lambda**.
 *
 * Note that lambdas are _data values_ and thus a type field declared as a lambda is not defined by that type itself,
 * but will be a data field (with a {@link FieldType}). The field value may be null or may be supplied with a
 * lambda instance.
 *
 * ```type
 * type X {
 *   method: member function(a: !int): !int
 *   lambda: lambda(a: !int): !int
 * }
 * ```
 *
 * In the example above, **method** and **lambda** are both declared in the type, however, they are treated differently
 * because the first one is a {@link Method} and the second is a lambda. Instances of the Obj will have only a single
 * field, for **lambda**, and it will only be set if there is a value supplied. All instances will share the same
 * **method** and it will be implemented on the type itself.
 *
 * ```js
 * let x = X.make({ lambda: a => a * 2 })
 * x.method(3)
 * x.lambda(3)
 * ```
 *
 * ```py
 * x = c3.X(lambda_ = lambda a: a * 2)
 * x.method(3)
 * x.lambda(3)
 * ```
 *
 * So in the above examples, both end up being callable from the instances, but the method implementation goes with
 * the type while the lambda implementation is a field value that goes with the instance.
 *
 * ```java
 * X x = X.builder().lambda(a -> a * 2).build();
 * x.method(3);
 * x.lambda().apply(3);
 * ```
 *
 * In Java, the lambdas are strongly typed (using the
 * [FunctionalInterface](https://docs.oracle.com/javase/8/docs/api/java/lang/FunctionalInterface.html) annotation),
 * so must be invoked using the correct method name. `apply` is appropriate here since this lambda will be a
 * [Function<Long, Long>](https://docs.oracle.com/javase/8/docs/api/java/util/function/Function.html).
 *
 * @see MethodType
 * @see methods.c3doc#lambdas
 */
type LambdaType mixes FunctionType {

  /**
   * @return true if this lambda can be represented as Java Functional Interface.
   */
  isJavaNative: member function(): boolean

  /**
   * Create a consumer lambda type that takes zero or more parameters.
   */
  consumer: function(params: ValueType ...): !LambdaType

  /**
   * Create a function lambda type that takes zero or more parameters and returns a value. The last argument
   * to this function becomes the return type.
   */
  function: function(paramsAndRet: ValueType ...): !LambdaType

  /**
   * Create a predicate lambda type that takes zero or more parameters and returns a boolean value.
   */
  predicate: function(params: ValueType ...): !LambdaType

  /**
   * Create a supplier lambda type that takes no parameters and returns a value. The argument to this function becomes
   * the return type.
   */
  supplier: function(ret: !ValueType): !LambdaType

  /**
   * lambda(any, any)
   */
  biConsumerOfAny: cached function(): !LambdaType

  /**
   * lambda(any, any): any
   */
  biFunctionOfAny: cached function(): !LambdaType

  /**
   * lambda(any, any): boolean
   */
  biPredicateOfAny: cached function(): !LambdaType

  /**
   * lambda(): any
   */
  callableOfAny: cached function(): !LambdaType

  /**
   * lambda(any)
   */
  consumerOfAny: cached function(): !LambdaType

  /**
   * lambda(any): any
   */
  functionOfAny: cached function(): !LambdaType

  /**
   * lambda(any): boolean
   */
  predicateOfAny: cached function(): !LambdaType

  /**
   * lambda(any, any, any, any)
   */
  quadConsumerOfAny: cached function(): !LambdaType

  /**
   * lambda(any, any, any, any): any
   */
  quadFunctionOfAny: cached function(): !LambdaType

  /**
   * lambda(any, any, any, any): boolean
   */
  quadPredicateOfAny: cached function(): !LambdaType

  /**
   * lambda()
   */
  runnable: cached function(): !LambdaType

  /**
   * lambda(): any
   */
  supplierOfAny: cached function(): !LambdaType

  /**
   * lambda(any, any, any)
   */
  triConsumerOfAny: cached function(): !LambdaType

  /**
   * lambda(any, any, any): any
   */
  triFunctionOfAny: cached function(): !LambdaType

  /**
   * lambda(any, any, any): boolean
   */
  triPredicateOfAny: cached function(): !LambdaType

  visit:       ~
  javaClass:   ~
  javaJType:   ~
  isSameValue: ~ java | js | py

  @call(stayInEngine=true)
  isAssignableValue: ~ java | js | py

  isConvertibleValue:  ~ java
  isConvertibleFrom:   ~
  convertValue:        ~
  isPersistSerialized: ~
  serializedValueType: ~

  @call(stayInEngine=true)
  valueFromJson: ~ java | js | py

  @call(stayInEngine=true)
  valueFromString: ~

  @call(stayInEngine=true)
  valueToJson: ~ java | js | py

  @call(stayInEngine=true)
  valueToTypedJson: ~ java | js | py

  @call(stayInEngine=true)
  makeValue: ~ java | js | py

  @call(stayInEngine=true)
  guessType: ~ js | py

  guessTypeFromJavaClass: ~: LambdaType
  ofAnyFunction:          cached function(): !LambdaType
  valueConverter:         ~

  /**
   * @return a list of the possible `LambdaConverter` for native java lambdas for this LambdaType.
   */
  nativeJavaLambdaConverters: private cached member function()
                                                      : @java(class='java.util.List<c3.platform.typesys.type.LambdaConverter>') native
}
