type TypeDeepRef mixes TagRef {

  /**
   * Construct from type/tenant/tag
   *
   * @param TypeRef
   *           Type to construct ref for
   * @param tenantName
   *           Tenant name to construct ref for.  If null, the tenant for the current context will be used.
   * @param tagName
   *           Tag name to construct ref for.  If null, the tag for the current context will be used.
   *
   * @return the requested ref
   */
  fromTypeAndTag: function(type: !Type, tenantName: string, tagName: string): TypeDeepRef

  typeName: !string
}
