/**
 * Base marker type for all type-system elements that can be referenced via simple string in a given root C3 package.
 *
 * @see Typesys.Ref
 */
final private type Typesys.WithRef mixes WithRef, Value {

  toRef:   abstract ~: !Typesys.Ref
  fromRef: abstract ~
  refType: abstract ~
}
