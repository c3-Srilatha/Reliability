/**
 * Ref value to FieldType or Method.
 *
 * This has the string representation of the parent type name and the field or method separated by a hash mark:
 * "Duration#fromString". This is the same format used for documentation references.
 *
 * In addition, if #declaredNativeRequirement exists, that will be appended after a space:
 * "Duration#fromString js-client".
 */
inline type FieldTypeAndMethodRef mixes Typesys.Ref {

  /**
   * Parent type of this FieldType or Method.
   */
  parentType: !string serialized Type

  /**
   * Parent type of this FieldType or Method.
   */
  parentTypeMeta: member function(pkg: Pkg): !TypeMeta

  /**
   * Name of the Field Type or Method.
   */
  name: !string

  /**
   * Name of the {@Link Action.Requirement} if this field or method was declared on a native remix.
   */
  declaredNativeRequirement: string serialized Action.Requirement
}
