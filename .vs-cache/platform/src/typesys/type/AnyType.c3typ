/**
 * The "any" value type indicates that any value at all may be used.
 *
 * It is declared in DSL simply as `any`.
 *
 * Note that any is not the same as "Obj": any represents *any* possible value type while Obj indicates a reference
 * type that can contain instances of all declared types. For example, primitive value types and collections are not
 * Objs, but they are `any`.
 *
 * Like all other value types, `any` is also assignable to `native` (since every type has a native representation).
 * However, not all `native` values are `any`; those values not of known C3 types are `native`, but not `any`.
 *
 * Values declared as `any` implicitly preserve empty values. In other words, a null collection value passed to a
 * context expecting `any` will not result in an empty collection being instantiated. It is up to the consumer to
 * handle any reasonable value or throw an error otherwise.
 *
 * @see Obj
 * @see Type
 * @see ReferenceType
 */
type AnyType mixes ValueType, Singleton {

  isA:                 ~(other: ValueType) java | js | py
  isEmptyValue:        ~ java | js | py
  inst:                ~
  makeValue:           ~ java | py | js
  convertValue:        ~ java | py
  valueConverter:      ~
  valueToJson:         ~ java | py | js
  valueToTypedJson:    ~ java | py | js
  valueFromJson:       ~ java | py | js
  isPersistSerialized: ~
  serializedValueType: ~
  toString:            ~ java | js | py
}
