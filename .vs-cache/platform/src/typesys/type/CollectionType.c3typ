/**
 * "Collection type" is the base type for all specific collection value types: array, set, map and stream.
 *
 * Collections all share the behavior of holding elements of a single value type.
 *
 * - An {@link ArrayType array} is a collection whose elements are ordered and are accessed by index.
 *   Arrays allow nulls or duplicates.
 * - A {@link SetType set} is a special array which does not allow nulls and duplicates.
 *   Like arrays, sets are also ordered and accessed by index.
 * - A {@link MapType map} is an associative array of elements.  The key can be any primitive value type,
 *   although most maps are indexed by strings.
 * - A {@link StreamType stream} is a read-once collection.  Streams may be arbitrarily large, larger than can fit into
 *   memory at any one time, so care should be taken not to materialize them all at once.
 *
 * For programming convenience, instances of collections use underlying language binding facilities where appropriate:
 * - In Java, arrays (and sets) implement the java.util.List interface and map collections implement Map.
 * - In JavaScript, arrays and sets extend Array and maps are objects.
 * - In Python, arrays and sets are lists and maps are dictionaries.
 *
 * It is also possible to declare _any collection_ using the `collection<..>` syntax. This refers to any collection
 * type and specifies only the element type. Instances of any of the concrete collection types are allowed (as long as
 * the element type is compatible).
 *
 * @see ArrayType
 * @see SetType
 * @see MapType
 * @see StreamType
 */
type CollectionType mixes ValueType {

  /**
   * The value type for the keys that index the collection.
   * For array and set, the key is `int` and for stream is the key is not used.
   * For maps, the key can be any primitive type.
   */
  keyType: ValueType

  /**
   * The value type for the elements of the collection.
   */
  elementType: !ValueType

  /**
   * If this collection was declared using the `collection` syntax, instances could be any collection (array, map, set
   * or stream).
   */
  isAnyCollection: member function(): boolean java | js | py

  /**
   * Whether the collection enforces unique values.
   */
  isUnique: cached member function(): boolean

  /**
   * Whether the collection maintains its elements in insertion order. This is true by default for
   * {@link ArrayType arrays} and {@link StreamType streams}, but not other collection types for performance reasons.
   * This can be enabled using the {@link Ann.Indexed @indexed} annotation.
   */
  isIndexed: cached member function(): boolean java | js

  /**
   * Whether the collection maintains its elements in sorted order. This is false by default for all collections for
   * performance reasons, but can be enabled using the {@link Ann.Sorted @sorted} annotation.
   */
  isSorted: cached member function(): boolean

  /**
   * @return this collection type but with preserving of insertion order
   */
  index: cached member function(): !mixing CollectionType

  /**
   * @return this collection type but with sorted elements
   */
  sort: cached member function(): !mixing CollectionType

  /**
   * @return this collection type but with duplicate elements discarded
   */
  unique: cached member function(): !mixing CollectionType

  /**
   * @return true if this map can have null keys
   */
  hasNullKeys: cached member function(): boolean

  /**
   * @return true if this collection can have null elements
   */
  hasNullElements: cached member function(): boolean

  /**
   * @return the factory method name for this collection type (e.g., "ofInt", "ofStr", "ofDbl") using the type (e.g., ArrayType).
   */
  factoryMethodName: ~

  /**
   * @param instanceType
   *        if true, returns the method name for factory method invocation on an instance type (e.g., for `Array.ofInt()`
   *        vs for `ArrayType.ofInt()`)
   * @return the factory method name for this collection type (e.g., "ofInt", "ofStr", "ofDbl").
   */
  factoryMethodName: member function(instanceType: !?boolean): !string

  /**
   * @return a code expression that instantiates this collection type (e.g., "ArrayType.ofStr()", "Array.ofInt()").
   */
  factoryMethodExpr: ~

  /**
   * @param instanceType
   *        if true, use instance type for the expression (e.g., Array vs ArrayType)
   * @return a code expression that instantiates this collection type (e.g., "ArrayType.ofStr()", "Array.ofInt()").
   */
  factoryMethodExpr: member function(instanceType: !?boolean): !string

  /**
   * @return {@link CollectionType} of specified element type
   */
  of: function(elementType: !ValueType): !mixing CollectionType java | js | py

  /**
   * @return {@link CollectionType} of any elements
   */
  ofAny: cached function(): !mixing CollectionType java | js | py

  /**
   * @return {@link CollectionType} of binary elements
   */
  ofBinary: cached function(): !mixing CollectionType java | js | py

  /**
   * @return {@link CollectionType} of boolean elements
   */
  ofBool: cached function(): !mixing CollectionType java | js | py

  /**
   * @return {@link CollectionType} of byte elements
   */
  ofByte: cached function(): !mixing CollectionType java | js | py

  /**
   * @return {@link CollectionType} of datetime elements
   */
  ofDateTime: cached function(): !mixing CollectionType java | js | py

  /**
   * @return {@link CollectionType} of decimal elements
   */
  ofDecimal: cached function(): !mixing CollectionType java | js | py

  /**
   * @return {@link CollectionType} of float elements
   */
  ofDbl: cached function(): !mixing CollectionType java | js | py

  /**
   * @return {@link CollectionType} of float elements
   */
  ofFloat: cached function(): !mixing CollectionType java | js | py

  /**
   * @return {@link CollectionType} of 64 bit int elements
   */
  ofInt: cached function(): !mixing CollectionType java | js | py

  /**
   * @return {@link CollectionType} of 32 bit int elements
   */
  ofInt32: cached function(): !mixing CollectionType java | js | py

  /**
   * @return {@link CollectionType} of 16 bit int elements
   */
  ofInt16: cached function(): !mixing CollectionType java | js | py

  /**
   * @return {@link CollectionType} of json elements
   */
  ofJson: cached function(): !mixing CollectionType java | js | py

  /**
   * @return {@link CollectionType} of native elements
   */
  ofNative: cached function(): !mixing CollectionType java | js | py

  /**
   * @return {@link CollectionType} of string elements
   */
  ofStr: cached function(): !mixing CollectionType java | js | py

  /**
   * @return array type of elements of this collection
   */
  toArrayType: cached member function(): !ArrayType

  /**
   * @return array type of elements of this collection with new elementType
   */
  toArrayType: member function(elementType: !ValueType): !ArrayType

  /**
   * @return default set type of elements of this collection
   */
  toSetType: cached member function(): !SetType

  /**
   * @return default set type of elements of this collection with new elementType
   */
  toSetType: member function(elementType: !ValueType): !SetType

  /**
   * @return map type of elements of this collection
   */
  toMapType: cached member function(): !MapType

  /**
   * @return map type of elements of this collection with new elementType
   */
  toMapType: member function(elementType: !ValueType): !MapType

  /**
   * @return map type of elements of this collection with new elementType and keyType
   */
  toMapType: member function(keyType: !ValueType, elementType: !ValueType): !MapType

  /**
   * @return stream type of elements of this collection
   */
  toStreamType: cached member function(): !StreamType

  /**
   * @return stream type of elements of this collection with new elementType
   */
  toStreamType: member function(elementType: !ValueType): !StreamType

  /**
   * @return collection built by provided lambda
   */
  buildCollection: member function<E>(builder: lambda(b: !CollectionBuilder<E>)): Collection<E> java | js

  /**
   * @return collection of this type with provided elements
   */
  makeCollection: abstract member function<E>(elements: E ...): Collection<E>

  /**
   * @return collection builder of this type with initial elements
   */
  makeCollectionBuilder: abstract member function<E>(initial: Collection<E>): CollectionBuilder<E>

  /**
   * @return collection builder of this type with initial size allocation
   */
  makeCollectionBuilder: abstract member function<E>(size: !int): CollectionBuilder<E>

  /**
   * Calls specific method on collection type visitor based on instance of this collection type.
   */
  visitCollectionType: abstract member function<T>(visitor: @java(class='c3.platform.typesys.type.ValueTypeVisitor.CollectionVisitor<T>') !native)
                                         : T

  /**
   * Guesses type from C3 Collection (i.e. c3.platform.typesys.value.Array -> ArrayType.ofAny()). Gives back collection types
   * parameterized with values of AnyType since Java classes are not bound to any parameters at runtime.
   */
  guessTypeFromJavaClass: ~: CollectionType

  /**
   * Guess the corresponding C3 CollectionType from Python class
   */
  guessTypeFromPythonClass: ~: CollectionType py

  /**
   * @return an empty collection (i.e. a collection containing no elements) of this CollectionType
   */
  emptyCollection: abstract member function<E>(): Collection<E>

  visit:              ~
  build:              ~
  isBuilt:            ~
  javaClass:          ~
  javaJType:          ~
  hasReference:       ~
  dereferenceMeta:    ~ java | js
  isSame:             ~
  isSameValue:        ~ java | js
  isEmptyValue:       ~ java | js | py
  isA:                ~(other: ValueType) java | js | py
  isAssignableFrom:   ~ java | js
  isAssignableValue:  ~ java | js
  isConvertibleFrom:  ~
  isConvertibleValue: ~

  // isGeneric: ~
  hasAnyMixing: ~

  hasVarReference:      ~
  guessType:            ~: CollectionType java | js | py
  guessConvertibleType: ~ java | js | py
  needsValueBoxing:     ~
  valueToString:        ~
  valueToTypedJson:     ~ java | js | py
  valueToJson:          ~ java | js | py
  valueFromJson:        ~ java | py | js
  compareValues:        ~
  makeValue:            ~ java | js | py-client
  valueFromString:      ~
  bindAllGenericVars:   ~
  initialValue:         ~
  dataFieldTypeNames:   ~
  toString:             ~ java | js | py
}
