/**
 * An "any-of" value type means a list of alternates, any of which are allowed. For example,
 * `NormTimeseriesDouble | double` indicates that either a double timeseries (vector) or single double (scalar) are
 * allowed. This is also known as a "union type".
 *
 * The list of possible value types for an anyof are called its "restrictions". These restrictions must be unique
 * from an assignability test. For example `int | number` is invalid because `int` is assignable to `number`.
 * However, `int | string` _is_ value because neither is assignable to the other (although both are convertible).
 * For the same reason, `any` and `native` are not allowed as restrictions.
 *
 * If a value being applied to an anyof field could match multiple restrictions, the most natural one is tried first and
 * then explicit conversion is tried in order (see #isA and #convertValue).
 *
 * For example, `int | string`:
 *   * `"4"` will match `string`, since its natural type is string
 *   * `4` will match `int` since its natural type is int
 *   * `4.1` converts to `int` (by truncation)
 *   * `4.1` also converts to `string` (toString)
 *
 * This means it is best to specify the restrictions from most- to least-specific in the declaration.
 *
 * Any-of restrictions can also be declared and reused as {@link Union union types}.
 */
type AnyOfType mixes ValueType {

  /**
   * The possible value types; cannot be empty nor contain only a single alternate. Note that all but the first
   * restriction may be an "exclude" restriction.
   */
  restrictions: ![AnyOfRestriction]

  /**
   * This declares that the values are constrained to those defined on the named union type. The binding of the union
   * type contains the restrictions.
   *
   * ```type
   * union type Stringish = string | [string]
   *
   * type X {
   *   string: Stringish
   * }
   * ```
   *
   * @see Union
   */
  @dsl(suppress=true)
  unionRefType: ReferenceType

  /**
   * Get the common base type across all restrictions
   *
   * @return the base type
   */
  anyOfBaseType: cached member function(): !ValueType

  /**
   * Whether the anyof type has _any_ generic variable reference
   */
  hasVarRestriction: cached member function(): boolean

  /**
   * Whether the anyof type has _any_ reference as possible value
   */
  hasReferenceRestriction: cached member function(): boolean

  /**
   * All of the restrictions which are ReferenceTypes.
   */
  referenceRestrictions: cached member function(): [ReferenceType]

  /**
   * Whether the anyof type has _any_ lambda as possible value
   */
  hasLambdaRestriction: cached member function(): boolean

  /**
   * Whether the anyof type has _any_ primitive possible values
   */
  hasPrimitiveRestriction: cached member function(): boolean

  /**
   * Whether the anyOf type has _only_ primitive possible values
   */
  hasOnlyPrimitiveRestrictions: cached member function(): boolean

  /**
   * Whether the anyOf type has _only_ numeric primitive possible values
   */
  hasOnlyNumberRestrictions: cached member function(): boolean

  /**
   * Whether the anyOf type has _only_ generic variable reference(s) as possible values
   */
  hasOnlyVarRestrictions: cached member function(): boolean

  /**
   * Whether the anyOf type has _only_ reference(s) as possible values
   */
  hasOnlyReferenceRestrictions: cached member function(): boolean

  /**
   * Whether the anyOf type has _only_ lambda(s) as possible values
   */
  hasOnlyLambdaRestrictions: cached member function(): boolean

  /**
   * Check if _any_ one of #inclusions satisfies provided predicate
   */
  hasRestriction: member function(predicate: lambda(vt: !ValueType): boolean): boolean java | js | py

  /**
   * Check if _all_ of #inclusions satisfy provided predicate
   */
  hasOnlyRestrictions: member function(predicate: lambda(vt: !ValueType): boolean): boolean

  /**
   * An anyof may be declared explicitly non empty:
   * ```
   * !(int | Duration)
   * ```
   *
   * Or it may be declared with all non empty alternate types:
   * ```
   * !int | !Duration
   * ```
   *
   * Both forms actually require a value.
   */
  // TODO: PLAT-41138 Implement in JavaScript and Python
  isNonEmpty: ~ java

  /**
   * Check whether the specified value type is in the list of restrictions.
   * Note that this uses the same rules as ValueType.matches.
   *
   * @return true if the value type is found
   */
  isRestriction: member function(vt: !?ValueType): boolean

  /**
   * Named union type containing the restrictions.
   *
   * @see Union
   */
  unionType: cached member function(): Type

  /**
   * Guess primitive type restriction for a provided value
   *
   * @param value
   *        value to get primitive type for
   * @return the primitive type
   */
  guessPrimitiveRestriction: member function(value: !?any, failIfNot: boolean): PrimitiveType java | js | py

  /**
   * Guess which of the restrictions fits the value most closely. For null values or when no restriction type matches,
   * return null. If `failIfNone` is true, an unguessable value will throw an error.
   *
   * The conventions of the language binding affect the result. Java's rich set of types mean that values are highly
   * descriptive, while JavaScript has only "number" for all numeric values. Python falls in between with distinct
   * integer and floating point types.
   *
   * For example, guessRestriction on `int | double | string`:
   *
   * | value      | result   | notes                       |
   * |------------|----------|-----------------------------|
   * | `"four"`   | string   | natural type is string      |
   * | `4`        | int      | natural type is int         |
   * | `4.1`      | double   | natural type is double      |
   * | `"4"`      | string   | natural type is string      |
   * | `true`     | `null`   | boolean not in restrictions |
   * | `null`     | `null`   | null is not anything        |
   *
   * @param value value to examine
   * @param testContent if true and the value is a string, attempts to parse string content to determine type
   * @param failIfNone if true, throw an exception instead of returning null
   * @return matched restriction type or null
   *
   * @see PrimitiveType#guessType
   */
  guessRestriction: member function(value: !?any, testContent: boolean, failIfNone: boolean): ValueType java | js | py

  /**
   * Convert the specified value to one of the restriction types. If the value cannot be converted, return null.
   * If `failIfInvalid` is true, an unconvertable value will throw an error.
   *
   * Note that "null" includes similar values such as JavaScript's `undefined`. The actual value returned for null will
   * be appropriate to the language binding, for example Python's `None` singleton. For JavaScript, conversion of `null`
   * and `undefined` return the given value. Similarly, conversion of fractional numbers to integers uses the language
   * binding conventions, typically truncation towards zero.
   *
   * If the natural type of the value (using {@link #guessRestriction}) is matched, the original value is returned.
   * Otherwise, conversion is attempted to each of the restrictions and the first one that succeeds is returned.
   *
   * For example, convertValue on `int | double | string`:
   *
   * | value             | result       | notes                       |
   * |-------------------|--------------|-----------------------------|
   * | `"four"`          | `"four"`     | natural type is string      |
   * | `4`               | `4`          | natural type is int         |
   * | `4.1`             | `4.1`        | natural type is double      |
   * | `"4"`             | `"4"`        | natural type is string      |
   * | `true`            | `"true"`     | boolean converts to string  |
   * | `DateTime.now()`  | `"2017-...`  | datetime converts to string |
   * | `null`            | `null`       | null converts to anything   |
   * | `undefined`       | `undefined`  | undefined treated as null   |
   *
   * @param value value to convert
   * @param failIfInvalid whether to throw an error if conversion fails
   * @return value or null if not convertible
   *
   * @see #guessRestriction
   * @see PrimitiveType#convertValue
   */
  convertValue: ~

  /**
   * The possible acceptable value types - i.e. restrictions without exclusions.
   */
  inclusions: cached member function(): ![ValueType]

  /**
   * The exclusion value types.
   */
  exclusions: cached member function(): [ValueType]

  /**
   * Whether this value type is explicitly excluded (#isA any of the listed exclusions).
   */
  isExcluded: member function(vt: !ValueType): boolean java | js | py

  /**
   * @return new instance from restrictions
   */
  fromRestrictions: function(pkg: !Pkg, restrictions: ![ValueType]): !AnyOfType

  bindAllGenericVars:  ~
  initialValue:        ~
  isA:                 ~(other: ValueType) java | js | py
  isAssignableFrom:    ~ java | js | py
  isEmptyValue:        ~ java | js | py
  makeValue:           ~ java | js | py
  valueFromJson:       ~ java | py | js
  valueToJson:         ~ java | js | py
  valueToTypedJson:    ~ java | js | py
  instanceType:        ~
  isPersistSerialized: ~
  serializedValueType: ~
}
