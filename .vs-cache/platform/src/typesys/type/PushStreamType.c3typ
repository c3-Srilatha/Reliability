/**
 * A push-stream is a notification mechanism or communication channel that data producer [ e.g. server process ] is
 * using for delivering new data to caller / client.
 *
 * Push Streams are declared in DSL using `push stream<E>` syntax:
 * ```type
 * // a push-stream of float values
 * metrics: push stream<float>
 * ```
 *
 * @see Stream
 * Also see [Streams](streams.c3doc).
 */
type PushStreamType mixes ValueType {

  /**
   * The value type for the elements of this push-stream.
   */
  elementType: !ValueType

  instanceType: ~
}
