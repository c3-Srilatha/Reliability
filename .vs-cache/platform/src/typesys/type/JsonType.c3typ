/**
 * The JavaScript Object Notation (JSON) value type has two variants:
 *  - `json`: JSON data without fixed structure
 *  - `typed json`: JSON for type-aware serialization
 *
 * There are no fields (other than #modifier), so this is normally accessed with {@link PrimitiveType#ofJson}.
 *
 * @see https://www.json.org/json-en.html
 */
type JsonType mixes PrimitiveType {

  /**
   * Whether this JSON includes boxing and other structure necessary for maintaining full fidelity communication of
   * made C3 values with a type-aware peer process.
   *
   * @see serdeser.c3doc
   */
  typed: boolean

  makeValue:       ~ java | py | js
  valueFromJson:   ~ java | py | js
  valueFromString: ~ java | py
  valueConverter:  ~
  toString:        ~ java | js | py
}
