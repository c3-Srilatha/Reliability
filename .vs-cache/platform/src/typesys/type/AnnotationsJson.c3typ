/**
 * Parsed annotations are represented in JSON with a specific structure. If any annotations are declared, the top
 * level will be an object node, and the keys in it will be the annotation names. The value of each annotation name
 * is an array of the field assignment declarations.
 *
 * ```type
 * @foo(x=17, y=Flah, z=true)
 * @db(index += 'blah')
 * ```
 *
 * Would have the JSON representation:
 * ```json
 * [
 *   {
 *     "foo": [
 *       {
 *         "name": "x",
 *         "value": 17,
 *         "declaredSrcLine": 1,
 *         "declaredSrcCharInLine": 6
 *       },
 *       {
 *         "name": "y",
 *         "value": "Flah",
 *         "valueIsId": true,
 *         "declaredSrcLine": 1,
 *         "declaredSrcCharInLine": 12
 *       },
 *       {
 *         "name": "z",
 *         "value": true,
 *         "declaredSrcLine": 1,
 *         "declaredSrcCharInLine": 20
 *       }
 *     ]
 *   },
 *   {
 *     "db": [
 *       {
 *         "name": "index",
 *         "value": "'blah'",
 *         "op": "+=",
 *         "declaredSrcLine": 2,
 *         "declaredSrcCharInLine": 5
 *       }
 *     ]
 *   }
 * ]
 * ```
 *
 * Note that the original text of the value is preserved in the string, including the original string quoting. If the
 * value was an identifier (unquoted string of word characters and dots), that is indicated by `valueIsId`.
 *
 * If the annotation uses the shortcut, value-only syntax, the name will be "_value_"; see Annotation#VALUE_ONLY_FIELD.
 *
 * Please use the {@link AnnotationsJsonFieldName} enum so the field names do not need to be hard-coded.
 */
abstract type AnnotationsJson mixes Typesys {

  /**
   * Parse DSL syntax for zero or more annotations and return the corresponding JSON tree. Note that if the input is
   * empty, the result is `null`.
   */
  jsonFromDsl: function(dsl: string): json

  /**
   * Format a set of annotations as DSL syntax and return the string. If no annotations are contained in this object,
   * the string is `null`.
   */
  jsonToDsl: function(annotations: !?json): string

  /**
   * Converts annotations json into instance of annotations type. If provided json is invalid `snd` of the result will
   * contain issue details.
   * If #failOnDuplicateKey is set, annotations json cannot contain multiple annotations with the same name
   * else the annotations with the same name will be merged together
   */
  jsonToAnnotations: function(annotations: !?json,
                              annotationsType: !Type,
                              failOnDuplicateKey: boolean): !Pair<Annotations, [string]>

  /**
   * Converts single annotation json into instance of corresponding annotation type. If provided json is invalid `snd`
   * of the result will contain issue details.
   */
  jsonToAnn: function(annotations: !?json, annotationType: !Type): !Pair<Annotation, [string]>

  /**
   * @return true if json has given annotation
   */
  jsonHasAnn: function<T: Annotation>(annotations: !?json, annType: !Type): boolean

  /**
   * @return true if json has given annotation
   */
  jsonHasAnn: function<T: Annotation>(annotations: !?json, ann: !string): boolean

  /**
   * Replaces single annotation.
   */
  jsonWithAnn: function(annotations: !?json, ann: !?Annotation): json

  /**
   * Removes single annotation.
   */
  jsonWithoutAnn: function(annotations: !?json, annType: !Type): json

  /**
   * Get the JSON declaration(s) for the specified annotation.
   *
   * @param json the full JSON
   * @param ann the annotation name
   * @param failIfMissing if true throw an error if no such annotations are found
   * @return the JSON for each corresponding annotation found
   */
  jsonForAnn: function(annotations: !?json, ann: !string, failIfMissing: boolean): [json]

  /**
   * Get the JSON declaration(s) for the specified annotation field.
   *
   * @param json the full JSON
   * @param ann the annotation name
   * @param field the field name
   * @param failIfMissing if true throw an error if no such fields are found
   * @return the JSON for each corresponding field found
   */
  jsonForAnnField: function(annotations: !?json, ann: !string, field: !string, failIfMissing: boolean): [json]

  /**
   * Merges annotations into a coherent set. Fields specified in override will replace those in base, but fields that
   * are only specified in base will remain. In other words, the overriding is at the field level, not the whole
   * annotation level.
   *
   * @param override the set of annotations that are changed
   * @param base the set of annotations that are previously existing
   * @return merged annotations json
   */
  merge: function(override: !?json, base: !?json): json
}
