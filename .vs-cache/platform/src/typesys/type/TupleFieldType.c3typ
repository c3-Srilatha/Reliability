/**
 * Each field in the tuple has a value type. If the tuple is named, it has those names as its names.
 * Otherwise, the zero-based indexes are used as the name.
 *
 * @see Tuple
 */
type TupleFieldType mixes Nameable, Typesys {

  /**
   * Every field has a zero-based index, which corresponds to the order in which they were declared.
   */
  index: !int

  /**
   * The type of value this tuple field holds.
   */
  valueType: !ValueType

  /**
   * @return whether this `TupleFieldType` has a name
   */
  hasName: member function(): !boolean
}
