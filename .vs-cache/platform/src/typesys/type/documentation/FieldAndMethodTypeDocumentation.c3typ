/**
 * Documentation of any type field (data) or method (function).
 */
type FieldAndMethodTypeDocumentation mixes Documentation, AnnotatedDocumentation {

  /**
   * The type for which documentation is being produced.
   */
  parentType: string

  /**
   * The closest type name on which this field/method is defined, if not the target type.
   */
  inheritedFrom: DocumentationReference

  /**
   * Whether this field/method is marked as private.
   */
  private: boolean

  /**
   * The DSL declaration of the field/method.
   */
  declaration: string
}
