/**
 * What type of reference in the documentation.
 *
 * @see DocumentationReference
 */
enum type DocumentationReferenceKind {

  /**
   * An inline link reference in the documentation text.
   */
  LINK

  /**
   * An explicit `@see` reference in the documentation comment.
   */
  SEE

  /**
   * A usage reference to a type that mixes in the documented type.
   */
  MIXIN

  /**
   * A usage reference to a method that takes the documented spec type.
   */
  SPEC

  /**
   * A usage reference to a method that returns the documented result type.
   */
  RESULT

  /**
   * A link to a footnote at the bottom of the page.
   */
  FOOTNOTE
}
