/**
 * Documentation of a type. Types are documented with a comment in their declaration (such as this one).
 *
 * Type documentation is not inherited from mixins; each type should have its own documentation.
 * However, it is possible to explicitly inherit documentation from a mixin using the `@inheritdoc` directive:
 *
 * ```
 * /**
 *  * @inheritdoc B
 *  * /
 * type X mixes A, B, C
 * ```
 *
 * The @inheritdoc line is replaced with the contents of the documentation from the named type, which means a mixin's
 * documentation can be included and augmented if desired. Other markup from the mixin's comment will also be
 * interpolated, including @var and @see declarations.
 */
type TypeDocumentation mixes Documentation, AnnotatedDocumentation {

  /**
   * How this type would be persisted.
   */
  persist: string enum('entity', 'included')

  /**
   * All public data fields and methods on the type, both {@link FieldTypeDocumentation} and
   * {@link MethodTypeDocumentation} instances.
   *
   * @see Type#fieldTypes
   */
  fieldAndMethodDoc: [FieldAndMethodTypeDocumentation]

  /**
   * Number of fields and methods defined on the type itself.
   */
  declaredFieldAndMethodCount: !int

  /**
   * Number of fields and methods inherited from mixins.
   */
  mixinFieldAndMethodCount: !int

  /**
   * Direct mixins of this type, but not mixins-of-mixins.
   *
   * @see Type#mixins
   */
  mixinTypeDoc: [TypeDocumentation]

  /**
   * Parametric variables in the type which must be resolved by concrete types that mixin this one.
   *
   * @see Generic#genericVars
   */
  genericVarDoc: [Documentation]

  /**
   * Parametric bindings in the type for variables in mixin types.
   *
   * @see Generic#genericVarBindings
   */
  genericVarBindingDoc: [TypeBindingDocumentation]

  /**
   * Markup of bindings formatted as inline markup.
   *
   * @see #genericVarBindingDoc
   */
  genericVarBindingDecl: DocumentationMarkup

  /**
   * True if this is an annotation type.
   */
  annotation: boolean

  /**
   * True if this is an enumeration type (mixes {@link Enum}).
   */
  enum: boolean

  /**
   * Whether this type is marked as private. This means it should not be used outside its declaring package.
   */
  private: boolean

  /**
   * Whether this type is marked as abstract. This means that it may not be used directly, only through types that
   * mix it in.
   */
  abstract: boolean

  /**
   * Whether this type is explicitly or implicitly final. This means it should be mixed in other types.
   */
  final: boolean

  /**
   * The DSL declaration of the type header (without fields).
   */
  declaration: string

  /**
   * The bare names of the types declared as immediate inner types of this type.
   */
  innerTypes: [string]

  /**
   * Poly tests of this type for examples and extra documentation.
   */
  polyTests: [string serialized UrlPath]

  /**
   * Return only the fields documented in #fieldAndMethodDoc.
   */
  fieldDoc: member function(): [FieldTypeDocumentation]

  /**
   * Return only the methods documented in #fieldAndMethodDoc.
   */
  methodDoc: member function(): [MethodTypeDocumentation]
}
