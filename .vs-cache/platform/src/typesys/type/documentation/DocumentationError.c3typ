/**
 * Errors produced during documentation parsing.
 * @see DocumentationParser
 */
type DocumentationError {

  /**
   * The kind of source object for the documentation
   */
  sourceKind: string enum DocumentationKind

  /**
   * The path to the source object for the documentation
   */
  sourcePath: string

  /**
   * The code of the error.
   */
  errCode: string

  /**
   * The formatted error message.
   */
  message: string
}
