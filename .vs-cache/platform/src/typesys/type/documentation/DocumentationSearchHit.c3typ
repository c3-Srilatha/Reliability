/**
 * Single search hit.
 * @see DocumentationSearchResult
 */
type DocumentationSearchHit {

  /**
   * Score, relative to other results for this search. The maximum value will be 1.0 for highest relevance.
   */
  score: !double

  /**
   * The kind of documentation matched.
   */
  kind: !string enum DocumentationKind

  /**
   * The path of the documentation object, which will include the parent name if needed.
   */
  path: !string

  /**
   * The name of the documentation object (within its parent).
   */
  name: !string
}
