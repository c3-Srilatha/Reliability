/**
 * A card block, which contains a title and a body and is displayed in a bordered recangle arranged in a grid layout.
 *
 * ```md
 * [[[ Ace ]]]
 * The **Ace** is the highest and/or lowest card in the pack.
 * [[[ King ]]]
 * The **King** is the highest card except for the ace.
 * [[[ ]]]
 * ```
 *
 * @see MarkdownCard
 */
type DocumentationCard mixes DocumentationBlock {

  /**
   * The desired number of columns, space permitting.
   */
  cols: !int32

  /**
   * The target that the whole card links to.
   */
  href: DocumentationReference

  /**
   * The title from between the opening brackets. This doesn't appear in the card body.
   */
  title: string

  /**
   * The name associated with the sequence of cards (the "cardset").
   */
  name: string

  kind: ~ = CARD
}
