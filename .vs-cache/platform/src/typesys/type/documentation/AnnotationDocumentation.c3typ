/**
 * Documentation of a single annotation on a piece of metadata.
 */
type AnnotationDocumentation mixes Documentation {

  /**
   * Reference to the annotation type.
   */
  annotationType: DocumentationReference

  /**
   * The set of annotation attributes (name/value pairs).
   * The values are literals rendered as (abbreviated) text.
   */
  attributes: map<string, string>

  /**
   * Markup of the annotation declaration formatted as a code span or pre block.
   */
  declaration: DocumentationMarkup
}
