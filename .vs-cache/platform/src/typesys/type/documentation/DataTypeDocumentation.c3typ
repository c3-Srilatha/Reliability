/**
 * Values related to the value type of a data field, function argument or return value.
 */
type DataTypeDocumentation {

  /**
   * The type of the data value.
   */
  dataType: DocumentationMarkup

  /**
   * Whether a non-empty value is required to be present (`!`).
   *
   * @see ValueModifier#NON_EMPTY
   */
  nonEmpty: boolean

  /**
   * Whether this value is an enumeration.
   */
  enum: boolean

  /**
   * The external enumeration type name.
   */
  enumName: string

  /**
   * The legal enumeration values.
   */
  enumValues: [any]

  /**
   * If value is declared with "string serialized", this is the serializing type name.
   */
  serializedType: string

  /**
   * Whether this value is required to be present. This is a combination of "non-empty" (`!`, cannot be null) and
   * "non-optional" (`!?`, may be null) for function parameters.
   *
   * @see ValueModifier
   * @see #nonEmpty
   */
  required: property(): boolean
}
