/**
 * A collapsible block, which contains a title and a body.
 *
 * ```md
 * +++ Spoiler
 * The _butler_ did it.
 * +++
 * ```
 *
 * The spans in this block make up the title and the blocks make up the body.
 *
 * @see MarkdownCollapsible
 */
type DocumentationCollapsible mixes DocumentationBlock {

  /**
   * Whether to start in expanded state.
   */
  startExpanded: boolean

  /**
   * The name if part of an exclusive accordion.
   */
  name: string

  kind: ~ = COLLAPSE
}
