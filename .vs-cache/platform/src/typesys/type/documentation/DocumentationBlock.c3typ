/**
 * A single block element, which may be a simple block such as a paragraph or list item or a compound block such as a
 * list or table. Only one of #spans or #blocks should have child markup.
 *
 * @see DocumentationSpan
 * @see DocumentationTable
 */
type DocumentationBlock mixes DocumentationMarkup {

  /**
   * The type of block.
   */
  kind: string enum DocumentationBlockKind

  /**
   * Additional style information for certain block kinds.  For example, CODE blocks may have the programming language
   * for pretty printing.
   */
  style: string

  /**
   * The spans within the simple block.
   */
  spans: [DocumentationSpan]

  /**
   * The sub-blocks within the compound block.
   */
  blocks: [DocumentationBlock]
}
