/**
 * Documentation of the binding of a parametric variable in a mixin type.
 */
type TypeBindingDocumentation mixes Documentation {

  /**
   * The mixin type name for the binding.
   */
  mixinName: string

  /**
   * The value type it's bound to.
   */
  boundType: DocumentationMarkup
}
