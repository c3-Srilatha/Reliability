/**
 * Options for documentation parser functions.
 *
 * @see DocumentationParser
 */
type DocumentationParserSpec mixes Spec {

  /**
   * Don't build documentation for fields and methods when called on a type.
   */
  noChildFields: boolean

  /**
   * Exclude fields and methods inherited from mixins (and not overridden on the type).
   */
  noMixinFields: boolean

  /**
   * Exclude fields and methods marked as private in this type.
   */
  noPrivateFields: boolean

  /**
   * Exclude annotations and DSL declaration.
   */
  noDeclarations: boolean

  /**
   * Exclude cross-references for key usages of a type.
   */
  noUses: boolean

  /**
   * Exclude poly-tests for the type.
   */
  noPolyTests: boolean

  /**
   * Exclude `@see` links on type and field documentation.
   */
  noSee: boolean

  /**
   * Extract example code for the specified language. Examples are identified with the `@example` annotation.
   *
   * This is exclusive with #exampleAllLangs. (If that field is set, this one is ignored.)
   */
  exampleLang: string enum DocumentationExample.Language

  /**
   * Include example code for all supported languages. Examples are identified with the `@example` annotation.
   *
   * This is exclusive with #exampleLang. (If this field is set, that one is ignored).
   */
  exampleAllLangs: boolean

  /**
   * If true, examples will be synthesized for standard cases, such as Obj construction and field access. These code
   * snippets use randomly generated values so provide a serviceable, but not very enlightening, example. To enable
   * this behavior, this field must be set _and_ either #exampleLang or #exampleAllLangs.
   */
  synthesizeExamples: boolean

  /**
   * Specify the package to be used for loading types and topic files (instead of the package of the current app).
   */
  pkg: Pkg

  /**
   * Produce a new spec with #noChildFields, #noDeclarations, #noMixinFields, #noUses, #noPolyTests and #noSee on.
   * (This is a quick way to build a spec that only formats the type and description.)
   */
  headerOnly: member function(): !mixing DocumentationParserSpec

  /**
   * Return the #pkg specified in the spec, or the current app's package if none.
   */
  safePkg: member function(): !Pkg
}
