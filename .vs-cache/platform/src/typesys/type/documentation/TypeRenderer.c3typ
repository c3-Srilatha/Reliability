/**
 * For types themselves, a natural rendering in HTML is their documentation.
 *
 * @see HtmlRenderable
 */
type TypeRenderer mixes DocumentableRenderer {

  title: ~ java | js-client

  /**
   * Produce a DocumentableRenderer for this type.
   */
  forType: function(type: !Type): !TypeRenderer java | js-client

  documentable: !TypeMeta
}
