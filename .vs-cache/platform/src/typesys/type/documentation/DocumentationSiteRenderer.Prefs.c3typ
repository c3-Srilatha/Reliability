/**
 * User preferences for the documentation micro site.
 */
@config(minOverride=USER)
type DocumentationSiteRenderer.Prefs mixes Config {

  /**
   * Type names favorited by the user, which always show up in the big list.
   */
  favoriteTypes: set<!string>

  /**
   * Type names recently viewed by the user, which show up in natural contexts.
   */
  recentTypes: [!string]

  /**
   * Topic file paths favorited by the user, which always show up in the big list.
   */
  favoriteTopics: set<!string>

  /**
   * Topic file paths recently viewed by the user, which show up in natural contexts.
   */
  recentTopics: [!string]
}
