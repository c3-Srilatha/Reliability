/**
 * Generic argument to documentation search functions.
 * @see DocumentationSearcher
 */
type DocumentationSearchSpec mixes Spec {

  /**
   * Single kind of documentation to search.
   */
  singleKind: string enum DocumentationKind

  /**
   * Single category to match.
   */
  singleCategory: string

  /**
   * Only search the names (not descriptions).
   */
  nameOnly: boolean = false

  /**
   * Maximum number of hits to return.
   */
  maxResults: int = 100
}
