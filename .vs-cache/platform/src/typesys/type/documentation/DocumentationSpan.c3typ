/**
 * A piece of parsed documentation markup with a single formatting style.
 */
type DocumentationSpan mixes DocumentationMarkup {

  /**
   * The style of the span.
   */
  style: string enum DocumentationSpanStyle

  /**
   * The content of the span.
   */
  text: ?string
}
