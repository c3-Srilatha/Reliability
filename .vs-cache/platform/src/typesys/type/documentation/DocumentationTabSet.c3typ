/**
 * A "tab set" contains one or more "tabs", plus has a list of the individual tab names. This makes it easier for
 * rendering HTML (or other output) because the bounds of each tab can be easily identified. The block children
 * will all be {@link DocumentationTab}s.
 *
 * The tabs are defined by headings using the `=` leaders (instead of `#`):
 *
 * ```md
 * == Stuff
 * Some stuff
 * == Nonsense
 * Even more nonsense.
 * == ==
 * ```
 *
 * == Stuff
 * Some stuff
 * == Nonsense
 * Even more nonsense.
 * == ==
 *
 * This produces HTML that contains the structure, but not the specific appearance or behavior to make the tabs work:
 * ```html
 * <div class="tabset">
 *   <ul class="tab-handles">
 *     <li class="tab-handle" data-section="section:1.1"><a href="#section:1.1">Stuff</a></li>
 *     <li class="tab-handle" data-section="section:1.2"><a href="#section:1.2">Nonsense</a></li>
 *   </ul>
 *   <div class="tab-content" data-section="section:1.1">
 *     <a name="stuff"></a><h2 class="tab-heading" id="section:1.1">Stuff</h2>
 *     <p>Some stuff</p>
 *     ...
 *   <div class="tab-content" data-section="section:1.2">
 *     ...
 * </div>
 * ```
 *
 * @see DocumentationTab
 */
type DocumentationTabSet mixes DocumentationBlock {

  /**
   * The text of the headings that define the individual tabs.
   */
  titles: ![!string]

  /**
   * The sections of the headings that define the individual tabs.
   */
  sections: ![!string]

  kind: ~ = TABSET
}
