/**
 * Generic response from documentation search functions.
 * @see DocumentationSearcher
 */
type DocumentationSearchResult mixes Result {

  /**
   * Original search text.
   */
  query: string

  /**
   * Total number of search hits (this may be larger than the number returned in #hits).
   */
  totalHits: !int

  /**
   * Top search hits (up to the maximum requested) ordered by score descending.
   */
  hits: [DocumentationSearchHit]

  /**
   * If the query could not be parsed, the error message.
   */
  error: string
}
