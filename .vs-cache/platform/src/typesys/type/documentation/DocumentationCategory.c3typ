/**
 * Documentation on types and topics can be grouped into "categories" to make it easier to browse the large amount of
 * information in the system. Categories themselves are defined as metadata instances of this type.
 *
 * Topics normally define their category using the multi-markdown syntax ({@link documentation-features.c3doc}):
 * ```c3doc
 * Title: Authoring Documentation
 * Category: Basics
 * Abstract: How to author documentation for types and feature areas.
 *
 * Platform documentation is produced from comments on types as well as separate topic files...
 * ```
 * This will associate the topic with the "Basics" category.
 *
 * Types may also listed explicitly in categories, but its better to specify them using relationships. A type
 * implicitly or explicitly belong to multiple categories. Types which mixin the #baseTypes and are returned by the
 * #typeSupplier are constrained by #excludeTypes and augmented by #includeTypes. If none of these fields are specified,
 * no types will be included in the category.
 */
type DocumentationCategory mixes Named, Metadata {

  /**
   * This is the short label for the category as displayed in the documentation UI. It should one to a few words
   * spelled in title case ("Basics" or "Data Integration").
   */
  name: !~

  /**
   * This longer description will be included in the UI when the category is expanded and there is room for a fuller
   * description. The contents may be Markdown as described in {@link documentation-features.c3doc}.
   */
  description: string

  /**
   * Any types listed here define membership in the category of types which mix in the listed base types. Note that the
   * base types themselves are not included.
   */
  baseTypes: [!Type]

  /**
   * A lambda that discovers which types are included in this category. This is used only if the type does not match
   * based on #baseTypes and #includeTypes. It will also be filtered by #excludeTypes.
   */
  typeSupplier: lambda(): [!Type]

  /**
   * A list of types that are explicitly excluded. If types matched by baseTypes or returned by typeSupplier are in this
   * list, they are _not_ included in the category.
   */
  excludeTypes: [!Type]

  /**
   * A list of types that are explicitly included.
   */
  includeTypes: [!Type]

  /**
   * Category names are case insensitive and punctuation is generally ignored. This method returns the category name in
   * a form usable as the unique key in the cache, but not necessarily for user display. If the name has no letters or
   * digits, null is returned.
   */
  canonicalName: member function(): string

  /**
   * Return true if there are any type specifications in the category.
   */
  canMatchTypes: member function(): boolean

  /**
   * Determine whether or not the specified type matches this category, based on the listed types (#baseTypes,
   * #excludeTypes, #includeTypes).
   */
  typeMatches: member function(type: !Type): boolean

  /**
   * Return the full set of types that match this category, based on the listed types (#baseTypes, #excludeTypes,
   * #includeTypes).
   */
  matchedTypes: member function(): set<!Type>

  /**
   * Return the full set of parsed documentation topics which specify this category in the "front matter".
   *
   * For example, the topic:
   * ```
   * Topic Type: Reference
   * Audience: Customer
   * Category: Documentation
   * Title: Authoring Documentation
   * Abstract: Commenting in type files and writing topic documentation.
   * (blank line)
   * ```
   *
   * Declared the category "Documentation" and if it isn't declared through metadata, this is enough for an implicit
   * declaration.
   */
  matchedTopics: member function(spec: DocumentationParserSpec): set<!TopicDocumentation>

  /**
   * Return the full set of documentation topic file paths that specify this category in the "front matter".
   *
   * @see #matchedTopics
   */
  matchedTopicPaths: member function(): set<!string serialized Pkg.Path>

  /**
   * Load a topic for the specified name, normally this matches the ID and is unique.
   */
  forName: ~

  /**
   * Return all the valid categories defined.
   */
  all: cached function(): [DocumentationCategory]

  /**
   * Category names are case insensitive and punctuation is generally ignored. This method takes a user-entered category
   * name and returns the form usable as the unique key in the cache, but not necessarily for user display. If the name
   * has no letters or digits, null is returned.
   */
  canonicalizeName: function(name: string): string
}
