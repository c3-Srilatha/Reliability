/**
 * List of documentation matched by search.
 */
type ResultsDocumentation mixes Documentation {

  /**
   * Original search text.
   */
  query: string

  /**
   * Search hits.
   */
  results: [Documentation]

  /**
   * If the query could not be parsed, the error message.
   */
  error: string

  /**
   * All known paths/names covered by this search domain. The first element of the pair is the path and the
   * second is the name/title to display.
   */
  allNames: set<Pair<string, string>>
}
