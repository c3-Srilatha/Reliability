/**
 * Static documentation not directly associated with a type. This is read from files in the metadata source tree
 * with the extension `.c3doc`, called "topics".
 */
type TopicDocumentation mixes Documentation {

  /**
   * The metadata about the topic, providing information about a documentation, following the MultiMarkdown syntax.
   *
   * The keys are all lower-case with whitespace removed. Use {@link #topicMetadataValue} to access.
   *
   * @see https://github.com/fletcher/MultiMarkdown/wiki/MultiMarkdown-Syntax-Guide
   */
  topicMetadata: map<string, string>

  /**
   * The title of the topic. This is usually the `Title:` in the head matter, but may come from the first heading.
   */
  title: string

  /**
   * The type of the topic. This is specified using `Topic Type:` in the head matter.
   */
  topicType: string

  /**
   * The category declared by the topic.
   */
  category: string

  /**
   * The abstract of the topic for summary display.
   */
  abstract: DocumentationMarkup

  /**
   * Types referenced in the documentation.
   */
  relatedTypes: [string]

  /**
   * Return all documentation topics. This will find topics in the specified package plus any it depends on.
   */
  allTopics: function(pkg: !Pkg): [!Pkg.File]

  /**
   * Find a single documentation topic file by full or partial path. This will find topics in the specified package
   * plus any it depends on.
   */
  matchTopic: function(pkg: !Pkg, name: !?string, failIfNotFound: boolean): Pkg.File

  /**
   * Parse documentation from a file in the package hierarchy. By default, the documentation is parsed in the context
   * of the file's package, but if another package is passed as the second argument, that will be used instead.
   */
  fromFile: function(file: !Pkg.File, pkg: Pkg): TopicDocumentation

  /**
   * Get the value for a single key in the front matter. The key is case-insensitive and all whitespace is ignored.
   */
  topicMetadataValue: member function(key: !string, failIfMissing: boolean): string
}
