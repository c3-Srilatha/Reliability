/**
 * Feedback on a piece of documentation from someone reading it.
 */
type DocumentationFeedback mixes Identifiable {

  /**
   * The root package provisioned to the tag from which the documentation was generated.
   */
  package: string

  /**
   * The version of the server when the documentation was generated.
   */
  serverVersion: string

  /**
   * The type object being commented on.
   */
  kind: !string enum DocumentationKind

  /**
   * The full path down to the object being commented on.
   * This, in conjunction with the kind, should allow global resolution of the source object.
   */
  path: !string

  /**
   * The URL against which the documentation was viewed.
   */
  url: string

  /**
   * The user name (email address) of the commenter.
   */
  username: string

  /**
   * Thumbs up/down rating.
   */
  rating: string enum('good', 'bad')

  /**
   * User entered comments.
   */
  comments: string

  /**
   * Submit feedback.
   */
  submit: member function()
}
