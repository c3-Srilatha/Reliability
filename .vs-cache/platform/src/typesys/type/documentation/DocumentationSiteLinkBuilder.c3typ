/**
 * Link translation for the documentation micro-site. The actual URLs are built based on the view from the client
 * accessing the site.
 *
 * @see DocumentationSiteRenderer
 */
type DocumentationSiteLinkBuilder mixes DocumentationLinkBuilder {

  /**
   * URL to the documentation micro-site as seen by the client invoking the current action.
   */
  baseUrl: !string

  /**
   * File being rendered, generally for a topic.
   */
  file: Pkg.File

  href: ~
  src:  ~
}
