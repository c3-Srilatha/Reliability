/**
 * Documentation of type data field. Note that method documentation uses a parallel structure:
 * {@link MethodTypeDocumentation}.
 */
type FieldTypeDocumentation mixes FieldAndMethodTypeDocumentation, DataTypeDocumentation {

  /**
   * Whether this data field is constant (cannot be changed).
   */
  constant: boolean

  /**
   * The literal initializer value for the field.
   */
  initializer: string

  /**
   * The type of calculated field (if any).
   */
  calcType: string enum('stored', 'read')

  /**
   * The expression used for a calculated field.
   */
  calcExpr: string

  /**
   * The field using which this value is translated.
   * If this is a field of this type, the markup will be link.
   */
  translatedBy: DocumentationMarkup

  /**
   * Description of foreign key reference.
   */
  foreignKeyInfo: DocumentationMarkup

  kind: ~ = FIELD
}
