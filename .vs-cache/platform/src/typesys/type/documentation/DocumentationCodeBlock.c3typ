/**
 * A Markdown fenced code block, usually with a language associated:
 *
 * ````md
 * ```js
 * 2 + 2
 * ```
 * ````
 *
 * The language may be the formal name, such as "JavaScript" or a common alias as above. It is also case-insensitive.
 *
 * Syntax highlighting will be done for {@link DocumentationExample.Language known languages}.
 *
 * This is also used for indented code blocks (4+ leading spaces), although with no language associated there will
 * be no syntax highlighting.
 *
 * This parsed structure appears in the {@link Documentation#description description}. Fenced code blocks within
 * `@example` annotations are parsed as {@link Documentation#examples separate examples}.
 */
type DocumentationCodeBlock mixes DocumentationBlock {

  /**
   * The full info string specified in the first line. This will start with the #style, but also may include other
   * directives such as line highlighting.
   *
   * @see MarkdownFencedCodeBlock#info
   */
  info: string

  /**
   * The language specified in the fenced code block #info. Note that this can be the formal name of the language
   * ("Python") or a standard abbreviation ("py"). The name is case insensitive ("python", "Py").
   *
   * {@link ImplLanguage Programming languages} will have syntax highlithing support, as will some structured data
   * languages such as JSON.
   */
  style: ~

  /**
   * A set of lines (and optionally columns) to be highlighted in the code block. This is specified in the #info using
   * `highlight={...}` where the text between the braces is returned by this method.
   *
   * @see MarkdownFencedCodeBlock#highlight
   */
  highlight: string serialized MarkdownFencedCodeBlock.Highlights

  /**
   * Return the corresponding example language, which may be a programming language, "Type" or one of the "REST"
   * options plus data types such as "JSON" and "HTML". #style is not validated, so there may not be a corresponding
   * example language.
   *
   * Note that this is a superset of #implLanguage.
   *
   * @see DocumentationExample.Language
   */
  exampleLanguage: member function(failIfInvalid: boolean): string enum DocumentationExample.Language

  /**
   * Return the corresponding implementation language. #style is not validated, so there not may be a corresponding
   * implementation language.
   *
   * Note that this is a subset of #exampleLanguage, of only supported method implementation languages.
   *
   * @see ImplLanguage
   */
  implLanguage: member function(failIfInvalid: boolean): string serialized ImplLanguage

  kind: ~ = CODE
}
