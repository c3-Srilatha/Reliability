/**
 * Documentation of one parameter of a function.
 */
type ParameterDocumentation mixes Documentation, DataTypeDocumentation {

  /**
   * Whether the parameter may be repeated.
   */
  varargs: boolean

  /**
   * Whether the parameter is non-optional (`!?`). Note that this allows passing an explicit empty value, but the
   * argument may not be omitted.
   *
   * @see ValueModifier#NON_OPTIONAL_PARAM
   */
  nonOptional: boolean

  /**
   * @inheritdoc
   * @see #nonOptional
   */
  required: ~

  /**
   * The default value for the parameter.
   */
  default: string
}
