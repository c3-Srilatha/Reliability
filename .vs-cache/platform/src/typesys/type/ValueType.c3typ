/**
 * A value type is the metadata for any individual value that can be declared in the type system.
 *
 * Each group of possible values is represented by a type that mixes in value type.
 *  - {@link PrimitiveType} is for simple values such a strings and dates
 *  - {@link ReferenceType} is for values which are type system-defined objects
 *  - {@link CollectionType} is for collections of values (arrays, maps, streams)
 *  - {@link FunctionType} is for functions signatures and method declarations
 *  - {@link AnyOfType} is for a values which are a selection of specific types
 *  - {@link AnyType} is for a value that can hold anything at all
 *  - {@link NativeType} is for a private value that has special support for one or more language bindings
 *
 * Here is the full hierarchy of "runtime" value types:
 *  - {@link PrimitiveType}
 *     - {@link BinaryType}
 *     - {@link BooleanType}
 *     - {@link DateTimeType}
 *     - {@link JsonType}
 *     - {@link NumberType}
 *        - {@link ByteType}
 *        - {@link DecimalType}
 *        - {@link DoubleType}
 *        - {@link FloatType}
 *        - {@link IntType}
 *        - {@link Int32Type}
 *        - {@link Int16Type}
 *        - {@link BigIntType}
 *     - {@link StringType}
 *  - {@link ReferenceType}
 *  - {@link VarReferenceType}
 *  - {@link CollectionType}
 *     - {@link ArrayType}
 *     - {@link MapType}
 *     - {@link SetType}
 *     - {@link StreamType}
 *     - {@link VectorType}
 *  - {@link FunctionType}
 *     - {@link LambdaType}
 *     - {@link MethodType}
 *  - {@link PushStreamType}
 *  - {@link TupleType}
 *  - {@link AnyOfType}
 *  - {@link AnyType}
 *  - {@link NativeType}
 *  - {@link VoidType}
 *
 * Additionally there are set of value types that are only used when declaring a new C3 Type or parsing C3 Type dsl:
 *  - {@link InheritedValueType} is for a value type inherited (and perhaps modified) from one of its parent type's
 *    mixins
 *  - {@link DeclaredFieldType} is for holding field type declaration that could be declaring data field, method,
 *    constant or inner type
 *  - {@link DeclaredReferenceType} is for holding not yet resolved reference to another C3 Type
 *
 * Note that these value types will not be used for any runtime value
 *
 * Value types may be compared with varying degrees of exactness:
 *  - {@link #isSame} the value types are identical
 *  - {@link #isA} this type is a sub-type of another
 *  - {@link #isAssignableFrom} whether this type allows all values of another (inverse of **isAssignableTo**)
 *  - {@link #isAssignableTo} whether another type allows all values of this one (inverse of **isAssignableFrom**)
 *  - {@link #isConvertibleFrom} whether a conversion path exists from the other type to this one
 *
 * Values can also be matched against value types:
 *  - {@link #isSameValue} the value is exactly of this value type
 *  - {@link #isAssignableValue} the value is allowable for this value type
 *  - {@link #isConvertibleValue} the value can be converted to this value type
 *
 * Finally, the value type can be guessed from a value using #guessType.
 *
 * For general type system information, see {@link typesys.c3doc Type System}.
 */
abstract type ValueType mixes Annotatable, StringSerializable, WithCacheKey, Fingerprinted {

  /**
   * Value type modifier
   *
   * Non empty constraint is specified by adding an exclamation mark in front of the ValueType:
   * ```type
   *   where: !Location
   * ```
   *
   * The desire to preserve empty values (such that they can be differentiated from the lack of any value) is specified
   * by adding a question mark in front of the ValueType:
   * ```type
   *   approved: ?boolean
   * ```
   *
   * The non optional function parameter constraint is specified by adding `!?` in front of the ValueType:
   * ```type
   *   f: function(url: !?string serialized Url)
   * ```
   *
   * @see #isNonEmpty
   * @see #preservesEmpty
   * @see #isNonOptionalParam
   * @see FunctionParam#isNonOptional
   */
  @dsl(suppress=true)
  modifier: string enum ValueModifier

  /**
   * Whether this value type allows empty values. This is the inverse of {@link #isNonEmpty}.
   *
   * Returns true for:
   * - `type` (no modifier) - can be empty
   * - `?type` (PRESERVES_EMPTY) - can be empty, preserves and differentiates empty vs null
   * - `!?type` (NON_OPTIONAL_PARAM) - can be empty, must be explicitly provided
   *
   * Returns false for:
   * - `!type` (NON_EMPTY) - cannot be empty
   *
   * @see #isNonEmpty
   * @see #preservesEmpty
   * @see ValueModifier
   */
  allowsEmpty: inline member function(): boolean java | js | py

  /**
   * If true, value is allowed to be empty. The definition of "empty" expands depending on the value type, but always
   * includes null.
   *
   * In DSL, this is specified by adding a question mark in front of the ValueType:
   * ```type
   *   approved: ?boolean
   * ```
   *
   * Effect on various value types:
   * - boolean: when true, it means a tri-state (`true`/`false`/`null`); when false, `false` and `null` are identical.
   * - string: when true, whitespace values (including empty string itself) will retain their original value and not
   * be treated as `null`; if false, they will be treated as null.
   * - collection: when true, `null` will continue to be `null` instead of being auto-converted into empty collections;
   * when false, `null` will be auto-converted into empty collections to allow easy traversal but the empty values are
   * transient.
   * - reference: when true, an empty instance (with no fields) will continue to be an empty instance and not
   * auto-converted to `null`; if false, it would be transient and converted to null.
   *
   * @see #isEmptyValue
   */
  preservesEmpty: inline member function(): boolean java | js | py

  /**
   * Whether this value type is an explicit "any". This is a singleton representing any of the other types listed
   * here (except `native`).
   *
   * @see AnyType
   */
  isAny: inline member function(): boolean java | js | py

  /**
   * Whether this value type is a primitive.
   *
   * @see PrimitiveType
   */
  isPrimitive: inline member function(): boolean java | js | py

  /**
   * Whether this value type is an array.
   *
   * @see ArrayType
   */
  isArray: inline member function(): boolean java | js | py

  /**
   * Whether this value type is a set.
   *
   * @see SetType
   */
  isSet: inline member function(): boolean java | js | py

  /**
   * Whether this value type is a map.
   *
   * @see MapType
   */
  isMap: inline member function(): boolean java | js | py

  /**
   * Whether this value type is a stream.
   *
   * @see StreamType
   */
  isStream: inline member function(): boolean java | js | py

  /**
   * Whether this value type is a push stream.
   *
   * @see PushStreamType
   */
  isPushStream: inline member function(): boolean java | js | py

  /**
   * Whether this value type is an event stream.
   *
   * @see EventStreamType
   */
  isEventStream: inline member function(): boolean java | js | py

  /**
   * Whether this value type can be streamed, e.g. over HTTP.
   */
  isStreamable: inline member function(): boolean java | js | py

  /**
   * Whether this value type can be streamed as C3 action argument, e.g. over HTTP.
   */
  isStreamableArg: inline member function(): boolean java | js | py

  /**
   * Whether this value type can be streamed as C3 action result, e.g. over HTTP.
   */
  isStreamableResult: inline member function(): boolean java | js | py

  /**
   * Whether this value type is any collection (array, map, set, stream).
   *
   * @see CollectionType
   */
  isCollection: inline member function(): boolean java | js | py

  /**
   * Whether this value type is a reference to a type.
   *
   * @see ReferenceType
   */
  isReference: inline member function(): boolean java | js | py

  /**
   * Whether this value type is a reference to an Instance type such as `Array` or `Lambda`.
   *
   * @see #instanceType
   * @see #instanceValueType
   */
  isInstanceType: inline member function(): boolean java | js | py

  /**
   * Whether this value type is a reference to a type or method generic variable.
   *
   * @see VarReferenceType
   */
  isVarReference: inline member function(): boolean java | js | py

  /**
   * Whether this value type is a declared reference to a type or method generic variable.
   */
  isDeclaredReference: inline member function(): boolean java | js | py

  /**
   * Whether this value type is an "anyof" (or "union type") such as `int | [int]`.
   *
   * @see AnyOfType
   */
  isAnyOf: inline member function(): boolean java | js | py

  /**
   * Whether this value type is a binary (of any size).
   *
   * @see BinaryType
   */
  isBinary: cached inline member function(): boolean java | js | py

  /**
   * Whether this type is a Boolean value.
   *
   * @see BooleanType
   */
  isBoolean: inline member function(): boolean java | js | py

  /**
   * Whether this type is a byte.
   *
   * @see ByteType
   */
  isByte: inline member function(): boolean java | js | py

  /**
   * Whether this type is a full (64 bit) integer.
   *
   * @see IntType
   */
  isInt: inline member function(): boolean java | js | py

  /**
   * Whether this type is a half (32 bit) integer.
   *
   * @see Int32Type
   */
  isInt32: inline member function(): boolean java | js | py

  /**
   * Whether this type is a quarter (16 bit) integer.
   *
   * @see Int16Type
   */
  isInt16: inline member function(): boolean java | js | py

  /**
   * Whether this type is an arbitrary-length integer.
   *
   * @see BigIntType
   */
  isBigInt: inline member function(): boolean java | js | py

  /**
   * Whether this type is a IEEE single precision number.
   *
   * @see FloatType
   */
  isFloat: inline member function(): boolean java | js | py

  /**
   * Whether this type is a IEEE double precision number.
   *
   * @see DoubleType
   */
  isDouble: inline member function(): boolean java | js | py

  /**
   * Whether this type is a arbitrary-precision decimal number.
   *
   * @see DecimalType
   */
  isDecimal: inline member function(): boolean java | js | py

  /**
   * Whether this value type is a date/time value (of any resolution).
   *
   * @see DateTimeType
   */
  isDateTime: cached inline member function(): boolean java | js | py

  /**
   * Whether this type is a JavaScript Object Notation object.
   *
   * @see JsonType
   * Whether this type is JavaScript Object Notation object.
   */
  isJson: inline member function(): boolean java | js | py

  /**
   * Whether this type is a typed JavaScript Object Notation object.
   */
  isTypedJson: inline member function(): boolean java | js | py

  /**
   * Whether this type is an untyped JavaScript Object Notation object.
   */
  isUntypedJson: inline member function(): boolean java | js | py

  /**
   * Whether this type is a number.
   *
   * @see NumberType
   */
  isNumber: inline member function(): boolean java | js | py

  /**
   * Whether this type is a text string.
   *
   * @see StringType
   */
  isString: cached inline member function(): boolean java | js | py

  /**
   * Whether this value type is a numeric primitive with an integer type.
   *
   * @see ByteType
   * @see IntType
   * @see Int32Type
   * @see Int16Type
   * @see BigIntType
   */
  isIntegralNumber: cached inline member function(): boolean java | js | py

  /**
   * Whether this value type is a numeric primitive with a real number type.
   *
   * @see DoubleType
   * @see FloatType
   * @see DecimalType
   */
  isRealNumber: cached inline member function(): boolean java | js | py

  /**
   * Whether this value type is a vector.
   *
   * @see VectorType
   */
  isVector: inline member function(): boolean java | js | py

  /**
   * Whether this value type is an explicit "void". This is a singleton representing no possible value.
   *
   * @see VoidType
   */
  isVoid: inline member function(): boolean java | js | py

  /**
   * Whether this value type is a {@link Boxed} C3 type reference. Non-specific value types such as `any` and "anyof"
   * require boxing during serialization to preserve the type information.
   */
  isBoxed: inline member function(): boolean java | js | py

  /**
   * Whether this type is a potentially boxed type; i.e. it's instances could be boxed; e.g. will return `true` for
   * `any` and of course for any value type that `isBoxed`. This returns true if the value should be boxed for
   * serialization.
   */
  isBoxedForSerialization: inline member function(): boolean

  /**
   * Whether this value type is a reference to a primitive value boxed in an instance of Boxed C3 type.
   */
  isBoxedPrimitive: cached inline member function(): boolean

  /**
   * Whether this value type is an array of references to a boxed primitive type.
   *
   * @see ArrayType
   * @see Boxed
   */
  isBoxedArray: inline member function(): boolean

  /**
   * @return whether this value type is a map whose elements are references to a boxed primitive type.
   *
   * @see MapType
   * @see Boxed
   */
  isBoxedMap: inline member function(): boolean

  /**
   * @return whether this value type is a set of references to a boxed primitive type.
   *
   * @see SetType
   * @see Boxed
   */
  isBoxedSet: inline member function(): boolean

  /**
   * @return whether this value type is a collection of references to a boxed primitive type.
   *
   * @see CollectionType
   * @see Boxed
   */
  isBoxedCollection: inline member function(): boolean

  /**
   * Whether this value type is an array of references.
   *
   * @see ArrayType
   * @see ReferenceType
   */
  isRefArray: inline member function(): boolean

  /**
   * Whether this value type is a map whose elements are references.
   *
   * @see MapType
   * @see ReferenceType
   */
  isRefMap: inline member function(): boolean

  /**
   * Whether this value type is a set of references.
   *
   * @see SetType
   * @see ReferenceType
   */
  isRefSet: inline member function(): boolean

  /**
   * Whether this value type is any collection of references.
   *
   * @see CollectionType
   * @see ReferenceType
   */
  isRefCollection: inline member function(): boolean java | js

  /**
   * Whether this value type specifies that a _non-empty_ value must be specified. This is normally the
   * {@link ValueModifier NON_EMPTY} modifier, but may also consider compound structure of more complex value types.
   */
  isNonEmpty: inline member function(): boolean java | js | py

  /**
   * Whether this value type specifies that a (possibly empty) value must be passed as an argument. This is either of
   * the `NON_OPTIONAL_PARAM` or `NON_EMPTY` {@link ValueModifier modifiers}.
   *
   * @see #isNonEmpty
   */
  isNonOptionalParam: inline member function(): boolean java | js | py

  /**
   * Whether this value type is any collection of numbers.
   *
   * @see CollectionType
   * @see NumberType
   */
  isNumCollection: inline member function(): boolean

  /**
   * Whether this value type is an array of numbers.
   *
   * @see ArrayType
   * @see NumberType
   */
  isNumArray: inline member function(): boolean

  /**
   * Whether this value type is map whose elements are numbers.
   *
   * @see MapType
   * @see NumberType
   */
  isNumMap: inline member function(): boolean

  /**
   * Whether this value type is any collection of string.
   *
   * @see CollectionType
   * @see StringType
   */
  isStrCollection: inline member function(): boolean

  /**
   * Whether this value type is an array of strings.
   *
   * @see ArrayType
   * @see StringType
   */
  isStrArray: inline member function(): boolean

  /**
   * Whether this value type is map whose elements are strings.
   *
   * @see ArrayType
   * @see StringType
   */
  isStrMap: inline member function(): boolean

  /**
   * Whether this value type is a {@link Timeseries}.
   */
  isTimeseries: inline member function(): boolean

  /**
   * Whether this value type is a tuple.
   *
   * @see TupleType
   */
  isTuple: inline member function(): boolean java | js | py

  /**
   * Whether this value type is a function.
   *
   * @see FunctionType
   */
  isFunction: inline member function(): boolean java | js | py

  /**
   * Whether this value type is a method that implements a type action.
   *
   * @see MethodType
   */
  isMethod: inline member function(): boolean java | js | py

  /**
   * Whether this value type is a lambda.
   *
   * @see LambdaType
   */
  isLambda: inline member function(): boolean java | js | py

  /**
   * Whether this value type represents a native type, directly supported through each language binding. Uses of
   * native implicitly include all other value types (since they can be represented in each language).
   *
   * @see NativeType
   */
  isNative: inline member function(): boolean java | js | py

  /**
   * Whether the value type has a reference to an enum.
   *
   * @see ReferenceType
   * @see Enum
   */
  isEnumRef: inline member function(): !boolean

  /**
   * Whether this value type is a reference to an {@link Obj}.
   * Note that this is *not* the equivalent of {@link #isReference}, since there exists references to {@link Value}.
   *
   * @see ReferenceType
   * @see Obj
   */
  isObjRef: inline member function(): boolean java | js | py

  /**
   * Whether this value type is a reference to the specified type. This is a convenience function that checks for
   * a reference type and then that the reference is to the specified type. Note that unlike #isAssignableTo, this
   * compares the exact type.
   */
  isReferenceTo: inline member function(type: !(Type | string)): boolean

  /**
   * Cast this value type into a primitive type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return primitive type or null
   */
  asPrimitiveType: member function(failIfNot: boolean, source: lambda(): string): PrimitiveType

  /**
   * Cast this value type into a number type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return native type or null
   */
  asNumberType: member function(failIfNot: boolean, source: lambda(): string): NumberType

  /**
   * Cast this value type into a datetime type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return native type or null
   */
  asDateTimeType: member function(failIfNot: boolean, source: lambda(): string): DateTimeType

  /**
   * Cast this value type into a number type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return native type or null
   */
  asStringType: member function(failIfNot: boolean, source: lambda(): string): StringType

  /**
   * Cast this value type into a reference type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return reference type or null
   */
  asReferenceType: member function(failIfNot: boolean, source: lambda(): string): ReferenceType

  /**
   * Cast this value type into an varReference type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return var reference type or null
   */
  asVarReferenceType: member function(failIfNot: boolean, source: lambda(): string): VarReferenceType

  /**
   * Cast this value type into a declared reference type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return declared reference type or null
   */
  asDeclaredReferenceType: member function(failIfNot: boolean, source: lambda(): string): DeclaredReferenceType

  /**
   * Cast this value type into a collection type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return collection type or null
   */
  asCollectionType: member function(failIfNot: boolean, source: lambda(): string): CollectionType

  /**
   * Cast this value type into an array type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return array type or null
   */
  asArrayType: member function(failIfNot: boolean, source: lambda(): string): ArrayType

  /**
   * Cast this value type into a set type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return set type or null
   */
  asSetType: member function(failIfNot: boolean, source: lambda(): string): SetType

  /**
   * Cast this value type into a map type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return map type or null
   */
  asMapType: member function(failIfNot: boolean, source: lambda(): string): MapType

  /**
   * Cast this value type into a stream type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return stream type or null
   */
  asStreamType: member function(failIfNot: boolean, source: lambda(): string): StreamType

  /**
   * Cast this value type into a push stream type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return push stream type or null
   */
  asPushStreamType: member function(failIfNot: boolean, source: lambda(): string): PushStreamType

  /**
   * Cast this value type into a event stream type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return event stream type or null
   */
  asEventStreamType: member function(failIfNot: boolean, source: lambda(): string): EventStreamType

  /**
   * Cast this value type into a tuple type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return tuple type or null
   */
  asTupleType: member function(failIfNot: boolean, source: lambda(): string): TupleType

  /**
   * Cast this value type into a function type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return function type or null
   */
  asFunctionType: member function(failIfNot: boolean, source: lambda(): string): FunctionType

  /**
   * Cast this value type into a method type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return method type or null
   */
  asMethodType: member function(failIfNot: boolean, source: lambda(): string): MethodType

  /**
   * Cast this value type into an anyof type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return anyof type or null
   */
  asAnyOfType: member function(failIfNot: boolean, source: lambda(): string): AnyOfType

  /**
   * Cast this value type into an any type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return any type or null
   */
  asAnyType: member function(failIfNot: boolean, source: lambda(): string): AnyType

  /**
   * Cast this value type into a native type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return native type or null
   */
  asNativeType: member function(failIfNot: boolean, source: lambda(): string): NativeType

  /**
   * Cast this value type into a lambda type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return lambda type or null
   */
  asLambdaType: member function(failIfNot: boolean, source: lambda(): string): LambdaType

  /**
   * Cast this value type into a vector type.
   *
   * @param failIfNot if true, throw an error instead of returning null
   * @param source if throwing an error, provides more detail in the message
   * @return vector type or null
   */
  asVectorType: member function(failIfNot: boolean, source: lambda(): string): VectorType

  /**
   * Whether or not there are any `mixing` reference types in this instance.
   *
   * @see ReferenceType#mixing
   */
  hasAnyMixing: abstract member function(): boolean

  /**
   * Returns true if there are no `mixing` reference types or if all `mixing` declarations matches the given type Name
   */
  hasValidMixing: abstract member function(typeName: !string): boolean

  /**
   * Whether or not this ValueType has any possible values.
   *
   * @see #possibleValues
   */
  hasPossibleValues: member function(): boolean

  /**
   * @return `true` if this type references valid C3 type
   *
   * @see ReferenceType
   */
  hasReference: cached abstract member function(): boolean

  /**
   * @return `true` if this type references a generic variable
   *
   * @see VarReferenceType
   */
  hasVarReference: cached abstract member function(): boolean

  /**
   * Look up the referenced C3 type and return it. For unbound variables or invalid type references, null is returned.
   *
   * @param failIfMissing if true, throw an error instead of returning null
   * @return loaded type
   *
   * @see #instanceType
   */
  dereference: member function(failIfMissing: boolean): Type java | js

  /**
   * Look up the referenced C3 type and return it's {@link TypeMeta}. For unbound variables or invalid type references,
   * null is returned.
   *
