/**
 * R : expression result type (PrimitiveType/Arry/Mapp)
 * readOnly ==> readOnly for app. its platform generated.
 * expr can be mixed-in - but that would limit the type to support only
 * one type.
 */
@deprecated(finalVersion='v7.9', details='use Expr')
type OldExpr<R> {

  @deprecated
  expr: string

  @deprecated
  bindings: map<string, Obj> not persistable

  @deprecated
  useBindings: boolean

  @deprecated
  result: R schema suffix 'R'

  @deprecated
  eval: function(expression: OldExpr<R>, obj: Obj): R

  @deprecated
  getVariables: function(expression: OldExpr<R>): [string]

  @deprecated
  parse: function(expression: OldExpr<R>): boolean
}
