/**
 * Columnar representation of a flat type (containing only primitive fields) for space optimization & ser/deser time
 * Currently skips fields like versionEdits / meta on the type. If those fields are important for the application, refrain
 * from converting to columnar format
 */
type Columnar<T> {

  /**
   * Convert an array of objects into columnar format
   */
  fromObjs: function(objStream: stream<T>, spec: ColumnarSpec): Columnar<T>

  /**
   * Convert a columnar object to stream of original objects
   */
  toObjs: member function(spec: ColumnarSpec): stream<T>

  /**
   * Construct the columnar version for the given type
   */
  typeConstructor: private inline function(t: !TypeMeta): !TypeMeta
}
