/**
 * Zip utility
 */
inline type Zip {

  /**
   * Compressed Zip as Content from a stream of contents
   */
  zip: function(contents: !?stream<Content>, contentLocationRoot: string serialized Url): !Content

  /**
   * Zips a stream of contents into a provided byte push steam
   */
  zip: function(zip: !push stream<byte>, contents: !?stream<Content>, contentLocationRoot: string serialized Url)

  /**
   * De-compress contents of a Zip as stream of contents
   */
  unzip: function(zip: !?Content, contentLocationRoot: string serialized Url): stream<Content>

  /**
   * Creates a Java native InputStream from a Java native ZipInputStream by concatenating each zip entry
   */
  unzipStream: private function(inputStream: @java(class='java.util.zip.ZipInputStream') !native,
                                ignoreFirstLineInEachEntry: boolean): @java(class='java.io.InputStream') !native
}
