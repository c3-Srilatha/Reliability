/**
 * Used for filtering the fields based on the passed spec.
 */
@beta
private type Log.AppProfile.FilterFieldSpec {

  /**
   * Specifies the matching behavior for the operation.
   *
   * strict: Peforms the exact match on the values.
   * includes: Allows wildcard matches, where the values can be included within a larger context.
   */
  match: !string enum ('strict', 'includes', 'matchPrefix', 'matchSuffix')

  /**
   * A list of values to be matched according to the specified matching behavior.
   */
  values: [!string]
}
