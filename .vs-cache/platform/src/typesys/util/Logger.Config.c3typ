/**
 * Config holding details for loggers
 */
@config(doNotDefaultIfMissing=true)
type Logger.Config mixes Config, Named {

  /**
   * level of the logger
   */
  level: !Logger.Level

  /**
   * Should log messages be recursively added from parent to child
   */
  notAdditive: boolean

  /**
   * In future [Pair<Logger.AppenderKind, Logger.Level>] and get rid of corresponding appenderLevel
   *
   * Type of appenders included on the logger
   */
  // TODO :PLAT-41706 CodeGen does not support pair in config child element
  appenders: [Logger.AppenderKind]

  /**
   * Corresponding appender level
   */
  appendersLevels: [Logger.Level]

  /**
   * Logger.Config by given loggerId in the current environment
   *
   * @param loggerName
   * @return Logger.Config by given loggerId in the current environment
   */
  forName: ~
}
