type RecursiveData mixes Value {

  /**
   * This function recursively crawls from your Persistable Type through populated reference fields. The recursion
   * requires at least 1 (at most 15) Source Objects from which it collects all related data. The function will continue
   * recursing through all reference and fkey fields given the following conditions:
   *    1. No circular references, a type-node can be visited once
   *    2. At most you can recurse 10 levels below the rootType (otherwise this routine might fetch the entire db)
   *    3. No recursing through cassandra types
   *
   *  Refer to @see RecursiveFetchSpec.excludedPaths and @see RecursiveFetchSpec.excludedTypes for more ways to tune this recursion.
   *
   * @param type
   *          The type to start the recursive fetch
   * @param spec
   *          The spec to do recursive fetch
   * @return RecursiveFetchResult The returned object has 3 fields:
   *    1. data, a serialized array of all relational data found during recursion
   *    2. model, a record of all the traversed references. Helpful for visualizing how things are related.
   *    3. cassandraKeys, this routine does not fetch any Cassandra types but it collects all the Cassandra-type + partition keys which you can use to fetch the cassandra objects on your own.
   */
  @action(group+='read')
  fetch: function(type: !Type, spec: !RecursiveFetchSpec): RecursiveFetchResult js-server

  /**
   * This function is a wrapper around the {@link RecursiveData.fetch} that writes all cassandra data to path and just returns {@link RecursiveFetchResult.data}. This action is used in {@link Export.exportRelatedData}.
   * @param type
   *          The type to start the recursive fetch export action
   * @param spec
   *          The spec to do recursive fetch
   * @param path
   *          The path of the export file location
   * @return The relational data found during recursion
   */
  exportAction: function(type: !Type, spec: !RecursiveFetchSpec, path: !string): ObjArry js-server

  /**
   * This function is used to import relational data generated by {@link RecursiveData.fetch}.
   * @param objArry
   *          The relational data to import
   */
  importAction: function(data: ObjArry) js-server
}
