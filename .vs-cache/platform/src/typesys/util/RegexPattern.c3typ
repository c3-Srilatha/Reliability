/**
 * C3 Type representing Java regex pattern.
 */
type RegexPattern mixes StringPattern {

  /**
   * @return compiled regex pattern
   */
  regex: inline member function(): !string

  compiled: private @java(class='java.util.regex.Pattern') !native

  /**
   * Option for sub-types to provide more specific match score for a given input string
   */
  computeMatchScore: private inline member function(str: !string): !double

  /**
   * Option for sub-types to map groups from Java regex matcher to StringPatternMatch#groups
   */
  mapMatchGroups: private inline member function(matchGroups: [string]): [string]
}
