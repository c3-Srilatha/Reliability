/**
 * This type implements SHA-512 secure hash algorithm.
 *
 * @see SHA256
 * @see https://en.wikipedia.org/wiki/SHA-2
 */
type SHA512 mixes MessageDigest {

  /**
   * The hash of an empty value.
   */
  EMPTY_HASH: const string = 'cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e'
}
