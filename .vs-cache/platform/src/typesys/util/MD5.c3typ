/**
 * This type implements MD5 hash algorithm.
 *
 * Note that this is not cryptographically secure; use {@link SHA256} if a secure hash function is needed.
 *
 * @see https://en.wikipedia.org/wiki/MD5
 */
type MD5 mixes MessageDigest {

  /**
   * The hash of an empty value.
   */
  EMPTY_HASH: const string = 'd41d8cd98f00b204e9800998ecf8427e'
}
