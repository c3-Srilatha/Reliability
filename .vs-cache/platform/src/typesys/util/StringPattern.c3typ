/**
 * An abstract C3 Type for representing String Pattern.
 *
 * @see RegexPattern
 * @see GlobPattern
 * @see CamelCasePattern
 */
abstract type StringPattern mixes StringSerializable {

  /**
   * The pattern to match against
   */
  pattern: !string

  /**
   * Test if input string matches this pattern.
   *
   * @param str
   *        string input to be matched
   * @return true if str matches the pattern.
   */
  isMatch: abstract inline member function(str: !?string): boolean

  /**
   * Match input string against multiple patterns and return true is at least one pattern matches.
   *
   * @param str
   *           string input to be matched
   * @param patterns
   *           list of patterns to match against
   * @return true if at least one pattern matches.
   */
  @beta
  matchAnyPattern: abstract inline function(str: !?string, patterns: ![string]): boolean

  /**
   * Compute match of the input string with this pattern.
   *
   * @param str
   *        string input to be matched
   * @return match details
   */
  match: abstract inline member function(str: !?string): !StringPatternMatch

  /**
   * Splits input string around matches of this pattern.
   *
   * @param str
   *        string input to be matched
   * @return matches
   */
  split: abstract inline member function(str: !?string, limit: int): [string]

  /**
   * Construct a specific StringPattern object from the given input pattern.
   *
   * @param s
   *           input pattern
   * @return the compiled pattern
   */
  fromString: abstract ~

  /**
   * Return a lambda that will perform matching according to logic of this pattern.
   */
  matcher: abstract inline member function(): !lambda(str: !?string): boolean

  toString: ~
}
