/**
 * Represents a single timestamped log entry in a C3 log, produced by {@link Logger} for an action.
 *
 * @see Log.Profile
 */
type Log.Entry mixes Log.EntryBase {

  timestamp: !~

  // ========================== Execution Context - Basic ==================================

  /**
   * Id of C3 node (e.g. task, data...) that log entry was logged from.
   */
  node: !string

  /**
   * Id of process that log entry was logged from.
   */
  process: !string

  /**
   * Id of thread that log entry was logged from.
   */
  thread: !string

  /**
   * Id of {@link Cluster} that log entry was logged from.
   */
  cluster: !string

  /**
   * Id of {@link Env} that log entry was logged from.
   */
  env: !string

  /**
   * Id of {@link App} that log entry was logged from.
   */
  app: !string

  /**
   * Id of {@link User} that logged the entry.
   */
  user: !string

  /**
   * Name of the type that log entry was logged from.
   */
  typeName: !string

  /**
   * Name of the action that log entry was logged from.
   */
  actionName: !string

  // RequestId of the Http request that triggered the Action
  requestId: !string

  // ========================== Execution Context - Lineage ==================================

  /**
   * Id of the current action.
   */
  action: !string

  /**
   * Id of the parent action for the current action.
   */
  actionParent: !string

  /**
   * Id of the root action for the current action.
   */
  actionRoot: !string

  /**
   * Id of async action call (i.e. the one to submit to queue). Optional - only use if running as part of async action.
   */
  asyncParent: string

  /**
   * Id of root async action call. Optional - only use if running as part of async action.
   */
  asyncRoot: string

  /**
   * Depth of async action call. Optional - only use if running as part of async action.
   */
  asyncDepth: int

  /**
   * Id of the current job. Generally, the job is triggered by an async action. {@link #async} records the
   * id of the action submitting the job to the queue, whereas this records the id of the job itself.
   * Optional - only use if running as part of job.
   */
  job: string

  /**
   * Id of the parent job. Optional - only use if running as part of job.
   */
  jobParent: string

  /**
   * Id of the root job. Optional - only use if running as part of job.
   */
  jobRoot: string

  /**
   * String representing the ids of the parent actions separated by colon. Optional - null if the action is root action
   */
  parentActionIds: string

  /**
   * Unique identifier of the TypeName#ActionName call.
   */
  actionFunc: string

  /**
   * String representing the {@link #actionFunc} of the parent actions separated by colon. Optional - null if the action is root action
   */
  parentActionFuncs: string

  // ========================== Execution Context - Fetch ==================================

  /**
   * The fetch filter that was used to fetch the data
   */
  fetchFilter: string

  /**
   * The fetch include that was used to fetch the data
   */
  fetchInclude: string

  // =================================== Custom Content ======================================
  toString: ~

  fromString: ~

  /**
   * Same as {@link #fromString}, except does not attempt to construct sub-types of {@link Log.Entry}. In other words,
   * this constructor will always return an instance of the type it is called on (or null).
   */
  baseEntryFromString: ~: Log.Entry
}
