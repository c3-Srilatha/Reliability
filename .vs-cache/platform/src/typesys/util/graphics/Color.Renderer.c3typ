/**
 * Produce HTML to show a color.
 *
 * @see Color
 */
type Color.Renderer mixes HtmlRenderer {

  _color:    private !string serialized Color
  menuTitle: ~ java | js-client
  title:     ~ java | js-client
  toHtml:    ~ java | js-client
}
