/**
 * All functions produce React components and thus can only be used on the client. Note that these can be created
 * given the raw data, but are more usually created using the methods defined on {@link ChartBuilder}.
 */
type ReactChart mixes ChartBuilder, ReactClass {

  /**
   * ECharts chart type.
   */
  chart: !string

  /**
   * The data used for the chart.
   */
  data: !any

  /**
   * Options for rendering the chart.
   */
  spec: ChartSpec

  line:      ~: native js-client
  sparkline: ~: native js-client
  column:    ~: native js-client
  bar:       ~: native js-client
  scatter:   ~: native js-client
  pie:       ~: native js-client
}
