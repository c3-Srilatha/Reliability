/**
 * The "kinds" of colormaps:
 *  - sequential: information that has ordering
 *  - diverging: information has a critical middle value
 *  - cyclic: values wrap around at the ends
 *  - qualitative: information that does not have ordering
 *
 * @see ColorMap
 */
enum type ColorMap.Kind {

  /**
   * information that has ordering
   */
  SEQUENTIAL

  /**
   * information has a critical middle value
   */
  DIVERGING

  /**
   * values wrap around at the ends
   */
  CYCLIC

  /**
   * information that does not have ordering
   */
  QUALITATIVE
}
