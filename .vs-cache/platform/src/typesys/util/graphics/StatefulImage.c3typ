/**
 * Stateful image representation.
 * Not yet fully implemented
 * Remove abstract for full implement this type
 */
// TODO https://c3energy.atlassian.net/browse/PLAT-38125 - Implement StatefulImage in V8
abstract type StatefulImage mixes Stateful, StringSerializable, Image {

  fromFile:         ~
  fromMediaContent: ~
  save:             ~
  mediaType:        ~
  toImageContent:   ~

  /**
   * Lookup a stateful image by id.
   */
  // TODO: remove?
  forId: function(id: !?string, failIfMissing: boolean): StatefulImage

  /**
   * All instances of images in memory.
   */
  // TODO: remove?
  all: function(): [StatefulImage]

  /**
   * Clones this image.
   */
  clone: member function(): !StatefulImage

  /**
   * Discards this image effectively making this instance of the dataset unusable after this call.
   */
  // TODO: remove?
  close: member function()

  /**
   * Construct image from id.
   */
  // TODO: remove?
  fromString: ~ java | py

  /**
   * Serialize image using it's id.
   */
  // TODO: remove?
  toString: ~ java | py

  /**
   * Set pixel on image.
   */
  setRgb: member function(x: !int32, y: !int32, r: !int32, g: !int32, b: !int32): !mixing StatefulImage

  /**
   * Display image nicely in jupyter
   */
  visualize: inline member function(maxWidth: int32, maxHeight: int32): native py
}
