native py remix type Image {

  /**
   * Converts image to numpy array of shape (width X height X colors), where colors encoded as 3 uint8 numbers.
   */
  _array_: ~ py

  to_numpy: member function(dtype: native): native py-matplotlib

  /**
   * Display image nicely in jupyter
   */
  visualize: member function(maxWidth: int32): !native py
}
