/**
 * C3 type holding a video. Also provides simple way of authoring videos.
 */
abstract type Video mixes VisualMedia {

  /**
   * convert a video to stream of frames images.
   */
  frames: abstract member function(spec: VideoOperSpec): stream<VideoFrame>
}
