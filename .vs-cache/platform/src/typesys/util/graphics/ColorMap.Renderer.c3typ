/**
 * This renderer displays the color map as a list of swatches (for qualitative maps) or a sequence of colors (for
 * other kinds). The produced HTML element is a `<table>` with a cell for each color.
 */
type ColorMap.Renderer mixes HtmlRenderer {

  colormap:  !ColorMap
  menuTitle: ~ java | js
  title:     ~ java | js
  toHtml:    ~
  render:    ~ js-browser
}
