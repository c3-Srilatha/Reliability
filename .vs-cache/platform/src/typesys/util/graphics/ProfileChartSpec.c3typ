/**
 * Options for building a static flame/icicle graph from a set of stack trees.
 *
 * @see ChartBuilder#stacks
 * @see http://www.brendangregg.com/FlameGraphs/cpuflamegraphs.html
 */
type ProfileChartSpec mixes ChartSpec {

  /**
   * Which style of graph to generate. The same information is presented in both case, except that "flame" graphs
   * have the root elements and the bottom and the call stack depth increases upward while "icicle" graphs are
   * rooted at the top and grow downwards.
   */
  style: string enum('icicle', 'flame') = 'icicle'

  /**
   * Option to limit the depth of the trees presented.
   */
  maxDepth: int = -1
}
