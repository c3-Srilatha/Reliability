/**
 * Options for building a chart.
 */
type ChartSpec mixes Spec {

  /**
   * Logical width of the chart image.
   */
  width: int

  /**
   * Logical height of the chart image.
   */
  height: int

  /**
   * A title to display at the top or left of the chart.
   */
  title: string

  /**
   * The label for the category axis (X axis for horizontal orientation).
   */
  categoryAxisLabel: string

  /**
   * The label for the value axis (Y axis in horizontal orientation).
   */
  valueAxisLabel: string

  /**
   * Whether to put labels on the category axis (X axis).
   */
  categoryLabels: boolean

  /**
   * Whether to put labels on the value axis (Y axis).
   */
  valueLabels: boolean

  /**
   * Whether to draw min and maximum lines and labels on value axis.
   */
  gridLines: boolean

  /**
   * Whether to draw an extra element at points in the line graph.
   */
  points: boolean

  /**
   * The plot orientation (horizontal or vertical). Not all chart types will support vertical.
   */
  plotOrientation: string enum('HORIZONTAL', 'VERTICAL')

  /**
   * Whether to display a legend alongside the chart. Not all chart types will support legends.
   */
  legend: boolean

  /**
   * Whether to generate tooltips at data points.
   */
  tooltips: boolean

  /**
   * Whether to display a linear regression trend line among the values.
   */
  trend: boolean

  /**
   * Whether to include 0 in the value axis, even if all values are positive.
   */
  includeZero: boolean

  /**
   * Include this value in the value axis, even if outside all the samples.
   */
  maxValue: double

  /**
   * Whether to fill missing values or have gap in the line
   */
  fillMissing: boolean

  /**
   * CSS style for chart lines. The default is a solid black line.
   */
  lineStyle: string

  /**
   * The unit used for rendering values in tool tips if the data set does not include dimensioned values.
   */
  unit: Unit

  /**
   * Indexes in the data to be highlighted.
   */
  xHighlights: [ChartXHighlight]
}
