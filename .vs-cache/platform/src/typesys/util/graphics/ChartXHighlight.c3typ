/**
 * Specification of a single chart X axis highlight.
 *
 * @see ChartSpec
 */
type ChartXHighlight {

  /**
   * Index of starting point for the highlight.
   */
  x: !int

  /**
   * Index of ending point (exclusive) for the highlight. If unspecified, the highlight is only for the #x index.
   */
  xEnd: int

  /**
   * String to be displayed when the highlight is hovered over.
   */
  tooltip: string
}
