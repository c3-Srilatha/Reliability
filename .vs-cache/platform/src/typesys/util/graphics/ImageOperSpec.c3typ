/**
 * Options to operate on an image
 */
type ImageOperSpec mixes Spec {

  /**
   * if specified will convert to {@link MediaType} specifically VisualMediaType
   */
  contentType: string

  /**
   * if specified will scale to width
   */
  width: int

  /**
   * if specified will scale to height
   */
  height: int

  /**
   * Number of channels for image eg R G B A
   */
  channelCount: int

  /**
   * Number of pixels in the image
   */
  pixelCount: int
}
