/**
 * Immutable representation of images in C3
 */
type ImageContent mixes Image, ContentValue {

  /**
   * Private property to cache parsed image. It should optimize operations on images.
   */
  parsedContent: private cached property(): @java(class="java.awt.image.BufferedImage") native

  fromMediaContent: ~
  rawBinary:        ~
  draw:             ~
  scale:            ~
  resize:           ~
  crop:             ~
  flip:             ~
  rotate:           ~
  toGrayscale:      ~
  rgb:              ~
  rgbData:          ~
}
