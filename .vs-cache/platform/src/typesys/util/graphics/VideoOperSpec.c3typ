/**
 * Options to operate on a video
 */
type VideoOperSpec mixes ImageOperSpec {

  /**
   * start offset inclusive for video to operate on, if not specified will operate from start of the video
   */
  startOffsetSec: int

  /**
   * end offset exclusive for video to operate on, if not specified will operate till the end of the video
   */
  endOffsetSec: int
}
