/**
 * A "color map" is a set of colors values which can be used as a pleasing palette for graphing or as a sequential
 * set of values that indicate intensity.
 *
 * The "kinds" of colormaps are:
 *  - sequential: information that has ordering
 *  - diverging: information has a critical middle value
 *  - cyclic: values wrap around at the ends
 *  - qualitative: information that does not have ordering
 *
 * The terminology and default set of colormaps is borrowed from
 * [matplotlib](https://matplotlib.org/stable/tutorials/colors/colormaps.html).
 */
type ColorMap mixes WithName, HtmlRenderable {

  /**
   * If the colormap is a standard one, it will have a name.
   */
  name: ~

  /**
   * The "class" of colormap, which defines its applicability.
   */
  kind: !string enum ColorMap.Kind

  /**
   * The set of colors in the map. For qualitative color maps, these values should be used directly.
   * For other kinds, the #scalar function should be used.
   */
  colors: ![!string serialized Color]

  /**
   * Colormaps may specify a special color to be used for invalid values, such as `null` or `NaN`. Otherwise, no
   * color is used.
   */
  bad: string serialized Color

  /**
   * Colormaps may specify a special color to be used for values under the expected range. Otherwise, this is usually
   * the first listed color or the start of the spectrum.
   */
  under: string serialized Color

  /**
   * Colormaps may specify a special color to be used for values over the expected range. Otherwise, this is usually
   * the last listed color or the end of the spectrum.
   */
  over: string serialized Color

  /**
   * Return a color in the colormap by interpolating between the fixed set of colors.
   *
   * The value is in the range [0..1]. For diverging colormaps, 0.5 is the desaturated diverging point.
   *
   * This does not make sense for qualitative color maps.
   */
  scalar: member function(v: !double): !string serialized Color java | js

  /**
   * Return one of the seed colors in the colormap by index. If the value is out of range, it wraps around.
   *
   * This makes the most sense for qualitative color maps.
   */
  index: member function(i: !int): !string serialized Color java | js

  /**
   * Produce a new color map with the same colors as this one, reversed.
   */
  reversed: member function(): !ColorMap

  /**
   * Get the names of the standard colormaps. These are a subset of ones defined in
   * [matplotlib](https://matplotlib.org/stable/tutorials/colors/colormaps.html).
   *
   * @param kind if specified, only names of this kind of color map are returned
   *
   * @see #forName
   */
  names: cached function(kind: string enum ColorMap.Kind): [!string]

  /**
   * Get one of the standard colormaps by name. These are a subset of ones defined in
   * [matplotlib](https://matplotlib.org/stable/tutorials/colors/colormaps.html).
   *
   * @see #names
   */
  forName: cached function(name: !string, failIfMissing: boolean): mixing ColorMap

  /**
   * Create a sequential color map given at least two color values. The first value is the low end the last value is
   * the high end. Other values are used for interpolation in even steps.
   */
  sequential: function(colors: ![!string serialized Color], name: string): !ColorMap java | js

  /**
   * Create a sequential color map given at least three color values. The number of colors must be odd. The first
   * value is the low end, the middle value is the divergence point, and the last value is the high end. Other
   * values are used for interpolation in even steps.
   */
  diverging: function(colors: ![!string serialized Color], name: string): !ColorMap java | js

  /**
   * Create a cyclic color map given at least three color values. The first and last value must be the same (to
   * create the cycle).
   */
  cyclic: function(colors: ![!string serialized Color], name: string): !ColorMap java | js

  /**
   * Create a qualitative color map given at least two color values.
   */
  qualitative: function(colors: ![!string serialized Color], name: string): !ColorMap java | js

  /**
   * Create a PNG image file that contains a preview of this colormap. If this is a qualitative colormap, there will be
   * one horizontal tile for each color and otherwise, it will be a gradient across the range [0..1] (see #scalar).
   * The aspect ratio should be much wider than tall since there is only a horizontal layout.
   *
   * @param width width of the image (should be at least 256 pixels)
   * @param height height of the image (should be tall enough to see)
   */
  previewImage: member function(width: !int32 = 256, height: !int32 = 24): !Image

  /**
   * Create a PNG image file that contains a preview of the named colormap. If this is a qualitative colormap, there
   * will be one horizontal tile for each color and otherwise, it will be a gradient across the range [0..1]
   * (see #scalar). The aspect ratio should be much wider than tall since there is only a horizontal layout.
   *
   * @param name the name of the image; see #forName
   * @param width width of the image (should be at least 256 pixels)
   * @param height height of the image (should be tall enough to see)
   * @param failIfMissing if there is no standard colormap with that name, throw an error instead of returning null
   */
  previewImageFor: function(name: !string, width: !int32 = 256, height: !int32 = 24, failIfMissing: boolean): Image

  _standard: private cached function(): map<string, native>
  renderer:  ~: !ColorMap.Renderer java | js
}
