/**
 * Python-specific remix of {@link BoundingBox} adding to_numpy.
 */
native py remix type BoundingBox {

  /**
   * @returns a numpy array containing the cv2 representation of the boxes
   */
  _array_: ~ py

  to_numpy: member function(dtype: native): native py
}
