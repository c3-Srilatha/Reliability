/**
 * Spec that exposes options to draw {@link BoundingBox} on {@link ImageContent}.
 */
type BoundingBoxDrawingSpec mixes Spec {

  /**
   * Color of the font. Defaults to white
   */
  fontColor: Color = "white"

  /**
   * Color of the boxes to draw. Defaults to red
   */
  boxColor: Color = "red"

  /**
   * Thickness of the box in px.
   */
  // @constraint(condition='$ > 0')
  boxStrokeWidth: int = 3

  /**
   * Offset between the top of the bounding box and the text in px.
   */
  fontYOffset: int = -10

  /**
   * Font stroke width in px.To disable font stroke, set this field to 0.
   */
  fontStrokeWidth: int = 1

  /**
   * Font stroke color. Defaults to black
   */
  fontStrokeColor: Color = "black"

  /**
   * Size of the font in px.
   */
  // @constraint(condition='$ > 0')
  fontSize: int = 14
}
