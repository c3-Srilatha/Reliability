/**
 * A block that declares the footnote body, such as:
 * ```
 * [^1]: A fasscinating aside.
 * ```
 *
 * One or more footnote links (references) should refer to this such as "[^1]" somewhere in the regular content.
 *
 * @see MarkdownFootnoteLink
 */
type MarkdownFootnoteBody mixes MarkdownNode {

  /**
   * The declared footnote label. All links to this footnote must use the same label. This can be any sequence of
   * non-whitespace characters.
   */
  label: member function(): !string
}
