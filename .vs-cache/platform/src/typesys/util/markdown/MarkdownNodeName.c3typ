/**
 * Each node of the parsed Markdown has a name that relates to the CommonMark spec, plus the some of the GitHub
 * Flavored Markdown (GFM) extensions.
 *
 * @see MarkdownNode
 */
enum type MarkdownNodeName {

  BlockQuote
  BulletList
  Code
  Document
  Emphasis
  FencedCodeBlock
  HardLineBreak
  Heading
  HtmlBlock
  HtmlInline
  Image
  IndentedCodeBlock
  Link
  ListBlock
  ListItem
  OrderedList
  Paragraph
  SoftLineBreak
  Strikethrough
  StrongEmphasis
  TableBlock
  TableBody
  TableCell
  TableHead
  TableRow
  Text
  ThematicBreak
}
