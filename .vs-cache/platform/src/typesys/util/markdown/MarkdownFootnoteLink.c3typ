/**
 * A link (reference) to a footnote in parsed Markdown, such as "[^1]" or "[^foo]".
 *
 * It is also possible to use "inline footnotes" without a separate body: `text^[footnote body]`. This means
 * there will be no separate body in the Markdown tree and the renderer is responsible for using the children of
 * the inline footnote correctly at the end of the document.
 *
 * @see MarkdownFootnoteBody
 */
type MarkdownFootnoteLink mixes MarkdownLink {

  /**
   * The declared footnote label for regular footnotes. There must be a {@link MarkdownFootnoteBody body} with the same
   * label to provide the definition.
   *
   * For inline footnotes, this label is generated and there will be no separate body.
   */
  label: member function(): !string

  /**
   * Whether this is an "inline footnote" that defines its own body.
   *
   * For inline footnotes, the children make the body (definition).
   */
  isInline: member function(): boolean

  destination: ~
  anchor:      ~
  title:       ~
  text:        ~
}
