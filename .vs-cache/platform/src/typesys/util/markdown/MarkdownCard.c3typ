/**
 * A Markdown card is a section displayed with a rectangular border and arranged across the page in rows and columns.
 * This is a way to highlight a small amount of information about a set of topics that are visually distinct.
 * Each card body may link to another topic, type documentation, or an external link.
 *
 * ```md
 * [[[ Ace ]]]
 * ## Ace
 * A playing card, die or domino with a single pip.
 * [[[ Deuce ]]]
 * ## Deuce
 * The word _Daus_ as a description of the two pips on a die has been in use since the 12th century.
 * [[[ King ]]]
 * ## King
 * A playing card with a picture of a king displayed on it.
 * [[[ ]]]
 * ```
 *
 * [[[ Ace ]]]
 * ## Ace
 * A playing card, die or domino with a single pip.
 * [[[ Deuce ]]]
 * ## Deuce
 * The word _Daus_ as a description of the two pips on a die has been in use since the 12th century.
 * [[[ King ]]]
 * ## King
 * A playing card with a picture of a king displayed on it.
 * [[[ ]]]
 *
 * It is not necessary to use a closing `[[[` line between successive cards; all sequences of cards with no intervening
 * markup will be put into the same grid. Of course, the last card in the sequence must be ended since all other
 * markup is allowed within a card.
 *
 * The number of open and close brackets used does not matter since cards cannot nest. However, at least three must be
 * used.
 *
 * The text between the brackets of the opening lines is simply a title and does not appear in the card,
 * however it must be present to distinguish the closing and opening lines. It may be used for a link tooltip,
 * alt text or similar. Any content to appear in the card must be put into the body.
 *
 * The default is three columns, but this can be adjusted by specifying the number of `cols` (from 1 through 6)
 * as an attribute of the first card:
 *
 * ```md
 * [[[ title ]]] {cols=4}
 * ```
 *
 * It is also possible to assign a link so that when the card itself is clicked the page navigates to another topic
 * or external link using the `href` attribute:
 *
 * ```md
 * [[[ MarkdownCard ]]] {href="MarkdownCard"}
 * ## MarkdownCard
 * This type represents the parsed Markdown node for a single "card".
 * [[[ ]]]
 * ```
 *
 * @see MarkdownHeading
 */
type MarkdownCard mixes MarkdownNode {

  /**
   * The maximum allowable number of columns.
   */
  MAX_COLS: const !int32 = 6

  /**
   * The default number of columns.
   */
  DFLT_COLS: const !int32 = 3

  /**
   * The desired number of columns, specified on the first card in a sequence. If unspecified this will default to
   * #DFLT_COLS.
   */
  cols: member function(): !int32

  /**
   * The link target if the card itself is clicked.
   */
  href: member function(): string

  /**
   * The title from between the opening brackets.
   */
  title: member function(): !string

  /**
   * The name associated with the sequence of cards (the "cardset").
   */
  name: member function(): string
}
