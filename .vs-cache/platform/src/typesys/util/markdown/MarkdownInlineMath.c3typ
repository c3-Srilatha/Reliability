/**
 * LaTeX inline math expression in Markdown, delimited with `$$`, such as: $$k_{n+1} = n^2 + k_n^2 - k_{n-1}$$.
 *
 * ```md
 * ... such as: $$k_{n+1} = n^2 + k_n^2 - k_{n-1}$$.
 * ```
 *
 * @see MarkdownNode
 * @see MarkdownDisplayMath
 * @see https://en.wikibooks.org/wiki/LaTeX/Mathematics
 */
type MarkdownInlineMath mixes MarkdownNode
