/**
 * A link in parsed Markdown.
 *
 * @see MarkdownNode
 * @see MarkdownImage
 */
type MarkdownLink mixes MarkdownNode {

  /**
   * Get the destination of the link.
   */
  destination: member function(): string

  /**
   * Get the anchor text (in square brackets). Note that the child nodes could actually contain further formatting,
   * such as `[a **strong** link](https://www.merriam-webster.com/dictionary/strong)`.
   *
   * @see #text
   */
  anchor: member function(): string

  /**
   * Get the optional title (after the destination).
   */
  title: member function(): string
}
