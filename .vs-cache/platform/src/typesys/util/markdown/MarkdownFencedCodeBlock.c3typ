/**
 * A fenced code block in parsed Markdown.
 *
 * @see MarkdownIndentedCodeBlock
 */
type MarkdownFencedCodeBlock mixes MarkdownNode {

  /**
   * Get the extra info specified on the first line of this block. This starts with the language, but may have other
   * directives such as the line(s) to highlight.
   */
  info: member function(): string

  /**
   * Extract the specified language, which is the first word of the #info. This is returned exactly as specified in
   * the markup, which may be a full language name such as "Python" (any case) or an abbreviation such as "py".
   * It may also be something that isn't an implementation language, such as "json" or "type".
   *
   * @see #implLanguage
   */
  language: member function(failIfMissing: boolean): string

  /**
   * Extract the implementation language, which is the first word of the #info. This must correspond to a known
   * language (either full name or standard abbreviation).
   *
   * @see #language
   */
  implLanguage: member function(failIfInvalid: boolean): ImplLanguage

  /**
   * A set of lines to be highlighted in the code block. This is specified using `highlight={}...` where the text
   * between the braces is returned by this method.
   *
   * One or more line ranges can be be specified, separated by commas. Lines are 1-based and ranges are inclusive:
   *  - `highlight={3}` just the third line
   *  - `highlight={2-4}` lines 2, 3, and 4 (inclusive)
   *  - `highlight={1, 5}` the first and fifth lines only
   *
   * It is also possible to specify spans within the line using a period to separate the line number and character
   * number (also 1-based). For example, in the snippet below the return value expression is specified using
   * `highlight={2.12 - 2.16}`.
   *
   * ```py highlight={2.12 - 2.16}
   * def sum(a, b)
   *     return a + b
   * ```
   *
   * @see MarkdownFencedCodeBlock.Highlights
   */
  highlight: member function(): string serialized MarkdownFencedCodeBlock.Highlights

  /**
   * A set of lines to be highlighted in the code block, parsed with invalid specifications removed.
   *
   * @see #highlight
   */
  parsedHighlight: member function(): MarkdownFencedCodeBlock.Highlights

  /**
   * Get the line number of the first line of code, if known.
   */
  codeLineNumber: member function(): int32

  /**
   * Get the overall indentation of the code block.
   */
  indent: member function(): !int32

  /**
   * Parse an #info string into three parts:
   *  - the #language (first word)
   *  - a #highlight specification
   *  - any other text in the info
   *
   * @param info the extra info on the first line of a block
   * @return triple if any data is found, or null if the info is empty
   */
  parseInfo: function(info: !?string): Triple<string, string serialized MarkdownFencedCodeBlock.Highlights, string>
}
