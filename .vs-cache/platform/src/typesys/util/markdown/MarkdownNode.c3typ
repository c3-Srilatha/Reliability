/**
 * Each node of the parsed Markdown contains its own state and possibly child nodes. Many of the types are just markers
 * for formatting, but some have complex sub structure, such as {@link MarkdownTable}.
 *
 * @see Markdown
 */
abstract type MarkdownNode mixes WithToString {

  /**
   * The node type from the CommonMark spec, such as "Heading" or "Emphasis".
   */
  nodeName: member function(): !string enum MarkdownNodeName

  /**
   * If this node is made up of simply text with a style, get that text. For example, the {@link MarkdownEmphasis}
   * node `_good_` would have a the text "good". Note that the text may contain only whitespace, for example for
   * plain whitespace between other nodes.
   */
  text: member function(): ?string

  /**
   * Get the line number of this structure, if known. This should be the start of the structure, but is generally
   * only available for block nodes.
   */
  lineNumber: member function(): int32

  /**
   * Whether or not this node has interesting (non text) children. Most blocks always have children and most inline
   * styles do not, although they will if inline styles are nested.
   */
  hasChildren: member function(): boolean

  /**
   * The immediate child nodes. These may have structure and/or rendering semantics or may be just
   * {@link MarkdownText text}.
   */
  children: member function(): stream<MarkdownNode>

  /**
   * Construct the corresponding type instance from the CommonMark instance. This will throw an exception on an
   * unsupported node type. Note that some nodes are ignored in the input and for these this method will return null.
   */
  fromParsed: private function(node: @java(class='org.commonmark.node.Node') !native): MarkdownNode

  /**
   * Renders this node to Markdown syntax.
   *
   * Note that it doesn't preserve the exact syntax of the original input Markdown (if any). However, it should produce
   * Markdown that is semantically equivalent to the input.
   */
  toString: ~

  parsed: private @java(class='org.commonmark.node.Node') !native
}
