/**
 * A Markdown table (GitHub flavored). It will have one {@link MarkdownTableHead} and optionally a
 * {@link MarkdownTableBody}. Both contain {@link MarkdownTableRow}s and {@link MarkdownTableCell}s.
 *
 * @see MarkdownTableHead
 * @see MarkdownTableBody
 * @see MarkdownTableRow
 */
type MarkdownTable mixes MarkdownNode
