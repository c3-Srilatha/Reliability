/**
 * A Markdown block containing quoted text, lines beginning with `> `.
 *
 * This also supports "callouts" (or "alerts"), which create specially declared block quotes. For example:
 * ```md
 * > [!NOTE]
 * > Useful information that users should know, even when skimming content.
 * ```
 *
 * @see https://docs.github.com/en/get-started/writing-on-github/getting-started-with-writing-and-formatting-on-github/basic-writing-and-formatting-syntax#alerts
 */
type MarkdownBlockQuote mixes MarkdownNode {

  /**
   * If this is an callout, the type specified (such as "NOTE").
   */
  calloutType: member function(): string

  /**
   * If this is a callout, the title specified or defaulted (such as "Note"). There may be additional markup if
   * the title is specified by the user on the same line as the type:
   * ```
   * > [!TIP] Performance
   * > This operation is costly and should be called only when necessary.
   * ```
   */
  calloutTitle: member function(): MarkdownParagraph

  /**
   * Whether this is a callout, with the "[!type]" syntax, plus some other content.
   */
  isCallout: member function(): boolean
}
