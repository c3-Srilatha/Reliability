/**
 * LaTeX display math in Markdown, delimited with `$$` as a paragraph by itself, such as:
 *
 * $$
 * \frac{n!}{k!(n-k)!} = \binom{n}{k}
 * $$
 *
 * ```md
 * $$
 * \frac{n!}{k!(n-k)!} = \binom{n}{k}
 * $$
 * ```
 *
 * @see MarkdownNode
 * @see MarkdownInlineMath
 * @see https://en.wikibooks.org/wiki/LaTeX/Mathematics
 */
type MarkdownDisplayMath mixes MarkdownNode
