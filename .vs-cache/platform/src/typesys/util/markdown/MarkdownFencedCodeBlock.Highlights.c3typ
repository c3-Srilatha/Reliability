/**
 * A set of highlighted line and/or column ranges.
 *
 * One or more line ranges can be be specified, separated by commas. Lines are 1-based and ranges are inclusive:
 *  - `3` just the third line
 *  - `2-4` lines 2, 3, and 4 (inclusive)
 *  - `1,5` the first and fifth lines only
 *
 * Here we're highlighting the key lines in the Christmas rhyme (1-2, 9, 13):
 *
 * ```song highlight={1-2, 9, 13}
 * On the twelveth day of Christmas, my true love gave to me:
 *   Twelve drummers drumming,
 *   Eleven pipers piping,
 *   Ten lords a-leaping,
 *   Nine ladies dancing,
 *   Eight maids a-milking,
 *   Seven swans a-swimming,
 *   Six geese a-laying,
 *   Five golden rings;
 *   Four calling birds,
 *   Three french hens,
 *   Two turtle doves,
 *   And a partridge in a pear tree.
 * ```
 *
 * It is also possible to specify spans within the line using a period to separate the line number and character
 * number (also 1-based). For example, in the snippet below the return value expression is specified by `2.12-2.16`.
 *
 * ```py highlight={2.12-2.16}
 * def sum(a, b)
 *     return a + b
 * ```
 *
 * If code syntax highlighting does not support column ranges, the whole line is highlighted instead.
 *
 * Leading zeros in numbers and spaces around dashes and commas are ignored.
 *
 * Full-line ranges that overlap are merged. For example, "1-2, 2.3-2.8, 3-4, 1-4" becomes "1-4, 2.3-2.8".
 * This does _not_ merge adjacent ranges nor does it touch ranges with columns.
 *
 * @see MarkdownFencedCodeBlock#highlights
 */
type MarkdownFencedCodeBlock.Highlights mixes StringSerializable {

  /**
   * One or more highlighted ranges.
   */
  ranges: ![!MarkdownFencedCodeBlock.Highlight]

  /**
   * Whether there is more than one range specified (#ranges size is > 1).
   */
  isMultiRange: member function(): boolean

  /**
   * Whether more than one line is involved in all the ranges.
   */
  isMultiLine: member function(): boolean

  /**
   * Whether all ranges start at the beginning and continue to the end of their lines.
   */
  isFullLines: member function(): boolean

  /**
   * Remove columns and simplify to whole lines.
   */
  linesOnly: member function(): !mixing MarkdownFencedCodeBlock.Highlights

  /**
   * Apply the highlighting to a block of text. This inserts the lead and tail sequences at the points
   * specified by the highlights.
   *
   * If specified, the #process the lambda is applied _after_ determining string offsets and _before_ reassembling the
   * #split strings. For example, Str#escapeHtml could be used when building an HTML string. Note that process is _not_
   * applied to the #lead and #tail.
   *
   * If highlights overlap, the one starting earliest takes precendence.
   *
   * @param s string to highlight
   * @param lead the string to insert at the start of each range
   * @param tail the string to start at the end of each range
   * @param process lambda to process each section before reassembling the string
   * @return highlighted string
   */
  apply: member function(s: !?string, lead: !?string, tail: !?string, process: lambda(s: !?string): ?string): string

  /**
   * Split a block of text at the highlight points. The number of strings returned will always be odd. If there are no
   * valid highlights in the block, a single string will be returned. Otherwise, the strings will alternate between
   * unhighlighted and highlighted sections with the first and last unhighlighted. Any unhighlighted section may be
   * zero length, for example if the highlight starts at the beginning of the block.
   *
   * If highlights overlap, the one starting earliest takes precendence.
   *
   * For full-line ranges, the terminating newline will be part of the split and the following string will begin the
   * new line. This means any line endings that are part of the highlight will appear within it. This is not true
   * for ranges with column positions; those will not include the terminating newline even if longer than the actual
   * line.
   */
  split: member function(s: !?string): ![?string]
}
