/**
 * A heading in parsed Markdown.
 *
 * Note that in addition to normal headings, they may be used to define pages of tabbed content. A sequence of tab
 * headings (at the same level) will be rendered as a tab group with the contents of each section as a tab and the
 * title of the heading as the tab text. Tab groups may not nest, but it is fine to have normal headings within a
 * tab (at deeper levels of nesting).
 *
 * ```md
 * # Regular H1
 * Normal paragraph text.
 *
 * == First
 * Content of tab 1.
 *
 * ### 1.1
 * More content of tab 1.
 *
 * == Second
 * Content of tab 2.
 *
 * ## Regular H2
 * This section and its contents come _after_ the tab group.
 * ```
 *
 * == First
 * Content of tab 1.
 * ### 1.1
 * More content of tab 1.
 * == Second
 * Content of tab 2.
 * == ==
 *
 * It is also possible to end the last tab with a heading with no text (`== ==`) if the following text should be
 * outside the tab (and there isn't a higher level header to end it naturally).
 *
 * Because HTML needs special handling to render as tabs, we add some extra elements that can be augmented for the
 * CSS framework being used.
 *  - All tabs are surrounded by a `div` with class "tabset".
 *  - A `ul` is generated for the tab controls, each `li` with class "tab-handle".
 *  - The content of each tab is in a `div` with class "tab-content".
 *  - The tab content includes the original heading tag.
 *
 * ```html
 * <div class="tabset">
 *   <ul class="tab-handles">
 *     <li class="tab-handle" data-section="section:1.1">
 *       <a href="#section:1.1">First</a>
 *     </li>
 *     <li class="tab-handle" data-section="section:1.2">
 *       <a href="#section:1.2">Second</a>
 *     </li>
 *   </ul>
 *   <div class="tab-content" data-section="section:1.1">
 *     <a name="first"></a><h3 class="tab-heading" id="section:1.1">First</h3>
 *     <p>Content of tab 1.</p>
 *     <a name="1-1"></a><h4 id="section:1.1.1">1.1</h4>
 *     <p>More content of tab 1.</p>
 *   </div>
 *   <div class="tab-content" data-section="section:1.2">
 *     <a name="second"></a><h3 class="tab-heading" id="section:1.2">Second</h3>
 *     <p>Content of tab 2.</p>
 *   </div>
 * </div>
 * ```
 *
 * This structure can be transformed at rendering time to the needs of the CSS. For example, the server documentation
 * micro-site transforms it into [Bootstrap tabs](https://getbootstrap.com/docs/3.3/javascript/#tabs).
 *
 * @see MarkdownNode
 */
type MarkdownHeading mixes MarkdownNode {

  /**
   * Get the heading depth with 1 as the top-level heading and larger numbers (up to 6) for nested headings.
   */
  level: member function(): !int32

  /**
   * Get the title text.
   */
  title: member function(): string

  /**
   * Return true if this heading is used to define a tab. Tab headings use `=` (equal sign) instead of `#` (hash mark),
   * but only work with "ATX" style headings.
   */
  isTab: member function(): boolean

  /**
   * Produce the anchor text for linking to this heading. This will be the #title, trimmed, lower-cased, with each
   * space replaced by a dash, and all characters that aren't letters, digits, dashes, or underscores removed.
   */
  linkAnchor: member function(): string

  /**
   * Produce the anchor text for linking to a heading. This will be the title, trimmed, lower-cased, with each space
   * replaced by a dash, and all characters that aren't letters, digits, dashes, or underscores removed.
   */
  linkAnchorOf: function(title: !?string): string
}
