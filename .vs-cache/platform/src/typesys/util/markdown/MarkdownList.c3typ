/**
 * An ordered or bulleted Markdown list. It will only have list item children.
 *
 * @see MarkdownListItem
 */
abstract type MarkdownList mixes MarkdownNode {

  /**
   * If the list is authored with no blank lines within any item or between items, it is considered "tight" and list
   * items will not have a paragraph within them.
   */
  isTight: member function(): boolean
}
