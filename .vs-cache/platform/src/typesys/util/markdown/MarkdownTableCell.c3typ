/**
 * A header or body cell of a Markdown table (GitHub flavored). It will be contained in a {@link MarkdownTableRow}.
 *
 * @see MarkdownTableRow
 * @see MarkdownTable
 */
type MarkdownTableCell mixes MarkdownNode {

  /**
   * Whether this cell is in a header row.
   */
  isHeader: member function(): boolean

  /**
   * Get the alignment specified for this header cell.
   */
  alignment: member function(): string enum MarkdownTableCell.Alignment
}
