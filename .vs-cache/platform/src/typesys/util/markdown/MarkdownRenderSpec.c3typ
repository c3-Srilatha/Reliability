/**
 * Options for turning Markdown into a document (typically HTML).
 *
 * @see Markdown
 */
type MarkdownRenderSpec mixes Spec {

  /**
   * Maps a URL from the Markdown file into a valid URL for a link relative to the rendered document.
   */
  urlMapper: lambda(link: !MarkdownLink, destination: !string): string
}
