/**
 * The interface of a generic Bloom filter. This is a way to maintain a fixed-size hash of a large number of objects.
 * However, it is probabilistic in the sense that it may have false positives (but not false negatives).
 *
 * Traditional terminology for Bloom filters:
 *  - _m_ bits of data are stored (space required)
 *  - _k_ hash functions (time required)
 *  - _n_ the number of values entered
 *  - _X_ the number of bits that are set
 *  - _ε_ the false positive probability
 *
 * The choice of _m_ and _k_ are interrelated, see the Wikipedia page below for more info. The functions
 * #requiredM and #requiredK may be helpful.
 *
 * This type is abstract because the actual hash function must be specified by sub-types. This could either be using
 * _k_ separate hash functions or a smaller number combined in _k_ ways.
 *
 * This type has an implementation in all three languages so it can be used for client/server communications without
 * the need to remote. Sub-types should do the same.
 *
 * @var V the type of values to hash
 * @see https://en.wikipedia.org/wiki/Bloom_filter
 */
abstract type BloomFilter<V> mixes StringSerializable {

  /**
   * The number of bits. The more bits per expected entry, the lower the false positive probability.
   *
   * @see #requiredM
   */
  m: !int

  /**
   * The number of hash functions to use. The more hash functions, the lower the false positive probability.
   *
   * @see #requiredK
   */
  k: !int

  /**
   * The number of bits set in the bloom filter. _k_ bits are set for each entry, one for each hash function.
   */
  X: property(): !int java | js | py

  /**
   * The approximate number of unique values entered. This accuracy of this approximation is dependent on the
   * independence of the hash functions.
   */
  n: property(): !int java | js | py

  /**
   * Estimate the false positive probability for this bloom filter. This assumes that good hash functions with wide
   * outputs are used. Note that this depends on the {@link #n estimated number of entries}.
   */
  ε: property(): !double java | js | py

  /**
   * Return whether or not there is a filter hit for this value. Note that there will never be a false negative,
   * but there is a chance of a false postive, depending on the number of bits, the number of items entered, #k,
   * and the quality of the hash functions.
   *
   * @see see #ε
   */
  lookup: member function(v: !V): boolean java | js | py

  /**
   * Enter a value into the filter. Entering the same value multiple times is a no-op.
   */
  enter: member function(v: !V) java | js | py

  /**
   * To help with sizing, this method can be called with the expected _n_ and the desired false positive
   * probability (_ε_). Note that larger _m_ values will require more space in the filter (at least _m / 8_ bytes).
   *
   * @param n expected number of entries (must be positive)
   * @param ε desired false positive probability in (0..1)
   * @return minimum number of bits estimate (_m_)
   */
  estimateM: function(n: !int, ε: !double): !int java | js | py

  /**
   * To help with setup, this method can be called with the desired false positive probability (_ε_).
   * Note larger _k_ values will make hashing slower, since each hash function must be called on every lookup.
   *
   * @param ε desired false positive probability in (0..1)
   * @return number of hash functions estimate (_k_)
   */
  estimateK: function(ε: !double): !int java | js | py

  /**
   * Estimate the false positive rate (_ε_) from the number of bits, number of hash functions, and expected number of
   * entries. This assumes that good hash functions with wide outputs are used.
   *
   * @param m number of bits
   * @param k number of hash functions
   * @param n expected number of entries (must be positive)
   * @return false positive rate estimate in (0..1)
   */
  estimateE: function(m: !int, k: !int, n: !int): !double java | js | py

  /**
   * Construct a Bloom filter using Murmur3 hashing, specifying the parameters.
   *
   * @see BloomFilter.Murmur#create
   */
  murmur: function<R: ValueType>(vt: !R, m: !int, k: !int): !BloomFilter.Murmur<R>

  /**
   * Construct a Bloom filter using Murmur3 hashing, choosing parameters for the expected number of entries (_n_) and
   * desired false positive probability (_ε_).
   *
   * @param n the expected number of entries (must be positive)
   * @param ε desired false positive probability in (0..1)
   *
   * @see BloomFilter.Murmur#createForN
   */
  murmurForN: function<R: ValueType>(vt: !R, n: !int, ε: !double): !BloomFilter.Murmur<R>

  _bits: private @java(class="java.util.BitSet") native

  /**
   * This function must be implemented by sub-types to actually hash the value using _k_ distinct hash functions or
   * rounds or a smaller number of functions.
   */
  _hash: private abstract member function(v: !V): @java(class="java.util.BitSet") native

  toString:   abstract ~
  fromString: abstract ~
}
