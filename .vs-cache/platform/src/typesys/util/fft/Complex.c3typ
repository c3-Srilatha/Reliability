type Complex {

  r:         !double
  i:         !double
  num:       inline function(r: !double, i: !double): !Complex js-server
  plus:      inline member function(other: Complex): Complex js-server
  minus:     inline member function(other: Complex): Complex js-server
  mul:       inline member function(other: Complex): Complex js-server
  magnitude: inline member function(): double js-server
}
