/**
 * This specs helps to generate {@link Curl} for {@link FileSourceCollection}
 */
type CurlFileSpec mixes CurlLocalFileSpec {

  /**
   * Location of the remote file after upload. e.g. FileSourceCollection.rootUrl() + FileName
   */
  contentLocation: string

  /**
   * If the file has binary content.
   */
  dataBinary: boolean

  /**
   * If the local file should be streamed for the curl request.
   */
  stream: boolean

  /**
   * Security protocol. For files, it will use "--ssl" by default
   */
  protocol: string
}
