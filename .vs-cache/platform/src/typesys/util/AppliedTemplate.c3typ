/**
 * Type to contain the bound variables and values to be used in a template
 */
type AppliedTemplate {

  /**
   * the variables to substitute into the template at render time
   */
  appliedVars: !json

  /**
   * the template to use at render time
   */
  template: !Template

  /**
   * format the template with applied variables
   */
  format: member function(): !string
}
