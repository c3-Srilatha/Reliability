/**
 * This type implements SHA-256 secure hash algorithm.
 *
 * @see SHA512
 * @see https://en.wikipedia.org/wiki/SHA-2
 */
type SHA256 mixes MessageDigest {

  /**
   * The hash of an empty value.
   */
  EMPTY_HASH: const string = 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'
}
