/**
 * A single identified log file.
 *
 * @see Log.Entry
 */
type Log.File mixes StringSerializable {

  /**
   * The URL of the log file.
   */
  url: !string serialized FileUrl

  /**
   * Read a stream of raw entries from a log file; no filtering is done.
   */
  read: member function(): stream<!Log.EntryBase>
}
