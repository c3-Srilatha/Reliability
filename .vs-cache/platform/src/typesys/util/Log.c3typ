/**
 * Namespace for all inner types for log-reading. For log-writing, see {@link Logger}.
 */
type Log {

  /**
   * Read error exceptions from openSearch and summarize for a given interval
   */
  summaryForInterval: function(begin: !datetime, end: !datetime, limit: int = 10000): string py-data-server

  /**
   * Get Summary of exceptions for a duration
   */
  summary: function(period: string serialized Duration, limit: int = 10000): string py-data-server

  /**
   * Return a reference to a specific log file.
   */
  file: function(file: !File): !Log.File

  /**
   * Return a reference to a specific log file.
   */
  file: function(file: !string serialized FileUrl): !Log.File
}
