/**
 * Implements a semantic version as specified at http://semver.org/.
 */
inline type SemanticVersion mixes StringSerializable {

  MAX_SORTABLE_PRE_RELEASE_TAG_LENGTH: const int = 10

  /**
   * Major version is incremented when there are incompatible API changes
   */
  majorVersion: !int

  /**
   * Minor version is incremented when a functionality is added in a backwards-compatible manner
   */
  minorVersion: !int

  /**
   * Patch version is incremented when backwards-compatible bug fixes are made
   */
  patchVersion: !int

  /**
   * @see http://semver.org/#spec-item-9
   */
  preReleaseVersion: string

  /**
   * @see http://semver.org/#spec-item-10
   */
  buildMetadata: string

  /**
   * Parse given string into SemanticVersion, if it is valid.
   *
   * @param version
   *           to be parsed as SemanticVersion.
   * @param failIfInvalid
   *           when true, will throw error if version can not be parsed as SemanticVersion.
   */
  fromString: function(s: !?string, failIfInvalid: boolean): mixing SemanticVersion java | js-client

  fromString: ~ java | js-client
  toString:   ~ java | js-client

  /**
   * Returns the major.minor version.
   */
  toMajorMinor: member function(): !SemanticVersion.MajorMinor

  /**
   * Returns a string representation of the version that results in a lexicographically sortable string
   * which is consistent with http://semver.org/ ordering.
   *
   * C3 limits the maximum length of any character sequence
   * matching `[0-9]+` in the orderable section (major.minor.patch-prelease) of the semver to 9 characters.
   *
   * For example, `9.1.3-a.1b2c.5+branch.11.a8aef8e8ef9ef` can be converted to
   * `0000000009.0000000001.0000000003-a.0000000001b0000000002c.5+branch.11.a8aef8e8ef9ef` using {@link #toSortableString}
   * so that ordering and filtering can be done using the lexicographically sortable string in db queries.
   */
  toSortableString: member function(): !string

  /**
   * Increment the {@link #patchVersion} by 1 and discard #preReleaseVersion if any.
   */
  incrementPatchVersion: member function(): SemanticVersion java | js-client

  /**
   * Increment the {@link #preReleaseVersion} by 1.
   *
   * If the {@link #preReleaseVersion} contains an integer token, increment it by 1.
   *
   * If the {@link #preReleaseVersion} does not contain an integer token, append an integer token of 1.
   */
  incrementPreReleaseVersion: member function(): SemanticVersion java | js-client

  /**
   * returns > 0 if context is semantically greater than 'other'
   * returns < 0 if context is semantically less than 'other'
   */
  compareTo: member function(other: string): !int32 java | js-client

  compareTo: member function(other: SemanticVersion): !int32 java | js-client

  /**
   * Returns true if this version falls within the given version range.
   */
  satisfies: member function(range: !SemanticVersionRange): !boolean

  /**
   * Returns the semantic portion of the version i.e. "major.minor.patch"
   */
  majorMinorPatch: member function(): string java | js-client

  /**
   * Returns the maximum allowed {@link SemanticVersion}.
   */
  maxVersion: function(): !string

  /**
   * Returns the minimum allowed {@link SemanticVersion}.
   */
  minVersion: function(): !string

  /**
   * @return true, if the version is in a valid format.
   */
  isValid: function(version: !?string): boolean java | js-client

  /**
   * Returns true if version a is greater than version b.
   */
  gt: function(a: !string, b: !string): !boolean java | js-client

  gt: function(a: !SemanticVersion, b: !SemanticVersion): !boolean java | js-client

  /**
   * Returns true if version a is greater than or equal to version b.
   */
  gte: function(a: !string, b: !string): !boolean java | js-client

  gte: function(a: !SemanticVersion, b: !SemanticVersion): !boolean java | js-client

  /**
   * Returns true if version a is lesser than version b.
   */
  lt: function(a: !string, b: !string): !boolean java | js-client

  lt: function(a: !SemanticVersion, b: !SemanticVersion): !boolean java | js-client

  /**
   * Returns true if version a is lesser than or equal to version b.
   */
  lte: function(a: !string, b: !string): !boolean java | js-client

  lte: function(a: !SemanticVersion, b: !SemanticVersion): !boolean java | js-client

  /**
   * Returns true if version a is equal to version b.
   */
  eq: function(a: !string, b: !string): !boolean java | js-client

  eq: function(a: !SemanticVersion, b: !SemanticVersion): !boolean java | js-client

  /**
   * A comparator lambda for sorting SemanticVersion objects with latest first
   */
  comparator: cached function(): !lambda(v1: !SemanticVersion, v2: !SemanticVersion): !int32 java | js-client
}
