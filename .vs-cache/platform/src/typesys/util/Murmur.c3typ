/**
 * This type implements MurmurHash 3 X64-128 bit with seed = 0.
 *
 * @see https://en.wikipedia.org/wiki/MurmurHash
 */
type Murmur mixes HashFunction {

  /**
   * Implementation of MurmurHash3 32-bit. This is provided in each language so that it can be efficienlty used in
   * the client. A null value is treated as a zero-length string (hashing to 0). The string is hashed using its
   * UTF-8 encoding.
   *
   * @param value string to hash
   * @param seed a means to randomize the hash function (default 0)
   * @return 32-bit integer value (in 64-bit int so will always be positive)
   */
  hash32: function(value: !?string, seed: int32 = 0): !int java | js | py

  /**
   * Implementation of MurmurHash3 32-bit. This is provided in each language so that it can be efficienlty used in
   * the client. A null value is treated as a zero-length binary (hashing to 0).
   *
   * @param value binary data to hash
   * @param seed a means to randomize the hash function (default 0)
   * @return 32-bit integer value (in 64-bit int so will always be positive)
   */
  hash32: function(value: !?binary, seed: int32 = 0): !int java | js | py

  algorithm:                ~ java | js | py
  isCryptograhicallySecure: ~ java | js | py
}
