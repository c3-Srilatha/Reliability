/**
 * This type implements SHA-1 hash algorithm.
 *
 * Note that this is not cryptographically secure; use {@link SHA256} if a secure hash function is needed.
 *
 * @see https://en.wikipedia.org/wiki/SHA-1
 */
type SHA1 mixes MessageDigest {

  /**
   * The hash of an empty value.
   */
  EMPTY_HASH: const string = 'da39a3ee5e6b4b0d3255bfef95601890afd80709'
}
