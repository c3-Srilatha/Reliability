/**
 * Js implementation for `CamelCasePattern`.
 * @see CamelCasePattern
 */
// TODO: PLAT-31486: Merge `CamelCasePatternJs` with `CamelCasePattern`
type CamelCasePatternJS mixes MutableObj {

  /**
   * The raw camelCasePattern from user.
   */
  pattern: !string

  fromString: inline function(s: !string,
                              allowLowerCamelCase: !boolean,
                              fileNameOnly: !boolean): !CamelCasePatternJS js-client

  /**
   * @return The according regex pattern to match against with.
   */
  regex: inline member function(): !string js-client
}
