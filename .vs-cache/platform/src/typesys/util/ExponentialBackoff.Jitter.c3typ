/**
 * Jitter represents a different implementation of the exponential backoff algorithm with a different version of
 * jitter, discussed in https://aws.amazon.com/blogs/architecture/exponential-backoff-and-jitter/. Jitter is random
 * variance that is introduced to help offset processes that fail when produced at the same time.
 */
enum type ExponentialBackoff.Jitter {

  /**
   * This mode calculates a uniform value between minMillis and the upper limit set by the nth exponential value.
   * This mode does not guarantee increasing wait times between attempts.
   */
  FULL

  /**
   * This mode calculates a uniform value between the midpoint of the lower and upper limit, and the upper limit set by
   * the nth exponential value. This mode guarantees that wait times will increase on average.
   */
  EQUAL

  /**
   * This mode does not calculate any jitter and will instead use the nth exponential value.
   */
  NONE
}
