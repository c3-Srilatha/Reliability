/**
 * Template is used to generate text output (error messages, log entries, HTML web pages, e-mails, configuration files,
 * source code, etc.) based on static text template and dynamic data (bindings).
 *
 * Template is using ES6 template literals for value substitution.
 *
 * Usage example:
 * ```
 *   var template = Template.fromString("${company.name} had ${company.employeeCount} employees at the end of ${year}.");
 *   var bindings = { company: {
 *                      name: "c3.ai",
 *                      employeeCount: 440
 *                    },
 *                    year: 2019
 *                  };
 *   template.format(bindings) // returns "c3.ai had 440 employees at the end of 2019."
 * ```
 *
 * @see StrFormat
 */
type Template mixes StringSerializable {

  /**
   * The template.
   */
  template: !string

  /**
   * Format the template with bindings.
   *
   * @param bindings
   *        json object containing fields with data for template expressions.
   * return formatted string.
   */
  format: member function(bindings: !json): !string

  /**
   * Format the template with bindings.
   *
   * @param bindings
   *        C3 obj instance as parent scope for template expressions.
   * return formatted string.
   */
  format: member function(bindings: !Obj): !string

  /**
   * Format the template with bindings.
   *
   * @param bindings
   *        map containing fields as scope for template expressions.
   * return formatted string.
   */
  format: member function(bindings: !map<string, any>): !string

  /**
   * @return formatted string by evaluating all template expression with empty scope. Note that expression may still
   *         lookup shared scope and/or evaluate stdlib function
   */
  format: member function(): !string

  /**
   * @return an array of field paths extracted from template expressions
   */
  vars: member function(): [string serialized FieldPath]

  /**
   * Free marker template configuration that is setup once per application
   */
  freeMarkerCfg: private cached inline function(): @java(class="freemarker.template.Configuration") native
}
