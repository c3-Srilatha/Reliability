/**
 * Wrapper for java.security.MessageDigest to make MessageDigest implementations DRYer
 */
abstract private type MessageDigest mixes Hash {

  algorithm:                abstract ~ java | js | py
  isCryptograhicallySecure: abstract ~ java | js | py
  hashByteStream:           ~
  hashBinary:               ~ java | js-node | py-client
  hashHex:                  ~ java | js-node | py-client
  hashString:               ~ java | js-node | py-client
}
