/**
 * A "property setter" represents a function declaration used to handle a property write access in a class.
 *
 * ```js
 * set foo(v) {
 *   this.bar = v > 0 ? v : 0;
 * }
 * ```
 *
 * ```py
 * @foo.setter
 * def foo(self, v):
 *     self.bar = v if v > 0 else 0
 * ```
 *
 * @see Code.DefinedClass
 */
@code(java="none", js="2015", py="2.7")
type Code.Setter mixes Code.MethodBase, Code.WithName
