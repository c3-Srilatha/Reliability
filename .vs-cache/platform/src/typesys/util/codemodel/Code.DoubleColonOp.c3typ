/**
 * A "double colon operator" represents referencing a method for us as a lambda in Java.
 *
 * ```java
 * urls.map(Url::fromString)
 * ```
 */
@code(js="none", py="none")
type Code.DoubleColonOp mixes Code.Expr {

  /**
   * The class of the method.
   */
  left: member function(): !Code.Class

  /**
   * The method name.
   */
  method: member function(): !string

  _left:   private !Code.Class
  _method: private !string
}
