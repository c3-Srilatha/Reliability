/**
 * A "for statement" represents the C-style for with three components in the loop.
 *
 * Python's "for statement" is represented by {@link Code.ForEach}.
 */
@code(py="none")
type Code.For mixes Code.StmtWithBody {

  /**
   * The variables initialized before looping starts.
   */
  vars: member function(): [!Code.Var]

  /**
   * The expression that tests whether to continue for initial and for another iteration of the loop.
   */
  test: member function(): Code.Expr

  /**
   * The increment expressions executed each time after the body
   */
  incrs: member function(): [!Code.Expr]

  _vars:  private [!Code.Var]
  _test:  private Code.Expr
  _incrs: private [!Code.Expr]
}
