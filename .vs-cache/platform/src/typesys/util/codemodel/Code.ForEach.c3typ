/**
 * A "foreach statement" represents operating on each element of an iterable object.
 *
 * ```java
 * for (String s : list) ...
 * ```
 *
 * ```js
 * for (let s of list) ...
 * ```
 *
 * ```py
 * for s in list: ...
 * ```
 *
 * @see Code.For
 */
type Code.ForEach mixes Code.StmtWithBody {

  /**
   * The variable that receives each element in turn.
   */
  var: member function(): !Code.Var

  /**
   * An expression that results in the collection to be iterated.
   */
  expr: member function(): !Code.Expr

  _var:  private !Code.Var
  _expr: private !Code.Expr
}
