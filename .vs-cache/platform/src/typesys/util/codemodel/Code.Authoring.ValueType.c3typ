/**
 * Builder for authoring a value type.
 *
 * @see Code.Authoring
 */
type Code.Authoring.ValueType mixes Code.ValueType, Code.Authoring.TypeBase {

  /**
   * @return `binary` primitive type
   */
  binary: function(): !Code.Authoring.ValueType

  /**
   * @return `boolean` primitive type
   */
  bool: function(): !Code.Authoring.ValueType

  /**
   * @return `byte` primitive type
   */
  byte: function(): !Code.Authoring.ValueType

  /**
   * @return `datetime` primitive type
   */
  datetime: function(): !Code.Authoring.ValueType

  /**
   * @return `decimal` primitive type
   */
  decimal: function(): !Code.Authoring.ValueType

  /**
   * @return `double` primitive type
   */
  dbl: function(): !Code.Authoring.ValueType

  /**
   * @return `float` primitive type
   */
  float: function(): !Code.Authoring.ValueType

  /**
   * @return `int` primitive type
   */
  int: function(): !Code.Authoring.ValueType

  /**
   * @return `int32` primitive type
   */
  int32: function(): !Code.Authoring.ValueType

  /**
   * @return `int16` primitive type
   */
  int16: function(): !Code.Authoring.ValueType

  /**
   * @return `bigint` primitive type
   */
  bigint: function(): !Code.Authoring.ValueType

  /**
   * @return `json` primitive type
   */
  json: function(): !Code.Authoring.ValueType

  /**
   * @return `number` primitive type
   */
  num: function(): !Code.Authoring.ValueType

  /**
   * @return `string` primitive type
   */
  str: function(): !Code.Authoring.ValueType

  /**
   * @return node for value type
   */
  of: function(vt: !ValueType): !Code.Authoring.ValueType

  /**
   * Set the non-empty modifier on this value type.
   */
  nonEmpty: member function(): !mixing Code.Authoring.ValueType

  /**
   * Set the preserve empty modifier on this value type.
   */
  preservesEmpty: member function(): !mixing Code.Authoring.ValueType
}
