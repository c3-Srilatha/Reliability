/**
 * Builder for authoring a code module.
 *
 * @see Code.Authoring
 */
type Code.Authoring.DefinedModule mixes Code.DefinedModule, Code.Authoring.WithName {

  /**
   * Add a new compilation unit to this module.
   */
  compileUnit: member function(fileName: string): !Code.Authoring.CompileUnit

  /**
   * Add a class in a new compilation unit to this module. This is a convenience function for the two steps:
   *  - add a compilation unit to this module
   *  - add a class to that compilation unit
   *
   * The compilation unit file will be named after the class name (if provided).
   *
   * @see Code.Authoring.CompileUnit#class
   */
  class: member function(name: string): !Code.Authoring.DefinedClass
}
