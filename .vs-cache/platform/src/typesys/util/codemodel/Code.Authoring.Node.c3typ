/**
 * An "authoring node" just adds mutability and tracking.
 */
abstract type Code.Authoring.Node mixes Code.Node, Mutable {

  /**
   * Instantiate the correct sub-type of the specified node type for the current language and set its parent to this
   * instance.
   *
   * @see Code.Authoring#node
   */
  child: private member function<T: Code.Authoring.Node>(forType: !Type<<Code.Node>>): !T

  /**
   * Make this node a child of the current node. This is necessary in preparation for adding it to a child field
   * in order for its parent and code model pointers to be set.
   *
   * @param child node to be our child
   * @return same instance
   */
  reparent: private member function<T: Code.Authoring.Node>(child: !T): !T
}
