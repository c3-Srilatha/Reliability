/**
 * Any node that can take modifiers.
 *
 * @see Code.Mod
 */
abstract type Code.WithMods {

  /**
   * Modifiers of the node.
   */
  mods: member function(): [!string enum Code.Mod]

  /**
   * Whether the #mods contains {@link Mod#PUBLIC}.
   */
  isPublic: member function(): boolean

  /**
   * Whether the #mods contains {@link Mod#PROTECTED}.
   */
  isProtected: member function(): boolean

  /**
   * Whether the #mods contains {@link Mod#PRIVATE}.
   */
  isPrivate: member function(): boolean

  /**
   * Whether the #mods contains {@link Mod#STATIC}.
   */
  isStatic: member function(): boolean

  /**
   * Whether the #mods contains {@link Mod#ABSTRACT}.
   */
  isAbstract: member function(): boolean

  /**
   * Whether the #mods contains {@link Mod#FINAL}.
   */
  isFinal: member function(): boolean

  /**
   * Whether the #mods contains {@link Mod#SYNCHRONIZED}.
   */
  isSynchronized: member function(): boolean

  /**
   * Whether the #mods contains {@link Mod#VOLATILE}.
   */
  isVolatile: member function(): boolean

  /**
   * Whether the #mods contains {@link Mod#DEFAULT}.
   */
  isDefault: member function(): boolean

  /**
   * Whether the #mods contains {@link Mod#CONST}.
   */
  isConst: member function(): boolean

  _mods: private [!string enum Code.Mod]
}
