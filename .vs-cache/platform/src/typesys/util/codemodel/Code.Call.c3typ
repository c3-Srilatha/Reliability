/**
 * A "call" represents calling a function or lambda value with a set of argument values passed in the regular way.
 * This is useful when the function is computed, but the arguments are known at code-generation time.
 *
 * For example:
 * ```js
 * let op = this.binaryOpImpl();
 * return op.call(this, left, right);
 * ```
 * Here we have the function to call as an expression, but we know the arguments are code-generation time so we
 * pass them explicitly.
 *
 * In Python there is no special form:
 * ```py
 * op = this.binaryOpImpl()
 * op(this, left, right)
 * ```
 *
 * In Java, this only makes sense for lambdas. Also, lambdas have various different method names, such as "apply",
 * "accept", "get" and "test".
 *
 * @see Code.Invocation
 * @see Code.Apply
 */
type Code.Call mixes Code.Expr {

  /**
   * The expression that yields the function value to call.
   */
  function: member function(): !Code.Expr

  /**
   * The positional arguments to call with.
   */
  args: member function(): [!Code.Expr]

  /**
   * The keyword arguments to call with.
   */
  kwargs: member function(): @indexed map<!string, !Code.Expr>

  /**
   * The application function name. For JavaScript, this will always be "call", but in Java the method differs with
   * the class of the lambda.
   */
  method: member function(): string

  _function: private !Code.Expr
  _this:     private Code.Expr
  _args:     private [!Code.Expr]

  @code(java="none", js="none")
  _kwargs: private @indexed map<!string, !Code.Expr>

  @code(js="none", py="none")
  _method: private string
}
