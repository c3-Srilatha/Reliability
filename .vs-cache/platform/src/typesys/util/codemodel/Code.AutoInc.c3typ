/**
 * A "auto-increment" represents setting a variable or field to one or more less than it's current value.
 * This handles pre- and post-increment unary operators such as `++i` and `o.count--`.
 *
 * @see Code.Assignment
 */
@code(py="none")
type Code.AutoInc mixes Code.UnaryOp {

  /**
   * If true, this is a pre-increment (`++i`).
   */
  prefix: member function(): boolean

  _prefix: private boolean
}
