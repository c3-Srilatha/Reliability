/**
 * A "assignment expression" represents setting a variable or field to an expression. This includes compound
 * operators such as "+=", but not the auto-increment operators.
 *
 * Note that in most languages assignment is an expression, but in Python assignment is a statement except if the
 * "walrus operator" (`:=`) is used.
 *
 * @see Code.AutoInc
 */
type Code.Assignment mixes Code.Expr {

  /**
   * The left-hand side of the assignment.
   */
  left: member function(): !Code.AssignmentTarget

  /**
   * The assignment operator.
   */
  operator: member function(): !string enum Code.AssignmentOperator

  /**
   * The value that will be assigned.
   */
  expr: member function(): !Code.Expr

  _left:     private !Code.AssignmentTarget
  _operator: private !string enum Code.AssignmentOperator
  _expr:     private !Code.Expr
}
