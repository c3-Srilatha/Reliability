/**
 * An "element reference" represents an element of an array-like instance.
 *
 * @see Code.DefinedClass
 */
type Code.ElementRef mixes Code.Expr, Code.AssignmentTarget {

  /**
   * The object on which the element is being referenced.
   */
  left: member function(): Code.Expr

  /**
   * The index within the instance.
   */
  index: member function(): Code.Expr

  _left:  private Code.Expr
  _index: private Code.Expr
}
