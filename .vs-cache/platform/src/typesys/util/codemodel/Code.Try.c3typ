/**
 * A "try statement" represents a wrapper that catches exceptions in a block of code and handles them.
 */
type Code.Try mixes Code.StmtWithBody {

  /**
   * For Java's try-with-resources, you can declare variables that will be closed automatically.
   */
  resources: member function(): [Code.Var]

  /**
   * The code to be executed if an exception occurs. At most one catch can have no class. In Python, this is the
   * `except:` block.
   */
  catches: member function(): [Code.Catch]

  /**
   * The code to be executed if no exception occurs.
   */
  else: member function(): Code.Block

  /**
   * The code to be executed no matter the result.
   */
  finally: member function(): Code.Block

  @code(js="none", py="none")
  _resources: private [Code.Var]

  _catches: private [Code.Catch]
  _finally: private Code.Block

  @code(java="none", js="none")
  _else: private Code.Block
}
