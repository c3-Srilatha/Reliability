/**
 * A "type var" represents a generic variable associated with a type or method declaration.
 */
@code(js="none", py="none")
type Code.TypeVar mixes Code.TypeBase {

  /**
   * The lower bounds for the generic type, if any.
   */
  bounds: member function(): [Code.TypeBase]

  _bounds: private [Code.TypeBase]
}
