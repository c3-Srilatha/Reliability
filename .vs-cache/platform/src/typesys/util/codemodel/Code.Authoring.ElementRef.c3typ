/**
 * An "element reference" represents an element of an array-like instance.
 *
 * @see Code.Authoring
 */
type Code.Authoring.ElementRef mixes Code.ElementRef, Code.Authoring.Expr {

  /**
   * Set the object on which the field is being referenced.
   */
  left: member function(expr: !Code.Authoring.Expr): !mixing Code.Authoring.ElementRef

  /**
   * Set the index within the instance.
   */
  index: member function(expr: !Code.Authoring.Expr): !mixing Code.Authoring.ElementRef
}
