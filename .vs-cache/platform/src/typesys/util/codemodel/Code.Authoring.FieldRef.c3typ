/**
 * A "field reference" represents a reference to a field on an instance, class or a global variable.
 *
 * @see Code.Authoring
 */
type Code.Authoring.FieldRef mixes Code.FieldRef, Code.Authoring.WithName, Code.Authoring.Expr {

  /**
   * Set the object on which the field is being referenced.
   */
  left: member function(expr: !Code.Authoring.Expr): !mixing Code.Authoring.FieldRef
}
