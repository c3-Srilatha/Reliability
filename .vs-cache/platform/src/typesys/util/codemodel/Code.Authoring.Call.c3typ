/**
 * Builder for authoring a function/method call.
 *
 * @see Code.Authoring
 */
type Code.Authoring.Call mixes Code.Call, Code.Authoring.Expr {

  /**
   * Set the expression that yields the function value to call.
   */
  function: member function(expr: !Code.Authoring.Expr): !mixing Code.Authoring.Call

  /**
   * Set the name of the function value to call (simple case of expression).
   */
  function: member function(name: !string): !mixing Code.Authoring.Call

  /**
   * Add a positional argument to this call.
   */
  arg: member function(expr: !Code.Authoring.Expr): !mixing Code.Authoring.Call

  /**
   * Add a positional argument to this call.
   */
  kwarg: member function(name: !string, expr: !Code.Authoring.Expr): !mixing Code.Authoring.Call
}
