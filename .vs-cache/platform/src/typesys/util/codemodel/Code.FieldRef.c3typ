/**
 * A "field reference" represents a reference to a field on an instance, class or a global variable.
 *
 * @see Code.DefinedClass
 */
type Code.FieldRef mixes Code.Expr, Code.WithName, Code.AssignmentTarget {

  /**
   * The object on which the field is being referenced, if any. If this is a static field, the target will be a class
   * or reference type. If it's a member field, the target will be an expression that resolves to the instance.
   * If null, the field is a global variable in the same compilation unit.
   */
  left: member function(): Code.Expr

  _name: !~
  _left: private Code.Expr
}
