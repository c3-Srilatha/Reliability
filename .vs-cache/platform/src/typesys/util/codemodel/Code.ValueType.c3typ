/**
 * A "value type" represents the reference to a C3 value type. Instead of having an AST node such as `IntType`,
 * the node will be a `Code.ValueType` with #valueType set to `int`.
 *
 * @see ValueType
 */
@code(js="none", py="none")
type Code.ValueType mixes Code.TypeBase {

  /**
   * The value type which represents the external type referenced.
   */
  valueType: member function(): !ValueType

  _valueType: private !ValueType
}
