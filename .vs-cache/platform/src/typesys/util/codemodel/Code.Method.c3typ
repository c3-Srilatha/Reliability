/**
 * A "method" represents a single function declaration. This can be a class method or a global function.
 *
 * @see Code.DefinedClass
 */
type Code.Method mixes Code.MethodBase, Code.WithName {

  /**
   * The return value type.
   */
  returnType: property(): Code.TypeBase

  /**
   * Generic variables defined on the method.
   */
  generics: member function(): @indexed map<string, Code.TypeBase>

  _name: !~

  @code(js="none", py="none")
  _returnType: private Code.TypeBase

  @code(js="none", py="none")
  _generics: private @indexed map<string, Code.TypeBase>
}
