/**
 * This is a parent type for unary, binary and ternary operators.
 */
abstract type Code.OpExpr mixes Code.Expr {

  /**
   * The operator symbol.
   */
  op: member function(): !string enum Code.Operator

  /**
   * The number of expressions on which this operates.
   */
  arity: abstract member function(): !int

  _op: !string enum Code.Operator
}
