/**
 * A "statement with body" represents a single statement that has a single associated block of statemetns.
 */
abstract type Code.StmtWithBody mixes Code.Stmt {

  /**
   * The statement body.
   */
  body: member function(): Code.Block

  _body: private Code.Block
}
