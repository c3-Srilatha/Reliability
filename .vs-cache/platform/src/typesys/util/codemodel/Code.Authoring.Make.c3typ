/**
 * Builder for authoring an Obj make expression. This ends up being a function call, possibly chained.
 *
 * @see Code.Authoring
 */
type Code.Authoring.Make mixes Code.Make, Code.Authoring.Expr {

  /**
   * Set the reference to type to make.
   */
  objType: member function(type: !Code.TypeRef): !mixing Code.Authoring.Make

  /**
   * Set the type to make (simple case of ref).
   */
  objType: member function(type: !Type): !mixing Code.Authoring.Make

  /**
   * Add a field value initialization.
   */
  field: member function(name: !string, expr: !Code.Authoring.Expr): !mixing Code.Authoring.Make
}
