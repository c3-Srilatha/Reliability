/**
 * Each node in the abstract syntax tree (AST) is a sub-type of this type.
 */
abstract type Code.Node {

  /**
   * The code model this node is contained within.
   */
  code: member function(): !Code

  /**
   * The parent node for upward traversal.
   */
  parent: member function(): Code.Node

  /**
   * The language this node is for, if language-specific.
   */
  language: member function(): string serialized ImplLanguage

  /**
   * Each node stores the children in fields with particular types, but for generic tree traveral the various nodes can
   * be accessed as a single collection.
   */
  children: member function(): [Code.Node]

  /**
   * Validate that the structure is supported in this language. This is primarily based on the {@link Ann.Code}
   * annotation, but may also include custom validation if the node implements #doValidate.
   *
   * @param version if specified, validation will fail for features not available in that language version
   * @return metadata issues found
   */
  validate: final member function(version: string serialized SemanticVersion): [Pkg.Issue]

  /**
   * Write this structure to the instantiated writer. This should operate recursively and write out the node and
   * all its sub-structure. The structure must have been created for a particular language and must be valid in that
   * language.
   */
  write: final member function(writer: !Code.Writer)

  /**
   * Custom validation for this node if needed. This will be called by the single #validate implementation if declared
   * on a particular node. This does not need to recurse itself as the public #write method will handle recursion into
   * the #children.
   */
  doValidate: private optional member function(version: string serialized SemanticVersion): [Pkg.Issue]

  /**
   * Custom implementation of writing the code. This is required for each language-specific node to actually generate
   * valid code and will be called by the single #write implementation.
   *
   * When this method needs to write sub-structure, it should only call `write`, never doWrite directly.
   */
  doWrite: private optional member function(writer: !Code.Writer)

  /**
   * Create a metadata issue for this node.
   */
  makeIssue: member function(message: !string): !Pkg.Issue

  /**
   * Get the type of the language-specific node. For example {@link Code.Block} is the generic node type and
   * {@link Code.Py.Block} is the Python-specific implementation. Nodes have no specific node in languages which don't
   * support them.
   */
  langNodeType: private member function(failIfNone: boolean): Type

  /**
   * The parent node.
   */
  @ser(hidden=true)
  _parent: private Code.Node

  /**
   * The code model.
   */
  @ser(hidden=true)
  _code: private Code
}
