/**
 * A "assignment expression" represents setting a variable or field to an expression. Assignments can update the
 * current value using operators like `+` (add to the current value). This enum list all possible assignment operators.
 *
 * @see Code.Assignment
 * @see https://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Expressions_and_Operators#assignment_operators
 */
enum type Code.AssignmentOperator mixes Code.Operator {

  ASSIGN = '='

  ADD = '+='

  SUB = '-='

  MUL = '*='

  DIV = '/='

  MOD = '%='

  @code(java="none")
  LSHIFT = '<<='

  @code(java="none")
  RSHIFT = '>>='

  @code(java="none", py="none")
  LRSHIFT = '>>>='

  @code(java="none")
  BITAND = '&='

  @code(java="none")
  BITOR = '|='

  @code(java="none")
  BITXOR = '^='

  @code(java="none", js="none")
  FLOOR = '//='

  @code(java="none", js="2016")
  EXP = '**='

  @code(java="none", js="", py="none")
  LOGAND = '&&='

  @code(java="none", js="", py="none")
  LOGOR = '||='

  @code(java="none", js="2021", py="none")
  NULL = '??='

  @code(java="none", js="none")
  WALRUS = ':='
}
