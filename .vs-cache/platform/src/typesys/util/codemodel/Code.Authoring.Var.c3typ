/**
 * Builder for authoring a variable declaration.
 *
 * @see Code.Authoring
 */
type Code.Authoring.Var mixes Code.Var, Code.Authoring.WithName {

  /**
   * Set a modifier on this variable.
   */
  mod: member function(mod: !string enum Code.Mod): !mixing Code.Authoring.Var

  /**
   * Set the type of this variable.
   */
  varType: member function(type: !Code.Authoring.TypeBase): !mixing Code.Authoring.Var

  /**
   * Set the initializer expression of this variable.
   */
  init: member function(expr: !Code.Authoring.Expr): !mixing Code.Authoring.Var
}
