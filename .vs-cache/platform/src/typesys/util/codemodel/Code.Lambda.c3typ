/**
 * A "lambda" represents a callable piece of code that is used like data.
 */
type Code.Lambda mixes Code.Expr {

  /**
   * The formal parameters of the lambda.
   */
  params: member function(): [Code.LambdaParam]

  /**
   * The lambda body.
   */
  body: member function(): !(Code.Expr | Code.Block)

  _params: private [Code.LambdaParam]
  _body:   private !(Code.Expr | Code.Block)
}
