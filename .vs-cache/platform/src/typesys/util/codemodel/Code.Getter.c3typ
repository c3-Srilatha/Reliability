/**
 * A "property getter" represents a function declaration used to handle a property read access in a class.
 *
 * ```js
 * get foo() {
 *   return this.bar + 17;
 * }
 * ```
 *
 * ```py
 * @property
 * def foo(self):
 *     return self.bar + 17
 * ```
 *
 * @see Code.DefinedClass
 */
@code(java="none", js="2015", py="2.7")
type Code.Getter mixes Code.MethodBase, Code.WithName
