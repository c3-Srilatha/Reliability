abstract type Code.Py.MethodBase mixes Code.MethodBase {

  /**
   * Write out the parameter list for this method.
   */
  writeParams: private member function(writer: !Code.Writer)

  /**
   * Write out the body of the method.
   */
  writeBody: private member function(writer: !Code.Writer)
}
