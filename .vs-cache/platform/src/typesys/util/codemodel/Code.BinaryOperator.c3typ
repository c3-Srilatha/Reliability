/**
 * A "binary expression" represents an operator that takes two single expressions. This enum lists all possible
 * binary operators.
 *
 * @see Code.BinaryOp
 */
enum type Code.BinaryOperator {

  ADD = '+'

  SUB = '-'

  MUL = '*'

  DIV = '/'

  MOD = '%'

  LSHIFT = '<<'

  RSHIFT = '>>'

  LRSHIFT = '>>>'

  BITAND = '&'

  BITOR = '|'

  BITXOR = '^'

  LOGAND = '&&'

  LOGOR = '||'

  EQ = '=='

  NE = '!='

  LT = '<'

  LE = '<='

  GT = '>'

  GE = '>='

  @code(java="none", js="2016")
  EXP = '**'

  @code(java="none", js="2020", py="none")
  NULL = '??'

  @code(java="none", js="none")
  FLOOR = '//'

  @code(java="none", js="none")
  MATMUL = '@'

  @code(java="none", py="none")
  EQSTRICT = '==='

  @code(java="none", py="none")
  NESTRICT = '!=='

  @code(java="none", js="none")
  IS = 'is'

  @code(java="none", js="none")
  ISNOT = 'is not'

  @code(java="none")
  IN = 'in'

  @code(java="none", js="none")
  NOTIN = 'not in'
}
