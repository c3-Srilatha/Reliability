/**
 * A "spread operator" represents expanding an iterable, such as an array, in places where zero or more arguments to
 * a function call are allowed or in assignments to array or object literals.
 *
 * ```js
 * let args = [ ...some, another, andMore ];
 * foo(...args);
 * ```
 *
 * ```py
 * foo(*args, **kwargs)
 * ```
 */
@code(java="none", js="2015")
type Code.Spread mixes Code.Expr {

  /**
   * The expression which yields the values to be iterated for expansion into the call or literal value.
   */
  source: member function(): !Code.Expr

  /**
   * For Python, there is special syntax used for expanding keyword arguments: `**kwargs`.
   */
  kwargs: member function(): boolean

  _source: private !Code.Expr

  @code(js="none")
  _kwargs: private boolean
}
