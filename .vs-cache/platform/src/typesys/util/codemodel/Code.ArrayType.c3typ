/**
 * The type of a native array in a strongly-typed language. Note that this is different from a C3 {@link ArrayType}
 * which would be handled by {@link Code.ValueType}.
 *
 * ```java
 * int[] buckets = ...
 * ```
 */
@code(js="none", py="none")
type Code.ArrayType mixes Code.TypeBase {

  /**
   * The type of the array elements.
   */
  element: member function(): !Code.TypeBase

  _element: private !Code.TypeBase
}
