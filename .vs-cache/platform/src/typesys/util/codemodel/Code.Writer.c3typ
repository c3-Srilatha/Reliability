/**
 * A code writer keeps track of source code concerns such as indentation level and per-language indentation amount.
 * It only makes sense at the compilation unit level; modules will need to organize their source code in
 * language-specific structure, such as a Java JAR file.
 *
 * This class does not support pretty-printing; it will produce code that may exceed the desired line length.
 *
 * Most methods return the same instance, allowing chaining.
 *
 * @see Code.Node#write
 */
type Code.Writer mixes WithToString, Mutable {

  /**
   * The language this writer supports.
   */
  language: !string serialized ImplLanguage

  /**
   * The version of the language being generated, if not the most current.
   */
  version: string serialized SemanticVersion

  /**
   * The text used for indentation. If this value is set to null, no indentation will be done.
   */
  indentStr: ?string

  /**
   * The text used for separating lines. Cannot be null.
   */
  newlineStr: ?string = "\n"

  /**
   * The text used for a single white space. Cannot be null.
   */
  spaceStr: ?string = " "

  /**
   * Return true if we have written no content yet.
   */
  isEmpty: member function(): boolean

  /**
   * Return true if we're at the start of a new line (or the content is empty).
   */
  isAtNewline: member function(): boolean

  /**
   * If not at the beginning of a line, emit the newline character.
   *
   * @see #newlineStr
   */
  newline: member function(): !mixing Code.Writer

  /**
   * If not at the beginning of a line, emit the newline character. Always emit another newline, creating a blank
   * line.
   *
   * @see #newline
   */
  blankLine: member function(): !mixing Code.Writer

  /**
   * If at the beginning of a line, indent to the current indentation level.
   *
   * @see #indentStr
   */
  indent: member function(): !mixing Code.Writer

  /**
   * If not at the beginning of a line, emit the newline character. Always indent to the current indentation level.
   */
  newlineIndent: member function(): !mixing Code.Writer

  /**
   * Append the cannonical "single whitespace" string.
   *
   * @see #spaceStr
   */
  space: member function(): !mixing Code.Writer

  /**
   * Add some text to the file being written. This text is written exactly as is, so must be legal syntax for the
   * language being written.
   *
   * @param s syntax to write
   * @return same instance
   */
  append: member function(s: ?string): !mixing Code.Writer

  /**
   * Increase the level of indentation.
   */
  pushIndent: member function(): !mixing Code.Writer

  /**
   * Decrease the level of indentation.
   */
  popIndent: member function(): !mixing Code.Writer

  /**
   * Reset all state of the writer as though beginning a brand new file.
   *
   * @return same instance
   */
  reset: member function(s: string): !mixing Code.Writer

  /**
   * Return a string representing the white space for the current indentation level.
   *
   * @see #indentStr
   */
  indentationStr: member function(): ?string

  /**
   * Construct a writer with appropriate defaults for the specified language.
   *
   * @param lang language to generate code for
   * @param version language version, if features should be restricted
   */
  makeWriter: private function(lang: !string serialized ImplLanguage,
                               version: string serialized SemanticVersion): !Code.Writer

  buffer:      private @java(class="java.lang.StringBuilder") native
  indentation: private !int32 = 0
}
