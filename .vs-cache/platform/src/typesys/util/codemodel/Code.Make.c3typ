/**
 * A "make expression" represents constructing an instance of an Obj from its field values.
 *
 * @see Obj#make
 * @see Code.Call
 */
type Code.Make mixes Code.Expr {

  /**
   * The type to be made.
   */
  objType: member function(): !Code.TypeRef

  /**
   * The initial value for the fields.
   */
  fields: member function(): Map<!string, !Code.Expr>

  _objType: private !Code.TypeRef
  _fields:  private map<!string, !Code.Expr>
}
