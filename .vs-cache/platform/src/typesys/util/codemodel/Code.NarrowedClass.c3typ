/**
 * A "narrowed class" represents the reference to a generic class with the generic variables bound.
 *
 * For example in Java, `Array<String>` is a narrowed version of `Array<E>`.
 */
@code(js="none", py="none")
type Code.NarrowedClass mixes Code.Class {

  /**
   * The generic class being narrowed.
   */
  proto: member function(): !Code.Class

  /**
   * The generic bindings, one per generic variable in the #proto class.
   */
  bindings: member function(): ![!Code.Class]

  _proto:    private !Code.Class
  _bindings: private ![!Code.Class]
}
