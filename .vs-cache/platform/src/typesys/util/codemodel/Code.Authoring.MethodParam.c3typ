/**
 * Builder for authoring a method param.
 *
 * @see Code.Authoring
 */
type Code.Authoring.MethodParam mixes Code.MethodParam, Code.Authoring.WithName {

  /**
   * Set the name of this parameter.
   */
  name: member function(name: !string): !mixing Code.Authoring.MethodParam

  /**
   * Set the type of this parameter.
   */
  paramType: member function(type: !Code.Authoring.TypeBase): !mixing Code.Authoring.MethodParam

  /**
   * Set whether this parameter may be omitted when making the call.
   */
  optional: member function(optional: !boolean): !mixing Code.Authoring.MethodParam

  /**
   * Set the default value of this parameter.
   */
  default: member function(expr: !Code.Authoring.Expr): !mixing Code.Authoring.MethodParam
}
