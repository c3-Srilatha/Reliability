/**
 * A "delete" represents removing a field value of an object. Note that the difference between assigning to null and
 * deleting is that the slot in the object is removed in the latter.
 *
 * @see https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Operators/delete
 */
@code(java="none")
type Code.Delete mixes Code.UnaryOp
