/**
 * A "field" represents a single class field declaration.
 *
 * @see Code.DefinedClass
 * @see Code.Assignment
 * @see Code.FieldRef
 */
@code(py="none")
type Code.FieldVar mixes Code.Node, Code.WithName, Code.DocumentationTarget, Code.AnnotationTarget, Code.WithMods {

  /**
   * Type of the field.
   */
  fieldType: member function(): Code.TypeBase

  /**
   * The initial value of the field.
   */
  init: member function(): Code.Expr

  /**
   * Get the parent class of this field.
   */
  parentClass: private member function(failIfNone: boolean): Code.DefinedClass

  _name: !~

  @code(js="none")
  _fieldType: private Code.TypeBase

  _init: private Code.Expr
}
