/**
 * A "parameter" represents a single method formal parameter.
 *
 * @see Code.Method
 */
type Code.MethodParam mixes Code.Node, Code.WithName {

  /**
   * The type of the parameter.
   */
  paramType: member function(): Code.TypeBase

  /**
   * If true, this parameter may be omitted when making the call.
   */
  optional: member function(): boolean

  /**
   * The default value of the parameter, if any.
   */
  default: member function(): Code.Expr

  /**
   * Whether this is a parameter that takes a variable number of positional arguments.
   */
  varargs: member function(): boolean

  /**
   * Whether this is a parameter that receives all keyword arguments.
   */
  kwargs: member function(): boolean

  _name: !~

  @code(js="none", py="none")
  _paramType: private Code.TypeBase

  _optional: private boolean

  @code(java="none")
  _default: private Code.Expr

  _varargs: private boolean

  @code(java="none", js="none")
  _kwargs: private boolean
}
