/**
 * Builder for authoring a ternary condition.
 *
 * @see Code.Authoring
 */
type Code.Authoring.TernaryCond mixes Code.TernaryCond, Code.Authoring.Expr {

  /**
   * Set the expression to be used to determine which expression is evaluated and returned.
   */
  test: member function(expr: !Code.Authoring.Expr): !mixing Code.Authoring.TernaryCond

  /**
   * Set the expression to be evaluated if the #test is true.
   */
  then: member function(expr: !Code.Authoring.Expr): !mixing Code.Authoring.TernaryCond

  /**
   * Set the expression to be evaluated if the #test is false.
   */
  else: member function(expr: !Code.Authoring.Expr): !mixing Code.Authoring.TernaryCond
}
