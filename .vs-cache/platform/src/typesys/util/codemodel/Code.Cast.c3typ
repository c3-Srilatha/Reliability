/**
 * A "cast expression" represents adding type information with an expression, which may also change the behavior
 * of the results of the expression.
 *
 * ```java
 * int avg = (int) (sum / count);
 * ```
 */
@code(js="none", py="none")
type Code.Cast mixes Code.Expr {

  /**
   * The type to which the expression is being cast.
   */
  castType: member function(): !Code.TypeBase

  /**
   * The expression the type cast is applied to.
   */
  expr: member function(): !Code.Expr

  _castType: private !Code.TypeBase
  _expr:     private !Code.Expr
}
