/**
 * A "void operator" represents executing an expression and then ignoring the result in JavaScript. It always
 * returns `undefined`.
 *
 * @see https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Operators/void
 */
@code(java="none", py="none")
type Code.Void mixes Code.UnaryOp
