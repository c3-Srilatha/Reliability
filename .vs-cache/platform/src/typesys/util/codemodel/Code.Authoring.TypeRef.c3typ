/**
 * Build for a "type reference" representing a reference to a C3 type.
 *
 * @see Code.Authoring
 */
type Code.Authoring.TypeRef mixes Code.TypeRef, Code.Authoring.Expr {

  /**
   * Set the type which is being referenced.
   */
  toType: member function(type: !Type): !mixing Code.Authoring.TypeRef
}
