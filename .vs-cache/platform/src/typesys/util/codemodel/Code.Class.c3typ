/**
 * A "class" represents the reference a class. This could be any class avilable to the language, including a class
 * being generated at the same time.
 *
 * @see Code.DefinedClass
 */
type Code.Class mixes Code.TypeBase {

  /**
   * The specific kind of class.
   */
  classType: member function(): !string enum Code.ClassType

  _classType: private !string enum Code.ClassType
}
