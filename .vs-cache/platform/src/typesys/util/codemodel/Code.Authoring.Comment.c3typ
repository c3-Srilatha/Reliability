/**
 * Builder for authoring a comment.
 *
 * @see Code.Authoring
 */
type Code.Authoring.Comment mixes Code.Comment, Code.Authoring.Node {

  /**
   * Set the entire comment, including start (and end if multi-line). This should _not_ include indentation, which
   * will be added when the code is written. (At least one line should start in the first column.)
   */
  comment: member function(comment: !string): !mixing Code.Authoring.Comment

  /**
   * Set the content of the comment (without the start/end). Delimiters will be added as appropriate for the
   * authoring language, type of comment and whether there are multiple lines or not.
   */
  text: member function(text: !string): !mixing Code.Authoring.Comment
}
