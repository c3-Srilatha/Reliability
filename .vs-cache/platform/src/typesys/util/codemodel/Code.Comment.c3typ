/**
 * A "comment" represents a single comment in source code. This is meant for human readers and not manipulated by the
 * AST itself.
 */
type Code.Comment mixes Code.Node {

  /**
   * The entire comment, including comment start (and end if multi-line).
   */
  comment: member function(): !string

  _comment: private !string
}
