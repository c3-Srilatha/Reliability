/**
 * Builder for authoring a compilation unit.
 *
 * @see Code.Authoring
 */
type Code.Authoring.CompileUnit mixes Code.CompileUnit, Code.Authoring.Node {

  /**
   * Add a class declaration to this compilation unit.
   */
  class: member function(name: string, mods: string enum Code.Mod ...): !Code.Authoring.DefinedClass

  /**
   * Add a global variable declaration to this compilation unit.
   */
  var: member function(name: !string): !Code.Authoring.FieldVar

  /**
   * Add a global function declaration to this compilation unit.
   */
  function: member function(name: !string): !Code.Authoring.Method

  /**
   * Add a top-level statement to this compilation unit.
   */
  statement: member function(stmt: !Code.Authoring.Node): !Code.Authoring.Node

  /**
   * Add an already-created node to the compile unit.
   *
   * @see #program
   */
  add: private member function(node: !Code.Authoring.Node): !Code.Authoring.CompileUnit
}
