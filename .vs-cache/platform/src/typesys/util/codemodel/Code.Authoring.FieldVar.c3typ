/**
 * Builder for authoring a class field.
 *
 * @see Code.Authoring
 */
type Code.Authoring.FieldVar mixes Code.FieldVar, Code.Authoring.WithName {

  /**
   * Set a modifier on this field.
   */
  mod: member function(mod: !string enum Code.Mod): !mixing Code.Authoring.FieldVar

  /**
   * Set the type of this field.
   */
  fieldType: member function(type: !Code.Authoring.TypeBase): !mixing Code.Authoring.FieldVar

  /**
   * Set the initializer expression of this field.
   */
  init: member function(expr: !Code.Authoring.Expr): !mixing Code.Authoring.FieldVar

  /**
   * Set the documentation comment body text for this field.
   */
  doc: member function(text: !string): !mixing Code.Authoring.FieldVar
}
