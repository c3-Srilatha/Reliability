/**
 * A "anonymous class" represents a class defined inside a code block that extends another class or implements an
 * interface.
 *
 * ```java
 * Runnable run = new Runnable() {
 *    @Override
 *    public void run() {
 *       ...
 *    }
 * };
 * ```
 */
@code(js="none", py="none")
type Code.AnonymousClass mixes Code.DefinedClass {

  /**
   * The base class this one extends or interface it implements.
   */
  base: member function(): !Code.DefinedClass

  _base: private !Code.DefinedClass
}
