/**
 * A "ternary conditional" is an expression that produces one of two results depending on a condition. This is an
 * expression form of the traditional {@link Code.Conditional if statement}.
 *
 * ```py
 * "yes" if v else "no"
 * ```
 *
 * ```java
 * v ? "yes" : "no"
 * ```
 */
type Code.TernaryCond mixes Code.OpExpr {

  /**
   * The expression to be used to determine which expression is evaluated and returned.
   */
  test: member function(): !Code.Expr

  /**
   * The expression to be evaluated if the #test is true.
   */
  then: member function(): !Code.Expr

  /**
   * The expression to be evaluated if the #test is false.
   */
  else: member function(): !Code.Expr

  _test: private !Code.Expr
  _then: private !Code.Expr
  _else: private !Code.Expr
}
