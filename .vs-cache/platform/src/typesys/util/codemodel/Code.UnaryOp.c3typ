/**
 * A "unary expression" represents setting an operator that takes a single expression, such as `!`. Unary expressions
 * all have separate types. For example {@link Code.Not} for logical not (`!`).
 *
 * @see Code.BinaryOp
 */
abstract type Code.UnaryOp mixes Code.OpExpr {

  /**
   * The expression this operator takes.
   */
  expr: member function(): !Code.Expr

  _expr: private !Code.Expr
  op:    ~: string enum Code.UnaryOperator
  arity: ~
}
