/**
 * A "return" statement exits the current method and optionally provides the expression the method yields.
 */
type Code.Return mixes Code.Stmt {

  /**
   * The value the function will return, if any.
   */
  expr: member function(): Code.Expr

  _expr: private Code.Expr
}
