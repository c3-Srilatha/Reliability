/**
 * Builder for authoring a method.
 *
 * @see Code.Authoring
 */
type Code.Authoring.Method mixes Code.Method, Code.Authoring.WithName, Code.Authoring.MethodBase {

  /**
   * Set the return type of this method.
   */
  returnType: member function(type: !Code.Authoring.TypeBase): !mixing Code.Authoring.Method
}
