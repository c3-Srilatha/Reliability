/**
 * Builder for a binary operator.
 *
 * @see Code.Authoring
 */
type Code.Authoring.BinaryOp mixes Code.BinaryOp, Code.Authoring.Expr {

  /**
   * Set the left-hand-side expression.
   */
  left: member function(left: !Code.Authoring.Expr): !mixing Code.Authoring.BinaryOp

  /**
   * Set the right-hand-side expression.
   */
  right: member function(right: !Code.Authoring.Expr): !mixing Code.Authoring.BinaryOp

  /**
   * Set the operator.
   */
  op: member function(op: !string enum Code.BinaryOperator): !mixing Code.Authoring.BinaryOp
}
