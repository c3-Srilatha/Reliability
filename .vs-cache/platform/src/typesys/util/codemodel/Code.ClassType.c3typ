/**
 * The "class type" represents specific types of classes for languages such as Java that have multiple.
 *
 * @see Code.Class
 */
enum type Code.ClassType {

  CLASS

  @code(js="none", py="none")
  INTERFACE

  @code(js="none", py="none")
  ENUM

  @code(js="none", py="none")
  ANNOTATION

  @code(js="none", py="none")
  ANONYMOUS
}
