/**
 * The shared parts of method-like structures, such as methods and constructors.
 *
 * @see Code.DefinedClass
 */
abstract type Code.MethodBase mixes Code.StmtWithBody, Code.AnnotationTarget, Code.DocumentationTarget, Code.WithMods {

  /**
   * The formal parameters of the method declaration.
   */
  params: member function(): [!Code.MethodParam]

  /**
   * Classes for Java checked exceptions thrown by the method.
   */
  throws: member function(): [!Code.Class]

  /**
   * Get the parent class of this method.
   */
  parentClass: private member function(failIfNone: boolean): Code.DefinedClass

  _params: private [!Code.MethodParam]

  @code(js="none", py="none")
  _throws: private [!Code.Class]
}
