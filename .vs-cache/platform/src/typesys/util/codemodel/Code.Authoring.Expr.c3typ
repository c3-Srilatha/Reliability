/**
 * There is no concrete "expression" node, but it's convenient to be able to create expressions and then use them
 * as elements of other expressions and statements.
 *
 * @see Code.Expr
 */
abstract type Code.Authoring.Expr mixes Code.Expr, Code.Authoring.Node {

  /**
   * Construct a literal null value.
   */
  null_: function(): !Code.Authoring.Literal

  /**
   * Construct a numeric literal node.
   */
  lit: function(value: !number): !Code.Authoring.Literal

  /**
   * Construct a boolean literal node.
   */
  lit: function(value: !boolean): !Code.Authoring.Literal

  /**
   * Construct a string literal node.
   *
   * @param value the string contents, unquoted
   * @param quote the quote character
   */
  lit: function(value: !?string, quote: !int32 = '"'): !Code.Authoring.Literal

  /**
   * Create an expression that will produce the specified value. This works naturally for primitives and some
   * instances, but will not support every possible value.
   */
  value: function(value: !?any, vt: ValueType): !Code.Authoring.Expr

  /**
   * Construct a call to a function.
   */
  call: function(): !Code.Authoring.Call

  /**
   * Construct a call to a named function.
   */
  call: function(name: !string): !Code.Authoring.Call

  /**
   * Construct a call to a type static method.
   */
  staticCall: function(type: !Type, name: !string): !Code.Authoring.Call

  /**
   * Construct a call to an instance member method.
   */
  memberCall: function(target: !Code.Authoring.Expr, name: !string): !Code.Authoring.Call

  /**
   * Construct a ternary condition.
   */
  ternary: function(): !Code.Authoring.TernaryCond

  /**
   * Construct a ternary condition, specifying the test condition.
   */
  ternary: function(test: !Code.Authoring.Expr): !Code.Authoring.TernaryCond

  /**
   * Create a reference to a variable in scope.
   */
  varRef: function(name: !string): !Code.Authoring.FieldRef

  /**
   * Create a reference to a field of an object.
   */
  fieldRef: function(left: !Code.Authoring.Expr, name: !string): !Code.Authoring.FieldRef

  /**
   * Create a reference to a field of a variable.
   */
  fieldRef: function(left: !string, name: !string): !Code.Authoring.FieldRef

  /**
   * Create a reference to an element of a variable.
   */
  elementRef: function(left: !string, index: !int): !Code.Authoring.ElementRef

  /**
   * Create a reference to an element of a variable.
   */
  elementRef: function(left: !string, index: !Code.Authoring.Expr): !Code.Authoring.ElementRef

  /**
   * Create a reference to an element of an expression.
   */
  elementRef: function(left: !Code.Authoring.Expr, index: !int): !Code.Authoring.ElementRef

  /**
   * Create a reference to an element of an expression.
   */
  elementRef: function(left: !Code.Authoring.Expr, index: !Code.Authoring.Expr): !Code.Authoring.ElementRef

  /**
   * Create a reference to a type instance.
   */
  typeRef: function(toType: !Type): !Code.Authoring.TypeRef

  /**
   * Create a reference to a type by name.
   */
  typeRef: function(name: !string): !Code.Authoring.TypeRef

  /**
   * Create a reference to "this" for a member method.
   */
  thisRef: function(): !Code.Authoring.This

  /**
   * Create a reference to a field of "this" for a member method.
   */
  thisField: function(name: !string): !Code.Authoring.FieldRef

  /**
   * Create an assignment expression to a variable name.
   */
  assign: function(name: !string): !Code.Authoring.Assignment

  /**
   * Create an assignment expression to a field.
   */
  assign: function(ref: !Code.Authoring.FieldRef): !Code.Authoring.Assignment

  /**
   * Create an binary operator to test if the value is null.
   */
  isNull: function(left: !Code.Authoring.Expr): !Code.Authoring.BinaryOp

  /**
   * Create an binary operator to test if the variable is null.
   */
  isNull: function(leftName: !string): !Code.Authoring.BinaryOp

  /**
   * Create an binary operator to test if the value is not null.
   */
  isNotNull: function(left: !Code.Authoring.Expr): !Code.Authoring.BinaryOp

  /**
   * Create an binary operator to test if the variable is not null.
   */
  isNotNull: function(leftName: !string): !Code.Authoring.BinaryOp

  /**
   * Create an binary operator.
   */
  binOp: function(): !Code.Authoring.BinaryOp

  /**
   * Create an Obj make expression for the specified type reference.
   */
  objMake: function(type: !Code.Authoring.TypeRef): !Code.Authoring.Make

  /**
   * Create an Obj make expression for the specified type.
   */
  objMake: function(type: !Type): !Code.Authoring.Make
}
