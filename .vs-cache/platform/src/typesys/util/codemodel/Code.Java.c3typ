/**
 * The "java" type is an outer type that contains all the Java-specific AST types. These are mainly implementations
 * of nodes supported by Java.
 */
abstract final type Code.Java mixes Code.Lang, Value {

  /**
   * Write out the modifiers for this piece of structure.
   */
  writeMods: private function(node: !Code.WithMods, writer: !Code.Writer)

  makeWriter: ~
}
