/**
 * Any node that can be annotated is an "annotation target".
 *
 * @see Code.Annotation
 */
abstract type Code.AnnotationTarget {

  /**
   * Annotations that apply to this node.
   */
  annotations: member function(): [Code.Annotation]

  @code(js="none", py="none")
  _annotations: private [Code.Annotation]
}
