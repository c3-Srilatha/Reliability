/**
 * Builder for authoring a conditional (`if`) statement.
 *
 * @see Code.Authoring
 */
type Code.Authoring.Conditional mixes Code.Conditional, Code.Authoring.StmtWithBody, Code.Authoring.Node {

  /**
   * Set the condition expression.
   */
  test: member function(expr: !Code.Authoring.Expr): !mixing Code.Authoring.Conditional

  /**
   * Set the body of the statement, to be executed if the condition is true.
   */
  body: member function(body: !Code.Authoring.Block): !mixing Code.Authoring.Conditional

  /**
   * Set the body of the statement to be another conditional (`else if`) statement.
   */
  elseIf: member function(): !Code.Authoring.Conditional

  /**
   * Set the body of the statement to be another conditional (`else if`) statement and add its body.
   */
  elseIf: member function(test: !Code.Authoring.Expr): !Code.Authoring.Block

  /**
   * Set the body to be an `else` statement and add its body.
   */
  else: member function(): !Code.Authoring.Block
}
