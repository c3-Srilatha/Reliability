/**
 * Builder for a node with a name.
 *
 * @see Code.Authoring
 */
abstract type Code.Authoring.DocumentationTarget mixes Code.DocumentationTarget, Code.Authoring.Node {

  /**
   * Set already-built documentation comment
   */
  doc: member function(comment: !Code.Authoring.DocComment): !mixing Code.Authoring.DocumentationTarget

  /**
   * Set the content of the comentation comment (without the start/end). Delimiters will be added as appropriate for
   * the authoring language, type of comment and whether there are multiple lines or not.
   */
  doc: member function(text: !string): !mixing Code.Authoring.DocumentationTarget
}
