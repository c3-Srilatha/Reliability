/**
 * A "block statement" represents a set of programming language statements, which form the body of a function or loop.
 */
type Code.Block mixes Code.Stmt, WithSize {

  /**
   * The "statements" in a block are usually sub-types of {@link Code.Stmt}, but may also be class
   * definitions for scripting languages or comments.
   */
  stmts: member function(): [Code.Node]

  _stmts: private [Code.Node]
}
