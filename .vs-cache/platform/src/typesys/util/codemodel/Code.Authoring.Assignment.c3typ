/**
 * An assignment expression (or statement for Python).
 *
 * @see Code.Authoring
 */
type Code.Authoring.Assignment mixes Code.Assignment, Code.Authoring.Expr {

  /**
   * Set The left-hand side of the assignment.
   */
  left: member function(expr: !Code.Authoring.AssignmentTarget): !mixing Code.Authoring.Assignment

  /**
   * Set The left-hand side of the assignment to a variable ref.
   */
  left: member function(var: !string): !mixing Code.Authoring.Assignment

  /**
   * Set the assignment operator.
   */
  operator: member function(operator: !string enum Code.AssignmentOperator): !mixing Code.Authoring.Assignment

  /**
   * Set the value that will be assigned.
   */
  expr: member function(expr: !Code.Authoring.Expr): !mixing Code.Authoring.Assignment
}
