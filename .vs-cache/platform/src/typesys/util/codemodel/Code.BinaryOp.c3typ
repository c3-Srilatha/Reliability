/**
 * A "binary expression" represents an operator that takes two single expressions, such as `+`.
 *
 * @see Code.UnaryOp
 */
type Code.BinaryOp mixes Code.OpExpr {

  /**
   * The left-hand-side expression.
   */
  left: member function(): !Code.Expr

  /**
   * The right-hand-side expression.
   */
  right: member function(): !Code.Expr

  _left:  private !Code.Expr
  _right: private !Code.Expr
  op:     ~: !string enum Code.BinaryOperator
  arity:  ~
}
