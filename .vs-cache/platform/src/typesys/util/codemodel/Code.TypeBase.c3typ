/**
 * A "type" represents the reference to a type. This can either be a known value type or a class generated as part of
 * this same code model.
 */
abstract type Code.TypeBase mixes Code.Expr, Code.WithName {

  /**
   * The fully qualified name of the type, including module information such as the Java package.
   */
  fullName: member function(): !string

  _name:     !~
  _fullName: private !string
}
