/**
 * A "parameter" represents a single lambda formal parameter.
 *
 * @see Code.Lambda
 */
type Code.LambdaParam mixes Code.Node, Code.WithName {

  /**
   * The type of the parameter.
   */
  paramType: member function(): Code.TypeBase

  _name: !~

  @code(js="none", py="none")
  _paramType: private Code.TypeBase
}
