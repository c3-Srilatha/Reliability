type Code.Py.Block mixes Code.Block {

  doWrite: ~

  /**
   * Write the body of a function or compound statement. If the block is null or empty, a single "pass" statement is
   * emitted. If specified, the documentation comment will be at the start of the body block.
   */
  _writeBody: private function(writer: !Code.Writer, block: Code.Block, doc: Code.DocComment)
}
