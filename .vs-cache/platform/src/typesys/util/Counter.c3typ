/**
 * Primitive mutable counter. Note that is it not distributed nor thread safe.
 */
type Counter mixes Mutable {

  /**
   * Current count
   */
  count: !int

  /**
   * Increment counter
   */
  increment: member function(): !int

  /**
   * Reset counter to 0
   */
  reset: member function()
}
