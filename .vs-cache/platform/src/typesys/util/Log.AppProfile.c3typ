/**
 * A {@link Log.Profile} where the source log is fetched from the cluster's log aggregator service. For e.g. {@link OpenSearch}
 */
@beta
private type Log.AppProfile mixes DefaultInstance {

  /**
   * Id of the app being profiled
   */
  appId: !string

  /**
   * Whether the application is singleNode. This field is used to build the correct filter for the log aggregator.
   */
  singleNode: boolean

  /**
   * Profiles actions based on the passed {@link Log.AppProfile.ProfileSpec}.
   *
   * @param spec
   *           see {@link Log.AppProfile.ProfileSpec}
   * @return array of {@link Log.AppProfile.ActionsProfilerResult}
   */
  actionProfiler: member function(spec: !Log.AppProfile.ProfileSpec): Log.AppProfile.ProfileResult

  /**
   * Generates a tree of actions based on the provided {@link Log.AppProfile.ProfileSpec}.
   * Note: The groupBy parameter in Log.AppProfile.ProfileSpec within this method supports only two configurations: (a_id, a_pids) or (a_func, a_pfuncs).
   *
   * @param spec
   *           see {@link Log.AppProfile.ProfileSpec}
   * @return array of {@link Log.AppProfile.ActionsProfilerResult}
   */
  flamegraphJson: member function(spec: !Log.AppProfile.ProfileSpec): Log.AppProfile.ProfileResult

  /**
   * Determines if the action profiler for the current application is in a healthy or degraded state.
   *
   * Health Criteria:
   * - The `a_id` field must exist (this is the base filter that returns all actions).
   * - If the action is "root", the `a_func` field must exist for all actions.
   * - If the action is "child", the following fields (`a_pfuncs`, `a_pids`, or `a_func`) must exist for all actions.
   *
   * If any of these conditions are not met, the Log.AppProfiler for this application is considered to be in a degraded state.
   */
  isHealthy: member function(): boolean

  /**
   * Returns the time range of actions for the current application stored in the Log Aggregator.
   */
  timeRange: member function(): !TimeRange

  /**
   * Returns the query used by the log aggregator.
   */
  generateLogAggregatorQuery: member function(spec: !Log.AppProfile.ProfileSpec): json

  inst: ~
}
