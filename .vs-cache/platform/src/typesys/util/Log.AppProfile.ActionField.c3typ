/**
 * A list of action fields used in profiling of the actions.
 */
@beta
private enum type Log.AppProfile.ActionField mixes Log.AppProfile.GroupByField, Log.AppProfile.MetricField {

  /**
   * Timestamp when the action completed.
   */
  TIMESTAMP = '@timestamp'

  /**
   * Unique identifier of the action's root action.
   */
  ACTION_ROOT_ID = 'a_rid'

  /**
   * Unique identifier of the action's parent action.
   */
  ACTION_PARENT_ID = 'a_pid'
}
