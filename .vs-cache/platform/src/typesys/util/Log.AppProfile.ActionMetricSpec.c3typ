/**
 * Defines the configuration for performing statistical computations on application logs during profiling.
 */
@beta
private type Log.AppProfile.ActionMetricSpec {

  /**
   * Statistical computation options for profiling application logs.
   */
  kind: string enum Log.AppProfile.MetricKind

  /**
   * The name of the field on which the statistical computation will be performed.
   */
  actionField: string enum Log.AppProfile.ActionField

  /**
   * Sorts the {@link Log.AppProfile.ProfileAction} based on the metricValue.
   * Note: This sorting is not applicable when Log.AppProfile.MetricKind is set to VALUES.
   */
  order: string enum('asc', 'desc')
}
