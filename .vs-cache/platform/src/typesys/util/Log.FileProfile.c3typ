/**
 * A {@link Log.Profile} where the source log is in the {@link FileSystem}.
 */
type Log.FileProfile mixes Log.Profile {

  /**
   * Reference to file containing the log.
   */
  file: !string serialized File

  /**
   * If true, we will include running actions in the result.
   */
  includeRunning: boolean

  entries: ~
  actions: ~
}
