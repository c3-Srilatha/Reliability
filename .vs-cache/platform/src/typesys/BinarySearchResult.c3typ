/**
 * Result object of binary search result. {@see CollectionWithIndex#binarySearch}
 */
type BinarySearchResult<E> {

  /**
   * If the actual element being searched for was found in the array
   */
  found: boolean

  /**
   * Index at which the element was found. If the exact element was not found, the closest lower element index
   */
  index: !int

  /**
   * The value of the element at the index
   */
  value: E
}
