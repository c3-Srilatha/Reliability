/**
 * The `WithUniqueId` type just defines the required name field, but is used as a mixin for many types which identify
 * their value with a unique label in the parent set.
 *
 * @see WithUniqueId
 */
type WithUniqueName mixes WithGlobalKey {

  /**
   * The unique and required name of this instance.
   */
  name: !string
}
