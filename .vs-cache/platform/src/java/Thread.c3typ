/**
 * Execution thread
 */
type Thread mixes Identified, Nameable, DefaultInstance {

  /**
   * Pause execution on the current thread for given number of milliseconds
   */
  sleep: function(ms: !int)

  /**
   * Retrieve info for this thread
   */
  info: member function(): !ThreadInfo

  /**
   * Interrupt execution of this thread
   */
  interrupt: member function(): string

  /**
   * Abort execution and and terminate this thread; may leak open resources
   */
  stop: member function(): string
}
