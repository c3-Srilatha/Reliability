/**
 * A single element of a Java (server) stack trace.
 *
 * For example:
 * ```
 * c3.studioBase.StudioService_Methods.appAllowAccess(StudioService_Methods.java:340)
 * ```
 *  - className: "c3.studioBase.StudioService_Methods"
 *  - methodName: "appAllowAccess"
 *  - fileName: "StudioService_Methods.java"
 *  - lineNumber: 340
 *
 * @see ExceptionStackTrace
 */
type ThreadStackTraceElement mixes StringSerializable {

  /**
   * The Java class of the method called. This may be abbreviated in some renderings, for example
   * "j.l.NullPointerException" for "java.lang.NullPointerException".
   */
  className: string

  /**
   * The name of the method called in this stack frame.
   */
  methodName: string

  /**
   * The source file name of the method called.
   */
  fileName: string

  /**
   * The source file line number of the method at the point of the exception (or call to another method).
   */
  lineNumber: int32

  /**
   * Build a single element from a Java stack element.
   */
  fromJava: inline function(stackTraceElement: @java(class='java.lang.StackTraceElement') !?native)
                     : mixing ThreadStackTraceElement
}
