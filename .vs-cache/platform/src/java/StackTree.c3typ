/**
 * Hierarchical representation of consumption of any resource. The width at each level of the tree is in the range
 * [0..1] relative to its parent. This leads to a natural presentation as an icicle chart or other tree visualization.
 */
type StackTree mixes Nameable {

  /**
   * Unique label for this node in the tree, at least within its parent.
   */
  name: !~

  /**
   * Width of this node in [0..1] relative to its parent width.
   */
  width: !double

  /**
   * Attributes to be displayed with this node.
   */
  attrs: map<string, string | Dimension>

  /**
   * Immediate children in tree.
   */
  children: [mixing StackTree]
}
