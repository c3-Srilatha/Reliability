/**
 * Statistics for a JVM object memory usage.
 */
type JvmObjMemUsage mixes Result {

  /**
   * Name of the C3 type this object represents.
   */
  c3TypeName: string

  /**
   * Name of the java class.
   */
  javaClassName: string

  /**
   * Count of all instances.
   */
  count: int

  /**
   * Total memory used by this object.
   */
  totalMem: int

  /**
   * Memory used by this object only without children.
   */
  totalSelfMem: int

  /**
   * Unit of memory measure.
   */
  unit: string enum JvmMemoryUnit

  /**
   * Immediate children if JvmProfileMemorySpec#group was set when calling Jvm#profileMemory.
   */
  children: map<string, JvmObjMemUsage>

  /**
   * @return the difference vs other usage.
   */
  diff: member function(other: JvmObjMemUsage): JvmObjMemUsage

  /**
   * @return negates every measure.
   */
  neg: member function(): !JvmObjMemUsage

  /**
   * Reduces depth and limit of the children and optionally discard small objects.
   */
  shrink: member function(depth: int, limit: int, minUsage: int): JvmObjMemUsage
}
