/**
 * JVM heap histogram representing memory usage by class.
 *
 * Obtained via {@link Jvm#heapHisto} which uses JMX DiagnosticCommandMBean (`gcClassHistogram`).
 *
 * @see Jvm#heapHisto
 * @see Jvm.HeapHisto.Entry
 */
type Jvm.HeapHisto mixes WithToString {

  /**
   * Heap histogram entries.
   */
  entries: [Jvm.HeapHisto.Entry]

  /**
   * Number of entries in the histogram.
   */
  @ser(name='size')
  size: property(): !int

  /**
   * Formats the histogram as an ASCII table.
   *
   * @param limit
   *        maximum number of entries to include. Use -1 for all entries. Default is 25.
   * @param width
   *        table width in characters. Default is 120.
   * @return formatted ASCII table string
   */
  print: member function(limit: int = 25, width: int = 120): string

  toString: ~
}
