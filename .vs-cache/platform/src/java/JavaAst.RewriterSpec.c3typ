type JavaAst.RewriterSpec mixes Spec {

  /**
   * Whether to instantiate a symbol solve with the JavaAst.Rewriter. Transformations which needs an instance check
   * will not work without enabling the Symbol solver.
   *
   * @see JavaAst.Rewriter#fromContent
   */
  enableSymbolSolver: boolean
}
