/**
 * Integration with [Async Profiler](https://github.com/jvm-profiling-tools/async-profiler)
 */
@action(authz='always')
type Jvm.AsyncProfiler mixes DefaultInstance {

  /**
   * @return the version of Async Profiler
   */
  version: member function(): string

  /**
   * Checks if the current operating system and architecture are supported by the bundled async-profiler native library
   */
  isSupported: member function(): boolean

  /**
   * @return JVM process id
   */
  pid: member function(): !int32

  /**
   * @return the number of samples collected by the profiler
   */
  samples: member function(): !int

  /**
   * Start profiling the JVM process; profiler will run until {@link #stop} command is explicitly called.
   *
   * @param options
   *        comma separated, profiling options. e.g: 'event=alloc,live,total'
   *
   * @see [Async Profiler options](https://github.com/async-profiler/async-profiler/blob/master/docs/ProfilerOptions.md)
   */
  start: member function(options: string)

  /**
   * Start CPU profiling of the JVM process; profiler will run until {@link #stop} command is explicitly called.
   */
  startCpu: member function(intervalNanos: int)

  /**
   * Start Memory Leak profiling of the JVM process; profiler will run until {@link #stop} command is explicitly called.
   */
  startMem: member function(intervalBytes: string)

  /**
   * Start Memory Allocation profiling of the JVM process; profiler will run until {@link #stop} command is explicitly
   * called.
   */
  startAlloc: member function(intervalBytes: string)

  /**
   * Stop profiling the JVM process and print the report
   */
  stop: member function()

  /**
   * Check if the specified profiling event is available.
   */
  check: member function(event: string): boolean

  /**
   * Show the list of profiling events available for the target process specified with PID.
   */
  list: member function(options: string): string

  /**
   * Print profiling status: whether profiler is active and for how long.
   */
  status: member function(options: string): string

  /**
   * Print used memory statistics.
   */
  meminfo: member function(options: string): string

  /**
   * Dump collected data without stopping profiling session.
   */
  dumpTraces: member function(maxTraces: int32 = 0): string

  /**
   * Dump collected data without stopping profiling session.
   */
  dumpFlat: member function(maxMethods: int32 = 0): string

  /**
   * Dump collected data without stopping profiling session.
   */
  dumpCollapsed: member function(counter: string enum('SAMPLES', 'TOTAL') = 'SAMPLES'): string

  /**
   * Retrieve an interactive flame graph that allows to explore profiling events.
   */
  flameGraph: member function(options: string ...): Html

  /**
   * Retrieve an interactive heatmap that allows to explore profiling events on a timeline.
   */
  heatmap: member function(options: string ...): Html

  /**
   * Retrieve a collection of call stacks, where each line is a  semicolon separated list of frames followed by a
   * counter. This is used by the FlameGraph script to generate the FlameGraph visualization of the profile data.
   */
  collapsed: member function(options: string ...): Content

  /**
   * Retrieve .pb.gz file for Google's [pprof](https://github.com/google/pprof)
   */
  pprof: member function(options: string ...): Content

  /**
   * Retrieve .jfr file from last profiling session.
   */
  jfr: member function(): Content

  /**
   * Execute a profiler command
   *
   * @param command
   *        command and options. e.g: 'start,event=alloc,live,total'
   */
  execute: member function(command: !string): string

  /**
   * Merge multiple JFR Content objects into collapsed stack format. Useful for combining profiling data from
   * multiple sessions into a unified view.
   *
   * @param jfrs
   *        array of JFR Content objects to merge
   * @param options
   *        additional options to pass to the converter
   * @return merged profiling data in collapsed stack format
   */
  mergeCollapsed: member function(jfrs: ![!Content], options: string ...): string

  /**
   * Merge multiple JFR Content objects and generate a unified flame graph visualization.
   *
   * @param jfrs
   *        array of JFR Content objects to merge
   * @param options
   *        additional options to pass to the converter (e.g., --title, --minwidth)
   * @return HTML flame graph of the merged profiling data
   */
  mergeFlameGraph: member function(jfrs: ![!Content], options: string ...): Html

  /**
   * Convert the profiling data to a different format. The default format is `flamegraph` HTML.
   *
   * @see [jfrconv](https://github.com/async-profiler/async-profiler/blob/master/docs/ConverterUsage.md)
   */
  convert: private member function(format: !string enum('html', 'heatmap', 'pb.gz', 'pprof', 'collapsed'),
                                   options: string ...): Content

  /**
   * @return the directory URL where profiler files are stored for cron jobs
   */
  cronDir: member function(): !string serialized FileUrl

  /**
   * Schedule a cron job that periodically checks a condition and dumps profiler data when the condition is true.
   *
   * @param options
   *        profiling options for start command, e.g. 'event=cpu,alloc,live,total'
   * @param conditionJsSrc
   *        JS function source that returns true when profiler data should be dumped, e.g. '() => Jvm.gc().percentUsed() > 80'
   * @param period
   *        period for cron schedule, e.g. '5m' for every 5 minutes
   * @return the created CronJob
   */
  scheduleCron: function(options: string, conditionJsSrc: string, period: string serialized Period): !CronJob
}
