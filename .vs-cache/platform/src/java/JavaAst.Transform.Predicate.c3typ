type JavaAst.Transform.Predicate mixes StringSerializable {

  /**
   * The relevant types `AstTransform` should apply to.
   * Multiple types can be included with a `|`
   */
  resolvedType: !string

  /**
   * The target variable in `AstTransform.from` and `AstTransform.to` this predicate is applicable to
   */
  variable: string = "$1"

  /**
   * Determines whether a transformation is to be applied for when a `variable` is an instance of `resolvedType`
   */
  isInstanceOf: boolean

  /**
   * Returns a JavaAst.Transform.Predicate from a map where the keys are the fields of a JavaAst.Transform.Predicate
   * ```js
   * input = {resolvedType: "type", variable : "$2", isInstanceOf : true}
   * ```
   */
  fromJava: function(jsonMap: !map<string, any>): JavaAst.Transform.Predicate
}
