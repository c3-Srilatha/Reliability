/**
 * An entry in the JVM heap histogram representing memory usage for a single class.
 *
 * @see Jvm.HeapHisto
 * @see Jvm#heapHisto
 */
type Jvm.HeapHisto.Entry mixes WithToString {

  /**
   * Number of instances of this class in the heap.
   */
  instances: int

  /**
   * Total shallow bytes consumed by instances of this class (object headers + field slots, excluding referenced objects).
   */
  @ui(hide=true)
  bytes: int

  /**
   * JVM internal class name (e.g., "java.lang.String", "[B", "[Ljava.util.Map;").
   */
  @ui(hide=true)
  javaClassName: string

  /**
   * Human-readable class name (e.g., "[B" becomes "byte[]", "[Ljava.util.Map;" becomes "java.util.Map[]").
   */
  @ser(name='className')
  @ui(show=true)
  className: cached property(): string

  /**
   * Human-readable formatted bytes (e.g., "1.5 GB", "256 KB").
   */
  @ser(name='bytesFormatted')
  @ui(show=true, align='right')
  bytesFormatted: cached property(): string

  toString: ~
}
