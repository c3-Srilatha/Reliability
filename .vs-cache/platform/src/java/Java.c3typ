/**
 * Interface to Java language.
 */
type Java mixes ImplLanguage, NativeCompat {

  /**
   * Applies given lambda
   */
  @action(authz='always', group='cluster-admin')
  apply: function<T>(action: !lambda(): T): T

  /**
   * Applies given lambda
   */
  @action(authz='always', group='cluster-admin')
  apply: function<T>(action: !lambda(): T, spec: !TimeoutSpec): T

  /**
   * Submits given lambda for asynchronous execution.
   */
  @action(authz='always', group='cluster-admin')
  async: function<T>(action: !lambda(): T, spec: TimeoutSpec): !Promise<T>

  /**
   * Executes Java lambda source code
   *
   * @param java should be a java lambda expression returning value - e.g. `() -> 42` or `() -> { return null; }`
   * @param imports should be `;` separated list of Java classes or C3 type names to import; e.g. `java.util.Map;User`
   */
  @action(authz='always', group='cluster-admin')
  exec: function(java: !string, imports: string): any
}
