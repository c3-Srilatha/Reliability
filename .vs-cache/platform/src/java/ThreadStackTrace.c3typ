/**
 * A Java (server) stack trace. This is a simple list of {@link ThreadStackTraceElement stack frames elements}.
 *
 * For example, in the exception:
 * ```
 * c3.platform.stuff.BadStuff: Bad stuff happened!
 *   at c3.platform.stuff.Stuff.doStuff(Stuff.java:40)
 *   at c3.platform.Main.run(Main.java:10)
 * ```
 * the two lines beginning with "at" are stack frame elements and the whole set together is a "stack trace".
 * The first one is the top element of the stack representing the innermost frame.
 *
 * @see ExceptionStackTrace
 */
type ThreadStackTrace mixes StringSerializable, WithSize {

  /**
   * The individual stack frames, with the innermost one first.
   */
  elements: ![!ThreadStackTraceElement]

  /**
   * Get the innermost stack element in #elements.
   */
  top: property(): !ThreadStackTraceElement

  /**
   * Build a single element from a Java stack element.
   */
  fromJava: inline function(stackTraceElements: @java(class='java.lang.StackTraceElement[]') !?native)
                     : mixing ThreadStackTrace

  /**
   * Produce an MD5 style hash of this stack trace, taking everything into account. This will only match another
   * stack trace that would print identically.
   */
  hashExact: member function(): !string

  /**
   * Produce an MD5 style hash of this stack trace, leaving out variable parts. This will match another stack trace with
   * different line numbers in the elements.
   */
  hashShape: member function(): !string

  /**
   * Whether the other stack trace is the same as this one, taking everything into account. This will only match another
   * stack trace that would print identically.
   */
  equalsExact: member function(other: !?ThreadStackTrace): boolean

  /**
   * Whether the other stack trace is the same as this one, leaving out variable parts. This will match another
   * stack trace with different line numbers in the elements, if the stack contains the same methods.
   */
  equalsShape: member function(other: !?ThreadStackTrace): boolean

  /**
   * Produce a series of string tokens that represent the stack trace elements. If #exact is true, this will
   * include line numbers.
   *
   * This produces roughly what you would see if printed, without any whitespace or punctuation.
   *
   * @param exact if true, include variable parts of the stack trace
   */
  tokens: member function(exact: boolean): stream<string>
}
