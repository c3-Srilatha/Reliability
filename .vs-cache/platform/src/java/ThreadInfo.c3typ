type ThreadInfo mixes Identifiable, Nameable, WithToString {

  state:                  string enum ThreadState
  suspended:              boolean
  inNative:               boolean
  blockedTime:            datetime
  blockedCount:           int
  waitedTime:             datetime
  waitedCount:            int
  lock:                   ThreadLockInfo
  lockName:               string
  lockOwnerId:            int
  lockOwnerName:          string
  startedTime:            datetime
  stackTrace:             [ThreadStackTraceElement]
  lockedMonitors:         [ThreadMonitorInfo]
  lockedSynchronizers:    [ThreadLockInfo]
  suspectedStuckDuration: Duration

  fromJava: inline function(threadInfo: @java(class='java.lang.management.ThreadInfo') !native,
                            suspectedStuckDurationMillis: int): !ThreadInfo

  dumpInfo:       inline member function(): string
  dumpStackTrace: inline member function(padding: string): string
  toString:       ~ java
}
