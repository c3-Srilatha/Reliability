/**
 * Abstract measure of JVM resource usage.
 */
type JvmUsage mixes Result {

  /**
   * Name of the JVM resource.
   */
  name: string

  /**
   * Current usage in `unit`s.
   */
  current: int

  /**
   * Overall capacity `unit`s.
   */
  capacity: int

  /**
   * Percentage of used capacity (0...100).
   */
  percentage: double

  /**
   * Unit of measure.
   */
  unit: string enum JvmMemoryUnit

  /**
   * Current usage in megabytes.
   */
  currentMb: inline member function(): double

  /**
   * Overall capacity megabytes.
   */
  capacityMb: inline member function(): double
}
