/**
 * Memory units used in Jvm operations.
 */
enum type JvmMemoryUnit {

  BYTE = 'BYTE'

  KB = 'KB'

  KiB = 'KiB'

  MB = 'MB'

  MiB = 'MiB'

  GB = 'GB'

  GiB = 'GiB'

  TB = 'TB'

  TiB = 'TiB'

  /**
   * Conversion factor of a given unit to BYTE.
   */
  factor: function(unit: string enum JvmMemoryUnit): !int

  /**
   * Converts value from one memory unit to another.
   */
  convert: function(value: int, from: string enum JvmMemoryUnit, to: string enum JvmMemoryUnit): double
}
