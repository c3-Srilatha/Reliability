/**
 * Options that are supplied to Jmap operations to indicate if all objects or only live objects should be included.
 * @see https://docs.oracle.com/en/java/javase/17/docs/specs/man/jmap.html
 */
enum type Java.JmapObjs {

  /**
   * Jmap operation takes into account all objects in the heap
   */
  all

  /**
   * Jmap operation takes into account only live objects in the heap
   */
  live
}
