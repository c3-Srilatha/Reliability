/**
 * An exception stack trace includes information about the exception, its stack trace, as well as the chain of
 * cause exceptions.
 *
 * ```
 * c3.platform.stuff.BadStuff: Bad stuff happened!
 *   at c3.platform.stuff.Stuff.doStuff(Stuff.java:40)
 *   at c3.platform.Main.run(Main.java:10)
 * Caused by: java.lang.NumberFormatException: For input string: NaN
 *   at java.base/java.lang.NumberFormatException.forInputString(NumberFormatException.java:67)
 *   at java.base/java.lang.Integer.parseInt(Integer.java:668)
 *   ... 59 more
 * ```
 *
 * Note that this example actually has _two_ {@link ThreadStackTrace stack traces}, one for the outer and one for the
 * inner (cause) exception.
 *
 * @see ThreadStackTrace
 */
type ExceptionStackTrace mixes StringSerializable {

  /**
   * The name of the exception class.
   */
  className: string

  /**
   * The error message associated with the exception.
   */
  message: string

  /**
   * The individual stack frames, with the innermost one first.
   */
  stackTrace: ThreadStackTrace

  /**
   * The exception that caused this one to be thrown. This in turn has a class, message and stack trace.
   */
  cause: ExceptionStackTrace

  /**
   * The first line number of the printed exception in the source file. This is where the exception class name appears.
   * This is only set when exceptions are read from a file such as #readFromFile.
   */
  lineNumber: int32

  /**
   * Build from a parsed Java exception.
   */
  fromJava: function(exception: @java(class='java.lang.Throwable') !?native): ExceptionStackTrace

  /**
   * Produce an MD5 style hash of this exception, taking everything into account. This will only match another
   * exception that would print identically.
   *
   * @see #equalsExact
   */
  hashExact: member function(): !string

  /**
   * Produce an MD5 style hash of this exception, leaving out variable parts. This will match another
   * exception with a different message or different line numbers in stack trace elements, if the exception class
   * is the same and the stack contains the same methods.
   *
   * @see #equalsShape
   */
  hashShape: member function(): !string

  /**
   * Whether the other exception is the same as this one, taking everything into account. This will match another
   * exception that would print identically.
   *
   * @see #hashExact
   */
  equalsExact: member function(other: !?ExceptionStackTrace): boolean

  /**
   * Whether the other exception is the same as this one, leaving out variable parts. This will match another
   * exception with a different message or different line numbers in stack trace elements, if the exception class
   * is the same and the stack contains the same methods.
   *
   * @see #hashShape
   */
  equalsShape: member function(other: !?ExceptionStackTrace): boolean

  /**
   * Produce a series of string tokens that represent the exception and its stack trace. If #exact is true,
   * this will include the exception message and line numbers in stack trace elements.
   *
   * This produces roughly what you would see if printed, without any whitespace or punctuation.
   *
   * @param exact if true, include variable parts of the exception and stack trace
   */
  tokens: member function(exact: boolean): stream<string>

  /**
   * Read a stream of exceptions from a text source. This could be a structured server log or a capture of the process
   * standard out/error. In either case, printed exceptions are extracted from the surrounding text and returned in a
   * stream.
   */
  readFromText: function(input: !CharStream): stream<!ExceptionStackTrace>

  /**
   * Read a stream of exceptions from a text file. This could be a structured server log or a capture of the process
   * standard out/error. In either case, printed exceptions are extracted from the surrounding text and returned in a
   * stream.
   *
   * @see Log.File#read
   */
  readFromFile: function(file: !File): stream<!ExceptionStackTrace>

  /**
   * Read a stream of exceptions from a text file. This could be a structured server log or a capture of the process
   * standard out/error. In either case, printed exceptions are extracted from the surrounding text and returned in a
   * stream.
   *
   * @see Log.File#read
   */
  readFromFile: function(file: !string serialized FileUrl): stream<!ExceptionStackTrace>

  /**
   * Extract the first apparent exception with stack trace from the string. Note that this will skip unrecognized
   * lines before the exception class as well as ignorning lines after the stack trace (including other exceptions).
   */
  fromString: ~
}
