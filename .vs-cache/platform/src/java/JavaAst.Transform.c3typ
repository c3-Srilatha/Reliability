type JavaAst.Transform mixes StringSerializable {

  /**
   * The source Java code snippet pattern to apply a transformation to.
   */
  from: !string

  /**
   * The target Java code snippet to transform the @from snippet to.
   * An empty value indicates the Java code snippet needs to be removed.
   */
  to: string

  /**
   * A collection of AstTransform.Predicate conditions for the transformation
   */
  predicates: ![JavaAst.Transform.Predicate]

  /**
   * Returns a JavaAst.Transform from a map where the keys are the fields of the JavaAst.Transform
   * ```js
   * input = {from: "fromType", to: "toType", predicates : List[{resolvedType: "type", variable : "$2", isInstanceOf : true}]
   * ```
   */
  fromJava: function(jsonMap: !map<string, any>): JavaAst.Transform
}
