/**
 * Detailed profile of JVM memory.
 */
type JvmMemProfile mixes Result {

  /**
   * Total memory user by target.
   */
  total: !int

  /**
   * Unit of measure.
   */
  unit: string enum JvmMemoryUnit

  /**
   * If true then java memory allocation instrumentation agent https://github.com/google/allocation-instrumenter was not
   * active so numbers are best guesses.
   *
   * If you are running server locally use `-M` option with `c3-server` to enable memory allocation instrumentation.
   */
  guesstimated: boolean

  /**
   * Statistics for instances by type name or java class name. @see JvmProfileMemorySpec#group.
   */
  objs: map<string, JvmObjMemUsage>

  /**
   * Set to `true` if this profile was produced by #diff method.
   */
  delta: boolean

  /**
   * @return the difference vs other profile.
   */
  diff: member function(other: JvmMemProfile): JvmMemProfile

  /**
   * Reduces depth and limit of the objects and children and optionally discard small objects.
   */
  shrink: member function(depth: int, limit: int, minUsage: int): !JvmMemProfile

  /**
   * Format the profile as a table for display using a fixed-width font.
   */
  formatTable: member function(spec: JvmMemProfileFormatSpec): string

  /**
   * Format and print the profile to the Java print stream, defaulting to standard output.
   */
  printTable: private member function(s: @java(class='java.io.PrintStream') native, spec: JvmMemProfileFormatSpec)
}
