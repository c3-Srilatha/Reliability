type MBeanAttribute {

  hostname:   string
  domain:     string
  name:       string
  attribute:  string
  dataType:   string
  value:      string
  valueList:  [string]
  valueMap:   map<string, string>
  isReadable: boolean
  isWritable: boolean
  get:        function(nameSpec: string, attribute: string): [MBeanAttribute]

  @action(authz='always')
  set: function(nameSpec: string, attribute: string, value: string): [MBeanAttribute]
}
