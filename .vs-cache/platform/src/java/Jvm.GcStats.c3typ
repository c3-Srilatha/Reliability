/**
 * JVM Garbage Collection statistics for a time period.
 *
 * @see Jvm#gcStats
 */
type Jvm.GcStats {

  /**
   * Total number of old-generation GC events in the period.
   */
  count: int

  /**
   * Total time spent in old-generation GC in milliseconds.
   */
  timeMs: int

  /**
   * GC time as percentage of total period (0-100).
   */
  percentTime: double

  /**
   * Current heap memory usage percentage (0-100).
   */
  percentUsed: double
}
