/**
 * Api for controlling the attached java-agent
 */
type JavaAgent mixes Singleton {

  /**
   * Enable/disable method stats collection based on polling threads.
   * This is typically enabled in conjunction with reporting (see enableReporting).
   */
  enableThreadStackPolling: member function(enable: !boolean, pollingIntervalMillis: !int = 1): boolean

  /**
   * Enable/disable method stats collection based on method entry/exit hooks.
   * This is typically enabled in conjunction with reporting (see enableReporting).
   *
   * WARNING: Enabling this *severely* impacts overall JVM performance
   */
  enableMethodEntryExitHooks: member function(enable: !boolean): boolean

  /**
   * Enable/disable periodic logging.  Logs the immediate state of all thread stacks as well as
   * any method performance stats (see enableThreadStackPolling, enableMethodEntryExitHooks)
   */
  enableStatLogging: member function(enable: !boolean, loggingIntervalSecs: !int = 30): boolean

  inst: ~
}
