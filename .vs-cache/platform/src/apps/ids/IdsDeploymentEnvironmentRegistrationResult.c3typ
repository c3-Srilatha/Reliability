/**
 * {@link IdsSetupResult} type describing the registration of a deployment environment in an IDS control tag.
 */
type IdsDeploymentEnvironmentRegistrationResult mixes IdsSetupResult {

  /**
   * Whether or not a {@link Pod} representing the deployment environment was successfully upserted in the IDS control
   * tag.
   */
  registerDeploymentEnvironmentPod: !boolean = false

  /**
   * Whether or not a {@link DeploymentEnvironment} was successfully created in the IDS control tag for the deployment
   * environment.
   */
  registerDeploymentEnvironment: !boolean = false
}
