/**
 * {@link IdsSetupResult} type describing the registration of an IDS control tag in Marketplace (repository.c3-e.com).
 */
type IdsMarketplaceRegistrationResult mixes IdsSetupResult {

  /**
   * Whether or not a {@link Pod} was successfully created in Marketplace describing the IDS control tag.
   */
  registerDevelopmentPodInMarketplace: !boolean = false

  /**
   * Whether or not a {@link User} was created to represent the IDS control tag in Marketplace.
   * This {@link User} will be used as both the PackageManager and Marketplace admin for the IDS control tag.
   */
  registerPmUserInMarketplace: !boolean = false

  /**
   * Whether or not a {@link PlatformOrganization} was created to represent the IDS control tag in Marketplace.
   */
  registerPlatformOrganizationInMarketplace: !boolean = false
}
