/**
 * Spec for setting up a deployment environment for Deployment Pipelines
 */
type IdsDeploymentEnvironmentSetupSpec mixes IdsSetupSpec {

  /**
   * The canonical url of the deployment environment being set up.
   */
  deploymentEnvironmentCanonicalUrl: !string

  /**
   * The alias for the deployment environment to be given to the {@link Pod} that will be created in the IDS control
   * tag.
   */
  deploymentEnvironmentPodName: !string

  /**
   * IMPORTANT: This is the name that will be used for {@link Tag}s created through deployment pipelines.
   *
   * The name of the {@link DeploymentEnvironment} that will be created in the IDS control tag.
   */
  deploymentEnvironmentName: !string

  /**
   * The {@link MetadataWorkspace} that the created {@link DeploymentEnvironment} should be associated with.
   */
  targetSpace: !string
}
