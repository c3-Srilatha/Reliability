/**
 * Tas KnownIssue.
 */
entity type Tas.KnownIssue {

  /**
   * The key for the ticket representing known issue.
   */
  id: ~

  /**
   * The key for the ticket representing known issue.
   */
  jiraKey: string

  /**
   * The summary of the jira ticket representing known issue.
   */
  jiraSummary: string

  /**
   * List of Known errors for the jiraIssue.
   */
  knownErrors: [string]

  /**
   * List of tests that this known issue is applicable to.
   */
  applicableTests: [string]

  /**
   * Whether the matched issue had a ignore all flag, which means all other testcases will be suppressed.
   */
  ignoreAll: boolean = false

  /**
   * Category of the issue.
   */
  category: string enum Tas.KnownIssue.Category = DEFAULT

  /**
   * Produces instances from the provided JiraIssue(s).
   */
  fromJiraIssues: function(issues: !?[JiraIssue]): !?[Tas.KnownIssue] py-server

  /**
   * Default JQL query used to fetch known Unstable / Regression / Flipper tickets from Jira
   */
  jqlForUnstables: cached function(): !string py-server

  /**
   * Fetch Unstable / Regression / Flipper {@link JiraIssue} which were created to keep build green. The query is captured by {@link dfltJqlForUnstables}.
   */
  fetchFromJira: function(): [Tas.KnownIssue] py-server
}
