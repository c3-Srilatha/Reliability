/**
 * Data for each unique Jira Ticket + test failure in the Unstable Test Trend Report on the Jenkins build page.
 * @see Tas.UnstableReport.History
 */
type Tas.UnstableReport {

  /**
   * Jira Ticket Key
   */
  jiraKey: !string

  /**
   * Link to ticket
   */
  jiraLink: !string serialized Url

  /**
   * Ticket title/summary
   */
  jiraSummary: !string

  /**
   * Failed test matched by the jira ticket
   */
  testSuiteName: !string

  /**
   * The trend, an array of previous successes and failures for the branch
   */
  trend: ![Tas.UnstableReport.History]
}
