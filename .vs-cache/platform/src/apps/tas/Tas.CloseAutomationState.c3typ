/**
 * Stored information about the last run of the Jira Ticket Closing Automation for the next run to use.
 */
@db(versionHistory=true)
entity type Tas.CloseAutomationState mixes Identified {

  /**
   * The name of the branch, such as "develop", "release", or "master"
   */
  id: ~

  /**
   * The SHA of the last commit looked at by the automation.
   */
  lastCommit: !string

  /**
   * The timestamp of the last commit looked at. NOT the timestamp of the last run of the automation.
   * The next run of the automation will look at commits after this timestamp.
   */
  timeOfLastCommit: !datetime

  /**
   * Information about the last run of the automation.
   */
  lastRun: JobHistory
}
