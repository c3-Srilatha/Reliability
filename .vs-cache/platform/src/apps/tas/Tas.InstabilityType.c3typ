/**
 * Enum type of instability for {@link Tas.MatchedIssue}
 */
enum type Tas.InstabilityType {

  /**
   * Flipper. Should pass on subsequent attempts in the same build.
   */
  FLIPPER = 'flipper'

  /**
   * Unstable. Should pass on subsequent builds.
   */
  UNSTABLE = 'unstable'

  /**
   * Regression. Consistently failing.
   */
  REGRESSION = 'regression'

  /**
   * Unknown. Not a known issue
   */
  UNKNOWN = 'unknown'
}
