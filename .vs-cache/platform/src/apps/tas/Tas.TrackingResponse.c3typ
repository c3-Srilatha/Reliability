/**
 * Response from TAS when reporting non-test error, such as Build Step failures or thread deadlocks
 */
entity type Tas.TrackingResponse mixes Tas.Response {

  /**
   * @link Tas.MatchedIssue corresponding that was found, or `null` if not found.
   */
  matchedIssue: Tas.MatchedIssue

  /**
   * Type of failure, e.g. Regression, Flipper, Unknown
   */
  failureType: string enum Tas.InstabilityType
}
