/**
 * Test Analyzer Service (TAS)
 * Formerly Jarvis, the Test Analyzer Service handles Flipper, Unstable, and Regression tests.
 * TAS reduces build noise by suppressing known errors from the build pages, while still logging occurrences to the
 * corresponding ticket.
 */
@deprecated(finalVersion="8.8", reason="Use the new C3poClient.Tas instead")
type Tas {

  /**
   * Looks for corresponding Jira ticket, returns Tas.TestSuiteResponse containing new {@link TestSuiteResult} with suppressed known errors per testcase
   * and other information.
   * @param testSuiteResult
   *          {@link TestSuiteResult} to analyze. Looks for known issues for each failed testcase and returns a new
   *          {@link TestSuiteResult} with suppressed errors if found.
   * @param attemptNum
   *          Attempt number, used for populating Jira comment.
   * @return {@link Tas.TestSuiteResponse}
   */
  analyzeFailedTest: function(testSuiteResult: !TestSuiteResult,
                              attemptNum: !int,
                              buildInfo: Tas.BuildInfo): !Tas.TestSuiteResponse

  /**
   * Returns the corresponding Jira ticket for the missing test.
   * @param testName
   *          Name of the ticket to search for, does NOT include prefix.
   *          e.g. if `testName` is "AssertPoly_Test", then it will look for "Unstable: Missing-Test: AssertPoly_Test",
   *          "Unstable: Missing-Test: AssertPoly_Test" etc, as the summary
   * @param buildInfo
   *          {@link Tas.BuildInfo} that TAS uses for tracking and observability
   * @return {@link JiraIssue} if found, null if not.
   */
  analyzeMissingTest: function(testName: !string, buildInfo: Tas.BuildInfo): JiraIssue

  /**
   * Persists {@link Tas.TestSuiteResponse} to TAS standalone remote app for tracking and later use.
   *
   * @param tasResponse
   *          The TAS representation of the test or build step that failed.
   * @param appUrl
   *          Full path for app url, e.g. 'https://ci.c3ci.cloud/c3/tas/'
   * @param authToken
   *          Token auth for the app url path.
   */
  persistTasTestSuiteResponseRemote: function(tasResponse: !Tas.TestSuiteResponse, appUrl: string, authToken: string)

  /**
   * Removes stale {@link Tas.TestSuiteResponse}s from older builds matching branch and build from {@link Tas.BuildInfo}
   *
   * @param buildInfo
   *          {@link Tas.BuildInfo} branch and build for which to prune data
   * @return The number of objs removed as returned by {@link Persistable}.removeAll
   */
  removeStaleResults: function(buildInfo: !Tas.BuildInfo): !int

  /**
   * Persists information about failure for tracking (such as a build step failure). Returns Tas.TrackingResponse with information about Jira ticket, if matched.
   *
   * @param stepName
   *          Name of the step that failed, e.g. 'Run Tests Using Jarvis'
   * @param errMsg
   *          Error message or stacktrace of the step failure
   * @param buildInfo
   *          {@link Tas.BuildInfo} that TAS uses for tracking and observability
   * @return {@link Tas.TrackingResponse}
   */
  reportErrorForTracking: function(stepName: !string,
                                   errMsg: !string,
                                   attemptNum: !int,
                                   buildInfo: Tas.BuildInfo): !Tas.TrackingResponse

  reportPerfMetricError: function(metricName: !string, e: @java(class='java.lang.Throwable') !?native)

  /**
   * Persists {@link Tas.Response} to TAS standalone app for tracking and later use.
   *
   * @param tasResponse
   *          The TAS representation of the test or build step that failed.
   */
  persistTasResponse: function(tasResponse: !Tas.Response)

  /**
   * Persists {@link Tas.BuildInfo} to TAS standalone app for tracking and later use.
   *
   * @param buildInfo
   *          {@link Tas.BuildInfo} that TAS uses for tracking and observability
   */
  persistBuildInfo: function(buildInfo: !Tas.BuildInfo)

  /**
   * Returns a list of {@link Tas.UnstableReport} for errors that TAS caught during the given build.
   *
   * @param buildInfo
   *          {@link Tas.BuildInfo} that TAS to collect the data for
   * @param numPreviousBuilds
   *          Number of previous build to use for the Trend.
   */
  collectUnstableTableEntries: function(buildInfo: !Tas.BuildInfo,
                                        numPreviousBuilds: !int = 50): [!Tas.UnstableReport]

  /**
   * Closes Jira tickets merged into the reference branches (develop, release, master).
   */
  closeMergedJiraTickets: function(repositoryFullName: string = "c3-e/c3server",
                                   branches: [string] = ["develop", "release", "master"],
                                   since: datetime,
                                   until: datetime,
                                   dryRun: boolean = false): [string]

  /**
   * Validate a Jira ticket to ensure it captures any test failures in the target build.
   *
   * @param branchName
   *           The branch name of the target build
   * @param buildNumber
   *           The build number of the target build
   * @param jiraKey
   *           The Jira ticket number to be validated
   */
  verifyTicket: function(branchName: string, buildNumber: string, jiraKey: string): string

  /**
   * Sync JIRA issues with Tas.KnownIssue and return sync results with additional information about the changes done as part of the sync e.g updates, additions and deletions.
   * The "changelog" proves useful in doing simple checks to validate that all changes done by either human or C3po were incorporated in the sync.
   */
  syncKnownIssues: function(isTasRemote: boolean): json py-data-server
}
