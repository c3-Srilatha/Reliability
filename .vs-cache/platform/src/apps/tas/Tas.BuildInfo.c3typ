/**
 * Information that TAS needs for tracking of issue occurrences and provide trace-ability.
 */
entity type Tas.BuildInfo mixes Identified {

  /**
   * Branch for the build.
   * e.g. master
   */
  branch: !string

  /**
   * The Jenkins build number
   */
  buildNumber: !int

  /**
   * The SHA of the commit
   */
  commitSHA: string

  /**
   * link to the Jenkins' build
   */
  jenkinsBuildLink: string

  /**
   * Length of time for entire build, in minutes
   */
  buildDuration: int

  /**
   * Status of the build.
   */
  status: string enum('STABLE', 'UNSTABLE', 'FAILED', 'ABORTED')

  /**
   * Semantic version
   * e.g 7.0.2+5-rc1
   */
  semanticVersion: string serialized SemanticVersion

  /**
   * Creates a Tas.BuildInfo instance with the provided branch and build number
   * @param branch
   *           The full branch, e.g. task/cloud/aa/PLAT-XXXX
   * @param buildNumber
   *
   * @return The new TestProblem instance
   */
  fromBranchAndBuildNum: function(branch: !string, buildNumber: !int, jenkinsBuildLink: string): !Tas.BuildInfo
}
