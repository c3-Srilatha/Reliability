/**
 * Config for {@link Tas}.
 */
@action(group+='cluster-admin')
type Tas.Config mixes Config, Singleton {

  /**
   * Tas app url.
   */
  appUrl: string serialized AppUrl

  /**
   * Auth token to authenticate to Tas app.
   */
  @config(secret=true)
  authToken: string

  /**
   * The interval (number of hours) to consider when scanning reference branches for closing merged Jira tickets.
   */
  numberOfHours: int = 168
}
