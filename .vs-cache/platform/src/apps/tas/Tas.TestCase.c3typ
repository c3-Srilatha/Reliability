/**
 * TAS representation of a testcase. Contains the original error message, {@link Tas.MatchedIssue}, etc.
 */
entity type Tas.TestCase {

  /**
   * Name of test case
   */
  testCaseName: !string

  /**
   * The error message or stacktrace of the failed/errored testcase
   */
  errorMessage: string

  /**
   * The {@link Tas.MatchedIssue} that matched the `errorMessage`
   */
  matchedIssue: Tas.MatchedIssue

  /**
   * Describes whether the matchedIssue was used to suppress the testcase error.
   * False if the matchedIssue was a flipper or the errorMessage not known
   */
  suppressed: boolean = false

  /**
   * Type of failure, e.g. Regression or Flipper, or Unknown
   */
  failureType: string enum Tas.InstabilityType
}
