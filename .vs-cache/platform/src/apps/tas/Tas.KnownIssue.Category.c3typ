/**
 * Tas KnownIssue Category.
 */
enum type Tas.KnownIssue.Category {

  /**
   * Single error that may cause failures in multiple tests.
   */
  INFRA_RELATED

  /**
   * Error/exception to persist for tracking purposes, such as for build step failures or deadlocks. May or may not
   * apply to tests
   */
  TRACKING

  /**
   * Regular test failure.
   */
  DEFAULT
}
