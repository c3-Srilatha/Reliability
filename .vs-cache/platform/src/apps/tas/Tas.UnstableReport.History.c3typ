/**
 * Single datum for the "Trend" in {@link Tas.UnstableReport}.
 */
type Tas.UnstableReport.History {

  /**
   * Link to the build page
   */
  buildLink: string serialized Url

  /**
   * Whether the test originally passed or not (before being caught by TAS).
   *
   * TAS only keeps track of failed tests, so if the the build status is aborted or failed, TAS cannot distinguish between
   * a test passed or was never run. In these cases, classify it as UNKNOWN
   */
  testStatus: !string enum('PASSED', 'FAILED', 'UNKNOWN')
}
