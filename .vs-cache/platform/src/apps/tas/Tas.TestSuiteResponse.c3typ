/**
 * Tas.Response when TAS acts upon a test failure. Contains modified {@link TestSuiteResult} along with
 * various TAS information.
 */
entity type Tas.TestSuiteResponse mixes Tas.Response {

  /**
   * Full name of test, taken from {@link TestCaseResult}
   */
  testName: !string

  /**
   * {@link Tas.TestCase} representation of each testcase with more TAS-related information
   */
  testCases: ![Tas.TestCase]

  /**
   * A modified copy of the {@link TestSuiteResult} after TAS handles known errors.
   */
  testSuiteResult: !TestSuiteResult not persistable

  /**
   * The attempt count of the test
   */
  attemptNum: int
}
