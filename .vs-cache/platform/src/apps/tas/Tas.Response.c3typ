/*
 * Response from TAS apis
 * @see Tas.TestSuiteResponse
 * @see Tas.TrackingResponse
 */
abstract entity type Tas.Response {

  /**
   * If the failure is a known flipper, it should be retried. If it's unstable/regression, there's no point in retrying
   */
  shouldRetry: !boolean = false

  /**
   * Info about the associated build
   */
  buildInfo: !Tas.BuildInfo

  /**
   * The TAS output generated
   */
  logs: string not persistable

  /**
   * Describes the integ group or JarvisStep the test was run on
   */
  buildStepName: string
}
