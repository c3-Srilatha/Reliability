/**
 * Additional information about a Jira Issue matched by TAS
 */
entity type Tas.MatchedIssue {

  /**
   * The {@link JiraIssue} that was matched.
   */
  jiraBaseUrl: private !string = 'https://c3energy.atlassian.net/browse/'

  /**
   * The {@link JiraIssue} that was matched.
   */
  jiraIssue: !Tas.JiraIssue

  /**
   * The key for the ticket that was matched.
   */
  jiraKey: !string

  /**
   * Returns the link to the jira.
   */
  jiraLink: member function(): !string

  /**
   * The summary of the jira ticket that was matched.
   */
  jiraSummary: !string

  /**
   * The known error that was used to match the jiraIssue. Helpful because there are often multiple known errors per
   * ticket
   */
  matchedKnownError: !string

  /**
   * Snapshot of Known errors for the jiraIssue. Helpful because it can change over time. This grants us
   * visibility into the known error at the time of match.
   */
  knownErrorsSnapshot: ![string]

  /**
   * Whether the matched issue had a ignore all flag, which means all other testcases will be suppressed.
   */
  ignoreAll: boolean = false

  /**
   * Type of issue: Test, Infra-Related, Tracking etc.
   */
  issueType: string
}
