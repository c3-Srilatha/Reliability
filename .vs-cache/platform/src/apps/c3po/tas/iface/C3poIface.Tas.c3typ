/**
 * Interface for the TAS: Test Analyzer Service.
 *
 * Test Analyzer Service handles Flipper, Unstable, and Regression tests.
 *
 * TAS reduces build noise by suppressing known errors from the build pages, while still logging occurrences to the
 * corresponding ticket and C3PO database.
 */
type C3poIface.Tas mixes Microservice.Iface
