/**
 * The @webSocket annotation is used for specifying properties for WebSocket handlers.
 * This annotation provides the most commonly needed configuration options for WebSocket endpoints.
 */
@annotation(appliesTo=['type'], configurable=true)
type Ann.WebSocket mixes Annotation {

  /**
   * Endpoint path for which the WebSocket handler should listen (e.g., /websocket, /stream)
   */
  endpoint: string

  /**
   * Maximum message size in bytes (default: 1MB)
   */
  maxMessageSize: int32

  /**
   * Idle timeout in milliseconds after which the connection will be closed (default: 60 seconds)
   */
  idleTimeout: int32

  /**
   * Whether to enable logging for this WebSocket endpoint
   */
  enableLogging: boolean

  /**
   * If set, closes the WebSocket connection when an error occurs during message processing
   */
  closeOnError: boolean

  /**
   * Custom headers to include in WebSocket handshake response
   */
  customHeaders: map<string, string>
}
