/**
 * Allows types to send and receive messages over a WebSocket connection.
 * Allows the clients to Send and Receive Messages as a String and clients are allowed to
 * parse the strings as they wish.
 * Note: this only allows single session web socket connections and can be used for a single user debugger & other
 * single session scenarios
 */
@beta
abstract type WebSocketHandler {

  /**
   * Lambda which needs to be set by the server's WebSocketHandler
   * this lambda will send the message to the Websocket Client
   */
  _sendMessage: private lambda(message: !?string)

  /**
   * Send buffer message
   */
  _sendBuffer: private lambda(message: !?binary)

  /**
   * this lambda will close the connection to the Websocket Client
   */
  _closeHandler: private lambda()

  /**
   * this lambda will be called to check the websocket connection status
   */
  _closed: private lambda(): boolean

  /**
   * Type Implementations which want to listen to the WebSocketMessages will implement this function
   */
  onReceiveMessage: optional member function(message: !?string)

  /**
   * Type implementations that want to listen to the buffer messages sent by the WebSocketClient
   */
  onReceiveBuffer: optional member function(buffer: binary)

  /**
   * Type implementations that want to handle WebSocket exceptions
   */
  onExceptionHandler: optional member function(exception: !?string)

  /**
   * Type implementations that want to handle WebSocket connection close events
   */
  onCloseHandler: optional member function()

  /**
   * Send message to the WebSocket Client
   */
  sendMessage: member function(message: string)

  /**
   * Send a buffer to websocket client
   */
  sendBuffer: member function(message: binary)

  /**
   * Close the connection to the WebSocket Client
   */
  close: member function()

  /**
   * Check the websocket connection status
   */
  isClosed: member function(): boolean
}
