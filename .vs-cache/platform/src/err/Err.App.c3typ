/**
 * Error type relating to App Lifecycle.
 */
// TODO: PLAT-82266 Move all Err.formatted in App Lifecycle code to Err.App
type Err.App mixes Error {

  @error(message="App is must be in test or dev mode to perform this action!", httpCode=403)
  appNotInTestDevMode: function(): !Err.App

  @error(message="The app ${appName} does not exist", httpCode=404)
  invalidApp: function(appName: !?string): !Err.App

  @error(message="User ${user} does not have permission to modify app ${appName}", httpCode=403)
  userNotAuthorizedToModifyApp: function(user: !string, appName: !string): !Err.App
}
