/**
 * Error type representing "connection" error.
 */
type Err.Connection mixes Error {

  @error(message="Error while trying to send a message: ${why} (${statusCode}, ${description})")
  connectionClosed: function(why: !?string, statusCode: !?int, description: !?string): !Err.Connection

  @error(message="Error while trying to send a message: ${why} (${statusCode}, ${description})")
  connectionShutdown: function(why: !?string, statusCode: !?int, description: !?string): !Err.Connection

  @error(message="Failed to connect")
  failedConnection: function(): !Err.Connection

  @error(message="Failed to connect to ${connection}")
  failedConnection: function(connection: !any): !Err.Connection

  @error(message="The request was interrupted on websocket ${webSocketId}")
  requestInterrupted: function(webSocketId: !?int): !Err.Connection
}
