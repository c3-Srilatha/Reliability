/**
 * Error type representing "UserGroup" related authentication/authorization errors.
 */
type Err.UserGroup mixes Error {

  @error(message="UserGroup: ${groupId} is inactive!", httpCode=400)
  inactiveUserGroupException: function(groupId: !string): !Err.UserGroup

  @error(message="Can not create a UserGroup ${userGroupId} if no corresponding role exists", httpCode=400)
  missingUserGroupRoleException: function(userGroupId: !string): !Err.UserGroup

  @error(message="Cannot remove UserGroups with Security Level: ${userGroupId}", httpCode=403)
  cannotRemoveSecurityLeveledUserGroup: function(userGroupId: !string): !Err.UserGroup

  @error(message="User: ${userName} can not modify higher privileged UserGroup: ${userGroupId}", httpCode=403)
  highPrivilegeUserGroupModificationException: function(userName: !string, userGroupId: !string): !Err.UserGroup

  @error(message="UserGroup ${userGroupId} can not have idpGroup mappings on the current app ${appId}", httpCode=400)
  invalidIdpGroupMapOnAppException: function(userGroupId: !string, appId: !string): !Err.UserGroup

  @error(message="Invalid idpGroup: ${idpGroup}. Must be in the format <idpConfig>#<idpGroup>", httpCode=400)
  invalidIdpGroupFormatException: function(idpGroup: !string): !Err.UserGroup

  @error(message="Cannot map existing group ${idpGroup} to another userGroup", httpCode=409)
  conflictingIdpGroupMappingException: function(idpGroup: !string): !Err.UserGroup

  @error(message="IdpGroup ${config}:${idpGroup} is already mapped to UserGroup ${existingUserGroup}", httpCode=409)
  duplicateIdpGroupMappingException: function(config: !string,
                                              idpGroup: !string,
                                              existingUserGroup: !string): !Err.UserGroup
}
