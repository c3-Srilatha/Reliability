/**
 * Error type representing "Database" error.
 */
type Err.Db mixes Error {

  @error(message="Object with id ${quote(id)} does not exist in type ${typeName}!")
  noObjWithSuchId: function(id: !?string, typeName: !?string): !Err.Db

  @error(message="Datastore ${datastore} is not available.")
  datastoreNotAvailable: function(datastore: !?string): !Err.Db

  @error(message="Cannot get a database connection for action ${action} from store ${datastore}: ${message}")
  dataConnectionNotAvailable: function(action: !any, datastore: !?string, message: !?string): !Err.Db

  @error(message="No secondary datastore configured for type ${typeName}")
  noSecondaryDatastore: function(typeName: !?string): !Err.Db

  @error(message="There can only be one C3 tenant!")
  c3TenantAlreadyExists: function(): !Err.Db

  @error(message="Invalid datastore ${datastore}")
  invalidDatastore: function(datastore: !?string): !Err.Db

  @error(message="Redshift datastore ${datastore} can't be used for tenant datastore ${tenantName}")
  redshiftTenantDatastore: function(datastore: !?string, tenantName: !?string): !Err.Db

  @error(message="Cannot init the datastore: ${datastore}, ${ex.message}")
  datastoreInitalizationFailed: function(datastore: !?string, ex: @java(class='java.lang.Throwable') !native): !Err.Db

  @error(message="Cannot start the datastore: ${datastore}, ${ex.message}")
  datastoreStartFailed: function(datastore: !?string, ex: @java(class='java.lang.Throwable') !native): !Err.Db

  @error(message="No ACL authorization to remove Object ${quote(objName)} in type ${typeName}!")
  noAclToRemoveObj: function(objName: !?string, typeName: !?string): !Err.Db

  @error(message="Upsert called with more than one include spec.")
  upsertMultipleInclude: function(): !Err.Db

  @error(message="Internal error: ${err}")
  internalError: function(err: !?string): !Err.Db

  @error(message="Error writing to backup file: ${message}")
  backUpFileWriteFailed: function(message: !?string): !Err.Db

  @error(message="timeslice parameter is not yet supported for explainQuery action")
  timeSliceNotSupportedForExplain: function(): !Err.Db

  @error(message="hierarchyDepth parameter is not yet supported for explainQuery action")
  hierarchyDepthNotSupportedForExplain: function(): !Err.Db

  @error(message="No include spec was found. GetTimeline requires an input.")
  getTimelineRequiresIncludeSpec: function(): !Err.Db

  @error(message="A pending update for ${proposal} would be obsoleted or replaced by another pending update for ${timeSeriesInterval}")
  timeseriesPendingUpdateConflict: function(proposal: !any, timeSeriesInterval: !any): !Err.Db

  @error(message="Array filter for fkey array: ${quote(expr)} uses offset() or limit() in an invalid manner.")
  fkeyArrayFilterOffsetLimitInvalid: function(expr: !?string): !Err.Db

  @error(message="Error removing obj with id ${quote(id)} of type ${quote(typeName)}: ${ex.message}")
  removeAllFailed: function(id: !?string, typeName: !?string, ex: @java(class='java.lang.Throwable') !native): !Err.Db

  @error(message="Version ${version} not found for object of type ${quote(typeName)} with id ${quote(id)}")
  versionNotFound: function(version: !?any, typeName: !?string, id: !?string): !Err.Db

  @error(message="VersionAsOf ${versionAsOf} not found for object of type ${quote(typeName)} with id ${quote(id)}")
  versionAsOfNotFound: function(versionAsOf: !?any, typeName: !?string, id: !?string): !Err.Db

  @error(message="Can't unremove seed data object with id ${quote(id)} in type ${quote(typeName)}. Object does not exist.")
  unremoveSeedObjNotExist: function(id: !?string, typeName: !?string): !Err.Db

  @error(message="Can't fetch on parametric type ${quote(typeName)}.")
  fetchParametricType: function(typeName: !?string): !Err.Db

  @error(message="Projection expression: ${quote(expr)} has args not of map type for 'unique' function.  Not supported.")
  projectUniqueMustOnMapTypes: function(expr: !any): !Err.Db

  @error(message="Could not acquire lock for key ${dbkey} because: ${reason}")
  dbLockTimeout: function(dbkey: !?string, reason: !?string): !Err.Db

  @error(message="Cannot instantiate type ${typeName}, it is parametric and its variables aren't bound. Use the bound parametric type instead (usually reachable from a field).")
  makeGenericType: function(typeName: !?string): !Err.Db

  @error(message="Object ${objName} already exists")
  objectAlreadyExists: function(objName: !?string): !Err.Db

  @error(message="Excessive/infinite recursion detected in field '${typeName}.${fieldName}'.")
  invalidFieldTypeRecursion: function(typeName: !?string, fieldName: !?string): !Err.Db

  @error(message="Already waited 20 minutes for ${db} operator to create a K8sSecret with the resourceName ${resourceName}. But it is still not there.")
  secretTimeout: function(db: !?string, resourceName: !?string): !Err.Db

  @error(message="Invalid index definition: ${indexDef} in type ${typeName}: Invalid field path: ${fieldPath}")
  invalidIndexDef: function(typeName: !?string, indexDef: !?string, fieldPath: !?string): !Err.Db

  @error(message="Invalid index definition: ${indexDef} in type ${typeName}: Invalid field path: ${fieldPath} Reason: ${message}")
  invalidIndexDefWithReason: function(typeName: !?string,
                                      indexDef: !?string,
                                      fieldPath: !?string,
                                      message: !?string): !Err.Db

  @error(message="Invalid unique constraint: ${constraintDef} in type: ${typeName}: Invalid field path: ${fieldPath}")
  invalidUniqueConstraintDef: function(typeName: !?string, constraintDef: !?string, fieldPath: !?string): !Err.Db

  @error(message="Cycle detected on type ${cycleType} for persistable field ${rootTypeName}.${fieldPath}")
  persistableFieldCycle: function(cycleType: !?string, rootTypeName: !?string, fieldPath: !?string): !Err.Db

  @error(message="Value type ${valueType} for field ${fieldName} is not supported in a CompositeKey.")
  unsupportedKeyPartType: function(valueType: !?string, fieldName: !?string): !Err.Db
}
