/**
 * Error type representing "Dispatcher" error.
 */
type Err.Dispatcher mixes Error {

  @error(message="${component} found no route for ${target}, traversed: ${traversed}")
  noRouteFound: function(component: !any, target: !any, traversed: !any): !Err.Dispatcher

  @error(message="Modules for claim are empty and no default module is set on @Port or @Engine: ${method}")
  noModuleForClaim: function(method: !any): !Err.Dispatcher

  @error(message="Types for claim are empty and no default module is set on @Port or @Engine: ${method}")
  noTypeForClaim: function(method: !any): !Err.Dispatcher

  @error(message="Server is stopping")
  serverIsStopping: function(): !Err.Dispatcher

  @error(message="No engine could be found for ${action}")
  noEngineForAction: function(action: !any): !Err.Dispatcher
}
