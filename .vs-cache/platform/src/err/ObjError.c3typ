/**
 * Errors returned for a single obj in the {@link ObjList.errors} array for various operations on {@link Persistable}.
 */
type ObjError mixes BatchError {

  /**
   * Concatenation of all of the error messages for the obj (with already substituted parameters).
   */
  message: !~

  /**
   * Target type of obj that the error(s) was/were encountered for.
   */
  targetType: !string serialized Type

  /**
   * Target id of obj that the error(s) was/were encountered for.
   */
  targetId: !string

  /**
   * Additional info about the errors (e.g. deser source).
   */
  info: string

  /**
   * Map of field level errors for the obj.  The key of the map is the field name and the value is the error instance.
   */
  @db(persistAllFields=true)
  fieldErrors: map<string, Error> schema suffix 'FE'

  /**
   * returns true if any of the errors are a Err.UniqueConstraint instance.
   */
  isAnyUniqueConstraint: member function(): boolean

  fromErrors: ~
}
