/**
 * Error type representing missing "things" in K8s.
 */
type Err.MissingK8s mixes Error {

  @error(message="Missing K8s ${thing}.", httpCode=404)
  missingK8s: function(thing: !?string): !Err.MissingK8s

  @error(message="Missing K8s ${thing} ${name}.", httpCode=404)
  missingK8s: function(thing: !?string, name: !?string): !Err.MissingK8s

  @error(message="Missing K8s ${thing} ${name} for ${for}.", httpCode=404)
  missingK8s: function(thing: !?string, name: !?string, for: !?string): !Err.MissingK8s
}
