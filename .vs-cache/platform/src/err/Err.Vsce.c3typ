/**
 * Error type representing {@link VsCodeServer} error.
 */
type Err.Vsce mixes Error {

  @error(message="VS Code in the browser can only be started in the C3 application of a Single Node Environment.")
  invalidStartingServer: function(): !Err.Vsce

  @error(message="VS Code in the browser is not enabled. To enable it, please contact your Cluster Admin.")
  notEnabled: function(): !Err.Vsce
}
