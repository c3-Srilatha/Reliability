/**
 * This type represents a frame in a stacktrace. This could be from Java or from a scripting language.
 */
type StackFrame mixes ThreadStackTraceElement {

  /**
   * If the frame can be identified with a particular scripting language file, the path to that source file.
   */
  fileMetadataPath: Pkg.Path

  /**
   * Code snippet that threw the error, with line numbers.
   */
  source: string
}
