/**
 * Error type representing "Validation" error. Includes Syntax, Semantic, Reference, and TestSetupFailed errors.
 */
type Err.Validation mixes Error {

  @error(message="Validation error: ${message} ", httpCode=400)
  validationError: function(message: !any): !Err.Validation

  @error(message="Parsing of json failed for ${baseType}!", httpCode=400)
  parsingFailed: function(baseType: !any): !Err.Validation

  @error(message="Parsing of json failed for ${inputLocation} at ${jsonLocation}!", httpCode=400)
  parsingFailed: function(inputLocation: !any, jsonLocation: !any): !Err.Validation

  @error(message="Parsing failed with error: ${ex.message}!", httpCode=400)
  parsingFailed: function(ex: @java(class='java.lang.Throwable') !native): !Err.Validation
}
