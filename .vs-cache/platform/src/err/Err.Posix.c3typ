/**
 * Error type representing POSIX command exception.
 */
type Err.Posix mixes Error {

  @error(message='${err}')
  posixError: function(err: !string): !Err.Posix

  @error(message='Error executing command: ${quote(cmd)}:\n${ex.message}')
  execError: function(cmd: !string, ex: @java(class='java.lang.Exception') native): !Err.Posix

  @error(message='Error executing command: ${quote(cmd)}:\n${err}')
  execErrorMsg: function(cmd: !string, err: !string, ex: @java(class='java.lang.Exception') native): !Err.Posix

  @error(message='Error executing command: ${quote(cmd)}: exit code ${exitCode}')
  execErrorCode: function(cmd: !string, exitCode: !int): !Err.Posix
}
