/**
 * Error type representing wrapped Java Exception.
 */
type Err.JavaException mixes Error {

  @error(message="Internal Java error: ${ex.message}!")
  wrap: function(ex: @java(class='java.lang.Throwable') !native): !Err.JavaException

  @error(message="${message}: ${ex.message}!")
  wrap: function(message: !?string, ex: @java(class='java.lang.Throwable') !native): !Err.JavaException

  @error(message="${message}")
  wrapFormatted: function(message: !string, ex: @java(class='java.lang.Throwable') !native): !Err.JavaException

  @error(message="Multiple internal Java errors!")
  wrap: function(ex: @java(class='java.lang.Throwable') !native ...): !Err.JavaException
}
