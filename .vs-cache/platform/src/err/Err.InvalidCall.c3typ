/**
 * Error type representing invalid call / invocation.
 */
type Err.InvalidCall mixes Error {

  @error(message="Invalid call to ${target}.")
  invalidCall: function(target: !string): !Err.InvalidCall

  @error(message="Invalid call to ${target}: ${reason}.")
  invalidCall: function(target: !string, reason: !?string): !Err.InvalidCall

  @error(message="Invalid call to ${target}: ${ex.message}")
  invalidCall: function(target: !string, ex: @java(class='java.lang.Throwable') !native): !Err.InvalidCall

  @error(message="Invalid call of ${target} from ${fromEngine} to ${toRequirement}.")
  invalidCallFromEngineToRequirement: function(target: !string,
                                               fromEngine: !string serialized Action.Engine,
                                               toRequirement: !string serialized Action.Requirement): !Err.InvalidCall
}
