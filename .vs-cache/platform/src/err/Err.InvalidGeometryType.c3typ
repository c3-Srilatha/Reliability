/**
 * Error type representing invalid C3 Type.
 */
type Err.InvalidGeometryType mixes Err.Db {

  @error(message="InvalidGeometryType : Attempt to insert/update a value for field ${fieldName} with invalid geometry value type: ${typeName}")
  invalidGeometryType: function(fieldName: !string, typeName: !string): !Err.InvalidGeometryType
}
