/**
 * Error type representing invalid value.
 */
type Err.InvalidValue mixes Error {

  @error(message="Invalid obj: ${errs}.")
  invalidObj: function(errs: !map<string, Error>): !Err.InvalidValue

  @error(message="Invalid value ${quote(value)}.")
  invalidValue: function(value: !?native): !Err.InvalidValue

  @error(message="Invalid value ${quote(value)} for ${for}.")
  invalidValue: function(value: !?native, for: !?string): !Err.InvalidValue

  @error(message="Invalid value ${quote(value)} for ${for}: ${ex.message}")
  invalidValue: function(value: !?native,
                         for: !?string,
                         ex: @java(class='java.lang.Throwable') !native): !Err.InvalidValue

  @error(message="Invalid value ${quote(value)} for ${for}: ${detail}")
  invalidValueDetail: function(value: !?native, for: !?string, detail: !string): !Err.InvalidValue

  @error(message="Invalid value ${quote(value)} for field ${typeName}.${fieldName}.")
  invalidFieldValue: function(value: !?native, typeName: !?string, fieldName: !?string): !Err.InvalidValue

  @error(message="Invalid value ${quote(value)} for field ${typeName}.${fieldName}: ${detail}.")
  invalidFieldValue: function(value: !?native,
                              typeName: !?string,
                              fieldName: !?string,
                              detail: !string): !Err.InvalidValue

  @error(message="Invalid ${detail}")
  invalidValueCustom: function(detail: !string): !Err.InvalidValue

  // TODO PLAT-27855 Refactor Err.InvalidValue.c3typ into a more generic Err.Invalid.c3typ
  @error(message="Invalid content: ${detail}")
  invalidContent: function(detail: !string): !Err.InvalidValue
}
