/**
 * Error type representing missing value.
 */
type Err.MissingValue mixes Error {

  @error(message="Missing value for ${for}.")
  missingValue: function(for: !?string): !Err.MissingValue

  @error(message="Missing field value for ${fieldName}.")
  missingFieldValue: function(fieldName: !?string): !Err.MissingValue

  @error(message="Missing field value for ${typeName}.${fieldName}.")
  missingFieldValue: function(typeName: !?string, fieldName: !?string): !Err.MissingValue

  @error(message="Missing method parameter value for ${typeName}.${fieldName}.${paramName}.")
  missingParamValue: function(typeName: !?string, fieldName: !?string, paramName: !?string): !Err.MissingValue

  @error(message="No input object was provided.")
  missingInputObject: function(): !Err.MissingValue
}
