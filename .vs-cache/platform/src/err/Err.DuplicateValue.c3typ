/**
 * Error type representing invalid duplication of a value.
 */
type Err.DuplicateValue mixes Error {

  @error(message="Duplicate value ${quote(value)}.")
  duplicateValue: function(value: !?any): !Err.DuplicateValue

  @error(message="Duplicate value ${quote(value)} for ${for}.")
  duplicateValue: function(value: !?any, for: !?string): !Err.DuplicateValue

  @error(message="Duplicate value ${quote(value)} for ${for}: ${detail}")
  duplicateValueDetail: function(value: !?any, for: !?string, detail: !string): !Err.DuplicateValue

  @error(message="Duplicate ${detail}")
  duplicateValueCustom: function(detail: !string): !Err.DuplicateValue
}
