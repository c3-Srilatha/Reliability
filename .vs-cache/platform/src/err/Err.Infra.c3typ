/**
 * Error type representing "Infra" error where this is an issue related to cluster infra.
 *
 * Primary use is to propagate information regarding infra related issues, causing test to fail.
 */
type Err.Infra mixes Error {

  @error(message="Infrastructure error caused by issues with connection. ${cause}")
  connectionError: function(cause: ?string): !Err.Infra

  @error(message="Error caused due to pod eviction. ${cause}")
  podEvicted: function(cause: ?string): !Err.Infra

  @error(message="${cause}")
  failure: function(cause: ?string): !Err.Infra
}
