type Err.JobRecoverFailing mixes Err.Db {

  @error(message="'${jobType}' job '${jobId}' is 'failing' and can't be recovered until it has 'failed'")
  jobRecoverFailing: function(jobType: !string, jobId: !string): !Err.JobRecoverFailing
}
