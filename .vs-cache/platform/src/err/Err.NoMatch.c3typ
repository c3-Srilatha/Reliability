/**
 * Error type representing "not a match" error.
 */
type Err.NoMatch mixes Error {

  @error(message="Match was not found!")
  noMatch: function(): !Err.NoMatch

  @error(message="${src} does not match ${target}!")
  noMatch: function(src: !any, target: !any): !Err.NoMatch

  @error(message="${srcName} ${src} does not match ${targetName} ${target}!", httpCode=400)
  noMatch: function(srcName: !string, src: !any, targetName: !string, target: !any): !Err.NoMatch
}
