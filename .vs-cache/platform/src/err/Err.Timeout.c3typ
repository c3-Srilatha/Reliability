/**
 * Error type representing "timeout" error.
 */
type Err.Timeout mixes Error {

  @error(message="The request timed out")
  timeout: function(): !Err.Timeout

  @error(message="The request timed out after ${time}")
  timeout: function(time: !any): !Err.Timeout

  @error(message="The request timed out on websocket ${webSocketId}")
  socketTimeout: function(webSocketId: !?int): !Err.Timeout
}
