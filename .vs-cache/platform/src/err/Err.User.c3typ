/**
 * Error type representing "User" related authentication/authorization errors.
 */
type Err.User mixes Error {

  @error(message="User: ${userName} can not modify higher privileged User: ${targetUserId}", httpCode=403)
  highPrivilegeUserModificationException: function(userName: !string, targetUserId: !string): !Err.User

  @error(message="User: ${userName} can not add users to higher privileged UserGroup: ${userGroupId}", httpCode=403)
  highPrivilegeUserGroupAdditionException: function(userName: !string, userGroupId: !string): !Err.User

  @error(message="User: ${userName} can not modify System User: ${systemUserId}", httpCode=403)
  systemUserModificationException: function(userName: !string, systemUserId: !string): !Err.User

  @error(message="TestUser with id ${quote(id)} was not found", httpCode=404)
  testUserNotFound: function(id: !?string): !Err.User

  @error(message="TestIdP#assumeUser does not support C3.ClusterAdmin, C3.EnvAdmin, C3.AppAdmin, or C3.Developer groups",
         httpCode=403)
  forbiddenAssumeUserSecurityLevel: function(): !Err.User
}
