/**
 * Error type representing duplicate id detected on create.
 */
type Err.DuplicateIdForCreate mixes Err.DbRetryableForMerge {

  @error(message="The specified ID ${quote(id)} already exists for type ${typeName}. Please change to a unique ID.")
  duplicateIdForCreate: function(id: !string, typeName: !string): !Err.DuplicateIdForCreate
}
