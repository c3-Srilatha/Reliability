/**
 * Error type representing "Authentication" error.
 */
type Err.Ldap mixes Error {

  @error(message="Failed to connect to LDAP server", httpCode=501)
  ldapConnectionFailed: function(): !Err.Ldap

  @error(message="Trust store path and password must be set in config", httpCode=400)
  ldapTlsMissingTrustStore: function(): !Err.Ldap

  @error(message="Failed to unbind a connection to LDAP server", httpCode=501)
  ldapUnbindFailed: function(): !Err.Ldap

  @error(message="Failed to search in LDAP server for filter", httpCode=501)
  ldapSearchFailed: function(): !Err.Ldap
}
