/**
 * Error type representing index creation error due to syntax of filter sql.
 */
type Err.IndexFilter mixes Err.Db {

  @error(message="Error creating filter sql for index for table '${tableName}', sql: (${sql}): ${message}")
  indexFilterSql: function(tableName: !string, sql: !string, message: !string) : !Err.IndexFilter

  @error(message="Error creating filter sql for index for type '${typeName}', expression: (${filter}): ${message}")
  indexFilterExpr: function(typeName: !string, filter: !string, message: !string) : !Err.IndexFilter
}
