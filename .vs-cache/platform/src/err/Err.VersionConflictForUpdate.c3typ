/**
 * Error type representing db version conflict for update operation.
 */
type Err.VersionConflictForUpdate mixes Err.VersionConflict {

  @error(message="Failed to put entry in kvstore for kvstore=${kvstore},type=${typeName},key=${dbKey},cas=${cas}")
  kvVersionConflictForUpdate: function(kvstore: !?string,
                                       typeName: !?string,
                                       dbKey: !?string,
                                       cas: !?any): !Err.VersionConflictForUpdate

  @error(message="Version Conflict. Update failed because of a version number conflict for type: '${typeName}', id: '${id}'",
         httpCode=409)
  versionConflictForUpdate: function(typeName: !string, id: !string): !Err.VersionConflictForUpdate
}
