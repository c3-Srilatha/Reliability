/**
 * Authentication Errors related to server side issues
 */
type Err.Authn.ServerError mixes Error {

  @error(message='Invalid signature', httpCode=401)
  invalidSignature: function(): !Err.Authn.ServerError

  @error(message='Unable to retrieve user information: ${error}', httpCode=401)
  failedToGetUser: function(error: string): !Err.Authn.ServerError

  @error(message='Session sequence for user: ${quote(userId)} in app: ${quote(appId)} out of sync, tokenSeq: ${quote(tokenSeq)}, srcAppSeq: ${quote(srcAppSeq)}',
         httpCode=401)
  sessionSeqOutOfSync: function(userId: string, appId: string, tokenSeq: int, srcAppSeq: int): !Err.Authn.ServerError

  @error(message='Unable to connect to the authentication server', httpCode=503)
  failedToConnect: function(): !Err.Authn.ServerError

  @error(message="App in prod or trial mode will not validate a token from test or dev mode", httpCode=403)
  appInProdMode: function(): !Err.Authn.ServerError
}
