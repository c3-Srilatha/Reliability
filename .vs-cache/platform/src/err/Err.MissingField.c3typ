/**
 * Error type representing missing / invalid field type or method.
 */
type Err.MissingField mixes Error {

  @error(message="Field ${field} is missing.")
  missingField: function(field: !?string): !Err.MissingField

  @error(message="Type ${typeName} does not declare field: ${field}.")
  missingField: function(typeName: !?string, field: !?string): !Err.MissingField

  @error(message="Method ${method} is missing.")
  missingMethod: function(method: !?string): !Err.MissingField

  @error(message="Type ${typeName} does not declare method: ${method}.")
  missingMethod: function(typeName: !?string, method: !?string): !Err.MissingField
}
