/**
 * This error signals that env-level infrastructure shutdown has failed critically
 */
type Err.App.InfraShutdownEnvFailed mixes Err.App {

  @error(message="Infrastructure shutdown failed for env ${envId} with ${errorCount} errors: ${message}", httpCode=500)
  failure: function(envId: !string, errorCount: !int, message: !string): !Err.App.InfraShutdownEnvFailed
}
