/**
 * Error type representing "Overflow" error. Includes StringOverflow, BinaryOverflow, ArrayOverflow.
 */
type Err.Overflow mixes Error {

  @error(message="${message}")
  overflow: function(message: !string): !Err.Overflow

  @error(message="Index name ${indexName} for table ${tableName} generated for type ${typeName} is longer than ${maxIndexNameLen} characters.")
  indexNameTooLong: function(indexName: !string,
                             tableName: !string,
                             typeName: !string,
                             maxIndexNameLen: !int): !Err.Overflow

  @error(message="Index name ${indexName} for table ${tableName} generated for map field ${typeName} is longer than ${maxIndexNameLen} characters.")
  mapIndexNameTooLong: function(indexName: !string,
                                tableName: !string,
                                typeName: !string,
                                maxIndexNameLen: !int): !Err.Overflow
}
