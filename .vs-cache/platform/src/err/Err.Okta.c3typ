/**
 * Error type representing Okta errors.
 */
type Err.Okta mixes Error {

  @error(message="OktaGroup with groupId ${quote(groupId)} already exists", httpCode=409)
  oktaGroupConflict: function(groupId: !?string): !Err.Okta

  @error(message="OktaUser with email ${quote(email)} already exists", httpCode=409)
  oktaUserConflict: function(email: !?string): !Err.Okta

  @error(message="Okta is not correctly configured. Reason: ${reason}", httpCode=403)
  oktaUnconfigured: function(reason: !?string): !Err.Okta

  @error(message="Waiting for operation ${operation} to update in Okta timed out. Please retry or check if idp is configured correctly",
         httpCode=500)
  oktaWaitForUpdateTimeout: function(operation: !?string): !Err.Okta
}
