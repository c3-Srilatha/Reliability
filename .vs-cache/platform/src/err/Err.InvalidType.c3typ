/**
 * Error type representing invalid C3 Type.
 */
type Err.InvalidType mixes Error {

  @error(message="Invalid type ${typeName}.")
  invalidType: function(typeName: !?string): !Err.InvalidType

  @error(message="Invalid type ${typeName} for ${for}.")
  invalidType: function(typeName: !?string, for: !?string): !Err.InvalidType

  @error(message="Invalid type ${typeName}: ${ex.message}")
  invalidType: function(typeName: !?string, ex: @java(class='java.lang.Throwable') !native): !Err.InvalidType

  @error(message="Invalid type ${typeName} for ${for}: ${ex.message}")
  invalidType: function(typeName: !?string,
                        for: !?string,
                        ex: @java(class='java.lang.Throwable') !native): !Err.InvalidType
}
