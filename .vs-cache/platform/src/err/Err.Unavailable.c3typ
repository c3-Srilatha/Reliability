/**
 * Error type representing Unavailable error for some execution resources (thread, process etc.)
 */
type Err.Unavailable mixes Error {

  @error(message="Unavailable thread in ThreadPool [${threadPoolName}] when running action [${actionName}]")
  threadInThreadPool: function(threadPoolName: !string, actionName: !string): !Err.Unavailable

  @error(message="Unavailable thread in ThreadPool [${threadPoolName}] when running action [${actionType}#${actionName}] after queuing for ${timeout}")
  threadInThreadPoolAfterTimeout: function(threadPoolName: !string,
                                           actionType: !string,
                                           actionName: !string,
                                           timeout: !string serialized Duration): !Err.Unavailable
}
