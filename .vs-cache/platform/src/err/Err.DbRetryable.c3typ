/**
 * Error type representing "Database Retryable" error.
 */
type Err.DbRetryable mixes Err.Db {

  @error(message="An exception occured accessing the database: ${quote(message)}")
  sqlRecoverable: function(message: !string): !Err.DbRetryable

  @error(message="Result set does not exist: ${quote(message)}")
  resultSetDoesntExist: function(message: !string): !Err.DbRetryable

  @error(message="Connection Reset")
  connectionReset: function(): !Err.DbRetryable
}
