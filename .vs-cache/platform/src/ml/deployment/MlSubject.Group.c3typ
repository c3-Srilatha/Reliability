/**
 * Type {@link MlSubject.Group} is a way to group {@link MlSubject}s using filters or grouping on
 * {@link MlProject#subjectType subjectType}.
 *
 * To retrieve the subjects in the segment, use {@link subjects}.
 *
 * {@link MlSubject.Group} for population can be constructed using {@link MlProject#population}.
 */
@dependency(include="this, project.this")
entity type MlSubject.Group mixes WithMlProject, WithSize {

  /**
   * Optional name of the segment.
   */
  name: ~

  /**
   * Filter used to find {@link MlSubject}s that belong to this segment.
   *
   * Note that this filter does not take into account the project's {@link MlProject#subjectFilter subjectFilter}.
   * To retrieve the subjects that are actually in this segment, one should use {@link subjects}.
   */
  subjectFilter: !string serialized Filter

  /**
   * The combination of the segment {@link subjectFilter} with the potential {@link project}'s
   * {@link MlProject#subjectFilter subjectFilter}.
   *
   * To retrieve the subjects that are actually in this segment, use {@link subjects}.
   */
  resolvedSubjectFilter: private cached property(): !string serialized Filter

  /**
   * If applicable, contains link to parent {@link MlSubject.Group}.
   * Used when {@link MlSubject.Group} was created as sub-segment of segment.
   */
  parent: MlSubject.Group

  /**
   * If applicable, shows subsegments that was split from this {@link MlSubject.Group}.
   */
  subSegments: [MlSubject.Group](parent)

  /**
   * If applicable, name of field on {@link MlSubject} (exact type is referenced as
   * {@link MlProject#subjectType subjectType}) that was used for grouping of subjects.
   *
   * This field set by {@link #groupBy}. Same value is used in {@link #subjectFilter} as
   * 'subjectGroupByField == subjectGroupByValue'.
   * Value is stored only for user convenience to show which field of {@link MlSubject} was used to construct this
   * {@link MlSubject.Group} was constructed for.
   *
   * See {@link #subjectGroupByValue}.
   */
  subjectGroupByField: string

  /**
   * If applicable, value of field {@link #subjectGroupByField} on {@link MlSubject} (exact type is referenced as
   * {@link MlProject#subjectType subjectType}) that was used for grouping of subjects.
   *
   * This field set by {@link #groupBy}. Same value is used in {@link #subjectFilter} as
   * 'subjectGroupByField == subjectGroupByValue'.
   * Value is stored only for user convenience to show for which value this {@link MlSubject.Group} was
   * constructed for.
   *
   * See {@link #subjectGroupByField}.
   */
  subjectGroupByValue: any

  /**
   * Make {@link MlSubject.Group} using filter on {@link MlSubject} and {@link MlProject}.
   *
   * @param filter
   *           Filter like expression that will be applied to {@link MlSubject}.
   * @param project
   *           Link to the project that this {@link MlSubject.Group} should belong to.
   * @param name
   *           Optional name for this segment.
   *
   * @return Constructed {@link MlSubject.Group} based on specified filter.
   */
  fromFilter: function(filter: !string serialized Filter, project: !MlProject, name: string): !MlSubject.Group

  /**
   * Make {@link MlSubject.Group} by grouping specified {@link MlSubject}s.
   *
   * @param subjects
   *           List of subjects that need to be grouped in one {@link MlSubject.Group}.
   * @param project
   *           Link to the project that this {@link MlSubject.Group} should belong to.
   * @param name
   *           Optional name for this segment.
   *
   * @return Constructed {@link MlSubject.Group} based on specified list of {@link MlSubject}s.
   */
  fromSubjects: function(subjects: ![MlSubject], project: !MlProject, name: string): !MlSubject.Group

  /**
   * Make {@link MlSubject.Group} by grouping specified {@link MlSubject}s by ids.
   *
   * @param ids
   *           List of ids of {@link MlSubject}s that need to be grouped in one {@link MlSubject.Group}.
   * @param project
   *           Link to the project that this {@link MlSubject.Group} should belong to.
   * @param name
   *           Optional name for this segment.
   *
   * @return Constructed {@link MlSubject.Group} based on specified list of ids.
   */
  fromSubjectIds: function(ids: ![string], project: !MlProject, name: string): !MlSubject.Group

  /**
   * Split {@link MlSubject.Group} into 2 using condition.
   *
   * @param condition
   *           Filter like expression that will be applied to {@link MlSubject}.
   *
   * @return Array of {@link MlSubject.Group}s with 2 elements: first segment will include subjects that match
   *         condition and second will not.
   */
  splitByCondition: member function(condition: !string): ![MlSubject.Group]

  /**
   * Create sub-segment of population by applying additional filter to current segment.
   *
   * @param filter
   *           Filter like expression that will be applied to {@link MlSubject}.
   * @param name
   *           Optional name for this segment.
   *
   * @return Segment that contains subset of {@link MlSubject}s that belongs to parent subject and match filter.
   */
  sub: member function(filter: !string serialized Filter, name: string): !MlSubject.Group

  /**
   * Splits segment by grouping by filed name of the {@link MlSubject}.
   *
   * Method will populate {@link #groupByField} and {@link #groupByValue} fields to distinguish between segments.
   *
   * @param fieldName
   *           Field name of {@link MlSubject} object that we will group on.
   *
   * @return Array of {@link MlSubject.Group}s created for each of value grouping field.
   */
  groupBy: member function(fieldName: !string): ![MlSubject.Group]

  /**
   * Outputs {@link MlSubject}s in current segment.
   * Note that this function relies on {@link resolvedSubjectFilter}.
   *
   * @return Stream of {@link MlSubject}s that belong to this {@link MlSubject.Group}.
   */
  subjects: member function(): stream<MlSubject>

  /**
   * Outputs number of {@link MlSubject}s that belongs to this segment.
   * Note that this function relies on {@link resolvedSubjectFilter}.
   *
   * @return number of subjects in this {@link MlSubject.Group}.
   */
  size: ~

  /**
   * Checks is segment is empty.
   * Note that this function relies on {@link resolvedSubjectFilter}.
   *
   * @return true if there are no {@link MlSubject}s in {@link MlSubject.Group}.
   */
  isEmpty: ~

  /**
   * Process all {@link MlSubject}s in the segment.
   *
   * The field {@link MlSubject.ProcessJob#subjectFilter} will be populated with the segment's {@link subjectFilter}.
   *
   * @param spec
   *          options for the {@link MlSubject.ProcessJob}
   * @return a handle to the asynchronous job execution.
   */
  process: member function(spec: MlSubject.OperationJobSpec): !MlOperationRun<MlSubject.OperationJob.Run>
}
