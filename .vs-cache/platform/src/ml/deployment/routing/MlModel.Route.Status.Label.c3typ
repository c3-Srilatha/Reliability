/**
 * This type holds the possible labels for a deployed {@link MlModel.Route}'s status.
 *
 * @see MlModel.Route.Status#label
 * @see MlModel#deploy
 * @see MlModel.Route#updateStatus
 */
enum type MlModel.Route.Status.Label {

  /**
   * For models that serve the primary predictions for a given {@link MlSubject}.
   * Those predictions are typically used by a downstream user or system, e.g. in a UI or an alerting system.
   */
  CHAMPION

  /**
   * For models that "challenge" a {@link CHAMPION} model, for example to try a new ML approach.
   * The predictions generated by such models are typically analyzed by Data Scientists or a model monitoring system
   * to promote the model to {@link CHAMPION}.
   */
  CHALLENGER

  /**
   * For models that can serve predictions which are not used by a downstream user or system.
   * When a model is deployed, this is the default status of the {@link MlModel.Route} that is returned by
   * {@link MlModel#deploy}.
   */
  CANDIDATE

  /**
   * For models that are not fit for serving anymore.
   * Those models won't be used to compute predictions with {@link MlSubject#process}.
   */
  RETIRED

  isActive: inline function(label: !string enum MlModel.Route.Status.Label): boolean java | js | py
}
