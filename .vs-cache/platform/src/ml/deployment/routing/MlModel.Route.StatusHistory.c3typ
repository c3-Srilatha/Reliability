 * Represents a point in the history of status for a given {@link MlModel.Route}.
 * The current status of a route is accessible through the field {@link MlModel.Route#status}.
 *
 * @see MlModel.Route
 */
@db(timedValueHistoryPreventOverlaps=true)
entity type MlModel.Route.StatusHistory mixes MlModel.Route.Status, TimedIntervalValueHistory<MlModel.Route> {

  parent: !~
}
