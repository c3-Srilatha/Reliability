/**
 * Timed relation between a {@link MlSubject} and a {@link MlModel}.
 * This Type should be subtyped for each subtype of {@link MlSubject}.
 *
 * Usage:
 * ```type
 * entity type WindTurbine mixes MlSubject
 *
 * entity type WindTurbineToModelRelation extends MlSubjectToModelRelation<WindTurbine>
 * ```
 */
// TODO: PLAT-44579 - investigate usage of @db(defaultCommitSize) to make creation/update faster
@db(index=["from", "to", "start", "end", "status", "groupId"])
extendable entity type MlSubjectToModelRelation<S: MlSubject> mixes TimedIntervalRelation<S, MlModel> {

  /**
   * The instance of {@link MlSubject} referenced by the relation.
   */
  from: !~

  /**
   * The {@link MlModel} referenced by the relation
   */
  to: !~

  /**
   * The {@link MlModel.Route} that originated this relation.
   */
  route: !MlModel.Route

  /**
   * The deployment status of the relation, in particular if it is {@link MlModel.Route.Status.Label.CHAMPION CHAMPION},
   * {@link MlModel.Route.Status.Label.CHALLENGER CHALLENGER} or {@link MlModel.Route.Status.Label.RETIRED RETIRED}.
   */
  status: !MlModel.Route.Status

  /**
   * The group ID of the relation, which is used to group together relations that were created as part of the same
   * batch. This can help optimize the fetch of these relations when doing batch operations.
   * For example, see {@link MlModel.Router#updateRouteBatch}.
   */
  groupId: string

  /**
   * @return the Type of the {@link #from} field;
   *         if the current Type is parametric with unbound parameters, an error is thrown.
   */
  subjectType: cached function(): !Type<<MlSubject>>

  /**
   * @return the subtype of {@link MlSubjectToModelRelation} for which the {@link from}
   *         field is of the given `subjectType`; if no such Type is found, an error is thrown.
   */
  forSubjectType: cached function(subjectType: !Type<<MlSubject>>): !Type<<MlSubjectToModelRelation>>
}
