/**
 * This type represents statistics about the deployment of a {@link MlModel}, performed either via
 * {@link MlModel#deploy} or {@link MlModel.Route#updateStatus}.
 */
// TODO: PLAT-44151 - re-enable deployment stats
@beta
type MlModel.RelationRouter.OperationStats mixes Result {

  /**
   * The number of {@link MlSubjectToModelRelation} created by the operation.
   */
  newRelations: int

  /**
   * The number of {@link MlSubjectToModelRelation} deleted by the operation.
   */
  closedRelations: int

  /**
   * The total number of {@link MlSubject} that are affected by the operation, i.e. those selected by both the
   * {@link MlProject#subjectFilter} and the {@link MlModel.Route#subjectFilter}.
   */
  subjectsAffected: int
}
