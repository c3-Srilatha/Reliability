/**
 * A mixin for all the Types whose instances are specific to a {@link MlProject}.
 * This is useful to compartmentalize the artifacts of a {@link MlProject} such as {@link MlModel ML models}
 * or ML predictions.
 */
type WithMlProject {

  /**
   * The project this object belongs to.
   */
  project: !MlProject

  /**
   * The {@link MlSubject} sub-type associated with this object.
   */
  @dependency(include="project.subjectType")
  subjectType: property(): !Type<<MlSubject>>
}
