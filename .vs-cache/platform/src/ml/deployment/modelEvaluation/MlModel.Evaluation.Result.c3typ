/**
 * Represents the evaluation result for a single {@link MlModel} by a single {MlModel.Evaluator.Operation} of a single
 * {@link MlModel.Evaluator}. All results that have the same {@link #evaluator} should be comparable.
 */
type MlModel.Evaluation.Result extends MlWorkflowCoordinatableResult type key 'MER' {

  /**
   * The model to evaluate
   */
  model: !MlModel

  /**
   * {@link MlModel.Evaluator} that produced this result
   */
  evaluator: !MlModel.Evaluator

  /**
   * The name of the {@link MlModel.Evaluator.Operation} that created the artifacts on this result (if status is
   * completed). The specific instance of {@link MlModel.Evaluator.Operation} can be found by using this name and
   * querying `evaluator.operations`.
   */
  operation: !string

  /**
   * The outputs of the evaluation operation, keyed by the result name.
   */
  artifacts: map<string, any>

  startWorkflow: ~
}
