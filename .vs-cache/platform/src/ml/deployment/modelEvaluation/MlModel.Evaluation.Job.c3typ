/**
 * Represents an evaluation job for executing many {@link MlModel.Evaluators} for many {@link MlModel}s.
 * All models should be within the scope of a single {@link MlProject}.
 * Each model will be evaluated against every evaluator specified in {@link #evaluators}.
 * The {@link #evaluators} may be customized per model as per {@link MlModel.Evaluator#evaluatorForModel}.
 *
 * Example usage:
 * ```python
 * #Step 1 - Create evaluators
 * evaluator_usa = c3.MlModel.Evaluator(
 *   id='USA_2020_simple',
 *   scope=c3.MlModel.Evaluator.Scope(
 *     subjectFilter="country=='USA'",
 *     start="2020-01-01",
 *     end="2020-12-31"
 *   ),
 *   operations={
 *     "accuracy": c3.MlModel.Evaluator.ModelMetric(metricNames=["score_accuracy_out"])
 *   }
 * ).create()
 *
 * evaluator_canada = c3.MlModel.Evaluator(
 *   id='CAN_2020_simple',
 *   scope=c3.MlModel.Evaluator.Scope(
 *     subjectFilter="country=='CAN'",
 *     start="2020-01-01",
 *     end="2020-12-31"
 *   ),
 *   operations={
 *     "accuracy": c3.MlModel.Evaluator.ModelMetric(metricNames=["score_accuracy_out"])
 *   }
 * ).create()
 *
 * #Step 2 - Create job
 * evaluation_job = c3.MlModel.Evaluation.Job(evaluators=[evaluator_usa, evaluator_canada]).create()
 *
 * #Step 3 - Start the execution of evaluation job using models
 * operation_run = evaluation_job.start(models=[MlModel1, MlModel2])
 *
 * #(OR) Step 3 - Start the execution of evaluation job using completed MlModel.Train.JobRun
 * operation_run = evaluation_job.start(trainJobRun=train_job_run)
 *
 * #Step 4 - Get all evaluation results
 * evaluation_job_run = operation_run.result()
 * evaluation_results = evaluation_job_run.evaluationResults()
 * ```
 */
@beta
@db(createOnly=true)
entity type MlModel.Evaluation.Job {

  /**
   * List of {@link MlModel.Evaluator}s to be executed in this {@link MlModel.Evaluation.Job}.
   */
  evaluators: ![string serialized MlModel.Evaluator]

  /**
   * Starts an evaluation job for the given models. The resulting {@link MlModel.Evaluation.JobRun}
   * can be used to summarize the evaluation results.
   *
   * @param modelFilter
   *           {@link Filter} for fetching {@link MlModel}s to evaluate.
   * @param spec
   *           customizations for the execution of the evaluation job.
   * @return handle to the async operation.
   */
  start: member function(modelFilter: !string serialized Filter,
                         spec: MlModel.Evaluation.Spec): !MlOperationRun<MlModel.Evaluation.JobRun>

  /**
   * Starts an evaluation job for the given models. The resulting {@link MlModel.Evaluation.JobRun}
   * can be used to summarize the evaluation results.
   *
   * @param models
   *           the models to evaluate.
   * @param spec
   *           customizations for the execution of the evaluation job.
   * @return handle to the async operation.
   */
  start: member function(models: ![string serialized MlModel],
                         spec: MlModel.Evaluation.Spec): !MlOperationRun<MlModel.Evaluation.JobRun>

  /**
   * Starts an evaluation job for trained models produced by {@link MlModel.Train.JobRun}.
   * The resulting {@link MlModel.Evaluation.JobRun} can be used to summarize the evaluation results.
   *
   * @param trainJobRun
   *           {@link MlModel.Train.JobRun} for fetching {@link MlModel}s to evaluate.
   * @param spec
   *           customizations for the execution of the evaluation job.
   * @return handle to the async operation.
   */
  start: member function(trainJobRun: !MlModel.Train.JobRun,
                         spec: MlModel.Evaluation.Spec): !MlOperationRun<MlModel.Evaluation.JobRun>
}
