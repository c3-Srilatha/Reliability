/**
 * Manages the execution of a set of model evaluations, one for each model in {@link #models}. Results can
 * be summarized with the {@link #summary} API.
 * This is created by {@link MlModel.Evaluator#start}.
 */
@deprecated(details="All functionality is now merged with MlModel.Evaluation.JobRun")
type MlModel.Evaluation.Run extends MlWorkflowCoordinatable<MlModel.Evaluation.Result> type key 'MEJR' {

  /**
   * the evaluator performing this evaluation.
   */
  evaluator: !MlModel.Evaluator

  /**
   * the models to evaluate with the {@link #evaluator}.
   */
  models: ![string serialized MlModel]

  /**
   * spec that was used to specify execution constraints for this evaluation run.
   */
  spec: !MlModel.Evaluation.Spec

  generateNextResults:          ~
  startResult:                  ~
  completeResult:               ~
  customSummaryFieldsForResult: ~ py
}
