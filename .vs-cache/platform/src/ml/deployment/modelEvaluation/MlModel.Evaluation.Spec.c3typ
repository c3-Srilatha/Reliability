/**
 * Spec for customizing execution of {@link MlModel.Evaluation.Run}.
 * See {@link MlModel.Evaluator#start}.
 */
type MlModel.Evaluation.Spec mixes JobOptions {

  /**
   * Maximum time allocated for execution of a {@link MlModel.Evaluator} evaluation.
   */
  jobTimeoutMinutes: int

  /**
   * Maximum time allocated for performing a single evaluation operation on a single {@link MlModel}.
   */
  operationTimeoutMinutes: int
}
