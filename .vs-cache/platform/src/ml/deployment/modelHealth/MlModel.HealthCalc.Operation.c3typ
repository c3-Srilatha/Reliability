/**
 * {@link MlModel.HealthCalc.Operation} represents the operation that is used to calculate the health of a model.
 * Since the operation is application-specific, this type is `abstract` and expected to be extended/implemented by
 * the application.
 * The minimum function to override is {@link #calculateHealth}, but {@link #calculateHealthBatch} can optionally be overridden
 * to improve performance.
 * This type is provided to {@link MlModel.HealthCalc.Job}, as specification of the health calculation operation to use.
 */
@beta
abstract type MlModel.HealthCalc.Operation {

  /**
   * Batches up {@link #calculateHealth} calls for multiple models. This function can be optionally overridden to
   * improve the health calculation performance.
   * For example, the metric data for multiple models can be fetched simultaneously in a single database operation if
   * this batched function is overridden. Otherwise, the default implementation is basically just a for-loop
   * with some error-handling.
   */
  calculateHealthBatch: member function(models: ![MlModel],
                                        context: !MlModel.HealthCalc.Context): ![MlModel.Health.Value]

  /**
   * Calculates the health of a single model in a single {@link MlModel.HealthCalc.Context#calcTime} point in time.
   *
   * @param model
   *           the model to calculate the health of.
   * @param context
   *           the context in which to calculate the health of the model. Specifically, this provides the reference time.
   * @return the calculated health of the model.
   */
  calculateHealth: abstract member function(model: !MlModel,
                                            context: !MlModel.HealthCalc.Context): !MlModel.Health.Value
}
