/**
 * Manages the execution of a set of health calculations, one for each model.
 * This is created by {@link MlModel.HealthCalc.Job#start}.
 */
@beta
type MlModel.HealthCalc.JobRun extends MlWorkflowCoordinatable<MlModel.HealthCalc.Result> type key 'MHCJR' {

  /**
   * Reference to the job that created this job run.
   */
  job: !MlModel.HealthCalc.Job

  /**
   * Context for this job run.
   */
  context: !MlModel.HealthCalc.Context

  /**
   * Spec for executing this job.
   */
  spec: !MlModel.HealthCalc.ExecutionSpec

  /**
   * Model filter for fetching {@link MlModel}s to calculate healths for.
   */
  modelFilter: string serialized Filter

  /**
   * List of {@link MlModel}s to calculate healths for.
   */
  models: [string serialized MlModel]

  /**
   * Returns all {@link MlModel.Health.History}s generated by this {@link MlModel.HealthCalc.JobRun}.
   * @param spec
   *    Common specifications for fetching the results.
   * @return a list of {@link MlModel.Health.History}.
   */
  healthHistories: member function(spec: FetchSpec): ![MlModel.Health.History]

  generateNextResults:          ~
  startResult:                  ~
  completeResult:               ~
  customSummaryFieldsForResult: ~ py
}
