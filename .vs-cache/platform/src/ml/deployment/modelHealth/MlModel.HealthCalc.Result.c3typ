/**
 * An instance of {@link MlModel.HealthCalc.Result} represents the execution of health calculations for a batch
 * of models. The actual health values are persisted in {@link MlModel.Health.History}.
 *
 * Instances of this type are intended to be created by {@link MlModel.HealthCalc.Job}.
 */
@beta
type MlModel.HealthCalc.Result extends MlWorkflowCoordinatableResult type key 'MHCR' {

  /**
   * List of models whose health was calculated in this batch.
   */
  models: ![MlModel]

  /**
   * Number of model health calculations that were executed in this batch.
   * See {@link #numCalcErrors} for the number of these that errored.
   */
  numCalcResults: !int = 0

  /**
   * Number of models whose health calculations had errors in this batch.
   */
  numCalcErrors: !int = 0

  /**
   * Returns all {@link MlModel.Health.History}s generated by this {@link MlModel.HealthCalc.Result}.
   * @param spec
   *    Common specifications for fetching the results.
   * @return a list of {@link MlModel.Health.History}.
   */
  healthHistories: member function(spec: FetchSpec): ![MlModel.Health.History]

  /**
   * Calls {@link MlModel.HealthCalc.Operation#calculateHealthBatch} and upserts the computed model healths.
   *
   * @return pair, where first value is total number of {@link MlModel.Health.History} values upserted, and second value
   *           is the number of those that had errors.
   */
  computeAndUpsertHealthBatch: private member function(): !Pair<int, int>

  errors:        ~
  startWorkflow: ~
}
