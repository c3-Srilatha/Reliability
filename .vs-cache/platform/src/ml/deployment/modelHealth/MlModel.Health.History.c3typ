/**
 * An instance of {@link MlModel.Health.History} holds the health for a specific {@link MlModel} at a specific point in time.
 * In aggregate, this persistable type can be used to track the health history of a model.
 *
 * Instances of this type are intended to be created by {@link MlModel.HealthCalc.Job}.
 */
@beta
@db(index+=['calcResult'])
entity type MlModel.Health.History mixes TimedValueHistory<MlModel>, MlModel.Health.Value {

  /**
   * Optional reference to the specific batch in {@link MlModel.HealthCalc.Job} that produced this value.
   */
  calcResult: MlModel.HealthCalc.Result

  /**
   * Optional reference to the {@link MlModel.HealthCalc.JobRun} that produced this value.
   */
  jobRun: MlModel.HealthCalc.JobRun
}
