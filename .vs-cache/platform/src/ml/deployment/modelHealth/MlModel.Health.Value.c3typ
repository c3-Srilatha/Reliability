/**
 * {@link MlModel.Health.Value} represents the result of a single health calculation for an {@link MlModel} for
 * a point in time. Primarily, it is used to represent the return value of {@link MlModel.HealthCalc.Operation#calculateHealth}.
 * See {@link MlModel.HealthCalc.Operation} for more information.
 */
@beta
type MlModel.Health.Value {

  /**
   * A "discretized" health value, representing the health of a model at a point in time. The possible values or
   * enumerations will depend on the application. This is the single "at-a-glance" value that is associated with
   * a model's health in an application.
   * For extra details on health, see {@link #notes}.
   *
   * e.g. "RED", "YELLOW", "GREEN"
   * e.g. "P0", "P1", "P2", "P3", "P4"
   */
  health: string

  /**
   * Optional key-value store for any extra details about health that may be useful to an application user.
   *
   * e.g. {"worst metric": "accuracy", "worst subject": "SKU-1234"}
   * e.g. {"explanation": "The model health is RED because the accuracy of 0.32 is below the threshold of 0.9!"}
   */
  notes: map<string, string>

  /**
   * This field is populated if there was any error raised during the calculation of the health value.
   */
  error: string
}
