/**
 * Interpret result for a {@link MlSubject}. Since multiple {@link MlModel} can be simultaneously deployed on the
 * same subject, this type gathers the different outputs (and potential errors) for further handling.
 *
 * @see MlModel
 * @see MlSubject
 * @see MlSubject#interpret
 */
type MlSubject.InterpretResult mixes MlSubject.OperationResult<any>
