/**
 * Definition of a single batch of model(s) to deploy.
 * One of {@link #models}, {@link #modelFilter}, or {@link trainJobRun} must be populated.
 *
 * @see MlModel#deployBatch
 */
type MlModel.DeployBatch {

  /**
   * List of models to deploy with this {@link #spec}.
   */
  models: [MlModel]

  /**
   * Filter of models to deploy with this {@link #spec}.
   */
  modelFilter: string serialized Filter

  /**
   * All trained models produced by the {@link MlModel.Train.JobRun} will be deployed with this {@link #spec}.
   * Furthermore, unless otherwise specified in the {@link #spec}, the subject filter of the deployment will match
   * the subject filter of training.
   */
  trainJobRun: MlModel.Train.JobRun

  /**
   * Configuration for the deployment. In particular, this holds the specification of the subject filter.
   */
  spec: MlModel.DeploySpec
}
