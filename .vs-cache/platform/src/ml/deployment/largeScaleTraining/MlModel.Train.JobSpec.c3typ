/**
 * Execution constraints for {@link MlModel.Train.Job#start}.
 */
type MlModel.Train.JobSpec mixes MlJobOptions, Spec {

  /**
   * Maximum time allocated for execution of a {@link MlModel.Train.Job}.
   */
  jobTimeoutMinutes: ~

  /**
   * Maximum time allocated for training and scoring a single {@link MlModel}.
   */
  operationTimeoutMinutes: int

  /**
   * Upper bound on total number of {@link MlModel}s that could be trained in parallel during execution of {@link MlModel.Train.Job}.
   */
  @deprecated(details="Will be deprecated in future, Use maxConcurrency field instead")
  maxConcurrentModelTrain: int

  /**
   * Upper bound on total number of {@link MlModel}s that could be trained in parallel during execution of {@link MlModel.Train.Job}.
   */
  maxConcurrency: ~ = 10

  /**
   * If set, then disables scoring trained {@link MlModel}s in execution of a {@link MlModel.Train.Job}.
   */
  doNotScore: boolean
}
