/**
 * Manages creation and execution of {@link Workflow} required for starting and monitoring a {@link MlModel.Train.Job}.
 * {@link MlModel.Train.Job#start} creates a new instance of {@link MlModel.Train.JobRun}.
 */
type MlModel.Train.JobRun extends MlWorkflowCoordinatable<MlModel.Train.Result> type key 'MTJR' {

  /**
   * {@link MlModel.Train.Job} that this job run belongs to.
   */
  trainJob: !MlModel.Train.Job

  /**
   * spec that was used to specify execution constraints for this run.
   */
  spec: !MlModel.Train.JobSpec

  /**
   * {@link MlOperationRun} associated with execution of this {@link MlModel.Train.JobRun}.
   * This is where a developer could find the information for the {@link WorkflowExecutorRun}.
   */
  operationRun: private MlOperationRun

  generateNextResults:          ~ py
  startResult:                  ~ py
  completeResult:               ~ py
  customSummaryFieldsForResult: ~ py

  /**
   * Returns all {@link MlModel.Train.Result}s associated with this job run.
   * @param includeHpo
   *    If True, includes the train results associated with models produced during Hpo experimentation.
   *    This is valid only if {@link MlModel.Train.Template#spec.HpoSpec} is specified and if {@link Hpo.Spec.keepAllTrainedPipes} is True.
   * @param spec
   *    Common specifications for fetching the results.
   * @return a list of {@link MlModel.Train.Result}.
   */
  // TODO: PLAT-48617 - Add hpo support for MlModel.Train.Job
  trainResults: member function(includeHpo: boolean, spec: FetchSpec): ![MlModel.Train.Result] py

  /**
   * Returns a {@link Data} which summarizes {@link MlModel.Train.Result}s for a {@link MlModel.Train.JobRun}.
   * @param includeHpo
   *    If True, includes the train result summaries of models produced during Hpo experimentation.
   *    This is valid only if {@link MlModel.Train.Template#spec.HpoSpec} is specified.
   * @param spec
   *    Common specifications for fetching the results.
   * @return {@link Data} with resultant summary of {@link MlModel.Train.Result}s for a {@link MlModel.Train.JobRun}.
   */
  // TODO: PLAT-48617 - Add hpo support for MlModel.Train.Job
  trainSummary: member function(includeHpo: boolean, spec: FetchSpec): Data py

  /**
   * The result corresponding to this run.
   */
  @deprecated(details="Use operationRun field instead")
  result: private MlModel.Train.JobResult

  /**
   * List of pending {@link MlModel.Train.JobRunEngine.Input}s to be executed.
   * Each element in this list corresponds to input required for {@link MlModel.Train.JobRunEngine#startTrainAndScore}.
   */
  @deprecated(details="Use pendingResults function instead")
  pendingEngineInputs: private [MlModel.Train.JobRunEngine.Input]

  /**
   * List of pairs of {@link MlModel.Train.JobRunEngine.Input} and
   * respective {@link MlOperationRun} used for execution of {@link MlModel.Train.JobRunEngine#startTrainAndScore}.
   */
  @deprecated(details="Use runningResults function instead")
  pendingRuns: private [Pair<MlModel.Train.JobRunEngine.Input, MlOperationRun>]

  /**
   * List of pairs of {@link MlModel.Train.JobRunEngine.Input} and
   * respective {@link MlOperationRun} used for execution of {@link MlModel.Train.JobRunEngine#startTrainAndScore}.
   */
  @deprecated(details="Use completedResults function instead")
  completedRuns: private [Pair<MlModel.Train.JobRunEngine.Input, MlOperationRun>]

  /**
   * Total number of model trainings handled by this {@link MlModel.Train.JobRun}
   */
  @deprecated(details="No longer used by internal implementation")
  expectedModelRuns: private int
}
