/**
 * Specifies the model training template required for {@link MlModel.Train.Group}.
 */
type MlModel.Train.Template {

  /**
   * The underlying model used by this {@link MlModel.Train.Template}.
   */
  model: !MlModel

  /**
   * Customizations for {@link MlPipeline#train}, including {@link HpoSpec}.
   * If {@link MlOperationSpec#xSnapshotIds} or {@link MlOperationSpec#ySnapshotIds} is provided,
   * the same feature set snapshot will be reused across all the {@link MlModel.Train.Group}s that this
   * {@link MlModel.Train.Template} belongs to.
   */
  spec: MlOperationSpec
}
