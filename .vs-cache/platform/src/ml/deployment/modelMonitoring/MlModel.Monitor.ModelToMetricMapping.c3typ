/**
 * Stores the metric names that are used to monitor a {@link MlModel}. Intended to be used as a lookup table to
 * for user interfaces.
 * See related type {@link MlModel.Monitor.TimedResultHeader}.
 */
@db(unique=['model, metricName'], index=['model', 'metricName'])
entity type MlModel.Monitor.ModelToMetricMapping {

  /**
   * {@link MlModel} that is monitored.
   */
  model: !MlModel

  /**
   * the name of the {@link MlScoringMetric} that is used to monitor the {@link #model}.
   */
  metricName: !string

  /**
   * Recommended constructor for making instances of this type. In particular, this constructor will automatically set
   * the id consistently, such that duplicates are avoided.
   *
   * @param model
   *           the {@link MlModel} associated with this series of monitoring results.
   * @param metricName
   *           the name of the {@link MlScoringMetric} that produced this series of results.
   * @return a constructed (but not upserted) instance of this type.
   */
  fromMetric: private function(model: !MlModel, metricName: !string): !mixing MlModel.Monitor.ModelToMetricMapping
}
