/**
 * An instance of {@link MlModel.Monitor.TimedResult} holds the value of a metric for a specific {@link MlModel} for
 * a specific data filter at a specific point in time. In aggregate, this persistable type can be used to track the
 * history of a metric for a model over a certain data filter.
 *
 * Instances of this type are intended to be created by {@link MlModel.Monitor.Job}.
 * Also, see related type {@link MlModel.Monitor.TimedResultHeader}.
 */
@db(index+=['jobRun', 'batchResult'])
entity type MlModel.Monitor.TimedResult mixes TimedValueHistory<MlModel.Monitor.TimedResultHeader>, MlModel.Monitor.Value {

  /**
   * Optional reference to the specific batch in {@link MlModel.Monitor.Job} that produced this value.
   */
  batchResult: MlModel.Monitor.BatchResult

  /**
   * Optional reference to the {@link MlModel.Monitor.JobRun} that produced this value.
   */
  jobRun: MlModel.Monitor.JobRun
}
