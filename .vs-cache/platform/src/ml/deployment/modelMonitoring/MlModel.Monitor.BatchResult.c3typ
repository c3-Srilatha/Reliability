/**
 * {@link MlModel.Monitor.BatchResult} tracks execution metadata for a batch of model monitoring results. The
 * actual results are stored in {@link MlModel.Monitor.TimedResult}, and many could be produced by a single
 * {@link MlModel.Monitor.BatchResult}.
 * This type is intended to be created by {@link MlModel.Monitor.Job}.
 */
@db(index+=['parentJobRun', 'groupIdx'])
type MlModel.Monitor.BatchResult extends MlWorkflowCoordinatableResult type key 'MMBR' {

  /**
   * Index of {@link MlModel.Monitor.Group} in {@link MlModel.Monitor.Job#groups} that this result belongs to.
   */
  groupIdx: !int

  /**
   * {@link MlModel.Monitor.JobRun} that produced this batch.
   */
  parentJobRun: !MlModel.Monitor.JobRun

  /**
   * Batches of calculations that this {@link MlModel.Monitor.BatchResult} is responsible to execute.
   */
  batches: ![MlModel.Monitor.Batch]

  /**
   * Number of model metrics whose calculations were executed in this batch.
   * See {@link #numCalcErrors} for the number of these that errored.
   */
  numCalcResults: !int = 0

  /**
   * Number of model metrics whose calculations had errors in this batch.
   */
  numCalcErrors: !int = 0

  /**
   * Returns all {@link MlModel.Monitor.TimedResult}s associated with this {@link MlModel.Monitor.BatchResult}.
   * @param spec
   *    Common specifications for fetching the results.
   * @return a list of {@link MlModel.Monitor.TimedResult}.
   */
  metricResults: member function(spec: FetchSpec): ![MlModel.Monitor.TimedResult]

  /**
   * Executes all metrics for this monitoring group on the provided batch.
   *
   * @param batch
   *           model and data to compute the metrics over.
   * @return list of {@link MlModel.Monitor.TimedResult}s, one for each metric in the group.
   */
  computeBatch: private member function(batch: !MlModel.Monitor.Batch): ![MlModel.Monitor.TimedResult] py

  /**
   * Executes all of {@link #batches} and upserts the results to {@link MlModel.Monitor.TimedResult}.
   *
   * @return pair, where first value is total number of {@link MlModel.Monitor.TimedResult}s upserted, and second value
   *           is the number of results that had errors.
   */
  computeAndUpsertResults: private member function(): !Pair<int, int>

  errors:        ~
  startWorkflow: ~
}
