/**
 * Spec for {@link MlModel.Monitor.Job} execution.
 */
type MlModel.Monitor.ExecutionSpec mixes MlJobOptions, Spec {

  /**
   * Upper bound on total number of metrics per {@link MlModel.Monitor.Group} that can be executed in parallel.
   */
  maxConcurrency: ~ = 8

  /**
   * Maximum time allocated for execution of a {@link MlModel.Monitor.Job} evaluation.
   */
  jobTimeoutMinutes: ~

  /**
   * Number of {@link MlModel.Monitor.Group}s to execute in a single {@link MlModel.Monitor.BatchGroupRun}.
   * See {@link MlModel.Monitor.BatchResult#batches}.
   */
  groupBatchSize: int = 100
}
