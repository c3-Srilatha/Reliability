/**
 * Type for model monitoring results. Each instance of {@link MlModel.Monitor.Result} holds
 * 1) A model performance value resulting from {@link MlScoringMetric} calculation.
 * 2) Metadata on {@link MlModel.Monitor.Job} and {@link MlModel.Monitor.Group} that this result belongs to.
 * 3) Metadata on how the model performance was calculated such as - groupBy, MlModel, monitorTime etc,.
 */
@deprecated(finalVersion='8.4', details='use MlModel.Monitor.BatchResult instead')
type MlModel.Monitor.Result extends MlWorkflowCoordinatableResult type key 'MMRES' {

  /**
   * {@link MlModel.Monitor.Job} that this result belongs to.
   */
  job: !MlModel.Monitor.Job

  /**
   * Index of {@link MlModel.Monitor.Group} in {@link MlModel.Monitor.Job#groups} that this result belongs to.
   */
  groupIdx: !int

  /**
   * {@link MlModel.Monitor.JobRun} that produced this result.
   */
  parentJobRun: !MlModel.Monitor.JobRun

  /**
   * {@link MlModel} associated with this monitoring result.
   */
  model: MlModel

  // Predictions used for producing this result.
  predictions: private Data | map<string, Data>

  // Labels used for producing this result.
  labels: private Data | map<string, Data>

  // Contexts used for producing this result
  contexts: private map<string, Data>

  /**
   * Date specifying the monitor time of {@link MlModel.Monitor.Job} that produced this result.
   */
  monitorTime: datetime

  /**
   * {@link MlScoringMetric#name} that produced this result.
   */
  metricName: !string

  /**
   * The score produced by the {@link MlScoringMetric}
   */
  metricValue: double

  /**
   * The grouped columns/attributes.
   */
  groupBy: [string]

  /**
   * The grouped column/attribute values, if {@link #groupBy} is present.
   */
  groupByValue: [any]

  /**
   * String representation of the {@link Filter} that corresponds to the {@link #groupBy} and {@link #groupByValue}, as well
   * as the {@link MlModel.Monitor.Group#filter} of the {@link MlModel.Monitor.Group} that this result belongs to.
   * This field is expected to be set automatically and *consistently* by {@link MlModel.Monitor.Job}.
   *
   * e.g. groupBy = ["country", "city"] and groupByValue = ["USA", "NYC"] would produce filter string 'country == "USA" && city == "NYC"'
   * e.g. if there was an additional monitor group filter "assetType == 'windTurbine'", the filter string would be
   *      "(country=='USA' && city=='NYC') && (assetType == 'windTurbine')"
   */
  filter: string serialized Filter

  /**
   * Calculates score for a single metric associated with this {@link MlModel.Monitor.Result}.
   * @return the result of score operation.
   */
  score: private member function(): double py

  /**
   * Helper function to compute the {@link #filter} field from the {@link #groupBy}, {@link #groupByValue}, and
   * {@link MlModel.Monitor.Group#filter} fields.
   * In particular, this is used by {@link MlModel.Monitor.GroupRun} to calculate {@link #filter} when it creates
   * {@link MlModel.Monitor.Result}s.
   */
  combinedFilterFromGroupBy: private member function(): Filter

  startWorkflow: ~ py
}
