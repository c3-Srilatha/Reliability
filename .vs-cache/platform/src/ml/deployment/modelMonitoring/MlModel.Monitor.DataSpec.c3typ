/**
 * Spec holding inputs for customization of {@link MlModel.Monitor.Data#dataGroupsFromSpec}.
 */
type MlModel.Monitor.DataSpec {

  /**
   * {@link MlModel.Monitor.Context} for a {@link MlModel.Monitor.Job}.
   */
  context: !MlModel.Monitor.Context

  /**
   * List of {@link MlModel}s to be monitored.
   */
  models: !(string serialized Filter | [MlModel])

  /**
   * {@link Filter} to select the inputs in scope for {@link MlScoringMetric} calculation.
   * {@link Filter} is specified as part of {@link MlModel.Monitor.Group}.
   */
  filter: string serialized Filter

  /**
   * {@link MlModel.Monitor.Group#groupBy} specified as part of {@link MlModel.Monitor.Group}.
   * It is used for selecting inputs in scope for {@link MlScoringMetric} calculation.
   */
  groupBy: [string]
}
