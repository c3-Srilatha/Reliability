/**
 * Type holding results for execution of {@link MlModel.Monitor.Group}.
 */
type MlModel.Monitor.GroupResult extends MlWorkflowCoordinatableResult type key 'MMGP' {

  /**
   * Index of a {@link MlModel.Monitor.Group} in {@link MlModel.Monitor.Job#groups}.
   */
  idx: !int

  /**
   * Applies {@link MlModel.Monitor.Data#dataGroupsFromSpec} for this {@link MlModel.Monitor.GroupResult},
   * and generates list of {@link MlModel.Monitor.Input}s containing {@link #predictions}/{@link #labels}/{@link #contexts}.
   * Post processes the list of {@link MlModel.Monitor.Input}s to generate a `map<string, MlModel.Monitor.Input>`
   * where the keys are group identifiers constructed as `<model.id>#<groupByValue>`.
   */
  getMonitorInputs: private member function(): !map<string, MlModel.Monitor.Input> py

  /**
   * Returns all {@link MlModel.Model.Result}s associated with this {@link MlModel.Monitor.GroupResult}.
   * @param spec
   *    Common specifications for fetching the results.
   * @return a list of {@link Monitor.Monitor.Result}.
   */
  monitorResults: member function(spec: FetchSpec): ![MlModel.Monitor.BatchResult] py

  startWorkflow: ~ py
}
