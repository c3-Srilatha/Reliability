/**
 * Manages creation and execution of {@link Workflow} required for starting and monitoring a {@link MlModel.Monitor.Job}.
 * {@link MlModel.Monitor.Job#start} creates a new instance of {@link MlModel.Monitor.JobRun}.
 */
type MlModel.Monitor.JobRun extends MlWorkflowCoordinatable<MlModel.Monitor.GroupResult> type key 'MMJR' {

  /**
   * {@link  MlModel.Monitor.Job} that this group run belongs to
   */
  job: !MlModel.Monitor.Job

  /**
   * Context for this job run.
   */
  context: !MlModel.Monitor.Context

  /**
   * Spec for executing this job.
   */
  spec: !MlModel.Monitor.ExecutionSpec

  /**
   * Returns all {@link MlModel.Monitor.TimedResult}s associated with this {@link MlModel.Monitor.JobRun}.
   * @param spec
   *    Common specifications for fetching the results.
   * @return a list of {@link Monitor.Monitor.TimedResult}.
   */
  metricResults: member function(spec: FetchSpec): ![MlModel.Monitor.TimedResult]

  /**
   * Returns all {@link MlModel.Monitor.BatchResult}s associated with this {@link MlModel.Monitor.JobRun}.
   * @param spec
   *    Common specifications for fetching the results.
   * @return a list of {@link MlModel.Monitor.BatchResult}.
   */
  monitorResults: member function(spec: FetchSpec): ![MlModel.Monitor.BatchResult] py

  /**
   * Returns all {@link MlModel.Monitor.GroupResult}s associated with this {@link MlModel.Monitor.JobRun}.
   * @param spec
   *    Common specifications for fetching the results.
   * @return a list of {@link MlModel.Monitor.GroupResult}s.
   */
  groupResults: member function(spec: FetchSpec): ![MlModel.Monitor.GroupResult] py

  generateNextResults:          ~ py
  startResult:                  ~ py
  completeResult:               ~ py
  customSummaryFieldsForResult: ~ py
}
