/**
 * Manages creation and execution of {@link Workflow} required for starting and monitoring a {@link MlModel.Monitor.Group}.
 * {@link MlModel.Monitor.GroupResult#startWorkflow} creates a new instance of {@link MlModel.Monitor.GroupRun}.
 */
@deprecated(finalVersion='8.4', details='use MlModel.Monitor.BatchGroupRun instead')
type MlModel.Monitor.GroupRun extends MlWorkflowCoordinatable<MlModel.Monitor.Result> type key 'MMGR' {

  /**
   * {@link MlModel.Monitor.GroupResult} for executing a {@link MlModel.Monitor.Group} that this run belongs to.
   */
  groupResult: !MlModel.Monitor.GroupResult

  generateNextResults:          ~ py
  startResult:                  ~ py
  completeResult:               ~ py
  customSummaryFieldsForResult: ~ py
}
