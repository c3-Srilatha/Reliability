/**
 * Job to distribute {@link MlModel#interpret} over many subjects and time ranges.
 *
 * Example usage:
 * ```py
 * >>> project = c3.MlProject(...)
 * >>> model = c3.MlModel(project=project, ...)
 * >>> deploy_spec = {"subjectFilter": "1 == 1"}
 * >>> model.deploy(deploy_spec)
 * >>> job_spec = c3.MlSubject.OperationJobSpec(subjectFilter=deploy_spec["subjectFilter"],
 * ...                                          start="2020-01-01",
 * ...                                          end="2020-01-03",
 * ...                                          batchInterval=c3.Interval.DAY,
 * ...                                          project=project)
 * >>> job = c3.MlSubject.InterpretJob(project=project).upsert()
 * >>> job.start(job_spec)
 * ```
 */
entity type MlSubject.InterpretJob extends MlSubject.OperationJob type key 'MSIJ'
