/**
 * Interface for methods used for starting a job to process/interpret many {@link MlModel}s, ex: {@link MlSubject.ProcessJob} and {@link MlSubject.InterpretJob}.
 * Methodology for defining a batch:
 * - subjects are fetched/filtered and are assigned to one or more routes, via routing logic
 * - each route is executed in a separate batch, combining all of its assigned subjects
 * - a given route may participate in more than one batch, if it has many subjects assigned to it - see {@link MlSubject.OperationJobSpec#batchSize}
 * - a given route may also participate in more than one batch, if the time range is large - see {@link MlSubject.OperationJobSpec#batchInterval}
 * - the route defines the model and output handlers to be used for the batch
 *
 * Note: batching in this manner maximizes the number of subjects processed in a single model execution call.
 */
abstract extendable entity type MlSubject.OperationJob mixes WithMlProject {

  /**
   * Starts a job to do the ml operation across all subjects for the given time range, in batches.
   *
   * @param spec
   *           provides the batching specification and execution constraints for this job.
   * @return a handle to the asynchronous execution result.
   */
  start: member function(spec: MlSubject.OperationJobSpec): !MlOperationRun<MlSubject.OperationJob.Run>

  /**
   * Helper function for creating the {@link Workflow} for the execution of this job.
   *
   * @param spec
   *           provides the execution constraints for this job.
   * @return the workflow for this job.
   */
  createWorkflow: private function(spec: !MlSubject.OperationJobSpec): !Workflow

  /**
   * Computes the time range slices required for batching across time for {@link MlSubject.ProcessJob} and {@link MlSubject.InterpretJob}.
   * Note that if either {@link start} or {@link end} is `null`, no slicing is performed.
   * This is used by {@link MlSubject.ProcessJob#doStart} and {@link MlSubject.InterpretJob#doStart}
   *
   * @param start
   *    The start time for batch job.
   * @param end
   *    The end time for batch job.
   * @param interval
   *    {@link MlSubject.OperationJobSpec#batchInterval} used for batching across time.
   *
   * @returns a list of {@link TimeRange}
   */
  computeTimeRanges: function(start: datetime, end: datetime, interval: string): ![TimeRange]
}
