/**
 * Manages creation and execution of {@link Workflow} required for starting and monitoring a {@link MlModel.Route.OperationJob}.
 * {@link MlModel.Route.OperationJob#start} creates a new instance of {@link MlModel.Route.OperationJob.Run}.
 */
@beta
type MlModel.Route.OperationJob.Run extends MlWorkflowCoordinatable<MlModel.Route.OperationJob.Result> type key 'MROJRUN' {

  /**
   * {@link MlModel.Route.OperationJob} that this job run belongs to.
   */
  operationJob: !MlModel.Route.OperationJob

  /**
   * filter expression to select the {@link MlModel.Route}s to run operations on.
   */
  routeFilter: !string serialized Filter

  /**
   * spec that was used to specify execution constraints for this run.
   */
  spec: !MlModel.Route.OperationJobSpec

  generateNextResults:          ~
  startResult:                  ~
  completeResult:               ~
  customSummaryFieldsForResult: ~ py
}
