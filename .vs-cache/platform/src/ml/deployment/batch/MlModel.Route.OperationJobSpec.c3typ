/**
 * Spec for running ML operations on {@link MlModel.Route} at a large scale.
 * See {@link MlModel.Route.OperationJob}.
 */
@beta
type MlModel.Route.OperationJobSpec mixes MlJobOptions, Spec {

  /**
   * If `true`, {@link MlModel.OutputHandler output handlers} specified on {@link MlModel.Route relevant routes}
   * won't be processed.
   */
  doNotHandleOutputs: boolean

  /**
   * Maximum time allocated for execution of a {@link MlModel.Route.OperationJob}.
   */
  jobTimeoutMinutes: ~

  /**
   * Maximum time to wait for the {@link MlModel} operations to complete.
   */
  operationTimeoutMinutes: int
}
