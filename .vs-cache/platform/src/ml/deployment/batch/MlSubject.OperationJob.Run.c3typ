/**
 * Manages creation and execution of {@link Workflow} required for starting and monitoring a {@link MlSubject.OperationJob}.
 * {@link MlSubject.OperationJob#start} creates a new instance of {@link MlSubject.OperationJob.Run}.
 */
type MlSubject.OperationJob.Run extends MlWorkflowCoordinatable<MlSubject.OperationJob.Result> type key 'MSUBRUN' {

  /**
   * {@link MlSubject.OperationJob} that this job run belongs to.
   */
  operationJob: !MlSubject.OperationJob

  /**
   * spec that was used to specify execution constraints for this run.
   */
  spec: !MlSubject.OperationJobSpec

  generateNextResults:          ~
  startResult:                  ~
  completeResult:               ~
  customSummaryFieldsForResult: ~ py
  afterCoordinationComplete:    ~
}
