/**
 * Holds metadata on an operation for an {@link MlModel}, as part of {@link MlSubject.OperationJob.Run}.
 */
type MlSubject.OperationJob.Result extends MlWorkflowCoordinatableResult mixes TimeRange type key 'MSUBRES' {

  /**
   * the route that relates the {@link #model} to the {@link #subjects}. It also contains the handlers
   * used for the operation that was performed.
   */
  route: !MlModel.Route

  /**
   * the subjects that this operation was performed on.
   */
  subjects: ![string serialized MlSubject]

  /**
   * Helper method for {@link #startWorkflow}. Gathers x features and pipeline, and calls
   * `pipeline.<operation>(x, spec)`.
   *
   * @return handle to the asynchronous execution.
   */
  doOperation: private member function(): !MlOperationRun

  /**
   * Helper method for {@link #startWorkflow}. Takes the operation output of {@link #doOperation} and
   * uses the output handlers on {@link #route} to handle it.
   *
   * @param operationOutput
   *           the output of the operation in {@link #doOperation}.
   * @return this.
   */
  handleOperationOutput: private member function(operationOutput: !any): !mixing MlSubject.OperationJob.Result

  startWorkflow: ~
}
