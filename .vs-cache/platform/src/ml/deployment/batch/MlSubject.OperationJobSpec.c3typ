/**
 * Spec for running ML operations on MlSubject at a large scale. Ex: {@link MlSubject.ProcessJob}, {@link MlSubject.InterpretJob}.
 */
type MlSubject.OperationJobSpec mixes MlJobOptions, MlSubject.OperationSpec {

  /**
   * Filter applied on the project to get the {@link MlSubject}s to process on.
   */
  subjectFilter: string serialized Filter

  /**
   * The size of each batch (number of {@link MlSubject}s).
   */
  batchSize: int = 1000

  /**
   * If provided, the job will not only distribute across {@link MlSubject}s but also over time by slicing the
   * time range defined by {@link start} and {@link end} into slices of the given interval.
   * This is useful if you process for a large period and you want to split up the work in even more
   * {@link MlSubject.Batch}es.
   *
   * Note that if either {@link start} or {@link end} is `null`, this field is ignored and no slicing is performed.
   *
   * Example: if there is exactly one week between {@link start} and {@link end}, and if `interval` is
   * {@link Interval#DAY DAY}, then 7 batches will be created for the each batch of subjects.
   */
  batchInterval: string enum Interval

  /**
   * Maximum time allocated for execution of a {@link MlSubject.OperationJob}.
   */
  jobTimeoutMinutes: ~

  /**
   * Specifying a node pool will schedule {@link MlModel#process}, {@link MlModel#interpret}, and {@link MlModel#handleOutput}
   * on this node pool. If not specified, the operations will be scheduled on the default task node pool.
   * Note: The non-compute intensive job coordination tasks continue to be run in the default task node pool.
   */
  nodePool: ~

  supportedFields: ~
}
