/**
 * Optional parameters to deploy a {@link MlModel}.
 *
 * @see MlModel#deploy
 */
type MlModel.DeploySpec mixes Spec {

  /**
   * Filter for the subjects covered by this ML deployment. The filter is applied to the
   * {@link MlProject#subjectType subjectType} of the {@link MlModel#project}.
   *
   * @see MlProject#subjectFilter
   */
  subjectFilter: string serialized Filter

  /**
   * {@link MlModel.OutputHandler Model output handlers} used to post-process model outputs, e.g. transforming and
   * persisting to prediction types or saving to a CSV file.
   * @see MlModel.Route#outputHandlers
   */
  outputHandlers: [MlModel.OutputHandler]

  /**
   * {@link MlModel.OutputHandler Model output handlers} used to post-process model interpretation results, e.g. transforming and
   * persisting to prediction types or saving to a CSV file.
   * @see MlModel.Route#outputHandlers
   */
  interpretHandlers: [MlModel.OutputHandler]

  /**
   * If enabled, then all validation will be skipped. This saves computation cost/time when deploying many models.
   * This option should only be used for stable production flows where the flow has been automated and
   * pre-tested/validated. It is highly encouraged to NOT skip validation when experimenting and developing.
   */
  skipValidation: boolean
}
