/**
 *  An {@link MlModel.OutputHandler} that persists the output to DB.
 *
 *  **Important note**: the type of the pipeline output values must be {@link Data}.
 *
 *  This handler maps the output of prediction output to entity type, and persists the entity type.
 *
 *  The fields of the entity type consists of:
 *  ```
 *  modelId,statusLabel,statusTags,subjectId,predictionTimestamp,field1,field2,...
 *  ```
 *  where:
 *   - `modelId` is the ID of the {@link MlModel};
 *   - `statusLabel` is the {@link MlModel.Route.Status.Label status label} of the route;
 *   - `statusTags` is a string representing the (optional) {@link MlModel.Route.Status#tags} of the route;
 *   - `subjectId` is the ID of the {@link MlSubject} for which the output is computed;
 *   - `outputTimestamp` is the timestamp for which the output is computed (optional, it is present only when
 *      there is a {@link Feature#TIMESTAMP timestamp} column in the {@link Data} to process);
 *   - `field1,field2,...` correspond to the mapped columns of the output to process (see {@link columnMapping}).
 *
 *  Each row of the entity type correspond to a row in the {@link Data} object processed by the handler.
 *
 *  **NOTE**: This handler only supports single pipeline output, so `outputNames` should be singleton or empty.
 *
 *  User must create the entity type `c3.MlTestPredictionHandler` before instantiating {@link MlModel.OutputHandler}
 *  Usage:
 *  ```python
 *  handler = c3.MlModel.DbOutputHandler(
 *      outputNames=["predictions"],
 *      targetType = c3.MlTestPredictionHandler,
 *      columnMapping={
 *          "mean": "value",
 * "subjectId" : "assetId",
 *      },
 *  )
 *  ```
 */
type MlModel.DbOutputHandler mixes MlModel.DataOutputHandler {

  doProcess: ~
  validate:  ~

  /**
   * Entity type associated with this {@link MlModel.DbOutputHandler},
   * used for writing {@link MlModel} outputs to database.
   */
  targetType: !Type<<Persistable>>

  /**
   * Transform and persist output data in DB.
   *
   * @param route
   *    the route argument passed to {@link process}
   * @param output
   *    the output to convert; the columns are mapped using {@link columnMapping}
   */
  write: private member function(route: !MlModel.Route, output: !Data) py
}
