/**
 * A future-like interface that holds the run details of {@link MlModel#train training}.
 */
// TODO: PLAT-85302 remove remixable.
@db(systemType=true)
@typesys(remixable=true)
entity type MlModel.OperationRun mixes AsyncJobRun<any, Workflow.Status> schema name 'MLMODEL_RUN' {

  /**
   * Holds {@link MlModel} that this operation was executed on.
   */
  @db(persistAllFields=true)
  model: !MlModel

  /**
   * Holds execution run details of operation.
   */
  trainingRun: !MlOperationRun<any>

  /**
   * {@link MlModel.Input} that captures the inputs used for {@link MlModel#train}.
   */
  trainInput: MlModel.Input

  /**
   * Blocking call to return result of operation
   * @param timeoutMinutes
   *          maximum time to wait for operation to complete, in minutes
   * @param displayStatus
   *          If True, display current status periodically while waiting for completion of {@link #trainingRun}
   * @param spec
   *         {@link WaitSpec} for customization of sleep time for polling status of {@link #trainingRun}
   * @return MlModel with trained
   */
  @dependency(include="this, model, trainingRun, trainInput")
  result: member function(timeoutMinutes: int, displayStatus: boolean = False, spec: WaitSpec): !MlModel

  /**
   * Attempts to cancel a running run of {@link #trainingRun}.
   */
  cancel: member function(): Workflow.Status py

  /**
   * NOTE: This method currently raises a C3 NotImplementedError.
   *
   * @inheritdoc
   */
  // TODO: PLAT-72215 Implement this method, not throw an error
  @beta
  promise: ~

  @dependency(include="this, trainingRun")
  status: ~
}
