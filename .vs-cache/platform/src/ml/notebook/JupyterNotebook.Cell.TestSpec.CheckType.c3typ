/**
 * Enum of available check types.
 */
enum type JupyterNotebook.Cell.TestSpec.CheckType {

  /**
   * Cell considered passing if no uncaught exceptions during execution.
   */
  NOERRORS = "noErrors"

  /**
   * Cell considered passing if cell outputs match outputs from previous run. Includes stdout, stderr, and cell result.
   */
  EXACT = "exact"

  /**
   * Cell considered passing if regex match found in cell result, stdout, or stderr.
   */
  REGEX = "regex"
}
