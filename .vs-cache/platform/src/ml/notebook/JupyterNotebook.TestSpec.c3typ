/**
 * Represents a json file under test folder that describes a Jupyter notebook test.
 */
private type JupyterNotebook.TestSpec mixes JupyterLab.Session.CellExecutionSpec {

  /**
   * Path of {@link JupyterNotebook}.
   */
  path: !string

  /**
   * Whether the test should always be skipped.
   * The test is also be skipped if a function provided in {@link skippedCondition} evaluates to true.
   */
  skipped: boolean = false

  /**
   * A function that will cause the test to be skipped if it evaluates to true.
   * The test is also skipped if {@link skipped} is set to true.
   */
  skippedCondition: lambda(): boolean

  /**
   * Reason why the test is being skipped.
   */
  skippedReason: string = "Skipping test as it is marked for skipping"

  /**
   * Location of the test file that corresponds to this {@link JupyterNotebook.TestSpec}.
   */
  testLocation: property(): !string py

  /**
   * Save spec to test folder.
   * @returns path to the file under test folder.
   */
  save: member function(): !string py

  /**
   * Removes this spec from test folder
   */
  remove: member function() py
}
