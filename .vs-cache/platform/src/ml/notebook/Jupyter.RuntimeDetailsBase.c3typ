type Jupyter.RuntimeDetailsBase {

  /**
   * The name of this runtime (ex. "py-dill").
   */
  name: !string

  /**
   * The language version of this runtime (ex. "3.9").
   */
  languageVersion: string

  description: string

  /**
   * The C3 package where this runtime is seeded.
   */
  sourcePackage: string

  /**
   * Returns the runtime size in KiB. Note since the libraries in a runtime share hard links with cache or other libraries,
   * this size is an upper bound on the actual size of the installed runtime.
   *
   * See {@link ImplLanguage.ResolvedRuntime#runtimeSize}
   */
  size: int
}
