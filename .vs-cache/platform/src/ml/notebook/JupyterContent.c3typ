/**
 * Base class for Jupyter Notebook, Folder, and File, as well as Jupyter Notebook Checkpoint.
 * For Jupyter documentation, see https://github.com/ipython/ipython/wiki/IPEP-27:-Contents-Service
 * and http://jupyter-notebook.readthedocs.io/en/latest/extending/contents.html.
 */
@db(index+=['path'], unique=['path'])
@seed(userUpdatable=true)
private extendable entity type JupyterContent mixes AclEnabled<JupyterContent>, SeedData<JupyterContent> schema name 'JPCT' {

  /**
   * Name of the 'content'
   */
  name: !string

  /**
   * (virtual) path to the content
   */
  path: !string

  /**
   * The type of file represented by this content model.
   */
  jupyterContentType: !string enum('notebook', 'directory', 'file')

  /**
   * Content format of the file
   */
  format: !string enum('json', 'text', 'base64')

  /**
   * File mimetype
   */
  mimetype: string

  /**
   * Indicates whether content can be written to
   */
  // TODO: revert to "writable: boolean = true" once "PLAT-69002" is addressed.
  writable: ?boolean = true

  /**
   * Size of the content(file) in bytes.
   * This field is populated by {@link #beforeUpdate} using {@link #calcContentSize} method.
   */
  contentSize: int

  /**
   * Calculate content size. Returns -1 for directories and the size of the content (external file) for files and
   * notebooks.
   */
  calcContentSize: private member function(): !int

  /**
   * Override {@link beforeCreate} method to update {@link #contentSize}.
   */
  beforeCreate: ~

  /**
   * Override {@link beforeUpdate} method to update {@link #contentSize}.
   */
  beforeUpdate: ~

  /**
   * Get the {@link #jupyterContentType} for {@link JupyterContent} at a given path.
   *
   * @param path
   *         Path to the content.
   * @return the content type for the content at the given path, null if not found.
   */
  contentTypeFromPath: private function(path: !string): string

  /**
   * The file containing the actual content/data for this file.
   */
  externalFile: File schema suffix 'F'

  /**
   * Make sure that the external file is deleted for JupyterFiles.
   */
  @dependency(include='externalFile')
  beforeRemove: ~

  /**
   * Chunk number for chunked upload
   * Numbers start from 1 and the last chunk will have `chunk` set to -1.
   */
  chunk: int

  /**
   * True if chunked file upload is fully completed (all chunks uploaded and saved) or if this is not chunked upload
   */
  uploadCompleted: boolean = false

  /**
   * Hash of the content of the externalFile. This is computed inside Jupyter and updated before every upsert from Jupyter.
   */
  contentHash: string

  /**
   * Write contents as seed data.  Their external files are also written as metadata files.
   */
  publishSeedData: function(objs: ![mixing JupyterContent],
                            spec: JupyterContent.PublishSeedDataSpec): ![mixing JupyterContent]
}
