/**
 * Type used to store Jupyter notebooks
 */
private entity type JupyterNotebook extends JupyterContent type key 'NTBK' {

  format:             ~ = 'json'
  jupyterContentType: ~ = 'notebook'

  /**
   * The name of the resource profile associated with this notebook.
   */
  resourceProfile: ResourceProfile

  /**
   * @param failIfMissing
   *        If true and the content language is not found, an error will be thrown.
   *        If false and the content language is not found, returns nothing.
   * @return the language of the notebook content
   */
  contentLanguage: member function(failIfMissing: boolean): string js-server

  /**
   * Timestamp for which the notebook has been most recently saved, NOT checkpointed. Jupyter
   * has a concept of both save and checkpoint, which normally is saved to different locations.
   */
  lastJupyterSave: datetime

  /**
   * @return the notebook json as string saved in externalFile.url
   */
  readContent: member function(): string py

  /**
   * Field to pass content in and out to type system calls. WARNING: this field should be never be used for heavy payload
   * as it can cause JVM to crash.
   */
  content: private json

  /**
   * List of dependencies of the notebook. A notebook can depend on notebooks, files and directories.
   * The paths of the dependencies should be subdirectories with respect to the notebook's path.
   * Notebooks can depend on other notebooks, but the transitive dependency is not evaluated.
   */
  notebookDependencies: [JupyterContent]

  /**
   * Kernel name based on notebook metadata.
   */
  kernelName: cached property(): !string

  /**
   * Read cells from the notebook file.
   */
  cells: property(): [!JupyterNotebook.Cell] py

  /**
   * Runs this {@link JupyterNotebook} using specified {@link JupyterLab.Session.CellExecutionSpec spec}.
   *
   * This method will try to start JupyterLab service (if not yet running) and will {@link JupyterLab.Session#run run} notebook cells there.
   * If necessary {@link #kernelName kernel} will be installed.
   */
  run: member function(spec: JupyterLab.Session.CellExecutionSpec): [!JupyterNotebook.Cell] py-notebook_runner-py4j

  /**
   * Return test spec for this notebook.
   */
  testSpec: private property(): !JupyterNotebook.TestSpec py

  /**
   * Entities associated with this notebook.
   */
  associations: [JupyterNotebook.Association](notebook)

  /**
   * Clean up relevant entities before removing this notebook.
   */
  @dependency(include='associations')
  beforeRemove: ~
}
