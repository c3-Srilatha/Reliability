/*
 * JupyterLab.ImportedComponentConfig.From is used to define the form that will be used to associate the entity type with the Jupyter notebook
 */
type JupyterNotebook.ImportedComponentConfig mixes Metadata, Named {

  /**
   * The route to the component to be imported
   */
  route: !string

  /**
   * The parameters to be used for the route
   * @key: parameter name
   * @value: type associated with the parameter
   */
  parameters: !map<string, string>

  /**
   * The form to be used to associate the entity type with the Jupyter notebook
   */
  form: !JupyterNotebook.ImportedComponentConfig.Form
}
