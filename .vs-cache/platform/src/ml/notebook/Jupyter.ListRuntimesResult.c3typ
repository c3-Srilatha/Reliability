/**
 * A result type for {@link Jupyter.RuntimeInfo.listRuntimes}.
 */
type Jupyter.ListRuntimesResult {

  /**
   * The successfully returned runtimes.
   */
  runtimes: [Jupyter.RuntimeInfo]

  /**
   * Names and error messages for runtimes that couldn't be processed.
   */
  errors: [Jupyter.ListRuntimesError]
}
