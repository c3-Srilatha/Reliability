/**
 * Details for an error encountered when calling calling {@link JupyterContent#uploadFromLocalClient}
 * or {@link JupyterContent#downloadToLocalClient}
 */
type JupyterContentSyncError {

  /**
   * The path of the {@link JupyterContent} for which this error occurred
   */
  path: !string

  /**
   * The error message itself
   */
  message: !string
}
