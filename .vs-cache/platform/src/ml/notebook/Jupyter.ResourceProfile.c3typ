/**
 * Base type for specifying different resource profiles (memory, cpu(s), gpu(s), disk size) used by {@link JupyterHub}
 * to start/restart {@link JupyterLab}
 */
@config(doNotDefaultIfMissing=true)
type Jupyter.ResourceProfile mixes BaseHardwareResourceRequirements, Named {

  toString: ~

  /**
   * Returns list of all the resource profile names
   */
  resourceProfileNames: function(): ![string]
}
