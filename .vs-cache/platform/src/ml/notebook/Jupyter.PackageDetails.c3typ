/**
 * Package information for package and dependency fields in {@link Jupyter.RuntimeDetails}.
 */
type Jupyter.PackageDetails {

  /**
   * The name of the package manager (ex. "conda").
   */
  packageManager: !string

  /**
   * The name of the package (ex. "dill").
   */
  name: !string

  /**
   * The resolved version.
   */
  resolvedVersion: string

  /**
   * The declared version (ex. ">=1.3.0").
   */
  declaredVersion: string
}
