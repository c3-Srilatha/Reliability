/**
 * A type to manage JupyterContent. We want a unified interface/API exposed even though the types and storage mechanisms
 * differ for different JupyterContent types.
 * For Jupyter content documentation, see https://github.com/ipython/ipython/wiki/IPEP-27:-Contents-Service
 * and http://jupyter-notebook.readthedocs.io/en/latest/extending/contents.html.
 */
private type JupyterContentManager {

  /**
   * Gets a JSON representation of the JupyterContent at `path`.
   * @param path
   *         The logical path of the content within the Jupyter folder.
   * @param excludeContent
   *         If true, the `content` field of the JupyterDirectory will be empty.
   * @param timeoutMs
   *         If > 0 and there is a backing db that supports it, the timeout for operations/statements on
   *         the connection used will be set with this value.
   *
   * @return The JupyterContent at `path`
   */
  getContent: function(path: !string, excludeContent: boolean, timeoutMs: int = 0): JupyterContent

  /**
   * Saves a JupyterNotebook to C3.
   * @param jupyterNotebook
   *         The JupyterNotebook to be saved.
   * @param path
   *         The logical path of the content within the Jupyter folder.
   * @param localPath
   *         The localPath on client side where we store the notebook json before saving it
   * @param checkpoint
   *         If true, a checkpoint of the notebook is made. Otherwise, the notebook is saved to the latest checkpoint.
   *
   * @return The shell of the JupyterNotebook saved
   */
  saveNotebook: function(jupyterNotebook: !JupyterNotebook,
                         path: !string,
                         checkpoint: boolean = false): !JupyterNotebook py

  /**
   * Saves a JupyterDirectory to C3.
   * @param jupyterDirectory
   *         The JupyterDirectory to be saved.
   * @param path
   *         The logical path of the content within the Jupyter folder.
   * @param timeoutMs
   *         If > 0 and there is a backing db that supports it, the timeout for operations/statements on
   *         the connection used will be set with this value.
   *
   * @return The shell of the JupyterDirectory saved
   */
  saveDirectory: function(jupyterDirectory: !JupyterDirectory, path: !string, timeoutMs: int = 0): JupyterDirectory

  /**
   * Saves a JupyterFile to C3, with the actual file `content` stored in S3.
   * @param jupyterFile
   *         The JupyterFile to be saved.
   * @param path
   *         The logical path of the content within the Jupyter folder.
   * @param localPath
   *        The localPath on client side where we store the file before saving it
   * @return The shell of the JupyterFile saved
   */
  saveFile: function(jupyterFile: !JupyterFile, path: !string): JupyterFile py

  /**
   * Delete the JupyterContent at `path`. If the content is a `JupyterFile`, the S3 file is deleted as well.
   * @param path
   *         The logical path of the content within the Jupyter folder.
   * @param timeoutMs
   *         If > 0 and there is a backing db that supports it, the timeout for operations/statements on
   *         the connection used will be set with this value.
   */
  deleteContent: function(path: !string, timeoutMs: int = 0)

  /**
   * Change the `path` of the JupyterContent from `oldPath` to `newPath`. If `oldPath` corresponds to a
   * JupyterDirectory, all JupyterContent within that directory (and its subdirectories) will have their
   * paths updated as well.
   * @param oldPath
   *         The current path of the content within the Jupyter folder.
   * @param newPath
   *         The desired new path of the content within the Jupyter folder.
   * @param timeoutMs
   *         If > 0 and there is a backing db that supports it, the timeout for operations/statements on
   *         the connection used will be set with this value.
   *
   * @return An array containing all the files and notebooks inside the oldPath if oldPath is a directory otherwise
   * an empty array
   */
  renameContent: function(oldPath: !string, newPath: !string, timeoutMs: int = 0): [JupyterNotebook | JupyterFile]

  /**
   * Returns whether a JupyterNotebook or JupyterFile exists at `path`.
   * @param path
   *         The logical path of the content within the Jupyter folder.
   * @param timeoutMs
   *         If > 0 and there is a backing db that supports it, the timeout for operations/statements on
   *         the connection used will be set with this value.
   *
   * @return Whether a JupyterNotebook or JupyterFile exists at `path`.
   */
  fileExists: function(path: !string, timeoutMs: int = 0): !boolean

  /**
   * Returns whether a JupyterNotebook exists at `path`.
   * @param path
   *         The logical path of the notebook within the Jupyter folder.
   * @param timeoutMs
   *         If > 0 and there is a backing db that supports it, the timeout for operations/statements on
   *         the connection used will be set with this value.
   *
   * @return Whether a JupyterNotebook exists at `path`.
   */
  notebookExists: function(path: !string, timeoutMs: int = 0): !boolean

  /**
   * Returns whether a JupyterDirectory exists at `path`.
   * @param path
   *         The logical path of the content within the Jupyter folder.
   * @param timeoutMs
   *         If > 0 and there is a backing db that supports it, the timeout for operations/statements on
   *         the connection used will be set with this value.
   *
   * @return Whether a JupyterDirectory exists at `path`.
   */
  dirExists: function(path: !?string, timeoutMs: int = 0): !boolean

  /**
   * Returns whether any JupyterContent exists at `path`.
   * @param path
   *         The logical path of the content within the Jupyter folder.
   * @param timeoutMs
   *         If > 0 and there is a backing db that supports it, the timeout for operations/statements on
   *         the connection used will be set with this value.
   *
   * @return Whether any JupyterContent exists at `path`.
   */
  contentExists: function(path: !?string, timeoutMs: int = 0): !boolean

  /**
   * Returns whether a JupyterFile at `path` is hidden.
   * For now, always False.
   * @param path
   *         The logical path of the content within the Jupyter folder.
   *
   * @return false
   */
  isHidden: function(path: !string): !boolean

  /**
   * This method allows for files to be upserted as {@link JupyterContent} objects
   * @param src
   *         The logical path of the content which shall be upserted. This path can specify a single file, or a
   *         directory. If this argument is a directory, all contents of the directory will be (recursively) upserted.
   *
   * @param dest
   *         The path relative to Jupyter's "root" tree, specifying the `path` of the {@link JupyterContent} objects
   *         being upserted. This argument may be a directory, or a file name (if `src` specifies a file).
   *
   * @param srcIsLocal
   *         Boolean variable indicating whether "src" denotes a local (true) or remote (false) file system.
   *
   * @return int, number of files successfully copied
   */
  upsertJupyterContentFiles: inline function(src: !string, dest: !string, srcIsLocal: boolean = false): !int py
}
