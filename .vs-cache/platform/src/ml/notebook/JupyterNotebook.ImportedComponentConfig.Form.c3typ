/*
 * JupyterLab.ImportedComponentConfig is used to configure entity types to be used in Jupyter notebooks
 */
private type JupyterNotebook.ImportedComponentConfig.Form {

  /**
   * The title of the form
   */
  formTitle: !string

  /**
   * The submit button text of the form
   */
  submitButtonText: !string

  /**
   * The fields of the type to be used in the form to be used to associate the entity type with the Jupyter notebook
   */
  fields: ![json]
}
