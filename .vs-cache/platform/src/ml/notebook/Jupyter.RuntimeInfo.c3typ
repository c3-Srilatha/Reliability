/**
 * A JupyterKernel represents an {@link ImplLanguage.Runtime} which can be installed as a kernel inside a
 * {@link JupyterLab} container.
 */
type Jupyter.RuntimeInfo {

  /**
   * Name of the runtime info
   */
  name: !string

  /**
   * Language along with the version for the kernel.
   */
  languageVersion: !string

  /**
   * Description for the runtime. See {@link ImplLanguage.Runtime#description}
   */
  description: string

  /**
   * List of resolved versions of {@link ImplLanguage.Runtime#library}s derived from
   * {@link ImplLanguage.ResolvedRuntime#libraries} for a given {@link ImplLanguage.ResolvedRuntime}
   */
  packages: ![ImplLanguage.Library]

  /**
   * List of {@link ImplLanguage.ResolvedRuntime#libraries}, excluding {@link ImplLanguage.Runtime#libraries}
   */
  dependencies: ![ImplLanguage.Library]

  /**
   * See {@link ImplLanguage.ResolvedRuntime#lastResolvedTime}
   */
  lastResolvedTime: datetime

  /**
   * This method is used to list and extract fields from {@link ImplLanguage.Runtime}s (for {@link ImplLanguage.Executor.IPYTHON} executor) and
   * return a list of {@link Jupyter.RuntimeInfo}s
   *
   * @param runtimeNames the names of the runtimes; if not set, return information for all python non-test runtimes
   */
  listRuntimes: function(runtimeNames: [string]): Jupyter.ListRuntimesResult

  /**
   * Returns the basic details (name, language version, and description) of the runtimes that can be
   * used with Jupyter. (These are python client non-test runtimes.)
   */
  clientRuntimeBasicDetails: function(): [Jupyter.RuntimeDetailsBase]

  /**
   * Returns information on py client runtimes. This is used by Jupyter UI to populate the kernel selection modal
   * and the kernel management widget.
   */
  listRuntimeDetails: function(kernelNames: [string]): Jupyter.ListRuntimeDetailsResult
}
