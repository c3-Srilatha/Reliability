/**
 * Represent instructions on how to run tests for this cell. Usually stored in cell metadata under 'testSpec' key.
 */
type JupyterNotebook.Cell.TestSpec mixes Spec {

  /**
   * What checks to perform for cell.
   */
  checkType: !string enum JupyterNotebook.Cell.TestSpec.CheckType = NOERRORS

  /**
   * Check parameter. As example regex for the regex {@link JupyterNotebook.Cell.TestSpec#checkType check}.
   */
  parameter: string
}
