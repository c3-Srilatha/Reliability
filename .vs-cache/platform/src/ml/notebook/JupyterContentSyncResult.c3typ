/**
 * The result of calling {@link JupyterContent#uploadFromLocalClient} or {@link JupyterContent#downloadToLocalClient}
 */
type JupyterContentSyncResult {

  /**
   * The number of files that were successfully uploaded or downloaded
   */
  successCount: !int

  /**
   * Any errors encountered when uploading or downloading
   */
  errors: [JupyterContentSyncError]
}
