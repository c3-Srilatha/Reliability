/**
 * Input interface for creating/updating status for an entry in ModelApproval.
 */
@beta
type ModelApproval.Update.Status {

  /**
   * {@link ModelRegistry.Entry#uri}, Identifier of an entry in ModelRegistry that corresponds to this status.
   */
  modelUri: !string

  /**
   * {@link ModelRegistry.Entry#ver}, Version of an entry in ModelRegistry that corresponds to this status.
   */
  modelVersion: !int

  /**
   * scope/context for which this approval is for.
   */
  scope: !string

  /**
   * approval status for the ModelRegistry entry.
   */
  status: !string
}
