/**
 * Client Interface for Approval of Model Registry Entries
 */
@beta
type ModelApproval mixes ModelApprovalIface, Microservice.Proxy {

  /**
   * Client interface for updating approval status with supporting artifacts.
   * This invokes {@link #update} after converting files into {@link ByteStream}.
   * @param status
   *    {@link ModelApproval.Update.Status}, inputs required for updating approval status.
   * @param files
   *    Artifact files required for approval.
   *    key - category of artifact, value - list of urls for {@link File}s corresponding to artifacts.
   *
   * @return an instance of {@link ModelApproval.Status} representing the updated approval status.
   */
  updateWithFiles: function(status: !ModelApproval.Update.Status,
                            files: !map<string, [string serialized Url]>): !ModelApproval.Status

  /**
   * Load the supporting artifacts of a {@link ModelApproval.Status}.
   * This invokes {@link #artifacts} and writes the incoming {@link ByteStream}s to respective files.
   * @param status
   *    {@link ModelApproval.Status} to read artifacts for.
   *
   * @return a map. key - category of artifact, value - list of urls for artifact files.
   */
  loadFiles: function(status: !ModelApproval.Status): map<string, [string serialized Url]>
}
