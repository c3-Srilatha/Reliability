/**
 * This type represents a search space for a set of hyperparameters. Each hyperparameter within this space has its own
 * {@link Hp.ParamSpace} that defines all possible values for that hyperparameter. When put together, an
 * {@link Hp.SearchSpace} represents the space of all valid combinations of the specified hyperparameters.
 */
type Hp.SearchSpace {

  /**
   * A map of hyperparameters to their parameter spaces.
   */
  searchSpace: private map<string, Hp.ParamSpace>

  /**
   * A list of hyperparameter names in this search space
   */
  hyperparams: property(): [string] py

  /**
   * Add or modify a {@link Hp.ParamSpace} for a hyperparameter.
   * @param hp
   *           The name of the hyperparameter.
   * @param paramSpace
   *           A parameter space that defines the space of valid values for `hp`.
   * @return A new {@link Hp.SearchSpace} with a new or modified parameter space
   */
  withParamSpace: member function(hp: !string, paramSpace: !Hp.ParamSpace): Hp.SearchSpace py

  /**
   * Add or modify {@link Hp.ParamSpace}s for a set of hyperparameters.
   * @param hpSpaces
   *           A map of hyperparameter names to their new parameter spaces that define the space of valid values for
   *           each respective hyperparameter.
   * @return A {@link Hp.SearchSpace} with a new or modified parameter space.
   */
  withParamSpaces: member function(paramSpaces: !map<string, Hp.ParamSpace>): Hp.SearchSpace py

  /**
   * Make an instance of {@link Hp.SearchSpace} with a map of hyperparameter names to their parameter spaces.
   */
  fromParamSpaces: function(paramSpaces: !map<string, Hp.ParamSpace>): Hp.SearchSpace py

  /**
   * Remove a {@link Hp.ParamSpace} for a hyperparameter.
   * @param hp
   *           The name of the hyperparameter.
   * @return A new {@link Hp.SearchSpace} with the parameter space removed.
   */
  removeParamSpace: member function(hp: !string): Hp.SearchSpace py

  /**
   * Get the {@link Hp.ParamSpace} for a hyperparameter.
   * @param hp
   *           The name of the hyperparameter.
   * @return The {@link Hp.ParamSpace} for the hyperparameter. This function will return null if there exists no
   * parameter space for the specified hyperparameter.
   */
  paramSpace: member function(hp: !(string | [string])): Hp.ParamSpace | map<string, Hp.ParamSpace> py
}
