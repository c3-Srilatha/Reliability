/**
 * Abstract Type, defining a space of valid values for a single hyperparameter. These parameter spaces are used in
 * {@link Hp.SearchSpace} to describe a space to perform hyperparameter search over.
 */
abstract type Hp.ParamSpace {

  /**
   * Validate that a parameter is a point in the parameter space
   * @param param
   *           The parameter to validate
   * @return true if the parameter is a valid point in this instance's parameter space
   */
  isValidParam: abstract member function(param: any): boolean

  /**
   * @return A random sample from the parameter space
   */
  sample: abstract member function(): any

  /**
   * @return An integer specifying how many candidate values are in this parameter space
   */
  numCandidates: cached abstract member function(): int py
}
