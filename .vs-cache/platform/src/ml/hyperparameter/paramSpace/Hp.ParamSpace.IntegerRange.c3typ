/**
 * This type defines a integer parameter space, where the valid values for a hyperparameter range from a start
 * value (inclusive), a stop value (inclusive) and an optional step size with a default value of +1.
 *
 * Usage Examples:
 * Setting fields as {start: 5, stop: 20, stepSize: 3} would give integer values in the set {5, 8, 11, 14, 17, 20}.
 * Setting fields as {start: 20, stop: 5, stepSize: -3} would give the integer values in the set {20, 17, 14, 11, 8, 5}.
 * Setting fields as {start: 5, stop: 20, stepSize: -3} would give no values (invalid range).
 *
 * An example of defining a {@link Hp.ParamSpace.IntegerRange}:
 * ```py
 * integer_space = c3.Hp.ParamSpace.IntegerRange.fromRange(start=5, stop=20, stepSize=3)
 * ```
 */
type Hp.ParamSpace.IntegerRange mixes Hp.ParamSpace {

  /**
   * Minimum (or maximum) value in the integer range equals this value.
   */
  start: !int

  /**
   * Maximum (or minimum) value in the integer range is equal to or less than (or greater than) this value.
   */
  stop: !int

  /**
   * Constant step size between contiguous values.
   */
  stepSize: int = 1

  /**
   * Make an instance of a integer parameter space from given range of [start, stop] with a step size.
   */
  fromRange: function(start: !int, stop: !int, stepSize: int): !Hp.ParamSpace.IntegerRange py

  isValidParam: ~ py

  /**
   * NOTE: This method currently returns a NotImplementedError.
   *
   * @inheritdoc
   */
  // TODO: PLAT-72211 Implement this method, not throw an error
  @beta
  sample: ~ py

  numCandidates: ~ py
}
