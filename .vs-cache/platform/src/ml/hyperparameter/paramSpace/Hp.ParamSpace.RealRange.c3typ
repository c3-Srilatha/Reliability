/**
 * This type defines a real parameter space, where the valid values for a hyperparameter range from a start
 * value (inclusive), a stop value (inclusive) and an optional step size with a default value of +1.
 *
 * Usage Examples:
 * Setting fields as {start: 1.1, stop: 11.1, stepSize: 2.5} would give real values in the set {1.1, 3.6, 6.1, 8.6, 11.1}.
 * Setting fields as {start: 11.1, stop: 1.1, stepSize: -2.5} would give real values in the set {11.1, 8.6, 6.1, 3.6, 1.1}.
 * Setting fields as {start: 1.1, stop: 11.1, stepSize: -2.5} would give no values (invalid range).
 *
 * An example of defining a {@link Hp.ParamSpace.RealRange}:
 * ```py
 * real_space = c3.Hp.ParamSpace.RealRange.fromRange(start=5.0, stop=20.0, stepSize=3)
 * ```
 */
type Hp.ParamSpace.RealRange mixes Hp.ParamSpace {

  /**
   * Minimum (or maximum) value in the range equals this value.
   */
  start: !double

  /**
   * Maximum (or minimum) value in the range is equal to or less than (or greater than) this value.
   */
  stop: !double

  /**
   * Constant step size between contiguous values.
   */
  stepSize: double = 1

  /**
   * Make an instance of a real parameter space from given range of [start, stop] with a step size.
   */
  fromRange: function(start: !double, stop: !double, stepSize: double): !Hp.ParamSpace.RealRange py

  isValidParam: ~ py

  /**
   * NOTE: This method currently returns a NotImplementedError.
   *
   * @inheritdoc
   */
  // TODO: PLAT-72211 Implement this method, not throw an error
  @beta
  sample: ~ py

  numCandidates: ~ py
}
