/**
 * Name of validation errors resulting from {@link ModelRegistryIface#validate}
 */
@beta
private enum type ModelRegistry.Validate.Kind {

  MISSING_MLMODEL = "Missing_MlModel"

  MISSING_ROUTER = "Missing_Router"

  ILLEGAL_ROUTER = "Illegal_Router"

  MISSING_TARGET_TYPE = "Missing_Target_Type"

  MISSING_SUBJECT_TYPE = "Missing_Subject_Type"

  ILLEGAL_SUBJECT_TYPE = "Illegal_Subject_Type"

  MISSING_FEATURE = "Missing_Feature"

  MISSING_RUNTIME = "Missing_Runtime"

  MISSING_SUBJECT_TO_MODEL_RELATION = "Missing_Subject_To_Model_Relation"

  MLPIPE_ID_EXISTS = "MlPipe_Id_Exists"

  MLMODEL_ID_EXISTS = "MlModel_Id_Exists"

  INVALID_PIPE = "Invalid_Pipe"

  INVALID_MODEL = "Invalid_Model"
}
