/**
 * Output of {@link ModelRegistryIface#loadMeta}.
 */
@beta
private type ModelRegistry.LoadMeta.Result {

  /**
   * Name of {@link ModelRegistry.Register.ArtifactsMeta#mlProject}.
   */
  mlProject: string

  /**
   * Name of {@link MlModel.Router} Type in {@link ModelRegistry.Register.ArtifactsMeta#mlProject}.
   */
  routerType: string

  /**
   * Name of {@link targetTypes} in {@link ModelRegistry.Register.ArtifactsMeta#mlProject}.
   */
  targetTypes: [string]

  /**
   * Name of {@link MlSubject} Type in {@link ModelRegistry.Register.ArtifactsMeta#mlProject}.
   */
  subjectType: string

  /**
   * Name of all runtimes in {@link ModelRegistry.Register.ArtifactsMeta#runtimes}.
   */
  runtimes: [string]

  /**
   * Name of all {@link Feature}s corresponding to {@link ModelRegistry.Register.ArtifactsMeta#xFeatures}
   * and {@link ModelRegistry.Register.ArtifactsMeta#yFeatures}
   */
  features: [string]
}
