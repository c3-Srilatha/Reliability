/**
 * Client Interface for Model Registry.
 * Registering and loading {@link MlPipe} and {@link MlModel} may need additional methods to be implemented.
 * See {@link MlPipe#replaceEntityReferences}, {@link MlPipe#beforeCreate}.
 * See {@link MlModel#replaceEntityReferences}, {@link MlModel#beforeCreate}.
 * See {@link MlInterpreter#backgroundDataByName},
 * See {@link MlInterpreter#backgroundDataFromMap}.
 *
 * Users interact with Model Registry using either a URI or a PATH.
 * 1. PATH - Paths can contain multiple components which enables organizing models that are either similar in architecture
 * or domain into the same group. A path can be constructed in three ways - relative, absolute, and globally unique.
 * 2. URI - Uniquely identifies a model in Model Registry. URI is a concatenation of a globally unique path and version.
 *
 * The following describes the three ways to construct a path:
 * 1. Relative paths
 * Relative paths are the quickest way to organize the models - the requirements are that the path must
 * contain at least one component and that it must not start with a leading slash `/` or 'ModelRegistry-'.
 * The following are all valid relative paths:
 * - `My_Classifier`
 * - `classifiers/Random_Forest`
 *
 * 2. Absolute paths
 * Absolute paths must start with a leading slash `/` - the only requirement is that the path must contain at least
 * two components. The default way to convert a relative path to absolute path is to add {@link App} ID as a prefix.
 * Based on the relative path examples above, the following are all valid absolute paths:
 * - `/cluster-env-app/My_Classifier`
 * - `/acme-prod-crm/classifiers/Random_Forest`
 * In addition, the user can craft their own absolute namespacing for absolute paths:
 * - `/hello_world_project/My_Classifier`
 * - `/all_models/classifiers/Random_Forest`
 *
 * 3. Globally unique paths
 * Globally unique paths start with a `ModelRegistry-ModelRegistry.serviceAppId()`.
 * The default way to convert a relative/absolute path to a globally unique path is to add the prefix mentioned above.
 * Users can either craft their globally unique path or use a relative/absolute path which gets internally converted to globally unique path.
 * Based on the relative and absolute path examples above, the following are all valid globally unique paths:
 * - `ModelRegistry-cluster-df-ms/cluster-env-app/My_Classifier`
 * - `ModelRegistry-acme-prod-ms/all_models/classifiers/Random_Forest`
 *
 * Users can load/list models organized by any path or URI.
 * However, registering is disallowed using a globally unique path that is not in scope of this client.
 * See {@link ModelRegistryIface#registerMlPipe} or {@link ModelRegistryIface#registerMlModel} for more details.
 */
@beta
type ModelRegistry mixes ModelRegistryIface, Microservice.Proxy.File {

  /**
   * Register a {@link MlPipe} into Model Registry. This methods invokes {@link ModelRegistry#register}.
   * @param mlPipe
   *    An instance of {@link MlPipe} to be registered.
   * @param path
   *    Path for the {@link MlPipe} to be registered. If using a global path to register, the prefix must match
   *    `ModelRegistry-{@link ModelRegistry.serviceAppId}`. If the {@link ModelRegistry.serviceAppId} in the prefix
   *    does not match the {@link App.id} of {@link ModelRegistryService} that this {@link ModelRegistry} is configured to
   *    interface with, a validation error is thrown.
   * @param desc
   *    Optional description for the {@link MlPipe} to be registered.
   * @param spec
   *    Optional {@link ModelRegistry.RegisterLoadSpec} for tuning file upload to {@link ModelRegistryService}.
   *
   * @return an instance of {@link ModelRegistry.Entry}, representing metadata for the registered {@link MlPipe}.
   */
  registerMlPipe: function(mlPipe: !MlPipe,
                           path: !string,
                           desc: string,
                           spec: ModelRegistry.RegisterLoadSpec): !ModelRegistry.Entry

  /**
   * Register a {@link MlModel} into Model Registry. This methods invokes {@link ModelRegistry#register}. Registering
   * an {@link MlModel} will save its {@link MlPipeline}, {@link MlProject}, and {@link Feature.Set}s. Note that this
   * will not save the project's {@link MlModel.Route}s.
   * @param mlModel
   *    An instance of {@link MlModel} to be registered.
   * @param path
   *    Path for the {@link MlModel} to be registered. If using a global path to register, the prefix must match
   *    `ModelRegistry-{@link ModelRegistry.serviceAppId}`. If the {@link ModelRegistry.serviceAppId} in the prefix
   *    does not match {@link App.id} of {@link ModelRegistryService} that this {@link ModelRegistry} client is configured to
   *    interface with, a validation error is thrown.
   * @param desc
   *    Optional description for the {@link MlModel} to be registered.
   * @param spec
   *    Optional {@link ModelRegistry.RegisterLoadSpec} for tuning file upload to {@link ModelRegistryService}.
   *
   * @return an instance of {@link ModelRegistry.Entry}, representing metadata for the registered {@link MlModel}.
   */
  registerMlModel: function(mlModel: !MlModel,
                            path: !string,
                            desc: string,
                            spec: ModelRegistry.RegisterLoadSpec): !ModelRegistry.Entry

  /**
   * Read an {@link MlPipe} from Model Registry. The loaded {@link MlPipe} is upserted into DB by default.
   * There are two options to read:
   * 1. Read using {@link ModelRegistry.Entry#uri}, which uniquely identifies a version. Version need not be provided
   * explicitly as parameter.
   * 2. Read using path. If a version is not provided, return the {@link MlPipe}
   * with the highest {@link ModelRegistry.Entry#version}.
   * This methods invokes {@link ModelRegistryIface#load}.
   * @param pathOrUri
   *    {@link ModelRegistry.Entry#uri} or path to read from.
   * @param version
   *    {@link ModelRegistry.Entry#ver} to read from.
   * @param id
   *    Optional id to persist {@link MlPipe}. If an instance of {@link MlPipe} exists with this `id`,
   * an error is thrown. If no `id` is provided, DB generated `id` is used.
   * @param spec
   *    Optional {@link ModelRegistry.RegisterLoadSpec} for tuning file download from {@link ModelRegistryService}.
   *
   * @return an instance of {@link MlPipe} corresponding to the uri or path/version.
   */
  loadMlPipe: function(pathOrUri: !string, version: int, id: string, spec: ModelRegistry.RegisterLoadSpec): !MlPipe

  /**
   * Read an {@link MlModel} from Model Registry. The loaded {@link MlModel} is upserted into DB by default.
   * There are two options to read:
   * 1. Read using {@link ModelRegistry.Entry#uri}, which uniquely identifies a version. Version need not be provided
   * explicitly as parameter.
   * 2. Read using path. If a version is not provided, return the {@link MlModel}
   * with the highest {@link ModelRegistry.Entry#version}.
   * @param pathOrUri
   *    {@link ModelRegistry.Entry#uri} or path to read from.
   * @param version
   *    {@link ModelRegistry.Entry#ver} to read from.
   * @param id
   *    Optional id to persist {@link MlModel}. If an instance of {@link MlModel} exists with this `id`,
   * an error is thrown. If no `id` is provided, DB generated id is used.
   * @param spec
   *    Optional {@link ModelRegistry.RegisterLoadSpec} for tuning file download from {@link ModelRegistryService}.
   *
   * @return an instance of {@link MlModel} corresponding to the uri or path/version.
   */
  loadMlModel: function(pathOrUri: !string, version: int, id: string, spec: ModelRegistry.RegisterLoadSpec): !MlModel

  /**
   * Reads {@link ModelRegistry.Register.ArtifactsMeta} from Model Registry, and creates an instance of
   * {@link ModelRegistry.LoadMeta.Result}.
   * There are two options to read:
   * 1. Read using {@link ModelRegistry.Entry#uri}, which uniquely identifies a version. Version need not be provided
   * explicitly as parameter.
   * 2. Read using path. If a version is not provided, return the {@link ModelRegistry.LoadMeta.Result}
   * with the highest {@link ModelRegistry.Entry#version}
   *
   * @param pathOrUri
   *    {@link ModelRegistry.Entry#uri} or path to read from.
   * @param version
   *    {@link ModelRegistry.Entry#ver} to read from.
   *
   * @return an instance of {@link ModelRegistry.LoadMeta.Result} corresponding to the uri or path/version.
   */
  loadMeta: function(pathOrUri: !string, version: int): !ModelRegistry.LoadMeta.Result

  /**
   * Reads {@link ModelRegistry.Register.ArtifactsMeta} from Model Registry,
   * and validates if all the metadata for successful execution of
   * {@link ModelRegistry#loadMlModel} exists in the current C3 application.
   * There are two options to read:
   * 1. Read using {@link ModelRegistry.Entry#uri}, which uniquely identifies a version. Version need not be provided
   * explicitly as parameter.
   * 2. Read using path. If a version is not provided, return the {@link ModelRegistry.Register.ArtifactsMeta}
   * with the highest {@link ModelRegistry.Entry#version}.
   *
   * @param pathOrUri
   *     {@link ModelRegistry.Entry#uri} or path to validate the metadata for.
   * @param version
   *    {@link ModelRegistry.Entry#ver} to validate the metadata for.
   * @param id
   *    Optional id to persist {@link MlModel}. If an instance of {@link MlModel} exists with this `id`,
   *    a validation error is recorded.
   *
   * @returns a list of {@link ModelRegistry.Validate.Error}s.
   */
  validateMlModel: function(pathOrUri: !string, version: int, id: string): ![ModelRegistry.Validate.Error]

  /**
   * Reads {@link ModelRegistry.Register.ArtifactsMeta} from Model Registry,
   * and validates if all the metadata for successful execution of {@link ModelRegistry#loadMlPipe}
   * exists in the current C3 application.
   * There are two options to read:
   * 1. Read using {@link ModelRegistry.Entry#uri}, which uniquely identifies a version. Version need not be provided
   * explicitly as parameter.
   * 2. Read using path. If a version is not provided, return the {@link ModelRegistry.Register.ArtifactsMeta}
   * with the highest {@link ModelRegistry.Entry#version}
   *
   * @param pathOrUri
   *    {@link ModelRegistry.Entry#uri} to validate the metadata for.
   * @param version
   *    {@link ModelRegistry.Entry#ver} to validate the metadata for.
   * @param id
   *    Optional id to persist {@link MlPipe}. If an instance of {@link MlPipe} exists with this `id`,
   *    a validation error is recorded.
   *
   * @returns a list of {@link ModelRegistry.Validate.Error}s.
   */
  validateMlPipe: function(pathOrUri: !string, version: int, id: string): ![ModelRegistry.Validate.Error]

  /**
   * Returns string representing declared runtime from {@link ModelRegistry.Register.ArtifactsMeta}
   * corresponding to runtimeName.
   * @param runtimeName
   *    Name of runtime to return the declared runtime for.
   * @param pathOrUri
   *    {@link ModelRegistry.Entry#uri} or path to read from.
   * @param version
   *    If path is specified, {@link ModelRegistry.Entry#ver} to read from.
   *    If no version is specified, then the {@link ModelRegistry.Register.ArtifactsMeta}
   *    for latest version is used.
   *
   * @return string representing declared runtime corresponding to runtimeName
   */
  runtimeDeclaration: function(runtimeName: !string, pathOrUri: !string, version: int): !string

  /**
   * Returns string representing {@link MlPipe} from {@link ModelRegistry.Register.ArtifactsMeta}.
   * @param pathOrUri
   *    {@link ModelRegistry.Entry#uri} or path to read from.
   * @param version
   *    If path is specified, {@link ModelRegistry.Entry#ver} to read from.
   *    If no version is specified, then the {@link ModelRegistry.Register.ArtifactsMeta}
   *    for latest version is used.
   *
   * @return string representing {@link MlPipe} corresponding to uri or path/version.
   */
  pipeJson: function(pathOrUri: !string, version: int): !string

  /**
   * Returns string representing {@link MlModel} from {@link ModelRegistry.Register.ArtifactsMeta}.
   * @param pathOrUri
   *    {@link ModelRegistry.Entry#uri} or path to read from.
   * @param version
   *    path is specified, {@link ModelRegistry.Entry#ver} to read from.
   *    If no version is specified, then the {@link ModelRegistry.Register.ArtifactsMeta}
   *    for latest version is used.
   *
   * @return string representing {@link MlPipe} corresponding to uri or path/version.
   */
  modelJson: function(pathOrUri: !string, version: int): !string

  /**
   * Creates a {@link ModelRegistry.Entry.Card} for the given uri.
   * If {@link ModelRegistry.Entry.Card} exists for the given uri, this API will update the existing card.
   * Update operation merges the newly provided card with the existing card.
   *
   * @param uri
   *           Same as {@link ModelRegistry.Entry#uri}.
   * @param card
   *           {@link ModelRegistry.Card} to be created or updated.
   * @param spec
   *           Optional {@link ModelRegistry.Entry.CardWriteSpec} for tuning file/plot upload to {@link ModelRegistryService}.
   *
   * @return {@link ModelRegistry.Entry.CardMetadata} as an acknowledgement, i.e return a
   * summary of the card which includes names (no values) of all metrics, parameters, plots etc,. associated with a card.
   */
  updateCard: function(uri: !string,
                       card: !ModelRegistry.Card,
                       spec: ModelRegistry.Entry.CardWriteSpec): !ModelRegistry.Entry.CardMetadata

  /**
   * Reads {@link ModelRegistry.Entry.Card} associated with the given URI.
   * By default, only content, parameters and metrics are read from card.
   * If plots and files are needed, they can be read by providing a {@link ModelRegistry.Entry.CardReadSpec}.
   * If a spec is provided, only fields requested in the spec will be read.
   *
   * @param uri
   *           {@link ModelRegistry.Entry#uri} for which model card needs to be read.
   * @param spec
   *           Optional {@link ModelRegistry.Entry.CardReadSpec} for customization of what to read from card and how to read from card.
   * @return {@link ModelRegistry.Entry.Card} corresponding to the uri.
   */
  card: function(uri: !string, spec: ModelRegistry.Entry.CardReadSpec): !ModelRegistry.Entry.Card

  /**
   * Removes all data associated with a {@link ModelRegistry.Entry.Card} for the given URI.
   * If only specific fields need to be removed, use {@link ModelRegistry.Entry.CardRemoveSpec}.
   *
   * @param uri
   *           {@link ModelRegistry.Entry#uri} for which model card fields need to be removed.
   * @param spec
   *           {@link ModelRegistry.Entry.CardRemoveSpec} for customizing the remove operation.
   * @return {@link ModelRegistry.Entry.CardMetadata} as an acknowledgement.
   */
  removeCard: function(uri: !string, spec: ModelRegistry.Entry.CardRemoveSpec): !ModelRegistry.Entry.CardMetadata

  _exec: ~
}
