/**
 * Type holding data files associated with {@link ModelRegistryIface#register}.
 */
@beta
private type ModelRegistry.Register.Data {

  /**
   * Value is user defined key specified in methods such as {@link MlInterpreter.backgroundDataRegister}
   */
  dataName: string

  /**
   * {@link Data} represented as json string
   */
  data: string

  /**
   * File url path for saving {@link #data} json string.
   */
  dataPath: string

  /**
   * key is `fileName` backing data and value is relative {@link Url} of file.
   */
  fileUrls: map<string, string>

  /**
   * key is `fileName` backing data and value is backing {@link ByteStream} of file.
   */
  // TODO: PLAT-94033 Simplify Model Registry Service by removing support for 8.4 proxy
  // Developer Note: Remove this field when support for 8.4 proxy is removed
  files: map<string, ByteStream>
}
