/**
 * Type holding artifacts associated with {@link ModelRegistryIface#load}
 */
@beta
private type ModelRegistry.Register.ArtifactsMeta {

  /**
   * uri for which artifacts are loaded, only used for read operations
   */
  uri: string

  /**
   * {@link MlPipe} represented as string
   */
  mlPipe: string

  /**
   * {@link MlModel} represented as string
   */
  mlModel: string

  /**
   * Map of the {@link #mlPipe} `x` inputs names to corresponding string representations of {@link Feature.Set}s.
   */
  xFeatures: map<string, string>

  /**
   * Map of the {@link #mlPipe} `y` inputs names to corresponding string representations of {@link Feature.Set}s.
   */
  yFeatures: map<string, string>

  /**
   * key is runtime name, value is runtime json string needed for execution of corresponding {@link MlPipe}.
   */
  // TODO: PLAT-47687 migrate the type of the value to string serialized Action.Requirement (or equivalent)
  runtimes: map<string, string>
}
