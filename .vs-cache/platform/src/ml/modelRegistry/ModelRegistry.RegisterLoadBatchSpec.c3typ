/**
 * Spec for tuning {@link BatchJob} for registration and loading of many model {@link File}s between
 * {@link ModelRegistryService} and {@link ModelRegistry}.
 * See {@link ModelRegistry.RegisterLoadSpec#enableBatchJob} for more details.
 */
type ModelRegistry.RegisterLoadBatchSpec mixes BatchJobOptions, Spec {

  maxConcurrency:          ~ = 4
  numAutoRecoveryAttempts: ~ = 2

  /**
   * Timeout for {@link BatchJob#waitForCompletion}.
   */
  batchJobTimeout: string serialized Duration = "3h"
}
