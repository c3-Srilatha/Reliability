/**
 * Spec for customization of {@link ModelRegistry#updateCard} and {@link ModelRegistry#card} operations.
 */
@beta
type ModelRegistry.Entry.CardSpec mixes Spec {

  /**
   * {@link FileOperationSpec} for tuning the upload/download of file artifacts associated with a model card
   * to/from {@link ModelRegistryService}.
   */
  fileOperationSpec: FileOperationSpec
}
