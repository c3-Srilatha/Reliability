/**
 * Batch job for uploading and downloading model files between Model Registry Service and Model Registry Proxy.
 */
private type ModelRegistry.RegisterLoadBatchJob extends BatchJob<ModelRegistry.RegisterLoadBatchJob, ModelRegistry.RegisterLoadSpec, ModelRegistry.RegisterLoadBatchJobBatch> type key 'MRBJ' {

  /**
   * Map of source and destination urls for file transfer between Model Registry Service and Model Registry Proxy.
   * Key is source url and value is destination url.
   */
  srcToDest: !map<string, string>

  /**
   * True if the batch job has to upload files from Model Registry Proxy to Model Registry Service.
   */
  isUpload: !boolean

  /**
   * Spec for configuring the file upload/download
   */
  spec: !ModelRegistry.RegisterLoadSpec
}
