/**
 * Interface for Model Registry
 */
@beta
abstract type ModelRegistryIface mixes Microservice.Iface, Singleton {

  /**
   * Register artifacts into Model Registry.
   * If a {@link ModelRegistry.Register.Metadata} with path exists,
   * {@link ModelRegistry.Entry#version} is incremented.
   * @param registrationMetadata
   *    {@link  ModelRegistry.Register.Metadata}, metadata required for registering artifacts.
   * @param artifacts
   *    {@link ModelRegistry.Register.Artifacts}, artifacts to register.
   *
   * @return an instance of {@link ModelRegistry.Entry} representing metadata for the registered record.
   */
  register: abstract function(registrationMetadata: !ModelRegistry.Register.Metadata,
                              artifacts: !ModelRegistry.Register.Artifacts): !ModelRegistry.Entry

  /**
   * List the {@link ModelRegistry.Model.Metadata}s for entries in Model Registry based on {@link Filter}.
   * @param FetchSpec
   *    {@link FetchSpec}, customizations for fetching from DB, including filter expression and pagination.
   *
   * @return {@link FetchResult} holding {@link ModelRegistry.Model.Metadata} objects.
   */
  list: abstract function(spec: FetchSpec): FetchResult<ModelRegistry.Model.Metadata>

  /**
   * List the {@link ModelRegistry.Entry}s in the Model Registry for the given entry path/URI.
   * @param pathOrUri
   *    The path or {@link ModelRegistry.Register.Metadata#uri} of the model to list versions for.
   *    All {@link ModelRegistry.Entry}s where {@link ModelRegistry.Entry#uri} contains this pathOrUri are returned.
   *    If you want to match one {@link ModelRegistry.Entry} from {@link ModelRegistry.Register.Metadata#uri},
   *    Use FetchSpec like the following example.
   *    ```python
   *    ModelRegistry.listVersions(null, {filter: Filter.eq('uri', uri)})
   *    ```
   * @param FetchSpec
   *    {@link FetchSpec}, customizations for fetching from DB. The filter expression is applied to {@link ModelRegistry.Entry} fields.
   *
   * @return {@link FetchResult} holding {@link ModelRegistry.Entry} objects.
   */
  listVersions: abstract function(pathOrUri: string, spec: FetchSpec): FetchResult<ModelRegistry.Entry>

  /**
   * Reads file artifacts from Model Registry. There are two options to read
   * 1. Read using {@link ModelRegistry.Entry#uri}, which uniquely identifies a versioned model.
   * 2. Read using path. If a version is not provided, return the
   * url of file artifacts of {@link ModelRegistry.Entry} with the highest {@link ModelRegistry.Entry#version}.
   *
   * @param pathOrUri
   *    {@link ModelRegistry.Entry#uri} or path to read from.
   * @param version
   *    {@link ModelRegistry.Entry#version} to read from.
   *
   * @return an instance of {@link Map}.
   * key is {@link MlPipeline#pipePaths}, value is the map.
   * key for value map is "fieldpath" of file fields in {@link MlPipe}, value is list of {@link ByteStream}s of artifacts.
   */
  @deprecated(finalVersion='8.5', details='Replaced by {@link ModelRegistryIface#loadFileUrls}')
  loadFiles: abstract function(// TODO: PLAT-94033 Simplify Model Registry Service by removing support for 8.4 proxy
                               // Developer Note: Remove this API when support for 8.4 proxy is removed
                               pathOrUri: !string,
                               version: int): !map<string, map<string, [ByteStream]>>

  /**
   * Reads url of file artifacts from Model Registry.There are two options to read
   * 1. Read using {@link ModelRegistry.Entry#uri}, which uniquely identifies a versioned model.
   * 2. Read using path. If a version is not provided, return the
   * url of file artifacts of {@link ModelRegistry.Entry} with the highest {@link ModelRegistry.Entry#version}.
   *
   * @param pathOrUri
   *    {@link ModelRegistry.Entry#uri} or path to read from.
   * @param version
   *    {@link ModelRegistry.Entry#version} to read from.
   *
   * @return an instance of {@link Map}.
   * key is {@link MlPipeline#pipePaths}, value is the map.
   * key for value map is "fieldpath" of file fields in {@link MlPipe}, value is list of {@link FileUrl}s of artifacts.
   */
  loadFileUrls: abstract function(pathOrUri: !string, version: int): !map<string, map<string, [string]>>

  /**
   * Reads files backing data artifacts.
   * 1. Read using {@link ModelRegistry.Entry#uri}, which uniquely identifies a versioned model.
   * 2. Read using path. If a version is not provided, return the
   * file of {@link ModelRegistry.Entry} with the highest {@link ModelRegistry.Entry#version}.
   * @param pathOrUri
   *    {@link ModelRegistry.Entry#uri} or path to read from.
   * @param version
   *    {@link ModelRegistry.Entry#version} to read from.
   *
   * @return an instance of {@link Map}.
   * key is vertex path in {@link MlPipeline}.
   * value is {@link ModelRegistry.Register.Data} representing files backing data in a path.
   */
  @deprecated(finalVersion='8.5', details='Replaced by {@link ModelRegistryIface#loadDataUrls}')
  loadData: abstract function(// TODO: PLAT-94033 Simplify Model Registry Service by removing support for 8.4 proxy
                              // Developer Note: Remove this API when support for 8.4 proxy is removed
                              pathOrUri: !string,
                              version: int): !map<string, [ModelRegistry.Register.Data]>

  /**
   * Reads url of backing data artifacts.
   * 1. Read using {@link ModelRegistry.Entry#uri}, which uniquely identifies a versioned model.
   * 2. Read using path. If a version is not provided, return the
   * file of {@link ModelRegistry.Entry} with the highest {@link ModelRegistry.Entry#version}.
   * @param pathOrUri
   *    {@link ModelRegistry.Entry#uri} or path to read from.
   * @param version
   *    {@link ModelRegistry.Entry#version} to read from.
   *
   * @return an instance of {@link Map}.
   * key is vertex path in {@link MlPipeline}.
   * value is {@link ModelRegistry.Register.Data} representing urls of backing data in a path.
   */
  loadDataUrls: abstract function(pathOrUri: !string, version: int): !map<string, [ModelRegistry.Register.Data]>

  /**
   * Read in-memory artifacts from Model Registry.
   * 1. Read using {@link ModelRegistry.Entry#uri}, which uniquely identifies a versioned model.
   * 2. Read using path. If a version is not provided, return the
   * file of {@link ModelRegistry.Entry} with the highest {@link ModelRegistry.Entry#version}.
   * @param pathOrUri
   *    {@link ModelRegistry.Entry#uri} or path to read from.
   * @param version
   *    {@link ModelRegistry.Entry#version} to read from.
   *
   * @return an instance of {@link ModelRegistry.Register.ArtifactsMeta} corresponding to the URI and version.
   */
  load: abstract function(pathOrUri: !string, version: int): !ModelRegistry.Register.ArtifactsMeta

  /**
   * Update metadata for the latest version of {@link ModelRegistry.Entry}.
   * @param registrationMetadata
   *    {@link ModelRegistry.Register.Metadata} to update.
   *
   * @return an instance of {@link ModelRegistry.Entry} with updated metadata.
   */
  @deprecated("No longer supported")
  updateVersion: abstract function(registrationMetadata: !ModelRegistry.Register.Metadata): !ModelRegistry.Entry

  /**
   * Update metadata of {@link ModelRegistry.Model.Metadata}.
   * @param path
   *    Path to update metadata for.
   *    If using a global path, the {@link ModelRegistry.serviceAppId} in prefix
   *    `ModelRegistry-{@link ModelRegistry.serviceAppId}` must match the {@link App.id} of {@link ModelRegistryService},
   *    that a {@link ModelRegistry} is configured to interact with.
   * @param updateSpec
   *    {@link ModelRegistry.Model.UpdateSpec} holding fields and values that need to be updated.
   *
   * @return an instance of {@link ModelRegistry.Model.Metadata} with updated metadata.
   */
  updateModel: abstract function(path: !string,
                                 updateSpec: !ModelRegistry.Model.UpdateSpec): !ModelRegistry.Model.Metadata

  /**
   * Remove tags from {@link ModelRegistry.Model.Metadata}.
   *
   * @param path
   *    Path to remove model tags from.
   *    If using a global path, the {@link ModelRegistry.serviceAppId} in prefix
   *    `ModelRegistry-{@link ModelRegistry.serviceAppId}` must match the {@link App.id} of {@link ModelRegistryService},
   *    that a {@link ModelRegistry} is configured to interact with.
   * @param tags
   *    List of tags to remove. All the tags that do not exist will be ignored.
   *    If no tags are provided, all tags are removed.
   *
   * @return an instance of {@link ModelRegistry.Model.Metadata} with updated metadata.
   */
  removeTags: abstract function(path: !string, tags: [string]): !ModelRegistry.Model.Metadata

  /**
   * Returns the number of versions for the given path or URI
   * @param pathOrUri
   *    path or URI for which number of versions is obtained. If URI, returned value is always 1,
   *    irrespective of the number of versions. This is because URI uniquely identifies a version.
   * @param FetchFilterSpec
   *    Optional {@link FetchFilterSpec} to use for this version count.
   *    The filter expression is applied to {@link ModelRegistry.Entry} fields
   *
   * @returns the number of versions for the given uri.
   */
  versionCount: abstract function(pathOrUri: string, spec: FetchFilterSpec): !int

  /**
   * Returns the number of models in the model registry.
   * The filter is applied to {@link ModelRegistry.Model.Metadata}.
   * @param FetchFilterSpec
   *    Optional {@link FetchFilterSpec} to use for this model count.
   *
   * @returns the number of models in the model registry.
   */
  modelCount: abstract function(spec: FetchFilterSpec): !int

  /**
   * Returns {@link ModelRegistry.Register.ArtifactsPath} holding path names for storing artifacts.
   * @param path
   *    {@link ModelRegistry.Register.Metadata#path} for registering a model.
   * @returns {@link ModelRegistry.Register.ArtifactsPath} for the input path.
   */
  basePathForArtifacts: abstract function(path: !string): !ModelRegistry.Register.ArtifactsPath

  /**
   * Returns {@link ModelRegistry.Entry.CardArtifactsPath} holding path names for storing artifacts associated
   * with a model card.
   * @param uri
   *           {@link ModelRegistry.Entry#uri} for creating/updating a model card.
   * @returns {@link ModelRegistry.Entry.CardArtifactsPath} for the input uri.
   */
  basePathForCardArtifacts: abstract function(uri: !string): !ModelRegistry.Entry.CardArtifactsPath

  /**
   * Creates/Updates a {@link ModelRegistry.Entry.Card}.
   * If {@link ModelRegistry.Entry.Card} exists, this API will update the existing card.
   *
   * @param card
   *           {@link ModelRegistry.Entry.Card} to be created or updated.
   * @return {@link ModelRegistry.Entry.CardMetadata} as an acknowledgement.
   */
  registerCard: abstract function(card: !ModelRegistry.Entry.Card): !ModelRegistry.Entry.CardMetadata

  /**
   * Removes all data associated with a {@link ModelRegistry.Entry.Card} for the given URI.
   * If only specific fields need to be removed, use {@link ModelRegistry.Entry.CardRemoveSpec}.
   *
   * @param cardMetaFields
   *           {@link ModelRegistry.Entry.CardMetadataFields} containing URI for which card data needs to be removed.
   * @param spec
   *           {@link ModelRegistry.Entry.CardRemoveSpec} for customizing the remove operation.
   * @return {@link ModelRegistry.Entry.CardMetadata} as an acknowledgement.
   */
  removeFromCard: abstract function(cardMetaFields: !ModelRegistry.Entry.CardMetadataFields,
                                    spec: ModelRegistry.Entry.CardRemoveSpec): !ModelRegistry.Entry.CardMetadata

  /**
   * Reads {@link ModelRegistry.Entry.Card} associated with the given URI.
   *
   * @param uri
   *           {@link ModelRegistry.Entry#uri} for which model card needs to be read.
   * @param selector
   *           {@link ModelRegistry.Entry.CardFieldKeys} for customizing the read results. If no selector is provided,
   * only metrics, parameters and content are returned.
   * @return {@link ModelRegistry.Entry.Card} corresponding to the uri.
   */
  loadCard: abstract function(uri: !string, selector: ModelRegistry.Entry.CardFieldKeys): !ModelRegistry.Entry.Card

  /**
   * Reads {@link ModelRegistry.Entry.CardMetadata} associated with the given URI.
   *
   * @param uri
   *           {@link ModelRegistry.Entry#uri} for which model card metadata needs to be read.
   * @return {@link ModelRegistry.Entry.CardMetadata} corresponding to the uri.
   */
  cardMeta: abstract function(uri: !string): !ModelRegistry.Entry.CardMetadata
}
