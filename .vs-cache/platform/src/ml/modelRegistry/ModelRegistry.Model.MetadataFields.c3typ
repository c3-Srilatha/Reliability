/**
 * Holds metadata fields for versioned models corresponding to {@link ModelRegistry.Model.MetadataFields#uri}.
 */
@beta
type ModelRegistry.Model.MetadataFields mixes ModelRegistry.Model.MetadataUpdatable {

  /**
   * Global unique path for grouping all versioned models.
   * This field represents the path of the model, not uri. It is not same as {@link ModelRegistry.Entry#uri}.
   * See {@link ModelRegistry} for definition of path.
   */
  uri: !string

  /**
   * Number of versioned models for this {@link ModelRegistry.Model.MetadataFields#uri}.
   */
  numVersions: !int

  /**
   * Datetime of latest version created for {@link ModelRegistry.Model.MetadataFields#uri}.
   */
  lastUpdatedAt: !datetime

  /**
   * Author of latest version for {@link ModelRegistry.Model.MetadataFields#uri}.
   */
  lastUpdatedBy: string
}
