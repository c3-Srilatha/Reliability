/**
 * Type holding paths for storing artifacts associated with {@link ModelRegistryIface#register}.
 */
@beta
private type ModelRegistry.Register.ArtifactsPath {

  /**
   * Parent path in {@link ModelRegistryService} where all artifacts are stored.
   */
  parent: string

  /**
   * Name of sub-path in {@link #parent} path where all file artifacts are stored.
   */
  fileArtifacts: string

  /**
   * Name of sub-path in {@link #parent} path where all data artifacts are stored.
   */
  dataArtifacts: string

  /**
   * Name of sub-path within {@link #dataArtifacts} path where all {@link ModelRegistry.Register.Data#files} are stored.
   */
  dataFiles: string

  /**
   * Name of sub-path with {@link #dataArtifacts} path for storing {@link ModelRegistry.Register.Data#data}.
   */
  dataJson: string
}
