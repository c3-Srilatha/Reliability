/**
 * Spec for customization of {@link ModelRegistry.Entry.Card} remove operation.
 * Use this spec to define which fields should be removed from the card.
 */
@beta
type ModelRegistry.Entry.CardRemoveSpec mixes ModelRegistry.Entry.CardFieldKeys {

  /**
   * Set this field, if content needs to be removed.
   */
  content: ~
}
