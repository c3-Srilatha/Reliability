/**
 * Information pertaining to validation error output from {@link ModelRegistryIface#validate}.
 */
@beta
type ModelRegistry.Validate.Error {

  /**
   * Enum representing category of validation error
   */
  kind: !ModelRegistry.Validate.Kind

  /**
   * Name of the component producing this error.
   * The component name is one of field values in {@link ModelRegistry.LoadMeta.Result}.
   */
  param: !string

  /**
   * Additional details of this error, if any.
   */
  info: string

  /**
   * Stack trace of the error, if any.
   */
  stackTrace: string
}
