/**
 * Holds fields of {@link ModelRegistry.Model.MetadataFields} that are updatable by users.
 */
@beta
type ModelRegistry.Model.MetadataUpdatable {

  /**
   * User provided description for all the versioned models for {@link ModelRegistry.Model.Metadata#uri}.
   */
  description: string

  /**
   * List of tags associated with all the versioned models for {@link ModelRegistry.Model.Metadata#uri}.
   */
  tags: ?[string]
}
