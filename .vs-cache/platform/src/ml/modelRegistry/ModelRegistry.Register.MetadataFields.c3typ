/**
 * Interface for metadata of {@link ModelRegistryIface#register} operation.
 */
@beta
type ModelRegistry.Register.MetadataFields {

  /**
   * DB `id` of registered models at the time of registration.
   * For example, This is {@link MlPipe#id} or {@link MlModel#id} used for registration.
   */
  sourceId: string

  /**
   * Name of c3 application package that invoked {@link ModelRegistryIface#register}
   */
  pkgName: !string

  /**
   * {@link Pkg#version} of {@link App} that invoked {@link ModelRegistryIface#register}
   */
  pkgVersion: !string

  /**
   * User provided description of this ModelRegistry.Register.Metadata
   */
  description: string

  /**
   * {@link App#appMode} of {@link App} that invoked {@link ModelRegistryIface#register}
   */
  appMode: string

  /**
   * Name of user who registered the entry
   */
  registeredBy: string
}
