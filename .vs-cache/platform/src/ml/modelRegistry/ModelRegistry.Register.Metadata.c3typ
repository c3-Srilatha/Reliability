/**
 * Interface for metadata of {@link ModelRegistryIface#register} operation.
 */
@beta
type ModelRegistry.Register.Metadata mixes ModelRegistry.Register.MetadataFields {

  /**
   * A globally unique path to register a model into model registry.
   * See {@link ModelRegistry} for definition of a globally unique path.
   */
  path: !string
}
