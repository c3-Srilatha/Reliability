/**
 * Type holding artifacts associated with {@link ModelRegistryIface#register}.
 */
@beta
private type ModelRegistry.Register.Artifacts mixes ModelRegistry.Register.ArtifactsMeta {

  /**
   * key is {@link MlPipeline#pipePaths}, value is the map.
   * key for value map is "fieldpath" of file fields in {@link MlPipe}, value is list of relative {@link ByteStream}s of files.
   */
  // TODO: PLAT-94033 Simplify Model Registry Service by removing support for 8.4 proxy
  // Developer Note: Remove this field when support for 8.4 proxy is removed
  files: map<string, map<string, [ByteStream]>>

  /**
   * key is {@link MlPipeline#pipePaths}, value is the map.
   * key for value map is "fieldpath" of file fields in {@link MlPipe}, value is list of {@link Url}s of files.
   */
  fileUrls: map<string, map<string, [string]>>

  /**
   * Holds paths for storing artifacts associated with {@link ModelRegistryIface#register}
   */
  artifactsPath: ModelRegistry.Register.ArtifactsPath

  /**
   * key is vertex path of {@link MlPipeline}.
   * value is list of {@link ModelRegistry.Register.Data} associated with a path.
   */
  data: map<string, [ModelRegistry.Register.Data]>
}
