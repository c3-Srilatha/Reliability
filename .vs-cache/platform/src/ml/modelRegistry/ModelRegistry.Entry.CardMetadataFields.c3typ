/**
 * Metadata fields of a {@link ModelRegistry.Entry.Card}.
 * These fields are inferred when user invoked {@link ModelRegistry#updateCard}.
 */
@beta
type ModelRegistry.Entry.CardMetadataFields {

  /**
   * {@link ModelRegistry.Entry#uri} of the entry that this card belongs to.
   */
  uri: !string

  /**
   * Last updated date of {@link ModelRegistry.Entry.Card}.
   */
  lastUpdatedAt: datetime

  /**
   * Author of the last update of {@link ModelRegistry.Entry.Card}.
   */
  lastUpdatedBy: string
}
