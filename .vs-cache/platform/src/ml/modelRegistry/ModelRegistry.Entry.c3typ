/**
 * Interface for metadata of a record in Model Registry
 */
@beta
type ModelRegistry.Entry mixes ModelRegistry.EntryFields {

  /**
   * Gets the approval status for this entry within a given {@link ModelApproval.Status#scope scope}.
   *
   * @see #listApprovalStatuses
   */
  approvalStatus: member function(scope: !string): !ModelApproval.Status

  /**
   * Gets the approval statuses for this entry within all relevant scopes.
   *
   * @see #approvalStatus
   */
  listApprovalStatuses: member function(spec: FetchSpec): !FetchResult<ModelApproval.Status>

  /**
   * Updates the approval status for this entry given {@link ModelApproval.Status#status status} and
   * {@link ModelApproval.Status#scope scope}. Optionally accepts approval-supporting artifacts.
   * Note that an entry may have different approval statuses associated with it within different scopes.
   *
   * @param status
   *     custom approval status string
   * @param scope
   *     scope/context that the approval is within
   * @param artifacts
   *     approval-related artifacts
   */
  updateApprovalStatus: member function(status: !string,
                                        scope: !string,
                                        artifacts: map<string, [string serialized Url]>): !ModelApproval.Status

  /**
   * Gets the approval artifacts for this entry given {@link ModelApproval.Status#scope scope} if any exist.
   */
  approvalArtifacts: member function(scope: !string): map<string, [string serialized Url]>

  /**
   * Creates an absolute path from a global URI
   * @param uri
   *           A {@link #uri}.
   * @return an absolute path
   */
  absolutePathFromUri: function(uri: !string): !string

  /**
   * Creates an global path from a global URI
   * @param uri
   *           A {@link #uri}.
   * @return a global path
   */
  globalPathFromUri: function(uri: !string): !string

  /**
   * Creates the version from a global URI
   * @param uri
   *           A {@link #uri}.
   * @return the version associated with the uri
   */
  versionFromUri: function(uri: !string): !int

  /**
   * Validates if the provided global path allows write operations such as register and update.
   * If validation fails, an error is thrown.
   * @param path
   *           A path.
   * @param serviceAppId
   *           Model registry service app id to be validated against.
   * @return None
   */
  validateGlobalPath: private function(path: !string, serviceAppId: !string)

  /**
   * Returns a global path or URI.
   * @param pathOrUri
   *           A path or {@link #uri}.
   * @param serviceAppId
   *           Model registry service app id to be used for making global path or URI.
   *           If not provided, the default service app id will be used.
   * @return a properly formatted global path or URI.
   */
  makeGlobalPathOrUri: private function(pathOrUri: string, serviceAppId: string): string

  /**
   * Formats the path in the provided metadata to be a global path, if not already.
   *
   * @param metadata
   *           the metadata to update the path for.
   * @param serviceAppId
   *           Model registry service app id to be used for making global path
   *           If not provided, the default service app id will be used.
   * @return a new {@link ModelRegistry.Register.Metadata} with the {@link #path} formatted to an global
   *           path.
   */
  formatPath: function(metadata: !ModelRegistry.Register.Metadata,
                       serviceAppId: string): !ModelRegistry.Register.Metadata

  /**
   * Returns string global path prefix.
   */
  globalPathPrefix: private function(): !string

  /**
   * Creates a {@link ModelRegistry.Entry.Card} for this entry.
   * If {@link ModelRegistry.Entry.Card} exists for this entry, this API will update the existing card.
   * Update operation merges the newly provided card with the existing card.
   *
   * @param card
   *           {@link ModelRegistry.Card} to be created or updated.
   * @param spec
   *           Optional {@link ModelRegistry.Entry.CardWriteSpec} for tuning file/plot upload to {@link ModelRegistryService}.
   * @return {@link ModelRegistry.Entry.CardMetadata} as an acknowledgement, i.e return a
   * summary of the card which includes names (no values) of all metrics, parameters, plots etc,. associated with a card.
   */
  updateCard: member function(card: !ModelRegistry.Card,
                              spec: ModelRegistry.Entry.CardWriteSpec): !ModelRegistry.Entry.CardMetadata

  /**
   * Removes all data associated with this {@link ModelRegistry.Entry.Card}.
   * If only specific fields need to be removed, use {@link ModelRegistry.Entry.CardRemoveSpec}.
   *
   * @param spec
   *           {@link ModelRegistry.Entry.CardRemoveSpec} for customizing the remove operation.
   * @return {@link ModelRegistry.Entry.CardMetadata} as an acknowledgement.
   */
  removeCard: member function(spec: ModelRegistry.Entry.CardRemoveSpec): !ModelRegistry.Entry.CardMetadata

  /**
   * Reads {@link ModelRegistry.Entry.Card} for this entry.
   * By default, only content, parameters and metrics are read from card.
   * If plots and files are needed, they can be read by providing a {@link ModelRegistry.Entry.CardReadSpec}.
   * If a spec is provided, only fields requested in the spec will be read.
   *
   * @param spec
   *           Optional {@link ModelRegistry.Entry.CardReadSpec} for customization of what to read from card and how to read from card.
   * @return {@link ModelRegistry.Entry.Card} corresponding to this entry.
   */
  card: member function(spec: ModelRegistry.Entry.CardReadSpec): !ModelRegistry.Entry.Card

  /**
   * Reads {@link ModelRegistry.Entry.CardMetadata} for this entry.
   *
   * @return {@link ModelRegistry.Entry.CardMetadata} corresponding to this entry.
   */
  cardMeta: member function(): !ModelRegistry.Entry.CardMetadata
}
