/**
 * Declares all of the fields on a {@link ModelRegistry.Entry}.
 * Developer Note: this is also used by types in the model registry service package.
 */
@beta
type ModelRegistry.EntryFields mixes ModelRegistry.Register.MetadataFields {

  /**
   * The URI of this {@link ModelRegistry.Entry entry}. It is unique across all registered models and its versions.
   * The URI is constructed by concatenating globally unique path and {@link #version}.
   * See {@link ModelRegistry} for definition of globally unique path.
   * Some examples of valid URIs are
   * - `ModelRegistry-cluster-df-ms/cluster-env-app/My_Classifier/3`
   * - `ModelRegistry-acme-prod-ms/all_models/classifiers/Random_Forest/4`
   */
  uri: !string

  /**
   * Version of the {@link ModelRegistry.Entry entry}.
   */
  ver: !int

  /**
   * Creation date of the {@link ModelRegistry.Entry entry}.
   */
  createdAt: datetime

  /**
   * Author of the {@link ModelRegistry.Entry entry}.
   */
  createdBy: string
}
