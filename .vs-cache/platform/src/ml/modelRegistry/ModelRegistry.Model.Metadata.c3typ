/**
 * Holds metadata for all versioned models.
 */
@beta
type ModelRegistry.Model.Metadata mixes ModelRegistry.Model.MetadataFields {

  /**
   * Updates fields specified by {@link ModelRegistry.Model.UpdateSpec}
   * and returns an updated instance of {@link ModelRegistry.Model.Metadata}.
   * @param spec
   *    {@link ModelRegistry.Model.UpdateSpec} holding fields and values that need update.
   *
   * @return an instance of updated {@link ModelRegistry.Model.Metadata}.
   */
  update: member function(spec: !ModelRegistry.Model.UpdateSpec): !ModelRegistry.Model.Metadata
}
