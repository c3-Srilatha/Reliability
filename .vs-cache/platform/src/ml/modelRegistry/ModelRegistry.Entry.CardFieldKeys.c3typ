/**
 * Fields of {@link ModelRegistry.Entry.Card} from Model Registry Service.
 */
@beta
type ModelRegistry.Entry.CardFieldKeys {

  /**
   * List of metrics associated with a {@link ModelRegistry.Entry.Card}.
   * Same as keys of {@link ModelRegistry.Entry.Card#metrics}.
   */
  metrics: [string]

  /**
   * List of parameters associated with a {@link ModelRegistry.Entry.Card}.
   * Same as keys of {@link ModelRegistry.Entry.Card#parameters}.
   */
  parameters: [string]

  /**
   * List of plots associated with a {@link ModelRegistry.Entry.Card}.
   * Same as keys of {@link ModelRegistry.Entry.Card#plots}.
   */
  plots: [string]

  /**
   * List of files associated with a {@link ModelRegistry.Entry.Card}.
   * Same as keys of {@link ModelRegistry.Entry.Card#files}.
   */
  files: [string]

  /**
   * True, if model card {@link ModelRegistry.Entry.Card#content} is not null.
   */
  content: boolean
}
