/**
 * This type represents an object that has the ability to interpret itself for machine learning purposes. An
 * interpretable object will most likely use {@link MlInterpreter}s to perform interpret operations to provide an
 * understanding of the object's underlying behavior. Please note an {@link MlInterpretable} object is not the same as
 * an {@link MlInterpreter} object. While {@link MlInterpretable} defines the ability for an object to be interpreted,
 * an {@link  MlInterpreter} will contain actual interpretation algorithms.
 */
abstract type MlInterpretable<DX, DI> {

  /**
   * Use {@link MlInterpreter}s to interpret the {@link MlInterpretable} object using the input data and context. See
   * {@link MlInterpreter} for information on interpreters. This API is asynchronous non-blocking.
   *
   * @param x
   *           Data to use as the source input. This is not the same as the downstream inputs that may or may not feed
   *           in to {@link MlInterpreter}(s)
   * @param context
   *           Additional information required to perform interpretation
   * @param spec
   *           Customizations for execution
   * @return a {@link MlOperationRun} object that represents the launched interpretation. The caller should use the APIs on
   *           the operation run object to query status and to get the final result.
   */
  interpret: abstract member function(x: !?DX, spec: MlOperationSpec): MlOperationRun<DI>

  /**
   * Blocking, synchronous version of {@link #interpret}.
   */
  interpretSync: private abstract member function(x: !?DX, context: map<string, any>, spec: MlOperationSpec): DI
}
