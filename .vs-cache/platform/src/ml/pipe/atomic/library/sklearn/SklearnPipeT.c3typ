/**
 * The pipe represents a trainable and processable python native (sklearn)[https://scikit-learn.org/stable/] object.
 *
 * Depending on the {@link #implementationType} field, the pipe will use the corresponding SklearnPipe version to train/process the data.
 * For example, if the {@link #implementationType} is set to "SklearnPipe", the pipe will use the `SklearnPipe` type to train/process the data.
 */
entity type SklearnPipeT extends MlTemplate.AtomicPipe.PipeVersioned<SklearnPipe.Base, SklearnPipe, Data, Data, Data> mixes SklearnLikePipe.FieldsAndUtils type key 'SKLTP' {

  // TODO Dry with SklearnPipe.Base
  // afterConvertFlattenInput is defined on SklearnLikePipe.FieldsAndUtils and overridden on SklearnPipe.Base.
  // We cannot mixing SklearnPipe.Base as it's a MlAtomicPipe, but this implementation is required #afterConvert.
  afterConvertFlattenInput: ~ py

  afterConvert: ~ from SklearnLikePipe.FieldsAndUtils py
}
