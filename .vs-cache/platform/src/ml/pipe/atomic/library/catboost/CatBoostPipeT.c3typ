/**
 * This type represents a trainable and processable python native [CatBoost](https://catboost.ai/en/docs/) object.
 * This pipe supports `CatBoostClassifier` and `CatBoostRegressor` estimators but does not support
 * `CatBoostRanker` estimators.
 */
@beta
entity type CatBoostPipeT extends MlTemplate.AtomicPipe.PipeVersioned<CatBoostPipe.Base, CatBoostPipe, Data, Data, Data>
                          mixes SklearnLikePipe.FieldsAndUtils, CatBoostPipe.Common
                          type key 'CATTP' {

  afterConvert: ~ from SklearnLikePipe.FieldsAndUtils py
  isFitted:     ~ from CatBoostPipe.Common py
}
