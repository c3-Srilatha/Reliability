/**
 * This type represents a trainable and processable python native [CatBoost](https://catboost.ai/en/docs/) object.
 * This pipe supports `CatBoostClassifier` and `CatBoostRegressor` estimators but does not support
 * `CatBoostRanker` estimators.
 */
@beta
entity type CatBoostPipe extends CatBoostPipe.Base type key 'CAT' {

  doTrain:     ~ from super py-catboost
  doProcess:   ~ from super py-catboost
  trainSync:   ~ from super py-catboost
  processSync: ~ from super py-catboost
  convert:     ~ from super py-catboost
}
