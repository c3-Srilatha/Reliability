/**
 * Huggingface library has a concept called pipeline {@link https://huggingface.co/transformers/main_classes/pipelines.html}
 *  which is completely different from the concept of pipeline in c3 {@link MlPipeline}.
 *
 * Huggingface pipeline encapsulates the task, model, tokenizer and feature_extractor.
 *
 * Example usage of this pipe:
 * ```python
 * >>> pipe = HuggingfacePipe.convert_from_task('sentiment-analysis')
 * >>> pipe.process(c3.Data.makeHelper([
 *                      ('input', c3.PrimitiveType.ofStr(),
 *                      ['Wow, this is fantastic!'])
 *                  ]))
 * ```
 */
@beta
entity type HuggingfacePipe extends MlAtomicPipe<Data, Data, Data> type key 'HFP' {

  /**
   * Name of the task according to {@link https://huggingface.co/transformers/main_classes/pipelines.html#transformers.pipeline}.
   */
  task: private !string

  /**
   * Name of the model according to {@link https://huggingface.co/transformers/main_classes/pipelines.html#transformers.pipeline}.
   * If not provided, the default for the task will be loaded.
   */
  modelName: private string

  /**
   * Name of the tokenizer according to {@link https://huggingface.co/transformers/main_classes/pipelines.html#transformers.pipeline}.
   * If not provided, the default for the task will be loaded.
   */
  tokenizerName: private string

  /**
   * Convert `x` and `y` from `DX`, `DY` type to python native format.
   * Uses column 'x' for x or if that doesn't exist, the zeroth index column.
   * Uses column 'y' for y or if that doesn't exist, the zeroth index column.
   * For question-answering, the column names must be `question` and `context` for `x`.
   */
  convertPipeInputsToNative: ~ py

  doProcess: ~ py-huggingface

  /**
   * NOTE: This method currently throws a NotImplementedError.
   *
   * @inheritdoc
   */
  // TODO: PLAT-37991 Implement this method, not throw an error
  @beta
  doTrain: ~ py-huggingface

  saveModel:   ~ py
  loadModel:   ~ py
  nativeModel: ~ py-huggingface
  convert:     ~ py-huggingface

  /**
   * Convert the native object to a {@link HuggingfacePipe} object.
   * Example usage:
   * ```python
   * pipe1 = HuggingfacePipe.convert_from_task('sentiment-analysis')
   *
   * pipe2 = HuggingfacePipe.convert_from_task('sentiment-analysis', 'distilbert-base-uncased-finetuned-sst-2-english')
   *
   * model = TFAutoModelForSequenceClassification.from_pretrained('distilbert-base-uncased-finetuned-sst-2-english'),
   * tokenizer = AutoTokenizer.from_pretrained('distilbert-base-uncased-finetuned-sst-2-english')
   * pipe3 = HuggingfacePipe.convert_from_task('sentiment-analysis', model, tokenizer)
   * ```
   *
   * @param task
   *    Name of the task according to {@link https://huggingface.co/transformers/main_classes/pipelines.html#transformers.pipeline}.
   * @param model
   *    Either a native PreTrainedModel {@link https://huggingface.co/transformers/main_classes/model.html#transformers.PreTrainedModel}
   *    or a string representation of the model.
   *    Could be retrieved from the Hugginface model repository {@link https://huggingface.co/models}.
   *    eg: `facebook/mbart-large-cc25` for {@link https://huggingface.co/facebook/mbart-large-cc25}
   * @param tokenizer
   *    Either a native PreTrainedTokenizerFast {@link https://huggingface.co/transformers/main_classes/tokenizer.html#transformers.PreTrainedTokenizerFast}
   *    or a string representation of the tokenizer.
   *    Could be retrieved from the Hugginface model repository {@link https://huggingface.co/models}.
   * @param spec
   *    Customizations for convert.
   * @return an {@link MlPipe} C3 object that behaves as the native machine learning object.
   */
  convert_from_task: function(task: !string,
                              model: native,
                              tokenizer: native,
                              spec: MlConvertSpec): !mixing HuggingfacePipe py-huggingface
}
