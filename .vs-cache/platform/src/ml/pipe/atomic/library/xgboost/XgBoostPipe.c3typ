/**
 * This type represents a trainable and processable python native [XGBoost](https://xgboost.readthedocs.io/en/stable/) object.
 * This pipe supports `XGBClassifier`, `XGBRegressor`, `XGBRFClassifier` and `XGBRFRegressor` estimators but does not
 * support `XGBRanker` estimators.
 */
@beta
type XgBoostPipe extends SklearnLikePipe type key 'XGB' {

  doTrain:     ~ from super py-xgboost
  doProcess:   ~ from super py-xgboost
  trainSync:   ~ from super py-xgboost
  processSync: ~ from super py-xgboost
  convert:     ~ from super py-xgboost
}
