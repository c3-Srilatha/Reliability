/**
 * This type represents a trainable and processable python native [LightGBM](https://lightgbm.readthedocs.io/en/latest/) object.
 * This pipe supports `LGBMClassifier` and `LGBMRegressor` estimators but does not support `LGBMRanker` estimators.
 */
@beta
abstract type LightGbmPipe.Base extends SklearnLikePipe type key 'LGBMB'
