/**
 * This type represents a base for trainable and processable python native keras object.
 *
 * `GEN` is a type of the {@link KerasGenerator} to use.
 * `CGEN` is a type of custom generator to use, see {@link KerasCustomGenerator}
 */
@beta
abstract type KerasPipe.Base<DX, DY, DO, GEN, CGEN> extends MlAtomicPipe<DX, DY, DO> mixes KerasPipe.FieldsAndUtils<DX, DY> type key 'KERPB' {

  afterConvert:               ~ py
  saveModel:                  ~ py
  loadModel:                  ~ py
  convertPipeInputsToNative:  ~ py
  convertNativeToNative:      ~ py
  convertNativeToPipeOutputs: ~ py
  nativeInputFormats:         ~ py

  @dependency(include='this')
  doTrain: ~ py-tf

  @dependency(include='this')
  doProcess: ~ py-tf

  createGenerator: ~ py-tf
}
