/**
 * This type represents a trainable and processable python native keras object.
 */
entity type KerasPipe<DX, DY, DO> extends KerasPipe.Base<DX, DY, DO, KerasGenerator, KerasCustomGenerator> type key 'KER' {

  trainSync:       ~ from super py-tf
  processSync:     ~ from super py-tf
  createGenerator: ~ from super py-tf
}
