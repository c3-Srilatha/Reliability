/**
 * This type represents a CPU-only wrapper over {@link KerasPipe} such that users with Mac OSX machines can develop
 * and execute {@link KerasPipe}s. This wrapper can also be used to guarantee execution on only the CPU.
 */
@beta
entity type KerasPipeCpu<DX, DY, DO> extends KerasPipe<DX, DY, DO> type key 'KERM'
