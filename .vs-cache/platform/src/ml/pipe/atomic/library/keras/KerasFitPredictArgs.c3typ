/**
 * Customizations for {@link KerasPipe#convert} that define args that are common to both `fit` and `predict` in Keras.
 */
private type KerasFitPredictArgs mixes KerasGeneratorArgs {

  /**
   * Verbosity mode. 0 = silent, 1 = progress bar, 2 = one line per epoch.
   */
  verbose: int = 1

  /**
   * Native Keras Callbacks to call on training.
   */
  /*
   * TODO: PLAT-39678: Native objects
   * callbacks: native
   */

  /**
   * Maximum size for the generator queue.
   *
   * Ignored in tensorflow>3
   */
  @ML(hyperparameter=true)
  max_queue_size: int = 10

  /**
   * If True, use process-based threading.
   *
   * Ignored in tensorflow>3
   */
  @ML(hyperparameter=true)
  use_multiprocessing: boolean

  /**
   * Maximum number of processes to spin up when using process-based threading.
   */
  @ML(hyperparameter=true)
  workers: int = 1
}
