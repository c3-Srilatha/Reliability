/**
 * Customizations for {@link KerasPipe#convert} to define args to pass in during processing to the native Keras object's
 * `predict` function.
 */
private type KerasPredictArgs mixes KerasFitPredictArgs {

  /**
   * Total number of steps (batches of samples) before declaring the prediction round finished.
   */
  @ML(hyperparameter=true)
  steps: int
}
