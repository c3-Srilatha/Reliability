/**
 * Customizations for {@link KerasGenerator}.
 */
private type KerasGeneratorArgs {

  /**
   * Batch Size for sampling of data by {@link KerasGenerator} for the model of {@link KerasPipe}.
   */
  @ML(hyperparameter=true)
  batch_size: int = 32

  /**
   * If true, shuffle the training data.
   */
  @ML(hyperparameter=true)
  shuffle: boolean
}
