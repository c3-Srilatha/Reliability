/**
 * This type represents a trainable and processable python native keras object.
 */
entity type KerasPipeT<DX, DY, DO> extends MlTemplate.AtomicPipe.PipeVersioned<KerasPipe.Base<DX, DY, DO, any, any>, KerasPipe<DX, DY, DO>, DX, DY, DO> mixes KerasPipe.FieldsAndUtils<DX, DY> type key 'KERTP' {

  createGenerator: ~ py
}
