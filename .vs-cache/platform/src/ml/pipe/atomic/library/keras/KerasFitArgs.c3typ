/**
 * Customizations for {@link KerasPipe#convert} to define args to pass in during training to the native Keras object's
 * `fit` function. Validation data and the related args are not supported.
 */

/**
 * Weights to apply to the model's loss for each sample. Should be the same length as the `x` input into
 * {@link KerasPipe}. This should be passed in to the `y` port when calling {@link #train}.
 */
// @ML(hyperparameter=true)
// sample_weight: Data
type KerasFitArgs mixes KerasFitPredictArgs {

  /**
   * Number of epochs to train the model.
   */
  @ML(hyperparameter=true)
  epochs: int = 1

  /**
   * Epoch at which to start training. Defaults to 0 if not specified.
   */
  @ML(hyperparameter=true)
  initial_epoch: int

  /**
   * Total number of steps (batches of samples) before declaring one epoch finished and starting the next epoch.
   */
  @ML(hyperparameter=true)
  steps_per_epoch: int

  /**
   * Maps class labels to weights.
   */
  @ML(hyperparameter=true)
  class_weight: map<int, float>
}
