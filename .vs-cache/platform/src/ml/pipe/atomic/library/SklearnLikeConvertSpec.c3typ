/**
 * Customizations for {@link SklearnLikePipe#convert}.
 */
type SklearnLikeConvertSpec mixes MlConvertSpec {

  /**
   * Override the train function for {@link SklearnPipe#trainFunc}.
   */
  trainFunc: string

  /**
   * Override {@link SklearnPipe#keepInputColumnIndices} to keep input column indices on the output
   */
  keepInputColumnIndices: boolean
}
