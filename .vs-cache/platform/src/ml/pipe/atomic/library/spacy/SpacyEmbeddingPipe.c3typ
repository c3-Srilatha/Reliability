/**
 * A {@link MlAtomicPipe} using *Python*'s *spaCy* library underneath to get embeddings for text at specified
 * granularity level. This is a multi-output pipe which takes a DataTable of SpacyDoc and produces out_embeddings,
 * out_docids, and out_text.
 *
 * See {@link SpacyPipe}.
 *
 * Example usage:
 * ```python
 * >>> nlp = spacy.load("en_core_web_sm") # The runtime should have the *spacy* language model available.
 * >>> string_list = ["C3 AI customers include Royal Dutch Shell", "Others are US Air Force, and New York Power Authority."]
 * >>> spacyPipe = c3.SpacyPipe.convert(nlp)
 * >>> embeddingPipe = c3.SpacyEmbeddingPipe(name='embedding_pipe', embeddingMode='document')
 * >>> mla = c3.MlPipeline.Authoring
 * >>> x = mla.var()
 * >>> spacy_out = spacyPipe(x)
 * >>> out = embeddingPipe(spacy_out)
 * >>> pipeline = mla.pipeline(x=x, out=out)
 * >>> x = pd.DataFrame.from_dict({'text': string_list})
 * >>> x = c3.Data.from_pandas(x)
 * >>> result = pipeline.process(x=x).result()
 * >>> print(result['out_text'], result['out_docids'], result['out_embeddings'])
 * ```
 */
@beta
entity type SpacyEmbeddingPipe extends MlAtomicPipe<Data, Data, SpacyEmbeddingPipe.Output> type key 'SE' {

  convertXToNative: ~ py
  convertYToNative: ~ py
  doProcess:        ~ py-spacy
  isTrainable:      ~ py
  embeddingMode:    string enum SpacyEmbeddingPipe.EmbeddingType = DOCUMENT
}
