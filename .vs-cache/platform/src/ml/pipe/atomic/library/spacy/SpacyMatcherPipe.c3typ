/**
 * A {@link MLAtomicPipe} using *Python*'s *spaCy* library underneath to perform NLP Matching
 * operations. This pipe takes a DataTable of matches with their string IDs and their representative text.
 * Example usage of this pipe:
 * ```python
 * >>> nlp = spacy.load("en_core_web_sm")
 * >>> matcher = Matcher(nlp.vocab)
 * >>> spacyPipe = c3.SpacyPipe.convert(nlp)
 * >>> matcherPipe = c3.SpacyMatcherPipe(matcher)
 * >>> out_dt = spacyPipe.process(data_text)
 * >>> pattern = [{"LOWER": "hello"}, {"IS_PUNCT": True}, {"LOWER": "world"}]
 * >>> matcherPipe = matcherPipe.addPattern("HelloWorld", [pattern])
 * >>> matching_dt = matcherPipe.process(out_dt)
 * ```
 */
@beta
entity type SpacyMatcherPipe extends MlAtomicPipe<Data, Data, Data> type key 'SM' {

  /**
   * Returns dictionary mapping hash of all match_ids to their respective patterns.
   */
  getAllPatterns: member function(): any py-spacy

  /**
   * Returns the readable string match_id from the hash of match_id.
   */
  getMatchIDString: member function(matchId: int): string py-spacy

  convertXToNative: ~ py-spacy
  convertYToNative: ~ py-spacy
  doTrain:          ~ py-spacy
  doProcess:        ~ py-spacy
  matcherType:      SpacyMatcherPipe.MatcherType = TOKEN
  isTrainable:      ~ py
}
