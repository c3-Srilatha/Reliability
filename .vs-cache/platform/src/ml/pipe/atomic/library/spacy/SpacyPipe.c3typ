/**
 * A {@link MLAtomicPipe} using *Python*'s *spaCy* library underneath to perform Natural Language Processing (NLP)
 * operations. This pipe takes a Data of text and provides a Data of {@link SpacyDoc} representing
 * the native spacy language model outputs.
 *
 * Note: Make sure you have the *spacy* language model is available in your *Python* runtime. (eg. `py-spacy`)
 * Example usage of this pipe:
 * ```python
 * >>> nlp = spacy.load("en_core_web_sm") # The runtime should have the *spacy* language model available.
 * >>> spacyPipe = c3.SpacyPipe.convert(nlp)
 * >>> out_dt = spacyPipe.process(data_text)
 * ```
 */
@beta
entity type SpacyPipe extends MlAtomicPipe<Data, Data, Data> type key 'SP' {

  convertXToNative: ~ py-spacy
  convertYToNative: ~ py-spacy
  doTrain:          ~ py-spacy
  doProcess:        ~ py-spacy
  saveModel:        ~ py
  loadModel:        ~ py
}
