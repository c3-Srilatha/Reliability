/**
 * Type representing multiple outputs of this Pipe
 */
type SpacyEmbeddingPipe.Output {

  /**
   * Embedding vectors obtained from {@link SpacyDoc}
   */
  out_embeddings: Data

  /**
   * Text corresponding to embedding vectors obtained from {@link SpacyDoc}
   */
  out_text: Data

  /**
   * Document id's of text obtained from {@link SpacyDoc}
   */
  out_docids: Data
}
