/**
 * This type represents methods that can be used to migrate platform provided {@link MlAtomicPipe} pipe(s) across python versions.
 */
type MlAtomicPipe.Migratable {

  /**
   * Migrates {@link MlAtomicPipe} pipe(s) from a given {@link Type}, to another specified {@link Type}. If the upgrade fails, use {@link #rollBackPipes} to recover the original pipe(s).
   * @param typeTo
   *           {@link Type} to which the pipes should be upgraded.
   * @param spec
   *           {@link FetchSpec} for the pipes to upgrade.
   * @param keepId
   *           {@link boolean} If true, the id of the newly created {@link MlAtomicPipe} pipe(s) will be the same as the current {@link MlAtomicPipe} pipe(s), and the current {@link MlAtomicPipe} pipe(s) will be deleted.
   * @return
   *           {@link FetchResult} containing the upgraded {@link MlAtomicPipe} pipe(s).
   */
  migratePipes: function(typeTo: Type, spec: FetchSpec, keepIds: boolean): !FetchResult py

  /**
   * Recover the backups of {@link MlAtomicPipe} pipe(s) created during {@link #migratePipes}. This will rollback to the type the API is invoked on.
   * @param pipes
   *           {@link MlAtomicPipe} pipe(s) to rollback. This will delete the migrated pipe(s) and restore the original pipe(s) from the backup.
   */
  rollBackPipes: function(pipes: ![MlAtomicPipe]): !FetchResult py

  /**
   * Clears the backups of {@link MlAtomicPipe} pipe(s) created during {@link #migratePipes}. This should be called after the upgrade is successful and the backup is no longer needed.
   * @param pipes
   *           Migrated {@link MlAtomicPipe} pipe(s) to clear the backup for.
   */
  clearBackupPipes: function(pipes: ![MlAtomicPipe], confirm: boolean) py

  /**
   * The prefix used for the name of the backup of {@link MlAtomicPipe} pipe(s) during the upgrade process, which can be used to recover the pipe(s) if the upgrade fails.
   */
  BACKUP_PIPE_NAME_PREFIX: private const !string = 'm!GR@tep!PEB@ckup'
}
