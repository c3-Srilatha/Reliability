@beta
type MlAtomicPipe.Engine mixes Engine<MlAtomicPipe.Engine.Deployment, MlAtomicPipe.Engine.DeploySpec> {

  /**
   * Calls {@link #pipe#process}.
   */
  process: member function(x: !?any, spec: MlOperationSpec): !any

  /**
   * Calls {@link #pipe#processStreamable}.
   *
   * Returns a {@link Pair} of streamId and Id of the node where this Stream is stored.
   */
  processStream: member function(prompt: !string, params: ?map<string, any>): !Pair<int, string>

  /**
   * The {@link MlAtomicPipe} that this engine is associated with.
   */
  pipe: cached inline property(): !MlAtomicPipe

  /**
   * The id of the {@link MlAtomicPipe} that would be created with the given Model Registry uri.
   */
  pipeIdFromUri: private inline function(uri: !string): !string

  /**
   * Returns the secondary {@link App.Node.ThreadPool} for this {@link MlAtomicPipe.Engine} if it is configured.
   */
  targetSecondaryThreadPool: private cached inline property(): App.Node.ThreadPool

  /**
   * Runs {@link MlAtomicPipe#deploymentHardwareConstraint} and {@link MlAtomicPipe#validate} for the {@link #pipe}.
   */
  beforeDeploy: ~

  /**
   * Create the {@link App.Node.ThreadPool.Config} for the secondary threadpool if it is configured.
   */
  specToConfigs: ~

  /**
   * Start the {@link Engine.DeploySpec#secondaryThreadPool} if it is configured.
   */
  onStart: ~

  /**
   * Stop {@link Engine.DeploySpec#secondaryThreadPool} if it is configured.
   */
  onStop: ~

  /**
   * Cleans up the secondary thread pool if it is configured.
   */
  afterTerminate: ~

  /**
   * Native lambda for efficiently recording duration of {@link #process} in case of success.
   */
  recordSuccessProcessDuration: private cached property(): @java(class="java.util.function.Consumer<Double>") !native

  /**
   * Native lambda for efficiently recording duration of {@link #process} in case of failure.
   */
  recordFailureProcessDuration: private cached property(): @java(class="java.util.function.Consumer<Double>") !native

  /**
   * Native lambda for efficiently recording duration of {@link #process} in case of failure.
   */
  recordRetryProcessCount: private cached property(): @java(class="java.util.function.Consumer<Double>") !native

  state:             ~
  errors:            ~
  summarizeInstance: ~
  summarizeThreads:  ~
}
