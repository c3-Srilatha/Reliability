@beta
type MlAtomicPipe.Engine.DeploySpec mixes MlAtomicPipe.Engine.DeployBase, Engine.DeploySpec {

  /**
   * If configured, {@link MlAtomicPipe.Engine#pipe#warmup} and {@link MlAtomicPipe.Engine#pipe#process} are called in
   * this thread pool. This thread pool is used solely by the {@link MlAtomicPipe.Engine}, and its lifecycle is tied to
   * the engine.
   */
  secondaryThreadPool: App.Node.ThreadPool.Spec

  /*
   * The number of threads per node for the primary threadpool.
   * Sets the {@link #threadPool} minThreads, maxThreads, and initialThreads to numThreads.
   * See {@link App.Node.ThreadPool#minThreads}, {@link App.Node.ThreadPool#maxThreads}, and {@link App.Node.ThreadPool#initialThreads}.
   */
  withNumThreads: member function(numThreads: !int32): !MlAtomicPipe.Engine.DeploySpec

  /*
   * Sets the queueTimeout for the {@link #threadPool}. If {@link #secondaryThreadPool} is configured, the same queueTimeout is set for it as well.
   * See {@link App.Node.ThreadPool#queueTimeout}.
   */
  withQueueTimeout: member function(queueTimeout: !string serialized Duration): !MlAtomicPipe.Engine.DeploySpec

  // Merge the current spec with otherSpec, if conflicts, otherSpec takes precedence.
  merge: private member function(otherSpec: !?MlAtomicPipe.Engine.DeploySpec): !?MlAtomicPipe.Engine.DeploySpec
}
