/**
 * This prototype pipe is used to run (process only) "sklearn-like" models trained in V7.
 * See implementation file for integration details and ideas for increasing robustness of this prototype.
 */
entity type SklearnLikePipeV7 extends MlAtomicPipe<Data, Data, Data> type key 'SKLV' {

  /**
   * See `runtimeRequirement` arg to {@link #fromV7Json}.
   */
  legacyRuntime: private string

  /**
   * The model file is parsed out of {@link #legacyPipeJson} and stored here.
   */
  legacyModelFile: private Url

  /**
   * See `pipe` arg to {@link #fromV7Json}. This is stored so that further functionality could be added to this pipe
   * in the future, without having to re-migrate instances.
   */
  legacyPipeJson: private Url

  doProcess: ~ py

  /**
   * Primary constructor for this pipe - based on the stringified v7 pipe json and runtime requirement
   * @param pipe
   *           json dump of the v7 MLLeafPipe.
   * @param runtimeRequirement
   *           yaml for the declared runtime requirement in v7 for the runtime corresponding to the MLLeafPipe.
   * @return constructed V8-operable {@link MlAtomicPipe}.
   */
  fromV7Json: function(pipe: !string, runtimeRequirement: !string): !mixing SklearnLikePipeV7 py
}
