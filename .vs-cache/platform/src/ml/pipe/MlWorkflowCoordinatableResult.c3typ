/**
 * A persistable result type used by {@link MlWorkflowCoordinatable}.
 * Examples are {@link MlModel.Train.Result}, {@link Hpo.Trial}, {@link Hpo.Run}
 * See {@link MlWorkflowCoordinatable}
 * See {@link Workflow.Coordinatable}
 */
@db(index=['parentCoordinator', 'statusForCoordinatable', 'errorCount'])
abstract extendable entity type MlWorkflowCoordinatableResult mixes WithUniqueName type key 'MWR' {

  /**
   * Parent {@link MlWorkflowCoordinatable} that this result belongs to.
   */
  parentCoordinator: !MlWorkflowCoordinatable

  /**
   * Helper field for filtering during the coordinator implementation.
   * See {@link Workflow.Coordinatable} for status semantics.
   */
  statusForCoordinatable: private !string enum("pending", "running", "completed")

  /**
   * Number of times the {@link #parentCoordinator} has canceled this result.
   */
  canceledCount: int = 0

  /**
   * True if the most recent execution of this result was canceled. This is used for quick filtering
   * to focus on canceled results.
   */
  isCanceled: boolean

  /**
   * Stores the count of errors that would be returned from {@link #errors}. This is used for quick filtering
   * to focus on results with errors.
   */
  errorCount: int = 0

  /**
   * Retrieves the errors associated this {@link MlWorkflowCoordinatableResult}.
   * key is step name. Value is {@link Workflow.Status#errors} of the step.
   */
  errors: member function(): map<string, [string]>

  /**
   * Helper function for creating and starting a workflow to execute the operation for this result.
   * @return a handle to the asynchronous execution.
   */
  startWorkflow: private abstract member function(): !WorkflowExecutorRun

  /**
   * Reference to the {@link WorkflowExecutorRun} that executed the actions to execute this
   * result.
   */
  run: private WorkflowExecutorRun

  /**
   * Duration in seconds of the most recent {@link #run} that executed the actions pertaining to this result.
   * This is used for quick filtering to focus on results with unexpected execution times (long or short).
   * This field is null if this result has not been executed.
   */
  durationSeconds: private ?int

  /**
   * Reference to all past {@link WorkflowExecutorRun}s that executed the actions pertaining to this
   * result.
   */
  pastRuns: private [WorkflowExecutorRun]

  /**
   * Number of times the {@link #parentCoordinator} has attempted to recover this result.
   */
  attemptedRecoveryCount: int = 0

  /**
   * Helper function that prepares this result for recovery by making any necessary state changes.
   * See {@link Workflow.Coordinatable#recover}.
   * @return this result with necessary state changes. Returned results are not persisted, and
   * caller is responsible for persisting the result.
   */
  beforeRecover: private member function(): !mixing MlWorkflowCoordinatableResult

  /**
   * Helper function that prepares this result for cancellation by making necessary state changes.
   * If the result is already canceled, this function does not make any changes.
   * If the result is "running", this function attempts to cancel the {@link #run} associated with this result, in addition to
   * necessary state changes.
   *
   * @return this result with necessary state changes. Returned results are not persisted, and
   * caller is responsible for persisting the result.
   */
  beforeCancel: private member function(): !mixing MlWorkflowCoordinatableResult
}
