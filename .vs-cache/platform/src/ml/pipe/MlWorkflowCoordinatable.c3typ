/**
 * Specialization of {@link Workflow.Coordinatable} representing a coordinator
 * that uses {@link MlWorkflowCoordinatableResult} as results.
 * RT = "result type", e.g. {@link MlModel.Train.Result}, {@link Hpo.Trial}, {@link Hpo.Run}
 */
abstract type MlWorkflowCoordinatable<RT: MlWorkflowCoordinatableResult> extends Workflow.Coordinatable<RT> type key 'MWC' {

  runFromResult:         ~
  pendingResultsCount:   ~
  runningResultsCount:   ~
  completedResultsCount: ~
  allResultsCount:       ~
  erroredResultsCount:   ~
  canceledResultsCount:  ~
  pendingResults:        ~
  runningResults:        ~
  completedResults:      ~
  canceledResults:       ~
  allResults:            ~
  afterComplete:         ~
  afterStart:            ~
  updateRunningResults:  ~
  erroredResults:        ~
  recover:               ~
  autoRecover:           ~
  cancel:                ~

  /**
   * {@link JobOptions} for executing this coordinator.
   */
  jobOptions: private JobOptions

  /**
   * Returns the batch size for `upsertBatch` in `generateNextResults` for sub-types of {@link MlWorkflowCoordinatable}.
   */
  upsertResultsBatchSize: private member function(): !int

  /**
   * Helper function for creating a {@link Workflow} to execute this coordinator.
   * @param jobOptions
   *    Execution options for workflow.
   */
  createCoordinatorWorkflow: private member function(jobOptions: !JobOptions): !Workflow

  /**
   * Helper function for fetching results coordinated by this coordinator.
   * @param spec
   *         {@link FetchSpec} for customizing the results to be fetched.
   *
   * @returns a {@link FetchResult} consisting of results coordinated by this coordinator.
   */
  resultsForSummary: private member function(spec: FetchSpec): FetchResult<RT>
}
