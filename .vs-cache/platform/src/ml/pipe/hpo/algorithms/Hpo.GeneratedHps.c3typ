/**
 * Base type representing the objects returned by {@link Hpo.Algorithm#generate}
 */
type Hpo.GeneratedHps {

  /**
   * A single hyperparameter combination produced by {@link Hpo.Algorithm#generate}
   * key is the hyperparameter name, value is the respective hyperparameter value
   */
  hyperparam: !map<string, any>
}
