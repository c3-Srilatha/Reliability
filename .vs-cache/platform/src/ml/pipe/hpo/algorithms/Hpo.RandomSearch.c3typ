/**
 * This type represents a random hyperparameter search technique. All generated sets of hyperparameter combinations
 * will be randomly sampled from the parameter spaces in this technique's search space.
 */
type Hpo.RandomSearch mixes Hpo.Algorithm {

  /**
   * This search technique only supports random search.
   */
  algorithm: ~ = "random"

  initialize: ~ py
  generate:   ~ py
  isSerial:   ~ py
}
