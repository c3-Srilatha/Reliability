/**
 * Implementation of {@link Hpo.Algorithm} type using Optuna
 * library: https://optuna.readthedocs.io/
 * Supported sampling {@link Hpo.Algorithm#algorithm}s are Random, Grid, TPE, and CMAES.
 * Optuna uses "TPE" as default.
 */
type Hpo.OptunaSearch mixes Hpo.Algorithm {

  /**
   * The algorithm to use for searching. By default, this search technique will use the Tree-structured Parzen Estimator
   * (TPE) algorithm.
   */
  algorithm: ~ = "TPE"

  /**
   * Contains path of the file that stores serialized Optuna study object.
   */
  studyPath: private string

  /**
   * Returns path of the file for serialized Optuna study object.
   * @param study - Optuna's study object.
   * @return a path of the file for serialized Optuna study object
   */
  saveNativeStudy: private member function(study: !native): !string py-optuna_312 | py-optuna

  // @return The native Optuna study saved on this search technique.
  loadNativeStudy: private member function(): !native py-optuna_312 | py-optuna

  initialize: ~ py-optuna_312 | py-optuna
  generate:   ~ py-optuna_312 | py-optuna
  isSerial:   ~ py
}
