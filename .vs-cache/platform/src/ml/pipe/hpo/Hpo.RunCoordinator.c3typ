/**
 * Manages creation and execution of {@link Workflow} required for starting and executing a {@link Hpo.Trial},
 * {@link Hpo.Trial#startWorkflow} creates a new instance of {@link Hpo.RunCoordinator}.
 */
type Hpo.RunCoordinator extends MlWorkflowCoordinatable<Hpo.Run> type key 'HPORC' {

  /**
   * {@link Hpo.Trial} that this coordinator belongs to.
   */
  hpoTrial: !Hpo.Trial

  generateNextResults:          ~ py
  startResult:                  ~ py
  completeResult:               ~ py
  customSummaryFieldsForResult: ~ py
  recover:                      ~ py
}
