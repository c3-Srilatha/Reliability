/**
 * Specification for which trials need to be removed/retained upon user-initiated {@link Hpo.ExperimentBase} clean up.
 */
type Hpo.CleanUpSpec {

  /**
   * If true, we remove all {@link MlPipe}s and all runs except for the {@link MlPipe}s and runs corresponding
   * to the best hyperparameter combination.
   */
  keepBest: boolean = False
}
