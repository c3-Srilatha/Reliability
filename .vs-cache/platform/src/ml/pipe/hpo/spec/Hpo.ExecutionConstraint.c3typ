/**
 * Execution constraints for {@link Hpo.ExperimentBase}, provided as part of {@link Hpo.Spec} setting the time taken
 * and number of trials. Also determines the number of concurrent trials.
 */
type Hpo.ExecutionConstraint {

  /**
   * Maximum time to run the search, in minutes (total time including any nested searches).
   */
  maxSearchTime: int

  /**
   * Upper bound on total hyperparameter sets that we are evaluating during the search.
   */
  maxTrials: int = 50

  /**
   * Upper bound on total hyperparameter sets that we are evaluating in parallel during the search.
   */
  maxConcurrentTrials: int = 10

  /**
   * If value is greater than 0, failed trials of hpo experiment will be attempted for recovery.
   */
  numAutoRecoveryAttempts: int = 0
}
