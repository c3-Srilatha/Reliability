/**
 * {@link Hpo.RetentionPolicy} allows specification of how/whether to clean up trained artifacts automatically after
 * experiment completion.
 */
type Hpo.RetentionPolicy {

  /**
   * If true, then all {@link MlPipe}s will remain persisted after auto-tuning.
   * By default, this is false, and only the best pipe is guaranteed to be stored.
   */
  keepAllTrainedPipes: boolean
}
