/**
 * Results for a single hyperparameter combination of {@link Hpo.Experiment}.
 * Aggregates the results from the individual trainings (may be more than one) for cross-validation
 * purposes. Also contains a single validation summary score that is used to compare different
 * hyperparameter combinations. Should only be used for results of a hyperparameter combination based on
 * {@link Hpo.Experiment}.
 */
type Hpo.Trial extends MlWorkflowCoordinatableResult type key 'HPOTRIAL' {

  /**
   * Set of hyperparameters used for the trainings within this search trial.
   */
  generatedParams: Hpo.GeneratedHps

  /**
   * Collection of results from individual training runs. The number of {@link Hpo.Run}s will depend on the number
   * of splits generated by the {@link MlSplit.Technique}.
   */
  hpoRuns: member function(): [Hpo.Run] py

  /**
   * The summary score of all the training scores in {@link #runs} for the
   * {@link MlPipe#scoringMetrics}. Aggregation technique is described by
   * {@link MlSplit.Technique#scoreSummary}.
   */
  trainedScoreSummaries: map<string, double>

  /**
   * The summary score of all the validation scores in {@link #runs} for the
   * {@link MlPipe#scoringMetrics}. Aggregation technique is described by
   * {@link MlSplit.Technique#scoreSummary}.
   */
  validationScoreSummaries: map<string, double>

  /**
   * Cancel this {@link Hpo.Trial} and all the {@link Hpo.Run}s for this trial, and
   * set the {@link #statusForCoordinatable} as `completed`.
   */
  cancel: private member function() py

  /**
   * Helper function for populating summary of training and validation scores
   * before completion of this {@link Hpo.Trial}.
   */
  beforeComplete: private member function(): !Hpo.Trial py

  startWorkflow: ~ py

  /**
   * Keeps track of the state of the trial.
   * 'pending' - one or more trainings are still ongoing
   * 'succeeded' - all trainings have completed successfully
   * 'failed' - all training completed, at least one of which failed
   * 'interrupted' - trial was prematurely stopped, due to parent {@link Hpo.Experiment} search being stopped
   */
  @deprecated(details="No longer applicable")
  status: string enum('pending', 'succeeded', 'failed', 'interrupted')

  /**
   * Collection of results from individual training runs. The number of {@link Hpo.Run}s will depend on the number
   * of splits generated by the {@link MlSplit.Technique}.
   */
  @deprecated(details="No longer applicable")
  runs: [Hpo.Run]

  /**
   * Timestamp of the beginning of the trial that includes training and scoring.
   * Note that startTimestamp may be updated on a different machine compared to endTimestamp
   * whose clocks may not be synchronized.
   */
  @deprecated(details="No longer applicable")
  startTimestamp: datetime

  /**
   * Timestamp of the end of the trial that includes training and scoring.
   */
  @deprecated(details="No longer applicable")
  endTimestamp: datetime
}
