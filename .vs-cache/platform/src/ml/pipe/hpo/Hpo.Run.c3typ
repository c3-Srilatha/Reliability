/**
 * Results for a single training run of {@link MlPipe}.
 * Upon successful completion, this will contain validation/train scores.
 * Upon failure, this will contain a best-effort error message.
 * Note: a single hyperparameter combination may trigger multiple training runs for cross-validation purposes.
 * The {@link Hpo.Run}s are aggregated in {@link Hpo.Trial}.
 */
type Hpo.Run extends MlWorkflowCoordinatableResult type key 'HPORUN' {

  /**
   * A single train and validation split for training and scoring this {@link Hpo.Run}.
   */
  validationSplit: private MlSplit

  /**
   * Validation scores computed from {@link MlPipe#scoringMetrics} in
   * {@link Hpo.Spec#validationTechnique}. The key is the name of the metric, and the value is the score.
   */
  validationScores: map<string, double>

  /**
   * Training scores computed from {@link MlPipe#scoringMetrics} in
   * {@link Hpo.Spec#validationTechnique}. The key is the name of the metric, and the value is the score.
   */
  trainingScores: map<string, double>

  /**
   * Trained pipe from the training run.
   */
  pipe: MlPipe

  /**
   * Cancel this {@link Hpo.Run} and set the {@link #statusForCoordinatable} as `completed`.
   */
  cancel: private member function() py

  /**
   * Update this {@link Hpo.Run} with trained {@link #pipe}, {@link #validationScores} and
   * {@link #trainingScores}.
   */
  beforeComplete: private member function(): Hpo.Run py

  /**
   * Reference to the {@link MlOperationRun} that executed the actions to execute this
   * result.
   */
  operationRun: private MlOperationRun

  /**
   * Helper function for creating and starting a workflow to execute the operation for this result.
   * @return a handle to the asynchronous execution.
   */
  startWrapperWorkflow: private member function(): !MlOperationRun py

  startWorkflow: ~ py

  /**
   * Error returned by a failed training run.
   */
  @deprecated(details="No longer applicable")
  error: [string]

  /**
   * Trained pipe from the training run.
   */
  @deprecated(details="No longer applicable")
  @db(persistAllFields=true)
  trainedPipe: MlPipe

  /**
   * {@link MlOperationRun} that is orchestrating the train and score execution of pending trainings.
   * Only intended for internal use!
   */
  @deprecated(details="No longer applicable")
  mlOperationRun: private MlOperationRun

  /**
   * Timestamp of the beginning of the {@link Hpo.Run} that includes training and scoring.
   * Note that startTimestamp may be updated on a different machine compared to endTimestamp
   * whose clocks may not be synchronized.
   */
  @deprecated(details="No longer applicable")
  startTimestamp: datetime

  /**
   * Timestamp of the end of the {@link Hpo.Run} that includes training and scoring.
   */
  @deprecated(details="No longer applicable")
  endTimestamp: datetime

  /**
   * Shape of the inputs and targets (if any) used for training in an {@link Hpo.Run}
   */
  @deprecated(details="No longer applicable")
  trainShape: map<string, any>

  /**
   * Shape of the inputs and targets (if any) used for validation in an {@link Hpo.Run}
   */
  @deprecated(details="No longer applicable")
  valShape: map<string, any>
}
