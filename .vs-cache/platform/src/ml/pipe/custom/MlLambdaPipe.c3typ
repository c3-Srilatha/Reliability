/**
 * An {@link MlLambdaPipe} wraps a native stateless function to allow for custom processing in an {@link MlPipeline}.
 * A {@link MlLambdaPipe} cannot be trained.
 *
 * @see MlAtomicPipe
 * @see MlPipeline
 */
type MlLambdaPipe<DX, DY, DO> extends MlCustomPipe<DX, DY, DO> type key 'LMDA' {

  /**
   * The function used for processing.
   */
  _lambda: private !lambda(x: !DX, spec: MlConvertSpec): DO

  /**
   * Creates an {@link MlLambdaPipe} from a C3 {@link Lambda}.
   */
  // TODO PLAT-45705 Refactor MlLambdaSpec#fromLambda spec argument
  fromLambda: function(_lambda: !lambda(x: !DX, spec: MlConvertSpec): DO, spec: MlConvertSpec): !MlLambdaPipe py

  @dependency(include='this')
  doProcess: ~ py
}
