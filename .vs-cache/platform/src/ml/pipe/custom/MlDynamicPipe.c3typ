/**
 * An {@link MlDynamicPipe} wraps around a native Python class that itself implements logic to process a machine
 * learning model, and optional logic to train, load, and save the same model. The primary purpose for an
 * {@link MlDynamicPipe} is to prototype and test custom {@link MlPipe}s at a much faster rate than creating custom C3
 * Types that mixin of {@link MlAtomicPipe}. Rather than having to provision a completely new C3 Type for every
 * variation of a native class's internal logic, one can create new instances of an {@link MlDynamicPipe} and easily
 * insert them into an {@link MlPipeline}.
 *
 * To use an {@link MlDynamicPipe}, first develop a native Python class that implements a processing mechanism, and
 * optionally a training, saving, loading, and hyperparameter setting mechanism (see {@link MlDynamicPipe#from_py} for example). This class may
 * also contain a state and an __init__. Then, use {@link MlDynamicPipe#from_py} to create a new dynamic pipe instance
 * which will use the native class implementation for all the pipe's machine learning operations. Finally, use
 * {@link MlDynamicPipe#initialize} to set the __init__ parameters of your custom native class, and/or set the native
 * model to be associated with the dynamic pipe.
 *
 * For a full tutorial on using {@link MlDynamicPipe}, see the 'MlDynamicPipeTutorial.ipynb' IPython notebook.
 *
 * @see MlAtomicPipe
 * @see MlPipeline
 */
type MlDynamicPipe<DX, DY, DO> extends MlCustomPipe<DX, DY, DO> type key 'DYN' {

  /**
   * Set if user provides a `do_train` function.
   */
  isTrainableOverride: private boolean

  /**
   * The url for accessing the saved native class source code
   */
  nativeClassUrl: private Url

  /**
   * Serialized instance of custom, native Python class.
   * Allows for these classes to be stateful.
   */
  nativeInstance: private string

  /**
   * Deserializes {@link MlDynamicPipe#nativeInstance} and calls the specified method with given arguments
   * @param method_name
   *           The name of the method on {@link MlDynamicPipe#nativeInstance} to execute
   * @param args
   *           Method arguments
   * @param kwargs
   *           Method keyword arguments
   * @return map<string, native>
   *           A map containing:
   *           - "out": The (optional) native output from executing `method_name` on
   *             {@link MlDynamicPipe#nativeInstance}
   *           - "nativeInstance": The {@link MlDynamicPipe#nativeInstance} after calling `method_name` on it. If the
   *             instance contains state, the state may have been updated.
   */
  @dependency(include='this')
  callNativeMethod: private inline member function(method_name: !string,
                                                   args: [native],
                                                   kwargs: map<string, native>): map<string, native> py

  /**
   * Initializes a new instance of {@link MlDynamicPipe} with a native model, and initialization parameters.
   *
   * This method is executing inline, meaning
   *
   * @param model
   *           A native model to associate with an instance of a pipe.
   *           Please see {@link MlPipe#convert} for requirements on custom native models defined in a Jupyter notebook.
   * @param args
   *           args parameters of the `__init__` function of the native class.
   * @param kwargs
   *           kwargs parameters of the `__init__` function of the native class.
   * @param spec
   *           Spec for the initialization of the {@link MlDynamicPipe} instance. This is not a spec for the native
   *           Python class.
   * @return A copy of {@link MlDynamicPipe} with a provided model and initialized native class object.
   */
  initialize: private member function(model: native,
                                      args: [any],
                                      kwargs: map<string, any>,
                                      spec: MlConvertSpec): !MlDynamicPipe py

  convert:    ~ py
  saveModel:  ~ py
  loadModel:  ~ py
  doTrain:    ~ py
  doProcess:  ~ py
  afterTrain: ~ py

  /**
   * Add or change the hyperparameters on the {@link #nativeInstance}. In order for hyperparameter support to be
   * enabled on {@link MlDynamicPipe}s, the native Python class must at least have an instance variable
   * `hyperparams`, a native dictionary of strings to hyperparameters, and may optionally contain a member function
   * `with_hyperparams(self, new_hps)`. If the optional function does not exist, the call to {@link #withHyperparams}
   * will automatically update the `hyperparams` instance variable on the {@link nativeInstance}. If both the
   * function and instance variable are present, the function will be invoked directly instead.
   *
   * If implemented, ensure the method signature of `with_hyperparams` matches of that in the example usage below.
   *
   * Example usage:
   * - Only an instance variable `hyperparams`
   * ```py
   * class ExamplePythonClass:
   *     def __init__(self, num_layers):
   *         self.hyperparams = {'num_layers': num_layers}
   *
   *     def do_train(self, model, x, y, spec):
   *          ...
   *
   * dynamic_pipe = c3.MlCustomPipe.from_py(HpVariableClass, class_args=[10])
   * dynamic_pipe = dynamic_pipe.withHyperparams({'num_layers': 20})  # updates self.hyperparams
   * ```
   *
   * - Instance variable and member function `with_hyperparameters`.
   * ```py
   * class ExamplePythonClass:
   *     def __init__(self, num_layers):
   *         self.hyperparams = {'num_layers': num_layers}
   *
   *     def with_hyperparams(self, new_hps):
   *         self.hyperparams.update(new_hps)
   *
   *     def do_train(self, model, x, y, spec):
   *          ...
   *
   * dynamic_pipe = c3.MlCustomPipe.from_py(HpVariableClass, class_args=[10])
   * dynamic_pipe = dynamic_pipe.withHyperparams({'num_layers': 20})  # calls self.with_hyperparams
   * ```
   */
  @dependency(include='this')
  withHyperparams: ~ py

  /**
   * @return this instance's {@link #hyperparamOverrides} Map. This method will not return the native
   * `hyperparams` dictionary on {@link #nativeInstance}.
   */
  @dependency(include='this')
  hyperparams: ~ py

  @dependency(include='this')
  isTrainable: ~ py

  nativeInputFormats: ~ py
}
