/**
 * This native remix allows users to create an {@link MlDynamicPipe} directly from a native Python class.
 */
native py remix type MlDynamicPipe {

  /**
   * @inheritdoc
   *
   * Creates an {@link MlDynamicPipe} from a native Python class. The native Python class should obey the signatures
   * specified in the example below.
   *
   * `__init__` function of the custom class will be executed inline by the `from_py`.
   *
   * Example usage:
   * ```py
   * class MyDynamicPipeClass {
   *   def __init__(self, param1, param2=None):
   *     self.my_params = {'param1': param1, 'param2': param2}
   *
   *   def do_train(self, model, x, y, spec):
   *     # optional, see MlAtomicPipe.doTrain
   *     ...
   *     return trained_model
   *
   *   def do_process(self, model, x, spec):
   *     # required, see MlAtomicPipe.doProcess
   *     ...
   *     return out
   *
   *   def save_model(model_dir, model):
   *     # optional, see MlAtomicPipe.saveModel
   *     ...
   *
   *   def load_model(model_dir):
   *     # optional, see MlAtomicPipe.loadModel
   *     ...
   *     return model
   *
   *   def native_input_formats(self):
   *     # optional, see MlAtomicPipe.nativeInputFormats
   *     ...
   *     return [c3.MlNativeDataFormat.NUMPY]
   *
   * dynamic_pipe = c3.MlDynamicPipe.from_py(py_native=MyDynamicPipeClass,
   *                                         model=native_model,
   *                                         class_args=['param1-value'],
   *                                         class_kwargs={'param2': 'param2-value'})
   * ```
   */
  from_py: ~ py-client
}
