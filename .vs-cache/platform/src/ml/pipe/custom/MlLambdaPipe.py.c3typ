/**
 * This native remix allows users to create an {@link MlLambdaPipe} directly from a Python function.
 */
native py remix type MlLambdaPipe {

  /**
   * @inheritdoc
   *
   * Creates an {@link MlLambdaPipe} from a native python function. The function should obey the order and names of
   * the parameters specified in the example below.
   *
   * Example usage:
   * ```py
   * def argmax(x, spec=None):
   *     import numpy as np
   *     return np.argmax(x.to_numpy(), axis=-1)
   *
   * lambda_pipe = c3.MlLambdaPipe.from_py(py_native=argmax)
   * ```
   */
  from_py: ~ py
}
