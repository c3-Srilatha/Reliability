/**
 * This type represents an {@link MlAtomicPipe} that wraps around a native Python object that itself implements basic
 * atomic pipe functionality. The native Python object must at least implement functionality to process data, optionally
 * using a machine learning model.  For {@link MlDynamicPipe}, a subtype of {@link MlCustomPipe}, the object can
 * implement functionality to train, save, and load a machine learning model.
 *
 *
 * @see MlLambdaPipe
 * @see MlDynamicPipe
 */
abstract type MlCustomPipe<DX, DY, DO> extends MlAtomicPipe<DX, DY, DO> type key 'CUST' {

  /**
   * The {@link Action.Requirement minimal action requirement} in which all user-defined methods for the custom pipe
   * need to run.
   */
  actionRequirement: private string serialized Action.Requirement

  /**
   * Helper function to return the string for the bound type based on the {@link MlConvertSpec#xType},
   * {@link MlConvertSpec#yType}, and {@link MlConvertSpec#outType} defined in the provided spec.
   */
  typeStrFromSpec: private function(spec: MlConvertSpec): !string py

  /**
   * Training requires input data `x` of parametrized Type DX and optionally target data `y` of parametrized Type DY.
   * By default, {@link MlCustomPipe#from_py} will set these parametrized Types to {@link Data}, meaning that `x` and
   * `y` must be array-like and an instance of {@link Data}. To override the default binding, use an
   * {@link MlConvertSpec} and set the `inputType` and `targetType` fields. For example, set `inputType` to
   * {@link MapType#ofStrTo} for scenarios where multiple inputs are required for `x`.
   */
  train: ~ from super

  /**
   * Process requires input data `x` with the same parametrized Type DX from {@link #train} and will output a value of
   * parametrized Type DO. By default, {@link MlCustomPipe#from_py} will set these parametrized Types to {@link Data},
   * meaning that `x` and the return value must be array-like and an instance of {@link Data}. To override the default
   * binding, use an {@link MlConvertSpec} and set the `inputType` and `outType` fields. For example, set `outType`
   * to {@link MapType#ofStrTo} for scenarios where process will return multiple outputs.
   */
  process: ~ from super

  convertNativeToPipeOutputs: ~ py

  /**
   * Prior to converting the `x` input from `DX` to a Python native format, {@link MlCustomPipe}s will invoke
   * {@link MlAtomicPipe#setFeatureIndices} on `x`, or the elements of `x`, such that `subject` and `timestamp` (if
   * present) are always indices on all {@link Data} inputs.
   */
  convertXToNative: ~ py

  /**
   * Prior to converting the `y` input from `DY` to a Python native format, {@link MlCustomPipe}s will invoke
   * {@link MlAtomicPipe#setFeatureIndices} on `y`, or the elements of `y`, such that `subject` and `timestamp` (if
   * present) are always indices on all {@link Data} inputs.
   */
  convertYToNative: ~ py

  trainSync:          ~ py
  processSync:        ~ py
  nativeInputFormats: ~ py
}
