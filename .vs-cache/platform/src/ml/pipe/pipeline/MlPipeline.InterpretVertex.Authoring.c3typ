/**
 * Functional authoring type for {@link MlPipeline.InterpretVertex} that is used for embedding an {@link MlInterpreter}
 * within an {@link MlPipeline}.
 */
type MlPipeline.InterpretVertex.Authoring mixes MlPipeline.Vertex.Authoring<MlPipeline.InterpretVertex> {

  toVertex: ~ py

  /**
   * Reference to the interpreter
   */
  interpreter: private MlInterpreter

  /**
   * {@link MlConvertSpec} used by callable interface of {@link #interpreter}
   */
  convertSpec: private MlConvertSpec

  /**
   * Whether the vertex has nested-input ports for x.
   */
  isXNestedInput: private boolean

  /**
   * Helper constructor for an interpreter authoring vertex
   * @param name
   *           required name for the vertex.
   * @param interpreter
   *           the interpreter for a trained pipe.
   * @param xNames
   *           names of x input ports that the new vertex will have.
   * @param outNames
   *           names of output ports that the new vertex will have.
   * @return constructed interpreter authoring vertex.
   */
  fromInterpreter: function(name: string,
                            interpreter: !MlInterpreter,
                            xNames: [string],
                            outNames: [string],
                            isXNestedInput: boolean,
                            spec: MlConvertSpec): MlPipeline.InterpretVertex.Authoring py
}
