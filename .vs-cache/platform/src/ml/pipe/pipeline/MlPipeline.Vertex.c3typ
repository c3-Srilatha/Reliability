/**
 * A specialized {@link FlowGraph.Vertex} that represents a vertex in a {@link MlPipeline}.
 */
abstract type MlPipeline.Vertex mixes FlowGraph.Vertex {

  /**
   * Name for vertex that is locally unique to the graph. Used for visualization, as well as user access. This should
   * NOT be a UUID.
   */
  name: !~

  /**
   * Names of ports corresponding to x input.
   */
  x: private set<string>

  /**
   * Names of ports corresponding to y input.
   */
  y: private set<string>

  /**
   * Names of ports corresponding to context input.
   */
  context: private set<string>

  /**
   * @return all x input ports on this vertex. The key is the port name.
   */
  xPorts: property(): map<string, FlowGraph.Port> java | js | py

  /**
   * @return all y input ports on this vertex. The key is the port name.
   */
  yPorts: property(): map<string, FlowGraph.Port> java | js | py

  /**
   * @return all context input ports on this vertex. The key is the port name.
   */
  contextPorts: property(): map<string, FlowGraph.Port> java | js | py

  /**
   * Helper function that returns True if the vertex represents a pipe where none of the 'trainOnly', 'processOnly',
   * 'scoreOnly', or 'interpretOnly' flags are set.
   */
  is_callable_pipe: private member function(): !boolean py

  /**
   * Helper function that returns whether the vertex is an {@link MlPipeline.MlPipeline.Input} or
   * {@link MlPipeline.MlPipeline.Ouput}.
   */
  is_io: private member function(): !boolean py

  /**
   * Helper function that returns whether the vertex is a scoring metric.
   */
  is_metric: private member function(): !boolean py

  /**
   * Helper function that returns whether the vertex is an interpreter.
   */
  is_interpreter: private member function(): !boolean py

  autoName: ~ py
}
