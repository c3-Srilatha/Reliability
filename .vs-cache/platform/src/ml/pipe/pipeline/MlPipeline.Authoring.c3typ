/**
 * Helper type to consolidate useful APIs for authoring of {@link MlPipe} and {@link MlPipeline}.
 * Example usage:
 * ```py
 * >>> from sklearn import linear_model
 * >>> lr = c3.MlPipe.convert(linear_model.LinearRegression())
 * >>> mla = c3.MlPipeline.Authoring
 * >>> x = mla.var()
 * >>> y = mla.var()
 * >>> y_pred = lr(x, y)
 * >>> pipeline = mla.pipeline(x={'iris_features': x},
 *                             y={'iris_class': y},
 *                             out={'iris_class_pred': y_pred})
 * ```
 */
type MlPipeline.Authoring mixes FlowGraph.Authoring<MlPipeline.Vertex, MlPipeline<any, any, any, any, any>> {

  vertexAuthoringType: ~
  portAuthoringType:   ~

  /**
   * See {@link MlPipe#convert}
   */
  convert: function(model: !native, spec: MlConvertSpec): !MlPipe py

  /**
   * Instantiates an {@link MlVar}. The MlVar object could be named by using the keys of the `x` and `y`
   *  arguments in {@link #pipeline}.
   * @return an {@link FlowGraph.Port.Authoring}.
   */
  var: function(): !MlVar<MlPipeline.Vertex> py

  /**
   * Sequentially links {@link MlPipe}s in the order given in the input list. When calling `pipeline.train(x,y)`
   * on the output pipeline, only the last pipe will receive the 'y' value.
   *
   * @param pipes
   *    List of {@link MlPipe}s.
   * @param names
   *    List of names that correspond to the pipes. The length of {@link #names} should match the length of
   *    {@link #pipes}
   * @return an {@link MlPipeline} linking the input pipes together serially.
   */
  sequential: function(pipes: [MlPipe], names: [string]): !MlPipeline py

  /**
   * Instantiates an {@link MlPipeline}.
   * @param x
   *           x input(s) to the pipeline.
   * @param y
   *           y input(s) to the pipeline.
   * @param context
   *           context input(s) to the pipeline for scoring.
   * @param out
   *           output(s) of the pipeline.
   * @param scores
   *           score(s) of the pipeline.
   * @param interpretations
   *           interpretable result(s) of the pipeline
   * @param name
   *           optional name to instantiate with.
   * @return an {@link MlPipeline}.
   */
  // TODO PLAT-45404 Fix arg values for MlPipeline.Authoring#pipeline
  pipeline: inline function(x: FlowGraph.Port.Authoring<MlPipeline.Vertex> | [FlowGraph.Port.Authoring<MlPipeline.Vertex>] | map<string, FlowGraph.Port.Authoring<MlPipeline.Vertex>>,
                            y: FlowGraph.Port.Authoring<MlPipeline.Vertex> | [FlowGraph.Port.Authoring<MlPipeline.Vertex>] | map<string, FlowGraph.Port.Authoring<MlPipeline.Vertex>>,
                            context: FlowGraph.Port.Authoring<MlPipeline.Vertex> | [FlowGraph.Port.Authoring<MlPipeline.Vertex>] | map<string, FlowGraph.Port.Authoring<MlPipeline.Vertex>>,
                            out: map<string, FlowGraph.Port.Authoring<MlPipeline.Vertex>>,
                            scores: map<string, FlowGraph.Port.Authoring<MlPipeline.Vertex>>,
                            interpretations: map<string, FlowGraph.Port.Authoring<MlPipeline.Vertex>>,
                            name: string): !MlPipeline py

  /**
   * Generates `*.c3typ` and `*.py` files for the given python class that represents an {@link MlAtomicPipe}
   * implementation. The files should be placed in the application package by the user.
   * This is a convenience for users to implement their own custom pipes.
   * Example usage:
   * ```py
   * class MyPipe {
   *
   *   def save_model(model_dir, model):
   *     # optional, see MlAtomicPipe.saveModel
   *     ...
   *
   *   def load_model(model_dir):
   *     # optional, see MlAtomicPipe.loadModel
   *     ...
   *     return model
   *
   *   def do_train(model, x, y):
   *     # optional, see MlAtomicPipe.doTrain
   *     ...
   *     return trained_model
   *
   *   def do_process(model, x):
   *     # required, see MlAtomicPipe.doProcess
   *     ...
   *     return out
   * }
   *
   * mla = c3.MlPipeline.Authoring
   * mla.generateC3Files(MyPipe, "/path/to/desired/directory/")
   * ```
   * @param implClass
   *           native class, representing implementation of pipe.
   * @param path
   *           client local file path to save the generated files to. If unspecified, then the current working directory will be used.
   */
  generateC3Files: function(implClass: !native, path: string) py-client
}
