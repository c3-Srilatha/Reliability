/**
 * A specialized {@link FlowGraph.Vertex} that represents an interpreter vertex in an {@link MlPipeline}
 */
type MlPipeline.InterpretVertex mixes MlPipeline.Vertex {

  /**
   * Reference to the interpreter
   */
  interpreter: private MlInterpreter

  /**
   * {@link MlConvertSpec} used by callable interface of {@link #interpreter}
   */
  convertSpec: private MlConvertSpec

  /**
   * Whether the vertex has nested-input ports for x.
   */
  isXNestedInput: private boolean

  /**
   * Helper constructor for this vertex type
   * @param name
   *           required name for the vertex.
   * @param interpreter
   *           interpreter for a trained pipe.
   * @param xNames
   *           names of x input ports that the new vertex will have.
   * @param outNames
   *           names of output ports that the new vertex will have.
   * @return constructed interpreter vertex.
   */
  fromInterpreter: function(name: string,
                            interpreter: !MlInterpreter,
                            xNames: [string],
                            outNames: [string],
                            isXNestedInput: boolean,
                            spec: MlConvertSpec): MlPipeline.InterpretVertex py
}
