/**
 * A specialized {@link FlowGraph.Vertex} that represents a pipe vertex in an {@link MlPipeline}.
 */
type MlPipeline.PipeVertex mixes MlPipeline.Vertex {

  /**
   * If true, then the pipe should only be used to process, instead of the default train-then-process.
   * Only one of this, {@link #trainOnly}, {@link #scoreOnly}, and {@link #interpretOnly} should be set at a time.
   */
  processOnly: private boolean

  /**
   * If true, then the pipe should only be used to train, instead of the default train-then-process.
   * Only one of this, @link #processOnly}, {@link #scoreOnly}, and {@link #interpretOnly} should be set at a time.
   */
  trainOnly: private boolean

  /**
   * If true, then the pipe should only be used to score. Only one of this, {@link #processOnly}, and {@link #trainOnly},
   *  and {@link #interpretOnly} should be set at a time.
   */
  scoreOnly: private boolean

  /**
   * If true, then the pipe should only be used to interpret. Only one of this, {@link #processOnly}, {@link #trainOnly},
   * and {@link #scoreOnly} should be set at a time.
   */
  interpretOnly: private boolean

  /**
   * {@link MlConvertSpec} used by shared {@link #pipe} in {@link #processOnly} vertices
   */
  convertSpec: private MlConvertSpec

  /**
   * Reference to machine learning pipe.
   */
  pipe: private MlPipe

  /**
   * Whether the vertex has nested-input ports for x.
   */
  isXNestedInput: private boolean

  /**
   * Whether the vertex has nested-input ports for y.
   */
  isYNestedInput: private boolean

  /**
   * Whether the vertex has nested-output ports.
   */
  isNestedOutput: private boolean

  /**
   * Helper constructor for a vertex.
   * @param name
   *           required name for the vertex.
   * @param pipe
   *           machine learning model.
   * @param xNames
   *           names of x input ports that the new vertex will have.
   * @param yNames
   *           names of y input ports that the new vertex will have.
   * @param outNames
   *           names of output ports that the new vertex will have.
   * @param isXNestedInput
   *           Whether the vertex has nested input port(s) for x.
   * @param isYNestedInput
   *           Whether the vertex has nested input port(s) for y.
   * @param isNestedOutput
   *           Whether the vertex has nested output port(s).
   * @return constructed vertex.
   */
  fromPipe: function(name: string,
                     pipe: MlPipe,
                     xNames: [string],
                     yNames: [string],
                     contextNames: [string],
                     outNames: [string],
                     isXNestedInput: boolean,
                     isYNestedInput: boolean,
                     isNestedOutput: boolean,
                     spec: MlConvertSpec): MlPipeline.PipeVertex py
}
