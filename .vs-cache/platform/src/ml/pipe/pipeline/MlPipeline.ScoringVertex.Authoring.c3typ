/**
 * Functional authoring type for {@link MlPipeline.ScoringVertex} that is used for embedding an {@link MlScoringMetric} within
 * an {@link MlPipeline}.
 */
type MlPipeline.ScoringVertex.Authoring mixes MlPipeline.Vertex.Authoring<MlPipeline.ScoringVertex> {

  toVertex: ~ py

  /**
   * Reference to the metric to use for scoring.
   */
  scoringMetric: private MlScoringMetric

  /**
   * Whether the vertex has nested-input ports for x.
   */
  isXNestedInput: private boolean

  /**
   * Whether the vertex has nested-input ports for y.
   */
  isYNestedInput: private boolean

  /**
   * Helper constructor for an authoring vertex.
   * @param name
   *           required name for the vertex.
   * @param scoringMetric
   *           metric used for scoring.
   * @param xNames
   *           names of x input ports that the new vertex will have.
   * @param yNames
   *           names of y input ports that the new vertex will have.
   * @param contextNames
   *           names of context input ports that the new vertex will have.
   * @param outNames
   *           names of output ports that the new vertex will have.
   * @param isXNestedInput
   *           Whether the vertex has nested input port(s) for x.
   * @param isYNestedInput
   *           Whether the vertex has nested input port(s) for y.
   * @return constructed vertex.
   */
  fromScoringMetric: function(name: string,
                              scoringMetric: MlScoringMetric,
                              xNames: [string],
                              yNames: [string],
                              contextNames: [string],
                              outNames: [string],
                              isXNestedInput: boolean,
                              isYNestedInput: boolean): MlPipeline.ScoringVertex.Authoring py
}
