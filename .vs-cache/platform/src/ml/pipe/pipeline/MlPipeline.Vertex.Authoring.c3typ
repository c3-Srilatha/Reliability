/**
 * Functional authoring type for {@link MlPipeline.Vertex}. For example usage, see {@link MlPipeline.Authoring}.
 */
abstract type MlPipeline.Vertex.Authoring<V: MlPipeline.Vertex> mixes FlowGraph.Vertex.Authoring<V> {

  portAuthoringType: ~

  /**
   * Names of ports corresponding to x input.
   */
  x: private set<string>

  /**
   * Names of ports corresponding to y input.
   */
  y: private set<string>

  /**
   * Names of ports corresponding to context input.
   */
  context: private set<string>
}
