/**
 * This executor takes the {@link Workflow}s' intermediate representation, parses it, and {@link #execute}s it
 * in a synchronous manner, relative to the caller of the {@link Workflow} execution.
 *
 * Currently, synchronous execution does not respect the action vertices {@link Workflow.Action#requirementOverride}
 * field when executing {@link Workflow.Action}
 */
abstract type SynchronousPyExecutor {

  /**
   * @param repr
   *           representation for the execution.
   * @param inputs
   *           inputs for the execution, <k, v> -> <input name, input value>.
   * @param spec
   *           optional execution hints.
   * @return an execution instance that can be used to query results and state.
   */
  execute: function(repr: WorkflowExecutionRepresentation,
                    inputs: !map<string, any>,
                    spec: WorkflowExecutionSpec): SimpleSynchronousPyRun py

  /**
   * Helper function for execution that is specific to an executor. Called by {@link #execute} and {@link #executeOnServer}
   * @param repr
   *           representation for the execution.
   * @param inputs
   *           inputs for the execution, <k, v> -> <input name, input value>.
   * @param spec
   *           optional execution hints.
   * @return an execution instance that can be used to query results and state.
   */
  _execute: private abstract function(repr: WorkflowExecutionRepresentation,
                                      inputs: !map<string, any>,
                                      spec: WorkflowExecutionSpec): SimpleSynchronousPyRun py

  /**
   * Executes the {@link WorkflowExecutionRepresentation} on the server.
   */
  executeOnServer: private function(repr: WorkflowExecutionRepresentation,
                                    inputs: !map<string, any>,
                                    spec: WorkflowExecutionSpec): SimpleSynchronousPyRun py-server

  /**
   * Helper function to group all the inputs based on {@link Workflow.Make#targetType}. This should be called by the executor of the
   * parent {@link Workflow}.
   * @param vertex
   *           {@link Workflow.Make} vertex to execute.
   * @param inputs
   *           key is the name of the input, value is the data for that input.
   * @return a made {@link Obj} or {@link Map}, depending on {@link #makeType}.
   */
  executeMake: private inline function(vertex: !Workflow.Make, inputs: !map<string, any>): Obj | map<string, any> py

  /**
   * Helper function to split the input based on {@link Workflow.Field#inputType}. This should be called by the executor of the
   * parent {@link Workflow}.
   * @param vertex
   *           {@link Workflow.Field} vertex to execute.
   * @param input
   *           the input to the vertex.
   * @return a map with keys corresponding to the outputs of the specified vertex and values corresponding to the accessed
   *           field/values in the provided input.
   */
  executeField: private inline function(vertex: !Workflow.Field, input: any): map<string, any> py

  /**
   * Helper function to execute a single {@link Workflow.Action}. This should be called by {@link SynchronousPyExecutor#_execute}.
   * @param vertex
   *           {@link Workflow.Action} vertex to execute.
   * @param inputs
   *           the inputs to the vertex.
   * @param exec_metadata
   *           metadata map that maps vertex id to action logs
   * @return a map mapping port name to results for the specific vertex
   */
  _execute_vertex: private inline function(vertex: !Workflow.Vertex,
                                           inputs: !map<string, any>,
                                           exec_metadata: !map<string, any>): map<string, any> py

  /**
   * Helper function to get result from previous {@link FlowGraph.Port}
   * @param port
   *          {@link FlowGraph.Port} to get previous results from
   * @param workflow
   *          the current workflow we are executing
   * @param prev_port_cache
   *          map of port name to previous ports, used to do search only once.
   * @return (whether result was found, result)
   */
  _prev_result_for: private inline function(port: !FlowGraph.Port,
                                            workflow: !Workflow,
                                            results: !map<string, any>,
                                            prev_port_cache: !map<string, string>): map<string, any> py

  /**
   * Helper function that iterates over a {@link Workflow.Vertex} and calls {@link SynchronousPyExecutor#_prev_port_for for all of its
   * input {@link FlowGraph.Port}s.
   * @return a map mapping port name to results for the specific vertex's input ports
   */
  _results_for_input: private inline function(vertex: !Workflow.Vertex,
                                              workflow: !Workflow,
                                              results: !map<string, any>,
                                              prev_port_cache: !map<string, string>): map<string, any> py

  /**
   * Helper function to execute a {@link workflow#finallyVertex}.
   */
  _execute_finally_vertex: private inline function(workflow: !Workflow,
                                                   results: !map<string, any>,
                                                   inputs: !map<string, any>,
                                                   run: !SimpleSynchronousPyRun,
                                                   exec_metadata: !map<string, any>): SimpleSynchronousPyRun py

  /**
   * Helper function to choose which synchronous executor to execute with
   */
  _execute_workflow: private inline function(workflow: !Workflow,
                                             inputs: !map<string, any>,
                                             innerWorkflowExecutor: !string): SimpleSynchronousPyRun py
}
