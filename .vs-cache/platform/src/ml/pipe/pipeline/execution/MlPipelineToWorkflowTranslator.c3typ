/**
 * This Type is used to translate an {@link MlPipeline} to a {@link Workflow} intermediate representation.
 * The translation separates the authoring from the execution of `MlPipeline`s.
 *
 * End users should NOT need to use this Type.  This Type is part of the internal execution engine of an `MlPipeline`.
 */
private type MlPipelineToWorkflowTranslator mixes Singleton {

  /**
   * Translates an {@link MlPipeline} object and the desired operation to perform on the {@link MlPipeline} (e.g.
   * `train`, `process`) to an unoptimized, abstract, intermediate representation of the plan of
   * execution.  Internal {@link MlPipeline.Vertex} objects will be translated to their respective {@link Workflow.Vertex}
   * counterparts, but nested `MlPipeline` objects will be "flattened" to their atomic
   * `MlPipeline.Vertex`s before translation. An interface of type {@link MlPipelineToWorkflowTranslator} will also
   * be created to keep track of the relationship between the input {@link MlPipeline}, the output {@link Workflow}
   * and the mapping of their respective vertices.
   * @param pipeline
   *           pipeline to transform into an `Workflow`.
   * @param opName
   *           list of names of the data consuming or data producing method on the `MlPipeline` being executed.
   * @param operationSpec
   *           {@link MlOperationSpec} used for execution of {@link MlPipeline}.
   * @param dataToExcludeFromCleanup
   *           list of {@link Data#toJsonString} to exclude from the clean up in the finallyVertex for this Workflow.
   *           See {@link #cleanup}.
   * @return the intermediate representation of the plan of execution.
   */
  createWorkflow: function(pipeline: !MlPipeline,
                           opName: ![MlDataOpName],
                           operationSpec: MlOperationSpec,
                           dataToExcludeFromCleanup: [string]): Workflow py

  /*
   * Clean up {@link Data} instances that are not returned as the outputs of the workflow.
   * @param run
   *           The {@link WorkflowExecutorRun} which provides the intermediate and output results.
   * @param dataToExclude
   *           A list of {@link Data#toJsonString} to exclude from clean up. For example, this can be used to
   *           prevent cleanup of Data that was persisted by the user prior to invoking ML operation.
   * @param excludeInputs
   *           If set, then all inputs to the workflow will be excluded from cleanup.
   * @return number of {@link Data} instance that were cleaned up
   */
  cleanup: function(run: !WorkflowExecutorRun, dataToExclude: [string], excludeInputs: boolean): int py
}
