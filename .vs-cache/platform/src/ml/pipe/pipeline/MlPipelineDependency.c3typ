/**
 * Represent a pipe in an MlPipeline dependency graph and name of the pipes or input data that this pipe is dependent on
 * An MlPipelineDependency should not exist independently of an MlPipeline,
 * @see {MlPipeline#dependencyGraph}
 */
type MlPipelineDependency {

  pipe: MlPipe

  /**
   * The name of pipes that the current pipe is dependent on or the name of input to the pipeline
   */
  xDep: string

  xDepOutputIdx: int

  /**
   * The name of pipes that the current pipe is dependent on or the name of input to the pipeline
   */
  yDep: string

  yDepOutputIdx: int
}
