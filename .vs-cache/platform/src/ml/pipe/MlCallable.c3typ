/**
 * Abstract type containing common helper functions for components that can be composed within an {@link MlPipeline}.
 */
abstract type MlCallable mixes CallableProtocol {

  /**
   * Extracts the inputs and standardizes them into a dict.
   */
  // TODO PLAT-45376 Remove inline claim
  standardizeInput: private inline member function(args: [any], kwargs: map<string, any>): map<string, any> py
}
