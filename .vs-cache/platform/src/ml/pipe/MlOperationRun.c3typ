/**
 * A future-like interface that holds the execution status details of an Ml Operation (e.g. train) and retrieves the end result.
 */
@db(systemType=true)
entity type MlOperationRun<V> mixes AsyncJobRun<V, Workflow.Status>, Workflow.Monitorable schema name 'MLPIPE_RUN' {

  /**
   * pipe that the operation was called on.
   */
  @db(persistAllFields=true)
  mlPipe: private MlPipe

  /**
   * run representing the ongoing {@link Workflow} execution.
   */
  run: private WorkflowExecutorRun

  /**
   * Additional context related to the run. For example {@link VllmPipe#process} stores the request ids generated by
   * the native vllm library in the key defined by {@VllmPipe#runContextKey}.
   */
  runContext: private map<string, any>

  /**
   * Map of {@link MlLogger}s for {@link MlPipeline} and {@link MlModel} operations
   * Same as {@link MlOperationSpec#loggers} for the operation run.
   */
  // TODO: PLAT-90845 Update loggers field in MlOperationSpec and MlOperationRun to be of type map<string, MlLogger>
  loggers: private map<string, any>

  /**
   * reference to the train job run object that tracks the in-progress train job.
   * Populated iff the operation is an {@link MlDataOpName#TEMPLATE_TRAIN}.
   */
  // TODO: PLAT-63211, this field is only used for the MlDataOpName.TEMPLATE_TRAIN operation
  trainJobRun: MlModel.Train.JobRun

  /**
   * name of the operation
   */
  // TODO: PLAT-40996 Refactor MlPipelineToWorkflowTranslator to eliminate need for caller post-processing
  opName: private [MlDataOpName]

  /**
   * Blocking call to return result of operation
   * @param timeoutMinutes
   *          Maximum time to wait for operation to complete, in minutes.
   *          Either {@link WaitSpec#maxTotalMillis} in {@link #spec} or {@link #timeoutMinutes} will specify the maximum wait time, but {@link #timeoutMinutes}
   *          will take precedence over {@link WaitSpec#maxTotalMillis}.
   * @param displayStatus
   *         If True, display current status periodically while waiting for completion of {@link #run}
   * @param spec
   *         {@link WaitSpec} for customization of sleep time between polling status of {@link #run}
   *
   * @return result of operation
   */
  result: member function(timeoutMinutes: int, displayStatus: boolean = False, spec: WaitSpec): !V py

  /**
   * Waits for the {@link #run} and finally vertex associated with {@link #run} to be completed.
   * @param timeoutMinutes
   *          Maximum time to wait for operation to complete, in minutes.
   *          Either {@link WaitSpec#maxTotalMillis} in {@link #spec} or {@link #timeoutMinutes} will specify the maximum wait time, but {@link #timeoutMinutes}
   *          will take precedence over {@link WaitSpec#maxTotalMillis}.
   * @param displayStatus
   *     If True, display current status periodically while waiting for completion of {@link #run}
   * @param spec
   *         {@link WaitSpec} for customization of sleep time between polling status of {@link #run}
   *
   * @returns the status for the {@link WorkflowExecutorRun} associated with finally vertex after completion.
   */
  waitForFinallyCompletion: private member function(timeoutMinutes: int,
                                                    displayStatus: boolean = False,
                                                    spec: WaitSpec): !Workflow.Status py

  /**
   * Waits for the {@link #run} to be completed.
   * @param timeoutMinutes
   *          maximum time to wait for operation to complete, in minutes.
   *          Either {@link WaitSpec#maxTotalMillis} in {@link #spec} or {@link #timeoutMinutes} will specify the maximum wait time, but {@link #timeoutMinutes}
   *          will take precedence over {@link WaitSpec#maxTotalMillis}. However, the timeoutMinutes can be only given in integer minutes which limit the lower-bound
   *          to 60 seconds, while specifying with {@link #spec} uses millis unit.
   * @param displayStatus
   *          If True, display current status periodically while waiting for completion of {@link #run}
   * @param spec
   *         {@link WaitSpec} for customization of sleep time between polling status of {@link #run}
   *
   * @return the status for the {@link #run} after completion
   */
  waitForCompletion: private member function(timeoutMinutes: int,
                                             displayStatus: boolean = False,
                                             spec: WaitSpec): !Workflow.Status py

  /**
   * Assemble a pipeline with artifacts from {@link MlDataOpName#TRAIN} operation.
   * @param pipeline
   *          Input {@link MlPipeline} to be assembled
   * @param execRun
   *          {@link #run} associated with the {@link MlDataOpName#TRAIN} operation
   * @param executionResults
   *          {@link WorkflowExecutorRun#executionResults} associated with the {@link MlDataOpName#TRAIN} operation
   *
   * @return the assembled {@link MlPipeline} with vertices updated with artifacts from {@link MlDataOpName#TRAIN}
   */
  assembleTrainedPipeline: private function(pipeline: !MlPipeline,
                                            execRun: !WorkflowExecutorRun,
                                            executionResults: !map<string, any>): !MlPipeline py

  /**
   * Attempts to cancel a running {@link MlOperationRun#run}.
   */
  cancel: member function(): Workflow.Status py

  /**
   * NOTE: This method currently raises a C3 NotImplemented error.
   *
   * @inheritdoc
   */
  // TODO: PLAT-72215 Implement this method, not throw an error
  @beta
  promise: ~ py

  status:               ~ py
  visualize:            ~ py
  summary:              ~ py-data_312 | py-data
  flamegraph:           ~ py
  flamegraphJson:       ~ py-server
  errors:               ~
  magnify:              ~
  summaryAsFetchResult: ~ py-server
  summaryCount:         ~ py-server
}
