/**
 * This type represents an object that is scorable for machine learning purposes.
 *
 * Parametrization:
 * DX - type for "x" input data to the model for scoring
 * DY - type for "y" targets for scoring
 *
 * Related Types:
 *   {@link MlOperationSpec}
 */
abstract type MlScorable<DX, DY, DS> {

  /**
   * Score the input data. This API is asynchronous non-blocking.
   *
   * @param x
   *           Data to use as input to the model for scoring.
   * @param y
   *           Data to use as "y" or "label" to use as ground truth for scoring.
   * @param context
   *           Additional contextual data to use for scoring.
   * @param spec
   *           Customizations for execution.
   * @return a {@link MlOperationRun} object that represents the launched scoring. The caller should use the APIs on
   *           the operation run object to query status and to get the final result.
   */
  score: abstract member function(x: !?DX,
                                  y: DY,
                                  context: DS,
                                  spec: MlOperationSpec): MlOperationRun<map<string, double>>

  /**
   * Blocking, synchronous version of {@link #score}.
   */
  scoreSync: private abstract member function(x: !?DX, y: DY, context: DS, spec: MlOperationSpec): map<string, double>

  /**
   * Score the input data for all pipes including intermediate pipes. This API is asynchronous, non-blocking.
   *
   * @param x
   *           Data to use as input to the model for scoring.
   * @param y
   *           Data to use as "y" or "label" to use as ground truth for scoring.
   * @param context
   *           Additional contextual data to use for scoring.
   * @param spec
   *           Customizations for execution.
   * @return a {@link MlOperationRun} object that represents the launched scoring. The caller should use the APIs on
   *           the operation run object to query status and to get the final result.
   */
  scoreAll: abstract member function(x: !?DX,
                                     y: DY,
                                     context: DS,
                                     spec: MlOperationSpec): MlOperationRun<map<string, double>>

  /**
   * Blocking, synchronous version of {@link #scoreAll}.
   */
  scoreAllSync: private abstract member function(x: !?DX,
                                                 y: DY,
                                                 context: DS,
                                                 spec: MlOperationSpec): map<string, double>
}
