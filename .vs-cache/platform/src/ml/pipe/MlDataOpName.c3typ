/**
 * The name of a data consuming or data producing method on {@link MlPipeline}.  This is used internally by the
 * MlPipeline execution engine.
 */
private enum type MlDataOpName {

  TRAIN = 'train'

  PROCESS = 'process'

  SCORE = 'score'

  SCORE_ALL = 'scoreAll'

  INTERPRET = 'interpret'

  SEARCH = 'search'

  SEARCH_TRAIN = 'searchTrain'

  TEMPLATE_TRAIN = 'templateTrain'

  MODEL_MONITOR = 'modelMonitor'

  PROCESS_JOB = 'processJob'

  INTERPRET_JOB = 'interpretJob'

  ROUTE_JOB = 'routeJob'

  MODEL_EVALUATION = 'modelEvaluation'

  ASYNC_PROCESS = 'asyncProcess'

  COMPOSITE_OP = 'compositeOp'

  ML_JOB = 'mlJob'

  TRAIN_IDENTITY = 'trainIdentity'
}
