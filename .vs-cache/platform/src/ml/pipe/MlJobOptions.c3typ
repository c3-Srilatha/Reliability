/**
 * Customizations for {@link MlWorkflowCoordinatable} execution.
 */
type MlJobOptions mixes JobOptions {

  /**
   * Upper bound on total number {@link MlWorkflowCoordinatableResult}s to execute in parallel.
   */
  maxConcurrency: int = 8

  /**
   * Maximum time allocated for execution of {@link MlWorkflowCoordinatable}
   */
  jobTimeoutMinutes: int

  /**
   * This feature is not supported for MlJobOptions
   */
  priority: ~

  /**
   * This feature is not supported for MlJobOptions
   */
  disabled: ~

  /**
   * This feature is not supported for MlJobOptions
   */
  maxConcurrencyPerNode: ~

  /**
   * This feature is not supported for MlJobOptions
   */
  runAsUser: ~

  /**
   * This feature is not supported for MlJobOptions
   */
  nodePool: ~

  /**
   * This feature is not supported for MlJobOptions
   */
  skipIfRunning: ~

  /**
   * Flag to indicate if {@link MlWorkflowCoordinatable#recover} should recover canceled results along with errored results.
   */
  doNotRecoverCanceled: boolean

  /**
   * ML jobs based on {@link MlWorkflowCoordinatable} do not support downstream use of all fields in {@link MlJobOptions} during execution.
   * This method validates and throws an error if any of unsupported fields are set.
   */
  validate: member function() java

  /**
   * Provides a set of fields in {@link MlJobOptions} supported in the execution of all ML jobs based on {@link MlWorkflowCoordinatable}.
   *
   * @returns a set of supported fields in {@link MlJobOptions}.
   */
  supportedFields: private member function(): !set<string> java
}
