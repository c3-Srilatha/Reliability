/**
 * Customizations for {@link MlCustomMetric}.
 */
type MlScoringMetricSpec mixes Spec {

  /**
   * True if a {@link MlCustomMetric} needs to be higher to be better.
   */
  higherIsNotBetter: boolean

  /**
   * True if a {@link MlCustomMetric} does not use `targetOutput` when calling {@link #doScore}.
   */
  noTarget: boolean

  /**
   * List of valid context names that a {@link MlCustomMetric} supports.
   */
  contextNames: [string]

  /**
   * List of valid target output names for multi-input custom metric.
   */
  targetOutputNames: [string]

  /**
   * List of valid model output names for multi-input custom metric.
   */
  modelOutputNames: [string]
}
