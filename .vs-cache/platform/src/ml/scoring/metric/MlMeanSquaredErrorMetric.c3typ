/**
 * The {@link MlMeanSquaredErrorMetric} computes the average squared error between the predicted value and target value.
 * The `modelOutput` and `targetOutput` are expected to have the same shape.
 * This metric supports `sampleWeights` as `context`. `sampleWeights` is single-dimensional with same number of samples
 * as the `modelOutput`. It represents a per-sample weighting when aggregating for MSE calculation.
 */
type MlMeanSquaredErrorMetric mixes MlScoringMetricSupportingPd<Data, Data, { sampleWeights: Data }> {

  doScore:        ~ py
  noTarget:       ~ py
  contextNames:   ~ py
  higherIsBetter: ~ py
  scoreFunction:  ~ py
}
