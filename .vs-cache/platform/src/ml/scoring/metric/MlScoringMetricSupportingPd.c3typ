/**
 * Enables RDCE for scoring metrics whose {@link MlScoringMetric#doScore} accepts Pandas objects as input.
 */
abstract type MlScoringMetricSupportingPd<DO, DY, DS> mixes MlScoringMetric<DO, DY, DS> {

  convertTargetOutputToNative:       ~ py
  convertModelOutputToNative:        ~ py
  convertContextToNative:            ~ py
  convertTargetOutputNativeToNative: ~ py
  convertModelOutputNativeToNative:  ~ py
  convertContextNativeToNative:      ~ py
  nativeInputFormats:                ~ py

  /**
   * Helper function to convert context to native and extract the sample weights. Note, this will only work if DS is a
   * {@link Tuple} containing the `sampleWeights` key.
   */
  sampleWeightsPd: private inline member function(context: DS): !native py
}
