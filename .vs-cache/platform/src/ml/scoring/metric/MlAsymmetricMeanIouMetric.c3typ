/**
 * {@link MlAsymmetricMeanIouMetric} computes the Intersection Over Union between two lists of {@link BoundingBox}.
 * It does not make any assumption on the cardinality and ordinality of the lists.
 * Instead, a best effort box to box matching algorithm (quadratic time complexity) is implemented.
 */
@beta
type MlAsymmetricMeanIouMetric mixes MlMeanIouMetric {

  /**
   * Whether to consider the class of the box AND its coordinates or just the coordinates.
   */
  enforceSameDetectedClass: boolean

  /**
   * Whether or not to account for extra unmatched boxes in the IOU score.
   */
  penalizeExtraBoxes: boolean

  doScore: ~ py
}
