/**
 * A {@link MlCustomMetric} wraps a native stateless function to allow for custom scoring.
 * @see {@link MlScoringMetric}
 */
type MlCustomMetric<DO, DY, DS> mixes MlScoringMetric<DO, DY, DS> {

  /**
   * The function used for scoring.
   */
  _lambda: private !lambda(targetOutput: DY, modelOutput: DO, context: DS): !double

  /**
   * The {@link Action.Requirement} in which all user-defined methods for the custom metric has to run
   * need to run.
   */
  actionRequirement: private string serialized Action.Requirement

  /**
   * {@link MlScoringMetricSpec} for customization of this score.
   */
  spec: !MlScoringMetricSpec

  doScore:        ~ py
  noTarget:       ~ py
  contextNames:   ~ py
  higherIsBetter: ~ py
}
