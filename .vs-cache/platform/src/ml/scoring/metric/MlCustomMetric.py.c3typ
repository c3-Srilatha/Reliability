native py remix type MlCustomMetric {

  /**
   * Create an instance of {@link MlCustomMetric} from user provided lambda.
   * The inputs to this {@link MlCustomMetric} are {@link Data} or tuple of {@link Data} for multi-input score.
   * Authors of custom metrics should ensure that the inputs to the user-defined function are properly converted from {@link Data} to
   * required format if needed as shown in the example below.
   * Example Usage:
   * ```py
   * def custom_score(targetOutput=None, modelOutput=None, context=None):
   *    # Multi-input will be input as Named Tuple of Data - names of `targetOutput` and `modelOutput` for multi-input score
   *    # is specified in `c3.MlScoringMetricSpec`.
   *    target_output_sales = targetOutput.t1.to_pandas()
   *    model_output_sales = modelOutput.m1.to_pandas()
   *    target_output_revenue = targetOutput.t2.to_pandas()
   *    model_output_revenue = modelOutput.m2.to_pandas()
   *    assert len(target_output_sales) == len(model_output_sales), "sales has different lengths"
   *    assert len(target_output_revenue) == len(model_output_revenue), "revenue has different lengths"
   *    assert len(target_output_sales) == len(target_output_revenue), "sales and revenue have different lengths"
   *
   *    diff_of_pred1 = target_output_sales - model_output_sales.sum()
   *    diff_of_pred2 = target_output_revenue - model_output_revenue.sum()
   *    return (diff_of_pred1 + diff_of_pred2)/len(target_output_sales)
   *
   * custom_metric = c3.MlCustomMetric.fromPyFunc(py_func=custom_score,
   *                                              spec=c3.MlScoringMetricSpec(targetOutputNames=["t1", t2"],
   *                                                                           modelOutputNames=["m1", m2"]))
   * ```
   * @param func
   *    A function that returns a double representing the scoring metric. targetOutput and modelOutput are {@link Map}.
   *    keys are prediction names in {@link MlModel#MlPipeline#outNames},
   *    values are {@link Data} for targetOutput, modelOutput or context.
   * @param spec
   *    A {@link MlScoringMetricSpec} for customization.
   */
  fromPyFunc: function(py_func: native,
                       actionRequirement: string serialized Action.Requirement,
                       spec: MlScoringMetricSpec): MlCustomMetric py
}
