/**
 * A mixin for refactoring common code used by various clustering scoring metrics backed by an Sklearn implementation,
 * to stay DRY.
 *
 * This type is not user facing (implementation details) and should not be used outside of platform code.
 * I.e. this type will not be backward-compatible between server releases, and may even be renamed or removed
 * completely.
 */
@beta
private type SklearnClusterScoreMixin {

  /**
   * Method holding common code for validating inputs and invoking sklearn implementation for scoring.
   * Only meant for use by platform code.  This method signature is subject to change without notice between server
   * releases.
   */
  doScoreHelper: private inline function(scoringMetric: !MlScoringMetric<Data, Data, { modelInput: Data }>,
                                         sklearnMetricName: !string,
                                         modelOutput: Data,
                                         context: { modelInput: Data }): !double py
}
