/**
 * Enumeration of normalization options for {@link MLRootMeanSquaredErrorMetric RMSE scoring metric}.
 */
enum type MlRootMeanSquaredErrorMetric.Normalization {

  /**
   * Normalization by the mean of the target variable.
   */
  MEAN = "mean"

  /**
   * Normalization by the range (difference between maximum and minimum) of the target variable.
   */
  RANGE = "range"

  /**
   * Normalization by the standard deviation of the target variable.
   */
  STD = "std"
}
