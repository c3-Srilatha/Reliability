/**
 * The {@link MlPrecisionMetric} computes the proportion of positive prediction values that are correct. Expressed
 * as a formula:
 * ```
 * precision = true_positives / (true_positives + false_positives)
 * ```
 * This metric only works for binary classification. If there are no true positive and false positive predictions,
 * this metric returns 0. The `modelOutput` can either be a single-dimensional with binary (i.e. 0 and 1) data
 * or two-dimensional with predicted probabilities for class '0' and '1'. Column '1' will be used for scoring.
 * The `targetOutput` is expected to be single-dimensional with binary (i.e. 0 and 1) data.
 * This metric supports `sampleWeights` as `context`. `sampleWeights` is single-dimensional
 * with same number of samples as the `modelOutput`.
 * It represents a per-sample weighting when aggregating for Precision calculation.
 */
@beta
type MlPrecisionMetric mixes MlScoringMetricSupportingPd<Data, Data, { sampleWeights: Data }> {

  /**
   * `probaThreshold` is a `double` value used to convert the predicted probabilities to class
   * labels for Precision Score calculation. `probaThreshold` defaults to 0.5 if no value is provided with the predicted
   * probabilities as input
   */
  probaThreshold: double = 0.5

  doScore:        ~ py
  noTarget:       ~ py
  contextNames:   ~ py
  higherIsBetter: ~ py
  scoreFunction:  ~ py
}
