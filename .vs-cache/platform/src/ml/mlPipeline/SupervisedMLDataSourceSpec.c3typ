/**
 * The base type for all data source specs for supervised training of MLPipelines and MLPipelineTrainingJobs.
 * The parametric bindings `DI` and `DO` refer to the pipeline training input and target types respectively (see
 * {@link MLPipe}.
 */
@beta
abstract extendable entity type SupervisedMLDataSourceSpec<DI, DO> extends MLDataSourceSpec<DI> type key 'SUP' {

  /**
   * Identifier for the target to learn
   */
  target: string

  /**
   * Retrieves data for the sourceIds specified according to the rest of the spec.
   */
  getInputDataForSources: abstract ~

  /**
   * Retrieves target data for the sourceIds specified according to the rest of the spec.
   */
  getTargetDataForSources: abstract member function(srcIds: !set<string>): !DO

  /**
   * Retrieves both input and target data for the sourceIds specified according to the rest of the spec.
   */
  getInputAndTargetDataForSources: member function(srcIds: !set<string>): !Pair<DI, DO>

  /**
   * Retrieves data for the sourceIds specified according to the rest of the spec.
   * Returned as a map of {{ value of groupingField }} -> data for source objects with that value.
   */
  getGroupedInputDataForSources: abstract ~

  /**
   * Retrieves both input and target data for the sourceIds specified according to the rest of the spec.
   * Returned as a map of {{ value of groupingField }} -> data for source objects with that value.
   */
  getGroupedInputAndTargetDataForSources: abstract member function(srcIds: !set<string>,
                                                                   groupingField: !string): !map<string, Pair<DI, DO>>

  /**
   * Function that combines an arry of the produced data type into a single object.
   */
  combineInputDataObjects: abstract ~

  /**
   * Function that combines an arry of the target data type into a single object.
   * Used to do map/reduce.
   */
  combineTargetDataObjects: abstract member function(dataObjs: ![DO]): !DO

  /**
   * Function that combines an arry of the input and target data pairs into a single object.
   * Used to do map/reduce.
   */
  combineInputAndTargetDataObjects: member function(dataObjs: ![Pair<DI, DO>]): !Pair<DI, DO>

  persistData:             abstract ~
  getPersistedInputData:   abstract ~
  isForSupervisedTraining: ~

  /**
   * Abstract function (to be implemented by classes that extend SupervisedMLDataSourceSpec) to persist
   * input and target data.
   * @param data
   *          The data to persist
   * @param group
   *          The group, if any, associated with this dataset. See {@link MLTrainingJob#group}.
   */
  persistInputAndTargetData: abstract member function(data: !Pair<DI, DO>, group: string)

  /**
   * Gets the data persisted for this spec.
   *
   * @return The persisted data for this spec. Null if no data has been persisted.
   */
  getPersistedInputAndTargetData: abstract member function(): Pair<DI, DO>
}
