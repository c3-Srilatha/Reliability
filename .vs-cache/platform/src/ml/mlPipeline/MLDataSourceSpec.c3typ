/**
 * The base type for all data source specs for MLPipelines and MLPipelineTrainingJobs. The parametric binding `T` refers
 * to the data type produced by the spec.
 */
@beta
extendable entity type MLDataSourceSpec<DI> mixes Spec schema name 'MLDSS' {

  /**
   * Retrieves data for the sourceIds specified according to the rest of the spec.
   */
  getInputDataForSources: abstract member function(srcIds: !set<string>): !DI

  /**
   * Retrieves data for the sourceIds specified according to the rest of the spec and returns it in a map of
   * {{ value of groupingField }} -> data for source objects with that value.
   */
  getGroupedInputDataForSources: abstract member function(srcIds: !set<string>,
                                                          groupingField: !string): !map<string, DI>

  /**
   * Function that combines an arry of the produced data type into a single object.
   * Used to do map/reduce.
   */
  combineInputDataObjects: abstract member function(dataObjs: ![DI]): DI

  /**
   * Whether this spec is for supervised training. A convenience function.
   */
  isForSupervisedTraining: member function(): !boolean

  /**
   * The source type for this spec (e.g. the type on which `evalMetrics` will be called).
   */
  srcType: !Type

  /**
   * Abstract function (to be implemented by classes that extend MLDataSourceSpec) to persist input data.
   * @param data
   *          The data to persist
   * @param group
   *          The group, if any, associated with this dataset. See {@link MLTrainingJob#group}.
   */
  persistData: abstract member function(data: !DI, group: string)

  /**
   * Gets the input data persisted for this spec.
   *
   * @return The persisted data for this spec. Null if no data has been persisted.
   */
  getPersistedInputData: abstract member function(): DI

  /**
   * The last time when data was persisted for this spec.
   * For a spec attached to an {@link MLTrainingJob} this timestamp reflects the time at which the job that persisted
   * the data completed. Note that there will not be any data associated with that instance of the spec, but rather
   * with the corresponding specs attached to all of the trained pipelines.
   * For a spec attached to an {@link MLPipeline} this timestamp reflects the actual time at which the data for that
   * was persisted as part of the training job.
   */
  dataTimestamp: datetime

  /**
   * Validates the spec, throwing an error (whose message specifies the reason) if it is invalid.
   */
  validate: optional member function()
}
