/**
 * Configuration parameters and helper methods for the Shap Interpreter technique.
 * @see https://shap.readthedocs.io/en/latest/
 */
type ShapInterpreter<DX, DO> mixes MlInterpreter<DX, DO>, MlInterpreter.BackgroundDataMixin<DX> {

  /**
   * The native SHAP explainer used to interpret a model.
   * List of currently supported SHAP explainers:
   * - KernelExplainer
   * - TreeExplainer
   * - GradientExplainer
   */
  explainer: ShapExplainerName

  resultType: ~ py
  makeExplainer: ~ py
  beforeInterpret: ~ py
  doInterpret: ~ py-shap
  fromExplainer: ~ py
  needsBackgroundData: ~ py
}
