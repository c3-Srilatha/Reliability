/**
 * Customizations for an {@link MlInterpreter}, including keyword args for the {@link MlInterpreter#explainer} and data
 * parameterizations.
 */
type MlInterpretSpec mixes Spec {

  /**
   * A name for the instance of {@link MlInterpreter}.
   */
  name: string

  /**
   * Manual specification of the DX binding for {@link MlInterpreter}.
   */
  inputType: string serialized ValueType

  /**
   * Manual specification of the DO binding for {@link MlInterpreter}.
   */
  outType: string serialized ValueType

  /**
   * Initialization keyword arguments for an {@link MlInterpreter#explainer} if the `explainer` is a native Python
   * class.
   */
  initKwargs: map<string, any>

  /**
   * Keyword arguments for an {@link #explainer}'s interpret function.
   */
  callKwargs: map<string, any>

  /**
   * The {@link Action.Requirement minimal action requirement} in which all MlInterpreter methods for the pipe will be executed.
   */
  actionRequirement: private string serialized ImplLanguage.Runtime
}
