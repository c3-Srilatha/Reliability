/**
 * Event that is happened at some point of time.
 */
extendable entity type ObservedEvent schema name 'OBSERVED_EVENT' {

  /**
   * Type of this event.
   */
  eventType: string

  /**
   * Event that should be predicted in this window.
   */
  timestamp: datetime
}
