/**
 * Represents monitored event window for an ongoing event prediction, typically created from {@link Timeseries}
 * using {@link EventWindow#fromTimeseries}.
 */
extendable entity type MonitoredEventWindow extends EventWindow type key 'MEW' {

  /**
   * "MONITORING" status if the {@link MonitoredEventWindow} is open but no {@link ObservedEvent} has occurred yet.
   * "EVENT-VERIFIED" if the {@link MonitoredEventWindow} is open and at least one {@link ObservedEvent} has occurred.
   * "FALSE-POSITIVE" if the {@link MonitoredEventWindow} is closed and there were no {@link ObservedEvent}s.
   */
  monitoringStatus: string calc "exists(events) ? 'EVENT-VERIFIED' : exists(end) ? 'FALSE-POSITIVE' : 'MONITORING'"
}
