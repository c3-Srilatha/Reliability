/**
 * Categorizes predicted {@link EventWindow}s as True Positives, False Positives, or False Negatives. See
 * {@link #outcome} for more details.
 */
type EventWindowBinaryScoreResult {

  /**
   * The {@link EventWindowBinaryClassificationSpec}. That was used to create this {@link EventWindowBinaryScoreResult}.
   */
  spec: EventWindowBinaryClassificationSpec

  /**
   * Possible outcomes are
   * - TP: A True Positive is a {@link #monitoredEventWindow} occurs right before a {@link #observedEvent}.
   * - FP: A False Positive is a {@link #monitoredEventWindow} far from any {@link #observedEvent}s.
   * - FN: A False Negative is a {@link #monitoredEventWindow} before some {@link #observedEvent}.
   * Note there is no True Negative because there are no negative events reported.
   */
  outcome: string enum('TP', 'FP', 'FN')

  /**
   * The {@link MonitoredEventWindow}. If the {@link #outcome} is 'TP' or 'FP', this field should be populated.
   */
  monitoredEventWindow: EventWindow

  /**
   * The {@link ObservedEvent}. If the {@link #outcome} is 'FN' or 'TP', this field should be populated.
   */
  observedEvent: ObservedEvent

  /**
   * Precision for a set of {@link EventWindowBinaryScoreResult}s.
   */
  precision: function(scores: ![EventWindowBinaryScoreResult]): double

  /**
   * Recall for a set of {@link EventWindowBinaryScoreResult}s.
   */
  recall: function(scores: ![EventWindowBinaryScoreResult]): double

  /**
   * F1-score for a set of {@link EventWindowBinaryScoreResult}s.
   */
  f1Score: function(scores: ![EventWindowBinaryScoreResult]): double
}
