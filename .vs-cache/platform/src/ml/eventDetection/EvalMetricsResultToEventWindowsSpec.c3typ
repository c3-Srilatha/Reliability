/**
 * This spec describes how to create {@link EventWindow} from {@link EvalMetricsResult}.
 */
type EvalMetricsResultToEventWindowsSpec mixes TimeseriesToEventWindowsSpec {

  /**
   * List of metric names that will be extracted from `emr` of {@link EventWindow.fromEvalMetricsResult} and can be
   * used in {@link #startAndEndExpression}.
   * If empty all metrics from `emr` will be used.
   */
  metricNames: [string]
}
