/**
 * EventWindow represents a datetime interval that corresponds to an event.
 * It is commonly generated from a timeseries of risk scores to predict events in the future.
 * NOTE: By convention, we assume the interval is closed on the left (i.e. the beginning) and open on the
 * right (i.e. the end). This allows EventWindow to be used for intervals that correspond to only one unit
 * interval of time.
 */
extendable entity type EventWindow mixes TimedIntervalValue schema name 'EVENT_WINDOW' {

  /**
   * Spec that was used to create this {@link EventWindow}.
   */
  spec: TimeseriesToEventWindowsSpec schema suffix 'S'

  /**
   * "OPEN" or "CLOSED" if {@link EventWindow} is in active monitoring state.
   */
  status: string calc "exists(end) ? 'CLOSED' : 'OPEN'"

  /**
   * Events corresponding to this {@link EventWindow}.
   * It could be more than one event if multiple {@link ObservedEvent}s are close and should be covered by the same
   * {@link EventWindow}.
   */
  events: [ObservedEvent] schema suffix 'E'

  /**
   * Extract {@link EventWindow} from {@link Timeseries} using {@link TimeseriesToEventWindowsSpec}
   * If you have more than one trigger-rule please call {@link #fromTimeseries} multiple times using different
   * specs and merge results using {@link #mergeEventWindows}.
   *
   * Generates unique Id based on spec and start timestamp for each {@link EventWindow}. You can safely change
   * {@link TimeseriesToEventWindowsSpec#startTimestamp} and {@link TimeseriesToEventWindowsSpec#endTimestamp} and merge
   * result {@link EventWindow}s. If the event was already stored (e.g. in OPEN state), then it will be updated.
   *
   * If the metric is active at the beginning of the interval specified in {@link TimeseriesToEventWindowsSpec}, then
   * the {@link EventWindow} is not detected.
   *
   * @param spec
   *          Spec that describes rules on how to create {@link EventWindow}s.
   * @returns not persisted {@link EventWindow}s.
   */
  @java(returnWildcardVarBindings=true)
  fromTimeseries: function(spec: TimeseriesToEventWindowsSpec): [mixing EventWindow]

  /**
   * Extract {@link EventWindow} from {@link EvalMetricsResult} using {@link EvalMetricsResultToEventWindowsSpec}
   * If you have more than one trigger-rule please call {@link #fromTimeseries} multiple times using different
   * specs and merge results using {@link #fromEvalMetricsResult}.
   *
   * Generates unique Id based on spec and start timestamp for each {@link EventWindow}. You can safely run this method
   * on multiple {@link EvalMetricsResult}s and then merge result {@link EventWindow}s. If the event was already stored
   * (e.g. in OPEN state), then it will be updated.
   *
   * If the metric is active at the beginning of the interval specified in {@link EvalMetricsResultToEventWindowsSpec}, then
   * the {@link EventWindow} is not detected.
   *
   * @param emr
   *          Eval metrics result that contains object id {@link EvalMetricsResultToEventWindowsSpec#objId}
   *          and metric {@link EvalMetricsResultToEventWindowsSpec#startAndEndExpression}.
   * @param spec
   *          Spec that describes rules on how to create {@link EventWindow}s.
   * @returns not persisted {@link EventWindow}s.
   */
  @java(returnWildcardVarBindings=true)
  fromEvalMetricsResult: function(emr: !EvalMetricsResult,
                                  spec: !EvalMetricsResultToEventWindowsSpec): [mixing EventWindow]

  /**
   * Build {@link EventWindow}s from given {@link ObservedEvent}s.
   * @param events
   *          List of events that need to be turned into corresponding {@link EventWindow}s.
   * @param windowDuration
   *          Size of window.
   * @param endsPriorToEvent
   *          Interval between {@link EventWindow#end} and {@link ObservedEvent#timestamp}.
   * @returns list of {@link EventWindow}s.
   */
  @java(returnWildcardVarBindings=true)
  fromObservedEvents: function(events: [ObservedEvent],
                               windowDuration: !Duration,
                               endsPriorToEvent: !Duration): [mixing EventWindow]

  // TODO: PLAT-17809 - Implement EventWindow.toTimeseries
  eventWindowsToTimeseries: function(eventWindows: [EventWindow]): [Timeseries]

  /**
   * Take list of list of {@link EventWindow}s, in "priority" order and iteratively throw-away overlapping ones
   * from lower priority lists.
   * Useful for merging {@link EventWindow}s detected using different metrics.
   * @param windows
   *          List of lists of {@link EventWindow}s that need to be flattened.
   * @param spec
   *          Specification how to merge overlapping {@link EventWindow}s and other corner-cases.
   * @returns time-ordered list of {@link EventWindow}s.
   */
  @java(returnWildcardVarBindings=true)
  mergeEventWindows: function(windows: [[mixing EventWindow]], spec: EventWindowMergeSpec): [mixing EventWindow]
}
