/**
 * Represents path part of the Url.
 */
type UrlPath mixes StringSerializable {

  /**
   * Weather or not this is a relative path. I.e. it doesn't start with '/' character.
   */
  isRelative: boolean

  /**
   * Weather or not this is a directory path. I.e. it ends with '/' character.
   */
  isDirectory: boolean

  /**
   * Decoded components of the path.
   */
  parts: [string]

  /**
   * First component (decoded) of the path; i.e. if this is a file in the root folder then file name
   * otherwise root folder.
   */
  first: inline member function(): string

  /**
   * Last component (decoded) of the path; i.e. if this is a file path then name of the file otherwise deepest nested
   * folder.
   */
  last: inline member function(): string

  /**
   * @return parent directory for this path. I.e. copy of this path without last part.
   */
  parentDirectory: inline member function(): UrlPath

  /**
   * Retrieves name of the file if this is not a directory.
   */
  fileName: inline member function(): string

  /**
   * Retrieves extension of the file or null if file doesn't have an extension.
   */
  fileExt: inline member function(): string

  /**
   * Retrieves name of the file without file extension if this is not a directory.
   */
  fileNameNoExt: inline member function(): string

  /**
   * Adds a part to this path.
   */
  append: inline member function(part: !?string): !UrlPath

  /**
   * Adds url encoded part to this path.
   */
  appendEncoded: inline member function(encodedPart: !?string): !UrlPath

  /**
   * Parses '/' separated url encoded path.
   */
  fromEncodedString: inline function(encodedPath: !?string): UrlPath

  /**
   * @return url encoded string representation. e.g. "/foo%20bar"
   */
  encode: inline member function(): !string java | js

  /**
   * @return non encoded string representation. e.g. "/foo bar"
   */
  decode: inline member function(): !string

  /**
   * @return path with a terminating '/' character. Does not append additional '/' if it already terminates by it.
   */
  withTerminatingSlash: inline function(path: !?string): string java | js

  /**
   * @return path with a leading '/' character. Does not prepend additional '/' if it already starts with it.
   */
  withLeadingSlash: inline function(path: !?string): string java | js

  /**
   * @return path without a terminating '/' character.
   */
  withoutTerminatingSlash: inline function(path: !?string): string java | js

  /**
   * @return path without a leading '/' character.
   */
  withoutLeadingSlash: inline function(path: !?string): string java | js

  /**
   * @return path without a leading and terminating '/' character.
   */
  withoutLeadingAndTerminatingSlash: inline function(path: !?string): string

  /**
   * @return path without duplicate '/' characters.
   */
  withoutDuplicateSlash: inline function(path: !?string): string js

  /**
   * Concatenate multiple parts into a path string, separating by slashes as necessary.
   */
  concat: inline function(parts: !string ...): !string

  /**
   * Inserts a segment into a path after the numPrefixSegments.
   * @param path
   *        the path to insert the segment into
   * @param segment
   *        the segment to insert
   * @param numPrefixSegments
   *        the number of segments before the insertion point
   */
  insertSegmentInPath: inline function(path: !string, segment: !string, numPrefixSegments: !int): !string
}
