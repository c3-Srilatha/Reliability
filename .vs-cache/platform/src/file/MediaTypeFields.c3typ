/**
 * Details of a registered with IANA Media Type from https://www.iana.org/assignments/media-types/media-types.xhtml.
 */
type MediaTypeFields {

  @ser(name='Name')
  name: string

  @ser(name='Template')
  template: string

  @ser(name='Reference')
  reference: string
}
