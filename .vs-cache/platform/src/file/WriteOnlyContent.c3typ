/**
 * Abstract write only content with header.
 *
 * Since this instance is mutable, care must be taken if used from multiple threads. In particular, writing to it
 * from multiple threads will have non-deterministic behavior because of the way streams work.
 */
abstract type WriteOnlyContent mixes Content {

  encodedStream: ~
  readMetadata:  ~
  isReadOnly:    ~
  isWriteOnly:   ~
}
