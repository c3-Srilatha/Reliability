/**
 * JS <-> Obj SerDeser
 *
 * @see JsSerializable
 */
type JsSerDeser mixes SerDeser {

  /**
   * Serialize an Obj from JS source code with SRC object that can be referenced in the JS code.
   */
  readObjWithSrc: member function(content: !Content, src: !?Obj, spec: FileObjsOperSpec): Obj

  readJsonLines: ~
}
