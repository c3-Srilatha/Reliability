/**
 * Interface to facilitate notification registration
 */
abstract type FileSystemNotificationRegistration {

  /**
   * This function should be invoked by the subtype to subscribe for notifications trigger by a file system.
   */
  registerNotification: optional function(urlOrEncodedPathPrefix: string, spec: FileSystemNotificationSpec)

  /**
   * This function should be invoked by the subtype to unsubscribe for notifications trigger by a file system.
   */
  deregisterNotification: optional function(urlOrEncodedPathPrefix: string)
}
