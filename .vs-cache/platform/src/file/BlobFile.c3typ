/**
 * Represents the Blob as a file.
 */
abstract type BlobFile<FS: BlobFileSystem> mixes FileWithUserMetadata {

  /**
   * @return the container / bucket name of the file
   */
  containerName: inline member function(): string

  /**
   * @return blob key of the file.
   */
  blobKey: inline member function(): string

  fromString:    ~
  callWithRetry: ~
  fsForThisType: private inline function(): FS
}
