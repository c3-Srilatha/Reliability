/**
 * Enum for all possible file system schemes.
 */
enum type FileSystemScheme {

  /**
   * C3 file-system
   */
  c3fs = 'c3fs'

  /**
   * Current meta-data for a tag
   */
  meta = 'meta'

  /**
   * All the meta-data known to environment
   */
  allmeta = 'allmeta'

  /**
   * Local file-system
   */
  file = 'file'

  /**
   * HTTP
   */
  http = 'http'

  /**
   * HTTPS
   */
  https = 'https'

  /**
   * AWS S3
   */
  s3 = 's3'

  /**
   * Azure blob
   */
  azure = 'azure'

  /**
   * Azure Data Lake Gen 2
   */
  adl = 'adl'

  /**
   * HDFS
   */
  hdfs = 'hdfs'

  /**
   * GCS
   */
  gcs = 'gcs'

  /**
   * GitHub
   */
  github = 'github'

  /**
   * Git
   */
  git = 'git'

  /**
   * Tmp
   */
  tmp = 'tmp'

  /**
   * Zip file-system
   */
  zip = 'zip'

  /**
   * In memory content
   */
  mem = 'mem'

  /**
   * MsGraph (OneDrive and SharePoint)
   */
  msgraph = 'msgraph'

  /**
   * GoogleDrive
   */
  gdrive = 'gdrive'

  /**
   * Box
   */
  box = 'box'
}
