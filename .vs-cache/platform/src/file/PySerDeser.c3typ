type PySerDeser mixes SerDeser {

  /**
   * Execute python source code in the provided content, and return the object pointed to by {@link PySerializable#DATA_IDENTIFIER} at the end of execution.
   *
   * @param context
   *    Bind variables for the execution of the source code. Note: "c3" is a reserved variable name and will be overwritten.
   */
  _constructDataObj: private member function(content: !Content, context: map<string, any>): Obj py
}
