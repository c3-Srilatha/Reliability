/**
 * Configuration for VFS FileSystemManager object pool.
 * Controls the behavior of pooled Apache Commons VFS FileSystemManager instances.
 */
type VfsManagerPoolConfig {

  /**
   * Minimum number of idle FileSystemManager instances to keep in the pool.
   */
  minIdle: !int32 = 2

  /**
   * Maximum number of idle FileSystemManager instances to keep in the pool.
   */
  maxIdle: int32 = 10

  /**
   * Maximum total number of FileSystemManager instances (active + idle) in the pool.
   * Default: Number of available processors * 2
   *
   * Setting this higher improves concurrency but uses more memory.
   * Each manager maintains its own caches and connection pools.
   */
  maxTotal: int32

  /**
   * Maximum time in milliseconds to wait for a manager when pool is exhausted.
   */
  maxWaitMillis: !int = 300000

  /**
   * Minimum time in milliseconds that an idle manager can sit in the pool before being eligible for eviction.
   * Default: 1800000 (30 minutes)
   */
  minEvictableIdleTimeMillis: !int = 1800000

  /**
   * Time in milliseconds between runs of the idle object evictor thread.
   * Default: 300000 (5 minutes)
   */
  timeBetweenEvictionRunsMillis: !int = 300000

  /**
   * Returns the default VFS manager pool configuration.
   * Calculates maxTotal based on available processors if not explicitly set.
   */
  defaultConfig: function(): VfsManagerPoolConfig

  /**
   * Converts this config to an ObjectPoolConfig for use with the generic pool implementation.
   */
  toObjectPoolConfig: member function(): ObjectPoolConfig
}
