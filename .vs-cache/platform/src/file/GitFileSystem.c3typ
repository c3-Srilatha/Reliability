@beta
type GitFileSystem mixes FileSystem, FileSystemConfigurable<GitFsConfig> {

  /**
   * The url of the repository.
   */
  gitUrl: !GitUrl

  mounts:               ~
  enabled:              ~
  fromUrlOrEncodedPath: ~
  urlFromEncodedPath:   ~

  /**
   * Run a git operation on the command line.
   *
   * @param localRootUrl
   *           The path to the git root directory on the local file system. Since the git command is not run from
   *           this directory, the path will be specified to the git command using the -C flag. For git clone,
   *           this should be left blank (the target local directory is specified as a different parameter).
   * @param gitArgs
   *           The arguments to the git command after "git -C ...". For example, for "git pull --rebase", gitArgs
   *           should be "pull" and "--rebase".
   */
  runGitCommand: private function(localRootUrl: Url, gitArgs: [string]): string

  /**
   * If the given target branch does not exist in the repository, create it from the source branch.
   * Similar to {@link GitHub.ensureBranchExists}.
   */
  ensureBranchExists: member function(targetBranch: !string, sourceBranch: !string): boolean

  /**
   * Empty the repository cache. Later file system calls will re-clone the appropriate repository.
   */
  emptyCache: function()

  /**
   * Reset the branch for this file system to the given base branch.
   */
  reset: member function(baseBranch: !string)

  /**
   * Return the version number from "git version".
   */
  gitVersion: function(): SemanticVersion
}
