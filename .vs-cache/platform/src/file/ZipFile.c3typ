/**
 * Represents single ZIP file.
 *
 * @see FileSystem#zipFiles
 */
type ZipFile mixes File {

  /**
   * Adds entry to this ZIP file. Note that it reads whole ZIP file in order to add one entry so it is more efficient
   * to use #addEntries or FileSystem#zip.
   */
  addEntry: member function(content: !binary, path: !?string): !ZipFile

  /**
   * Adds multiple entries to this ZIP file. Note that it reads whole ZIP file in order to add entries so it is more
   * efficient FileSystem#zip.
   */
  addEntries: member function(entries: !map<string, binary>): !ZipFile
}
