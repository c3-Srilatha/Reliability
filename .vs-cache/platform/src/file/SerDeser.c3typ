/**
 * C3 type-system serializer / deserializer.
 */
type SerDeser mixes DefaultInstance {

  /**
   * Serialization name of a field/element in Json/Xml that represents type of serialized instance.
   */
  TYPE_SER_NAME: const string = 'type'

  /**
   * Alternative serialization name of of a field/element in Json/Xml that represents type of serialized instance.
   */
  TYPE_ALT_SER_NAME: const string = '$type'

  /**
   * Optional C3 type for serialized content.
   */
  serType: Type

  /**
   * Reads C3 type instances from a serialized content.
   */
  readObjs: abstract member function(content: !Content, spec: FileObjsOperSpec): stream<Obj>

  /**
   * Reads C3 type instances from a serialized string content.
   */
  readObjs: member function(content: !string, spec: FileObjsOperSpec): stream<Obj>

  /**
   * Read a single instance of a C3 type from serialized content. Throws an error if more than one instance is found.
   */
  readObj: member function(content: !Content, spec: FileObjsOperSpec): Obj

  /**
   * Read a single instance of a C3 type from serialized string content. Throws an error if more than one instance is
   * found.
   */
  readObj: member function(content: !string, spec: FileObjsOperSpec): Obj

  /**
   * Deserializes content from file into a stream of jsons.
   */
  readJsonLines: member function(content: !Content, spec: FileObjsOperSpec): stream<json>

  /**
   * Writes C3 type instances as serialized content.
   */
  writeObjs: abstract member function(content: !Content, objs: stream<Obj>, spec: FileObjsOperSpec): !int

  /**
   * @return push stream of C3 type instances for serializing content into given byte push stream.
   */
  startWriteObjs: member function(content: !Content, spec: FileObjsOperSpec): !PushStream<Obj>

  /**
   * @return content type for this serializer.
   */
  contentType: abstract inline member function(): !string

  /**
   * @return serializer for a given content header.
   */
  forContent: inline function(content: !?Content, spec: FileObjsOperSpec, failIfNone: boolean): SerDeser

  /**
   * @return serializer for a given content type.
   */
  forContentType: cached inline function(contentType: !?string, failIfNone: boolean): SerDeser

  /**
   * @return serializer for a given file extension.
   */
  forFileExt: inline function(fileExt: !?string, failIfNone: boolean): SerDeser

  /**
   * @return true if input is of supported content type.
   */
  isValidContentType: inline function(contentType: !string): boolean

  iterator: private abstract inline member function(content: !Content,
                                                    spec: FileObjsOperSpec)
                                             : @java(class='c3.platform.typesys.value.ObjValueIterator') native

  receiver: private abstract inline member function(content: !Content,
                                                    spec: FileObjsOperSpec)
                                             : @java(class='c3.platform.typesys.value.ObjValueReceiver') native

  /**
   * schema for the avro/parquet content.
   */
  @beta
  schema: private optional function(content: !Content): string

  /**
   * schema map of field names to declared value types for avro/parquet content. Currently only works for primitive
   * value types only. Use schema instead for complex value types.
   */
  @beta
  schemaMap: private optional function(content: !Content): map<string, ValueType>

  _serType: private member function(spec: !?FileObjsOperSpec): Type
}
