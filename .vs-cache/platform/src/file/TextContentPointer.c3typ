/**
 * Represents a location in a piece of text content.  ContentPointer#offset is in
 * characters, as are the #lineNum and #colNum values defined by this type.
 */
type TextContentPointer mixes ContentPointer {

  /**
   * Cache of line number.
   */
  m_lineNum: int

  /**
   * Cache of column number.
   */
  m_colNum: int

  /**
   * Source code line number (1-based).
   */
  lineNum: member function(): !int

  /**
   * Source column number (1-based from start of line).
   */
  colNum: member function(): !int

  /**
   * Return the line of the text that corresponds to the pointer lineNum.
   * This will return null if no such line exists (the point is incorrect).
   */
  surroundingLine: member function(): string

  /**
   * Return the lines of the text that surround the pointer lineNum.
   * This will return null if no such line exists (the point is incorrect).
   *
   * `count` lines both before and after the pointer are returned (assuming they exist)
   * so a maximum of `count * 2 + 1` lines will be returned.
   *
   * @param count the number of lines of context before and after
   * @return a set of line numbers and contents
   */
  surroundingLines: member function(count: int = 1): [TextContentLine]

  /**
   * Return the word from the text that corresponds to the pointer.
   * This will return null if no natural word can be identified.
   * Words are identifiers, possibly including periods if not at the start or end.
   */
  surroundingWord: member function(): TextContentSnippet

  /**
   * Return a new text pointer with the location adjusted to match the specified line and column.
   */
  withTextLocation: member function(lineNum: !int, colNum: int): !TextContentPointer

  /**
   * Return a new text pointer with the location adjusted to match the specified offset and
   * the line and column location calculated.
   */
  withTextOffset: member function(offset: !int): !TextContentPointer

  /**
   * Instantiate from source code with line and column number.
   * The absolute offset in characters is calculated using #calculateOffset.
   *
   * @param content that supplies the text
   * @param lineNum the line number (1-based)
   * @param colNum the column number (1-based within the line)
   */
  fromSource: function(content: !Content, lineNum: !int, colNum: int): !TextContentPointer

  /**
   * Calculate the absolute offset in characters (0-based) from the text given a line
   * and column number (1-based).
   *
   * @param content that supplies the text
   * @param lineNum the line number (1-based)
   * @param colNum the column number (1-based within the line)
   */
  calculateOffset: function(content: !Content, lineNum: !int, colNum: int): !int

  /**
   * Calculate the line-relative position in characters (1-based) from the text given an
   * absolute character offset (0-based).
   *
   * @param content that supplies the text
   * @param offset character offset (0-based).
   */
  calculateLinePos: function(content: !Content, offset: !int): !TextContentPointer

  /**
   * Extract the line-relative position in characters (1-based) from source code and a
   * generic content pointer.
   *
   * @param at any content pointer
   */
  extractLinePos: function(at: !ContentPointer): !TextContentPointer

  offset:      ~
  fromContent: ~
}
