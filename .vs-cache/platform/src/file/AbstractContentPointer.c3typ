/**
 * Represents a part of the AbstractContent
 */
type AbstractContentPointer<C> {

  /**
   * abstract content type obj
   */
  content: C

  /**
   * md5 of the content referred by 'content'
   */
  contentMD5: string

  /**
   * sha1 of the content referred by 'content'
   */
  contentSHA1: string

  /**
   * Offset in bytes from the start of the content
   */
  offset: !int

  /**
   * length of the content in bytes after the offset
   */
  length: !int
}
