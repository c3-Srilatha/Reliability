/**
 * Interface for inspecting Content Type.
 */
type ContentTypeInfo {

  /**
   * @return true if this is a text content (not simply plain text but csv, json, xml etc).
   * I.e. readString is meaningful on a Content.
   */
  isAnyText: abstract inline member function(): boolean

  /**
   * Helper method for isAnyText() implementation which takes in the `mediaType` of the `ContentTypeInfo` subTypes
   * ({@link ContentType}, {@link ContentMeta}).
   */
  isAnyTextImpl: private inline member function(mediaType: !string): boolean java | js

  /**
   * @return true if this is a plain text content (i.e. not specifically csv, json, xml etc).
   */
  isPlainText: abstract inline member function(): boolean

  /**
   * @return true if this is a unknown binary content (i.e. not specifically c3Binary or parquet).
   */
  isBinary: abstract inline member function(): boolean

  /**
   * @return true if this is a csv content.
   */
  isCsv: abstract inline member function(): boolean

  /**
   * @return true if this is a green button csv content.
   */
  isGreenButtonCsv: abstract inline member function(): boolean

  /**
   * @return true if this is a green button xml content.
   */
  isGreenButtonXml: abstract inline member function(): boolean

  /**
   * @return true if this is a json content.
   */
  isJson: abstract inline member function(): boolean

  /**
   * @return true if this is a json content. http://jsonlines.org/.
   */
  isJsonLines: abstract inline member function(): boolean

  /**
   * @return true if this is YAML content.
   *
   * @see https://yaml.org/
   */
  isYaml: abstract inline member function(): boolean

  /**
   * @return true if this is a xml content.
   */
  isXml: abstract inline member function(): boolean

  /**
   * @return true if this is a xlsx content.
   */
  isXlsx: abstract inline member function(): boolean

  /**
   * @return true if this is a X12-EDI content.
   */
  isEdi: abstract inline member function(): boolean

  /**
   * @return true if this is c3 binary content.
   */
  isC3Binary: abstract inline member function(): boolean

  /**
   * @return true if this is a c3 type content.
   */
  isC3Type: abstract inline member function(): boolean

  /**
   * @return true if this is a JavaScript content.
   */
  isJavaScript: abstract inline member function(): boolean

  /**
   * @return true if this is a Python content.
   */
  isPython: abstract inline member function(): boolean

  /**
   * @return true if this is a R content.
   */
  isR: abstract inline member function(): boolean

  /**
   * @return true if this is a ruby source code content.
   */
  isRuby: abstract inline member function(): boolean

  /**
   * @return true if this is a Java content.
   */
  isJava: abstract inline member function(): boolean

  /**
   * @return true if this is a Java Script content.
   */
  isTypeScript: abstract inline member function(): boolean

  /**
   * @return true if this is any source code content.
   */
  isAnyCode: abstract inline member function(): boolean

  /**
   * @return true if this is an Apache Avro content.
   */
  isAvro: abstract inline member function(): boolean

  /**
   * @return true if this is an Apache Parquet content.
   */
  isParquet: abstract inline member function(): boolean

  /**
   * @return true if this is HDF5 content.
   */
  isHdf5: abstract inline member function(): boolean

  /**
   * @return true if this is HTML content.
   */
  isHtml: abstract inline member function(): boolean

  /**
   * @return true if this is a Zip file content.
   */
  isZip: abstract inline member function(): boolean

  /**
   * @return true if this is a Dsl file content.
   */
  isDsl: abstract inline member function(): boolean

  /**
   * @return true if this is a Type Dsl file content.
   */
  isTypeDsl: abstract inline member function(): boolean

  /**
   * @return true if this is a UI Dsl file content.
   */
  isUiDsl: abstract inline member function(): boolean

  /**
   * @return true if this is a (c3) Doc file content.
   */
  isDoc: abstract inline member function(): boolean

  /**
   * @return true if this is a Markdown file content.
   */
  isMarkdown: abstract inline member function(): boolean

  /**
   * @return true if this is a an image content.
   */
  isImage: abstract inline member function(): boolean

  /**
   * @return true if this is a SVG content.
   */
  isSvg: abstract inline member function(): boolean

  /**
   * @return true if this is a PNG content.
   */
  isPng: abstract inline member function(): boolean

  /**
   * @return true if this is a JPEG content.
   */
  isJpeg: abstract inline member function(): boolean
}
