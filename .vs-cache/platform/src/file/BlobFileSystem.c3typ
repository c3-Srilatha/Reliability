/**
 * Abstract base type for FileSystems that are based on a blob or object store such as S3 and Azure Data Lake.
 */
abstract type BlobFileSystem<F: BlobFile> mixes FileSystem {

  /**
   * Returns just blob container name for a given FileSystem Mount; Note that mount may also contain a path; So it's
   * best to use FileSystem APIs.
   */
  containerName: inline member function(mount: string enum FileSystemMount): !string

  /**
   * Returns all blob container  names that this pod and current tenant can access.
   */
  containerNames: inline member function(): [string]

  /**
   * Creates blob container with a given name. If name is not provided creates default container. If name is provided then
   * it is validated against possible container names.
   *
   * @return true if container didn't exist and was just created
   */
  upsertContainer: member function(containerName: string, spec: FileOperationSpec): boolean

  /**
   * Upserts all blob containers this pod can access and current tenant can access.
   *
   * @return count of newly created containers
   */
  upsertAllContainers: member function(spec: FileOperationSpec): !int

  /**
   * Returns whether the blob container exists.
   *
   * @param containerName
   *           if not provided uses the default blob container associated with pod
   * @return true if container exists.
   */
  containerExists: inline member function(containerName: string, spec: FileOperationSpec): boolean

  /**
   * Truncates provided blob container by deleting all files.
   * confirm parameter should be set to true otherwise action fails.
   *
   * @return number files deleted
   */
  truncateContainer: member function(containerName: string, confirm: boolean, spec: FileOperationSpec): !int

  /**
   * Returns all existing and visible to this pod blob container names.
   */
  listContainers: member function(spec: ListFilesOperationSpec): [string]

  doCreateContainer:   private abstract member function(containerName: !string, spec: FileOperationSpec): boolean
  doContainerExists:   private abstract member function(containerName: !string, spec: FileOperationSpec): boolean
  doTruncateContainer: private abstract member function(containerName: !string, spec: FileOperationSpec): !int
  doReadBlobMeta:      private abstract member function(containerName: !string,
                                                        blobKey: !string,
                                                        spec: FileOperationSpec): F

  doBlobEncodedStream: private abstract member function(containerName: !string,
                                                        blobKey: !string,
                                                        spec: FileOperationSpec): Pair<F, ByteStream>

  doBlobEncodedPushStream: private abstract member function(containerName: !string,
                                                            blobKey: !string,
                                                            file: File,
                                                            spec: FileOperationSpec): BytePushStream

  listBlobsDefaultLimit:  private abstract member function(): !int
  listBlobsPerQueryLimit: private abstract member function(): !int

  doListBlobs: private abstract member function(containerName: !string,
                                                blobKeyPrefix: string,
                                                isDirectory: boolean,
                                                limit: int,
                                                marker: string,
                                                readMetadata: boolean,
                                                spec: ListFilesOperationSpec): !ListFilesResult

  doListDirectChildrenBlob: private abstract member function(containerName: !string,
                                                             blobKeyPrefix: string,
                                                             isDirectory: boolean,
                                                             limit: int,
                                                             marker: string,
                                                             readMetadata: boolean,
                                                             spec: ListFilesOperationSpec): !ListFilesAndDirsResult

  maxDeleteBlobsCount: private abstract member function(): !int
  doDeleteBlobs:       private abstract member function(containerName: !string,
                                                        blobKeys: ![string],
                                                        spec: FileOperationSpec)

  doCopyBlob: private abstract member function(srcContainerName: !string,
                                               srcBlobKey: !string,
                                               destContainerName: !string,
                                               destBlobKey: !string,
                                               spec: FileOperationSpec): F

  /**
   * Copies blob files using cloud provider APIs. When the source scheme and destination schemes are the same,
   * files are copied by using batch APIs. Otherwise, each file is copied individually.
   */
  doCopyBlobs: private member function(srcContainerNames: ![string],
                                       srcBlobKeys: ![string],
                                       destContainerNames: ![string],
                                       destBlobKeys: ![string],
                                       spec: FileOperationSpec): [F]

  doReplaceBlobContentTypeAndEncoding: private abstract member function(containerName: !string,
                                                                        srcBlobKey: !string,
                                                                        contentType: string,
                                                                        contentEncoding: !string,
                                                                        spec: FileOperationSpec): F

  cloudClient: private abstract member function(containerName: !string)
                                         : @java(class='c3.platform.cloud.CloudClient') !native

  /**
   * @return blob file system specific instance of File.
   */
  makeFile: ~: !BlobFile

  cloudResourceTypeName:                abstract ~
  scheme:                               abstract ~
  supportsContentType:                  ~
  doOpenFile:                           ~
  doFileEncodedStream:                  ~
  doFileEncodedPushStream:              ~
  doListFiles:                          ~
  doDeleteFilesBatch:                   ~
  doReplaceContentTypeAndEncodingBatch: ~
  shouldRetry:                          ~
  fileType:                             private inline member function(): !Type
  doListDirectChildren:                 ~
  capabilities:                         ~
}
