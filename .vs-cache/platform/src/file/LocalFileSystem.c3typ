/**
 * Represents a local file system.
 */
type LocalFileSystem mixes VirtualFileSystem, FileSystemConfigurable<LocalFsConfig> {

  /**
   * Make a file in the local system's tmp directory
   */
  makeTmpFile: function(prefix: string, suffix: string): File

  mounts:               ~
  fromUrlOrEncodedPath: ~
  listChanges:          ~ java | js-node | py-client
  makeFile:             ~ java | js | py
  scheme:               ~ java | js | py
}
