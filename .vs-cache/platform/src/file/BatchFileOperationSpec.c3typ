/**
 * Spec for batch operations on the files
 */
type BatchFileOperationSpec mixes ListFilesOperationSpec {

  /**
   * No of files in each batch job
   */
  batchSize: int = 10

  /**
   * total number of files to process; if -1 all files will be retrieved, defaults is -1.
   */
  limit: int

  /**
   * default priority for job
   */
  priority: int
}
