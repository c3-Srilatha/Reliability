/**
 * Standard file extensions supported by C3.
 * Also see Media types {@link MediaType}
 */
enum type FileExt {

  TXT = '.txt'

  XML = '.xml'

  CSV = '.csv'

  XLSX = '.xlsx'

  JSON = '.json'

  JSON_LINES = '.ndjson'

  JSON_SCHEMA = '.schema.json'

  YAML = '.yaml'

  HTML = '.html'

  CSS = '.css'

  SCSS = '.scss'

  ZIP = '.zip'

  TAR = '.tar'

  TGZ = '.tgz'

  GZ = '.gz'

  SNAPPY = '.snappy'

  LZ4 = '.lz4'

  PKG = '.c3pkg.json'

  PKG_LOCK = '.c3pkg.lock.json'

  TYPE = '.c3typ'

  UI = '.c3ui'

  DOC = '.c3doc.md'

  DOC2 = '.c3doc'

  POLY = '.c3poly.md'

  C3BIN = '.c3bin'

  JS = '.js'

  JS5 = '.js5'

  JS_MAP = '.js_map'

  JS_MODULE = '.mjs'

  JS_X = '.x.js'

  TS = '.ts'

  TSX = '.tsx'

  D_TS = '.d.ts'

  PY = '.py'

  PYI = '.pyi'

  JAVA = '.java'

  R = '.R'

  RB = '.rb'

  EDI = '.edi'

  AVRO = '.avro'

  ARROW = '.arrow'

  PARQUET = '.parquet'

  HDF5 = '.hdf5'

  H5 = '.h5'

  GH5 = '.gh5'

  PNG = '.png'

  JPG = '.jpg'

  JPEG = '.jpeg'

  SVG = '.svg'

  ICO = '.ico'

  MD = '.md'

  WOFF = '.woff'

  WOFF2 = '.woff2'

  BYT = '.byt'

  FEATHER = '.feather'

  /**
   * Jupyter notebook.
   */
  IPYNB = '.ipynb'

  /**
   * C3 notebook (Console and VSCode).
   */
  C3NB = '.c3nb'

  /**
   * Those extensions which have two parts, such as ".d.ts". For these, the methods below will #extract,
   * {@link #fileHasExt find} and {@link #fileWithoutExt remove} _both_ parts.
   */
  compoundExts: cached function(): [!string] java

  /**
   * @return default file extension for given contentType and contentEncoding.
   */
  dfltForContentTypeAndEncoding: inline function(contentType: !string, contentEncoding: string): !string

  /**
   * Check whether a file name has the specified extension (case insensitive).
   *
   * @param path file path to check
   * @param extension file extension to check, including period (`".py"`)
   */
  fileHasExt: inline function(path: !string serialized File, extension: !string): boolean java | js | py

  /**
   * Remove the extension from a file name. This will be the final period in the path, as long as not followed by
   * a slash:
   * ```
   * foo.txt    --> foo
   * a/b/c.jpg  --> a/b/c
   * a/b/c      --> a/b/c
   * a.b/c      --> a.b/c
   * ```
   */
  fileWithoutExt: inline function(path: !string serialized File): !string java | js | py

  /**
   * Extract the extension from a file name, including the separating period.
   *
   * @param path file path to extract from
   * @return file extension, including period (`".py"`) or null
   */
  extract: inline function(path: !?string serialized File): string java | js | py
}
