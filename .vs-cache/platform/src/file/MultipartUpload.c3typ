/**
 * A type that creates and holds references to multiple files (aka parts), and merges them in order when done.
 */
type MultipartUpload {

  /**
   * The path to save to when the file is saved. This should be an encoded file name, which cannot have spaces in it.
   * e.g. "raw file.json" should passed as "raw%20file.json"
   */
  url: string

  /**
   * Parts of this instance.
   */
  contentParts: ![ContentPart] schema name 'MPUS'

  /**
   * ContentType of the destination file.
   */
  contentType: string

  /**
   * ContentEncoding of the destination file.
   */
  contentEncoding: string

  /**
   * If the upload operation is for copying file
   */
  isCopy: boolean

  /**
   * The maximum number of retries when reading the content part with exponential backoff
   */
  numRetries: int = 6

  /**
   * Create its file parts and sets the path
   * @param urlOrEncodedPath
   *              the destination of the combined file url or encoded path
   * @numParts
   *              the number of expected parts
   * @expectedLengths
   *              an array of expected lengths for each part. The size of this array must be equal to numParts. If
   *              not specified, the expected lengths of each part will be -1.
   */
  start: function(urlOrEncodedPath: !string serialized Url, numParts: !int, expectedLengths: [int]): !MultipartUpload

  /**
   * Adds another part to the #contentParts field and returns the new S3MultipartUpload instance
   */
  appendPart: private member function(): !mixing MultipartUpload

  /**
   * Returns the number of parts this instance has.
   */
  partsCount: member function(): !int

  /**
   * Get a particular part of this instance; will fail if it does not exist
   */
  part: member function(index: !int): !File

  /**
   * Get all parts of this instance
   */
  parts: member function(): [File]

  /**
   * Get a particular part of this instance; will fail if it does not exist
   */
  contentPart: member function(index: !int): !ContentPart

  /**
   * Delete the parts after upload is done.
   */
  deleteParts: member function()

  /**
   * Merge all parts of this instance and save the final file at the location specified by {@link url}.
   */
  done: member function(spec: FileOperationSpec): !File
}
