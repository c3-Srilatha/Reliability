/**
 * Provides options for various File actions.
 */
type DeleteFileOperationSpec mixes ListFilesOperationSpec {

  /**
   * If set to true, will delete the blobs with snapshots
   */
  deleteSnapshots: boolean

  /**
   * If set to `true` then any existing lease/lock on the file will be forcibly broken before the operation.
   * This is useful when you need to override existing locks and force the deletion to succeed
   */
  forceBreakLock: boolean
}
