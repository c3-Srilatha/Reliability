/**
 * A restful endpoint for generating NPM modules.
 * Example: http://localhost:8888/c3/c3/npm-modules/c3-remote.tgz
 */
@restful(endpoint='npm-modules')
type NpmModuleSource {

  /**
   * Generates npm module in tgz format from given .c3pkg.json and files.
   */
  generate: function(packageJsonContent: !json, files: map<string, ContentValue>): !ContentValue

  /**
   * Generates npm module in tgz format for c3 remote module.
   */
  @restful(subPath='c3-remote.tgz')
  c3Remote: function(): !ContentValue

  /**
   * To update the bundled tgz file for `c3-remote.tgz` in java resource.
   */
  generateC3RemoteBundle: private function()

  /**
   * Generates npm module in tgz format for c3 jasmine module.
   */
  @restful(subPath='c3-jasmine.tgz')
  c3Jasmine: function(): !ContentValue
}
