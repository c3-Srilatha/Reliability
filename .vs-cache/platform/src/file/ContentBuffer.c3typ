/**
 * A dynamic in-memory buffer. Content can be written into it once and then read many times.
 *
 * Since this instance is mutable, care must be taken if used from multiple threads. In particular, writing to it
 * from multiple threads will have non-deterministic behavior because of the way streams work.
 *
 * @see Content
 * @see ContentValue
 * @see ContentStream
 * @see ContentPushStream
 */
type ContentBuffer mixes Content {

  /**
   * The actual content buffer backed by a native mechanism.
   */
  bytes: private @java(class='java.io.ByteArrayOutputStream') native

  /**
   * Creates a new content buffer with a given initial capacity and content type and encoding.
   */
  create: function(initialCapacity: int, contentType: string, contentEncoding: string): !ContentBuffer java | js

  /**
   * Truncates the given buffer and makes it empty.
   */
  @action(group+='write')
  truncate: member function() java | js

  /**
   * @return current bytes accumulated in the buffer
   */
  currentContentLength: inline member function(): int java | js

  readEncoded:       ~
  encodedPushStream: ~ java | js
  encodedStream:     ~ java | js
  toContentValue:    ~ java | js
}
