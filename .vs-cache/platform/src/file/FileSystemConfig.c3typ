/**
 * Configuration for C3 File System.
 */
@action(group+='app-admin')
type FileSystemConfig mixes Config {

  /**
   * Default file system identified by scheme.
   */
  default: string enum FileSystemScheme

  /**
   * C3 file-system configuration.
   */
  c3fs: C3FsConfig

  /**
   * Local file-system configuration.
   */
  file: LocalFsConfig

  /**
   * AWS S3 based file-system configuration.
   */
  s3: S3FsConfig

  /**
   * Azure Data Lake store based file-system configuration.
   */
  adl: AdlFsConfig

  /**
   * Azure blob store based file-system configuration.
   */
  azure: AzureFsConfig

  /**
   * GCS based file-system configuration.
   */
  gcs: GcsFsConfig

  /**
   * Google Drive based file-system configuration.
   */
  gdrive: GDriveFsConfig

  /**
   * Box based file-system configuration.
   */
  box: BoxFsConfig

  /**
   * HDFS based file-system configuration.
   */
  hdfs: HdfsConfig

  /**
   * HTTP based file-system configuration.
   */
  http: HttpFsConfig

  /**
   * HTTPS based file-system configuration.
   */
  https: HttpFsConfig

  /**
   * GitHub based file-system configuration.
   */
  github: GitHubFsConfig

  /**
   * Temporary storage based file-system configuration.
   */
  tmp: TmpFsConfig

  /**
   * Pkg based file-system configuration.
   */
  meta: PkgFsConfig

  /**
   * MsGraph based file-system configuration (OneDrive/Sharepoint).
   */
  msgraph: MsGraphConfig

  /**
   * @return configuration of the specific file system.
   */
  childConfig: member function(scheme: !string): !FileSystemConfigChild

  /**
   * Sets default file system
   */
  setDefault: member function(scheme: !string serialized FileSystemScheme,
                              override: string enum ConfigOverride): !FileSystemConfig

  setConfig:      ~
  setConfigValue: ~
  validate:       ~
}
