/**
 * Spec to select files with various patterns and order. All provided patterns will be applied to select files.
 */
type FileFilterSpec mixes Spec {

  /**
   * path expression to match files.
   * For other options, set #pathGlob, #pathRegex, "pathContains".
   * If provided, files with path beginning with this string are selected.
   */
  pathPrefix: string

  /**
   * Optional glob to select files. A glob expression
   * supports '**' which translates to any level in the folder hierarchy.  The glob is normally case sensitive,
   * but this can be changed with #pathCaseInSensitive.
   */
  pathGlob: string

  /**
   * Optional regex to filter file paths.
   *  #pathPrefix, #pathGlob, #pathContains
   */
  pathRegex: string

  /**
   * Filter based on presence of any specific string in file path.
   */
  pathContains: string

  /**
   * Whether the match performed against the file path is case insensitive.
   */
  pathCaseInsensitive: boolean

  /**
   * If provided filter files by content media-type.
   */
  mediaType: string enum MediaType

  /**
   * returns a list of compiled Regex patterns based on the spec.
   */
  toRegex: cached member function(): [@java(class='java.util.regex.Pattern') native]

  /**
   * returns , if the File path matches, this filter spec.
   */
  matches: inline member function(file: File): boolean
}
