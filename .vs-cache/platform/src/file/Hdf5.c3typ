type Hdf5 mixes Value {

  /**
   * Deserializes content from various files led to by the path into a list of C3 Type instances.
   * @urlOrEncodedPath
   *           File path to stream data from
   * @see FileObjsOperSpec.targetType
   * @return json object
   */
  readJson: function(urlOrEncodedPath: !string, spec: Hdf5FileObjsOperSpec): json

  /**
   * Deserializes HDF5 content to raw json.
   */
  readContentAsJson: function(contentLocation: !string, content: !binary, spec: Hdf5FileObjsOperSpec): json

  /**
   * Deserializes HDF5 content to a dynamic type.
   */
  readObj: function(content: !Content, spec: FileObjsOperSpec): Hdf5Obj
}
