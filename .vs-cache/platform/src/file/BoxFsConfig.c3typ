type BoxFsConfig mixes FileSystemConfigChild {

  /**
   * The amount of time to wait (in milliseconds) when initially establishing a connection before timing out.
   */
  connectionTimeout: int = 60000

  /**
   * Returns the amount of time to wait (in milliseconds) for data to be transferred over an established, open connection before the connection times out and is closed. A value of 0 means no timeout, and isn't recommended.
   */
  socketTimeout: int = 120000

  /**
   * Number of retries due to rate limiting
   */
  maxRetries: ~ = 10
}
