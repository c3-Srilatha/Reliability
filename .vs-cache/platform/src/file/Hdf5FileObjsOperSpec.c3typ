type Hdf5FileObjsOperSpec mixes FileObjsOperSpec {

  /**
   * If provided, data will be read only for this group. The include will only be applied at the leaf level.
   * Comma separated list of values for groups. By default, information about all the groups will be returned
   */
  leafLevelGroupInclude: string
}
