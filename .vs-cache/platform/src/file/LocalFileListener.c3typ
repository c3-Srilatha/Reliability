/**
 * An abstract type that that notifies its mixers to be notified of local file changes
 */
type LocalFileListener {

  /**
   * The local directory to listen to changes for.
   */
  localRoot: !string

  /**
   * Starts listening for changes in the specified root folder for the type
   *
   * @return true if the specified localRoot is already being watched by the type
   */
  start: final function(localRootUrl: !FileUrl): boolean

  /**
   * Stops listening for changes in the specified root folder for the type
   */
  stop: final function(localRootUrl: !FileUrl)

  /**
   * Action that will be invoked in case of a new file is created.
   */
  created: abstract member function(file: FileUrl)

  /**
   * Action that will be invoked in case of a new file is deleted.
   */
  deleted: abstract member function(file: FileUrl)

  /**
   * Action that will be invoked in case of a new file is modified.
   */
  modified: abstract member function(file: FileUrl)
}
