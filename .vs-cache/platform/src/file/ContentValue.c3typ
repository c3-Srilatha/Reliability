/**
 * Read-only in-memory document content with metadata and data.
 *
 * @see ContentBuffer
 */
inline type ContentValue mixes ReadOnlyContent {

  /**
   * The actual content value.
   */
  content: binary

  @deprecated(finalVersion='8.6', details='Use `Content#fromText` instead.')
  fromString: inline function(s: !?string, contentType: string): !ContentValue java | js | py

  encodedStream: ~ java | js
}
