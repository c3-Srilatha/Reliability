/**
 * Result of Content.grep operation
 */
type Content.GrepResult {

  /**
   * Patterns that matched (in order they first matched)
   */
  matched: [string serialized RegexPattern]

  /**
   * Match count per pattern (only populated for ALL mode)
   */
  counts: map<string serialized RegexPattern, int>

  /**
   * True if stopped reading before end of file (FIRST_ANY or FIRST_ALL modes)
   */
  stoppedEarly: boolean

  /**
   * Number of lines read
   */
  linesRead: int
}
