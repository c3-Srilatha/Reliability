/**
 * This type is used for encoding and decoding parts of URL strings. URL encoding rules are complex and idiosyncratic
 * so care must be taken to use the correct encoding:
 *  - "Path" encoding is for slash-separate paths (typically files). Slashes are _not_ encoded and spaces are encoded
 *    with "%20" (plus signs are not encoded). The #encodePath method does this.
 *  - "Query" encoding is for components of query strings and
 *    {@link https://developer.mozilla.org/en-US/docs/Web/HTTP/Methods/POST form POST bodies}.
 *    Spaces may be encoded with either a '+' sign or "%20" and slashes will be encoded as "%2F". This should
 *    probably be called "query component" for clarity. The #encode method does this.
 *
 * Here are the key differences between the encoding methods:
 *
 * | Input   | Path | Path Component | Query Component |
 * |---------|------|----------------|-----------------|
 * | /       | /    | %2F            | %2F             |
 * | _space_ | %20  | %20            | +               |
 * | +       | +    | +              | %2B             |
 * | =       | =    | =              | %3D             |
 * | &       | &    | &              | %26             |
 *
 * Note that #encode is very similar to JavaScript's
 * {@link https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/encodeURIComponent encodeURIComponent},
 * except that the latter uses "%20" for space instead of a plus sign.
 */
type UrlEncoder {

  /**
   * URL encodes a given path. Note that it'll will not encode '/' and ':' character and will not replace '+' with %2B;
   * but will replace ' ' with %20.
   *
   * @see #decodePath
   * @see https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/encodeURI
   */
  encodePath: inline function(src: !?string): string java | js

  /**
   * URL encodes a given path segment. Unlike #encodePath, this _will_ encode '/', in order to keep the number of
   * elements in the path constant.
   *
   * @see #decodePathComponent
   */
  encodePathComponent: inline function(src: !?string): string java | js

  /**
   * URL encodes a given string, i.e. % encode all special characters and replace ' ' with '+'. This is meant for
   * use in building query strings and form bodies and will encode '&' and '='.
   *
   * @see #decode
   * @see https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/encodeURIComponent
   */
  encode: inline function(src: !?string): string

  /**
   * URL encodes a given string. i.e. % encode all special characters and replace ' ' with '%20'.
   */
  encodeURIComponent: inline function(src: !?string): string

  /**
   * Decodes URL encoded path string.
   *
   * @see encodePath
   */
  decodePath: inline function(encoded: !?string): string java | js

  /**
   * Decodes URL encoded path segment.
   *
   * @see #encodePathComponent
   */
  decodePathComponent: inline function(src: !?string): string java | js

  /**
   * Decodes URL encoded string.
   *
   * @see #encode
   */
  decode: inline function(encoded: !?string): string

  /**
   *  Check if a string is definitely not URL encoded. May produce false negatives, but never false positives.
   *
   *  @param path
   *          whether to check for path encoding (slashes are not encoded)
   *  @param s
   * .        string to check
   *  @return true if the string is definitely not URL encoded
   */
  isNotEncoded: inline function(path: !?boolean, s: !?string): boolean
}
