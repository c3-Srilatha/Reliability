type JsonSerDeser mixes SerDeser {

  /**
   * Read a serialized json string value.
   */
  readValue: member function(content: !string, spec: FileObjsOperSpec): any

  /**
   * Write a value to a serialized json string.
   */
  writeValue: member function(value: !any, spec: FileObjsOperSpec): string

  readJsonLines: ~
}
