/**
 * Represents the ttl for temporary files and directories
 */
type TmpTtlEntry {

  /**
   * The url where the file or directory exists (could be a file or a directory)
   */
  url: !string

  /**
   * The instant after which the file or directory will be deleted
   */
  ttl: !datetime

  fetch:  function(): stream<TmpTtlEntry>
  create: member function()
  remove: member function()
}
