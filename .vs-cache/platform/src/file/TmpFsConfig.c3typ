/**
 * Temporary storage based file system configuration.
 */
type TmpFsConfig mixes LocalFsConfig {

  /*
   * Number of hours after which tmp files will be available for clean-up. Default value is configured via
   * {@link FileSystemConfig} and can be inspected by:
   * ```js
   * FileSystem.fileSystemConfig().tmp
   * ```
   * Please note that files **may remain longer than the configured TTL** based on when and how they are
   * being cleaned-up or deleted.
   *
   * e.g If a CronJob is setup to clean files every 8 hours, then based on when the TTL expires and the next
   * clean-up is triggered, an TTL expired file (available-for-deletion) can stay up to 7 hrs 59 mins before getting
   * cleaned-up.
   *
   * @see TmpFileSystem.reapTmpFiles
   * @see TmpFileSpec.ttl
   */
  ttlHours: int
}
