/**
 * Mode for Content.grep operation
 */
enum type Content.GrepMode {

  /**
   * Stop reading when any pattern matches any line (first match found)
   */
  FIRST_MATCH

  /**
   * Stop reading when all patterns have matched at least once
   */
  FIRST_MATCH_ALL

  /**
   * Read all lines and count all matches per pattern
   */
  ALL
}
