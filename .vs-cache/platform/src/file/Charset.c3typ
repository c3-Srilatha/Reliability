/**
 * Enum type of C3 supported Character sets (or Content Encoding)
 */
enum type Charset {

  UTF8 = 'UTF-8'

  ISO8859 = 'ISO-8859-1'

  ASCII = 'ASCII'

  /**
   * Standardize charset from variants such as lower-case (used in `Content-Type` headers).
   */
  fromString: function(s: !?string, failIfInvalid: boolean): string enum Charset java | js
}
