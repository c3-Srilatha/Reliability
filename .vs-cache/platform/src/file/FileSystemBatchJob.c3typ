/**
 * Batch job to process file system actions on each file in a distributed mode
 */
entity type FileSystemBatchJob extends BatchJob<FileSystemBatchJob, string, FileSystemBatchJobBatch> type key 'FSBJ' {

  /**
   * Url from which files need to be read
   */
  url: !string

  /**
   * Spec for batch file operation
   */
  spec: BatchFileOperationSpec

  /**
   * Specify if lambda action is batchAction or not
   */
  isBatchAction: boolean

  // TODO: PLAT-38785 change to primitive lambda

  /**
   * User action to be called for each file
   */
  action: !Lambda<function(file: File | [File])> schema name 'ACT'
}
