/**
 * Represents a virtual file system implemented using Apache Commons VFS.
 */
abstract type VirtualFileSystem mixes FileSystem {

  /**
   * Optional root OS folder to limit access to files.
   */
  root: private string

  /**
   * Creates an instance of a VirtualFileSystem rooted at the root. Root should be a URL.
   *
   * Throws an exception if 'root' can't be accessed.
   */
  fromRoot: function(root: !FileUrl): !VirtualFileSystem

  /**
   * deletes directory recursively. If directory does not exist, does nothing.
   *
   * @param encodedPath
   *           encodedPath relative to root
   * @param confirm
   *           flag to confirm.
   */
  deleteDir: member function(encodedPath: string, confirm: boolean, spec: FileOperationSpec)

  cloudResourceTypeName:   ~
  doCreateDir:             ~
  doOpenFile:              ~
  doListFiles:             ~
  doListFilesStream:       ~
  doListDirsStream:        ~
  doFileEncodedStream:     ~
  doFileEncodedPushStream: ~
  doDeleteFilesBatch:      ~
  doListDirectChildren:    ~
  supportsContentType:     ~
  capabilities:            ~
}
