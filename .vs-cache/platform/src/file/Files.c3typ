type Files {

  /**
   * order the given files in specified order.
   */
  order: function(files: [File], order: string serialized FileOrder = URL): [File]

  /**
   * Filter of files based on spec.
   *
   * @param spec
   *          provide path, match criteria
   * @returns list of files based on spec.
   */
  filter: function(files: [File], spec: FileFilterSpec): [File]

  /**
   * Filter of files based on spec.
   *
   * @param spec
   *          provide path, match criteria
   * @returns stream of files based on spec.
   */
  filterStream: function(files: Stream<File>, spec: FileFilterSpec): Stream<File>

  /**
   * Filter and order files based on spec.
   *
   * @param files
   *         list of files
   * @param order
   *         order by option
   * @param spec
   *          provide path, match criteria, order
   * @returns files based on spec.
   */
  filterAndOrder: function(files: [File], order: string enum FileOrder = URL, spec: FileFilterSpec): [File]
}
