/**
 * Represents a part of a piece of content. Used in MultipartUpload.
 */
type ContentPart {

  /**
   * URL of content part
   */
  url: string

  /**
   * Specifies where the part starts in the content.
   */
  offset: !int

  /**
   * The length of the part in terms of number of bytes. Length = -1 means end of file.
   */
  length: !int = -1

  /**
   * Create an instance of content pointer from a URL and optionally an offset and an length
   */
  fromUrl: function(url: !string, offset: int, length: int): !ContentPart
}
