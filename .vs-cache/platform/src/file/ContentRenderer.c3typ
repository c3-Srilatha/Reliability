/**
 * Render a content as HTML if possible.
 */
type ContentRenderer mixes HtmlRenderer {

  m_value:   private Content
  create:    inline function(arg: !Content): !ContentRenderer java | js-client
  menuTitle: inline ~ java | js-client
  title:     ~ java | js-client
  component: ~ js-client
  render:    ~ js-client
  toHtml:    ~ java | js-client
  toImage:   ~ java | js-client
  dispose:   ~ js-client
}
