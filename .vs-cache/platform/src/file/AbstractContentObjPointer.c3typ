/**
 * Represents a part of content which can deserialize into C3 objs
 */
type AbstractContentObjPointer<C> mixes AbstractContentPointer<C> {

  /**
   * Index of the obj at the offset.
   */
  startIndex: !int

  /**
   * Number of objs in the content from offset to length.
   */
  count: !int

  /**
   * csvHeader to use for deserialization; required if the contentType is text/csv.
   */
  csvHeader: string

  /**
   * Type to deserialize into
   */
  typeName: !string

  /**
   * Reads the objs from startIndex to count; uses csvHeader and typeName if required.
   * @return arry of objs
   */
  readObjs: member function(): [Obj]
}
