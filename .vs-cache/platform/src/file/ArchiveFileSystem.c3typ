/**
 * Represents a archive file system.
 * When creating (fromRoot, fromUrlOrEncodedPath, etc.) an archive file system,
 * the archive will be downloaded if necessary and expanded to allow for faster reading
 */
@beta
abstract type ArchiveFileSystem mixes VirtualFileSystem, FileSystemConfigurable<ArchiveFsConfig> {

  /**
   * Synchronizes all writes to archive file
   */
  synchronize: member function()

  /**
   * Check the TTL of all open archives.
   * Synchronizes any unarchived file systems which are reaped.
   */
  reapTTL: function()

  /**
   * Given an archive url, returns a url representing the archive itself
   */
  archiveUrl: function(url: FileUrl): !FileUrl

  /**
   * Given an archive url, returns a url representing the location on the
   * local file system where the expanded archive is stored
   */
  expandedArchiveUrl: function(url: !FileUrl): !FileUrl

  /**
   * Given an archive url, returns the part of the url which is the path inside the archive
   */
  archivePath: function(url: !FileUrl): !UrlPath

  rootUrl:              ~
  fromRoot:             ~
  fromUrlOrEncodedPath: ~
  urlToExternalUrl:     ~
  urlFromExternalUrl:   ~
  urlFromEncodedPath:   ~
  doListFilesStream:    ~
  cloudProvider:        ~
  doListDirectChildren: ~
  scheme:               abstract ~
}
