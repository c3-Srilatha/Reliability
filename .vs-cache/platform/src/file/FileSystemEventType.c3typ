/**
 * Enumeration of general file system notification events
 */
enum type FileSystemEventType {

  CREATED = 'CREATED'

  REMOVED = 'REMOVED'

  CREATED_BY_MULTIPART_UPLOAD = 'CREATED_BY_MULTIPART_UPLOAD'

  CREATED_BY_COPY = 'CREATED_BY_COPY'

  CREATED_BY_POST = 'CREATED_BY_POST'

  CREATED_BY_PUT = 'CREATED_BY_PUT'

  REMOVED_DELETE = 'REMOVED_DELETE'

  REMOVED_DELETE_MARKER_CREATED = 'REMOVED_DELETE_MARKER_CREATED'

  REDUCED_REDUNDANCY_LOST = 'REDUCED_REDUNDANCY_LOST'
}
