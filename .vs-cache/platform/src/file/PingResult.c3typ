/**
 * The result for pinging a URL.
 */
type PingResult mixes Result {

  /**
   * The target URL that will be checked.
   */
  url: !string

  /**
   * Indicate whether the target URL is reachable for access.
   */
  reachable: boolean

  /**
   * If the target is not reachable, an error indicating why not.
   */
  errorMsg: string

  /**
   * The time in nano seconds required for a packet to travel to the target URL and back again.
   */
  roundtripNanos: int
}
