/**
 * Helper type to represent Git file urls.
 * GitHub: git://token@github.com/owner/repoName/reference/encodedPath
 * GitHub: git://token@gitHubEnterpriseDomain/owner/repoName/reference/encodedPath
 * AzureDevOps: git://token@owner.visualstudio.com/projectName/_git/repoName/reference/encodedPath
 * AzureDevOps: git://dev.azure.com/owner/projectName/_git/repoName/reference/encodedPath
 *
 * In addition to standard {@link Url} fields like host and port, this type contains git-specific
 * fields like organization, project, repository, and reference.  Not all git implementations
 * use all of these fields.
 */
@beta
type GitUrl mixes Url {

  /**
   * The owner name.
   */
  owner: string

  /**
   * The project name.
   */
  project: string

  /**
   * The repository name.
   */
  repositoryName: !string

  /**
   * The URL-encoded branch or tag name
   */
  encodedReference: string

  /**
   * The {@link SourceControlHost} for this url.
   */
  sourceControlHost: !string enum SourceControlHost

  /**
   * The scheme of the original url, if this GitUrl was generated by {@link fromString}.  {@link toCloneableUrl}
   * will return a url with this scheme.
   */
  originalScheme: string

  /**
   * Return the decoded reference (from {@link encodedReference}).
   */
  reference: member function(): string

  /**
   * @return authority part of url. e.g. username:password@hostname
   */
  authority: inline member function(): string

  scheme: ~ = "git"

  /**
   * Takes a url and gives back a {@link GitUrl} instance. Validates that:
   * - The scheme is {@link FileSystemScheme.git}
   * - A {@link #repository} name can be parsed out
   * - A {@link #reference} can be parsed out
   */
  fromString: ~ java

  /**
   * Takes a url and gives back a {@link GitUrl} instance.
   * Does not validate against scheme or presence of other fields.
   */
  fromStringWithoutValidation: function(s: string): GitUrl

  /**
   * Convert this url to a string.  This string is not in an appropriate format for use with any
   * third party.  Use {@link toCloneableUrl} to generate a url string that can be used with git commands.
   * {@see GitUrlInterpreter.toString}
   */
  toString: ~ java

  /**
   * Convert the {@link GitUrl} into a remote url that actually points to the resource.
   * Returns a url which can be successfully used by a `git clone url` call.
   */
  toCloneableUrl: member function(): string

  /**
   * Determine the path of this url within the git base directory, which can be used on the git command line.
   *
   * @return {@link #encodedPath} without the leading "/"
   */
  getGitPath: member function(): string

  /**
   * Utility method to determine which source control system applies to a given url.  It will return
   * GITHUB, BITBUCKET, or AZURE_DEVOPS if the url appears to belong to one of those systems.  Otherwise,
   * it returns undefined.
   */
  sourceControlHostFromUrl: private function(url: !string): string enum SourceControlHost
}
