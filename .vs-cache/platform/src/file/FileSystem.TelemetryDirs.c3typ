/**
 * Enumerates the possible values for the telemetry file system (refer to {@link FileSystemMount.TELEMETRY}) sub-directories.
 */
enum type FileSystem.TelemetryDirs {

  /**
   * Jvm heap histograms by node
   */
  HEAP_HISTOGRAM = 'heaphistogram'

  /**
   * JVM heap dumps by node
   */
  HEAP_DUMP = 'heapdump'

  /**
   * Python profile dir
   */
  PY_PROFILE = "pyprofile"
}
