/**
 * Spec containing information about how {@link FileList} data needs to be ordered & read
 */
type FileListOrderSpec mixes FileObjsOperSpec {

  /**
   * If set, will order individual files. If not set (default), no ordering will be performed on the individual files
   * and the assumption is that the files are already ordered. When setting this property be sure to provide the
   * {@link FileListOrderSpec#serType} to indicate what type the order expression is applied to
   */
  filesAreNotOrdered: boolean
}
