/**
 * Enum representing different visual media types that can ve represented by {@link Image.c3typ}
 */
enum type VisualMediaType {

  /**
   * JPEG image.
   */
  JPEG = 'image/jpeg'

  /**
   * PNG image.
   */
  PNG = 'image/png'

  /**
   * BMP image.
   */
  BMP = 'image/bmp'

  /**
   * GIF image.
   */
  GIF = 'image/gif'

  /**
   * SVG image.
   */
  SVG = 'image/svg+xml'

  /**
   * ICO icon.
   */
  ICO = 'image/vnd.microsoft.icon'

  /**
   * ARF file.
   */
  ARF = 'application/arf'
}
