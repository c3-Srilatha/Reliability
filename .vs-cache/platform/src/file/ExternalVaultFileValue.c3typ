/**
 * In-memory file data for ExternalVault.
 */
type ExternalVaultFileValue mixes File {

  readString:    ~ java
  writeString:   member function(content: !?string, spec: FileObjsOperSpec): !mixing ExternalVaultFileValue
  writeObj:      member function(obj: !?Obj, spec: FileObjsOperSpec): !mixing ExternalVaultFileValue
  delete:        ~
  exists:        ~
  directoryUrl:  ~ java
  fileNameNoExt: ~ java
}
