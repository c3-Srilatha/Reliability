/**
 * Map Reduce implementation for File System
 */
entity type FileSystemMapReduce extends MapReduce<File, string, any, any> type key 'FSMR' {

  /**
   * Url from which files need to be read
   */
  url: !string

  /**
   * User provided context to be passed to the mapper and reducer lambdas
   *
   * @see MapReduceFilesOptions#context
   */
  context: any

  // TODO: PLAT-38785 change to primitive lambda

  /**
   * User provided mapper lambda
   */
  _mapper: private !Lambda<function(files: ![File]): map<string, any>>

  /**
   * User provided mapper lambda
   */
  _reducer: private !Lambda<function(interKey: string, interValues: [any]): any>

  reduce:         ~
  scanTargetType: ~
}
