/**
 * UrlQuery type is used for parsing and construct query of URL. Example of query: "ion=1&espv=8". Parameters can
 * appear multiple times and by convention a parameter without a value (no `=` sign) is interpreted as a flag.
 *
 * Note that all names and values are URL decoded (for example "%20" is replaced with a space).
 */
type UrlQuery {

  /**
   * Raw parameters is an map of multiple pairs of key and values. Each value is an array of specified values for each
   * occurrance of the parameter in the query string. If a parameter is specified without a value (no `=` sign),
   * the element is null.
   *
   * This is the highest fidelity method, but is the hardest to use. For code which does not need to handle flags or
   * repeated parameters, #stringParameters is more convenient.
   */
  rawParameters: map<!string, [?string]>

  /**
   * String parameters is an map of multiple pairs of key and values as strings. If a parameter is specified without a
   * value (no `=` sign), the value is null. If the parameter is specified multiple times, the values are concatenated
   * separated by commas.
   *
   * This is the most convenient method for code which doesn't need to handle flags or repeated query parameters.
   */
  stringParameters: member function(): map<!string, ?string>

  /**
   * Fetch the query of URL and parse query into UrlQuery type.
   * @param url
   *           A string represents URL.
   * @return UrlQuery type.
   */
  fromUrl: function(url: !string): UrlQuery

  /**
   * Parse the encoded query of URL into UrlQuery type.
   * @param urlQuery
   *           An encoded string represents the query of URL.
   * @return UrlQuery type.
   */
  fromEncodedString: inline function(encodedUrlQuery: !string): UrlQuery

  /**
   * Return encoded query string of the instance.
   *
   * @return a string representation of encoded URL query.
   */
  encode: inline member function(): !string

  /**
   * Replace the parameters with a set built from the simple map of strings. Note that this does not provide full
   * fidelity of #rawParameters.
   *
   * @see #stringParameters
   */
  withStringParameters: member function(params: map<string, string>): mixing UrlQuery
}
