/**
 * Object pool for Apache Commons VFS FileSystemManager instances.
 * Pooling managers helps reduce lock contention in high-concurrency scenarios.
 */
type VfsManagerPool mixes ObjectPool<native> {

  /**
   * Initializes the VFS manager pool with the specified pool configuration.
   *
   * @param config
   *        VFS-specific pool configuration.
   *
   * @return the initialized VFS manager pool.
   */
  init: function(config: !VfsManagerPoolConfig): VfsManagerPool

  /**
   * Initializes the VFS manager pool with default configuration.
   *
   * @return the initialized VFS manager pool with default settings.
   */
  initWithDefaults: function(): VfsManagerPool

  /**
   * Borrows a FileSystemManager from the pool.
   */
  borrowManager: inline member function(): @java(class="org.apache.commons.vfs2.FileSystemManager") native

  /**
   * Returns a FileSystemManager to the pool.
   *
   * @param manager
   *        FileSystemManager to return.
   */
  returnManager: inline member function(manager: @java(class="org.apache.commons.vfs2.FileSystemManager") native)

  /**
   * Destroys a FileSystemManager rather than returning it to the pool.
   *
   * @param manager
   *        FileSystemManager to destroy.
   */
  destroyManager: inline member function(manager: @java(class="org.apache.commons.vfs2.FileSystemManager") native)
}
