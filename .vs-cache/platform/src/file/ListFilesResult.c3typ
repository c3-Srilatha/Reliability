/**
 * The following encapsulates listFiles result.
 */
type ListFilesResult mixes Result {

  /**
   * List of files.
   */
  files: [File]

  /**
   * If there are large number of files with path prefix that was used for listFiles call then nextMarker
   * can be used to retrieve subsequent set of files.
   */
  nextMarker: string
}
