/**
 * Represents a location in a piece of content.
 */
type ContentPointer {

  /**
   * Cache of URL.
   */
  m_url: private string

  /**
   * Cache of content.
   */
  m_content: private Content

  /**
   * Cache of offset.
   */
  m_offset: private int

  /**
   * URL of content.
   */
  url: member function(): string

  /**
   * Load the content for the URL.  Always use this method because the content may be
   * specialized for the content type.
   */
  content: member function(): !Content

  /**
   * The offset from the beginning of the content (0-based).
   */
  offset: member function(): !int

  /**
   * Create an instance of content pointer from a URL and optionally an offset.
   * If the offset is not specified, zero (beginning of file) is assumed.
   *
   * @param url resource URL
   * @param offset pointer offset (0-based)
   */
  fromUrl: function(url: !string, offset: int): !ContentPointer

  /**
   * Create an instance of content pointer from a content value and optionally an offset.
   * If the offset is not specified, zero (beginning of file) is assumed.
   *
   * @param content content value
   * @param offset pointer offset (0-based)
   */
  fromContent: function(content: !Content, offset: int): !ContentPointer
}
