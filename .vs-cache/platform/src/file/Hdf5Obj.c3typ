/**
 * C3 Type wrapping content of HDF5 file; note that this is a state-full type and needs call to #close to free up the
 * resources.
 */
type Hdf5Obj {

  /**
   * Name of this object
   */
  name: string

  /**
   * Named attributes; value can be a primitive or array.
   */
  attrs: map<string, any>

  /**
   * Named variables.
   */
  vars: map<string, Hdf5Var>

  /**
   * Children.
   */
  groups: map<string, Hdf5Obj>

  /**
   * Closes all resources
   */
  close: member function()

  _ncFile: private native
}
