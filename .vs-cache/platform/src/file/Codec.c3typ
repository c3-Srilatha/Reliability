/**
 * Base type for content encoding / decoding.
 */
type Codec mixes Value {

  /**
   * Lookup Codec type from Content Encoding name.
   */
  typeFromContentEncoding: function(contentEncoding: !string): !Type

  /**
   * Name of this Content Encoding. E.g. "gzip"
   */
  contentEncoding: abstract function(): !string

  /**
   * Encodes stream.
   */
  encode: abstract function(content: !BytePushStream): !BytePushStream

  /**
   * Encodes bytes.
   */
  encodeBytes: function(content: !binary): !binary

  /**
   * Encodes bytes.
   */
  encodeString: function(content: !string): !binary

  /**
   * Decodes stream.
   */
  decode: abstract function(content: !ByteStream): !ByteStream

  /**
   * Decodes bytes.
   */
  decodeBytes: function(content: !binary): !binary

  /**
   * Decodes bytes.
   */
  decodeString: function(content: !binary): !string
}
