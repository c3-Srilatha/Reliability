/**
 * The Console UI can be extended by defining instances of types that mix in
 * ConsoleTool and implement the *execute* method.
 */
entity type ConsoleTool schema name 'CONSOLE_TOOL' {

  /**
   * Label to show in the tools menu.
   */
  label: !string

  /**
   * Longer description of function to show on extended hover.
   */
  tooltip: string

  /**
   * Name of the Glyphicon (Bootstrap 3) icon to use in the menu, if any.
   */
  icon: string

  /**
   * The action to be invoked by the menu item.
   */
  action: !ActionRef

  /**
   * Whether or not this Tool requires a file upload
   */
  fileUpload: boolean
}
