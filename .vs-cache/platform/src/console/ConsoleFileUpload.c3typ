/**
 * This is the C3 Type that wraps the JS File interface. This
 * type is useful as an input to a function that you want to
 * use in a {@link ConsoleTool}.
 */
type ConsoleFileUpload {

  /**
   * Name of the file the user chose
   */
  fileName: string

  /**
   * Type of the file the user chose
   */
  fileType: string

  /**
   * Content of the file the user chose
   */
  content: string
}
