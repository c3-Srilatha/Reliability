/**
 * Base type for {@link Workflow.Vertex}'s that execute an {@link ActionRef}.
 * See {@link Workflow.Action} and {@link Workflow.Nested.Action}.
 */
abstract type Workflow.ActionBase mixes Workflow.Vertex {

  /**
   * The action to run.
   */
  action: ActionRef

  /**
   * Automatically infers {@link #inTypes}, {@link #outTypes}, {@link #id}, and {@link #name} from {@link #action}.
   */
  beforeMake: ~

  /**
   * Helper method to quickly retrieve this vertex's {@link ActionRef#actionName}
   */
  actionName: inline member function(): !string

  /**
   * Helper method to quickly retrieve this vertex's {@link ActionRef#typeName}
   */
  typeName: inline member function(): !string
}
