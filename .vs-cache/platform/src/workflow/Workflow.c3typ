/**
 * The {@link Workflow} is an intermediate representation language that represents a directed port graph of
 * steps. Each {@link Workflow.Vertex} represents a specialized step.
 * There are several types of vertices:
 * 1. Action-based Vertex
 *    - e.g. Action, Batch, MapReduce, Export, Import
 *    - explicit inputs and outputs, represented by input and output ports, respectively
 *    - "$start" input port, whose data is typed as {@link Workflow.Signal}. This is often, but not required to be, connected
 *      to a "$success" output port of another vertex, indicating an implicit data relationship for e.g. non-pure functions
 *    - "$success" output port, whose data is typed as {@link Workflow.Signal}. This is often, but not required to be, connected
 *      to a "$start" input port of another vertex, indicating an implicit data relationship for e.g. non-pure functions
 *    - "error" output port, whose data is typed as {@link Error}. This can be used as an input to subsequent steps
 *      for custom error-handling
 *    - NOTE: the "$" prefix naming convention is used to distinguish "control" (i.e. {@link Workflow.Signal}) from traditional "data"
 * 2. Input/Output Vertex
 *    - e.g. Input, Output, Const
 *    - represent high-level arguments and high-level return values for the workflow itself
 * 3. Control Flow
 *    - e.g. Conditional
 *
 * @see workflow.c3doc.md
 */
entity type Workflow mixes FlowGraph<Workflow.Vertex> {

  /**
   * Optional link to a parent {@link FlowGraph}. This field is intended to be populated when there exists
   * translations between {@link FlowGraph}s and allows the execution metadata to be aggregated to the original
   * {@link FlowGraph}.
   */
  /*
   * TODO: PLAT-36603, should be PersistableFlowGraph, but gives code-gen error
   * parent: FlowGraph
   */
  /*
   * Optional action vertex that will start after the execution of the rest of the Workflow and after the
   * Workflow has been transitioned to a finished state (e.g. completed, failed, canceled).
   * - the action must accept `run: Workflow.Run` as an argument. This argument will be populated by the Workflow
   * so that the action can access the execution data/metadata, if necessary.
   * - the action is executed asynchronously, so there is NO guarantee that the action completes before the
   * Workflow is transitioned to a finished state.
   * - the action must be idempotent as there are NO guarantee that the action will be executed only once
   *
   * {@link Workflow.Run#finallyVertexWorkflowRun}
   * {@link SimpleSynchronousPyRun#finallyVertexWorkflowRun}
   * {@link MlPipelineToWorkflowTranslator#cleanup}
   */
  finallyVertex: Workflow.Action

  /**
   * @param strategy
   *           optimization strategy to use to optimize this {@link Workflow}. If unspecified, then the default instance will
   *           be used.
   * @return a valid {@link Workflow} that is functionally equivalent to the original, after applying the
   *           optimization specified in the given optimization strategy.
   */
  optimize: member function(strategy: Workflow.OptimizationStrategy): !mixing Workflow

  /**
   * Aggregate execution profiling results by vertex.
   *
   * @param run
   *           the execution run for which to aggregate the metadata for. The {@link WorkflowExecutorRun#parent} should
   *           match this type instance.
   * @return a map with key id of vertex executed and value the results accumulated
   *         by action profiling.
   */
  executionMetadataByVertex: member function(run: !WorkflowExecutorRun): map<string, Log.Entry.Action>

  /**
   * Aggregate execution profiling results by parent vertex. It is up to the implementing type to determine how
   * to map its vertices to its parent vertices.
   * NOTE: this function only works if {@link #parent} is populated!
   *
   * @param run
   *           the execution run for which to aggregate the metadata for. The {@link WorkflowExecutorRun#parent} should
   *           match this type instance.
   * @return a map with key id of parent vertex executed and value the results accumulated
   *         by action profiling.
   */
  executionMetadataByParentVertex: member function(run: !WorkflowExecutorRun): map<string, Log.Entry.Action>

  /**
   * Create a visualization plotting start and end timestamps for all vertices in {@link #executionMetadataByVertex}.
   *
   * @param run
   *           the execution run for which to plot the metadata for. The {@link WorkflowExecutorRun#parent} should
   *           match this type instance.
   * @return the native plot object.
   */
  plotExecutionTimestamps: member function(run: !WorkflowExecutorRun): native py

  /**
   * De-duplicate {@link Workflow.Const} vertices such that:
   *  ```
   *  + - - - - - - - +                    + - - - - - - - - - -+
   *  '  FlowGraph A  '                    '  FlowGraph Merged  '
   *  '               '                    '                    '
   *  ' +-----------+ '                    ' +----------------+ '
   *  ' |  "field"  | '                    ' |    "field"     | '
   *  ' +-----------+ '                    ' +----------------+ '
   *  '   |           '                    '   |                '
   *  '   |           '                    '   |                '
   *  '   v           '                    '   v                '
   *  ' +-----------+ '                    ' +----------------+ '
   *  ' |   pluck   | '  A.mergeWith(B) =   |     pluck      | '
   *  ' +-----------+ '                    ' +----------------+ '
   *  '               '                    '   |                '
   *  + - - - - - - - +                    '   |                '
   *      |                                '   v                '
   *      |                                ' +----------------+ '
   *      v                                ' |      add       | '
   *  + - - - - - - - +                    ' +----------------+ '
   *  '  FlowGraph B  '                    '                    '
   *  '               '                    + - - - - - - - - - -+
   *  ' +-----------+ '
   *  ' |    add    | '
   *  ' +-----------+ '
   *  '               '
   *  + - - - - - - - +
   *  ```
   * As opposed to the following graph where "field" is duplicated because both "pluck" and "add" have a path to
   * the "field" constant.
   *  ```
   *                              + - - - - - - - - - - - +
   *                              '   FlowGraph Merged    '
   *                              '                       '
   *                              ' +-------------------+ '
   *                              ' | field 1 ("field") | '
   *                              ' +-------------------+ '
   *                              '   |                   '
   *                              '   |                   '
   *                              '   |                   '
   *  + - - - - - - - - - - - - -     |                   '
   *  '                               v                   '
   *  ' +-------------------+       +-------------------+ '
   *  ' | field 2 ("field") | ----> |       pluck       | '
   *  ' +-------------------+       +-------------------+ '
   *  '                               |                   '
   *  + - - - - - - - - - - - - -     |                   '
   *                              '   |                   '
   *                              '   |                   '
   *                              '   v                   '
   *                              ' +-------------------+ '
   *                              ' |        add        | '
   *                              ' +-------------------+ '
   *                              '                       '
   *                              + - - - - - - - - - - - +
   *  ```
   */
  @typesys(todo="PLAT-130530 - Remove FlowGraph#mergeWith override from Workflow")
  mergeWith: ~

  /**
   * Extracts a subgraph, specified by list of member vertices, from this graph. Converts "dangling" edge inputs
   * into explicit {@link Workflow.Input} and {@link Workflow.Output} vertices. Vertex ids (and names) will be
   * preserved.
   * @param sub
   *           list of vertices (and corresponding) edges to extract as a subgraph.
   * @return the subgraph.
   */
  subGraph: member function(sub: ![Workflow.Vertex]): !mixing Workflow

  /**
   * Starts a workflow using any specified workflow executor.
   * @param inputs:
   *           Map of input values to be used for the workflow execution.  The key of the map must be the name of a vertex that
   *           mixes Workflow.Input.
   * @param spec:
   *           An instance of WorkflowExecutionSpec to specify details on how the workflow execution will happen.
   * @return the new workflow run.
   */
  @call(stayInEngine=true)
  start: member function(inputs: map<string, any>, spec: WorkflowExecutionSpec): WorkflowExecutorRun java | py

  /**
   * Previous asynchronous executions for this workflow
   */
  @db(order='descending(started, true)')
  asyncRuns: [Workflow.Run](workflowId)

  /**
   * @return the last asynchronous run for the workflow.
   */
  lastAsyncRun: member function(): Workflow.Run

  /**
   * Removes all instances of {@link Workflow.Run} and {@link Workflow.Run.Vertex} that have exceeded
   * their time to live.
   * Called by `workflow-run-cleanup` {@link CronJob}. See {@link Workflow.Run.Config} for configurations.
   */
  removeStaleInstances: function()

  /**
   * Extracts the {@link Action.Requirement} for the {@link Workflow} for each input of {@link WithInitialState} type.
   * @return a list of {@link Action.Requirement requirements} for each {@link WithInitialState} object.
   */
  @beta
  extractWithInitialStateObjsPerRequirement: private inline member function(inputs: map<string, any>)
                                                                     : !?map<string serialized Action.Requirement, !?[!WithInitialState]> py
}
