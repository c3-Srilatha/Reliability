/**
 * A specialized {@link Workflow.Vertex} that represents a {@link BatchJob}.
 * Every {@link Workflow.Batch} has two input ports: a port "options" and a port "$start". The "options" input, if connected,
 * will override the options provided in the {@link #options} field.
 * Every {@link Workflow.Batch} has a two output ports: "$success" and "error". NOTE: this vertex type has no other output.
 * See {@link Workflow} for more details on ports "$start", "$success", and "error".
 * ```
 * -------------------                         ---------------------
 * | Workflow.Action | $success ---> $start    |                   |
 * -------------------                         |                   | $success -----------> ...
 *                                             |  Workflow.Batch   |
 * -------------------                         |                   | error ----------------> ...
 * | Workflow.Action | out --------> options   |                   |
 * -------------------                         ---------------------
 * ```
 */
type Workflow.Batch mixes Workflow.Vertex {

  /**
   * Batch job to run.
   */
  job: !BatchJob

  /**
   * Options to run the batch job with.
   */
  options: Obj

  /**
   * Handler for customizing how to start the {@link job}.
   * If unspecified, then {@link JobBase#start} of {@link #job} will be used.
   */
  handlerType: Type<<Workflow.JobHandler>>

  /**
   * Helper constructor for vertex.
   * @param job
   *           batch job to run.
   * @param options
   *           options to run the batch job with.
   * @param name
   *           name for this vertex.
   * @param handlerType
   *           see {@link #handlerType}.
   * @return new vertex.
   */
  fromJob: function(job: !BatchJob,
                    options: Obj,
                    name: string,
                    handlerType: Type<<Workflow.JobHandler>>): !mixing Workflow.Batch

  requiresPolling: ~
}
