/**
 * Specializations for the {@link Workflow.Monitorable#summary} API.
 */
type Workflow.Monitorable.SummarySpec mixes FetchSpec {

  /**
   * If true, the summary will be refreshed until the monitorable is finished running.
   */
  watch: boolean

  /**
   * The sleep time, in seconds, between each summary refresh.
   */
  watchInterval: int = 1

  /**
   * The total timeout, in seconds, to prevent infinite refreshes.
   */
  watchTimeout: int = 300
}
