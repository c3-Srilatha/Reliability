/**
 * This type represents an execution representation that a C3-supported workflow execution engine can execute.
 * Typically, produced from the result of {@link #translate} on a {@link Workflow}.
 */
abstract type WorkflowExecutionRepresentation {

  /**
   * Optional link to a parent {@link FlowGraph}. This field is intended to be populated when there exists
   * translation between {@link FlowGraph} and {@link WorkflowExecutionRepresentation}. It allows the execution metadata to
   * be aggregated to the original parent {@link FlowGraph}.
   */
  // TODO: PLAT-36603, should be PersistableFlowGraph, but gives code-gen error
  parent: Workflow

  /**
   * Translate the given {@link Workflow} to this execution representation.
   * @param workflow
   *           the {@link Workflow} to be translated.
   * @return an execution representation which is equivalent to the input {@link Workflow}.
   */
  fromWorkflow: abstract function(workflow: Workflow): mixing WorkflowExecutionRepresentation

  /**
   * Execute this representation using an appropriate execution engine and collect results and any other metadata.
   * @param inputs
   *         input data to the execution.
   * @param spec
   *         optional configurations for the execution.
   * @return the {@link WorkflowExecutorRun} created as a result of execution.
   */
  execute: abstract member function(inputs: !?map<string, any>, spec: WorkflowExecutionSpec): WorkflowExecutorRun
}
