/**
 * Result of a {@link WorkflowExec.Simple}
 */
@deprecated(details="Use Workflow and Workflow.Run instead")
type WorkflowExecRun.Simple mixes WorkflowExecutorRun {

  /**
   * Holds the execution results from the synchronous execution
   * Keys correspond to the Ids of the Workflow's sink vertices. see {@link FlowGraph.Vertex#id)
   */
  results: private !map<string, any>

  /**
   * Execution Representation associated with this run.
   */
  er: Workflow

  /**
   * The spec that workflow was started with
   */
  spec: WorkflowExecutionSpec

  status:    ~
  visualize: ~ py
  summary:   ~
  errors:    ~
  magnify:   ~
}
