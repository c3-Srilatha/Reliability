/**
 * Specialization of {@link SimpleSynchronousPyRun} that contains native fields.
 * Developer Note: this type is not meant to be upserted, only to be used as input to the native finallyVertex
 * cleanup function, if it exists.
 */
private type NativePyRun mixes SimpleSynchronousPyRun {

  /**
   * Input values provided to the executor.
   */
  inputValues: private map<string, any>
}
