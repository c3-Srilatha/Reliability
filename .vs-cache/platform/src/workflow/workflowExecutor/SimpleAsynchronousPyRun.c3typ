/**
 * Represent run of a workflow that executes Python `async def` coroutines asynchronously.
 *
 * Usage:
 * ```python
 * async def _generate_async(model, prompts):
 *   await asyncio.sleep(1)
 *   return prompt + "resp"
 *
 * def process(...):
 *   c3.MlOperationRun(run=c3.SimpleAsynchronousPyRun.start(_generate_async(model, prompts)),
 *                     opName=[c3.MlDataOpName.ASYNC_PROCESS])
 * ```
 *
 * This can be useful in persisted python executes.
 * Please note that opName should be mandatory set to `c3.MlDataOpName.ASYNC_PROCESS`.
 */
type SimpleAsynchronousPyRun mixes WorkflowExecutorRun {

  /**
   * Waits for this {@link SimpleAsynchronousPyRun} to be completed. If the run is already completed, this method will return immediately.
   * @param timeoutMinutes
   *          Maximum time to wait for operation to complete, in minutes.
   *          Either {@link WaitSpec#maxTotalMillis} in {@link #spec} or {@link #timeoutMinutes} will specify the maximum wait time, but {@link #timeoutMinutes}
   *          will take precedence over {@link WaitSpec#maxTotalMillis}. However, the timeoutMinutes can be only given in integer minutes which limit the lower-bound
   *          to 60 seconds, while specifying with {@link #spec} uses millis unit.
   * @param displayStatus
   *          Not used for this type.
   * @param spec
   *         {@link WaitSpec} for customization of sleep time between polling status of {@link #run}. Only {@link WaitSpec#maxTotalMillis} is used.
   * @return the status for this {@link WorkflowExecutorRun} after completion
   */
  waitForCompletion: inline member function(timeoutMinutes: int,
                                            displayStatus: boolean = False,
                                            spec: WaitSpec): !Workflow.Status

  /**
   * Wait for run to complete.
   * Throws exception if run fails/timeouts.
   * Returns results of the run.
   */
  waitForResults: inline member function(timeoutMillis: int = 300000): any

  /**
   * Reference to json serialized results of the run.
   */
  reference: private @java(class="java.util.concurrent.atomic.AtomicReference<String>") !native

  status:           inline ~
  executionResults: inline ~
  visualize:        ~ py
  summary:          ~
  errors:           ~
  magnify:          ~
}
