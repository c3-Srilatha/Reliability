/**
 * Interface to use from python.
 */
native py remix type SimpleAsynchronousPyRun {

  /**
   * Return asyncio's event loop and ensures that it's running in daemon thread.
   */
  eventLoop: inline function(): !native py

  /**
   * Starts coroutine in the {@link #eventLoop event loop} and returns {@link SimpleAsynchronousPyRun} as future-like object.
   */
  start: inline function(coroutine: !native): !mixing SimpleAsynchronousPyRun py-py4j
}
