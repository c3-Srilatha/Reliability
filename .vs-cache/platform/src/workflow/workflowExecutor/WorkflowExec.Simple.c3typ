/**
 * A simple, single threaded Workflow Executor
 */
@deprecated(details="Use Workflow and Workflow.Run instead")
type WorkflowExec.Simple {

  /**
   * Executes a Workflow
   */
  execute: function(graph: !Workflow, spec: WorkflowExecutionSpec): !WorkflowExecRun.Simple

  /**
   * Executes a specific action in a Workflow
   */
  execute: function(vertex: !Workflow.Action, graph: !Workflow): any

  /**
   * Emits a value from the given vertex.
   */
  executeVertex: function(vertex: !Workflow.Vertex, graph: !Workflow, evaluated: !MapBuilder<string, any>): any
}
