/**
 * {@link WorkflowExecutorRun} provides an abstract representation of a specific run of a {@link WorkflowExecutionRepresentation}.
 */
abstract type WorkflowExecutorRun mixes Workflow.Monitorable {

  /**
   * @return overall status of the execution.
   */
  status: abstract member function(): Workflow.Status

  /**
   * @return map of <k, v> -> <result name, result>.
   */
  executionResults: abstract member function(): map<string, any>

  /**
   * Waits for this {@link WorkflowExecutorRun} to be completed. If the run is already completed, this method will return immediately.
   * @param timeoutMinutes
   *          maximum time to wait for operation to complete, in minutes.
   *          Either {@link WaitSpec#maxTotalMillis} in {@link #spec} or {@link #timeoutMinutes} will specify the maximum wait time, but {@link #timeoutMinutes}
   *          will take precedence over {@link WaitSpec#maxTotalMillis}. However, the timeoutMinutes can be only given in integer minutes which limit the lower-bound
   *          to 60 seconds, while specifying with {@link #spec} uses millis unit.
   * @param displayStatus
   *          If True, display current status periodically while waiting for completion of {@link #run}
   * @param spec
   *         {@link WaitSpec} for customization of sleep time between polling status of {@link #run}
   * @return the status for this {@link WorkflowExecutorRun} after completion
   */
  waitForCompletion: member function(timeoutMinutes: int,
                                     displayStatus: boolean = False,
                                     spec: WaitSpec): !Workflow.Status py

  /**
   * Create a visualization plotting start and end timestamps for all vertices in {@link #executionMetadataByAction}.
   *
   * @return the native plot object.
   */
  plotExecutionTimestamps: member function(): native py-client

  /**
   * Id of the action that executes {@link startWorkflow}
   */
  startingActionId: string

  flamegraph:     ~ py
  flamegraphJson: ~ py-server
}
