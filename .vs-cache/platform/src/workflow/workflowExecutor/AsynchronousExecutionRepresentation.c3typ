/**
 * {@link AsynchronousQueueExecutionRepresentation} is the execution representation for executing a {@link Workflow} using
 * the invalidation queues.
 */
type AsynchronousExecutionRepresentation mixes WorkflowExecutionRepresentation {

  /**
   * Developer Note:  {@link #fromWorkflow} of this representation is trivial (i.e. one-to-one mapping between workflow and
   * representation for execution) because the invalidation queue based executor is able to consume the {@link Workflow}
   * {@link FlowGraph} directly.
   */
  workflow: private !Workflow

  fromWorkflow: ~ java | py
  execute:      ~ java | py
}
