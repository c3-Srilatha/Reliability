/**
 * Abstract interface that helps with mapping an asynchronous {@link Workflow.Nested.Action#action} to the underlying
 * {@link WorkflowExecutorRun} that implements it.
 * See {@link Workflow.Nested.Action} for more details.
 * See {@link MlOperationRun.Handler} for an example usage.
 */
abstract type Workflow.Nested.Action.Handler {

  /**
   * This will be called on the return value of {@link Workflow.Nested.Action#action}. The output {@link WorkflowExecutorRun}
   * will be used to determine when the asynchronous processing is finished.
   *
   * @param actionOutput
   *           the output of the action in {@link Workflow.Nested.Action#action}.
   * @return the underlying workflow run that implements the asynchronous action.
   */
  runFromActionOutput: abstract function(actionOutput: !any): !WorkflowExecutorRun

  /**
   * This will be called on the return value of {@link Workflow.Nested.Action#action} once the underlying {@link WorkflowExecutorRun}
   * is finished. The output will represent the result of the asynchronous action processing.
   *
   * @param actionOutput
   *           the output of the action in {@link Workflow.Nested.Action#action}.
   * @return the result from the underlying workflow run that implements the asynchronous action.
   */
  resultFromActionOutput: abstract function(actionOutput: !any): any
}
