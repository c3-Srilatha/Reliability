/**
 * A specialized {@link Workflow.Vertex} that represents a {@link ActionRef}.
 * Every {@link Workflow.Action} has multiple input ports: a port "$start" and a number of ports whose names
 * match the arguments to the configured {@link #action}.
 * Every {@link Workflow.Action} has three output ports: an optional port "out", a port "$success", and a port "error".
 * The "out" output represents the return value of the {@link #action}, if any.
 * See {@link Workflow} for more details on ports "$start", "$success", and "error".
 * ```
 * -------------------                            ---------------------
 * | Workflow.Action | $success --------> $start  |                   | $success --------> ...
 * -------------------                            |                   |
 *                                                |  Workflow.Action  | error -----------> ...
 * -------------------                            |                   |                       -------------------
 * | Workflow.Input  | out -------------> arg1    |                   | out -------------> in | Workflow.Output |
 * -------------------                            ---------------------                       -------------------
 * ```
 */
type Workflow.Action mixes Workflow.ActionBase, App.NodePoolAware {

  /**
   * The constraints need to be met for executing this action.
   */
  hardwareConstraint: HardwareConstraint

  /**
   * Overrides the action requirement associated with the {@link #action}, to be used for action execution
   */
  // TODO: PLAT-47640 should be string serialized Action.Requirement
  requirementOverride: private string

  /**
   * Helper constructor for a vertex.
   * @param action
   *           action that this vertex represents.
   * @param name
   *           (optional) name for this vertex.
   * @param inNames
   *           names of input ports that the new vertex will have. These should correspond to the names of the action
   *           method parameters.
   * @param outNames
   *           names of output ports that the new vertex will have. This corresponds to the return value of an action, in which
   *           case the name is only for user reference. The only exception is if a return type has named fields (e.g. `Obj`, `Map`).
   *           In this case, the output port names can represent field paths in the scope of the target method return value and will
   *           be extracted properly for subsequent steps. Example for machine learning, where a native library may return
   *           two conceptual outputs that need to be routed differently in subsequent steps. Note the dot-notation
   *           field path syntax which signals a multi-output.
   *           ```
   *           outNames = ["out.images", "out.boundingBoxes"]
   *           // get output from action
   *           out = action.call(...)
   *           // if `out` return is a `Map`
   *           outImages = out["images"]
   *           outBoundingBoxes = out["boundingBoxes"]
   *           // if `out` return is an `Obj`
   *           outImages = out.images
   *           outBoundingBoxes = out.boundingBoxes
   *           ```
   * @param actionRequirement
   *           the {@link Action.Requirement minimal action requirement} for this action to be executed in
   * @return new vertex
   */
  fromAction: function(action: !ActionRef,
                       name: string,
                       inNames: [string],
                       outNames: [string],
                       actionRequirement: string serialized Action.Requirement): !Workflow.Action

  /**
   * Helper method for creating {@link Workflow.Action} from ActionRef. Automatically infers fields from
   * {@link FlowGraph.Vertex}.
   */
  fromActionRef: function(action: !ActionRef,
                          actionRequirement: string serialized Action.Requirement): !Workflow.Action

  /**
   * @return a list of action requirements for all overloads of the action specified.
   */
  requirementsForAllOverloads: private member function(): ![string serialized Action.Requirement]

  requiresPolling: ~
}
