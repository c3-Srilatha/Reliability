/**
 * A {@link FlowGraph.Visitor} for visiting a Workflow. Defines visitor methods for {@link Workflow.Action} and
 * {@link Workflow.Const} vertices.
 */
abstract type Workflow.Visitor<C> mixes FlowGraph.Visitor<C> {

  /**
   * {@link Workflow.Action} visitor to be overridden by subtype
   */
  action: abstract function(action: !?Workflow.Action, ctx: C): C

  /**
   * {@link Workflow.Const} visitor to be overridden by subtype
   */
  const: abstract function(const: !?Workflow.Const, ctx: C): C

  /**
   * {@link Workflow.Input} visitor to be overridden by subtype
   */
  input: abstract function(input: !?Workflow.Input, ctx: C): C

  /**
   * {@link Workflow.Output} visitor to be overridden by subtype
   */
  output: abstract function(output: !?Workflow.Output, ctx: C): C

  /**
   * {@link Workflow.Make} visitor to be overridden by subtype
   */
  make_: abstract function(make: !?Workflow.Make, ctx: C): C

  /**
   * {@link Workflow.Field} visitor to be overridden by subtype
   */
  field: abstract function(field: !?Workflow.Field, ctx: C): C
}
