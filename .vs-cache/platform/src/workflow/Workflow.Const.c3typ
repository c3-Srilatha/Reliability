/**
 * A specialized {@link Workflow.Vertex} that represents a constant vertex.
 * Every {@link Workflow.Const} has no input ports.
 * Every {@link Workflow.Const} has a single output port "out".
 * ```
 * -----------------                   -------------------
 * | Workflow.Const| out ---------> in | Workflow.Action | ...
 * -----------------                   -------------------
 * ```
 */
type Workflow.Const mixes Workflow.Vertex {

  /**
   * The constant value to emit.
   */
  const: ?any

  /**
   * Helper method for creating a {@link Workflow.Const}.
   */
  fromConst: function(const: !?any): Workflow.Const

  /**
   * Populate {@link FlowGraph.Vertex#outTypes} with guessed {@link ValueType} of {@link #const}.
   *
   * @see ValueType#guessType
   */
  beforeMake: ~
}
