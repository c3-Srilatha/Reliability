/**
 * A specialized {@link Workflow.Vertex} that represents a {@link Workflow} job.
 * Every {@link Workflow.Nested} has two input ports: a port "options" and a port "$start". The "options" input, if connected,
 * will override the options provided in the {@link #options} field.
 * Every {@link Workflow.Nested} has two output ports: "$success" and "error". NOTE: this vertex type has no other output.
 * See {@link Workflow} for more details on ports "$start", "$success", and "error".
 * ```
 * -------------------                         -----------------------
 * | Workflow.Action | $success ---> $start    |                     |
 * -------------------                         |                     | $success -----------> ...
 *                                             |  Workflow.Nested    |
 * -------------------                         |                     | error --------------> ...
 * | Workflow.Action | out --------> options   |                     |
 * -------------------                         -----------------------
 * ```
 */
type Workflow.Nested mixes Workflow.Vertex {

  /**
   * Workflow job to run.
   */
  job: !Workflow

  /**
   * Options to run the workflow job with.
   */
  options: map<string, any>

  /**
   * Helper constructor for vertex.
   * @param workflow
   *           workflow job to run.
   * @param options
   *           options to run the workflow job with.
   * @param name
   *           name for this vertex.
   * @return new vertex.
   */
  fromWorkflow: function(workflow: !Workflow, options: map<string, any>, name: string): !mixing Workflow.Nested

  requiresPolling: ~
}
