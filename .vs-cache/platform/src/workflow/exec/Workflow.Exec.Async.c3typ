/**
 * This executor takes the {@link Workflow} intermediate representation, parses it, and {@link #execute}s it
 * asynchronously.
 */
type Workflow.Exec.Async {

  /**
   * Starts a workflow that is orchestrated via the {@link WorkflowQueue}.
   *
   * Note that not all valid workflows are currently supported.
   *
   * @param inputs:
   *           Map of input values to be used for the workflow run.  The key of the map must be the name of a vertex that
   *           mixes Workflow.Input.
   * @param spec
   *           The spec for the workflow execution.
   *
   * @return the new workflow run.
   */
  start: function(repr: !AsynchronousExecutionRepresentation,
                  inputs: map<string, any>,
                  spec: WorkflowExecutionSpec): !Workflow.Run
}
