/**
 * Base type for a workflow vertex run for a Workflow.MapReduce or Workflow.Batch vertex.
 */
abstract entity type Workflow.Run.JobBase extends Workflow.Run.Vertex type key 'JOB' {

  /**
   * @return the job run of the correct type from the type that extends this type.
   */
  jobRun: abstract member function(): JobRun

  /**
   * @return the job of the correct type from the type that extends this type.
   */
  job: abstract member function(failIfMissing: boolean): JobBase

  recover:     ~
  cancel:      ~
  checkStatus: ~
}
