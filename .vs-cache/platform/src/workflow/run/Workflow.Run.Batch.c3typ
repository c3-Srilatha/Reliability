/**
 * A workflow vertex run for a Workflow.Batch vertex
 */
entity type Workflow.Run.Batch extends Workflow.Run.JobBase type key 'BATCH' {

  /**
   * The batch job run that is created by starting the job.
   */
  batchJobRun: !BatchJobRun

  doStart: ~
  jobRun:  ~
}
