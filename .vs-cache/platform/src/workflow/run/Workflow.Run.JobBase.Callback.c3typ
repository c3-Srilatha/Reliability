/**
 * This callback will invalidate {@link #parentWorkflowRun} in the {@link WorkflowQueue} when invoked.
 */
type Workflow.Run.JobBase.Callback mixes JobBase.Callback {

  /**
   * {@link Workflow.Run} to invalidate upon execution of callback.
   */
  parentWorkflowRun: !Workflow.Run

  callback: ~
}
