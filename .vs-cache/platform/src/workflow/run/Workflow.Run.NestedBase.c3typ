/**
 * Base type for a workflow vertex run that represents a nested {@link Workflow.Run}.
 * For examples, see {@link Workflow.Run.Nested} and {@link Workflow.Run.Nested.Action}.
 */
abstract entity type Workflow.Run.NestedBase extends Workflow.Run.Vertex type key 'NSTB' {

  /**
   * @return the {@link Workflow.Run} for the nested workflow.
   */
  nestedRun: abstract member function(): Workflow.Run

  /**
   * NOTE: this will be called after the {@link #nestedRun} is finished, in order to {@link #setResult}.
   * @return the result of the nested workflow run.
   */
  resultFromRun: abstract member function(): any

  recover:        ~
  cancel:         ~
  checkStatus:    ~
  visualize:      ~ py
  summary:        ~ py-data
  flamegraph:     ~ py
  flamegraphJson: ~ py-server
  errors:         ~
  magnify:        ~
}
