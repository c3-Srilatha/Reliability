/**
 * Status for a workflow vertex run.
 */
private type Workflow.Run.VertexRunStatus {

  /**
   * Current status for the vertex run
   */
  vertexStatus: !Workflow.Run.VertexStatus

  /**
   * Current (fully populated) workflow run owning the vertex run.
   */
  workflowRun: !Workflow.Run

  /**
   * True if a new vertex was started due to vertex being completed.
   */
  vertexStarted: !boolean
}
