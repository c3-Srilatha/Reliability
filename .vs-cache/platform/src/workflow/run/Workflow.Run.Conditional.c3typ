/**
 * A workflow vertex run for a Workflow.Conditional.
 */
entity type Workflow.Run.Conditional extends Workflow.Run.Vertex type key 'COND' {

  /**
   * Holds the result of the evaluation (used by next to determine next vertex)
   */
  isTrue: boolean

  next:        ~
  checkStatus: ~
}
