/**
 * A specialized {@link Workflow.Vertex} that serves as a source vertex to represent the unique name of a workflow input.
 * Every {@link Workflow.Input} has a single disconnected input port whose name is the name of this vertex.
 * Every {@link Workflow.Input} has a single output port "out".
 * Note that this is an optional way to explicitly specify an input. In general, any input on a source will be considered a workflow input.
 * ```
 *         ------------------
 *  images | Workflow.Input | out ------> ...
 *         ------------------
 * ```
 */
type Workflow.Input mixes Workflow.Vertex {

  /**
   * @param name
   *           name for the input.
   * @return a constructed {@link Workflow.Input} of the given name.
   */
  fromName: function(name: !string): !mixing Workflow.Input
}
