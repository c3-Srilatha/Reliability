/**
 * A {@link Workflow.OptimizationStrategy} which continues to run all of its optimizations serially on the
 * {@link Workflow} until the Workflow is unchanged after a full round of optimizations.
 */
type Workflow.RunToSteadyState mixes Workflow.OptimizationStrategy
