/**
 * {@link Workflow.FusionContext} is the intermediate context used by the visitor {@link Workflow.FusionVisitor}.
 * It tracks updates to {@link #membership} as vertices are fused into groups.
 */
private type Workflow.FusionContext {

  /**
   * The graph that we are conducting the fusion optimization over.
   */
  graph: !Workflow

  /**
   * This represents a rudimentary implementation of a disjoint set data structure, which tracks group membership for each
   * vertex. The key is the vertex id, and the value is the vertex id of its "parent" vertex in the group. If a vertex is its own parent, then that
   * means it is the leader of its group. Membership should be initialized with all vertices being their own parent.
   */
  membership: !map<string, string>

  /**
   * @param a
   *           the vertex id of a member vertex in the group to fuse.
   * @param b
   *           the vertex id of a member vertex of another group to fuse.
   * @return new context representing the fusion of the two groups of vertices.
   */
  fuse: member function(a: !string, b: !string): !mixing Workflow.FusionContext

  /**
   * Converts {@link #membership} to a list of lists of vertices. The outer list is the list of groups.
   * An inner list is the membership of a distinct group instance.
   */
  fusionGroups: member function(): ![[Workflow.Vertex]]
}
