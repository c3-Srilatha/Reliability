/**
 * Rule that checks that the originating vertex for the 'this' ports are the same during CSE.
 */
type Workflow.Cse.Rule.TraceThisPort mixes Workflow.Cse.Rule.PortRule {

  /**
   * Recursively traces the 'this' inputs for the previous vertices. Returns true if the originating vertex
   * is the same.
   */
  prevVerticesAreEquivalent: ~ java | py
}
