/**
 * The {@link Workflow.VertexFusion} optimization merges a set of {@link Workflow.Vertex} into a single {@link Workflow.Action}
 * vertex, to be executed in a single process. For example, this could reduce network, scheduling, data movement overhead
 * for a series of simple actions.
 * There are numerous factors to take into account when deciding whether to fuse a set of vertices:
 * - similarity (or equality) of {@link ImplLanguage.Runtime} of proposed vertices
 * - aggregated {@link ResourceProfile} of proposed vertices, after fusion
 * - special/expensive (e.g. GPU) resource requirements that may not be required for all proposed vertices
 * - parallelization vs fusion tradeoff for proposed vertices that run in parallel
 */
type Workflow.VertexFusion mixes Workflow.Optimization {

  /**
   * Each fusion group contains a list of vertices that should be fused together, the runtime the fused group should
   * execute in, and the hardware constraint for the fused group execution.
   */
  fusionGroups: [Workflow.VertexFusion.FusionGroup]

  optimize: ~

  /**
   * @param workflow
   *           fused subgraph of the original {@link Workflow} to execute.
   * @param inputs
   *           key is input name and value is input value.
   * @param runtime
   *           runtime in which to execute the fused vertex.
   * @return key is output name and value is output value.
   */
  // TODO: PLAT-38590, should be implemented in multiple languages
  executeFusedVertex: private function(workflow: !Workflow,
                                       inputs: !map<string, any>,
                                       runtime: string serialized ImplLanguage.Runtime): !any py

  /**
   * Given a workflow containing {@link Workflow.Action} vertices (and optionally {@link Workflow.Make} and
   * {@link Workflow.Field} vertices), this method uses a greedy approach to fuse groups of vertices into a single
   * action where all vertices in each group can execute within a common runtime.
   */
  findFusionGroups: private member function(workflow: !Workflow): !Workflow.VertexFusion py
}
