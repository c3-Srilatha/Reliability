/**
 * This type governs how the Common Subexpression Elimination optimization handles a specific port when comparing
 * {@link Workflow.Action} vertices for the same action.
 */
type Workflow.Cse.Rule.PortRule {

  /**
   * Returns true if the previous vertices for the ports are equivalent. By default, this
   * returns true iff the ids of the previous vertices are the same.
   *
   * @param p1
   *           The first {@link FlowGraph.Port} to check equivalence for.
   * @param p2
   *           The second {@link FlowGraph.Port} to check equivalence for.
   * @param workflow
   *           The original {@link Workflow} to which both 'p1' and 'p2' belong.
   * @return true if the previous vertices for the ports are equivalent.
   */
  prevVerticesAreEquivalent: member function(p1: !FlowGraph.Port,
                                             p2: !FlowGraph.Port,
                                             workflow: !Workflow): boolean java | py
}
