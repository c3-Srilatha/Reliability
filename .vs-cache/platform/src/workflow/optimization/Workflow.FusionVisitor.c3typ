/**
 * {@link Workflow.FusionVisitor} is used in {@link Workflow.VertexFusion#optimize} to visit each vertex in a
 * Workflow and assign/update fusion groups.
 */
private type Workflow.FusionVisitor mixes Workflow.Visitor<Workflow.FusionContext> {

  action: ~
  const:  ~
  input:  ~
  output: ~
  make_:  ~
  field:  ~
}
