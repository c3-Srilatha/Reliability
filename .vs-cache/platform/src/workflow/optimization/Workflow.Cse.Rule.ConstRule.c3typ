/**
 * Rules specifying how to handle {@link Workflow.Const} vertices.
 */
type Workflow.Cse.Rule.ConstRule mixes Workflow.Cse.Rule.VertexRule {

  /**
   * Returns "Workflow.Const".
   */
  vertexKey: ~ java | py

  /**
   * Checks if the {@link Workflow.Const#const} objects are the same.
   */
  areEquivalent: ~ java | py

  /**
   * Returns true iff vertex is a {@link Workflow.Const}.
   */
  isApplicable: ~ java | py
}
