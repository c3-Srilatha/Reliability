/**
 * The {@link Workflow.Optimization} defines an interface for representing an optimization over any {@link Workflow}.
 */
abstract type Workflow.Optimization {

  /**
   * Inputs into the workflow that is being optimized
   */
  inputs: map<string, any>

  /**
   * @param workflow
   *           original {@link Workflow}, to be optimized.
   * @return a new {@link Workflow} that is functionally equivalent to the original, but has the optimization run
   *           on it. Note that the returned workflow should not have any identifying fields.
   *
   * @see {@link Persistable#withoutIdentity}
   */
  optimize: abstract member function(workflow: !Workflow): !Workflow
}
