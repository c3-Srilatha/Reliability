/**
 * This strategy operates on {@link Workflow}s that have been optimized using the {@link Workflow.VertexFusion}
 * optimization. It applies the specified optimizations to the input {@link Workflow} for all fused vertices.
 */
type Workflow.MlPipeline.FusedVerticesStrategy mixes Workflow.OptimizationStrategy {

  optimize: ~ py
  inst:     ~ py
}
