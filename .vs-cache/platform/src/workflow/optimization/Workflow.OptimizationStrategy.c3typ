/**
 * The {@link Workflow.OptimizationStrategy} defines an interface for all optimization strategies to use with {@link Workflow#optimize}. The
 * responsibility of an optimization strategy is to coordinate the dependencies and execution order (and count) for a list of
 * {@link Workflow.Optimization}. An optimization strategy can make these determinations based off of, for example,
 * an optimization latency vs estimated optimization benefit trade-off.
 * Note that an optimization strategy itself is a {@link Workflow.Optimization} and is therefore composable/reusable in other
 * optimization strategies.
 */
abstract type Workflow.OptimizationStrategy mixes Workflow.Optimization, DefaultInstance {

  /**
   * The optimizations to run during the {@link #optimize} of this optimization strategy.
   */
  optimizations: private ![Workflow.Optimization]

  /**
   * @param optimizations
   *           optimizations to run during the optimize for this optimization strategy.
   * @return constructed {@link Workflow.OptimizationStrategy}.
   */
  fromOptimizations: function(optimizations: ![Workflow.Optimization]): !mixing Workflow.OptimizationStrategy

  /**
   * Convenience helper which constructs a {@link Workflow.OptimizationStrategy} with a single optimization
   */
  fromOptimization: function(optimization: !Workflow.Optimization): !mixing Workflow.OptimizationStrategy

  inst: ~
}
