/**
 * This type represents a possible {@link Workflow} fusion group for the {@link Workflow.VertexFusion} optimization.
 */
type Workflow.VertexFusion.FusionGroup {

  /**
   * A list of vertices that should be fused together into a single group.
   */
  vertices: [Workflow.Vertex]

  /**
   * A list of runtimes that all vertices in this group can execute in.
   */
  runtimes: [string]

  /**
   * A list of hardware constraints for _each_ of the vertices in this group. Use {@link HardwareConstraint#max} to
   * find the best available hardware constraint that can support the execution of all vertices in this group.
   */
  hardwareConstraints: [HardwareConstraint]
}
