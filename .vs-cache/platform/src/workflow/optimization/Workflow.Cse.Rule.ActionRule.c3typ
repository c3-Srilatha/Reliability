/**
 * Rules specifying how to handle specific ports for a given {@link Workflow.Action}.
 */
type Workflow.Cse.Rule.ActionRule mixes Workflow.Cse.Rule.VertexRule {

  /**
   * The action to which this rule applies.
   */
  actionName: string

  /**
   * The type to which this rule applies.
   */
  typeName: string

  /**
   * Returns "{@link Workflow.Action#typeName}#{@link Workflow.Action#actionName}".
   */
  vertexKey: ~ java | py

  isApplicable:  ~ java | py
  areEquivalent: ~ java | py
}
