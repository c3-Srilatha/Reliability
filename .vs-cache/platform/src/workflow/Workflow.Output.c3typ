/**
 * A specialized {@link Workflow.Vertex} that serves as a sink vertex to represent the unique name of a workflow output.
 * Every {@link Workflow.Output} has a single input port "in".
 * Every {@link Workflow.Output} has a single disconnected output port whose name represents the workflow output name.
 * ```
 * -------------------                   -------------------
 * | Workflow.Action | out ---------> in | Workflow.Output | predictions
 * -------------------                   -------------------
 * ```
 */
type Workflow.Output mixes Workflow.Vertex {

  /**
   * @param name
   *           name for the output.
   * @return a constructed {@link Workflow.Output} of the given name.
   */
  fromName: function(name: !string): !mixing Workflow.Output
}
