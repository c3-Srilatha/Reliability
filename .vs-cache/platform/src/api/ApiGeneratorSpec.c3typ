/**
 * Options for API declaration generation. By default, anything that can be expressed is, but this allows some content
 * to be skipped for simpler results.
 */
type ApiGeneratorSpec mixes Spec {

  /**
   * If true, ignore data fields.
   */
  noDataFields: boolean

  /**
   * If true, ignore methods.
   */
  noMethods: boolean

  /**
   * If true, do not include documentation.
   */
  noDocumentation: boolean

  /**
   * If true, skip data fields and methods purely inherited from mixin types (not mentioned in the type declaration
   * itself).
   */
  noInherited: boolean

  /**
   * If true, skip outer structure and produce only the declaration itself (which may not be valid as a stand-alone
   * file).
   */
  noPrePostamble: boolean

  /**
   * If true, only generates the type declaration that represents a fully-instantiated instance, and skips other
   * potentially useful declarations for the type. For example, in {@link TypeScriptApiGenerator}, the type declaration
   * to be used for method parameter value type (the I* class) will be skipped if this flag is set true.
   */
  mainDeclarationOnly: boolean

  /**
   * Generate `import` statements for types referenced if the language requires them.
   */
  imports: boolean

  /**
   * When generating `import` statements for types referenced if the language, use this string as a prefix to the
   * simple type name.
   *
   * @see #imports
   */
  importsPrefix: string

  /**
   * Generate the types referenced as well as the requested types. This option is only effective with
   * {@link ApiGenerator#generateBatch}.
   *
   * @see #skipTypes
   */
  addReferenced: boolean

  /**
   * If the caller already has some definitions generated and is using #addReferenced, specifying the types it already
   * has in this array will prevent them from being re-generated. This option is only effective with
   * {@link ApiGenerator#generateBatch}.
   *
   * @see #addReferenced
   */
  skipTypes: [Type]

  /**
   * If true, use inheritance if available in the language as an optimization to inlining all fields and methods.
   * For example, in {@link TypeScriptApiGenerator}, all types that have {@link Obj} as a mixin will extend {@link Obj}
   * in the declaration.
   */
  useInheritance: boolean

  /**
   * If true and applicable for the language, export interface instead of exporting class.
   */
  exportInterfaceInsteadOfClass: boolean
}
