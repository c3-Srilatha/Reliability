/**
 * Produce a {@link https://www.typescriptlang.org/index.html TypeScript} interface that represents the specified type.
 *
 * This produces the
 * {@link https://www.typescriptlang.org/docs/handbook/declaration-files/templates/module-d-ts.html module.d.ts} format
 * with everything other than the single interface being part of the pre/postamble.
 */
type TypeScriptApiGenerator mixes ApiGenerator
