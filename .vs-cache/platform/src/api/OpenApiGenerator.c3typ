/**
 * Produce an OpenAPI specification that represents the specified type.
 *
 * @see https://spec.openapis.org/oas/v3.0.3
 */
type OpenApiGenerator mixes ApiGenerator {

  /**
   * Version of OpenAPI specification delivered.
   */
  OAS_VERSION: const string = "3.0.3"

  /**
   * Whether to produce the result as YAML rather than JSON.
   */
  yaml: boolean

  /**
   * The prefix URL for this instance of the server. This should not include "/api/n" nor a trailing slash.
   */
  origin: string serialized Url

  /**
   * Produce a path to the server's API endpoint.
   *
   * @see #origin
   */
  serverPath: member function(): !string

  /**
   * Produce a path to the server's documentation endpoint for the specified type.
   *
   * @see #origin
   */
  docPath: member function(typeName: !string): !string
}
