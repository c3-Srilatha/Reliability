/**
 * This envelope is used to wrap an ApiResponse with additional information that can be used for routing, profiling, additional headers, etc.
 * Currently used by the websocket transport for ClusterDispatcher. Additional field 'response' is known at runtime and will be added dynamically.
 */
// TODO: Currently unused
type ApiResponseEnvelope {

  version:     string
  isStreaming: boolean
  headers:     map<string, string>
}
