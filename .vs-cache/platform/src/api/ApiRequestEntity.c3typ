/**
 * The shape of a request entity sent to the C3 web API.
 * A request entity is targeted for a given action. So, theoretically, each action parameter should have a corresponding field in this type.
 * However the list of parameters is only known at runtime. So these fields will be dynamically added.
 */
type ApiRequestEntity {

  version: string
}
