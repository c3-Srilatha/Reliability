/**
 * Produce a {@link https://www.python.org/dev/peps/pep-0484/ Python} interface that represents the specified type.
 *
 * This produces the
 * {@link https://mypy.readthedocs.io/en/stable/stubs.html .pyi} format
 * with everything other than the single interface being part of the pre/postamble.
 */
type PythonApiGenerator mixes ApiGenerator
