/**
 * This envelope can be used to wrap an ApiRequest with additional information that can be used for routing, profiling, additional headers, etc.
 * Currently used by the websocket transport for ClusterDispatcher. Additional field 'request' is known at runtime and will be added dynamically.
 */
type ApiRequestEnvelope {

  version:  string
  target:   string
  clientId: string
  rootId:   string
  parentId: string
  headers:  map<string, string>
}
