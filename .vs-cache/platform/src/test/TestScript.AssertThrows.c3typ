/**
 * A "throws" assertion checks that the expression throws the expected exception.
 */
type TestScript.AssertThrows mixes TestScript.Assertion {

  /**
   * If specified, this error code (type name) must be thrown.
   */
  errorCode: string

  /**
   * If specified, the thrown error message must match this regular expression.
   */
  messageRE: string
}
