/**
 * Type to host methods to test the {@link TypeScriptApiGenerator}.
 */
final private type TypeScriptApiGenerator.Tester mixes Value {

  /**
   * Function to validate the resultant `.d.ts` file for all Types present in the App.
   *
   * @param useInheritance
   *        If true, generates and validates `.d.ts` files using inheritance where possible.
   *        If false, validates the fully inlined (non-inheritance) form of type declarations.
   *
   * @see ApiGeneratorSpec#useInheritance
   */
  @nodejs(typeSystem=true)
  validateAllFiles: function(useInheritance: boolean): [TypeScriptApiGenerator.Tester.Error] js-babel-parser-server-node
}
