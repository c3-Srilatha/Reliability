/**
 * Type to store errors caught during validation of `.d.ts` generation in the
 * {@link TypeScriptApiGenerator.Tester#validateAllFiles} function.
 */
final private type TypeScriptApiGenerator.Tester.Error {

  /**
   * The error string caught when validating the generated `.d.ts` file.
   */
  error: string

  /**
   * The Type for which this error was caught.
   */
  targetType: string
}
