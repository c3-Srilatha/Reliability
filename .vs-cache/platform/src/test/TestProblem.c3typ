/**
 * Represents the problem that occurred when running a single test case
 */
type TestProblem mixes Result {

  /**
   * The number of line (starting from 1) in the test file that caused the problem (if any from stacktrace).
   */
  @xmlField(hidden=true)
  srcLineNum: int

  /**
   * The error object
   */
  @xmlField(hidden=true)
  stackTrace: [StackFrame]

  /**
   * The error message. e.g., if a java exception is thrown, the return value of getMessage()
   */
  message: string

  /**
   * The type of error that occurred. e.g., if a java exception is thrown the full class name of the exception.
   */
  // TODO PLAT-4434
  @xmlField(name='type')
  type_: !string

  /**
   * Creates a TestProblem instance with the provided error
   * @param error
   *           The java error to create a TestProblem from
   * @return The new TestProblem instance
   */
  fromJavaThrowable: function(error: @java(class='java.lang.Throwable') !native): !mixing TestProblem
}
