/**
 * A single before or after hook code block. At most one of each may be defined and they must be defined before the
 * first test code block since they apply to _all_ #cases.
 */
type TestSuite.Hook mixes Nameable {

  /**
   * The name is set to the hook type ("before" or "after").
   *
   * @see TestSuite.HookName
   */
  name: !~ enum TestSuite.HookName

  /**
   * If loaded from a Markdown file, the line number of the fenced code block.
   */
  lineNumber: int32

  /**
   * The script (contents of the fenced code block of hook code).
   */
  script: !TestScript

  /**
   * Whether this is a `before` or `beforeEach` hook.
   */
  isBefore: member function(): boolean

  /**
   * Whether this is an `after` or `afterEach` hook.
   */
  isAfter: member function(): boolean
}
