/**
 * A simple expression, such as a bare method call, is an implicit assertion that the expression does not throw an
 * exception.
 *
 * Note that assignment statements of bare variable names become {@link TestScript.Assignment} statements.
 */
type TestScript.AssertExpr mixes TestScript.Assertion
