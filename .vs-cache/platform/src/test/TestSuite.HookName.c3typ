/**
 * The hook block types supported.
 */
enum type TestSuite.HookName {

  /**
   * Initialization block run once before all test code blocks. Variables set in this block will be available within
   * all other hooks and test blocks.
   */
  BEFORE_ALL = 'before'

  /**
   * Initialization block run before each test code block. Variables set in this block will be available within the
   * test code block. Variables introduced in the #BEFORE_ALL block may not be set.
   */
  BEFORE_EACH = 'beforeEach'

  /**
   * Cleanup block run after each test code block. No variables may be introduced and variables introduced in the
   * #BEFORE_ALL block may not be set.
   */
  AFTER_EACH = 'afterEach'

  /**
   * Cleanup block run once after all test code blocks. No variables may be set.
   */
  AFTER_ALL = 'after'
}
