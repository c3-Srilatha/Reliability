/**
 * Single run / fire of a MaximGun.
 */
@db(index+=['gun,descending(meta.created)'])
entity type MaximGunFire schema name 'MGUN_FIRE' {

  /**
   * Parent gun.
   */
  gun: !MaximGun

  /**
   * MachineGun options for this run.
   */
  options: !MaximGunOptions schema suffix 'OP'

  /**
   * Status of the run.
   */
  status: member function(): !BatchJobStatus

  /**
   * @return aggregate statistics by test action / request.
   */
  stats: member function(): map<string, MaximGunStats>

  /**
   * @return aggregate statistics for the custom measurements.
   */
  customStats: member function(): map<string, MaximGunStat>

  /**
   * Active concurrency; i.e. actual number of tester actions currently running against target cluster. Can be less then
   * #options.concurrency.
   */
  activeConcurrency: member function(): int

  /**
   * Users for this run.
   */
  users: private [MaximGunUser](fire)

  listUsers: private member function(): [MaximGunUser]

  /**
   * Iterates through all users and executes `user.count / #options.concurrency` actions for each.
   * NOTE: if #options.uniqueUserPerThread is specified, then instead this will run all user.count
   * actions for the user corresponding to the provided userNum, where userNum is not 0-indexed.
   */
  burstFire: private member function(userNum: int)
}
