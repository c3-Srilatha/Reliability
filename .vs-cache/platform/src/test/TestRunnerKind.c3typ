/**
 * Enumeration of TestRunner kinds.
 */
enum type TestRunnerKind {

  CANONICAL = 'canonical'

  JASMINE = 'jasmine'

  NOTEBOOK = 'notebook'

  PERF = 'perf'

  PYTEST = 'pytest'

  BROWSER = 'browser'

  CLUSTER = 'cluster'
}
