/**
 * Type that supports measuring a process's memory usage over a period of time. The {@link #id} denotes the PID of
 * the process being profiled.
 */
type ProcessProfiler mixes Identified {

  /**
   * Denotes the number of times a given `ProcessProfiler` has been {@link ProcessProfiler#start}ed, but not
   * {@link ProcessProfiler#stop}ped. If non-zero, profiling is occurring.
   */
  activeCount: private int

  /**
   * Begin measuring a process's memory usage at a given frequency.
   * Increments the {@link #activeCount} of a `ProcessProfiler`.
   *
   * @param frequencyHz
   *            desired frequency (in Hz) at which the process will be measured.
   */
  start: member function(frequencyHz: int = 15)

  /**
   * Stop measuring a process's memory usage and get measurements. For each call to {@link #start}, there
   * should be a respective call to {@link #stop}. This method decrements the {@link #activeCount} of a
   * `ProcessProfiler`. The result contains all measurements starting from the call to {@link #start} which incremented
   * the {@link #activeCount} to 1, and ending at the call to this method.
   *
   * @return a `ProcessProfilerResult` containing process memory usage measurements over the duration of profiling.
   */
  stop: member function(): !ProcessProfilingResult

  /**
   * Forcefully stop measuring a process's memory usage for a given `ProcessProfiler`. Affectively, this method calls
   * {@link #stop} on a `ProcessProfiler` until its {@link #activeCount} is 0.
   *
   * @return a `ProcessProfilerResult` containing process memory usage measurements over the duration of profiling.
   */
  forceStop: member function(): !ProcessProfilingResult

  /**
   * Forcefully stop all process profiling. All {@link #activeCount}s will be set to 0.
   *
   * @return the number of processes that were being measured
   */
  stopAll: function(): !int
}
