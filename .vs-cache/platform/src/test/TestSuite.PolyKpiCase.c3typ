/**
 * A KpiCase used to measure C3 code. The setup, measure, and assert blocks of a PolyKpiCase must be authored in
 * Poly Test Script as they will be transpiled to all locations.
 */
type TestSuite.PolyKpiCase mixes TestSuite.KpiCase<TestScript>, TestSuite.PolyCase {

  /**
   * @inheritdoc
   * Vars set in the setup block are included with those set in the measure block. Note that generally new vars
   * should not be introduced in the assert block.
   */
  vars: ~

  /**
   * Find all external references in the script for this poly KPI test case that do not correspond to type names in
   * the specified package, variables set by before hooks or special variables for KPI cases. For the measure block,
   * this includes `$spec` and variables set by the `setup` block and for the `assert` block, this includes
   * `$result`.
   *
   * @param suite the parent test suite (for hooks)
   * @param pkg the package for which to check type names
   * @return a list of unknown variables and the line numbers in the suite
   */
  unknownGlobals: ~
}
