/**
 * Internal state of a MaximGun test user.
 */
entity type MaximGunUser schema name 'MGUN_USER' {

  /**
   * Parent.
   */
  fire: !MaximGunFire

  /**
   * Test user id.
   */
  user: !string

  /**
   * Test user auth token.
   */
  auth: !string

  /**
   * Timestamp in milliseconds when next test action should be invoked for this user.
   */
  nextMillis: !int

  /**
   * Approximate number of test actions this user should invoke.
   */
  count: !int

  /**
   * Current count of test actions this user has already invoked.
   */
  currentCount: !int

  /**
   * Pre-generated test action requests for this user. They will be executed randomly.
   */
  requests: [HttpRequest] schema suffix 'REQ'

  /**
   * Current stats for this test user.
   */
  stats: map<string, MaximGunStats> schema suffix 'STATS'

  /**
   * Custom stats for this test user.
   */
  customStats: map<string, MaximGunStat> schema suffix 'CS'
}
