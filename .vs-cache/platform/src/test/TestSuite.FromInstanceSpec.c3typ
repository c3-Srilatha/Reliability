/**
 * Options for TestSuite#fromInstance.
 */
type TestSuite.FromInstanceSpec mixes Spec {

  /**
   * Suite name/top-level heading.
   */
  name: string

  /**
   * Depth of the top-level heading, 1-based (`2` is "##").
   */
  headingLevel: int = 1

  /**
   * Markdown text added between the top-level heading and the first test case heading.
   */
  description: string

  /**
   * Global ignore for the entire test suite, such as "x:js-server PLAT-12345".
   */
  ignore: string

  /**
   * A list of fields/methods to ignore when generating the test.
   */
  skipFields: [string]
}
