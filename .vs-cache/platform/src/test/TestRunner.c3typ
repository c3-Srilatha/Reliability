/**
 * C3 Type for running tests.
 */
type TestRunner {

  /**
   * Construct a TestRunner instance to run all the tests in the current package.
   * @param deep
   *           Whether to include tests from the current package's dependencies.
   */
  forPackage: function(deep: boolean): !TestRunner

  /**
   * Run the tests.
   */
  run: member function(spec: TesterRunSpec): !TestResult

  // TODO: PLAT-117944 Properly support run a subset of tests for TestRunner

  /**
   * Run the tests with the specified timeout (in seconds).
   * Call back function will be invoked with the test result and the callbackArgs at the end of the test run.
   */
  runWithTimeout: member function(spec: TesterRunSpec,
                                  timeout: int,
                                  callbackArgs: any,
                                  callback: lambda(testResult: TestResult, callbackArgs: any)): !TestResult

  /**
   * Executes the tests in the appropriate runtime and returns the results
   * @param tests
   *          The list of tests to run
   */
  @deprecated(finalVersion='8.9', details="Use TestRunner#run or TestRunner#runWithTimeout instead")
  runTests: member function(testPaths: ![string serialized Pkg.Path]): ![TestResult]

  /**
   * Only the test paths matching the glob pattern will be executed.
   */
  testPathGlob: string serialized Pkg.Path

  /**
   * Returns the name of test.  This is determined from the test path.
   * @param testPath
   *        The path of the test
   */
  findTestName: private function(testPath: !string): string js-server

  /**
   * Only the test names matching the glob pattern will be executed.
   */
  testNameGlob: string

  /**
   * This field is used to further filter out any matching test suites whose {@link requirementForPath}'s corresponding
   * {@link Action.Requirement#enginesForTest} cannot run this Action.Requirement.
   * E.g. if "py-py4j-ml" is specified as the requirement and the test glob is /somePkg/test/py-ml/test_foo.py, we will only
   * run the test in the `Action.Engine` `py-ml-server-py4j`. Otherwise, this test would have run against `Action.Engines`
   * `py-ml-client-ipython` and `py-ml-server-py4j`.
   */
  requirement: string serialized Action.Requirement

  /**
   * If true, execute tests from the current package and all its dependency packages.
   */
  includeDependencies: boolean

  /**
   * The endpoint of the C3 server to connect to, in the case the test requires a remote server.
   */
  endpoint: string serialized Url

  /**
   * @return a collection of all test files which satisfy all semantics for the fields of this `TestRunner`.
   */
  testSuites: cached member function(): ![string serialized Pkg.Path]

  /**
   * @return a collection of all {@link Tester}s necessary to run the {@link TestRunner#testSuites}.
   */
  testers: cached member function(): ![Tester]

  /**
   * Given the path to a test, returns the {@link Action.Requirement} specified by the path.
   * e.g.
   *        - `requirementForPath(""/<pkg>/test/py-py4j-server-ml/test_something.py")` would return the Action.Requirement
   *           py-py4j-server-ml
   * Will fail if `failIfInvalid` is `true` path doesn't have corresponding Action.Requirement.
   */
  requirementForPath: function(path: !string, failIfInvalid: boolean): Action.Requirement

  /**
   * Run a single test file.
   * Assumes tag is already setup correctly.
   *
   * @param file
   *           The file to run.
   * @param includePatterns
   *           Optional array of regexes to filter Jasmine `it` and `describe` blocks to only those that match one
   *           or more of the patterns.
   * @param stopOnFailure
   *           If true, tests will stop all execution on the first thrown error or failed expectation, instead of
   *           continuing to process subsequent suites and specs and reporting all failures at the end.
   * @return the results of the test, or null if the file is not a test.
   */
  @deprecated(finalVersion='7', details='Use {@link Tester}')
  testFile: abstract function(file: !Pkg.File, includePatterns: [string], stopOnFailure: boolean): TestSuiteResult

  /**
   * Runs all tests matching the specified path.
   * Assumes tag is already setup correctly.
   *
   * @param path
   *           The path to check for the {@link Pkg.File}s to run. Uses {@link Pkg.Path.MatchBy.REGEX}.
   * @param includePatterns
   *           Optional array of regexes to filter Jasmine `it` and `describe` blocks to only those that match one
   *           or more of the patterns.
   * @param stopOnFailure
   *           If true, tests will stop all execution on the first thrown error or failed expectation, instead of
   *           continuing to process subsequent suites and specs and reporting all failures at the end.
   * @return the results of the tests.
   */
  @deprecated(finalVersion='7', details='Use {@link Tester}')
  testPath: function(path: !Pkg.Path, includePatterns: [string], stopOnFailure: boolean): [TestSuiteResult]

  /**
   * Run all the tests in a specific package.
   * @param config
   *           The config to use when running testPackage. If not specified,
   *           testPackage will use the defaults for TestRunnerConfig for the package.
   */
  @deprecated(finalVersion='7', details='Use {@link TestRunner#forPackage}')
  testPackage: function(config: TestRunnerConfig): !mixing TestRunner

  /**
   * Returns the TestResult for a TestRunner instance. If the job is still running, this will aggregate
   * the in-progress results of the running batches.
   */
  @deprecated(finalVersion='7', details='Use {@link Tester}')
  getTestResult: member function(): TestResult

  /**
   * Executes lambda as `tester` user. `tester` user exists only in tags in `test` mode.
   *
   * @param lambda
   *           Lambda to apply as `tester` user
   * @return the result of application of lambda
   */
  asTester: function(user: !string, lambda: !lambda(): any): any

  /**
   * Executes lambda as test user with only provided C3 role.
   *
   * @param  roles
   *           The C3 roles for test user
   * @param  lambda
   *           Lambda to apply as test user
   * @return the result of application of lambda
   */
  @action(authzChildActions=true)
  asRole: function(role: !string, lambda: !lambda(): any): any

  /**
   * Executes lambda as test user with only provided C3 role.
   * This method may only be called on an app that isTestMode.
   *
   * @param  role
   *           The C3 role for test user
   * @param  lambda
   *           Lambda to apply as test user
   * @return the result of application of lambda
   */
  asRoles: function(roles: ![string], lambda: !lambda(): any): any

  /**
   * Executes lambda as test user with only provided C3 user.
   * This method may only be called on an app that isTestMode.
   *
   * @param user
   *           The id of the C3 user
   * @param lambda
   *           Lambda to apply as test user
   * @return the result of application of lambda
   */
  asUser: function(user: !string, lambda: !lambda(): any): any

  /**
   * Executes lambda as test user with only provided C3 user.
   * This method may only be called on an app that isTestMode.
   *
   * @param user
   *           The C3 user
   * @param lambda
   *           Lambda to apply as test user
   * @return the result of application of lambda
   */
  asUser: function(user: !User, lambda: !lambda(): any): any

  /**
   * Executes lambda as worker user.
   * This method may only be called on an app that isTestMode.
   * Useful for simulating worker actions in tests to ensure
   * correct behavior under restricted contexts.
   *
   * @param lambda
   *           Lambda to apply as test user
   * @return the result of application of lambda
   */
  @action(group+="app-admin")
  asWorker: function(lambda: !lambda(): any): any

  /**
   * @returns true if the current app is in dev or test mode
   */
  isDevTestMode: private inline function(): boolean

  /**
   * Asserts that the current app is running in dev or test mode.
   * Useful for ensuring that certain actions or APIs are only executed
   * during development or automated testing.
   */
  assertInDevTestMode: private inline function()

  /**
   * Executes script to instrument files in the current package.
   *
   * @param category
   *          The category of Pkg.Files to instrument. Defaults to {@link Pkg.Category.SRC},
   *          if not specified.
   *
   * @return a mapping of file paths to their stringified instrumented code.
   */
  instrumentedFiles: function(category: !string enum Pkg.Category, pkgName: !string): map<string, string>

  /**
   * Executes script to instrument one file in a package.
   *
   * @param file
   *          The {@link Metadatafile} to instrument.
   * @return The instrumented code of the file as a string.
   */
  instrumentedFile: function(file: !Pkg.File): string

  /**
   * Find all tests in all packages.
   * @return a map of pkg to the tests that exist in that pkg
   * (For the tests it uses the fully-qualified name of the test class (e.g., c3.platform.action.Action_Test) for
   * JUnit tests and /<package>/test/<test-dir>/ for all other tests.
   */
  findAllTests: function(): map<string, [string]>

  /**
   * Trigger a dump of the jacoco binary coverage file and return its contents
   * @param filePath
   *          The filepath to put the jacoco binary file
   * @return binary of jacoco coverage data, in base64
   */
  fetchJacocoBinary: function(): binary

  /**
   * Lambda called with the result immediately after the test run completes.
   *
   * @param result
   *          Result of running a single test
   */
  onTestCaseComplete: lambda(result: !TestCaseResult)

  /**
   * @return The {@link Action.Engine engines} we should be testing against for the actionRequirement.
   * There are potentially many Action.Engines that can run the provided Action.Requirement.
   * TestRunner will run a test suite across various engines for an action requirement to confirm the test suite
   * passes when ran in different locations and executors.
   */
  enginesForTests: cached function(actionRequirement: !Action.Requirement): [Action.Engine]
}
