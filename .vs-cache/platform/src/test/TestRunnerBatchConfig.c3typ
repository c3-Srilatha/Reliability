/**
 * Configuration object passed to {@link TestRunner.processBatch} to specify the batch options.
 */
type TestRunnerBatchConfig {

  /**
   * The id generated for this specific batch
   */
  batchId: !string

  /**
   * The tests in the batch.
   */
  tests: [Pkg.File] schema suffix 'TSTS'
}
