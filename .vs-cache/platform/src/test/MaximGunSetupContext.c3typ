/**
 * This type can be used by implementations of {@link MaximGunOptions.setupLambda} to record information that
 * will be used during the test itself and in the teardown step. An example of something that could be recorded
 * here is a selenium session id.
 *
 * {@link MaximGunOptions.teardownLambda} should remove any MaximGunSetupContext objects created by the setup step.
 */
entity type MaximGunSetupContext schema name 'MXMGNCTX' {

  /**
   * The information recorded during the {@link MaximGunOptions.setupLambda}.
   */
  values: map<string, any> schema name 'VALS'
}
