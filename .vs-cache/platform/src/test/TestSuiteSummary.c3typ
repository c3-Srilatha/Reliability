/**
 * This type contains summary stats for one or more {@link TestSuite TestSuites}.
 */
// TODO PLAT-30926 Generate summary from JUnit tests.
type TestSuiteSummary {

  /**
   * Stats that counts test cases.
   */
  cases: TestSuiteSummary.Stats

  /**
   * Stats that counts test assertions.
   */
  assertions: TestSuiteSummary.Stats

  /**
   * Aggregate multiple {@link TestSuiteSummary TestSuiteSummaries} into one.
   */
  aggregate: function(summaries: [TestSuiteSummary]): TestSuiteSummary
}
