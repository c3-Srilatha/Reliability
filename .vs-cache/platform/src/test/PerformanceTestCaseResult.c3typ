/**
 * Type representing the performance test results for a version of the package
 */
type PerformanceTestCaseResult {

  /**
   * The name of the package
   */
  packageName: string

  /**
   * The name of the repository
   */
  repository: string

  /**
   * The semantic version for the build
   */
  semanticVersion: string

  /**
   * The name for the performance test suite
   */
  testSuiteName: string

  /**
   * The name for the performance test case
   */
  testCaseName: string

  /**
   * The timestamp when the performance test was conducted
   */
  timestamp: datetime

  /**
   * The count of actions in the {@link PerformanceTestCase}
   */
  count: int

  /**
   * Average end to end time in seconds.
   */
  avg: double

  /**
   * Minimum end to end time in seconds.
   */
  min: double

  /**
   * Maximum end to end time in seconds.
   */
  max: double

  /**
   * 95 percentile end to end time in seconds.
   */
  p95: double

  /**
   * Total time for all calls in seconds.
   */
  sum: double

  /**
   * The test failure if the test case failed
   */
  failure: TestFailure

  /**
   * The test warning if the test case has a warning
   */
  warning: TestWarning
}
