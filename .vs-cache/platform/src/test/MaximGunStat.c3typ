/**
 * PSR test (aka Maxim gun fire) execution statistics.
 */
type MaximGunStat {

  /**
   * Count of actions.
   */
  count: int

  /**
   * Average end to end / wall time in seconds.
   */
  avg: double

  /**
   * Minimum end to end / wall time in seconds.
   */
  min: double

  /**
   * Maximum end to end / wall time in seconds.
   */
  max: double

  /**
   * 95 percentile end to end / wall time in seconds.
   */
  p95: double

  /**
   * Total time for all calls in seconds.
   */
  sum: double

  fromArray: private function(times: [double]): MaximGunStat
  add:       private function(a: !?MaximGunStat, b: !?MaximGunStat): !MaximGunStat
}
