/**
 * C3 Type for instrumenting files.
 */
type JsCodeCoverageInstrumenter {

  /**
   * Instruments JS files in the given directory.
   * The files will be overwritten in place with the instrumented content.
   *
   * @param dir
   *          The directory containing files to instrument.
   * @param spec
   *          A spec defining additional instrumentation options.
   * @return The default {@link CodeCoverageCounter}s for the instrumented files. If tracked,
   * makes finding uncovered files easier.
   */
  instrumentDir: function(dir: !string, spec: CodeCoverageInstrumentationSpec): [CodeCoverageCounter]

  /**
   * Instruments JS code using Babel.
   *
   * @param sourceFileName
   *           The label to use for code coverage data. It is recommended to provide relative paths. This API does not
   *           read from the file path given, it instruments the given sourceCode, and uses the path as a label.
   * @param sourceCode
   *           The source code to instrument.
   * @return The instrumented source code.
   */
  instrument: function(sourceFileName: !string,
                       sourceCode: !string): !JsCodeCoverageInstrumenter.Result js-instrumenter-node
}
