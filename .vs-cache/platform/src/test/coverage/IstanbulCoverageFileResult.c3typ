/**
 * IstanbulCoverageFileResult keeps track of which lines were reached in the last test execution.
 */
@db(compactType=true)
entity type IstanbulCoverageFileResult schema name 'ISTCOV' {

  /**
   * File path of the source file
   */
  path: string

  /**
   * Key is a unique integer generated by the instrumentation to identify each statement.
   * Value represents the number of times the statement has been reached by the Istanbul code coverage tool when
   * running tests.
   */
  @ser(name='s')
  statementReachedCount: map<int, int> schema suffix 'STMTCNT'

  /**
   * Key is a unique integer generated by the instrumentation to identify each branch.
   * Value {@link IstanbulBranchReachCounts} contains a counts array, representing the number of times each of
   * the branches has been reached by the Istanbul code coverage tool when running tests. For example, if the
   * branch is a switch statement, the counts array length would be the number of cases in the switch statement.
   */
  @ser(name='b')
  branchReachedCount: map<int, IstanbulBranchReachCounts> schema suffix 'BRCHCNT'

  /**
   * Key is a unique integer generated by the instrumentation to identify each function.
   * Value represents the number of times the function has been reached by the Istanbul code coverage tool when
   * running tests.
   */
  @ser(name='f')
  functionReachedCount: map<int, int> schema suffix 'FNCNT'

  /**
   * Statement map used by Istanbul coverage tool to map unique ids that are embedded into instrumented code representing
   * statements, to the file locations in uninstrumented code.
   */
  // TODO: remove statementMap here to reduce storage. It's possible to recreate the statement map when generating reports.
  statementMap: map<int, IstanbulCoverageLocation> schema suffix 'STMTMAP'

  /**
   * Branch map used by Istanbul coverage tool to map unique ids that are embedded into instrumented code representing
   * branches, to the file locations in uninstrumented code.
   */
  // TODO: remove branchMap here to reduce db storage. It's possible to recreate the branch map when generating reports.
  branchMap: map<int, IstanbulBranchMetadata> schema suffix 'BRCHMAP'

  /**
   * Function map used by Istanbul coverage tool to map unique ids that are embedded into instrumented code representing
   * functions, to the file locations in uninstrumented code.
   */
  // TODO: remove functionMap to reduce db storage. It's possible to recreate the function map when generating reports.
  @ser(name='fnMap')
  functionMap: map<int, IstanbulFunctionMetadata> schema suffix 'FNMAP'

  /**
   * Json map of input sources.
   */
  inputSourceMap: IstanbulCoverageInputSourceMap schema suffix 'ism'

  /**
   * Creates a IstanbulCoverageFileResult for each file coverage result in a Istanbul coverage object.
   * @param coverage
   *      json coverage object produced by Istanbul
   * @return true if successfully created new IstanbulCoverageFileResult instance.
   */
  loadCoverage: function(coverage: json)

  /**
   * Generates an array of coverage objects from all of the persisted IstanbulCoverageFileResult's, each of which can be
   * fed into Istanbul collector to generate reports.
   *
   * @return A Json containing all Istanbul coverage object json
   */
  generateCoverageJson: function(): json

  /**
   * Transform {@link CodeCoverageCounter} objects to Istanbul format.
   *
   * @param counters
   *        The {@link CodeCoverageCounter} objects to be transformed.
   * @return
   *        The transformed {@link CodeCoverageCounter} objects as {@link IstanbulCoverageFileResult} objects.
   */
  fromCodeCoverageCounter: function(counters: [CodeCoverageCounter]): [IstanbulCoverageFileResult]
}
