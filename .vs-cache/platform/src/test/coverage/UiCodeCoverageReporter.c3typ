/**
 * C3 Type for generating code coverage reports for UI ts/tsx files.
 */
type UiCodeCoverageReporter {

  chromeResultsDir: const string = "chromeCoverage"
  scriptSourcesDir: const string = "scriptSources"

  @nodejs(typeSystem=true, async=true)
  convertV8ToIstanbulCoverageFileResult: function(pkgFilePaths: [string],
                                                  dataDirPath: string,
                                                  repoDir: string): json js-nyc-server-node

  /**
   * Takes v8 coverage data and converts it to istanbul format.
   * @param packageFilesMap
   *           A map of the file name to package file path.
   * @param chromeResults
   *           The {@link UiCodeCoverageChromeResult}s associated with the test run.
   * @param scriptSources
   *           The {@link UiCodeCoverageScriptSource}s associated with the test run.
   * @return The istanbul report json.
   */
  @nodejs(typeSystem=true, async=true)
  convertV8ToIstanbul: function(packageFilesMap: map<string, string>,
                                chromeResults: [UiCodeCoverageChromeResult],
                                scriptSources: [UiCodeCoverageScriptSource]): json js-nyc-server-node

  /**
   * Replaces the file paths generated by v8ToIstanbul, with actual paths in the filesystem that point to the
   * original source files.
   *
   * @param istanbulReportMap
   *           The istanbulReportMap, which is a merge of all the reports for each file.
   * @param istanbulPathToFileSourceMap
   *           A mapping from istanbulPath (the one generated by v8ToIstanbul) to the filesystem path for the source file.
   * @return The modified istanbulReportMap.
   */
  @nodejs
  replaceIstanbulPathsWithFileSourcePaths: function(istanbulReportMap: !json,
                                                    istanbulPathToFileSourceMap: !json): json js-nyc-server-node

  /**
   * Gets the filename from an URL.
   *
   * @param url
   *           The URL from which to extract the filename.
   * @return The filename.
   */
  @nodejs
  getFileNameFromUrl: function(url: !string): string js-nyc-server-node

  /**
   * This function is required because the way that IstanbulLibCoverage.merge works is that
   * it uses the `path` value to determine whether to perform a report merge or not.
   * Because we use federated modules, we can have the same source file reported as two different
   * federated modules, which have different paths.
   * To rectify this, when we detect that a source file is being reported that is already in the `istanbulReportMap`,
   * we use the existing federated module path for that source file, and copy that over the currently reported
   * federated module path in `istanbulReport`. Then the report is passed to the `IstanbulLibCoverage.merge` function
   * which performs the merge properly.
   *
   * @param istanbulReportMap
   *           The istanbulReportMap, which is a merge of all the reports for each file.
   * @param istanbulReport
   *           The istanbul report for a single file.
   * @param relevantFileName
   *           The file that is associated with the report.
   */
  @nodejs
  swapPathForExisting: function(istanbulReportMap: !json,
                                istanbulReport: !json,
                                relevantFileName: !string): json js-nyc-server-node
}
