/**
 * IstanbulCoverageCoordinate is a location in code (line and column number) used in {@link IstanbulCoverageFileResult}.
 * Note that line is 1-based, but column is 0-based.
 */
type IstanbulCoverageCoordinate schema name 'ISTCOVCOORD' {

  /**
   * Line of statement, branch, or function used by Istanbul.
   */
  line: int

  /**
   * Column of statement, branch, or function used by Istanbul.
   */
  column: int
}
