/**
 * A type to store the results of a UI code coverage run, for a specific test file.
 */
entity type UiCodeCoverageChromeResult mixes Value {

  /**
   * The name of the file being tested.
   */
  testFileName: !string

  /**
   * The coverage result. This is in the Chrome V8 results format.
   * This should be `json` value type, but it seems there's a bug when trying to persist in this field.
   */
  coverageResult: !string

  /**
   * The name of the package under test.
   */
  pkgName: !string
}
