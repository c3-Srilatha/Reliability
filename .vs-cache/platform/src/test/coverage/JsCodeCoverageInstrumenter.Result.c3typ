/**
 * C3 Type for instrumenting files.
 */
type JsCodeCoverageInstrumenter.Result {

  instrumentedCode: !string
  sourceCode:       !string
  sourcePath:       !string
  statementMap:     map<int, json>
  branchMap:        map<int, json>
  functionMap:      map<int, json>
}
