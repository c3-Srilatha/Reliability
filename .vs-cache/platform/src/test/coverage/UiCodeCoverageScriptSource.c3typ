/**
 * A type to capture the intermediate code, and source map, from the test coverage run for a single file.
 */
@db(unique=["scriptUrl"])
entity type UiCodeCoverageScriptSource mixes Value {

  // The source code captured by Debugger.getScriptSource(scriptId)
  scriptSource: !string

  // The webpack url
  scriptUrl: !string

  // The source file name (i.e., UiSdlButton.ts)
  sourceFileName: !string
}
