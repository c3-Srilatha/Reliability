/**
 * C3 Type for generating code coverage reports for JS files.
 */
type JsCodeCoverageReporter {

  /**
   * Execute nyc report --reporter=text --reporter=json-summary on the supplied working directory
   * @param workingDir
   *        working directory to execute nyc report
   * @param reportDir
   *        directory to save nyc report to
   */
  @nodejs(async=true)
  generateJsonReport: function(workingDir: string, reportDir: string) js-nyc-node
}
