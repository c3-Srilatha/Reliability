/**
 *  Wrapper for counts array, representing the number of times each of
 * the branches has been reached by the Istanbul code coverage tool when running tests. For example, if the
 * branch is a switch statement, the counts array length would be the number of cases in the switch statement.
 */
type IstanbulBranchReachCounts schema name 'BRCNTS' {

  /**
   * An array of counts, each index in array represents a different branch path for a branch.
   */
  counts: [int] schema suffix 'CNTS'
}
