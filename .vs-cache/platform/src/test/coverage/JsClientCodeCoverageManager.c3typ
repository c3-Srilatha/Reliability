type JsClientCodeCoverageManager mixes CodeCoverageManager {

  initialize:       ~ js-client
  statementReached: ~ js-client
  branchReached:    ~ js-client
  functionReached:  ~ js-client
  incrementCounter: ~ js-client

  /**
   * Util method to aggregate and return an array of {@link CodeCoverageReachCounter} from window.codeCoverageCounters
   */
  fetchCoverageNumbersFromBrowser: function(): [json] js-client

  /**
   * Get the coverage numbers from browser by calling {@link fetchCoverageNumbersFromBrowser},
   * and persist the numbers by calling {@link upsertCounters}.
   */
  upsertCountersFromClient: function() js-client
}
