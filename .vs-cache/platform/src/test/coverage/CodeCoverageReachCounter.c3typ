/**
 * {@link CodeCoverageReachCounter} is used by {@link CodeCoverageManager} to track
 * how many times a statement, function, or branch is reached.
 */
entity type CodeCoverageReachCounter schema name 'CODECOVRC' {

  /**
   * Number of times a statement, function, or branch is reached.
   */
  count: !int

  /**
   * File path of the source code
   */
  sourcePath: !string

  /**
   * Type of the counter
   */
  reachType: !string enum CodeCoverageReachType

  /**
   * An integer generated by the instrumentation to identify each statement, function, or branch
   */
  number: !int
}
