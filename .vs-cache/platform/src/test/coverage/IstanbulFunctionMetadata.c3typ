/**
 * IstanbulFunctionMetadata represets Istanbul map value for the functionMap property
 * used in {@link IstanbulCoverageFileResult}.
 */
type IstanbulFunctionMetadata schema name 'ISTFNMETA' {

  /**
   * Name of the function used by Istanbul.
   */
  name: string

  /**
   * Location of function declaration used by Istanbul.
   */
  decl: IstanbulCoverageLocation schema suffix 'FNCOVDECL'

  /**
   * Location of function used by Istanbul.
   */
  loc: IstanbulCoverageLocation schema suffix 'FNCOVLOC'

  /**
   * Line for function used by Istanbul.
   */
  line: int

  /**
   * Optional parameter used by Istanbul to skip the function for code coverage.
   */
  skip: boolean
}
