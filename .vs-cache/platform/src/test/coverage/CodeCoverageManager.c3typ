/**
 * CodeCoverageManager holds functions used to collect data about code execution for JavaScript code.
 *
 * Refer to {@link CodeCoverage.c3doc Code Coverage} for usage information.
 */
type CodeCoverageManager {

  /**
   * Relative file path of the source code generated by the instrumenter
   * E.g. "/repo/pkg/src/my path/file.txt"
   */
  sourcePath: !string

  /**
   * Setup {@link InMemoryKvStore} and return {@link CodeCoverageManager}
   * @param sourcePath
   *           The relative file path to the instrumented file
   * @return An initialize {@link CodeCoverageManager} with {@link sourcePath} populated.
   */
  initialize: function(sourcePath: !string): !CodeCoverageManager

  /**
   * Updates the {@link CodeCoverageReachCounter} for this sourcePath to increment the statement reached count.
   * @param sourcePath
   *           The relative file path to the instrumented file.
   * @param number
   *           The instrumented number of  the statement.
   */
  statementReached: inline member function(number: !int): !boolean

  /**
   * Updates the {@link CodeCoverageReachCounter} for this sourcePath to increment the branch reached count.
   * @param sourcePath
   *           The relative file path to the instrumented file.
   * @param number
   *           The instrumented number of  the branch.
   */
  branchReached: inline member function(number: !int): !boolean

  /**
   * Updates the {@link CodeCoverageReachCounter} for this sourcePath to increment the function reached count.
   * @param sourcePath
   *           The relative file path to the instrumented file.
   * @param number
   *           The instrumented number of  the function.
   */
  functionReached: inline member function(number: !int): !boolean

  /**
   * @return {@link CodeCoverageCounter}s from all {@link CodeCoverageReachCounter}s in {@link InMemoryKvStore}
   */
  createCoverageCounter: function(): [CodeCoverageCounter]

  /**
   * Remove all {@link CodeCoverageReachCounter}s from {@link InMemoryKvStore}
   */
  removeCoverageDataFromInMemoryKvStore: function()

  /**
   * @return a singleNode {@link InMemoryKvStore} instance
   */
  db: private inline function(): !InMemoryKvStore

  /**
   * Increment {@link CodeCoverageReachCounter} in {@link InMemoryKvStore}
   * @param sourcePath
   *           The relative file path to the instrumented file.
   * @param reachType
   *           e.g. StatementReached, FunctionReached, BranchReached
   * @param number
   *           The instrumented number of the function, statement, or branch.
   */
  incrementCounter: private inline function(sourcePath: !string,
                                            reachType: !string enum CodeCoverageReachType,
                                            number: !int)

  /**
   * Bulk upsert {@link CodeCoverageReachCounter}s to {@link InMemoryKvStore}.
   * The function is used to track js client code coverage. To improve performance, each individual
   * statement/branch/function reached calls are cached in a local variable in the browser.
   * On browser close, all counters are upserted at once.
   *
   * @param counters
   *          {@link CodeCoverageReachCounter}s to upsert
   */
  upsertCounters: function(counters: ![CodeCoverageReachCounter])
}
