/**
 * IstanbulBranchMetadata is used by Istanbul coverage tool to map unique ids that are embedded into instrumented code representing
 * branches, to the file locations in uninstrumented code. Used by {@link IstanbulCoverageFileResult}.
 */
type IstanbulBranchMetadata schema name 'ISTBRMETA' {

  /**
   * The type of the branch (e.g. "if" or "switch") used by the Istanbul code coverage tool
   */
  @ser(name='type')
  branchType: string

  /**
   * Line of branch used by Istanbul.
   */
  line: int

  /**
   * Location of branch used by Istanbul.
   */
  loc: IstanbulCoverageLocation

  /**
   * Locations of each part of the branch used by Istanbul.
   */
  locations: [IstanbulCoverageLocation] schema suffix 'LOCS'
}
