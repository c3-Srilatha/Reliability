/**
 * A spec for {@link WebDriverBase.getPerformanceTiming}.
 */
type UiPerformanceTimingSpec mixes Obj {

  /**
   * Selectors for detecting whether the page has been loaded. The page is assumed to be loaded when all the selectors
   * exists.
   */
  keyElementSelectors: [string]

  /**
   * The base url of the page to load, which is usually the vanity url.
   * Prepending this to the {@link path} is our {@link testUrl}.
   */
  baseUrl: string

  /**
   * The path of the page to load (i.e. movie/movies).
   * Appending this to the {@link baseUrl} creates the {@link testUrl}.
   */
  path: string

  /**
   * The url of the page to load. Either this or {@link testPage} is required.
   */
  testUrl: string

  /**
   * Maximum number of time `executeAsyncScript` should be retried.
   * This is necessary to fix "document unloaded while waiting for result" error in chromium.
   */
  maxExecuteAsyncScriptRetry: int = 3

  /**
   * A test page to load. Either this or {@link testUrl} is required.
   */
  testPage: PageLoadTimeMeasurable

  /**
   * The interval for `setTimeout()` for the browser script that generates the performance results.
   */
  pollingIntervalMilliseconds: !int = 20

  /**
   * The maximum amount of time to wait for the results. When this time elapses, any results
   * that have been generated will be returned.
   */
  timeoutSeconds: !int = 60

  /**
   * The chosen performance metrics that we wish to persist as {@link MaximGunStat}s.
   */
  customMetricNames: [string] = ["customPageLoadTime"]
}
