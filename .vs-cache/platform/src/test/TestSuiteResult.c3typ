/**
 * Contains the results of executing a testsuite
 */
// @xml(rootElement='testsuite', compact=true, schema='junit4.xsd')
type TestSuiteResult mixes Result {

  /**
   * Full class name of the test for non-aggregated testsuite documents.
   * Class name without the package for aggregated testsuites documents
   */
  name: !string

  /**
   * when the test was executed. Timezone may not be specified.
   */
  timestamp: !datetime

  /**
   * Host on which the tests were executed. 'localhost' should be used if the hostname cannot be determined.
   */
  hostname: !string

  /**
   * The time in seconds that the suite took to run.
   */
  time: !double

  /**
   * The count of errors not reported as failures (e.g. exceptions happened during the test execution, etc.).
   */
  @ser(name='errors')
  errorCount: !int

  /**
   * The total number of test cases in the suite
   */
  @ser(name='tests')
  testCount: !int

  /**
   * The number of tests skipped. Currently the same as disabled.
   */
  @ser(name='skipped')
  skippedCount: !int

  /**
   * The number of tests disabled. Currently the same as skipped.
   */
  @ser(name='disabled')
  disabledCount: !int

  /**
   * The number of tests that failed (i.e. the test assertion is incorrect).
   */
  @ser(name='failures')
  failureCount: !int

  /**
   * The number of tests that failed to meet the warning threshold.
   */
  @xmlField(hidden=true)
  @ser(name='warnings')
  warningCount: int

  /**
   * The network requests associated with this test suite.
   */
  networkRequests: [LukeNetworkLog]

  /**
   * Array of all tests within the suite.
   */
  testcase: ![TestCaseResult] schema name 'CASE'

  /**
   * Id of the TestRunner batch (if applicable) in which this test ran.
   */
  @xmlField(hidden=true)
  batchId: string

  /**
   * The kind of TestRunner ran this test suite.
   */
  @xmlField(hidden=true)
  testRunnerKind: string enum TestRunnerKind

  /**
   * The category of the test suite.
   */
  @xmlField(hidden=true)
  testCategory: string enum TestCategory

  /**
   * Get all TestCases that failed
   */
  allFailures: member function(): [TestCaseResult]

  /**
   * Get a compilation of the all the failure messages.
   *
   * @return all failure messages.
   */
  allFailureMessages: member function(): string

  /**
   * Calculate the number of tests that passed.
   */
  passedCount: inline property(): int java | js

  /**
   * Make it green - remove all errors and failures.
   */
  withoutErrorsAndFailures: member function(): !mixing TestSuiteResult

  /**
   * The {@link TestSuite} error, if there exists one, that occurred during the TestSuite execution not related
   * the test cases.
   * Not be confused with {@link TestSuiteResult.errorCount}, which refers to the count errors reported in testcases
   */
  @xmlField(hidden=true)
  error: TestError

  /**
   * Standard Output
   */
  stdout: string

  /**
   * Standard Error
   */
  stderr: string

  /**
   * Contains stdout and stderr logs
   */
  logs: string

  /**
   * Builds a TestSuiteResult instance with default values and the provided lambda function.
   *
   * @param builder
   *           The lambda function which follows builder patterns used to build the instance.
   */
  buildResult: function(builder: !lambda(b: ObjBuilder<!TestSuiteResult>)): !?mixing TestSuiteResult

  /**
   * Builds a result corresponding to total testSuite failure.
   *
   * @param className
   *            The test classname
   * @param error
   *            the test error
   * @param duration
   *            duration in seconds
   */
  buildErrorResult: function(className: !string, error: !TestError, duration: !double): !?mixing TestSuiteResult

  /**
   * Convert a TestSuiteResult instance to a serialized XML string.
   */
  toXmlString: ~

  /**
   * Convert from a junit XML file to a TestSuiteResult instance
   */
  fromXmlString: ~

   /**
    * Sanitizes a (test result) string for XML serialization
    * @param s
    *          String to sanitize
    * @return
               Sanitized string
    */
  sanitizeForXml: function(s: !string): !string
}
