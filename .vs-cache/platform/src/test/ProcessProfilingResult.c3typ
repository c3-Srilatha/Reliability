/**
 * Type containing the results of profiling a process's memory usage.
 */
type ProcessProfilingResult mixes Result {

  /**
   * PID of the process profiled
   */
  pid: !int

  /**
   * A collection of measurements, along with the times at which the measurements were made. The measurements are of
   * the process's memory allocation, measured in KB.
   */
  allocatedMemMBAndTimes: ![Pair<double, datetime>]

  /**
   * @returns an {@link Array} of the measurements contained within {@link #allocatedMemKBAndTimes} (in the same order).
   */
  allocatedMemMB: member function(): ![double]

  /**
   * @returns an {@link Array} of the times contained within {@link #allocatedMemKBAndTimes} (in the same order).
   */
  times: member function(): ![datetime]
}
