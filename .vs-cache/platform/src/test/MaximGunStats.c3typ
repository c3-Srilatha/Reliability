/**
 * PSR test (aka Maxim gun fire) execution statistics.
 */
type MaximGunStats {

  /**
   * Statistic for times for success.
   */
  successTime: MaximGunStat

  /**
   * Statistic for times for failure.
   */
  failureTime: MaximGunStat

  /**
   * @return success rate [0,1]
   */
  successRate: inline member function(): !double

  /**
   * Messages from any errors encountered during execution.
   */
  errorMessages: [string] schema suffix 'ERRMSG'

  /**
   * Record the successful responses obtained from the requests when {@link MaximGunOptions#recordResponses}
   * is set to be true
   */
  successResponses: [json] schema suffix 'SR'

  add: private member function(other: !?MaximGunStats): MaximGunStats
}
