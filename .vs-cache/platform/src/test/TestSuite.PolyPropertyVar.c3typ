/**
 * Declare the type and filters of variables to be used in {@link PolyProperty}
 */
abstract type TestSuite.PolyPropertyVar {

  /**
   * The `ValueType` of the variable
   */
  valueType: string serialized ValueType

  /**
   * Filter for generation of the variable
   */
  pbtFilter: string serialized Expr
}
