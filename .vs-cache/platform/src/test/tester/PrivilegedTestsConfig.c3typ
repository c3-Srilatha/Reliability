/**
 * A config to specify the tests to run with escalated privileges.
 */
@action(group+='cluster-admin')
type PrivilegedTestsConfig mixes Config, Singleton {

  /**
   * Set of test paths to run as a privileged user.
   */
  paths: set<string serialized Pkg.Path>

  /**
   * This method is used to whitelist platform tests to run as a privileged user.
   */
  whitelistPlatformTests: member function(override: string enum ConfigOverride)
}
