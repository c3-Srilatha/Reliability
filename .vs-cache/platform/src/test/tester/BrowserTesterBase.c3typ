/**
 * Base type Containing infrastructure to executes tests in the browser.
 * It is not associated with any specific {@link ImplLanguage.Runtime}.
 */
type BrowserTesterBase {

  /**
   * Whether or not tests should be executed in headless mode.
   */
  headless: boolean = false

  /**
   * Path relative to `ui/content` to find the `.html` to load.
   * The html file should expect to receive a `file` parameter that indicates which test to run.
   */
  testerHtmlPagePath: string

  /**
   * Returns stringified JS code that will be executed asynchronously in the browser window to determine whether page is ready for interaction.
   */
  testerHtmlPageReadyFunc: member function(): !string

  /**
   * Returns stringified JS code that will be executed asynchronously in the browser window to run test and collect results.
   */
  testerHtmlPageRunTestFunc: member function(): !string

  /**
   * The full URL browser window should visit when running a test with all necessary query params.
   * e.g. http://localhost:8888?file=/uiDemo/test/js-browser-luke/test_navMenuHighlighting.js&includedPatterns=
   *
   * @param baseUrl
   *          The baseUrl to build on top of
   * @param testSuitePath
   *          TestSuite Pkg.Path
   * @param spec
   *          Configuration spec
   */
  generateTestUrl: member function(baseUrl: !Url, testSuitePath: !string, spec: TesterRunSpec): !Url

  /**
   * List of arguments passed to the browser.
   */
  seleniumArgCapabilities: member function(browser: !string enum Browser): [string]

  /**
   * Runs the given testSuite in browser by:
   *
   * 1. Configuring and starting a browser session
   * 2. Visiting the url generated by {@link #generateTestUrl}
   * 3. Calling {@link #waitForTestCompletion}
   * 3. Calling {@link #collectTestResults}
   *
   * @param testSuitePath
   *           The test suite represented by its {@link Pkg.Path}.
   * @param spec
   *           The {@link TesterRunSpec} with attributes required to run the Test Suite.
   */
  runTestSuiteInBrowser: member function(testSuiteCode: !string,
                                         testSuitePath: !string serialized Pkg.Path,
                                         spec: TesterRunSpec): !TestSuiteResult
}
