/**
 * This {@link TsBrowserTester} is in charge of running uiInfrastructureReact UI unit tests in the browser.
 */
// TODO: MIG8-3548 Move to `uiInfrastructureReact`
type TsBrowserC3UiTester mixes BrowserTesterBase, Tester {

  requirement:               ~
  engine:                    ~ = "ts-c3ui-client-browser-test"
  testerHtmlPagePath:        string = "c3/test.html"
  maxRetries:                int = 3
  runTestSuiteCode:          ~
  cancel:                    ~
  testerHtmlPageReadyFunc:   ~
  testerHtmlPageRunTestFunc: ~
}
