/**
 * Base type Containing infrastructure to executes tests in the browser.
 * It is not associated with any specific {@link ImplLanguage.Runtime}.
 */
type BrowserTesterBase.Config mixes Config, Singleton {

  /**
   * List of browsers to test against.
   */
  browsers: [string] = ["CHROME"]

  /**
   * List of extensions to install and load into the browser.
   */

  /**
   * Luke test completion timeout in seconds.
   */
  lukeTestTimeout: int = 1800

  /**
   * Timeout for BrowserTesterBase.testerHtmlPageReadyFunc in seconds.
   */
  testerHtmlPageReadyFuncTimeout: int = 900

  /**
   * Script timeout in seconds.
   * This must be greater than jasmine.DEFAULT_TIMEOUT_INTERVAL which is 1800s by default.
   * This must be less than hardcoded selenium helm value SE_NODE_SESSION_TIMEOUT which is 3600s by default.
   */
  @constraint(condition='scriptTimeout > 1800 && scriptTimeout < 3600')
  scriptTimeout: int = 2000

  /**
   * Page load timeout in seconds.
   */
  pageLoadTimeout: int = 900

  /**
   * Maximum number of retires.
   */
  @constraint(condition='maxRetries > 0 && maxRetries <= 5')
  maxRetries: int = 3
}
