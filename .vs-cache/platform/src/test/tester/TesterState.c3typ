/**
 * All possible states of a {@link Tester}
 */
enum type TesterState {

  /**
   * The tester has been initialized
   */
  INITIAL = 'initial'

  /**
   * The tester is running
   */
  RUNNING = 'running'

  /**
   * The tester has completed
   */
  COMPLETED = 'completed'

  /**
   * The tester has been cancelled
   */
  CANCELED = 'canceled'

  /**
   * The tester failed
   */
  FAILED = 'failed'
}
