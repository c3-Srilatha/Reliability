// TODO: PLAT-85298 remove remixable.
@typesys(remixable=true)
type JsServerTester mixes Tester {

  runTestSuiteCode: ~ js-server
  requirement:      ~
  engine:           ~ = "js-server-rhino"
  cancel:           ~

  /**
   * Evaluate test suite into rhino context, transpile code to es5 if necessary
   */
  evaluateTestSuite: private member function(code: string, sourceName: string)
}
