type JsVsceTester mixes Tester {

  /**
   * The version of VS Code to install and use for testing.
   * Note: When a new VS Code version is released, manually update this field and `testVsCodeVersion` in `runUiTests.ts`.
   */
  vscodeVersion: const string = '1.93.1'

  /**
   * Whether or not to use VS Code Insiders for VSCE test pipeline.
   * Manually update this field to be `true` if you want to run an insiders build.
   * See {@link https://code.visualstudio.com/insiders}
   */
  useInsiders: const boolean = false

  /**
   * Returns the path of runtime root.
   */
  runtimeRoot: private cached function(): !string js-vscetester-server-node

  /**
   * Initialize and prepare for the test session.
   * It does the following things:
   *    1. Override the stdout for node process.
   *    2. Start the process for video recording.
   *    3. Prepare tests/workspace, installs vsix, and other extensions.
   */
  initTestSession: private function(testSuites: ![string serialized Pkg.Path],
                                    spec: !TesterRunSpec): Promise<void> js-vscetester-server-node

  /**
   * Run the given test suites.
   */
  runTestSession: private function(testSuites: ![string serialized Pkg.Path]): Promise<void> js-vscetester-server-node

  /**
   * After the test session finishes, clean up the session, upsert the logs, and return the test results.
   */
  afterTestSession: private function(testSuites: ![string serialized Pkg.Path],
                                     spec: !TesterRunSpec): Promise<!map<string serialized Pkg.Path, TestSuiteResult>> js-vscetester-server-node

  @nodejs(typeSystem=true, async=true)
  runTestSuiteCode: ~ js-vscetester-server-node

  @nodejs(typeSystem=true, async=true)
  runTestSuiteCodes: ~ js-vscetester-server-node

  requirement: ~
  engine:      ~ = "js-vscetester-server-node"
  cancel:      ~
}
