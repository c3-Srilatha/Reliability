/**
 * Tester that can run Playwright browser tests for testing {@link VsCodeServer}.
 */
@beta
private type VsCodeServerTester mixes PlaywrightTester {

  requirement:      ~
  cancel:           ~
  engine:           ~ = "js-vscodeplaywright-server-node"
  runTestSuiteCode: ~ js-vscodeplaywright-server-node

  /**
   * Browser VS Code tests will be run in a single session. See {@link TesterRunSpec#inSingleSession}.
   */
  runTestSuiteCodes: ~ js-vscodeplaywright-server-node
}
