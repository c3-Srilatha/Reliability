/**
 * The concrete implementation of {@link PyTester} for Python client tests
 */
type PyClientTester mixes PyTester {

  /**
   * This function executes the pytest and prints the json-serialized results to the named pipe at the provided path.
   */
  executePytestAndPrintResult: private function(tempDirectory: !string,
                                                testSuite: !string,
                                                namedPipePath: !string,
                                                spec: TesterRunSpec) py-client

  requirement: ~
  engine:      ~ = "py-ipython-client"
}
