/**
 * The {@link Tester} for running pytests.
 */
abstract type PyTester mixes Tester {

  runTestSuiteCode: ~

  runTestSuite: private abstract member function(tempDirectory: !string,
                                                 testSuite: !string,
                                                 spec: TesterRunSpec): !TestSuiteResult

  /**
   * Private function to execute pytest test code and collect test results
   * Tests the given code using the pytest framework.
   *
   * @param tempDirectory
   *        top level temp directory that contains the pytest and conftest.py files for this test
   * @param testSuite
   *        metadata path of the test file
   * @param spec
   *        a TesterRunSpec to specify other tester options.
   * @return a {@link TestSuiteResult} by parsing pytest output of executing tmpFileContent
   */
  executePyTest: private function(tempDirectory: !string,
                                  testSuite: !string,
                                  spec: TesterRunSpec): !TestSuiteResult py

  /**
   * Find the local system path given {{metadataPath}} for a Python file. Return a string of code for PyTest to execute.
   * The return value will be written to tmp file; running PyTest against this tmp file will run your PyTest code
   * compiled to point towards file located at absolute path of the Python file. Debugger will catch breakpoint in your
   * Python code.
   *
   * @param metadataPath
   *        metadataPath of the Python file
   * @return "exec(compile(" + Str.quote(python code) + ", " + Str.quote(absolute path of Python file)+ ", 'exec'))"
   */
  tmpFileContentForPytest: private function(pyTest: !string serialized Pkg.Path): !string

  /**
   * Check if conftest.py file exists in the same directory as the given {{metadataPath}}.
   * If yes, call {@link tmpFileContentForPytest} with the {@link Pkg.Path} for the conftest file
   * to get a string of code for PyTest to import conftest before running a PyTest.
   *
   * @param pyTest
   *        metadataPath of the pytest file
   * @return "exec(compile(" + Str.quote(conftest code) + ", " + Str.quote(absolute path of conftest) + ", 'exec'))"
   */
  tmpFileContentForConftest: private function(pyTest: !string serialized Pkg.Path): string

  /**
   * Given a pyTest file path, returns all corresponding conftest files in the pkg.
   * @param pyTest
   *        metadataPath of the pytest file
   * @return array of conftest file Pkg.Path names
   */
  conftestFilesForPytest: private function(pyTest: !string serialized Pkg.Path): [string serialized Pkg.Path]

  /**
   * Writes the pytest and conftest (if any) content to a temporary directory and returns the top level temp directory path.
   */
  writeLocalPyTestFiles: private function(pyTest: !string serialized Pkg.Path): !string

  /**
   * Replace dots(.) (if any) in filename with underscores (_) to make module importable.
   */
  pytestFileName: private function(pyTest: !string serialized Pkg.Path): !string

  /**
   * Sanitize XML content by removing all invalid characters and escaping quotation marks with their XML equivalents.
   */
  sanitizeXmlContent: private function(xml: string): string py

  /**
   * Generate {@link TestSuiteResult} for pytest result based on the information provided. It's pulled into c3typ for testing purpose.
   */
  generateTestSuiteResult: private function(testResultsXml: string,
                                            capturedStdout: string,
                                            capturedStderr: string,
                                            suiteName: string,
                                            startTime: datetime): TestSuiteResult py
}
