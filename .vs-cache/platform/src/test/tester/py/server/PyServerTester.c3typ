/**
 * This C3 Type is used for running PyTests for the location {@link ImplLanguage.RuntimeLocation#SERVER}
 */
type PyServerTester mixes PyTester {

  /**
   * @return "py-server"
   */
  requirement: ~

  engine: ~ = "py-data_312-server-jep"
}
