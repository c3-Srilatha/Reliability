/**
 * The {@link Tester} for testing JupyterNotebooks.
 */
type NotebookTester mixes Tester {

  requirement:      ~
  engine:           ~ = "py.3.12-notebook_runner-server-py4j"
  runTestSuiteCode: ~ py-notebook_runner-py4j
  cancel:           ~

  /**
   * Helper API for tests running as part of NotebookTester.
   * escalates the privilege for K8sAPIServer#isHealthy call if the original call is
   * originated from NotebookTester#runCellsTest and NotebookTester#runTestSuiteCode
   */
  isK8sHealthy: function(): boolean

  /**
   * Endpoint to use from JupyterLab.
   *
   * @param sessionPath
   *   If set, use this path to create the session used to run the test. It should refer to
   *   a randomized file name in the same directory as the notebook. The test can then be
   *   canceled by terminating the session, which can be looked up by the path.
   *
   *   If not specified, a path will be randomly generated,
   */
  runCellsTest: member function(cells: ![!JupyterNotebook.Cell],
                                kernelName: !string,
                                notebookName: string,
                                notebookPath: string,
                                sessionPath: string,
                                spec: JupyterLab.Session.CellExecutionSpec): !TestSuiteResult py-notebook_runner-py4j
}
