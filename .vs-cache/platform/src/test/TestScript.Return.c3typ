/**
 * A return statement is used to return an object in a poly KPI test to measure the size of for the "retainedMem"
 * metric. This is only legal in "measure" blocks of poly KPI tests.
 */
type TestScript.Return mixes TestScript.Statement {

  /**
   * The value to return.
   */
  value: !string serialized Expr
}
