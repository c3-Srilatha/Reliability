/**
 * "Poly test script" is a simplified JavaScript for building cross-language tests. It allows simple specification of
 * test case logic that can be translated to different languages easily and designed to require a minimal amount of
 * typing.
 *
 * ```
 * what = Parrot.polly()
 * what == "Polly wants a cracker"
 * ```
 *
 * JavaScript statements are executed as-is except that top-level expressions that would lose their side-effects are
 * treated as assertions. In the example above, “what = Parrot.polly()” is an “expression statement”, but since it’s an
 * assignment, it is not treated as an assertion. However, “what == …” is a top-level inequality that gets translated
 * to an assertion:
 *   - JUnit: `assertEquals("Polly wants a cracker", what)`
 *   - Jasmine: `expect(what).toBe("Polly wants a cracker")`
 *   - PyTest: `assert what == "Polly wants a cracker"`
 *
 * @see TestSuite
 * @see poly-test.c3doc.md#test-code
 */
type TestScript mixes StringSerializable, Spec {

  /**
   * The raw code of the test script.
   */
  code: !string

  /**
   * The file name of the test suite if known.
   */
  fileName: string

  /**
   * If loaded from a Markdown file, the line number of the first line of code for this script. This will generally
   * be the line after the opening fenced code block marker.
   */
  codeLineNumber: int32

  /**
   * The parsed statements of script. Some validation is done at this point:
   *  - each statement must be valid JavaScript (ES5)
   *  - the statements must be mappable to a {@link Statement} sub-type
   *
   * However, the script statements may still not be valid. For example, if they refer to invalid globals that will
   * not be caught here.
   *
   * @see validateGlobals
   */
  statements: member function(): [TestScript.Statement]

  /**
   * The plain variables set in assignment statements in this script. If the script is not valid, this may be
   * incomplete.
   *
   * @see #externalVars
   * @see TestScript.Assignment#var
   */
  vars: member function(): set<!string>

  /**
   * The references to variables which are not set via assignment statements in this script. If the script is not valid,
   * this may be incomplete.
   *
   * This does not include JavaScript globals like `NaN`, but does include type names and variables that may be
   * initialized by other script blocks.
   *
   * Each reference is the variable name and the line number on which it first appears.
   *
   * @see #vars
   * @see #builtins
   */
  externalVars: member function(): set<Pair<!string, int32>>

  /**
   * The names of global variables available to scripts. These represent JavaScript globals like `NaN` which are also
   * usable in poly test script. Note that this does not include built-in objects like `Date` or `Array` because the
   * native values should not be used; the corresponding C3 types must be used instead. It also includes the implicit
   * global `C3`.
   */
  builtins: cached function(): set<string>
}
