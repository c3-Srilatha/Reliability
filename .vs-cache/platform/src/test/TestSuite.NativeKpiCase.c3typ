/**
 * A KpiCase used to measure native language code. The common use case for a NativeKpiCase is comparing C3 to
 * native language performance. Just as any other NativeCase, the content of the code blocks must follow the syntax
 * of the native language. Just as any other KpiCase, a MicrobenchSpec can be returned from a `setup` block, and a
 * result can be returned from a `measure` block. A KpiCase can be claimed as a NativeKpiCase by specifying the
 * location in the header of the markdown block as shown below:
 *
 *     ```setup
 *     let someVar = 2;
 *     let someOtherVar = 0;
 *     return MicrobenchSpec.make({measureMemAllocations: true});
 *     ```
 *
 *     ```measure 1M times, js, x: js-server PLAT-12345
 *     return someVar + someVar;
 *     ```
 *
 *     ```assert
 *     expect($result).toBe(4);
 *     ```
 *
 * NOTE: the assert and setup blocks inherit the location and ignores of the measure block
 */
type TestSuite.NativeKpiCase mixes TestSuite.KpiCase<string>, TestSuite.NativeCase {

  /**
   * If loaded from a Markdown file, the line number of the fenced code block for the setup block.
   */
  setupLineNumber: int32

  /**
   * If loaded from a Markdown file, the line number of the fenced code block for the assert block.
   */
  assertLineNumber: int32
}
