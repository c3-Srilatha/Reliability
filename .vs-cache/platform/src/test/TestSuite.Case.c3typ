/**
 * A single test case defined in the file. The boils down to a single code block with its name from the heading
 * hierarchy and comments from Markdown paragraphs. Each test case produces a function (or similar structure)
 * named by the heading(s) and with the textual content as comments.
 */
abstract type TestSuite.Case mixes Nameable {

  /**
   * The test case name is taken from the appended heading texts. If there is no preceding heading, "test" is used.
   * All names are unique within the test suite so they can be used for result reporting.
   */
  name: !~

  /**
   * If loaded from a Markdown file, the line number of the fenced code block.
   */
  lineNumber: int32

  /**
   * The text of the headings active at the point of this test code block. The first heading is the outermost one
   * and the latter ones (if any) are innermost (deeper nesting level) headings.
   */
  headings: [string]

  /**
   * The text of Markdown (other than headings) associated with this test case. Note that this may contain
   * multiple lines.
   */
  comment: string

  /**
   * Ignores of this test case.
   */
  ignore: [TestSuite.Ignore]

  /**
   * The original test code from the fenced code block.
   */
  source: !string

  /**
   * Return the standard requirements to which this case is potentially applicable. This does not take into account
   * ignores, so will return all supported requirements for {@link TestSuite.PolyCase} and just the matching requirements
   * for {@link TestSuite.NativeCase}.
   */
  possibleRequirements: abstract member function(): [string serialized Action.Requirement]

  /**
   * Return the standard requirements for which this case is applicable and not ignored. This will consider all
   * supported requirements for {@link TestSuite.PolyCase} and just the matching requirements for
   * {@link TestSuite.NativeCase} and then remove those which are ignored (globally or just on this case).
   *
   * @param suite the parent test suite (to check global ignores)
   */
  enabledRequirements: member function(suite: TestSuite): [string serialized Action.Requirement]

  /**
   * Count the number of test assertions present in this case. For poly tests, this is exact, but for native cases
   * it may be an estimate.
   */
  countAssertions: abstract member function(): !int

  /**
   * Find all external references in the script(s) for this test case that do not correspond to type names in the
   * specified package or variables set by context. This is a no-op for native cases and will just return an empty
   * list.
   *
   * @param suite the parent test suite (for hooks)
   * @param pkg the package for which to check type names
   * @return a list of unknown variables and the line numbers in the suite
   */
  unknownGlobals: member function(suite: !TestSuite, pkg: !Pkg, failIfInvalid: boolean): set<Pair<string, int32>>
}
