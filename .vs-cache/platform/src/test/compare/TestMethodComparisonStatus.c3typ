/**
 * Instances of {@link TestMethodComparisonStatus} are created after comparing two junit test reports to identify the
 * differences between the two test runs. Test execution status of each test (method) is captured from both "base" and
 * "compare" report to make the comparison easier.
 *
 * A test maybe:
 * 1. Present in both "base" and "compare" reports.
 * 2. Present in only "compare", indicating that it's a potentially newly added test.
 * 3. Present in only "base", indicating that it maybe deleted/refactored in the "compare" run.
 *
 * An array of **TestMethodComparisonStatus** obtained from {@link #fromJunitReports} may be processed in different
 * ways to help manage different initiatives involving migration, feature revamping or simply addressing tech debt.
 */
type TestMethodComparisonStatus mixes WithToString {

  /**
   * Test class from the "base" report
   */
  baseTestClass: string

  /**
   * Test method from the "base" report
   */
  baseTestName: string

  /**
   * Test method status (PASSED, SKIPPED, etc.) from the "base" report
   */
  baseTestStatus: string

  /**
   * Test class from the "compare" report
   */
  compareTestClass: string

  /**
   * Test method from the "compare" report
   */
  compareTestName: string

  /**
   * Test method status (PASSED, SKIPPED, etc.) from the "compare" report
   */
  compareTestStatus: string

  toString: ~

  /**
   * @return an Array of TestMethodComparisonStatus from the "base" and "compare" junit test reports.
   * Junit test reports are aggregated and parsed (using {@link JenkinsTestReport#passedAndSkipped}) and a mapping is
   * created between the reports such that the status of the test in both "base" and "compare" junit test report is
   * captured in one instance of {@link TestMethodComparisonStatus}. Either of the "base" or "compare" data points may
   * be empty if a particular test (method) is only present in one of the two runs.
   *
   * We can also influence the association if either the test class or the test method have been "refactored" between the
   * "base" and "compare" test run by appropriately populating the **renames** map or **testClassMapping** lambda.
   *
   * By default, no "refactoring" is assumed i.e all test classes and test methods should have the same name as "base"
   * version and absence of them in "compare" denotes that they have been **dropped** or **newly added**.
   *
   * Also, only PASSED and SKIPPED ("ignored") tests are used in comparison. All other status like "FIXED", "FAILED", etc.
   * are not considered.
   *
   * @see JenkinsTestReport#passedAndSkipped
   * @see TestComparisonStatus
   * @see TestComparisonStatus#fromJunitReports
   * @see TestComparisonStatus#fromTestMethods
   */
  fromJunitReports: function(baseReport: ![JenkinsTestReport],
                             compareReport: !JenkinsTestReport,
                             renames: map<string, map<string, Pair<string, string>>>,
                             testClassMapping: lambda(old: !string): !string): [TestMethodComparisonStatus]
}
