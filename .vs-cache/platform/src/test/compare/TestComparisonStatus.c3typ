/**
 * Allows encapsulating all the information related to how a test class methods may have changed between "base" and
 * "compare" run.
 * @see TestMethodComparisonStatus
 * @see #fromTestMethods
 * @see #fromJunitReports
 */
type TestComparisonStatus mixes WithToString {

  /**
   * test class of the "base" junit test report
   */
  baseTestClass: !string

  /**
   * set of all "PASSED" tests from the "base" junit test report
   */
  basePassed: set<string>

  /**
   * set of all "SKIPPED" tests from the "base" junit test report
   */
  baseSkipped: set<string>

  /**
   * map of all "PASSED" tests from the associated test classes in "compare" test report for the {@link baseTestClass}
   * in the "base" test report
   */
  comparePassed: map<string, set<string>>

  /**
   * map of all "SKIPPED" tests from the associated test classes in "compare" test report for the {@link baseTestClass}
   * in the "base" test report
   */
  compareSkipped: map<string, set<string>>

  /**
   * @return a comma separated concatenated string of all associated test classes in "compare" test report
   * for the {@link baseTestClass} in the "base" test report
   */
  compareTestClasses: cached member function(): ?string

  /**
   * @return a set of all tests which were passing in both "base" and "compare" reports.
   * @see #skipped
   * @see #dropped
   */
  passed: cached member function(): set<string>

  /**
   * @return a set of all tests which were passing in "base" but are skipped in "compare" report.
   * @see #passed
   * @see #dropped
   */
  skipped: cached member function(): set<string>

  /**
   * @return a set of all tests which were passing in "base" but did not run as part of the "compare" run. These may
   * either be deleted or refactored, and may need some special attention.
   * @see #passed
   * @see #skipped
   */
  dropped: cached member function(): set<string>

  toString: ~

  /**
   * indicate is the test class is manually overridden
   */
  overridden: !boolean

  /**
   * @return an array of **TestComparisonStatus** from the array of {@link TestMethodComparisonStatus}, which already
   * captures the status of the test method in two runs i.e in "base" and "compare" version.
   *
   * Any test which passes in both "base" and "compare" is considered as {@link #passed}.
   * Any test which passes in "base" but is skipped in "compare" is considered as {@link #skipped}.
   * Any test which passed in "base" but is neither passed nor skipped in "compare" is considered as {@link dropped}.
   *
   * @see #passed
   * @see #skipped
   * @see #dropped
   * @see TestMethodComparisonStatus
   */
  fromTestMethods: function(testMethods: ![TestMethodComparisonStatus],
                            completionPredicate: lambda(baseTestClass: !string): boolean): ![TestComparisonStatus]

  /**
   * @return an array of TestComparisonStatus from the "base" and "compare" junit test reports.
   * Parses each test result and builds {@link TestComparisonStatus} for every test class in "base" test unit reports,
   * associated compare test class(s) in "compare" test report.
   *
   * {@link TestMethodComparisonStatus#fromJunitReports} is used to create an array of {@link TestMethodComparisonStatus}
   * which is then parsed using {@link #fromTestMethods} to yield the resulting {@link TestComparisonStatus} array.
   *
   * @see #fromTestMethods
   * @see TestMethodComparisonStatus#fromJunitReports
   */
  fromJunitReports: function(baseReport: ![JenkinsTestReport],
                             compareReport: !JenkinsTestReport,
                             renames: map<string, map<string, Pair<string, string>>>,
                             testClassMapping: lambda(old: !string): !string): [TestComparisonStatus]
}
