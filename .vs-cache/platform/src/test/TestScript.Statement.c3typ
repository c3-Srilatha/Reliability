/**
 * Each distinct statement is one of a small number of types that must be translated into the target language.
 */
abstract type TestScript.Statement {

  /**
   * The line number of start of the statement.
   */
  lineNumber: !int32

  /**
   * The parsed JavaScript statement.
   */
  ast: @java(class='org.mozilla.javascript.ast.AstNode') native

  /**
   * Single-line comment text on the same line as the statement.
   */
  comment: string
}
