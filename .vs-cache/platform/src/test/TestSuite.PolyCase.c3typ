/**
 * Most test cases are in "poly test script", which is a subset of JavaScript that is translated into each of the
 * supported languages. Test blocks without special types (or with the "test" type) are parsed as scripts.
 *
 * For example, by default code blocks define PolyCases:
 *
 *     ```
 *     n = 2 + 2
 *     n === 4
 *     ```
 */
type TestSuite.PolyCase mixes TestSuite.Case {

  /**
   * The script parsed from the source.
   */
  script: !TestScript

  /**
   * The plain variables set in assignment statements in the script. If the script is not valid, this may be
   * incomplete.
   *
   * @see TestScript#vars
   */
  vars: member function(): set<string>

  /**
   * Find all external references in the script for this poly test case that do not correspond to type names in the
   * specified package or variables set in the before hooks.
   *
   * @param suite the parent test suite (for hooks)
   * @param pkg the package for which to check type names
   * @return a list of unknown variables and the line numbers in the suite
   */
  unknownGlobals: ~
}
