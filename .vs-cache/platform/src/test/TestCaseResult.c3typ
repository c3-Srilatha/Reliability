/**
 * Result of running a single test
 */
type TestCaseResult mixes Result {

  /**
   * The full description including all ancestors of this test case.
   */
  classname: !string

  /**
   * The description of the test.
   */
  name: !string

  /**
   * The time, in seconds, that the test case took.
   */
  time: !double

  /**
   * The lineNumber of the test.
   */
  // TODO: PLAT-42140: populate `srcLineNum` in TestCaseResult for all testers
  @xmlField(hidden=true)
  srcLineNum: int

  /**
   * Whether this test was a performance test
   */
  @xmlField(hidden=true)
  isPerformanceTest: boolean

  /**
   * Performance test result
   */
  // TODO: migrate MaximGun
  // @xmlField(hidden=true)
  performanceTestResult: MaximGunStat

  /**
   * Performance test result for custom metrics {@see MaximGunOptions.customMeasurementFields}
   */
  // @xmlField(hidden=true)
  customPerformanceTestResult: map<string, MaximGunStat> schema suffix 'CP'

  /**
   * Status of the test run result.
   */
  status: inline property(): string enum TestCaseResult.Status js

  /**
   * Indicates that the test was skipped.
   */
  skipped: TestSkipped

  /**
   * Indicates that the test error-ed.
   */
  error: TestError

  /**
   * Indicates that the test failed.
   */
  failure: TestFailure

  /**
   * Indicates that the test failed to meet the warning threshold.
   */
  @xmlField(hidden=true)
  warning: TestWarning

  /**
   * Standard Output
   */
  stdout: string

  /**
   * Standard Error
   */
  stderr: string

  /**
   * Contains c3 server, stdout, and stderr logs
   */
  logs: string

  /**
   * Make it green - remove all error and failure.
   */
  withoutErrorAndFailure: member function(): !mixing TestCaseResult
}
