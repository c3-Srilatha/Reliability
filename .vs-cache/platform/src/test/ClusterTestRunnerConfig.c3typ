/**
 * This type is used for configuring a TestRunner job running in a remote cluster. The id of the config is the cluster
 * endpoint
 *
 * @see ClusterTestRunner
 */
// TODO: PLAT-35204 Testing | Refactor or discard ClusterTestRunner.c3typ
@action(group+='cluster-admin')
type ClusterTestRunnerConfig mixes TestRunnerConfig, Config, Identifiable {

  /**
   * Tenant to run the test.
   */
  tenant: string

  /**
   * Tag to run the test.
   */
  tag: string

  /**
   * auth token to be used for running the tests
   */
  @config(secret=true)
  clusterAuthToken: string
}
