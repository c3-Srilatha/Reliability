/**
 * A value assertion checks that the expression yields the expected value.
 */
type TestScript.AssertValue mixes TestScript.Assertion {

  /**
   * The expected value to compare.
   */
  expected: string serialized Expr

  /**
   * The comparison to be performed.
   */
  compare: !string enum TestScript.Compare

  /**
   * For numeric comparisons, the epsilon value if specified.
   */
  epsilon: double
}
