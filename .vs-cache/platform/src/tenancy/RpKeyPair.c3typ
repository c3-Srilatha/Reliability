@deprecated
@db(versionHistory=true)
@facade(tenant='c3', tag='c3')
@action(group+='cluster-admin')
entity type RpKeyPair schema name 'TENANCY_RPKEYPAIR' {

  /**
   * in
   */
  privateKey: string

  publicKeyCertificate: string
  expiry:               datetime

  /**
   * out
   */
  generated: datetime

  expiration:   datetime
  keyStore:     string
  generate:     function(privateKeyFile: string, publicKeyFile: string, expiration: datetime)
  beforeCreate: ~
}
