@deprecated
@db(unique=['name'], index+=['name'], archive=true, versionHistory=true)
@facade(tenant='c3', tag='c3')
entity type VanityUrl schema name 'TENANCY_URL' {

  /**
   * Host portion of the URL. The format of the host conforms to RFC 2732.
   */
  name: !~

  /**
   * Tenant this vanity URL is bound to.
   */
  tenant: !string

  /**
   * Tag this vanity URL is bound to.
   */
  tag: !string

  /**
   * If present, it will be appended to the request url path.
   */
  contentRoot: string

  /**
   * If present, it will be appended to the request url path, after contentRoot.
   */
  defaultContent: string

  /**
   * If TRUE, this Vanity URL is an Okta Sp (will be authenticated through Okta).
   */
  okta: boolean = false

  /**
   * If TRUE, the Vanity URL is upserted/removed only after the DNS record is upserted/removed.
   */
  waitForDns: boolean = false

  /**
   * If TRUE, this Vanity URL has anonymous user access.
   * Api access is defined by the AnonymousAccessRole.
   */
  anonymousUser: boolean = false

  /**
   * If TRUE, this Vanity URL will be protected from CSRF by enforcing the Origin header
   * check and also adding a session token (CSRF).
   */
  csrfProtected: boolean = false

  /**
   * Optional description.
   */
  description: string

  /**
   * This is valid only if the vanity Url is okta=true. It will override the default assertion consumer service url
   * with the given url.
   */
  samlAcsUrl: string

  /**
   * If set, this URL (domain) will be allowed to access C3 server ui content from an IFrame.
   * Basically allows the given url through the 'X-Frame-Options ALLOW-FROM' and Content-Security-Policy frame-ancestors'
   * http request headers.
   */
  iFrameUiContentAccessUrl: string

  /**
   * Endpoint where requests to this vanity url will be proxied to.
   */
  proxiedEndpoint: private Url

  /**
   * Private field used if type is mapped to an external resource
   */
  externalSource: private string enum('okta')

  /**
   * Private field used if type is mapped to an external resource
   */
  externalSourceId: private string

  /**
   * If csrfProtected is TRUE, this control whether the Origin header should be checked.
   */
  csrfOrigin: private boolean = true

  /**
   * Salt used to generate the CSRF token. Needed only for UI access.
   */
  csrfSalt: private string

  /**
   * Set if you want to skip creation of dns entry on dns not managed by underlying cloud services.
   * {@see canRegisterUrl}
   */
  hasExternalDns: boolean

  /**
   * Check if the Url has been added into the DNS registry of Amazon Route53.
   */
  urlRegistrationStatus: member function(): !AwsUrlRegistrationInfo

  /**
   * Register the Url into the DNS registry of Amazon Route53, if the Url is not in the registry yet.
   */
  registerUrl: member function()

  /**
   * Get all the VanityUrls for the given tenant and tag.
   */
  forTenantTag: function(tenant: !string, tag: !string): [VanityUrl]

  /**
   * Check if the Url can be added into the DNS registry of Amazon Route53.
   */
  canRegisterUrl: member function(): boolean

  toString:     ~ java
  beforeCreate: ~
  beforeUpdate: ~
  beforeRemove: ~

  @dependency(include='[id, name, tenant, tag, okta, samlAcsUrl, externalSource, externalSourceId, versionEdits]')
  afterCreate: ~

  @dependency(include='[id, name, tenant, tag, okta, samlAcsUrl, externalSource, externalSourceId, versionEdits]')
  afterUpdate: ~

  afterRemove: ~
}
