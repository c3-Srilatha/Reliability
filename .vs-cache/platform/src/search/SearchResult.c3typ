/**
 * Query Result from SearchStore
 * Sample Json Response
 * ```
 * {
 *   "took": 5,
 *   "timed_out": false,
 *   "hits": {
 *     "max_score": 1.3862942,
 *     "hits": [
 *       {
 *         "index": "my-index-000001",
 *         "id": "0",
 *         "score": 1.3862942,
 *         "document": {
 *           "field": "someText"
 *         }
 *       },
 *       ...
 *     ]
 *   }
 * }
 * ```
 *
 * @see SearchStore
 * @see SearchHit
 */
type SearchResult<T> mixes QueryResult<T> {

  /**
   * Maximum score of the hits
   */
  maxScore: double

  /**
   * Time taken for query
   */
  responseTime: int
}
