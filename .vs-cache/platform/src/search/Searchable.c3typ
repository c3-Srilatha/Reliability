/**
 * Entity type which mixes Searchable will be stored in SearchStore
 *
 * Index Lifecycle management
 * Two primary storage types will be managed during DI:
 * 1. Index -> Schema
 * 2. Documents -> Rows/Data
 *
 * Example:
 * ```
 * @searchIndex(primaryCount=5, replicaCount=5, doNotIndexNameField=false)
 * entity type Company mixes Searchable {
 *      @search
 *      name: string
 *
 *      @search
 *      value: int
 *
 *      // Will not be stored in search store
 *      founder: string
 *
 *      // @search on reference type is not supported
 *      employees: [Person]
 *
 * }
 *
 * type Person {
 *      @search
 *      firstName: string
 *
 *      @search
 *      lastName: string
 *
 *      dob: datetime
 * }
 * ```
 * @see Ann.Search
 */
type Searchable {

  /**
   * Executes a search within the search index based on the options in the SearchQuerySpec
   * Return SearchResult with entity type instances
   */
  search: function(spec: !SearchQuerySpec): SearchResult<mixing Searchable>

  /**
   * Executes a search within the search index based on the options in the SearchQuerySpec
   * Return SearchResult with SearchHit(s), SearchHit has metadata for application development, but does not return
   * data from primary data store, only from SearchStore.
   *
   * @see SearchHit
   */
  searchWithScore: function(spec: !SearchQuerySpec): SearchResult<SearchHit>

  /**
   * Executes a search against one or more search indices based on the options in the SearchQuerySpec
   * Return SearchResult with Obj, which are different entity types that mixes Searchable
   */
  searchMultiple: function(spec: !SearchQuerySpec, types: [string]): SearchResult<Obj>

  /**
   * Executes a search against one or more search indices based on the options in the SearchQuerySpec
   * Return SearchResult with SearchHit(s), SearchHit has metadata for application development, but does not return
   * data from primary data store, only from SearchStore.
   */
  searchMultipleWithScore: function(spec: !SearchQuerySpec, types: [string]): SearchResult<SearchHit>

  /**
   * Returns the corresponding SearchIndex for current type
   */
  searchIndex: member function(): SearchIndex

  /**
   * Fetch the document that was indexed for the corresponding ID for the type instance
   */
  searchDocument: member function(): SearchDocument

  /**
   * Upserts searchable data to search store
   */
  upsertToSearchStore: member function()

  /**
   * Upserts a batch of searchable data to search store
   */
  upsertBatchToSearchStore: function(batch: [Searchable])

  /**
   * Removes a batch of searchable data from search store
   */
  removeBatchFromSearchStore: function(batch: [Searchable])

  /**
   * Removes the searchable data from the search store
   */
  removeFromSearchStore: member function()
}
