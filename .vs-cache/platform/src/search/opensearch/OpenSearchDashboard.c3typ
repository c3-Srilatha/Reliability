/**
 * To use this REST endpoint, you need to configure both @see{REST.apiUrl} and @see{REST.apiAuth}.
 * The cluster admin should save the config at the CLUSTER level.
 * Default REST apiUrl = "http://opensearch-dashboard-opensearch-dashboards.c3-opsadmin:5601"
 * Default REST apiAuth = "Basic @see{Base64.encodeString}(username:password)"
 */
type OpenSearchDashboard mixes REST {

  /**
   * Manage Opensearch-Dashboard saved objects, including index-patterns, dashboards, visualizations, and more.
   */
  @rest(method='GET',
        contentType='application/json',
        acceptType='application/json',
        uri='/opensearch/api/saved_objects/')
  saved_objects: abstract function(@rest(partOfURI=true)
                                   action: string,
                                   @rest(queryParameter=true)
                                   fields: string,
                                   @rest(queryParameter=true, parameterName='type')
                                   _type: string): json
}
