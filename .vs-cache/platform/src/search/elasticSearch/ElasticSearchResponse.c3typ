type ElasticSearchResponse {

  @ser(name='_scroll_id')
  scroll_id: string

  @ser(name='terminated_early')
  terminated_early: boolean

  @ser(name='took')
  took: int

  @ser(name='timed_out')
  timedOut: boolean

  @ser(name='_shards')
  shards: ElasticShardsCount

  @ser(name='hits')
  hits: ElasticHits
}
