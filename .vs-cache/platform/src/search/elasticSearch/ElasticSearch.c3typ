type ElasticSearch mixes REST {

  /**
   * Retrieve a document and its source or stored fields from a particular index.
   * @param index
   *    Name of the index
   * @param docId
   *    Unique identifier of the document
   * @param source
   *    (Optional, string) True or false to return the _source field or not, or a list of fields to return.
   */
  @rest(method='GET', contentType='application/json', acceptType='application/json')
  getDocById: abstract function(@rest(partOfURI=true)
                                index: string,
                                @rest(partOfURI=true, uriPrefix='/_doc/')
                                docId: !string,
                                @rest(queryParameter=true)
  @ser(name='_source')
                                source: string,
                                @rest(queryParameter=true)
  @ser(name='_source_includes')
                                sourceIncludes: string,
                                @rest(queryParameter=true)
                                preference: string,
                                @rest(queryParameter=true)
                                realtime: boolean,
                                @rest(queryParameter=true)
                                refresh: boolean,
                                @rest(queryParameter=true)
                                routing: string,
                                @rest(queryParameter=true)
  @ser(name='stored_fields')
                                storedFields: boolean,
                                @rest(queryParameter=true)
  @ser(name='_source_excludes')
                                sourceExcludes: string,
                                @rest(queryParameter=true)
                                version: int,
                                @rest(queryParameter=true)
                                version_type: string): ElasticSearchGetResponse

  /**
   * Add a new index to an Elasticsearch cluster
   */
  @rest(method='PUT', contentType='application/json', acceptType='application/json')
  createIndex: abstract function(@rest(partOfURI=true)
                                 index: string,
                                 @rest(queryParameter=true)
                                 wait_for_active_shards: string,
                                 @rest(queryParameter=true)
                                 master_timeout: string,
                                 @rest(queryParameter=true)
                                 timeout: string,
                                 @rest(doNotUseParameterName=true)
                                 body: ElasticSearchIndexCreateBody): json

  /**
   * Gets information about an index
   */
  @rest(method='GET', contentType='application/json', acceptType='application/json')
  index: abstract function(@rest(partOfURI=true) index: !string): json

  /**
   * Adds or removes indices on an alias
   * An alias is a virtual index name that can point to one or more indices
   */
  @rest(method='POST', uri='/_aliases/', contentType='application/json', acceptType='application/json')
  modifyAlias: abstract function(@rest(doNotUseParameterName=true) body: ModifyAliasBody): json

  /**
   * Gets all the indices associated with an alias
   */
  @rest(method='GET', uri='/_alias/', contentType='application/json', acceptType='application/json')
  indicesForAlias: abstract function(@rest(partOfURI=true) alias: !string): json

  /**
   * Gets a list of all aliases and the indices they map to
   */
  @rest(method='GET', uri='/_cat/aliases?v', contentType='application/json', acceptType='application/json')
  aliases: abstract function(): json

  /**
   * Adds a JSON document to the specified data stream or index and makes it searchable.
   */
  @rest(method='PUT', contentType='application/json', acceptType='application/json')
  putDocumentWithDocId: abstract function(@rest(partOfURI=true)
                                          index: !string,
                                          @rest(partOfURI=true, uriPrefix='/_doc/')
                                          docId: !string,
                                          @rest(queryParameter=false, doNotUseParameterName=true)
                                          document: json,
                                          @rest(queryParameter=true)
                                          if_seq_no: int,
                                          @rest(queryParameter=true)
                                          if_primary_term: int,
                                          @rest(queryParameter=true)
                                          op_type: string,
                                          @rest(queryParameter=true)
                                          pipeline: string,
                                          @rest(queryParameter=true)
                                          refresh: string,
                                          @rest(queryParameter=true)
                                          routing: string,
                                          @rest(queryParameter=true)
                                          timeout: string,
                                          @rest(queryParameter=true)
                                          version: int,
                                          @rest(queryParameter=true)
                                          version_type: string,
                                          @rest(queryParameter=true)
                                          wait_for_active_shards: string,
                                          @rest(queryParameter=true)
                                          require_alias: boolean): ElasticSearchPutDocumentResponse

  /**
   * Adds a JSON document to the specified data stream or index and makes it searchable.
   */
  @rest(method='POST', uri='/_bulk', contentType='application/x-ndjson', acceptType='application/json')
  modifyDocumentWithDocIdBulk: abstract function(@rest(queryParameter=false, doNotUseParameterName=true)
                                                 json_lines: json ...): json

  /**
   * Adds a JSON document to the specified data stream or index and makes it searchable.
   */
  @rest(method='POST', contentType='application/json', acceptType='application/json')
  putDocumentWithoutDocId: abstract function(@rest(partOfURI=true, uriSuffix='/_doc/')
                                             index: !string,
                                             @rest(queryParameter=false, doNotUseParameterName=true)
                                             document: json,
                                             @rest(queryParameter=true)
                                             if_seq_no: int,
                                             @rest(queryParameter=true)
                                             if_primary_term: int,
                                             @rest(queryParameter=true)
                                             op_type: string,
                                             @rest(queryParameter=true)
                                             pipeline: string,
                                             @rest(queryParameter=true)
                                             refresh: string,
                                             @rest(queryParameter=true)
                                             routing: string,
                                             @rest(queryParameter=true)
                                             timeout: string,
                                             @rest(queryParameter=true)
                                             version: int,
                                             @rest(queryParameter=true)
                                             version_type: string,
                                             @rest(queryParameter=true)
                                             wait_for_active_shards: string,
                                             @rest(queryParameter=true)
                                             require_alias: boolean): ElasticSearchPutDocumentResponse

  /**
   * Allows you to update fields of a document
   */
  @rest(method='POST', contentType='application/json', acceptType='application/json')
  updateDocument: abstract function(@rest(partOfURI=true, uriSuffix='/_update/')
                                    index: string,
                                    @rest(partOfURI=true)
                                    docId: string,
                                    @rest(queryParameter=false,
                                          contentType='application/json',
                                          doNotUseParameterName=true)
                                    doc: json): ElasticSearchPutDocumentResponse

  /**
   * Allows you to delete a document by id
   */
  @rest(method='DELETE', contentType='application/json', acceptType='application/json')
  deleteDocument: abstract function(@rest(partOfURI=true, uriSuffix='/_doc/')
                                    index: string,
                                    @rest(partOfURI=true)
                                    docId: string): ElasticSearchPutDocumentResponse

  /**
   * Allows you to execute a search query and get back search hits that match the query.
   */
  @rest(method='POST', contentType='application/json', acceptType='application/json')
  search: abstract function(@rest(partOfURI=true, uriSuffix='/_search')
                            index: string,
                            @rest(queryParameter=true)
                            scroll: string,
                            @rest(queryParameter=false, contentType='application/json', doNotUseParameterName=true)
                            query: json,
                            @rest(queryParameter=false, contentType='application/json', doNotUseParameterName=true)
                            highlight: json,
                            @rest(queryParameter=true)
                            q: string,
                            @rest(queryParameter=true)
                            from: int,
                            @rest(queryParameter=true)
                            size: int,
                            @rest(queryParameter=true)
                            sort: string,
                            @rest(queryParameter=true)
                            _source: string,
                            @rest(queryParameter=true)
                            allow_no_indices: boolean,
                            @rest(queryParameter=true)
                            allow_partial_search_results: boolean,
                            @rest(queryParameter=true)
                            batched_reduce_size: int,
                            @rest(queryParameter=true)
                            ccs_minimize_roundtrips: boolean,
                            @rest(queryParameter=true)
                            explain: boolean,
                            @rest(queryParameter=true)
                            _source_excludes: string,
                            @rest(queryParameter=true)
                            version: boolean): ElasticSearchResponse

  /**
   * Allows you to execute an SQL search query and get back search hits that match the query.
   */
  @rest(method='POST', uri='/_plugins/_sql', contentType='application/json', acceptType='application/json')
  sqlSearch: abstract function(@rest(queryParameter=false, contentType='application/json', doNotUseParameterName=true)
                               query: json): ElasticSearchSqlResponse

  /**
   * Allows you to execute a search query on multiple indices and get back search hits that match the query.
   */
  @rest(method='POST', contentType='application/x-ndjson', acceptType='application/json')
  multiSearch: abstract function(@rest(partOfURI=true, uriSuffix='/_msearch')
                                 indices: string,
                                 @rest(queryParameter=false,
                                       contentType='application/json',
                                       doNotUseParameterName=true)
                                 meta: json,
                                 @rest(queryParameter=false,
                                       contentType='application/json',
                                       doNotUseParameterName=true)
                                 query: json): ElasticMultiSearchResponse

  /**
   * Retrieves the next batch of results for a scrolling search.
   */
  @rest(method='POST', uri='/_search/scroll', contentType='application/json', acceptType='application/json')
  scroll: abstract function(@rest(queryParameter=false, contentType='application/json', doNotUseParameterName=true)
                            body: ElasticSearchScrollRequest): ElasticSearchResponse

  /**
   * Deletes documents that match the specified query.  This implementation only supports
   * a lucene style query.
   */
  @rest(method='POST', contentType='application/json', acceptType='application/json')
  deleteByQuery: abstract function(@rest(partOfURI=true, uriSuffix='/_delete_by_query')
                                   index: string,
                                   @rest(queryParameter=true)
                                   q: string)

  /**
   * Checks if an index exists.  If the status code is 200,the specified index or index alias
   * exists.
   */
  @rest(method='HEAD', contentType='application/json', acceptType='application/json')
  checkIndex: abstract function(@rest(partOfURI=true) index: string): HttpResponse

  /**
   * Deletes an existing index.
   */
  @rest(method='DELETE', contentType='application/json', acceptType='application/json')
  deleteIndex: abstract function(@rest(partOfURI=true) index: string): ElasticSearchAcknowledge
}
