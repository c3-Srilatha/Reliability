type ElasticSearchPutDocumentResponse {

  @ser(name='_shards')
  shards: ElasticShardsCount

  @ser(name='_index')
  index: string

  @ser(name='_type')
  etype: string

  @ser(name='_id')
  id: string

  @ser(name='_version')
  version: int

  @ser(name='_seq_no')
  seq_no: int

  @ser(name='_primary_term')
  primaryTerm: string

  @ser(name='result')
  result: string
}
