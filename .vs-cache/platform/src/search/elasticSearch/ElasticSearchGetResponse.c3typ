type ElasticSearchGetResponse {

  @ser(name='_index')
  index: string

  @ser(name='_id')
  id: string

  @ser(name='_version')
  version: int

  @ser(name='_seq_no')
  seqNo: int

  @ser(name='_primary_term')
  primaryTerm: int

  found: boolean

  @ser(name='_source')
  source: json

  /**
   * If the stored_fields parameter is set to true and found is true,
   * contains the document fields stored in the index.
   */
  @ser(name='_fields')
  storedFields: json
}
