type ElasticDocumentHits {

  @ser(name='_index')
  index: string

  @ser(name='_type')
  etype: string

  @ser(name='_id')
  id: string

  @ser(name='_score')
  score: double

  @ser(name='_source')
  source: json

  highlight: json

  /**
   * placeholder datatype for now
   */
  storedFields: json
}
