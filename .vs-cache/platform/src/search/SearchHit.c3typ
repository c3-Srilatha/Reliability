/**
 * SearchHit contain a SearchDocument and metadata of query hits.
 * This is useful for application developer to optimize their search query.
 * Content of each query hit from SearchResult
 * Sample Json
 * ```
 * {
 *     "hits": [
 *       {
 *         "index": "my-index-000001",
 *         "id": "0",
 *         "score": 1.3862942,
 *         "document": {
 *           "field": "someText"
 *         }
 *       },
 *       ...
 *     ]
 * }
 * ```
 * @see SearchResult
 */
type SearchHit {

  /**
   * Score assigned by SearchStore that indicates relevancy of the result to the query.
   */
  score: float

  /**
   * Document associate with this hit
   */
  document: SearchDocument

  /**
   * Highlight information for the SearchHit
   */
  highlight: json
}
