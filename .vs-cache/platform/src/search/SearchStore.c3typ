/**
 * Containing APIs to execute search queries spanning one or more search indices.
 * (ElasticSearch by default)
 */
type SearchStore mixes DefaultInstance<any>, Configurable<SearchStoreConfig> {

  /**
   * Data store to store search data
   * Default to Elastic Search
   */
  datastore: string = 'ElasticSearch'

  /**
   * Search Query on one index based on the spec.
   * Guarantee that within SearchHit, the data are coming from one entity type.
   */
  search: member function(indexName: !string, spec: !SearchQuerySpec): SearchResult<SearchHit>

  doSearch: abstract member function(indexName: !string, spec: !SearchQuerySpec): SearchResult<SearchHit>

  /**
   * Search Query across one or more indexes,
   * Doesn't guarantee that within SearchHit, the data are coming from one entity type.
   */
  searchMultiple: member function(indexPattern: ![string], spec: !SearchQuerySpec): SearchResult<SearchHit>

  doSearchMultiple: abstract member function(indexPattern: ![string], spec: !SearchQuerySpec): SearchResult<SearchHit>

  /**
   * Updates the field mappings on a search index
   */
  updateIndex: member function(type: !Type): json

  doUpdateIndex: abstract member function(searchType: !string): json

  /**
   * Upserts a Searchable's data to a search store
   */
  upsert: member function(searchable: !Searchable)

  /**
   * Upserts a batch of Searchable's data to a search store
   */
  upsertBatch: member function(searchables: !?[Searchable])

  /**
   * Removes a batch of Searchable's data from a search store
   */
  removeBatch: member function(searchables: !?[Searchable])

  doUpsert:      abstract member function(searchable: !Searchable)
  doUpsertBatch: abstract member function(searchables: !?[Searchable])
  doRemoveBatch: abstract member function(searchables: !?[Searchable])

  /**
   * Removes a Searchable's data from a search store
   */
  remove: member function(searchable: !Searchable)

  doRemove: abstract member function(searchable: !Searchable)

  /**
   * Creates a unique index name for a Searchable type in a particular tenant and tag
   */
  indexName: abstract member function(typeName: string): string

  /**
   * Deletes a search index given the index name
   */
  deleteIndex: member function(indexName: string)

  doDeleteIndex: abstract member function(indexName: string)

  /**
   * Enables the SearchStore to be used. Any data persisted while the SearchStore is disabled won't be persisted to the SearchStore.
   */
  enable: function()

  /**
   * Disables the SearchStore and no data will be persisted while the SearchStore is disabled.
   */
  disable: function()

  /**
   * returns true if the SearchStore is enabled, false otherwise.
   */
  isEnabled: function(): boolean

  /**
   * Handles the processing of Expr Ast for query building
   */
  processExpr: private abstract member function(spec: !SearchQuerySpec): !string
}
