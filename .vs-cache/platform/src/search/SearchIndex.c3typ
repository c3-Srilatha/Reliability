/**
 * Metadata required to link C3 entity types to a search index
 *
 * Ex: entity type Company mixes Searchable<Company>
 * Index name will be formatted: <tenant>-<tag>-<typename>
 * GET /test-tag-Company/C3.ai
 * GET /test-tag-Company/Palantir
 * ```
 * Sample index metadata
 * health status index            uuid                   pri rep docs.count docs.deleted store.size pri.store.size
 * yellow open   my-index-000001  u8FNjxh8Rfy_awN11oDKYQ   1   1       1200            0     88.1kb         88.1kb
 * green  open   my-index-000002  nYFWZEO7TUiOjLQXBaYJpA   1   0          0            0       260b           260b
 * ```
 *
 * @see SearchStore
 */
type SearchIndex {

  /**
   * Name of the index
   */
  name: string

  /**
   * Type mapping of the index
   */
  schema: json

  /**
   * Entity type that is used to construct this SearchIndex
   */
  entityType: Type

  /**
   * Return document by id within this index
   */
  documentById: member function(id: string): SearchDocument

  /**
   * Return true if the index is healthy, false otherwise
   */
  isHealthy: member function(): boolean

  /**
   * Fetch number of documents in the index
   */
  documentCounts: member function(): int

  /**
   * Return Search index based on the the entity type
   */
  searchIndex: function(type: Type): SearchIndex

  /**
   * Additional index info that can be retrieved for application development
   * Gives basic index info, type mapping, query stats, and index setting, etc.
   */
  indexInfo: member function(): json
}
