@deprecated(finalVersion='7.10', details='use File and FileSystem instead')
type OldContent mixes Layout {

  name:                string
  size:                decimal = 0
  contentType:         string
  checksum:            string
  tag:                 string
  context:             string
  numContentRevisions: int = 0
  fileSystem:          string enum('cassandra', 'hdfs')

  /**
   * not implemented yet
   * zipped : string enum ("none", "gzip", "bzip2")
   * Placeholder methods for streaming implementation of File.openWrite() and File.openRead() within 1 JVM
   * write(OldContent obj, boolean trimAfterWrite, decimal offset)
   * read(OldContent obj, decimal offset, int numBytesToRead) : Obj
   * trimAfterWrite = true means that the file will be truncate after writing content at offset.
   * So, the size of the file after this operation will be offset content.length. trimAfterWrite defaults to false
   * offset defaults to 0
   * characterSet defaults to UTF-8
   * Returns the new length of the file
   */
  writeString: function(obj: OldContent,
                        content: string,
                        trimAfterWrite: boolean,
                        offset: decimal,
                        characterSet: string): decimal

  /**
   * offset defaults to 0
   * numBytesToRead defaults to min(content size, 1000) bytes
   * characterSet defaults to UTF-8
   */
  readString: function(obj: OldContent, offset: decimal, numBytesToRead: int, characterSet: string): string

  /**
   * Returns the new length of the file
   */
  truncate: function(obj: OldContent, offset: decimal): decimal

  /**
   * gzip compresses content; newId and newName is optional and if not provided .gz will be appended to an existing value
   */
  gzip: function(obj: OldContent, newId: string, newName: string): Obj

  /**
   * gzip de-compresses content; newId and newName is optional and if not provided .gz will be removed from an existing value
   */
  gunzip: function(obj: OldContent, newId: string, newName: string): Obj

  /**
   * mutate the headers from app
   */
  headers: function(obj: OldContent, op: string, headers: map<string, string>): map<string, string>

  contentCreated: function(txn: Transaction)
  contentUpdated: function(txn: Transaction)
  contentRemoved: function(txn: Transaction)

  /**
   * Writes content to a temporary system file and returns its path
   * Writes file named tmpName+tmpExtension (tmpExtension should start with .)
   */
  writeToTmpFile: function(obj: OldContent, tmpName: string, tmpExtension: string): string
}
