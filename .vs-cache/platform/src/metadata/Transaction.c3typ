/**
 * Type of argument passed into various asynchronous callback functions (e.g. {@link Persistable#created})
 */
type Transaction {

  /**
   * List of ids for the callback to process.
   */
  ids: [ObjIdCompact]

  /**
   * Module name for the request.
   */
  srcModule: !string

  /**
   * Type name for the request.
   */
  srcType: !string

  /**
   * Starting block for {@link TextContentStream.blockCreated} callback.
   *
   * Text Content Streams
   */
  startBlock: int

  /**
   * Ending block for {@link TextContentStream.blockCreated} callback.
   */
  endBlock: int
}
