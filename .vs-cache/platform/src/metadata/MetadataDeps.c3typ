/**
 * All the dependencies of instance of the metadata to a type or another metadata element
 *
 * Subtypes are expected to add actual dependency as fields. E.g. {@link UnitDeps} adds `componentUnits: Unit` field
 * which then allows use of `MetadataDeps.backwardDeps('componentUnits', '<my unit id>')`
 *
 * @see Metadata#dependencies
 */
abstract type MetadataDeps<M: Metadata> mixes WithKey {

  /**
   * Type of the metadata type this dependency is for
   */
  metadataType: function(): !Type<<Metadata>>

  /**
   * Key value of the metadata element; normally `id` or `name`
   */
  key: !string

  /**
   * any Pkg.Issues generated  while building dependencies.
   */
  issues: [Pkg.Issue]

  /**
   * Retrieves cached single dependency for a given key and dependency element
   *  e.g. RoleDeps.dependency("developerRole",  "securityLevel") -> 6;
   * @see Metadata#dependencies
   */
  dependency: function(key: !string, dependencyName: !string): any

  /**
   * Retrieves backwards depending instances of metadata for a given dependency element
   *
   * @see Metadata#dependencies
   */
  backwardDeps: function(dependencyName: !string, dependencyKey: !any): set<M>

  /**
   * All dependencies of metadata for this type
   */
  all: private function(): [MetadataDeps<M>]

  keyFieldType:  ~
  keyFieldValue: ~
}
