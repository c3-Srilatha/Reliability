/**
 * This represents Pkg.Store backed by zip file.
 * @see Pkg.Store.Zip.Config
 */
type Pkg.Store.Zip mixes Pkg.Store.Nested, Configurable<Pkg.Store.Zip.Config>, Named {

  /**
   * Clear caches related to Pkg.Store.Zip by closing all open file handles and delete any downloaded ZIP files.
   * Any Pkg.Store.Zip(s) in the whitelist will not delete their downloaded ZIP files but will close their file handles.
   */
  clearCaches: private function(whitelist: [Pkg.Store.Nested])

  /**
   * setup config for name with url of the zip file.
   */
  configureFor: function(name: !string, url: !string serialized Url): Pkg.Store.Zip
}
