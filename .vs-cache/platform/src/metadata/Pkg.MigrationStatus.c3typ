/**
 * Status of a C3 Application Package migration run. Typically represented as a JSON object under the `migration/status`
 * folder with `<package name>.<package version>.json` file.
 *
 * @see Pkg.Category#MIGRATION
 * @see Pkg.Store#migratePkg
 */
type Pkg.MigrationStatus {

  /**
   * List of migration steps / scripts that completed successfully.
   */
  completed: [string]

  /**
   * Migration step / script that failed.
   */
  failedMigration: string

  /**
   * Error message from the failed migration step / script.
   */
  error: Error
}
