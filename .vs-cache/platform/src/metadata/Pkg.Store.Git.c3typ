/**
 * A type for Pkg.Store interactions with Git.
 */
type Pkg.Store.Git {

  _pkgStore: private string serialized Pkg.Store

  /**
   * This api will update contents of Pkg.Store with contents from configured branch or provied with spec.
   *
   * When pulling from remote branch, Pkg.store contents will applied on latest or per spec,
   * if there are no conflicts, all updates will be synced to Pkg.Store.
   */
  pull: member function(spec: Pkg.Store.Git.PullSpec): Pkg.Store.Git.OpResult

  /**
   * This api will push changes from Pkg.Store to provided Git branch that is configured on Pkg.Store.config().source.
   *
   * If Pkg.Store is not configured with gitBranch, this will throw error.
   * The changes in Pkg.store will be applied as a commit to branch and pushed to remote branch.
   * If the push fails, due to changes in remote git branch since last pull, We will try to apply changes latest
   * from remote and if there are no conflicts, changes will be commited to git branch.
   * If force is set, changes will be forced to remote branch, any changes on remote will be lost.
   * If conflicts arise, suggested course of action will be returned.
   *
   * @param message
   *            commit message to be used for publishing changes.
   * @param spec
   *           spec to publish the changes to Git branch.
   */
  push: member function(message: !string, spec: Pkg.Store.Git.PushSpec): Pkg.Store.Git.OpResult

  /**
   * This api will push changes from Pkg.Store to a temp branch then create a pull request to provided target branch.
   * Returns PR url and temp branch created  with Pkg.Store contents as output.
   *
   *
   * @param targetBranch
   *            used as target branch for Pull request
   */
  createPullRequest: member function(targetBranch: !string): Pkg.Store.Git.OpResult

  /**
   * If store is configured with git, shows unpublished changes in Pkg.Store since last update from configured branch.
   * To get diff options  see Pkg.Store.Git.DiffSpec
   */
  changes: member function(spec: Pkg.Store.Git.DiffSpec): Git.Changes

  /**
   * Will provide list of commits in configured branch.
   */
  logs: member function(spec: Pkg.Store.Git.LogSpec): [Git.CommitInfo]

  /**
   * Return the current commit sha that was sync to Pkg.Store.
   */
  currentCommit: member function(): string

  /**
   * return Git.Branch if configured.
   */
  configuredBranch: member function(): Pkg.Store.Git.Branch

  /**
   * Ensure the local workspace on app node exist, if previously configured.
   */
  ensureWorkspace: member function(): Pkg.Store.Git.Workspace
}
