/**
 * Mapping of field paths to numeric ids for more efficient storage of references to field paths in other objs.  The value of the
 * id field will be the pathId for the specified field path.
 */
@db(systemType=true, compactType=true, unique=['path'])
entity type PathId schema name 'METADATA_PATHID' {

  /**
   * Path.
   */
  path: string schema name 'PATH'

  /**
   * PathId mappings are never updated so no need for version field.
   */
  version: ~ not persistable

  meta: ~ not persistable
}
