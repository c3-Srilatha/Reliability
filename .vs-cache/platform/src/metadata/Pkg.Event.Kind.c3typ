/**
 * type of change done to a Pkg.File
 */
enum type Pkg.Event.Kind {

  /**
   * For adding new Pkg.File
   */
  ADD

  /**
   * For removing a Pkg.File
   */
  REMOVE

  /**
   * For updating a Pkg.File
   */
  UPDATE

  /**
   * Additional info from server about steps in processing a Pkg.File
   */
  INFO

  ISSUE
}
