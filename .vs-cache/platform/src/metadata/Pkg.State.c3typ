/**
 * To keep track of state of app root pkg deployment.
 */
@deprecated(finalVersion="8.4", details="Use App.State instead")
entity type Pkg.State mixes Singleton {

  /**
   * last deployed root pkg fingerprint.
   */
  pkgFingerprint: int

  /**
   * true indicates, for pkg, all seed has been upserted.
   */
  seeded: boolean
}
