/**
 * This represents Pkg.Store backed by database. Default Instance would be a writable store used for storing modified
 * Pkg content with Pkg.Store apis. A store can be configured to be readonly and content can't modified through Pkg.Store.
 */
type Pkg.Store.Db mixes Pkg.Store.Nested, Configurable<Pkg.Store.Db.Config>, Named, DefaultInstance {

  DEFAULT:      const string = 'DEFAULT'
  pkgDeclPaths: ~
}
