/**
 * Module definition.
 */
type Module {

  /**
   * Name of the module.
   */
  name: string

  /**
   * Package name of the module.
   */
  packageName: string

  /**
   * List of modules that the module imports.
   */
  imports: [string]

  /**
   * If the module is a remix module, the module that it remixes.
   */
  remix: string

  /**
   * List of data types in the module (*not* including annotation types).
   */
  types: [TypeMeta]

  /**
   * List of default UIs in the module.
   */
  defaultUis: [TypeDefaultUi]

  /**
   * Hash value of the contents of the module.  Used to determine if the module has changed during provisioning.
   */
  sourceHash: string
}
