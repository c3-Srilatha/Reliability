/**
 * @deprecated replaced by {@link PartiallyAppliedAction}
 */
@deprecated
type PartiallyAppliedFunction mixes FunctionRef {

  /**
   * The name of the arg and the value associated with the argument to be used when calling the function
   */
  appliedArgs: map<string, Obj> schema suffix 'AA'

  /**
   * This is the result of invoking the target function.
   */
  result: Obj
}
