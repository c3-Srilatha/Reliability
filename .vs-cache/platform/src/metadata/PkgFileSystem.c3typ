/**
 * Represents C3 Pkg files. Default instance of PkgFileSystem contains only the files that are
 * part of the current application's Pkg. This allows Pkg files to be accessed like files in any of other
 * C3 supported filesystems.
 *
 * @see Pkg.File
 */
type PkgFileSystem mixes FileSystem {

  makeFile: ~
}
