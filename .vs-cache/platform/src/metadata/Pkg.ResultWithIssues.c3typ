/**
 * Holds result with pkg issues.
 */
type Pkg.ResultWithIssues {

  /**
   * true if {@link issues} has at least one entry with {@link Pkg.Issue#severity} as
   * {@link Pkg.Issue.Severity#ERROR}.
   */
  hasErrors: inline member function(): boolean

  /**
   * true if {@link issues} has at least one entry with {@link Pkg.Issue#severity} as
   * {@link Pkg.Issue.Severity#WARNING}.
   */
  hasWarnings: inline member function(): boolean

  /**
   * Pkg issues caused by the operation.
   */
  issues: [Pkg.Issue]
}
