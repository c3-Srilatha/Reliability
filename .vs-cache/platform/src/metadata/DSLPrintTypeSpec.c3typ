/**
 * Options for Tag.printType.  All values have defaults, which apply
 * if no options object is specified.
 */
type DSLPrintTypeSpec mixes DslPrintSpec {

  wMixins:     boolean = true
  grouping:    boolean = false
  sorting:     string enum('decl', 'alpha') = 'alpha'
  wFields:     boolean = true
  wFunctions:  boolean = true
  wExtensions: boolean = true
  wIncluded:   boolean = true
}
