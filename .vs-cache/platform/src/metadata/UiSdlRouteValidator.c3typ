/**
 * Utility type that hosts logic to validate UiSdlRoute metadata
 */
type UiSdlRouteValidator {

  /**
   * Validate a given UiSdlRoute metadata file
   * @param mf
   *           {@link Pkg.File} instance to validate
   * @param pkg
   *           {@link Pkg} that the {@link Pkg.File} belongs to
   * @return a list of pkg issues created when validating the pkg file
   */
  validate: function(mf: Pkg.File, pkg: Pkg): [Pkg.Issue]
}
