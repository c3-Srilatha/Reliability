type Pkg.Store.ArtifactHubRegisterSpec mixes Spec {

  /**
   * If true, validation of Pkg content will not be done.
   */
  skipValidation: boolean

  /**
   * If true, the uploaded {@link Pkg} will only contain the root source content.
   */
  // TODO: PLAT-114679 Allow uploading pkg with only root source content
  // rootSourceOnly: boolean

  /**
   * The id with which to register the {@link Pkg}. Note that this should be unique. If not specified, the id will
   * be "{pkg.name}-{pkg.version}".
   */
  artifactId: string

  /**
   * The {@link ArtifactHub.ArtifactKind} to set on the uploaded pkg.
   */
  artifactKind: ArtifactHub.ArtifactKind

  /**
   * If `true` will set {@link ArtifactHub.Artifact.Pkg#resolvedDependencies} based on {@link Pkg#resolvedVersions}.
   */
  useResolvedDependencies: boolean
}
