/**
 * Specification of the options/parameters for the {@link Persistable#exportDataForRedshift} function.
 */
type RedShiftExportDataSpec mixes Spec {

  /**
   * S3 bucket to export data into.
   */
  s3Bucket: string

  /**
   * File path to export data into.
   */
  filePath: string

  /**
   * Include spec identifying which fields to export.
   */
  include: string

  /**
   * Filter identifying which objs to export.
   */
  filter: string
}
