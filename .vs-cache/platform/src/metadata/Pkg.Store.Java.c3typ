/**
 * This represents Pkg.Store backed by Java Resources e.g platform, repo/server packages.
 */
type Pkg.Store.Java mixes Pkg.Store.Nested, Singleton {

  allPkgPaths:   private cached member function(): @indexed set<Pkg.Path>
  platformPaths: private cached member function(): @indexed set<Pkg.Path>
  pkgDeclPaths:  cached ~
}
