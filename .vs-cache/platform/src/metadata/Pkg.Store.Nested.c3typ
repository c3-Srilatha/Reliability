/**
 * Base type for different backing pkg stores that allow reading/writing pkg contents.
 * @see {Pkg.Store.Db}
 * @see {Pkg.Store.Local}
 * @see {Pkg.Store.Zip}
 * @see {Pkg.Store.Java}
 */
abstract type Pkg.Store.Nested mixes Pkg.StoreIface {

  /**
   * Reads fingerprints from precomputed file-fingerprints file for the given package in this store, if it exists.
   */
  readFileFingerprints: private member function(pkgName: !string): map<string serialized Pkg.Path, string>

  /**
   * computes fingerprints for given path by reading content from this store.
   */
  computeFingerprint: member function(pkgPath: !string serialized Pkg.Path): string

  /**
   * @return stream of all paths available in this store.
   */
  listPaths: abstract member function(): stream<Pkg.Path>

  /**
   * api to just upsert/remove the content from store. will not do any invalidations.
   */
  doWriteEncodedContents: private abstract member function(update: map<Pkg.Path, binary>, remove: [Pkg.Path])

  paths:                final ~
  writeEncodedContents: ~
  readFingerprint:      ~
  readFingerprints:     ~
  evictFingerprints:    ~
  pkgDecl:              final ~
  pkgDeclAndIssues:     final ~
}
