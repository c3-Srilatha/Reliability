enum type Pkg.Overlay {

  /**
   * for test overlay path. e.g. /pkgA/test/src/Test.c3typ
   */
  TEST = 'test'

  /**
   * for generated  overlay path. e.g. /pkgA/gen/cache/TypeMetaDeps#dts/TestType.d.ts
   */
  GEN = 'gen'

  /**
   * for dependency package  overlay path. e.g. /pkgA/dep/pkgB/src/TypeA.c3typ/TestType.dts
   */
  DEP = 'dep'
}
