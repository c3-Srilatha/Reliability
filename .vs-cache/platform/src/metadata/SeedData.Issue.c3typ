/**
 * Describes issue with SeedData file content.
 *
 * To get the full list of Pkg.Issues for a Pkg, call pkg().issues()
 */
type SeedData.Issue mixes DataIssueDimensions {

  /**
   * Error message indicating the nature of the issue.
   */
  message: !string

  /**
   * URL of the source pkg file. {@link #file}
   */
  fileUrl: string
}
