/**
 * Base type for all query result
 *
 * @see FetchResult
 * @see SearchResult
 */
type QueryResult<T> {

  /**
   * Returned list of objs that satisfied input the
   */
  objs: [T]

  /**
   * Number of returned objs.
   */
  count: int

  /**
   * If the QuerySpec limit was set to less than the actual number of qualifying objs, this flag will be set to true
   * to indicate that there were more objs that were not returned.
   */
  hasMore: boolean
}
