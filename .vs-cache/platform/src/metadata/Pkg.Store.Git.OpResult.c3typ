/**
 * Output from Git operations
 */
type Pkg.Store.Git.OpResult {

  /**
   * output from git commands ran as Pkg.Store git sync.
   */
  output: string

  /**
   * true, if all Git commands were successful to complete Pkg.Store git sync call.
   */
  success: boolean

  /**
   * When git operations were not successful, suggested next course of action to progress.
   */
  onErrorSuggestion: string

  /**
   * true, if the git operation (pull/push/configure) results in any conflicts
   */
  conflicts: boolean

  /**
   * Link to PR (pull request), if it is created due to conflicts on pull/push operation
   */
  pullRequest: string serialized Url

  /**
   * Branch name where changes are published, (if conflicts are found) to generate PR.
   */
  branch: string
}
