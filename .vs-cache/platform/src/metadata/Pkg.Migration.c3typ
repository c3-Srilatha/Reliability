/**
 * C3 Application Package migration script.
 *
 * @see Pkg.Category#MIGRATION
 * @see Pkg.Store#migratePkg
 */
inline type Pkg.Migration {

  /**
   * Source C3 application package file.
   */
  file: !Pkg.File

  /**
   * Path from a declaring package.
   */
  path: property(): !Pkg.Path

  /**
   * Name of the migration, this is a part of the file name after `nnn-` prefix and before the file extension.
   */
  name: cached property(): !string

  /**
   * Sequence number of the migration i.e. `nnn-` prefix of the file name.
   */
  seq: cached property(): !int

  /**
   * Name of the declaring package.
   */
  package: cached property(): !string

  /**
   * Version of the migration scripts.
   */
  version: cached property(): !string

  /**
   * Lambda representing the migration logic.
   */
  action: cached property(): !Lambda<function(pkg: !Pkg)>

  /**
   * Execute migration for a given writable package.
   *
   * @param pkg
   *         Writable package to migrate.
   * @return true if the migration run and was successful, false migration was already run in the past.
   */
  run: member function(pkg: !Pkg): boolean
}
