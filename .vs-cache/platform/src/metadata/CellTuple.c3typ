/**
 * Set of values returned for all projections for a single returned result in a {@link EvaluateResult}.
 */
type CellTuple mixes Result {

  cells: [Cell]

  /**
   * @return value of the cell at index.
   */
  value: inline member function(index: !int): any

  /**
   * @return C3 type instance value of the cell at index.
   */
  obj: inline member function(index: !int): Obj

  /**
   * @return number value of the cell at index.
   */
  number: inline member function(index: !int): decimal

  /**
   * @return datetime value of the cell at index.
   */
  date: inline member function(index: !int): datetime

  /**
   * @return boolean value of the cell at index.
   */
  bool: inline member function(index: !int): boolean

  /**
   * @return string value of the cell at index.
   */
  str: inline member function(index: !int): string

  /**
   * @return the number of cells in the Tuple
   */
  count: inline member function(): !int

  /**
   * @return the first cell in the tuple if any exist and null otherwise.
   */
  first: inline member function(): Cell
}
