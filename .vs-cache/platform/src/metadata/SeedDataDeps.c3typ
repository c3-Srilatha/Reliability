abstract type SeedDataDeps<S: SeedData> {

  /**
   * Type of the seed data type this dependency is for
   */
  seedDataType: function(): !Type<<SeedData>>

  /**
   * Key value of the seed data element; normally `id`
   */
  key: !string

  /**
   * Retrieves backwards depending instances of seed data for a given dependency element
   *
   * @see SeedData#dependencies
   */
  backwardDeps: function(dependencyName: !string, dependencyKey: !any): set<S>

  /**
   * All dependencies of seed data for this type
   */
  all: private function(): [SeedData<S>]
}
