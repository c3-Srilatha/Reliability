/**
 * Specification for Pkg.files action.
 */
type Pkg.FilesSpec mixes FileFilterSpec {

  /**
   * If provided filters files by package name.
   */
  package: string

  /**
   * If provided filters files by category.
   */
  category: string enum Pkg.Category

  /**
   * If provided filters files by encodedSubPath.
   */
  encodedSubPath: string

  /**
   * If true only test files will be retrieved.
   */
  isTest: boolean

  /**
   * If provided filters files based on target c3 type name.
   */
  targetType: string

  /**
   * If provided files will be ordered  based on package dependency order or  alphabetic order ascending or descending.
   */
  order: string enum Pkg.FileOrder = REMIX

  /**
   * If true, read metadata for each file before returning.
   */
  readMetadata: boolean

  matches: ~
}
