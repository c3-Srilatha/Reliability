type Pkg.Store.Git.LogSpec mixes Spec {

  /**
   * Number of commits to get. If set to -1, will return all available commits, ( will be slow).
   */
  num: int32 = 100

  /**
   * Single author name to filter by. Takes priority over authorNames if set. Accepts patterns.
   */
  authorName: string

  /**
   * Author name(s) to filter by. Supports single or multiple authors. Accepts patterns.
   */
  authorNames: [string]

  /**
   * Show commits more recent than a specific date
   */
  since: datetime

  /**
   * Show commits older than a specific date (for date range filtering with since)
   */
  until: datetime

  /**
   * options to git log command
   */
  extra: [string]
}
