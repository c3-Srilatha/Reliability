/**
 * Helper type to generate a JSON schema for a type to be used for metadata autocomplete
 * feature in VS Code. More information regarding JSON schema: https://json-schema.org/
 */
type JsonSchemaGenerator {

  /**
   * Generate the JSON Schema string given a TypeMeta for a type
   */
  generate: function(type: TypeMeta): !json
}
