/**
 * Provides an API to refactor c3typ files by providing the type declaration as a string.
 * Each field can be specified once per instance but you can use a list of instances to apply the
 * same refactor "method" multiple times.
 */
type DslRefactor {

  /**
   * Takes a type declaration as string and a list of DslRefactor objects, each containing one or many
   * refactor fields.
   *
   * @param typeDeclaration the type to convert as specified in a c3typ file
   * @param specs a list of DslRefactor objects specifying the changes needed.
   */
  refactor: function(typeDeclaration: string, specs: [DslRefactor]): string

  /**
   * When specified, the type will be renamed to the supplied value
   */
  renameType: string

  /**
   * When specified, will remove a field named with the supplied value from the type being refactored.
   */
  removeTypeField: string

  /**
   * When specified, if the field contains substring in the first element, will replace it with the substring in the second element.
   * Format: {
   *   fst: string // the substring to search for in the field name
   *   snd: string // the substring to replace the first substring with
   *   thd: [string] // a list of types to exclude from the renaming operation
   * }
   */
  renameTypeField: Triple<string, string, [string]>

  /**
   * When specified, will be rename annotation with name as the first element. The new name is the second element.
   */
  renameAnnotationInFields: Pair<string, string>

  /**
   * When specified, all methods with the specified runtime will be replaced to use a different one.
   * Format: {
   *   name: !string // the name of the runtime to replace
   *   newRuntime: {
   *     name: !string // the new annotation's name
   *     values: json // the new annotation's values
   *   }
   * }
   */
  // TODO: Define DslRefactorRuntime
  replaceRuntime: json

  /**
   * When specified, the supplied values indicate the type names that are going to be removed from any type mixing them.
   */
  removeMixins: [string]

  /**
   * When specified, the supplied values indicate the type names that are going to be removed from any type extending them.
   */
  removeExtends: [string]

  /**
   * Renames any Type reference in all the fields inside the type.
   * The first element is the old type name and the second the new type name.
   *
   * This method will replace them as strings in their ValueType definition, this means that complex fields will also be updated.
   * Example:
   *   Using { renameRefType: {fst: 'X', snd: 'Y'} }
   *       myField: X  => myField: Y
   *       myArray: [X] => myArray: [Y]
   *       myFunc: function (x: X)  => myFunc: function(x: Y)
   */
  renameRefType: Pair<string, string>

  /**
   * When specified, if the type extends the type in the first element, will replace it with the type in the second element.
   */
  replaceExtends: Pair<string, string>

  /**
   * When specified, if the type mixes the type in the first element, will replace it with the type in the second element.
   * The types listed in the third element will be ignored during the replacement.
   */
  replaceMixin: Triple<string, string, [string]>

  /**
   * When specified, all types containing a specific substring will be replaced with a different substring, excluding types
   * specified in a blacklist.
   * Format: {
   *   fst: string // the substring to search for in the type name
   *   snd: string // the substring to replace the first substring with
   *   thd: [string] // a list of types to exclude from the renaming operation
   * }
   */
  renameTypesContaining: Triple<string, string, [string]>

  /**
   * Removes any parameter of the given type from all methods
   */
  removeParamsWithType: string

  /**
   * Adds an annotation to the type
   */
  addAnnotation: string

  /**
   * Given the Triple X, Y, Z. Adds a parameter named Z.fst.fst with documentation Z.fst.snd of type Z.snd and remove params named Z.thd to any method annotated with X.
   * The Y value is the position of the parameter.
   */
  addParameterToAnnotatedMethod: Triple<string, int, Triple<Pair<string, string>, string, [string]>>

  /**
   * When specified, will add a prefix to all type references within a type definition.
   * The types listed in the second element will be ignored from adding a prefix.
   */
  addPrefixToRefType: Pair<string, [string]>

  /**
   * When specified, will add a prefix to all type extends within a type definition.
   * The types listed in the second element will be ignored from adding a prefix.
   */
  addPrefixToExtends: Pair<string, [string]>

  /**
   * When specified, will add a prefix to all type mixins within a type definition.
   * The types listed in the second element will be ignored from adding a prefix.
   */
  addPrefixToMixins: Pair<string, [string]>
}
