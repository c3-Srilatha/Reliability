type Pkg.Store.Git.ConfigureSpec mixes Spec {

  /**
   * If reset is set true, remote git branch contents will be used to replace Pkg.Store contents.
   * If reset is false, and Pkg.Store has contents, {@link pullFromGit(gitBranch)} will be called to get latest branch
   * and exising Pkg.Store changes will be applied on top of branch.
   */
  reset: boolean
}
