/**
 * All the dependencies of a PkgFile to metadata element
 */
type PkgFileDeps mixes Nameable {

  /**
   * Encoded Pkg.Path of the file.
   */
  name: ~

  /**
   * Documentation category (names) declared in topic files.
   *
   * @see TopicDocumentation
   */
  category: set<string>

  /**
   * The title of a documentation topic file.
   *
   * @see TopicDocumentation#title
   */
  topicTitle: string

  /**
   * The type of a documentation topic file.
   *
   * @see TopicDocumentation#topicType
   */
  topicType: string

  /**
   * true if content is serializable to targetType of the path. if null, not verified
   */
  serializable: ?boolean

  /**
   * any Pkg.Issues generated while building dependencies.
   */
  issues: [Pkg.Issue]

  /**
   * Retrieves cached backwards depending PkgFile for a given dependency element
   */
  backwardDeps: function(name: !string, key: !string): set<string serialized Pkg.Path>

  /**
   * Retrieves cached single dependency for a given PkgFile and dependency element
   *
   * @see Pkg.File#deps
   */
  dependency: function(pkgPath: !string serialized Pkg.Path, name: !string): any

  /**
   * @return Dependency with given name for all files accessible from this package, with file url being the key.
   */
  allDeps: function(name: !string): map<string serialized Pkg.Path, any>
}
