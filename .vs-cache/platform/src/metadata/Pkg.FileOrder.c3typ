/**
 * Order of files returned by Pkg.files action.
 */
enum type Pkg.FileOrder mixes FileOrder {

  /**
   * Order by files by placing remixed one first. I.e. if file B is remixing (overriding) file A then B
   * will show up first
   */
  REMIX = 'REMIX'

  /**
   * reverse order of remix.
   */
  REVERSE_REMIX = 'REVERSE_REMIX'
}
