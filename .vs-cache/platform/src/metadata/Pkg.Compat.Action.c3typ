/**
 * Declaration of API version compatibility transforms
 *
 * @see Pkg.Category#COMPAT
 */
inline type Pkg.Compat.Action mixes Pkg.Compat {

  /**
   * Source method for this compatibility
   */
  srcMethod: !Method

  /**
   * Target method for this compatibility
   */
  targetMethod: !Method

  /**
   * Compatibility for this arg
   */
  @java(codeGenSetCached=true)
  thsArg: cached property(): Pkg.Compat

  /**
   * Compatibility for result
   */
  result: cached property(): Pkg.Compat

  /**
   * Transform the arguments to the function from client version structure to structure in the current version
   */
  transformArgs: member function(thsArg: !?any, args: !?map<string, any>): Triple<MethodType, any, [native]>

  /**
   * Transform the result to client version structure
   */
  transformResult: member function(result: !?any): any

  /**
   * Compatibility for member actions
   */
  fromThsArgCompat: function(thsArg: !Pkg.Compat, srcMethodType: !MethodType): !Pkg.Compat.Action

  key:       ~
  transform: ~
}
