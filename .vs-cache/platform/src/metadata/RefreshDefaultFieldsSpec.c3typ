/**
 * Spec for the {@link Persistable#refreshDefaultFields} function.
 */
type RefreshDefaultFieldsSpec mixes RefreshSpec {

  /**
   * If specified, the list of default fields to refresh.  If empty, all default fields for the
   * type will be refreshed.
   */
  defaultFieldsToRefresh: [string]

  /**
   * If true and {@link defaultFieldsToRefresh} is not specified, then only default fields that
   * were defined in the type itself (e.g. not in its base type) will be refreshed.  If
   * defaultFieldsToRefresh is specified, this is ignored.
   */
  excludeBaseTypeFields: boolean
}
