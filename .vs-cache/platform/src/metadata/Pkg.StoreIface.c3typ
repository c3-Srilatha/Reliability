/**
 * This is an interface to different Pkg.Store.
 * All the metadata (Types and source code, Seed Config, Metadata, SeedData …) for an application is available through
 * {@link Pkg} instance.  To access all available {@link Pkg} instances, we are defining a store called 'Pkg.Store`.
 * Pkg.Store purpose is to allow editing of root package in Dedicated Developer Environment or serving production app
 * deployment.
 * {@see pkg.store.c3doc}
 */
abstract type Pkg.StoreIface {

  /**
   * @return all root pkg names in store.
   */
  pkgs: member function(): [string]

  /**
   * @return all available root pkg names and versions
   */
  pkgVersions: member function(): map<string, string serialized SemanticVersion>

  /**
   * @return true if given package is available in this store.
   */
  pkgExists: member function(name: !string): boolean

  /**
   * @return  file.paths available in this store filtered by pathPrefixOrGlob. If includeDeps is true, then dependency
   *          package paths will included with Pkg.Path.Overlay.Dep.
   */
  paths: abstract member function(pathPrefixOrGlob: string, includeDeps: boolean): @indexed set<Pkg.Path>

  /**
   * checks if the given path exists.
   */
  pathExists: member function(path: !string serialized Pkg.Path): boolean

  /**
   * @return fingerprint of provided content
   * @see Pkg#fileFingerprint
   */
  fingerprintEncodedContent: function(content: binary): !string

  /**
   * @return fingerprint of the requested path
   * @see Pkg#fileFingerprint
   */
  readFingerprint: abstract member function(pkgPath: !string serialized Pkg.Path): string

  /**
   * @return fingerprints of paths requested.
   * @see Pkg#fileFingerprint
   */
  readFingerprints: abstract member function(pkgPaths: ![string serialized Pkg.Path])
                                      : map<!string serialized Pkg.Path, string>

  /**
   * @return fingerprints of paths requested.
   * @see Pkg#fileFingerprint
   */
  readFingerprints: abstract member function(pkgPaths: !Collection<Pkg.Path>)
                                      : map<!string serialized Pkg.Path, string>

  /**
   * Remove cached entries of fingerprints for given paths.
   */
  evictFingerprints: abstract member function(paths: ![string serialized Pkg.Path])

  /**
   * Read content for a given path from this Pkg.Store.
   * @see readEncodedContent and readContentString
   */
  content: member function(path: !string serialized Pkg.Path, failIfMissing: boolean): Content

  /**
   * Read the bytes for a given path from this Pkg.Store.
   * @see content and readContentString
   */
  readEncodedContent: member function(pkgPath: !string serialized Pkg.Path, failIfMissing: boolean): binary

  /**
   * read content as a string from this store for a path.
   * @see content and readEncodedContent
   */
  readContentString: member function(pkgPath: !string serialized Pkg.Path, failIfMissing: boolean): string

  /**
   * Reads contents for given paths from this Pkg.Store.
   */
  contents: abstract member function(paths: ![string serialized Pkg.Path],
                                     failIfMissing: boolean): map<string serialized Pkg.Path, Content>

  /**
   * Reads contents for given paths from this Pkg.Store out as binary.
   */
  readEncodedContents: abstract member function(pkgPaths: ![string serialized Pkg.Path],
                                                failIfMissing: boolean): map<string serialized Pkg.Path, binary>

  /**
   * Read contents for pathPrefix Or Glob from this Pkg.Store.
   */
  readEncodedContents: member function(pathPrefixOrGlob: !string,
                                       includeDeps: boolean): map<string serialized Pkg.Path, binary>

  /**
   * Write the given content to this Pkg.Store at provided Pkg.Path. Will fail if this Pkg.Store is {@link #isReadOnly}.
   * Users may call `pkg().writeContent(content) or pkg().file().writeContent(content)`, which will
   * call this api to persist, if pkg() is backed by updatable store e.g Pkg.Store.Db, Pkg.Store.Local, Pkg.Store.Vcs.
   */
  writeEncodedContent: member function(pkgPath: !string serialized Pkg.Path,
                                       content: binary,
                                       spec: Pkg.Store.WriteSpec)

  /**
   * write content to this store as string.
   * @see writeEncodedContent
   */
  writeContentString: member function(pkgPath: !string serialized Pkg.Path, content: !string)

  /**
   * write content to this store.
   */
  writeContent: member function(content: !?Content)

  /**
   * Write the given contents to this Pkg.Store at provided Pkg.Path. Will fail if this Pkg.Store is {@link #isReadOnly}.
   * Do any cache invalidations.
   */
  writeEncodedContents: abstract member function(pathToContent: map<string serialized Pkg.Path, binary>,
                                                 spec: Pkg.Store.WriteSpec)

  /**
   * Delete given pkg path and content from store.
   */
  deleteContent: member function(pkgPath: !string serialized Pkg.Path, confirm: boolean)

  /**
   * Delete given pkg paths and contents from store.
   */
  deleteContents: member function(pkgPaths: ![string serialized Pkg.Path], confirm: boolean)

  /**
   * Returns true if the store is not writable. e.g. Pkg.Store.Java, Pkg.Store.Zip.
   */
  isReadOnly: abstract member function(): boolean

  /**
   * return Pkg.Decl for the given pkgName from this store. Null if Pkg.Decl is missing or contains critical issues.
   */
  pkgDecl: abstract member function(pkgName: !string, failIfMissing: boolean): Pkg.Decl

  /**
   * return Pkg.Decl for the given pkgName from this store as well as any errors in the Pkg.Decl.
   */
  pkgDeclAndIssues: abstract member function(pkgName: !string, failIfMissing: boolean): Pair<Pkg.Decl, Pkg.Issue>

  /**
   * return a best attempt of the parsed Pkg.Decl, suppressing any non-critical issues like incorrect fields.
   * If the issue is critical, such as being unparsable, Pkg.Decl will be null and Pkg.Issue will be set.
   * If the issue is non-critical, Pkg.Decl and Pkg.Issue will both be set.
   */
  parsePkgDecl: function(pkgDecl: !string, url: Pkg.Path): Pair<Pkg.Decl, Pkg.Issue>

  /**
   * @return all {@link Pkg.Path}s that point to a serialized {@link Pkg.Decl} (aka .c3pkg.json).
   */
  pkgDeclPaths: member function(): @indexed set<Pkg.Path>

  /**
   * Write Pkg.Decl with given name and dependencies to store.
   */
  writePkgDecl: member function(name: !string,
                                dependencies: map<string, string serialized SemanticVersion>,
                                spec: Pkg.Store.WriteSpec)
}
