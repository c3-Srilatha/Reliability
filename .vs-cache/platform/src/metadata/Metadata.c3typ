/**
 * Base type for metadata that is provisioned by c3 application package.
 *
 * By default, users cannot update metadata. However, the application can be in the development mode with
 * live metadata ON in which case metadata can be updated. Deploying a new version of an application will always
 * override live update but live updates can be promoted to application source repository as a new branch if source
 * control is configured.
 *
 * Metadata needs to mixin either `Named` or `Identified` and instances can be retrieved using either `forName` or
 * `forId` respectively.
 *
 * Metadata content is authored under `/metadata/` folder in c3 application package.
 *
 * Note that metadata in a depending package can be remixed by a root package by authoring updated version with same
 * `name` or `id`. {@link Jsn#merge(base, remix, true, true)} logic is used to perform the remix operation.
 *
 * Similarly if application is deployed in the test mode then metadata defined under `/test/metadata/` is remixed
 * with base.
 *
 * @see Config
 * @see SeedData
 */
abstract type Metadata mixes Fetchable, WithKey {

  /**
   * Various system fields.
   */
  // TODO: PLAT-82341 WithMeta tech debt
  meta: Meta

  /**
   * Retrieves dependencies to types or other metadata elements for the given instance of metadata.
   */
  dependencies: member function(): !MetadataDeps<@java(codeGenExtends=true) mixing Metadata>

  save:   member function(subPath: string, contentType: string serialized ContentType): !mixing Metadata
  remove: member function(spec: UpsertSpec): boolean

  /**
   * Remove the metadata instance as well as its associated backward dependencies.
   * Ex: {@link SourceSystem} has backward dependencies on {@link SourceCollection}
   */
  removeWithChildren: abstract optional member function(): boolean

  removeAll:        function(removeFilter: string): !int
  update:           member function(srcObj: mixing Metadata, spec: UpsertSpec): mixing Metadata
  upsert:           member function(srcObj: mixing Metadata, spec: UpsertSpec): mixing Metadata
  fetch:            ~
  fetchObjStream:   ~
  fetchMultiLocale: ~
  fetchCount:       ~
  scan:             ~

  /**
   * Retrieves folder that holds metadata.
   */
  metadataFolder: inline function(): string

  /**
   * If this Metadata type has arbitrary folder hierarchy.
   */
  hasArbitraryFolderHierarchy: inline function(): boolean

  /**
   * If metadata path is valid.
   * @param pkg
   *    name of the package
   * @param filePath
   *    path of metadata json file
   */
  isValidMetadataJson: function(pkg: !string, filePath: !string): boolean

  /**
   * Optional member function to enable custom validation logic.
   */
  @beta
  validateMetadata: optional inline member function(): !ValidateObjResult
}
