/**
 * Specific error codes for paths that fail validation as a fetch filter.
 */
enum type NonFilterablePathCode {

  /**
   * The final field in the path was an included type, which is not filterable.
   */
  INCLUDED_TYPE

  /**
   * The referenced type for a field in the path is not accessible from the current tenant/tag
   */
  FACADED_TYPE
}
