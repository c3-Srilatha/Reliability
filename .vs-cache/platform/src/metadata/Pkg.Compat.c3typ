/**
 * Declaration of API version compatibility transforms
 *
 * @see Pkg.Category#COMPAT
 */
@beta
inline type Pkg.Compat {

  /**
   * Package file this compatibility is defined in
   */
  file: !Pkg.File

  /**
   * Source type for this compatibility
   */
  srcType: !Type

  /**
   * Target type for this compatibility
   */
  targetType: !Type

  /**
   * Version of the source instance
   */
  from: !SemanticVersion.MajorMinor

  /**
   * Version of the target instance
   */
  to: !SemanticVersion.MajorMinor

  /**
   * Key for this compatibility in Egg#compats result
   */
  key: property(): !string

  /**
   * Transform lambda
   */
  transformer: cached property(): !lambda(src: !?any): any

  /**
   * Transform the instance of a given type to or from client version structure
   */
  transform: member function(src: !?any): any

  /**
   * Create instance from a package file
   */
  fromFile: function(file: !Pkg.File): !mixing Pkg.Compat
}
