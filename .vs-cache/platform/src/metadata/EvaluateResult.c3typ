/**
 * Result returned from call to {@link Persistable#evaluate}.
 */
type EvaluateResult mixes DataGriddable, Refreshable, Result {

  /**
   * Only used for  identifying test results for verification.  Otherwise, not used by the system at all.
   */
  id: string

  /**
   * List of returned results.  If no grouping is involved, each result will be the evaluated projections for a single obj that participated in
   * the evaluation.  If grouping is involved, each result will be for one unique set of grouped values.
   */
  tuples: [CellTuple]

  /**
   * Number of results returned.
   */
  count: !int

  /**
   * If the {@link EvaluateSpec.limit} was set to less than the actual number of results, this flag will be set to true to indicate that there were
   * more results that were not returned.
   */
  hasMore: boolean

  /**
   * Earliest result timestamp for a timeseries based evaluation.  Support for timeseries based evaluation is deprecated.  Moving forward {@link MetricEvaluatable.evalMetric}
   * or {@link MetricEvaluatable.evalMetrics} should be used instead.
   *
   * @see MetricEvaluatable
   */
  earliest: datetime

  /**
   * Earliest result timestamp aligned to the grain for a timeseries based evaluation.  Support for timeseries based evaluation is deprecated.  Moving forward {@link MetricEvaluatable.evalMetric}
   * or {@link MetricEvaluatable.evalMetrics} should be used instead.
   *
   * @see MetricEvaluatable
   */
  alignedEarliest: datetime

  /**
   * Latest result timestamp for a timeseries based evaluation.  Support for timeseries based evaluation is deprecated.  Moving forward {@link MetricEvaluatable.evalMetric}
   * or {@link MetricEvaluatable.evalMetrics} should be used instead.
   *
   * @see MetricEvaluatable
   */
  latest: datetime

  /**
   * Latest result timestamp aligned to the grain for a timeseries based evaluation.  Support for timeseries based evaluation is deprecated.  Moving forward {@link MetricEvaluatable.evalMetric}
   * or {@link MetricEvaluatable.evalMetrics} should be used instead.
   *
   * @see MetricEvaluatable
   */
  alignedLatest: datetime

  /**
   * Interval for timeseries based evaluation.  Support for timeseries based evaluation is deprecated.  Moving forward
   * {@link MetricEvaluatable.evalMetric} or {@link MetricEvaluatable.evalMetrics} should be used instead.
   */
  interval: string enum Interval

  /**
   * If {@link FetchSpec#explain} was set to true, returns the database query plans for all queries issued for the {@link Persistable#fetch} request.
   */
  queryPlans: [QueryPlan]

  /**
   * Original type on which {@link Evaluatable.evaluate} was called.
   */
  evaluateType: Type<<Evaluatable>>

  /**
   * Original spec passed to {@link Evaluatable.evaluate}.
   */
  spec: EvaluateSpec

  /**
   * @return the first Tuple, if there are any and null otherwise.
   */
  first: member function(): CellTuple

  /**
   * Converts this result into a flattened data type with dynamically constructed columns that are in order of
   * how projection was specified
   *
   * Note: the individual columns from projection may be adjusted to make it an allowed FieldType#name
   * (i.e. remove any special characters / identifiers)
   *
   * e.g.
   *  type TestType {
   *     id: string
   *     dbl: double
   *  }
   * projection: "id,sum(dbl)"
   *
   * id, dbl
   * s1   5
   * s2   15
   * s3   25
   *
   * er.toData(TestType,"id,sum(dbl)")
   *   id   sumdbl
   *   s1    5
   *   s2    15
   *   s3    25
   */
  @deprecated(finalVersion="8.8", details="This method will be removed in future releases.")
  toData: member function(type: !Type<<Evaluatable>>, projection: !string): Data

  /**
   * Make a tabular representation of the data with the projections as columns.
   */
  toDataGrid: ~ java | js

  isRefreshable: ~ java | js
}
