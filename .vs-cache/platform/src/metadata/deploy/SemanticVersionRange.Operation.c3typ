/**
 * Defines what operators can be used in a {@link SemanticVersionRange} string.
 * See {@link SemanticVersionRange} for more information.
 */
enum type SemanticVersionRange.Operation {

  EQ = '='

  GT = '>'

  GTE = '>='

  LT = '<'

  LTE = '<='

  TILDE = '~'

  CARET = '^'

  WILDCARD = '*'

  OR = '||'

  AND = ' '
}
