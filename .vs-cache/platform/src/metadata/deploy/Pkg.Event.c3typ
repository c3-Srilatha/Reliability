// TODO PLAT-67474: Write a c3doc for Pkg.Event. There's one for Pkg.File.Event but not for here.

/**
 * Event generated as part of Pkg contents change with details about the change.
 */
type Pkg.Event {

  /**
   * Sequence number for the event generated.
   */
  sequenceNum: !int

  /**
   * Pkg.File that changed
   */
  targetFile: !string serialized Pkg.Path

  /**
   * Fingerprint for the file.
   * @see Pkg#fileFingerprint
   */
  targetFileFingerprint: string

  /**
   * Target type of the metadata file that changed, if applicable.
   */
  targetType: Type

  /**
   * Dependent types that are affected by this change, if any.
   */
  backwardDeps: [string]

  /**
   * Kind of event generated fpr the target file.
   */
  kind: !string enum Pkg.Event.Kind

  /**
   * All Pkg.Issues that are present for the target file.
   */
  issues: [Pkg.Issue]

  /**
   * Return the file name (without path).
   *
   * @see #targetFile
   */
  fileName: member function(): !string java | js

  /**
   * Return the type name if this file is part of a type (definition or implementation source code). For example,
   * changes to the file `WindTurbine.c3typ` would be to the **WindTurbine** type.
   *
   * @see #targetFile
   */
  typeName: member function(): string java | js

  /**
   * Return what part of the type that changed if this file is part of a type (definition or source code). For example,
   * changes to the file `WindTurbine.py` would be to the `SOURCE` type part.
   *
   * @see #targetFile
   */
  typePart: member function(): string enum Pkg.File.TypePart java | js
}
