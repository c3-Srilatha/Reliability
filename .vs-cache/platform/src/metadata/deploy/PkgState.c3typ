/**
 * Current list of {@link Pkg.Issue}s in Pkg, and the expected sequence number for next {@link Pkg.Event}
 * to send to client.
 */
type PkgState {

  /**
   * Sequence number maintained by server for event to be generated.
   */
  nextEventSequenceNum: !int

  /**
   * All metadata issues present at current time.
   */
  issues: [Pkg.Issue]
}
