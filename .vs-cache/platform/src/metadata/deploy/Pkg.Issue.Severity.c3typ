/**
 * Enumeration of metadata issue severity.
 */
enum type Pkg.Issue.Severity {

  /**
   * Indicates major problem with the Pkg file. I.e. this file can not be provisioned.
   */
  ERROR

  /**
   * Indicates a problem with the Pkg file; however file is still provision-able. This issue needs to be
   * fixed before deploying file in production.
   */
  WARNING

  /**
   * Helpful information / hint regarding this Pkg file. E.g. suggestion to use a better more optimized way of
   * defining metadata.
   */
  INFO

  /**
   * Information that can be used for debugging issues. Only produced if explicitly requested.
   */
  DEBUG
}
