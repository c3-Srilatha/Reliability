/**
 * In-memory instance of Pkg.File that cannot be persisted. This is useful for passing content internally.
 *
 * Note that this class only allows reading from the file since there is no underlying file system; however it is
 * possible to clone it by replacing a content and then saving it
 */
type Pkg.File.Value mixes Pkg.File {

  encodedContent: binary

  /**
   * Saves this in memory metadata file into current metadata store.
   */
  save: member function(): !Pkg.File

  @deprecated(finalVersion='8.6',
              reason='Use fromText(text: !?string, contentType: !string, contentEncoding: !?string, pathOrUrl: !string) instead')
  fromText: function(pathOrUrl: !string, contentType: !string, text: !?string): Pkg.File.Value java | js | py

  @deprecated(finalVersion='8.6', reason='Use fromBinary instead')
  fromData: function(pathOrUrl: !string, contentType: !string, data: !?binary): Pkg.File.Value

  fromText: function(text: !?string,
                     contentType: !string,
                     contentEncoding: !?string,
                     pathOrUrl: !string): Pkg.File.Value java | js | py

  fromBinary: function(encodedBinary: !?binary,
                       contentType: !string,
                       contentEncoding: !?string,
                       pathOrUrl: !string): Pkg.File.Value java | js

  fromUrlOrPath:     ~
  readMetadata:      ~
  encodedStream:     ~
  encodedPushStream: ~
}
