enum type TypeConflictResolution {

  /**
   * Discard metadata in my type in favor of dependency types with the same name
   */
  DISCARD = 'discard'

  /**
   * Discard metadata in the base type with the same name as a type in this package
   */
  DISCARD_BASE = 'discard-base'
}
