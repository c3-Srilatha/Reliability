/**
 * Reference to content that can be attached to an instance of data. E.g. to an instance of entity type or Config or
 * SeedData or Metadata.
 */
type Attachment {

  /**
   * Url of the attached content
   */
  url: !string serialized Url

  /**
   * If set then actual content eTag is matched to this value
   */
  eTag: string

  /**
   * If true then best effort is made to ensure attached content is read-only e.g. by updating target file metadta.
   * Note however that this may not be possible for a file system that handles given Url
   */
  readOnly: boolean

  /**
   * @return attached content
   */
  content: member function(failIfMissingOrOurOfDate: boolean): Content

  /**
   * Creates new instance of Attachment. If `eTag` is `true` then will store correct `eTag` of attached content. If
   * `readOnly` is set then will attempt to verify or update attached content metadata and will fail if unable to do so
   */
  create: function(url: !string serialized Url, eTag: boolean, readOnly: boolean): !mixing Attachment
}
