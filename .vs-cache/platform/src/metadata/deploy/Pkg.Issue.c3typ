/**
 * Describes issue with Pkg file content.
 *
 * To get the full list of Pkg.Issues for a Pkg, call pkg().issues()
 */
inline type Pkg.Issue {

  /**
   * URL of the source metadata file. {@link #file}
   */
  fileUrl: !string

  /**
   * Line number in the source metadata file where this issue is occurring.
   */
  lineNum: !int

  /**
   * Column number in the source metadata file where this issue is occurring.
   */
  colNum: !int

  /**
   * Metadata issue severity.
   */
  severity: !string enum Pkg.Issue.Severity

  /**
   * Human readable description of the issue.
   */
  message: !string

  /**
   * Optional target type name for this issue.
   */
  targetType: private string

  /**
   * Optional target type field name for this issue.
   */
  targetField: private string

  /**
   * Optional target obj id name for this issue.
   */
  targetId: private string

  /**
   * Optional category code for related issues.
   */
  code: string enum Pkg.Issue.Code

  /**
   * Formatted message for this issue
   */
  formattedMessage: property(): !string

  /**
   * @return instance of the source metadata file. {@link #file}
   */
  file: member function(): Pkg.File

  /**
   * @return true if has targetType or targetId
   */
  hasTarget: member function(): boolean

  /**
   * @return true if this issue if an ERROR.
   */
  isError: member function(): boolean

  /**
   * @return true if this issue if an WARN.
   */
  isWarn: member function(): boolean

  /**
   * @return true if this issue if an INFO.
   */
  isInfo: member function(): boolean

  /**
   * @return true if this issue if an DEBUG.
   */
  isDebug: member function(): boolean

  /**
   * @return true if this issue if for a provided target.
   */
  isFor: member function(target: Obj): boolean

  /**
   * @return true if this issue if for a provided type.
   */
  isForType: member function(targetType: string): boolean

  /**
   * @return true if this issue if for a provided field.
   */
  isForField: member function(targetType: string, targetField: string): boolean

  /**
   * @return true if this issue is for the provided metadata file.
   */
  isForFile: member function(targetUrl: string): boolean

  /**
   * Generate an issue for a type, a metadata file or a seed data object. Either forType, forFile or forSeedData is
   * called depending on the value passed.
   * @return Pkg.Issue for the specified target object
   */
  forTarget: function(target: !any,
                      severity: !string enum Pkg.Issue.Severity,
                      message: !string,
                      code: string): !Pkg.Issue

  /**
   * @return Pkg.Issue with provided type's definition file with the line number at the first line of the type
   *         definition and the first column on the type name.
   */
  forType: function(targetType: !Type,
                    severity: !string enum Pkg.Issue.Severity,
                    message: !string,
                    code: string): !Pkg.Issue

  /**
   * @return Pkg.Issue with provided fields's definition file positioned on the field declaration.
   */
  forField: function(targetType: !Type,
                     targetField: !string,
                     severity: !string enum Pkg.Issue.Severity,
                     message: !string,
                     code: string): !Pkg.Issue

  /**
   * @return Pkg.Issue with provided method's implementation script metadata file with the line number at the
   *         function declaration.
   */
  forSourceCode: function(targetType: !Type,
                          targetField: !string,
                          severity: !string enum Pkg.Issue.Severity,
                          message: !string,
                          code: string): !Pkg.Issue

  /**
   * @return Pkg.Issue with provided objects source seed data file with the line number at the object content.
   */
  forSeedData: function(obj: !Obj,
                        severity: !string enum Pkg.Issue.Severity,
                        message: !string,
                        code: string): !Pkg.Issue

  /**
   * @return Pkg.Issue for the specified file
   */
  forFile: function(file: !Pkg.File,
                    severity: !string enum Pkg.Issue.Severity,
                    message: !string,
                    code: string,
                    lineNum: int,
                    colNum: int): !Pkg.Issue

  /**
   * @return Pkg.Issue with corresponding .c3pkg.json metadata file with the line number at the first line of JSON.
   */
  forPackage: function(package: !Pkg.Decl,
                       severity: !string enum Pkg.Issue.Severity,
                       message: !string,
                       code: string): !Pkg.Issue

  /**
   * @return new instance with Pkg.Issue.Severity.ERROR
   */
  makeError: function(message: !string, fileUrl: string, lineNum: int, colNum: int): !Pkg.Issue

  /**
   * @return new instance with Pkg.Issue.Severity.WARNING
   */
  makeWarn: function(message: !string, fileUrl: string, lineNum: int, colNum: int): !Pkg.Issue

  /**
   * @return new instance with Pkg.Issue.Severity.WARNING if ver < errorStartingVer else Pkg.Issue.Severity.ERROR.
   *        If Pkg.Issue.Severity.WARNING, also appends a blurb stating the version the warning will become an error.
   */
  makeWarnUpTo: function(errorStartingVer: !SemanticVersion.MajorMinor,
                         ver: !SemanticVersion.MajorMinor,
                         message: !string,
                         fileUrl: !string): !Pkg.Issue

  /**
   * @return new instance with Pkg.Issue.Severity.WARNING, indicating a deprecated API was used and including the
   * final version in which it will be supported. Do not use the word "deprecated" in the message; it will be appended
   * automatically.
   */
  makeDeprecate: function(message: !string,
                          finalVersion: !string,
                          fileUrl: string,
                          lineNum: int,
                          colNum: int): !Pkg.Issue

  /**
   * @return new instance with Pkg.Issue.Severity.INFO
   */
  makeInfo: function(message: !string, fileUrl: string, lineNum: int, colNum: int): !Pkg.Issue

  /**
   * @return new instance with Pkg.Issue.Severity.DEBUG
   */
  makeDebug: function(message: !string, fileUrl: string, lineNum: int, colNum: int): !Pkg.Issue

  /**
   * @return a new instance with Pkg.Issue.Severity.Error, based exception provided.
   */
  fromException: function(ex: @java(class='java.lang.Throwable') !?native, fileUrl: string): !Pkg.Issue

  /**
   * Set the message by formatting the specified string. This replaces "{}" escapes with the corresponding
   * arguments by index.
   * @return new instance with message set
   */
  withMessageFormat: member function(format: !string,
                                     arg1: any,
                                     arg2: any,
                                     arg3: any,
                                     arg4: any,
                                     arg5: any): !Pkg.Issue

  /**
   * Format the specified string by replacing "{}" escapes with the corresponding arguments by index.
   * @return formatted string
   */
  format: private function(format: !string, arg1: !any, arg2: any, arg3: any, arg4: any, arg5: any): !string
}
