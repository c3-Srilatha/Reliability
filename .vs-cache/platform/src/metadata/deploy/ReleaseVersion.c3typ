/**
 * Release version for C3 metadata repository, using the same versioning scheme as Semantic Versioning
 */
@deprecated(finalVersion='8.0', details='Use {@link SemanticVersion}')
type ReleaseVersion mixes StringSerializable {

  /**
   * Major version is incremented when there are incompatible API changes
   */
  majorVersion: !int

  /**
   * Minor version is incremented when a functionality is added in a backwards-compatible manner
   */
  minorVersion: int

  /**
   * Patch version is incremented when backwards-compatible bug fixes are made
   */
  patchVersion: int

  /**
   * A flag to represent if current version is supported by the C3 metadata repository store
   */
  deprecated: boolean = false

  /**
   * Print release version number with format: MAJOR.MINOR.PATCH
   */
  toString: ~ js

  /**
   * Construct a release version from string with format MAJOR.MINOR.PATCH
   */
  fromString: ~ js
}
