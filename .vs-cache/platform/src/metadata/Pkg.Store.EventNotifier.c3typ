/**
 * Event notifier that keeps track of pushstreams backing EventStreams and pushes any store generated
 * events to EventStreams.
 */
private type Pkg.Store.EventNotifier mixes Stateful, Mutable, Named {

  /**
   * list of PushStreams backing EventStreams that are listened to.
   * Each listener of Pkg.Store will have any entry here.
   */
  pushStreams: [EventStream.PushStream<Pkg.File.Event>]

  /**
   * returns next event number that will be pushed.
   */
  nextEventSequenceNum: member function(): int

  /**
   * returns true, if there are any EventStreams that are listened to.
   */
  hasStreams: member function(): boolean

  /**
   * Write the given event with to all event streams, will set event.sequenceNum with ths.eventSequenceNum and advance
   * this notifier.eventSequenceNum by 1.
   *
   * @param event
   *          {@link Pkg.File.Event} to write to event streams.
   * @param broadcast
   *           If true, all nodes in env and apps will be notified of this event.
   * @return The input event sent post-processing with additional debug info from {@link Pkg.Store.Event.Verbose}.
   */
  writeEvent: member function(event: Pkg.File.Event, broadcast: boolean): Pkg.File.Event.Verbose

  /**
   * for testing, will push the given event to all event streams. does not change event or notifier's eventSequenceNum.
   */
  pushEvent: private member function(event: Pkg.File.Event, broadcast: boolean)

  /**
   * create an EventStream. EventStream would be used by listener to receive new events from store.
   * @see EventStream.
   */
  createEventStream: member function(): EventStream<Pkg.File.Event>
}
