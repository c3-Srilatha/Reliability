/**
 * Spec for {@link MetadataUtil.getTypesThatMixinMultiple}
 */
type TypesThatMixinSpec mixes Spec {

  /**
   * The mixin type
   */
  mixinType: Type

  /**
   * If true, return types that mixin other types that mixin the specified type, default to false
   */
  deep: boolean = false
}
