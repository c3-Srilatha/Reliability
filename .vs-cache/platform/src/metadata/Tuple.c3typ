/**
 * Set of named or positional values.
 *
 * To get the {@link TupleType} from a tuple instance, use TupleType#ofTuple. In JavaScript and Python, the `$type`
 * property can also be used.
 *
 * @see TupleType
 */
type Tuple mixes Iterable<native>, Fingerprintable, Serializable, Instance, FieldsProtocol, ItemProtocol, InProtocol, LengthProtocol, Value {

  /**
   * Tuple field value by name. If field doesn't exit, returns null.
   */
  field: member function<T>(name: !?string): T java | js

  /**
   * Tuple field value by index. If not in range, returns null.
   */
  field: member function<T>(index: !int): T java | js

  /**
   * Tuple field values by index.
   */
  fields: member function(): [any] java | js

  /**
   * Tuple field values by name.
   */
  fieldsByName: member function(): map<string, any> java | js | py-client

  /**
   * New tuple with provided field set by name
   */
  withField: member function<T>(name: !?string, value: !?any, doNotConvert: boolean): !mixing Tuple

  /**
   * New tuple with provided field set by index
   */
  withField: member function<T>(index: !int, value: !?any, doNotConvert: boolean): !mixing Tuple

  /**
   * Constructor for obtaining array of Tuple
   */
  fromDataColumns: private function(cols: [Data.Column]): [Tuple]

  /**
   * Constructs named tuple from fields provided as sequence of triples of field name, value type and value. E.g.
   * `Tuple.of("a", "string", "foo", "b", "int", 17)` produces tuple `{a: "foo", b: 17}` of type `{a: string, b: int}`
   */
  of: function(fields: any ...): tuple

  toTypedJson: ~ java | js | py-client
  toJson:      ~ java | js | py-client
  _length_:    ~ java | py-client
  _item_:      ~ java | py-client

  /**
   * Return true if the requested value is equal to one of the values in the tuple.
   */
  _contains_: ~ java | py-client

  _field_:      ~ java | py-client
  _fieldNames_: ~ java | py-client

  /**
   * Returns an array containing all the fields of a named tuple
   */
  fieldNames: member function(): [string] java | js | py-client

  iter:   ~ java | py
  _iter_: ~ java | py

  /**
   * Type of this tuple
   */
  // TODO: PLAT-107680 Remove Tuple#type property and change serialization to always use $type
  @deprecated(details="This can be shadowed by a field, so TupleType#ofTuple should be used instead")
  type: property(): !TupleType java | js | py-client

  toNative:    ~ java | js | py
  valueType:   ~ java | js | py
  valueTypeOf: ~ java | js | py
}
