/**
 * A record of where local git workspace is maintained for Pkg.Store interactions with Git.
 */
private entity type Pkg.Store.Git.Workspace mixes Singleton {

  id: !~ = "Pkg.Store.GitWorkspace"

  /**
   * Git repo url and branch used for synchronizing with Pkg.Store.
   */
  gitBranch: !Pkg.Store.Git.Branch

  /**
   * Last commit used locally to sync with Pkg.Store.
   */
  commitSha: string

  /**
   * For node affinity, always send Git operations to this node only.
   */
  appNodeId: !string serialized App.Node.Id
}
