/**
 * Data points have a shape based on a repeating date component.  Used in {@link TimeseriesDataSpec.components}.
 */
type DatePartSpec mixes Spec {

  /**
   * Repeating date component.
   */
  datePart: string enum('HourOfWeek', 'HourOfDay', 'DayOfYear', 'MonthOfYear')

  /**
   * Minimum number to increment by.
   */
  min: double

  /**
   * Maximum number to increment by.
   */
  max: double

  /**
   * Shape for generated data.
   */
  shape: [double]
}
