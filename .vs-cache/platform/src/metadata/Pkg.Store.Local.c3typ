/**
 * This represents Pkg.Store backed by local filesystem.
 * @see Pkg.Store.Local.Config
 */
type Pkg.Store.Local mixes Pkg.Store.Nested, Configurable<Pkg.Store.Local.Config>, Named {

  /**
   * Setup config for name with local path.
   */
  configureFor: function(name: !string, localRoot: !string): Pkg.Store.Local
}
