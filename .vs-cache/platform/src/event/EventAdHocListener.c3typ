/**
 * Info regarding event listener added via Event#listen or EventBus#listen
 */
type EventAdHocListener mixes Spec {

  /**
   * Target event
   */
  event: !(string | Type<<Event>>)

  /**
   * Event filter
   */
  filter: string serialized Expr<<Event>>

  /**
   * Parent Action that started listening
   */
  owner: Action

  /**
   * Stops listening to the event
   */
  stop: member function()

  /**
   * @return approximate statistics for this listener
   */
  stats: member function(): !EventListenerStats
}
