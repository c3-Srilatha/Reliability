type GuardInstance mixes Tmta, LockAttrs {

  cid:          string
  ownerNodeId:  string
  username:     string
  status:       string
  requestCount: int
  lockCount:    int
  lockedBy:     string
  due:          decimal
  guard:        string
  create:       function(obj: GuardInstance): GuardInstance
  update:       function(obj: GuardInstance): GuardInstance
  upsert:       function(obj: GuardInstance): GuardInstance
  remove:       function(obj: GuardInstance)
  get:          function(obj: GuardInstance): GuardInstance
  fetch:        function(spec: FetchSpec): FetchResult
  evaluate:     function(spec: EvaluateSpec): EvaluateResult
}
