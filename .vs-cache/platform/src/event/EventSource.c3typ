/**
 * Type that can trigger {@link EventWithSource}. Manages callback registration and invokes appropriate callbacks when
 * specific instances of the {@link EventWithSource} are triggered.
 *
 * Although the name may be confusing, types mixing EventSource represent not just the source or trigger of the event
 * but also the listener, registering/deregistering with the #on/#off methods.
 * The reason for this is because we want the listeners to be stored on the metadata of the event that it's emitting.
 */
abstract type EventSource mixes Mutable {

  /**
   * All registered event handlers on this EventSource that should be serialized with state.
   */
  @react(skipToReactProps=true)
  @mutable(skipOnChange=true)
  eventHandlers: map<string, [lambda(e: !EventWithSource<EventSource>)]>

  /**
   * All registered event handlers on this EventSource that should NOT be serialized with state.
   */
  @ser(hidden=true)
  @react(skipToReactProps=true)
  @mutable(skipOnChange=true)
  nonSerializableEventHandlers: private map<string, [lambda(e: !EventWithSource<EventSource>)]>

  /**
   * Registers a custom handler to be called when events of given type are triggered from this EventSource.
   *
   * @param eventType the specific {@link EventWithSource} type that is being listened to
   * @param cb callback to be called when an instance of `eventType` is triggered.
   */
  // TODO: PLAT-24110 - :v8: - `mixing` does not work in function generic vars
  // on: member function<T: EventWithSource<mixing EventSource>>(eventType: !Type<<T>>, cb: !lambda(e: !T))
  on: member function<T: EventWithSource>(eventType: !Type<<T>>, cb: !lambda(e: T)): EventSource java | js

  /**
   * Registers a custom handler to be called when events of given types are triggered from this EventSource.
   * @param nonSerializable true if the event handler should not be serialized with the EventSource. Typically, this
   *            should be 'true' when adding handlers within an `afterMake`.
   * @param eventType the specific {@link EventWithSource} type that is being listened to
   * @param cb callback to be called when an instance of `eventType` is triggered.
   */
  on: private member function<T: EventWithSource>(nonSerializable: boolean,
                                                  eventType: !Type<<T>>,
                                                  cb: !lambda(e: T)): EventSource java | js

  /**
   * Removes a handler for the named event type so that it is no longer called when events of given type are triggered
   * from this EventSource. If no handler is specified, all handlers registered for that event are.
   *
   * @param eventType the specific {@link EventWithSource} type that is being listened to
   * @param cb callback to unregister
   */
  // TODO: PLAT-24110 - :v8: - `mixing` does not work in function generic vars
  // off: member function<T: EventSource<mixing EventSource>>(eventType: !Type<<T>>, cb: !lambda(e: !T))
  off: member function<T: EventWithSource>(eventType: !Type<<T>>, cb: lambda(e: !T)): EventSource java | js

  /**
   * Invokes all callbacks registered for the `event` type.
   *
   * @param event the event to trigger
   */
  trigger: member function(event: !EventWithSource<EventSource>) java | js

  /**
   * All {@link EventWithSource} types that this EventSource can emit/be triggered on.
   */
  eventTypes: cached function(): [Type<<EventWithSource<EventSource>>>] java | js

  /**
   * Returns all {@link EventWithSource} types that the input EventSource can emit/be triggered on.
   */
  eventTypesFor: private function(type: Type<EventSource>): [Type<<EventWithSource<EventSource>>>]

  /**
   * Get all the event handlers registered on the EventSource, grouped by name of the EventWithSource type
   */
  allHandlers: private member function(): map<string, [lambda(e: !EventWithSource<EventSource>)]> java | js
}
