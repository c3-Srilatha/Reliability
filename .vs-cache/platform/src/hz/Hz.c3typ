type Hz mixes Singleton {

  isRunning:     inline member function(): boolean
  isClusterSafe: inline member function(): boolean
  start:         member function(): !HzStatus
  start:         member function(leaderAddress: !string, leaderPort: !int32): !HzStatus
  stop:          member function()
  status:        member function(): !HzStatus
  terminate:     member function()
  map:           member function(name: !string, spec: HzEntitySpec): !HzMap
  queue:         member function(name: !string, spec: HzEntitySpec): !HzQueue
  lock:          member function(name: !string, spec: HzEntitySpec): !HzLock
  exec:          member function<T>(action: @ser lambda(): T): T
  inst:          ~
  port:          private member function(): !int32
  ipAddress:     private member function(): !string
  doStart:       private member function(leaderAddress: !?string, leaderPort: !?int32)
  doShutdown:    private member function()
  doTerminate:   private member function()
}
