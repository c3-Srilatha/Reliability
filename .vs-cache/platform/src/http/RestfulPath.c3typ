/**
 * A "restful path" is a specification used with the {@link Ann.Restful @restful} annotation to map a request path to
 * a method for invocation from the API.
 *
 * This looks like a normal URL path, but path elements (slash separated) may be replaced with a variable name prefixed
 * with colon (`:`). For example: "type/:name" requests the path to start with literal "type/", but will pass anything
 * after the slash as the value for the parameter "name".
 *
 * If a parameter appears in the middle of the path, it will only match to the next slash, allowing multiple parameters
 * to be used, for example "type/:typeName/field/:fieldName".
 */
type RestfulPath mixes UrlPath {

  /**
   * The parameters defined in the path.
   */
  params: member function(): [string]

  /**
   * Whether or not this path has any parameters defined.
   */
  hasParams: member function(): boolean

  /**
   * Extract the value of a specific parameter from an actual URL. If this URL doesn't conform to the format, null
   * is returned (or an error is thrown). The URL is expected to be properly encoded.
   *
   * Note that scheme, host, query and fragment are ignored and the URL path may contain elements _before_ the spec,
   * but it must _end_ with the spec. So this is a more forgiving than #urlMatches.
   */
  extractUrlParam: member function(url: !string serialized Url, param: !string, failIfNoMatch: boolean): string

  /**
   * Extract the value of a specific parameter from a file path. If this path doesn't conform to the format, null
   * is returned (or an error is thrown). The path is expected to be already decoded.
   *
   * Note that the URL path may contain elements _before_ the spec, but it must _end_ with the spec. So this is a more
   * forgiving than #pathMatches.
   */
  extractPathParam: member function(path: !string, param: !string, failIfNoMatch: boolean): string

  /**
   * Return true if an actual URL matches this spec. This is true if the URL's path (ignoring schema, host, query
   * and fragment) match.
   *
   * @see #pathMatches
   */
  urlMatches: member function(url: !string serialized Url): boolean

  /**
   * Return true if an actual path matches this spec. This is only true if the non-parameter path elements match and
   * there is content for the parameter elements.
   */
  pathMatches: member function(path: string): boolean

  /**
   * Build a regular expression pattern that matches the entire path. (This is used by #pathMatches to avoid
   * building the pattern repeatedly.)
   */
  pathPattern: private cached member function(): @java(class="java.util.regex.Pattern") !native
}
