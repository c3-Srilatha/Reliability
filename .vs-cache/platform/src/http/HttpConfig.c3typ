/**
 * Type used to configure various HttpListener parameters.
 */
// TODO: Document
type HttpConfig mixes Config, Singleton {

  httpPort:                            int32 = 8080
  useSyncProxyServlet:                 boolean = true
  requestStatsLoggingFrequencySeconds: int32 = 60
  httpOnlyCookie:                      boolean = false
  httpOnlyC3Auth:                      boolean = true
  tunnelEnabled:                       boolean = true
  tunnelMaxTimeoutSecs:                int32 = 900
  httpsPort:                           int32 = 8443
  responseTimeoutMs:                   int32 = 1440000
  minGzipSize:                         int32 = 512
  authEnabled:                         boolean = false
  httpEnabled:                         boolean = true
  httpsEnabled:                        boolean = false
  anonThrottleTime:                    int32 = 100
  traceEnabled:                        boolean = false
  webSocketMaxMsgSize:                 int32 = 524288
  webSocketConnTimeout:                int32 = 60
  webSocketRetries:                    int32 = 10
  webSocketAuthEnabled:                boolean = true
  webSocketAuthTokenExpiration:        int32 = 0
}
