/**
 * Http cookie value
 */
type HttpCookie mixes StringSerializable {

  /**
   * The name of the cookie.
   */
  name: !string

  /**
   * The value of the cookie.
   */
  value: !string

  /**
   * The domain for which the cookie is valid. This attribute is optional (any domain).
   */
  domain: string

  /**
   * The subset of URLs to which this cookie applies. This attribute is optional (all paths).
   */
  path: string

  /**
   * Indicates to the browser whether the cookie should only be sent using a secure protocol, such as HTTPS or SSL.
   */
  secure: boolean

  /**
   * HttpOnly cookies are not supposed to be exposed to client-side scripting code, and may therefore help mitigate
   * certain kinds of cross-site scripting attacks.
   */
  httpOnly: boolean

  /**
   * This attribute defines the lifetime of the cookie, in seconds. After this time elapses, the client must discard
   *  the cookie. A value of zero means the cookie should be discarded immediately.
   */
  maxAge: int32

  /**
   * Cookie version, defaults to version 1 (RFC 2109). This is a required value.
   */
  vers: int32 = 1

  /**
   * Creates a javax.servlet.http.Cookie object
   */
  toJavaxServletCookie: inline member function(): @java(class="javax.servlet.http.Cookie") native
}
