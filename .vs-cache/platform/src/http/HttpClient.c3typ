/**
 * Asynchronous HTTP client
 */
type HttpClient mixes Value {

  /**
   * Opens HTTP client to a given url ready to send requests
   */
  open: function(rootUrl: !string serialized Url,
                 auth: !?string serialized Authorization,
                 defaultRequestHeaders: map<string, string>): !HttpClient

  /**
   * @return root URL of this client
   */
  rootUrl: member function(): !string serialized Url

  /**
   * @return URL for a given encoded path
   */
  url: member function(encodedPath: !?string): !string serialized Url

  /**
   * Clears all default request headers including Authorization
   */
  clearDefaultRequestHeaders: member function()

  /**
   * Sets or clears provided default request header
   */
  setDefaultRequestHeader: member function(name: !string, value: !?string)

  /**
   * @return default HTTP headers that are sent with every request
   */
  defaultRequestHeaders: member function(): map<string, string>

  /**
   * @return new HttpRequest for a given encoded path
   */
  request: member function(method: !string serialized HttpMethod, encodedPath: !?string): !HttpRequest

  /**
   * @return new HttpRequest for a given path and json payload
   */
  request: member function(method: !string serialized HttpMethod, encodedPath: !?string, entity: !?json): !HttpRequest

  /**
   * @return promise of response for provided request
   */
  sendJson: member function(method: !string serialized HttpMethod,
                            encodedPath: !?string,
                            entity: json): !Promise<HttpResponse>

  /**
   * Closes this connection
   */
  close: member function()
}
