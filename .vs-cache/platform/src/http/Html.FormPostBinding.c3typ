/**
 * Represents a form data to be sent in the body of a POST request.
 */
inline type Html.FormPostBinding mixes Html {

  /**
   * The form data to be sent
   */
  params: map<string, string>

  /**
   * The URL to which the form data should be sent.
   */
  redirectUrl: string

  fromString: ~ java
  toString:   ~ java
}
