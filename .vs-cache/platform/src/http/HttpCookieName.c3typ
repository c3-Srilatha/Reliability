/**
 * Http cookie names used by C3 server.
 */
enum type HttpCookieName {

  /**
   * C3 Authentication token (aka session token)
   */
  C3_AUTH = 'c3auth'

  /**
   * Tenant associated with the request's host (domain).
   */
  C3_TENANT = 'c3tenant'

  /**
   * Tag associated with the request's host (domain).
   */
  C3_TAG = 'c3tag'

  /**
   * Cookie indicating whether canonical url was used for the request
   */
  C3_CANONICAL = 'c3canonical'

  /**
   * Cookie used to protect cross-site request forgery.
   */
  C3_CSRF = 'c3csrf'
}
