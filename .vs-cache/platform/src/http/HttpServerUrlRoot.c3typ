/**
 * Type to represent the root of the server request.
 */
enum type HttpServerUrlRoot {

  /**
   * Api request.
   */
  API = 'api'

  /**
   * File request.
   */
  FILE = 'file'

  /**
   * Import request.
   */
  IMPORT = 'import'

  /**
   * Content request.
   */
  CONTENT = 'content'

  /**
   * Type system request.
   */
  TYPESYS = 'typesys'

  /**
   * Ui content request.
   */
  UI = 'ui'

  /**
   * Explicit authentication request.
   */
  AUTH = 'auth'
}
