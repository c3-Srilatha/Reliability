/**
 * Type to represent the root of the server request.
 */
enum type HttpStatusCode {

  CONTINUE = 100

  OK = 200

  ACCEPTED = 202

  NO_CONTENT = 204

  MOVED_PERMANENTLY = 301

  FOUND = 302

  NOT_MODIFIED = 304

  BAD_REQUEST = 400

  NOT_AUTHORIZED = 401

  FORBIDDEN = 403

  NOT_FOUND = 404

  CONFLICT = 409

  INTERNAL_SERVER_ERROR = 500

  BAD_GATEWAY = 502

  SERVICE_UNAVAILABLE = 503

  METHOD_NOT_ALLOWED = 405
}
