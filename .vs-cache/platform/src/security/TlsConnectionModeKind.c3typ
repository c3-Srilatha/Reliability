/**
 * Enum for different "kinds" of connection modes
 * (e.g. "allow" or "disabled") - https://jdbc.postgresql.org/documentation/ssl/
 */
enum type TlsConnectionModeKind {

  /**
   * Disable TLS/SSL
   */
  DISABLE = 'disable'

  /**
   * Allow TLS/SSL
   */
  ALLOW = 'allow'

  /**
   * Prefer TLS/SSL
   */
  PREFER = 'prefer'

  /**
   * Require TLS/SSL
   */
  REQUIRE = 'require'

  /**
   * Verify-CA for TLS/SSL
   */
  VERIFY_CA = 'verify-ca'

  /**
   * Verify-Full for TLS/SSL
   */
  VERIFY_FULL = 'verify-full'
}
