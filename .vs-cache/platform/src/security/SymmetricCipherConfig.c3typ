/**
 * Configuration for SymmetricCipher
 */
@config(maxOverride=CLUSTER, minOverride=APP)
@action(group+='app-admin')
type SymmetricCipherConfig mixes Config {

  /**
   * Data encryption key validity period in days. if not configured, data encryption key is not refreshed till the node
   * is restarted.
   */
  dekValidity: string serialized Period = '0d'

  /**
   * Data Encryption Key pool size in terms of %. If not specified, it assumes 0.001% of number records that will be
   * ingested by the platform
   */
  dekPoolSize: double = 0.001

  /**
   * Long term key used for hashing the data.
   */
  @config(secret=true)
  keyForHash: SecretKey

  /**
   * Active key encryption key(Kek)
   */
  @config(secret=true)
  activeKek: SecretKey

  /**
   * Inactive key encryption key(Kek)
   */
  @config(secret=true)
  inactiveKek: SecretKey

  /**
   * Key encryption key(Kek) which is deleted.
   */
  @config(secret=true)
  deletedKek: SecretKey
}
