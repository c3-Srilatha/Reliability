/**
 * Cache for various ACL privilege caches
 */
type AclPrivilegesCache mixes Cached {

  /**
   * AclPrivilege entries by type
   */
  aclPrivilegesByType: map<string, [AclPrivilege]>

  /**
   * Acl backward deps grouped by source type.
   */
  aclBwdDepsByType: map<string, [TypeBackwardDep]>

  /**
   * @return the info in the cache.
   */
  info: function(): !AclPrivilegesCache

  /**
   * Gets the AclPrivilege entries for a specified type and types in its base type chain.
   *
   * @param type
   *        Type to get privileges for.
   *
   * @return all privileges for the specified type and any type in its base type chain.
   */
  privileges: function(type: !Type): [AclPrivilege]

  produce:    ~
  produceAll: ~
}
