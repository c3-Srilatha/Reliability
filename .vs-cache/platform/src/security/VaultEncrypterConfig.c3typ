/**
 * Configuration for {@VaultEncrypter}.
 */
@config(minOverride=CLUSTER, authz='cluster-admin', secretAuthz='cluster-admin')
@action(group+='cluster-admin')
private type VaultEncrypterConfig mixes Config, Singleton {

  // NEVER add any secret values to this config as it will cause circular dependency issues!

  /**
   * Type of encryption algorithm used
   */
  CIPHER_ALGORITHM: private const string enum CryptoSecretKeyAlgorithm = AES

  /**
   * Type of cipher transformation used
   */
  CIPHER_TRANSFORMATION: private const string enum CryptoCipherTransformation = AES_GCM_NO_PADDING

  /**
   * The json key path at which to store the MEK
   */
  MEK_JSON_KEY: private const string = "mek"

  /**
   * Denotes C3 Vault is un-encrypted (no key)
   */
  KEY_NOT_SET: private const string = ""

  /**
   * Temporary directory to store files during migration
   */
  MIGRATION_DIR: private const string = "migration/"

  /**
   * Whether C3Vault is enabled and encrypted.
   * Please do NOT set manually. Used internally by {@VaultEncrypter}.
   */
  enabled: private !boolean
}
