/**
 * The private key of an asymmetric key pair.
 */
@action(group+='cluster-admin')
type CryptoPrivateKey mixes CryptoKey {

  @config(secret=true)
  content: ~

  @config(secret=true)
  fileUrl: ~

  @config(secret=true)
  pkcs: ~

  @config(secret=true)
  passphrase: string

  // TODO: placeholder for Config object forId
  forId: function(id: !?string, failIfMissing: boolean): CryptoPrivateKey

  @action(inline=true)
  fromJwk: ~
}
