/**
 * A type which allows application logic to be invoked as part of {@link UserRegistration#start} and {@link UserRegistration#complete}
 */
type AppUserRegistration {

  /**
   * Invoked after {@link UserRegistration} token is created for a new user registration in {@link UserRegistration#start}
   */
  startNewUserRegistration: optional function(userFields: UserFields,
                                              token: string,
                                              optionalAppParams: UserRegistrationOptionalParams)

  /**
   * Invoked after {@link UserRegistration} token is created for a password reset in {@link UserRegistration#start}
   */
  startPasswordReset: optional function(userFields: UserFields,
                                        token: string,
                                        optionalAppParams: UserRegistrationOptionalParams)

  /**
   * Used for validating the email for at the beginning of {@link UserRegistration#start}
   */
  validateEmail: optional function(email: string, actionType: string enum UserRegistrationActionType)

  /**
   * Invoked after {@link UserRegistration} token is created for a new user registration in {@link UserRegistration#start}
   */
  validateNewUserToken: optional function(email: string, token: string)

  /**
   * Invoked after {@link User} is created for a new user registration in {@link UserRegistration#complete}
   */
  completeNewUserRegistration: optional function(user: User, optionalAppParams: UserRegistrationOptionalParams)
}
