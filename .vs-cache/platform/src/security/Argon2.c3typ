/**
 * Argon2 is modern ASIC-resistant, GPU-resistant, memory-hard hashing algorithm.
 *  It has better password cracking resistance than PBKDF2, Bcrypt and Scrypt
 *  and is the winner of the Password Hashing Competition in 2015.
 *  https://en.wikipedia.org/wiki/Argon2
 *  Argon2 RFC: https://datatracker.ietf.org/doc/rfc9106/
 */
type Argon2 mixes Hash {

  /**
   * Hashes the given data using the specified {@link Argon2.HashSpec}.
   *
   * @param data
   *             The data to be hashed.
   *
   * @param spec
   *             {@link Argon2.HashSpec} used to hash the data.
   *
   * @return the hashed content in base64 encoding
   */
  hash: function(data: !string, spec: !Argon2.HashSpec): !string

  /**
   * Verifies the hashed data against the provided hash with the specified {@link Argon2.HashSpec}.
   *
   * @param data
   *             The data to be hashed.
   *
   * @param hash
   *             The hash to compare the data to.
   *
   * @param spec
   *             {@link Argon2.HashSpec} used to hash the data.
   *
   * @return whether the data matches the hashed data
   */
  verify: function(data: !string, hash: !string, spec: !Argon2.HashSpec): boolean
}
