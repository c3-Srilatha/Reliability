/*
 * This type is a cache for the ExprNode that is compiled from the condition of a {@link DataPermission}
 * The key of the cache is a string which represents the {@link Action}, {@link App} the action is being called on,
 * and the {@link User} who called the action.
 */
@cache(maxSize=1000)
@action(group+='cluster-admin')
private type DataPermissionCache mixes Cached, Identifiable {

  compiledExprClass: Expr.Compiled
  produce:           ~
}
