/**
 * Metadata type that represents the unit of access control in the C3 Platform.
 * It follows an env/app fetch hierarchy: env/app -> env/c3 -> c3/c3, i.e. when fetching Role objects in a given
 * env/app, objects from env/app + env/c3 + c3/c3 will be returned.
 *
 * There are a handful of Roles defined as `seed` Roles which are not persisted and can only be accessed through the {@link Role#seed} action
 *
 * @see security-roles-and-permissions.c3doc.md
 */
// TODO: PLAT-87388 Remove user-admin from type level and put on methods
@action(group+='user-admin')
type Role mixes Metadata, AccessControlEntity {

  /**
   * Cluster Admin
   */
  CLUSTER_ADMIN: const string = 'C3.ClusterAdmin'

  /**
   * Environment Admin
   */
  ENV_ADMIN: const string = 'C3.EnvAdmin'

  /**
   * App Admin
   */
  APP_ADMIN: const string = 'C3.AppAdmin'

  /**
   * Operator
   */
  OPERATOR: const string = 'C3.Operator'

  /**
   * User Admin
   */
  USER_ADMIN: const string = 'C3.UserAdmin'

  /**
   * Developer
   */
  DEVELOPER: const string = 'C3.Developer'

  /**
   * Data Integrator
   */
  DATA_INTEGRATOR: const string = 'C3.DataIntegrator'

  /**
   * Data Scientist
   */
  DATA_SCIENTIST: const string = 'C3.DataScientist'

  /**
   * Allows reading all objects with no filter
   */
  READ_ALL: const string = 'C3.ReadAll'

  /**
   * App Role of a member app of an env or cluster.
   */
  MEMBER_APP: const string = 'C3.MemberApp'

  /**
   * Public
   */
  // TODO: PLAT-79733 Combine C3.Public and C3. Anonymous roles in to one single role
  PUBLIC: const string = 'C3.Public'

  /**
   * ArtifactReader
   */
  ARTIFACT_READER: const string = 'C3.ArtifactReader'

  /**
   * Anonymous
   */
  ANONYMOUS: const string = 'C3.Anonymous'

  /**
   * OAuth Client
   */
  OAUTH_CLIENT: const string = 'C3.OAuthClient'

  /**
   * Library Manager
   */
  LIBRARY_MANAGER: const string = 'C3.LibraryManager'

  /**
   * Rules that define the access controls for this Role
   */
  permissions: [Permission]

  /**
   * Condition to be passed to specified actions, aka data access permissions
   */
  dataPermissions: [DataPermission]

  /**
   * The {@link Role}s that are included with this Role.
   * If there are conflicting roles between nestedRoles and roles field, then the role defined in nestedRoles takes priority.
   * Permissions and resources granted to child roles are automatically granted to their parent roles.
   */
  @deprecated(finalVersion="8.4", details="Use #nestedRoles instead")
  roles: [Role]

  /**
   * The ids of the Roles that are included with this Role.
   * If there are conflicting roles between nestedRoles and roles field, then the role defined in nestedRoles takes priority.
   * Permissions and resources granted to child roles are automatically granted to their parent roles.
   */
  nestedRoles: [string]

  /**
   * Human readable description of the Role
   */
  description: string

  /**
   * Get the security level for the Role.
   *
   * Security levels are defined only for Platform Roles {@link SeedRoles.json}.
   * They are used to control access to specific actions for Impersonation.
   * The lower the value, the higher the access.
   *
   * @return the security level or null, if not defined for the Role.
   */
  @action(inline=true)
  securityLevel: inline member function(): int enum SecurityLevel

  /**
   * Get the Role that corresponds to provided action group.
   */
  @action(inline=true)
  forActionGroup: inline member function(actionGroup: !?string serialized Action.Group, failIfInvalid: boolean): Role

  /**
   * Gets all the {@link Role roles} for this role
   *
   * @return array of Role.
   */
  @action(inline=true)
  allRoles: inline member function(): [Role]

  /**
   * Gets all the DataPermissions for this user.
   *
   * @return array of DataPermission.
   */
  @action(inline=true)
  allDataPermissions: inline member function(): [DataPermission]

  /**
   * Gets all the Permissions for this Role.
   *
   * @return array of Permission.
   */
  allPermissions: member function(): [Permission]

  /**
   * @return all UserGroups with this role
   */
  allGroups: member function(): [UserGroup]

  /**
   * @return all Users with this role
   */
  allUsers: member function(): [User]

  dependencies: ~: RoleDeps

  @action(inline=true)
  forId: inline ~

  save:   ~
  remove: ~
}
