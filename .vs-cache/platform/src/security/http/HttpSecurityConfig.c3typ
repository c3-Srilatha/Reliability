/**
 * Configuration options for various security features pertaining to an AppUrl.
 */
@config(minOverride=APP, maxOverride=CLUSTER)
type HttpSecurityConfig mixes Config, Singleton {

  /**
   * Flag to enable csrf token generation and checking
   */
  csrfProtection: boolean

  /**
   * Flag to enable origin checks and disallow origins that
   * are not present in the allowedOrigins field
   */
  originFilter: boolean

  /**
   * If set to true, the Origin/Referer Header check is performed using a hostname match instead of a complete string match.
   */
  originFilterHostnameMatch: boolean

  /**
   * The allowedOrigins are checked against the 'Origin' request header.
   * Or in it's absence, the 'Referer' request header.
   * Note that the entries must be valid and parseable URLs, if originFilterHostnameMatch is set to true.
   */
  allowedOrigins: ![string]

  /**
   * The allowedHeaders are provided in response to the 'Access-Control-Request-Headers' preflight request header.
   * Note that entries must be valid HTTP header names.
   */
  allowedHeaders: [string]

  corsEnabled:               !boolean
  varyHeader:                !string
  xssHeaderEnabled:          !boolean
  xssBlockModeEnabled:       !boolean
  cacheControlHeaderEnabled: !boolean
  cspHeader:                 !string
  xFrameOptionsHeader:       !string
}
