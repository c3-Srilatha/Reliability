/**
 * Metadata type used to define access control for specific resource.
 * Refer to the topic on {@link access-control.c3doc.md Access Control} for usage information.
 */
type DataPermission mixes AccessControl {

  /**
   * Expression to be passed to the action for additional visibility filtering
   */
  condition: string

  /**
   * To see if the dataPermission could be applied to the action (i.e. method) in a type
   *
   * @param typeName
   *            type name the action belongs to.
   * @param action
   *            name of the action (or method).
   * @return data permission expression id applicable, otherwise null
   */
  conditionFor: inline member function(typeName: !string, action: !string): string
}
