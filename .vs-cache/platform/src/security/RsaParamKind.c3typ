/**
 * This type represents the different parameters of an RSA key.
 * More info on the RSA algorithm can be found at {@link https://datatracker.ietf.org/doc/html/rfc8017}
 */
enum type RsaParamKind {

  MODULUS = 'n'

  PUBLIC_EXPONENT = 'e'

  PRIVATE_EXPONENT = 'd'

  PRIME_P = 'p'

  PRIME_Q = 'q'

  PRIME_EXPONENT_Q = 'dq'

  PRIME_EXPONENT_P = 'dp'

  CRT_COEFFICIENT = 'qi'
}
