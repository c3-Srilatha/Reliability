type Password {

  /**
   * The minimum length of the password.
   */
  minLen: int = 16

  /**
   * The maximum length of the password.
   */
  maxLen: int = 32

  /**
   * Count of digits in the password
   */
  digitCount: int = 5

  /**
   * Count of special characters ("!@#$%^&*_=+-/") in the password
   */
  specialCharacterCount: int = 2

  /**
   * Count of upper-case character in the password
   */
  uppercaseCharacterCount: int = 5

  /**
   * generate a random password that satisfies the requirements on minLen, maxLen, digitCount, specialCharacterCount,
   * and uppercaseCharacterCount. If the password_len > digitCount + specialCharacterCount
   */
  generate: member function(): !string
}
