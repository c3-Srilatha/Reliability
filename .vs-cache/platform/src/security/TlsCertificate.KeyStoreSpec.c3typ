/**
 * Spec used to generate encrypted keystore files
 */
type TlsCertificate.KeyStoreSpec mixes TlsCertificateFields {

  /**
   * The alias to use for the keystore. By default, this will use the keystore type.
   */
  alias: string

  /**
   * The X.509 public certificate chain that corresponds to the private key.
   */
  clientCertificates: [!binary]

  /**
   * The trusted X.509 root CA certificates. You will need to download this from your host provider.
   */
  caCertificates: [!binary]

  /**
   * The PKCS1 or PKCS8 private key. This is required when sslMode = VERIFY_FULL
   */
  privateKey: binary

  /**
   * The private key password, if encrypted
   */
  privateKeyPassword: string
}
