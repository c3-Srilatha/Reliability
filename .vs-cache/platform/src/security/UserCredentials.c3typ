/**
 * Specifies primary authentication and recovery credentials for a user. Currently only used for Okta Users.
 */
type UserCredentials {

  /**
   * Password to be used for authentication against the identity provider. Must follow the policy defined by the IdP.
   */
  password: string

  /**
   * This object contains a question and answer used by the identity provider to recover a lost password
   */
  recoveryQuestion: UserRecoveryQuestion
}
