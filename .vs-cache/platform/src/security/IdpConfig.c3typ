@action(group+='app-admin')
@cache(cacheNulls=true)
@config(doNotDefaultIfMissing=true)
abstract type IdpConfig mixes Config, Identified {

  /**
   * Returns the name of the {@link IdentityProvider} associated with this IdpConfig.
   */
  idp: member function(): Type

  /**
   * If present, the user will be redirected to this url instead of the idp login page.
   */
  defaultContentUrl: string serialized Url

  /**
   * Which field of the IdpUser to use as the user id
   */
  userIdFormat: string enum IdpUserIdFormatKind

  /**
   * The default group to assign to users upon successful authentication.
   * Security leveled groups are not permitted.
   */
  defaultGroupId: string

  toString: ~ java

  /**
   * Returns whether we should write back to the Idp
   */
  idpWriteback: boolean = false

  /**
   * Returns whether we should write back {@link UserGroup} updates to the Idp
   */
  idpGroupWriteback: boolean = false

  /**
   * Returns the identity provider for write-back (if enabled)
   */
  idpType: string enum IdpVendor

  /**
   * The external authentication application ID that this IdpConfig is associated with.
   * This is used to identify the application in the IdP ex: okta app id.
   */
  externalAppId: string

  /**
   * List of allowed email domains that users can have to be able to login.
   * The email domain is everything after the '@' in the email address.
   * If empty, then no email domain validation is done on user login.
   */
  allowedEmailDomains: [string]

  /**
   * Applications that are trusted to redirect authenticated user(s)
   */
  trustedApplicationHosts: [string]

  /**
   * Checks if provided email is allowed to login based on the allowed email domains.
   * @param email
   *        email address to check
   * @return throws error if email domain is not part of the allowed email domains
   */
  validateIsEmailAllowed: member function(email: !string)

  /**
   * List of relevant groups for the cluster from the IDP. If empty, then no group filtering is done on user login.
   */
  relevantGroups: [string]

  /**
   * Adds a group to the list of relevant groups from the IDP.
   */
  addRelevantGroup: member function(groupId: !string)

  /**
   * Removes the group from the list of relevant groups from the IDP.
   */
  removeRelevantGroup: member function(groupId: !string)

  /**
   * Returns a list of valid idp groups that the user is a member of, filtered by the relevantGroups, and current App allowed groups
   * @param idpAssignedGroups
   *        list of groups assigned to the user by the IDP
   * @return the idpAssignedGroups, and the mapped usergroups
   */
  validIdpGroups: member function(idpAssignedGroups: [string]): Pair<[UserGroup], [string]>
}
