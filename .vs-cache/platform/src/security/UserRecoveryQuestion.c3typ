/**
 * Specifies a secret question and answer that is validated when a user forgets their password or unlocks their account
 * Currently only used for Okta users.
 */
type UserRecoveryQuestion {

  /**
   * Security question.
   */
  question: string

  /**
   * Answer to the security question.
   */
  answer: string
}
