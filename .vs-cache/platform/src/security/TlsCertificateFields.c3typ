/**
 * Shared fields of TlsCertificate to support TLS authentication for services
 */
type TlsCertificateFields {

  /**
   * TLS truststore type ex: JKS, PKCS12
   */
  trustStoreType: KeystoreKind

  /**
   * TLS keystore type ex: JKS, PKCS12
   */
  keyStoreType: KeystoreKind

  /**
   * A single string formatted as a comma-separated list of accepted https protocols, ie: "TLSv1.2,TLSv1.3"
   */
  httpsProtocols: string

  /**
   * Controls the level of security and verification applied when establishing an SSL connection.
   */
  sslMode: string enum TlsConnectionModeKind = VERIFY_CA
}
