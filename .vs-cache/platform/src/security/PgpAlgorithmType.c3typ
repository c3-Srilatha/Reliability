/**
 * Enum type for PGP encryption algorithms
 */
enum type PgpAlgorithmType {

  IDEA
  TRIPLE_DES
  CAST5
  BLOWFISH
  DES
  AES_128
  AES_192
  AES_256
  TWOFISH
  CAMELLIA_128
  CAMELLIA_192
  CAMELLIA_256
}
