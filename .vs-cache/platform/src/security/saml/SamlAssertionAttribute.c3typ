/**
 * This type is used to store SAML assertion attribute info to the platform extension for SSO
 */
type SamlAssertionAttribute {

  /**
   * Attribute Name
   * This is a mandatory field.
   */
  name: !string

  /**
   * List of SAML assertion attribute values for the attribute
   */
  values: [SamlAssertionAttributeValue]
}
