/**
 * This type is used to store SAML assertion attribute values to the SamlSignOn
 * processing for SSO
 */
type SamlAssertionAttributeValue {

  xsType:    private string
  separator: private string
  raw:       private any

  /**
   * {@link SamlAssertionAttributeValueType} for this SamlAssertionAttributeValue. Used to decide which of the value
   * fields to get.
   */
  valType: string enum SamlAssertionAttributeValueType

  /**
   * If {@link SamlAssertionAttributeValueType}SamlAssertionAttributeValueType.valType equals
   * SamlAssertionAttributeValueType.STRING, this field will return the String value.
   */
  strVal: inline member function(failIfInvalid: boolean): string

  /**
   * If {@link SamlAssertionAttributeValueType}SamlAssertionAttributeValueType.valType equals
   * SamlAssertionAttributeValueType.INTEGER, this field will return the Integer value.
   */
  intVal: inline member function(failIfInvalid: boolean): int

  /**
   * If {@link SamlAssertionAttributeValueType}SamlAssertionAttributeValueType.valType equals
   * SamlAssertionAttributeValueType.DATETIME, this field will return the DateTime value.
   */
  dtVal: inline member function(failIfInvalid: boolean): datetime

  /**
   * To assess the XS Type of the SAML Attribute value and parse it to the respective C3 value type.
   * If a type is an XS String and a separator is defined, a list of values is returned after performing a split using
   * the separator. If value is of unknown C3 value type will return `null` or error based on failIfInvalid.
   */
  value: inline member function(failIfInvalid: boolean): any
}
