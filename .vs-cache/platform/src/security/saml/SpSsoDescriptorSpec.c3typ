/**
 * This type used to describes the Assertion Consumer Service at the service provider
 */
type SpSsoDescriptorSpec mixes Spec {

  /**
   * The url of assertion consumer service to be hit when redirected from Idp
   */
  acsUrl: !string

  /**
   * If expect the assertion from Idp to be encrypted with Sp's public key.
   */
  wantAssertionsEncrypted: boolean = false

  /**
   * The id of {@link X509Certificate x509Certificate} that this sp wants to share to an Idp.
   */
  certificateId: string
}
