/**
 * This type is used to pass SAML assertion data to the platform extension for SSO
 * Each field of this type will map to a field on {@link User}.
 */
type SamlAssertionData {

  // Maps to {@link User#id}, {@link User#idpUserId}, {@link User#name}.
  nameId: !string

  // Maps to {@link User#idpGroups}.
  groups: set<string>

  // Maps to {@link User#email}.
  email: string

  // Maps to {@link User#idpAssignedGroups}.
  roles: set<string>

  // Maps to {@link User#firstName}.
  firstName: string

  // Maps to {@link User#lastName}.
  lastName: string

  // Map of additional {@link User} field names to object data. See {@link SamlAssertionAttributeKeys#customMappings}.
  customMappings: map<string, any>
}
