@config(maxOverride=CLUSTER, minOverride=APP, secretAuthz='cluster-admin')
@action(group+='app-admin')
type SamlIdpConfig mixes IdpConfig, Identified {

  id: ~
  requestUri: string
  sp:         SamlServiceProvider
  ssoUrl:     string
  sloUrl:     string
  logOutUrl:  string
  issuer:     string
  cert:       string
  certFormat: string
  settings:   SamlSettings

  emailSuffix:    string

  /**
   * c3auth token expiration in minutes
   */
  c3AuthValidMinutes: int

  /**
   * The {@link CryptoPrivateKey CryptoPrivateKey} used for decrypting incoming Saml encrypted assertion.
   */
  cryptoPrivateKey: string

  // The relaying party public key used for configuring the authn request
  relayingPublicKey: string

  // The relaying party private key used for configuring the authn request
  relayingPrivateKey: string

  userIdFormat: ~ = IDP_ID
}
