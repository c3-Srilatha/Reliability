/**
 * SamlServiceProvider stands for the service provider, which is one of the two entities that communicates to each other
 * for authentication and authorization (the other entity is {@link Idp IdentityProvider}) in SAML flow. The service provider
 * here trusts the identity provider to authenticate users.
 */
type SamlServiceProvider {

  entityId: string

  /**
   * The assertion consume service end point.
   */
  acsUrl: string
}
