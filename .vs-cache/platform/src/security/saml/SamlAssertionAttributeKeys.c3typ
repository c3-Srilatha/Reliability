/**
 * This type is used to store SAML assertion attribute key field names that are used to create {@link SamlAssertionData}
 */
type SamlAssertionAttributeKeys {

  groups:    string = "groups"
  email:     string = "email"
  roles:     string = "roles"
  firstName: string = "firstName"
  lastName:  string = "lastName"

  /*
   * Custom mapping that can be provided on the {@link SamlIdpConfig} for mapping SAML assertion attributes to platform
   * {@link User} type fields. See {@link SamlAssertionData#customMappings}.
   */
  customMappings: map<string, string>
}
