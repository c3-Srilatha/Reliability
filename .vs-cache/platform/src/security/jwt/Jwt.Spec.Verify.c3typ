/**
 * The specification for verifying a JWT token.
 */
type Jwt.Spec.Verify mixes Jwt.Spec {

  /**
   * JWT Encoded token to de verified
   */
  token: !string

  /**
   * String Enum {@link OidcCertKind} that specifies the kind of certificate stored.
   * If null, indicates that a raw public key has been stored.
   */
  oidcCertKind: string
}
