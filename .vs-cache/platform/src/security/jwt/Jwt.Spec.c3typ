// The outer c3type for defining the specifications of signing and verifying JWT tokens
type Jwt.Spec {

  /**
   * key (Base64 Encoded) used to verify the token
   */
  key: !string

  /**
   * Algorithm used to sign the token. see {@link JwsAlgorithmKind}
   */
  algKind: !string enum JwsAlgorithmKind

  /**
   * The key id used to identify the key used to sign the token. This is used to verify the token.
   */
  keyId: string
}
