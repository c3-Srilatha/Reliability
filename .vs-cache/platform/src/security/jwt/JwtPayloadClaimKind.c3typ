/**
 * JWT payload claims
 */
enum type JwtPayloadClaimKind {

  Audience = "aud"

  AuthorizedParty = "azp"

  Issuer = "iss"

  IssuedAt = "iat"

  IdentityProvider = "idp"

  NotBefore = "nbf"

  ExpirationTime = "exp"

  CodeHash = "c_hash"

  AccessTokenHash = "at_hash"

  PreferredUserName = "preferred_username"

  Email = "email"

  Name = "name"

  FirstName = "given_name"

  LastName = "family_name"

  Nonce = "nonce"

  ObjectId = "oid"

  Roles = "roles"

  Groups = "groups"

  Principal = "sub"

  TenantId = "tid"

  UniqueName = "unique_name"

  Version = "ver"

  HasGroups = "hasGroups"

  RelyingPartyState = "state"

  EncryptedCodeVerifier = "enc_code_verifier"
}
