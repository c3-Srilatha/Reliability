/**
 * This type maps Okta user information into a type used by UserAdmin.getOktaUserInfo()
 */
type OktaUserInfo {

  /**
   * status can be one of STAGED, PROVISIONED, ACTIVE, PASSWORD_EXPIRED, LOCKED_OUT, RECOVERY, SUSPENDED, DEPROVISIONED
   */
  status: string

  login:           string
  email:           string
  firstName:       string
  lastName:        string
  created:         datetime
  activated:       datetime
  statusChanged:   datetime
  lastLogin:       datetime
  lastUpdated:     datetime
  passwordChanged: datetime
}
