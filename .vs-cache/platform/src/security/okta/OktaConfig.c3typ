@action(group+='cluster-admin')
@config(maxOverride=CLUSTER, minOverride=CLUSTER)
type OktaConfig mixes Config, Singleton {

  /**
   * Url to external Okta IDP
   */
  url: string

  /**
   * Token to authenticate against Okta endpoint
   */
  @config(secret=true)
  authToken: string

  /**
   * Helper action to set okta url
   */
  setUrl: function(url: !string)

  /**
   * Helper action to set okta api token
   */
  setToken: function(token: !string)

  /**
   * Force enable okta
   */
  forceEnable: boolean
}
