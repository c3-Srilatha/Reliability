/**
 * This type implements higher level APIs for changes reflected in both Okta and C3.
 * Used to interface with {@link OktaRestApi}.
 */
@action(group+='user-admin')
type Okta mixes Configurable<OktaConfig>, Singleton {

  /**
   * Returns the OktaUserInfo object for the given user.
   * @param oktaUserIdOrEmail
   *          The email or okta ID of the user. Email is case insensitive.
   * @return
   *          Corresponding OktaUserInfo
   */
  getUserInfo: function(oktaUserIdOrEmail: !string): OktaUserInfo

  /**
   * Removes the given user in both C3 and Okta.
   * @param userId
   *          The ID of the user in {@link User#id}
   * @param waitForUpdate
   *          Whether to wait for the changes to be reflected on the Okta's servers
   */
  removeUser: function(userId: !string, waitForUpdate: boolean)

  /**
   * Create the given user.
   * If the User already exists in Okta, it will link it to the C3 User, preserving its existing credentials.
   * The email will converted to lowercase for both Okta & C3. This requires using the lowercase email for
   * methods that take in {@link User#id}.
   * @param user
   *         UserFields object containing the user information to be created (email, name, etc)
   * @param password
   *         Sets the password if provided
   * @param activate
   *         Activates the user if true
   * @param waitForUpdate
   *         Whether to wait for the changes to be reflected on the Okta's servers
   * @param doNotFailIfExists
   *         Does not fail the call if either the Okta user or C3 User already exists
   * @param addToOktaApp
   *         Adds the user to the Okta app upon creation if true.
   */
  createUser: function(user: !UserFields,
                       password: string,
                       activate: boolean,
                       waitForUpdate: boolean,
                       doNotFailIfExists: boolean,
                       addToOktaApp: boolean)

  /**
   * Create group with given name
   * @param groupName
   *          Name of the group to be created
   * @param prefixAppId
   *          Prepend the C3.AppId to the groupId when creating the group
   * @param waitForUpdate
   *          Whether to wait for the changes to be reflected on the Okta's servers
   */
  createGroup: function(groupName: !string, prefixCurrentAppId: boolean, waitForUpdate: boolean): string

  /**
   * Remove group with given name
   * @param groupName
   *          Name of the group to be removed
   * @param waitForUpdate
   *          Whether to wait for the changes to be reflected on the Okta's servers
   */
  removeGroup: function(groupName: !string, waitForUpdate: boolean)

  /**
   * Remove all groups that are prefixed with the given appId
   * @param appId
   *          Id of the app
   * @param waitForUpdate
   *          Whether to wait for the changes to be reflected on the Okta's servers
   */
  removeAllGroupsInApp: function(appId: !string, waitForUpdate: boolean): BatchError

  /**
   * Add group to given okta app. If the group and/or app does not exist in Okta then this will fail.
   * @param groupName
   *          Id of the group the user will be added to
   * @param oktaAppName
   *          Label name of the Okta App
   * @param prefixAppId
   *          Prepend the C3.AppId to the groupId when obtaining the group
   */
  addOktaGroupToApp: function(groupName: !string,
                              oktaAppName: !string,
                              prefixCurrentAppId: boolean,
                              waitForUpdate: boolean): string

  /**
   * Add user to given okta app. If the user and/or app does not exist in Okta then this will fail.
   * @param userId
   *          The ID of the user in {@link User#id}
   * @param oktaAppName
   *          Label name of the Okta App
   * @param waitForUpdate
   *          Whether to wait for the changes to be reflected on the Okta's servers
   */
  addUserToApp: function(userId: !string, oktaAppName: !string, waitForUpdate: boolean): string

  /**
   * Add user to given group. If the given group does not exist in okta, one will be created before
   * adding the user. The user will also be added to the corresponding group through idpAssignedGroups
   * @param userId
   *          The ID of the user in {@link User#id}
   * @param groupName
   *          Name of the okta group the user will be added to
   * @param prefixAppId
   *          Prepend the C3.AppId to the groupId when adding the user to the group
   * @param waitForUpdate
   *          Whether to wait for the changes to be reflected on the Okta's servers
   */
  addUserToGroup: function(userId: !string,
                           groupName: !string,
                           prefixCurrentAppId: boolean,
                           waitForUpdate: boolean): string

  /**
   * Remove user from given group. Fails if the given group does not exist
   * @param userId
   *          The ID of the user in {@link User#id}
   * @param groupName
   *          Name of the group the user will be removed from
   * @param prefixAppId
   *          Prepend the C3.AppId to the groupId when removing the user from the group
   * @param waitForUpdate
   *          Whether to wait for the changes to be reflected on the Okta's servers
   */
  removeUserFromGroup: function(userId: !string,
                                groupName: !string,
                                prefixCurrentAppId: boolean,
                                waitForUpdate: boolean): string

  /**
   * Remove user from given app (that is managed by C3) by removing the user from the relevant idpAssigned groups and removing the user from the C3 managed app.
   * @param userId
   *          The ID of the user in {@link User#id}
   */
  removeUserFromCurrentC3App: function(userId: !string)

  /**
   * Sets the password for the given user.
   * @param userId
   *          The ID of the user in {@link User#id}
   * @param newPassword
   *          New password
   */
  @action(group+='cluster-admin')
  setPassword: function(userId: !string, newPassword: !string)

  /**
   * Returns the OktaUser object for the given user.
   * @param oktaUserIdOrEmail
   *          The email or okta ID of the user. Email is case insensitive.
   * @return
   *          Corresponding OktaUser
   */
  getOktaUser: function(oktaUserIdOrEmail: !string, failIfMissing: boolean): OktaUser

  /**
   * Returns the OktaGroup object for the given group
   * @param groupName
   *          Name of the group
   * @return
   *          Corresponding OktaGroup
   */
  getOktaGroup: function(groupName: !string, failIfMissing: boolean): OktaGroup
}
