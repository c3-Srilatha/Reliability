/**
 * Okta supports several types of groups that constrain how the group’s profile and memberships are managed.
 */
enum type OktaGroupType {

  /**
   * Group profile and memberships are managed by Okta and cannot be modified.
   */
  BUILT_IN

  /**
   * Group profile and memberships are imported and must be managed within the application that imported the group
   * (Active Directory and LDAP groups will also have APP_GROUP type).
   */
  APP_GROUP

  /**
   * Group profile and memberships are directly managed in Okta via static assignments or indirectly via group rules
   * (This is the type off all the groups created through the C3 platform).
   */
  OKTA_GROUP
}
