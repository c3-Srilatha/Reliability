/**
 * The status of a Okta user state changes in response to explicit events, such as admin-driven lifecycle changes,
 * user login, or self-service password recovery. Click {@link okta-user-state.c3doc here} for the Okta User State
 * diagram.
 */
enum type OktaUserStatus {

  /**
   * User created
   */
  STAGED

  /**
   * From STAGED via "User reset password" email and Welcome Wizard"
   */
  PROVISIONED

  /**
   * From:
   * * PROVISIONED via password set link or welcome wizard
   * * SUSPENDED via unsuspend
   * * RECOVERY -> via password set
   * * LOCKED_OUT via unlock
   * * PASSWORD_EXPIRED via set new password
   */
  ACTIVE

  /**
   * From ACTIVE via reset password
   */
  RECOVERY

  /**
   * From ACTIVE via suspend
   */
  SUSPENDED

  /**
   * From ACTIVE via exceeded password policy or manually expired
   */
  PASSWORD_EXPIRED

  /**
   * From ACTIVE via exceeded password policy
   */
  LOCKED_OUT

  /**
   * From ACTIVE, SUSPENDED, RECOVERY, PASSWORD_EXPIRED or LOCKED_OUT via deactivate
   */
  DEPROVISIONED
}
