/**
 * C3 type mapping to Okta SAML 2.0 Application settings object
 */
type OktaSignOnSettings {

  ssoAcsUrl:             !string
  audience:              !string
  recipient:             !string
  destination:           !string
  signatureAlgorithm:    !string
  digestAlgorithm:       !string
  assertionSigned:       !boolean = false
  responseSigned:        !boolean = false
  subjectNameIdFormat:   !string
  attributeStatements:   [OktaSamlAttributeStatement]
  defaultRelayState:     string
  idpIssuer:             string
  subjectNameIdTemplate: string
  honorForceAuthn:       boolean
  authnContextClassRef:  string
  spIssuer:              string
  requestCompressed:     boolean
}
