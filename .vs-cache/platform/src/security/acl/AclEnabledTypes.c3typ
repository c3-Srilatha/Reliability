/**
 * Represents a cache of the Types that currently have ACLs enabled.  This is a singleton cache (e.g. there is only one
 * entry containing the list of enabled Types. See also:
 * @see AclEnabled
 * @see AclPrivilege
 * @see AclEntry
 * @see EnableAclPrivilege
 */
@cache(dependencies=['EnableAclPrivilege'])
type AclEnabledTypes mixes Cached {

  /**
   * Types that currently have acl enforced.
   */
  enabledTypes: [string]

  /**
   * Determines if a type currently has acl enforced on it.
   */
  isEnabled: inline function(type: !Type): boolean

  produce:    ~
  produceAll: ~
}
