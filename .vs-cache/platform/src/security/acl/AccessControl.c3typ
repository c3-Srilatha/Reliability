/**
 * Base Type used to define access control for specific resource
 * @see access-control.c3doc.md
 */
abstract private type AccessControl mixes StringSerializable {

  /**
   * Type name.
   * If not specified, when authorization check, this access control instance will be applied to all types.
   */
  typeName: string

  /**
   * If true, this access control will be applied to all inner types of #typeName.
   */
  innerTypes: boolean

  /**
   * Action name.
   * If not specified, when authorization check, this access control instance will be applied to all actions of a type.
   */
  action: string

  /**
   * Action group name.
   */
  actionGroup: string

  /**
   * To check if the access control could be applied to a method (or action) in a type.
   *
   * @param action
   *        type#action
   *
   * @return true if applicable.
   */
  isApplicable: cached inline member function(action: !string): boolean

  /**
   * Gets all the {@link Roles} that have this access control.
   *
   * @return An arry of {@link Roles}}.
   */
  allRoles: inline member function(): stream<Role>
}
