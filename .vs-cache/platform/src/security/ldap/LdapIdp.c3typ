/**
 * This type implements the authentication request and login and logout redirect endpoints for LDAP
 * authentication flow.
 */
type LdapIdp mixes IdentityProvider<LdapIdp.Config> {

  /**
   * All the groups found for the user on the ldap server
   * @param userId - id of user whose groups will be found
   * @param configId - {@link LdapIdp.Config} id for server information
   * @return list of Ldap group ids
   */
  groupIds: private function(userId: !string, userPath: !string, configId: !string): [string]

  /**
   * Clears ldap server connections and trustStore associated with the specified {@link LdapIdp.Config} id.
   */
  resetConnectionPool: function(configId: !string)
}
