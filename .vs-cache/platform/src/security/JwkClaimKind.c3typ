/**
 * This type represents the different kinds of claims that can be found in a JWK (JSON Web Key).
 * More information can be found at {@link https://datatracker.ietf.org/doc/html/rfc7517}
 */
enum type JwkClaimKind {

  KEY_TYPE = 'kty'

  ALGORITHM = 'alg'

  KEY_ID = 'kid'

  USE = 'use'

  KEY_OPERATION = 'key_ops'
}
