/**
 * Use to enable or disable ACLs for Types that mix in {@link AclEnabled}. See also:
 * @see AclPrivilege
 * @see AclEnabled
 * @see AclEntry
 * @see AclEnabledTypes
 */
@db(archive=true, versionHistory=true)
entity type EnableAclPrivilege mixes PrivilegeBase<EnableAclPrivilege> schema name 'ADMIN_ENBLACLP' {

  /**
   * If true, then acl authorization will be enforced for the type and acls will be automatically populated/maintained
   * via {@link AclPrivilege} entries.  If false, acl authorization will not be enforced and acl entries will not
   * be automatically refreshed.
   */
  enabled: boolean = true
}
