/**
 * The top-level interface for all crypto keys.
 */
abstract type CryptoKey mixes Config, Identifiable {

  /**
   * A cached instance of native java Key class.
   */
  key: private @java(class="java.security.Key") native

  /**
   * The {@link CryptoKeyAlgorithm algorithm} of the key.
   */
  algorithm: !string enum CryptoKeyAlgorithm

  /**
   * Supported {@link PublicKeyCryptographyStandards pubic key cryptography standard} of the key.
   * Now {@link CryptoPrivateKey CryptoPrivateKey} supports both PKCS1 and PKCS8 standards while
   * {@link CryptoPublicKey CryptoPublicKey} only support PKCS8
   */
  pkcs: !string enum PublicKeyCryptographyStandards = PKCS8

  /**
   * The algorithm used to verify jwt tokens using the key pair.
   */
  jwtAlgorithm: string enum JwsAlgorithmKind = RSA512

  /**
   * The string representation of the key in PEM extension. The key could either be constructed with this content field
   * populated or sourcing from the specified the {@link fileUrl} pointing to the key file in PEM extension.
   */
  content: string

  /**
   * The url of the file storing the key in PEM extension on a Cloud FileSystem (ex: {@link S3 Se} or
   * {@link AzureFileSystem AzureFileSystem}). The url should contains scheme (i.e. file-system) and fully qualified encoded path.
   */
  fileUrl: string

  /**
   * The {@link CryptoSignatureAlgorithm} the keys will be used for.
   * This is for use with the java.security.signature library
   */
  signAlgorithm: string enum CryptoSignatureAlgorithm = SHA512_WITH_RSA

  /**
   * Key size in bits, what this represents depends on the public key crypto scheme used.
   * For example, for RSA, this is the bit-length of the modulus.
   */
  keyLength: int32 = 2048

  /**
   * Number of days the keys are valid since the key was generated
   */
  daysValid: int32 = 180

  /**
   * Time the keys expire
   */
  expiration: datetime

  /**
   * Return an instance of native java Key class.
   */
  nativeKey: private abstract inline member function(): @java(class="java.security.Key") native

  validate: private abstract inline member function(): !mixing CryptoKey

  /**
   * Creates a new CryptoKey object from a JWK (JSON Web Key) string. The id of the CryptoKey is set to the value of
   * the "kid" (key ID) field in the JWK.
   * The JWK must be a valid JSON string with the required fields for the desired key.
   * Currently only RSA keys are supported.
   * @param jwk
   *    A string representing the JWK (JSON Web Key) of the public key.
   * @param failIfInvalid
   *    If true, the function will throw an error if the JWK is invalid or cannot be parsed. Else, it will return null.
   * @return
   *    A CryptoKey object representing the jwk.
   */
  fromJwk: private abstract inline function(jwk: !string, failIfInvalid: boolean): !mixing CryptoKey
}
