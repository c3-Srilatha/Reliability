/**
 * Base type for single-user entities, for example {@link Engine.Deprecated engines} or {@link ExternalService external services}
 * that serve just a single user.
 * This means that there will be a separate instance for each user.
 *
 * @see ExternalService
 */
type SingleUser {

  /**
   * User the instance is associated with.
   */
  user: !string
}
