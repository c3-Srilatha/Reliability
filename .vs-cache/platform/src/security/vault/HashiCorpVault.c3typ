/**
 * HashiCorp Vault.
 */
private type HashiCorpVault mixes ExternalVault {

  /**
   * Default version of the Key/Value (KV) Secrets Engine in HashiCorp Vault. Determines the API features available.
   */
  defaultKvEngineVersion: private const int32 = 2

  k8sSecretAuthName: private const string = 'hashicorp-vault-auth'

  k8sSecretAuthKey: private const string = 'authPayload'

  /**
   * The maximum number of retries to attempt when making requests to the HashiCorp Vault server.
   */
  retries: private const int32 = 3

  get:    ~
  put:    ~
  delete: ~

  /**
   * Write custom metadata to a path in the HashiCorp Vault.
   */
  putCustomMetadata: member function(path: !string, metadata: map<string, string>)

  /**
   * Read custom metadata from a path in the HashiCorp Vault.
   */
  getCustomMetadata: member function(path: !string): string

  /**
   * Gets the authentication secret for the HashiCorp Vault.
   */
  @action(authz='always', group='cluster-admin')
  getSecretAuth: private cached function(authKind: string): string

  /**
   * Migrate config and secrets from {@link BootConfigInfo.migrateSourceRoot} to {@link BootConfigInfo.root}.
   */
  @action(authz='always', group='cluster-admin')
  migrate: private function()
}
