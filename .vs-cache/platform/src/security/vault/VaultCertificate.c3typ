/**
 * This type represents the Vault Store Data
 */
@db(archive=true, versionHistory=true)
@facade(tag='c3')
entity type VaultCertificate schema name 'ADMIN_VLTCTF' {

  /**
   * the name of a certificate
   */
  name: string

  /**
   * the certificate can be of any C3 type. An example used here is the AwsIotCertificate
   */
  certificate: Obj
}
