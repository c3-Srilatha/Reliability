/**
 * Abstract base type for external Vaults.
 */
abstract private type ExternalVault mixes ConfigStore, DefaultInstance<ExternalVault> {

  /**
   * Whether external Vault is enabled.
   */
  enabled: inline function(): boolean

  /**
   * Gets the value from Vault.
   */
  @action(group+='read')
  get: abstract member function(key: !?string): string

  /**
   * Puts the data into Vault.
   */
  @action(group+='write')
  put: abstract member function(key: !?string, data: !string)

  /**
   * Removes the data at specific path from Vault.
   */
  @action(group+='write')
  delete: abstract member function(key: !?string)

  /**
   * Lists the files on a path in Vault.
   */
  @action(group+='read')
  list: abstract member function(key: !?string): [ExternalVaultFileValue]

  loadConfigAndSecret:  ~
  loadConfig:           ~
  loadSecret:           ~
  loadFromOverride:     ~
  setConfigValue:       ~
  setConfig:            ~
  clearConfig:          ~
  configAndSecretFiles: ~
  inst:                 ~
}
