/**
 * Type used to access fields in {@link TlsCertificate}.
 */
enum type TlsStoreInfoKind {

  /**
   * TLS truststore path.
   */
  TRUST_STORE_PATH = 'trustStorePath'

  /**
   * Password for the truststore.
   */
  TRUST_STORE_PASSWORD = 'trustStorePassword'

  /**
   * Type for the truststore.
   */
  TRUST_STORE_TYPE = 'trustStoreType'

  /**
   * TLS keystore path.
   */
  KEY_STORE_PATH = 'keyStorePath'

  /**
   * Password for the keystore.
   */
  KEY_STORE_PASSWORD = 'keyStorePassword'

  /**
   * Type for the keystore.
   */
  KEY_STORE_TYPE = 'keyStoreType'

  /**
   * TLS
   */
  TLS = 'TLS'

  /**
   * DEFAULT NAME
   */
  DEFAULT_SSLFACTORY = 'DEFAULT'
}
