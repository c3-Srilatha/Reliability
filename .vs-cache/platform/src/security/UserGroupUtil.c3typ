@action(group+='user-admin')
type UserGroupUtil {

  /**
   * Helper for UserGroup#fetch that will obtain all implicit {@link UserGroup}s not upserted as well
   * @param spec/filter
   *            Specification or filter to use for fetching {@link Role} that is associated to the {@link UserGroup}
   * @return All UserGroups that match the spec/filter
   */
  fetchUserGroups: function(spec: FetchSpec): !FetchResult<UserGroup>

  fetchUserGroups: function(filter: !Filter): !FetchResult<UserGroup>

  /**
   * Helper for UserGroup#get that will obtain a specific {@link UserGroup}
   * @param id
   *            id for the {@link UserGroup} that should be obtained
   * @param failIfMissing
   *            if true, will throw an error if the corresponding {@link Role} is not found for the UserGroup
   * @return UserGroup that matches the id
   */
  fetchUserGroup: function(id: !?string, failIfMissing: boolean): UserGroup
}
