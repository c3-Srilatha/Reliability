/**
 * Base type to support TLS authentication for services
 */
type TlsCertificate mixes ConfigChild, TlsCertificateFields {

  /**
   * TLS truststore path.
   */
  trustStorePath: string

  /**
   * Password for the truststore.
   */
  @config(secret=true)
  trustStorePassword: string

  /**
   * TLS keystore path.
   */
  keyStorePath: string

  /**
   * Password for the keystore.
   */
  @config(secret=true)
  keyStorePassword: string

  /**
   * The binary content of the keystore in memory
   */
  @config(secret=true)
  keystore: binary

  /**
   * The binary content of the truststore in memory
   */
  @config(secret=true)
  truststore: binary

  /**
   * Create a TlsCertificate with an encrypted java keystore file in memory
   */
  createTls: function(spec: !TlsCertificate.KeyStoreSpec): TlsCertificate
}
