/**
 * Shared fields for PrivateKeyAuth to support key-pair authentication for any connector
 */
type PrivateKeyAuthFields {

  /**
   * The private key content in PEM format
   */
  @config(secret=true)
  privateKeyPem: string

  /**
   * The passphrase for the private key if encrypted
   */
  @config(secret=true)
  privateKeyPassphrase: string

  /**
   * The PKCS format of the private key (PKCS1 or PKCS8)
   */
  pkcsFormat: string enum PublicKeyCryptographyStandards = PKCS8

  /**
   * The algorithm of the private key (RSA, DSA, EC)
   */
  algorithm: string enum CryptoKeyAlgorithm = RSA
}
