/**
 * Generic type to support key-pair authentication for any connector using private keys
 */
// TODO: PLAT-131632: Refactor CryptoPrivateKey and merge PrivateKeyAuth into CryptoKey hierarchy
type PrivateKeyAuth mixes ConfigChild, PrivateKeyAuthFields {

  /**
   * Create a PrivateKeyAuth from PEM content
   */
  createFromPem: function(privateKeyPem: !string,
                          privateKeyPassphrase: string,
                          pkcsFormat: !string enum PublicKeyCryptographyStandards,
                          algorithm: string enum CryptoKeyAlgorithm = RSA): PrivateKeyAuth

  /**
   * Create a PrivateKeyAuth from a file path
   */
  createFromFile: function(filePath: !string,
                           privateKeyPassphrase: string,
                           pkcsFormat: !string enum PublicKeyCryptographyStandards,
                           algorithm: string enum CryptoKeyAlgorithm = RSA): PrivateKeyAuth

  /**
   * Get the private key as Java PrivateKey object
   */
  nativePrivateKey: member function(): @java(class="java.security.PrivateKey") native

  /**
   * Validate the private key format and accessibility
   */
  validate: member function(): PrivateKeyAuth
}
