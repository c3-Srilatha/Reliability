/**
 * Type to represent OpenId Provider metadata
 */
enum type OidcProviderMetadataKind {

  Issuer = "issuer"

  AuthEndPoint = "authorization_endpoint"

  TokenEndPoint = "token_endpoint"

  TokenEndPointAuthMethods = "token_endpoint_auth_methods_supported"

  UserInfoEndPoint = "userinfo_endpoint"

  KeysUri = "jwks_uri"

  RegEndPoint = "registration_endpoint"

  Scopes = "scopes_supported"

  ResponseTypes = "response_types_supported"

  ResponseModes = "response_modes_supported"

  GrantTypes = "grant_types_supported"

  SubjectTypes = "subject_types_supported"

  IdTokenSigAlgorithms = "id_token_signing_alg_values_supported"

  Claims = "claims_supported"
}
