/**
 * This type represents various represents various client certificate types
 */
enum type OidcCertKind {

  /**
   * .PEM (Privacy Enhanced Mail) format
   */
  PEM

  /**
   * .CER format
   */
  CER

  /**
   * .CRT format
   */
  CRT

  /**
   * .DER (Distinguished Encoding Rules) format
   */
  DER
}
