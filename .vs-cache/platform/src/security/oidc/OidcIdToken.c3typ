/**
 * This type represents IdToken which is returned OIDC provider
 */
private type OidcIdToken {

  /**
   * Identifies the intended recipients of the token. This must include the application id assigned to our app by OP.
   */
  audience: [string]

  /**
   * Identifies the authorized party (azp) to which the ID token was issued. This is the application id assigned to our
   * app by OP.
   */
  authorizedParty: string

  /**
   * Identifies the idp (uri) that constructs and returns the token.
   */
  issuer: string

  /**
   * Identifies when the authentication for this token occurred.
   */
  issuedAt: int

  /**
   * Identifies IDP (uri) that authenticated the subject of the token.
   */
  identityProvider: string

  /**
   * The nbf (not before) claim identifies the time before which JWT must not be accepted
   */
  notBefore: int

  /**
   * The exp (expiry) claim identifies the expiration time of token in seconds since epoch.
   */
  expirationTime: int

  /**
   * Identifies the code hash (c_hash), included only when the ID token is issued with OAuth 2.0 authorization code.
   */
  codeHash: string

  /**
   * Identifies the access token hash (at_hash), included only when the ID token is issued from /authorize end point
   * with OAuth2.0
   * access token.
   */
  accessTokenHash: string

  /**
   * Identifies the primary username (preferred_username) that represents the user. It could be an email address,
   * phone number or generic
   * username without a specified format.
   */
  preferredUsername: string

  /**
   * Identifies the user email
   */
  email: string

  /**
   * The name claim provides a human-readable value identifies the subject of the token via full name. Possibly includes
   * titles and suffixes.
   */
  name: string

  /**
   * The given name of the user, aka first name
   */
  givenName: string

  /**
   * The family name of the user, aka last name
   */
  familyName: string

  /**
   * The nonce matches the parameter included in the original request to IDP. if does not match, application should
   * reject the token.
   */
  nonce: string

  /**
   * Immutable identifier (oid) for a user to track across all applications.
   */
  objectId: string

  /**
   * The set of roles that were assigned to the user.
   */
  roles: [string]

  /**
   * The set of groups that were assigned to the user.
   */
  groups: [string]

  /**
   * Identifies the user (sub) unique to a particular application.
   */
  principal: string

  /**
   * A GUID that represents the tenant (tid) that the user is from. Identifies the organization that the user belongs
   */
  tenantId: string

  /**
   * Provides a human readable value that identifies the subject (unique_name) of the token.
   */
  uniqueName: string

  /**
   * Indicates the version (ver) of the id_token
   */
  versionIdentifier: string

  /**
   * if true, this claim indicates that the user is at least belong to one group.
   */
  hasGroups: boolean

  /**
   * Prepares IdToken from JWT
   * @param jwt
   *      JWT
   * @param claimNames
   *      claim names that are present in the JWT
   * @param ignoreGroups
   *      if set to true, then ignore the groups sent from the idp
   * @return
   *      IdToken
   */
  fromJwt: private function(jwt: !Jwt, claimNames: OidcIdToken.ClaimNames, ignoreGroups: !?boolean): !OidcIdToken

  /**
   * Verify oidc provider issued idToken and converts to OidcIdToken c3type
   *
   * @param idToken
   *        idtoken issued by OIDC provider
   * @param vanityUrlId
   *        vanity url identifier
   * @param ignoreGroups
   *      if set to true, then ignore the groups sent from the idp
   * @return OidcIdToken
   *         OidcIdToken c3type
   */
  fromIdTokenStr: function(idToken: !string, vanityUrlId: !?string, ignoreGroups: !?boolean): !OidcIdToken
}
