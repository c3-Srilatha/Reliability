/**
 * This type implements the authentication request and login and logout redirect endpoints for OpenID Connect
 * authentication flow.
 */
type Oidc mixes Authenticator, OidcIdpConfig {

  /**
   * Validates the id_token from the IDP and authenticates the user
   * @param idToken
   *     The id_token received from the IDP
   * @param host
   *     The host for which IdpConfig is configured for
   */
  authenticateIdToken: function(idToken: !string, req: !HttpRequest): AuthenticateResult

  /**
   * Validates the auth code from the IDP, makes a request to the token endpoint to get the id_token
   * @param config
   *     The IDP configuration
   * @param authCode
   *     The authorization code received from the IDP
   * @param jwt
   *    The JWT token containing the encrypted code verifier
   * @param signerApp
   *   The app that signed the JWT token
   * @return id_token
   */
  requestFromTokenEndpoint: private function(config: !OidcIdpConfig,
                                             authCode: !string,
                                             jwt: !Jwt,
                                             signerApp: !App): string

  /**
   * Generate authentication request.
   * An Authentication Request is an OAuth 2.0 Authorization Request that requests that the End-User be authenticated
   * by the Authorization Server.
   * @param state
   *      opaque state that will be used to identify this request with the corresponding redirect request
   *      will also contain the path used to redirect the client after validating the authentication token.
   * @param key
   *      State will be encoded in the message as a JWT token, the key will be used to HMAC256 sign it.
   * @return {link @OidcAuthenticationRequest}
   */
  authRequest: member function(state: !string, key: !App.PrivateKey): OidcAuthenticationRequest

  /**
   * Construct an http response that will redirect the client to their target app login endpoint.
   * @param app
   *      The target app to redirect to
   * @param host
   *      The host for which the IdpConfig is configured for
   * @param data
   *      The data to be passed to the target app
   * @param req
   *      The request that initiated the authentication flow
   */
  redirectToTargetApp: private function(app: !string, host: !string, data: !string, req: !HttpRequest): HttpResponse

  /**
   * Validates the id token according to
   * {@link https://openid.net/specs/openid-connect-core-1_0.html#IDTokenValidation OIDC standards}.
   * Throws an error if the token is invalid.
   *
   * @param oidcIdToken
   *       The id token to validate.
   * @param oidcConfig
   *       The configuration of the OIDC IdP.
   */
  validateIdToken: private function(idToken: !OidcIdToken, config: !OidcIdpConfig)

  /**
   * Returns the {@link AppId} for the target app stored in the provided state token
   * @param state
   *      The state token
   * @param host
   *      The host for which the IdpConfig is configured for
   * @param failIfInvalid
   *      If true, will throw an error if the state token is invalid
   */
  appFromStateToken: private function(state: !string, host: !string, failIfInvalid: boolean): string serialized AppId
}
