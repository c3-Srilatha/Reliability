/**
 * These contain the default claim names used in {@link OidcIdToken}s.
 * They can be configured using {@link OidcIdpConfig}
 */
type OidcIdToken.ClaimNames {

  audience:              string = "aud"
  authorizedParty:       string = "azp"
  issuer:                string = "iss"
  issuedAt:              string = "iat"
  identityProvider:      string = "idp"
  notBefore:             string = "nbf"
  expirationTime:        string = "exp"
  codeHash:              string = "c_hash"
  accessTokenHash:       string = "at_hash"
  preferredUsername:     string = "preferred_username"
  email:                 string = "email"
  name:                  string = "name"
  givenName:             string = "given_name"
  familyName:            string = "family_name"
  nonce:                 string = "nonce"
  objectId:              string = "oid"
  roles:                 string = "roles"
  groups:                string = "groups"
  principal:             string = "sub"
  tenantId:              string = "tid"
  uniqueName:            string = "unique_name"
  versionIdentifier:     string = "ver"
  hasGroups:             string = "hasGroups"
  encryptedCodeVerifier: string = "enc_code_verifier"
  relyingPartyState:     string = "state"
}
