/**
 * Error responses are returned with an HTTP 400 status code (unless specified otherwise), with error and error_description parameters.
 */
private type OidcErrorResponse mixes OAuthErrorResponse {

  /**
   * OAuth 2.0 state value. REQUIRED if the Authorization Request included the state parameter. Set to the value
   * received from the Client.
   */
  state: string
}
