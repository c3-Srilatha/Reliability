/**
 * Type to represent the authentication data for OIDC.
 */
type AuthenticationSpec.Data.Oidc mixes AuthenticationSpec.Data {

  toString:   ~
  fromString: ~

  /**
   * State of the authentication request (e.g., OAuth state parameter)
   */
  state: string

  /**
   * Code or Token of the authentication request (e.g., OAuth authorization code/token)
   */
  idTokenOrAuthzCode: string
}
