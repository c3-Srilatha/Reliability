/**
 * This type represents the certificate material used to validate idp server issued tokens
 */
type OidcIdpServerCertificate {

  /**
   * key id
   */
  kid: !string

  /**
   * Certificate or public key
   */
  certificate: !string

  /**
   * Certificate format type
   */
  formatKind: string enum OidcCertKind

  /**
   * Type (RSA, EC) of the key
   */
  keyType: !string
}
