/**
 * A SessionToken represents an authenticated user in the C3 platform.
 * It is generated as a result of a valid Authentication operation through one of the configured Identity Providers.
 * It carries information about which user is authenticated, the application context, and the token’s expiration.
 */
@cache(maxSize=1000)
@action(group+='cluster-admin')
private type SessionToken mixes StringSerializable, Cached {

  /**
   * Identifies the {@link User} in the C3 server.
   * The field is populated on successful {@link SessionToken#generate} and {@link SessionToken#validate} operations.
   */
  user: !User

  /**
   * Application where the {@link User} has been authenticated.
   * The token is valid only for this application.
   */
  appId: !string

  /**
   * Represents the expiration time of the token, after which the user must re-authenticate.
   * It is NOT the duration of token validity.
   * System currently defaults to 24 hours from token generation.
   * Custom expiration time can be set via the claims parameter of the {@link SessionToken#generate} method.
   */
  // TODO: Allow configuration per url/path.
  expiry: DateTime

  /**
   * The session sequence for the token. This sessionSequence is a number used for tracking
   * invalidated tokens for a particular user in an app.
   * Starts from 1, and increases with every new session created for a user in an app.
   * Any token issued with an earlier lower sessionSequence becomes invalid.
   */
  sessionSequence: !int

  /**
   * The signed and serialized token string.
   * This is what the client sends to authenticate requests to the server.
   */
  signedToken: !string

  /**
   * If true, enforces validation on sessionSequence to ensure older tokens are invalid.
   */
  verifySessionSequence: boolean = true

  /**
   * The {@link Action#id} when the sessionToken is generated for an action rather than standard user session flows.
   */
  actionId: string

  /**
   * True if this token's {@link SessionToken#expiry} time has passed.
   */
  expired: property(): boolean

  /**
   * Deserialize and validate the given string serialized token. Validation consists of checking the signature,
   * expiration, and session sequence.
   * Invalid tokens will not have their failure reason exposed to the client.
   * @param signedToken
   *        A signed and serialized token string to validate.
   * @param failIfInvalid
   *        If true, the method throws an error when the token is invalid. Otherwise, return null.
   * @returns
   *        SessionToken if valid, or null if invalid and failIfInvalid is false.
   */
  validate: function(signedToken: !string, failIfInvalid: boolean): SessionToken

  /**
   * Generates a new SessionToken for a given user. Additional claims can be passed to specify custom claims
   * in the token.
   * @param user
   *        The {@link User} for which the session token is generated.
   * @param claims
   *        If provided, an optional map of string keys to values, which will be appended to the token payload.
   *        If any {@link SessionTokenClaimKind} claims are provided, then they will override the default values.
   * @returns
   *        SessionToken for the given {@link User} with the specified claims.
   */
  generate: function(user: !User, claims: map<string, any>): !SessionToken

  /**
   * Determines if the token is valid, and if not, returns the reason why.
   * Differs from {@link SessionToken#validate} in that this function returns the specific reason for failure.
   * @param token
   *        A signed and serialized token string to check.
   * @param verify
   *        If true, the token signature will be verified
   * @returns
   *       A pair containing the valid SessionToken and an error if the token is invalid.
   */
  @action(group+='cluster-admin')
  sanityCheck: function(token: !string, verify: boolean): Pair<SessionToken, Error>

  /**
   * Generates a SessionToken from an {@link AppToken}. Depending on the {@link AppToken#srcAppId} and
   * {@link AppToken#destAppId}, use either app's roles from {@link AppIdentity} or user's roles from {@link AppToken}
   * for creating the user for this SessionToken.
   * @param appToken
   *        The AppToken that contains app information.
   * @returns
   *        The SessionToken object derived from the provided AppToken.
   */
  fromAppToken: function(appToken: !AppToken): !SessionToken

  /**
   * The signed and serialized token string.
   */
  toString: ~

  /**
   * Accepts a signed and serialized token string and validates it.
   */
  @action(inline=true)
  fromString: inline ~

  @action(inline=true)
  produce: inline ~

  @action(inline=true)
  clearCache: inline ~

  @action(inline=true)
  forCacheKey: inline ~
}
