/**
 * Type that performs CRUD operations on Azure AD users.
 */
type AzureIdp mixes IdentityProvider<AzureIdpConfig> {

  /**
   * Provisions Azure storage resources for the given user.
   * @return Map<String, String> consisting of the secrets required to access the provisioned resources.
   */
  provisionForUser: function(): map<string, string>

  /**
   * Revokes Azure storage resources from the user specified by the given email if an email is supplied, otherwise
   * revokes from the user invoking the action.
   */
  @action(group+='cluster-admin')
  revokeFromUser: function(email: string)
}
