/**
 * Type that performs CRUD operations on Gcp IAM users.
 */
type GcpIdp mixes IdentityProvider<GcpIdpConfig> {

  /**
   *  Provisions key pair on the Gcs service account, see {@link GcpIdpConfig}, for the given user.
   *
   *  @return Map<String, String> consisting of the {@link GcpCredentials} fields needed to access Gcs resources
   * through the service account.
   */
  provisionForUser: function(): map<string, string>

  /**
   * Revokes Gcp access keys for the user specified by the given email if an email is supplied,
   * otherwise revokes from the user invoking the action.
   */
  @action(group+='cluster-admin')
  revokeFromUser: function(email: string)
}
