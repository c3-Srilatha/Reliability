/**
 * Automatically provides visitors with the Anonymous user identity (@see User#anonymous) if not authenticated.
 * @mixes {@link IdentityProvider}
 */
@action(group+='cluster-admin')
type C3RegistrationIdp mixes IdentityProvider<C3RegistrationIdpConfig>
