type AzureIdpConfig mixes CloudIdpConfig {

  /**
   * The ID of the default resource group under which Azure resources are created.
   */
  defaultResourceGroup: !string

  /**
   * The prefix to be added to Azure storage account names. Note that maximum length of the overall storage account name is 24 characters consisting
   * of lowercase characters and numbers.
   */
  storageAccountPrefix: !string

  /**
   * The Azure region to use for the storage account
   */
  storageAccountRegion: !string = "eastus"

  /**
   * The Access Tier to use for the Azure storage account. Possible values are "Hot" and "Cool"
   */
  storageAccountAccessTier: !string = "Cool"
}
