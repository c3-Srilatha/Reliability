/**
 * Idp used for testing, and basic auth.
 * This will only be enabled for local environments,
 * or if the current app's {@link AppMode} is set to {@link AppMode#TEST} or {@link AppMode#DEV}.
 */
@restful(endpoint='testidp')
@action(group+='user-admin')
type TestIdp mixes IdentityProvider<TestIdpConfig> {

  /**
   * Ensures that test users for provided group exist and creates if missing. It will not set user password so this
   * user can only be used in tests.
   *
   * @param group
   *            Group to create the test users in.
   * @param num
   *            Number of test users to create
   * @return list of created users
   */
  createTestUsersForGroup: function(group: !string, num: int = 1): ![TestUser]

  /**
   * Remove test users that were created for provided group.
   *
   * @param group
   *            Group to create the test users in.
   * @return number of users removed
   */
  removeTestUsersForGroup: function(group: !string): int

  /**
   * Creates users for all roles that are provisioned in the given environment and sets this env as default env for
   * new users. Only works on local environments.
   *
   * @param dryRun
   *           Whether only a dry-run of the migration should be run.
   * @param num
   *            Number of test users to create
   *
   * @return array of test users
   */
  @action(authz='always')
  createTestUsers: private function(dryRun: boolean, num: int = 1): [TestUser]

  /**
   * Creates a test user with arbitrary permissions
   *
   * @param userId
   *          user identifier
   * @param password
   *          password to be assigned
   * @param permissions
   *         permission list
   * @return test user with arbitrary permissions
   */
  @action(authz='always')
  createTestUserWithPermissions: private function(userId: !string, password: !string, permissions: ![string]): !User

  /**
   * Removes test roles
   *
   * @param roles
   *          list of roles
   */
  @action(authz='always')
  removeTestRoles: private function(roles: !?[Role])

  /**
   * Creates test user and assigns a password. Also adds the user to groups if supplied.
   *
   * @param userId
   *          user identifier
   * @param password
   *          password to be assigned
   * @param groups
   *           list of groups to be assigned
   * @return test user
   */
  @action(authz='always')
  createTestUser: private function(userId: !string, password: !string, groups: [string]): !User

  /**
   * Saves the provided user to TestUserConfig
   * @param user
   *          user to be saved
   * @return true if success
   */
  upsertTestUser: function(user: !User): User

  /**
   * Finds test user by role.
   *
   * @param roleId
   *           role id
   *
   * @return test user if success; null or error based on failIfMissing flag otherwise.
   */
  @action(authz='always')
  testUserByRole: private function(roleId: !string, failIfMissing: boolean): User

  /**
   * Removes test users
   *
   * @param users
   *          user list
   */
  @action(authz='always')
  removeTestUsers: private function(users: !?[User])

  /**
   * Sets Private Key for user
   *
   * @param userid
   *          user identifier
   * @param privateKey
   *          private key to be assigned
   */
  @action(authz='always')
  setUserPrivateKey: private function(user: !User, privateKey: !string)

  /**
   * Sets Oidc provided User Object Id for the user
   *
   * @param user
   *          User object
   * @param oidcUserObjectId
   *          The object ID of the user returned from the OIDC endpoint
   */
  @action(authz='always')
  setOidcUserObjectId: private function(user: !User, oidcUserObjectId: !string)

  /**
   * Executes lambda as test user with only provided C3 role.
   *
   * @param  roles
   *           The C3 roles for test user
   * @param  lambda
   *           Lambda to apply as test user
   * @return the result of application of lambda
   */
  @action(authzChildActions=true)
  executeAsRole: function(role: !string, action: !lambda(): any): any

  /**
   * Executes lambda as the given test user.
   *
   * @param  user
   *           The id of C3 test user
   * @param  lambda
   *           Lambda to apply as test user
   * @return the result of application of lambda
   */
  @action(authzChildActions=true)
  executeAsUser: function(user: !string, action: !lambda(): any): any

  /**
   * Executes lambda as the given test user.
   *
   * @param  user
   *           The C3 test user
   * @param  lambda
   *           Lambda to apply as test user
   * @return the result of application of lambda
   */
  @action(authzChildActions=true)
  executeAsUser: function(user: !User, action: !lambda(): any): any

  /**
   * Sets the current session to be that of the provided user. User cannot have any roles defined in the platform package.
   * Can only be used in TEST or DEV app modes.
   * @param user
   *        ID of User to assume
   */
  @restful(subPath='assumeUser/:userId')
  assumeUser: function(userId: !string): HttpResponse

  /**
   * Removes the current session.
   * Can only be used in TEST or DEV app modes.
   */
  @restful(subPath='unassumeUser')
  @action(inline=true)
  unassumeUser: inline function(): HttpResponse

  createUser:       ~
  setPassword:      ~
  setUserPublicKey: ~
  removeUser:       ~
  user:             ~
  users:            ~
  unlockLogin:      ~

  @deprecated(finalVersion="8.10",
              details="Use TestIdp#addUserToGroup in the correct application you have access to instead")
  addUserToApp: ~

  @deprecated(finalVersion="8.10",
              details="Use TestIdp#addUserToGroup in the correct environment you have access to instead")
  addUserToEnv: ~

  addUserToGroup:      ~
  removeUserFromGroup: ~
  isUserInGroup:       ~

  @deprecated(finalVersion="8.10", details="Use User#apps instead")
  allUserApps: ~

  @deprecated(finalVersion="8.10", details="Use User#envs instead")
  allUserEnvs: ~

  @deprecated(finalVersion="8.10", details="Use TestIdp#user in the correct environment instead")
  isUserInEnv: ~

  @deprecated(finalVersion="8.10", details="Use User#create instead")
  createSystemUser: ~
}
