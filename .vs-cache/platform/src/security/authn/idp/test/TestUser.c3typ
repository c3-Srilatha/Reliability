type TestUser mixes User {

  /**
   * passcode field
   */
  @config(secret=true)
  passcode: string

  /**
   * Determines whether this user is locked or not.
   */
  locked: boolean

  /**
   * Private key for the User
   */
  privateKey: string

  /**
   * Role associated to the TestUser
   */
  testRoles: [Role]

  /**
   * ObjectId of the User within the OIDC provider
   */
  oidcUserObjectId: string
}
