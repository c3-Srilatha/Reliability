/**
 * Type that performs CRUD operations on AWS IAM users.
 */
type AwsIdp mixes IdentityProvider<AwsIdpConfig> {

  /**
   * Provisions an AWS IAM user and storage (S3 bucket) for the given user.
   *
   * @return Map<String, String> consisting of the secrets required to access the provisioned resources.
   */
  provisionForUser: function(): map<string, string>

  /**
   * Revokes Aws storage resources and access keys from the user specified by the given email if an email is supplied,
   * otherwise revokes from the user invoking the action.
   */
  @action(group+='cluster-admin')
  revokeFromUser: function(email: string)

  createUser:          ~
  removeUser:          ~
  addUserToGroup:      ~
  removeUserFromGroup: ~
}
