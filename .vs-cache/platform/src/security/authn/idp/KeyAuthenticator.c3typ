type KeyAuthenticator mixes Authenticator {

  /*
   * Verifies the signature using the input publicKey.
   *
   * @param publicKey
   *           The public key in PEM format
   * @param signature
   *           Hex-encoded signature that needs to be verified
   * @param data
   *           Data that the signature is based on
   * @return True if the signature is valid. Otherwise, throws an exception.
   */
  verify: function(publicKey: !string, signature: !string, data: !string): boolean

  /*
   * Verifies the signature using the input publicKey.
   *
   * @param privateKey
   *           The private key in PEM format, used to sign the data
   * @param data
   *           Data that the signature is based on
   * @return The generated signature
   */
  sign: function(privateKey: !string, data: !string): string
}
