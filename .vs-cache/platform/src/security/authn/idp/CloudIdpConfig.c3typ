@config(minOverride=CLUSTER, maxOverride=CLUSTER, authz='cluster-admin', secretAuthz='cluster-admin')
@action(group+='cluster-admin')
abstract type CloudIdpConfig mixes Config, Singleton {

  /**
   * Contains the access key and secret key.
   */
  credentials: !CloudCredentials

  /**
   * The default group id to add IAM users to.
   */
  defaultGroupId: !string
}
