/**
 * Stores the CSRF token and its expiry time. Every time a new token is generated, a new entry is created in the cache.
 * When validating an expired csrf token, the cache entry for the particular token will be evicted.
 */
@cache(maxSize=1000)
@action(group+='cluster-admin')
final private type CsrfToken.ExpiryCache mixes Cached, Identifiable {

  /**
   * The expiry time of the token in milliseconds since epoch.
   */
  expiry: int

  /**
   * Called if Cache miss. Returns a CsrfToken.ExpiryCache instance with expiry set to 0L.
   */
  produce: ~
}
