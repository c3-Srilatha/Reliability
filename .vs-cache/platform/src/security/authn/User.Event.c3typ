/**
 * This type represents a user event.
 */
@action(group+='user-admin')
type User.Event {

  /**
   * Unique identifier for user
   */
  userId: !string

  /**
   * Time of the user event
   */
  date: !datetime

  /**
   * Id of the application that the user event occurred on.
   */
  appId: !string serialized AppId
}
