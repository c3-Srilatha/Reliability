/**
 * Type to represent the status or authentication result.
 */
enum type AuthenticationStatus {

  /**
   * Authenticated successfully.
   */
  OK

  /**
   * No given token
   */
  NO_TOKEN

  /**
   * No given user
   */
  NO_USER

  /**
   * Invalid token
   */
  BAD_TOKEN

  /**
   * Expired token
   */
  EXPIRED_TOKEN

  /**
   * Invalid user name
   */
  INVALID_USERNAME

  /**
   * No user could be found with given token
   */
  USER_NOT_FOUND

  /**
   * No public key could be found with given token
   */
  PUBLIC_KEY_NOT_FOUND

  /**
   * Failed to verify the signature with public key in the c3 server.
   */
  KEY_VERIFICATION_FAILED
}
