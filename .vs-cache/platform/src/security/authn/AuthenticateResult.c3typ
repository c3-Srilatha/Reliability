/**
 * Result of a call to Authenticator#Authenticate
 */
inline type AuthenticateResult mixes Result {

  /**
   * C3 Basic authentication header
   */
  BASIC_AUTH_REALM: const string = 'Basic realm=c3.ai'

  /**
   * Invalid authentication
   */
  INVALID: const string = 'invalid'

  /**
   * Error Message displayed on {@link MediaType#HTML}
   */
  ERROR_MESSAGE: const string = 'Please contact your application administrator'

  /**
   * The authenticated user
   */
  user: User

  /**
   * The client app that initiated the authentication
   */
  clientAppId: string

  /**
   * The client user that initiated the authentication
   */
  clientUserId: string

  /**
   * The request used for authentication
   */
  request: HttpRequest

  /**
   * The response to send to the client app if request failed to authenticate
   */
  response: HttpResponse

  /**
   * `true` if all OK
   */
  ok: member function(): boolean

  /**
   * `true` if 401 response
   */
  notAuthorized: member function(): boolean

  /**
   * Error object
   */
  error: Error

  /**
   * The authentication spec used in the http request
   */
  spec: AuthenticationSpec

  /**
   * `true` if the endpoint of the request is anonymous-allowed.
   */
  anonymous: boolean
}
