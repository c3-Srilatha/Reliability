@action(group+='app-admin')
@config(maxOverride=APP, minOverride=APP, authz='app-admin')
private type App.SecretKey.Config mixes Config, Singleton {

  /**
   * Number of days the key is valid since the key was generated
   */
  daysValid: int32 = 180

  /**
   * Time this key expires
   */
  expiration: datetime

  /**
   * Secret key bit string
   */
  @config(secret=true)
  secretKey: string

  /**
   * Key Length in bits. if none provided, assumes 256 bit sized key.
   */
  keyLength: int32 = 256

  /**
   * The algorithm used to sign and verify jwt tokens.
   */
  jwtAlgorithm: string enum JwsAlgorithmKind = HMAC256
}
