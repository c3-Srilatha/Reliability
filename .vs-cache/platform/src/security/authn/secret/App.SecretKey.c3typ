/**
 * Type to represent application secret key, which is used to generate and validate authentication tokens.
 * Generation of secret key efficient as opposed to application private key {@see App.AsymmetricKeys}. For example,
 * applications in practice, simply draw k bits from linux random source (/dev/urandom).
 * To generate private key, in case of discrete logarithm based cryptography involves group exponentiations.
 */
@action(group+="app-admin")
private type App.SecretKey mixes Configurable<App.SecretKey.Config>, Cached {

  /**
   * If refresh is false, and there already exists valid keys in the config store, return true.
   * Otherwise if either refresh is true or there is no valid keys, generate new secret key.
   * @returns true if success; false otherwise.
   */
  ensure: function(refresh: boolean): !boolean

  /**
   * Validates whether SecretKey is expired or not.
   *
   * @returns true if not expired; false otherwise.
   */
  isValid: function(): !boolean

  /**
   * Returns the application secret key.
   */
  key: function(): !string
}
