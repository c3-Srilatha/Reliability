/**
 * Type to represent a pair of app's private/public keys.
 */
private type App.AsymmetricKeys mixes CryptoKeyPair {

  /**
   * If refresh is false, and there already exists valid keys in the config store, return true.
   * Otherwise if either refresh is true or there is no valid keys, generate new public/private keys.
   * @returns true if success; false otherwise.
   */
  @action(group+="app-admin")
  ensure: member function(refresh: boolean): !boolean

  /**
   * Validates whether the keys are expired or not.
   *
   * @returns true if not expired; false otherwise.
   */
  isValid: member function(): !boolean

  /**
   * Returns the application public key.
   */
  publicKey: ~

  /**
   * Returns the application private key.
   */
  privateKey: ~
}
