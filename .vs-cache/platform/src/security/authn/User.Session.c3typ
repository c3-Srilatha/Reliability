/**
 * The stored {@link User}#sessionSequence to validate against. 1 to 1 mapping with {@link User} entity via id
 */
@action(group+='cluster-admin')
@cache(cacheNulls=true)
@db(domain='system')
private entity type User.Session mixes Identified, Cached {

  /**
   * The stored sessionSequence
   */
  sequence: !int

  @action(inline=true)
  clearCache: inline ~
}
