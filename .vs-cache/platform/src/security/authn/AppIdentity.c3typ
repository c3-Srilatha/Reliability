/**
 * This type represents the App Identity of an App
 */
// TODO: PLAT-85369 Remove AppIdentity.c3typ
@cache(dependencies=['App'])
type AppIdentity mixes Config, Identified {

  /**
   * If an AppIdentity with AppIdentity.DEFAULT as id is upserted by the app admin, ALL APPS in the cluster are granted
   * access to the current app via provided roles. This is mainly a use case for Microservices so set it with caution.
   */
  DEFAULT: const string = 'DEFAULT'

  /**
   * The public key of the app
   */
  // TODO: PLAT-72459 Remove deprecated fields on AppIdentity.c3typ
  @deprecated
  publicKey: string

  /**
   * The algorithm used for verifying jwt tokens from the app
   */
  // TODO: PLAT-53483 Remove deprecated fields on AppIdentity.c3typ
  @deprecated
  jwtAlgorithm: string enum JwsAlgorithmKind = RSA512

  /**
   * The roles assigned to the app identity for the app.
   */
  roles: [string]

  forId:                          ~
  setConfig:                      ~
  setSecret:                      ~
  setConfigValue:                 ~
  setSecretValue:                 ~
  setConfigValueTemplate:         ~
  setSecretValueTemplate:         ~
  setConfigOrSecretValue:         ~
  setConfigOrSecretValueTemplate: ~
}
