/**
 * Type to represent the authentication data.
 */
type AuthenticationSpec mixes Spec {

  /**
   * Authentication type
   */
  kind: !string enum AuthenticationKind

  /**
   * User or Identity Provider supplied authentication data to be used by authenticator to identify and/or validate
   * access.
   */
  data: !string serialized mixing AuthenticationSpec.Data

  /**
   * HttpRequest that needs to be authenticated
   */
  req: HttpRequest

  /**
   * Prepares AuthorizationSpec from the authorization header supplied by user, such as {@link AuthenticationKind.BASIC},
   * {@link AuthenticationKind.APP}, {@link AuthenticationKind.C3}, etc.
   *
   * If a BASIC authorization header is supplied without a username, then the provided password is treated as a session token.
   *
   * @param authorization
   *        authorization string(e.g. Authorization: Basic|C3Bearer Base64 encoded string)
   *
   * @returns AuthorizationSpec if success; null otherwise.
   */
  fromAuthorizationHeader: inline function(authorization: !string,
                                           req: HttpRequest,
                                           failIfInvalid: boolean): !AuthenticationSpec

  /**
   * Prepares AuthorizationSpec from the HttpRequest {@link HttpRequest}
   *
   * @param req
   *        HttpRequest
   * @param failIfInvalid
   *          throws error if true; null otherwise
   *
   * @returns AuthorizationSpec if success; null otherwise. We first check for Authorization header and then we look for
   *          the query parameter {@link HttpQueryParam#AUTH}
   */
  fromHttpRequest: inline function(req: !HttpRequest, failIfInvalid: boolean): !AuthenticationSpec

  /**
   * Prepares AuthorizationSpec from the certain IdpConfigs {@link IdpConfig}
   *
   * @param idpConfig
   *        IdpConfig
   * @param failIfInvalid
   *          throws error if true; null otherwise
   *
   * @returns AuthorizationSpec if success; null otherwise.
   */
  fromIdpConfig: inline function(idpConfig: !IdpConfig,
                                 req: !HttpRequest,
                                 failIfInvalid: boolean): !AuthenticationSpec
}
