/**
 * Type to represent the url fields for the authentication data.
 */
abstract type AuthenticationSpec.Data mixes StringSerializable {

  /**
   * Host from which the request originated
   */
  host: !string

  /**
   * Scheme of the request (http or https)
   */
  scheme: string

  /**
   * Port of the request
   */
  port: string

  /**
   * Encoded path of the request
   */
  encodedPath: string
}
