/**
 * Type to provide system level configuration for Kerberos. There can only be single krb file/content.
 * This config will throw error if neither of krbFilePath or krbContent is set.
 */
type KerberosConfig mixes Config, Singleton {

  /**
   * File path to local krb5 configuration file. The file path should end with krb5.conf or krb5.ini.
   * e.g /etc/krb5.conf
   */
  krbFilePath: string

  /**
   * This will be ignored if krbFilePath is set.
   * The Kerberos configuration content for realms and hostnames.
   * Content can be provided as plain text string, and use "\\n" for line breakers.
   */
  krbContent: string

  // TODO: these 2 configuration variables are used in KerberosCommon.java
  keytabRootDir: string

  krbConfigsDir: string

  /**
   * This will set System property 'java.security.krb5.conf' to krb5.conf.
   * Use {@link KerberosConfig.krbFilePath} or  write {@link KerberosConfig.krbContent}
   * to default krb config file and use that file path to update System property for krb config file.
   *
   *  This will also reload krb5.conf if file contents of file `krbFilePath` are modified.
   * Check to see if the file is modified will be done if the last check was done more than 120 sec. ago.
   */
  refreshKrbConf: function(force: boolean)

  /**
   * remove System property 'java.security.krb5.conf' for krb config file, if previously set.
   */
  clearKrbConf: function()
}
