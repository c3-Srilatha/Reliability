/**
 * This holds credential fields for Kerberos authentication. This type can be a field of a C3 credentials type such as
 * {@link ApacheCredentials}, {@link JdbcCredentials}.
 */
type KerberosCredentials {

  /**
   * Kerberos principal. Typical format is primary/instance@REALM. (ie. hive/_HOST/PRINCIPAL.COM)
   * Should also provide either keytabFilePath, keytabContent, or password. First available value for one of
   * `keytabFilePath, keytabContent, or password` will be used in the same order.
   */
  principal: string

  @config(secret=true)
  password: string

  /**
   * The user's keytab content that contains encrypted user name and password. As the file is in binary format,
   * the content needs to be base64 encoded for this field. In Kerberos world, you can login using a principal name
   * and the password, or, a keytab file that's generated from the principal and the password.
   */
  @config(secret=true)
  keytabContent: string

  /**
   * The user's keytab content file that contains encrypted user name and password.
   */
  keytabFilePath: string

  /**
   * Return a list of SaslSubjects that are active in the system.
   */
  activeSubjects: function(): [SaslSubject]

  /**
   * Invalidate all Kerberos Credentials.
   *
   * @param logout
   *          additionally log out the principal, which has the effect of tearing down underlying TCP/IP connections
   */
  invalidateAllCredentials: function(logout: boolean)

  /**
   * Invalidate a specific Kerberos Credentials.
   *
   * @param principal
   *          name of the principal to invalidate its credentials
   * @param logout
   *          additionally log out the principal, which has the effect of tearing down underlying TCP/IP connections
   */
  invalidateCredentials: function(principal: !string, logout: boolean)

  /**
   * Log out all subjects. Admin only function.
   */
  logAllOut: function()

  /**
   * Log out a subject. Admin only function.
   *
   * @param principal
   *          name of the principal to log out
   */
  logout: function(principal: !string)
}
