/**
 * SaslSubject implementation. An object of this type represents a java security Subject active in the system.
 * A SaslSubject can be instantiated through JAAS configuration or programmatically. In any case, for a JAAS subject,
 * there will be a javax.security.auth.Subject internally.
 *
 * A KerberosSpec is used in materializing a SaslSubject when Kerberos is used for its SASL mechanism.
 */
type SaslSubject {

  /**
   * the principal or user name
   */
  principal: string

  /**
   * UserGroupInformation description
   */
  description: string

  /**
   * an instance of an application-level Java class that wraps the Java Subject, for instance, Hadoop's UserGroupInformation
   */
  user: native

  /**
   * the internal Java Subject instance; this may not be available through the JaasSubject
   */
  javaSubject: @java(class="javax.security.auth.Subject") native

  /**
   * keytab description
   */
  keytab: string

  /**
   * details about tickets(kerberos, for instance) that are associated with the JassSubject
   */
  tickets: [[string]]
}
