/**
 * A type that accepts a native Vertx Response, validates it
 * and returns a scanned native Vertx Response.
 */
type HttpResponseScanner {

  scan: function(request: !HttpRequest,
                 response: @java(class="io.vertx.core.http.HttpServerResponse") !native)
          : @java(class="io.vertx.core.http.HttpServerResponse") !native
}
