/**
 * A type used for validating HttpRequest that pertain to a particular {@link AppUrl}
 * It accepts an HttpRequest, validates it and returns an HttpResponse in case an error is encountered.
 * Returns null, otherwise.
 */
type HttpRequestScanner {

  /**
   * Validates the origin of the request.
   * @param request
   *           the incoming HttpRequest to scan
   * @return {@link HttpResponse} in case of validation error, null otherwise
   */
  validateOrigin: function(request: !HttpRequest): HttpResponse

  /**
   * Validates the csrf token in the request.
   * @param request
   *           the incoming HttpRequest to scan
   * @return {@link HttpResponse} in case of validation error, null otherwise
   */
  validateCsrf: function(request: !HttpRequest): HttpResponse
}
