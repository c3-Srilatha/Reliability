/**
 * This type represents the key used for protecting sensitive data stored in database.
 */
private type SecretKey {

  /**
   * Key identifier
   */
  id: string

  /**
   * Time this secret key is created.
   */
  created: datetime

  /**
   * Time this secret key expires
   */
  expiration: datetime

  /**
   * Random byte array
   */
  @config(secret=true)
  key: binary

  /**
   * Generates a new secret key
   *
   * @param days
   *           Number of days that the generated key is valid
   *
   * @param length
   *           Length of the key in bits. if not supplied, assumes 256 bit key
   *
   * @return SecretKey {@link SecretKey}
   */
  generateKey: inline function(days: int, length: int): SecretKey

  /**
   * Returns true if this key is expired; false otherwise
   */
  isExpired: inline member function(): boolean
}
