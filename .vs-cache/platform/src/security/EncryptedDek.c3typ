/**
 * Entity type to represent metadata to enable {@link SymmetricCipher} to decrypt data encryption keys during decrypt
 * requests. Upon receiving a decrypt request, {@link SymmetricCipher} queries this table to fetch encrypted
 * data encryption key, decrypts it using active key encryption key and returns decrypted value.
 */
@db(index+=['kekId'])
private entity type EncryptedDek mixes Cached schema name 'ENCRYPTED_DEK' {

  /**
   * Data Encryption Key Identifier
   */
  dekId: !string

  /**
   * Key encryption key identifier
   */
  kekId: !string

  /**
   * Data encryption key encrypted under key encryption key
   */
  encryptedDek: !Ciphertext
}
