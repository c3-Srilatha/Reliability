/**
 * Specification for hashing with Argon2.
 * {@link Argon2}
 */
private type Argon2.HashSpec mixes Spec {

  /**
   * The variant of Argon2 to use.
   */
  variant: Argon2.Variant

  /**
   * The version of Argon2 to use.
   */
  version: Argon2.Version

  /**
   * The salt to use when hashing.
   */
  salt: binary

  /**
   * The amount of memory to use when hashing in KB.
   */
  memorySize: int32

  /**
   * The length of the hash to generate.
   */
  hashLength: int32

  /**
   * The number of iterations to use when hashing.
   */
  iterations: int32

  /**
   * The degree of parallelism to use when hashing.
   */
  parallelism: int32

  /**
   * The default Argon2 hash specification.
   *  as specified in the Argon2 RFC: https://datatracker.ietf.org/doc/rfc9106/
   */
  defaultSpec: function(): Argon2.HashSpec
}
