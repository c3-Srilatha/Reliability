/**
 * Enum that specifies which field of the IdpUser to use as the user's id.
 */
enum type IdpUserIdFormatKind {

  /**
   * User id from the idp user information
   */
  IDP_ID

  /**
   * Hashed user id from the idp user information
   *      Hashed logic defined by configured idp
   */
  IDP_HASHED_ID

  /**
   * Email from the idp user information
   */
  EMAIL

  /**
   * Strictly lowercase email from the idp user information
   */
  LOWERCASE_EMAIL

  /**
   * Name from the idp user information
   */
  NAME

  /**
   * Preferred username from the idp user information if one exists
   */
  PREFERRED_USERNAME
}
