/**
 * OAuth code challenge method
 */
enum type OAuthCodeChallengeMethodEnum {

  /**
   * {@link OAuth.authorize} code_challenge_method
   * code_challenge = code_verifier
   */
  plain

  /**
   * {@link OAuth.authorize} code_challenge_method
   * code_challenge = BASE64URL-ENCODE(SHA256(ASCII(code_verifier)))
   */
  S256
}
