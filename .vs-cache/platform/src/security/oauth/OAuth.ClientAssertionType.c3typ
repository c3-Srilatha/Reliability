/**
 * If client wants to generate oAuth 2.0 token using Client Assertion needs to perform one of the below
 * client assertion types
 * https://datatracker.ietf.org/doc/html/rfc7521
 */
enum type OAuth.ClientAssertionType {

  JWT_BEARER = "urn:ietf:params:oauth:client-assertion-type:jwt-bearer"

  SAML_BEARER = "urn:ietf:params:oauth:client-assertion-type:saml2-bearer"
}
