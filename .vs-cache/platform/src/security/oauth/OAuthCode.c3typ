private type OAuthCode {

  /**
   * User tied to this OAuth authorization
   */
  userId: string

  /**
   * Email associated with the user
   */
  email: string

  /**
   * Groups that the user has.
   */
  groupIds: [string]

  /**
   * The Idp Type name that stores the user
   */
  idpName: string

  /**
   * C3 App this access object is bound to
   */
  appId: string

  /**
   * OAuth application this access object is bound to
   */
  oauthAppId: string

  /**
   * Code expiration datetime
   */
  codeExpiration: int

  /**
   * Scope
   */
  scope: string

  /**
   * If code was requested with a specific redirect_uri, the token request
   * using the authorization code must include that redirect_uri.
   */
  redirectUri: string

  /**
   * PKCE code_challenge
   */
  code_challenge: string

  /**
   * PKCE code_challenge_method
   */
  code_challenge_method: string
}
