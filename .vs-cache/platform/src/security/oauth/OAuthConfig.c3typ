@config(maxOverride=CLUSTER, minOverride=APP)
@action(group+='app-admin')
type OAuthConfig mixes Config, Singleton {

  /**
   * in minutes: 60 * 2 = 2 hours
   */
  accessTokenDuration: string serialized Duration = '2h'

  /**
   * in minutes: 60 * 24 * 365 = 1 year
   */
  refreshTokenDuration: string serialized Duration = '365d'

  /**
   * in minutes: 10 minutes
   */
  authorizationCodeDuration: string serialized Duration = '10m'

  /**
   * Whether to issue a new refresh token along with a new access token on a refresh_token request.
   */
  reissueRefreshToken: boolean = false
}
