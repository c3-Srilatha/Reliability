/**
 * OAuth application.
 */
@action(group+="app-admin")
@db(unique=['name'], index+=['name'])
entity type OAuthApplication schema name 'SEC_OAUTH_APP' {

  /**
   * OAuth application name
   */
  name: !string

  /**
   * Redirect URI for this OAuth application
   */
  redirectUri: !string

  /**
   * Home page of the registered application.
   */
  homePageUrl: string

  /**
   * Brief application description.
   */
  description: string

  /**
   * Register this OAUth application with C3 A registered OAuth application allows OAuth token creation with the
   * authorization_code flow.
   *
   * @param groups
   *        The groups that the confidential client will have.
   */
  register: member function(groups: [string]): OAuthApplicationCredentials

  /**
   * Deregister this OAUth application from C3.
   */
  deregister: member function()

  /**
   * Invalidates client secret
   */
  revokeSecret: member function()

  /**
   * Generate a new client secret if one does not already exist
   */
  generateSecret: member function(): OAuthApplicationCredentials
}
