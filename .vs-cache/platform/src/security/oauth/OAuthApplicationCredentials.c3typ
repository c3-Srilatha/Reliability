private type OAuthApplicationCredentials {
  /**
   * Uniquely identifies the client application in C3 server.
   * generated when calling the {@link OAuthApplication.register} API.
   */
  clientId: !string

  /**
   * Secret used to authenticate the oauth application with C3 server.
   */
  clientSecret: string
}
