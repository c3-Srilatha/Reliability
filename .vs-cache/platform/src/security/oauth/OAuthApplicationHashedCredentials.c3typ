@action(group+="app-admin")
private entity type OAuthApplicationHashedCredentials {
  /**
   * Uniquely identifies the client application in C3 server.
   */
  clientId: !string

  /**
   * Secret used to authenticate the oauth application with C3 server.
   */
  clientSecretHash: !string

  /**
   * Spec used to hash the client secret.
   */
  spec: Argon2.HashSpec
}
