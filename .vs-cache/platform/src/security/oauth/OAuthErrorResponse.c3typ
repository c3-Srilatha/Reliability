/**
 * Error responses are returned with an HTTP 400 status code (unless specified otherwise), with error and error_description parameters.
 */
private type OAuthErrorResponse {

  /**
   * {@link OAuthErrorEnum}
   */
  error: !string enum OAuthErrorEnum

  /**
   * Optional field used to return a sentence or two at most describing the circumstance of the error (must be ASCII).
   */
  error_description: string

  /**
   * Optional field that can be used to link to documentation for information about how to correct the specific error.
   */
  error_uri: string
}
