/**
 * Control type for the Canary flag
 */
type CanaryMode {

  /**
   * Determine if the Canary flag is enabled.
   */
  enabled: function(): !boolean

  /**
   * Set the Canary flag to true
   * @param override
   *            (Optional) The override level to enable.  See {@link ConfigOverride}
   */
  enable: function(override: string enum ConfigOverride)

  /**
   * Set the Canary flag to false
   * @param override
   *            (Optional) The override level to disable.  See {@link ConfigOverride}
   */
  disable: function(override: string enum ConfigOverride)
}
