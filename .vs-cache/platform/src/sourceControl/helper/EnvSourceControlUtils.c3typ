/**
 * Utils for getting {@link REST} and {@link Pkg.Store} and setting source control REST
 * configs through {@link SourceControlRestApi}
 */
type EnvSourceControlUtils {

  /**
   * Retrieves {@link Pkg.Store.Git.Branch} info for the environment's {@link Pkg.Store} instance
   * @return {@link Pkg.Store.Git.Branch}
   *        returns an instance of the type if it is configured, and null otherwise
   */
  envPkgStoreGitBranch: function(): Pkg.Store.Git.Branch

  /**
   * Creates a {@link Pair} of {@link REST#apiUrl} and {@link REST#apiAuth} from the current environment.
   * @param sourceControlInst
   *        {@link SourceControlRestApi}, will be used to determine which {@link REST} configs to check on the current environment.
   * @return {@link Pair<string, string>}
   *        Returns a {@link Pair<string, string>} which holds url in fst, and auth in snd
   */
  sourceControlConfigs: function(sourceControlInst: !SourceControlRestApi): Pair<string, string>

  /**
   * Creates a {@link Pair} of {@link REST#apiUrl} and {@link REST#apiAuth}, in token format, from the current environment.
   * @param sourceControlType
   *        {@link SourceControlHost}, will dictate which {@link SourceControlRestApi} type instance is returned and which {@link REST} configs to check on the current environment.
   * @return {@link Pair<string, string>}
   *        Returns a {@link Pair<string, string>} which holds url in fst, and auth in snd
   */
  envSourceControlConfigs: function(sourceControlType: !string enum SourceControlHost): Pair<string, string> js

  /**
   * Sets {@link REST#apiUrl} and {@link REST#apiAuth} on the current environment for the given source control.
   * @param sourceControlType
   *        {@link Type} that dictates which {@link REST} config to set. e.g. {@link GitHub} will call {@link GitHub.setApiUrlAndAuth}
   * @param url
   *        the {@link REST#apiUrl} to set on the current environment.
   * @param auth
   *        the auth used to set with {@link REST#apiAuth} on the current environment.
   */
  setApiUrlAndAuth: function(sourceControlType: !REST, url: string, auth: string)

  /**
   * Sets {@link REST#apiUrl} and {@link REST#apiAuth} using {@link EnvSourceControlUtils#setApiUrlAndAuth}
   * @param sourceControlType
   *        {@link SourceControlHost} that dictates which {@link REST} config to set. e.g. {@link SourceControlHost#GITHUB} will call {@link GitHub.setApiUrlAndAuth}
   * @param url
   *        the {@link REST#apiUrl} to set on the current environment.
   * @param token
   *        the token to transform to auth using {@link SourceControlRestApi#getAuthFromToken} and set as {@link REST#apiAuth} on the current environment.
   */
  setEnvApiUrlAndAuth: function(sourceControlType: !string enum SourceControlHost, url: string, token: string) js
}
