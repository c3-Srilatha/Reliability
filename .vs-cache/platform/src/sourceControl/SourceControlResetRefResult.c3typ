/**
 * Represents a result of updating a branch/ref to a provided sha.
 */
type SourceControlResetRefResult {

  /**
   * Whether or not the update was successful
   */
  updateSuccessful: boolean

  /**
   * If supplied, provides the branch name of a copy of the original intended ref to update.
   */
  branchCopyName: string
}
