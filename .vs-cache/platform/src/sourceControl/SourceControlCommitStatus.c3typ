/**
 * Holds information about a {@link SourceControlCommit}'s status. For most git services, this equates to the icon you
 * see on PR's that contains a link to CI.
 */
type SourceControlCommitStatus {

  /**
   * The state of the status, often translated to icon type/ color. This varies by git service provider.
   */
  state: !string enum SourceControlCommitState

  /**
   * A link to an external process or UI that can provide more information about the status.
   */
  externalLink: string serialized Url

  /**
   * The description of the status. Often shows up as a longer 1 line string describing the process producing the status.
   */
  description: string

  /**
   * The name or category of this status which often shows up as a 1 word way to differentiate between statuses.
   */
  name: string

  /**
   * The commit to post this status too. Services will associate the status with a pull request based off the commit.
   */
  sha: !string
}
