/**
 * Type to represent a repository for a given source control
 */
type SourceControlRepository {

  /**
   * Name of the repository, e.g. "c3server"
   */
  name: !string

  /**
   * full name with org and repository name, e.g. "c3-e/c3server"
   */
  fullName: string

  /**
   * the html url of the repository, e.g. "https://github.com/c3-e/c3server".
   */
  htmlUrl: string
}
