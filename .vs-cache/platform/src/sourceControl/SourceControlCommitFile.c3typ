/**
 * Represents a file in a {@link SourceControlCommit}
 */
type SourceControlCommitFile {

  /**
   * Number of added lines
   */
  additions: !int

  /**
   * Number changed lines
   */
  changes: !int

  /**
   * Number of deleted lines
   */
  deletions: !int

  /**
   * Name of the changed file
   */
  filename: !string

  /**
   * A small file indicating the changes made in the corresponding commit
   */
  patch: !string

  /**
   * Status of the file being changed (e.g 'modified')
   */
  status: !string
}
