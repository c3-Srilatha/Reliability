/**
 * Represents a pull request response from a REST call to a source control system
 */
type SourceControlPullRequest {

  /**
   * Status of the pull request
   */
  status: !string enum SourceControlPullRequestStatus

  /**
   * PR identifier in the source control system
   */
  number: !int

  /**
   * Url to the PR
   */
  url: !string

  /**
   * Whether or not pull request has been merged
   */
  merged: boolean

  /**
   * Head commit of the pull request
   */
  head: SourceControlCommit

  /**
   * The time at which this PR was last updated
   */
  updated: DateTime
}
