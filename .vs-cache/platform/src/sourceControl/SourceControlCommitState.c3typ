/**
 * Enum of the state of the {@link SourceControlCommitStatus}
 */
enum type SourceControlCommitState {

  /**
   * The commit is being built.
   */
  PENDING

  /**
   * The commit looks good.
   */
  SUCCESS

  /**
   * The commit has test failures.
   */
  FAILURE

  /**
   * The commit has errors.
   */
  ERROR
}
