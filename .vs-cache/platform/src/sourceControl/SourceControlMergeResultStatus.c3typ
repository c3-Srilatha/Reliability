/**
 * Represents a merge result between two commits from a REST call to a source control system
 */
enum type SourceControlMergeResultStatus {

  /**
   * Merge result success status
   */
  SUCCESS

  /**
   * Merge result fail status
   */
  FAIL

  /**
   * Merge result conflict status
   */
  CONFLICT
}
