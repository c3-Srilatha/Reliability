/**
 * A type representing the diff of a file between two commits.
 */
type SourceControlDiffPatch {

  /**
   * The patch for this file.
   */
  patch: ?string

  /**
   * The number of added lines.
   */
  additions: int

  /**
   * The number of removed lines.
   */
  deletions: int

  /**
   * The number of changed lines.
   */
  changes: int

  /**
   * Generate a patch by examining the line-by-line differences between the two strings.
   *
   * @param oldText
   *           The previous file text.  If this is a newly created file, this should be null or undefined.  An empty string
   *           is treated as a file with one blank line.
   * @param newText
   *           The previous file text.  If this is a deleted file, this should be null or undefined.  An empty string
   *           is treated as a file with one blank line.
   * @return a {@link SourceControlDiffPatch} containing the diffs
   */
  diffPatch: function(oldText: string, newText: string): SourceControlDiffPatch js-server
}
