/**
 * A spec type with several parameter options used in {@link SourceControlRestApi#getCommits}
 */
type SourceControlGetCommitsSpec {

  /**
   * Login or email address by which to filter by commit author.
   */
  author: string

  /**
   * Mumber of items to show per page
   */
  itemsPerPage: int

  /**
   * Page number, starting from 1
   */
  page: int

  /**
   * Only commits containing this file path will be returned.
   */
  path: string

  /**
   * Only commits after this date will be returned. This is a timestamp in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`.
   */
  since: string

  /**
   * Only commits before this date will be returned. This is a timestamp in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`.
   */
  until: string

  /**
   * SHA or branch to start listing commits from. Default: the repository’s default branch (usually master).
   */
  sha: string
}
