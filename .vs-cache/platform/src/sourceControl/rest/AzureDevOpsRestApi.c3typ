/**
 * Type to access AzureDevOps through REST.
 */
type AzureDevOpsRestApi mixes SourceControlRestApi<AzureDevOps> {

  sourceControlType: ~ = AZURE_DEVOPS

  /**
   * This sha is used for updateRefs() calls to represent a nonexistent branch.
   * It has 40 '0's.
   *
   * When creating a new branch, it should be used as the oldObjectId.  When deleting
   * a branch, it should be used as the newObjectId.
   */
  zeroSha: !string = '0000000000000000000000000000000000000000'

  /**
   * The number of times to check if a merge is successful.  Merging involves waiting for a
   * pull request to be completed, which happens asynchronously.
   */
  numMergeTries: int = 30

  /**
   * The number of seconds to wait between checking if a merge is successful.
   */
  secondsBetweenMergeRetries: int = 6

  /**
   * Name of organization.
   */
  organizationName: !string

  /**
   * Name of project.
   */
  projectName: !string

  /**
   * Sets repoUrl, sourceControlRepoName, projectName, and organizationName and returns the updated instance.
   */
  configureWithRepoUrl: ~ js-server

  /**
   * Use the Azure DevOps token to generate the basic authentication string for REST calls
   */
  getAuthFromToken: ~ js-server

  /**
   * Get the AzureDevOps token from the basic authentication string for REST calls
   */
  getTokenFromAuth: ~ js-server

  /**
   * Validate `token` for appropriate permissions to function well in C3 IDS.
   */
  validateToken: ~ js-server

  /**
   * Returns the https url to the UI of the source control system for the specified branch name.
   */
  getBranchUrl: ~ js-server

  /**
   * Return the content of the file.
   */
  getFileContent: ~ js-server

  /**
   * Checks if branch name already exists.
   */
  isBranchPresent: ~ js-server

  /**
   * Creates a branch off the given branch.
   */
  createBranchFromSrcBranch: ~ js-server

  /**
   * Creates a branch from the given sha.
   */
  createBranchFromSha: ~ js-server

  /**
   * Delete the branch.
   */
  deleteBranch: ~ js-server

  /**
   * Returns information of commits under the queried repository.
   */
  getCommits: ~ js-server

  /**
   * Returns information for a single commit in the queried repository for the specified SHA.
   */
  getCommitDetails: ~ js-server

  /**
   * Returns the url for a single commit for the specified SHA.
   */
  getCommitUrl: ~ js-server

  /**
   * Returns the source control system username for the user invoking this function.
   * This uses {@link AzureDevOps.profile}, which will fail if the auth token is not
   * configured for "All accessible organizations".
   */
  getMyUsername: ~ js-server

  /**
   * Returns the number of commits the head branch is ahead of the base branch, or compares the two SHAs
   */
  getCommitsAheadCount: ~ js-server

  /**
   * Get info for the given branch.
   */
  branch: ~ js-server

  /**
   * Gets the correct rest url endpoint for the given source system
   */
  getRestUrl: ~ js-server

  /**
   * Creates content on a branch
   */
  createContent: ~ js-server

  /**
   * Updates content on a branch
   */
  updateContent: ~ js-server

  /**
   * Helper function called by {@link AzureDevOpsRestApi.createContent} and {@link AzureDevOps.updateContent}
   */
  createOrUpdateContent: private member function(changeType: string enum('edit', 'add'),
                                                 path: !string,
                                                 message: !string,
                                                 content: !string,
                                                 branch: !string) js-server

  /**
   * Compares the HEAD of the head branch against the base branch, or compares two SHAs.
   */
  compare: ~ js-server

  /**
   * Performs a merge of one branch into another.  Unlike merge implementations for other
   * source control systems, this one does create a pull request, which is deleted when
   * the merge occurs.  This is because the merge REST API for Azure DevOps does not seem to work.
   */
  merge: ~ js-server

  /**
   * Reset target branch to same sha as source branch.
   */
  reset: ~ js-server

  /**
   * Checks the status of a pull request
   */
  getPullRequest: ~ js-server

  /**
   * Create a pull request
   */
  createPullRequest: ~ js-server

  /**
   * Decline a pull request
   */
  declinePullRequest: ~ js-server

  /**
   * Updates a given reference to the provided sha
   */
  updateReferenceToSha: ~ js-server

  getItemsInFolder: ~ js-server

  /**
   * Gets all the {@link SourceControlBranch}s
   */
  branches: ~ js-server

  /**
   * Gets all the open pull requests with their head commit
   */
  getOpenPullRequests: ~ js-server

  /**
   * Posts a status to a commit
   */
  postCommitStatus: ~ js-server

  /**
   * Download a repository to the C3 File System
   */
  downloadRepository: ~ js-server

  /**
   * get list of {@link SourceControlRepository}s
   */
  repositories: ~ js-server

  /**
   * Get all commit statuses for a ref
   */
  commitStatuses: member function(ref: !string): [json] js-server

  /**
   * check if the token and url on {@link SourceControlRestApi#restInst} are valid, throws otherwise
   */
  validateConfigTokenAndUrl: ~ js-server
}
