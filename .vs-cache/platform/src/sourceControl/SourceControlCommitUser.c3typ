/**
 * A user associated with a {@link SourceControlCommit}
 */
type SourceControlCommitUser {

  /**
   * Username in the source control system
   */
  name: !string

  /**
   * User email
   */
  email: !string

  /**
   * Date of the commit made by this user
   */
  date: !datetime
}
