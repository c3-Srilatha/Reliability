/**
 * Represents a commit from a REST call to a source control system
 */
type SourceControlCommit {

  /**
   * SHA of the commit
   */
  sha: !string

  /**
   * branch of the commit
   */
  ref: string

  /**
   * An array of files associated with this commit
   */
  files: ![SourceControlCommitFile]

  /**
   * Commit information details
   */
  commitInfo: !SourceControlCommitInfo

  /**
   * Commit url on source control system website
   */
  url: !string
}
