/**
 * Information about the operation being performed.
 */
@deprecated
type OperationInfo {

  /**
   * Name of the tenant
   */
  tenant: string

  /**
   * Name of the tag
   */
  tag: string

  /**
   * Name of the operation
   */
  name: string

  /**
   * User performing the operation
   */
  user: string

  /**
   * Success or failure
   */
  success: boolean

  /**
   * Reason for failure
   */
  error: string
}
