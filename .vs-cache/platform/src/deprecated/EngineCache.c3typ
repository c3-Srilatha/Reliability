/**
 * This cache contains running Engines. MultiTenantEngines are always cached under c3/c3 (only) while
 * SingleTenantEngines are cached under the tag in which they are defined.
 *
 * This means that MultiTenantEngines can only be provisioned once, but likely we will restrict them to platform types.
 *
 * @see Engine.Deprecated
 */
private type EngineCache mixes MetadataCacheOld<EngineCacheEntry>, Value {

  /**
   * @return information about instance for a given Engine type if running.
   */
  entry: function(typeName: !string): EngineCacheEntry

  /**
   * @return instance for a given Engine type (even if it's an external engine) if running.
   */
  inst: function(typeName: !string): Engine.Deprecated

  /**
   * @return running ExternalEngineSession for a given Engine type if it is an external engine and it's running.
   */
  externalEngineSession: function(typeName: !string): ExternalEngineSession

  /**
   * Instantiates Engine, places it in the cache and starts it.
   */
  startEngine: function(typeName: !string): !Engine.Deprecated

  /**
   * Evict instance of the engine if running.
   */
  evictEngine: function(typeName: !string): boolean

  release: ~
}
