@deprecated(finalVersion='7.9', details='see Deployment')
type DeployAppOptions {

  /**
   * Tag to which the package will be deployed. Defaults to current tag.
   */
  tag: string

  /**
   * Should provide full version. When provided, Package manager version in combination with package name will
   */
  packageVersion: string

  /**
   * If set then will reset all metadata for the tag. I.e. will not attempt to provision incrementally.
   */
  reset: boolean

  /**
   * If true keeps tag in invalid state if metadata files have errors.
   */
  doNotRevertStateOnError: boolean

  /**
   * When true, provision will conitnue with out waiting for current running actions.
   */
  doNotWaitForRunningActions: boolean

  /**
   * When true, tag reference/prod will not be upgraded.
   */
  skipReferenceProd: boolean

  /**
   * When true, test data is provisioned.
   */
  test: boolean
}
