/**
 * Seed data files have a number of supported formats, each format is defined by its MIME type.
 */
type SeedFileFormat {

  /**
   * The MIME type for this file type.  This will be a C3-specific MIME type
   * such as `application/vnd.c3.data+json` rather than the generic type (`application/json`).
   */
  mimeType: !string

  /**
   * The canonical extension for this file type, such as `.json`.
   */
  extension: !string

  /**
   * Create an empty seed data file for the specified type and return it.
   */
  create: member function(packageName: string, typeName: !string): ContentValue
}
