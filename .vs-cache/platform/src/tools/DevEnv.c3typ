/**
 * Manages the env for development purpose.
 */
@beta
type DevEnv {

  /**
   * Reserved app name for development in a single node Env.
   */
  DEV_APP_NAME: const string = 'dev'

  /**
   * RootPkg for `dev` app.
   */
  DEV_ROOTPKG: const string = 'ide'

  /**
   * Ensure `dev` app is started with rootPkg `ide` for the given {@link Env}. If not given, default to the current env.
   */
  @action(group+='env-admin')
  ensureDevApp: function(env: Env)
}
