/**
 * Supported kinds of notebooks.
 */
enum type Notebook.Kind {

  /**
   * Jupyter/JupyterLab notebooks.
   *
   * @see https://nbformat.readthedocs.io/en/latest/
   */
  IPYNB

  /**
   * C3 Console/VS Code notebooks.
   */
  C3NB

  /**
   * Get the normal file extension for this kind of notebook.
   */
  fileExt: function(kind: !?string enum Notebook.Kind, failIfInvalid: boolean): string

  /**
   * Get the normal file extension for this kind of notebook.
   */
  mediaType: function(kind: !?string enum Notebook.Kind, failIfInvalid: boolean): string enum MediaType

  /**
   * Pick the kind for the extension of the specified file.
   */
  fromFileExt: function(fileName: !?string, failIfInvalid: boolean): string enum Notebook.Kind

  /**
   * Pick the kind for the specified content type.
   */
  fromContentType: function(contentType: !?string serialized ContentType,
                            failIfInvalid: boolean): string enum Notebook.Kind
}
