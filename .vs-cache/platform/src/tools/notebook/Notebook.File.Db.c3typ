/**
 * Notebook file stored as a database entity.
 */
entity type Notebook.File.Db mixes Notebook.File, SeedData<Notebook.File.Db>, AclEnabled<Notebook.File.Db> schema name 'NB_FILE' {

  /**
   * Encoded content of this file.
   */
  encodedContent: ?binary

  hasMetadata: ~ not persistable

  @db(createOnly=true)
  kind: !~

  @db(createOnly=true)
  path: !~

  /**
   * Converts a file path to content location for database storage.
   *
   * @param path the file path
   * @return content location for database storage
   */
  pathToContentLocation: function(path: !string): !string
}
