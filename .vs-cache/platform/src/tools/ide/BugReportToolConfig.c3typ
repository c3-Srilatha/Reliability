/**
 * Handles the configurations for the bug report tool
 */
@config(minOverride='CLUSTER')
type BugReportToolConfig mixes Config, Singleton {

  /**
   * Flag to indicate whether the bug report tool is disabled
   */
  disabled: boolean

  /**
   * disable collecting server logs
   */
  logsDisabled: boolean

  /**
   * The number of minutes of server log history we want to collect
   */
  logHistoryTimeBoundary: int = 15

  /**
   * Enable attaching attachments
   */
  attachment: boolean

  /**
   * Enable collecting source code
   */
  srcCodeEnabled: boolean

  /**
   * Disable collecting C3 notebook
   */
  notebookDisabled: boolean

  /**
   * Disable test results
   */
  testResultsDisabled: boolean
  
  /**
   * Enable automatically creating Jira tickets
   */
  jiraEnabled: boolean
}
