/**
 * A reference to an action with some parameters pre-specified.
 * Additional parameters may be specified at the call time or the pre-specified parameters may be complete.
 */
type PartiallyAppliedAction mixes ActionRef {

  /**
   * The pre-specified parameters of the action, keyed by parameter name.
   */
  args: map<string, any>

  /**
   * Invoke the referenced action, specifying additional parameters if needed.
   * Any parameters specified here override those in {@link #args}.
   */
  apply: member function(extraArgs: map<string, any>): any

  /**
   * Return the JavaScript implementation of the partially applied action with args filled. Return value is a JavaScript
   * function declaration code.
   */
  jsImpl: member function(): !string

  /**
   * HTTP request for this action.
   */
  httpRequest: member function(cluster: string, tenant: string, tag: string): !HttpRequest

  /**
   * Curl command for this action.
   */
  curl: member function(cluster: string, tenant: string, tag: string): !string
}
