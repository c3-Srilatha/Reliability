/**
 * Job Run interface for asynchronous executor.
 */
@beta
abstract type AsyncJobRun<V, S> {

  /**
   * Returns {@link JobStatus} of the current run for the job
   */
  status: abstract member function(): !S

  /**
   * Returns {@link Promise} of the current run for the job
   */
  promise: abstract member function(): !Promise<V>
}
