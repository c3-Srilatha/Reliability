type JobRun<ST: BatchJobStatusBase> {

  /**
   * Id of the job that owns the run.
   */
  jobId: !string

  /**
   * The type of job that owns the run.
   */
  jobType: Type<<JobBase>>

  /**
   * Status of the current run for the job
   */
  status: !ST schema suffix 'S'

  /**
   * Time the run was started
   */
  started: !datetime

  /**
   * True if the job is about to be set to 'failed' status and we are calling the 'failed' callback or doing
   * auto recovery.
   */
  handlingFailed: private boolean

  /**
   * Used to keep track of who is calling 'failed' or performing auto recovery to avoid concurrency issues.
   */
  handleFailedToken: private string

  /**
   * If 'numAutoRecoveryAttempts' was set in the options while starting the job, the remaining number of attempts
   * available.
   */
  remainingAutoRecoveryAttempts: int

  /**
   * Determines if a job has completed the 'failing' process (e.g. all of its relevant queue entries are exhausted).
   *
   * @param job
   *        Job to check.
   *
   * @return True if the job has completed the 'failing' process (e.g. all of its relevant queue entries are exhausted).
   */
  isFailComplete: private abstract member function(job: !JobBase): boolean

  /**
   * Determines if a job has completed the 'canceling' process (e.g. all of its relevant queue entries are gone).
   *
   * @param job
   *        Job to check.
   *
   * @return True if the job has completed the 'canceling' process (e.g. all of its relevant queue entries are gone).
   */
  isCancelComplete: private abstract member function(job: !JobBase): boolean

  /**
   * Sets the status of the job to 'failed'.  If the job's type overrides 'failed' or specifies auto recovery,
   * those things are processed in lieu of setting the status.
   *
   * @param job
   *        Job to check.
   *
   * @return The resulting job run.
   */
  setStatusFailed: private member function(job: !JobBase): JobRun<ST>

  /**
   * Checks the state when 'callingAutoRecovery' or 'callingFailed' is true.  If either is true and there is
   * no action handling them (can happen if server goes down during 'setStatusFailed') and clears them if that
   * is the case
   *
   * @param job
   *        Job to check
   *
   * @return Update job run.
   */
  checkHandlingFailed: private member function(job: !JobBase): JobRun<ST>

  /**
   * Sets the status of the job to 'canceled'.
   *
   * @param job
   *        Job to check.
   *
   * @return The resulting job run.
   */
  setStatusCanceled: private member function(job: !JobBase): JobRun<ST>

  /**
   * Calls the 'failed' override for the job.
   * @param job
   *        Job to call 'failed' on.
   */
  callFailed: private abstract member function(job: !JobBase)

  /**
   * Calls recover for the job.
   * @param job
   *        Job to call recover on.
   */
  callRecover: private abstract member function(job: !JobBase)

  /**
   * Display a flamegraph of the C3 actions for the `Workflow.Run`-like object
   */
  flamegraph: member function(): native py

  /**
   * Given a list of actions, returns the data required for a flamegraph with the following fields (note that depending on the entry, some fields may be missing):
   *    name: abbreviated name of the action (when [type name]#[action name] is longer than 20 characters, the beginning part of type name is truncated)
   *    value: total time in milliseconds for the action and all of its descendant actions to complete
   *    time: start time of the action
   *    id: action id
   *    asyncParent: id of the parent action in the async tree
   *    parent: id of the parent action in the action tree
   *    asyncRoot: id of the root action in the async tree
   *    nameLong: full name of the action (format: [type name]#[action name])
   *    root: id of the root action in the action tree
   *    children: list of child actions (same format as this object)
   * @return json of flamegraph data
   */
  flamegraphJson: member function(): json py-server

  /**
   * Action ID for where the Job Run is defined. In this case, this is the asyncRootId of all actions in the job run.
   */
  startingActionId: !string
}
