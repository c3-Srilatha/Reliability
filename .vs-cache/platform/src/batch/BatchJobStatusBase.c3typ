type BatchJobStatusBase mixes JobStatus {

  /**
   * Errors for the current run.  Only the ids are persisted.  However, the full detail will be populated when
   * calling the `status` function on the job.
   */
  errors: [JobRunErrorDetail] schema suffix 'ERR'

  /**
   * @return true if the job has errors.
   */
  hasErrors: inline member function(): !boolean

  /**
   * @return concatenation of all of the error objs for a status jsonified.
   */
  errorLog: member function(): string
}
