/**
 * A Generic EventNotifier that can be used to send events to clients through {@link EventStream}.
 * This class is responsible for creating eventStreams and writing events to all the pushStreams.
 */
abstract inline type EventNotifier<T> mixes Stateful, Mutable {

  /**
   * list of PushStreams backing EventStreams that are listened to.
   */
  pushStreams: [PushStream<T>]

  /**
   * Creates a new EventStream that can be listened to.
   */
  create: member function(): EventStream<T>

  /**
   * Writes an event to all the pushStreams.
   */
  writeEvent: member function(event: T)

  /**
   * Returns true if there are no pushStreams listening to the EventNotifier.
   */
  isEmpty: member function(): boolean
}
