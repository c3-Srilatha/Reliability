/**
 * An entity in charge of processing {@link C3Request}s once they have been approved or denied.
 * Used to run an idempotent and eventually consistent lambda upon decision.
 *
 * The appropriate lambda is guaranteed to be run from start to finish at least once.
 * If provided, the @{link #onApprove} and {@link #onDeny} lambdas must be idempotent and eventually consistent.
 * This is to make request processing resilient to resource re-allocations, network failures, and the like.
 * There is a small chance that 2 threads might be processing the same request at the same time in case of a network outage.
 *
 * By default, if no appropriate lambda is provided, the default behavior will be to return a "SUCCESS" result.
 */
@db(unique=["topic"])
entity type C3Request.Processor {

  /**
   * The {@link C3Request#topic} which this processor is in charge of processing.
   * Only 1 processor per topic is allowed.
   */
  topic: !string

  /**
   * The lambda to run upon request approval.
   */
  onApprove: lambda(request: C3Request): C3Request.Processor.Result

  /**
   * The lambda to run upon request denial.
   */
  onDeny: lambda(request: C3Request): C3Request.Processor.Result

  /**
   * The lambda to run upon request cancellation.
   */
  onCancel: lambda(request: C3Request): C3Request.Processor.Result
}
