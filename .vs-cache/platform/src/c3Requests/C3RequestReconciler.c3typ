/**
 * Utility type that performs recovery logic for any requests that did not finish while processing.
 */
type C3RequestReconciler {

  /**
   * Runs through all unprocessed requests and ensures that there is an {@link ActionQueue} entry for each.
   */
  processAll: function() js-server
}
