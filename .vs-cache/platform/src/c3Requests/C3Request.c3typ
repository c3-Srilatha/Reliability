/**
 * Provides a base class for request entities.
 * {@link C3Request#state} has an expected linear progression:
 * - Creation: PENDING
 * - Decision: PENDING -> APPROVING | PENDING -> DENYING | PENDING -> CANCELLING
 * - Processing: APPROVING -> APPROVED | DENYING -> DENIED | CANCELLING -> CANCELLED
 */
abstract entity type C3Request mixes Identified, C3RequestFields {

  /**
   * A transient id describing the most recent {@link ActionQueue} entry attempting to process this request.
   * This field can be inaccurate at any point in time. Request processors must be idempotent, and it is possible
   * for two or more {@link ActionQueue} entries to exist at the same time for any request.
   */
  actionQueueEntryObjId: private string

  /**
   * The timestamp at which the most recent {@link ActionQueue} entry attempting to process this request was submitted.
   * This field can be inaccurate at any point in time. Request processors must be idempotent, and it is possible
   * for two or more {@link ActionQueue} entries to exist at the same time for any request.
   */
  processSubmitted: private datetime

  /**
   * Transitions {@link #state} from PENDING to APPROVING and submits an action to the {@link ActionQueue}
   * to process this request using {@link #process}.
   */
  @dependency(include='state')
  approve: final member function(deciderSpec: C3Request.DeciderSpec) js-server

  /**
   * Transitions {@link #state} from PENDING to DENYING and submits an action to the {@link ActionQueue}
   * to process this request using {@link #process}.
   */
  @dependency(include='state')
  deny: final member function(deciderSpec: C3Request.DeciderSpec) js-server

  /**
   * Cancels the request prior to a decision being made by an approver.
   * Transitions {@link #state} from PENDING to CANCELLING and submits an action to the {@link ActionQueue}
   * to process this request using {@link #process}.
   */
  @dependency(include='state')
  cancel: final member function(deciderSpec: C3Request.DeciderSpec) js-server

  /**
   * Finds the appropriate {@link C3Request.Processor} and calls {@link C3Request.Processor#onApprove} or
   * {@link C3Request.Processor#onDeny} depending on the value of {@link #state}.
   * If no {@link C3Request.Processor} is found, {@link #processed} is set to true, and the error is logged in
   * {@link #error}.
   */
  process: private member function() js-server

  /**
   * Submits an entry to the {@link ActionQueue} for this request to be processed using {@link #process}.
   * If {@link actionQueueEntryObjId} is set, the action is guarenteed to have been successfully submitted to
   * the {@link ActionQueue}.
   */
  submitActionQueueEntry: private member function() js-server

  /**
   * Formats an error message for a request that has no corresponding {@link C3Request.Processor}.
   */
  noProcessorError: private member function() js-server

  /**
   * Formats an error message for a request with no {@link #topic}.
   */
  noTopicError: private member function() js-server

  /**
   * Ensures that all required fields are present and overrides every field except {@link #topic} and {@link #message}
   * to their appropriate defaults. If the non-abstract request type has additional fields
   * beyond the base {@link C3Request} fields, they are untouched.
   */
  beforeCreate: ~ js-server
}
