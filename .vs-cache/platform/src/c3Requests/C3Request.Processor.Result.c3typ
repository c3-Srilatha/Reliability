/**
 * The return value of {@link C3Request.Processor} lambdas which process approvals and denials.
 * These fields live on {@link C3Request}, and will be merged into the processed request.
 */
type C3Request.Processor.Result {

  /**
   * The status of processing a request.
   */
  status: string enum C3Request.Status

  /**
   * A generic string field that can hold information regarding the request's processing.
   * The lambda can set this field to arbitrary values.
   * Could be serialized data structures, or just a basic message.
   */
  result: string

  /**
   * A generic string field that can hold information regarding the request's processing.
   * The lambda can set this field to arbitrary values.
   * Could be serialized data structures, or just a basic message.
   */
  error: string
}
