type Vertx mixes Singleton, Mutable, Value {

  start:     member function(port: !int32, allowDuplicateServer: boolean)
  stop:      member function()
  client:    private member function(): @java(class='io.vertx.ext.web.client.WebClient') !native
  port:      private member function(): !int32
  ipAddress: private member function(): !string
}
