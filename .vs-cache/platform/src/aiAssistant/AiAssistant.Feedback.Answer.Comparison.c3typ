/**
 * The comparison given by the user between the base/original answer and the reference/new answer.
 */
type AiAssistant.Feedback.Answer.Comparison {

  /**
   * The base {@link AiAssistant.Feedback.Answer} that the reference {@link AiAssistant.Feedback.Answer} is being compared to.
   */
  baseAnswer: !AiAssistant.Feedback.Answer

  /**
   * The reference @link AiAssistant.Feedback.Answer} that the base @link AiAssistant.Feedback.Answer} is being compared to.
   */
  referenceAnswer: !AiAssistant.Feedback.Answer

  /**
   * The comparison given by the user between the base feedback and the reference response.
   */
  comparison: !string enum AiAssistant.Feedback.Answer.ComparisonEnum
}
