/**
 * The actual feedback given by the user for the answer given for a {@link AiAssistant.FeedbackContext#query} by the AI Assistant.
 */
@deprecated(details="All functionality is now moved to AiAssistant.Feedback.Answer")
type AiAssistant.Feedback {

  /**
   * The answer that was given by the AI Assistant
   */
  answer: !string

  /**
   * The reaction of the user to the answer
   */
  reaction: string enum AiAssistant.Feedback.Answer.Reaction

  /**
   * The feedback given by the user for the answer
   */
  feedback: string

  /**
   * The desired answer that the user expected from the AI Assistant
   */
  desiredAnswer: string

  /**
   * The categories of the feedback
   */
  feedbackCategories: [string enum AiAssistant.Feedback.Answer.Category]
}
