/**
 * The parameters to {@link AiAssistant#askV2}.
 */
type AiAssistant.AskParams.V2 {

  /**
   * The current question being asked by the user.
   */
  question: !string

  /**
   * The id of the chat 'session' in which this question was asked.
   */
  chatId: string

  /**
   * For questions related to c3 code, this should specify the server version for which documentation should be searched
   * If not supplied, the latest version available to the code assistant will be used.
   */
  serverVersion: string serialized SemanticVersion

  /**
   * Keyword arguments related to the query. This is intentionally **NOT** strongly typed to accommodate
   * the need for cross-version client and server compatibility.
   */
  questionKwargs: json

  /**
   * The client from which the ask request is sent
   */
  client: string enum AiAssistant.ClientType

  /**
   * This is the chat history that the user has with the assistant until the last query.
   *
   * See {@link AiAssistant.Feedback.Question#chatHistory} for more details.
   */
  chatHistory: [AiAssistant.QAPair.V2]

  /**
   * Number of times the user has requested for a response for the same question.
   * `0` would be the first response, `1` would be first regeneration request, and so on.
   */
  regenerationCount: int
}
