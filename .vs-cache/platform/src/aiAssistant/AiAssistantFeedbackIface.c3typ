/**
 * The interface for interacting with {@link AiAssistantFeedback}.
 */
abstract type AiAssistantFeedbackIface mixes Microservice.Iface, Singleton {

  /**
   * Saves the feedback given by the user for a question and answer generated by the AI Assistant and returns the upserted db ids for {@link AiAssistant.FeedbackContext} and the {@link AiAssistant.Feedback}.
   *
   * If the existing records needs to be updated, the feedbackContextId and feedbackId should be passed as part of the spec.
   *
   * @param feedbackContextSpec
   *     The specification of the feedback context that needs to be upserted or updated.
   *        If the feedbackContextSpec doesn't have feedbackContextId, a new {@link AiAssistant.FeedbackContext} will be upserted.
   *        If the feedbackContextSpec has feedbackContextId, the existing FeedbackContext will be updated with feedback.
   *
   * @param feedbackSpec
   *    The specification of the feedback that needs to be upserted or updated.
   *        If the feedbackSpec doesn't have feedbackId, a new {@link AiAssistant.Feedback} will be upserted, and the id will be appended to {@link AiAssistant.FeedbackContext#feedbacks}.
   *        If the feedbackSpec has feedbackId, the existing feedback entry in the db will be updated with fields passed as part of the spec.
   *
   * @return A pair of feedbackContextId and feedbackId upserted to the db.
   */
  @deprecated
  saveFeedback: abstract function(feedbackContextSpec: AiAssistant.FeedbackContextSpec,
                                  feedbackSpec: AiAssistant.FeedbackSpec): !Pair<!string, !string>

  /**
   * Saves the feedback given by the user for a question and answer generated by the AI Assistant and
   * returns the upserted db ids for {@link AiAssistant.Feedback.Question} and the {@link AiAssistant.Feedback.Answer}.
   *
   * If the existing records needs to be updated, the feedbackQuestionId and feedbackAnswerId should be passed as part of the spec.
   *
   * @param feedbackQuestionSpec
   *     The specification of the feedback question that needs to be upserted or updated.
   *        If the feedbackQuestionSpec doesn't have feedbackQuestionId, a new {@link AiAssistantFeedbackService.Feedback.Question} will be upserted.
   *        If the feedbackQuestionSpec has feedbackQuestionId, the existing Feedback.Question will be updated with feedback.
   *
   * @param feedbackAnswerSpec
   *    The specification of the feedback answer that needs to be upserted or updated.
   *        If the feedbackAnswerSpec doesn't have feedbackAnswerId, a new {@link AiAssistantFeedbackService.Feedback.Answer} will be upserted, and the id will be added to {@link AiAssistant.FeedbackQuestion#answers}.
   *        If the feedbackAnswerSpec has feedbackAnswerId, the existing Feedback.Answer entry in the db will be updated with fields passed as part of the spec.
   *
   * @return A pair of feedbackQuestionId and feedbackAnswerId upserted to the db.
   */
  saveFeedback: abstract function(feedbackQuestionSpec: AiAssistant.Feedback.QuestionSpec,
                                  feedbackAnswerSpec: AiAssistant.Feedback.AnswerSpec): !Pair<!string, !string>

  /**
   * Saves the comparison for 2 answers generated by the co-pilot and returns the upserted db ids for {@link AiAssistantFeedbackService.Feedback.Question}, and the 2 {@link AiAssistantFeedbackService.Feedback.Answer}.
   * See {@link AiAssistantFeedbackService.Feedback.Question#answerComparisons} for more information
   *
   * If any of the question, and the 2 answers are not present in the db, they will be upserted first.
   *
   * @param feedbackQuestionSpec
   *     The specification of the feedback question that needs to be upserted or updated.
   *        If the feedbackQuestionSpec doesn't have feedbackQuestionId, a new {@link AiAssistantFeedbackService.Feedback.Question} will be upserted.
   *        If the feedbackQuestionSpec has feedbackQuestionId, the existing Feedback.Question will be updated with feedback.
   *
   * @param baseAnswerSpec
   *    The specification of the base answer for which the comparison is being stored
   *        If the feedbackAnswerSpec doesn't have feedbackAnswerId, a new {@link AiAssistantFeedbackService.Feedback.Answer} will be upserted, and the id will be added to {@link AiAssistant.FeedbackQuestion#answers}.
   *        If the feedbackAnswerSpec has feedbackAnswerId, the existing Feedback.Answer entry in the db will be updated with fields passed as part of the spec.
   *
   * @param referenceAnswerSpec
   *    The specification of the reference answer for which the comparison is being stored
   *        If the feedbackAnswerSpec doesn't have feedbackAnswerId, a new {@link AiAssistantFeedbackService.Feedback.Answer} will be upserted, and the id will be added to {@link AiAssistant.FeedbackQuestion#answers}.
   *        If the feedbackAnswerSpec has feedbackAnswerId, the existing Feedback.Answer entry in the db will be updated with fields passed as part of the spec.
   *
   * @param answerComparison
   *    The comparison between the base answer and the reference answer. See {@link AiAssistant.Feedback.Answer.ComparisonEnum} for the possible values.
   *
   * @return A triple of feedbackQuestionId, baseAnswerId, and referenceAnswerId upserted to the db.
   */
  saveFeedbackComparison: abstract function(feedbackQuestionSpec: !AiAssistant.Feedback.QuestionSpec,
                                            baseAnswerSpec: !AiAssistant.Feedback.AnswerSpec,
                                            referenceAnswerSpec: !AiAssistant.Feedback.AnswerSpec,
                                            answerComparison: !AiAssistant.Feedback.Answer.ComparisonEnum)
                                     : !Triple<!string, !string, !string>
}
