/**
 * The feedback given by the user for the answer given for a {@link AiAssistant.FeedbackContext#query} by the AI Assistant.
 */
@deprecated(details="All functionality is now moved to AiAssistant.Feedback.Question")
type AiAssistant.FeedbackContext {

  /**
   * The query for which the feedback is given.
   */
  query: !string

  /**
   * Server version of the client Application.
   */
  serverVersion: !string

  /**
   * Chat history of the user with the assistant.
   * The elements of the array are in increasing order of time. i.e. last element is the most recent {@link AiAssistant.QAPair}.
   */
  chatHistory: [AiAssistant.QAPair]

  /**
   * The client service from which the feedback is given. Could be jupyter, VSCE, community, etc.
   */
  client: !string enum AiAssistant.ClientType

  /**
   * List of upserted {@link AiAssistant.Feedback} ids given by the user for this query.
   */
  feedbackIds: ![string]

  /**
   * Information regarding the model used for generating the response. See {@link AiAssistant.ModelMetadata}.
   */
  modelMetadata: AiAssistant.ModelMetadata
}
