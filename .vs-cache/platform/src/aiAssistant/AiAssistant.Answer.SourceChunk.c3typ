/**
 * One of the pieces of a source document used to answer the user's question. {@see AiAssistant#askV2}
 */
type AiAssistant.Answer.SourceChunk {

  /**
   * The path to the source document from which this chunk came. This path is the relative
   * path within the documentation zip file used to populate the assistant's vector store.
   */
  sourcePath: !string

  /**
   * The content of the chunk
   */
  content: !string

  /**
   * Additional metadata related to the chunk
   */
  metadata: json
}
