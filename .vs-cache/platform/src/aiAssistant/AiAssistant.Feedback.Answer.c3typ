/**
 * The actual feedback given by the user for the answer given for a {@link AiAssistant.Feedback.Query#query} by the AI Assistant.
 */
extendable entity type AiAssistant.Feedback.Answer {

  /**
   * The answer that was given by the AI Assistant
   */
  answer: !string

  /**
   * The {@link AiAssistant.Feedback.Question} for which the feedback was given.
   */
  question: AiAssistant.Feedback.Question

  /**
   * The feedback given by the user for the answer
   */
  feedback: AiAssistant.AnswerFeedback
}
