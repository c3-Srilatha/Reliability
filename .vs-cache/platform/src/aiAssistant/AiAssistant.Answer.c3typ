/**
 * `AiAssistant.Answer` defines the response to an {@link AiAssistant#ask} request.
 */
type AiAssistant.Answer {

  /**
   * The answer
   */
  answer: !string

  /**
   * The id of the chat 'session' for this answer
   */
  chatId: string

  /**
   * The sources used to help generate the #answer
   */
  sources: [AiAssistant.Answer.SourceChunk]

  /**
   * Any additional metadata related to the #answer
   */
  answerMetadata: json
}
