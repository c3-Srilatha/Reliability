type AiAssistant mixes Configurable<AiAssistant.Config>, Singleton {

  /**
   * Make a request to the AiAssistant.
   * @param askParams
   *                The details of the request
   * @return the answer
   */
  @deprecated(details="Replaced by askV2", finalVersion="8.10")
  ask: member function(askParams: !AiAssistant.AskParams): string

  /**
   * Make a request to the AiAssistant using the {@link Microservice} with name `AiAssistant`
   * @param askParams
   *                The details of the request
   * @return the answer
   */
  askV2: member function(askParams: !AiAssistant.AskParams.V2): !AiAssistant.Answer
}
