/**
 * Configuration for the C3 AI Assistant feature in Jupyter and VS Code.
 */
@config(minOverride='APP', maxOverride='CLUSTER')
type AiAssistant.Config mixes Config, Singleton {

  /**
   * Indicates if the C3 AI assistant feature is enabled.
   */
  enabled: boolean

  /**
   * Default timeout in seconds of all AiAssistant requests
   */
  requestTimeout: int = 120

  /**
   * Indicates if the C3 AI assistant feedback service is enabled.
   * If feedback is disabled, the feedback capabilities of the UI should be removed.
   */
  feedbackEnabled: boolean

  /**
   * The maximum number of {@link AiAssistant.QAPair}s to pass to {@link AiAssistant#ask}
   * and persist in the {@link AiAssistant.FeedbackContext#chatHistory}.
   */
  chatHistoryLimit: int = 20

  /**
   * The proxy name for the middleware to be used for the C3 AI assistant requests.
   */
  middlewareProxyName: string

  /**
   * The name of the {@link AiAssistant.Microservice} that should be used for calls to {@link AiAssistant#askV2}.
   */
  askV2MicroserviceName: string = "AiAssistant"
}
