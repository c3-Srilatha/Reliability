/**
 * A spec used to help bind the fields of {@link AiAssistant.Feedback.Answer} to save the feedback for the answer.
 */
type AiAssistant.Feedback.AnswerSpec extends AiAssistant.Feedback.Answer type key 'AFAS' {

  /**
   * The database id of the upserted {@link AiAssistant.Feedback.Answer}.
   */
  feedbackAnswerId: string
}
