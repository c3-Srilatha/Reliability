/**
 * A spec used to help bind the fields of {@link AiAssistant.FeedbackContext} together for the saving the Feedback Context.
 */
@deprecated(details="All functionality is now moved to AiAssistant.Feedback.QuerySpec")
type AiAssistant.FeedbackContextSpec mixes AiAssistant.FeedbackContext {

  /**
   * The database id of the upserted {@link AiAssistant.FeedbackContext}.
   */
  feedbackContextId: string
}
