/**
 * A spec used to help bind the fields of {@link AiAssistant.Feedback.Query} together for the saving the Feedback Context.
 */
type AiAssistant.Feedback.QuestionSpec extends AiAssistant.Feedback.Question type key 'AFQS' {

  /**
   * The database id of the upserted {@link AiAssistant.Feedback.Question}.
   */
  feedbackQuestionId: string
}
