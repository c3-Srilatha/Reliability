/**
 * Options to generate the TypeScript declaration file.
 */
@deprecated(finalVersion='7', details='This feature will be replaced by {@link ApiGenerator} in version 8')
type TypeScriptApiGeneratorSpec mixes Spec {

  /**
   * If true, ignore methods.
   */
  noMethods: boolean

  /**
   * If true, do not include documentation.
   */
  noDocumentation: boolean

  /**
   * If true, do not include the unmade form of the types.
   */
  noUnmadeType: boolean
}
