/**
 * The tiers of the API support by the remote SDK.
 *
 * @see ServerConnection
 */
enum type Remote.Tier {

  /**
   * The lowest level tier supports only unprocessed REST request, taking JSON and returning JSON.
   */
  REST

  /**
   * The middle tier supports calling methods by name, but only through proxies. All requests remote for implementation.
   *
   * @see ServerConnection#thinTypeSystem
   * @see ServerConnection#asyncThinTypeSystem
   */
  THIN

  /**
   * The richest tier supports calling methods by name and getting more fully-formed instances of the types that
   * support conversion and local behavior.
   *
   * @see ServerConnection#typeSystem
   * @see ServerConnection#asyncTypeSystem
   */
  FULL
}
