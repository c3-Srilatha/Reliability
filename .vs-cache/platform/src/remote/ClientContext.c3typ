/**
 * Information on the current server state for which the client is operating.
 */
type ClientContext {

  /**
   * The user logged in.
   */
  user: UserContext

  /**
   * The application name at connection time.
   */
  app: string

  /**
   * Authentication string.
   */
  auth: string

  /**
   * Authentication time to live.
   */
  validUntil: datetime

  /**
   * If a vanity URL was used by the client, the hostname associated with that vanity URL.
   */
  vanityUrlHost: string
}
