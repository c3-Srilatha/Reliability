type Remote.PyTypeLoader mixes Remote.TypeLoader {

  /**
   * Return all types necessary for bootstrapping the py-client SDK. This list differs among SDKs due to differing
   * implementation.
   */
  bootstrapTypes: ~

  persistableRelatedTypes: ~

  /**
   * Returns an indexed map of all the file paths and their corresponding source code necessary for
   * Python client side bootstrapping by bundling several requests for bootstrapping-necessary metadata into one call
   * and endpoint.
   * @param debug
   *           Whether to include the code to support Python debugging
   */
  bootstrapSourceCodeAndFilePaths: function(debug: boolean): @indexed map<string serialized Pkg.Path, string>

  /**
   * @return metadata for the input types for a particular {@Link Action.Engine}.
   */
  metaJsons: function(typeNames: ![string],
                      actionEngine: !string serialized Action.Engine,
                      skipTypes: [string]): map<string, json>

  /**
   * @return metadata of all bootstrap types for the py-client SDK.
   */
  bootstrapMetaJsons: cached function(actionEngine: !string serialized Action.Engine): map<string, json>

  /**
   * @return metadata necessary to make a fetch call on Persistable for the py-client SDK.
   */
  persistableRelatedMetaJsons: cached function(actionEngine: !string serialized Action.Engine): map<string, json>
}
