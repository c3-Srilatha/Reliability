type ClientDispatcherSpec mixes Spec {

  host:          !string
  port:          !int
  ssl:           boolean
  proxyHost:     string
  proxyPort:     int
  proxySsl:      boolean
  username:      string
  password:      string
  authToken:     string
  timeoutInSecs: int

  /**
   * Duration of dispatcher session token in minutes. Note that this value can be overridden or limited in the server.
   */
  requestedSessionDurationMin: int

  errorCallback: @java(class="java.util.function.Consumer<Exception>") native
}
