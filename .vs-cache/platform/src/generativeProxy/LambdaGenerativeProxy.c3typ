/**
 * A {@link Lambda lambda}-based implementation of {@link GenerativeProxy} that can be used for testing or quick
 * experimentation.
 */
@beta
type LambdaGenerativeProxy mixes GenerativeProxy<LambdaGenerativeProxy.Config> {

  /**
   * Helper method for creating {@link LambdaGenerativeProxy.Config} and setting it with specified override level.
   *
   * @param name
   *           The name for this {@link LambdaGenerativeProxy}.
   * @param _lambda
   *           Lambda function that will be used for processing completions.
   * @param override
   *           Override level for the {@link LambdaGenerativeProxy.Config config}. Will be `App` if not specified.
   * @return Returns instance of {@link LambdaGenerativeProxy} with specified configuration.
   *
   * @see LambdaGenerativeProxy#from_py.
   */
  fromLambda: function(name: !string,
                       _lambda: !lambda(params: !GenerativeProxy.CompletionSpec): !GenerativeProxy.Completion,
                       override: string enum ConfigOverride = ConfigOverride.APP): !LambdaGenerativeProxy
}
