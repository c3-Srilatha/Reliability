/**
 * Question and Answer pairs to keep the conversation history.
 */
@beta
type QuestionAnswerPair {

  /**
   * The query that was asked.
   */
  @deprecated(details="Replaced by QuestionAnswerPair#question")
  query: string

  /**
   * The question that was asked.
   */
  question: string

  /**
   * Any additional arguments (e.g. a source filter) for the question.
   */
  questionKwargs: json

  /**
   * The answer that was given to the {@link #query}.
   */
  answer: !string

  /**
   * Any additional metadata (e.g. source documents used to answer)
   */
  answerMetadata: json
}
