/**
 * {@link Engine.Periodic} that runs on each {@link App.Node} in the {@link Cluster} and calls {@link #ensure} periodically.
 */
abstract type Controller mixes Engine.Periodic, Configurable<Controller.Config> {

  task: ~

  /**
   * Called from dedicated java thread every {@link Controller.Config#syncIntervalMilliSeconds} on each {@link App.Node}.
   */
  ensure: abstract inline member function()
}
