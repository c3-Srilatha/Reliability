/**
 * Container for EnvLog and performing evalMetric. The functions which its name contains "remote" are making REST call
 * to all-env to perform fetch on EnvLogs or evalMetric and list on EnvReport.
 */
@facade(cluster='https://stage-c3e.c3-e.com:443/', tenant='c3e', tag='prod')
extendable entity type EnvReport mixes MetricEvaluatable, SeedData<EnvReport> type key 'ENVRPT' schema name 'ENV_RPT' {

  /**
   * Stored corresponding EnvLogs.
   */
  envLogs: [EnvLog](category, id)

  /**
   * Fetch envLogs from all-env according to client's cluster, tenant and tag
   *
   * @param spec
   *          Specification of what data to fetch. If not specified, all objs of EnvLog will be returned.
   * @return EnvLog objs.
   */
  remoteFetchEnvLogs: function(spec: FetchSpec): !FetchResult<EnvLog>

  /**
   * Upsert multiple envLog instance of same subType to all-env. Basically, it is making a REST call to all-env and do
   * upsertBatch action on the objs
   *
   * @param envLogs
   *           Updated or new envLogs.
   * @param srcEnvLogs
   *           If specified, the actual update to the envLogs will be only the diff between the envLogs and its corresponding srcEnvLogs.  If
   *           not specified, the envLogs will completely replace the existing one if it does not already exist.
   * @param spec
   *           Various parameters that control the operation of function.
   * @return list of created or updated objs and any errors encountered
   */
  remoteUpsertEnvLogs: function(objs: !?[EnvLog], srcObjs: [EnvLog], spec: UpsertSpec): ObjList<EnvLog>

  /**
   * List envReports from all-env according to client's cluster, tenant and tag
   *
   * @param spec
   *          Specification of what data to fetch.  If not specified, all objs will be returned for EnvReport.
   * @return EnvReport objs.
   */
  remoteListEnvReports: function(): [EnvReport]

  /**
   * Perform metric evaluation on envLogs from all-env according to client's cluster, tenant and tag
   *
   * @param spec
   *          the spec which specifies the sourceId / start / end / metricName / grain
   * @return a Timeseries of eval result based on spec.
   */
  remoteEvalMetric: function(spec: !EvalMetricSpec): Timeseries

  /**
   * Get all the SimpleMetrics and CompoundMetrics for envLogs
   *
   * @return a list of metrics
   */
  remoteListMetrics: function(): [Metric]
}
