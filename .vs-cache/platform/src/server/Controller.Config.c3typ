/**
 * Configuration for {@link Controller}.
 *
 * Allowing min {@link ConfigOverride#APP} because {@link Controller} is running for an {@link App}.
 */
@config(minOverride=APP)
type Controller.Config mixes ConfigNamed {

  /**
   * Delay between running {@link Controller#ensure} method.
   *
   * More frequent calls will result in faster synchronization, but will increase load on the c3 cluster.
   */
  syncIntervalMilliSeconds: int
}
