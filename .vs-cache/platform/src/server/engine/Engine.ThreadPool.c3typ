/**
 * Base type for Engines that execute all actions (besides start/stop) in a dedicated thread pool.
 * NOTE: for now, Engine.ThreadPools are unique per subtype-app-node combination.
 */
@beta
@deprecated(finalVersion='8.9', details="Migrate to Engine")
abstract private type Engine.ThreadPool mixes Engine.Deprecated, DefaultInstance {

  /**
   * If implemented, will be invoked when the engine is started.
   *
   * See #onThreadStart if per-thread startup logic is necessary.
   */
  onStart: optional member function()

  /**
   * If implemented, will be invoked in each thread belonging to the engine's threadpool when the thread is started.
   */
  onThreadStart: optional member function()

  /**
   * If implemented, will be invoked when the engine is stopped.
   *
   * See #onThreadStop if per-thread stopping logic is necessary.
   */
  onStop: optional member function()

  /**
   * If implemented, will be invoked in each thread belonging to the engine's threadpool when the thread is stopped.
   */
  onThreadStop: optional member function()

  /**
   * Made final to handle thread pool setup. See #doStart if additional startup logic is required for your engine.
   */
  start: final ~

  /**
   * Made final to handle thread pool shutdown. See #doStop if additional stopping logic is required for your engine.
   */
  stop: final ~

  /**
   * Made final to handle thread pool shutdown. See #doStop if additional stopping logic is required for your engine.
   */
  shutdown: final ~
}
