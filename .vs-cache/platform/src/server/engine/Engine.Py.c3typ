/**
 * Specialized {@link Engine} that executes all actions in a persistent Python (py4j) process.
 * For now, any subtype of Py.Engine can only have one instance per node. All Python-implemented methods on a Py.Engine
 * must use the same {@link ImplLanguage.Runtime}. For now, only the {@link Py4jExecutor} can be used.
 *
 * NOTE: for now, all code in an Engine.Py that uses global variables to maintain state must live in a single engine
 * type and cannot be inherited
 */
@beta
@deprecated(finalVersion='8.9', details="Migrate to Engine")
abstract type Engine.Py mixes Engine.ThreadPool {

  inst: ~

  // TODO: figure out why this doesn't work...
  // runtime: const string serialized ImplLanguage.Runtime

  /**
   * Any custom startup logic for your engine should be implemented in pySetup and claimed in #runtime.
   * `onPyProcessStart` will execute in each Python process belonging to the engine when it is started.
   */
  onPyProcessStart: optional member function()

  /**
   * Made final to handle Python process initialization. Use #onPyProcessStart to implement any custom logic needed
   * to set up your engine within each Python process belonging to the engine.
   */
  onThreadStart: final ~

  /**
   * Made final to handle Python process initialization. Use #onPyProcessStart to implement any custom logic needed
   * to set up your engine within each Python process belonging to the engine.
   */
  onStart: final ~

  /**
   * Made final to shut down python processes.
   */
  // TODO: add another lifecycle hook and/or refactor so we just use super calls
  onStop: final ~
}
