/**
 * Specification of how to stop an {@link Engine}.
 */
@beta
type Engine.StopSpec mixes Spec {

  /**
   * Duration to wait for the tasks in the {@link Engine}'s queue to finish. By default, the engine will
   * wait until all actions in the queue complete or timeout according to the {@link App.Node.ThreadPool} configuration.
   */
  drainTimeout: string serialized Duration

  /**
   * Whether to interrupt and force the shutdown of the {@link Engine}.
   */
  interrupt: boolean
}
