/**
 * An {@link Engine} that precomputes the state of specified {@link WithInitialState} objects in a corresponding
 * {@link Action.Engine} when it is deployed.
 */
@beta
abstract type WithInitialState.Engine<D: WithInitialState.Engine.Deployment, S: WithInitialState.Engine.DeploySpec> mixes Engine<D, S> {

  /**
   * Method that called during interpreter start. Calls {@link WithInitialState#loadInitialState} for each object
   * configured in {@link WithInitialState.Engine.DeploySpec#initialStateObjs}.
   */
  onInterpreterStart: private function(spec: !S) py

  specToConfigs: ~

  /**
   * Instance of {WithInitialState} whose initial state has been precomputed.
   */
  deployedObjs: property(): !?map<string serialized Action.Engine, !?[WithInitialState]>

  /**
   * Fingerprints associated with the deployed objects.
   */
  deployedObjFingerprints: private cached property(): !?map<string serialized Action.Engine, !?[int]>

  /**
   * List of runtimes for this engine.
   */
  runtimes: property(): !?[string serialized Action.Engine]

  /**
   * Returns true if the input object's state has been initialized the corresponding {@link Action.Requirement}. If no
   * requirement is passed, then this function will return true if the state has been initialized in some runtime.
   */
  isStateLoaded: member function(obj: !WithInitialState, requirement: string serialized Action.Requirement): !boolean

  /**
   * Returns the {@link Action.Engine}s for this engine that can satisfy the supplied {@link Action.Requirement}.
   */
  actionEnginesForRequirement: private member function(requirement: !string serialized Action.Requirement)
                                                : !?set<string serialized Action.Engine>
}
