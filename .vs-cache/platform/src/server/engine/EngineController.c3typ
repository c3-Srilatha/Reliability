/**
 * {@link Controller} ensures engine state and configuration for each {@link App.Node}.
 */
// TODO PLAT-68367 Should be EngineController, but code-gen fails. See PLAT-68367.
@beta
type EngineController mixes Controller {

  /**
   * Method checks running {@link Engine engines} and {@link Engine.Deployment deployments} and:
   * - stops engines that has no deployments
   * - starts engines that has deployment but not running
   * - triggers {@link Engine#update} if necessary
   *
   * All checks respect location where engine(s) should be running and deployment state.
   *
   * Exceptions thrown from this method logged, but not cause failures of the {@link Controller}.
   */
  ensure: ~

  /**
   * This callback will stop all {@link Engine engines} running in this {@link App.Node node}.
   */
  onStop: ~
}
