/**
 * Specialized {@link Engine.Deprecated} for running a single background action / thread on a C3 Server Node
 */
abstract type Engine.Daemon mixes Engine.Static {

  /**
   * Restarts {@link #run} every second.
   */
  runAndReturnDuration: final ~

  /**
   * Eternal and immortal thread / action; i.e. if thread dies {@link Engine.Daemon engine} will immediately restarts it.
   */
  run: abstract member function()
}
