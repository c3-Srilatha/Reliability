/**
 * Represent state of {@link Engine engines} instance.
 */
@beta
private type Engine.Summary {

  /**
   * {@link App.Node} on which this {@link Engine engine} instance is running.
   */
  node: string serialized App.Node

  /**
   * Name of {@link HardwareProfile} of the {@link #node}.
   */
  hardwareProfile: string serialized HardwareProfile

  /**
   * State of the instance.
   */
  state: string enum Engine.State

  /**
   * Number of thread running in the instance.
   */
  runningThreads: int

  /**
   * Number of ready thread running in the instance.
   */
  readyThreads: int

  /**
   * Min number of thread that should be running for the engine.
   */
  minThreadsBoundary: int32

  /**
   * Max number of thread that can be started for the engine.
   */
  maxThreadsBoundary: int32

  /**
   * Queue size corresponding {@link App.Node.ThreadPool} if applicable
   */
  queueSize: int32

  /**
   * Remaining capacity of the queue of corresponding {@link App.Node.ThreadPool} if applicable.
   */
  queueRemainingCapacity: int32

  /**
   * Errors corresponding to the instance.
   */
  errors: [string]

  /**
   * Errors corresponding to the threads.
   */
  threadsErrors: [Error]
}
