/**
 * Configuration / deployment of an {@link Engine} that C3 App will be running.
 *
 * {@link Engine.Deployment} restricted to have minimal override on {@link ConfigOverride#APP} level because
 * {@link Engine} is deployed per {@link App}. However {@link Engine.Deployment deployments} may be create for a {@link Cluster} or an {@link Env}.
 */
@beta
@config(minOverride=APP, doNotDefaultIfMissing=true)
abstract type Engine.Deployment<E: Engine> mixes Engine.DeployBase, Named, Config {

  forName: ~

  /**
   * Return the subtype of {@link Engine} to which this {@link Engine.Deployment} belongs.
   */
  engineType: private cached property(): Type<<E>>

  /**
   * Default implementation of {@link Engine.Deployment#fromDeploySpec} that translates a {@link Engine.DeploySpec} into an {@link Engine.Deployment}.
   *
   * Can be overridden by the specific {@link Engine.Deployment} type to provide additional validations or transformations.
   */
  fromDeploySpec: private function(spec: !Engine.DeploySpec): mixing Engine.Deployment<E>
}
