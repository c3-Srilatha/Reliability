/**
 * Base type for {@link Engine.InitialState.Deployment} and {@link Engine.InitialState.DeploySpec}
 */
@beta
type WithInitialState.Engine.Deployment<E: WithInitialState.Engine> mixes Engine.Deployment<E: WithInitialState.Engine> {

  /**
   * Map specifying which objects' state initialized in which {@link Action.Engine}.
   *
   * key - The {@link Action.Engine engine} in which {@link WithInitialState object}'s state was initialized.
   * value - The list of {@link WithInitialState object}s initialized in the {@link Action.Engine engine}.
   */
  initialStateObjsPerActionEngine: !?map<string serialized Action.Engine, ![!WithInitialState]>

  /**
   * Implement translation form {@link WithInitialState.Engine.DeploySpec#initialStateObjsPerRuntime} to
   * {@link WithInitialState.Engine.Deployment#initialStateObjsPerActionEngine}.
   */
  fromDeploySpec: ~
}
