/**
 * Engine specialized in running actions periodically.
 *
 * {@link #inst Default instance} taken for each {@link Engine.Periodic} and {@link #doRun} method called.
 *
 * {@link #doRun} method may choose to return {@link Duration} which will indicate time to the next call to {@link #doRun} method.
 */
abstract type Engine.Periodic mixes Engine.Static {

  DEFAULT_SLEEP_INTERVAL: const string serialized Duration = "5m"

  /**
   * Uses {@link Duration} returned by {@link #doRun} or {@link #DEFAULT_SLEEP_INTERVAL} if value is `null` or `0`.
   */
  runAndReturnDuration: ~

  /**
   * Runs short-lived action. Optionally returns {@link Duration} that need to be waited before running the method next time.
   */
  task: abstract member function(): Duration
}
