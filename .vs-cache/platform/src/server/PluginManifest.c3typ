/**
 * Plugin Runtime Manifest
 */
type PluginManifest mixes ServicePlugin {

  isDirty:        boolean
  createdAt:      datetime
  modifiedAt:     datetime
  distributedVia: string enum('rpm', 'config')
  buildDetails:   map<string, any>
}
