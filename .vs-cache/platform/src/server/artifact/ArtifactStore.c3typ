/**
 * Represents Application and Library Artifact database for this cluster
 */
type ArtifactStore {

  /**
   * Uploads latest version of server artifact to store
   */
  uploadServerJar: function()

  /**
   * Latest version build # and fingerprint of a server artifact in a store
   */
  serverJarLastBuild: function(): Pair<int32, int>
}
