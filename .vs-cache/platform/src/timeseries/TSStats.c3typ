@db(compactType=true, index+=['job,group,start'])
entity type TSStats schema name 'TS_STS' {

  job: TSStatsJob

  /**
   * this value is for job.spec.group or null
   */
  group: string

  start:      datetime
  value:      double
  startCalc:  function(spec: TSStatsCalcSpec): TSStatsJob js-server
  cancelCalc: function(job: TSStatsJob): TSStatsJob js-server
  status:     function(job: TSStatsJob): MapReduceStatus js-server
  read:       function(spec: TSStatsReadSpec): [TSStats] js-server
}
