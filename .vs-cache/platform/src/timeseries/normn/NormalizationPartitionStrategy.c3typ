/**
 * Describes partitioning strategy for NormalizedTimeseries tables indicating how much data lives in what storage
 */
type NormalizationPartitionStrategy {

  /**
   * Interval by which columns are aggregated to be stored in cold store. Has to be equal to or higher than {@link TimedDataFields#bucketInterval}
   * If not set, system will default to one interval coarser than {@link TimedDataFields#bucketInterval}
   */
  coldBucketInterval: string enum Interval

  /**
   * Max value across all the buckets in hot storage. E.g. max date until which data should be in hot storage (e.g. "now() - period(6, 'MONTH')"
   */
  maxHotBucketDate: string serialized Expr
}
