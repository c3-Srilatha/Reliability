type RefreshNormalizationSpec mixes RefreshSpec {

  /**
   * Start time to normalize data from.
   *
   * If `start` and `end` represent a _smaller_ interval than the {@link TimedDataFields#bucketInterval} (which defaults
   * to 1 month) of the header type, data will be normalized according to the `bucketInterval`. The `bucketInterval`
   * is the lower bound in this case.
   */
  start: datetime

  /**
   * End time to normalize data until.
   *
   * If `start` and `end` represent a _smaller_ interval than the {@link TimedDataFields#bucketInterval} (which defaults
   * to 1 month) of the header type, data will be normalized according to the `bucketInterval`. The `bucketInterval`
   * is the lower bound in this case.
   */
  end: datetime

  /**
   * Force normalization even if the series has been previously normalized and valid
   */
  force: boolean
}
