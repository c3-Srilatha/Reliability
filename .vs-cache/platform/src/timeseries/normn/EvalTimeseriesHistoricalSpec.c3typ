type EvalTimeseriesHistoricalSpec mixes EvalTimeseriesSpecOld {

  /**
   * Filter to be applied on the timeseries data points while normalizing
   */
  filter: string

  /**
   * Bind variables for a filter to be applied on the timeseries data points while normalizing
   */
  vars: map<string, Obj>

  /**
   * Group by field name on the data point type. You can specify comma separated field names to group by multiple fields
   */
  group: string

  /**
   * the effective data version start
   */
  effectiveStart: datetime

  /**
   * the effective data version end
   */
  effectiveEnd: datetime
}
