/**
 * Type that specifies rules about treating a timeseries itself
 */
type TimeseriesHeaderInfo mixes Value {

  /**
   * default: ZERO_INTERPOLATOR
   */
  interpolator: string enum('LINEAR_INTERPOLATOR', 'ZERO_INTERPOLATOR')

  /**
   * default: IGNORE
   */
  duplicateHandling: string enum('IGNORE', 'KEEP')

  /**
   * default: AVG
   */
  overlapHandling: string enum('SUM', 'AVG', 'MIN', 'MAX')

  interval:  string enum Interval
  treatment: string enum AggOp

  /**
   * default: false
   */
  extrapolate: boolean

  unit: Unit
}
