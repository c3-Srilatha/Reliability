/**
 * Timeseries data points base type to hold multiple readings as an array of values. Fields with @ts annotations
 * should be [double] or [<any numerical value type>]. Values should be interval aligned/ without gaps / overlaps
 *
 * This type is useful for storing really "high frequency" data points that do NOT apply the steps in normalization
 * process (@see normalization.c3doc) but is needed in downstream processing via the same interface
 *
 * There needs to be a 1-1 mapping in between a {@link TimeseriesDataPoints} type & {@link IntervalDataHeader} type
 *
 * A single TimeseriesDataPoints type CANNOT map to multiple IntervalDataHeader types
 *
 * You'd also need to create a Timeseries field that needs to be normalized typically denoted with an annotation
 * @ts (@see Ann.Ts) and value type of which should be [<any numerical value type]
 *
 * @see normalization#getting-started for an end to end example
 * @see normalization#how-it-works
 * @see TimedDataPoint
 * @see IntervalDataHeader
 */
@db(rangeKey='start')
abstract type TimeseriesDataPoints<P: IntervalDataHeader> mixes TimedDataPointFields {

  /**
   * milliseconds between each data point
   */
  intervalMillis: !int

  /**
   * Series header for these data points
   */
  parent: !P
}
