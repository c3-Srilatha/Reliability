/**
 * Header type is used as a pointer to the actual Timeseries data points and contains meta information about the series
 * itself e.g. interval at which series needs to be normalized, unit for the series, how to deal with overlaps, etc.
 *
 * Mixin this type to provide meta information about the Timeseries being stored in {@link TimedDataPoint}
 *
 * This type participates in normalization process (@see normalization.c3doc) which performs data cleansing on these points
 * Since this object contains the meta information about the Timeseries, normalization is triggered on this type
 *
 * In order for normalization process to work, there needs to be a 1-1 mapping in between a
 * {@link TimedDataPoint} type & {@link TimedDataHeader}
 *
 * @see normalization#getting-started for an end to end example
 *
 * DO NOT mixin this type if you do not want to participate in the normalization process
 *
 * @see normalization#how-it-works
 * @see TimedDataPoint
 * @see IntervalDataHeader
 */
type TimedDataHeader<TDP: TimedDataPoint> mixes TimedDataFields<TDP> {

  /**
   * Indicates whether the last data point should be repeated until infinity
   */
  extrapolate: boolean

  /**
   * Data points corresponding to this timeseries header
   */
  data: ~(parent)
}
