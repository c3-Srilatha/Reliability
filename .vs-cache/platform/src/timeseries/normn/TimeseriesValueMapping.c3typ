/**
 * Provides value mappings for timeseries data points (as string -> number mapping) as metadata. Types mixin in this
 * are only expected to have id & value field populated and there should be no other field on the type
 *
 * E.g. entity type MyExampleTimeseriesValueMapping mixes TimeseriesValueMapping
 *
 * Load data containing id & value field indicating the value mapping
 */
@db(unique='value', compactType=true)
abstract extendable type TimeseriesValueMapping mixes Metadata, Identified {

  /**
   * Value that the given string {@link id} should be mapped to
   */
  value: int

  /**
   * Generate a value mapping for the given id
   */
  lookupValue: inline function(id: !?string, failIfMissing: boolean): int

  /**
   * Obtain the id string for the given mapped value
   */
  lookupId: inline function(value: !?int, failIfMissing: boolean): string
}
