/**
 * Indicates how normalized data should be written
 */
type NormalizedTimeseriesPutSpec mixes KvStorePutSpec, NormalizedTimeseriesSpecBase {

  /**
   * If set, columns are merged with existing columns. If new values with same column name are provided, existing values
   * in those columns will be overwritten
   */
  merge: boolean

  /**
   * Removes the given columns. Used when removing invalidatedRange columns on normalization
   */
  removedColumns: set<string>

  /**
   * If set, skips attempting to write to cold bucket during {@link NormalizedTimeseriesPersister#put} action if hot/cold storage is enabled
   */
  skipColdBucketUpdate: private boolean

  /**
   * If set, will attempt compacting of hot data into cold store as part of {@link NormalizedTimeseriesPersister#put} action. If the buckets
   * are not part of NormalizedTimeseries object, `put` will read the data from the hot store
   * If set, skipColdBucketUpdate will be ignored and the cold bucket will be updated
   */
  fullCompact: private boolean
}
