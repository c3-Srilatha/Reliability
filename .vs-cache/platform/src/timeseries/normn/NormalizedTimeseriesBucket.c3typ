/**
 * Represents a single bucket for the normalized timeseries
 */
type NormalizedTimeseriesBucket {

  /**
   * bucket id
   */
  id: !string

  /**
   * Earliest normalized data point in this bucket
   */
  earliest: !TSDataPoint

  /**
   * Latest normalized data point in this bucket
   */
  latest: !TSDataPoint

  /**
   * normalization interval
   */
  interval: !string enum Interval

  /**
   * count of data points in this bucket
   */
  count: !int

  /**
   * If set, the content for this bucket is stored remotely
   */
  contentLocation: string serialized FileUrl

  /**
   * If set, the content for this bucket is stored in a cold storage in the bucket specified by the id
   */
  coldBucketRef: string
}
