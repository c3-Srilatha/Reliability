/**
 * Data type for storing normalized timeseries data. One NormalizedTimeseries object is created
 * per header-field combination
 */
@db(datastore="kv")
entity type NormalizedTimeseries schema name 'timeseries_NormalizedTimeseries' {

  /**
   * Estimates in raw data. key is YEAR-MONTH
   *
   * @db(storage="column")
   */
  estimates: map<string, DateTimeMapp>

  /**
   * Value indicating if the interval is missing or not. null value represents all available
   * Key is the same as counts / values
   */
  missing: map<string, Boxed<[boolean]>>

  /**
   * Value is all normalized points that fall into this period. key is grain-YEAR-MONTH.
   *
   * @db(storage="columnPerKey")
   */
  values: map<string, DecimalArry>

  /**
   * Contains the range of this timeseries. start, end, finest-grain at which the timeseries is normalized
   */
  range: NormalizedTimeseriesRange

  /**
   * This object contains meta information about how the timeseries was normalized and if there
   * were any errors during normalization.
   */
  state: NormalizedTimeseriesState

  /**
   * Denotes whether the given timeseries is valid and ready for consumption
   */
  valid: ?boolean

  /**
   * The value for earliest and latest data point for this timeseries. It is extracted from the raw data
   * This is independent of interval, time period, etc.
   * Pair contains -> <Earliest Value, Latest Value>
   */
  earliestLatestValue: DimensionPair

  /**
   * Value is all raw data point counts that fall into this period. key is grain-YEAR-MONTH.
   *
   * @db(storage="columnPerKey")
   */
  counts: map<string, DecimalArry>

  /**
   * Time range indicating the period that is invalidated. The presence of this field means that the state is invalid
   * This field will be stored a they arrive and will only be gettable by it self without using include with other fields
   */
  invalidatedRanges: private [NormalizedTimeseriesInvalidationRange] schema name 'IR'

  /**
   * Persists the given timeseries in cassandra
   * @param timeseries Object to be persisted
   * @param id primary key to persist
   */
  persistTimeseries: function(timeseries: !Timeseries, id: !string)

  /**
   * Purges the given timeseries id from cassandra
   * @param ids Timeseries ids to purge
   */
  purgeTimeseries: function(ids: ![string])

  /**
   * Get the timerange for the timeseries specified by id
   * @param spec The spec should specify start / end / grain/ projection
   * @param id The id of the timeseries for which TimeRange is desired
   * @return The available TimeRange for the timeseries
   */
  computeTimeRange: function(spec: TSEvalSpec, id: !string): TimeRange

  /**
   * Get the normalized data for the timeseries specified by id
   * @param spec The spec should specify start / end / grain/ projection
   * @param id The id of the timeseries for which TimeRange is desired
   * @return The normalized data for the timeseries
   */
  fetchNormalizedData: function(spec: TSEvalSpec, id: !string): Timeseries

  /**
   * Id : typeId(rawDataPointType).parentId.pathId(tsField)
   */
  id: ~

  name: ~ not persistable
  meta: ~ not persistable

  /**
   * Computes in memory Pair of [hot, <coldBucketUrl : cold buckets content>] from the given instance of NormalizedTimeseries
   */
  hotColdBuckets: member function(): Pair<NormalizedTimeseries, map<string, NormalizedTimeseries>>

  /**
   * @return the end point where the cold data will be persisted
   */
  coldDataEndpoint: private inline member function(): !string

  /**
   * Computes in memory Pair of [hot, <coldBucketUrl : cold buckets content>] from the given instance of NormalizedTimeseries
   * This differs from hotColdBuckets in the sense that it will read the data from the state buckets and cold store if need be
   * @return <hot NTS instance, cold instances, cols to be removed from hot]
   */
  compactInMemory: private member function()
                                    : Triple<NormalizedTimeseries, map<string, NormalizedTimeseries>, [string]>
}
