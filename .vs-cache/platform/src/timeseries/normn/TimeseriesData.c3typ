/**
 * Raw data point type for timeseries with no header type. However, each raw interval timeseries is associated with a
 * TimeseriesInfo which could contain metadata about the actual timeseries
 * Parameter TI is mandatory and denotes the TimeseriesInfo type where metadata needs to be obtained from
 */
type TimeseriesData<P, TI> mixes IntervalDataPointFields, TimeseriesDataBase {

  /**
   * this is a string to look up data points by
   */
  parent: string
}
