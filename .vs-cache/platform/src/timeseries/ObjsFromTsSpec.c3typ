/**
 * Type describing parameters that are needed to convert a list of timeseries Obj into a Array of Obj
 */
type ObjsFromTsSpec mixes Spec {

  /**
   * Desired element type of the resulting Collection
   */
  elementType: ValueType

  /**
   * {@link FillMissingSpec} to use for filling missing values
   */
  fillMissingSpec: FillMissingSpec
}
