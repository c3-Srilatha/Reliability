/**
 * Tracking info for timeseries.
 */
type TimeseriesSourceInfo mixes Spec {

  /**
   * Source object / identifier of the timeseries.
   */
  source: Identifiable | string

  /**
   * Additional metadata about the source
   */
  tags: map<string, string>

  /**
   * Metric expression used to construct the timeseries.
   */
  expr: string

  sourceId:   inline member function(): string js
  expression: inline member function(): string js
  label:      inline member function(): string js
}
