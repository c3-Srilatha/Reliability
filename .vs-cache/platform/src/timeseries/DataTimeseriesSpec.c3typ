/**
 * Timeseries specification to be applied to all fields on the given Data
 */
type DataTimeseriesSpec mixes TimeseriesSpec, TimeseriesAggFields {

  /**
   * Convenience function to construct a DataTimeseriesSpec
   * @param startExpr
   *        DateTime field/expression on which Timeseries should be constructed. Sets DataTimeseriesSpec.startExpr
   * @param period
   *        Time period for each element within the Timeseries. Sets DataTimeseriesSpec.interval
   * @param parentExpr
   *            Field/Expression indicating the grouping criteria. Sets DataTimeseriesSpec.parentExpr
   * @param aggOp
   *        Aggregation function for aggregating values in the Timeseries
   */
  forFields: function(startExpr: string,
                      period: string serialized Period,
                      parentExpr: string,
                      aggOp: string enum AggOp = SUM): DataTimeseriesSpec
}
