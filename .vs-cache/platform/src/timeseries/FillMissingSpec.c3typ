/**
 * Type describing parameters that are needed to fill missing values
 */
type FillMissingSpec mixes Spec {

  /**
   * The maximum number of consecutive missing values to forward/backward fill along each field of `E`. In other words,
   * if there is a gap with more than this number of consecutive missing values, it will only be partially filled.
   */
  limit: int
}
