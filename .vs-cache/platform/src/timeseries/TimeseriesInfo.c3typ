inline type TimeseriesInfo mixes TimeseriesBase.Info, TimeseriesInfoBase, TimeInfo {

  interval: !~ = DAY

  /**
   * The array of booleans for each data point indicating if the data point is missing or available
   */
  missing: [boolean] schema suffix 'M'

  /**
   * @return new timeseries info with provided time zone
   */
  withTimeInfo: member function(timeInfo: !TimeInfo): TimeseriesInfo

  /**
   * returns a full available TimeseriesInfo
   */
  fullyAvailable: member function(): TimeseriesInfo

  /**
   * @return new instance of time info based on the Timeseries c3 obj.
   */
  fromTimeseries: function(ts: !Timeseries): !TimeseriesInfo

  // constructors
  from: final function(timeInfo: !TimeInfo, missing: [boolean], sInfo: TimeseriesSourceInfo): !TimeseriesInfo

  /**
   * API to convert array of time range objects into percentage value in between 0-100 for each interval in between start
   * and end depending on the time period spanned by each of the "ranges"
   * E.g. if  start : 2010-01-01, end : 2011-01-01, interval : "MONTH", ranges: [{start : 2010-07-01, end : 2011-01-01}],
   * the output will be => [0,0,0,0,0,0,100,100,100,100,100,100]
   * @param start
   *            Start date for the timeseries
   * @param end
   *            End date for the timeseries
   * @param interval
   *            Interval for the timeseries
   * @param ranges
   *            Ranges indicating the time period that need to be converted to percentage values in between 0 - 100
   * @return percentage value between 0-100 for each interval between start and end based on the given ranges
   */
  timeRangeToByteArray: function(start: !datetime, end: !datetime, interval: !string, ranges: [TimeRange]): [byte]

  /**
   * Utility to convert [byte] => [boolean] mostly used for converting backward compat missing [byte] to [boolean]
   */
  convertToMissing: private function(byteArray: [byte]): [boolean]

  /**
   * Constructs TimeseriesInfo with full missing. Optimizes to hold this information as a flag instead of materialized
   * array of values
   */
  withFullMissing: member function(size: !int): TimeseriesInfo
}
