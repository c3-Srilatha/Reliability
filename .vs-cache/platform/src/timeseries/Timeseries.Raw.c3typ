/**
 * A raw timeseries that contains its timestamps and data
 */
type Timeseries.Raw<E> mixes TimeseriesBase<E, TimeseriesBase.Info> {

  /**
   * Representation of data points for this time series
   */
  _data: [E] schema suffix 'DATA'

  /**
   * Representation of time points for this time series
   */
  _dates: [datetime] schema suffix 'DATES'

  dataPointType: ~

  /**
   * As timeseries raw is not a normalized timeseries, the result will always be the aggregated values of the data points within the new period range.
   * E.g if the input {@link Timeseries.Raw} called inputRawTs looks like
   *  ```
   *  ----------------------------
   *     timestamp   |    value
   *     2023-04-01  |    1.0
   *     2023-04-02  |    2.0
   *     2023-04-03  |    3.0
   *     2023-04-04  |    NaN
   *     2023-04-05  |    4.0
   *     2023-04-06  |    5.0
   *     2023-04-07  |    null
   *     2023-04-08  |    null
   *     2023-04-09  |    null
   *  ----------------------------
   *  ```
   * then the output of inputRawTs.toPeriod("3d", "SUM") would be
   *  ```
   *  ----------------------------
   *     timestamp   |    value
   *     2023-04-01  |    6.0
   *     2023-04-04  |    NaN
   *     2023-04-07  |    0.0
   *  ----------------------------
   *  ```
   *
   * then the output of inputRawTs.toPeriod("3d", "MIN") would be
   *  ```
   *  ----------------------------
   *     timestamp   |    value
   *     2023-04-01  |    1.0
   *     2023-04-04  |    4.0
   *     2023-04-07  |    0.0
   *  ----------------------------
   *  ```
   */
  toPeriod: ~
}
