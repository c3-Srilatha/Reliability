/**
 * Short term MapReduce job to compute aggregates for a timeseries.
 *
 * Long term new eval api should be able to support this natively.
 */
type TSStatsCalcSpec mixes Spec {

  targetType: Type

  /**
   * if rollup is set then projection should include rollup expression
   */
  projection: string

  filter: string

  /**
   * can only be a reference to a single field in targetType
   */
  group: string

  start:  datetime
  end:    datetime
  grain:  string
  rollup: boolean = true

  /**
   * optional
   */
  jobId: string

  batchSize: int = 1000
}
