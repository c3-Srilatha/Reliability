/**
 * Custom message that can be sent to the client to trigger special behavior
 * Such as showing a dialog, or changing the UI (separate from the standard DebugAdapterProtocol messages)
 */
type Debugger.CustomMessage {

  /**
   * This will help client to distinguish between DAP messages and custom messages
   */
  isC3CustomMessage: boolean = true

  /**
   * The type of message to send
   */
  kind: !string enum Debugger.CustomMessage.Kind

  /**
   * The actual message the client can use to trigger special behavior
   */
  body: any
}
