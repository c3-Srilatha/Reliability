/**
 * Inform the Client to start the DAP client for the given action engine.
 */
type Debugger.CustomMessage.StartDapClient {

  /**
   * Currently supported @{link ImplLanguage.Executor} are {@link ImplLanguage.Executor.PY4J} and {@link ImplLanguage.Executor.RHINO}.
   */
  implLanguageExecutor: !ImplLanguage.Executor

  dapProxyId: !string
}
