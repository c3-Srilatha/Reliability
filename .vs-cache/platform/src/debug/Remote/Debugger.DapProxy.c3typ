/**
 * DAP Proxy stands for Debug Adapter Protocol Proxy.
 * It is a proxy that acts as a Debugger Adapter Client for the process running on the server
 * the implementation should be programming language agnostic
 */
type Debugger.DapProxy mixes Mutable, Identified {

  /**
   * The port on which the proxy will listen messages from the process being debugged
   */
  port: int

  /**
   * Used to inform client to connect the correct debug adapter to this proxy
   */
  implLanguageExecutor: string enum ImplLanguage.Executor

  /**
   * The instance of Java.net.ServerSocket which the action process will connect to.
   */
  socketServer: @java(class='java.net.ServerSocket') native

  /**
   * The instance of Java.net.Socket which is created when an action is connected to the socketServer.
   */
  socketClient: @java(class='java.net.Socket') native

  /**
   * Send the message to the actual DAP client.
   */
  send: private member function(message: binary)

  /**
   * Start the Socket server.
   */
  start: private member function()

  /**
   * returns true if the server socket is running and no action is being debugged
   */
  canAcceptRequest: private member function(): !boolean

  /**
   * Check if the socket client is active
   */
  isSocketClientActive: private member function(): !boolean

  /**
   * Check if the socket server is active
   */
  isSocketServerActive: private member function(): !boolean

  /**
   * Accept request from action
   */
  acceptRequest: member function(implLanguageExecutor: !string enum ImplLanguage.Executor)

  /**
   * Stop the proxy.
   */
  stop: member function()

  /**
   * Generate a {@link Debugger.DapProxy} instance with a random port # and unique id
   */
  generate: function(): !Debugger.DapProxy

  /**
   * Stop all {@link Debugger.DapProxy} instances
   */
  stopAll: function()

  /**
   * Get the first available Dap Proxy that is not being used by any action
   * returns null if no proxy is available
   */
  firstAvailable: function(): Debugger.DapProxy

  forId: ~
}
