/**
 * Debugger Manager is responsible for managing the remote debug session.
 * Clients need to use @{link Debugger.Client} to call actions on this type.
 */
type Debugger.Manager mixes Singleton, Mutable, Configurable<Debugger.Config> {

  /**
   * Active websocket connection for remote debugging.
   */
  webSocket: Debugger.WebSocketHandler

  /**
   * This will stop the DAP proxy and close the websocket connection.
   */
  stop: member function()

  /**
   * Check if the websocket connection is active.
   */
  isWebSocketConnected: private member function(): !boolean

  /**
   * Setup the Server for the debug session.
   * Start the Dap Proxy if not already started.
   */
  initServer: member function()

  /**
   * Return the port for the action to connect to
   * @param actionEngine
   *        the action engine for which the port is requested
   * return -1 if socket isn't available
   */
  acceptAction: member function(implLanguageExecutor: !string enum ImplLanguage.Executor): int
}
