/**
 * Client-side interface to the debugger.
 * Client needs to use this types to make any changes to the state for debugger on the server.
 */
type Debugger.Client {

  /**
   * Calls {@link Debugger.Manager#initServer} on the server.
   */
  initServer: function()

  /**
   * Calls {@link Debugger.Manager#stop} on the server.
   */
  stop: function()
}
