/**
 * Configurations for {@link LukeCore}.
 */
@beta
type LukeCoreConfig mixes Config, Singleton {

  /**
   * The directory path for the downloaded files by Luke
   */
  downloadPath: string = '/root/Downloads/'

  /**
   * Whether to print browser logs if an error occurs
   */
  printBrowserLogsOnError: boolean = true

  /**
   * Whether to save a screen shot if an error occurs
   */
  saveScreenShot: boolean = true

  /**
   * The directory path for the saved screen shot files
   */
  screenShotPath: string = '/tmp/luke/screenshots/'

  /**
   * The directory path for the saved accessibility HTML reports
   */
  reportPath: string = '/tmp/luke/reports/'
}
