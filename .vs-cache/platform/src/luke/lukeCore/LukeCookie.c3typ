/**
 * Browser Cookie
 */
type LukeCookie {

  /**
   * Name of the cookie
   */
  name: !string

  /**
   * The cookie value
   */
  value: !string

  /**
   * The url of the cookie, defaults to the orign of the current host
   */
  url: string

  /**
   * True if the cookie is a host-only cookie (i.e. a request's host must exactly match the domain of the cookie)
   */
  hostOnly: boolean

  /**
   * The path of the cookie
   */
  path: string

  /**
   * True if the cookie is marked as Secure (i.e. its scope is limited to secure channels, typically HTTPS)
   */
  secure: boolean

  /**
   * When the cookie expires, specified in seconds since Unix Epoch.
   * Defaults to 20 years into the future if omitted.
   *
   * (It works well in chrome but not in firefox)
   */
  expiry: double
}
