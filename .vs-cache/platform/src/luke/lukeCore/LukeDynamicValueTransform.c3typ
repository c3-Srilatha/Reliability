/**
 * Represents a node in a chain of transforms for a {@link LukeDynamicValue}
 */
@beta
type LukeDynamicValueTransform {

  /**
   * The function that transforms the resolved dynamic value
   */
  transformFunc: private any

  /**
   * Additional arguments to be passed to the transform function. A resolved dynamic value followed by the args will be passed to
   * the function
   */
  args: private [any]
}
