/**
 * A symbolic type for notating a dynamic value that are stored in and resolved from a {@link Luke} instance.
 * When using Luke functions that support dynamic values, developers can pass such notations as alternative arguments
 * so that each retry of that async task will pick the latest value resolved from the {@link Luke} instance.
 * @example
 * ```js
 * this.client.searchAll('.grid-row').attr('length').saveAsDynamicValue('orginalNumberOfRows');
 * ... // After some user interactions, the number of rows are expected to increase
 * this.client.searchAll('.grid-row').assert('toBeGreaterThan', LukeDynamicValue.makeValue('orginalNumberOfRows'));
 * // We can also set an input to the saved dynamic value
 * this.client.search('input.number', true).setValue(LukeDynamicValue.makeValue('orginalNumberOfRows'));
 * // A dynamic value can also be transformed before being used in Luke APIs
 * this.client.search('input.number', true).setValue(LukeDynamicValue.makeValue('orginalNumberOfRows').transform(
 *   function (val) {
 *     return val * 2;
 *   })
 * );
 * ```
 */
@beta
type LukeDynamicValue {

  /**
   * Makes an instance of {@link LukeDynamicValue} with a given name
   * @return an instance of {@link LukeDynamicValue}
   */
  makeValue: inline function(name: !string): LukeDynamicValue js

  /**
   * The name for the dynamic value
   */
  name: private string

  /**
   * Stores a chain of transforms to be applied to the resolved value
   */
  transforms: private [LukeDynamicValueTransform]

  /**
   * Returns the name of the dynamic value
   */
  getName: inline member function(): string js

  /**
   * Adds a transform to a dynamic value. Note that the original dynamic value instance
   * won't change, instead a clone with the added transform will be created. As such, an
   * instance of {@link LukeDynamicValue} can be reused in multiple Luke commands.
   * @example
   * ```js
   * luke.searchAll('.message').size().saveAsDynamicValue('sum');
   * ...
   * var half = LukeDynamicValue.makeValue('sum').transform(function (sum) {
   *   return sum / 2;
   * });
   * this.client.searchAll('.row').size().assert('toEqual', half);
   * this.client.searchAll('.info').size().assert('toEqual', half.transform(function (val) {
   *   val * 3;
   * }));
   * this.client.searchAll('.warn').size().assert('toEqual', half.transform(function (val) {
   *   val * 5;
   * }));
   *
   * var diff = LukeDynamicValue.makeValue('sum').transform(function (sum, max) {
   *   return sum - max; // Both sum and max are resolved dynamic values
   * }, [LukeDynamicValue.makeValue('max')]);
   * this.client.searchAll('.row').size().assert('toEqual', diff);
   * ```
   *
   * @return a clone of the current {@link LukeDynamicValue} with dynamic transform function attached
   */
  transform: inline member function(func: !any, args: [any]): LukeDynamicValue js

  /**
   * Generates a new {@link LukeDynamicValue} that will transform the value resolved from the current instance to an integer
   * @example
   * ```js
   * luke.search('label').text().saveAsDynamicValue('sum');
   * ...
   * luke.searchAll('.list-item').size().assert('toEqual', LukeDynamicValue.makeValue('sum').transformToInt());
   * ```
   *
   * @return a clone of the current {@link LukeDynamicValue} with dynamic transform function attached
   */
  transformToInt: inline member function(): LukeDynamicValue js

  /**
   * Generates a new {@link LukeDynamicValue} that will transform the value resolved from the current instance to a number
   * @example
   * ```js
   * luke.search('label.speed').text().saveAsDynamicValue('speed');
   * ...
   * luke.runLambda(function () {
   *   return __myApp.state.speed;
   * }).assert('toEqual', LukeDynamicValue.makeValue('speed').transformToNumber(3));
   * ```
   *
   * @param decimals
   *           Number of decimals, note that the trailing 0 decimals will be omitted. For example, if "23.1200" is transformed
   *           to a number with 3 decimals, the resolved value will be 23.12 because JavaScript Number object will drop
   *           the trailing 0 decimals.
   *           {@see #transformToNumberString}
   * @return a clone of the current {@link LukeDynamicValue} with dynamic transform function attached
   */
  transformToNumber: inline member function(decimals: int = 0): LukeDynamicValue js

  /**
   * Generates a new {@link LukeDynamicValue} that will transform the value resolved from the current instance to a string representing a number
   * @example
   * ```js
   * luke.search('input').getValue().saveAsDynamicValue('input-number');
   * ...
   * luke.search('label.display').text().assert('toEqual',
   *   LukeDynamicValue.makeValue('input-number').transformToNumberString(3));
   * ```
   * @param decimals
   *           Number of decimals
   * @return a clone of the current {@link LukeDynamicValue} with dynamic transform function attached
   */
  transformToNumberString: inline member function(decimals: int = 0): LukeDynamicValue js

  /**
   * Generates a new {@link LukeDynamicValue} that will transform the value resolved from the current instance to a string
   * @example
   * ```js
   * luke.searchAll('.item').size().saveAsDynamicValue('size');
   * ...
   * luke.search('label.total').text().assert('toEqual',
   *   LukeDynamicValue.makeValue('size').transformToString());
   * ```
   * @return a clone of the current {@link LukeDynamicValue} with dynamic transform function attached
   */
  transformToString: inline member function(): LukeDynamicValue js
}
