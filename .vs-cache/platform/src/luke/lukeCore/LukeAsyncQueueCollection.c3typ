@beta
type LukeAsyncQueueCollection<E> mixes LukeAsyncQueueNode {

  /**
   * Returns the element type (E)
   */
  elementType: inline member function(): Type js

  /**
   * Resolves the size of the collection when async elements are loaded
   * @return a {@link LukeAsyncQueueNode} that will resolve the size
   */
  size: inline member function(): LukeAsyncQueueNode js

  /**
   * Finds an async element that satisfies the predicate function
   * @param funk
   *          The predicate function that returns a LukeAsyncQueueNode resolving true or false.
   *          A luke instance, an async wrapper (the E parametric type of the collection) and an index
   *          will be passed as the first three arguments to the function
   * @param args
   *          Arguments (following the first three default arguments) to be passed to the predicate function
   * @param resolveOnFound
   *          If true, only resolve the `find` node when an element is found to satisfy the predicate function
   * @return An async element wrapper (the E parametric type of the collection, and it should be a sub type of
   * {@link LukeAsyncQueueNode})
   *
   * @example
   * ```js
   * luke.searchAll('option').find(function (client, option, index) {
   *   return option.getElementAttribute('value').then(function (client, value) {
   *     return value === 'select me';
   *   });
   * }).click();
   * ```
   */
  find: inline member function(funk: any, args: [any], resolveOnFound: boolean): E js

  /**
   * Finds the index of async element that satisfies the predicate function
   * @param funk
   *          The predicate function that returns a LukeAsyncQueueNode resolving true or false.
   *          A luke instance, an async wrapper (the E parametric type of the collection) and an index
   *          will be passed as the first three arguments to the function
   * @param args
   *          Arguments (following the first three default arguments) to be passed to the predicate function
   * @param resolveOnFound
   *          If true, only resolve the `find` node when an element is found to satisfy the predicate function
   * @return An async element wrapper (the E parametric type of the collection, and it should be a sub type of
   * {@link LukeAsyncQueueNode})
   *
   * @example
   * ```js
   * luke.searchAll('option').find(function (client, option, index) {
   *   return option.getElementAttribute('value').then(function (client, value) {
   *     return value === 'select me';
   *   });
   * }).click();
   * ```
   */
  findIndex: inline member function(funk: any, args: [any], resolveOnFound: boolean): int js

  /**
   * Iterates through all async elements and aggregates their results to a single value
   * @param funk
   *          The predicate function that returns a LukeAsyncQueueNode resolving the result accumulated so far.
   *          A luke instance, an async wrapper (the E parametric type of the collection), an accumulated result and an index
   *          will be passed as the first four arguments to the function
   * @param accumulator
   *          The initial result to be accumulated through iterations
   * @param args
   *          Arguments (following the first three default arguments) to be passed to the predicate function
   * @return A {@link LukeAsyncQueueNode}) that will resolve the final result
   *
   * @example
   * ```js
   * // Sums up values of all `input` elements
   * luke.searchAll('input').reduce(function (client, input, accumulator) {
   *   return input.getValue().then(function (client, value, _accumulator) {
   *     return _accumulator + parseInt(value);
   *   }, [accumulator]);
   * }, 0);
   * ```
   */
  reduce: inline member function(funk: any, accumulator: any, args: [any]): LukeAsyncQueueNode js

  /**
   * Maps a collection of async elements to a collection of the same element type (e.g. {@link LukeWebElement}s to {@link LukeWebElement}s)
   * @param funk
   *          The function that returns an async element of the same type.
   *          A luke instance, an async wrapper (the E parametric type of the collection) and an index
   *          will be passed as the first three arguments to the function
   * @param args
   *          Arguments (following the first three default arguments) to be passed to the predicate function
   * @return An async collection of the same element type (the E parametric type of the collection, and it should be a sub type of
   * {@link LukeAsyncQueueNode})
   *
   * @example
   * ```js
   * luke.searchAll('option.selected').map(function (client, option, index) {
   *   return option.parentElement();
   * }).find(function (client, parent) {
   *   return parent.search('span').then(function (client, text, index) {
   *     return text === 'target' && index > 3;
   *   });
   * });
   * ```
   */
  mapToSame: inline member function(funk: any, args: [any]): LukeAsyncQueueCollection<E> js

  /**
   * Maps a collection of async elements to a collection of {@link LukeAsyncQueueNode}s wrapping any value.
   * @param funk
   *          The function that returns an async element wrapping any value.
   *          A luke instance, an async wrapper (the E parametric type of the collection) and an index
   *          will be passed as the first three arguments to the function
   * @param args
   *          Arguments (following the first three default arguments) to be passed to the predicate function
   * @return An async collection of {@link LukeAsyncQueueNode}s
   *
   * @example
   * ```js
   * luke.searchAll('option.selected').mapToAny(function (client, option, index) {
   *   return option.parentElement().search('span').text();
   * }).assert('toEqual', ['A', 'B', 'C']);
   * ```
   */
  mapToAny: inline member function(funk: any, args: [any]): LukeAsyncQueueCollection<LukeAsyncQueueNode> js

  /**
   * filters a collection of async elements
   * @param funk
   *          The predicate function that returns a LukeAsyncQueueNode resolving true or false.
   *          A luke instance, an async wrapper (the E parametric type of the collection) and an index
   *          will be passed as the first three arguments to the function
   * @param args
   *          Arguments (following the first three default arguments) to be passed to the predicate function
   * @return An async collection of the same element type (the E parametric type of the collection, and it should be a sub type of
   * {@link LukeAsyncQueueNode})
   *
   * @example
   * ```js
   * luke.searchAll('option.selected').filter(function (client, option, index) {
   *   return option.text().then(function (client, textValue) {
   *     return textValue === 'target';
   *   });
   * }).assert('toHaveLength', 3);
   * ```
   */
  filter: inline member function(funk: any, args: [any]): LukeAsyncQueueCollection<E> js

  /**
   * Returns an async element wrapper (the E parametric type of the collection) at the given index
   * @param index
   *          The index of the element in the async collection
   * @return An async element wrapper (the E parametric type of the collection, and it should be a sub type of
   * {@link LukeAsyncQueueNode})
   */
  atIndex: inline member function(index: !int): E js

  /**
   * Iterate over each element within the collection and invoke the iteratee function for each element.
   * @param funk
   *          The iteratee function being invoked for each element.
   *          A luke instance, an async wrapper (the E parametric type of the collection) and the index of the element
   *          in the collection will be passed as the first three arguments to the function.
   * @param args
   *          Arguments (following the first three default arguments) to be passed to the iteratee function
   *
   * @return a {@link LukeAsyncQueueNode} attached to the current node
   *
   * @example
   * ```js
   * luke.searchAll('.row').each(function (client, row) {
   *   row.search('td').text().assert('toContain', 'active');
   * });
   *
   * luke.searchAll('.row').each(function (client, row, index, stopLimit) {
   *   if (index < stopLimit) {
   *     row.search('button').click();
   *   }
   * }, [5]);
   * ```
   */
  each: inline member function(funk: any, args: [any]): LukeAsyncQueueNode js

  /**
   * Reverses the order of the elements
   * @return An async collection of the same elements in the reverse order
   */
  reverse: inline member function(): LukeAsyncQueueCollection<E> js
}
