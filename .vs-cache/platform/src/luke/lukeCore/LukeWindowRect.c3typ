/**
 * A representation of the dimensions and position of the window used in a Luke test.
 */
type LukeWindowRect {

  /**
   * The window width
   */
  width: int

  /**
   * The window height
   */
  height: int

  /**
   * The offset of the window from the left edge of the screen in pixels
   */
  left: int

  /**
   * The offset of the window from the top edge of the screen in pixels
   */
  top: int
}
