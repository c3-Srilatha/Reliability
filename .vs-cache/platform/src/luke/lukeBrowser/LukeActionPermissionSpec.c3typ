/**
 * Specifies a source that defines action permissions. Only one source can be used per call
 * of {@link Luke#validateActionPermissions}
 */
@beta
type LukeActionPermissionSpec mixes Spec {

  /**
   * The id of a page
   */
  pageId: string

  /**
   * The id of a {@link Role}
   */
  roleId: string

  /**
   * The id of an {@link UserGroup}
   */
  groupId: string

  /**
   * The id of a {@link User}
   */
  userId: string
}
