/**
 * This type configures the target window for a Luke test run. These configurations are wrappers
 * around Chrome's Window types and method parameters, found here:
 * https://developer.chrome.com/docs/extensions/reference/api/windows
 */
type LukeWindowSpec {

  /**
   * If true, the target window will be opened in incognito mode.
   */
  incognito: boolean = false

  /**
   * The starting state of the window.
   */
  state: string enum('normal', 'maximized', 'fullscreen')
}
