/**
 * A subtype of {@link LukeAsyncQueueNode} that interacts with files downloaded by the browser
 */
@beta
type LukeAsyncQueueFile mixes LukeAsyncQueueNode {

  /**
   * Reads content as text from the downloaded file
   * @return a {@link LukeAsyncQueueNode} that resolves with the file content
   */
  readString: inline member function(): LukeAsyncQueueNode js-client

  /**
   * Removes a downloaded file
   * @return a {@link LukeAsyncQueueNode} that resolves when the file is removed
   */
  remove: inline member function(): LukeAsyncQueueNode js-client
}
