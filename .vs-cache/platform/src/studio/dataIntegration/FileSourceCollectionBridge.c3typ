/**
 * Nested Component of UiSdlDataGrid requires each row to have id. This bridge
 * adds the id to the SourceCollection's fetch call.
 */
type FileSourceCollectionBridge {

  /**
   * Fetch method for the bridge
   */
  fetch: function(spec: FetchSpec): FetchResult<SourceCollectionWithId> js-server

  /**
   * Fetch SourceCollections including its inboxUrl and inferred {@link Source}
   */
  fetchInboxUrlAndSource: function(spec: FetchSpec): FetchResult<json> js-server
}
