/**
 * Generates and returns the data to pass to the {@link UiSdlTimeGraph}.
 */
type SourceCollectionDataQuality {

  /**
   * Unique Identifier of the data Quality. Contains the name of the SourceCollection + timestamp
   */
  id: string

  /**
   * Id of the entity type. the object structure is
   * from { id: <Name of the SourceCollection> }
   */
  from: map<string, string>

  /**
   * The Opacity to show on {@link UiSdlTimeGraph}
   */
  opacity: double

  /**
   * Status of the data
   */
  status: string enum SourceCollectionDataQualityStatus

  /**
   * The range for the timestamp
   * The object structure is
   * timeRange: { start: <start timestamp>, end: <end timestamp> }
   */
  timeRange: map<string, datetime>

  /**
   * Returns the heatmap data for last 30 days
   */
  fetch: function(spec: FetchSpec, clientTimeZoneOffset: string): FetchResult<SourceCollectionDataQuality> py-data_312
}
