/**
 * A timestamp convertor for {@link Data}
 */
type TimestampConverter {

  /**
   * Returns a {@link Data} of converted utc timestamps depending on timezone_offset
   *
   * @param data
   *        The data to convert
   * @param time_field
   *        the column name of the time field
   * @param timezone_offset
   *        the offset hours to convert to
   *
   * @returns a {@link Data.Series} of converted timestamps
   */
  convert_utc_timestamps: function(data: Data.Lazy, time_field: string, timezone_offset: string): Data.Series.Lazy py
}
