/**
 * A type to fetch and populate the SourceCollectionOverview grid.
 * It combines data from
 * {@link SourceCollection}, {@link DataIntegStatus} and {@link SourceCollection.Config}.
 */
type SourceCollectionOverview {

  /**
   * {@link SourceCollection} used in the overview panel.
   */
  sourceCollectionName: !string

  /**
   * Type of the SourceCollection
   */
  sourceCollectionType: !string

  /**
   * State of the latest entry of {@link DataIntegStatus}
   * for this {@link SourceCollection}.
   */
  status: string

  /**
   * Process rate of {@link SourceCollection}
   * It should be a rolling average of the per-second process rate over the past 10 minutes.
   * Essentially, sum(each TransformStatus inst successful count) / (10 mins * 60 seconds per min min)
   * filtered to TransformStatus.meta.updated > now() - 10 mins
   */
  processRate: double

  /**
   * Skip rate of {@link SourceCollection}
   * It should be a rolling average of the per-second skip rate over the past 10 minutes.
   * Essentially, sum(each TransformStatus inst skip count) / (10 mins * 60 seconds per min min)
   * filtered to TransformStatus.meta.updated > now() - 10 mins
   */
  skipRate: double

  /**
   * Failure rate of {@link SourceCollection}
   * It should be a rolling average of the per-second failure rate over the past 10 minutes.
   * Essentially, sum(each TransformStatus inst failed count) / (10 mins * 60 seconds per min min)
   * filtered to TransformStatus.meta.updated > now() - 10 mins
   */
  failureRate: double

  /**
   * Items currently being processed for {@link SourceCollection}
   */
  itemsQueueProcessing: double

  /**
   * Timestamp when Obj was updated in source system.
   */
  updated: datetime

  /**
   * Member id that last updated the instance.
   */
  updatedBy: string

  /**
   * processMode derived from {@link SourceCollection.Config} for {@link SourceCollection}
   */
  processMode: string enum SourceCollectionProcessMode

  /**
   * Only valid if processMode is ON_SCHEDULE
   */
  processSchedule: string serialized CronSchedule

  /**
   * Fetch method for the bridge
   *
   * @param spec
   *          spec of the fetch call
   *          of type FileSourceCollection, CloudMessageSourceCollection, and ApiSourceCollections
   * @return a collection of SourceCollectionOverview objects
   */
  fetch: function(spec: FetchSpec): FetchResult<SourceCollectionOverview> js-server

  /**
   * Fetch count method for the bridge
   *
   * @param spec
   *          spec of the fetch call
   *          of type FileSourceCollection, CloudMessageSourceCollection, and ApiSourceCollections
   * @return a collection of SourceCollectionOverview objects
   */
  fetchCount: function(spec: FetchFilterSpec): !int js-server
}
