/**
 * Preview the content of a {@link SourceFile}
 */
type SourceFilePreviewData {

  /**
   * The actual {@link SourceFile} associated with the SourceFile id
   */
  sourceFile: SourceFile

  /**
   * The objects that were read from `contentLocation`
   */
  objs: [Obj]

  /**
   * Reads objects from a source file's content location
   *
   * @param sourceFileId
   *        The id of the SourceFile to read
   * @param limit
   *        Optional limit for the number of objects to read
   *
   * @return formatted data for an {@link UiSdlDataGrid}
   */
  preview: function(sourceFileId: !string, limit: int): SourceFilePreviewData js-server
}
