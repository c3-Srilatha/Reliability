/**
 * Util type for generating data for the Metric Tiles and Filterable Volume Chart
 */
type DataIntegStatusUtil {

  /**
   * Generates time series data based on {@link DataIntegStatus}
   *
   * @param type_name
   *          Name of the {@link DataIntegStatus} type
   * @param time_field
   *          Name of the time field to aggregate over
   * @param aggregated_field_expr
   *          An expression to evaluate over the statuses (i.e. `count(errors)`)
   * @param additional_filter
   *          Any additional filter other than the interval filters. Used by {@link DataIntegStatusBySourceCollectionUtil}
   * @param client_start
   *          The start time in client's local timezone
   * @param client_end
   *          The end time in client's local timezone
   * @param client_timezone_offset
   *          The offset time in hours between UTC and client time
   * @param freq
   *          The frequency of sampling the data. Supports minute='min', hour='H', day='D', month='M'
   * @return an the timestamp index and aggregated data for the statuses
   */
  get_data: function(type_name: string,
                     time_field: string,
                     aggregated_field_expr: string,
                     additional_filter: Filter,
                     client_start: DateTime,
                     client_end: DateTime,
                     client_timezone: TimeZone,
                     freq: string): json py-data

  /**
   * An API that conforms to {@link UiSdlMetricTileDataSpec}'s requirements for
   * utilizing {@link UiSdlMetricTile}.
   */
  // TODO TOOLS-14123: remove this API if possible
  evalMetrics: function(spec: EvalMetricsSpec): json py-data
}
