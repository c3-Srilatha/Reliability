/**
 * A bridge for {@link SourceFile} where if doNotArchiveSources is set to false, it will
 * filter to {@link SourceFile}s where SourceCollection.inboxUrl() is the subpath of {@link SourceFile#contentLocation} . Else,
 * filter to {@link SourceFile}s where its associated {@link SourceStatus#state} is in {"initial", "stopped"}
 */
type SourceFileBridge {

  /**
   * Returns the filtered source files
   */
  fetch: function(spec: FetchSpec): FetchResult<SourceFile>

  /**
   * Returns the count for the filtered source files.
   */
  fetchCount: function(spec: FetchFilterSpec): int
}
