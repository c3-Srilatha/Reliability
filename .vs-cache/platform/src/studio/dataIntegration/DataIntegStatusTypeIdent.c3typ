/**
 * UI Accessible enum of the type identifiers of the different types of {@link DataIntegStatus}es
 */
enum type DataIntegStatusTypeIdent {

  /**
   * {@link SourceStatus#typeIdent}
   */
  SOURCE

  /**
   * {@link SourceChunkStatus#typeIdent}
   */
  CHUNK = 'SOURCE:CHUNK'

  /**
   * {@link TransformStatus#typeIdent}
   */
  TRANSFORM

  /**
   * {@link TargetStatus#typeIdent}
   */
  TARGET
}
