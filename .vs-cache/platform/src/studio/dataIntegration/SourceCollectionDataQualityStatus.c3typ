/**
 * Status for the {@link SourceCollection}'s data quality
 */
enum type SourceCollectionDataQualityStatus {

  /**
   * No rows were processed
   */
  NEUTRAL = 'neutral'

  /**
   * Errors when processing the rows
   */
  ERROR = 'error'

  /**
   * Rows were skipped, or, rows were processed
   * but no records were created or updated.
   */
  WARNING = 'warning'

  /**
   * Rows Processed successfully
   */
  SUCCESS = 'success'
}
