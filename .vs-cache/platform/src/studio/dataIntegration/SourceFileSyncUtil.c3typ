/**
 * A custom syncing util for {@link SourceFile}. Support syncing SourceFiles from Files in a SourceCollection and
 * SourceFiles that already exist.
 */
type SourceFileSyncUtil {

  /**
   * @param fileSourceCollectionName
   *        The name of the {@link FileSourceCollection}
   * @param sourceFileIds
   *        The list of the {@link SourceFile} ids to sync
   * @param syncSourceFileFromFile
   *        Whether to sync files in the {@link FileSourceCollection} to {@link SourceFile}s
   *
   * @returns true if there are any {@link SourceFile} being synced or false if no {@link SourceFile} synced
   */
  syncMetadataWithId: function(fileSourceCollectionName: string,
                               sourceFileIds: [string],
                               syncSourceFileFromFile: boolean): boolean js-server

  /**
   * sync all files from all {@link FileSourceCollection}s
   *
   * @returns an array of sourceCollectionName that were synced
   */
  syncAll: function(): [string] js-server
}
