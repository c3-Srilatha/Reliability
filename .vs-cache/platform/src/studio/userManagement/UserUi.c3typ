/**
 * Ui representation of {@link User}.
 * The {@link #id} of this {@link UserUi} is the same as the corresponding {@link User}.
 */
// ====================================================================================
@action(group+='user-admin')
private type UserUi mixes FetchableUi, WithUniqueId, WithName {

  /**
   * {@see User#email}
   */
  email: string

  /**
   * Last time the user logged into the env or app
   */
  lastLoginAt: datetime

  /**
   * {@see User#idpAssignedGroups}
   */
  idpAssignedGroups: private map<string serialized IdpConfig, [string]>

  /**
   * {@see User#groups}
   */
  groups: [UserGroup]

  /**
   * Fetches {@link UserUi} according to the FetchSpec
   */
  fetch: ~ js-server

  /**
   * Returns the fetch count of all {@link User} according to the FetchSpec
   */
  fetchCount: ~ js-server

  /**
   * Translates the {@link FetchSpec} for {@link UserUi} into one that can be applied to {@link User}.
   */
  translateFetchSpec: ~ js-server

  /**
   * Translates the {@link FetchSpec#filter} for {@link UserUi} into one that can be applied to {@link User}.
   */
  translateFilter: ~ js-server

  /**
   * Translates the {@link FetchSpec#include} for {@link UserUi} into one that can be applied to {@link User}.
   */
  translateInclude: ~ js-server

  // ====================================================================================

  /**
   * // TODO: PLAT-75190 - Move to IdentityManager
   * Abstraction across different IDPs and User Management. Synchronizes the User Management action with the underlying
   * IDP as necessary.
   */

  /**
   * Retrieves and validates the {@link IdpConfig} in the current context
   */
  validateAndGetIdpConfig: private function(): IdpConfig

  /**
   * Creates a user.
   * Leverage the {@link User#c3Groups} field to indicate initial {@link UserGroup}s. If there is an
   * associated idp and idp group, the {@link User#idpAssignedGroups} will be populated accordingly.
   * @param user
   */
  // TODO: PLAT-75190 - Move to IdentityManager
  createUser: function(user: !User): User

  /**
   * Adds the given users to the given groups.
   * @param userIds
   *          {@link User#id}
   * @param groupIds
   *          {@link UserGroup#id}
   */
  // TODO: PLAT-75190 - Move to IdentityManager
  addUsersToGroups: function(userIds: ![string], groupIds: ![string])

  /**
   * Removes the given users from the given groups.
   * @param userIds
   *          {@link User#id}
   * @param groupIds
   *          {@link UserGroup#id}
   */
  // TODO: PLAT-75190 - Move to IdentityManager
  removeUsersFromGroups: function(userIds: ![string], groupIds: ![string])

  /**
   * Removes the user
   */
  // TODO: PLAT-75190 - Move to IdentityManager
  removeUser: function(userId: !string)

  /**
   * A wrapper for {@link App#urls} to retrieve {@link AppUrl}s for a given app
   * TODO: PLAT-61502 Re-evaluate this wrapper once platform developer role has been updated
   * @param app
   *        {@link App} instance
   * @returns an array of {@link AppUrl}s for the application
   */
  fetchAppUrls: function(app: App): ![AppUrl]
}
