/**
 * Spec related to Alert providers for notification service
 */
type C3Notification.ServiceSpec.AlertProvider {

  /**
   * Service account name used by external alert provider service to contact notificationService
   */
  serviceAccountName: string = 'c3prometheus'

  /**
   * Role to assign to the service account user
   */
  serviceAccountRole: string = 'C3.NotificationService.AlertProvider'

  /**
   * The name of the Prometheus resource to use for alerting
   */
  prometheusResourceName: string = 'app-prometheus'
}
