/**
 * Spec type with different filtering options used for fetching Types from a Tag
 */
type FetchTypesFilterSpec {

  /**
   * Whether or not to skip returning Parametric Types
   */
  excludeParametric: boolean

  /**
   * The packages of types to return from
   */
  packages: [string]

  /**
   * Whether or not to skip Transforms types
   * MIG8-3362 Update handling of Transform
   */
  excludeTransforms: boolean
}
