/**
 * Ui representation of {@link MetadataPackage}
 */
type UiMetadataPackage {

  /**
   * See {@link MetadataPackage#name}
   */
  name: !string

  /**
   * Whether this package is the root package for the current {@link App}
   */
  isRoot: boolean
}
