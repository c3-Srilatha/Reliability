type TypesByCategory {

  /**
   * Indicates if the type is extendable
   */
  isExtendable: boolean

  /**
   * Indicates if the type is parametric
   */
  isParametric: boolean

  /**
   * Indicates if the type is transform
   */
  isTransform: boolean

  /**
   * Type name
   */
  name: !string

  /**
   * The package to which the type belongs
   */
  package: string
}
