/**
 * The data for a node that is associated with a {@link Type}.
 */
type GlobalCanvasGraphTypeAssociatedNodeData mixes GlobalCanvasGraphNodeData {

  /**
   * Number of fields defined in the type.
   */
  fieldsCount: int

  /**
   * The key for accessing {@link AllUiTypesGlobalState} and getting type data.
   */
  // TODO TOOLS-14154: move this field out of platform
  uiTypeId: string
}
