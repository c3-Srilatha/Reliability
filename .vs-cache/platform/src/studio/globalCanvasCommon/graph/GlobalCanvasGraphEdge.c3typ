/**
 * Represents an instance of an edge in a {@link GlobalCanvasGraph}
 */
type GlobalCanvasGraphEdge mixes Edge<GlobalCanvasGraphNode<GlobalCanvasGraphNodeData>> {

  /**
   * @inheritdoc
   */
  relationship: ~

  /**
   * Which node end point manages this edge. All nodes should be able to re-calculate all
   * the edges that it manages - regardless of its "incoming" or "outgoing" nature relative
   * to the node.
   */
  managedBy: [string]
}
