/**
 * Represents additional data about the node. The category of the node drives what the data will look like.
 */
type GlobalCanvasGraphNodeData {

  /**
   * The name of the node
   */
  name: string

  /**
   * The identifier for the metadata that this node represents (contextual to its category).
   * For example:
   *    For Entity category, the categoryMetadataIdentifier is the type name.
   *    For an Entity instance (ex: SourceCollection category), the categoryMetadataIdentifier is SourceCollection#id
   */
  categoryMetadataIdentifier: !string

  /**
   * The package that the node data is defined in.
   */
  package: !string

  /**
   * The status of the metadata binding
   */
  // TODO TOOLS-14154: move this field out of platform
  metadataStatus: string enum('PENDING', 'LINKED')
}
