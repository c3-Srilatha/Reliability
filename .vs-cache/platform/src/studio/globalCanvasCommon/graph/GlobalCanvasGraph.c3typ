/**
 * Graph interface used to model relationships in global canvas.
 */
type GlobalCanvasGraph mixes InMemoryGraph<GlobalCanvasGraphNode<GlobalCanvasGraphNodeData>, GlobalCanvasGraphEdge> {

  /**
   * `Graph.vertices` fails when the graph does not have vertices(PLAT-33612). This function is a wrapper
   * to `Graph.vertices` that will invoke the latter when the graph has vertices
   * See {@link Graph#vertices}
   */
  fetchVertices: member function(filter: string,
                                 bindings: ObjMapp): [GlobalCanvasGraphNode<GlobalCanvasGraphNodeData>] js-server
}
