// TODO TOOLS-11168, Convert this to a GlobalCanvasRegistration
enum type GlobalCanvasGraphEdgeRelationship {

  /**
   * Defines a ONE_TO_ONE relationship
   * ```
   *  title: Title
   * ```
   */
  ONE_TO_ONE

  /**
   * Defines a ONE_TO_MANY relationship
   * ```
   *  roles: [Role]
   * ```
   */
  ONE_TO_MANY

  /**
   * Defines a UI_TO_UI edge
   */
  UI_TO_UI
}
