/**
 * Represents an instance of a node in a {@link GlobalCanvasGraph}
 */
abstract type GlobalCanvasGraphNode<T: GlobalCanvasGraphNodeData> mixes Vertex {

  /**
   * Category of the node.
   */
  category: !string serialized GlobalCanvasGraphNodeCategory

  /**
   * Additional data about the instance of the node.
   */
  data: T
}
