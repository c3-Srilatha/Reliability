/**
 * Represents a single {@link GlobalCanvasGraphEntityNode.children} of an {@link Entity} type in a
 * {@link GlobalCanvasGraph}
 */
type GlobalCanvasGraphEntityNodeChild mixes Identifiable {

  /**
   * The name of the field
   */
  fieldName: string

  /**
   * The {@link ValueType} of the field
   */
  fieldValueType: string serialized ValueType

  /**
   * The level from the original type which the field is defined.
   * {@link User.id} is defined on {@link Persistable} which is 1 level away
   * {@link User.roles} is defined on {@link User} which is 0 levels away
   */
  level: int
}
