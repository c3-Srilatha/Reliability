/**
 * Structure of the package dependency graph
 */
type EntityRelationshipDiagramPackageDependencyGraph {

  /**
   * Information about the root package
   */
  rootPkg: !EntityRelationshipDiagramRootPackageInfo

  /**
   * Map of package dependencies where keys are package names and values are sets of their direct dependency packages
   */
  dependencies: !map<string, set<string>>

  /**
   * Detailed information for all packages in the dependency graph
   */
  pkgInfo: !map<string, EntityRelationshipDiagramPackageInfo>
}
