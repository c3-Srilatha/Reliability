/**
 * Util type for dataFusion code editor.
 */
type DataFusionCodeEditorUtil {

  /**
   * Returns the type definition for the given type name.
   *
   * @param typeName
   *           The name of the type.
   * @param pkg
   *           The name of the root package for the current application.
   * @returns a map with two key/value pairs:
   *    originalDeclaration: [declaration code]
   *    remixDeclaration: [declaration code] if applicable
   */
  getTypeDefinition: function(typeName: string, pkg: string): map<string, string> js-server

  /**
   * Returns the javaScript source code of a given type.
   *
   * @param typeName
   *            The name of the type.
   * @param pkg
   *         The name of the root package for the current application.
   * @returns a map with two key/value pairs:
   *    originalSourceCode: [implementation code]
   *    remixSourceCode: [implementation code] if applicable
   */
  getSourceCode: function(typeName: string, pkg: string): map<string, string> js-server

  /**
   * Returns the functions information of a given type.
   *
   * @param typeName
   *           The name of the type.
   * @param pkg
   *           The name of the root package for the current application.
   */
  getFunctionsInfo: function(typeName: string, pkg: string): map<string, map<string, [string]>> js-server

  /**
   * Returns the functions information of a given type.
   *
   * @param typeMeta
   *            The meta of the type.
   */
  getNewFunctionsInfo: function(typeMeta: TypeMeta): map<string, map<string, [string]>> js-server

  /**
   * Returns the sub path directory of a given type.
   *
   * @param typeMeta
   *            The meta of the type.
   */
  getSubPathDir: function(typeMeta: TypeMeta): string js-server

  /**
   * If a type is remixed, returns either the type declaration code, or the type implementation code, depending
   * on the value of the `codeType` argument.
   *
   * @param typeMeta
   *           The typeMeta of the type.
   * @param pkg
   *           The name of the root package that the type belongs to.
   * @param codeType
   *           Whether to get the type declaration or implementation code.
   * @returns The remix code .
   */
  getRemixCode: function(typeMeta: TypeMeta, pkg: string, codeType: string enum RemixCodeType): string js-server
}
