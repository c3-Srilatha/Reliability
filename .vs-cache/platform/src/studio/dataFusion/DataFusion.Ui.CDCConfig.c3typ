/**
 * Configuration for setting up CDC (Change Data Capture) for a single SQL source collection.
 * This type encapsulates all the parameters needed to configure CDC staging and processing.
 */
type DataFusion.Ui.CDCConfig {

  /**
   * The name of the SqlSourceCollection for which CDC is being configured
   */
  sqlSourceCollectionName: !string

  /**
   * The name for the FileSourceSystem to create for staging (e.g. SqlSourceCollectionName + "_FileSourceSystem")
   */
  fileSourceSystemName: !string

  /**
   * The name for the FileSourceCollection to create for staging (e.g. SqlSourceCollectionName + "_FileSourceCollection")
   */
  fileSourceCollectionName: !string

  /**
   * Array of Transform objects to be upserted for this source collection
   * These transforms define the data transformation from source to target
   * At this point, the transforms are not yet upserted. So, we define the transforms as json.
   */
  transforms: [json]

  /**
   * Array of TypeMeta objects for target types to be upserted
   */
  targets: [TypeMeta]
}
