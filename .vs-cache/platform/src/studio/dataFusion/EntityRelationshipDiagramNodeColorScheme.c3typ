// Enum type for possible node color scheme options to select from
enum type EntityRelationshipDiagramNodeColorScheme {

  // Nodes will be colored by package
  PACKAGE = 'package'

  // Nodes will be colored by a single color
  NO_COLOR = 'noColor'

  /**
   * Nodes are colored into two colors
   * 1. If they are integrated into the application (they are a target type for a {@link Transform})
   * 2. If they are populated by the application (all other entities)
   */
  INTEGRATED_POPULATED = 'integratedPopulated'
}
