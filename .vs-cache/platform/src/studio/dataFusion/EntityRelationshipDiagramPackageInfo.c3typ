/**
 * Information about a package in the dependency graph
 */
type EntityRelationshipDiagramPackageInfo {

  /**
   * Name of the package
   */
  name: !string

  /**
   * version of this pkg. {@link Pkg.Decl#version}
   */
  version: !string serialized SemanticVersion

  /**
   * Version up to which this pkg is compatible to. {@link Pkg.Decl#compatibleToVersion}
   */
  compatibleToVersion: !string serialized SemanticVersion

  /**
   * AppMode of the package (e.g., dev, prod)
   */
  appMode: string enum AppMode
}
