/**
 * All fields for {@link EntityRelationshipDiagramView}, shared between the persisted entity and the spec for creation/updates {@link EntityRelationshipDiagramView.Spec}
 */
type EntityRelationshipDiagramView.Fields mixes WithName {

  /**
   * Optional description for the diagram view
   */
  description: string

  /**
   * The saved diagram settings of the view
   */
  diagramSettings: !EntityRelationshipDiagramUiSettings

  /**
   * Positions for every graph node as a map of [id: string] : {x: number, y: number}, saved as a json to avoid large sub-tables
   */
  graphPosition: json

  /**
   * The filters applied to the diagram, stored as a JSON object.
   * Format: {[filterField: string]: {[pkgId: string]: {selected: boolean, name: string, ...pkgProps}}}
   * Example: {"packages": {"pkg1": {selected: true, name: "pkg1"}, "pkg2": {selected: false, name: "pkg2"}}}
   */
  diagramFilterList: json
}
