/**
 * Utility functions for Data Integration UI
 */
@typeScript
type DataFusion.Ui.DataIntegUtil {

  /**
   * Fetches all source systems with their configurations.
   * Returns an array of source systems where each source system is wrapped in a 'fst' property.
   *
   * The response format is:
   * [
   *   {
   *     fst: {
   *       name: string,
   *       type: string,
   *       ...other source system properties
   *     }
   *   },
   *   ...
   * ]
   *
   * @returns {Array<{fst: SourceSystem}>} Array of source systems with their configurations
   */
  fetchSourceSystemsWithConfig: function(spec: FetchSpec): [Pair<SourceSystem, SourceSystem.Config>]

  /**
   * Returns an array of declared field types that are associated with the specified type name.
   *
   * @param {string} typeName - The name of the type to fetch field types for
   * @returns Array of declared field types for the specified type
   */
  fetchFieldTypesForTypeName: function(typeName: !string): [DeclaredFieldType]

  /**
   * Helper utility to allow an {@link CronJob} to trigger a data integration pipeline even though
   * {@link DataInteg.Executor} is not {@link Persistable}
   */
  executePipeline: function(pipeline: DataInteg.Pipeline)

  /**
   * Creates an {@link DataInteg.Pipeline} and its child steps
   */
  createPipeline: function(pipeline: DataInteg.Pipeline): DataInteg.Pipeline

  /**
   * Publishes a pipeline and its steps.
   * This function assumes that the pipeline and its steps have already been upserted.
   *
   * @param pipeline {@link DataInteg.Pipeline} The pipeline to publish
   */
  publishPipeline: function(pipeline: DataInteg.Pipeline)

  /**
   * Updates a step and all pipelines with a reference to it.
   */
  @beta
  upsertStepAndUpdatePipelines: function(step: DataInteg.Pipeline.Step): DataInteg.Pipeline.Step

  /**
   * Batch operation for complete CDC setup including staging and scheduling configuration.
   * Creates CDC staging components and configures processing schedule for multiple SQL source collections.
   */
  setupCompleteCDCPipelineBatch: function(configs: [DataFusion.Ui.CDCConfig]): [DataFusion.Ui.CDCBatchResult]

  /**
   * Starts CDC processing for multiple SQL source collections by calling startOnScheduleMode() on each.
   */
  startCDCPipelineBatch: function(sqlSourceCollectionNames: [string]): [DataFusion.Ui.CDCBatchResult]

  /**
   * Fetches all source collections excluding FileSourceCollections used as CDC staging collections.
   * Staged means files are in an intermediate state. They have been processed and are ready for further steps in the pipeline, but are not yet archived.
   */
  fetchSourceCollectionsExcludingStaged: function(spec: FetchSpec): [SourceCollection<SourceCollection.Config>]
}
