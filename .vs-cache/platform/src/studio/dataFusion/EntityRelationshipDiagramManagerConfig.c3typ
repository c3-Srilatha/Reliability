/**
 * General configs for the {@link EntityRelationshipDiagramManager}.
 */
type EntityRelationshipDiagramManagerConfig mixes Config, Singleton {

  /**
   * The maximum number of {@link EntityRelationshipDiagramView} in the ERD for the current app.
   */
  maxPersistedDiagramViews: int = 25

  /**
   * The id for the default {@link EntityRelationshipDiagramView} to render on page load
   */
  defaultDiagramViewId: string = 'detailed'

  /**
   * If enabled, types that reside in the `test/` path will be included in the ERD
   * This is disabled by default.
   */
  showTestTypes: boolean
}
