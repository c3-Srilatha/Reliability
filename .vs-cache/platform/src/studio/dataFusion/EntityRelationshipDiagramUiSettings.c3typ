// Represents the settings for the diagram, configurable from the UI
type EntityRelationshipDiagramUiSettings {

  // The color scheme for the nodes. See {@link EntityRelationshipDiagramNodeColorScheme} for possible options.
  nodeColorScheme: string enum EntityRelationshipDiagramNodeColorScheme

  // If true, shows the "External" token for applicable nodes.
  showExternalDataSourceTag: boolean = false

  // If true, shows the "Remixed" token for applicable nodes.
  showRemixTag: boolean = false

  // If true, shows the entity datastore tags for applicable nodes.
  showEntityTag: boolean = false

  // True to show the fields section on expanded {@link ErdNode}.
  showFields: boolean = false

  /**
   * True to show the `indexed` token for related fields on expanded {@link ErdNode}.
   * Note: only effective when {@link #showFields} is true.
   */
  showIndexed: boolean = false

  // True to show the calculated fields section on expanded {@link ErdNode}.
  showCalcFields: boolean = false

  // True to show the methods section on expanded {@link ErdNode}.
  showMethods: boolean = false
}
