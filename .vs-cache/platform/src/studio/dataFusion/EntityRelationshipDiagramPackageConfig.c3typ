/**
 * Configs for pkg to exclude for {@link EntityRelationshipDiagramManager} methods. Name of the config is the pkg name (either root, or dependency pkgs).
 */
type EntityRelationshipDiagramPackageConfig mixes Config, Named {

  /**
   * True if the pkg with the same name is to be excluded from {@link EntityRelationshipDiagramManager} methods.
   */
  exclude: boolean
}
