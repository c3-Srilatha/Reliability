/**
 * A representation of a "diagram view" pertaining to the entity relationship diagram.
 * A diagram view has contains diagram settings and saved node positions that can be loaded into the UI.
 */
@seed(userUpdatable=true, userRemovable=true)
entity type EntityRelationshipDiagramView mixes EntityRelationshipDiagramView.Fields, SeedData {

  /**
   * Create a diagram view from a {@link EntityRelationshipDiagramView.Spec}.
   * If pkg is updatable {@link Pkg#isUpdatable}, a seed data for the view will be created in pkg at the same time.
   * @param spec
   *           The spec describing the create operation
   * @returns The persisted {@link EntityRelationshipDiagramView}
   */
  createDiagramView: function(spec: !EntityRelationshipDiagramView.Spec): EntityRelationshipDiagramView

  /**
   * Update an existing diagram view.
   * If pkg is updatable {@link Pkg#isUpdatable}, seed data for the view will be updated in pkg at the same time.
   * @param id
   *          The id of the {@link EntityRelationshipDiagramView}
   * @param spec
   *           The spec describing the update operation
   * @returns The persisted {@link EntityRelationshipDiagramView}
   */
  // TODO: PLAT-119635: update the {@link EntityRelationshipDiagramManagerConfig} accordingly based on {@link EntityRelationshipDiagramView.Spec#setAsDefault}
  updateDiagramView: function(id: !string, spec: !EntityRelationshipDiagramView.Spec): EntityRelationshipDiagramView

  /**
   * Delete an existing diagram view.
   * If pkg is updatable {@link Pkg#isUpdatable}, seed data for the view will be removed.
   * @param id
   *          The id of the {@link EntityRelationshipDiagramView}
   * @returns If the remove operation was successful or not
   */
  deleteDiagramView: function(id: !string): boolean

  beforeCreate: ~

  /**
   * Wrapper for `fetch` to return objs with defaults
   */
  fetchWithDefaults: function(spec: FetchSpec): !FetchResult<mixing Fetchable>
}
