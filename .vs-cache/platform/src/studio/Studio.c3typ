/**
 * A way to administrate {@link App}s and {@link Env}s in a controlled manner.
 */
type Studio mixes StudioIface, Microservice.Proxy {

  @reClaim(inherit=true)
  @typesys(todo="PLAT-130528 - Remove Microservice.Proxy#proxyApp overrides from proxy types")
  proxyApp: ~

  /**
   * Deploy Studio and its services.
   * This method should be called on c3 app of the env.
   */
  @action(group+='cluster-admin')
  @reClaim(inherit=true)
  deploy: function(mode: string enum AppMode = PROD)

  /*
   * Deploys `notificationService` in the calling {@link Env} following {@link C3Notification.ServiceSpec}.
   * Will set the `notificationService` to be the CLUSTER level {@link Microservice.Config}.
   */
  @action(group+='cluster-admin')
  @reClaim(inherit=true)
  configureNotificationService: function(spec: C3Notification.ServiceSpec, mode: string enum AppMode = PROD)
}
