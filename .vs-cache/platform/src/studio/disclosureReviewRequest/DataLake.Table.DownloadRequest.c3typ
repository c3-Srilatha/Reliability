/**
 * A dataset download request that needs to be approved for a {@link Dataset} to be downloaded.
 */
entity type DataLake.Table.DownloadRequest extends DisclosureReviewRequest type key 'DATALAKE_TABLE_DOWNLOAD_REQUEST' {

  /**
   * The data table associated with this download request
   */
  datatable: DataLake.Table.Managed

  /**
   * The data table snapshot associated with this download request
   */
  snapshot: DataLake.Table.Snapshot.Iceberg

  /**
   * Create a {@link DataLake.Table.DownloadRequest} for a specific datatable snapshot.
   */
  @action(group='disclosure-requestor')
  createRequest: function(datatable: !DataLake.Table.Managed,
                          snapshot: !DataLake.Table.Snapshot.Iceberg,
                          spec: DataLake.Table.DownloadRequest.CreateRequestSpec): DataLake.Table.DownloadRequest js-server

  /**
   * Export the corresponding datatable as csv
   */
  @dependency(include='status, datatable.this, snapshot')
  @action(group='disclosure-requestor')
  exportTable: member function() js-server

  @action(group='disclosure-requestor')
  exportTableWithId: function(id: !string) js-server

  @dependency(include='status')
  @action(group='disclosure-reviewer')
  approveRequest: ~

  @dependency(include='status')
  @action(group='disclosure-reviewer')
  rejectRequest: ~

  @action(group='disclosure-reviewer')
  expireRequest: ~
}
