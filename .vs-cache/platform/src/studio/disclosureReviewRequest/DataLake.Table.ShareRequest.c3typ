/**
 * A dataset share request that needs to be approved for a dataset to be shared
 * with other {@link UserGroup}s or {@link User}s.
 */
entity type DataLake.Table.ShareRequest extends DisclosureReviewRequest type key 'DATALAKE_TABLE_SHARE_REQUEST' {

  /**
   * Prone to change
   */
  datatable: DataLake.Table.Managed

  /**
   * The user groups that will have access to this {@link Dataset}
   */
  sharedGroups: [UserGroup]

  /**
   * The permissions allowed for the sharedGroups
   */
  sharePermissions: string enum('READONLY', 'READWRITE') = 'READONLY'

  /**
   * Naming prone to change.
   * Create a {@link DataLake.Table.ShareRequest} for a specific datatable.
   */
  @action(group='disclosure-requestor')
  createRequest: function(datatable: !DataLake.Table.Managed,
                          spec: DataLake.Table.ShareRequest.CreateRequestSpec): DataLake.Table.ShareRequest js-server

  @dependency(include='status')
  @action(group='disclosure-reviewer')
  approveRequest: ~

  @dependency(include='status')
  @action(group='disclosure-reviewer')
  rejectRequest: ~

  @action(group='disclosure-reviewer')
  expireRequest: ~
}
