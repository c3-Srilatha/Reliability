/**
 * Entities that need to go through disclosure review process should mix this type.
 * See {@link DataLake.Table.Managed}, {@link DataLake.Table.ShareRequest}, and {@link DataLake.Table.DownloadRequest}
 */
type DisclosureReviewAclEntity {

  /**
   * The owner of this entity.
   */
  owner: User

  /**
   * The {@link UserGroup}s who will have access to this entity.
   */
  sharedGroups: [UserGroup]

  /**
   * The {@link UserGroup}s who will have read access to this entity.
   */
  sharedReadOnlyGroups: [UserGroup]

  /**
   * The {@link UserGroup}s who will have update and remove access to this entity.
   */
  sharedUpdateRemoveGroups: [UserGroup]
}
