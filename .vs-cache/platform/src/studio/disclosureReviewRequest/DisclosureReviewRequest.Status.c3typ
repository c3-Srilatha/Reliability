/**
 * The different statuses of a {@link DisclosureReviewRequest}.
 */
enum type DisclosureReviewRequest.Status {

  /**
   * The request is waiting for approval.
   */
  PENDING = 'pending'

  /**
   * The request is approved.
   */
  APPROVED = 'approved'

  /**
   * The request is rejected.
   */
  REJECTED = 'rejected'

  /**
   * The request is expired.
   */
  EXPIRED = 'expired'
}
