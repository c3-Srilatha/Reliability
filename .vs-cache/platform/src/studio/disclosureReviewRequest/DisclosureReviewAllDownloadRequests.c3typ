/**
 * A wrapper type that contains all Download Requests
 */
    type DisclosureReviewAllDownloadRequests extends DisclosureReviewRequest type key 'DISCLOSURE_REVIEW_ALL_DOWNLOAD_REQUESTS' {

  /**
   * The id of the download request.
   */
  id: string

  /**
   * The type name associated with the download request.
   */
  typeName: string

  /**
   * The name of the table or story topic.
   */
  name: string

  /**
   * The name of the requester.
   */
  requestedByName: string

  /**
   * The date the request was created.
   */
  dateCreated: datetime

  /**
   * The status of the request.
   */
  status: string

  /**
   * The type of request to be displayed on grid.
   */
  requestType: string

  /**
   * The rest of the contents in the request.
   */
  contents: json

  /**
   * Custom fetch method to reconcile DataLake.Table.DownloadRequests and DisclosureReviewPdfDownloadRequests.
   */
  fetch:      ~ js-server
  fetchCount: ~ js-server

}
