/**
 * Specification of creating a {@link DataLake.Table.ShareRequest}.
 */
type DataLake.Table.ShareRequest.CreateRequestSpec mixes Spec {

  /**
   * The description of this request.
   */
  description: string

  /**
   * The {@link UserGroup}s who will have access to the datatable.
   */
  sharedGroups: [UserGroup]

  /**
   * The permissions allowed for the sharedGroups
   */
  sharePermissions: string enum('READONLY', 'READWRITE') = 'READONLY'
}
