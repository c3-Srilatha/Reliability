/**
 * A dataset download request that needs to be approved for a {@link Dataset} to be downloaded.
 */
entity type DisclosureReviewStoryPdfDownloadRequest extends DisclosureReviewRequest type key 'DISCLOSURE_REVIEW_STORY_PDF_DOWNLOAD_REQUEST' {

  /**
   * The base-64 encoded string for the pdf
   */
  pdf: string

  /**
   * The name of the story topic
   */
  name: string

  /**
   * The contents of the download request
   */
  contents: json

  /**
   * Create a {@link DisclosureReviewStoryPdfDownloadRequest} for a specific pdf download request.
   */
  @action(group='disclosure-requestor')
  createRequest: function(pdf: !string, name: !string): DisclosureReviewStoryPdfDownloadRequest js-server

  /**
   * Export the corresponding pdf
   */
  @dependency(include='status, contents.this')
  @action(group='disclosure-requestor')
  exportPdf: member function() js-server

  @dependency(include='status')
  @action(group='disclosure-reviewer')
  approveRequest: ~

  @dependency(include='status')
  @action(group='disclosure-reviewer')
  rejectRequest: ~

  @action(group='disclosure-reviewer')
  expireRequest: ~
}
