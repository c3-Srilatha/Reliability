/**
 * A translated fetch spec - used when needing to translate between a {@link FetchSpec} that targets a
 * UI data model and one that targets the true backend data model (ex: MlModelUi.fetch vs MlModel.fetch)
 * {@see TranslatedFilter}
 * {@see TranslatedInclude}
 */
type TranslatedFetchSpec {

  /**
   * The FetchSpec that applies to the backend model
   */
  fetchSpec: !FetchSpec

  /**
   * Additional contextual filters that need to be applied after the fetch
   */
  additionalFilter: map<string, json>

  /**
   * "include" fields that apply to the UI data model and should be added to the return value
   */
  additionalInclude: [string]
}
