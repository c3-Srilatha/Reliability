/**
 * A representation of a translated include string - used when needing to translate between a {@link FetchSpec#include} that targets a
 * UI data model and one that targets the true backend data model (ex: MlModelUi.fetch vs MlModel.fetch)
 * {@see TranslatedFetchSpec}
 * {@see TranslatedFilter}
 */
type TranslatedInclude {

  /**
   * The include tokens that can be applied to the backend data model
   */
  include: [string]

  /**
   * Include strings that are specific to the UI data model. Generally will be used if the backend data model is not
   * sufficient and additional processing needs to be applied in each instance to satisfy the presence of a field.
   */
  uiInclude: [string]
}
