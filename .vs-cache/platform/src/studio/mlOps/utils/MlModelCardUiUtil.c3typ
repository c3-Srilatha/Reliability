/**
 * Utility functions for fetching/getting Model card related type information,
 * and used by UI to store Redux state or feed metadata dataSpec.
 */
type MlModelCardUiUtil {

  /**
   * Fetches metrics from the model card with given uri.
   * @param uri
   *        URI associated with the model card.
   * @param spec
   *        FetchSpec object.
   */
  fetchMetrics: private function(uri: !string, spec: FetchSpec): FetchResult<json> js

  /**
   * Fetches metrics count from the model card with given uri.
   * @param uri
   *        URI associated with the model card.
   * @param spec
   *        FetchSpec object.
   */
  fetchMetricsCount: private function(uri: !string, spec: FetchSpec): !int js

  /**
   * Fetches params from the model card with given uri.
   * @param uri
   *        URI associated with the model card.
   * @param spec
   *        FetchSpec object.
   */
  fetchParams: private function(uri: !string, spec: FetchSpec): FetchResult<json> js

  /**
   * Fetches params count from the model card with given uri.
   * @param uri
   *        URI associated with the model card.
   * @param spec
   *        FetchSpec object.
   */
  fetchParamsCount: private function(uri: !string, spec: FetchSpec): !int js

  /**
   * Updates the given objs for the metrics / params of the model card. The UiSdlDataGrid inline edit triggers call to the action
   * upsertBatch on the type specified in the dataSpec. That's why we named it like this.
   * @param objs
   *        Modified values for the metrics / params.
   * @param srcObjs
   *        Original values for the metrics / params.
   */
  upsertBatch: private function(objs: ![json], srcObjs: [json]): any js
}
