/**
 * Util type for modelOps.
 */
type MlOpsUtil {

  /**
   * Returns display name for the user with given userId. If user is not found by the given userId, userId is returned as the displayName.
   * If the field value is email, email of the user will be returned as a display name.
   * If the field value is name, name of the user will be returned.
   * If the field value is not passed or invalid value is passed, userId will be returned as a display name.
   */
  getUserDisplayName: function(userId: string, field: string enum('name', 'email') = 'email'): string js-server
}
