/**
 * Ui representation of {@link MlPipeline} and its related types. This serves as a basic
 * aggregator across the related types to surface to the Ui.
 * The {@link #id} of this {@link MlPipeineUi} is the same as the corresponding {@link MlPipeline}.
 */
type MlPipelineUi mixes WithUniqueId, WithName {

  /**
   * Metadata about the training run, if this pipeline is trained.
   * Null if not trained.
   */
  trainedMetadata: MlPipelineUi.TrainedMetadata

  /**
   * Creates a {@link MlPipelineUi} from a {@link MlPipeline}.
   *
   * Callers should ensure that the following fields are populated:
   * - {@link MlPipeline.trainStatus}
   */
  from: function(mlPipeline: MlPipeline): MlPipelineUi js-server

  /**
   * Training status.
   */
  trainedStatus: string enum('TRAINED', 'UNTRAINED') = 'UNTRAINED'
}
