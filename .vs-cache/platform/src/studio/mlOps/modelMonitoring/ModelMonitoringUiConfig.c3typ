/**
 * UI configuration settings for model monitoring.
 */
type ModelMonitoringUiConfig mixes Config, Singleton {

  /**
   * Config map containing health value to color, icon, display text mapping.
   */
  modelHealthUiSettingsMap: map<string, ModelHealthUiSettings>

  /**
   * Model monitoring documentation url.
   */
  documentationUrl: string = 'https://developer.c3.ai/tutorial_notebooks/8.6/src-notebooks/Model-Monitoring.html'
}
