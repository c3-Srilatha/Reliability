/**
 * Ui representation of {@link MlModel} and its related types. This serves as a basic
 * aggregator across the related types to surface to the Ui.
 * The {@link #id} of this {@link MlModelUi} is the same as the corresponding {@link MlModel}.
 */
type MlModelUi mixes FetchableUi, WithUniqueId, WithName {

  /**
   * The project that this MlModelUi belongs to.
   */
  project: MlProjectUi

  /**
   * Representation of the pipeline that belongs to the model.
   */
  pipeline: MlPipelineUi

  /**
   * The feature sets associated with this MlModel, key'd by 'X' and 'Y'
   */
  featureSets: map<string, [FeatureUi.Set]>

  /**
   * The snapshots associated with this MlModel, key'd by 'X' and 'Y'
   */
  snapshots: map<string, [Feature.Set.Snapshot]>

  /**
   * The routes associated with the {@link MlModel}.
   */
  routes: [MlModelUi.Route]

  /**
   * Model health value.
   */
  health: string

  /**
   * Model health history.
   */
  healthHistory: [MlModel.Health.History]

  /**
   * Fetches {@link MlModelUi} according to the FetchSpec
   */
  fetch: ~ js-server

  /**
   * Returns the fetch count of all {@link MlModel} according to the FetchSpec
   */
  fetchCount: ~ js-server

  /**
   * Translates the {@link FetchSpec} for {@link MlModelUi} into one that can be applied to {@link MlModel}.
   */
  translateFetchSpec: ~ js-server

  /**
   * Translates the {@link FetchSpec#filter} for {@link MlModelUi} into one that can be applied to {@link MlModel}.
   */
  translateFilter: ~ js-server

  /**
   * Translates the {@link FetchSpec#include} for {@link MlModelUi} into one that can be applied to {@link MlModel}.
   */
  translateInclude: ~ js-server

  /**
   * Creates a {@link MlModelUi} instance from the give {@link MlModel}.
   *
   * Callers should ensure that the following fields are populated to receive a full {@link MlModelUi}:
   * - {@link MlModel#id}
   * - {@link MlModel#name}
   * - {@link MlModel#xFeatures}
   * - {@link MlModel#yFeatures}
   * - {@link MlModel#project.subjectType}
   */
  from: function(mlModel: MlModel): MlModelUi js-server

  /**
   * @param mlModelUis
   *           The {@link MlModelUi}s to return the feature sets for. If specified, returns all {@link Feature.Set}
   *           that are in the models. Assumes that {@link MlModelUi#featureSets} is populated.
   * @param includeAllIfEmpty
   *           Defines behavior if `modelUis` is not specified, or empty. If true, returns all {@link Feature.Set}s.
   *           If false, returns only feature sets across all models.
   */
  featureSetUis: function(mlModelUis: [MlModelUi], includeAllIfEmpty: boolean): [FeatureUi.Set] js-server

  /**
   * Deployed status.
   */
  deployedStatus: string enum('DEPLOYED', 'NOT DEPLOYED') = 'NOT DEPLOYED'

  /**
   * Train input.
   */
  trainInput: MlModel.Input
}
