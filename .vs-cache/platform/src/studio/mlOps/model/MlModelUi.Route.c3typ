/**
 * Ui representation of {@link MlModel.Routes}.
 * The {@link #id} of this {@link MlModelUi.Route} is the same as the corresponding {@link MlModel.Route}.
 */
type MlModelUi.Route mixes FetchableUi, WithUniqueId {

  /**
   * The total number of subject objects that this route captures.
   * This field is not eligible to be used in a {@link FetchSpec#filter}.
   */
  subjectCount: int

  /**
   * The model that this route predicts on.
   * There is a dual dependency between {@linkn MlModelUi.Route} and {@link MlModel#routes} for convenience.
   */
  model: MlModelUi

  /**
   * The project that this route belongs to. This can also be available on {@link MlModelUi.Route#model#project} but is
   * represented here for convenience.
   */
  project: MlProjectUi

  /**
   * The filter that this route predicts on.
   */
  subjectFilter: string serialized Filter

  /**
   * Information about who created the route and when
   */
  created: MlActionMetaUi

  /**
   * Metadata about the training run, if this pipeline is trained.
   * Null if not trained.
   */
  trainedMetadata: MlPipelineUi.TrainedMetadata

  /**
   * Current status of the route
   */
  currentStatus: MlModelUi.Route.Status

  /**
   * The destination for predictions
   */
  predictionDestinations: [string]

  /**
   * Represents how the UI wants to filter {@link MlModelUi.Route} with regards to subjects.
   * The UI has the option to filter by `subjectFilter` OR by an individual subject id.
   * ModelOps.RoutesFilterPanel will structure that filter value as
   * ['subjectFilter', '"country == 'GER'"] OR ['subjectId', 'windturbine_1'] where the
   * first index determines what kind of filtering should be applied and the second index
   * determines the filter value.
   * When it is passed to the backend the structure is stringified.
   * This field merely exists for documentation for the filterPanel to put these values on a field
   * for filtering purposes with `fetch`.
   * It will never be returned on a {@link MlModelUi.Route#fetch} or {@link MlModelUi.Route#from}
   * but it can be included in {@link FetchSpec#filter} of {@link MlModelUi.Route#fetch}.
   */
  uiSubjectFilter: private any

  /**
   * Fetches {@link MlModelUi.Route} according to the FetchSpec
   */
  fetch: ~ js-server

  /**
   * Returns the fetch count of all {@link MlModel.Route} according to the FetchSpec
   */
  fetchCount: ~ js-server

  /**
   * Translates the {@link FetchSpec} for {@link MlModelUi.Route} into one that can be applied to {@link MlModel.Route}.
   */
  translateFetchSpec: ~ js-server

  /**
   * Translates the {@link FetchSpec#filter} for {@link MlModelUi.Route} into one that can be applied to {@link MlModel.Route}.
   */
  translateFilter: ~ js-server

  /**
   * Translates the {@link FetchSpec#include} for {@link MlModelUi.Route} into one that can be applied to {@link MlModel.Route}.
   */
  translateInclude: ~ js-server

  /**
   * Creates a {@link MlModelUi.Route} from a {@link MlModel.Route}.
   *
   * @param mlModelRoute
   *    Callers should ensure that the following fields are populated for a full MlModelUi.Route:
   *      - {@link MlModel.Route#id}
   *      - {@link MlModel.Route#subjectFilter}
   *      - {@link MlModel.Route#project.subjectType}
   *      - {@link MlModel.Route#model}
   *      - {@link MlModel.Route#statusHistory}
   * @param include
   *      Array of field names defined on {@link MlModelUi.Route} to perform additional fetches for if not immediately convertible.
   *      Ex: 'subjectCount'
   */
  from: function(mlModelRoute: MlModel.Route, include: [string]): MlModelUi.Route js-server

  /**
   * @param subjectType
   *          The name of the type to get subjectFilters for
   * Returns the list of all available subjectFilters in existing {@link MlModel.Route} for this specific
   * subjectType.
   */
  subjectFilters: function(subjectType: string): [string] js-server

  /**
   * Returns the count of deployed models.
   */
  fetchDeployedModelsCount: private function(): int js-server
}
