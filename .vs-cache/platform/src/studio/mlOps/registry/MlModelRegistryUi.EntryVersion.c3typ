/**
 * UI representation of a model registry version - {@link ModelRegistry.Entry}
 */
type MlModelRegistryUi.EntryVersion mixes FetchableUi, WithUniqueId {

  /**
   * Reference to the path for this version
   */
  path: string

  /**
   * The version number of this entry
   */
  ver: int

  /**
   * The original package that added this registry entry.
   */
  pkgName: string

  /**
   * The description of this version
   */
  versionLog: string

  /**
   * The creation metadata
   */
  created: MlActionMetaUi

  /**
   * Converts a {@link ModelRegistry.Entry} to a {@link MlModelRegistryUi.EntryVersion}
   */
  from: function(versionEntry: ModelRegistry.Entry): MlModelRegistryUi.EntryVersion js-server

  translateFetchSpec: ~ js-server
  translateFilter:    ~ js-server
}
