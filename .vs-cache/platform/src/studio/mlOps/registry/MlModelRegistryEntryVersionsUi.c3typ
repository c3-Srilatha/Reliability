/**
 * UI representation for versions of the {@link ModelRegistry.Entry}.
 */
type MlModelRegistryEntryVersionsUi {

  /**
   * Fetches versions list containing {@link ModelRegistry.Entry} according to the FetchSpec.
   */
  fetch: private function(spec: FetchSpec): FetchResult<ModelRegistry.Entry> js-server

  /**
   * Returns the fetch count of all versions {@link ModelRegistry.Entry} according to the FetchSpec.
   */
  fetchCount: private function(spec: FetchSpec): int js-server

  /**
   * Returns global path and version details of a given path.
   */
  getEntryDetails: private function(path: !string): map<string, string> js-server
}
