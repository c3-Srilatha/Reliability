/**
 * Ui representation of {@link Feature.Set} and its related types.
 * The {@link #id} of this {@link FeatureUi.Set} is the same as the corresponding {@link Feature.Set}.
 */
type FeatureUi.Set mixes WithUniqueId, WithName {

  /**
   * Name of features on this set
   */
  features: set<string serialized Feature>

  /**
   * subjectType of this Feature Set
   */
  subjectType: Type<<FeatureEvaluatable>>

  /**
   * Returns the fetch count of all {@link Feature.Set}
   */
  fetchCount: function(fetchSpec: FetchSpec): int js-server

  /**
   * Creates a {@link FeatureUi.Set} from a {@link Feature.Set}.
   *
   * Callers should ensure that the following fields are populated:
   * - {@link Feature.Set#name}
   */
  from: function(featureSet: Feature.Set): FeatureUi.Set js-server
}
