/**
 * Type for the config to return by the ExMachinaTemplateTutorialUi.getByProjectId
 */
type ExMachinaTemplateTutorialUiConfig {

  /**
   * The template Id
   */
  id: !string

  /**
   * The template name
   */
  name: !string

  /**
   * A brief description of the template
   */
  description: string

  /**
   * The graph itself, stored as json.
   */
  graph: !string

  /**
   * The url to download the documentation of this template
   */
  documentationDownloadUrl: string

  /**
   * The url to access the documentation of this template
   */
  documentationUrl: string

  /**
   * Whether to show the tutorial content again
   */
  doNotShowAgain: boolean
}
