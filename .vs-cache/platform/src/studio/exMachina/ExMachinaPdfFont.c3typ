type ExMachinaPdfFont {

  /**
   * Font file as a base64 encoded string for the "normal" version of the font
   */
  normal: string

  /**
   * Font file as a base64 encoded string for the "bold" version of the font
   */
  bold: string

  /**
   * Font file as a base64 encoded string for the "italics" version of the font
   */
  italics: string

  /**
   * Font file as a base64 encoded string for the "bolditalics" version of the font
   */
  bolditalics: string

  /**
   * Get the "Roboto" fonts
   */
  @nodejs(typeSystem=true, async=false)
  getRoboto: function(): ExMachinaPdfFont js-exmachina-server-node
}
