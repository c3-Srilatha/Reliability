/**
 * A type for holding enterprise account credentials
 */
type BoxAppSetting mixes ConfigChild<BoxAppConfig> {

  /**
   * The client ID
   */
  @config(secret=true)
  clientID: string

  /**
   * The client secret
   */
  @config(secret=true)
  clientSecret: string

  /**
   * The public key
   */
  publicKeyId: string

  /**
   * The encrypted private key
   */
  @config(secret=true)
  privateKey: string

  /**
   * The encryption key
   */
  @config(secret=true)
  passphrase: string

  /**
   * The redirect uri
   */
  redirectUri: string
}
