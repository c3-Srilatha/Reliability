/**
 * Type to manage Box App credential, belonging to C3.
 */
@config(maxOverride=APP, merge=REPLACE)
type BoxAppConfig mixes Config, Singleton {

  /**
   * The enterprise ID of the Box account
   */
  enterpriseId: string

  /**
   * The Box account settings
   */
  boxAppSettings: BoxAppSetting

  /**
   * A helper function to set public and secret configs
   */
  setConfigAndSecret: function(clientId: string,
                               clientSecret: string,
                               publicKeyId: string,
                               privateKey: string,
                               passphrase: string,
                               enterpriseId: string,
                               redirectUri: string) js-server
}
