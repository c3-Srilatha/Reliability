/**
 * Type to manage Box User credential, belonging to user.
 */
@config(minOverride=USER, maxOverride=USER, merge=REPLACE)
type BoxUserConfig mixes Config {

  /**
   * ID of the user associated with this config
   */
  userId: string

  /**
   * Box user setting
   */
  boxUserSetting: BoxUserSetting

  /**
   * A helper function to set public and secret configs
   */
  setConfigAndSecret: function(userId: string,
                               accessToken: string,
                               refreshToken: string,
                               lastRefresh: int,
                               expires: int) js-server

  /**
   * A helper function to get public and secret configs
   */
  getConfigAndSecret: function(): BoxUserConfig js-server
}
