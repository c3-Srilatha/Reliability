/**
 * A type for holding user credentials
 */
type BoxUserSetting mixes ConfigChild<BoxUserConfig> {

  /**
   * User access token.
   */
  @config(secret=true)
  accessToken: string

  /**
   * User refresh token, to be user to refresh accessToken once it's been expired.
   */
  @config(secret=true)
  refreshToken: string

  /**
   * Last time in millis when the access token was refreshed.
   */
  lastRefresh: int

  /**
   * Time in millis when the current accessToken will expire.
   */
  expires: int
}
