/**
 * Entity type to store the key pointing to the config where the credentials are actually stored
 */
extendable entity type ExMachinaConnectorCredential mixes AclEnabled, ExMachinaUserGroupShareable<ExMachinaConnectorCredential, ExMachinaConnectorCredentialOwnership, ExMachinaConnectorCredentialShareHistory> schema name 'EMCC' {

  /**
   * Display name of credential. Same as {@link DataConnectorCredential.displayName}
   */
  displayName: !string

  /**
   * The data store type. Same as {@link DataConnectorCredential.datastore}
   */
  datastore: !string enum ExMachinaDatastoreType

  /**
   * Custom description of the credential. Same as {@link DataConnectorCredential.description}
   */
  description: string

  /**
   * Saves credential information. Upserts an {@link ExMachinaConnectorCredential} record with the provided credential.
   * @param credential
   *           Credential spec to upsert.
   * @return upserted credential.
   */
  upsertCredential: function(credential: !DataConnectorCredential): ExMachinaConnectorCredential js-server

  /**
   * Returns the credential details for the current {@link ExMachinaConnectorCredential}
   * @return credential.
   */
  getCredential: member function(): DataConnectorCredential js-server

  /**
   * Fetches all connector credentials for the current user, then filters them and returns only the list of credentials
   * that the user is able to read based on the ACL. This prevents high-permission users (i.e., C3.Group.Developer)
   * from fetching credential objects created by other users.
   */
  fetchReadableCredentialObjs: private function(fetchSpec: FetchSpec): [ExMachinaConnectorCredential] js-server

  /**
   * Returns the list of credentials available to the user. Relies on ACLPrivilege for
   * {@link ExMachinaConnectorCredential}
   * @return all credentials.
   */
  fetchCredentials: function(datastore: string enum ExMachinaDatastoreType): FetchResult<DataConnectorCredential> js-server

  /**
   * Helper function for called within {@link fetchCredentialAssets} that can take in a filter to allow filtering on
   * fields that are available within the package that he method is being called within.
   */
  fetchCredentialAssetsHelper: private function(datastore: string enum ExMachinaDatastoreType,
                                                include: string): FetchResult<ExMachinaConnectorCredential> js-server

  /**
   * Returns the list of credential wrappers whose internals the user has access to.
   * Relies on ACLPrivilege for {@link ExMachinaConnectorCredential}
   * @return all credentials.
   */
  fetchCredentialWrappers: function(spec: FetchSpec): FetchResult<ExMachinaConnectorCredential> js-server

  /**
   * Returns the list of credential assets that are readable by the current member. The list does not include keys
   * with the credentials, so this should only be used for rendering useful metadata in the UI.
   *
   * @param datastore
   *           Optional datastore to use as a filter
   */
  fetchCredentialAssets: function(datastore: string enum ExMachinaDatastoreType)
                           : FetchResult<ExMachinaConnectorCredential> js-server

  /**
   * Removes {@link ExMachinaConnectorCredential} instance and the corresponding
   * {@link ExMachinaConnectorCredentialConfig} instance.
   * @return true if removal was successful, false otherwise
   */
  removeCredential: member function(): boolean js-server

  /**
   * Updates only the displayName and description fields of the {@link ExMachinaConnectorCredential}
   * and the underlying {@link ExMachinaConnectorCredentialConfig}
   * @param spec
   *          The spec to update the connector metadata.
   */
  updateCredentialMetadata: function(spec: !ExMachinaConnectorCredentialUpdateMetadataSpec) js-server

  @dependency(include='currentOwner.from.id')
  updateAdditionalAcls: ~ js-server

  /**
   * TODO: VAD-16871 - Add a common afterCreate for all shareable types after PLAT-51996 fix
   * Common logic to run after creation of any types that mixin {@link ExMachinaUserGroupShareable}
   */
  @dependency(include='isPubliclyAccessible, meta.createdBy, acl.member.id')
  afterCreate: ~ js-server
}
