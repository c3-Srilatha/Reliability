/**
 * Base type for managing all connector credential fields, including {@link JdbcCredentials} and {@link
 * CloudCredentials}.
 */
abstract type DataConnectorCredential {

  /**
   * Id of credential. For JdbcCredentials, it will be set based on {@link JdbcStoreConfig.name}. For CloudCredentials,
   * it will be set based on {@link CloudResource.resourceName}
   */
  id: string

  /**
   * Server address of credential. It will be set based on {@link JdbcCredentials.serverEndpoint} or {@link
   * CloudCredentials.endpoint}
   */
  serverEndpoint: string

  /**
   *  Display name of credential. It will be set based on displayName property on {@link JdbcStoreConfig.description} or
   * {@link CloudResource.description}.
   */
  displayName: string

  /**
   * Cloud service native secret Key. This field is available for both  {@link JdbcCredentials} type and {@link
   * CloudCrednetials} type.
   */
  secretKey: string

  /**
   * The data store type, including both JdbcStore types and FileSystem types.
   */
  datastore: string enum ExMachinaDatastoreType

  /**
   * Custom description of the credential.
   */
  description: string


//TODO: VAD-16892 remove below fields once ACL and mixin is fixed as it was just workarounds
  filePathPrefix: string

  /**
   * Cloud service native Access Key.
   */
  accessKey: string

  /**
   * Cloud account / subscription id.
   */
  accountId: string

  /**
   * Cloud service native identity for managing access to Cloud Resources. It is typically associated with compute
   * instance.
   */
  cloudIdentity: string

  /**
   * Cloud region for the credentials.
   */
  region: string

  /**
   * User name of credential. It will be set based on {@link JdbcCredentials.username}. This field is only set for
   * {@link JdbcCredentials} type.
   */
  username: string

  /**
   * A hashed password of credential. This field is only set for {@link JdbcCredentials} type.
   */
  password: string

  @config(secret=true)
  content: json
}
