/**
 * Config type for storing random credentials that cannot be stored as {@link JdbcCredentials} or {@link CloudCredentials}..
 */
@config(maxOverride=USER, minOverride=USER)
type JsonDataConnectorCredential mixes DataConnectorCredential, Config, Identifiable {

  @config(secret=true)
  content: json

  /**
   * Retrieve all credentials for given datastore
   */
  retrieveAll: function(datastore: !string enum ExMachinaDatastoreType): [JsonDataConnectorCredential] js-server

  /**
   * Save a new credential.
   */
  upsert: function(credentialKey: string, credential: JsonDataConnectorCredential): boolean js-server

  /**
   * Remove an existent credential.
   */
  remove: function(credential: JsonDataConnectorCredential): boolean js-server

  /**
   * Retrieve an existent credential.
   */
  get: function(credentialKey: string,
                datastore: !string enum ExMachinaDatastoreType): JsonDataConnectorCredential js-server
}
