type DataConnectorCredentialManagement mixes Value {

  /**
   * Retrieve all credential of the data store type that the caller has access to.
   *
   * @param datastore
   *           The data store type.
   */
  retrieveAll: function(datastore: !string enum ExMachinaDatastoreType)
                 : [FileSystemDataConnectorCredential | JdbcStoreDataConnectorCredential | JsonDataConnectorCredential] js-server

  /**
   * Create or update the credential in {@link JdbcCredentials}.
   */
  upsert: function(credential: !(FileSystemDataConnectorCredential | JdbcStoreDataConnectorCredential | JsonDataConnectorCredential))
            : boolean js-server

  /**
   * Remove the credential.
   */
  remove: function(credential: !(FileSystemDataConnectorCredential | JdbcStoreDataConnectorCredential | JsonDataConnectorCredential))
            : boolean js-server

  /**
   * Get the credential.
   *
   * @param credential
   *           The credential id
   */
  get: function(credential: string,
                datastore: !string enum ExMachinaDatastoreType)
         : FileSystemDataConnectorCredential | JdbcStoreDataConnectorCredential | JsonDataConnectorCredential js-server

  /**
   * Create the credential used for the storage service storing the shared files.
   *
   * @param credential
   *           The credential {@link FileSystemDataConnectorCredential}
   */
  createSharedFileStorageCredential: function(credential: !DataConnectorSharedFileStorageCredential): boolean js-server

  /**
   * Obtain the credential used for the storage service storing the shared files.
   */
  sharedFileStorageCredential: function(): DataConnectorSharedFileStorageCredential js-server
}
