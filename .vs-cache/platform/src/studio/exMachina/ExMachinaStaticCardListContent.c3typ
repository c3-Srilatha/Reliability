/**
 * This type is to persist the static card list content. Each record will be used
 * as card content
 */
@seed(userUpdatable=true, userRemovable=true)
entity type ExMachinaStaticCardListContent mixes SeedData schema name 'SCLC' {

  /**
   * The location where it's used for. For example, 'HOME_GET_STARTED' will be
   * use in the "Get Started" card list on the home page
   */
  location: !string enum('HOME_GET_STARTED', 'HOME_COMMUNITY')

  /**
   * Card header
   */
  header: string

  /**
   * Card sub header
   */
  subHeader: string

  /**
   * Card appearance order
   */
  sortOrder: int

  /**
   * Card link
   */
  link: string

  /**
   * Card content
   */
  contentBodyText: string

  /**
   * Card footer
   */
  footerText: string
}
