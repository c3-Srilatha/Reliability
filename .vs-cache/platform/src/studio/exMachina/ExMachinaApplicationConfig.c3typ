/**
 * Ex Machina application configuration details
 */
type ExMachinaApplicationConfig mixes Config, Singleton {

  /**
   * If set, will load appcues with this key.
   */
  @config(secret=true)
  appcuesKey: string

  /**
   * If set, will load google maps with this key.
   */
  @config(secret=true)
  googleMapsKey: string

  /**
   * If a workspace reaches or surpasses these memory usage percentages, the user will be presented with a warning alert
   * banner that prompts them to take action. Each value in the array must have a corresponding translation prefixed
   * with `ExMachinaManagement.EnvironmentStatus.Status.memoryUsedWarning.`, such as
   * `ExMachinaManagement.EnvironmentStatus.Status.memoryUsedWarning.90`
   */
  memoryUsagePercentageWarningThresholds: [int] = [90, 100]

  /**
   * The min workspace size available.
   */
  workspaceMinSize: ExMachinaMemorySize = {id: '16G'}

  /**
   * For non-subscription deployments (exMachinaUi), the max workspace size available. For subscription-based
   * deployments, this will be set on each individual plan.
   */
  workspaceMaxSize: ExMachinaMemorySize = {id: '1T'}

  /**
   * The path where documentation articles can be found and should therefore also be added in the case of new ones.
   */
  docsDirectoryPath: string = 'ui/content/docs/'

  /**
   * The path where the Notices & Acknowledgements file can be found.
   */
  acknowledgementsFilePath: string = '/assets/about/acknowledgements.pdf'

  /**
   * The path where the legal agreement can be found.
   */
  legalAgreementFilePath: string = 'ui/content/legal-agreement.md'

  /**
   * Enabling this would show the PDF download button to users, thorugh which
   * users can download the current visualization as a PDF.
   */
  isPdfConfigured: boolean = true

  /**
   * Checks whether {@link ExMachinaApplicationConfig.isPdfConfigured} is configured within {@link ExMachinaApplicationConfig}
   */
  getPdfConfigured: function(): boolean js-server

  /**
   * The number of days a request can stay pending before it gets automatically declined and marked expired.
   */
  requestPendingDaysUntilExpiration: int = 10

  /**
   * Default max workspace size for new account members.
   */
  defaultMaxSize: ExMachinaMemorySize = {"id": "32G"}

  /**
   * Default starting workspace size for new account members.
   */
  defaultStartingSize: ExMachinaMemorySize = {"id": "32G"}

  /**
   * Default time after which the environment will be shutdown automatically if idle.
   */
  defaultAutoShutdownPeriod: int = 30

  /**
   * If true, editors can change the shutdown period.
   */
  editorsCanModifyShutdown: boolean = true
}
