/**
 * Used to write PDF Reports in Ex Machina
 */
type ExMachinaPdf {

  /**
   * Write a PDF Report to the given file path
   *
   * @param fileUrl
   *          The file desired file path of the PDF report (including the name)
   *          Ex. gcs://c3--platform/pttest3/iem/pdfreports/sample.pdf
   *
   * @param pdfElems
   *         A list of {@link ExMachinaPdfElement} objects which represents the element to render onto the PDF.
   *         See {@link ExMachinaPdf#generatePdf} for more information on this parameter.
   *
   * @param additionalOptions
   *          Additional options to pass to the PDF generation process.
   *          See {@link ExMachinaPdf#generatePdf} for more information on this parameter.
   *
   * @return The {@link File} referencing the generated PDF report
   */
  @nodejs(typeSystem=true, async=true)
  writeReport: function(fileUrl: !string,
                        pdfElems: !json,
                        additionalOptions: json = {}): File js-exmachina-server-node

  /**
   * Generate a PDF Report as to the given file path
   *
   * @param pdfElems
   *          A list of {@link ExMachinaPdfElement} objects which represents the element to render onto the PDF.
   *          It is supposed to be of type {@link ExMachinaPdfElement} and not `json`, but putting {@link ExMachinaPdfElement}
   *          currently does not work because of limitation with typed JSON objects where having `"type"` as a field name in the
   *          object tries to serialize it to a C3 type system object and throws an error when it can't.
   *
   *          As a workaround, we have made the parameter type be `json`, instead of `json` within {@link ExMachinaPdfElement}
   *
   *          TODO PLAT-88676: Revert pdfElems from being a `json` to `[ExMachinaPdfElement]`
   *
   * @param additionalOptions
   *          Additional options to pass to the PDF generation process. These will be added directly to the document definition
   *          object that is passed to the pdfmake library.
   *          See the pdfmake documentation for more information on the available options: https://pdfmake.github.io/docs/0.1/
   *
   * @return The base64 encoded string corresponding to the PDF report
   */
  @nodejs(typeSystem=true, async=true)
  generatePdf: function(pdfElems: !json, additionalOptions: json = {}): string js-exmachina-server-node
}
