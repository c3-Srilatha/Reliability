/**
 * When an {@link ExMachinaApprovalRequest} is approved or declined, this validates whether that action is allowed
 * and if it will be successful. The resulting object is used within {@link UiAsyncEffectExMachinaUpdateTeamMemberApproval}.
 */
type ExMachinaApprovalValidationResponse {

  /**
   * Whether the request was approved/declined successfully.
   */
  success: boolean

  /**
   * Whether the request can be successfully approved/decilne.
   */
  valid: boolean

  /**
   * Whether the member approving/declining the request is authorized to do so.
   */
  unauthorized: boolean

  /**
   * The request object itself.
   */
  approvalRequest: ExMachinaApprovalRequest
}
