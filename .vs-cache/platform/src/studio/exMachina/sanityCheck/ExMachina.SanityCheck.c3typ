/**
 * Used to run sanity checks on the {@link ExMachina} service and related components.
 */
type ExMachina.SanityCheck {

  /**
   * Same as {@link ExMachina.SanityCheck#sanityCheck} but does not mutate any data
   */
  safeSanityCheck: function(): ExMachina.SanityCheck.Result js-server

  /**
   * Checks Ex Machina-related {@link CronJob}s, {@link InvalidationQueue}s, {@link ExMachinaInstance}s, and
   * {@link ExMachinaStory}s to ensure that the service can function properly.
   * @param spec
   *            Spec to dictate whether or not certain mutative actions should be performed in the sanity check.
   */
  sanityCheck: function(spec: ExMachina.SanityCheck.Spec): ExMachina.SanityCheck.Result js-server

  /**
   * Performs sanity check on the Ex Machina {@link CronJob}s.
   */
  sanityCheckCronJobs: private function(spec: ExMachina.SanityCheck.Spec): ExMachina.SanityCheck.Result js-server

  /**
   * Performs sanity check on the {@link InvalidationQueue}s that Ex Machina uses. The queues to check
   * are {@link ActionQueue}, {@link MetricsQueue}, {@link PopulateAclQueue}, {@link CalcFieldsQueue},
   * and {@link CronQueue}.
   */
  sanityCheckQueues: private function(spec: ExMachina.SanityCheck.Spec): ExMachina.SanityCheck.Result js-server

  /**
   * Performs sanity check on {@link ExMachinaInstance.Config} and the latest {@link ExMachinaInstance}. The user can
   * specify whether to run a "heavy-weight" sanity check, in which case a new {@link ExMachina} service will be created
   * and diagnosed.
   */
  sanityCheckExMachinaInstance: private function(spec: ExMachina.SanityCheck.Spec): ExMachina.SanityCheck.Result js-server

  /**
   * Performs sanity check on components related to {@link ExMachinaStory}s. Namely, the FileSystem must be configured,
   * and if there is an {@link ExMachinaVisualizationElement} available, it must be readable.
   */
  sanityCheckExMachinaStories: private function(spec: ExMachina.SanityCheck.Spec): ExMachina.SanityCheck.Result js-server
}
