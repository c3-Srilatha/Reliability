type ExMachina.SanityCheck.Spec {
  skipCronJobs: boolean = false

  skipInvalidationQueues: boolean = false

  skipInstance: boolean = false

  skipStories: boolean = false

  /**
   * standUpInstance refers to starting the Ex Machina Service, which is a heavy-weight
   * process. This should only be done from the static console since it may take up to 5
   * minutes to complete--or longer if the service is unhealthy.
   */
  standUpInstance: boolean = false
}
