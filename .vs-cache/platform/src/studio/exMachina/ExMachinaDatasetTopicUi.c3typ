/**
 * A wrapper around {@link ExMachinaDatasetTopic} to provide additional fields that will change depending on the user
 * accessing the records. These additional fields drive logic to show/hide certain buttons on the Datasets page in the
 * UI.
 */
type ExMachinaDatasetTopicUi extends ExMachinaDatasetTopic mixes ExMachinaUserGroupShareableUi<ExMachinaDatasetTopic, ExMachinaDatasetTopicUi> type key "EXM_DATASET_TOPC_UI" schema name "EXM_DATASET_TOPC_UI" {

  fetch:      ~ js-server
  fetchCount: ~ js-server
}
