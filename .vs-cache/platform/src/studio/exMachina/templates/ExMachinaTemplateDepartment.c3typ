/**
 * Type representing department categories
 */
enum type ExMachinaTemplateDepartment {

  /**
   * Finance department
   */
  FINANCE = 'Finance'

  /**
   * HR department
   */
  HR

  /**
   * IT department
   */
  IT

  /**
   * Operations department
   */
  OPERATIONS = 'Operations'

  /**
   * The 'other' department category
   */
  OTHER = 'Other'

  /**
   * Quality and Reliability department
   */
  QUALITY_RELIABILITY = 'Quality & Reliability'

  /**
   * Risk department
   */
  RISK = 'Risk'

  /**
   * Sales and Marketing department
   */
  SALES_MARKETING = 'Sales & Marketing'

  /**
   * Supply Chain department
   */
  SUPPLY_CHAIN = 'Supply Chain'
}
