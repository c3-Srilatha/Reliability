/**
 * Template request for templates page
 */
entity type ExMachinaTemplateRequest mixes AclEnabled schema name 'VAD_TPL_RQST' {

  /**
   * The relevant industry type of the template request
   */
  industry: !string enum ExMachinaTemplateIndustry

  /**
   * The relevant department type of the template request
   */
  department: !string enum ExMachinaTemplateDepartment

  /**
   * A short description to describe the intention of the template request
   */
  useCaseDescription: !string

  /**
   * An optional field to specify the industry for when 'Other' is selected
   */
  customIndustry: string

  /**
   * An optional field to specify the department for when 'Other' is selected
   */
  customDepartment: string

  /**
   * Request a new {@link ExMachinaTemplateRequest} and persist it for later use
   */
  requestTemplate: function(spec: ExMachinaTemplateRequestCreateSpec): ExMachinaTemplateRequest js-server

  /**
   * Returns possible industry enumerations
   */
  getIndustryList: function(): [string] js-server

  /**
   * Returns possible department enumerations
   */
  getDepartmentList: function(): [string] js-server
}
