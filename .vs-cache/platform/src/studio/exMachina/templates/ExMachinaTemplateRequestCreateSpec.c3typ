/**
 * Spec for {@link ExMachinaTemplateRequest.requestTemplate}.
 */
type ExMachinaTemplateRequestCreateSpec {

  /**
   * An industry category for {@link ExMachinaTemplateRequest}
   */
  industry: !string enum ExMachinaTemplateIndustry

  /**
   * A department category for {@link ExMachinaTemplateRequest}
   */
  department: !string enum ExMachinaTemplateDepartment

  /**
   * A use case description for {@link ExMachinaTemplateRequest}
   */
  useCaseDescription: !string

  /**
   * An optional field to specify the industry of the template request
   */
  customIndustry: string

  /**
   * An optional field to specify the department of the template request
   */
  customDepartment: string
}
