/**
 * This type is to persist additional resources content.
 */
@db(order='ascending(sortOrder)')
@seed(userUpdatable=true, userRemovable=true)
entity type ExMachinaResource mixes SeedData schema name 'EXM_RSRC' {

  /**
   * Resource id
   */
  id: !~

  /**
   * Resource name/title
   */
  name: ~ translate by id

  /**
   * Resource description
   */
  description: string translate by id

  /**
   * Resource icon
   */
  icon: string

  /**
   * Resource appearance order
   */
  sortOrder: int

  /**
   * Resource link
   */
  hyperlink: string
}
