/**
 * Infosec report provids visibility into what datasets were uploaded and/or shared within ExMachina instance.
 */
type ExMachinaInfosecReport  {

  /**
   * Downloads the datasets for both the CSV nodes and other dataset information
   */
  downloadDatasetInfo: function() js-client

  /**
   * Retrieves the dataset information in datasetMetadataHistory.
   */
  getDatasetAssets: function(): [[string]] js-server

  /**
   * Download csv file.
   */
  downloadCSV: function(csvLines:[string], filePrefix:string) js-client
}
