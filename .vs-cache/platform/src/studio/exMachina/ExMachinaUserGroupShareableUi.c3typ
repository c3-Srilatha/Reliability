/**
 * A wrapper around a type that mixes {@link ExMachinaUserGroupShareable} to provide additional fields that will change
 * depending on the user accessing the records. These additional fields drive logic to show/hide certain buttons on the
 * related pages for the type of shareable in the UI. Even if a button is hidden for a user, back-end guarding should
 * be provided to prevent users from making the applicable API calls.
 *
 * As a parametric type, the first parameter represents the shareable entity type and the second parameter is the
 * UI wrapper type, which must also mix the shareable entity type.
 */
type ExMachinaUserGroupShareableUi<S, SUI> {

  /**
   * Used internally to derive the shareable entity type from the type that mixes ExMachinaUserGroupShareableUi
   */
  typeName: private S

  /**
   * Whether the member viewing a record of a type mixing {@link ExMachinaUserGroupShareable} should be allowed to
   * view details of the shareable
   */
  allowViewDetails: boolean

  /**
   * Whether the member viewing a record of a type mixing {@link ExMachinaUserGroupShareable} should be allowed to
   * share the shareable
   */
  allowShare: boolean

  /**
   * Whether the member viewing a record of a type mixing {@link ExMachinaUserGroupShareable} should be allowed to
   * delete the shareable
   */
  allowDelete: boolean

  /**
   * Whether the member viewing a record of a type mixing {@link ExMachinaUserGroupShareable} should be allowed to
   * disable the shareable
   */
  allowDisable: boolean

  /**
   * Whether the member viewing a record of a type mixing {@link ExMachinaUserGroupShareable} should be allowed to
   * enable the shareable
   */
  allowEnable: boolean

  /**
   * Whether the member viewing a record of a type mixing {@link ExMachinaUserGroupShareable} should be allowed to
   * edit the shareable
   */
  allowEdit: boolean

  /**
   * Helper method to get the shareable entity type related to the caller type that mixes ExMachinaUserGroupShareableUi
   */
  getShareableEntityType: private inline function(): Type js-server

  /**
   * Fetches all accessible records for a type mixing {@link ExMachinaUserGroupShareable} and performs additional
   * checks to add fields that can be used by the UI. This can be used to populate a grid.
   */
  fetch: function(spec: FetchSpec): FetchResult<mixing SUI> js-server

  /**
   * Utility function to process the fetch results of the shareable entity.
   */
  processFetchResult: private function(shareableEntityFetchResult: FetchResult<S>,
                                       uiWrapperType: Type): FetchResult<SUI> js-server

  /**
   * Utility function to process list of shareable entities.
   */
  processShareableEntities: private function(shareableEntities: [S],
                                             uiWrapperType: Type): [SUI] js-server

  /**
   * Fetches the accessible count of records for a type mixing {@link ExMachinaUserGroupShareable}. This can be used
   * to populate the pagination for a grid.
   */
  fetchCount: function(spec: FetchSpec): int js-server

  /**
   * Utility function to retrieve include spec.
   */
  getIncludeSpec: private inline function(includeSpec: string): string js-server
}
