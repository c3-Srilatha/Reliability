entity type ExMachinaDemo_WeatherData {

  timestamp: datetime	

  temp:	double

  temp_min:	double

  temp_max:	double

  pressure:	int

  humidity:	int

  wind_speed:	int

  wind_deg:	int

  rain_1h: int

  rain_3h: int

  snow_3h:int

  clouds_all: int	

  weather_main:	string

  weather_description: string

  sunlight_average: double

}
