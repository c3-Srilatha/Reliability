/**
 * Type for Setting UI configs
 */
type ExMachinaSettingsFormUi {

  /**
   * Current Memory size
   */
  currentMemorySize: string

  /**
   * Current Auto Shutdown Setting
   */
  currentAutoShutdownSetting: int

  /**
   * Used to fetch info for Settings form
   */
  @action(group+='read')
  getUiSettingsFormData: function(): ExMachinaSettingsFormUi js-server

  /**
   * Persists settings form data into {@link ExMachinaUser}
   * @param formObject
   *          The form object
   */
  @action(group+='write')
  saveUiSettingsFormData: function(formObject: ExMachinaSettingsFormSpec)
                            : ExMachinaSettingsFormUiSaveUiSettingsFormDataResponse js-server

  /**
   * Fetches the memory size options that are smaller or equal to than the current member's max workspace size.
   * @see ExMachinaUser.size
   */
  @action(group+='read')
  availableMemorySizes: function(): FetchResult<ExMachinaMemorySize> js-server

  /**
   * Fetches the memory size options that are greater than the current member's max workspace size.
   * @see ExMachinaUser.size
   */
  @action(group+='read')
  unavailableMemorySizes: function(): FetchResult<ExMachinaMemorySize> js-server
}
