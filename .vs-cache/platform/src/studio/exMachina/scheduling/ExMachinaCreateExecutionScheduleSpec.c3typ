/**
 * Parameters for creating new schedule
 */
type ExMachinaCreateExecutionScheduleSpec mixes ExMachinaCreateCronJobSpec {

  /**
   * Schedule name
   */
  name: !string

  /**
   * Pipeline selected for execution
   */
  pipeline: ExMachinaProject

  /**
   * Pipeline properties bindings
   */
  propertiesBindings: json

  /**
   * Pipeline version to be selected for scheduling
   */
  pipelineVersion: int

  /**
   * The memory size to use when starting an ExMachinaSession for the scheduled execution
   */
  sessionSize: ExMachinaMemorySize

  /**
   * {@link ExMachinaUser}s to receive alerts on schedule updates.
   */
  accountMembersToNotify: [ExMachinaUser] schema suffix 'MBRS_TO_NTFY'
}
