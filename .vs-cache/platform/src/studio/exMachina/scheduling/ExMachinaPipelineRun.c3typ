/**
 * Type representing execution of pipelines
 */
entity type ExMachinaPipelineRun mixes AclEnabled schema name 'EXM_RUN' {

  /**
   * Specifies parameters for pipeline execution
   */
  spec: !ExMachinaPipelineRunSpec

  /**
   * State of pipeline run
   */
  state: !string enum ExMachinaPipelineRunState

  /**
   * Pipeline properties bindings
   */
  propertiesBindings: json

  /**
   * Trigger which started the execution. If missing then the execution was started manually.
   */
  trigger: ExMachinaExecutionTrigger

  /**
   * ExMachina Action used for run execution.
   */
  actionId: string

  /**
   * Date and time when run started.
   */
  startedAt: datetime

  /**
   * Date and time when run completed.
   */
  completedAt: datetime

  /**
   * The total time duration for the execution to complete
   */
  duration: int calc exists(completedAt) && exists(startedAt) && completedAt - startedAt >= 0 ? completedAt - startedAt : null

  /**
   * Whether the run is complete
   */
  isComplete: boolean calc exists(completedAt) || (state == 'completed') || (state == 'aborted') || (state == 'failed')

  /**
   * If the run failed, the error thrown if any
   */
  error: string

  /**
   * The session in which the pipeline was run
   */
  session: ExMachinaSession

  /**
   * Identify the list of newly completed runs by comparing the {@link completedAt} field on the new records with the
   * old records.
   */
  identifyNewlyCompletedRuns: private function(newRunRecords: !?[ExMachinaPipelineRun]): [ExMachinaPipelineRun] js-server
}
