/**
 * Schedule for pipeline execution
 */
entity type ExMachinaExecutionSchedule extends ExMachinaExecutionTrigger
                                       mixes ExMachinaDynamicCronJobScheduler<ExMachinaExecutionSchedule>, ExMachinaCreateCronJobSpec
                                       type key 'ST' {

  makeCronJobForSchedule:                ~
  getNumHoursIntoFutureToUpsertCronJobs: ~
  onStateChange:                         ~ js-server
  afterRemove:                           ~ js-server

  /**
   * Returns a new {@link ExMachinaScheduleUi}.
   */
  getScheduleUi: member function(): ExMachinaScheduleUi js-server

  /**
   * Creates a new {@link ExMachinaExecutionSchedule}.
   */
  createFromSpec: function(spec: !ExMachinaCreateExecutionScheduleSpec): ExMachinaExecutionSchedule js-server

  /**
   * Edits an existing {@link ExMachinaExecutionSchedule}.
   */
  editSchedule: member function(spec: !ExMachinaCreateExecutionScheduleSpec): ExMachinaExecutionSchedule js-server

  /**
   * Renames the schedule
   *
   * @param scheduleName
   *          The new schedule name
   */
  renameSchedule: member function(scheduleName: !string): ExMachinaExecutionSchedule js-server

  /**
   * Draft an {@link ExMachinaExecutionSchedule} based on the original creation spec and run spec
   */
  draftSchedule: function(scheduleSpec: !ExMachinaCreateExecutionScheduleSpec,
                          runSpec: !ExMachinaPipelineRunSpec): ExMachinaExecutionSchedule js-server

  /**
   * Helper function to fetch the list of running schedules
   */
  getRunningSchedules: function(): [ExMachinaExecutionSchedule] js-server

  /**
   * Helper function to get a list of projects running in schedules
   */
  getProjectsRunningInSchedules: function(): [string] js-server

  /**
   * Checks whether {@link ExMachinaConfig.isEmailServiceConfigured} is configured within {@link ExMachinaConfig}
   */
  getEmailServiceConfig: function(): boolean js-server

  /**
   * Run job associated with trigger.
   */
  @dependency(include='this,spec')
  runFromTrigger: member function(): ExMachinaPipelineRun js-server

  /**
   * Get the {@link ExMachinaExecutionSchedule} for the input spec
   */
  createPipelineRunSpec: private function(scheduleSpec: !ExMachinaCreateExecutionScheduleSpec)
                                   : ExMachinaExecutionSchedule js-server
}
