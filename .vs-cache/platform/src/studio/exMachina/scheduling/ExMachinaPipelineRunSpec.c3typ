/**
 * Defines parameters for pipeline execution
 */
entity type ExMachinaPipelineRunSpec mixes AclEnabled schema name 'EXM_JOB' {

  /**
   * Pipeline to be executed
   */
  pipeline: !ExMachinaProject

  /**
   * Pipeline input operators
   */
  inputOperators: json

  /**
   * Pipeline input bindings
   */
  inputBindings: json

  /**
   * Execute actions with given ids defined in pipeline
   */
  actionDefinitionIds: json

  /**
   * Execute actions with given ids defined in pipeline
   */
  actionDefinitions: json

  /**
   * Pipeline version to be selected for scheduling
   */
  pipelineVersion: int
}
