/**
 * This type includes all expression engine functions used by any ExMachina types
 * to calculate fields at runtime - provides a functional parallel to calc fields.
 */
type ExMachinaExpressionEngineFunction mixes ExpressionEngineFunction, Value {

  /**
   * Custom expression engine function to calculate whether a given {@link User}
   * is the currently logged in {@link User}
   * @param userId
   *          The current owner of the shared entity
   */
  isCurrentUser: function(userId: string): boolean js-server
}
