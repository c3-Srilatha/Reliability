/**
 * Information about an {@link ExMachinaUser} and the linked {@link ExMachinaAccount} to help determine what
 * the user should be able to access. Used by {@link ExMachinaUser.userInfo}.
 */
type ExMachinaUserInfo {

  /**
   * Whether the user is an Admin (is an AppAdmin, EnvAdmin, or ClusterAdmin)
   */
  isAdmin: boolean

  /**
   * Whether the user can approve / deny download and sharing requests
   */
  isDataDisclosureAdmin: boolean

  /**
   * Whether the user is an editor exempt from going through the approval flow for download and sharing data
   */
  isPowerEditor: boolean

  /**
   * Whether the user is an editor that needs to go through approval flow for download and sharing data
   */
  isLimitedEditor: boolean

  /**
   * Whether the user is any type of editor (Power Editor or Limited Editor)
   */
  isEditor: boolean

  /**
   * Whether the member is a Viewer in a Team account
   */
  isViewer: boolean

  /**
   * Whether the member is an Editor or a Viewer in a Team account
   */
  isCollaborator: boolean

  /**
   * True if the user does not own any Visual Notebook
   */
  isNewUser: boolean
}
