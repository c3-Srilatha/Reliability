/**
 * Helper type that can be used to seed {@link ExMachinaDatasetTopic} and {@link ExMachinaDatasetMetadata} records.
 */
entity type ExMachinaSeedDataset mixes SeedData schema name 'EXM_SEED_DTAST' {

  /**
   * Dataset description. This populates {@link ExMachinaDatasetTopic.description} and
   * {@link ExMachinaDatasetMetadata.description} after running {@link seedDatasets}.
   */
  description: string

  /**
   * Dataset schema. This populates {@link ExMachinaDatasetMetadata.dataSchema} after running {@link seedDatasets}.
   */
  dataSchema: json

  /**
   * Dataset digest. This populates {@link ExMachinaDatasetMetadata.digest} after running {@link seedDatasets}.
   */
  digest: json

  /**
   * Fetches all {@link ExMachinaSeedDataset}s and generates datasets by copying resource files from the given source
   * file system directory under the mounted `/` {@link FileSystemMount}.
   *
   * Example:
   *
   * For a test dataset with `id` "iris" and `sourceFileSystemLocation` set to "s3://c3-exmachina-seed-datasets",
   * resource files will be copied from `"s3://c3-exmachina-seed-datasets/iris/" to
   * `FileSystem.mounts().get('/') + "/dataset-storage/iris/"`.
   *
   * @param  sourceFileSystemLocation
   *            The path to a directory in the source file system that contains the source files.
   *            Note: We currently only support an S3 path as the `sourceFileSystemLocation`.
   * @return A series of success/failure messages for each test dataset.
   */
  seedDatasets: function(sourceFileSystemLocation: string = 'gcs://exmachina-dev/exmachina-seed-datasets'): [json] js-server

  /**
   * Creates the {@link ExMachinaDatasetTopic} and {@link ExMachinaDatasetMetadata} from the incoming object
   */
  createDatasetTopicAndMetadata: private function(seedDatasetObj: ExMachinaSeedDataset) js-server
}
