/**
 * Represents one {@link ExMachinaProjectRoot} with information about the related {@link ExMachinaProject}s and
 * {@link ExMachinaPipeline}
 */
type ExMachinaPipelineAssetDetailsResult {

  /**
   * The id of the {@link ExMachinaProjectRoot}
   */
  id: string

  /**
   * The name of the {@link ExMachinaProjectRoot}
   */
  name: string

  /**
   * The {@link ExMachinaProjectRoot}'s description
   */
  description: string

  /**
   * When the {@link ExMachinaProject} was last updated
   */
  pipelineAssetMetadata: [ExMachinaPipelineAssetDetailsAssetMetadataResult]
}
