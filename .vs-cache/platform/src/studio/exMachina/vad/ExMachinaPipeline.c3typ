@db(unique=['project'])
entity type ExMachinaPipeline mixes AclEnabled, ExMachinaUserGroupShareableRelated<ExMachinaPipeline> schema name 'EXM_PIPELINE' {

  /**
   * Pipeline name
   */
  name: !string

  /**
   * Pipeline description
   */
  description: string

  /**
   * Parent project
   */
  project: ExMachinaProject

  /**
   * Pipeline definition format
   */
  format: string

  /**
   * Pipeline definition in json format
   */
  definition: json

  /**
   * Pipeline metadata in json format
   */
  metadata: json

  /**
   * After creating the pipeline asset, remove the default ACL to prevent the creator from retaining viewing permissions even
   * after transferring ownership and leaving the team
   */
  afterCreate: ~ js-server
}
