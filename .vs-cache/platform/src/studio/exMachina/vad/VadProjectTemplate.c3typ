/**
 * A template that can be used as a starting point for a new project.
 */
@db(unique=['id'], versionHistory=true, archive=true, order='ascending(order)')
@seed(notUserCreatable=false, userUpdatable=true, userRemovable=true)
entity type VadProjectTemplate mixes SeedData schema name 'VAD_PROJ_TPL' {

  id: !string

  /**
   * The name of the graph.
   */
  name: !string

  /**
   * A brief description of the template
   */
  description: string

  /**
   * A detailed desci[ption of the template
   */
  detailedDescription: string

  /**
   * An image URL for the template
   */
  image: string

  /**
   * The graph itself, stored as string.
   */
  @deprecated(finalVersion='7.33',
              details='Please use the field `definition` instead because it is JSON and we do not need to manually parse it')
  graph: string

  /**
   * The definition itself, stored as json.
   */
  definition: !json = {}

  /**
   * The url to download the documentation of this template
   */
  documentationDownloadUrl: string

  /**
   * The url to access the documentation of this template
   */
  documentationUrl: string

  /**
   * The list of relevant analyses, e.g. Timeseries, Regression
   */
  analysis: [VADProjectTemplateClassifier] schema name 'ANA'

  /**
   * The list of relevant departments, e.g. Marketing, Finance
   */
  department: [VADProjectTemplateClassifier] schema name 'DEP'

  /**
   * The list of relevant industries, e.g. Energy
   */
  industry: [VADProjectTemplateClassifier] schema name 'IND'

  /**
   * The list of use cases, e.g. Demand Forecasting
   */
  usecase: [VADProjectTemplateClassifier] schema name 'USE'

  /**
   * An order that represents this template's display priority
   */
  order: int

  /**
   * If true, this template should be displayed on home page
   */
  featured: boolean

  /**
   * If true, this template will display the instructional logo
   */
  instructional: boolean

  /**
   * Used for text search by keyword across fields
   */
  @db(textSearchField=true)
  textSearchField: string stored calc join(["name", "description", "analysis", "department", "industry", "usecase"], ' ')
}
