/**
 * Represents the settings of a {@link ExMachinaProject}.
 */
type ExMachinaProjectSettings {

  /**
   * The description of the {@link ExMachinaProject}
   */
  description: string

  /**
   * {@link ExMachinaProjectUserPreference} to show a project settings modal on project load
   */
  showSettingsModal: boolean
}
