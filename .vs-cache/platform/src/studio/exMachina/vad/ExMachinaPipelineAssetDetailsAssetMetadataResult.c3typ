/**
 * Provides information about an {@link ExMachinaProject} and the related {@link ExMachinaPipeline}
 */
type ExMachinaPipelineAssetDetailsAssetMetadataResult {

  /**
   * The id of the {@link ExMachinaProject}
   */
  projectId: string

  /**
   * The name of the {@link ExMachinaProject}
   */
  name: string

  /**
   * The {@link ExMachinaProject}'s description
   */
  description: string

  /**
   * The version number for the {@link ExMachinaProject}
   */
  versionNumber: int

  /**
   * When the {@link ExMachinaProject} was published
   */
  created: datetime

  /**
   * The id of the {@link ExMachinaPipeline}
   */
  pipelineId: string

  /**
   * The {@link ExMachinaPipeline.definition}
   */
  assetDefinition: json

  /**
   * The {@link ExMachinaPipeline.metadata}
   */
  assetMetadata: json
}
