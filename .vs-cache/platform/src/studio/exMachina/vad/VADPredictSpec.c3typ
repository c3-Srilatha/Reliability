type VADPredictSpec {

  projectName:        !string
  predictionNodeName: !string

  /**
   * parameters for invoking fetch(). all optional.
   */
  filter: string

  limit: int = 100

  /**
   * For cases where we already have FetchResult on which we want to predict, we allow providing
   * that data directly in the invocation. If this field is set, we predict on the specified input,
   * thereby not making any calls to C3.
   */
  input: FetchResult
}
