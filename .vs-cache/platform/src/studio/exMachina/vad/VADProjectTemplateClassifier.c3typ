/**
 * Type representing a classifier that {@link VadProjectTemplate}s can be filtered by
 */
entity type VADProjectTemplateClassifier mixes SeedData schema name 'VAD_PROJ_TPL_CLFR' {

  /**
   * The category that this classifier maps to
   */
  category: !string enum('industry', 'analysis', 'department', 'usecase')

  /**
   * The translated category to be displayes to user
   */
  displayCategory: string translate by category

  /**
   * The topic under the classifier's category
   */
  topic: string translate by id
}
