entity type ExMachinaProjectRoot mixes AclEnabled, ExMachinaSoftRemovable<ExMachinaProjectRoot>, ExMachinaUserGroupShareable<ExMachinaProjectRoot, ExMachinaProjectRootOwnership, ExMachinaProjectRootShareHistory> schema name 'EXM_PROJECT_RT' {

  /**
   * Project root name
   */
  name: !string

  /**
   * Project root description
   */
  description: string calc currentHead.description

  /**
   * If the project has been published, when the current head project was created.
   * If the project has not been published, null.
   */
  lastPublished: datetime calc isPublished ? currentHead.meta.created : null

  /**
   * When the current head project was last updated
   */
  lastUpdated: datetime calc currentHead.meta.updated

  /**
   * Associated Projects
   */
  @db(order='descending(meta.created)')
  projects: [ExMachinaProject](root)

  /**
   * The total number of projects (versions) for the root
   */
  numVersions: int calc count(projects)

  /**
   * Whether the project has been pubslished. An unpublished project will have 1 project in the project lineage.
   */
  isPublished: boolean calc numVersions > 1

  /**
   * Translated string representing whether the project is published or unpublished.
   */
  displayIsPublished: string translate by isPublished

  /**
   * The current head project for the current project root. There can only be one head project per root and projects
   * can only be created via {@link ExMachinaProjectRoot.publishProject}.
   */
  currentHead: ExMachinaProject

  /**
   * The project kind, currently we support 'STANDARD' and 'PIPELINE'
   */
  kind: !string enum ExMachinaProjectKind

  /**
   * The {@link ExMachinaProjectRoot} which was cloned to create this project
   */
  cloned: ExMachinaProjectRoot

  /**
   * The template where this project copies from
   */
  fromTemplate: VadProjectTemplate

  /**
   * Clones the given `project` with a new, unique name.
   * @param project
   *           the project to clone
   * @return the cloned project
   */
  cloneProject: function(project: ExMachinaProjectRoot): ExMachinaProjectRoot js-server

  /**
   * Cancel all jobs and child futures related to current graph on the project
   *
   * @param session
   *          The session in which to cancel the project execution
   */
  cancelGraph: member function(session: !ExMachinaSession): json js-server

  /**
   * Creates a new {@link ExMachinaProjectRoot} and child ExMachinaProject and marks it as the current head.
   */
  @action(group+='write')
  createProject: function(formObj: !ExMachinaCreateProjectSpec): ExMachinaProjectRoot js-server

  /**
   * Renames the project
   *
   * @param projectId
   *          The project id
   * @param projectName
   *          The project name
   */
  renameProject: function(projectId: string, projectName: string): ExMachinaProjectRoot js-server

  /**
   * If applicable, cancels any current graph runs for the project and performs a soft-remove of the
   * ExMachinaProjectRoot, which retains functionality for downstream objects, such as pipeline assets.
   */
  removeProject: member function(): boolean js-server

  /**
   * Create a project from the template with the given template id
   * @param template
   *           The template to copy the graph from
   * @param projectName
   *           The project name. IF it's empty, it will use the template name as the project name
   * @return The newly created project with graph copied from the template
   */
  createFromTemplate: function(template: !VadProjectTemplate, projectName: string): ExMachinaProjectRoot js-server

  /**
   * @param kind
   *           Project kind
   * @param name
   *           Project name
   * @param description
   *           Project description
   * @param definition
   *           The project definition
   */
  doCreateProject: function(kind: !string enum ExMachinaProjectKind,
                            name: !string,
                            description: string,
                            definition: json): ExMachinaProjectRoot js-server

  /**
   * Gets the current head project for the project root and sets the pipeline {@link ExMachinaProject.asset} on it and
   * creates a new head {@link ExMachinaProject} with an empty asset.
   *
   * @param  pipelineAssetId The pipeline asset id that will be associated with the current project head before
   *                         creating a new project head. This API assumes the {@link ExMachinaPipeline} with that id
   *                         has already been persisted to the database.
   * @param  formObj Fields coming from the UI that will be applied at time-of-publish.
   * @return The new head project for the project root after publishing the previous head project
   */
  @dependency(include='id, kind, name, description, currentHead.format, currentHead.definition')
  publishProject: member function(formObj: ExMachinaPublishProjectSpec,
                                  pipelineAssetId: string): ExMachinaProject js-server

  /**
   * Returns a flat list representing the version lineage hierarchy for the current project root.
   */
  @dependency(include='currentHead.id, { projects: [id, name, description, definition, parent.id, meta.created, meta.updated, asset.metadata] }')
  pipelineProjectVersionLineage: member function(): [ExMachinaProjectVersionLineageResult] js-server

  /**
   * Reverts the {@link currentHead}'s {@link ExMachinaProject.definition} and {@link ExMachinaProject.format} to that
   * of the {@link ExMachinaProject} with the given project id. If a project with the id cannot be found or if it does
   * not exist in the same version lineage, throws an error.
   *
   * @param  revertToProjectId The id of the {@link ExMachinaProject} to revert to.
   * @return The updated project after reverting to the previous version.
   */
  @dependency(include='id, currentHead')
  revertToPreviousVersion: member function(revertToProjectId: !string): ExMachinaProject js-server

  /**
   * Returns the Pipeline Asset details, including information about the input/output schemas. Note that the
   * `dependency` annotation for this method will filter out all {@link projects} that don't have an
   * {@link ExMachinaPipeline} asset, so this will not return the {@link currentHead} project.
   */
  @dependency(include='id, name, description, lastPublished, { projects: [id, name, description, { asset: [id, metadata, definition] }, meta.created] }.(exists(asset))')
  getPipelineAssetDetails: member function(): ExMachinaPipelineAssetDetailsResult js-server

  /**
   * Common logic to be performed by {@link removeProject} and implicitly by {@link remove} via the {@link beforeRemove}
   */
  beforeProjectRemove: member function() js-server

  /**
   * Common logic to pause the {@link ExMachinaExecutionSchedule}s of a removed project
   */
  pauseSchedulesOnProjectRemove: private function(projectId: !string) js-server

  beforeRemove: ~ js-server

  /**
   * Validates project name and graph values and creates a new project from the JSON file
   *
   * @param formObject
   *          formObject containing the project name and imported project definition
   */
  createProjectFromImportForm: function(formObject: ExMachinaImportVADProjectUiSpec): ExMachinaProjectRoot js-server

  /**
   * TODO: VAD-16871 - Add a common afterCreate for all shareable types after PLAT-51996 fix
   * Common logic to run after creation of any types that mix ExMachinaUserGroupShareable
   */
  @dependency(include='isPubliclyAccessible, meta.createdBy, acl.member.id')
  afterCreate: ~ js-server
}
