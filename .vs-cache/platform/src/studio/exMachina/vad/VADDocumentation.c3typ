entity type VADDocumentation schema name 'VAD_VADD' {

  /**
   * Whether the documentation is for a node or port
   */
  target: !string enum('node', 'port')

  /**
   * Target kind
   */
  targetKind: !string enum('classId', 'portId')

  /**
   * HTML content of the documentation
   * @example
   * ```html
   * <h1>CSV</h1><div>This node is for ...</div>
   * ```
   */
  htmlContent: string

  /**
   * Absolute url of documentation
   * @example
   * ```txt
   * /exMachinaDoc/input-data/file-upload/JSON
   * ```
   */
  url: string
}
