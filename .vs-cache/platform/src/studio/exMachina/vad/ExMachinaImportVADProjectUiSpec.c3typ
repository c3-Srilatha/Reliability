/**
 * Structure of the form object when importing a project
 */
type ExMachinaImportVADProjectUiSpec {

  /**
   * The graph itself, stringified (this allows to import legacy projects containing the protected "type" keyword).
   */
  graph: !string

  /**
   * The name of the project
   */
  name: string

  /**
   * The project description
   */
  description: string

  /**
   * The type of project that will be applied to the created project's {@link ExMachinaProjectRoot.kind}
   */
  projectKind: string enum ExMachinaProjectKind

  /**
   * The id of the {@link Tenant} associated with the project
   */
  tenant: string

  /**
   * The id of the {@link Tag} associated with the project
   */
  tag: string

  /**
   * A field to hold the fileUploaderComponent
   */
  fileUploaderComponent: [json]
}
