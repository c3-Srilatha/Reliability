@db(unique=['id'], versionHistory=true, archive=true)
entity type ExMachinaProject mixes AclEnabled, ExMachinaUserGroupShareableRelated<ExMachinaProject> schema name 'EXM_PROJECT' {

  /**
   * Project description
   */
  description: string

  /**
   * Project root
   */
  root: !ExMachinaProjectRoot

  /**
   * Parent project
   */
  parent: ExMachinaProject

  /**
   * Pipeline Asset generated by the project
   */
  asset: ExMachinaPipeline(project)

  /**
   * Project definition format
   */
  format: string

  /**
   * Project definition in json format
   */
  definition: json

  /**
   * Given an action definition (from `definition.actions`), returns whether the action should be run
   */
  shouldRunAction: private function(actionDefinition: json): boolean js-server

  /**
   * Launches a run of the ExMachinaProjectRoot.
   *
   * @param session
   *           The session in which to run the project
   * @param forceRerun
   *           If true, force the re-run of the project.
   * @param waitForRunResult
   *           If true, poll {@link runResult} until the run completes.
   * @param waitTimeoutMinutes
   *           Valid if "waitForRunResult" is true. Sets the max timeout to wait for the run to complete
   */
  run: member function(session: !ExMachinaSession,
                       forceRerun: boolean,
                       waitForRunResult: boolean,
                       waitTimeoutMinutes: int = 5): json js

  /**
   * Gets the result of run of the ExMachinaProjectRoot.
   *
   * @param session
   *           The session from which to retrieve the run result
   * @param timeoutMinutes
   *           Max timeout to wait for a run result to be present
   * @return project execution results (or null if they're not yet ready).
   */
  runResult: member function(session: !ExMachinaSession, timeoutMinutes: int = 5): json js

  /**
   * Update project definition. This method is used as workaround for platform issue saving json containing
   * type key.
   *
   * @param id
   *           Project id
   * @param definition
   *           Updated project definition
   * @return updated project
   */
  updateProjectDefinition: function(id: string, definition: json): ExMachinaProject js-server

  /**
   * Sets the {@link ExMachinaProject.description} on {@link ExMachinaProject}
   *
   * @param  formObj
   *          {@link ExMachinaProjectSettings} which needs to be updated
   * @return
   *          (@link ExMachinaProject) after updating the description
   */
  saveSettings: member function(formObj: ExMachinaProjectSettings): ExMachinaProject js-server

  /**
   * Returns the settings of the {@link ExMachinaProject}
   *
   * @return
   *          {@link ExMachinaProjectSettings} containing project settings and user preferences
   */
  getSettings: member function(): ExMachinaProjectSettings js-server

  /**
   * After creating the project, remove the default ACL to prevent the creator from retaining viewing permissions even
   * after transferring ownership and leaving the team
   */
  afterCreate: ~ js-server
}
