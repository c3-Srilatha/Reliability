type VADPredictTimeseriesSpec {

  projectName:        !string
  predictionNodeName: !string

  /**
   * parameters for invoking eval metrics. all optional.
   */
  filter: string

  limit: int = 100
  start: datetime
  end:   datetime

  /**
   * For cases (like ACE), where we already have the EvalMetricsResult on which we want to predict, we allow
   * providing that data directly in the invocation. If this field is set, we predict on the specified input,
   * thereby not making any calls to C3.
   */
  input: EvalMetricsResult
}
