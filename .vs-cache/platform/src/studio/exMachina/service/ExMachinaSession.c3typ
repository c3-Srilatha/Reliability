/**
 * ExMachinaSession refers to the time period that a user attempts to Start and Stop a single ExMachina spark cluster,
 * and stores a reference to the underlying {@link ExMachinaInstance} used during the session.
 *
 * In order from lowest to highest abstraction, there are three orchestration types:
 * 1. {@link ExMachina}: The core CloudService
 * 2. {@link ExMachinaInstance}: Simplifies orchestration of ExMachina service and persists service metadata.
 * 3. {@link ExMachinaSession}: User-level details that persists information of single usage of CloudService.
 */
@db(order='descending(started)', unique=['instance'])
entity type ExMachinaSession schema name 'EXM_SESS' {

  /**
   * When the session was started. This can be different from the {@link ExMachinaInstance#started} time in cases
   * where the {@link instance} was started preemptively.
   */
  started: !datetime

  /**
   * When the session was stopped.
   */
  stopped: datetime

  /**
   * A reference to the underlying ExMachina instance used during the session. Each session has a unique instance,
   * which is enforced using the {@link Ann.Db#unique} annotation.
   */
  instance: !ExMachinaInstance

  /**
   * Return an API interface to the ExMachina spark server
   */
  api: property(): !ExMachina.Api js-server

  /**
   * Get the url to access the service from outside the cluster
   */
  externalUrl: property(): !string serialized Url js-server

  /**
   * Start a new session. Users are billed according to the {@link started} and {@link stopped} times.
   *
   * @param memorySize
   *          Seeded {@link ExMachinaMemorySize} to use when starting the {@link ExMachinaInstance}.
   * @param findUnassigned
   *          If true (by default), do not search for an unassigned {@link ExMachinaInstance} with the same size.
   *          This may be needed when debugging using a custom {@link ExMachinaInstance.Config}.
   * @param authorizedUserIds
   *          The initial list of authorized users to grant access to the session.
   */
  start: function(memorySize: ExMachinaMemorySize = {id: '16G'},
                  findUnassigned: boolean = true,
                  authorizedUserIds: [string]): !ExMachinaSession js-server

  /**
   * Attempt to stop the existing session and terminate the underlying {@link ExMachinaInstance}. It will fail to
   * terminate if the user does not have access to stop the session, as determined by {@link canIStop}.
   */
  stop: member function(): !ExMachinaSession js-server

  /**
   * Internally invoked by {@link stop} through a PrivilegedAction. This implements the core logic to stop a session.
   *
   * This method assumes that the user or action has privilege, as stopping a session requires access to methods that
   * contain {@link Ann.Action#authz} "always" annotation.
   */
  stopWithPrivilege: private member function(): !ExMachinaSession js-server

  /**
   * Whether the current user can stop the session. True if either:
   * 1. The session was created by the user, as denoted by {@link meta} "createdBy" field.
   * 2. The session is assigned to the user, as donated by {@link member} "from" field.
   * 3. The user has {@link SecurityLevel}.
   */
  canIStop: member function(): !boolean js-server

  /**
   * The current status of the underlying {@link instance}
   */
  status: member function(): !ExMachinaInstance.Status js-server

  /**
   * Whether the session is currently active. This is driven based on whether {@link stopped} is populated
   */
  isActive: member function(): boolean js-server

  /**
   * Utility to return {@link instance}
   */
  getInstance: member function(include: string = 'this'): !ExMachinaInstance js-server

  /**
   * Start a session using an existing unassigned {@link ExMachinaInstance} that has the same memorySize.
   * If an unassigned instance is found and assigned, return the ExMachinaSession.
   * If an unassigned instance does not exist, return null.
   *
   * @param memorySize
   *          The memory size with which the unassigned session was started
   * @param authorizedUserIds
   *          The initial list of authorized users to grant access to the session.
   */
  startWithUnassignedInstance: private function(memorySize: !ExMachinaMemorySize,
                                                authorizedUserIds: [string]): ExMachinaSession js-server

  /**
   * Start a session using a new {@link ExMachinaInstance} instead of finding an unassigned instance.
   *
   * @param memorySize
   *          The memory size with which to create the session
   * @param authorizedUserIds
   *          The initial list of authorized users to grant access to the session.
   */
  startWithNewInstance: private function(memorySize: !ExMachinaMemorySize,
                                         authorizedUserIds: [string]): !ExMachinaSession js-server

  /**
   * Attempt to create a new {@link ExMachinaSession} record with the given instance.
   * If this instance is not assigned to a session, create and return a new session.
   * If this instance is already assigned to a session, return null.
   */
  tryClaimingInstance: private function(instance: !ExMachinaInstance): ExMachinaSession js-server

  /**
   * By default, only the user who starts the session will have access to the service. This is enforced within
   * {@link ExMachina#ensureConfig}. This method can be used to grant access to additional users, e.g. when sharing
   * sessions. Without access, users will receive "401 Unauthorized" when making requests to the cluster.
   */
  grantAccess: member function(userIds: [string]) js-server

  /**
   * Revoke access to the service instance from the provided list of users
   */
  revokeAccess: member function(userIds: [string]) js-server

  /**
   * Wait till the service status changes to the target status. If the status
   * does not change after the timeout, return false.
   *
   * @param status
   * .        The target status that the session is expected to reflect
   * @param timeoutMinutes
   * .        The max time to wait for the session status to update to the target status
   */
  waitForStatus: private member function(status: !ExMachinaInstance.Status,
                                         timeoutMinutes: int = 4): boolean js-server

  /**
   * Abort any {@link ExMachinaPipeline} executions currently running in the session. This ensures run records are
   * properly updated, e.g. when the session is stopped.
   *
   * @return the number of aborted runs
   */
  abortPipelineRuns: member function(): int js-server

  /**
   * Shut down sessions for scheduled runs that have completed.
   * Also shut down sessions for which scheduled runs were started a long time ago but haven't yet completed, as this
   * indicates that the service likely crashed.
   *
   * @param shutdownIfRunIncompleteForNumMinutes
   *          Stop a session if its scheduled run was started before this time and hasn't yet completed.
   */
  shutdownSessionsForCompletedRuns: function(shutdownIfRunIncompleteForNumMinutes: int = 90): [ExMachinaSession] js-server

  /**
   * The member who started the session
   */
  member: ExMachinaUser

  /**
   * Return the {@link ExMachinaUser#session} for the current user's member
   */
  forMe: function(include: string): ExMachinaSession js-server

  /**
   * Return the {@link ExMachinaUser#session} for the provided member
   */
  forMember: function(member: !ExMachinaUser, include: string): ExMachinaSession js-server

  /**
   * User-facing API that invokes {@link startDefaultForMember} for the current user's member
   */
  @action(group+='basic-user')
  startDefaultForMe: function(): !ExMachinaSession js-server

  /**
   * Start a new ExMachinaSession using the configured {@link ExMachinaUser#size}.
   * Do nothing if {@link ExMachinaUser#session} is already running.
   *
   * @param member
   *          The member for which to start the default session
   */
  startDefaultForMember: function(member: !ExMachinaUser): !ExMachinaSession js-server

  /**
   * Start a new session for the member. A member can create multiple sessions, e.g. for running scheduled project
   * executions in isolated services.
   *
   * @param member
   *          The member for which to start a new session
   * @param size
   *          The session size
   */
  startNewForMember: function(member: !ExMachinaUser, size: !ExMachinaMemorySize): !ExMachinaSession js-server

  /**
   * User-facing API that invokes {@link stopDefaultForMember} for the user's member
   */
  @action(group+='basic-user')
  stopDefaultForMe: function(): ExMachinaSession js-server

  /**
   * Stop the default {@link ExMachinaUser#session} and set it to null
   *
   * @param member
   *          The member for which to start a new session
   */
  stopDefaultForMember: function(member: !ExMachinaUser): ExMachinaSession js-server

  /**
   * User-facing API that invokes {@link resizeDefaultForMember} for the user's member
   *
   * @param size
   *          The session size
   * @param updateActiveSession
   *          Whether to update {@link ExMachinaUser#session} to immediately reflect the new size. If a session
   *          is active, this will shutdown and start a new session.
   */
  @action(group+='basic-user')
  @deprecated(finalVersion="9.0", details="Please use ExMachinaSettingsFormUi#saveUiSettingsFormData instead.")
  resizeDefaultForMe: function(size: !ExMachinaMemorySize, updateActiveSession: boolean): ExMachinaSession js-server

  /**
   * Updates {@link size} with the new size so that future calls to {@link startDefaultForMe} use the updated size.
   * If the user wants to reflect this change immediately, they can pass "updateActiveSession" as true, in which case:
   * - If {@link session} is running with a different size, stop the session and start new session with updated size.
   * - If {@link session} is running with the same size, do nothing.
   *
   * @param member
   *          The member for which to start a new session
   * @param size
   *          The new memory size
   * @param updateActiveSession
   *          Whether to update {@link ExMachinaUser#session} to immediately reflect the new size. If a session
   *          is active, this will shutdown and start a new session.
   */
  @deprecated(finalVersion="9.0", details="Please use ExMachinaSettingsFormUi#saveUiSettingsFormData instead.")
  resizeDefaultForMember: function(member: !ExMachinaUser,
                                   size: !ExMachinaMemorySize,
                                   updateActiveSession: boolean): ExMachinaSession js-server

  /**
   * User-facing API that invokes {@link defaultStatusForMember} for the user's member
   */
  @action(group+='basic-user')
  defaultStatusForMe: function(): !ExMachinaInstance.Status js-server

  /**
   * Get the latest status of the member's {@link ExMachinaUser#session}
   */
  defaultStatusForMember: function(member: !ExMachinaUser): !ExMachinaInstance.Status js-server

  /**
   * Get the default session info for the current user's member
   */
  defaultInfoForMe: function(): ExMachinaSession.Info js-server

  /**
   * Get the default session info for the provided member
   *
   * @param member
   *         The member whose session info to retrieve
   */
  defaultInfoForMember: function(member: !ExMachinaUser): ExMachinaSession.Info js-server

  /**
   * TODO: Temporary workaround for ACL expression dependency fetch not working. Revert back to using AclPrivilege  when
   * PLAT-55265 is addressed
   */
  aclPrivilegeCalc: [User] stored calc member.to.members.(not(exists(end)) && current == true).from

  /**
   * Purge executions that are connected to given projectsIds from the current user's session.
   */
  purgeProjectExecutionsForMe: function(projectIds: [string]): boolean js-server
}
