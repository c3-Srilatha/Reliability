/**
 * Spark cluster settings
 */
type ExMachinaClusterSettings {
  /**
   * Amount of memory to allocate to each executor. e.g. '1G'
   */
  executorMemory: !string

  /**
   * Number of executors to start.
   */
  executorInstances: !int

  /**
   * Number of CPU cores on each executor.
   */
  executorCores: !int

  /**
   * Amount of memory to allocate to the driver. e.g. '1G'
   */
  driverMemory: !string

  /**
   * Number of CPU cores to allocate to the driver.
   */
  driverCores: !int

  /**
   * Convert memory size string to the number of MBs
   */
  getMemoryInMBs: function(memoryString: !string): double js-server
}
