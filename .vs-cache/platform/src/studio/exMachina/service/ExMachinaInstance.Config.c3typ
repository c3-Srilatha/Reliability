/**
 * Optional overrides used when starting an {@link ExMachina} service. When calling {@link ExMachinaInstance#start},
 * any values that are overridden on this config will override the {@link ExMachina_Config}. This is useful when
 * needing to configure App/Env/Cluster-level defaults.
 *
 * E.g. to set a global default {@link exmacDriverImage} that will be used throughout the cluster, call:
 *
 * ```javascript
 * ExMachinaInstance.Config.setConfigValue('exmacDriverImage', '<new image>', ConfigOverride.CLUSTER)
 * ```
 */
@config(minOverride=USER)
type ExMachinaInstance.Config mixes ExMachina_Config, Singleton
