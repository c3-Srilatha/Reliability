type ExMachinaSession.Info {
  /**
   * The url to access the ExMachinaSession
   */
  url: string

  /**
   * The session status
   */
  status: ExMachinaInstance.Status

  /**
   * Amount of memory that is allocated. e.g. '1G'
   */
  allocatedMemory: string = '0G'

  /**
   * Amount of memory that has been used.
   */
  usedMemory: string = '0M'

  /**
   * The reported percentage of the {@link allocatedMemory} that is in use.
   */
  percentMemoryUsed: double = 0
}
