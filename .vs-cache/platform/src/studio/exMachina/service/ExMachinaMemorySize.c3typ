/**
 * Available memory sizes
 */
@seed(userUpdatable=true)
entity type ExMachinaMemorySize mixes SeedData schema name 'EXM_MS' {
  /**
   * Description to use for label
   */
  description: string translate by id

  /**
   * Value
   */
  value: string

  /**
   * Default cluster settings for this memory size
   */
  clusterSettings: !ExMachinaClusterSettingsPreset

  /**
   * Indices provided to each memory size to help with sort order. Lower numbers signify smaller memory sizes.
   */
  sortOrderIndex: int

  /**
   * Description to use in the price list modal
   */
  priceListDescription: string translate by id

  /**
   * It's used in
   *  - Cluster Settings form to determine whether to show the contact support modal
   *  - To be excluded from the cluster size dropdown in member invitation request
   *
   * @example
   * ```js
   * ExMachinaMemorySize.make().sizeRequiredToContactSupport;
   * ```
   */
  sizeRequiredToContactSupport: string = '1P'

  /**
   * Determines whether the current memory size is valid.
   */
  isValidForCurrentPlan: member function(): boolean js-server

  /**
   * Retrieves the {@link ExMachinaApplicationConfig.workspaceMinSize}
   * @param include
   *           Optional include.
   */
  getMinSizeForCurrentPlan: function(include: string): ExMachinaMemorySize js-server

  /**
   * Retrieves the {@link ExMachinaApplicationConfig.workspaceMaxSize}
   * @param include
   *           Optional include.
   */
  getMaxSizeForCurrentPlan: function(include: string): ExMachinaMemorySize js-server
}
