/**
 * ExMachinaInstance refers to a single {@link ExMachina} service. It provides metadata including availability status,
 * memory settings, and start/stop times, and simplifies orchestration of ExMachina services.
 */
@db(unique=['settings'], order='descending(started)')
entity type ExMachinaInstance schema name 'EXMI' {

  /**
   * The id of the underlying {@link ExMachina} service.
   */
  id: !~

  /**
   * The status of the ExMachina service. Maintained by {@link ExMachinaInstance.Status.Controller#updateStatuses}
   */
  status: !string enum ExMachinaInstance.Status

  /**
   * A reference to the instance settings, including driver/executor sizing details. Persisted for billing.
   */
  settings: !ExMachinaInstance.Settings

  /**
   * When the service was started.
   */
  started: !datetime

  /**
   * When the service was stopped.
   */
  stopped: datetime

  /**
   * The parent {@link ExMachinaSession} to which this instance is assigned
   */
  session: ExMachinaSession(instance)

  /**
   * An instance of the {@link ExMachina} service assembled using the {@link id}.
   */
  service: property(): !ExMachina js-server

  /**
   * The list of users who have access to this service instance. See {@link ExMachina_Config#authorizedUsers}. Note that
   * if the config has been cleared (as is done by default within {@link stop}), this list will be empty.
   */
  authorizedUsers: property(): [string] js-server

  /**
   * Start an {@link ExMachina} service. Uses {@link ExMachinaInstance.Config} for default overrides, e.g. driver image.
   *
   * @param memorySize
   *          The memory size with which to start the instance
   * @param authorizedUserIds
   *          The initial list of authorized users to grant access to the service
   */
  start: function(memorySize: ExMachinaMemorySize = {id: '16G'},
                  authorizedUserIds: [string]): !ExMachinaInstance js-server

  /**
   * Called by CronJob to preemptively start unassigned instances, also known as "Warm Workspaces"
   *
   * @param config
   *  Key indicates the ExMachinaMemorySize id and value is the number of instances that need to exist.
   *  E.g. { '32G': 1, '64G': 2}
   *
   * @return the ExMachinaInstances that were created and started.
   */
  startUnassignedInstances: function(config: map<string, int>): [ExMachinaInstance] js-server

  /**
   * Stop the underlying {@link ExMachina} service
   */
  stop: member function(): ExMachinaInstance js-server

  /**
   * @return array of driver and executor pods in this instance
   */
  getK8sPods: member function(): [K8sPod] js-server

  /**
   * Grant the provided users access to the service
   */
  grantAccess: member function(userIds: [string]) js-server

  /**
   * Revoke access to the service instance from the provided list of users
   */
  revokeAccess: member function(userIds: [string]) js-server

  /**
   * Whether {@link status} is "stopped".
   */
  @dependency(include='status, stopped')
  isStopped: inline member function(): !boolean js-server

  /**
   * Whether {@link state} is "starting".
   */
  @dependency(include='status')
  isStarting: inline member function(): !boolean js-server

  /**
   * Whether {@link state} is "running".
   */
  @dependency(include='status')
  isRunning: inline member function(): !boolean js-server

  /**
   * Whether {@link state} is "stopping".
   */
  @dependency(include='status')
  isStopping: inline member function(): !boolean js-server

  /**
   * Whether {@link state} is "restarting".
   */
  @dependency(include='status')
  isRestarting: inline member function(): !boolean js-server

  /**
   * Start the underlying ExMachina service using an AsyncAction because upserting K8s resources can take time. If done
   * synchronously instead, a user would be forced to stay on the webpage and wait for the "start" API call to complete.
   */
  startCloudServiceAsync: private member function(): !AsyncAction js-server

  /**
   * Terminate the underlying {@link ExMachina} CloudService
   */
  stopCloudServiceAsync: private member function() js-server

  /**
   * Terminate the underlying {@link ExMachina} CloudService
   */
  stopCloudService: private member function() js-server

  /**
   * Waits for existing AsyncAction to complete. Used to avoid a race condition where a user starts and immediately
   * stops the instance. Also removes the AsyncAction once complete.
   *
   * @param timeoutMinutes
   *          The max time to wait for completion and cleanup before returning
   */
  awaitAsyncActionCompletion: private member function(timeoutMinutes: int = 3) js-server

  /**
   * Id with which to submit and track AsyncActions for starting ExMachina services.
   */
  getAsyncActionId: private member function(): !string js-server
}
