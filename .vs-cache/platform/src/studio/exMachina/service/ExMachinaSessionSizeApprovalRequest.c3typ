entity type ExMachinaSessionSizeApprovalRequest extends ExMachinaApprovalRequest type key 'SZ' {

  /**
   * The member who will get a larger maxSize.
   */
  member: !ExMachinaUser

  /**
   * Details about the {@link member} for presentation in the UI
   */
  memberDetailUi: string stored calc member.name + ' <' + member.email + '>'

  /**
   * The requested memory size.
   */
  requestedSize: !ExMachinaMemorySize

  /**
   * The memory size the member had when the request was created.
   */
  currentSize: !ExMachinaMemorySize

  requestsListHtml: ~ js-server
  doApproved:       ~ js-server
}
