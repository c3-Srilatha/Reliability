/**
  * Controller Type to update the {@link ExMachinaInstance#status} field for each instance so that it accurately
  * reflects the state of the underlying {@link ExMachina} service.
  *
  * This is done by retrieving all ExMachina K8s Deployments and parsing their "status" fields. For more information
  * see [Deployment status](https://kubernetes.io/docs/concepts/workloads/controllers/deployment/#deployment-status)
  *
  * We persist a singleton instance to track the last time that the statuses were updated. This way we can avoid
  * updating statuses beyond a particular interval, which prevents overloading the {@link K8sApiServer} with requests.
  * It is a persistable entity type because it is more robust to store in it in Postgres, while the Config framework can
  * require manual cache invalidation.
  *
  * The following approaches were considered during the design of this method:
  * 1. Make API requests to individual services
  *    - Used in prior versions (e.g. v7). This approach is not scalable.
  * 2. Use [K8s Watch API](https://kubernetes.io/docs/reference/using-api/api-concepts/#efficient-detection-of-changes)
  *    - Uses long-polling, which can tie up threads. However, this can be used in tandem with current implementation.
  * 3. Use [Container lifecycle hooks](https://kubernetes.io/docs/concepts/containers/container-lifecycle-hooks/)
  *    - Not robust or capable enough.
  * 4. **[Chosen Implementation]** Use liveliness/readiness readings from K8s Deployment Statuses.
  *    - Most scalable, as we can rely on individual kubelets to accurately provide deployment statuses.
  */
private entity type ExMachinaInstance.Status.Controller mixes DefaultInstance schema name 'EM_ISC' {
  /**
   * Return the default app-wide status controller
   */
  inst: ~ js-server

  /**
   * Update the {@link ExMachinaInstance#status} field for each instance so that it accurately reflects the state of
   * the underlying {@link ExMachina} service.
   *
   * @param debounceTimeInSeconds
   *          The time to wait since the last status updates, as indicated by {@meta.updated}
   */
  updateStatuses: function(debounceTimeInSeconds: int = 15) js-server

  /**
   * Get all {@link ExMachinaInstance}s that are running OR should be running.
   */
  getActiveInstances: inline member function(): [ExMachinaInstance] js-server

  /**
   * Get K8s deployments for the provided list of {@link ExMachina} instances
   *
   * @param instances
   *          The list of instances for which to retrieve active K8s deployments
   */
  getExMachinaK8sDeployments: inline member function(instances: [ExMachinaInstance]): [K8sDeployment] js-server

  /**
   * Get instances with updated {@link ExMachinaInstance#status} fields.
   *
   * @param instances
   *          The list of instances to update
   * @param deployments
   *          The list of K8s deployments that represent the driver pod for each ExMachina instance
   */
  getInstancesToUpdate: inline member function(instances: [ExMachinaInstance],
                                                deployments: [K8sDeployment]): [ExMachinaInstance] js-server

  /**
   * Return the in-memory instance with its "status" field updated
   *
   * @param instance
   *          The instance to update
   * @param deployment
   *          The K8s deployment for the instance's driver pod
   */
  getLatestInstanceStatus: inline member function(instance: !ExMachinaInstance,
                                                  deployment: K8sDeployment): !ExMachinaInstance.Status js-server
}
