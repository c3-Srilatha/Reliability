entity type ExMachinaPreferenceChangeRequest extends ExMachinaApprovalRequest type key 'PREF' {

  /**
   * Used to record whether limitations on email domains are Enabled or disabled
   */
  limitNewUsersEmailDomain: !string

  /**
   * The email domains allowed before admin preferences change was made
   */
  previousEmailDomainsAllowed: !string

  /**
   * The email domains allowed after admin preferences change was made
   */
  newEmailDomainsAllowed: !string

  doApproved: ~ js-server

  /**
   * Fetches info for Admin Preferences Change UI Modal
   */
  getDetails: function(id: string): json js-server
}
