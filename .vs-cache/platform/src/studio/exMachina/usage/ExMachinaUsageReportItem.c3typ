abstract extendable entity type ExMachinaUsageReportItem mixes WithParent<ExMachinaUsageReport>, AclEnabled schema name 'EXM_URI' {
  parent: !~

  /**
   * The start time for the interval to which this usage item applies
   */
  startTime: !datetime

  /**
   * The end time for the interval to which this usage item applies
   */
  endTime: !datetime
}
