/**
 * Usage information for a single {@link ExMachinaSession}
 */
entity type ExMachinaUsageReportItem.Session extends ExMachinaUsageReportItem type key 'SES' {
  /**
   * The {@link ExMachinaSession} corresponding to this usage item
   */
  session: !ExMachinaSession

  /**
   * The number of vCPU-hours of usage. This is computed using {@link ExMachinaInstance.Settings#computeVCpuHours}. We
   * only compute this value for the duration of the {@link session} that overlaps with the {@link parent} "startTime"
   * and "endTime", to handle cases where a session is active outside this interval (e.g. it is still running).
   */
  vCpuHours: double = 0

  /**
   * Session duration in seconds
   */
  durationSeconds: int = 0
}
