/**
 * A report that summarizes ExMachina usage over a given time interval. Used to drive billing.
 */
entity type ExMachinaUsageReport schema name 'EXM_UR' {
  /**
   * The beginning of the time interval for which usage information is collected
   */
  startTime: !datetime

  /**
   * The end of the time interval for which usage information is collected
   */
  endTime: !datetime

  /**
   * The list of session usage items generated for this report
   * These store session metadata, such as vCpuHours and total session duration. Used to calculate usage fee.
   */
  sessionItems: [ExMachinaUsageReportItem.Session](parent)

  /**
   * The list of member usage items generated for this report
   */
  memberItems: [ExMachinaUsageReportItem.Member](parent)

  /**
   * The sum of {@link ExMachinaUsageReportItem.Session#vCpuHours} across all {@link sessionItems}
   */
  sessionVCpuHours: double

  /**
   * The sum of {@link ExMachinaUsageReportItem.Session#sessionDurationSeconds} across all {@link sessionItems}
   */
  sessionDurationSeconds: int

  /**
   * The readable {@link startTime}, e.g. 1/1/2023
   */
  startTimeString: string calc concat(month(startTime), '/', day(startTime), '/', year(startTime))

  /**
   * The {@link endTime} is exclusive, i.e. we generate all usage until (but not including) this time.
   * Typically the endTime is the first day of the following month, so when displaying the time range to the user, we
   * print "1/1/2020 - 1/31/2020" instead of "1/1/2020 - 2/1/2020" by subtracting a millisecond.
   */
  endTimeInclusive: datetime calc dateTime(toMillis(endTime) - 1)

  /**
   * The readable {@link endTimeInclusive}, e.g. 1/1/2023
   */
  endTimeInclusiveString: string calc concat(month(endTimeInclusive), '/', day(endTimeInclusive), '/', year(endTimeInclusive))

  /**
   * The readable time range computed using {@link startTime} and {@link endTime}, e.g. 1/1/2023 - 1/31/2023
   */
  timeRange: string calc concat(startTimeString, ' - ', endTimeInclusiveString)

  /**
   * Generate a new usage report
   */
  generate: function(startTime: !datetime,
                     endTime: !datetime): !ExMachinaUsageReport js-server

  /**
   * Populate the {@link sessionItems}
   */
  populateSessionItems: private member function(): !ExMachinaUsageReport js-server

  /**
   * Draft a single session item
   */
  draftSessionItem: private member function(session: !ExMachinaSession): !ExMachinaUsageReportItem.Session js-server

  /**
   * Update the report with summary of the session items, e.g. {@link sessionVCpuHours}
   */
  withSessionItemsSummarized: private member function(): !ExMachinaUsageReport js-server

  /**
   * Populate the {@link memberItems}
   */
  populateMemberItems: private member function(): !ExMachinaUsageReport js-server

  /**
   * Draft a single member item
   */
  draftMemberItem: member function(member: !ExMachinaUser): !ExMachinaUsageReportItem.Member js-server

  /**
   * Remove the usage report and all corresponding usage items.
   */
  removeDeep: private member function(): int js-server

  /**
   * If a usage report exists with the same {@link startTime}, recompute it with the new endTime if the report was
   * last updated more than the arg "debounceTimeInSeconds" ago.
   * If a usage report does not exist, generate a new report with this spec.
   */
  generateFromStartTime: private function(startTime: !datetime,
                                          debounceTimeInSeconds: int = 0): !ExMachinaUsageReport js-server

  /**
   * Update the existing usage report based on the new endTime.
   *
   * The benefit here (over generating a new report) is that we can retain the ids of an existing report and its usage
   * items, which provides "sticky" records that can be referenced on management pages when loading the Usage grid.
   */
  updateWithNewEndTime: private member function(endTime: !datetime): !ExMachinaUsageReport js-server

  /**
   * Update the usage report with the new list of session usage items based on its diff against the new items.
   */
  updateWithNewSessionItems: private member function(
    newItems: [ExMachinaUsageReportItem.Session]
  ): !ExMachinaUsageReport js-server

  /**
   * Update the usage report with the new list of member usage items based on its diff against the new items.
   */
  updateWithNewMemberItems: private member function(
    newItems: [ExMachinaUsageReportItem.Member]
  ): !ExMachinaUsageReport js-server

    /**
     * Generate the usage report for the shared account for the previous month.
     */
    generateForPreviousMonth: function(): !ExMachinaUsageReport js-server

    /**
     * Generate the usage report for the shared account for the current month.
     *
     * @param debounceTimeInSeconds
     *         Generate the report only if the current month's report was last generated before the debounced time
     */
    generateForCurrentMonth: function(debounceTimeInSeconds: int = 300): !ExMachinaUsageReport js-server
}
