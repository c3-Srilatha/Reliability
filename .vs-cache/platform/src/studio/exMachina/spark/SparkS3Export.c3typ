/**
 * Stores {@link Export} job information associated with {@link SparkJob}.
 */
entity type SparkS3Export schema name 'IMA_SPKS3EXPT' {

  /**
   * Hash that identifies the Export spec.
   * E.g. two specs that contains the exact same type, EvalMetricsSpec and filter will receive the same hash.
   */
  hash: int

  /**
   * {@link SparkJob}s associated with current export job.
   */
  sparkJobs: [SparkJob](s3Export)

  /**
   * The actual {@link Export} job.
   */
  job: Export

  /**
   * Status of export.
   */
  status: string
}
