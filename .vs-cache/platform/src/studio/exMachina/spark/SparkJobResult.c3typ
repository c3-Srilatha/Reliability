/**
 * Stores job results from a {@link SparkJob}.
 * Form of results varies by job type. See {@link SparkDataExplorer} for more details on job type.
 */
entity type SparkJobResult schema name 'IMA_SPKJR' {

  /**
   * Error message if the {@link SparkJob} were to fail.
   */
  error: string

  /**
   * Result object.
   * This is of type Obj because different job types have different result structure.
   */
  result: Obj

  /**
   * The {@link SparkJob} that this result is for.
   */
  job: SparkJob
}
