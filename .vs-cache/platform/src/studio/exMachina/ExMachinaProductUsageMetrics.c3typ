/**
 * Convenience type for functions that fetches count of account assets like Visual Notebooks, Datasets, ML Pipelines etc.
 */
type ExMachinaProductUsageMetrics mixes Value {

  /**
   * Generic method that uses fetch and fetchCount for different asset types
   */
  getCountForAssetType: function(assetType: string, filter: string, isOwned: boolean): int js-server

  /**
   * Generic method for fetching All/Public/Owned/Shared counts
   */
  getAllCountsForAssetType: function(assetType: string,
                                     baseFilter: string): ExMachinaProductUsageMetricsAssetCountResult js-server

  /**
   * Fetch All/Public/Owned/Shared counts using {@link ExMachinaProjectRoot} c3type and of kind {@link ExMachinaProjectKind.STANDARD}
   */
  getProjectsCount: function(projectKind: ExMachinaProjectKind): ExMachinaProductUsageMetricsAssetCountResult js-server

  /**
   * Fetch All/Public/Owned/Shared counts using {@link ExMachinaDatasetTopic} c3type
   */
  getDatasetsCount: function(): ExMachinaProductUsageMetricsAssetCountResult js-server

  /**
   * Fetch All/Public/Owned/Shared counts using {@link ExMachinaStory} c3type
   */
  getStoriesCount: function(): ExMachinaProductUsageMetricsAssetCountResult js-server

  /**
   * Fetch All/Public/Owned/Shared counts using {@link ExMachinaConnectorCredential} c3type
   */
  getConnectorsCount: function(): ExMachinaProductUsageMetricsAssetCountResult js-server

  /**
   * Fetch All/Public/Owned/Shared counts using {@link ExMachinaExecutionSchedule} c3type
   */
  getDeploymentsCount: function(): ExMachinaProductUsageMetricsAssetCountResult js-server

  /**
   * Fetch All/Public/Owned/Shared counts
   */
  getAllCounts: function(): ExMachinaProductUsageMetricsAllAssetsCountResult js-server
}
