/**
 * Type to define the fields accepted by {@link ExMachinaConnectorCredential.updateCredentialMetadata} to update the
 * metadata of the connector credential
 */
type ExMachinaConnectorCredentialUpdateMetadataSpec {

  /**
   * The id of the connector credential.
   */
  id: !string

  /**
   * The display name of the connector credential.
   */
  displayName: !string

  /**
   * The description of the connector credential
   */
  description: string
}
