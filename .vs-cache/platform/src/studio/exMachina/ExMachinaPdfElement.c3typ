/**
 * Represents a valid PDF element when generating a PDF Report
 */
type ExMachinaPdfElement {

  /**
   * The type of PDF element to render on the PDF
   * See {@link ExMachinaPdfElementType} for available types
   */
  elementType: !ExMachinaPdfElementType

  /**
   * The configuration settings of the PDF Element to be rendered.
   *
   * See {@link ExMachinaPdfElementType} for more information about
   * valid fields for every available {@link ExMachinaPdfElementType}
   */
  elementConfig: !json

}
