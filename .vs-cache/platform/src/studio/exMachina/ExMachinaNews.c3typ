@db(order='descending(publishedDate)')
@seed(notUserCreatable=false, userUpdatable=true, userRemovable=true)
entity type ExMachinaNews mixes SeedData schema name 'EXM_NWS' {

  /**
   * News article id
   */
  id: !~

  /**
   * News title
   */
  name: !~

  /**
   * News description
   */
  description: string

  /**
   * News hyperlink
   */
  hyperlink: !string

  /**
   * News icon
   */
  icon: string

  /**
   * News published date time
   */
  publishedDate: !datetime
}
