/**
 * Represents a discrete request for approval in an Ex Machina Team
 */
abstract extendable entity type ExMachinaApprovalRequest schema name 'EXMAPRVR' {

  /**
   * The title of the request.
   */
  name: ~

  /**
   * The description of the request.
   */
  details: string

  /**
   * The member who created the request.
   */
  requester: ExMachinaUser

  /**
   * Details about the {@link requester} for presentation in the UI
   */
  requesterDetailUi: string stored calc requester.name + ' <' + requester.email + '>'

  /**
   * The member who approved or declined the increase.
   */
  approver: ExMachinaUser

  /**
   * Details about the {@link approver} for presentation in the UI
   */
  approverDetailUi: string stored calc approver.name + ' <' + approver.email + '>'

  /**
   * Whether it was approved or declined.
   */
  approved: ?boolean

  /**
   * Whether the request is expired. In most cases, this will be updated via {@link managePendingRequests}.
   */
  expired: boolean

  /**
   * Human-readable and translatable version of {@link approved}
   */
  decision: string translate by approved

  /**
   * Whether the request is pending - true if the request has not yet been approved/rejected
   */
  pending: boolean stored calc empty(approved)

  /**
   * The timestamp of when it was approved or declined.
   */
  approvalDate: datetime

  /**
   * Approve or decline a request.
   *
   * @param approved
   *             Whether request was approved or declined
   * @param memberPerformingApproval
   *             Optional. Will use the {@link ExMachinaUser} for the current {@link User} if not specified
   */
  recordApproval: member function(approved: boolean,
                                  memberPerformingApproval: ExMachinaUser): ExMachinaApprovalValidationResponse js-server

  /**
   * Validates whether a request can be approved or declined. Called within {@link recordApproval}
   * @param approvedBy
   *          The member who is recording the approval
   */
  validateApproval: member function(approvedBy: !ExMachinaUser): ExMachinaApprovalValidationResponse js-server

  /**
   * If a request is approved, do the approval steps.
   */
  doApproved: member function() js-server

  /**
   * For each account (or for all accounts by default), takes action on all pending requests. The action taken depends
   * on how long the request has been open. For pending requests that have not yet expired, this will send reminder
   * emails to account admins. Expired requests will be auto-declined. This is used by the
   * `ex-machina-manage-pending-requests` {@link CronJob}.
   */
  managePendingRequests: function() js-server

  /**
   * Used within {@link managePendingRequests} to auto-decline expired requests.
   */
  declineExpiredRequests: function() js-server

  /**
   * Given a filter spec, creates an HTML table for all resulting requests
   */
  requestsListHtml: function(filterSpec: string): string js-server
}
