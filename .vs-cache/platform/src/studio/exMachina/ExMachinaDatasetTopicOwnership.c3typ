/**
 * The relation between a dataset topic and its owner
 */
@db(index+=['to', 'from'])
entity type ExMachinaDatasetTopicOwnership mixes TimedIntervalRelation<User, ExMachinaDatasetTopic>, AclEnabled schema name 'EXM_DTPC_OWN' {

  @db(include='name')
  from: !~

  to: !~
}
