/**
 * Machine learning models metadata
 */
entity type ExMachinaModelMetadata mixes AclEnabled schema name 'EXM_MODEL_METADATA' {

  /**
   * Model Id
   */
  id: string

  /**
   * Model name
   */
  name: string

  /**
   * Model description
   */
  description: string

  /**
   * Project where model was trained and saved
   */
  project: ExMachinaProjectRoot

  /**
   * Model category
   */
  modelCategory: string

  /**
   * Model algorithm
   */
  modelAlgorithm: string

  /**
   * Model type
   */
  modelType: string

  /**
   * Training date time
   */
  trainDate: datetime

  /**
   * Label column
   */
  labelColumn: string

  /**
   * Label column type
   */
  labelColumnType: string

  /**
   * Model details in json format
   */
  details: string
}
