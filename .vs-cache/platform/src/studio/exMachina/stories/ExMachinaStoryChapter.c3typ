/**
 * An {@link ExMachinaStory} is made up of {@link ExMachinaStoryChapter}s, which are called "Story Topics" in the
 * Ex Machina Stories UI. A story chapter can be repositioned within a story and a chapter can have multiple
 * {@link ExMachinaStoryChapterElement}s, which can also be repositioned within the chapter.
 */
entity type ExMachinaStoryChapter mixes AclEnabled, WithParent.IncludeId<ExMachinaStory>, ExMachinaUserGroupShareableRelated<ExMachinaStoryChapter> schema name 'EXM_CHAPTER' {

  /**
   * The parent reference. Overridden to be required
   */
  parent: !~

  /**
   * A user-defined name for a chapter in an {@link ExMachinaStory}
   */
  name: !string

  /**
   * A user-defined description for a chapter in an {@link ExMachinaStory}
   */
  description: string

  /**
   * When the user last modified the chapterElement by creating/editing a {@link ExMachinaStoryChapterElement}
   */
  lastUpdated: datetime calc max(chapterElements[0].meta.updated, meta.updated)

  /**
   * All elements of a chapter (named "Story Topic" in the UI) for the story. An element could be a visualization or
   * potentially something else in the future.
   */
  @db(order='descending(meta.updated)')
  chapterElements: [ExMachinaStoryChapterElement](parent)

  /**
   * An ordered array of chapter element ids in the chapter. By including this as a separate array (as opposed to using
   * {@link chapterElements} directly with a field to mark the sort order), we don't need to maintain and persist an
   * `order` field on each chapter element, which could get messy if a user frequently reorders elements because we'd
   * need to batch update the `order` for several elements at a time.
   */
  chapterElementIds: [string] schema suffix 'ELMT_IDS'

  /**
   * The preview image for the chapter, which is represented by the first chapter element's preview image.
   */
  previewImage: string calc chapterElements.(id == chapterElementIds[0]).assetPreviewImage

  /**
   * Creates a new {@link ExMachinaStoryChapter} for a given {@link ExMachinaStory} and updates {@link chapterIds} to persist the order.
   * @param story
   *          ExMachinaStory that the chapter belongs to
   */
  @action(group+='write')
  createChapter: function(story: !ExMachinaStory): ExMachinaStoryChapter js-server

  /**
   * Clones {@link ExMachinaStoryChapter} by copying the metadata from the passed in ExMachinaStoryChapter and creates a new ExMachinaStoryChapter as the current user.
   * Existing {@link ExMachinaStoryChapterElement}s are also created for the new user
   * @param story
   *          ExMachinaStory that the chapter belongs to
   */
  cloneChapter: member function(story: !ExMachinaStory): ExMachinaStoryChapter js-server

  /**
   * Updates the given {@link ExMachinaStoryChapter} name and/or description fields after sanitizing them.
   * @param name
   *          Story Topic name
   * @param description
   *          Story Topic description
   * @param overrideNulls
   *          Whether or not to override a field if it is null. Default behavior is to ignore nulls, similar to {@link #merge}
   * @return The ExMachinaStoryChapter updated
   */
  updateChapter: member function(name: string,
                                 description: string,
                                 overrideNulls: boolean): ExMachinaStoryChapter js-server

  /**
   * Deletes the {@link ExMachinaStoryChapter}
   * Deleting the {@link ExMachinaStoryChapter} will also delete all {@link ExMachinaStoryChapterElement}s which belong to the chapter.
   */
  deleteChapter: member function(): boolean js-server

  /**
   * Creates a new chapter element in the current chapter from the persisted asset.
   *
   * @param storyAssetId
   *           The story asset id to use as the basis for the created element The specific object's `typeIdent` will be
   *           used to determine which element type to create. For example, if the incoming story asset is an
   *           {@link ExMachinaVisualizationAsset}, the created element will be an
   *           {@link ExMachinaVisualizationElement}.
   * @param insertionIndex
   *           If provided, where to insert the new chapter element. If not provided, it will be added to the end.
   */
  createChapterElementFromAsset: member function(storyAssetId: !string,
                                                 insertionIndex: int): ExMachinaStoryChapter js-server

  /**
   * Deletes the {@link ExMachinaStoryChapterElement} from the current chapter
   * @param chapterElement
   *          ExMachinaStoryChapterElement to be deleted
   */
  deleteChapterElement: member function(chapterElement: !ExMachinaStoryChapterElement): ExMachinaStoryChapter js-server

  /**
   * If the current user owns the associated {@link ExMachinaStory}, the chapter is owned as well
   */
  isOwned: boolean calc parent.isOwned

  /**
   * Before creating the story chapter, we ensure that the user has permissions to update the parent {@link story}.
   * If not, we prevent the user from creating a new version of the story chapter.
   */
  beforeCreate: ~ js-server

  /**
   * After creating the story chapter, remove the default ACL to prevent the creator from retaining viewing
   * permissions after transferring ownership and leaving the team.
   */
  afterCreate: ~ js-server
}
