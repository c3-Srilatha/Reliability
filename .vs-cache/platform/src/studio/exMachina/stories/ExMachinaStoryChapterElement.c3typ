/**
 * An {@link ExMachinaStoryChapter} is made up of {@link ExMachinaStoryChapterElement}s. A Visualization is an example
 * of a story element and it can be repositioned within a chapter.
 */
entity abstract extendable type ExMachinaStoryChapterElement mixes AclEnabled, WithParent.IncludeId<ExMachinaStoryChapter>, ExMachinaUserGroupShareableRelated<mixing ExMachinaStoryChapterElement> schema name 'EXM_CHAPTER_ELE' {

  /**
   * The parent reference. Overridden to be required
   */
  parent: !~

  /**
   * The asset that the chapter element refers to
   */
  asset: ExMachinaStoryAsset

  /**
   * The preview image for the chapter element's {@link asset}
   */
  assetPreviewImage: string calc asset.previewImage

  /**
   * The description of the story chapter element
   */
  description: string

  /**
   * The name of the element for rendering in the UI.
   */
  renderName: string calc exists(name) ? name : asset.name

  /**
   * A description of the element for rendering in the UI.
   */
  renderDescription: string calc exists(description) ? description : asset.description

  /**
   * Read the chapter element data as a string when assembling the story
   */
  readString: abstract member function(): string

  /**
   * If the current user owns the associated {@link ExMachinaStory}, the chapter element is owned as well
   */
  isOwned: boolean calc parent.parent.isOwned

  /**
   * Clones {@link ExMachinaStoryChapterElement} copying the metadata from the passed in ExMachinaStoryChapterElement and creates a new ExMachinaStoryChapterElement as the current user.
   * @param chapter
   *          ExMachinaStoryChapter that the chapterElement belongs to
   */
  cloneChapterElement: member function(chapter: !ExMachinaStoryChapter): ExMachinaStoryChapterElement js-server

  /**
   * Before creating the story chapter element, we ensure that the user has permissions to update the parent
   * {@link chapter}. If not, we prevent the user from creating a new version of the dataset.
   */
  beforeCreate: ~ js-server

  /**
   * After creating the story chapter element, remove the default ACL to prevent the creator from retaining viewing
   * permissions after transferring ownership and leaving the team.
   */
  afterCreate: ~ js-server

  /**
   * Creates a new chapter element in the given chapter from the persisted asset.
   *
   * @param chapter
   *           The chapter where the element should be created.
   * @param storyAsset
   *           The story asset to use as the basis for the created element.
   * @param insertionIndex
   *           If provided, where to insert the new chapter element. If not provided, it will be added to the end.
   */
  createChapterElementFromAsset: function(chapter: !ExMachinaStoryChapter,
                                          storyAsset: !ExMachinaStoryAsset,
                                          insertionIndex: int): ExMachinaStoryChapterElement js-server

  /**
   * Deletes the {@link ExMachinaStoryChapterElement} and update the {@link ExMachinaStoryChapter.chapterElementIds}
   */
  deleteChapterElement: member function(): boolean js-server
}
