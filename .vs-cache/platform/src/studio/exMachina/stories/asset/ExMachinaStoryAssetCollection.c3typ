abstract extendable entity type ExMachinaStoryAssetCollection mixes AclEnabled schema name 'EXM_ST_A_C' {

  name: !~

  /**
   * The list of assets
   */
  @db(order='descending(meta.updated)')
  assets: [ExMachinaStoryAsset](parent)

  /**
   * Method to create a new {@link ExMachinaStoryAssetCollection} for the user's current account
   */
  createForCurrentUser: function(name: !string): ExMachinaStoryAssetCollection js-server
}
