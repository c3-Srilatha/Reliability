entity abstract extendable type ExMachinaStoryAsset mixes WithParent.IncludeId<ExMachinaStoryAssetCollection> schema name 'EXM_ST_AS' {

  /**
   * The parent reference. Overridden to be required
   */
  parent: !~

  name:        !~
  description: string

  /**
   * A preview image for the asset. As a `clob` type, this could be an SVG string or a Base64 string represetation of
   * the image.
   */
  previewImage: string
}
