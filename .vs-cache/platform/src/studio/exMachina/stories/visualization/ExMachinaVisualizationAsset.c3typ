entity type ExMachinaVisualizationAsset extends ExMachinaStoryAsset type key 'VA' {

  /**
   * A reference to the visualization asset collection
   */
  parent: !ExMachinaVisualizationAssetCollection

  /**
   * The action result topic containing visualization results. Note that {@link ExMachinaActionResultTopic} is
   * ACL-enabled, so if the topic points to unpermitted data, the user won't be able to read it.
   */
  topic: !ExMachinaActionResultTopic

  /**
   * The latest persisted visualization data
   */
  latestMetadata: ExMachinaActionResultMetadata calc topic.latestMetadata

  /**
   * Updates the {@link ExMachinaVisualizationAsset.previewImage} with the given SVG.
   *
   * @param previewSvg
   *        An SVG representation of the visualization asset
   */
  updateVizPreviewInfo: member function(@db(clob=true) previewSvg: string): boolean js-server
}
