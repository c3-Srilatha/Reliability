/**
 * Structure for the return object from {@link ExMachinaVisualizationElement.getInfo}.
 */
type ExMachinaVisualizationElementInfo {

  /**
   * The id of the visualization element
   */
  id: string

  /**
   * The name of the visualization element
   */
  name: string

  /**
   * A description for the visualization element
   */
  description: string

  /**
   * The {@link ExMachinaProject.id} where the visualization was created
   */
  projectId: string

  /**
   * The visualization's settings, like title axis labels, etc.
   */
  vizSettings: json

  /**
   * The chart type for the visualization
   */
  chartType: string enum ExMachinaVisualizerChartType

  /**
   * When the {@link ExMachinaVisualizationAsset} was created
   */
  created: datetime

  /**
   * The chart data and other info to render in the chart
   */
  result: json

  /**
   * Whether the associated {@link ExMachinaVisualizationAsset} exists.
   */
  missingAsset: boolean

  /**
   * Whether an associated {@link ExMachinaActionResultMetadata} exists within the specified date range.
   */
  missingMetadataForDateRange: boolean

  /**
   * Whether the associated {@link ExMachinaProject} exists.
   */
  missingProject: boolean
}
