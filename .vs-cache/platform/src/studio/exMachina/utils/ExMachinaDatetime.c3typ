/**
 * Common operations for datetime values
 */
type ExMachinaDatetime {
  /**
   * Get the larger datetime. If a value is undefined, the other value is returned.
   */
  getLargerDatetime: function(value1: datetime, value2: datetime): datetime js-server

  /**
   * Get the smaller datetime. If a value is undefined, the other value is returned.
   */
  getSmallerDatetime: function(value1: datetime, value2: datetime): datetime js-server

  /**
   * The list of unique dates in the range [startTime, endTime), including startTime and excluding endTime. E.g.:
   * - Given startTime = 2022-01-01T00:00:00Z and endTime = 2022-01-03T00:00:00Z, return
   * [2022-01-01T00:00:00Z, 2022-01-02T00:00:00Z]
   * - Given startTime = 2022-01-01T00:00:00Z and endTime = 2022-01-03T00:00:01Z, return
   * [2022-01-01T00:00:00Z, 2022-01-02T00:00:00Z, 2022-01-03T00:00:00Z]
   */
  getUniqueDays: function(startTime: !datetime, endTime: !datetime): [datetime] js-server
}
