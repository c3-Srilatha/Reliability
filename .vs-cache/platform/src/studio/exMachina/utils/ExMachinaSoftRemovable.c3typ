/**
 * Can be mixed by an entity type to provide a way to soft-remove the object. A soft-removed object will still exist in
 * the database and will remain fetchable, but will have the `softRemoved` field set to `true`.
 *
 * This prevents undesired downstream effects when objects are removed. For example, the soft-removal of an
 * {@link ExMachinaProjectRoot} will still allow interactions with any downstream {@link ExMachinaProject}s,
 * {@link ExMachinaPipeline}s, {@link ExMachinaDatasetTopic}s, etc. without causing unintended issues.
 */
type ExMachinaSoftRemovable<S> {

  /**
   * Whether the entity has been soft-removed
   */
  softRemoved: boolean

  /**
   * Wrapper around {@link Persistable#fetch} to fetch all records for an entity type using the provided spec, but also
   * filters out any records that have been soft-removed.
   */
  @action(group+='read')
  fetchAvailable: function(spec: FetchSpec): !FetchResult<S> js-server

  /**
   * Wrapper around {@link Persistable#fetchCount} to fetch the number of records for an entity type using the provided
   * spec, but also filters out any records that have been soft-removed.
   */
  @action(group+='read')
  fetchAvailableCount: function(spec: FetchFilterSpec): int js-server

  /**
   * Wrapper around {@link Persistable#get} to get the record, but returns null if the record has been soft-removed.
   */
  @action(group+='read')
  @dependency(include='softRemoved')
  getAvailable: member function(include: string): S js-server

  /**
   * Soft-removes an instance of an entity type. Note that this will not run any {@link beforeRemove} logic. If this is
   * required, it is recommended that a custom wrapper function should be written around `softRemove` that also performs
   * whatever logic is needed before removal.
   */
  @action(group+='delete')
  softRemove: member function(): boolean js-server

  /**
   * Given a filter, soft-removes all applicable records of an entity type
   */
  @action(group+='delete')
  softRemoveAll: function(removeFilter: string): int js-server

  /**
   * Helper method to generate the FetchSpec or FetchFilterSpec for the fetch helper
   */
  generateSpec: private function(fetchSpecType: string,
                                 incomingSpecObj: FetchSpec | FetchFilterSpec): FetchSpec | FetchFilterSpec js-server
}
