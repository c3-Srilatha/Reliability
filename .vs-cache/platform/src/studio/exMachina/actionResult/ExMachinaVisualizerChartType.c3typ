/**
 * The different chart types available in Ex Machina
 */
enum type ExMachinaVisualizerChartType {

  /**
   * Line chart
   */
  line

  /**
   * Pair plot
   */
  pairPlot

  /**
   * Scatter plot
   */
  scatter

  /**
   * 3D Scatter plot
   */
  scatter3d

  /**
   * Histogram chart
   */
  histogram

  /**
   * Correlation matrix
   */
  correlationMatrix

  /**
   * Autocorrelation plot
   */
  autocorrelationPlot

  /**
   * Pie chart
   */
  pie

  /**
   * Box Plot
   */
  box

  /**
   * Bar chart
   */
  bar

  /**
   * Calendar Heat Map
   */
  calendarHeatMap

  /**
   * Normal QQ Plot
   */
  normalQQ

  /**
   * Table
   */
  table

  /**
   * Sankey
   */
  sankey
}
