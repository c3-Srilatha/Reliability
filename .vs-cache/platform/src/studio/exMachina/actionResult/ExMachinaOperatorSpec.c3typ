/**
 * Specifies ExMachina transformation node with input bindings
 */
type ExMachinaOperatorSpec {

  /**
   * Node id
   */
  id: !string

  /**
   * Node class id
   */
  classId: !string

  /**
   * Specifications for pipeline input bindings
   */
  inputs: map<string, [ExMachinaInputBinding]>

  /**
   * Specifications for pipeline input bindings
   */
  properties: json
}
