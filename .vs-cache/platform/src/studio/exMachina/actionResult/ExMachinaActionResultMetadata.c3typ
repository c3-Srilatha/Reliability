entity type ExMachinaActionResultMetadata mixes WithParent.IncludeId<ExMachinaActionResultTopic> schema name 'EXM_ARM' {

  /**
   * The parent reference. Overridden to be required
   */
  parent: !~

  /**
   * The project root on which the action(s) were executed
   */
  project: !ExMachinaProjectRoot

  /**
   * A reference to the file which contains action results
   */
  filename: !string

  /**
   * The full action definition for reference
   */
  action: !ExMachinaAction

  /**
   * Read the action result metadata as string
   */
  @dependency(include='filename, parent.id')
  readString: member function(): string js-server
}
