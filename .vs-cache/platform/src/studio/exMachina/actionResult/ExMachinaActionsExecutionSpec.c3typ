/**
 * Specifies actions to be executed
 */
type ExMachinaActionsExecutionSpec {

  /**
   * Pipeline id
   */
  pipelineId: !string

  /**
   * Specifications for input operators
   */
  inputNodes: [ExMachinaOperatorSpec]

  /**
   * Specifications for pipeline input bindings
   */
  inputBindings: map<string, ExMachinaInputBinding>

  /**
   * Execute actions with given ids defined in pipeline
   */
  actionDefinitionIds: [string]

  /**
   * Definition for actions to be executed
   */
  actionDefinitions: [ExMachinaAction]
}
