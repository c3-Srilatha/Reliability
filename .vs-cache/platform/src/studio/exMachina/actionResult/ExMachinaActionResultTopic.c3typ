entity type ExMachinaActionResultTopic schema name 'EXM_ART' {

  name: !~

  /**
   * A description of the action results
   */
  description: string

  /**
   * The latest action results
   */
  latestMetadata: ExMachinaActionResultMetadata stored calc metadataHistory[0]

  /**
   * All previously saved action results
   */
  @db(order='descending(meta.created)')
  metadataHistory: [ExMachinaActionResultMetadata](parent)

  /**
   * Returns the latest metadata result as of (up to and including) a certain datetime. If a `asOfDate` is not
   * provided, returns the {@link latestMetadata}.
   */
  getLatestMetadataAsOfDate: member function(asOfDate: datetime): ExMachinaActionResultMetadata js-server

  /**
   * Method to create a new {@link ExMachinaActionResultTopic} for the user's current account
   */
  createForCurrentUser: function(name: !string, description: string): ExMachinaActionResultTopic js-server
}
