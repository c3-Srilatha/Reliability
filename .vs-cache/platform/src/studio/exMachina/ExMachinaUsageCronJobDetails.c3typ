/**
 * Cron job details for usage
 */
type ExMachinaUsageCronJobDetails {

  /**
   * The timestamp at which the customer will be billed next
   */
  nextBillingDate: datetime

  /**
   * The additional filter to be applied
   */
  additionalFilter: string

  /**
   * Boolean indicating if usage has occured outside the billing window
   */
  isOutsideBillingWindow: boolean
}
