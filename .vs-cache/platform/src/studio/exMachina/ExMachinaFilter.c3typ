type ExMachinaFilter {
  /**
   * For types that contain start and end datetime fields, i.e. they represent a timed interval value, add a filter
   * to check that the record overlaps with the provided time interval.
   *
   * E.g. given the below fetch:
   * ```
   * MyType.fetch({ filter: ExMachinaFilter.timeRangeOverlaps('start', '2000-01-01', 'end', '2000-01-03') })
   * ```
   *
   * Time range overlaps:
   * - { start: '1999-12-31', end: undefined    }
   * - { start: '2000-01-01', end: '2000-01-02' }
   * - { start: '2000-01-01', end: '2000-01-03' }
   * - { start: '2000-01-01', end: '2000-01-04' }
   * - { start: '2000-01-01', end: undefined    }
   *
   * Time range does not overlap:
   * - { start: '1999-12-31', end: '2000-01-01' }
   * - { start: '2000-01-03', end: undefined    }
   *
   * @param startTimeFieldName
   *          The name of the datetime field that corresponds to the start of the time range
   * @param startTime
   *          The start of the time range
   * @param endTimeFieldName
   *          The name of the datetime field that corresponds to the end of the time range
   * @param endTime
   *          The end of the time range
   */
  timeRangeOverlaps: function(startTimeFieldName: !string,
                              startTime: !datetime,
                              endTimeFieldName: !string,
                              endTime: !datetime): !Filter js-server
}
