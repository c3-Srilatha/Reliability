/**
 * Util functions to get information for the NodeOverviewSidePanel, specifically the overview section.
 */
type NodeOverviewSidePanelManager mixes Value {

  /**
   * Generate configuration for source system node overview side panel dynamic section.
   */
  getOverviewSourceSystemSidePanelContent: function(graphNode: !string): json js-server

  /**
   * Generate configuration for source system node overview side panel dynamic section.
   */
  getOverviewSourceCollectionSidePanelContent: function(graphNode: !string): json js-server

  /**
   * Generate configuration for overview section of node overview side panel.
   */
  getOverviewSectionConfig: function(graphNode: !string): json js-server

  /**
   * Returns data shown in node overview side panel overview section.
   * @param graphNode
   *          {@link GlobalCanvasGraphNode} to construct data for.
   */
  getOverviewSectionData: function(graphNode: GlobalCanvasGraphNode): NodeOverviewSidePanelOverviewData js-server
}
