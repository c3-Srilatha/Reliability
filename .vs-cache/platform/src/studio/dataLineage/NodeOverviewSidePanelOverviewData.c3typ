/**
 * Represents data shown in overview section of node overview side panel.
 */
// TODO TOOLS-10046
type NodeOverviewSidePanelOverviewData {

  /**
   * Applicable to all
   */
  description: string

  numberOfPrimitiveColumns: int

  /**
   * For Entity
   */
  numberOfRecords: int

  /**
   * For Source Collection
   */
  inboxUrl: string

  brokerType: string
  brokerName: string

  /**
   * For Source System
   */
  url: string

  sourceType:                string
  datastore:                 string
  overrideUrl:               string
  serverEndpoint:            string
  numberOfSourceCollections: int

  /**
   * For Transforms
   */
  source: string

  target: string
}
