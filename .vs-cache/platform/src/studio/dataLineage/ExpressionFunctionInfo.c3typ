/**
 * Expression function information for displaying on the mapping builder page
 * This type is used so the corresponding react tsx file will be included in the webpack bundle
 */
type ExpressionFunctionInfo {

  /**
   * Name of the function
   */
  name: string

  /**
   * Parameters of the function
   */
  parameters: [string]

  /**
   * Return type of the function
   */
  returnType: string

  /**
   * Description of the function
   */
  description: string
}
