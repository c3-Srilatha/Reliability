/**
 * Ping Status for {@link GlobalCanvasGraphSourceSystemNodeData}
 */
enum type SourceSystemPingStatus {

  /**
   * Status for when {@link GlobalCanvasGraphSourceSystemNodeData} is missing datastore field
   */
  MISSING_DATASTORE = 'missingDatastore'

  /**
   * Status for when {@link GlobalCanvasGraphSourceSystemNode} is in unconfigured state
   */
  UNCONFIGURED = 'unconfigured'

  /**
   * Status for when {@link GlobalCanvasGraphSourceSystemNode} is in connecting state
   */
  CONNECTING = 'connecting'

  /**
   * Status for when {@link GlobalCanvasGraphSourceSystemNode} is in connected state
   */
  CONNECTED = 'connected'

  /**
   * Status for when {@link GlobalCanvasGraphSourceSystemNode} is in connection error state
   */
  CONNECTION_ERROR = 'connectionError'
}
