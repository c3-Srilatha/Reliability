type GlobalCanvasGraphSourceSystemNodeData mixes GlobalCanvasGraphNodeData {

  /**
   * Source system id. If not defined, the SourceSystem has not been persisted yet.
   */
  instanceId: string

  /**
   * The type name
   */
  typeName: string

  /**
   * The id of the datastore
   */
  datastore: string

  /**
   * Different connection statuses related to {@link SourceSystem}
   */
  pingStatus: string enum SourceSystemPingStatus

  /**
   * Response message from {@link SourceSystem}'s ping if any
   */
  pingStatusMessage: string
}
