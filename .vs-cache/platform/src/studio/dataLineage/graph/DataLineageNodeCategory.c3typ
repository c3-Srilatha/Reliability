/**
 * The specific {@link GlobalCanvasGraphNodeCategory} that the data lineage graph can reference. The values match the IDs
 * of the registration in `dataLineage` and `globalCanvasCommon` package.
 */
enum type DataLineageNodeCategory {

  /**
   * Node represents an {@link EntityType}
   */
  ENTITY = 'Entity'

  /**
   * Node represents a {@link @SourceCollection}
   */
  SOURCE_COLLECTION = 'SourceCollection'

  /**
   * Node represents a {@link SourceSystem}
   */
  SOURCE_SYSTEM = 'SourceSystem'

  /**
   * Node represents a {@link Transform}
   */
  TRANSFORM = 'Transform'

  /**
   * Node represents a {@link Source}
   */
  SOURCE = 'Source'
}
