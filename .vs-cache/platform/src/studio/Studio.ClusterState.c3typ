/**
 * Represents state of Studio envs and apps.
 */
enum type Studio.ClusterState mixes CloudCluster.State {

  /**
   * Studio env or app is pending start.
   */
  PENDING_START

  /**
   * Studio env or app is pending to restart.
   */
  PENDING_RESTART

  /**
   * Studio env or app is restarting
   */
  RESTARTING

  /**
   * Studio env or app is pending resume.
   */
  PENDING_RESUME

  /**
   * Studio env or app is pending stop.
   */
  PENDING_STOP

  /**
   * Studio env or app is pending termination.
   */
  PENDING_TERMINATE

  /**
   * Studio env or app is pending upgrade.
   */
  PENDING_UPGRADE

  /**
   * Studio env or app infrastructure is running but node state is degraded state.
   */
  DEGRADED

  /**
   * Studio env or app state is unknown.
   */
  UNKNOWN

  /**
   * More specific error state for app when failed in actual starting process.
   */
  ERROR_FAILED_START
}
