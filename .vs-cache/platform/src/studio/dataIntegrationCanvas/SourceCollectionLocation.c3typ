/**
 * Represents the source collection location
 */
enum type SourceCollectionLocation {

  /**
   * Whether the source collection only exists on the remote environment
   */
  REMOTE_ONLY

  /**
   * Whether the source collection only exists on the local environment
   */
  LOCAL_ONLY

  /**
   * Whether the source collection exists both on the remote and local environment
   */
  REMOTE_AND_LOCAL
}
