/**
 * Source collection type for UI purposes.
 */
type SourceCollectionUi {

  /**
   * The associated source collection name.
   */
  sourceCollectionName: string

  /**
   * The uploaded files in the source collection
   */
  fileNames: [string]

  /**
   * The associated local source collection.
   * The json object has the structure of {@link SourceCollection}.
   */
  localSourceCollection: json

  /**
   * The source type metadata associated to local version of the source collection.
   * The json object has the structure of {@link TypeMeta}.
   */
  localSource: TypeMeta

  /**
   * The source type metadata associated to remote version of the source collection.
   * The json object has the structure of {@link TypeMeta}.
   */
  remoteSource: TypeMeta

  /**
   * The location of the source system collection.
   */
  location: string enum SourceCollectionLocation

  /**
   * Map of all the mismatches for a local collection against the remote collection with the same name.
   * The map key is the field name.
   */
  localSourceMismatchAgainstRemote: map<string, string enum SourceCollectionUiSchemaMismatchError>
}
