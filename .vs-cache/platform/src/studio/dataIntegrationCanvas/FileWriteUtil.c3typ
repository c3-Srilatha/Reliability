// Utility APIs for writing files
type FileWriteUtil {

  /**
   * Write binary to a file at the given location.
   *
   * @param url
   *           The location of the file
   * @param content
   *           The binary data to write into the file
   * @return true unless an exception was thrown
   */
  writeBinaryToFile: function(url: !string, content: !?[int32]): boolean
}
