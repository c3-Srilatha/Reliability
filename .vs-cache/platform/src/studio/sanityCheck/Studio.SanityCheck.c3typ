/**
 * Return format for Studio#sanityCheck. Studio.SanityCheck contains a map of warnings and errors found from the check.
 * Currently the only warning is if a cronjob within the seed folder is deemed to be inactive.
 */
type Studio.SanityCheck {

  /**
   * Map of info type to info instances
   */
  infos: map<string, json>

  /**
   * Map of warning types to warning instances.
   */
  warnings: map<string, json>

  /**
   * Map of error types to error instances. Ex. { "cronjob" : {"inactive": ["cronjob-id-123", "cronjob-id-456"]}}
   */
  errors: map<string, json>

  /**
   * Flattens all the messages. Keys will be the 'infos', 'warnings', and 'errors' and values will be the messages.
   */
  flattenMessages: member function(): map<string, [string]> js-server
}
