/**
 * Api that performs {@link Evaluatable#eval} and {@link DataImpl#collect} required by Feature Store
 */
// TODO: PLAT-65344 Remove this type when {@link Evaluatable#eval} supports collecting
type EvalBridge {

  /**
   * Api that performs {@link Evaluatable#eval} on `evalType` and {@link DataImpl#collect}
   */
  evaluate: function(evalType: !Type<<Evaluatable>>, spec: EvalSpec): [any] js-server

  /**
   * Api that performs {@link EvalBridge#evaluate} and converts result to {@link FetchResult}
   */
  evalToFetchResult: function(evalType: !Type<<Evaluatable>>, spec: FetchSpec): FetchResult<any> js-server
}
