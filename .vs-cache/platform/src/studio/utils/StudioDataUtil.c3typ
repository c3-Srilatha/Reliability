/**
 * Utility function to simplify {@link UiSdlDataGrid}'s
 * fetch#spec related operations for non-persistable types.
 */
type StudioDataUtil {

  /**
   * Function to be passed to the Array.sort()
   * to perform sorting based on the field and sortOrder
   * sortOrder options are 1 for ascending and -1 for descending.
   */
  objectSort: function(dataArray: [any], field: !string, sortOrder: !int): [any] js-server

  /**
   * Function used to filter the data array based on the fetchFilterSpec.
   * filterStringSpec should contain lower-case values for comparison.
   */
  filter: function(dataArray: [any], filterStringSpec: string): [any] js-server

  /**
   * Returns the filtered data after evaluating the spec. Supports the basic spec operations
   * 1. filter
   * 2. sort
   * 3. limit
   * 4. offset
   */
  evaluateFetchSpec: function(dataArray: [any], spec: FetchSpec): [any] js-server
}
