/**
 * Meta information about each column in a {@link DataGrid}.
 */
type DataGrid.Col {

  index: !int32

  /**
   * The field name or path for data access.
   */
  name: !string

  /**
   * Column label for display. If not set, {@link #name} is used.
   */
  label: string

  /**
   * The identified value type of the column.
   */
  valueType: !ValueType

  /**
   * For measurements, the associated unit.
   */
  unit: Unit

  /**
   * If true, this column is not part of the data proper, but represents the row labels generated by the grid.
   *
   * @see DataGrid#labelCol
   */
  rowLabel: boolean

  /**
   * If this is a #rowLabel, whether it is displaying the index of the row instead of some other key.
   */
  rowIndex: boolean

  /**
   * Whether this column is the expansion of a collection in the source object. In this case, the #valueType will be
   * that of the collection element type and the values displayed will be elements of the collection. In the case of
   * maps, two columns will be produced, one for the key and one for the element.
   *
   * @see DataGrid.Flattened
   */
  flattened: string enum('key', 'element')

  /**
   * True if the value type is {@link NumberType numeric}.
   */
  number: property(): boolean java | js

  /**
   * Override the default alignment. If not specified, numeric columns are right-aligned and others are left-aligned.
   */
  align: string enum('left', 'right')

  /**
   * True if the value type's values can be compared for ordering purposes. This includes {@link #number numeric},
   * `datetime`, `string` and `boolean` types.
   */
  scalar: property(): boolean java | js

  /**
   * Compare the two values for this column according to the natural ordering of their value type. This only works well
   * for #scalar columns.
   *
   * @param a first value to compare
   * @param b second value to compare
   * @param order specify descending and/or nulls reversed
   * @return <0, 0, or >0 depending on the relative ordering of the values
   */
  compare: member function(a: !?any, b: !?any, order: SortDescriptor): !int32 java | js

  /**
   * Return a comparator function of two values for this column according to the natural ordering of their value type.
   * This only works well for #scalar columns.
   *
   * @param order specify descending and/or nulls reversed
   * @return lambda of two parameters that returns <0, 0, or >0 depending on the relative ordering of the values
   */
  comparator: member function(order: SortDescriptor): !lambda(a: !?any, b: !?any): !int32 java | js

  /**
   * Test a cell of this column against a specification string.
   *
   * Match values are interpreted according to the column value type:
   * - all columns:
   *   - a null value matches null
   *   - an empty string matches empty (null or whitespace)
   *   - "null" preceded by `=` or `!` does a null check
   * - numeric columns:
   *   - empty includes `NaN` and infinite values
   *   - plain number matches value
   *   - inequality prefixes `>`, `<`, `>=`, `<=`, `==`, `!=` supported
   * - datetime columns:
   *   - match value must be a valid datetime
   *   - inequality prefixes `>`, `<`, `>=`, `<=`, `==`, `!=` supported
   * - string columns:
   *   - plain string searches within value, case insensitive
   *   - a leading `/` means regular expression match (may be prefixed by `!` for negation)
   *   - a leading `!` means not containes
   *   - a leading `!=` or `==` means exact match (case sensitive)
   * - other columns are like string columns, but matching displayed (string) representation
   *
   * @param cell value to test
   * @param match match string; see above
   * @param failIfInvalid throw an error instead of returning false for an invalid match
   * @return true if the cell matches the filter
   */
  filter: member function(cell: !DataGrid.Cell, match: ?string, failIfInvalid: boolean): boolean java | js

  /**
   * Return a lambda that tests a cell of this column against a specification string. If the match cannot be parsed
   * to something that can ever be true, return null.
   *
   * @param match match string; see #filter
   * @param failIfInvalid throw an error instead of returning null for an invalid match
   * @return lambda that takes the cell to test
   *
   * @see #filter
   */
  filterer: member function(match: ?string, failIfInvalid: boolean): lambda(cell: !DataGrid.Cell): !boolean java | js

  /**
   * Defaults:
   * - If `name` is missing/empty but `label` is set, treat `label` as the access path.
   * - If `label` is missing/empty but `name` is set, default `label` for display.
   */
  beforeMake: ~ java | js
}
