/**
 * Abstract interface representing the pandas RangeIndex class.
 */
@beta
abstract type Data.RangeIndex mixes ReClaim, Data.IndexBase, Pandas.RangeIndex {

  // PySDK doesn't recognize ReClaimed static abstract methods so we need to claim them here
  from_range: ~
}
