/**
 * Contains the data for a single column in a DataFrame as a list. This is used when the underlying Data cannot be
 * converted to a numpy array. Has special logic for deserializing C3 TimeRange as a Pd timestamp on calls to to_numpy
 */
private type Data.TupleDefault mixes Data.TupleBase {

  /**
   * content of the column serialized using default options as a json string
   */
  values: string

  to_binary: ~
}
