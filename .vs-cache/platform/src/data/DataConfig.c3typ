@beta
type DataConfig mixes Config {

  /**
   * Indicates whether operations on Data should be evaluated lazily or eagerly
   */
  // TODO: PLAT-46488 Set the default Data evaluation mode to "eager"
  lazy: boolean = true

  /**
   * If true, the python methods annotated by the @profile will be profiled.
   */
  cprofileEnabled: boolean

  // TODO: PLAT-48670: Use TmpFileSystem to make Data test profiling configurable

  /**
   * The directory to save the cProfile files. This folder should be a temporary folder
   */
  profileFolder: string
}
