/**
 * Type containing logic for the binary serialization of a numpy array of booleans that may contain Nones.
 * None values in a bool array are encoded with a value of 255 that must be specially handled when deserializing
 */
private type Data.TupleBool mixes Data.TupleBase {

  /**
   * Binary serialized array of boolean values. May contain Nones
   */
  bytes: private binary

  to_binary: ~
}
