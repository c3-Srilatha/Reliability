/**
 * Base Index Pandas type that all Data.Index Pandas subtypes inherit from
 */
@beta
abstract private type Data.IndexBase.Pandas mixes DataImpl.Pandas, Data.IndexBase {

  _exec: ~ from DataImpl.Pandas

  @reClaim(inherit=true)
  toDataPandas: ~

  @reClaim(inherit=true)
  _repr_: ~

  @reClaim(inherit=true)
  _length_: ~

  type:      ~ java
  toDataRef: ~: !Data.IndexBase.Ref from DataImpl.Pandas
}
