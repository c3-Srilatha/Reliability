/**
 * This type of slicing supports serializing using Python `:` syntax, such as `0:20` (entries 0 through 19 inclusive)
 * and `::2` (every other entry).
 */
type AnySlice mixes Slice<any> {

  /**
   * Construct an AnySlice object from a string. Only supports primitive types
   */
  // TODO PLAT-49669: Remove fromString in AnySlice and update Javascript implementation to defer to Python
  fromString: inline function(s: !?string): AnySlice java | js | py

  // TODO PLAT-49669: Remove fromString in AnySlice and update Javascript implementation to defer to Python
  toString: inline member function(): string java | js | py
}
