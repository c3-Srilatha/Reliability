/**
 * Serves as probabilistic data structure to approximate ranks of inputted values
 * Using the approximate ranks, a Cumulative Distribution Function (CDF) can be estimated
 * For more information, the original paper is reference 5 of this article:
 * @see [https://medium.com/@mani./t-digest-an-interesting-datastructure-to-estimate-quantiles-accurately-b99a50eaf4f7]
 *
 * @var VT type of examined values
 * ```js
 * var inputStream = Stream.ofInt(1,2,3)
 * var tdigest = TDigest.create(inputStream, TDigestSpec.make())
 * var inputStream2 = Stream.ofInt(2,3)
 * tdigest = tdigest.add(inputStream2, true)
 * var histogram = tdigest.histogram()
 * ```
 */
// TODO: PLAT-27172 Make TDigest mix Serializable
type TDigest mixes Mutable {

  /**
   * Parameters that define the accuracy and speed of TDigest
   */
  spec: private TDigestSpec

  /**
   * Stores values waiting to merge into the clusters
   */
  buffer: private @java(class='java.util.ArrayList<TDigestCluster>') native

  /**
   * Sets merge in opposite direction to mitigate direction bias in errors from merging
   * Default set to false, fill be flipped after each merge automatically
   */
  mergeBackwards: private !boolean

  /**
   * Keeps track of total points in all clusters of this TDigest
   */
  count: private !int = 0

  /**
   * Stores the current clusters in the TDigest sorted by mean
   */
  clusters: private @java(class='java.util.ArrayList<TDigestCluster>') native schema suffix 'TDC'

  /**
   * Creates new instance of TDigest with input numbers
   * @param in
   *       Stream of input values
   * @param spec
   *       an instance of TDigestSpec containing information for parameters of the TDigest
   *       if no values are set, default TDigestSpec values will be used
   * @return new instance of TDigest with input values added
   */
  create: inline function(in: stream<int16 | int32 | int | double | decimal | float | byte>,
                          spec: TDigestSpec): TDigest

  /**
   * Creates PushStream that feeds into TDigest
   * @param spec
   *       an instance of TDigestSpec containing information for parameters of the TDigest
   *       if no values are set, default TDigestSpec values will be used
   * @return new instance of PushStream, values added to stream will go into TDigest
   */
  createPushStream: inline function(spec: TDigestSpec)
                             : Pair<TDigest, PushStream<int16 | int32 | int | double | decimal | float | byte>>

  /**
   * Add input values to existing TDigest, merges if Buffer fills or if force is True
   * @param in
   *       Stream of input values
   * @param flush
   *       If set to true, then items in buffer will merge into clusters
   *       If set to false, then items will only merge into cluster when buffer is full
   *       Recommend to set to false unless no more values are being added to TDigest
   * @return new instance of TDigest with input values added
   */
  addStream: member function(in: stream<int16 | int32 | int | double | decimal | float | byte>,
                             flush: boolean): TDigest

  /**
   * Add input values to existing TDigest, merges if Buffer fills
   * @param in
   *       Single input value
   * @return new instance of TDigest with input values added
   */
  add: inline member function(in: int16 | int32 | int | double | decimal | float | byte): TDigest

  /**
   * Merge together all TDigests in array to form single TDigest
   * @param tdigests
   *       Array of TDigests to merge
   * @param spec
   *       TDigestSpec giving the parameters of the new TDigest, i.e. Compression Parameter, Buffer Size, and Flush
   * @return new instance of TDigest with all TDigests merged
   */
  merge: function(tdigests: [TDigest], spec: TDigestSpec): TDigest

  /**
   * Clears buffer and adds elements in buffer to TDigest clusters
   */
  flush: private member function(): TDigest

  /**
   * @return Histogram that approximates all values passed in
   */
  histogram: member function(): NumericHistogram
}
