/**
 * Digest is a generic structure that contains analysis on a dataset of any type.
 */
// TODO: PLAT-25285: Add fourth parameter H (Histogram type) to Digest family
abstract type Digest<VT, D: Digest, B: DigestBuilder> mixes Stats<D, B> {

  /**
   * the minimum value of the input stream, for string will return string of minimum length
   */
  min: !?VT

  /**
   * the maximum value of the input stream, for string will return string of maximum length
   */
  max: !?VT

  /**
   * number of elements evaluated
   */
  count: !int

  /**
   * number of null elements evaluated
   */
  nullCount: !int

  /**
   * number of elements that did not match the specified ValueType of this Digest
   */
  invalidCount: !int

  /**
   * Stores the spec for what statistics were calculated for this Digest
   */
  spec: DigestSpec schema suffix 'DS'

  /**
   * The ValueType that this Digest corresponds to
   */
  valueType: member function(): ValueType

  /**
   * Stores histogram information
   */
  hist: abstract member function(): Histogram

  /**
   * Stores input data in a HyperLogLog structure used for estimating unique count
   */
  hyperLogLog: private HyperLogLog schema suffix 'HLL'

  /**
   * Stores input data in a CountMinSketch structure used for estimating frequent elements
   */
  countMinSketch: private CountMinSketch schema suffix 'CMS'

  /**
   * Stores hashes of a subset of input data used for approximate inclusion tests
   */
  minHash: private MinHash schema suffix 'MH'

  /**
   * The approximate number of unique elements in the stream
   */
  approxUniqueCount: member function(): !int

  /**
   * The approximate most frequent elements and their frequencies
   */
  approxMostFrequent: member function(): map<string, int>

  /**
   * Uses MinHash technique to approximately determine if all elements processed by this Digest contain all elements of
   * another Digest. Digests must be the same type.
   * @see MinHash
   */
  approxInclusionTest: member function(other: !D): !boolean

  /**
   * Uses MinHash technique to approximate Jaccard Index (or Jaccard similarity coefficient), which is equal to
   * |ths Intersect other| / |ths Union other|. Digests must be the same type.
   * @see MinHash
   * @see https://en.wikipedia.org/wiki/Jaccard_index
   */
  approxJaccardIndex: member function(other: !D): !double

  /**
   * Overload of statsBuilder to accept a DigestSpec
   */
  statsBuilder: function(spec: DigestSpec): !DigestBuilder

  /**
   * Convert AnyDigest to Digest with the highest count. This method is a no-op for anything but AnyDigest.
   * @see AnyDigest
   */
  toMostPopulatedDigest: abstract member function(): !Digest

  /**
   * merge is a wrapper around doMerge. Each sub type should implement sub type specific merging in doMerge.
   */
  mergeWith: final ~

  doMerge: abstract member function(other: D): !D
}
