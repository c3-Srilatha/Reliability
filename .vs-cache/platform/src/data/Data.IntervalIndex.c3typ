/**
 * Abstract interface representing the pandas IntervalIndex class.
 */
@beta
abstract type Data.IntervalIndex mixes ReClaim, Data.IndexBase, Pandas.IntervalIndex {

  // TODO: PLAT-50581 Pandas type generation framework should be able to infer parameters from documentation
  contains: abstract member function(other: any): [boolean]

  overlaps:   abstract member function(other: any): [boolean]
  set_closed: abstract member function(closed: string): Data.IntervalIndex

  // PySDK doesn't recognize ReClaimed static abstract methods so we need to claim them here
  from_arrays: ~

  from_breaks: ~
  from_tuples: ~
}
