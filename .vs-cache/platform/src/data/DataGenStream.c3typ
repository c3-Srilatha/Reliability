/**
 * Spec for generating a stream. See {@link Data.generate} & {@link Data.profile}.
 *
 * Because values are generated on demand, careful management of the seed is necessary to ensure reproducibility of
 * values from the same seed if calls are intermixed with calls to other sources of randomness.
 */
type DataGenStream mixes DataGenCollection<stream<any>> {

  /**
   * Wrap stream semantics around this array generator. This is useful because the seed can be made consistent since
   * all the values are generated in one shot by the caller. I.e., it can be used in combination with other data
   * data generators without special arrangements.
   *
   * The downside is that since all values are generated at once, the size of the stream must fit into memory.
   */
  fromArray: function(arrayGen: !DataGenArray): DataGenStream

  _source: private DataGenArray
}
