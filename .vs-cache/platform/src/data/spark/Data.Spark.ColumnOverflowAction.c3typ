/**
 * Enum for handling behavior when varchar columns exceed size limits in {@link Data.Spark.ReadFilesByRegexSpec}.
 */
enum type Data.Spark.ColumnOverflowAction {

  /**
   * Skip rows where the varchar column exceeds the size limit.
   */
  SKIP

  /**
   * Truncate the varchar column content when it exceeds the size limit.
   */
  TRUNCATE

  /**
   * Fail the entire operation when a varchar column exceeds the size limit.
   */
  FAIL
}
