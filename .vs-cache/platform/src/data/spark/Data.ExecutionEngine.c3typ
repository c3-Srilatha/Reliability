/**
 * Interface for data pipeline execution engine.
 */
@beta
abstract type Data.ExecutionEngine {

  /**
   * Send the pipeline to the execution engine for execution.
   * returns a {@link Json} that contains the execution result of the pipeline.
   */
  execute: abstract member function(pipeline: PipelineSpec, nodeId: string, outputId: string): json
}
