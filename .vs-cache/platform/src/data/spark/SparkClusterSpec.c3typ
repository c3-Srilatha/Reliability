type SparkClusterSpec mixes Spec {

  /**
   * Image tag used for main driver pod. Default value is {@link ExMachina_Config#exmacDriverImageTag}.
   */
  imageTag: private string

  /**
   * spark.executor.instances
   * @see https://spark.apache.org/docs/latest/configuration.html#application-properties
   */
  numExecutors: string = "1"

  @deprecated(finalVersion="8.10", details="Use numExecutors instead")
  numOfExecutor: string

  /**
   * spark.executor.cores
   * @see https://spark.apache.org/docs/latest/configuration.html#application-properties
   */
  executorCores: string = "8"

  /**
   * spark.executor.memory
   * @see https://spark.apache.org/docs/latest/configuration.html#application-properties
   */
  executorMemory: string = "32G"

  /**
   * additional spark application properties to set
   * @see https://spark.apache.org/docs/latest/configuration.html#application-properties
   * users need to pass something like {"spark.driver.maxResultSize": "2g"}
   */
  additionalConfig: map<string, any>

  /**
   * Decision to wait for service to be fully operational.
   */
  waitForReady: boolean = true

  /**
   * Service timeout in minutes.
   */
  idleTimeoutMinutes: int = 30

  /**
   * THe Http request timeout in minutes.
   */
  requestTimeoutMinutes: int = 30

  /**
   * Enable Spark dynamic resource allocation. Note that the 'minExecutors', 'maxExecutors', 'executorTimeoutSeconds', 'executorAllocationRatio'
   * will not have an effect unless this is enabled.
   */
  dynamicResourceAllocation: boolean = true

  /**
   * The minimum number of executors that will be active at any time.
   */
  minExecutors: string = "0"

  /**
   * The maximum number of executors that can be active at any time.
   */
  maxExecutors: string = "10"

  /**
   * How long, in seconds, an executor can be idle before shutting down.
   */
  executorTimeoutSeconds: string = "60"

  /**
   * This many tasks will be assigned to each executor. If there is tasks remaining, more executors will be provisioned.
   */
  executorAllocationRatio: string = "1"
}
