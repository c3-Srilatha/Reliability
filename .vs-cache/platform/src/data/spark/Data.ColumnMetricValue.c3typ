@beta
type Data.ColumnMetricValue {

  /**
   * Name of DataFrame column for which metric was computed.
   */
  column: !string

  /**
   * MetricName of DataFrame column for which metric was computed.
   */
  metric: !Data.ColumnMetric

  /**
   * Send the pipeline to the execution engine for execution.
   * returns a {@link Json} that contains the execution result of the pipeline.
   */
  value: any
}
