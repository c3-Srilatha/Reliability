@beta
native py remix type Data.Spark.IndexImpl {

  /**
   * Converts this Data.Spark.SeriesImpl  to native `pandas.Series`
   * Internally, it will call `to_spark` and then convert to `pandas.Series`
   * This method should only be used if the resulting pandas.Series is expected to fit in memory,
   * as all the data is loaded into the driver’s memory.
   */
  to_pandas: member function(): native py

  to_numpy: member function(): native py
  values:   property(): native py
  _iter_:   ~ py
}
