type Data.Spark.ReadFeatureSetPartition {

  // Specifies id of feature set to be read.
  featureSetId: !string

  // Specifies optional lower boundary for subject id to be included into partition.
  fromSubjectId: string

  // Specifies optional upper boundary for subject id to be included into partition.
  toSubjectId: string

  // Specifies maximum number of subjects to be included into partition.
  batchSize: int32
}
