@beta
native py remix type Data.Spark {

  /**
   * Access element through '.' syntax.
   * On DataFrame, it will access column based on the column name. (df.column_name)
   * On Series, it will access element based on the index (s.index)
   */
  @reClaim(inherit=true)
  _field_: private ~ py

  /**
   * Helper method to override the pipeline of a Data.Spark instance
   */
  @reClaim(inherit=true)
  updatePipeline: private member function(action: string, args: map<string, any>) py
}
