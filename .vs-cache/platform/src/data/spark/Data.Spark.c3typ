/**
 * Abstract super type for all Data.Spark subtypes.
 */
@beta
abstract private type Data.Spark mixes Mutable, PyReprProtocol, ArithmeticProtocol, MutableItemProtocol, FieldProtocol, ComparisonProtocol, LogicalProtocol, UnaryArithmeticProtocol, Iterable, ReClaim {

  /**
   * Underlying execution engine ({@link Data.ExecutionEngine}) that executes the plan
   * It's the same engine of Spark Session when we created this Data.Spark instance
   */
  engine: Data.ExecutionEngine

  /**
   * The plan that used to actualize this Data.Spark instance
   */
  pipeline: PipelineSpec

  /**
   * The id number that represent this Data.Spark instance
   */
  nodeId: string

  /**
   * The output name of the pipeline
   */
  outputId: string

  _exec:                   private ~
  lessThan:                private abstract ~: ?(Data.Spark.DataFrame | Data.Spark.Series)
  lessThanEqualTo:         private abstract ~: ?(Data.Spark.DataFrame | Data.Spark.Series)
  equalTo:                 private abstract ~: ?(Data.Spark.DataFrame | Data.Spark.Series)
  notEqualTo:              private abstract ~: ?(Data.Spark.DataFrame | Data.Spark.Series)
  greaterThan:             private abstract ~: ?(Data.Spark.DataFrame | Data.Spark.Series)
  greaterThanEqualTo:      private abstract ~: ?(Data.Spark.DataFrame | Data.Spark.Series)
  reflectedMatrixMultiply: private ~: ?Data.Spark.Series
}
