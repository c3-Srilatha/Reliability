@beta
native py remix type Data.Spark.DataFrameImpl {

  /**
   * Converts this Data.Spark.DataFrameImpl  to native `pyspark.sql.connect.dataframe.DataFrame`
   * The actual data still lives on the remote Spark Cluster and users could interact with it using the `pyspark` API
   * that Spark Connect (https://spark.apache.org/docs/latest/spark-connect-overview.html) supports
   */
  to_spark: member function(index_col: ?([string] | string)): native py

  /**
   * Converts this Data.Spark.DataFrameImpl  to native `pandas.core.frame.DataFrame`
   * Internally, it will call `to_spark` and then convert to `pandas.DataFrame`
   * This method should only be used if the resulting pandas.DataFrame is expected to fit in memory,
   * as all the data is loaded into the driver’s memory.
   */
  to_pandas: member function(): native py

  to_numpy:   member function(): native py
  values:     property(): native py
  shape:      ~: native py
  columns:    ~: native py
  _iter_:     ~ py
  items:      ~: native py
  iteritems:  ~: native py
  iterrows:   ~: native py
  itertuples: ~: native py
}
