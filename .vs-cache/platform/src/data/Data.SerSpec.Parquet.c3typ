/**
 * Pandas's Parquet Serialization
 * see https://pandas.pydata.org/docs/reference/api/pandas.DataFrame.to_parquet.html
 *
 * @see Data
 */
@beta
private type Data.SerSpec.Parquet mixes Data.SerSpec {

  /**
   * If path is provided, write the output to the path, otherwise return the content as binary
   */
  path: string

  /**
   * Parquet library to use
   */
  engine: string enum("pyarrow", "fastparquet") = "pyarrow"

  /**
   * Name of the compression to use
   */
  compression: string enum("snappy", "gzip", "brotli", "lz4", "zstd") = "snappy"

  /**
   * If True, include the dataframe’s index(es) in the output
   */
  index: boolean = true

  /**
   * Column names by which to partition the dataset.
   */
  partition_cols: Array<string>
}
