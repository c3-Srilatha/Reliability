/**
 * Base type for exact or approximate statistics of some data.
 */
abstract type Stats<S: Stats, B: StatsBuilder> mixes Mergeable<S> {

  /**
   * Builds stats by invoking consumer lambda with an empty builder
   */
  buildStats: function(builder: !lambda(b: B)): mixing Stats

  /**
   * Instantiates builder of this stats
   */
  statsBuilder: function(): !B

  /**
   * Retrieve type of specialized stats builder for this stats
   */
  statsBuilderType: function(): !Type<<B>>

  /**
   * Instantiates builder of this stats with initial values based on this instance
   */
  toStatsBuilder: member function(): !B
}
