/**
 * spec for {@link DataImpl.checkEquals} to check whether two dataImpls are same
 */
@beta
type Data.CheckEqualsSpec mixes Spec {

  /**
   * compares the types with in the dataframes i.e (Data with ints vs Data with floats)
   */
  check_dtype: boolean

  /**
   * compares the c3 Data subtype of the two dataImpls (DataRef vs DataLazy)
   */
  check_data_subtype: boolean

  /**
   * @param pySrc
   *        The python source code that is executed in python
   * @param dataType
   *        Type of the Data we want to assert against
   */
  assertionMethod: function(dataType: !Type): !string
}
