@beta
private type Data.ManualOpSpecs.PlotSpec {

  data:         ?Data
  x:            ?any
  y:            ?any
  kind:         string enum("line", "bar", "barh", "hist", "box", "kde", "density", "area", "pie", "scatter", "hexbin") = "line"
  ax:           ?any
  subplots:     boolean = false
  sharex:       boolean = true
  sharey:       boolean = false
  layout:       Pair<int, int>
  figsize:      Pair<int, int>
  use_index:    boolean = true
  title:        ?(string | [any])
  grid:         ?boolean
  legend:       boolean | string enum("reverse")
  style:        ?any
  logx:         boolean | string enum("sym") = false
  logy:         boolean | string enum("sym") = false
  loglog:       boolean | string enum("sym") = false
  xticks:       ?any
  yticks:       ?any
  xlim:         ?any
  ylim:         ?any
  xlabel:       ?any
  ylabel:       ?any
  rot:          int
  fontsize:     int
  colormap:     ?any
  colorbar:     boolean
  position:     float
  table:        ?any
  yerr:         ?any
  xerr:         ?any
  stacked:      boolean
  sort_columns: boolean = false
  secondary_y:  ?any = false
  mark_right:   boolean = true
  include_bool: boolean = false
  backend:      ?string
}
