/**
 * Options for rendering the grid as a textual table using spaces to align columns. The column to be sorted must
 * be specified at a minimum and the #descending and #nullsReversed options are also available.
 *
 * @see DataGrid.FormatSpec#sortColumns
 */
type DataGrid.SortCol mixes SortDescriptor, WithToString {

  /**
   * Zero-based index of the column on which to sort.
   */
  index: !int32

  toString: ~ java | js
}
