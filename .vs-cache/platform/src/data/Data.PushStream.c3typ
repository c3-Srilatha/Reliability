/**
 * Interface to write {@link Data} incrementally.
 */
@beta
abstract type Data.PushStream {

  /**
   * Spec controlling behavior of the push stream.
   */
  spec: Data.PushStreamSpec

  /**
   * Add elements to buffer as long as {@link spec.maxBatchSizeMB} is not exceeded. If adding data exceeds batch size,
   * flush to disk. This API accepts numpy.ndarray, pandas.DataFrame, or {@link Data} as input.
   * Note: The {@link #data} should fit in memory when materialized.
   */
  // TODO: PLAT-60636: Add overload for absolute position
  append: abstract member function(data: !native) py

  /**
   * Close the stream.
   */
  close: abstract member function(): !Data
}
