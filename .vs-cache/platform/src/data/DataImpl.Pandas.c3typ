/**
 * Abstract interface representing methods common to all concrete subtypes relevant to the pandas
 * execution mode. This include concrete types such as {@link Data.Pandas}, {@link Data.Series.Pandas} and
 * {@link Data.Index.Pandas}
 */
@beta
abstract private type DataImpl.Pandas mixes Data.Stateful, WithCacheKey, DataImpl {

  _exec: private ~

  /**
   * PySrc that can be executed to re-create this DataImpl.Pandas
   */
  _pySrc: private string

  @reClaim(inherit=true)
  pySrc: private property(): string

  _fileName: private string

  @reClaim(inherit=true)
  fileName: private property(): string

  @reClaim(inherit=true)
  sourceName: ~

  /**
   * Tuple of {columnName:[value]} to create a DataImpl.Pandas from
   */
  // TODO: PLAT-52291: _tuple field in Data.Pandas.c3typ should be Tuple instead of Any
  _tuple: private any

  // TODO: PLAT-52291: _tuple field in Data.Pandas.c3typ should be Tuple instead of Any
  @reClaim(inherit=true)
  tuple: private property(): any

  /**
   * Whether the {@link #tuple} field value types can be fully supported by arrow.
   */
  _arrowSupport: private boolean

  @reClaim(inherit=true)
  arrowSupport: private property(): boolean

  /**
   * All DataImpl.Pandas referenced by the pySrc
   */
  _datas: private set<DataImpl.Pandas>

  @reClaim(inherit=true)
  datas: private property(): set<DataImpl.Pandas>

  /**
   * Pickled Pandas binary
   */
  _binary: private binary

  /**
   * List of pickled Pandas segments binaries
   */
  _binaries: private [binary]

  /**
   * Helper method to get the binary segments of the Data
   */
  @reClaim(inherit=true)
  binaries: private property(): [binary]

  /**
   * Helper function to check whether the Dataset contains binary segments for this DataImpl.Pandas
   *
   * @return true if this has binary segments in the dataset, false otherwise
   */
  @reClaim(inherit=true)
  hasBinaries: private member function(): boolean

  _numBinarySegments: private int

  @reClaim(inherit=true)
  numBinarySegments: private property(): int

  /**
   * Retrieve from the Dataset the idx-th segment of the binary of the source Pandas DataFrame
   *
   * @param idx
   *        the index the segment being queried has in sorted order
   * @return the idx-th segment of the object with the given name's binary representation
   */
  @reClaim(inherit=true)
  getBinarySegment: private member function(idx: !int): binary

  /**
   * Helper method to rewind the binary buffer to the beginning
   */
  @reClaim(inherit=true)
  binary: private property(): binary

  /**
   * Type of binary format for reading {@link Data.Persisted}
   */
  _persistedFormat: private Data.PersistedFormat

  @reClaim(inherit=true)
  persistedFormat: private property(): string

  /**
   * see tableName arg for {@link Feature.Store#readData}.
   */
  _tableName: private string

  @reClaim(inherit=true)
  tableName: private property(): string

  /**
   * see id arg for {@link Feature.Store#readData}.
   */
  _tableEntryId: private string

  @reClaim(inherit=true)
  tableEntryId: private property(): string

  /**
   * Mapping of variable names to their values to be used by the PyAst Executor
   */
  _vars: private map<string, any>

  @reClaim(inherit=true)
  vars: private property(): map<string, any>

  /**
   * Create an instance of DataImpl.Pandas with the provided name
   */
  // TODO: PLAT-43055 Improve Data.Pandas Serialization so it is not tied to a particular pandas version
  @reClaim(inherit=true)
  @call(javaThreadAffinity=true)
  @pandas(isNotPandasDispatchable=true, canReturnData=true)
  fromBinary: private function(name: !string, data: !binary, dataset: Dataset): mixing DataImpl.Pandas py-jep

  @reClaim(inherit=true)
  @call(javaThreadAffinity=true)
  fromBinary: private function(name: !string, data: ![binary], dataset: Dataset): mixing DataImpl.Pandas py-jep

  /**
   * Create an instance of DataImpl.Pandas with the provided name from {@link Feature.Store} store information.
   * See {@link Feature.Store#readData} and {@link Feature.Store#readDataFromArrow}.
   */
  @reClaim(inherit=true)
  fromStore: private function(name: !string,
                              tableName: !string,
                              tableEntryId: !string,
                              dataset: Dataset,
                              persistedFormat: string): mixing DataImpl.Pandas

  /**
   * Create an instance of DataImpl.Pandas with the provided name from a pandas binary
   */
  @reClaim(inherit=true)
  fromName: private function(name: !string, binary: !binary, dataset: Dataset): mixing DataImpl.Pandas

  /**
   * Create an instance of DataImpl.Pandas with the provided name and pySrc
   */
  @reClaim(inherit=true)
  fromName: private function(name: !string,
                             pySrc: !string,
                             datas: set<DataImpl.Pandas>,
                             vars: map<string, any>,
                             dataset: Dataset): mixing DataImpl.Pandas

  /**
   * Create an instance of DataImpl.Pandas with the provided name from binary segments temporarily saved in the
   * Dataset. See {@link Dataset#addBinarySegment}
   */
  @reClaim(inherit=true)
  fromDatasetBinaries: private function(name: !string, dataset: Dataset): mixing DataImpl.Pandas

  /**
   * Create an instance of DataImpl.Pandas with the provided name from a pickled binary file specified by fileName
   */
  @reClaim(inherit=true)
  fromBinaryFile: private function(name: !string, fileName: !string, dataset: Dataset): mixing DataImpl.Pandas

  /**
   * Create a new DataImpl.Pandas from a PyAST visitor context.
   * see @DataToPyAstVisitorCtx
   */
  @reClaim(inherit=true)
  fromDataToPyAstVisitorCtx: private function(ctx: !DataToPyAstVisitorCtx, dataset: Dataset): mixing DataImpl.Pandas

  /**
   * Converts this DataImpl to {@link DataToPyAstVisitorCtx} that can be converted to a python AST.
   */
  // TODO: PLAT-46475 - DRY code
  @reClaim(inherit=true)
  toDataToPyAstVisitorCtxEngine: private function(ths: !DataImpl, spec: ToPySrcSpec): !DataToPyAstVisitorCtx

  /**
   * Dispatch a single method on an existing DataImpl.Pandas.
   *
   * @param doNotConvertData
   *         By default, if dispatch returns a pandas object it is converted to an array. If doNotConvertData is true,
   *         The native pandas value will be converted to the corresponding {@link DataImpl.Pandas} subtype
   */
  @reClaim(inherit=true)
  @call(javaThreadAffinity=true)
  dispatch: private function(pandas: !mixing DataImpl.Pandas,
                             name: !string,
                             args: [any],
                             kwargs: map<string, any>,
                             doNotConvertData: boolean): any py-jep

  /**
   * Get the specified attribute from the DataImpl.Pandas. Equivalent to running
   * `getattr(pandas, name)` in python
   * @param doNotConvertData
   *         By default, if dispatch returns a pandas object it is converted to an array. If doNotConvertData is true,
   *         The native pandas value will be converted to the corresponding {@link DataImpl.Pandas} subtype
   */
  @reClaim(inherit=true)
  @call(javaThreadAffinity=true)
  getAttribute: private function(pandas: !mixing DataImpl.Pandas,
                                 name: !string,
                                 doNotConvertData: boolean): any py-jep

  /**
   * Evaluate the dataframe without returning it. Useful for eager evaluation
   * @param pandas
   *        The pandas data to be evaluate
   */
  @reClaim(inherit=true)
  @call(javaThreadAffinity=true)
  evaluate: private function(pandas: !mixing DataImpl.Pandas) py-jep

  /**
   * Return the actual value wrapped by this DataImpl.Pandas
   * If the content converts to a pandas DataFrame, return pickled data frame as binary
   * If the content converts to a pandas Series, return the series as a list
   * Otherwise return the data as is
   */
  @reClaim(inherit=true)
  @call(javaThreadAffinity=true)
  _value: private member function(): any py-jep

  /**
   * Return a serialized representation of the pandas object
   */
  @reClaim(inherit=true)
  @call(javaThreadAffinity=true)
  toBinary: private function(pandas: !mixing DataImpl.Pandas): binary py-jep

  /**
   * Generate a binary representation of this DataImpl.Pandas, segment it into smaller chunks and store them in the
   * parent dataset
   *
   * @param pandas
   *        DataImpl.Pandas object to store binary segments of in a Dataset
   */
  @reClaim(inherit=true)
  @call(javaThreadAffinity=true)
  storeBinariesInDataset: private function(pandas: !mixing DataImpl.Pandas) py-jep

  @reClaim(inherit=true)
  visit: private ~

  @call(javaThreadAffinity=true)
  @reClaim(inherit=true)
  fromPySrc: private ~: mixing DataImpl.Pandas py-jep

  @call(javaThreadAffinity=true)
  @reClaim(inherit=true)
  executePySrc: private ~ py-jep

  @reClaim(inherit=true)
  toJson: ~ py | java | js

  @reClaim(inherit=true)
  toTypedJson: ~ py | java | js

  @reClaim(inherit=true)
  fromJson: ~ py | java | js

  @reClaim(inherit=true)
  cacheKey: private ~

  @reClaim(inherit=true)
  toString: ~

  @reClaim(inherit=true)
  value: ~

  @reClaim(inherit=true)
  concreteId: ~

  @call(javaThreadAffinity=true)
  @reClaim(inherit=true)
  closeDataFrame: private member function() py-jep

  @reClaim(inherit=true)
  supportsMultiNode: private ~

  /**
   * The size of a segment of binary must be small enough to not cause any Invalid Argument exceptions when sent
   * using HTTP, 10309165 is also a convenient number for testing the case when a dataframe divides evenly into
   * segments with no remainder
   */
  // 10.309165MB
  maxSegmentSizeClient: private const int = 10309165

  @reClaim(inherit=true)
  toDataRef: private ~: !DataImpl.Ref

  /**
   * write the binary of this Data to a temporary file
   * @return the path of the temporary file
   */
  @call(javaThreadAffinity=true)
  @reClaim(inherit=true)
  persistDf: private member function(): string py-jep

  /**
   * Read Data from arrow store in py-data_312 runtime.
   * Used internally to handle cross-runtime data loading (PLAT-130855).
   *
   * @param tableName
   *        name of the table for which the data is stored at.
   * @param tableEntryId
   *        id in the table for which the data is stored at.
   * @param local
   *        if True, read persisted data from the local filesystem. Otherwise, read from the remote.
   * @return the Data read from the store.
   */
  _readFromArrowStore: private function(tableName: !string, tableEntryId: !string, local: boolean): Data py-data_312

  /**
   * Read Data from arrow store in py-data runtime (legacy Python 3.9).
   *
   * @param tableName
   *        name of the table for which the data is stored at.
   * @param tableEntryId
   *        id in the table for which the data is stored at.
   * @param local
   *        if True, read persisted data from the local filesystem. Otherwise, read from the remote.
   * @return the Data read from the store.
   */
  _readFromArrowStoreLegacy: private function(tableName: !string, tableEntryId: !string, local: boolean): Data py-data
}
