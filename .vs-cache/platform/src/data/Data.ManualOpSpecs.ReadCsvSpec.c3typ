/**
 * Spec containing parameters for {@link Data#read_csv}.
 *
 *  @see https://pandas.pydata.org/docs/reference/api/pandas.read_csv.html
 */
@beta
type Data.ManualOpSpecs.ReadCsvSpec mixes Data.SourceSpec {

  sep:                   string
  delimiter:             string
  header:                int | [int] | string
  names:                 [string]
  index_col:             int | string | [int] | [string] | boolean
  usecols:               [string]
  dtype:                 string | map<string, string>
  true_values:           [any]
  false_values:          [any]
  skipinitialspace:      boolean
  skiprows:              int | [int]
  skipfooter:            int
  nrows:                 int
  na_values:             string | map<string, string>
  keep_default_na:       boolean
  na_filter:             boolean
  skip_blank_lines:      boolean
  parse_dates:           [string]
  infer_datetime_format: boolean
  keep_date_col:         boolean
  date_parser:           !lambda(e: any): any
  dayfirst:              boolean
  cache_dates:           boolean
  thousands:             string
  decimal:               string
  quotechar:             string
  quoting:               int
  escapechar:            string
  comment:               string
  encoding:              string
  error_bad_lines:       boolean
  warn_bad_lines:        boolean
  on_bad_lines:          string
  delim_whitespace:      boolean
}
