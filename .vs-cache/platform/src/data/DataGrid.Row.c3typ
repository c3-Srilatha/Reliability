/**
 * Contents of each row in a {@link DataGrid}.
 */
type DataGrid.Row {

  /**
   * The 0-based index of this row.
   */
  index: !int

  /**
   * The raw row value.
   */
  source: native

  /**
   * The label to use for the row. This is the formatted version of #labelSource.
   */
  label: !string

  /**
   * The data from which the #label is formatted. This usually is #index, but will be the key for map collections.
   */
  labelSource: ?any

  /**
   * The cells of the table, one per {@link DataGrid.Col}.
   */
  cells: [!DataGrid.Cell]

  /**
   * Extract the printable values from the cells.
   */
  strings: member function(): [string] java | js

  /**
   * Extract the source values from the cells.
   */
  sources: member function(): [any] java | js
}
