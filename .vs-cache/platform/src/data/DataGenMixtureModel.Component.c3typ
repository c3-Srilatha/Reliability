/**
 * A single component of the mixture model. This is a weight plus a vector of _n_ means and an _n_ x _n_ covariance
 * matrix where _n_ is the number of scalar columns used as input.
 */
type DataGenMixtureModel.Component {

  /**
   * weight of this component
   */
  weight: !double

  /**
   * _n_ vector
   */
  means: ![double] schema suffix 'M'

  /**
   * _n_ x _n_ matrix, flattened in row-major order
   */
  covariances: ![double] schema suffix 'COV'
}
