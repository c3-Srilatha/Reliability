/**
 * This abstract {@link DataGrid} implementation is used for concrete implementations that are based on a collection
 * of values. It handles some shared functionality around managing the underlying collection, including buffering
 * streams.
 */
abstract private type DataGrid.CollBase mixes DataGrid {

  /**
   * Get the value type of the collection from which the grid is built.
   */
  collectionType: member function(): !CollectionType java | js

  /**
   * Get whether the the collection from which the grid is built is a map. Maps will use the map keys as the labels
   * instead of row indecies.
   */
  isMap: member function(): boolean java | js

  size:         ~ java | js
  hasMore:      ~ java | js
  loadMore:     ~ java | js
  totalSize:    ~ java | js
  labelCol:     ~ java | js
  labelValues:  ~ java | js
  _coll:        private !Collection<any>
  _stream:      private stream<any>
  _buffer:      private @java(class="ArrayList<c3.platform.typesys.value.Pair<Object, Object>>") native
  _keys:        private [?any]
  _useStream:   private function(coll: Collection<any>): stream<any>
  _initialLoad: private function(coll: Collection<any>, spec: DataGrid.LoadSpec): [any] java | js
  _rowPair:     private member function(index: !int): Pair<any, any> java | js
  _formatLabel: private member function(value: ?any): ?string java | js
}
