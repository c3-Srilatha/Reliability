/**
 * Spec for generating values
 */
type DataGen.ColumnSpec mixes Spec {

  /**
   * Value type of the generated value; default to string
   */
  valueType: ValueType

  /**
   * Histogram of possible values
   */
  histogram: map<any, int>

  /**
   * If generating numbers then spec for value range and distribution
   */
  num: DataGen.NumSpec

  /**
   * Build spec from a file containing possible value histogram
   */
  fromHistogramFile: function(url: !string serialized FileUrl, failIfMissing: boolean): mixing DataGen.ColumnSpec

  /**
   * Build spec from a content containing possible value histogram
   */
  fromHistogramContent: function(content: !Content): !mixing DataGen.ColumnSpec
}
