/**
 * Spec for generating a string value based on a trained Markov chain.
 * The parameter is the order of the Markov chain (the number of characters to consider).
 *
 * @see https://en.wikipedia.org/wiki/Markov_chain
 */
type DataGenMarkov mixes DataGenPrimitive<string>, DataGenTrained<string, int32> {

  /**
   * The default order of the Markov chain (the number of characters to consider).
   */
  DEFAULT_ORDER: const int32 = 3

  /**
   * Range of length of generated string value.
   */
  length: DataGenInt

  /**
   * Number of previous characters to consider, taken from the single parameter. If unspecified, a default value of
   * `3` is used.
   */
  safeOrder: member function(): !int32

  /**
   * Generate a text starting with the specified characters. This should be a generatable initial sequence of
   * characters for this Markov sequence.
   *
   * @param seed random seed
   * @param range length range
   * @param string starting characters in sequence
   *
   * @see nextPrimitive
   */
  nextWithStart: inline member function(seed: !int, range: Range<int>, start: !string): !RndResult<string>

  /**
   * All learned states, keyed by the prior order-length string.
   */
  states: private !?map<string, DataGenMarkov.State> schema suffix 'ST'

  /**
   * Canonicalize the string by trimming and simplifying white space. Strings which are void (empty or contain only
   * spaces) map to null. Non-string values are converted to strings or null if not possible.
   */
  standardize: member function(in: any): string

  /**
   * Get the possible starting characters, in order of likelihood. This will always return a value if the Markov
   * chain has been trained with at least one string. If it has been trained with multiple strings with different
   * initial characters, the string will have one character for each.
   */
  startChars: member function(): string

  /**
   * Whether or not this value type is a string value that can be trained and generated as a Markov chain.
   */
  supports: function(valueType: !ValueType): boolean

  forType: ~: mixing DataGenMarkov
}
