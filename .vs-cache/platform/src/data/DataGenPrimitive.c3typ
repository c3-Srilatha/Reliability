/**
 * Base type for generating primitive values. See {@link Data.generate} & {@link Data.profile}.
 */
abstract private type DataGenPrimitive<P> mixes DataGen<P> {

  /**
   * @return primitive value generator for a value range.
   */
  forRange: inline function(min: !P, max: !P): !mixing DataGenPrimitive

  /**
   * @return primitive value generator for a values from a provided source type (enum or persistable).
   *
   * @see DataValues
   */
  forSourceType: inline function(srcTyp: !Type, srcField: string): !mixing DataGenPrimitive

  /**
   * @return primitive value generator for a values from a provided possible values.
   *
   * @see DataValues
   */
  forValues: inline function(values: ![P], distribution: [int]): !mixing DataGenPrimitive

  /**
   * @return a copy of this generator with possible values.
   */
  withPossibleValues: inline member function(values: ![P], distribution: [int]): !mixing DataGenPrimitive

  /**
   * Range of generated primitive values.
   */
  range: Range<P>

  /**
   * Possible values to pick a candidate from.
   */
  values: DataValues<P>

  primitiveType: private inline function(): !PrimitiveType
  _next:         ~
  nextPrimitive: abstract inline member function(seed: !int, range: Range<P>, prev: P): !RndResult<P>
}
