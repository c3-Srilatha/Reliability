// derived from https://developer.atlassian.com/cloud/confluence/rest/v2/api-group-blog-post/#api-blogposts-get
type ConfluenceBlogPost {

  id:        string
  status:    string
  title:     string
  spaceId:   string
  authorId:  string
  createdAt: string
  version:   json
  body:      json

  @ser(name='_links')
  links: json
}
