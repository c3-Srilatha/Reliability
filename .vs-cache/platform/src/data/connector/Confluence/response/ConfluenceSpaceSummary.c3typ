// derived from https://developer.atlassian.com/cloud/confluence/rest/v2/api-group-page/#api-pages-get
type ConfluenceSpaceSummary {

  id: string

  @ser(name='key')
  spaceKey: string

  @ser(name='name')
  spaceName: string

  @ser(name='type')
  spaceType: string

  status:      string
  authorId:    string
  createdAt:   string
  homepageId:  string
  description: json
  icon:        json

  @ser(name='_links')
  links: json
}
