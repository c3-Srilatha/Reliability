type Confluence mixes REST {

  /**
   * Retrieve all visible pages in a given space.
   * @param id
   *    id of the space
   * @param limit
   *    limit the number of pages returned. Default is 25, Maximum is 250.
   */
  @rest(method='GET', contentType='application/json', acceptType='application/json')
  getPagesBySpace: abstract function(@rest(partOfURI=true, uriPrefix='/spaces/', uriSuffix='/pages')
                                     id: int,
                                     @rest(queryParameter=true)
                                     limit: int): ConfluenceResponse<ConfluencePageSummary>

  /**
   * Retrieve all visible pages.
   * @param id
   *    Filter the results to pages based on their IDs. Multiple IDs can be specified as a comma-separated list.
   * @param sort
   *    Used to sort the result by a particular field. Valid values: id, -id
   * @param limit
   *    limit the number of pages returned. Default is 25, Maximum is 250.
   */
  @rest(method='GET', contentType='application/json', acceptType='application/json', uri='/pages')
  getPages: abstract function(@rest(queryParameter=true)
                              id: string,
                              @rest(queryParameter=true)
                              sort: string,
                              @rest(queryParameter=true)
                              limit: int): ConfluenceResponse<ConfluencePageSummary>

  /**
   * Retrieve a page by its id.
   * @param id
   *    id of the space
   */
  @rest(method='GET', contentType='application/json', acceptType='application/json', uri='/spaces/')
  getSpaceById: abstract function(@rest(partOfURI=true) id: !int): ConfluenceSpaceSummary

  /**
   * Retrieve all visible spaces.
   * @param ids
   *    Filter the results to spaces based on their IDs. Multiple IDs can be specified as a comma-separated list.
   * @param keys
   *    Filter the results to spaces based on their keys. Multiple keys can be specified as a comma-separated list.
   * @param sort
   *    Used to sort the result by a particular field. Valid values: id, -id, key, -key, name, -name
   * @param limit
   *    limit the number of spaces returned. Default is 25, Maximum is 250.
   */
  @rest(method='GET', contentType='application/json', acceptType='application/json', uri='/spaces')
  getSpaces: abstract function(@rest(queryParameter=true)
                               ids: string,
                               @rest(queryParameter=true)
                               keys: string,
                               @rest(queryParameter=true)
                               sort: string,
                               @rest(queryParameter=true)
                               limit: int): ConfluenceResponse<ConfluenceSpaceSummary>

  /**
   * Retrieve all visible attachments.
   * @param filename
   *    Filter the results based on the filename of the attachments
   * @param mediaType
   *    Filter the results based on the mediaType of the attachments
   * @param sort
   *    Used to sort the result by a particular field. Valid values: created-date, modified-date
   * @param limit
   *    limit the number of attachments returned. Default is 50, Maximum is 250.
   */
  @rest(method='GET', contentType='application/json', acceptType='application/json', uri='/attachments')
  getAttachments: abstract function(@rest(queryParameter=true)
                                    filename: string,
                                    @rest(queryParameter=true)
                                    mediaType: string,
                                    @rest(queryParameter=true)
                                    sort: string,
                                    @rest(queryParameter=true)
                                    limit: int): ConfluenceResponse<ConfluenceAttachment>

  /**
   * Retrieve an attachment by its id.
   * @param id
   *    id of the attachment
   */
  @rest(method='GET', contentType='application/json', acceptType='application/json', uri='/attachments/')
  getAttachmentById: abstract function(@rest(partOfURI=true) id: !string): ConfluenceAttachment

  /**
   * Retrieve all visible custom content. This retrieves custom objects like calenders and ignores already defined objects like pages, blogposts, attachments etc.
   * @param type
   *    The type of the content being requested
   * @param id
   *    Filter the results based on custom content ids.
   *    Multiple custom content ids can be specified as a comma-separated list.
   * @param spaceId
   *    Filter the results based on space ids.
   *    Multiple space ids can be specified as a comma-separated list.
   * @param sort
   *    Used to sort the result by a particular field. Valid values: id, created-date, title
   * @param limit
   *    limit the number of custom content returned. Default is 25, Maximum is 250.
   */
  @rest(method='GET', contentType='application/json', acceptType='application/json', uri='/custom-content')
  getCustomContent: abstract function(@rest(queryParameter=true)
                                      type: string,
                                      @rest(queryParameter=true)
                                      spaceId: string,
                                      @rest(queryParameter=true)
                                      id: string,
                                      @rest(queryParameter=true)
                                      sort: string,
                                      @rest(queryParameter=true)
                                      limit: int): ConfluenceResponse<ConfluenceCustomContent>

  /**
   * Retrieve all visible blogposts.
   * @param id
   *    Filter the results based on blogpost ids.
   *    Multiple blogpost ids can be specified as a comma-separated list.
   * @param title
   *    Filter the results based on the title of the blogposts
   * @param sort
   *    Used to sort the result by a particular field. Valid values: id, created-date, modified-date
   * @param limit
   *    limit the number of blogposts returned. Default is 25, Maximum is 250.
   */
  @rest(method='GET', contentType='application/json', acceptType='application/json', uri='/blogposts')
  getBlogPosts: abstract function(@rest(queryParameter=true)
                                  id: string,
                                  @rest(queryParameter=true)
                                  title: string,
                                  @rest(queryParameter=true)
                                  sort: string,
                                  @rest(queryParameter=true)
                                  limit: int): ConfluenceResponse<ConfluenceBlogPost>

  /**
   * Retrieve blogpost by its id.
   * @param id
   *    id of the blogpost
   */
  @rest(method='GET', contentType='application/json', acceptType='application/json', uri='/blogposts/')
  getBlogPostById: abstract function(@rest(partOfURI=true) id: !int): ConfluenceBlogPost

  /**
   * Retrieve all visible labels.
   * @param prefix
   *    Filters on label prefix. Multiple IDs can be specified as a comma-separated list.
   * @param sort
   *    Used to sort the result by a particular field.
   * @param limit
   *    limit the number of labels returned. Default is 25, Maximum is 250.
   */
  @rest(method='GET', contentType='application/json', acceptType='application/json', uri='/labels')
  getLabels: abstract function(@rest(queryParameter=true)
                               prefix: string,
                               @rest(queryParameter=true)
                               sort: string,
                               @rest(queryParameter=true)
                               limit: int): ConfluenceResponse<ConfluenceLabel>

  /**
   * Retrieve pages from a label
   * @param id
   *    id of the label
   * @param limit
   *    limit the number of pages returned. Default is 25, Maximum is 250.
   */
  @rest(method='GET', contentType='application/json', acceptType='application/json')
  getPagesByLabel: abstract function(@rest(partOfURI=true, uriPrefix='/labels/', uriSuffix='/pages')
                                     id: int,
                                     @rest(queryParameter=true)
                                     limit: int): ConfluenceResponse<ConfluencePageSummary>

  /**
   * Retrieve all visible tasks.
   * @param assignedTo
   *    Filter the results based on accountId of the user to whom the task is assigned
   *    Multiple account Ids can be specified as a comma-separated list.
   * @param spaceId
   *    Filter the results based on space ids.
   *    Multiple space ids can be specified as a comma-separated list.
   * @param status
   *    Used to sort the result depending on the status of the task
   * @param limit
   *    limit the number of tasks returned. Default is 25, Maximum is 250.
   */
  @rest(method='GET', contentType='application/json', acceptType='application/json', uri='/tasks')
  getTasks: abstract function(@rest(queryParameter=true)
                              spaceId: string,
                              @rest(queryParameter=true)
                              assignedTo: string,
                              @rest(queryParameter=true)
                              status: string,
                              @rest(queryParameter=true)
                              limit: int): ConfluenceResponse<ConfluenceTask>

  /**
   * Retrieve task by its id.
   * @param id
   *    id of the task
   */
  @rest(method='GET', contentType='application/json', acceptType='application/json', uri='/tasks/')
  getTaskById: abstract function(@rest(partOfURI=true) id: !int): ConfluenceTask

  /**
   * Retrieve attachments from a page
   * @param id
   *    id of the page whose attachments are to be returned
   * @param filename
   *    Filter the results based on the filename of the attachments
   * @param mediaType
   *    Filter the results based on the mediatype of the attachments
   * @param sort
   *    Used to sort the result by a particular field. Valid values: created-date, modified-date
   * @param limit
   *    limit the number of attachments returned. Default is 50, Maximum is 250.
   */
  @rest(method='GET', contentType='application/json', acceptType='application/json')
  getAttachmentsByPage: abstract function(@rest(partOfURI=true, uriPrefix='/pages/', uriSuffix='/attachments')
                                          id: !int,
                                          @rest(queryParameter=true)
                                          filename: string,
                                          @rest(queryParameter=true)
                                          mediaType: string,
                                          @rest(queryParameter=true)
                                          sort: string,
                                          @rest(queryParameter=true)
                                          limit: int): ConfluenceResponse<ConfluenceAttachment>

  /**
   * Retrieve all visible blogposts in a given space.
   * @param id
   *    id of the space
   * @param limit
   *    limit the number of blogposts returned. Default is 25, Maximum is 250.
   */
  @rest(method='GET', contentType='application/json', acceptType='application/json')
  getBlogPostsBySpace: abstract function(@rest(partOfURI=true, uriPrefix='/spaces/', uriSuffix='/blogposts')
                                         id: !int,
                                         @rest(queryParameter=true)
                                         limit: int): ConfluenceResponse<ConfluenceBlogPost>

  /**
   * Retrieve labels from a given page
   * @param id
   *    id of the page
   * @param prefix
   *    Filters on label prefix. Multiple IDs can be specified as a comma-separated list.
   * @param limit
   *    limit the number of labels returned. Default is 25, Maximum is 250.
   */
  @rest(method='GET', contentType='application/json', acceptType='application/json')
  getLabelsByPage: abstract function(@rest(partOfURI=true, uriPrefix='/pages/', uriSuffix='/labels')
                                     id: int,
                                     @rest(queryParameter=true)
                                     prefix: string,
                                     @rest(queryParameter=true)
                                     limit: int): ConfluenceResponse<ConfluenceLabel>

  /**
   * Retrieve labels from a given space
   * @param id
   *    id of the space
   * @param prefix
   *    Filters on label prefix. Multiple IDs can be specified as a comma-separated list.
   * @param limit
   *    limit the number of labels returned. Default is 25, Maximum is 250.
   */
  @rest(method='GET', contentType='application/json', acceptType='application/json')
  getLabelsBySpace: abstract function(@rest(partOfURI=true, uriPrefix='/spaces/', uriSuffix='/labels')
                                      id: int,
                                      @rest(queryParameter=true)
                                      prefix: string,
                                      @rest(queryParameter=true)
                                      limit: int): ConfluenceResponse<ConfluenceLabel>
}
