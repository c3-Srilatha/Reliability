/**
 * Input to DFS methods on {@link FlowGraph}
 */
type FlowGraph.DfsState<C> {

  graph:            !FlowGraph<FlowGraph.Vertex>
  visited:          SetBuilder<string>
  stack:            SetBuilder<string>
  folder:           !lambda(v: !FlowGraph.Vertex, ctx: !C): C
  doNotFailIfCycle: boolean
  topologicalOrder: boolean
  reverse:          boolean
  ctx:              C
  beforeMake:       ~
}
