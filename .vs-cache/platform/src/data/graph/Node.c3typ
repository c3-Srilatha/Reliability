/**
 * this type lets you represent a generic-node in a graph
 */
type Node {

  /**
   * will be populated with id and name
   */
  obj: Obj

  /**
   * information about the role played by the node in the hierarchy
   */
  info: string

  /**
   * children of the node
   */
  children: [Node]
}
