/**
 * This spec is used to figure out which vertices we are interested in counting during a
 * traversal and how much to multiply each edge by.
 *
 * @see LoadGraphSpec#vertexFilter
 * @see LoadGraphSpec#edgeFilter
 * @see LoadGraphSpec#bindings
 * @see TraverseGraphSpec#direction
 * @see TraverseGraphSpec#ignoreCycles
 * @see TraverseGraphSpec#depth
 * @see Graph#collectCounts
 * @see Graph#collectCountsBatch
 */
type CollectCountsSpec mixes TraverseGraphSpec {

  /**
   * When false, always collect terminal counts even if collectVertexFilter is null or evaluates to false.
   * When true, only use collectVertexFilter to determine whether or not to collect.
   *
   * A terminal node a sink node (out-degree 0) if we are traversing in the default TraverseGraphDirection.SINK.
   * If instead we traverse using TraverseGraphDirection.SOURCE, then it is a source node (in-degree 0).
   */
  dontCollectTerminal: boolean

  /**
   * If this filter evaluates true, then collect counts for this node regardless of dontCollectTerminal.
   * If null then always evaluate to false.
   */
  collectVertexFilter: string

  /**
   * An expression that evaluates to the integer weight of this edge.
   * Typically simply the name of an integer field containing the weight of this field.
   * If null or does not evaluate to an integer, then assume edge has weight 1.
   */
  edgeWeightExpr: string serialized Expr
}
