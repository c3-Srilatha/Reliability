enum type TraverseGraphDirection {

  /**
   * Traverse along out edges to neighboring vertices
   */
  SINK = 'sink'

  /**
   * Traverse along in edges from neighboring vertices
   */
  SOURCE = 'source'

  /**
   * Traverse in both directions
   */
  BIDIRECTION = 'biDirection'
}
