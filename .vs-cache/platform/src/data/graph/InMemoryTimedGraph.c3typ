type InMemoryTimedGraph<V, E> mixes TimedGraph<V, E> {

  /**
   * Graph instance
   */
  m_source: private Graph<V, E>

  /**
   * State Changes denoting which vertices were switched on / off in the graph
   * FORMAT: e.g. VERTEX_ID -> List of datetime indicating toggles
   */
  m_vertexTraversabilityChanges: private map<string, [datetime]>
}
