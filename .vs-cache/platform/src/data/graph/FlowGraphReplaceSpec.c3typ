type FlowGraphReplaceSpec mixes Spec {

  /**
   * Map ports of vertices being replaced to the port name of the new vertex.
   * The (key, value) pairs of this map are "oldPortId" -> list of "newPortId", eg:
   * "id3#in2" -> ["id4#in1"].
   * @see FlowGraph.Port
   */
  portReplacementMap: map<string, [string]>
}
