type TraverseGraphSpec mixes LoadGraphSpec {

  /**
   * Specifies the direction during graph traversal
   * The default "sink" will traverse along out edges
   */
  direction: !string enum TraverseGraphDirection = SINK

  /**
   * Specifies if ignore cycles when traversing in the graph
   */
  ignoreCycles: boolean

  /**
   * Limit of the depth when traversing in the graph
   */
  depth: int = -1
}
