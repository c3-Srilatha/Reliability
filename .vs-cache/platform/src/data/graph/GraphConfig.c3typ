/**
 * Type to specify configuration for {@link Graph} processing per {@link Graph} sub-type.
 */
type GraphConfig mixes Config, Singleton {

  /**
   * Disable computation of secondary index on graph loading
   */
  disableSecondaryIndex: boolean

  /**
   * Setting this configuration indicates the graph engine to cache graph in persistence storage rather than in memory
   */
  persistenceCacheEnabled: boolean

  /**
   * If the graph is stored in persistence cache, the location where the files are stored.
   * E.g. s3://c3--env-tenant-tag/myGraphType/
   */
  persistedGraphFilePath: string

  /**
   * Whether to enable FastGraph implementation.
   */
  fastGraphEnabled: boolean
}
