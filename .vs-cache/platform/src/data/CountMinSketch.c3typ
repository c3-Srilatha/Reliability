/**
 * Probabilistic data structure to approximate frequency of elements in stream
 * Note: errors for frequency approximations will be overestimates only
 * For more information, @see [http://theory.stanford.edu/~tim/s15/l/l2.pdf]
 */
// TODO: PLAT-27171 Make CountMinSketch mix Serializable
type CountMinSketch mixes Mutable, Obj, Mergeable<CountMinSketch> {

  /**
   * structures/constants for quickly hashing
   */
  modulo: private !int32

  repeatedHash: private @java(class='c3.platform.data.RepeatedHash') native

  /**
   * Number of elements added to this CountMinSketch
   */
  count: !int

  /**
   * Stores spec set during creation
   */
  spec: private CountMinSketchSpec schema suffix 'CMSS'

  /**
   * Structure that counts frequencies of hits from the hash function, where row i corresponds to the hash function i.
   */
  hashBins: private @java(class='c3.platform.typesys.util.Matrix2DLong') native schema suffix 'SCT'

  /**
   * Custom implementation of a double linked list where the nodes represent elements and their frequencies.
   */
  topKStruct: private @java(class='c3.platform.data.TopK') native schema suffix 'TKEM'

  /**
   * Processes topKStruct into a sorted list of pairs.
   * Takes O(KlogK) time where K is trackTopCount in CountMinSketchSec.
   */
  topK: member function(): map<string, int>

  /**
   * Creates new instance of CountMinSketch which input number of bins and hashes
   */
  create: inline function(value: Stream<any>, spec: CountMinSketchSpec): CountMinSketch

  /**
   * Creates PushStream that feeds into CountMinSketch
   * @param spec
   *       an instance of CountMinSketchSpec containing information for parameters of the CountMinSketch
   *       if no values are set, default CountMinSketchSpec values will be used
   * @return pair of CountMinSketch and PushStream, values added to stream will go into CountMinSketch
   */
  createPushStream: inline function(spec: CountMinSketchSpec): Pair<CountMinSketch, PushStream<any>>

  /**
   * Adds value to CountMinSketch in O(K) time.
   */
  add: private inline member function(value: any): CountMinSketch

  /**
   * Adds stream of values to CountMinSketch
   */
  addStream: private inline member function(value: Stream<any>): CountMinSketch

  /**
   * Returns estimate the number of times the inputted element has been added to the CountMinSketch hashBins
   */
  frequency: member function(value: any): !int
}
