/**
 * C3 Interface to a Data.Pandas
 *
 * @see Data
 */
@beta
native py remix type Data.Pandas {

  fieldValue: ~ py
  to_numpy:   member function(dtype: native, copy: native, na_value: native): native py
  makeHelper: ~: !Data.Pandas py

  /**
   * Convert this Data instance to an numpy 2D array where each row corresponds to a
   * column from the current data instance. This is equivalent to to_numpy().T
   */
  to_numpy_columnar: member function(): native py

  /**
   * Convert this Data instance to an arrow Table
   */
  to_arrow: member function(): native py
}
