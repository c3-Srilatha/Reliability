/**
 * Spec for generating numeric values
 */
type DataGen.NumSpec mixes Spec {

  avgIntDigits:          int32
  stdevIntDigits:        double
  minIntDigits:          int32
  maxIntDigits:          int32
  avgFractionalDigits:   int32
  stdevFractionalDigits: double
  minFractionalDigits:   int32
  maxFractionalDigits:   int32
  percentNegative:       double
  nextStr:               member function(): string
  withDefaults:          ~ java
}
