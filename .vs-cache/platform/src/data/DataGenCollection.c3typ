/**
 * Collection data generator. See {@link Data.generate} & {@link Data.profile}.
 */
abstract private type DataGenCollection<C> mixes DataGen<C> {

  /**
   * Range of the size of the generated collection.
   */
  size: DataGenInt

  /**
   * Custom specs for keys of the generated collection.
   */
  key: DataGen<any>

  /**
   * Custom specs for elements of the generated collection.
   */
  elem: DataGen<any>
}
