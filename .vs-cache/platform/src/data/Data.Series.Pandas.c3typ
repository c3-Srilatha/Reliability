/**
 * C3 Interface to a Data.Series.Pandas backed by native pandas
 *
 * @see Data.Series
 */
// TODO: PLAT-45752 Make Data.Pandas stateless
@beta
private type Data.Series.Pandas mixes Data.Series, DataImpl.Pandas {

  _exec: ~ from DataImpl.Pandas

  @call(javaThreadAffinity=true)
  flatten: ~ py-jep

  toDataPandas: ~
  _repr_:       ~
  collect:      ~
  dataType:     ~
  _length_:     ~
  toDataRef:    ~: !Data.Series.Ref from DataImpl.Pandas
  type:         ~ java
}
