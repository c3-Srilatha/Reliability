/**
 * Specification for how to convert {@link Data} and related types to a {@link Data.Flow} in {@link Data#toDataFlow}
 */
@beta
private type DataToFlowSpec mixes Spec {

  /**
   * If enabled then generated {@link Data.Flow} will replace any previously computed sub-graphs with a
   * {@link Data.Flow.Cached} vertex.
   */
  useCachedData: boolean

  /**
   * If set, then the generated {@link Data.Flow} will not replace non-Data C3 actions producing Data. This must only be
   * used in retrieving the "representative" Data.Flow for Data.
   */
  doNotPreExecuteNonPandasActions: boolean

  /**
   * The dataset in which to look for cached data. Used in conjunction with useCachedData
   */
  dataset: Dataset
}
