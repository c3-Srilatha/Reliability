@beta
type DataSession {

  /**
   * Evaluates one or more projection expressions for multiple obj instances based on a specification. Only objs that
   * the caller is authorized to fetch will be evaluated.
   *
   * @param spec
   *           Specification of projection expressions to evaluate and what objs to evaluate them on.
   * @return Iterator of result row batches in columnar format with column for every projection expression.
   */
  evaluate: function(type: !Type, spec: !EvaluateSpec): ArrowIterator

  /**
   * Evaluates SQL query defined in terms of relational data model built on top of C3 entity types.
   *
   * @param query
   *           SQL query, for example "select id, country, blades from turbines where id = 'TURBINE-1'"
   * @param bindings
   *           Mapping from virtual table names to underlying entity types with sub-set of fields.
   *           Example {"turbines": {"sourceType": "WindTurbine", "columns": ["id", "country", "blades"]}}
   */
  executeQuery: function(query: !string, bindings: map<string, DataSession.TableSpec>): ArrowIterator

  getTableMetadata: function(bindings: map<string, DataSession.TableSpec>): [DataSession.TableMetadata]
}
