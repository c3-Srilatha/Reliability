/**
 * Type to help with the binary ser/deser of a numpy array that does not require any custom logic.
 * Handles both regular and bigendian byte encodings. Can be used when the dtype of a numpy array is not "object"
 */
private type Data.TupleNumpy mixes Data.TupleBase {

  /**
   * Binary serialized numpy array content
   */
  bytes: private binary

  /**
   * Indicates if the binary in the bytes array uses bigendian encoding which affects deserialization
   */
  bigendian: boolean

  /**
   * dtype of the serialized numpy array
   */
  dtype: !string

  /**
   * Indicates if the values contain c3.TimeRange values that need to be converted to pd interval
   */
  isTimeRange: boolean

  to_binary: ~
}
