@beta
native py remix type DataImpl {

  /**
   * Converts to native `pandas.DataFrame` format.
   *
   * Currently, if all data does not fit in memory, it will crash the client.
   *
   * Example usage:
   * ```py
   * >>> df = pd.DataFrame({"a" : [1, 2, 3, 4],
   * ...                    "b" : [10, 20, 30, 40],
   * ...                    "c" : ["foo", "bar", "foo", "baz"],
   * ...                    "d" : pd.date_range('2021-01-01', freq='1d', periods=4)})
   * >>> dt = c3.Data.from_pandas(df)
   * >>> dt.to_pandas()
   *    a   b    c          d
   * 0  1  10  foo 2021-01-01
   * 1  2  20  bar 2021-01-02
   * 2  3  30  foo 2021-01-03
   * 3  4  40  baz 2021-01-04
   *
   * >>> type(dt.to_pandas())
   * pandas.core.frame.DataFrame
   * ```
   *
   * @return converted instance of Pandas DataFrame
   */
  to_pandas: abstract member function(): native py

  /**
   * Constructor of a {@link Data} from a python-native `pandas.DataFrame`.
   *
   * Example usage:
   * ```py
   * >>> df = pd.DataFrame({"a" : [1, 2, 3, 4],
   * ...                    "b" : [10, 20, 30, 40],
   * ...                    "c" : ["foo", "bar", "foo", "baz"],
   * ...                    "d" : pd.date_range('2021-01-01', freq='1d', periods=4)})
   * >>> dt = c3.Data.from_pandas(df)
   * >>> dt
   *    a   b    c          d
   * 0  1  10  foo 2021-01-01
   * 1  2  20  bar 2021-01-02
   * 2  3  30  foo 2021-01-03
   * 3  4  40  baz 2021-01-04
   *
   * >>> type(dt)
   * DataRef
   * ```
   *
   * NOTE: this method is deprecated and will be removed in a future release. In general, you should use Pandas directly
   * rather than calling **Data.from_pandas**, except when using {@link Data.Persisted#from_pandas} in {@link MlPipe MlPipes}.
   *
   * @param dataframe
   *           the `pandas.DataFrame` native object.
   * @return {@link Data} representing the given data frame.
   */
  @deprecated(finalVersion="8.8", details="This method will be removed in future releases.")
  from_pandas: function(pandas: !native, dataset_id: string, name: string): mixing DataImpl py

  /**
   * Construct the exception message for Data execution modes in python
   *
   * Example exception format:
   * ```py
   * RuntimeError: Error invoking py-py4j-modin-resolved method Data.Modin#fromPySrc: ModinOnRayException:
   * ---------------------------------------     error summary    ---------------------------------------
   * ValueError:No axis named 10 for object type DataFrame
   * ---------------------------------------      failing api     ---------------------------------------
   *               tmp_df0 = _convert(modin_dataframe_4fc3626e_dd4b_11ec_9e35_aa665a4da34c.groupby(as_index=True, by='manufacturer', group_keys=True, sort=True, dropna=True, observed=False))
   *               tmp_df1 = _convert(tmp_df0.min())
   *               tmp_df2 = _convert(tmp_df1.sum())
   * --> <lineno>  tmp_df3 = _convert(modin_dataframe.sum(axis=10))
   * For complete pySrc, run print(<dataframe>.toPySrc())
   * ---------------------------------------   modin/pandas exceptions   ---------------------------------------
   * <Original Modin/Pandas exception stacktrace>
   * ---------------------------------------   server callstack   ---------------------------------------
   * <C3 python callstack>
   * ```
   *
   * @param ex
   *    Exception instance
   * @param ex_frame
   *    Top frame of the exception stack
   * @param ex_stack
   *    String repr of the original exception stack
   * @param pattern
   *    String snippet to extract the line number of the failing pySrc api,
   *    'File "<string>", line ' for Modin, "file '<string>', line " for Pandas
   * @param pySrc
   *    The entire pySrc code
   * @return: Customized exception message for different Exceptions, i.e. ModinOnRayException, PandasException
   */
  dataException: private function(ex: native,
                                  ex_frame: native,
                                  ex_stack: native,
                                  pattern: string,
                                  pySrc: string): string py

  /**
   * Annotation to enable the cProfiling of one python function.
   * This function only works if {@link Data#cprofileEnabled} is set to true, which can be done by running `c3.Data.seCprofileEnabled(True)`
   * This also prints the memory usage of the func.
   */
  profile: private function(func: !native): native py

  /**
   * Converts to native `polars.DataFrame` format.
   * See https://pola-rs.github.io/polars/py-polars/html/reference/dataframe/index.html
   *
   * @param rechunk
   *           if true, make all data contiguous in memory
   * @param nan_to_null
   *           if true, convert NaN to None
   * @param schema_overrides
   *           map of column names to native polars datatypes
   * @param include_index
   *           if true, include the index column(s) in the polars dataframe
   * @return converted instance of Polars DataFrame
   */
  to_polars: abstract member function(rechunk: boolean = true,
                                      nan_to_null: boolean = true,
                                      schema_overrides: map<string, native>,
                                      include_index: boolean): native py

  /**
   * Constructor of a {@link Data} from a python-native `polars.DataFrame`.
   * See https://pola-rs.github.io/polars/py-polars/html/reference/dataframe/api/polars.DataFrame.to_pandas.html
   * Arguments in kwargs will be sent to pyarrow.Table.to_pandas()
   *
   * @param polars
   *           the `polars.DataFrame` native object.
   * @param dataset_id
   *           the id of the dataset
   * @param name
   *           name of the pandas dataframe on the server
   * @param use_pyarrow_extension_array
   *           if true, create the pandas dataframe backed by pyarrow extension, else numpy array
   * @param use_pyarrow_extension_array
   *           the id of the dataset
   * @param index_keys
   *           the single column key or list of keys corresponding to the indices of the dataframe
   * @param kwargs
   *           additional arguments to be sent to pyarrow.Table.to_pandas()
   * @return {@link Data} representing the given dataframe.
   */
  from_polars: function(polars: !native,
                        dataset_id: string,
                        name: string,
                        use_pyarrow_extension_array: boolean,
                        index_keys: ?any,
                        kwargs: map<string, native>): mixing DataImpl py

  /**
   * Converts to native `pandas.DataFrame` using pyarrow library. If pyarrow is not in the user runtime or if the some
   * fields in this Data instance are not supported by {@link Arrow}, this function will return null.
   * @see ArrowIterator
   */
  @call(stayInEngine=true)
  to_pandas_by_arrow: private member function(): native py
}
