/**
 * Spec to be used in {@link Data.FeatureSet#sliceStream}.
 */
@beta
type Data.FeatureSet.StreamSpec mixes Data.StreamSpec {

  /**
   * Override the number of subjects in each Data.FeatureSet slice.
   */
  maxSubjectPerSlice: private int = 1000

  /**
   * Average rows(number of timestamps) corresponding to each subject.
   */
  // TODO: PLAT-61644 Implement Feature.Meta and Feature.Meta.Store and move this field
  avgRowsPerSubject: private int = 365

  /**
   * Average bytes in one cell in a DataFrame.
   */
  // TODO: PLAT-61644 Implement Feature.Meta and Feature.Meta.Store and move this field
  bytesPerCell: private int = 8
}
