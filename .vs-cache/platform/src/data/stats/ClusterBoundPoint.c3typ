@db(datastore="kv",
    partitionKeyField='parent',
    persistenceOrder='start,end',
    persistDuplicates=false,
    shortId=true,
    shortIdReservationRange=100000)
entity type ClusterBoundPoint mixes IntervalDataPoint<ClusterBoundSeries> schema name 'stats_ClusterBoundPoint' {

  @ts(unitPath='parent.unitConstraint', treatmentPath='parent.treatment')
  upperValue: double

  @ts(unitPath='parent.unitConstraint', treatmentPath='parent.treatment')
  lowerValue: double
}
