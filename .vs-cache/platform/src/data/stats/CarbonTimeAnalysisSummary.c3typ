type CarbonTimeAnalysisSummary {

  /**
   * Number of points in the guessed grain
   */
  mostFrequentBucketCount: int

  guessedGrain: string

  /**
   * Effective range is calculated this way:
   *
   * if date range is specified (!=null) and LeadingandTrailingGaps == true then effective range is range
   *
   * else if range is specified and trailingGaps==false then it is intersection of TS range with the date range
   *
   * else it is TS range
   */
  effectiveStart: datetime

  effectiveEnd: datetime

  /**
   * total length of gap in seconds
   */
  nonCoveredTime: int

  /**
   * Percentage of effective range not covered by TS intervals
   */
  effectiveNonCoveredRange: double

  /**
   * Non-covered range: it is percentage of time series range (without imposed time range) not covered by TS intervals
   */
  nonCoveredRange: double

  /**
   * Number of gaps in the guessed grain
   */
  countGapIntervals: double

  /**
   * Number of points
   */
  initRecordCount: int

  outliers: [CarbonSuspiciousPoint]
}
