/**
 * Result row returned {@link DbAdmin.getTableUsageStats}.
 */
type DbAdmin.GetTableUsageStatsResult {

  /**
   * Schema name.
   */
  schemaName: string

  /**
   * Table name.
   */
  tableName: string

  /**
   * Number of sequential scans initiated on this table.
   */
  numSeqScans: double

  /**
   * Number of live rows fetched by sequential scans.
   */
  numSeqTupFetched: double

  /**
   * Number of index scans initiated on this index.
   */
  numIndexScans: double

  /**
   * Number of live rows fetched by index scans.
   */
  numTupFetched: double

  /**
   * Number of rows inserted.
   */
  numTupIns: double

  /**
   * Number of rows updated.
   */
  numTupUpd: double

  /**
   * Number of rows deleted.
   */
  numTupDel: double

  /**
   * Number of rows HOT updated (i.e., with no separate index update required).
   */
  numTupHotUpd: double

  /**
   * Estimated number of live rows.
   */
  numLiveTup: double

  /**
   * Estimated number of dead rows.
   */
  numDeadTup: double

  /**
   * Number of disk blocks read from this table.
   */
  numHeapBlksRead: double

  /**
   * Number of buffer hits in this table.
   */
  numHeapBlksHit: double

  /**
   * Number of disk blocks read from all indexes on this table.
   */
  numIndxBlksRead: double

  /**
   * Number of buffer hits in all indexes on this table.
   */
  numIndxBlksHit: double

  /**
   * Number of disk blocks read from this table's TOAST table (if any).
   */
  numToastBlksRead: double

  /**
   * Number of buffer hits in this table's TOAST table (if any).
   */
  numToastBlksHit: double

  /**
   * Number of disk blocks read from this table's TOAST table index (if any).
   */
  numToastIndxBlksRead: double

  /**
   * Number of buffer hits in this table's TOAST table index (if any).
   */
  numToastIndxBlksHit: double
}
