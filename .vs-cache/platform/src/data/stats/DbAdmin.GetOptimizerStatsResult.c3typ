/**
 * Result row returned from various functions that return optimizer statistics information (e.g.
 * {@link DbAdmin.getTableOptimizerStats}).
 */
type DbAdmin.GetOptimizerStatsResult {

  /**
   * Index name.
   */
  indexName: string

  /**
   * Table name.
   */
  tableName: string

  /**
   * Type of object.
   */
  objectType: string

  /**
   * Number of rows.
   */
  numRows: decimal

  /**
   * Number of blocks.
   */
  numBlocks: decimal

  /**
   * Number of empty blocks.
   */
  numEmptyBlocks: decimal

  /**
   * Average row length.
   */
  avgRowLen: decimal

  /**
   * Sample size.
   */
  sampleSize: decimal

  /**
   * Statistics locked state.
   */
  statTypeLocked: string

  /**
   * Stale statistics state.
   */
  staleStats: string

  /**
   * Time last analyze was performed.
   */
  lastAnalyzed: datetime
}
