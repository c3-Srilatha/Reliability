/**
 * Represents statistics of currently active instances of a given type
 */
type ObjTrackingStats {

  /**
   * Type of instances
   */
  objType: !Type

  /**
   * Count of allocated instances
   */
  allocatedCount: !int

  /**
   * Count of retained instances
   */
  retainedCount: !int

  /**
   * Retained instances
   */
  retained: member function(filter: string, offset: int = 0, limit: int = 2000): stream<Obj>

  /**
   * @return stats for a given type
   */
  forType: function(type: !Type): !ObjTrackingStats

  /**
   * @return stats for a given server node (default is current node) and optional type
   */
  forServer: function(nodeId: string, typeRef: Type): map<string, ObjTrackingStats>
}
