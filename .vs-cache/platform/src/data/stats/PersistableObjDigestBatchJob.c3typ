/**
 * Batch job to process files in a distributed mode to store {@link PersistableObjDigest} to summarize a source.
 */
entity type PersistableObjDigestBatchJob extends BatchJob<PersistableObjDigestBatchJob, string, FileSystemBatchJobBatch> type key 'PODBJ' {

  /**
   * Spec defining additional parameters for the PersistableObjDigestBatchJob
   */
  spec: PersistableObjDigestBatchJobSpec schema name 'SPEC'

  /**
   * Function to merge all PersistableObjDigests which will be invoked when all the batches that were scheduled
   * have successfully finished processing.  Will not be called if the job fails.
   */
  allComplete: ~

  /**
   * Function to fetch ObjDigest from database. Job must be completed for summary to be returned.
   */
  fetchResults: member function(): PersistableObjDigest
}
