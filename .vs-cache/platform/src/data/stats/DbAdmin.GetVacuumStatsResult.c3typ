/**
 * Result row returned from {@link DbAdming.getVacuumStats}.
 */
type DbAdmin.GetVacuumStatsResult {

  /**
   * Schema name.
   */
  schemaName: string

  /**
   * Table name.
   */
  tableName: string

  /**
   * Number of live tuples.
   */
  numLiveTuples: double

  /**
   * Number of dead tuples.  An excessive number relative to {@link numLiveTuples} may indicate that vacuuming is
   * recommended for the table.
   */
  numDeadTuples: double

  /**
   * Number of times the table has been manually vacuumed.
   */
  vacuumCount: double

  /**
   * Last time the table was manually vacuumed.
   */
  lastVacuum: datetime

  /**
   * Number of times the table has been auto vacuumed.
   */
  autoVacuumCount: double

  /**
   * Last time the table was auto vacuumed.
   */
  lastAutoVacuum: datetime

  /**
   * Fragmentation of data in the postgres table as a percentage number in the range [0, 100]
   */
  fragmentationPct: int
}
