type ClusterStats<M> {

  sources:          [M](cluster)
  centerSeries:     ClusterCenterSeries
  innerBoundSeries: ClusterBoundSeries
  outerBoundSeries: ClusterBoundSeries
  timeRangeStart:   datetime
  timeRangeEnd:     datetime
  grain:            string enum('HOUR', 'DAY')

  /**
   * number of objects in the cluster
   */
  count: int

  /**
   * eg 'usageData', 'buildingType'
   */
  clusterCategories: string

  geographicClusterCenterLatitude:  double
  geographicClusterCenterLongitude: double
}
