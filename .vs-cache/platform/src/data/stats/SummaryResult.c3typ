type SummaryResult {

  /**
   * number of processed points in the time series
   */
  count: int

  /**
   * percentage(!) of effective range covered by TS intervals
   *
   * Effective range is calculated this way:
   *
   * if date range is specified (!=null) and LeadingandTrailingGaps == true then effective range is range
   *
   * else if range is specified and trailingGaps==false then it is intersection of TS range with the date range
   *
   * else it is TS range
   */
  coverage: double

  numberOfTimeGaps:      int
  effectiveRangeStart:   datetime
  effectiveRangeEnd:     datetime
  attributeCompleteness: map<string, AttributeCompleteness>
}
