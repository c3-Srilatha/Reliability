/**
 * Summary of usage behavior
 */
@db(datastore="kv")
type UsageSummary<M> schema name 'stats_UsageSummary' {

  /**
   * Could be Meter or any other device
   */
  object: M

  /**
   * parametersValues for the hour of the week - 24 * 7 values
   */
  coeffs: [double]

  /**
   * heating coefficient and cooling coefficient for work and non work hours
   * 0 - hWork, 1 - hNonWork, 2 - cWork, 3 - cNonWork
   * cWork, cNonWork will be 0 for models that don't requires cooling (eg. NaturalGasConsumption)
   */
  heatingCoolingCoeffs: [double]

  r2: double

  /**
   * start of time range
   */
  timeRangeStart: datetime

  /**
   * end of time range
   */
  timeRangeEnd: datetime
}
