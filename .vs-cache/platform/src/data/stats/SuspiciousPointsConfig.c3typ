type SuspiciousPointsConfig {

  includeTimeGaps:             boolean = true
  ignoreOutlierFlag:           boolean = false
  ignoreEstimates:             boolean = false
  maxNumberOfSuspiciousPoints: int = 100
  timeLimitInSeconds:          int = 15
  degreeOfParallelism:         int = 5

  /**
   * Once we can access the UI annotation from the server, we can add grouping for these
   *
   * value outlier tuning parameters
   */
  nullValueAnalysis: boolean = true

  analysisLevel:        int = 2
  wingSpan:             double = 1
  nearNeighbours:       int = 3
  neighbourWidthFactor: double = 1

  /**
   * time analysis tuning parameters
   */
  overlapPercent: double = 0.001

  includeLeadingAndTrailingGaps: boolean = true

  /**
   * flavors of analysis to perform
   */
  lowEndOutliers: boolean = true

  upperEndOutliers: boolean = true
  digestConfig:     DigestConfig
  interval:         boolean
}
