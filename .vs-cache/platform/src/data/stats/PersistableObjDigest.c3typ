/**
 * Datatype to store ObjDigest in Database.
 * use C3Viz(PersistableObjDigest) to get best results
 * See {@ link ObjDigest} for more information on how to interpret results.
 */
entity type PersistableObjDigest mixes ObjDigest schema name 'PDS' {

  fieldStats: ~ schema suffix 'FS'

  /**
   * denotes source collection where ObjDigest came from. If the PersistableObjDigest summarizes entire
   * SourceCollection, field will be null, and id of SourceCollection will match id of PersistableObjDigest
   */
  partition: string

  /**
   * Generates a PersistableObjDigestBatchJob from URL or encoded path. Job will store PersistableObjDigest
   * in database, which will summarize data at the URL or encoded path.
   */
  fromUrlOrEncodedPath: final function(urlOrEncodedPath: string,
                                       spec: PersistableObjDigestBatchJobSpec): PersistableObjDigestBatchJob
}
