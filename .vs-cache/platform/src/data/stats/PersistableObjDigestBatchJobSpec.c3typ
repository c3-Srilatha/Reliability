/**
 * Spec for PersistableObjDigestBatchJob
 */
type PersistableObjDigestBatchJobSpec mixes FileObjDigestSpec {

  /**
   * Indicated the type of object being read. Set automatically from FileSourceCollection source field.
   */
  @deprecated(finalVersion='v7.13', details='use serType instead')
  sourceType: Type

  /**
   * Serves as generic identifier for where the data is coming from. For FileSourceCollection, will be url.
   */
  identifier: string

  /**
   * Number of files in each batch job.
   */
  batchSize: int = 1

  /**
   * Default priority for job.
   */
  priority: int

  /**
   * returns an instance of FileObjDigestSpec
   */
  fileObjDigestSpec: member function(): FileObjDigestSpec
}
