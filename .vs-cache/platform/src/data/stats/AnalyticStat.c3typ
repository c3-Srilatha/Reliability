entity type AnalyticStat schema name 'STATS_ANALSTAT' {

  aggregatedMetric: !Type
  percentile25th:   !double
  median:           !double
  percentile75th:   !double
  stDev:            !double
  mean:             !double
  count:            !int
  date:             !datetime
  days:             !int

  /**
   * Generates mean and standard deviation based on spec and persists results to AnalyticStat
   */
  computeStats: function(spec: AnalyticStatSpec)

  computeStat: function(sourceType: Type, date: datetime, days: int)
}
