/**
 * Result row returned {@link DbAdmin.getIndexUsageStats}.
 */
type DbAdmin.GetIndexUsageStatsResult {

  /**
   * Schema name.
   */
  schemaName: string

  /**
   * Index name.
   */
  indexName: string

  /**
   * Table name.
   */
  tableName: string

  /**
   * Number of index scans initiated on this index.
   */
  numIndexScans: double

  /**
   * Number of index entries returned by scans on this index.
   */
  numTuplesRead: double

  /**
   * Number of live table rows fetched by simple index scans using this index.
   */
  numTuplesFetched: double

  /**
   * Number of disk blocks read from this index.
   */
  numBlksRead: double

  /**
   * Number of buffer hits in this index.
   */
  numBlksHit: double
}
