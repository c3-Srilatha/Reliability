/**
 * Result row returned from {@link DbAdming.getAnalyzeStats}.
 */
type DbAdmin.GetAnalyzeStatsResult {

  /**
   * Schema name.
   */
  schemaName: string

  /**
   * Table name.
   */
  tableName: string

  /**
   * Number of live tuples.
   */
  numLiveTuples: double

  /**
   * Number of dead tuples.  An excessive number relative to {@link numLiveTuples} may indicate that vacuuming is
   * recommended for the table.
   */
  numDeadTuples: double

  /**
   * Number of times the table has been manually analyzed.
   */
  analyzeCount: double

  /**
   * Last time the table was manually analyzed.
   */
  lastAnalyze: datetime

  /**
   * Number of times the table has been auto analyzed.
   */
  autoAnalyzeCount: double

  /**
   * Last time the table was auto analyzed.
   */
  lastAutoAnalyze: datetime
}
