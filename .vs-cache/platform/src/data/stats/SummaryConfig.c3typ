type SummaryConfig {

  /**
   * if two intervals overlap less than the allowedTimeOverlap percentage, do not count it as overlap
   *
   * time analysis tuning parameters
   */
  overlapPercent: double = 0.001

  includeLeadingAndTrailingGaps: boolean = true
  ignoreEstimates:               boolean = true
  interval:                      boolean
}
