/**
 * This implementation of {@link DataGrid} "flattens" or denormalizes an {@link Obj} or {@link Tuple} into multiple
 * rows. Each field becomes a column and for collections there are additional rows for each element.
 *
 * This creates a 2D representation of a fundamentally non-rectangular shaped data structure, so there will be cells
 * which don't actually exist but are necessary to "fill in" the grid.
 */
type DataGrid.Flattened mixes DataGrid {

  /**
   * Flatten the specified {@link Obj} instance. Each field becomes a column and if that field is a collection,
   * each element becomes a row.
   */
  fromObj: function(obj: !Obj, spec: DataGrid.LoadSpec): !DataGrid.Flattened java | js

  /**
   * Flatten the specified {@link Tuple tuple} instance. Each field becomes a column and if that field is a collection,
   * each element becomes a row.
   */
  fromTuple: function(tuple: !tuple, spec: DataGrid.LoadSpec): !DataGrid.Flattened java | js

  /**
   * Determine whether there are any collection fields in this Obj which would result in multiple rows when flattened.
   * Otherwise, there is little point in using this representation.
   */
  canFlatten: function(obj: !?Obj): boolean java | js

  /**
   * Determine whether there are any collection fields in this tuple which would result in multiple rows when
   * flattened. Otherwise, there is little point in using this representation.
   */
  canFlatten: function(tuple: !?tuple): boolean java | js

  row:       ~ java | js
  hasMore:   ~ java | js
  loadMore:  ~ java | js
  size:      ~ java | js
  totalSize: ~ java | js
  _buffer:   private @java(class="ArrayList<ArrayList<c3.platform.typesys.value.Pair<Object, Boolean>>>") ?native
}
