type Anonymizable {

  /**
   * The function can be overloaded to enable 'custom' anonymization on specific types. This function (and all overloads)
   * should only return category that are enumerated in AnonymizationCategory ('address', 'name', 'phone', 'dob' or
   * 'email'). Returning null in an overloaded function will have the effect of skipping anonymization for that object.
   * @param category
   *          The category for the field
   * @return Custom category
   */
  @action(group+='read')
  anonymizationCategory: member function(category: string): string enum AnonymizationCategory
}
