/**
 * Annotations which provide functionality surrounding {@link Data} or {@link Data.Series} APIs
 */
@annotation(appliesTo=['function', 'valueType'])
type Ann.Pandas mixes Annotation {

  /**
   * Indicates that a generated Pandas method can possibly return a DataImpl subtype.
   * Useful in the case when the return type of a function is `any` and one of the possible
   * return types is a {@link Data} or {@link Data.Series}
   */
  canReturnData: boolean

  /**
   * Indicates that this function is not a native pandas function and should be dispatched with c3 instead
   */
  isNotPandasDispatchable: boolean

  /**
   * Indicates that this function mutates the underlying data
   */
  isMutable: boolean
}
