/**
 * Specification of the options/parameters for the {@link Persistable#generateData} function.
 */
type GenerateDataSpec mixes UpsertSpec {

  /**
   * Relative number of objects to generate.
   */
  cardinality: int = 1

  /**
   * Spec describing random data generation options; only one of randomData or carbon parameters can be present.
   */
  randomData: RandomDataSpec | RandomTimeseriesDataSpec

  /**
   * Carbon code that generates data; only one of randomData or carbon parameters can be present.
   */
  carbon: string
}
