/**
 * The Tag.generateTag action submits a new batch job each time, with a batch for each type to be generated.
 */
entity type TagGenerator extends BatchJob<TagGenerator, GenerateTagSpec, TypeGeneratorBatch> type key 'TAGDGEN' {

  generateStatus: GenerateTagStatus schema suffix 'GTS'
}
