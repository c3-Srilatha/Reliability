/**
 * Waveform with provided shape, amplitude, frequency and phase used in {@link TimeseriesDataSpec.components}.
 */
type WaveformSpec mixes Spec {

  /**
   * Kind of waveform.
   */
  kind: string enum('sine', 'square', 'triangle', 'sawtooth') = 'sine'

  /**
   * Amplitude.
   */
  amplitude: double

  /**
   * Frequency.
   */
  frequency: double

  /**
   * Phase.
   */
  phase: double
}
