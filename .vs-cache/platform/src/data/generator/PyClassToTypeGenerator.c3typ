/**
 * Convert a native python class to a C3 TypeMeta
 */
private type PyClassToTypeGenerator {

  /**
   * Generates a TypeMeta for the given python class
   * @param class
   *         native python class
   * @param parentPyClass
   *         the native python class corresponding to the parent type used as a fall back when source documentation is
   *         not found for a property or function declaration
   * @param spec
   *         the spec that contains additional information needed to generate the type
   * @return {@link TypeMeta} for to the newly created type
   */
  generateTypeMetaFromPyClass: function(pyClass: !native,
                                        parentPyClass: native,
                                        spec: PyClassToTypeGeneratorSpec): !TypeMeta py

  /**
   * Generates a TypeMeta for the given python class
   * @param class
   *         native python class
   * @param templateString
   *        the template string used for creating the basic type and add new methods in the final output
   * @param spec
   *         the spec that contains additional information needed to generate the type
   * @return {@link TypeMeta} for to the newly created type
   */
  generateTypeFromTemplate: function(pyClass: !native,
                                     templateString: !string,
                                     spec: PyClassToTypeGeneratorSpec): !TypeMeta py

  /**
   * Given a python type hint, return the corresponding C3 ValueType
   */
  typeForHint: function(hint: !PyAst.Expr2, spec: PyClassToTypeGeneratorSpec): !ValueType

  /**
   * Generate a DeclaredFieldType that corresponds to an individual python method
   */
  generateDeclaredFieldTypeFromFunction: function(functionName: !string,
                                                  args: PyAst.Arguments,
                                                  returns: PyAst.Expr2,
                                                  spec: PyClassToTypeGeneratorSpec): !DeclaredFieldType
}
