entity type GenerateTagSpec schema name 'METADATA_GENTAGSPC' {

  /**
   * the tag from which the profile was produced
   */
  sourceTag: Tag

  /**
   * all types profiled, Obj is GenerateDataSpec (as XML)
   */
  types: map<string, Obj> schema name 'TYP'

  /**
   * longer description of the circumstances/source data profiled
   */
  description: string

  /**
   * multiplier of the profiled data cardinality
   */
  cardinalityScale: double = 1.0

  /**
   * label for identifying this profile
   */
  name: !~
}
