type GenerateTagStatus {

  /**
   * the primary key prefix for all generated entities
   */
  idPrefix: string

  /**
   * per-type GenerateDataSpec (as XML)
   */
  types: map<string, Obj> schema name 'TYP'

  /**
   * multiplier of the profiled data cardinality
   */
  cardinalityScale: double

  /**
   * the batch job which performs the actual generation
   */
  jobId: string
}
