/**
 * Timeseries begins with start value and each consecutive data point value is incremented by height.  Used in {@link TimeseriesDataSpec.components}.
 */
type StepSpec mixes Spec {

  /**
   * Starting value for timeseries.
   */
  start: double

  /**
   * Amount to increment each timeseries data point with.
   */
  height: double
}
