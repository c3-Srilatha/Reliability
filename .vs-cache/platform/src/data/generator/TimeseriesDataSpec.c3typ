/**
 * Specification for creating random data for timeseries field in {@link Persistable#generateData}.
 *
 * @see RandomTimeseriesDataSpec
 */
type TimeseriesDataSpec mixes Spec {

  /**
   * One or more components of generated data. Final timeseries is basically a vector sum of all of it's components.
   * If any of the parameter in individual specs is not specified it will be picked randomly from 0..1 range.
   */
  components: [WaveformSpec | GaussianSpec | StepSpec | FlatSpec | DatePartSpec]

  /**
   * List of possible values. If specified then components param is ignored.
   */
  possibleValues: [string]

  /**
   * Unit id for ts data point.
   */
  unit: string

  /**
   * Carbon code that generates timeseries data. If specified then the rest of the parameters are ignored.
   */
  carbon: string
}
