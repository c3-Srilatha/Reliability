// Managed table in Iceberg format.
@beta
entity type DataLake.Table.Managed.Iceberg extends DataLake.Table.Managed<DataLake.Table.Snapshot.Iceberg> type key 'IBG' {

  _catalog:          private @java(class='org.apache.iceberg.catalog.Catalog') native
  _table:            private @java(class='org.apache.iceberg.catalog.Catalog') native
  tableName:         !string
  readArrowIterator: ~
  readPartitions:    ~
  readAsTuples:      ~
  importCsv:         ~
  importCsvJob:      ~
  exportCsv:         ~
  setMetaFields:     ~: DataLake.Table.Managed.Iceberg
  getMetaFields:     ~

  /**
   * Returns content of the table as Pandas dataframe.
   */
  read_pandas: member function(): native py

  expireSnapshots: ~
}
