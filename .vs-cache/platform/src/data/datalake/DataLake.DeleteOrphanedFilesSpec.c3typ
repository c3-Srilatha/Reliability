type DataLake.DeleteOrphanedFilesSpec mixes Spec {

  /**
   * Only orphaned files older than this value will be deleted. Only precision up to milliseconds is supported.
   * This value must be older than 24 hours in the past.
   */
  olderThan: datetime with millis

  /**
   * Maximum number of orphaned file locations to return in the result.
   */
  limit: int32 = 100
}
