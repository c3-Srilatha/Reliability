// Catalog for managing data lake tables in Iceberg format.
@beta
type DataLake.Catalog.Iceberg mixes DataLake.Catalog<DataLake.Table.Managed.Iceberg, DataLake.Catalog.Config.Iceberg> {

  /**
   * Returns catalog data location url.
   */
  location: property(): !string serialized Url

  catalog:                private cached member function(): @java(class='org.apache.iceberg.catalog.Catalog') native
  tables:                 ~
  table:                  ~
  deleteTable:            ~
  createTable:            ~
  transferTableOwnership: ~
}
