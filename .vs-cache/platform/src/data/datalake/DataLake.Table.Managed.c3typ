/*
 * Base class for all managed DataLake tables. Managed tables are created through {@link DataLake.Catalog} methods and
 * persisted in C3 storage layer.
 */
@beta
abstract extendable entity type DataLake.Table.Managed<S: DataLake.Table.Snapshot> mixes DataLake.Table<S>, DisclosureReviewAclEntity, AclEnabled schema name 'LAKE_TABLE' {

  metaFieldsValues: private [DataLake.Table.MetaFieldValue](table)

  /**
   * Current meta fields version. Each time meta fields are updated version is incremented.
   */
  currentMetaFieldsVersion: int32

  /**
   * The current version of metadata fields and values.
   */
  currentMetaFieldValues: map<string, any>

  /**
   * Sets new values of table meta fields.
   */
  @action(group='write')
  setMetaFields: abstract member function(metaFieldValues: map<string, any>): DataLake.Table.Managed<S>

  /**
   * Return values of meta fields for given meta fields version.
   */
  @action(group='read')
  getMetaFields: abstract member function(version: int32): map<string, any>

  /**
   * Sets a new description for the {@link DataLake.Table.Managed.Iceberg}
   */
  @action(group='write')
  setDescription: member function(description: string): DataLake.Table.Managed<S>
}
