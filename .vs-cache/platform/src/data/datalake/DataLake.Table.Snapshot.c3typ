// Snapshots are created when data in the table is changed and are immutable.
@beta
abstract type DataLake.Table.Snapshot {

  /**
   * snapshot id
   */
  snapshotId: !string

  /**
   * The schema of the table at this snapshot.
   */
  dataSchema: TupleType

  /**
   * When this snapshot was created.
   */
  created: datetime

  /**
   * The row count added/updated on the table at this snapshot.
   */
  updatedRowCount: int

  /**
   * The total row count of the table at this snapshot.
   */
  rowCount: int

  /**
   * The total data size of the table at this snapshot.
   */
  dataSize: int
}
