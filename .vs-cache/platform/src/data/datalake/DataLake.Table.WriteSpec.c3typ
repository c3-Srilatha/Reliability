@beta
type DataLake.Table.WriteSpec mixes Spec {

  mode: DataLake.Table.ImportMode = APPEND

  /**
   * List of column names to match. It's required when the mode is MERGE
   * e.g. df.write_table(table, mode="merge", on=["id", "timestamp"]) will match rows in df and table that have the same id and timestamp
   */
  on: [string]

  /**
   * Define merge actions based on specified conditions. Only applicable when mode is 'merge'. See {@link MergeActions} for more details.
   */
  how: MergeActions
}
