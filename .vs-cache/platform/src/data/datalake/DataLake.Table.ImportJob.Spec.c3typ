// Specification for importing csv data into table.
@beta
type DataLake.Table.ImportJob.Spec mixes Spec {

  catalog:     !string
  namespace:   !string
  table:       !string
  files:       ![string serialized FileUrl]
  mode:        string enum DataLake.Table.ImportMode = APPEND
  batchSize:   !int32
  parsingSpec: CsvParsingSpec
}
