type MergeActions.WhenNotMatchedBySource mixes MergeActions.Base {

  /**
   * Update all the not matched target table rows while changing only the specified columns based on the provided assignment.
   * Target table could be referenced with alias "t". Source table can’t be referenced.
   */
  update: member function(data: !map<string, any>): MergeActions

  /**
   * Delete all target rows that have no matches in the source table.
   */
  delete: member function(): MergeActions
}
