// DataLake Table interface
@beta
@db(index=["catalog,namespace,name"])
type DataLake.Table {

  /**
   * Catalog where table is stored
   */
  catalog: !string

  /**
   * Table namespace
   */
  namespace: !string

  /**
   * Table name
   */
  name: !string

  /**
   * Table description
   */
  description: string

  /**
   * Table schema
   */
  dataSchema: !TupleType

  /**
   * Table's partition spec, each partition definition is concatenated by "|"
   */
  partitionSpec: [string serialized Expr]

  /**
   * Table versions
   */
  snapshots: [DataLake.Table.Snapshot]

  /**
   * Points to the latest table version
   */
  currentSnapshot: DataLake.Table.Snapshot

  /**
   * Indicates if table was deleted
   */
  isDeleted: boolean = false

  /**
   * Returns content of the table as iterator Arrow column batches.
   */
  @action(group='read')
  readArrowIterator: abstract member function(filter: string serialized Filter,
                                              projections: [string],
                                              batchSize: !int32): ArrowIterator

  /**
   * Returns content of the table as iterator Arrow column batches with filter defined over partitions (filter over rows
   * not supported).
   */
  @action(group='read')
  readPartitions: abstract member function(filter: string serialized Filter,
                                           projections: [string],
                                           batchSize: !int32): ArrowIterator

  /**
   * Returns first limit rows on tha table in tuple format. This method is used to transfer data to UI for visualization.
   */
  @action(group='read')
  readAsTuples: abstract member function(limit: !int32, snapshot: DataLake.Table.Snapshot): stream<Tuple>

  /**
   * Parses given CSV file and adds new records to the table. CSV schema and table schema should match.
   * @param file
   *        csv file with new records to be added to the table.
   * @param mode
   *        specifies if new records should be appended or overwrite table rows.
   * @param spec
   *        specifies settings for parsing csv file
   */
  @action(group='write')
  importCsv: abstract member function(file: !string serialized FileUrl,
                                      mode: string enum DataLake.Table.ImportMode = APPEND,
                                      spec: CsvParsingSpec)

  /**
   * Asynchronous method for importing csv file records into the table.
   */
  @action(group='write')
  importCsvJob: abstract member function(file: !string serialized FileUrl,
                                         mode: DataLake.Table.ImportMode,
                                         spec: CsvParsingSpec): DataLake.Table.ImportJob

  /**
   * Exports content of the table as CSV file.
   * @param spec
   *        specifies settings for generating csv file for a specific snapshot.
   */
  exportCsv: abstract member function(spec: DataLake.Table.ExportCsvSpec): !string serialized FileUrl

  /**
   * Returns list of data files which contain all the data in latest snapshot.
   */
  dataFiles: abstract member function(): stream<DataLake.Table.DataFile>

  /**
   * Returns Url to table data location.
   */
  baseUrl: abstract member function(): !string serialized Url

  /**
   * Migrate table from source catalog to a target catalog, table cannot be accessed from the source catalog after this.
   *
   * Do not use this API while there are any active operations on the source table
   * Any in-progress changes will not be captured during migration, leading to
   * data loss or inconsistency. Ensure all operations on the source table are complete before migrating.
   *
   * @param targetCatalog
   *        target catalog where table will be registered.
   */
  moveToCatalog: abstract member function(targetCatalog: DataLake.Catalog, confirm: boolean)

  /**
   * Adds new records to the table from the input stream of objs
   *
   * Only fields that exist in the table schema are considered for insertion
   * Additional fields in the input objects that don't exist in the table schema are ignored
   * Required fields (as defined in the table schema) must be present in the input objects.
   *
   * @param objs
   *        Stream of input c3 objs or objs created from {@link TupleType} which are added to the table
   * @param mode
   *        update the table with the mode specfied(overwrite, append, etc..)
   */
  upsertBatch: abstract member function(objs: !(stream<Obj> | stream<Tuple>),
                                        mode: string enum DataLake.Table.ImportMode = APPEND)

  /**
   * Prune snapshots and associated metadata for this table. Note that this API will execute with the table's
   * expiration properties which are default (minimumSnapshots = 1, retentionWindow = '5d'), if these parameters are not specified
   * in the spec.
   */
  expireSnapshots: abstract member function(spec: DataLake.Table.ExpireSnapshotSpec)
}
