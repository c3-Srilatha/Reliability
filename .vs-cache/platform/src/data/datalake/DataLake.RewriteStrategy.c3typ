enum type DataLake.RewriteStrategy {

  /**
   * Combines small files into larger ones and decrease the total number of output files.
   * It's the cheapest and fastest approach.
   */
  BINPACK

  /**
   * Rewrites files while sorting data by specified columns.
   * It's useful when you run many aggregate functions that compare the neighboring records
   */
  SORT

  /**
   * Rewrites files using Z-order clustering on specified columns.
   */
  ZORDER
}
