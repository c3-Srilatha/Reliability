/**
 * User preferences for DataLake tables, including favorite status.
 */
@db(unique=["userId, tableId"], index=["userId", "tableId"])
entity type DataLake.UserPreferences schema name 'LAKE_TABLE_USER_PREFERENCES' {

  /**
   * User ID foreign key
   */
  userId: !string

  /**
   * Table ID foreign key
   */
  tableId: !string

  /**
   * Whether the table is favorited by the user
   */
  isFavorite: boolean = false

  /**
   * Sets the favorite status for a user and table combination.
   * Creates a new record if one doesn't exist, or updates existing record.
   */
  @action(group='write')
  setFavoriteStatus: function(userId: !string, tableId: !string, isFavorite: boolean): DataLake.UserPreferences
}
