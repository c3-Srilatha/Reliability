/**
 *  MergeActions provides methods to define and execute merge actions based on specified conditions.
 *  There are three cases, each could followed by some actions to update the table:
 *  1. When a source row matches a target table row based on the merge condition (whenMatched clauses), see {@link MergeActions.WhenMatched} for available actions.
 *  2. When a source row does not match any target row based on the merge condition (whenNotMatched clauses), see {@link MergeActions.WhenNotMatched} for available actions.
 *  3. When a target row does not match any rows in the source table based on the merge condition (whenNotMatchedBySource clauses), see {@link MergeActions.WhenNotMatchedBySource} for available actions.
 *  Each clause can have an optional condition and there maybe multiple clauses for each case. Only if the condition is met that the action will be executed.
 *  Examples:
 * ```py
 *  df.write_table(table, mode="merge", on=["id", "timestamp"], writer=c3.MergeActions.whenMatched().update({'col1': 's.col1 + t.col1'}).whenNotMatched().insertAll())
 * ```
 */
type MergeActions mixes DefaultInstance, Spec {

  inst: ~

  /**
   * List of {@link MergeOp} that store merge actions
   * Each contains condition, action, and optional data field
   */
  matchedActions: private [MergeOp]

  notMatchedActions:         private [MergeOp]
  notMatchedBySourceActions: private [MergeOp]

  /**
   * WhenMatched action will be executed when a source row matches a target table row based on the merge condition and the specified condition is satisfied
   * If the condition is left empty or "true" (c3.MergeActions.whenMatched().action()), it will be the default for all rows that doesn't satisfy the condition of any defined whenMatched action.
   * If the user doesn't define any whenMatched action, it will apply the default action "updateAll", i.e. whenMatched().updateAll()
   * @param condition
   *     condition that needs to be satisfied for the action to be executed. Target table are referenced with alias "t" and source table with alias "s".
   */
  whenMatched: member function(condition: ?string = 'true'): MergeActions.WhenMatched

  /**
   * WhenNotMatched action will be executed when a source row does not match any target row based on the merge condition and the specified condition is satisfied.
   * If the condition is left empty or "true" (c3.MergeActions.whenNotMatched().action()), it will be the default for all rows that doesn't satisfy the condition of any defined whenMatched action.
   * If the user doesn't define any whenNotMatched action, it will apply the default action "insertAll", i.e. whenNotMatched().insertAll()
   * @param condition
   *     condition that needs to be satisfied for the action to be executed. Target table are referenced with alias "t" and source table with alias "s".
   */
  whenNotMatched: member function(condition: ?string = 'true'): MergeActions.WhenNotMatched

  /**
   * WhenNotMatchedBySource action will be executed when a target row does not match any rows in the source table based on the merge condition and the specified condition is satisfied.
   * If the condition is left empty or "true", it will be the default for all rows that doesn't satisfy the condition of any defined whenMatched action.
   * If the user doesn't define any whenNotMatchedBySource action, the target row is left unchanged.
   * @param condition
   *     condition that needs to be satisfied for the action to be executed. Target table are referenced with alias "t" and source table with alias "s".
   */
  whenNotMatchedBySource: member function(condition: ?string = 'true'): MergeActions.WhenNotMatchedBySource
}
