type DataLake.RewriteDataFilesSpec mixes Spec {

  /**
   * The strategy to use for rewriting operation.
   * There are three strategies available: BINPACK, SORT and ZORDER.
   * See {@link DataLake.RewriteStrategy}
   */
  strategy: string = DataLake.RewriteStrategy.BINPACK

  /**
   * Files that may contain data matching the filter will be considered for rewriting.
   */
  filter: string serialized Filter

  /**
   * Defines how data and deletes files should be ordered in a table
   */
  sort_order: string

  /**
   * Other optional settings for the rewrite action. See https://iceberg.apache.org/docs/nightly/spark-procedures/#options
   */
  options: map<string, string>
}
