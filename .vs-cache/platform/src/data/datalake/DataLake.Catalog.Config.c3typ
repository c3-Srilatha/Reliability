// Base class for DataLake catalogs configs.
@config(doNotDefaultIfMissing=true)
@action(group+='cluster-admin')
@beta
abstract type DataLake.Catalog.Config mixes Config, Named {

  /**
   * Specifies C3 iceberg catalog type for the corresponding catalog implementation
   */
  catalogType: abstract member function(): Type<<DataLake.Catalog>>

  /**
   * Specifies table meta-fields which will be recorded for each table in Catalog.
   */
  metaFields: [DataLake.Table.MetaField]

  forName: ~: mixing DataLake.Catalog.Config

  /**
   * Perform catalog config initialization.
   */
  initialize: member function(): DataLake.Catalog.Config
}
