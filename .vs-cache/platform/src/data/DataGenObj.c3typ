/**
 * Data generation specification for instance of a C3 type. See {@link Data.generate} & {@link Data.profile}.
 */
type DataGenObj mixes DataGen<Obj> {

  /**
   * Prefix for generated ids.
   */
  idPrefix: string

  /**
   * Prefix for generated names.
   */
  namePrefix: string

  /**
   * Probability in the [0,1] range of optional fields having non empty value.
   */
  optionalFieldProbability: double

  /**
   * Size range for size of child collections.
   */
  childCollSize: DataGenInt

  /**
   * Custom generators for fields.
   */
  @ser(name='fields')
  fieldGenerators: map<string, DataGen<any>>

  /**
   * `true` if this generator is for a child reference object.
   */
  reference: boolean

  /**
   * @return target type of the generated data.
   */
  targetType: inline member function(): !Type

  /**
   * @return spec to be used for generating value for a provided field or `null` if field should be skipped.
   */
  fieldGenerator: private inline member function(seed: !int, field: !string): RndResult<DataGen<any>>

  /**
   * @return spec to be used for generating value for a provided value type (and optionally name).
   */
  fieldGenerator: private inline member function(seed: !int, vt: !ValueType, name: string): RndResult<DataGen<any>>

  /**
   * Simple method to create a generic generator for a type. This generator will produce uniform random (gibberish)
   * values for all fields.
   *
   * @see DataGen#forType
   */
  forObjType: function(type: !Type<<Obj>>, spec: Obj.GenerateSpec): DataGenObj

  /**
   * Generate array of random objs, by number of instances and then persist the generated objs into database.
   * This starts with the specified seed and updates the #seed field as it goes. Note that the ids of the generated objs will
   * be set to the format of "<valueType>_<uuid>", where the uuid is of 8 digits
   * for example, WindTurbine_11321234, WindTurbine_34244542, ....
   * @param count
   *        the number of objs to be created and persisted.
   * @return the RndResult with the persisted array of objs and the last seed value.
   */
  persistObjs: member function(count: !int): RndResult<[Persistable]>

  /**
   * Generate array of random objs, by number of instances and then persist the generated objs into database.
   * This starts with the current #seed and updates the field as it goes. Note that the ids of the generated objs will
   * be set to the format of "<valueType>_<uuid>", where the uuid is of 8 digits
   * for example, WindTurbine_11321234, WindTurbine_34244542, ....
   * @param count
   *        the number of objs to be created and persisted.
   * @param seed
   *        the seed number to be fed to random number generator
   * @return the RndResult with the persisted array of objs and the last seed value.
   */
  persistObjs: member function(seed: !int, count: !int): RndResult<[Persistable]>
}
