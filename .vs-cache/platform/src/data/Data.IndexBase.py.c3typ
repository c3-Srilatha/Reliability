/**
 * This native remix augments the {@link Data.IndexBase} type by adding pandas-like APIs, to be used specifically
 * in python.
 */
@beta
native py remix type Data.IndexBase {

  _iter_: ~ py
  shape:  property(): native py
  join:   member function(other: ?any, how: ?any, level: ?any, return_indexers: ?any, sort: ?any): native py

  sort_values: member function(return_indexer: ?any,
                               ascending: ?any,
                               na_position: ?any,
                               key: ?lambda(x: any ...): any): native py

  factorize:              member function(sort: ?any, na_sentinel: ?int): native py
  get_indexer_non_unique: member function(target: ?any): native py
  reindex:                member function(target: ?any,
                                          method: ?any,
                                          level: ?any,
                                          limit: ?any,
                                          tolerance: ?any): native py
  sortlevel:              member function(level: ?any, ascending: ?any, sort_remaining: ?any): native py
  slice_locs:             member function(start: ?any, end: ?any, step: ?any, kind: ?any): native py
  to_numpy:               member function(dtype: native, copy: native, na_value: native): native py
}
