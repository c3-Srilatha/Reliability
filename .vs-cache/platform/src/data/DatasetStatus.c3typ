@beta
type DatasetStatus mixes Result {

  state:                    string
  podCpuUsage:              double
  podMemoryUsage:           double
  count:                    int
  countFormatted:           string
  contentSize:              int
  contentSizeFormatted:     string
  rate:                     string
  fieldCount:               map<string, int>
  fieldApproxDistinctCount: map<string, int>
  hlls:                     map<int32, HyperLogLog>
}
