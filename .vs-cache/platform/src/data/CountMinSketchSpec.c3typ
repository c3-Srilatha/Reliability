/**
 * Defines spec for CountMinSketch instance. @see [http://web.stanford.edu/class/cs369g/files/lectures/lec7.pdf]
 * section 3.2 for an error analysis.
 */
type CountMinSketchSpec mixes Spec {

  /**
   * Sets number of possible values the hash function will map element too. Larger hash means more accurate estimate,
   * but larger structure in CountMinSketch. Must be a power of two for fast modulo calculations.
   */
  binCount: !int32 = 8192

  /**
   * Number of hash functions used in CountMinSketch. Larger hash means more accurate estimate, but larger structure
   * in CountMinSketch.
   */
  hashCount: !int32 = 10

  /**
   * Sets CountMinSketch to keep track of top k elements
   */
  trackTopCount: !int32 = 5

  /**
   * Enable or disable the tracking of top most frequent elements. Enabling this will decrease performance.
   */
  enableTrackTop: boolean = false
}
