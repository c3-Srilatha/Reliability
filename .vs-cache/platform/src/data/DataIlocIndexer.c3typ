/**
 * Intermediate representation for an `iloc` pandas-like operation on {@link Data} and {@link Series}.
 */
@beta
type DataIlocIndexer mixes MutableItemProtocol<any>, Mutable, Result {

  data:         private ?(Data | Data.Series)
  _item_:       ~
  _setItem_:    ~
  _removeItem_: ~
  get:          member function(fst: any, snd: any): any
  set:          member function(value: !?any, left: !any, right: any)
  remove:       member function(selector: !?any)
}
