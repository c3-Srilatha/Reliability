/**
 * Statistics of an action execution.
 */
type ActionStats mixes Result {

  /**
   * Number of objs created.
   */
  createdObjCount: !int

  /**
   * Number of objs updated.
   */
  updatedObjCount: !int

  /**
   * Number of objs removed.
   */
  removedObjCount: !int

  /**
   * Number of objs that encountered errors during processing.
   */
  failedObjCount: !int

  /**
   * Number of objs that being skipped during processing.
   */
  skippedObjCount: int

  /**
   * Total number of objs processed.
   */
  objCount: !int

  /**
   * If supported by the operation, the amount of time (in msec) that was spent waiting for the execution of database requests.
   */
  dbWait: !double

  /**
   * Total amount of time (in sec) that the operation took.
   */
  time: !double

  /**
   * Total amount of time (in sec) spent in db operations (both relational and KV).
   */
  dbTime: !double

  /**
   * {@link objCount} / ({@link time})
   */
  objsPerSecond: !double

  /**
   * {@link objCount} / ({@link dbTime})
   */
  dbObjsPerSecond: !double

  /**
   * @return new combined stats.
   */
  concat: member function(other: ActionStats): !mixing ActionStats

  /**
   * Create Stats for supplied values.
   */
  fromValues: function(createdObjCount: !int,
                       updatedObjCount: !int,
                       removedObjCount: !int,
                       failedObjCount: !int,
                       objCount: !int,
                       time: !double,
                       dbTimeNano: !int,
                       dbWait: !double): !ActionStats
}
