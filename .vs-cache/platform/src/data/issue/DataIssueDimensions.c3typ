/**
 * Base type for dimensions / attribute fields of the data issue mechanism.
 *
 * @see DataIssue
 */
abstract type DataIssueDimensions {

  /**
   * Target type of the obj with the issue.
   */
  targetType: !string

  /**
   * Id of obj with the issue.  If null, the issue applies to all objs for the `targetType`
   */
  targetId: string

  /**
   * Field with the issue.  If null, the issue applies to all fields in the `targetType` (where applicable).
   */
  targetField: string

  /**
   * DataIssue severity.
   */
  severity: !string enum DataIssueSeverity = WARNING
}
