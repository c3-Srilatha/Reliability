/**
 * Source data specific data issue type. Any error here indicates that the source data for a SourceCollection is
 * out of sync with the current metadata declarations. This could include missing fields, extra fields, or any other
 * change in schema.
 */
entity type DataIssue.SourceCollection extends DataIssue mixes Value type key 'SC' {

  sourceCollection: !SourceCollection
}
