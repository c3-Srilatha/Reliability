/**
 * Supported time zones
 * NONE - Represents logical time without any zone information
 * UTC  - Coordinated Universal Time
 * Any offset - e.g.("GMT-07:00", "-07:00")
 * Any legit time zone id - e.g.("America/Los_Angeles")
 */
type TimeZone mixes StringSerializable {

  /**
   * Get an instance of No time zone ("NONE"). None time zone represents logical time e.g. "2010-01-01T04:00:00" means
   * 4 am on 1st of january, 2010 irrespective of which zone the date is in
   */
  NONE: const TimeZone = "NONE"

  /**
   * Get an instance of utc time zone ("UTC")
   */
  UTC: const TimeZone = "UTC"

  /**
   * Name of the time zone.
   */
  name: !string

  /**
   * Generate a TimeZone instance from the given name
   * @param name
   *          Name can be "NONE","UTC", any offset e.g.("-07:00"), or any legit time zone id, e.g.("America/Los_Angeles")
   * @return TimeZone instance
   */
  fromString: ~ java | js | py

  /**
   * Convert the time zone instance to a string
   */
  toString: ~ java | js | py

  /**
   * Is time zone utc. This means the time zone is in universal time and suffixed by zone "Z"
   */
  isUtc: inline member function(): boolean java | js | py

  /**
   * Is time zone in none mode. This is the default mode and represents logical times without any zone info.
   * E.g. "2010-01-01T00:00:00" represents 1st of january, 2010 irrespective on any time zone
   */
  isNone: inline member function(): boolean java | js | py

  /**
   * Is time zone offset based. E.g. "-07:00"
   */
  isOffset: inline member function(): boolean java | js | py

  /**
   * Is time zone id based. E.g. "America/Los_Angeles"
   */
  isId: inline member function(): boolean java | js | py

  /**
   * Convert the given date to the given time zone
   * @param dt
   *         Date to be converted to the current time zone
   * @return converted datetime
   */
  convert: inline member function(dt: !datetime): !datetime

  /**
   * ONLY the time zone field will be replaced on the datetime object and all the other fields will be kept intact
   * E.g. Assume the timeZone instance has offset -07:00, the following behavior will be applied on the given date:
   * replace("2010-01-01T12:12:12-08:00") -> "2010-01-01T12:12:12-07:00"
   * @param dt
   *        Date on which zone information needs to be replaced
   * @return datetime object with the replaced zone only.
   */
  replace: inline member function(dt: !datetime): !datetime

  /**
   * Returns the offset of this time zone from UTC at the specified
   * date. If Daylight Saving Time is in effect at the specified
   * date, the offset value is adjusted with the amount of daylight
   * saving.
   * <p>
   * This method returns a historically correct offset value if an
   * underlying TimeZone implementation subclass supports historical
   * Daylight Saving Time schedule and GMT offset changes.
   *
   * @param date
   *          The date for which offset is needed
   * @return the amount of time in milliseconds to add to UTC to get local time.
   */
  offsetMillis: inline member function(dt: !datetime): !int32

  /**
   * List all the available time zone ids. e.g. ["America/Los_Angeles", "America/New_York" ... ]
   */
  listIds: function(): !set<string>
}
