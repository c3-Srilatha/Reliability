/**
 * Various kinds of {@link StdLib#merge} behaviors.
 *
 * @see MergeHelper
 */
enum type MergeKind {

  // Left side of venn diagram (X(X)-)
  LEFT = "left"

  // Right side of venn diagram (-(X)X)
  RIGHT = "right"

  // All parts of venn diagram (X(X)X)
  FULL = "full"

  // Inner part of venn diagram (-(X)-)
  INNER = "inner"
}
