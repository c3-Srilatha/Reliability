/**
 * Represents the computed intersections of a {@link Stdlib#merge} operation.
 *
 * @see MergeHelper
 */
private type MergeIntersections {

  /**
   * fields that exist on vt1 but not vt2
   */
  left: !?set<string>

  /**
   * fields that exist on both types and also key and fkey
   */
  merged: !?set<string>

  /**
   * fields that exist on both types but not in key and fkey
   */
  unmerged: !?set<string>

  /**
   * fields that exist on vt2 but not vt1
   */
  right: !?set<string>
}
