/**
 * In-memory merge spec
 * @see https://pandas.pydata.org/pandas-docs/stable/reference/api/pandas.DataFrame.merge.html
 */
private type MergeHelper.MergeSpec mixes Spec {

  how:         string = "inner"
  on:          [string]
  left_on:     [string]
  right_on:    [string]
  left_index:  boolean = false
  right_index: boolean = false
  sort:        boolean = false
  suffixes:    [string]
  copy:        boolean = true
  indicator:   boolean = false
  validate:    string
}
