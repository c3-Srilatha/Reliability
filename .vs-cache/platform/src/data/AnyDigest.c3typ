/**
 * Stores digests of all PrimitiveTypes to bel ater
 */
type AnyDigest mixes Digest<any, AnyDigest, DigestBuilder<AnyDigest>> {

  /**
   * Stores digests of all primitive types
   */
  digests: map<string, Digest>
}
