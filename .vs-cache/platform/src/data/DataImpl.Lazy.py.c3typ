@beta
native py remix type DataImpl.Lazy {

  to_pandas: ~

  /**
   * NOTE: this method is deprecated and will be removed in a future release. In general, you should use Pandas directly
   * rather than calling **Data.from_pandas**, except when using {@link Data.Persisted#from_pandas} in {@link MlPipe MlPipes}.
   */
  @deprecated(finalVersion="8.8", details="This function would be removed in future releases.")
  from_pandas: ~

  to_polars:   ~ py
  from_polars: ~ py

  /**
   * Converts the DataImpl.Lazy to a pandas DataFrame by actualizing the data on the server,
   * sending the binary from the server to the calling runtime, and then unpickling the binary
   */
  to_pandas_from_binary: private member function(): !native py
}
