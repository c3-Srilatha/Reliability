/**
 * Spec for Dataset operations
 */
@beta
type DatasetSpec mixes Spec {

  /**
   * If `true` data will be deserialized on Dataset#read and Dataset#cache operations. Otherwise it will be read or
   * cached in raw form, typically bytes.
   */
  deserialized: boolean

  /**
   * Data serialization type. If not provide type will be inferred from source data
   */
  serType: Type

  /**
   * If `true` data will be cached in memory immediately on Dataset construction
   */
  cache: boolean

  /**
   * If `true` snapshot of the data will be saved in a persisted store immediately on Dataset construction
   */
  save: boolean

  /**
   * If `true` snapshot of the data will be saved in a low latency persisted store immediately on Dataset construction
   */
  saveLowLatency: boolean

  /**
   * Suggested data size for a single chunk when using parallel reads
   */
  parallelReadChunkSizeMb: int32 = 64

  /**
   * Do not use parallel reads from file system / database, I.e. each file will be read serially.
   */
  disableParallelRead: boolean

  /**
   * Do not use string pooling, i.e. do not use single instance for duplicate strings.
   */
  disableStringPooling: boolean

  /**
   * Use single instance for all duplicate objects
   */
  enableObjectPooling: boolean

  /**
   * Server id where data for this dataset lives
   */
  server: private string
}
