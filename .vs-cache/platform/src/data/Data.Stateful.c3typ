/**
 * Base type for all {@link Data} subtypes which are held in memory on the server via belonging to a {@link Dataset}.
 * Every {@link Data.Stateful} must belong to an instance of a Dataset, and is identified in that Dataset by an id.
 */
@beta
abstract private type Data.Stateful {

  /**
   * Dataset which this Data belongs to
   */
  ds: private !Dataset

  /**
   * Id used to reference this Data within the Dataset to which it belongs
   */
  id: !string
}
