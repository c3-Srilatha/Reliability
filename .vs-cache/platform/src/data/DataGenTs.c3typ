/**
 * Random timeseries data generator. See {@link Data.generate} & {@link Data.profile}.
 */
type DataGenTs mixes DataGenObj {

  /**
   * Parent id.
   */
  parent: string

  /**
   * Time range of the generated timeseries.
   */
  timeRange: TimeRange

  /**
   * Interval of the timeseries data points.
   */
  interval: string enum Interval

  /**
   * Min and max range of the interval of timeseries data points in seconds.
   */
  intervalSec: DataGenDbl

  fieldGenerator: ~
  _next:          ~
}
