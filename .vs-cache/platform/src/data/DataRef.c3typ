/**
 * Implementation of DataRef for {@link Data}
 */
@beta
type DataRef mixes Data, DataImpl.Ref {

  _exec:       private ~ from DataImpl.Ref
  toDataRef:   private ~ from Data
  dereference: ~
  cache:       ~
  isCached:    ~

  // TODO: PLAT-45704: Support native pd.Timestamp as an argument to Data APIs (delete this method)
  fillna: ~

  type: ~ java
}
