/**
 * Contains public APIs shared by every single pd type etc.
 * Regardless of subtype
 */
@beta
abstract private type DataInterface {

  // public APIs for checking state of Data object
  isLazy: abstract member function(): boolean

  isRemote:  abstract member function(): boolean
  isMutable: abstract member function(): boolean

  // public APIs for checking and converting between different Data implementations
  isPandas: abstract member function(): boolean

  isSpark: abstract member function(): boolean
}
