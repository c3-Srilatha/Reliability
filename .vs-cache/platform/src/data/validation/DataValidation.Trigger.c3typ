/**
 * Enum with labels for different triggers for {@link DataValidation.Rule}
 */
enum type DataValidation.Trigger {

  /**
   * Manually triggered by the user.
   */
  MANUAL

  /**
   * Triggered by platform based on the schedule configured by the user.
   */
  SCHEDULE
}
