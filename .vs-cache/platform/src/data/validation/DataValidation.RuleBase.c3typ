/**
 * **DataValidation.RuleBase** contains all the fields and methods relevant to execution of {@link DataValidation.Rule} and {@link DataValidation.Rule.Draft} subtypes
 */
@db(unique=["name"], index=["targetType"])
abstract entity type DataValidation.RuleBase mixes Versionable, WithName {

  /**
   * The type the rule is associated with. This association informs different parts of the platform to make informed
   * decisions, which may include but are not limited to filtering, indexing or execution.
   */
  targetType: Type

  /**
   * Name of the rule
   */
  name: !~

  /**
   * Description of the rule.
   */
  description: string

  /**
   * Type of the details. This will help UI and other parts of the ecoSystem make informed decisions while rendering the details of the run.
   */
  detailsType: TupleType

  /**
   * Any arguments passed to the **rule**. Please note that these arguments will serve as the base arguments before applying any
   * arguments passed at runtime to the {@link #run} or {@link #initRun} method.
   *
   * Note that **targetType** is required here, and an error will be thrown if it is passed as **argsOverride**. If not specified,
   * the rule's targetType will be used to start the {@link MapReduceJob} to execute the {@link #map} function.
   */
  args: map<string, any>

  /**
   * Kind of this rule. Please see {@link DataValidation.Rule.Kind} for more details.
   */
  kind: DataValidation.Rule.Kind stored calc typeIdent == "LMAPR" ? LAMBDA : (typeIdent == "FKEY" ? FOREIGN_KEY : MANAGED)

  /**
   * List of all the runs executed for the current rule ordered by meta.created.
   * PLEASE DON'T USE THIS FOR ANYTHING!! {@link lastRun} is better suited for any application logic.
   * This is relevant and only needed to support computation of **lastRun**.
   */
  @db(order="descending(meta.created)")
  runs: private [DataValidation.Run](rule)

  /**
   * Last Run executed for the Rule.
   */
  lastRun: DataValidation.Run stored calc runs[0]

  /**
   * Fields from {@link #args} which will decide the {@link DataValidation.Run#runGroup runGroup} of the run.
   * By default, all fields from the {@link #args} are ignored and this id depends on the {@link #id} of the rule.
   */
  runIdempotencyArgsKeys: [string]

  /**
   * **Args** after applying the passed **argsOverride** on top of the {@link #args}.
   */
  overiddenArgs: member function(argsOverride: !?map<string, any>): !?map<string, any>

  /**
   * @return the runGroup for the rule for the provided argsOverride
   */
  @dependency(include="targetType, args, runIdempotencyArgsKeys")
  runGroup: member function(argsOverride: !?map<string, any>): !string

  /**
   * @return the runGroup for the rule with the provided "overridden args". Please note that this will assume that the
   * **overriddenArgs** are final (most probably extracted from {@link overiddenArgs}) and {@link #args} will not be looked up for any additional manipulation.
   */
  @dependency(include="targetType, runIdempotencyArgsKeys")
  _runGroup: private member function(overriddenArgs: !?map<string, any>): !string

  /**
   * Trigger / start the execution of the rule for the provided arguments. Please note this is supposed to be an
   * end-to-end run which will take care of rule initialization ({@link #initRun}), execution (rule specific)
   * and finalization ({@link #finalizeRun}).
   *
   * Please note that {@link #args} will be used as the base and the provided **args** will either be
   * overriding or adding to them.
   */
  @dependency(include="name, targetType, args, detailsType, runIdempotencyArgsKeys, enableUserNotifications, notifyUserIds, notifyUserGroups")
  run: abstract member function(argsOverride: map<string, any>): DataValidation.Run

  /**
   * Initialize a new {@link DataValidation.Run run} of the rule.
   *
   * Please note that {@link #args} will be used as the base and the provided **args** will either be
   * overriding or adding to them.
   */
  @dependency(include="name, targetType, args, detailsType, runIdempotencyArgsKeys, enableUserNotifications, notifyUserIds, notifyUserGroups")
  initRun: member function(argsOverride: map<string, any>): DataValidation.Run

  /**
   * Complete the execution of the rule by setting the status to {@link DataValidation.Status.PASSED} is found {@link DataValidation.Status.RUNNING}
   * No need to call this if you have ensured that the **run** has reached the right terminal state.
   */
  @dependency(include="targetType, args, runIdempotencyArgsKeys")
  finalizeRun: member function(run: !DataValidation.Run): !DataValidation.Status
}
