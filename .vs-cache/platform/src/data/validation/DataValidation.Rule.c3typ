/**
 * **DataValidation.Rule** is the primary type authored by the users to define the rule. This will determine
 * 1. What should the rule check?
 * 2. What conditions define a rule violation?
 * 3. How should the rule operate?
 * 4. Is the rule supposed to run as a schedule or triggered by a specific event?
 */
abstract extendable entity type DataValidation.Rule mixes DataValidation.RuleBase, DataValidation.Rule.NonDraftBase {

  targetType: !~

  /**
   * Status of the rule derived from the {@link DataValidation.Run}. Please note that this is not persisted in the db
   * and won't be available by default. {@link #fetchByStatus} and {@link #fetchCountByStatus} should be used if status
   * needs to be used in filtering.
   */
  status: DataValidation.Status not persistable

  /**
   * Fetch rules from Db with filter on {@link #status} and additional spec. Please note that status is **not persistable** and is added to
   * the rule by analyzing the {@link DataValidation.Run runs} of the rules. The vanilla {@link #fetch} will not work in this case.
   * Please note that an error will be thrown if any status specific filter is passed to spec.filter.
   */
  fetchByStatus: function(status: [DataValidation.Status], spec: FetchSpec): FetchResult<DataValidation.Rule>

  /**
   * Count of rules based on the {@link #status} and the additional FetchFilterSpec. Please note that status is **not persistable** and is added to
   * the rule by analyzing the {@link DataValidation.Run runs} of the rules. The vanilla {@link #fetchCount} will not work in this case.
   * Please note that an error will be thrown if any status specific filter is passed to spec.filter.
   */
  fetchCountByStatus: function(status: [DataValidation.Status], spec: FetchFilterSpec): !int
}
