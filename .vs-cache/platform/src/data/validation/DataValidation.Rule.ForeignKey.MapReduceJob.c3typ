/**
 * Type powering the MapReduce execution model of the managed ForeignKey rule.
 */
private entity type DataValidation.Rule.ForeignKey.MapReduceJob extends MapReduce<Obj, int, [DataValidation.Rule.ForeignKey.MapReduceRecord], int> mixes DataValidation.Rule.ForeignKey.MapReduceOptions type key 'DVFK' {

  /**
   * Overridden implementation that applies optimizations for KV store entities.
   */
  scanTargetType: ~

  /**
   * Rule running as part of the current job.
   */
  @db(persistAllFields=true)
  rule: !DataValidation.Rule.ForeignKey

  /**
   * This is the array of foreign key field types which we have to run the foreign key check on.
   */
  // TODO: Why does ![FieldType] fails during obj creation?
  fKeyNames: ![string]

  /**
   * {@link DataValidation.Run Run} for the rule.
   */
  ruleRun: DataValidation.Run

  /**
   * @inheritDoc
   *
   * Mapper for foreign-key validation.
   * <p>
   * 1) Counts occurrences of each FK value per field in this batch.
   * 2) Looks up which of those values actually exist in the primary table.
   * 3) Emits only the "missing" FK values with their counts.
   */
  @dependency(include="rule, ruleRun, targetType, fKeyFieldTypes")
  map: ~

  /**
   * @inheritDoc
   *
   * Reducer function for the Foreign Key MapReduce Job.
   * This method aggregates intermediate values (counts) grouped by a specific foreign key field name and value,
   * and writes the aggregated count into the DataValidation.Run as a detail entry.
   */
  @dependency(include="rule, ruleRun, targetType")
  reduce: ~

  /**
   * @inheritDoc
   *
   * Finalizes the execution and sets the status on the run.
   */
  completed: ~
}
