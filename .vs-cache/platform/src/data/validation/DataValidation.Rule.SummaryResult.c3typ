/**
 * Type provided to the user lambda to send information to be converted into details, summary and also decide the {@link DataValidation.Status status} of the run.
 */
type DataValidation.Rule.SummaryResult {

  /**
   * Data which need to be added to the details and will be accessible during and after the {@DataValidation.Run} finishes.
   */
  details: [json] | native

  /**
   * Status decided by the execution of the rule.
   * It's invalid to not have a **status** after the execution of the rule.
   */
  status: !DataValidation.Status
}
