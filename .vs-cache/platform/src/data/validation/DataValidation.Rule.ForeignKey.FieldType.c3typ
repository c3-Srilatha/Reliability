/**
 * A type being introduced as a workaround to allow ValueType of the FieldType to be extracted, which by default is not sent over the wire to UI.
 */
private type DataValidation.Rule.ForeignKey.FieldType {

  /**
   * Name of the fieldType
   */
  name: !string

  /**
   * valueType of the field being returned.
   */
  valueType: !string

  /**
   * Documentation related to the current field
   */
  doc: string
}
