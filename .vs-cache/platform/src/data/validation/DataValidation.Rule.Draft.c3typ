/**
 * **DataValidation.Rule.Draft** is the base type for all Draft rules which can be used to create "deployed rules" (subtype of {@link DataValidation.Rule}) and a deploy method will create a new "deployed" rule.
 */
abstract extendable entity type DataValidation.Rule.Draft mixes DataValidation.RuleBase {

  /**
   * The Non Draft rule type associated to the current Draft type
   */
  deployRuleType: private abstract function(): !Type<<DataValidation.Rule>>

  /**
   * Create (or merge into, if an existing rule with the same name exists) a "deployed" / non draft rule.
   */
  deploy: member function(spec: DataValidation.Rule.Draft.DeploySpec): DataValidation.Rule
}
