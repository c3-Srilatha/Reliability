@db(index=['parent, ascending(timestamp)'])
entity type DataValidation.Run.Debug mixes ParentPartitionable<DataValidation.Run> {

  /**
   * C3 Action id of action producing the debug log
   */
  actionId: string

  /**
   * Debug message logged as part of the current run.
   */
  log: !string

  /**
   * Context of the MapReduce job if debug log is generated from map function. If the debug log is generated from
   * summarize function then this would just be "summarize".
   */
  functionContext: !string

  /**
   * Timestamp when the log was generated
   */
  timestamp: !datetime with millis
}
