/**
 * Represents the value emitted during the map phase of a foreign key validation job.
 */
private type DataValidation.Rule.ForeignKey.MapReduceRecord {

  /**
   * key
   */
  key: string

  /**
   * value
   */
  value: string

  /**
   * count
   */
  count: int
}
