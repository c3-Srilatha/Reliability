/**
 * All possible status of the {@link DataValidation.Rule}
 */
enum type DataValidation.Status {

  /**
   * Indicates that the {@link DataValidation.Run run} is in-progress.
   */
  RUNNING

  /**
   * Indicates that the {@link DataValidation.Run run} has has encountered an error during execution.
   */
  ERROR

  /**
   * Denotes that the associated {@link DataValidation.Run} has a **critical** "validation failure" as decided by
   * {@link DataValidation.Rule#summarize}
   */
  FAILED_CRITICAL

  /**
   * Denotes that the associated {@link DataValidation.Run} has a **moderate** "validation failure" as decided by
   * {@link DataValidation.Rule#summarize}
   */
  FAILED_MODERATE

  /**
   * Denotes that the associated {@link DataValidation.Run} has a "validation success" as decided by
   * {@link DataValidation.summarize}
   */
  PASSED

  /**
   * Denotes that the associated run was aborted mid way during the execution
   */
  ABORTED

  /**
   * Denotes that the {@link DataValidation.Rule} may not have any {@link DataValidation.Run runs} or a
   * type may have had some **rules** but none of those ever had any run.
   */
  AWAITING_RUN
}
