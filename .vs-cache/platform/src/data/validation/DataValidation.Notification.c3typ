type DataValidation.Notification {

  /**
   * Send notification to Studio.
   * @param notificationSpec - Notification specification containing the message and other details.
   * @param userIds - List of user IDs to which the notification should be sent.
   * @param userGroups - List of user groups to which the notification should be sent.
   */
  send: function(notificationSpec: !App.Notification, userGroups: [string], userIds: [string])

  /**
   * Fetches authorized users and user groups for the current app.
   * @return Map containing "userIds" and "userGroups" arrays.
   */
  fetchUsersAndUserGroups: function(): map<string, [string]>
}
