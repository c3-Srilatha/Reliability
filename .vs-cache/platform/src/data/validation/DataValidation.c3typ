/**
 * Namespace for all types related to data quality and validation capabilities of the platform.
 */
abstract type DataValidation {

  /**
   * Returns the default runtime configurations for different implementation languages.
   * This cached function provides the runtime environment mappings for executing data validation rules
   * in various supported languages.
   *
   * @return A map containing language identifiers (e.g., "PYTHON", "JAVASCRIPT") as keys
   *         and their corresponding runtime environment strings as values
   */
  dfltRuntimes: cached function(): !map<string, string>

  /**
   * Retrieves argument information for a given data validation rule.
   * This function analyzes the rule and returns metadata about all available arguments,
   * including their names, types, values, and documentation. For ForeignKey rules,
   * it includes specialized MapReduceOptions fields. For other rule types, it includes
   * standard MapReduceOptions fields plus common arguments like 'start' and 'end' timestamps.
   *
   * @param rule The data validation rule for which to retrieve argument information
   * @return An array of DataValidation.Arg objects containing argument metadata
   */
  argsInfo: function(rule: !DataValidation.RuleBase): [DataValidation.Arg]

  /**
   * Returns an array of all primitive type names supported in data validation.
   * This function provides a list of basic data types that can be used in validation rules.
   *
   * @return An array of strings representing primitive type
   */
  allSupportedValueTypes: cached function(): ![string]
}
