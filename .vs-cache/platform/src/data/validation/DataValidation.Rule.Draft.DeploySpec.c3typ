type DataValidation.Rule.Draft.DeploySpec mixes DataValidation.Rule.NonDraftFields, MergeSpec {

  /**
   * Provides a different name than the Draft rule, which should change during deployment.
   */
  nameOverride: string

  /**
   * Provides a different description than the Draft rule, which should change during deployment.
   */
  descriptionOverride: string

  /**
   * If true, then an existing {@link DataValidation.Rule} **with the same name** will be **merged into**. Its important to **merge** to ensure that any existing **schedule** (or any other fields) of the rule is retained.
   * If false, then an error will be thrown if the same name as an existing {@link DataValidation.Rule} is used.
   */
  override: boolean
}
