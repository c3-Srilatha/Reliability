/**
 * **DataValidation.Rule.Lambda** allows a rule to be defined by providing **Lambda** for custom validation rules.
 */
abstract entity type DataValidation.Rule.WithLambda mixes DataValidation.RuleBase, JsSerializable, PySerializable {

  /**
   * Language for the current rule. Both {@link #map} and {@link #summarize} lambdas are assumed and expected to be implemented using this language
   */
  language: string serialized ImplLanguage

  /**
   * The minimal action requirement for this lambda to execute. This should generally be null, to make the lambda as
   * widely useful as possible.
   */
  actionRequirement: string serialized Action.Requirement

  /**
   * Lambda to be specified where the rule can be executed in batches and expected to generate details in smaller
   * chunks as well. Please note that {@link Persistable.merge} will be used to add to the {@link DataValidation.Run}
   * and any of the {@link Db.Retryable} errors will be handled implicitly by retries.
   */
  map: lambda(objs: ![Obj], run: !DataValidation.Run): DataValidation.Rule.MapResult

  /**
   * Logic of asserting if the output of the rule execution. Please note that if is not set, then it will be assumed to
   * be a {@link DataValidation.Status.PASSED}
   */
  summarize: lambda(run: !DataValidation.Run): !DataValidation.Rule.SummaryResult

  /**
   * Field containing all the user code shown to the user in the UX. Following fields will be made available to be
   * authored as part of this:
   * 1. {@link #map map lambda}
   * 2. {@link #summarize summarize lambda}
   * 3. {@link #detailsType}
   */
  userCode: string

  /**
   * Create a {@link DataValidation.Rule.WithLambda.SaveResult} that contains an Lambda rule instance from the provided code
   * and the issues that are produced in this process. This will be primary used to show / edit / create the rule from a UI.
   * Note that if there are issues when creating the Lambda rule, this API call will not fail, instead it will return a _null_ rule
   * with the issues.
   * @param code
   *        User code to be parsed into a new Lambda rule.
   * @param language
   *        The language of the user code.
   * @return a {@link DataValidation.Rule.WithLambda.SaveResult SaveResult} with fst as the new Lambda rule instance and
   *         the snd as the potential issues produced in parsing the user code.
   */
  fromCode: private function(code: !string,
                             language: !string serialized ImplLanguage): DataValidation.Rule.WithLambda.SaveResult

  /**
   * @inheritDoc
   * Apart from the default merging of rules, we:
   * 1. If not specified, use include="this" to give a better experience to non power users.
   */
  @dependency(include="args")
  overiddenArgs: ~

  /**
   * Trigger / start the execution of the rule for the provided arguments. Please note this is supposed to be an
   * end-to-end run which will take care of rule initialization ({@link #initRun}), execution ({@link #doExecMap}
   * and assertion ({@link #finalizeRun}) based on {@link #summarize}.
   *
   * Please note that {@link #args} will be used as the base and the provided **args** will either be
   * overriding or adding to them.
   */
  @dependency(include="name, targetType, args, detailsType, map, summarize, runIdempotencyArgsKeys, enableUserNotifications, notifyUserIds, notifyUserGroups")
  run: ~

  /**
   * Execute the rule for the provided batch of ids. Please note that this is a sync request and if the **run** is not
   * properly initialized, then an exception will be thrown.
   */
  @dependency(include="targetType, args, map, runIdempotencyArgsKeys")
  doExecMap: member function(objs: ![Obj], run: !DataValidation.Run)

  /**
   * @inheritdoc
   * If **argsOverride** contains **targetType** in it, then an error will be thrown.
   */
  @dependency(include="name, targetType, args, detailsType, runIdempotencyArgsKeys, language, map, summarize, enableUserNotifications, notifyUserIds, notifyUserGroups")
  initRun: ~

  /**
   * @inheritdoc
   *
   * Complete the execution of the rule by applying the {@link #summarize} on the {@link DataValidation.Run details} associated with the run.
   */
  @dependency(include="targetType, args, summarize, runIdempotencyArgsKeys")
  finalizeRun: ~

  toJsSource:   ~
  fromJsSource: ~

  /**
   * Construct a lambda rule from a python source code. If there are errors in the user code, then the error message will
   * be returned as a string. This function is different from the {@link PySerializable#fromPySource} because the
   * PySerializable#fromPySource will throw the errors when compiling and executing the python source code, but this function
   * will not throw errors, instead, it will return a {@link DataValidation.Rule.Lambda.Issue} containing the simplified error
   * message and the line numbers and offset if they are available.
   */
  fromPySrc: private function(userCode: !?string): !DataValidation.Rule.WithLambda | DataValidation.Rule.Lambda.Issue py

  /**
   * Construct a lambda rule from a javascript source code. If there are errors in the user code, then the error message will
   * be returned as a string. This function is different from the {@link #fromJsSource} because the
   * #fromPySource will throw the errors when compiling and executing the python source code, but this function
   * will not throw errors, instead, it will return a {@link DataValidation.Rule.Lambda.Issue} containing the simplified error
   * message and the line numbers and offset if they are available.
   */
  fromJsSrc: private function(userCode: !?string): !DataValidation.Rule.WithLambda | DataValidation.Rule.Lambda.Issue
}
