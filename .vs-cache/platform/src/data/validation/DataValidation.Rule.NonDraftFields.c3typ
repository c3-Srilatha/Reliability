/**
 * Base type containing common rule options fields used by both
 * {@link DataValidation.Rule.NonDraftBase} and {@link DataValidation.Rule.Draft.DeploySpec}.
 */
abstract type DataValidation.Rule.NonDraftFields {

  /**
   * Schedule to run this rule that will be passed to a corresponding {@link CronJob}.
   */
  schedule: CronSchedule

  /**
   * Enables user notifications for this rule's runs.
   * When true, DataValidation notifications will be generated for run lifecycle events (for example, when a run fails or transitions from fail to pass)
   * and dispatched to the recipients specified by {@link #notifyUserIds} and {@link #notifyUserGroups}.
   * If both recipient lists are empty or the notification service is not configured, no notifications will be sent.
   */
  enableUserNotifications: boolean

  /**
   * The desired list of user ids to send DataValidation notifications.
   */
  notifyUserIds: [string]

  /**
   * The desired list of user groups to send DataValidation notifications.
   */
  notifyUserGroups: [string]
}
