/**
 * Type to store detailed information that may include extensive context beyond simple metadata issue. This detail can be as rich and comprehensive as required.
 */
@db(index=['parent,name'])
entity type DataValidation.Run.Details mixes ParentPartitionable<DataValidation.Run> {

  /**
   * Additional identifier for optional partitioning of details belonging to a run. To be used as part of {@link
   * DataValidation.Run#addDetails}'s second parameter. {@link #DEFAULT_NAME} will be used for operations that
   * specify the empty or null name, e.g. {@link DataValidation.Run#fetchDetails}.
   */
  name: string = DataValidation.Run.DEFAULT_SCHEMA_NAME

  /**
   * Information to be stored in the partitioned data store
   */
  details: any
}
