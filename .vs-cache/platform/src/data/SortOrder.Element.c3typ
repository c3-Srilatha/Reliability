/**
 * Each component of the sort order is a field path and a sorting direction.
 */
type SortOrder.Element mixes StringSerializable {

  /**
   * The field on which to sort.
   */
  field: !FieldPath

  /**
   * If true, sort descending rather than ascending.
   */
  descending: boolean
}
