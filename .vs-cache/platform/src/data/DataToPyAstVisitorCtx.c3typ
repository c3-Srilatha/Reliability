@beta
private type DataToPyAstVisitorCtx {

  /**
   * Pre-computed names per {@link Workflow.Vertex}.
   * - {@link Workflow.Action} refers to temporary {@link Data} prefixed with "tmp_df"
   * - {@link Workflow.Const} refers to cached {@link Data} referring to either "df1" or "df2"
   */
  names: map<Workflow.Vertex, string>

  /**
   * Set of Data.Modin referenced by name referenced in generated {@link #ast}
   */
  data: set<DataImpl>

  /**
   * Mapping of variable names to their values to be used by the PyAst Executor
   */
  vars: map<any, string>

  /**
   * Graph context used to query vertices
   */
  wf: !Workflow

  /**
   * Module that is iteratively built throughout visitor implementation
   */
  ast: !PyAst.Module

  /**
   * This specifies the method that should be used for an execution engine when performing an io operation.
   */
  // TODO: PLAT-44183 remove this flag once all execution modes use `BytesIO`
  ioMethod: !string

  /**
   * specify whether output of each statement should be converted back to its native data structure
   */
  doNotConvertStatementToNative: boolean

  /**
   * Returns true if the workflow comprises a single {@link Data} returning {@link Workflow.Const} vertex, false otherwise
   * Useful for avoiding an unnecessary remote to Ray.
   */
  hasLoneDataConstVertx: private member function(): boolean

  /**
   * In the case that hasOnlySingleConst is true, returns the value of the const. Else, throws an exception.
   */
  loneDataConstValue: private member function(): !DataImpl

  /**
   * Generate final "ret = " assignment and add it to PyAst
   */
  addReturnNode: private member function(nVertices: !int): !DataToPyAstVisitorCtx

  /**
   * Add the function definition of the dataframe converter as an {@link PyAst.Stmt} to this {@link DataToPyAstVisitorCtx}
   */
  addDataFrameConverter: private member function(): !DataToPyAstVisitorCtx

  /**
   * Add the function definition of the file reader as a {@link PyAst.Stmt} to this {@link DataToPyAstVisitorCtx}
   */
  addFileReader: private member function(): !DataToPyAstVisitorCtx
}
