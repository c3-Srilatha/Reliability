/**
 * Histogram for booleans. Since there are only a finite number of booleans (2), this will actually be an exact mapping
 * of boolean -> count.
 */
type BooleanHistogram mixes Histogram<boolean, BooleanHistogram, HistogramBuilder<BooleanHistogram>> {

  /**
   * Helper method to generate boolean bins for a BooleanHistogram. Shared code between BooleanHistogram.merge and
   * HistogramBuilder.buildBoolHistogram
   */
  boolBins: function(falseCount: !int, trueCount: !int, total: !int): Array<HistogramBin<boolean>>
}
