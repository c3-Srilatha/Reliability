/**
 * Abstract interface representing the pandas DatetimeIndex class.
 */
@beta
abstract type Data.DatetimeIndex mixes ReClaim, Data.IndexBase, Pandas.DatetimeIndex {

  // TODO: PLAT-50581 Pandas type generation framework should be able to infer parameters from documentation
  @pandas(canReturnData=true)
  strftime: abstract member function(date_format: string): any

  round:      abstract member function(freq: any, ambiguous: any, nonexistent: any): Data.DatetimeIndex | Data.Series
  floor:      abstract member function(freq: any, ambiguous: any, nonexistent: any): Data.DatetimeIndex | Data.Series
  ceil:       abstract member function(freq: any, ambiguous: any, nonexistent: any): Data.DatetimeIndex | Data.Series
  to_period:  abstract member function(freq: any): Data.PeriodIndex
  month_name: abstract member function(locale: string): Data.Index
  day_name:   abstract member function(locale: string): Data.Index
  mean:       abstract member function(skipna: any, axis: int): any

  @reClaim(inherit=true)
  tz: ~

  @reClaim(inherit=true)
  tzinfo: ~

  @reClaim(inherit=true)
  std: ~
}
