native py remix type AnySlice {

  /**
   * Produce a Python "slice" value, equivalent to calling the `slice` function.
   */
  toPython: inline member function(): native py

  /**
   * Helper method for creating AnySlice for Python native slice instance
   */
  fromPySlice: function(slice: native): AnySlice py
}
