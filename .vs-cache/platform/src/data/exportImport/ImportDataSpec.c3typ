/**
 * Specification of the options/parameters for the {@link Importable.importData} function.
 */
type ImportDataSpec mixes Spec {

  /**
   * Should be a ref to an entity type mixing Content containing the data to import.
   */
  @deprecated(finalVersion='7.10', details='Use {@link url}')
  content: DeepRef

  /**
   * Url of the file to import from file system
   */
  url: string

  /**
   * Comma-separated list of fields to be excluded during import
   */
  exclude: string

  /**
   * Overrides for {@link Persistable#meta} fields.
   */
  meta: Meta schema name 'OVERRIDE'

  /**
   * If true then it will be assumed that all obs don't previously exist and we will create them with no attempt to fetch them to see if they exist.
   * This will have better performance if it is known beforehand that they don't exist.
   */
  createOnly: boolean = false

  /**
   * If true then hints to c3 data engine to bypass application logic and write data directly to datastore.
   *
   * This is only supported for the Cassandra datastore currently.
   */
  directPath: boolean = false

  /**
   * If updateMode is set to "merge" then values in the existing record that are not provided by import content
   * will be ignored. Otherwise they will be overwritten by the new values, including null values.
   */
  updateMode: string enum ImportDataUpdateModeEnum

  /**
   * If true then on failure will retry single Obj at a time.
   */
  retrySingleObjOnFailure: boolean = false

  /**
   * Number of errors after which import will be aborted.
   */
  numErrorsToAbort: int = 1000

  /**
   * How many records to commit at a time.
   */
  commitSize: int = 1000

  /**
   * Ignores columns that refer to fkey fields - i.e. fields that are not updatable in the context of this type.
   */
  ignoreFKeyFields: boolean

  /**
   * Carbon transform code.
   */
  // TODO: REMOVE!
  carbon: string

  /**
   * Wait time in seconds between progress report callbacks. Only meaningful if progressCallback is specified.
   */
  /*
   * TODO:
   *
   * e.g. "SPACE"
   *
   * separator : string enum("COMMA", "SPACE", "TAB") = "COMMA"
   *
   * TODO:
   *
   * true if header is present; header values are used in columnPaths
   *
   * firstRowIsHeader : boolean = true
   *
   * TODO:
   *
   * optinally maps headers to c3 type paths; or if header is not present that maps columns by index (starting from 1)
   *
   * e.g.
   *
   * { "SERVICE_POINT_ID":"parent.id", "TIME":"start", "USAGE_VALUE":"quantity.value", "UNITS":"quantity.unit.id" }
   *
   * or
   *
   * { "1":"parent.id", "2":"start", "3":"quantity.value", "4":"quantity.unit.id" }
   *
   * columnPaths : ma<(string, string>
   *
   * TODO:
   *
   * optinally maps header to a C3 value type; if value type mapping is missing than target field value type is used instead;
   *
   * value type has to be one of "integer","string","double","foat","decimal","datetime";
   *
   * if it is "datetime" then it can optionally contain format as "xsd:datetime" or java.text.SimpleDateFormat:
   *
   * e.g.
   *
   * { "TIME":"datetime as xsd:datetime", "TIME2":"datetime as yyyyMMddHHmm" }
   *
   * or
   *
   * { "2":"datetime as xsd:datetime", "3":"datetime as yyyyMMddHHmm" }
   *
   * columnValueTypes : map<string, string>
   *
   * TODO:
   *
   * JavaScript transform function; it should take object representing a row and target c3 type and return instance of c3 type
   *
   * transformJS : string
   */
  progressCallbackPeriod: int = 30

  /**
   * Should be a ref to an entity type mixing {@link ImportProgress}
   */
  progressCallback: DeepRef

  /**
   * Disables firing of async events during data import.
   */
  disableAsyncProcessing: boolean
}
