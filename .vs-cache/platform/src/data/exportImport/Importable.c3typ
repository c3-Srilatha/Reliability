/**
 * Base type for supporting import of data.
 *
 * @see Persistable
 */
type Importable mixes Value {

  /**
   * @return a push stream to import instances of this type.
   */
  @action(group+='write')
  startImportData: abstract function(spec: StartImportDataSpec): !PushStream<mixing Importable>

  /**
   * @return a push stream to import instances of this type.
   */
  @action(group+='write')
  startImportDataWithStats: abstract function(spec: StartImportDataSpec): !PushStreamWithStats<mixing Importable>

  /**
   * Imports instances into a C3 type from a file stored in Cassandra.
   *
   * @param spec
   *        Various parameters that control the operation of function.
   * @param async
   *        Indicates whether the operation should be performed asynchronously or not.  Default is false (e.g.
   *        synchronous)
   * @return various statistics and errors for the import operation.
   */
  @action(group+='write')
  @deprecated(finalVersion='v7.10')
  importData: abstract function(spec: !ImportDataSpec, async: boolean): ImportDataResult
}
