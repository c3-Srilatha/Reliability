entity type ExportImportChunk schema name 'EXPIMP_EXPIMPCHK' {

  /**
   * Url of the file exported/imported
   */
  url: string

  /**
   * Id of the parent batch process
   */
  parentId: string

  targetType: !Type

  /**
   * Obj ids of targetType instances that the chunk processes
   * It will be populated if
   */
  ids: [string] schema suffix 'I'

  /**
   * obj id of targetType instance that marks the start of chunk (inclusive)
   */
  startId: string

  /**
   * obj id of targetType instance that marks the end of chunk (exclusive)
   */
  endId: string

  exportStats: ActionStats
  importStats: ActionStats

  /**
   * Set to hash of the path of the file prefixed with the job type name
   */
  id: ~
}
