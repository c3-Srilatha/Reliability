/**
 * Specification of the options/parameters for the {@link Persistable#exportData} function.
 */
type ExportDataSpec mixes ExportDataCommonSpec {

  /**
   * Should be a ref to an entity type mixing Content. It's contentType will determine format of the exported data.
   * which can either be a c3 canonical csv or c3 canonical xml.
   */
  @deprecated(finalVersion='7.10', details='Use {@link contentName}')
  content: DeepRef

  /**
   * Content name if content should be created by export data api
   * If starts with s3://, it is exported to S3
   */
  contentName: string

  /**
   * carbon transform code.
   */
  carbon: string

  /**
   * Only used when anonymize is true.
   * Additional fields that you want to anonymize in addition to the fields annotated with
   * @PII(category="someCategory". Keys: field names, values: the anonymization category that should be applied on the
   * field, must be taken from AnonymizationCategory ('address', 'name', 'phone', 'dob', 'email' or 'random').
   */
  piiFields: map<string, string>

  /**
   * True will anonymize fields marked with @PII annotation in type definition and fields in piiFields
   */
  anonymize: boolean

  /**
   * Fields to be excluded from export (e.g. meta, version etc.).
   */
  skipFields: string

  /**
   * Whitelisted fields used in green button format export.
   */
  whitelistedFields: string

  /**
   * Wait time in seconds between progress report callbacks. Only meaningful if progressCallback is specified.
   */
  progressCallbackPeriod: int = 30

  /**
   * Should be a ref to an entity type mixing {@link ExportProgress}.
   */
  progressCallback: DeepRef

  /**
   * For testing only.
   */
  dryRun: boolean

  /**
   * For testing only.
   */
  exportAsTmpFile: boolean
}
