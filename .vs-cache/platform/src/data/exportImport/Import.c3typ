entity type Import extends BatchJob<Import, BatchImportOptions, ExportImportChunk> mixes ExportImportCommon type key 'IMPT' {

  /**
   * Kicks off Import Batch job
   */
  startImport: function(spec: !BatchImportSpec): Import

  /**
   * Returns the spec which was used to start the Import
   */
  spec: member function(): BatchImportSpec

  /**
   * Returns the URL from where the file are imported
   */
  filePath: member function(): string

  /**
   * This is a 'dummy' action used to track action call hierarchy during import.
   */
  servlet: private function() js-server

  /**
   * Schedule import batch job for a stream of files
   * Return the number of files imported.
   */
  scheduleImports: private member function(fileStream: Stream<File>): int

  doStart:      ~
  processBatch: ~
}
