@beta
native py remix type DataImpl.Pandas {

  /**
   * Cached pandas object this DataImpl.Pandas  references
   * If null, we will rebuild the dataframe from scratch
   */
  df: private cached property(): native py

  /**
   * Converts this {@link DataImpl.Pandas} to its corresponding native python value such as a pandas Dataframe or
   * pandas Series.
   * Unlike {@link #to_pandas}, this method does not support ser/deser between different runtimes but just
   * actualizes the {@link Data} instance in the calling runtime.
   */
  toNative: private inline member function(): native py

  /*
   * Read the binaries from Feature Store and return the dataframe.
   * @param local
   *           if True, read persisted data from the local filesystem. Otherwise, read from the remote.
   */
  readFromStore: private member function(local: boolean): native py

  /**
   * Helper function to serialize a pandas DataFrame into c3-compatible binary.
   *
   * @param dataframe
   *           pandas DataFrame to convert.
   * @return list of binaries. Typically, there is only one, but to prevent Java string overflow, it will be broken
   *           into segments if the dataframe is too large.
   */
  pandas_to_c3_binaries: private inline function(dataframe: !native): ![binary] py

  /**
   * Helper function to deserialize binary into pandas dataframe. This inverts {@link #pandas_to_c3_binaries}.
   *
   * @param binaries
   *           list of binaries, produced by {@link #pandas_t_c3_binaries}.
   * @return a single pandas DataFrame.
   */
  c3_binaries_to_pandas: private inline function(binaries: ![binary]): !native py

  to_pandas: ~: native py

  /**
   * NOTE: this method is deprecated and will be removed in a future release. In general, you should use Pandas directly
   * rather than calling **Data.from_pandas**, except when using {@link Data.Persisted#from_pandas} in {@link MlPipe MlPipes}.
   */
  @deprecated(finalVersion="8.8", details="This method will be removed in future releases.")
  from_pandas: function(pandas: !native,
                        dataset_id: string,
                        name: string,
                        stateful: boolean): mixing DataImpl.Pandas py

  /**
   * @param data
   *           a `pd.DataFrame` or `pd.Series`.
   * @return pandas dataframe or series with c3 objects serialized as Json.
   */
  to_json_serialized: private function(data: !native): !native py

  /**
   * @param data
   *           a `pd.DataFrame` or `pd.Series`.
   * @return pandas dataframe or series with c3 objects deserialized from Json.
   */
  to_json_deserialized: private function(data: !native): !native py

  /**
   * @param data
   *           a named tuple containing c3 Arrays.
   * @return pandas dataframe or series where each Array contained in the Tuple is a column
   */
  tuple_of_arrays_to_pd: private inline function(data: !Tuple): !native py

  /**
   * @param pandas
   *          native pandas instance
   * @param dataset
   *          the dataset to use for any new DataImpl created
   * @return the corresponding c3.Data type if found, else None
   */
  @call(stayInEngine=true)
  dataImpl_class_from_pandas: inline function(pandas: !native, ds: Dataset): DataImpl.Pandas py

  to_polars:   ~: native py
  from_polars: ~: mixing DataImpl.Pandas py

  /**
   * Helper to create numpy array from native pandas dataframe
   * @param pandas_data
   *     native pandas instance
   * @param dtype
   *     dtype of native numpy array
   * @param copy
   *     Enables copying of elements during pandas to numpy conversion
   * @param na_value
   *     NA value to be used during pandas to numpy conversion
   * @return the corresponding numpy array
   */
  @call(stayInEngine=true)
  native_pandas_to_numpy: private inline function(pandas_data: !native,
                                                  dtype: native,
                                                  copy: native,
                                                  na_value: native): native py

  /**
   * Returns true if this is a Data.Pandas instance that  contain tuple fields.
   */
  is_data_from_tuple: private member function(): boolean py
}
