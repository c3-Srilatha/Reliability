/**
 * Pipeline consists of connected operators that represents the plan to actualize data
 */
type PipelineSpec {

  /**
   * list of operators belongs to this Pipeline
   */
  nodeDefinitions: [OperatorSpec]

  /**
   * Add operator to this pipeline, returns a new pipeline
   */
  addOperator: member function(opSpec: OperatorSpec): PipelineSpec

  /**
   * Return a new pipeline with the given action and args applied
   */
  getUpdatedPipeline: function(action: string, args: map<string, any>): map<string, any>
}
