/**
 * Represents a operator that takes inputs and properties to produce output
 */
type OperatorSpec {

  /**
   * id of operator, in the format of "data%d" where %d is a unique integer within a pipeline
   */
  id: !string

  /**
   * class of operator
   */
  classId: !string

  /**
   * Operator properties bindings define mapping from property name to property value
   */
  properties: Map<string, any>

  /**
   * Operator input bindings define mapping from input name to outputs of operator producing value
   */
  inputs: Map<string, InputBindingSpec>

  toJson: ~ java
}
