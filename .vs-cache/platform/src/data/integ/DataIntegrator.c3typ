/**
 * Type to allow C3.DataIntegration to call APIs on types that extend CloudResource and hold the Transform Preview API used by Data Fusion UI.
 * All APIs exposed on this type are ones that are meant to be available to the C3.DataIntegrator Role, but aren't,
 * due to the inability to downlevel auths for APIs on types that extend CloudResource.
 */
// TODO: remove CloudResource APIs once PLAT-68535 is resolved.
type DataIntegrator<M: CloudMessage, S: CloudReceiveMessagesSpec> {

  /**
   * {@see CloudMessageBroker}
   */
  @action(group+='provision')
  sendMessages: function(broker: !CloudMessageBroker, messages: [M]): map<string, Error>

  /**
   * {@see CloudMessageBroker}
   */
  @action(group+='provision')
  sendObjs: function(broker: !CloudMessageBroker, objs: [Obj], spec: CloudMessageBrokerSendSpec): map<string, Error>

  /**
   * {@see CloudMessageBroker}
   */
  @action(group+='provision')
  receiveMessages: function(broker: !CloudMessageBroker, spec: S): [M]

  /**
   * {@see CloudMessageBroker}
   */
  @action(group+='provision')
  receivesMessagesAsync: function(brokerType: !Type): boolean

  /**
   * {@see CloudMessageBroker}
   */
  @action(group+='provision')
  registerReceiveMessagesAsync: function(broker: !CloudMessageBroker, spec: S)

  /**
   * {@see CloudMessageBroker}
   */
  @action(group+='provision')
  deregisterReceiveMessagesAsync: function(broker: !CloudMessageBroker)

  /**
   * {@see CloudMessageBroker}
   */
  @action(group+='provision')
  processor: function(broker: !CloudMessageBroker): CloudMessageProcessor<M, S>

  /**
   * {@see CloudMessageBroker}
   */
  @action(group+='provision')
  removeAll: function(broker: !CloudMessageBroker, confirm: boolean): int

  /**
   * {@see CloudMessageBroker}
   */
  @action(group+='provision')
  approximateCount: function(broker: !CloudMessageBroker, partition: !string, cloudConsumer: string): !int

  /**
   * Transforms a list of objects from various sources using the specified transformations.
   * @param spec
   *           various parameters that control the operation of function. Specify the transforms and source objs in TransformSourcesSpec
   * @return A {@link TransformObjsResult} containing the transformed objects.
   */
  transformSources: function(spec: TransformSourcesSpec): TransformObjsResult

  // TODO: PLAT-104862: Implement Transform#chain to support transform optimization and get rid of iterative method applyTransformChain

  /**
   * Apply a chain of transforms for the input obj array.
   * @param transforms
   *           list of {@link Transform}.
   * @param spec
   *           various parameters that control the operation of function.
   * @return a {@link TransformObjsResult} instance containing the objs.
   */
  applyTransformChain: private function(objs: [Obj],
                                        transforms: [Transform],
                                        spec: TransformObjsSpec): TransformObjsResult

  /**
   * Validates and upserts DI pipeline for the {@link SourceSystem}. The operation is atomic i.e. either the
   * pipeline upsert will succeed or the entire operation will be rolled back if it fails at any step.
   *
   * @params sourceSystem
   *            The {@link SourceSystem} object to upsert.
   * @params sourceCollections
   *            The list of {@link SourceCollection} objects to upsert.
   * @params sources
   *            The list of {@link Source} types to upsert.
   * @params targets
   *            The list of {@link Target} types to upsert.
   * @params transforms
   *            The list of {@link Transform} objects to upsert.
   * @params synchronous
   *            If set to true, it waits up to one minute for changes to propagate across all nodes;
   *            if not propagated within that time, the API will fail and roll back the upserted pipeline.
   *
   * @return void. An exception will be thrown if the pipeline upsert fails.
   */
  upsertPipeline: private function(sourceSystem: SourceSystem,
                                   sourceCollections: [json],
                                   sources: [TypeMeta],
                                   transforms: [json],
                                   targets: [TypeMeta],
                                   synchronous: boolean = false)
}
