/**
 * {@link Source} objects that failed during {@link Source#process}
 */
type FailedSource {

  /**
   * The error associated with the #source that failed
   */
  @db(persistAllFields=true)
  error: ObjSourceError schema suffix 'OE'

  /**
   * The {@link Source} object that failed
   */
  source: Obj

  /**
   * The target type for which this error occurred for this source.
   * one source per error will be generated for each target type.
   */
  targetType: Type

  /**
   * The transform type for which this error occurred for this source.
   * one source per error will be generated for each transform.
   */
  transformName: string

  /**
   * Record number of this failed record in the given content
   * For global exceptions, the recordNumber would be reported as -1
   */
  offsetInParentSources: int

  fromString: function(s: !string): FailedSource
  toString:   member function(): string
}
