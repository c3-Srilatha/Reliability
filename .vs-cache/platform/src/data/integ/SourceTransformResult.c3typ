/**
 * Result of a canonical content transformation.
 */
type SourceTransformResult mixes DataIntegStatsBase {

  /**
   * the transformed objs
   */
  objs: [Obj]

  /**
   * map containing the target type name and the transformed objs
   */
  objsByTargetType: map<string, [Obj]>

  /**
   * map containing the target type name and the transformed objs
   */
  stats: SourceTransformStats

  /**
   * map of the canonical obj index and the transformation error for the obj of that index in the CanonicalFile
   */
  errors: map<int, Error>

  /**
   * List of indexes for canonical records being transformed
   */
  recordNumbers: [int]

  /**
   * Adds the result object values to the result object it is called on and returns a new SourceTransformResult
   * object. The objs of each type are appended to the existing objs.
   *
   * @param result object to add the values from
   * @result SourceTransformResult object with merged result
   */
  add: private member function(result: !SourceTransformResult): !SourceTransformResult

  /**
   * Adds the objs to the existing objs and returns a new SourceTransformResult object
   *
   * @param objs objs to add
   * @result SourceTransformResult object with merged result
   */
  addObjs: private member function(objs: !?map<string, [Obj]>): !SourceTransformResult

  /**
   * Adds the objs to the existing objs and returns a new SourceTransformResult object
   *
   * @param objs objs to add
   * @result SourceTransformResult object with merged result
   */
  addErrors: private member function(errors: !?map<int, Obj>): !SourceTransformResult
}
