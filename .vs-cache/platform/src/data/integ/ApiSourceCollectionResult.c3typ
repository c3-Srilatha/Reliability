/**
 * Result type containing content from an api source collection e.g. Jira, Salesforce, etc.
 */
type ApiSourceCollectionResult {

  /**
   * Stream of data produced as a result of {@link ApiSourceCollection#lambda} execution
   */
  result: stream<any>

  /**
   * Are there more objects left to process from the Source collection
   */
  hasMore: boolean

  /**
   * Checkpoint to be used for the next call to {@link ApiSourceCollection#lambda}
   */
  checkpoint: Checkpoint
}
