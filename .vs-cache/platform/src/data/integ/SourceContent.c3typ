/**
 * Represents the {@link Sources} staged in Cassandra
 */
@db(datastore="kv", compactType=true, partitionKeyField='id', persistDuplicates=false)
extendable entity type SourceContent mixes ContentValue, Sources schema name 'SRC_CNT' {

  /**
   * if the sources is a chunk this is instantiated with the sources id.
   */
  parentSourcesId: private string

  /**
   * adding id of Sources here instead of id because of improving cassandra create and get speeds.
   */
  sourcesId: private string

  fromString: ~
}
