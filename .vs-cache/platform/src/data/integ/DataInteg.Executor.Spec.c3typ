/**
 * Additional specifications for executing a {@link DataInteg.Pipeline}
 */
type DataInteg.Executor.Spec mixes Spec {

  /**
   * If true, executor will execute pipeline synchronously and will only return once finished
   */
  synchronous: boolean
}
