/**
 * Base type for data integration step status.
 */
@db(index+=['rootSourceStatus', 'parentStatus'])
extendable entity type DataIntegStatus schema name 'DI_STATUS' {

  /**
   * A reference to {@link SourceStatus} of the initial / root Sources. Will be `null` for root SourceStatus.
   */
  rootSourceStatus: SourceStatus

  /**
   * Returns a reference to the parentStatus object, which is a {@see SourceStatus}, {@see SourceChunkStatus}, or
   * {@see TransformStatus} object.
   */
  parentStatus: DataIntegStatus

  /**
   * Array of statuses of immediate transforms optionally filtered by provided transform type.
   */
  transforms: [TransformStatus](parentStatus)

  /**
   * Array of statuses of immediate targets optionally filtered by provided transform type.
   */
  targets: [TargetStatus](parentStatus)

  /**
   * The {@see TypeRef} of the Sources for which the stats are being stored
   */
  sourceType: !Type

  /**
   * fingerprint id of the {@see DataIntegSpec} for fetching the corresponding merged specs.
   */
  @deprecated(finalVersion='8.4', details='use spec instead')
  specId: string

  /**
   * {@link DataIntegSpec} for the corresponding merged specs.
   */
  spec: DataIntegSpec

  /**
   * Specifies the current state of the current data integration step. See {@link SourcesState} for the different
   * state transitions.
   */
  state: !string enum SourcesState

  /**
   * The number of objects participating at this data integration step.
   */
  count: !int

  /**
   * The number of objects successfully processed at this data integration step.
   */
  successful: !int

  /**
   * The number of objects that were skipped at this data integration step.
   */
  skipped: !int

  /**
   * The number of objects that failed to process at this data integration step.
   */
  failed: !int

  /**
   * The total count of errors (including downstream errors) encountered when attempting to transform / persist sources
   * from this stage of the data integration pipeline.
   */
  totalErrorCount: !int

  /**
   * List of first 100 errors in this data integration step.
   */
  errors: [FailedSource] schema suffix 'E'

  /**
   * Error Msg up to 4000 characters to give insights into the actual failure, rather than going through the entire
   * rejected (or) failed sources.
   */
  firstError: string

  /**
   * A reference to the {@link SourcesStatus} of the immediate parent SourceStatus. Will be `null` for root
   * SourceStatus.
   */
  parentSourceStatus: member function(): SourceStatus

  /**
   * A reference to the {@link SourcesChunkStatus} for immediate parent Chunk. Note this could be `null` for root
   * SourceStatus or if Sources are not being chunked.
   */
  parentChunkStatus: member function(): SourceChunkStatus

  /**
   * A reference to the {@link TransformStatus} of transformation of parent Sources or Chunk. Note that this
   * is `null` in the first layer because the data is obtained from a file or a queue, not from a transformation.
   */
  parentTransformStatus: member function(): TransformStatus

  /**
   * @return `true` if the state is "initial"
   */
  isInitial: member function(): boolean

  /**
   * @return `true` if the state is "completed"
   */
  isCompleted: member function(): boolean

  /**
   * @return `true` if the state is "processing"
   */
  isProcessing: member function(): boolean

  /**
   * @return `true` if the state is "failing"
   */
  isFailing: member function(): boolean

  /**
   * @return `true` if the state is "rejecting"
   */
  isRejecting: member function(): boolean

  /**
   * @return `true` if the state is "failed"
   */
  isFailed: member function(): boolean

  /**
   * @return `true` if the state is "rejected"
   */
  isRejected: member function(): boolean

  /**
   * @return `true` if the state is a final state
   */
  isFinal: member function(): boolean

  /**
   * @return `true` if this is `SourceStatus`
   */
  isSource: inline member function(): boolean

  /**
   * @return `true` if this is `SourceChunkStatus`
   */
  isChunk: inline member function(): boolean

  /**
   * @return `true` if this is `TransformStatus`
   */
  isTransform: inline member function(): boolean

  /**
   * @return `true` if this is `TargetStatus`
   */
  isTarget: inline member function(): boolean

  /**
   * @return an array of statuses of immediate chunks
   */
  safeChunks: member function(): stream<SourceChunkStatus>

  /**
   * @return an array of statuses of immediate transforms
   */
  safeTransforms: member function(): stream<TransformStatus>

  /**
   * @return an array of statuses of immediate targets
   */
  safeTargets: member function(): stream<TargetStatus>

  /**
   * Load all nested steps of processing this {@link Sources}
   */
  all: member function(): !SourceStatus

  /**
   * Collect all errors from all nested steps of processing this {@link Sources}
   */
  allErrors: member function(): stream<FailedSource>

  /**
   * Streams the errors from {@link allErrors} using the given offset and limit.
   * (We need to implement this in Java, since the JavaScript stream implementation
   * does not handle offset or limit).
   */
  errorsInRange: member function(offset: int, limit: int): stream<FailedSource>

  /**
   * @return a stream of statuses of immediate and nested chunks
   */
  allChunks: member function(): stream<SourceChunkStatus>

  /**
   * @return a stream of statuses of immediate and nested transforms
   */
  allTransforms: member function(): stream<TransformStatus>

  /**
   * @return a stream of statuses of immediate and nested targets
   */
  allTargets: member function(): stream<TargetStatus>

  /**
   * @return a array of statuses of all immediate and nested data integration steps
   */
  allChildren: member function(): stream<DataIntegStatus>

  /**
   * @return a stream of statuses of all immediate and nested sources( including {@link SourceChunkStatus})
   */
  allSources: member function(): stream<SourceStatus>

  /**
   * generates an id for status entry for this instance.
   */
  // TODO: PLAT-16885: make is abstract member after the code compiles
  generateId: private inline function(child: !string, parent: string): !string

  /**
   * updates current state and stats based on immediate child statuses.
   */
  updateStatus: private member function(): !string
}
