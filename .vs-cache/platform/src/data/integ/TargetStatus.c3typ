/**
 * The following captures the statistics for targets in the data integration process. Target can either be a Persistable
 * entity type or a Source type.
 */
entity type TargetStatus extends DataIntegStatus type key 'TARGET' {

  /**
   * Target type of this status. Note that if this is a SourceStatus then #targetType field will be same as #sourceType.
   */
  targetType: !Type

  /**
   * Database operation statistics if this target is Persistable, otherwise `null`.
   */
  dbStats: PersistableTargetStats

  /**
   * Creates a TargetStatus object from PersistableTargetStats object
   */
  fromPersistableTargetStats: private inline function(stats: !PersistableTargetStats): TargetStatus
}
