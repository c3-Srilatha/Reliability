/**
 * Options for DataIntegrator#transformSources action.
 */
type TransformSourcesSpec mixes TransformObjsSpec {

  /**
   * A list of objs uploaded by users, which are usually existing in memory and not persisted yet.
   */
  objs: [Obj]

  /**
   * A list of pairs of {@link SourceCollection} names and {@link ObjsOperSpec}s, used to load source objs from source collections.
   */
  sourceCollectionSpecs: [{ name: !string, spec: ObjsOperSpec }]

  /**
   * A list of {@link Transform} instances to apply to the objects.
   */
  transforms: [Transform]

  /**
   * Specifies which fields to bring back values for in the returned objs of target type in the last transform of
   * {@link #transforms}. Excluded fields are dropped from the transform/projection evaluation results.
   * see {@link Include}
   */
  include: string serialized Include
}
