/**
 * "writable" or in memory buffer of {@link Sources}
 */
type SourceBuffer mixes ContentBuffer, Sources {

  /**
   * @return an empty SourceBuffer
   */
  init: function(sc: !SourceCollection,
                 contentType: string = 'application/json',
                 contentEncoding: string = 'snappy'): SourceBuffer
}
