/**
 * Configurable options for {@link SourceFile#removeWithData}
 */
type SourceFile.RemoveWithDataSpec mixes Spec {

  /**
   * If true, {@link SourceFile#removeWithData} will not delete the underlying
   * file at {@link SourceFile#contentLocation}
   */
  retainSourceFileContent: boolean

  /**
   * If true, will not call {@link SourceStatus#removeAll} and {@link DataIntegStatus#removeAll}
   * to delete the status
   */
  retainSourceStatus: boolean
}
