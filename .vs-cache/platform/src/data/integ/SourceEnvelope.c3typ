/**
 * Marker type for data integration to embed or refer to sources
 */
abstract type SourceEnvelope<S: Source, C> {

  /**
   * Instance of Source
   */
  value: S

  /**
   * Instances of Source
   */
  values: [S]

  /**
   * Reference to the instances of Source either urlOrEncodedPath or instance of #ContentRef
   */
  content: C

  /**
   * List of references to the instances of Source either urlOrEncodedPath or instance of #ContentRef
   */
  contents: [C]

  /**
   * Use this function to get source objs for the envelope
   * @return the stream of Source objs for the envelope
   */
  readObjs: inline member function(spec: FileObjsOperSpec): stream<Obj>

  /**
   * @return the urls for the contentRefs
   */
  fileUrls: inline member function(): [string serialized FileUrl]

  /**
   * @return instances of Sources from #value and #values
   */
  valueObjs: inline member function(): [S]

  /**
   * process is used to import the source data. This method is tenant/tag context aware.
   * It imports based on the context of tenant/tag where it is being imported.
   * @return result of the processing/data-load
   */
  process: inline member function(spec: FileObjsOperSpec): !SourceImportDataResult
}
