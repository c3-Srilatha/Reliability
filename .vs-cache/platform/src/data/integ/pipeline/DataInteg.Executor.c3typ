/**
 * The coordinator which triggers execution of a {@link DataInteg.Pipeline}. An appropriate engine will be chosen for each
 * {@link DataInteg.Step} based on its configuration. In the case of heterogeneous engine pipelines, the executor will
 * manage asynchronous execution, parallelize or distribute independent steps, collect outputs, and invoke downstream
 * steps.
 */
@db(unique=['pipeline'])
entity type DataInteg.Executor {

  /**
   * Which pipeline to start
   */
  pipeline: !DataInteg.Pipeline

  /**
   * Status information about the execution of this pipeline on the current instance
   */
  _status: private JobStatus

  /**
   * Any intermediate results persisted between {@link DataInteg.Step}s (id) and their output on the current instance
   */
  _results: private map<string, DataInteg.Pipeline.Step.Output>

  /**
   * Will execute the steps in the {@link DataInteg.Pipeline}.
   */
  executePipeline: member function(spec: DataInteg.Executor.Spec): !DataInteg.Executor

  /**
   * Status information about the execution of this pipeline
   */
  status: member function(): JobStatus

  /**
   * Any intermediate results persisted between {@link DataInteg.Step}s (id) and their output
   */
  results: member function(): map<string, DataInteg.Pipeline.Step.Output>
}
