/**
 * DataInteg.Pipeline.Step.Output contains information that is passed as output to the next {@link DataInteg.Pipeline.Step}s. The details
 * are based upon implementation use in {@DataInteg.Engine}.
 */
type DataInteg.Pipeline.Step.Output {

  /**
   * Information about the state of the output; completed, failed, etc.
   */
  status: string enum JobStatusEnum

  /**
   * If the step has failed, this will contain the reason why it failed
   */
  errorMessage: string

  /**
   * The value of the output
   */
  data: any
}
