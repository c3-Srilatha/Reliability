/**
 * Additional specifications of a {@link DataInteg.Pipeline}
 * runtime configurations over pipeline execution.
 */
type DataInteg.Pipeline.Config mixes Config, Identified {

  /**
   * The default is "0 0 0 * * ?", which means it runs every day at midnight.
   */
  processSchedule: string serialized CronSchedule = "0 0 0 * * ?"
}
