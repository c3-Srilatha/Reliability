/**
 * DataInteg.Engine is an execution engine that drives the execution of a {@link DataInteg.Step}. Different engines exist
 * that can drive execution using SQL, Spark, or other hybrid solutions.
 */
abstract type DataInteg.Engine<I: DataInteg.Pipeline.Step.Input, O: DataInteg.Pipeline.Step.Output, C: DataInteg.Engine.Config> mixes WithId, Configurable<C> {

  /**
   * Performs the execution of a {@link DataIntegStep}.
   *
   * @param step
   *            The step to execute
   * @param pipeline
   *            The pipeline which provides context of the source collection and adjacent steps
   * @param input
   *            Engine-specific input which provides additional input parameters to drive execution of the step
   * @return
   *            Engine-specific output which is used as input to the next step
   */
  executeStep: abstract member function(step: DataInteg.Pipeline.Step, pipeline: DataInteg.Pipeline, input: I): O

  configKey: ~
}
