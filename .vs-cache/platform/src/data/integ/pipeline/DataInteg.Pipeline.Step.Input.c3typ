/**
 * DataInteg.Pipeline.Step.Input contains information that is passed as input to the next {@link DataInteg.Pipeline.Step}s. The details
 * are based upon implementation use in {@DataInteg.Engine}.
 */
type DataInteg.Pipeline.Step.Input {

  /**
   * The combined output from all dependent {@link DataInteg.Pipeline.Step}s,
   * follows the order specified in {@link DataInteg.Pipeline}.
   */
  outputsFromDependencies: [DataInteg.Pipeline.Step.Output]
}
