/**
 * Runtime configurations for writing to a datalake table from a {@link SourceCollection}.
 */
type DataInteg.Pipeline.Step.Load.OutputConfiguration.DataLakeConfig mixes DataInteg.Pipeline.Step.Load.OutputConfiguration.Config, DataLake.Table.WriteSpec {

  /**
   * Specifications for creating a table if missing;
   * if empty, table is inferred using DataLake.CreateTableSpec.fromSource
   */
  createTableSpec: DataLake.CreateTableSpec

  /**
   * The datalake catalog instance
   */
  catalog: string

  /**
   * Target folder name in the Data Lake
   */
  folderName: string

  /**
   * Format of files to be written (e.g., parquet, csv)
   */
  fileFormat: string

  /**
   * File path to write data
   */
  filePath: string

  /**
   * Object path in the storage
   */
  objectPath: string
}
