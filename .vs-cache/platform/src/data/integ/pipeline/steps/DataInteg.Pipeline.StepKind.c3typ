/**
 * DataInteg.Pipeline.StepKind describes specific steps in a pipeline.
 */
enum type DataInteg.Pipeline.StepKind {

  SYNC

  TRANSFORM

  LOAD

  /**
   * used for the GenAI single step pipeline only -
   * May be removed later if the orchestration layer for steps is moved to platform.
   */
  GENAI_SINGLE_PROCESS_STEP
}
