/**
 * This step is responsible for writing to a datastore from a {@link FileSourceCollection}
 */
type DataInteg.Pipeline.Step.Load.OutputConfiguration.DataLake mixes DataInteg.Pipeline.Step.Load.OutputConfiguration<DataInteg.Pipeline.Step.Load.OutputConfiguration.DataLakeConfig> {

  datastore: ~ = "datalake"

  /**
   * Retrieves the catalog associated with this step.
   * This method is used to access metadata and configuration related to the data lake catalog.
   *
   * @return The DataLake.Catalog instance.
   */
  dataLakeCatalog: private member function(): DataLake.Catalog

  /**
   * Helper function to return the table specification associated with this step.
   * If missing, it creates the default spec based on the given source collection.
   *
   * @param sourceCollection The source collection from which to derive the table spec.
   * @return The DataLake.CreateTableSpec instance.
   */
  dataLakeCreateTableSpec: private member function(sourceCollection: SourceCollection): DataLake.CreateTableSpec
}
