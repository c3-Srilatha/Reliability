/**
 * DataInteg.Pipeline is a sequence of steps which represents a series of instructions needed to integrate data
 * starting from a {@link SourceCollection} and ending into a c3 {@link Datastore}. The pipeline consists of a series of
 * {@link DataInteg.Pipeline.Step}s, similar to a vertex in a graph. These steps correspond to actions that are executed by a
 * {@link DataInteg.Engine}. Different steps can contain different engines, supporting heterogeneous runtime execution.
 *
 * Each pipeline has a type, such as Structured or Unstructured. For example, a structured
 * DataInteg.Pipeline might look like the following:
 * ┌────────────┐     ┌────────────┐     ┌────────────┐     ┌────────────┐
 * │            │     │            │     │            │     │            │
 * │    SYNC    ├────►│   CHUNK    ├────►│   IMPORT   ┼────►│   ARCHIVE  │
 * │            │     │            │     │    DATA    │     │            │
 * │            │     │            │     │            │     │            │
 * └────────────┘     └────────────┘     └────────────┘     └────────────┘
 */
@seed(userUpdatable=true)
type DataInteg.Pipeline mixes PyReprProtocol, PyReprHtmlProtocol, Configurable<DataInteg.Pipeline.Config>, SeedData {

  /**
   * The starting point of a pipeline
   */
  source: SourceCollection

  /**
   * The steps in the pipeline
   */
  @db(persistAllFields=true)
  steps: ![!DataInteg.Pipeline.Step]

  /**
   * The type of the pipeline which determines its default execution flow. It can be STRUCTURED or UNSTRUCTURED.
   */
  kind: string enum DataInteg.PipelineKind

  /**
   * Map of dependencies for a single step to a list of its dependent steps. If empty, assume linear execution of steps
   */
  stepDependencies: map<string, [string]>

  _repr_:     ~
  _reprHtml_: ~

  /**
   * Pipeline looks like the following:
   * ┌────────────┐     ┌────────────┐
   * │            │     │            │
   * │    SYNC    ├────►│   LOAD     |
   * │            │     │            │
   * └────────────┘     └────────────┘
   * In SYNC, it identifies and captures changes made to data in the source collection, allowing downstream systems to
   * stay synchronized with the source data
   * In LOAD, it loads source data into dataLake's table. Table name is the type name of {@link SourceCollection#source}
   */
  // TODO: PLAT-122874: support source collection other than file source collection
  createDefaultDataLakePipeline: private function(sourceCollection: SourceCollection,
                                                  partitionExpressions: [string serialized Expr]): DataInteg.Pipeline

  /**
   * Create a default dataLake pipeline (if missing) and starts a cron job that periodically synchronizes data
   * from the specified source collection to the data lake.
   * This ensures that changes in the source collection are regularly reflected in the data lake tables.
   * Currently, csv, parquet, json, avro, orc files are supported
   *
   * @param sourceCollection The source collection to synchronize.
   * @param partitionExpressions List of {@link Expr} that defines how the table is partitioned.
   * @return the default dataLake pipeline and the cron job instance responsible for the synchronization process
   */
  syncToDataLake: function(sourceCollection: SourceCollection,
                           partitionExpressions: [string serialized Expr]): Pair<DataInteg.Pipeline, CronJob>

  /**
   * Pauses the cron job that synchronizes data from the specified source collection to the data lake.
   * This will halt further periodic synchronization until {@link #syncToDataLake} is called again.
   *
   * @param sourceCollection The source collection whose synchronization should be stopped.
   */
  pauseSyncToDataLake: function(sourceCollection: SourceCollection)
}
