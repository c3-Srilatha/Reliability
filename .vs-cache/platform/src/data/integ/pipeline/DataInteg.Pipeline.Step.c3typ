/**
 * DataInteg.Pipeline.Step describes the action that will be executed by the {@link DataInteg.Engine}.
 */
abstract type DataInteg.Pipeline.Step<C: DataInteg.Pipeline.Step.Config> mixes Configurable<C>, SeedData {

  /**
   * The engine determines where and how to execute a corresponding step. This could be sql, spark, or different
   * engine altogether.
   */
  engine: !DataInteg.Engine

  /**
   * The type of the step which determines what to execute on the {@link DataInteg.Engine}
   */
  kind: !string

  configKey: ~
  input:     DataInteg.Pipeline.Step.Input
  output:    DataInteg.Pipeline.Step.Output
}
