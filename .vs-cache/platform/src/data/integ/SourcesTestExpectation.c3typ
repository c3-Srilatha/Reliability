type SourcesTestExpectation {

  /**
   * The type of the input file
   */
  sourceType: string

  /**
   * The expected status(for the root sources) after transforming and persisting
   */
  state: string enum SourcesState

  /**
   * The expected stats (for the root sources) after transforming and persisting
   */
  stats: SourceStatus

  /**
   * The expected errors after transforming and persisting (represented as a regular expression)
   */
  errors: [string]

  /**
   * A map from a source instance id to a string of errors (represented as a regular expression)
   */
  failedSourcesBySources: map<string, string> schema name 'FS'

  /**
   * A map from a source instance id to the number of expected errors
   */
  errorCountBySources: map<string, int> schema name 'FSEC'

  /**
   * A map from source type to the stats for the source. If needed, another map from sourcesId to stats may also be
   * added to the test for specific paths in the transformation DAG.
   */
  sourceStatus: map<string, SourceStatus> schema name 'S'

  /**
   * A map from transform type name to the stats for the transform. If needed, another map from transformId to Stats
   * may also be added to test for specific paths in transformation DAG.
   */
  transformStatus: map<string, TransformStatus> schema name 'T'

  /**
   * A map from the {see Persistable} type name to the stats. If needed, another map from persistableId to stats may
   * also be added to test for specific paths in the transformation DAG.
   */
  targetStatus: map<string, TargetStatus> schema name 'P'
}
