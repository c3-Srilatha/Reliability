/**
 * This holds the result statistics returned from canonical import
 */
type SourceImportDataResult {

  /**
   * status returned from import
   */
  status: string enum SourcesState

  /**
   * summary of errors returned on import
   */
  errorSummary: string

  /**
   * Holds statistics related to source import
   */
  stats: SourceImportDataStats

  /**
   * Holds {@link SourceStatus} objects that have to be upserted by the invalidation queue
   */
  sourceStatus: [SourceStatus]

  /**
   * Holds {@link TransformStatus} objects that have to be upserted by the invalidation queue
   */
  transformStatus: [TransformStatus]

  /**
   * Holds {@link TargetStatus} objects that have to be upserted by the invalidation queue
   */
  targetStatus: [TargetStatus]

  /**
   * @return an array of {@link FailedSource} that are consolidated from the DataIntegStatus objects above
   */
  errors: member function(): [FailedSource]
}
