/**
 * Record stats for loading of source file
 */
@deprecated(finalVersion='7.9', details='Use SourceStatus instead')
private type SourceFileRecordStats {

  /**
   * Number of records in the source file
   */
  recordCount: int

  /**
   * Number of records that failed in the source file
   */
  failedRecordCount: int

  /**
   * Number of records that were rejected in the source file
   */
  rejectedRecordCount: int

  /**
   * Number of records that were successfully transformed in the source file
   */
  successfulRecordCount: int

  /**
   * Number of chunks created for this source file. Value is set when {@link FileSourceCollection#jmsDisabled} is false
   */
  chunkCount: int
}
