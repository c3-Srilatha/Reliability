/**
 * Result type for operations that remove secret fields from a credentials and need to report
 * which secret fields were found and removed.
 */
type CredentialsWithMaskedSecrets<CREDS: any> {

  /**
   * The credentials with all secret fields removed (recursively)
   */
  credentialWithoutSecrets: !CREDS

  /**
   * List of field paths that contained secret values and were removed.
   * Field paths use dot notation (e.g., "user.password", "credentials.apiKey")
   */
  removedSecretFields: ![string]
}
