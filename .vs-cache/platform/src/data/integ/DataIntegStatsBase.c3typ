/**
 * Hold common APIs shared in source transform phase.
 */
abstract private type DataIntegStatsBase {

  /**
   * Adds the stats from input ActionStats object and returns a new stats object
   *
   * @param actionStats ActionStats object to append the values from
   * @return DataIntegStatsBase object with added data
   */
  addActionStats: abstract member function(actionStats: ActionStats): !mixing DataIntegStatsBase
}
