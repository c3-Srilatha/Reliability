type CloudMessageSourceSystem mixes SourceSystem<SourceSystem.Config, CloudCredentials> {

  /**
   * List all cloud message brokers that satisfies the given spec.
   *
   * @param spec
   *           Specifications for the match criteria.
   * @return all cloud message brokers satisfying the spec.
   */
  cloudMessageBrokers: member function(spec: CloudMessageBrokerListSpec)
                                : !CloudListResourcesResult<CloudMessageBroker>

  ping: ~

  /**
   * This will set default credentials that can be used for {@link CloudMessageSourceCollection}#setCredentials
   */
  setCredentials: ~
}
