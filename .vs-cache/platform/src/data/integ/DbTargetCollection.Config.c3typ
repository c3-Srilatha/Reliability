type DbTargetCollection.Config mixes DataIntegFields, Named, MergeSpec, Config {

  /**
   * If set to false then attempt will be made to locate an existing object either by
   * provided id if match is found than it will be updated instead of creating a new object. Default is false
   */
  createOnly: boolean

  /**
   * In order to decrease the number of writes to database during dataloading,
   * user can set this field to true in a transform type. When true, the entity type
   * c3 objs in transform results are staged in FileSystemMount.DATA_LOAD/stage/ as
   * files and later get moved to databases in batch using a cron job
   */
  stageUpdates: boolean

  /**
   * If createOnly parameter is false and match is found then this parameter controls
   * existing object's update semantic; possible options are "replace" in which case
   * existing object will be removed and new one will be created with the same id or
   * "merge" in which case only provided field values will be updated.
   */
  updateMode: string enum ImportDataUpdateModeEnum = merge

  /**
   * Flag to indicate whether the values of {@link Meta#updated}, {@link Meta#updatedBy}, {@link Meta#created} and
   * {@link Meta#createdBy} will be overridden or defaulted to the current time and user
   * making the request while using {@link MergeSpec}.
   */
  noMetaOverride: boolean
}
