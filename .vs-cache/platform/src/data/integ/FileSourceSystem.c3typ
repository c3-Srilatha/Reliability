@cache(dependencies=['SourceSystem', 'FileSourceCollection'])
type FileSourceSystem mixes SourceSystem<SourceSystem.Config, CloudCredentials>, FileInfoOverride {

  /**
   * This feature is used to create the SourceFileInfo specific for a FileSourceSystem
   * see {@link FileInfoOverride #fileInfoOverride}
   * ```
   * var fss  = FileSourceSystem.get(<MyFileSourceSystem>);
   * fss.putField('fileInfoOverride', overrideLambda).upsert();
   * ```
   * This lambda will be then applied to all files being processed and you don't have to change the systems that generate
   * the files.
   * SourceFileInfo can be generated using any custom logic which can be applied here.
   * if fileInfoOverride is set in {@link FileSourceCollection} it will override this fileInfoOverride
   * @see Lambda to create a Lambda object.
   */
  fileInfoOverride: ~

  setCredentials:    ~
  credentials:       ~
  removeCredentials: ~

  /**
   * Check the file source system for connectivity.
   *
   * @return the results of checking the file source system for connectivity.
   */
  ping: ~

  /**
   * Registers {@link FileSourceSystem#rootUrlOverride} to allow for successful Data Integration.
   * This method will set a {@link FileSystem} mount based on the {@link FileSourceSystem}
   * NOTE: if the rootUrl for the {@link FileSourceSystem} changes, it will need to be registered again.
   */
  @beta
  register: private member function()

  /**
   * Unregisters a mount set by {@link FileSourceSystem#register}
   * This method will remove any mount set by the {@link FileSourceSystem}
   */
  @beta
  unregister: private member function()
}
