/**
 * Specifies the input data used to import the given canonical
 */
type SourceImportDataSpec mixes Spec {

  /**
   * The content to import, content can be in xml, json (or) csv
   */
  content: ContentRef

  /**
   * the sources to transform and persist
   */
  data: Sources

  /**
   * The abstract content
   */
  fileOperSpec: FileObjsOperSpec

  /**
   * If meta is specified, it is used to override the meta values in the target types being imported
   */
  meta: Meta

  /**
   * chunk id passed to create partition key for FileData target type
   */
  chunkId: private string

  /**
   * if set to true then target objs will include {@link Sources#sourcesMeta}
   */
  includeMeta: boolean
}
