/**
 * SourceFile is the prime place for loading and monitoring files loaded into C3.
 *
 * After defining and configuring {@link FileSourceCollection} for the SourceFile, data can be loaded using APIs defined
 * here.
 *
 * This type contains meta information about the file being loaded into the platform as well as contains APIs for
 * loading data and monitoring dataload.
 */
@db(index+=['contentLocation'])
entity type SourceFile mixes SourceContentMeta, Sources schema name 'DATALOAD_CANFL' {

  /**
   * SourceFileInfo derived from the #contentLocation.
   * {@see Source#parseFileName}
   */
  fileInfo: SourceFileInfo schema name 'INFO'

  // TODO: PLAT-124369: Split SourceFile#Status out of SourceFile.c3typ and put it on SourceFile.PipelineStatus

  /**
   * A foreign key reference to the {@see SourceStatus} entry in the db for the SourceFile instance
   */
  status: SourceStatus(id)

  pipelineStatuses: [Sources.PipelineStatus](sourcesId)

  /**
   * Syncs and updates the SourceFile entry with the following metadata if anything changed since last sync
   * #id #source #sourceCollection #fileInfo and all {@link ContentMeta} information.
   * @return SourceFile after being synced.
   *         {@see DataIntegSpec#include}
   */
  sync: member function(spec: DataIntegSpec): SourceFile

  /**
   * Performs #sync operation on a set of files specified by urlOrEncodedPath
   * @param urlOrEncodedPath files under the urlOrEncodedPath that need to be synced
   *        if null then it will create FileSystemBatchJob for each {@link FileSourceCollection} configured on the tag.
   * @param spec {@see DataIntegSpec} - Note: the synchronous field in DataIntegSpec will be ignored and set to false internally
   */
  syncAll: function(urlOrEncodedPath: string, spec: DataIntegSpec): [FileSystemBatchJob]

  /**
   * Performs #sync operation on a batch of SourceFiles
   * @return SourceFiles after being synced.
   *        {@see DataIntegSpec#include}
   */
  syncBatch: function(files: ![SourceFile], spec: DataIntegSpec): [SourceFile]

  /**
   * Performs #sync operation on a batch of SourceFile ids
   * @return SourceFiles after being synced.
   *        {@see DataIntegSpec#include}
   */
  syncBatchWithId: function(fileIds: ![string], spec: DataIntegSpec): [SourceFile]

  /**
   * Performs #syncFileMetadata on a batch of {@link File}
   * @param
   *      file
   * @param
   *      spec {@see DataIntegSpec}
   * @return {@link SourceFile} created for the files after being synced.
   */
  syncFileMetadataBatch: function(files: ![File], spec: DataIntegSpec): [SourceFile]

  /**
   * Syncs metadata of a {@link File}
   * updates the SourceFile entry with the following metadata if anything changed since last sync
   * #id #source #sourceCollection #fileInfo and all {@link ContentMeta} information.
   * @return SourceFile created for the file after being synced.
   *        {@see DataIntegSpec#include}
   */
  syncFileMetadata: function(file: !File, spec: DataIntegSpec): SourceFile

  /**
   * Performs #process on a list of SourceFile objects satisfying the spec
   * @param spec used to filter source files {@link DataIntegSpec}
   */
  processAll: function(spec: DataIntegSpec)

  /**
   * Performs #process on a batch of SourceFiles
   * @param sources batch of sourceFiles to process
   * @param spec {@see SourceFileProcessSpec}
   */
  processBatch: function(sources: !?[SourceFile], spec: DataIntegSpec)

  /**
   * Performs #process operation on a batch of SourceFile ids
   * @param sources batch of sourceFile ids to process
   * @param spec {@see SourceFileProcessSpec}
   */
  processBatchWithId: private function(fileIds: ![string], spec: DataIntegSpec)

  /**
   * Performs #process on a stream of SourceFiles
   * @param sources stream of sourceFiles to process
   * @param spec {@see SourceFileProcessSpec}
   */
  processStream: function(sources: stream<SourceFile>, spec: DataIntegSpec)

  /**
   * Stops a running #sync OR #process thus causing the source file status to be stopped eventually.
   * Once a source file is stopped it will only be synced and never be processed
   * the source file will only resume processing after #resume or #resumeBatch is invoked.
   */
  @beta
  stop: member function()

  /**
   * Performs #stop on a batch of SourceFiles.
   */
  @beta
  stopBatch: function(files: !?[SourceFile])

  /**
   * Updates the status of SourceFile to initial and #sync them
   * @param spec {@see DataIntegSpec} if process is set to true it will process the file as well.
   */
  @beta
  resume: member function(spec: DataIntegSpec): SourceFile

  /**
   * Performs #resume on a batch of SourceFiles.
   */
  @beta
  resumeBatch: function(files: !?[SourceFile], spec: DataIntegSpec): [SourceFile]

  /**
   * Performs validation on the SourceFile before #process
   * 1) checks if the #sourceCollection source field matches the #source type.
   * 2) source in SourceFile is of type Source
   * @return validated SourceFile
   */
  validate: member function(): SourceFile

  /**
   * @return a {@link File} object for the source file derived from the contentLocation.
   */
  toFile: member function(): File

  /**
   * @return a {@link File} object for the source file derived from the contentLocation, safeContentType and safeContentEncoding.
   */
  toInferredFile: member function(): File

  /**
   * Returns source file for the urlOrEncodedPath
   * @param urlOrEncodedPath the urlOrEncodedPath of the file
   * @param include string of field values to return for the SourceFile object
   * @param failIfMissing if set to true it will fail for missing source files.
   */
  forUrl: function(urlOrEncodedPath: !string, include: string, failIfMissing: boolean): SourceFile

  /**
   * @param chunkId
   *        chunk id for the file
   * @param include
   *        string of field values to return for the SourceFile object
   * @param failIfMissing
   *        if set to true it will fail for missing source files.
   * @return source file for the chunkId from the JmsQueue.
   */
  forChunkId: function(chunkId: !string, include: string, failIfMissing: boolean): SourceFile

  /**
   * Deletes all entries in SourceFile as specified in processSpec.
   * Also creates stats file {@see writeStatsFile}
   */
  archiveAll: function(spec: DataIntegSpec)

  /**
   * @return the archiveUrl for this SourceFile
   */
  archiveUrl: private member function(): !string

  /**
   * @return the inboxUrl for this SourceFile
   */
  inboxUrl: private member function(): !string

  /**
   * Deletes this sourceFile as well as the data associated with it,
   * including the SourceFile itself, its underlying content, and any upserted targets
   * that are connected via {@link Meta#sourceFile}.
   */
  removeWithData: member function(spec: SourceFile.RemoveWithDataSpec): !boolean

  /**
   * Schedules a {@link BatchJob} to delete sourceFiles and associated data
   * @param sourceFileIds
   *          The ids of the files to delete
   * @return the job associated with the source files
   */
  removeWithDataBatch: function(sourceFileIds: [string]): SourceFile.RemoveWithDataBatchJob

  /**
   * @return stream of SourceFiles for SourceCollection
   * if sc is null it will return all SourceFile
   */
  sourceFilesForSourceCollection: private function(sc: SourceCollection): !stream<SourceFile>

  // TODO: PLAT-35287 Verify and remove parseFileName, fileNameFormat methods

  /**
   * Override this method to implement custom parsing of the canonical filename.
   * First fetch the format using the collection, and check if it is present. Modify the fileName to the one
   * expected by the format, and then call fileNameFormat.parseFileName(newfileName);
   *
   * By default, it replaces "Canonical_" with "Canonical" to detect the CanonicalType
   *
   * @param fileName name of the file
   * @param fsc the file source collection for the file
   * @return SourceFileInfo with all the relevant fields populated
   */
  parseFileName: private function(fileName: string, fsc: FileSourceCollection): SourceFileInfo
}
