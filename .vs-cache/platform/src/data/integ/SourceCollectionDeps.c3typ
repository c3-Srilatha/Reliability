type SourceCollectionDeps mixes MetadataDeps<SourceCollection<SourceCollection.Config>> {

  /**
   * The source type of this SourceCollection
   */
  source: string serialized Type

  /**
   * The sourceSystem type of this SourceCollection
   */
  sourceSystem: !string serialized Type = 'Canonical'

  /**
   * The subtype of this SourceCollection
   */
  subType: string serialized Type

  /**
   * The name of the most recent package where the SourceCollection is overridden
   */
  pkgName: !string
}
