/**
 * Specifies parameters for transforming canonical content.
 */
type SourceTransformSpec mixes Spec {

  /**
   * Transforms the canonical obj to only this targetType.
   */
  targetType: string

  /**
   * Do not throw the error if transformation fails. Instead, returns errors field populated in
   * CanonicalTransformResult.
   */
  doNotThrowError: boolean

  /**
   * Timestamp to use for the timed value fields if Canonical.timestamp is not populated.
   */
  defaultTimestamp: datetime

  /**
   * Meta obj with fields to override in the target obj's meta.
   */
  // TODO: Meta
  metaOverride: Obj

  /**
   * Specifies that, for target obj, all fields which have a default value declared and were not provided
   * in src obj, will be populated with the default value.
   */
  withTargetDefaults: boolean
}
