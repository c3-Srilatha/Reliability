/**
 * Type to dispatch import request for a canonical
 */
@restful(endpoint='import')
type ImportApi mixes Restful, Value {

  /**
   * Wrapper to import incoming payload for a Source
   * @return status of the import
   */
  process: function(stream: @java(class="java.io.InputStream") native, source: !string, contentMeta: ContentMeta)

  handle: ~
}
