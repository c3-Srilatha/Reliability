/**
 * Performs canonical app test
 */
type DataIntegTester mixes Tester {

  /**
   * 1. Provision the tenant you want to test. E.g. *myTenant*
   * 2. Find the path to the canonical test folder. A canonical test folder contains two folders named *canonical* and *expected*.
   *    E.g. "myTenant/test/canonical/folder1/canonical" and "myTenant/test/canonical/folder1/expected". In this example,
   *    "myTenant/test/canonical/folder1" is the canonical test folder. Remember the subpath "test/canonical/folder1"
   *    and move on to the next step.
   * 3. Go to workbench, switch to *myTenant*, then type
   *
   *  ```js
   *
   *  var testPath = Pkg.Path.make({ package: testPackage, category: Pkg.Category.OTHER, encodedSubPath: "test/canonical/folder1"});
   *  var res = DataIntegTester.runTestSuiteCode(<testSuiteCode>, testPath);
   *  ```
   * @param path
   *           Path to the folder where the canonical test exists.
   * @return The test result of the canonical test.
   */
  runTestSuiteCode: ~

  /**
   * The DataIntegTester does canonical transform based on what is provided in the data folder
   * (A canonical test folder contains two folders named *canonical* and *expected*. E.g. "myTenant/test/canonical/folder1/canonical"
   * and "myTenant/test/canonical/folder1/expected". In this example, "myTenant/test/canonical/folder1" is the canonical test folder,
   * and "myTenant/test/canonical/folder1/canonical" is the data folder) and generates results to compare with what is
   * provided in the expected folder (in the above example, namely, "myTenant/test/canonical/folder1/expected").
   * In case you want to know the generated reference results for debugging purpose, this function will help.
   * 1. Provision the tenant you want to test. E.g. *myTenant*
   * 2. Find an arbitrary location in local file system where you want to export the reference result.
   *    E.g. "/path/myTenant/test/canonical/folder1/referenceResults"
   * 3. Go to workbench, switch to *myTenant*.
   * 4. Execute the following commands, then the reference result will be generated under folder
   *    "/path/myTenant/test/canonical/folder1/referenceResults". You can use it to compare with the expected result you
   *    provide in "myTenant/test/canonical/folder1/expected" and debug.
   *
   * ```js
   * var testPackage = Pkg.Store.pkg("myTenant" true);
   * var testPath = Pkg.Path.make({repository: testPackage.repository, package: "myTenant", category: Pkg.Category.OTHER, encodedSubPath: "test/canonical/folder1"});
   * var resStatus = DataIntegTester.generateExpectedResult(testPath, "/path/myTenant/test/canonical/folder1/referenceResults");
   * ```
   *
   * @param path
   *             Path to the folder where the canonical test exists
   * @param absoluteExportPath
   *             File system absolute path to export the expected result locally
   * @return Information about export result
   */
  generateExpectedResult: function(path: !Pkg.Path, absoluteExportPath: !string): !string
}
