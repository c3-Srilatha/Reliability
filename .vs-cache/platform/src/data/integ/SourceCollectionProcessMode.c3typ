/**
 * Modes for triggering process data associated to {@link SourceCollection}
 */
enum type SourceCollectionProcessMode {

  /**
   * Default mode set for SourceCollections. Without manually kicking off process, no new data will be discovered.
   */
  MANUAL

  /**
   * Mode set when an external notification service like SQS triggers process for SourceCollection.
   */
  ON_ARRIVAL

  /**
   * Mode set when a schedule is specified for triggering process in the @linkSourceCollection#syncSchedule
   */
  ON_SCHEDULE
}
