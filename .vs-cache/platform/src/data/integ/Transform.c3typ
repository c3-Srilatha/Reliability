type Transform mixes Metadata, Named, JsSerializable {

  /**
   * Source type of this transform.
   */
  source: !Type

  /**
   * Target type of this transform.
   */
  target: !Type

  /**
   * Name of TargetCollection for this Transform. If not present, will use {@link TargetCollection#dfltFromTarget}
   */
  targetCollection: string serialized TargetCollection

  /**
   * Optional condition for filtering rows of instances of source type. #condition is applied first.
   */
  condition: string

  /**
   * Json representing transform projection. I.e. instructions how to map Source to Target. Value expected to have keys
   * matching field names in Target type and values to be valid C3 expressions in the context of Source type. If for a
   * given key value is another Json Object then corresponding Target type field's value type needs to be a reference
   * and target for this nested projection becomes referenced C3 Type.
   */
  @merge(json=MERGE)
  projection: json

  /**
   * If set, this is the transformation function that will be applied to source objects.
   * This executes JavaScript code with C3 type-system loaded and therefore does not have direct ability to use C3
   * expressions. If C3 expressions are necessary, the recommendation is to use {@link #projection}. Alternatively,
   * you can also use {@link Expr} to access C3 expressions.
   */
  // TODO: PLAT-39923 change to lambda instead of Lambda
  transformer: Lambda<function(src: !?Obj): stream<Obj>>

  /**
   * Validates this transform.
   */
  validate: member function(spec: TransformValidateSpec): !TransformValidateResult

  /**
   * @return true if this transform is identity transform.
   */
  isIdentity: member function(): boolean

  /**
   * List of `.` separated field paths for a Source type defined in #projection of this transform.
   */
  sourceFieldPaths: member function(): [string]

  /**
   * List of `.` separated field paths for a Target type based on expressions in #projection of this transform.
   */
  targetFieldPaths: member function(): [string]

  /**
   * Transform a single source object. The result will be an empty stream in the following two cases:
   * 1) {@link condition} is provided and the src obj fails the condition check
   * 2) onError callback is provided, in which case no exception will be thrown
   */
  transform: member function(src: !?Obj, onError: lambda(src: Obj, error: Error)): stream<Obj>

  /**
   * Transform a batch of source objects.
   * When perSrcStats is set to true, it returns results with per-object success tracking and the number of skipped source objs.
   */
  transformBatch: member function(src: !?[Obj], perSrcStats: boolean): ObjList<Obj>

  /**
   * Transform a stream of source objects. If `onError` callback is not provided then fails on first error.
   */
  transformStream: member function(src: !?stream<Obj>, onError: lambda(src: Obj, error: Error)): stream<Obj>

  /**
   * Transform for removing all but provided include fields and optionally removing all excluded fields from the source
   * object.
   */
  includeTransform: function(type: !Type, include: !?string, exclude: string): !Transform

  /**
   * @java(class='c3.love.util.query.ObjTransformer')
   */
  // TODO: PLAT-11616 - ClassDeclParser should not fail if class can't be loaded

  /**
   * Compile this transform into an executable form.
   *
   * Error handling:
   * - If you provide a single callback (`onError`), it will be used for both:
   *   - compilation/setup failures (e.g., compiling {@link #condition} / {@link #projection}); and
   *   - errors encountered while transforming specific source objects.
   *   When the failure is not associated with a particular source object (setup/compile-time), the callback is invoked
   *   with `src = null`.
   * - If you provide two callbacks (`onObjError`, `onTransform`), they are used separately:
   *   - `onTransform` is invoked for compilation/setup failures (not tied to a specific source object);
   *   - `onObjError` is invoked for errors encountered while transforming a specific source object.
   *
   * If the relevant callback is not provided, the error is thrown.
   */
  compile: private member function(onError: lambda(src: Obj, error: Error)): native

  /**
   * Compile this transform with separate callbacks for per-object errors and transform-level (setup/compile-time) errors.
   *
   * See the overload above for the detailed error-handling semantics.
   */
  compile: private member function(onObjError: !?lambda(src: Obj, error: Error),
                                   onTransform: !?lambda(error: Error)): native

  compileOnErrorWithIndex: private member function(onError: lambda(src: Obj, index: int, error: Error)): native
  dependencies:            ~: !TransformDeps
  toJsSource:              ~
  fromJsSource:            ~
}
