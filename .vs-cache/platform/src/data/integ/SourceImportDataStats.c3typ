/**
 * The following captures the statistics around process time statistics
 */
type SourceImportDataStats mixes ActionStats {

  /**
   * The total amount of Transformation time spent in secs
   */
  totalTransformationTime: double

  /**
   * Count of canonical objects successfully processed
   */
  successfulObjCount: int

  /**
   * Count of canonical objects rejected to import, excludes failedObjCount
   */
  rejectedObjCount: int

  /**
   * Stores stats for each of the targettypes being imported as part of canonical import
   */
  targetTypeStats: map<string, PersistableTargetStats> schema name 'TS'

  /**
   * Set initial values to all the fields of this SourceImportDataStats instance
   * @return the initilized SourceImportDataStats
   */
  init: function(): !SourceImportDataStats

  /**
   * Adds database operation result stats to data load process stats. The time conversion from milliseconds to seconds is lossy in this function.
   * @param targetType
   *           The type of the data that is upserted into the database
   * @param stats
   *           The Stats type instance to be added to SourceImportDataStats
   * @return The result SourceImportDataStats
   */
  addStats: private member function(targetType: !string, stats: !ActionStats): !SourceImportDataStats

  /**
   * concats SourceImportDataStats and returns new result stats
   * @return The result SourceImportDataStats
   */
  concatStats: private member function(stats: !SourceImportDataStats): !SourceImportDataStats

  /**
   * Adds canonical transform stats to data load process stats. The time conversion from double to int is lossy in this function.
   * @param stats
   *           The SourceTransformStats type instance to be added to SourceImportDataStats
   * @return The result SourceImportDataStats
   */
  addSourceTransformStats: private member function(stats: !SourceTransformStats): !SourceImportDataStats

  /**
   * @return the SourceContentRecordStats derived SourceImportDataStats.
   */
  recordStats: private member function(): SourceContentRecordStats
}
