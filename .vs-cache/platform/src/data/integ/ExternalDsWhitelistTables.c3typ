/**
 * Holds a list of tables for a particular entry in {@link ExternalDsWhitelist.tablesByTenant}.
 */
type ExternalDsWhitelistTables {

  /**
   * List of tables for a particular entry in {@link ExternalDsWhitelist.tablesByTenant}.  The names should match the
   * table names specified as the schema names for the types associated with that table.
   */
  tables: [string] schema suffix 'TBL'
}
