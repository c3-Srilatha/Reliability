/**
 * type to store information about external source systems which are live sources
 */
@cache(dependencies=['SourceSystem'])
type ExternalSourceSystem mixes SourceSystem<SourceSystem.Config, JdbcCredentials> {

  /**
   * Target source system for the External source is a file source system
   * if defined then content from external source is always extracted to the file source system from where it is accessed for dataload
   * if not defined then content from external source is directly accessed from the external source system
   */
  targetFileSourceSystem: FileSourceSystem

  /**
   * Returns all the available source collections for the external source system
   */
  availableSourceCollections: member function(): [ExternalSourceCollection]
}
