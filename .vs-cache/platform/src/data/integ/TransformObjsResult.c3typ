/**
 * Result of the Transform#transformObjs action.
 */
type TransformObjsResult mixes ObjList<Obj> {

  /**
   * map of the transform name to the list of {@link ObjError}'s for that transform.
   */
  errorsByTransform: map<string, [ObjError]>

  /**
   * This field tracks data lineage by mapping each target field to the source fields that were used
   * to populate it during transformation.
   *
   * Example with a basic projection-based transform:
   *
   * Source type S: {a: string, b: int, c: [int]}
   * Target type T: {a: string, b: string, c: int, d: datetime}
   *
   * Transform projection:
   * {
   *   "a": "a",                    // direct field mapping
   *   "b": "concat(a, b, 'combined')",  // computed field using source fields a and b
   *   "c": "b * 2",               // computed field using source field b
   *   "d": "now()"                // literal/computed field with no source dependencies
   * }
   *
   * Result in sourceFieldsByTransform["transformName"]:
   * {
   *   "a": ["a"],           // target field "a" maps to source field "a"
   *   "b": ["a", "b"],      // target field "b" depends on source fields "a" and "b"
   *   "c": ["b"],           // target field "c" depends on source field "b"
   *   "d": []               // target field "d" has no source field dependencies
   * }
   *
   * This mapping is only populated when {@link TransformObjsSpec#trackSourceFields} is enabled.
   */
  sourceFieldsByTransform: map<string, map<string serialized FieldPath, [string serialized FieldPath]>>

  /**
   * List of source objs. It has the same size as {@link ObjList#objs}. It is populated when {@link TransformObjsSpec#trackSources} is enabled.
   */
  sourceObjs: [Obj]
}
