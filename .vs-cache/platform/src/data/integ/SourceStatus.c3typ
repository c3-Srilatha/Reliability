/**
 * This type represents the status of the Sources
 */
entity type SourceStatus extends DataIntegStatus type key 'SOURCE' {

  /**
   * {@see SourceChunkStatus} entries for the {@link Sources}
   */
  chunks: [SourceChunkStatus](parentStatus)

  /**
   * The {@link SourceCollection} id for the sources of this status.
   */
  sourceCollectionName: !string

  /**
   * count of the chunks for the Sources
   */
  chunkCount: int

  /**
   * construct a SourceStatus object from a sources object with the given state and stats initialized to zero
   */
  fromSources: function(sources: !Sources, state: string): !SourceStatus

  /**
   * initializes the state, stats, errors, and firstError fields
   */
  initialize: member function(state: string): SourceStatus

  /**
   * updates errors array and the counts to values from the sourceStatus object
   */
  withErrorsAndCount: private member function(sourceStatus: !SourceStatus): SourceStatus

  /**
   * return the {@link Sources} of this status
   */
  sources: private member function(): !Sources

  /**
   * returns the {@link SourceCollection} of the {@link Sources} of this status.
   */
  sourceCollection: private member function(): !SourceCollection
}
