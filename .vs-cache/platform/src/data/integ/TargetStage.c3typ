@db(datastore="kv",
    partitionKeyField='objId',
    persistDuplicates=false,
    shortIdReservationRange=1000000,
    compactType=true,
    persistenceOrder='objId')
private entity type TargetStage mixes Partitionable<string> schema name 'TGT_STG' {

  /**
   * This is going to be objs of type {@link Persistable} which are backed by relational stores.
   */
  obj: Obj

  /**
   * id of the obj
   * workaround for using partition key and ability to use dedup of partitionable.
   */
  objId: !string

  /**
   * This will persist all the objects for the targetName.
   * e.g if TargetStage has id which is the type Id for MeasurementSeries. sweep will merge #objs in
   */
  sweep: inline function(spec: TargetStageSweepSpec): TargetStageSweep

  /**
   * Creates a stream of TargetStage objs from objs.
   */
  fromObjs: function(objs: Stream<Obj>): Stream<TargetStage>

  /**
   * Persist targetStages
   */
  persistTargetStages: function(targetStages: Stream<TargetStage>, spec: UpsertSpec)
}
