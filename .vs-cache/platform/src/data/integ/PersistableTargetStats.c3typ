/**
 * The following captures the statistics around target C3 types being persisted into database.
 */
type PersistableTargetStats mixes ActionStats {

  /**
   * Number of objects staged for preparation to be uploaded to the database.
   *
   * @see DbTargetCollection.Config#stageUpdates
   */
  stagedObjCount: int

  /**
   * Number of objects staged for preparation to be uploaded to the database.
   *
   * @see DbTargetCollection.Config#stageUpdates
   */
  stageTime: int

  /**
   * Number of targets that were unchanged
   */
  unchangedObjCount: int

  /**
   * @return new combined stats.
   */
  concat: ~
}
