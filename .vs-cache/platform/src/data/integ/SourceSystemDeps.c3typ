type SourceSystemDeps<C: SourceSystem.Config, CREDS: any> mixes MetadataDeps<SourceSystem<C, CREDS>> {

  /**
   * The subtype of this SourceSystem
   */
  subType: string serialized Type

  /**
   * The name of the most recent package where the SourceSystem is overridden
   */
  pkgName: !string
}
