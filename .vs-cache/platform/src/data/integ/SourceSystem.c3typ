/**
 * Type that contains all source systems configured for dataload
 */
@cache(dependencies=['FileSourceSystem', 'ExternalSourceSystem', 'SqlSourceSystem'])
type SourceSystem<C: SourceSystem.Config, CREDS: any> mixes Configurable<C>, Metadata, Named, WithDescription {

  /**
   * Indicator of whether this instance is currently being configured
   */
  state: string enum('test', 'draft', 'configured')

  /**
   * List of source collections for the source system
   */
  // TODO: PLAT-34042 metadata should allow foreign key references
  // TODO: PLAT-40185 remove <any> restriction
  sourceCollections: cached member function(): [SourceCollection<any>]

  /**
   * If rootUrlOverride is set then rootUrl will return rootUrlOverride else rootUrl
   * If you want to set rootUrlOverride at design time, set it here on {@link SourceSystem#rootUrlOverride}
   * If you want to set rootUrlOverride at environment time, set it on {@link SourceSystem.Config#rootUrlOverride}
   */
  rootUrlOverride: string

  /**
   * Check the source system for connectivity.
   *
   * @return the results of checking the source system for connectivity.
   */
  ping: optional member function(): !PingResult

  /**
   * @return the root url of the SourceSystem.
   * Used to construct the default {@link SourceCollection#inboxUrl}
   * @see #rootUrlOverride
   * @see SourceSystem.Config#rootUrlOverride
   */
  rootUrl: private member function(): !string

  /**
   * @return default source system
   */
  dflt: private inline function(): !SourceSystem

  /**
   * Checks if SourceSystem is default i.e. "Legacy"
   */
  isDflt: private inline member function(): boolean

  /**
   * Sets the credentials (app level) for the specified SourceSystem.
   *
   * @param credentials
   *        Credentials to set
   * @param merge
   *        If true, merge with existing credentials. Fields not provided remain unchanged.
   *        If false, replace all credentials with the provided ones.
   */
  setCredentials: abstract member function(credentials: !CREDS, merge: boolean)

  /**
   * Removes the credentials (e.g. app level config) for the specified SourceSystem.
   */
  removeCredentials: abstract member function()

  /**
   * Gets the credentials for the specified SourceSystem without the secrets
   *
   * @returns the credentials, if present
   */
  @beta
  credentials: abstract member function(): CREDS

  /**
   * Gets the credentials for the specified SourceSystem including secrets
   *
   * @returns the credentials, if present
   */
  @action(group+='cluster-admin')
  credentialsWithSecrets: private abstract member function(): CREDS

  /**
   * Gets the credentials for the specified SourceSystem without the secrets and the list of secret fields.
   *
   * @returns the CredentialsWithMaskedSecrets
   */
  credentialsWithMaskedSecrets: member function(): CredentialsWithMaskedSecrets<CREDS>

  /**
   * Remove a {@link SourceSystem} and associated {@link SourceCollection}s.
   *
   * @return true if the SourceSystem and associated SourceCollections were successfully removed
   */
  removeWithChildren: ~

  dependencies: ~: !SourceSystemDeps
}
