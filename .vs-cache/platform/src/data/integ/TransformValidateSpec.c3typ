/**
 * Options for Transform#validate action.
 */
type TransformValidateSpec mixes Spec {

  /**
   * Ensure sourceType is mixing Source.
   */
  ensureSourceMixin: boolean

  /**
   * If `true` then will ignore required fields constraint check.
   */
  ignoreRequiredFields: boolean

  /**
   * If `true` then will not validate `condition` expression.
   */
  ignoreCondition: boolean

  /**
   * If `true` then will not validate `projection` expression.
   */
  ignoreProjection: boolean

  /**
   * If the Transform is invalid then throw an error at he end of validation.
   */
  failIfInvalid: boolean
}
