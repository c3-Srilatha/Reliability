type TransformDeps mixes MetadataDeps<Transform> {

  /**
   * The source type of this transform
   */
  source: !string serialized Type

  /**
   * The target type of this transform
   */
  target: !string serialized Type

  /**
   * The name of the most recent package where the Transform is overridden
   */
  pkgName: !string
}
