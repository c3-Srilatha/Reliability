/**
 * This type represents the reference to the content
 */
abstract type ContentRef mixes Value {

  /**
   * Url of the referenced file
   */
  fileUrl: inline member function(): !string serialized FileUrl

  /**
   * File for the instance of ContentRef
   */
  file: inline member function(): !File

  /**
   * returns a stream of objs for the referenced content
   */
  readObjs: inline member function(spec: FileObjsOperSpec): !stream<Obj>
}
