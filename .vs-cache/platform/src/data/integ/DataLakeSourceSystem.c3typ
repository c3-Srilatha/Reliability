@beta
type DataLakeSourceSystem mixes SourceSystem<SourceSystem.Config, CloudCredentials>, FileInfoOverride {

  /**
   * Data Lake catalog which contains tables which can be references as source collections.
   */
  catalog: DataLake.Catalog

  /**
   * Preview specified table.
   *
   * @param tableName
   *        name of the table to preview tuples. The name may be qualified or unqualified.
   * @param limit
   *        number of rows to return.
   * @return
   *        Array of CellTuple. First CellTuple is a tuple of column names.
   */
  previewTable: member function(tableName: !string, limit: int = 20): PreviewTableResult

  /**
   * Lists tables found in catalog behind this source system.
   *
   * @param spec
   *        Various parameters used for listing the tables.
   *
   * @return result containing requested table names.
   */
  listTableNames: member function(spec: JdbcListTableNamesSpec): !JdbcListTableNamesResult

  /**
   * Gets the schema information for the specified table.
   *
   * @param name
   *        Table name to get the schema information for. The name may be qualified or unqualified.  If it is
   *        unqualified and more than one table matches the name, an error will be thrown.
   * @param failIfMissing
   *        If true and the specified table doesn't exist an error will be thrown.
   *
   * @return the schema information for the specified table.
   */
  table: member function(name: !string, failIfMissing: boolean): SqlTable
}
