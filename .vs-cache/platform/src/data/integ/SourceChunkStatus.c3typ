/**
 * This type provides the stats and state for each {@link SourcesChunk}
 */
entity type SourceChunkStatus extends SourceStatus type key 'CHUNK' {

  /**
   * index of the chunk it is 0 based.
   */
  chunkIndex: !int

  /**
   * offset for the chunk in parent Sources
   * it is 0 based.
   */
  offsetInParentSources: !int

  /**
   * Initializes and creates a SourceChunkStatus given the chunk number and Sources
   * If isCompleted is true, chunk will be initialized in completed state
   */
  init: inline function(chunkNum: int,
                        src: Sources,
                        recordCount: int,
                        offsetInParentSources: int,
                        isCompleted: boolean): SourceChunkStatus

  /**
   * @returns the id of the SourceChunkStatus given the chunk number and Sources' id and source type
   */
  chunkId: private inline function(chunkNum: int, sourcesId: string, srcType: Type): string
}
