/**
 * ALL OF THE FOLLOWING TYPES BELONG TO THE NEW DATA LOAD
 *
 * Statistics for target types being transformed
 */
type SourceTransformTargetStats mixes DataIntegStatsBase {

  /**
   * Number of canonical objs skipped for the targetType
   */
  skippedObjCount: int

  /**
   * Number of successfully generated target objs
   */
  objCount: int

  /**
   * Time taken in seconds to transform all objs
   */
  transformationTime: double

  /**
   * Adds the stats object values to the stats object it is called on and returns a new stats object
   *
   * @param stats object to append the values from
   * @result CanonicalTransformTargetTypeStats object with added data
   */
  add: member function(stats: !SourceTransformTargetStats): !SourceTransformTargetStats
}
