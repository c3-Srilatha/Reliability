/**
 * Stats for Source.transform
 */
type SourceTransformStats mixes DataIntegStatsBase {

  /**
   * number of canonical objs that failed to transform
   */
  failedCount: int

  /**
   * number of canonical objs that transformed successfully
   */
  transformedCount: int

  /**
   * total time taken in seconds
   */
  totalTime: double

  /**
   * Stats for each of the target types
   */
  targetStats: map<string, SourceTransformTargetStats> schema name 'TTS'

  /**
   * Adds the stats object values to the stats object it is called on and returns a new stats object.
   * It adds up the counts and the time and calls SourceTransformTargetTypeStats.add for the stats for each
   * target type
   *
   * @param stats object to append the values from
   * @result SourceTransformStats object with added data
   */
  add: member function(stats: !SourceTransformStats): !SourceTransformStats

  /**
   * Adds the input's target type stats and returns a new stats object
   *
   * @param targetTypeStats map of target type name to target type stats
   * @result SourceTransformStats object with added stats
   */
  addTargetStats: member function(targetTypeStats: !?map<string, SourceTransformTargetStats>): !SourceTransformStats
}
