/**
 * This type is base for all Canonical Types. Canonical types are used to represent Application Data Model from the
 * standpoint of external sources integration. Canonical types are then mapped to the Application C3 Types | Application
 * Data Model that can be more complex and have more types and relationships.
 */
type Canonical mixes Source {

  /**
   * Converts contents of a file to c3 objs of the specific canonical type
   * Please be sure to provide at least the `url` and the `contentType` on the file object for the API to
   * de-serialize appropriately
   * @param file
   *          Location of the file that needs to be read
   * @param offset
   *           offset defaults to 0
   * @param limit
   *           number of objects to return; defaults reads entire file
   * @return array of c3 canonical objs
   */
  readObjs: private function(content: Content, offset: int, limit: int): [mixing Canonical]
}
