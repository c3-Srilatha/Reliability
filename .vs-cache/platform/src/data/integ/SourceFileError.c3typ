/**
 * Source file errors message info.
 */
@deprecated(finalVersion='7.9', details='Use FailedSource instead')
private type SourceFileError {

  /**
   * Line number at which the error occurred
   */
  lineNum: string

  /**
   * Detailed error message occurred in the file for the line number
   */
  errorMessage: string
}
