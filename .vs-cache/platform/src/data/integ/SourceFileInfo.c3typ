/**
 * Canonical file information
 */
type SourceFileInfo {

  /**
   * name of the customer
   */
  customer: string

  /**
   * name of the source type
   */
  src: string

  /**
   * date when this file was created or received
   */
  timestamp: datetime

  /**
   * sequence number of the file
   */
  sequence: int

  /**
   * hash of the file (only the md5, sha1, and cksum are supported)
   */
  hash: string

  /**
   * locale of the content of the file
   */
  locale: string
}
