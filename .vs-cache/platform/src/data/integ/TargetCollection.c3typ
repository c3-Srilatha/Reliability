/**
 * Represents a collection of data transformed in DI pipeline prior to persistence step.
 * Stores information on how to persist TargetObjs post transform
 */
@beta
abstract type TargetCollection<C> mixes Configurable<C>, Metadata, Named {

  /**
   * Structure defined to serialize the content from the TargetCollection
   * Type must be entity type
   */
  target: !Type

  /**
   * User defined lambda to define custom logic for persisting data. This will override default persisting logic
   */
  persist: abstract member function<T>(targetObjs: [T]): ObjList<T>

  /**
   * @return default target collection for Target
   */
  dfltFromTarget: function(target: Type): !TargetCollection<C>

  /**
   * @return true if the TargetCollection is a {@link DbTargetCollection}
   */
  isDb: member function(): !boolean

  /**
   * @return db target collection for the target collection if it exists
   */
  asDbTargetCollection: private member function(refresh: boolean, failIfMissing: boolean): DbTargetCollection
}
