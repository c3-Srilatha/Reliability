type SourceSystem.Config mixes Named, Config {

  // TODO PLAT-118447: Generically handle credentials on SourceSystem

  /**
   * If set, these credentials will be used as default credentials for source collections with a corresponding provider.
   */
  credentials: CloudCredentials

  /**
   * If rootUrlOverride is set then {@link SourceSystem#rootUrl} will return rootUrlOverride else rootUrl
   * If you want to set rootUrlOverride at design time, set it on {@link SourceSystem#rootUrlOverride}
   * If you want to set rootUrlOverride at environment time, set it here on {@link SourceSystem.Config#rootUrlOverride}
   */
  rootUrlOverride: string
}
