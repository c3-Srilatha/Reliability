/**
 * A {@link BatchJob} to delete {@link SourceFile}s and their associated persisted data
 */
entity type SourceFile.RemoveWithDataBatchJob extends BatchJob<SourceFile.RemoveWithDataBatchJob, BatchJobOptions, SourceFile.RemoveWithDataBatch> type key 'SRC_FL_RMV' {

  /**
   * The ids of the {@link SourceFile}s to delete
   */
  sourceFileIds: [string]

  doStart:      ~
  processBatch: ~
}
