/**
 * Specifications for running source data validation
 */
type ValidateSourceDataSpec mixes Spec {

  /**
   * if true, persist the results. See {@link DataIssue}.
   */
  persist: boolean

  /**
   * if specified, filter the results based on severity
   */
  severity: string enum DataIssueSeverity
}
