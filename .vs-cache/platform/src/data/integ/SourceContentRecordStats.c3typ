/**
 * Record stats for loading of {@link Source} records/objects
 */
type SourceContentRecordStats {

  /**
   * Number of records in the source content
   */
  recordCount: int

  /**
   * Number of records that failed in the source content
   */
  failedRecordCount: int

  /**
   * Number of records that were rejected in the source content
   */
  rejectedRecordCount: int

  /**
   * Number of records that were successfully transformed in the source content
   */
  successfulRecordCount: int

  /**
   * Number of chunks created for this source content. Value is set when {@link Sources#shouldChunk} is true
   */
  chunkCount: int

  /**
   * method to initialize SourceContentRecordStats
   */
  initialize: function(): !SourceContentRecordStats
}
