/**
 * Specifies whitelisted tables for an external datastore.  If an entry exists for a datastore
 * then only the tables specified here will be able to accessed from the datastore.  If no entry exists
 * for a datastore then any table may be accessed.
 */
@db(enforceUpdateAclForNonClusterAdmin=true, domain='system')
@cache(all=true)
@action(group+='env-admin')
entity type ExternalDsWhitelist mixes AclEnabled, Nameable, Cached schema name 'EXTDS_WHITELIST' {

  /**
   * Name of the datastore/SqlSourceSystem
   */
  name: ~

  /**
   * Map of whitelisted table names keyed by tenant (or tenant.tag) name.  The tables specified in the '*' tenant
   * will be merged with the appropriate ones of the calling/using tenant/tag.
   */
  tablesByTenant: map<string, ExternalDsWhitelistTables> schema suffix 'TBT'

  /**
   * Gets the whitelisted tables for the current tenant/tag.
   *
   * @param dsName
   *        Datastore name
   *
   * @return The whitelisted tables for the current tenant/tag.
   */
  myWhitelist: inline function(dsName: !string): [string]
}
