/**
 * {@link FlowGraph} representation of Data operations.
 */
@beta
private type Data.Flow mixes FlowGraph<Data.Flow.Vertex> {

  /**
   * Name of this {@link Data.Flow}. Required for {@link FlowGraph#visualize}
   */
  name: string

  /**
   * Performs Package Inference on this Data.Flow instance, returning an analyzed and transformed {@link PkgInference}
   * graph
   */
  infer: member function(): !PkgInference

  /**
   * Creates a new instance of {@link Data.Flow} from provided {@link DataImpl}.
   */
  fromData: function(data: !DataImpl, spec: DataToFlowSpec): !Data.Flow

  /**
   * Re-creates and returns a copy of the {@link DataImpl} used to create this {@link Data.Flow}. The returned DataImpl
   * instance will represent the only sink of this Data.Flow.
   */
  toData_: member function(): !DataImpl
}
