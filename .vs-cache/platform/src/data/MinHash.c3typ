/**
 * A technique for determining the approximate similarity between two collections of data. Used by the Type Inference
 * package to perform approximate inclusion tests between primary key and foreign key candidate columns.
 *
 * @see https://en.wikipedia.org/wiki/MinHash
 * @see MinHashBuilder
 * @see MinHashSpec
 */
type MinHash mixes Stats<MinHash, MinHashBuilder> {

  /**
   * Stores the spec used to create this MinHash structure
   */
  spec: MinHashSpec

  /**
   * Array (of length spec.hashCount) of arrays of minimum hashes by hash function. Each sub-array is the minimum hashes
   * of a single hash function in ascending order, of length spec.minCount.
   */
  minimumHashes: ![[int32]]

  /**
   * Perform an approximate inclusion test between this MinHash and another MinHash. The test will return false if it
   * detects an element in other which is not present in ths. Otherwise, the test returns true. Increasing
   * spec.hashCount() and spec.minCount() when building will make this test more accurate, but note that it will make
   * the MinHashBuilder significantly slower at ingesting data.
   */
  approxInclusionTest: member function(other: !MinHash): !boolean

  /**
   * Approximates the Jaccard Index (or Jaccard similarity coefficient) between this MinHash and another. Jaccard Index
   * is a measure of similarity between sets and is equal to |A Intersect B| / |A Union B|, where A and B are the data
   * added to ths MinHash and the other MinHash. Increasing spec.hashCount() and spec.minCount() when building will make
   * this approximation more accurate, but note that it will make the MinHashBuilder significantly slower at ingesting
   * data.
   * @see https://en.wikipedia.org/wiki/Jaccard_index
   */
  approxJaccardIndex: member function(other: !MinHash): !double
}
