/**
 * Stateful representation of arbitrary data
 */
@beta
type Dataset_Poc mixes Identified, Mutable, Obj {

  /**
   * Constructs dataset from a file or directory.
   */
  fromFile: abstract function(url: !?string serialized FileUrl, spec: DatasetSpec): !Dataset_Poc

  /**
   * Constructs dataset from a multiple file or directory.
   */
  fromFiles: abstract function(urls: ![string serialized FileUrl], spec: DatasetSpec): !Dataset_Poc

  /**
   * Constructs dataset from a content.
   */
  fromContent: abstract function(content: !Content, spec: DatasetSpec): !Dataset_Poc

  /**
   * Lookup a stateful dataset by GUID. Dataset_Poc can be in memory, in file system or in the db.
   */
  forId: abstract ~

  /**
   * All instances of active datasets i.e. in memory or saved.
   */
  all: abstract function(): stream<Dataset_Poc>

  /**
   * Caches raw data of this dataset. Unless spec#deserialize is set only caches raw data.
   */
  cache: abstract member function(spec: DatasetSpec): !Dataset_Poc

  /**
   * Discards all cached data. Datasets can be cached in memory or in the local file system. This call will get rid of
   * the cached copy. #cache or #read can be called again as needed.
   */
  uncache: abstract member function(): !Dataset_Poc

  /**
   * Saves deserialized dataset in the persisted store
   */
  save: abstract member function(spec: DatasetSpec): !Dataset_Poc

  /**
   * Uncaches and discards this dataset effectively making this instance of the dataset unusable after this call.
   *
   * @see close
   */
  close: abstract member function(): !Dataset_Poc

  /**
   * Deserializes and caches data in this dataset.
   */
  read: abstract member function(spec: DatasetSpec): !Dataset_Poc

  /**
   * Deserializes and caches data in this dataset.
   */
  readWithStatus: abstract member function(spec: DatasetSpec): stream<DatasetStatus>

  /**
   * Compresses this dataset.
   */
  compress: abstract member function(contentEncoding: string enum ContentEncoding = SNAPPY): !Dataset_Poc

  /**
   * Uncompresses this dataset.
   */
  uncompress: abstract member function(): !Dataset_Poc

  /**
   * Clones this dataset. Useful if you want to keep raw data before deserializing or decompressing.
   *
   * @see #read
   * @see #compress
   * @see #decompress
   */
  clone: abstract member function(spec: DatasetSpec): !Dataset_Poc

  /**
   * Sets element type for this Dataset_Poc and uses best effort attempt to convert element values.
   */
  setElementType: abstract member function(): !Dataset_Poc

  /**
   * Best effort attempt to guess element value and update the state of the Dataset_Poc to reflect the inferred value type.
   */
  inferElementType: abstract member function(): !Dataset_Poc

  /**
   * Best effort attempt to guess element value type based on available data.
   */
  inferredElementType: abstract member function(): !InferValueTypeResult

  /**
   * @return value type of elements in this dataset; note that Dataset_Poc can be heterogeneous i.e. contain elements of
   *         various types in which case this method will return `any` or `anyof`; or it can be tuple or generic Obj
   *         i.e. contain elements with named values in which case this method will return reference type to `Obj`.
   *
   * @see #fieldValueType
   */
  elementType: abstract member function(): !ValueType

  /**
   * @return value type of a named field if this data set contains C3 Type instances or tuples [ aka generic Obj ]
   *         or `null`
   */
  fieldValueType: abstract member function(field: !string): ValueType

  /**
   * @return value type of a 0 based indexed column or `null`
   */
  columnValueType: abstract member function(colIndx: !int32): ValueType

  /**
   * @return stream of elements
   */
  stream: abstract member function<T>(): stream<T>

  /**
   * @return stream of given field values from each element
   */
  pluck: abstract member function<T>(field: !string): stream<T>

  /**
   * @return stream of column values each element
   */
  pluck: abstract member function<T>(colIndx: !int32): stream<T>

  /**
   * @return expression evaluation result over elements of this dataset
   */
  eval: abstract member function<T>(expr: !string serialized Expr): T

  /**
   * @return aggregation results
   */
  groupBy: abstract member function<K, T>(groupColIndx: !int32,
                                          valColIndx: !int32,
                                          initial: !?T,
                                          agg: !lambda(e: any, r: T): T): map<K, T>

  /**
   * code signature should be: groupBy(elem, currRes) : result
   */
  groupByPy: abstract member function<K, T>(groupColIndx: !int32,
                                            valColIndx: !int32,
                                            initial: !?T,
                                            pyCode: !string): map<K, T>

  /**
   * code signature should be: groupBy(elem, currRes) : result
   */
  groupByJs: abstract member function<K, T>(groupColIndx: !int32,
                                            valColIndx: !int32,
                                            initial: !?T,
                                            jsCode: !string): map<K, T>

  /**
   * @return digest of elements
   */
  digest: abstract member function<T: Digest>(): !T

  /**
   * @return digest of a field
   */
  digest: abstract member function<T: Digest>(field: !string): !T

  /**
   * @return digest of a column
   */
  digest: abstract member function<T: Digest>(colIndx: !int32): !T

  /**
   * @return exact count of elements in this dataset
   */
  count: abstract member function(): !int

  /**
   * @return exact count of elements formatted as string
   */
  countFormatted: abstract member function(): !string

  /**
   * @return exact count of elements in this dataset
   */
  approxCount: abstract member function(): !int

  /**
   * @return approximate count of elements formatted as string
   */
  approxCountFormatted: abstract member function(): !string

  /**
   * @return map of approximate unique elements of all columns by their index
   */
  approxUniqueCount: abstract member function(): !map<int32, int>

  /**
   * @return approximate unique elements of a column
   */
  approxUniqueCount: abstract member function(colIndx: !int32): !int

  /**
   * @return in-memory dataset size in bytes
   */
  size: abstract member function(): !int

  /**
   * @return in-memory dataset size as formatted string
   */
  sizeFormatted: abstract member function(): !string

  /**
   * @return size of the source content [ typically files ] of this dataset in bytes
   */
  sourceSize: abstract member function(): !int

  /**
   * @return size of the source content [ typically files ] of this dataset as formatted string
   */
  sourceSizeFormatted: abstract member function(): !string

  /**
   * Universal resource locator(s) for source data for this dataset.
   */
  urls: [string serialized Url]

  /**
   * Specification of this dataset.
   */
  spec: !DatasetSpec

  /**
   * Compression / contentEncoding of this dataset
   */
  contentEncoding: string enum ContentEncoding

  /**
   * WIP
   */
  dispatch: private abstract member function(req: json): json

  summary:       abstract function(url: string): stream<DatasetStatus>
  summarySingle: abstract function(url: string): DatasetStatus
}
