/**
 * Anonymizer Model to provide a anonymized/"Fake" value based on the {@link AnonymizationCategory}. If the
 * AnonymizationCategory is either empty or not applicable to the provided {@link PrimitiveType}, then random values
 * based on the PrimitiveType are generated.
 *
 * @see Anonymizer.GeneralizationModel
 * @see ValueType.anonymize
 */
type Anonymizer.FakerModel mixes Anonymizer.Model {

  /*
   * Used to generate "fake" values for the given {@link PrimitiveType}. e.g Fake addresses will generated with
   * {@link AnonymizationCategory.Address}.
   *
   * If the AnonymizationCategory is either empty or not applicable to the provided {@link PrimitiveType}, then random
   * values based on the PrimitiveType are generated.
   */
  category: AnonymizationCategory

  anonFunc: ~
}
