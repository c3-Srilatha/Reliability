/**
 * See {@link Period}.
 * Data.Period uses pandas compatible frequency strings to represent units.
 * See http://pandas.pydata.org/pandas-docs/stable/user_guide/timeseries.html.
 */
@beta
type Data.Period {

  /**
   * Most commonly used periods from {@link Interval}.
   * These units must be Pandas compatible.
   * For non standardized abbreviations, see {@link TemporalUnit} or {@link Period}.
   */
  SECOND: const string = "s"

  MINUTE:       const string = "min"
  FIVE_MINUTE:  const string = "5min"
  TEN_MINUTE:   const string = "10min"
  QUARTER_HOUR: const string = "15min"
  HALF_HOUR:    const string = "30min"
  HOUR:         const string = "h"
  DAY:          const string = "d"
  MONTH:        const string = "m"
  YEAR:         const string = "y"
}
