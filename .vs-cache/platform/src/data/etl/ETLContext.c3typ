type ETLContext {

  /**
   * Represents the source entity row being processed
   */
  sourceOccurrence: Ref

  /**
   * The name of the timeseries measure being evaluated
   */
  tsMeasure: string

  /**
   * A map of dimension name to the row corresponding to the dimension. For example, the dimension could be "resource" and the value would be a DeepRef to a particular resource
   */
  dimensions: map<string, Ref>
}
