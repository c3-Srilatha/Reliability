/*
 * TODO: should we use uniqie index here?
 *
 * @db(unique=["fact, dim, measure"])
 */
type KPIMatrix {

  /**
   * The qualified name of the fact for which this KPIMatrix record is intended. Example: energy.fRsrcCon
   */
  fact: string

  /**
   * The id (Note that the name of the dimension is defined in @analyticExtract.kpiMatrixDim) of the dimension. Example:"naturalgas" or "electricity" or "energy" ...
   */
  dim: string

  /**
   * The name of the timeseries measure that the KPI corresponds to. Example: "budget_spend_qty" or "actual_consumption_invoiced_qty" or ...
   */
  measure: string

  /**
   * The id of the KPI for this dimension and measure combination.
   */
  kpiId: string
}
