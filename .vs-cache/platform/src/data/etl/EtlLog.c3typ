/**
 * Log of all incremental etl operations.
 */
entity type EtlLog mixes TimeRange, JobStatus schema name 'ETL_LOG' {

  /**
   * Coordinator the log entry is for.
   */
  coordinator: EtlCoordinator

  /**
   * Updates the etl log status.
   */
  updateStatus: function(coordinator: !EtlCoordinator, status: !string)
}
