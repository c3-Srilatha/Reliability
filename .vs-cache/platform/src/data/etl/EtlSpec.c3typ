/**
 * Etl spec used for the etl workflow/batch job.
 */
type EtlSpec mixes ObjBatch, TimeRange, Spec {

  /**
   * Type being processed.
   */
  typeName: string

  /**
   * Secondary datastore upsert used for grouping upserts to the secondary datastore for an incremental etl run.
   */
  secondaryDsUpsert: SecondaryDsUpsert

  batchSize: ~ = '10000'
}
