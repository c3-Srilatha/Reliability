/**
 * Etl coordinator.  Every entry is for a specific type that incremental etl is being performed for (e.g. types that
 * specify a secondary datastore.
 */
@db(systemType=true, unique=['typeName'])
entity type EtlCoordinator schema name 'ETL_COORD' {

  /**
   * Type that the entry is for.
   */
  typeName: string

  /**
   * Workflow that performs incremental etl operation.
   */
  workflow: Workflow

  /**
   * All etl logs for the type.
   */
  @db(order='descending(end), descending(start)')
  logs: [EtlLog](coordinator)

  /**
   * Performs incremental etl for all types that support it.
   */
  synchronizeAll: function()

  /**
   * Called by {@link synchronizeAll} to perform incremental etl for a specific type/entry.
   */
  synchronize: private member function()
}
