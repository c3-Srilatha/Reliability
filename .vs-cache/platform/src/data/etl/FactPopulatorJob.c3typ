/**
 * MapReduce job to compact the analytics queue entries.
 */
entity type FactPopulatorJob extends MapReduce<Obj, int, int, int> type key 'FACTPOP' {

  factType:  !Type
  batchSize: ~ = '500'
  include:   ~ = 'id'
  map:       ~ js-server
}
