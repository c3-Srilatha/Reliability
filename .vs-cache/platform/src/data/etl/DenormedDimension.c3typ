/**
 * This type should be mixed in to represent a denorm-based dimension hierarchy member type
 *
 * Example: @denormAttrHierarchy(denormEntity="...", relationship="", maxDepth=7)
 */
type DenormedDimension<T> {

  /**
   * Called depth because these are measured from the root
   */
  depth1: T

  depth2: T
  depth3: T
  depth4: T
  depth5: T
  depth6: T
  depth7: T

  /**
   * Note: Not called depth because MSTR measures levels from the leaf (bottom)
   */
  level1Name: string

  level2Name: string
  level3Name: string
  level4Name: string
  level5Name: string
  level6Name: string
  level7Name: string
}
