/**
 * Describes PII access event.
 *
 * @see PiiAccessListener
 */
type PiiAccessEvent {

  /**
   * Type containing PII.
   */
  piiType: !Type

  /**
   * Object IDs containing PII.
   */
  piiObjIds: ![string] schema suffix 'IDS'

  /**
   * PII field names.
   */
  piiFields: ![string] schema suffix 'FLDS'

  /**
   * PII access.
   */
  access: !string enum('read', 'write')

  /**
   * Query string used in PII read access in the format of "<root type name>: <filter expression>"
   */
  readQuery: string

  /**
   * User accessing PII.
   */
  user: string

  /**
   * `true` PII was accessed by "machine" / batch process. In this case user will be `null`.
   */
  machine: boolean

  /**
   * Time of access.
   */
  timestamp: !datetime

  /**
   * Server node hostname where PII was accessed.
   */
  serverNode: !string

  /**
   * Server node IP address where PII was accessed.
   */
  serverIpAddress: !string
}
