/**
 * Base type for all PII (personally identifiable information) access notification listeners. Note that even of sub-type
 * exists it is not enabled by default and needs to be explicitly enabled via #enable method.
 *
 * @see Ann.PII
 * @see PiiAccessEvent
 */
abstract type PiiAccessListener<C: PiiAccessListenerConfig> mixes Configurable<C> {

  /**
   * Invoked some time "soon" after PII data is accessed. Note that this method should be idempotent and could be
   * invoked more then once in case of failures.
   */
  notifyAccess: abstract function(piiType: !Type, events: [PiiAccessEvent])
}
