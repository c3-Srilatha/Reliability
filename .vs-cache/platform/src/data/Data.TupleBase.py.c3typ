private native py remix type Data.TupleBase {

  /**
   * Convert the given binary serialized from {@link Data.TupleBase}s to a pandas DataFrame
   */
  binaries_to_pandas: private function(data: binary): native py

  /**
   * Write the given metadata of a {@link Data.TupleBase} to the byte buffer and returns the byte buffer
   */
  write_metadata_to_byte_buffer: private function(byte_buffer: native, metadata: [any]): native py

  /**
   * Convert the given {@link Data.TupleBase}s to a binary representation
   */
  tuples_to_binary: private function(tuples: [Data.TupleBase]): binary py
}
