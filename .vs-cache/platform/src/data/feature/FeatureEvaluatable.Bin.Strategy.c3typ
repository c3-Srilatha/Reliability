/**
 * Binning strategy subtype to be used in Feature Store to bin ids of **FeatureEvaluatable** subtypes based on {@link Feature} and {@link Feature.Set} instances.
 */
@db(index=["featureType, featureId, isReady", "featureType, featureId, snapshotId, isReady"])
@dependency(include="id, featureType, featureId, snapshotId")
extendable entity type FeatureEvaluatable.Bin.Strategy extends Persistable.Bin.Strategy type key 'FBS' {

  /**
   * Type of the {@link FeatureBase} subtype linked to the current strategy as identified by {@link #featureId}
   */
  featureType: !Type<<FeatureBase>>

  /**
   * id of the {@link Feature} / {@link Feature.Set} associated with the current strategy.
   */
  featureId: !string

  /**
   * {@link Feature.Set.Snapshot#snapshotId} of the {@link Feature.Set.Snapshot snapshot} if this strategy was used when the snapshot was created. Please note that binning strategy for a snapshot cannot be changed once created. So, {@link #init} will fail when invoked on a strategy instances which belong to a snapshot.
   */
  snapshotId: string

  /**
   * if set, then the current strategy is **ready to be used operationally**. This is different from {@link Persistable.Bin.Strategy#isInitialized} because the "initialization" of the bins is not sufficient for them to be used to read data from associated {@link Feature.Store.Block blocks}. The associated data
   * should also be materialized for a strategy for it to be usable.
   *
   * Please note that:
   * * The strategy itself has no way of knowing its own readiness and the responsibility lies with the data writers ("materialization") to update this when they have done their job. (after "re-binning")
   * * **isReady** will always be set for binning strategies of {@link Feature.Set.Snapshot snapshots}
   * * Only existence check (i.e **exists(isReady)**) will be used to determine readiness and the actual value will not be compared.
   */
  isReady: private boolean

  /**
   * Mark the current strategy as "ready" to used operationally. This MUST be used by materialization / "rebinning" job after ensuring that the necessary data has been added to the Feature.Store
   */
  setIsReady: member function(): !mixing FeatureEvaluatable.Bin.Strategy

  /**
   * @return the feature instance for the current strategy
   */
  @dependency(include="featureType, featureId")
  feature: property(): !FeatureBase

  /**
   * @param feature
   *        The feature/feature set will be used to fetch the correct strategies
   * @param snapshotId
   *        The snapshotId of the snapshot. If null, fetch the strategies that are not for snapshot, otherwise, only fetch the strategies that are for this specific snapshot.
   * @param includeNonReady
   *        If set, also fetch the strategies that may not be ready yet.
   * @return the filter to fetch the correct strategies for the given Feature / Feature.Set or snapshot.
   */
  filter: private function(feature: !FeatureBase, includeNonReady: boolean, snapshotId: string): !Filter

  /**
   * @param feature
   *        The feature/feature set will be used to fetch the correct strategies
   * @param snapshotId
   *        The id of the snapshot. If null, fetch the strategies that are not for snapshot, otherwise, only fetch the strategies that are for this specific snapshot
   * @param includeNonReady
   *        If set, also fetch the strategies that are not ready
   * @param limit
   *        number of strategies to fetch
   * @return the FetchSpec to fetch the correct strategies for the given Feature / Feature.Set or snapshot.
   */
  fetchSpec: private function(feature: !FeatureBase,
                              includeNonReady: !boolean,
                              limit: !int,
                              snapshotId: string): !FetchSpec

  /**
   * @return the newly "created" strategy with the overridden fields from the **toMergerOverride** instance but with the exact same state as the current strategy
   */
  copy: private member function(toMergeOverride: !FeatureEvaluatable.Bin.Strategy)
                         : !mixing FeatureEvaluatable.Bin.Strategy

  /**
   * @return a filter to fetch the blocks associated with the provided strategies
   */
  blockFilter: private function(strategyIds: ![string]): !Filter

  /**
   * Delete (or mark deleted) associated {@link Feature.Store.Block}s for the provided strategies.
   * It will be called in {@link FeatureEvaluatable.Bin.Strategy}'s **beforeRemove** function.
   */
  doRemoveBlocks: private function(objs: !?[mixing FeatureEvaluatable.Bin.Strategy])
                            : !ObjList<mixing FeatureEvaluatable.Bin.Strategy>

  /**
   * @param recSubjectsPerBin
   *        number of subjects to be assigned to be in a bin.
   * Initialize strategy for this a {@link FeatureEvaluatable.Bin.Strategy} such that all ids as retrieved from Db for the given subjectType are assigned to different bins based on the "recommended ids per bin" (**recSubjectsPerBin**).
   */
  init: member function(recSubjectsPerBin: !int): boolean

  beforeRemove: ~
}
