/**
 * Base type for {@link Feature.Overview} and {@link Feature.Set.Overview}, which
 * combines data from {@link Feature}, {@link Feature.Set}, and {@link MlModel}
 */
type FeatureOverviewBase mixes WithId, WithName {

  /**
   * The kind of Feature / Feature Set
   */
  kind: !string

  /**
   * {@link FeatureBase#subjectType}
   */
  subjectType: !string

  /**
   * {@link FeatureBase#summary}
   */
  summary: string

  /**
   * How many {@link MlModel} are utilizing this feature
   */
  modelCount: int = 0

  /**
   * Determines whether the Feature or Feature Set is timeseries or not.
   */
  isTimeseries: ?boolean

  /**
   * The interval for the {@FeatureBase}
   */
  interval: string enum Interval

  /**
   * {@FeatureBase#meta}
   */
  meta: Meta

  /**
   * {@FeatureBase#_columns}
   */
  columns: map<string, ValueType>
}
