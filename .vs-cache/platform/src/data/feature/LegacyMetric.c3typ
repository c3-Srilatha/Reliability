/**
 * Type representing a combination of {@link Metric} & {@link Interval}
 */
type LegacyMetric {

  /**
   * Metric expression as could be specified in EvalMetricSpec#expression or metric definition itself. Note if the provided
   * metric uses other metrics, be sure to ensure that those metrics exist
   * {@see Metric}
   * {@see EvalMetricSpec#expression}
   */
  metric: string | Metric

  /**
   * Interval for the metric
   */
  interval: string enum Interval

  /**
   * Name of the metric
   */
  metricName: inline member function(): !string
}
