/**
 * Configuration for Feature Store that is used to specify whether or not materialization or snapshot creation is
 * allowed for any {@link Feature} or {@link Feature.Set}. No additional fields apart from `doNotMaterialize` should
 * be included on this config
 */
@beta
type Feature.Store.MaterializationConfig mixes Config, Singleton {

  /**
   * When doNotMaterialize is set to True any attempts to materialize data will fail. This can be enabled as a
   * security measure to prevent unwanted writing of data to the file system. This will override any `doNotMaterialize`
   * flag on {@link Feature} or {@link Feature.Set}
   */
  doNotMaterialize: boolean
}
