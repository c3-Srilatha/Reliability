/**
 * It combines data from {@link Feature.Set.Snapshot} and {@link MlModel}
 * for an overview of a {@link Feature.Set.Snapshot}
 */
type Feature.Set.Snapshot.Overview mixes WithId {

  /**
   * count of {@link Feature.Set.Snapshot#subjects}
   */
  subjectCount: int = 0

  /**
   * count of {@link MlModel} associated with this snapshot
   */
  modelCount: int = 0

  /**
   * {@link Feature.Set.Snapshot#meta}
   */
  meta: Meta

  /**
   * {@link Feature.Set.Snapshot#subjectFilter}
   */
  subjectFilter: string

  /**
   * {@link Feature.Set.Snapshot#snapshotId}
   */
  snapshotId: string

  /**
   * {@link Feature.Set.Snapshot#start}
   */
  start: datetime

  /**
   * {@link Feature.Set.Snapshot#end}
   */
  end: datetime

  /**
   * {@link Feature.Set.Snapshot#description}
   */
  description: string

  /**
   * Fetch method for the bridge
   *
   * @param spec
   *          spec of the fetch call
   *
   * @return a collection of {@link Feature.Set.Snapshot.Overview} objects
   */
  fetch: function(spec: FetchSpec): FetchResult<Feature.Set.Snapshot.Overview>

  /**
   * Fetch count method for the bridge
   *
   * @param spec
   *          spec of the fetch call
   *
   * @return the number of total {@link Feature.Set.Snapshot.Overview}
   */
  fetchCount: function(spec: FetchFilterSpec): !int
}
