/**
 * One Snapshot.Subject refers to one {@link FeatureEvaluatable} subject, and it belongs to one {@link Feature.Set.Snapshot}
 */
@db(datastore="kv")
entity type Feature.Set.Snapshot.Subject mixes ParentPartitionable<Feature.Set.Snapshot> {

  /**
   * This is the id of the {@link FeatureEvaluatable} subject that is stored in the KvStore and we use this field as
   * the identifier of each Feature.Set.Snapshot.Subject instance.
   */
  subjectId: !string
}
