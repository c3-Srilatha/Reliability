/**
 * The result of a custom materialization.
 *
 * @see FeatureBase#src
 * @see FeatureBase#srcBatch
 * @see FeatureBase#execCustomLambda
 */
type Feature.CustomMaterializationResult {

  /**
   * The data to be returned from the custom lambda for materialization.
   * If the data is **Data** instance, then it will be converted to a native DataFrame and then, returned from the custom lambda.
   * Arrow, Pandas (1 & 2) and Polars are the supported DataFrame types.
   *
   * @see FeatureBase#src
   * @see FeatureBase#srcBatch
   */
  data: Data | native

  /**
   * If **timeRangeIgnored** is set, then the platform will ensure that the data returned above is the ONLY data
   * remaining for the subjects. Essentially, all the data for the input subjects will be deleted first before
   * materializing the above specified data.
   *
   * @see FeatureBase#src
   * @see FeatureBase#srcBatch
   */
  timeRangeIgnored: boolean
}
