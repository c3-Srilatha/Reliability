/**
 * BatchJob to pack the {@link Feature.Store.Block}s in a distributed mode.
 */
entity type Feature.Store.Block.PackJob extends BatchJob<Feature.Store.Block.PackJob, Feature.Store.Block.PackOptions, Feature.Store.Block.PackBatch> type key 'FSBP' {

  /**
   * Start a pack job by passing a PackOptions.
   */
  startPackJobWithOptions: function(options: !Feature.Store.Block.PackOptions): Feature.Store.Block.PackJob

  doStart:      ~
  processBatch: ~
}
