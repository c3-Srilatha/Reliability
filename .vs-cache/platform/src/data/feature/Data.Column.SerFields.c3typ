/**
 * This type stores the aggregated meta information created while serializing Data.Columns.
 */
abstract type Data.Column.SerFields {

  /**
   * The number of rows. This rowCount can be for a single subject or for the total of a batch of subjects, depending on
   * where this meta type is used.
   */
  rowCount: int

  /**
   * The memory size of the serialized {@link Data.Column}s subjects. The unit of the memory size is Byte.
   */
  inMemorySize: int

  /**
   * The serialized {@link Data.Column}s as bytes subjects.
   */
  bytes: binary
}
