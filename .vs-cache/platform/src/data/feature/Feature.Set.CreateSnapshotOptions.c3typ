/**
 * Options for {@link Feature.Set.CreateSnapshotJob}
 * See parent type {@link MapReduceOptions} for additional option fields
 * such as {@link MapReduceOptions.filter} and {@link MapReduceOptions.batchSize}
 */
type Feature.Set.CreateSnapshotOptions mixes MapReduceOptions {

  /**
   * Subject type for `features`
   */
  subjectType: !Type<<FeatureEvaluatable>>

  /**
   * snapshotId is used to make the right snapshot table name
   */
  snapshotId: !string

  /**
   * The name of the {@link Feature.Set} that is used to create the snapshot. Note that this requires the Feature.Set to
   * be upserted and materialized first.
   */
  featureSet: !string serialized Feature.Set

  /**
   * Specification for {@link FeatureEvaluatable#evalFeature} and {@link FeatureEvaluatable#evalFeatureSet}.
   *
   * Used to define a time range for which we want to eval a feature or a featureset.
   */
  spec: CreateSnapshotSpec
}
