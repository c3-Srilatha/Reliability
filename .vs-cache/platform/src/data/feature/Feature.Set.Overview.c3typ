/**
 * It combines data from {@link Feature.Set} and {@link MlModel}
 * for an overview of a {@link Feature.Set}
 */
type Feature.Set.Overview mixes FeatureOverviewBase {

  /**
   * {@link Feature.Set#features}
   */
  features: set<!string serialized Feature>

  /**
   * count of {@link Feature.Set#columns} if featureSet is lambda backed and {@link Feature.Set#features} otherwise
   */
  featureCount: int = 0

  /**
   * Fetch method for the bridge
   *
   * @param spec
   *          spec of the fetch call
   *
   * @return a collection of {@link Feature.Set.Overview} objects
   */
  fetch: function(spec: FetchSpec): FetchResult<Feature.Set.Overview>

  /**
   * Fetch count method for the bridge
   *
   * @param spec
   *          spec of the fetch call
   *
   * @return the number of total {@link Feature.Set.Overview}
   */
  fetchCount: function(spec: FetchFilterSpec): !int
}
