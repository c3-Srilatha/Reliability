/**
 * type containing blocks associated for associated {@link FeatureEvaluatable.Bin}
 */
private type Feature.Store.Blocks mixes FeatureEvaluatable.Bin {

  /**
   * Blocks associated with the current bin
   */
  blocks: [Feature.Store.Block]

  /**
   * @return an array of {@link Feature.Store.Blocks} after combining the bins and the blocks
   */
  fromBinsAndBlocks: function(bins: ![FeatureEvaluatable.Bin],
                              blocks: ![Feature.Store.Block]): ![Feature.Store.Blocks]
}
