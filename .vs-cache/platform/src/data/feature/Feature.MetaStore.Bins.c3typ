private type Feature.MetaStore.Bins mixes Result {

  /**
   * Bins satisfying the query with minimal cost
   */
  bins: [FeatureEvaluatable.Bin]

  /**
   * Filter encapsulating the logic to filter the {@link Feature.Store.Block}s.
   */
  baseFilter: Filter

  /**
   * @return an array of **Feature.Store.Blocks** (notice the extra s) after fetching the {@link Feature.Store.Block} for the {@link #bins} along with the {@link #baseFilter}
   */
  blocks: member function(): [Feature.Store.Blocks]
}
