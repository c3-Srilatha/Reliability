native py remix type Feature.Store {

  /**
   * Helper method to store binaries in {@link Kv.Store}.
   *
   * @param table_name
   *           name of the table for which the data should be stored at.
   * @param id
   *           id in the table for which the data should be stored at.
   * @param data
   *           data as `pd.DataFrame` to store.
   * @param spec
   *           spec controlling write behavior.
   */
  @call(stayInEngine=true)
  write_pandas_to_pickle_store: private member function(table_name: !string,
                                                        id: !string,
                                                        data: !native,
                                                        spec: Feature.Store.WriteSpec): !Feature.Store.WriteMetadata py

  /**
   * Helper method to store arrow binaries in {@link Kv.Store}.
   *
   * @param table_name
   *           name of the table for which the data should be stored at.
   * @param id
   *           id in the table for which the data should be stored at.
   * @param data
   *           data as `pd.DataFrame` to store.
   * @param spec
   *           spec controlling write behavior.
   */
  @call(stayInEngine=true)
  write_pandas_to_arrow_store: private member function(table_name: !string,
                                                       id: !string,
                                                       data: !native,
                                                       spec: Feature.Store.WriteSpec): !Feature.Store.WriteMetadata py

  /**
   * Helper method to store pandas in {@link Kv.Store}.
   *
   * @param table_name
   *           name of the table for which the data should be stored at.
   * @param id
   *           id in the table for which the data should be stored at.
   * @param data
   *           data as `pd.DataFrame` to store.
   * @param spec
   *           spec controlling write behavior.
   */
  @call(stayInEngine=true)
  write_pandas_to_store: private member function(table_name: !string,
                                                 id: !string,
                                                 data: !native,
                                                 spec: Feature.Store.WriteSpec): !Data py

  /**
   * Helper method to store pandas in {@link Kv.Store}.
   *
   * @param table_name
   *           name of the table for which the data should be stored at.
   * @param id
   *           id in the table for which the data should be stored at.
   * @param data
   *           data as `pd.DataFrame` to store.
   * @param spec
   *           spec controlling write behavior.
   */
  @call(stayInEngine=true)
  write_pandas_to_pushstream: private member function(table_name: !string,
                                                      id: !string,
                                                      data: !native,
                                                      spec: Feature.Store.WriteSpec): !Feature.Store.WriteMetadata py

  /**
   * Helper method to retrieve pickle binaries in {@link Kv.Store}.
   *
   * @param table_name
   *           name of the table for which the data is stored at.
   * @param id
   *           id in the table for which the data is stored at.
   * @param local
   *           if True, read persisted data from the local filesystem. Otherwise, read from the remote.
   * @return data as a `pd.DataFrame`.
   */
  @call(stayInEngine=true)
  read_pandas_from_store: private member function(table_name: !string, id: !string, local: boolean): !native py

  /**
   * Helper method to retrieve arrow binaries in {@link Kv.Store}.
   *
   * @param table_name
   *           name of the table for which the data is stored at.
   * @param id
   *           id in the table for which the data is stored at.
   * @param local
   *           if True, read persisted data from the local filesystem. Otherwise, read from the remote.
   * @return data as a `pd.DataFrame`.
   */
  @call(stayInEngine=true)
  read_pandas_from_arrow_store: private member function(table_name: !string, id: !string, local: boolean): !native py

  /**
   * Helper method to construct base directory.
   *
   * @param table_name
   *           name of the table for which the data is stored at.
   * @param id
   *           id in the table for which the data is stored at.
   * @return base directory as string
   */
  @call(stayInEngine=true)
  baseDir: private function(table_name: !string, id: !string): !string py

  /**
   * For given dataframe, it validates the data generated by {@link Feature#src} or {@link Feature.Set#src}
   * for a lambda {@link Feature} or {@link Feature.Set}. Specifically, it checks whether:
   * - Data has a "subject" column.
   * - Data has a "timestamp" column if such is expected in {@link FeatureBase#_columns} and does not have one if it's unexpected.
   * - Data is being produced only for the subject we want. Strictly speaking, the actual subject from lambda should be the expected subject.
   * - Data's timestamps are: a. non-null, b. row-wise sorted from earliest to latest for each subject, and c. within the timerange of provided {@link EvalFeatureSpec}.
   * and throws error, if needed.
   *
   * Note: an empty dataframe is considered valid, i.e., it may genuinely have no data; in this case, the validations are skipped.
   *
   * @param df
   *        Dataframe (pyarrow.Table) to check
   * @param expected_subject
   *        Subject to expect in the {@link Feature.SUBJECT} column.
   * @param feature
   *        Instance of the feature or feature set itself
   * @param spec
   *        {@link EvalFeatureSpec} of the lambda feature or feature set
   */
  @call(stayInEngine=true)
  validate_src_df: private member function(df: !native,
                                           expected_subject: !string,
                                           feature: !FeatureBase,
                                           spec: EvalFeatureSpec) py

  /**
   * For given dataframe, it validates the data generated by {@link Feature#srcBatch} or {@link Feature.Set#srcBatch}
   * for a lambda {@link Feature} or {@link Feature.Set}. Specifically, it performs all checks of {@link Feature.Store.py#validate_src_df} with the only difference that:
   * - Data is being produced only for the subjects we want. Strictly speaking, actual subjects from lambda should be a subset of the expected subjects.
   * and additionally checks that:
   * - Data is row-wise grouped by the "subject" column.
   * and throws error, if needed.
   *
   * Note: an empty dataframe is considered valid, i.e., it may genuinely have no data; in this case, the validations are skipped.
   *
   * @param df
   *        Dataframe (pyarrow.Table) to check
   * @param expected_subjects
   *        Array of all subjects to expect in the {@link Feature.SUBJECT} column. This collection will be de-duplicated to contain only distinct elements.
   * @param feature
   *        Instance of the feature or feature set itself
   * @param spec
   *        {@link EvalFeatureSpec} of the lambda feature or feature set
   */
  @call(stayInEngine=true)
  validate_srcBatch_df: private member function(df: !native,
                                                expected_subjects: ![string],
                                                feature: !FeatureBase,
                                                spec: EvalFeatureSpec) py

  /**
   * For given dataframe, it rearranges the columns of the dataframe to have {@link Feature.SUBJECT} and {@link Feature.TIMESTAMP} as the first two columns.
   * @param df
   *        Dataframe (pyarrow.Table) to check
   * @param feature
   *        Instance of the feature or feature set itself
   * @param spec
   *        {@link EvalFeatureSpec} of the lambda feature or feature set
   */
  @call(stayInEngine=true)
  rearrange_df_cols: private member function(df: !native, feature: !FeatureBase, spec: EvalFeatureSpec): native py
}
