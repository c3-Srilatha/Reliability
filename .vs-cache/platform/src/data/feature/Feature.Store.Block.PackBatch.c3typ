/**
 * This type contains the information that is needed to pack a batch of {@link Feature.Store.Block}s into one single block.
 */
type Feature.Store.Block.PackBatch {

  /**
   * The set of subject ids that this batch will pack
   */
  subjects: !set<string>

  /**
   * The strategy id of for the {@link Feature} or {@link Feature.Set} used for this pack job
   */
  strategyId: !string

  /**
   * The bin number of the bin where all the blocks in this batch are grouped
   */
  bin: !int

  /**
   * The featureFingerprint of the {@link Feature} or {@link Feature.Set} used for this pack job
   */
  featureFingerprint: !string

  start: datetime
  end:   datetime

  /**
   * The table name of the new packed blocks
   */
  tableName: !string

  /**
   * The blocks to be packed. These blocks will eventually form a "rectangle", which means that all the subjects in each block
   * should have the same timeRange after this function call, i.e. there won't be any missing timeRange gaps or extra timeRanges.
   */
  blocks: ![!Feature.Chunk.DfBldr.Block]
}
