/**
 * MapReduce job to process feature materialization in a distributed mode.
 *
 * Use {@link #filter} if there is a need to select a subset of subjects for materialization. By default, (if unspecified), all subjects will be materialized.
 */
entity type Feature.Store.MaterializationJob<SubjectType: FeatureEvaluatable> extends MapReduce<SubjectType, void, void, void>
                                                                              mixes FeatureEvaluatable.Bin.JobBase, Feature.Store.MaterializationOptions
                                                                              type key 'FMRJ' {

  /**
   * Overridden to create and initialize the Binning strategy if it has not been done already.
   */
  readInput: ~

  /**
   * Overridden to increasing the probability of subjects belonging to the same bin ending up in the same map task / batch.
   * Simply uses {@link MapReduce#scanTargetType} to get the original stream and then, uses the {@link FeatureBase#latestStrategy} to identify the bins and then, co-locating the ids. This will ensure that when batches are cut from the **stream**, the ids
   * belonging to the same bin are most likely to end up in the same batch.
   */
  scanTargetType: ~

  map: ~

  /**
   * Overridden to marking the {@link FeatureBase#latestStrategy} as "operationally ready" once the data has been materialized.
   */
  completed: ~

  /**
   * The TimeRange used for materialization. Determined by the start and end fields of {@link Feature.MaterializationSpec}
   */
  timeRange: TimeRange
}
