/**
 * Combines data from {@link Feature}, {@link Feature.Set}, and {@link MlModel}
 * for an overview of a {@link Feature}
 */
type Feature.Overview mixes FeatureOverviewBase {

  /**
   * {@link Feature#valueType}
   */
  valueType: string serialized ValueType

  /**
   * Fetch method for the bridge
   *
   * @param spec
   *          spec of the fetch call
   *
   * @return a collection of {@link Feature.Overview} objects
   */
  fetch: function(spec: FetchSpec): FetchResult<Feature.Overview>

  /**
   * Fetch count method for the bridge
   *
   * @param spec
   *          spec of the fetch call
   *
   * @return the number of total {@link Feature.Overview}
   */
  fetchCount: function(spec: FetchFilterSpec): !int
}
