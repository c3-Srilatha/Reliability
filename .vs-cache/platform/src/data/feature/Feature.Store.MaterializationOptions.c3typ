/**
 * Feature Materialization Options for {@link Feature.Store.MaterializationJob}.
 */
type Feature.Store.MaterializationOptions mixes MapReduceOptions {

  TRIAL_MODE_SNAPSHOT: private const string = "TRIAL"

  /**
   * Subject type for `features`
   */
  subjectType: !Type<<FeatureEvaluatable>>

  /**
   * Feature names, Feature.Set ids to materialize
   */
  features: ![string]

  /**
   * If this app is currently in trial mode
   */
  trialMode: boolean
}
