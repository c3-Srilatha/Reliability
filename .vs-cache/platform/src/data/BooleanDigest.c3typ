/**
 * Summary statistics of a boolean value set.
 */
type BooleanDigest mixes Digest<?boolean, BooleanDigest, DigestBuilder<BooleanDigest>> {

  /**
   * The number of true boolean values
   */
  trueCount: !int

  /**
   * The number of false boolean values
   */
  falseCount: !int

  /**
   * Sugar function for getting the percentage of true booleans evaluated.
   */
  truePercent: member function(): !double

  /**
   * Frequency of true and false values
   */
  histogram: BooleanHistogram schema suffix 'HIST'
}
