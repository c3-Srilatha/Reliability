/**
 * Generic Histogram of any type.
 */
abstract type Histogram<VT, H, HB: HistogramBuilder> mixes Stats<H, HB> {

  /**
   * Bins for the histogram
   */
  bins: [HistogramBin<VT>] schema suffix 'BNS'

  /**
   * Stored {@link HistogramSpec} for this Histogram
   */
  spec: HistogramSpec schema suffix 'SPC'

  /**
   * Count of all the elements in consideration to generate this histogram
   */
  count: member function(): !int

  /**
   * Min of all the data points in the histogram
   */
  min: member function(): VT

  /**
   * Max of all the data points in the histogram
   */
  max: member function(): VT

  /**
   * Throws a descriptive error if histogram is not well-formed. Well-formed has a different meaning for each histogram
   * subtype, but basic correctness such as bin order, bin boundary values, etc. are checked.
   */
  validate: abstract member function(): !H

  /**
   * Produce an ASCII art bar chart, one line per histogram bucket.
   * @param ignoreDensity
   *    if set to True, histogram y-axis will simply plot the count of each bin
   *    if set to false (default), the histogram y-axis will plot percent per unit.
   *    This allows the histogram to normalize the count against the bin width and forces
   *    the area of the bins in the histogram to add up to 100%.
   *    Example: say a Histogram has 10 total points, and a given bin has width of 2 units and 5 values in that bin
   *    ignoreDensity is True: height of bar is 5 divided by 10 to get the percentage,
   *    then again divided by 2 because that is the unit length. Final height =  0.25 percent per unit
   *    ignoreDensity is False: Height is just count of values in bin. Final height =  5 values
   */
  toString: inline member function(ignoreDensity: !?boolean): string

  toString: inline member function(): string

  /**
   * @return a bin for the start value
   *
   * @param: startValue
   *         {@see HistogramBin.startValue}
   */
  binForStartValue: member function(startValue: !any): HistogramBin<VT>

  /**
   * Calculate values for the provided Histogram and percentiles.
   * Percentiles must be in range [0-1) (0 inclusive and 1 exclusive).
   * e.g .25, .50, .75, .999
   */
  percentiles: member function(percentiles: ![double]): [VT]

  /**
   * Calculate value for the provided Histogram and percentile.
   * Percentiles must be in range [0-1) (0 inclusive and 1 exclusive).
   * e.g .25, .50, .75, .999
   */
  percentile: member function(percentile: !double): VT

  /**
   * Calculate quantile values for the provided Histogram such that the distribution is divided in
   * `num` equal parts/ranges. A quantile with `num` will result in `num - 1` values in the output array.
   * e.g Few widely used quantiles are:
   * quantile(4) => percentiles([.25, .50, .75]). [**quartile**]
   * quantile(10) => percentiles([.10, .20, .30, .40, .50, .60, .70, .80, .90]). [**decile**]
   */
  quantile: member function(n: !int): [VT]

  statsBuilder: function(spec: !?HistogramSpec): HB

  /**
   * @return true if its an instance of BooleanHistogram.
   */
  isBoolean: member function(): !boolean

  /**
   * @return true if its an instance of CharHistogram.
   */
  isChar: member function(): !boolean

  /**
   * @return true if its an instance of NumericHistogram.
   */
  isNumeric: member function(): !boolean

  /**
   * @return the elementType of the current Histogram.
   */
  elementType: cached member function(): !ValueType
}
