/**
 * Spec for generating a string value. See {@link Data.generate} & {@link Data.profile}.
 */
type DataGenStr mixes DataGenPrimitive<string> {

  /**
   * Prefix of the generated value.
   */
  prefix: string

  /**
   * Range of length of generated string value.
   */
  length: DataGenInt

  /**
   * Typical value for a generated string.
   */
  kind: string enum RndStrKind
}
