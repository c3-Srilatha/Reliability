@beta
type DatasetInfo mixes Result {

  /**
   * @return best effort estimate of in-memory dataset size as formatted string
   */
  memorySizeFormatted: !string

  /**
   * @return best effort estimate of size of the source content [ typically files ] of this dataset as formatted string
   */
  sourceSizeFormatted: !string
}
