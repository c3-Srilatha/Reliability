/**
 * Specification for how to convert {@link Data} to a {@link Workflow} in {@link Data#toWorkflow}
 */
@beta
private type DataToWorkflowSpec {

  /**
   * If enabled then generated Workflow will replace any previously computed sub-graphs with a {@link Workflow.Const}
   * vertex.
   */
  useCachedData: boolean

  /**
   * If set, then the generated Workflow will not replace non-Data C3 actions producing Data. This must only be used in
   * retrieving the "representative" Workflow for Data.
   */
  doNotPreExecuteNonPyActions: boolean

  /**
   * If set, then sort the generated Workflow in topological order
   */
  sorted: boolean = false

  /**
   * The dataset in which to look for cached data. Used in conjunction with useCachedData
   */
  dataset: Dataset
}
