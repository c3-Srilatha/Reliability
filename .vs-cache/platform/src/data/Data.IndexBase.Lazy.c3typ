/**
 * Base Index Lazy type that all Data.Index lazy subtypes inherit from
 */
@beta
abstract private type Data.IndexBase.Lazy mixes DataImpl.Lazy, Data.IndexBase {

  _exec:              ~ from DataImpl.Lazy
  toDataRef:          ~: Data.IndexBase.Ref
  cacheParentMethods: private cached function(): set<string>
  toDataPandas:       ~

  @reClaim(inherit=true)
  @java(codeGenSetCached=true)
  _toPandas: private cached member function(datasetId: !string, returnNullIfNotCached: boolean): Data.IndexBase.Pandas

  cache:    ~
  isCached: ~
}
