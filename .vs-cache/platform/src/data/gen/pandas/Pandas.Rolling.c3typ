@deprecated(finalVersion="8.9",
            details="All the pandas subtypes apis are deprecated on Data types and will be removed in a future release")
abstract type Pandas.Rolling<R: DataImpl> mixes Value {

  win_type:  private abstract property(): ?any
  aggregate: abstract member function(func: ?any): ?R
  corr:      abstract member function(other: ?any, pairwise: ?boolean, ddof: ?int): ?R
  count:     abstract member function(): ?R
  cov:       abstract member function(other: ?any, pairwise: ?boolean, ddof: ?int): ?R
  kurt:      abstract member function(): ?R
  max:       abstract member function(engine: ?string, engine_kwargs: ?map<string, boolean>): ?R
  mean:      abstract member function(engine: ?string, engine_kwargs: ?map<string, boolean>): ?R
  median:    abstract member function(engine: ?string, engine_kwargs: ?map<string, boolean>): ?R
  min:       abstract member function(engine: ?string, engine_kwargs: ?map<string, boolean>): ?R
  quantile:  abstract member function(quantile: ?float, interpolation: ?string): ?R
  sem:       abstract member function(ddof: ?int): ?R
  skew:      abstract member function(): ?R
  std:       abstract member function(ddof: ?int): ?R
  sum:       abstract member function(engine: ?string, engine_kwargs: ?map<string, boolean>): ?R
  var:       abstract member function(ddof: ?int): ?R
}
