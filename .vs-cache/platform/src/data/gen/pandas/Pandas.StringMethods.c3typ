@deprecated(finalVersion="8.9",
            details="All the pandas subtypes apis are deprecated on Data types and will be removed in a future release")
abstract type Pandas.StringMethods<R: DataImpl> mixes Value {

  capitalize:  abstract member function(): ?R
  casefold:    abstract member function(): ?R
  cat:         abstract member function(others: ?any, sep: ?any, na_rep: ?any, join: ?any): ?(R | string)
  center:      abstract member function(width: ?any, fillchar: ?any): ?R
  contains:    abstract member function(pat: ?any, case: ?any, flags: ?any, na: ?any, regex: ?any): ?R
  count:       abstract member function(pat: ?any, flags: ?any): ?R
  decode:      abstract member function(encoding: ?any, errors: ?any): ?R
  encode:      abstract member function(encoding: ?any, errors: ?any): ?R
  endswith:    abstract member function(pat: ?any, na: ?any): ?R
  extract:     abstract member function(pat: ?string, flags: ?int, expand: ?boolean): ?(R | string)
  extractall:  abstract member function(pat: ?any, flags: ?any): ?Data
  find:        abstract member function(sub: ?any, start: ?any, end: ?any): ?R
  findall:     abstract member function(pat: ?any, flags: ?any): ?R
  fullmatch:   abstract member function(pat: ?any, case: ?any, flags: ?any, na: ?any): ?R
  get:         abstract member function(i: ?any): ?R
  get_dummies: abstract member function(sep: ?any): ?Data
  index:       abstract member function(sub: ?any, start: ?any, end: ?any): ?R
  isalnum:     abstract member function(): ?R
  isalpha:     abstract member function(): ?R
  isdecimal:   abstract member function(): ?R
  isdigit:     abstract member function(): ?R
  islower:     abstract member function(): ?R
  isnumeric:   abstract member function(): ?R
  isspace:     abstract member function(): ?R
  istitle:     abstract member function(): ?R
  isupper:     abstract member function(): ?R
  join:        abstract member function(sep: ?any): ?R
  len:         abstract member function(): ?R
  ljust:       abstract member function(width: ?any, fillchar: ?any): ?R
  lower:       abstract member function(): ?R
  lstrip:      abstract member function(to_strip: ?any): ?R
  match:       abstract member function(pat: ?any, case: ?any, flags: ?any, na: ?any): ?R
  normalize:   abstract member function(form: ?any): ?R
  pad:         abstract member function(width: ?any, side: ?any, fillchar: ?any): ?R
  partition:   abstract member function(sep: ?any, expand: ?any): ?(R | Data | Data.MultiIndex)
  repeat:      abstract member function(repeats: ?any): ?R

  replace: abstract member function(pat: ?any,
                                    repl: ?((lambda(x: any ...): any) | string),
                                    n: ?int,
                                    case: ?boolean,
                                    flags: ?int,
                                    regex: ?boolean): ?R

  rfind:         abstract member function(sub: ?any, start: ?any, end: ?any): ?R
  rindex:        abstract member function(sub: ?any, start: ?any, end: ?any): ?R
  rjust:         abstract member function(width: ?any, fillchar: ?any): ?R
  rpartition:    abstract member function(sep: ?any, expand: ?any): ?(R | Data | Data.MultiIndex)
  rsplit:        abstract member function(pat: ?any, n: ?any, expand: ?any): ?(R | Data | Data.MultiIndex)
  rstrip:        abstract member function(to_strip: ?any): ?R
  slice:         abstract member function(start: ?any, stop: ?any, step: ?any): ?R
  slice_replace: abstract member function(start: ?any, stop: ?any, repl: ?any): ?R
  split:         abstract member function(pat: ?any, n: ?any, expand: ?any): ?(R | Data | Data.MultiIndex)
  startswith:    abstract member function(pat: ?any, na: ?any): ?R
  strip:         abstract member function(to_strip: ?any): ?R
  swapcase:      abstract member function(): ?R
  title:         abstract member function(): ?R
  translate:     abstract member function(table: ?any): ?R
  upper:         abstract member function(): ?R
  wrap:          abstract member function(width: ?any): ?R
  zfill:         abstract member function(width: ?any): ?R
}
