abstract type Pandas.CategoricalIndex mixes Value, Pandas.Index<Data.CategoricalIndex> {

  categories: abstract property()
                         : ?(Data.Index | Data.RangeIndex | Data.MultiIndex | Data.CategoricalIndex | Data.IntervalIndex | Data.PeriodIndex | Data.DatetimeIndex | Data.TimedeltaIndex | Data.Int64Index | Data.UInt64Index | Data.Float64Index)

  codes:                    abstract property(): ?[any]
  inferred_type:            abstract property(): ?string
  ordered:                  abstract property(): ?any
  add_categories:           abstract member function(new_categories: any): ?Data.CategoricalIndex
  argsort:                  abstract member function(): ?[any]
  as_ordered:               abstract member function(): ?Data.CategoricalIndex
  as_unordered:             abstract member function(): ?Data.CategoricalIndex
  equals:                   abstract member function(other: ?any): ?boolean
  fillna:                   abstract member function(value: ?any, downcast: ?any): ?Data.CategoricalIndex
  is_dtype_equal:           abstract member function(other: any): ?any
  map:                      abstract member function(mapper: ?any): ?Data.Index
  max:                      private abstract member function(): ?any
  min:                      private abstract member function(): ?any
  remove_categories:        abstract member function(removals: any): ?Data.CategoricalIndex
  remove_unused_categories: abstract member function(): ?Data.CategoricalIndex
  rename_categories:        abstract member function(new_categories: any): ?Data.CategoricalIndex
  reorder_categories:       abstract member function(new_categories: any, ordered: boolean): ?Data.CategoricalIndex

  set_categories: abstract member function(new_categories: any,
                                           ordered: boolean,
                                           rename: boolean): ?Data.CategoricalIndex

  @pandas(canReturnData=true)
  take_nd: abstract member function(indices: [any], axis: int, allow_fill: boolean, fill_value: any): ?any
}
