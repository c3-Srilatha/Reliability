@deprecated(finalVersion="8.9",
            details="All the pandas subtypes apis are deprecated on Data types and will be removed in a future release.")
abstract private type Pandas.ExponentialMovingWindow<R: DataImpl> mixes Value {

  agg:       abstract member function(func: ?any): ?(Data | Data.Series | int)
  aggregate: abstract member function(func: ?any): ?(Data | Data.Series | int)
  corr:      abstract member function(other: ?any, pairwise: ?boolean): ?R
  cov:       abstract member function(other: ?any, pairwise: ?boolean, bias: ?boolean): ?R
  mean:      abstract member function(engine: ?any, engine_kwargs: ?any): ?R
  std:       abstract member function(bias: ?boolean): ?R
  var:       abstract member function(bias: ?boolean): ?R
}
