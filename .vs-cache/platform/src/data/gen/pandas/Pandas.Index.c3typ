@deprecated(finalVersion="8.9",
            details="All the pandas subtypes apis are deprecated on Data types and will be removed in a future release")
abstract type Pandas.Index<R: DataImpl> mixes Value {

  T:                       abstract property(): ?R
  array:                   private abstract property(): ?[any]
  dtype:                   private abstract property(): ?any
  empty:                   abstract property(): ?any
  has_duplicates:          abstract property(): ?boolean
  hasnans:                 abstract property(): ?any
  inferred_type:           abstract property(): ?any
  is_all_dates:            abstract property(): ?any
  is_monotonic:            abstract property(): ?any
  is_monotonic_decreasing: abstract property(): ?any
  is_monotonic_increasing: abstract property(): ?any
  is_unique:               abstract property(): ?any
  name:                    private abstract property(): ?any
  names:                   abstract property(): ?any
  nbytes:                  abstract property(): ?int
  ndim:                    abstract property(): ?int
  nlevels:                 abstract property(): ?int
  size:                    abstract property(): ?int
  values:                  private abstract property(): ?any

  @pandas(canReturnData=true)
  all: abstract member function(): ?any

  @pandas(canReturnData=true)
  any: abstract member function(): ?any

  append: abstract member function(other: ?any)
                            : ?(Data.Index | Data.RangeIndex | Data.MultiIndex | Data.CategoricalIndex | Data.IntervalIndex | Data.PeriodIndex | Data.DatetimeIndex | Data.TimedeltaIndex | Data.Int64Index | Data.UInt64Index | Data.Float64Index)

  argmax:    abstract member function(axis: ?any, skipna: ?any): ?int
  argmin:    abstract member function(axis: ?any, skipna: ?any): ?int
  argsort:   abstract member function(): ?[any]
  asof:      abstract member function(label: ?any): ?any
  asof_locs: private abstract member function(where: ?any, mask: ?any): ?[any]

  astype: abstract member function(dtype: ?any,
                                   copy: ?any)
                            : ?(Data.Index | Data.RangeIndex | Data.MultiIndex | Data.CategoricalIndex | Data.IntervalIndex | Data.PeriodIndex | Data.DatetimeIndex | Data.TimedeltaIndex | Data.Int64Index | Data.UInt64Index | Data.Float64Index)

  copy: abstract member function(name: ?any,
                                 deep: ?any,
                                 dtype: ?any,
                                 names: ?any)
                          : ?(Data.Index | Data.RangeIndex | Data.MultiIndex | Data.CategoricalIndex | Data.IntervalIndex | Data.PeriodIndex | Data.DatetimeIndex | Data.TimedeltaIndex | Data.Int64Index | Data.UInt64Index | Data.Float64Index)

  delete: abstract member function(loc: ?any)
                            : ?(Data.Index | Data.RangeIndex | Data.MultiIndex | Data.CategoricalIndex | Data.IntervalIndex | Data.PeriodIndex | Data.DatetimeIndex | Data.TimedeltaIndex | Data.Int64Index | Data.UInt64Index | Data.Float64Index)

  difference: abstract member function(other: ?any,
                                       sort: ?any)
                                : ?(Data.Index | Data.RangeIndex | Data.MultiIndex | Data.CategoricalIndex | Data.IntervalIndex | Data.PeriodIndex | Data.DatetimeIndex | Data.TimedeltaIndex | Data.Int64Index | Data.UInt64Index | Data.Float64Index)

  @pandas(canReturnData=true)
  drop: abstract member function(labels: ?any, errors: ?any): ?any

  drop_duplicates: abstract member function(keep: ?any): ?R
  droplevel:       abstract member function(level: ?any): ?(Data.Index | Data.MultiIndex)
  dropna:          abstract member function(how: ?any): ?R
  duplicated:      abstract member function(keep: ?any): ?[boolean]
  equals:          abstract member function(other: ?any): ?boolean

  @pandas(canReturnData=true)
  fillna: abstract member function(value: ?any, downcast: ?any): ?any

  format:          abstract member function(name: ?any, formatter: ?lambda(x: any ...): any, na_rep: ?any): ?[string]
  get_indexer:     abstract member function(target: ?any, method: ?any, limit: ?int, tolerance: ?any): ?[any]
  get_indexer_for: abstract member function(target: ?any): ?[any]

  get_level_values: abstract member function(level: ?any)
                                      : ?(Data.Index | Data.RangeIndex | Data.MultiIndex | Data.CategoricalIndex | Data.IntervalIndex | Data.PeriodIndex | Data.DatetimeIndex | Data.TimedeltaIndex | Data.Int64Index | Data.UInt64Index | Data.Float64Index)

  get_loc:         abstract member function(key: ?any, method: ?any, tolerance: ?any): ?(int | AnySlice | [boolean])
  get_slice_bound: abstract member function(label: ?any, side: ?any, kind: ?any): ?int

  @pandas(canReturnData=true)
  get_value: abstract member function(series: ?any, key: ?any): ?any

  @pandas(canReturnData=true)
  groupby: abstract member function(values: ?any): ?any

  holds_integer: abstract member function(): ?boolean
  identical:     abstract member function(other: ?any): ?boolean

  @pandas(canReturnData=true)
  insert: abstract member function(loc: ?int, item: ?any): ?any

  intersection: abstract member function(other: ?any,
                                         sort: ?any)
                                  : ?(Data.Index | Data.RangeIndex | Data.MultiIndex | Data.CategoricalIndex | Data.IntervalIndex | Data.PeriodIndex | Data.DatetimeIndex | Data.TimedeltaIndex | Data.Int64Index | Data.UInt64Index | Data.Float64Index)

  is_:                abstract member function(other: ?any): ?boolean
  is_boolean:         abstract member function(): ?boolean
  is_categorical:     abstract member function(): ?boolean
  is_floating:        abstract member function(): ?boolean
  is_integer:         abstract member function(): ?boolean
  is_interval:        abstract member function(): ?boolean
  is_mixed:           abstract member function(): ?boolean
  is_numeric:         abstract member function(): ?boolean
  is_object:          abstract member function(): ?boolean
  is_type_compatible: abstract member function(kind: ?any): ?boolean
  isin:               abstract member function(values: ?any, level: ?any): ?[any]
  isna:               abstract member function(): ?[any]
  isnull:             abstract member function(): ?[any]
  item:               abstract member function(): ?any
  map:                private abstract member function(mapper: ?any, na_action: ?any): ?(Data.Index | Data.MultiIndex)
  max:                abstract member function(axis: ?any, skipna: ?any): ?any
  memory_usage:       abstract member function(deep: ?any): ?int
  min:                abstract member function(axis: ?any, skipna: ?any): ?any
  notna:              abstract member function(): ?[any]
  notnull:            abstract member function(): ?[any]
  nunique:            abstract member function(dropna: ?any): ?int

  putmask: abstract member function(mask: ?any,
                                    value: ?any)
                             : ?(Data.Index | Data.RangeIndex | Data.MultiIndex | Data.CategoricalIndex | Data.IntervalIndex | Data.PeriodIndex | Data.DatetimeIndex | Data.TimedeltaIndex | Data.Int64Index | Data.UInt64Index | Data.Float64Index)

  ravel:  private abstract member function(order: ?any): ?[any]
  rename: abstract member function(name: ?any, inplace: ?any): ?R

  @pandas(canReturnData=true)
  repeat: abstract member function(repeats: ?any, axis: ?any): ?any

  searchsorted:  private abstract member function(value: ?any, side: ?any, sorter: ?any): ?any
  set_names:     private abstract member function(names: ?any, level: ?any, inplace: ?any): ?R
  set_value:     private abstract member function(arr: ?any, key: ?any, value: ?any): ?any
  shift:         abstract member function(periods: ?any, freq: ?any): ?R
  slice_indexer: private abstract member function(start: ?any, end: ?any, step: ?int, kind: ?any): ?AnySlice
  sort:          private abstract member function(): ?any

  symmetric_difference: private abstract member function(other: ?any,
                                                         result_name: ?any,
                                                         sort: ?any)
                                                  : ?(Data.Index | Data.RangeIndex | Data.MultiIndex | Data.CategoricalIndex | Data.IntervalIndex | Data.PeriodIndex | Data.DatetimeIndex | Data.TimedeltaIndex | Data.Int64Index | Data.UInt64Index | Data.Float64Index)

  take: abstract member function(indices: ?any,
                                 axis: ?int,
                                 allow_fill: ?any,
                                 fill_value: ?any)
                          : ?(Data.Index | Data.RangeIndex | Data.MultiIndex | Data.CategoricalIndex | Data.IntervalIndex | Data.PeriodIndex | Data.DatetimeIndex | Data.TimedeltaIndex | Data.Int64Index | Data.UInt64Index | Data.Float64Index)

  to_flat_index: abstract member function()
                                   : ?(Data.Index | Data.RangeIndex | Data.MultiIndex | Data.CategoricalIndex | Data.IntervalIndex | Data.PeriodIndex | Data.DatetimeIndex | Data.TimedeltaIndex | Data.Int64Index | Data.UInt64Index | Data.Float64Index)

  to_frame:        abstract member function(index: ?any, name: ?any): ?Data
  to_list:         private abstract member function(): ?[any]
  to_native_types: private abstract member function(slicer: ?any): ?[any]
  to_series:       abstract member function(index: ?any, name: ?any): ?Data.Series
  tolist:          private abstract member function(): ?[any]
  transpose:       abstract member function(): ?R

  @pandas(canReturnData=true)
  union: abstract member function(other: ?any, sort: ?any): ?any

  unique: abstract member function(level: ?any)
                            : ?(Data.Index | Data.RangeIndex | Data.MultiIndex | Data.CategoricalIndex | Data.IntervalIndex | Data.PeriodIndex | Data.DatetimeIndex | Data.TimedeltaIndex | Data.Int64Index | Data.UInt64Index | Data.Float64Index)

  value_counts: abstract member function(normalize: ?any,
                                         sort: ?any,
                                         ascending: ?any,
                                         bins: ?any,
                                         dropna: ?any): ?Data.Series

  @pandas(canReturnData=true)
  view: abstract member function(cls: ?any): ?any

  where: private abstract member function(cond: ?any, other: ?any): ?Data.Index
}
