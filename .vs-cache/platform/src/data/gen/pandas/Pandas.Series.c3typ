  rfloordiv:   abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?Data.Series
  rmod:        abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?Data.Series
  rmul:        abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?Data.Series

