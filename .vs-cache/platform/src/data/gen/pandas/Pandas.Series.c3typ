                                         copy: ?any,
                                         limit: ?any,
                                         tolerance: ?any): ?Data.Series

  rename: abstract member function(index: ?any,
                                   axis: ?any,
                                   copy: ?any,
                                   inplace: ?any,
                                   level: ?any,
                                   errors: ?any): ?Data.Series

  rename_axis:    abstract member function(mapper: ?any): ?Data.Series
  reorder_levels: private abstract member function(order: ?any): ?Data.Series
  repeat:         abstract member function(repeats: ?any, axis: ?any): ?Data.Series

  replace: abstract member function(to_replace: ?any,
                                    value: ?any,
                                    inplace: ?any,
                                    limit: ?int,
                                    regex: ?any,
