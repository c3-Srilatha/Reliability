@deprecated(finalVersion="8.9",
            details="All the pandas subtypes apis are deprecated on Data types and will be removed in a future release")
abstract type Pandas.Series mixes Value {

  T:     abstract property(): ?Data.Series
  array: private abstract property(): ?[any]
  attrs: abstract property(): ?map<any, any>

  @pandas(canReturnData=true)
  axes: private abstract property(): ?[any]

  dtype:   abstract property(): ?any
  dtypes:  abstract property(): ?any
  empty:   abstract property(): ?any
  flags:   private abstract property(): ?any
  hasnans: abstract property(): ?boolean
  iat:     private abstract property(): ?any
  iloc:    abstract property(): ?DataIlocIndexer

  index: abstract property()
                    : ?(Data.Index | Data.RangeIndex | Data.MultiIndex | Data.CategoricalIndex | Data.IntervalIndex | Data.PeriodIndex | Data.DatetimeIndex | Data.TimedeltaIndex | Data.Int64Index | Data.UInt64Index | Data.Float64Index)

  is_monotonic:            private abstract property(): ?any
  is_monotonic_decreasing: abstract property(): ?any
  is_monotonic_increasing: abstract property(): ?any
  is_unique:               abstract property(): ?any
  loc:                     abstract property(): ?DataLocIndexer
  nbytes:                  abstract property(): ?int
  ndim:                    abstract property(): ?int
  shape:                   abstract property(): ?any
  size:                    abstract property(): ?int
  values:                  private abstract property(): ?[any]
  abs:                     abstract member function(): ?Data.Series
  add:                     abstract member function(other: ?any,
                                                    level: ?any,
                                                    fill_value: ?any,
                                                    axis: ?any): ?Data.Series
  add_prefix:              abstract member function(prefix: ?string): ?Data.Series
  add_suffix:              abstract member function(suffix: ?string): ?Data.Series

  @pandas(canReturnData=true)
  agg: abstract member function(func: ?any, axis: ?any): ?any

  @pandas(canReturnData=true)
  aggregate: private abstract member function(func: ?any, axis: ?any): ?any

  @pandas(canReturnData=true)
  align: abstract member function(other: ?any,
                                  join: ?any,
                                  axis: ?any,
                                  level: ?any,
                                  copy: ?any,
                                  fill_value: ?any,
                                  method: ?any,
                                  limit: ?any,
                                  fill_axis: ?any,
                                  broadcast_axis: ?any): ?[any]

  @pandas(canReturnData=true)
  all: abstract member function(axis: ?any, bool_only: ?any, skipna: ?any, level: ?any): ?any

  @pandas(canReturnData=true)
  any: abstract member function(axis: ?any, bool_only: ?any, skipna: ?any, level: ?any): ?any

  append:  private abstract member function(to_append: ?any, ignore_index: ?any, verify_integrity: ?any): ?Data.Series
  apply:   abstract member function(func: ?any, convert_dtype: ?any, args: ?any): ?(Data | Data.Series)
  argmax:  abstract member function(axis: ?any, skipna: ?any): ?int
  argmin:  abstract member function(axis: ?any, skipna: ?any): ?int
  argsort: abstract member function(axis: ?any, kind: ?any, order: ?any): ?Data.Series

  asfreq: abstract member function(freq: ?any,
                                   method: ?any,
                                   how: ?string,
                                   normalize: ?any,
                                   fill_value: ?any): ?Data.Series

  @pandas(canReturnData=true)
  asof: abstract member function(where: ?any, subset: ?any): ?any

  astype:   abstract member function(dtype: ?any, copy: ?any, errors: ?string): ?Data.Series
  at_time:  abstract member function(time: ?any, asof: ?any, axis: ?any): ?Data.Series
  autocorr: abstract member function(lag: ?any): ?float
  backfill: abstract member function(axis: ?any, inplace: ?any, limit: ?int, downcast: ?any): ?Data.Series
  between:  abstract member function(left: ?any, right: ?any, inclusive: ?any): ?Data.Series

  between_time: abstract member function(start_time: ?any,
                                         end_time: ?any,
                                         include_start: ?any,
                                         include_end: ?any,
                                         axis: ?any): ?Data.Series

  bfill:         abstract member function(axis: ?any, inplace: ?any, limit: ?int, downcast: ?any): ?Data.Series
  bool:          private abstract member function(): ?any
  clip:          abstract member function(lower: ?any, upper: ?any, axis: ?any, inplace: ?any): ?Data.Series
  combine:       abstract member function(other: ?any, func: ?any, fill_value: ?any): ?Data.Series
  combine_first: abstract member function(other: ?any): ?Data.Series

  compare: abstract member function(other: ?Data.Series,
                                    align_axis: ?any,
                                    keep_shape: ?any,
                                    keep_equal: ?any): ?(Data | Data.Series)

  convert_dtypes: abstract member function(infer_objects: ?any,
                                           convert_string: ?any,
                                           convert_integer: ?any,
                                           convert_boolean: ?any,
                                           convert_floating: ?any): ?Data.Series

  copy: abstract member function(deep: ?any): ?Data.Series
  corr: abstract member function(other: ?any, method: ?any, min_periods: ?any): ?float

  @pandas(canReturnData=true)
  count: abstract member function(level: ?any): ?any

  cov:     abstract member function(other: ?Data.Series, min_periods: ?int, ddof: ?int): ?float
  cummax:  abstract member function(axis: ?any, skipna: ?any): ?Data.Series
  cummin:  abstract member function(axis: ?any, skipna: ?any): ?Data.Series
  cumprod: abstract member function(axis: ?any, skipna: ?any): ?Data.Series
  cumsum:  abstract member function(axis: ?any, skipna: ?any): ?Data.Series

  describe: abstract member function(percentiles: ?any,
                                     include: ?any,
                                     exclude: ?any,
                                     datetime_is_numeric: ?any): ?Data.Series

  diff:   abstract member function(periods: ?int): ?Data.Series
  div:    abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?Data.Series
  divide: abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?Data.Series

  @pandas(canReturnData=true)
  divmod: abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?[any]

  @pandas(canReturnData=true)
  dot: abstract member function(other: ?any): ?any

  drop: abstract member function(labels: ?any,
                                 axis: ?any,
                                 index: ?any,
                                 columns: ?any,
                                 level: ?any,
                                 inplace: ?any,
                                 errors: ?any): ?Data.Series

  drop_duplicates: abstract member function(keep: ?any, inplace: ?any): ?Data.Series
  droplevel:       private abstract member function(level: ?any, axis: ?any): ?Data.Series
  dropna:          abstract member function(axis: ?any, inplace: ?any, how: ?any): ?Data.Series
  duplicated:      abstract member function(keep: ?any): ?Data.Series
  eq:              abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?Data.Series
  equals:          abstract member function(other: ?any): ?any

  ewm: private abstract member function(com: ?float,
                                        span: ?float,
                                        halflife: ?any,
                                        alpha: ?float,
                                        min_periods: ?int,
                                        adjust: ?any,
                                        ignore_na: ?any,
                                        axis: ?any,
                                        times: ?any): ?Data.Series

  expanding: private abstract member function(min_periods: ?int, center: ?any, axis: ?any, method: ?string): ?any
  explode:   abstract member function(ignore_index: ?any): ?Data.Series

  @pandas(canReturnData=true)
  factorize: abstract member function(sort: ?any, na_sentinel: ?int): ?[any]

  ffill: abstract member function(axis: ?any, inplace: ?any, limit: ?int, downcast: ?any): ?Data.Series

  fillna: abstract member function(value: ?any,
                                   method: ?any,
                                   axis: ?any,
                                   inplace: ?any,
                                   limit: ?int,
                                   downcast: ?any): ?Data.Series

  filter:            abstract member function(items: ?any, like: ?string, regex: ?string, axis: ?any): ?Data.Series
  first:             abstract member function(offset: ?any): ?Data.Series
  first_valid_index: abstract member function(): ?any
  floordiv:          abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?Data.Series
  ge:                abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?Data.Series

  @pandas(canReturnData=true)
  get: abstract member function(key: ?any, default: ?any): ?any

  groupby: private abstract member function(by: ?any,
                                            axis: ?any,
                                            level: ?any,
                                            as_index: ?any,
                                            sort: ?any,
                                            group_keys: ?any,
                                            squeeze: ?any,
                                            observed: ?any,
                                            dropna: ?any): ?any

  gt:   abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?Data.Series
  head: abstract member function(n: ?int): ?Data.Series

  hist: private abstract member function(by: ?any,
                                         ax: ?any,
                                         grid: ?any,
                                         xlabelsize: ?int,
                                         xrot: ?float,
                                         ylabelsize: ?int,
                                         yrot: ?float,
                                         figsize: ?(int, int),
                                         bins: ?any,
                                         backend: ?string,
                                         legend: ?any): ?any

  idxmax:        abstract member function(axis: ?any, skipna: ?any): ?any
  idxmin:        abstract member function(axis: ?any, skipna: ?any): ?any
  infer_objects: abstract member function(): ?Data.Series

  interpolate: abstract member function(method: ?string,
                                        axis: ?any,
                                        limit: ?int,
                                        inplace: ?any,
                                        limit_direction: ?string,
                                        limit_area: ?string,
                                        downcast: ?string): ?Data.Series

  isin:      abstract member function(values: ?any): ?Data.Series
  isna:      abstract member function(): ?Data.Series
  isnull:    abstract member function(): ?Data.Series
  item:      private abstract member function(): ?any
  items:     abstract member function(): ?any
  iteritems: abstract member function(): ?any

  @pandas(canReturnData=true)
  keys: abstract member function(): ?any

  @pandas(canReturnData=true)
  kurt: abstract member function(axis: ?any, skipna: ?any, level: ?any, numeric_only: ?any): ?any

  @pandas(canReturnData=true)
  kurtosis: abstract member function(axis: ?any, skipna: ?any, level: ?any, numeric_only: ?any): ?any

  last:             abstract member function(offset: ?any): ?Data.Series
  last_valid_index: abstract member function(): ?any
  le:               abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?Data.Series
  lt:               abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?Data.Series

  @pandas(canReturnData=true)
  mad: abstract member function(axis: ?any, skipna: ?any, level: ?any): ?any

  map: private abstract member function(arg: ?any, na_action: ?any): ?Data.Series

  mask: abstract member function(cond: ?any,
                                 other: ?any,
                                 inplace: ?any,
                                 axis: ?any,
                                 level: ?any,
                                 errors: ?any,
                                 try_cast: ?any): ?Data.Series

  @pandas(canReturnData=true)
  max: abstract member function(axis: ?any, skipna: ?any, level: ?any, numeric_only: ?any): ?any

  @pandas(canReturnData=true)
  mean: abstract member function(axis: ?any, skipna: ?any, level: ?any, numeric_only: ?any): ?any

  @pandas(canReturnData=true)
  median: abstract member function(axis: ?any, skipna: ?any, level: ?any, numeric_only: ?any): ?any

  memory_usage: abstract member function(index: ?any, deep: ?any): ?int

  @pandas(canReturnData=true)
  min: abstract member function(axis: ?any, skipna: ?any, level: ?any, numeric_only: ?any): ?any

  mod:        abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?Data.Series
  mode:       abstract member function(dropna: ?any): ?Data.Series
  mul:        abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?Data.Series
  multiply:   private abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?Data.Series
  ne:         abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?Data.Series
  nlargest:   abstract member function(n: ?int, keep: ?any): ?Data.Series
  notna:      abstract member function(): ?Data.Series
  notnull:    abstract member function(): ?Data.Series
  nsmallest:  abstract member function(n: ?int, keep: ?string): ?Data.Series
  nunique:    abstract member function(dropna: ?any): ?int
  pad:        abstract member function(axis: ?any, inplace: ?any, limit: ?int, downcast: ?any): ?Data.Series
  pct_change: abstract member function(periods: ?int, fill_method: ?any, limit: ?int, freq: ?any): ?Data.Series
  pop:        abstract member function(item: ?any): ?any
  pow:        abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?Data.Series

  @pandas(canReturnData=true)
  prod: abstract member function(axis: ?any, skipna: ?any, level: ?any, numeric_only: ?any, min_count: ?any): ?any

  @pandas(canReturnData=true)
  product: abstract member function(axis: ?any, skipna: ?any, level: ?any, numeric_only: ?any, min_count: ?any): ?any

  quantile: abstract member function(q: ?any, interpolation: ?any): ?any
  radd:     abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?Data.Series

  rank: abstract member function(axis: ?any,
                                 method: ?string,
                                 numeric_only: ?any,
                                 na_option: ?string,
                                 ascending: ?any,
                                 pct: ?any): ?Data.Series

  ravel: abstract member function(order: ?any): ?[any]
  rdiv:  abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?Data.Series

  @pandas(canReturnData=true)
  rdivmod: abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?[any]

  reindex: abstract member function(index: ?any): ?Data.Series

  reindex_like: abstract member function(other: ?any,
