  round:    abstract member function(decimals: ?int): ?Data.Series
  rpow:     abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?Data.Series
  rsub:     abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?Data.Series
  rtruediv: abstract member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?Data.Series

  sample: abstract member function(n: ?int,
