@deprecated(finalVersion="8.9",
            details="All the pandas subtypes apis are deprecated on Data types and will be removed in a future release")
abstract private type Pandas.SeriesGroupBy mixes Value {

  corr:                    abstract property(): ?float
  cov:                     abstract property(): ?float
  diff:                    abstract property(): ?Data.Series
  dtype:                   abstract property(): ?any
  fillna:                  abstract property(): ?Data.Series
  hist:                    abstract property(): ?any
  idxmax:                  abstract property(): ?Pandas.Index
  idxmin:                  abstract property(): ?Pandas.Index
  is_monotonic_decreasing: abstract property(): ?boolean
  is_monotonic_increasing: abstract property(): ?any
  mad:                     abstract property(): ?Data.Series
  nlargest:                abstract property(): ?Data.Series
  nsmallest:               abstract property(): ?Data.Series
  skew:                    abstract property(): ?Data.Series
  take:                    abstract property(): ?(Data | Data.Series)
  tshift:                  abstract property(): ?(Data | Data.Series)
  unique:                  abstract property(): ?[any]
  agg:                     abstract member function(func: ?any, engine: ?any, engine_kwargs: ?any): ?Data.Series
  aggregate:               abstract member function(func: ?any, engine: ?any, engine_kwargs: ?any): ?Data.Series
  count:                   abstract member function(): ?Data.Series
  describe:                abstract member function(): ?(Data | Data.Series)
  filter:                  abstract member function(func: ?any, dropna: ?any): ?Data.Series
  nunique:                 abstract member function(dropna: ?boolean): ?Data.Series
  pct_change:              abstract member function(periods: ?any, fill_method: ?any, limit: ?any, freq: ?any): ?any
  transform:               abstract member function(func: ?any, engine: ?any, engine_kwargs: ?any): ?Data.Series
  value_counts:            abstract member function(normalize: ?any,
                                                    sort: ?any,
                                                    ascending: ?any,
                                                    bins: ?any,
                                                    dropna: ?any): ?any
}
