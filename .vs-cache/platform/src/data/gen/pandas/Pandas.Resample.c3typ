@deprecated(finalVersion="8.9",
            details="All the pandas subtypes apis are deprecated on Data types and will be removed in a future release")
abstract type Pandas.Resample<R: DataImpl> mixes Value {

  ax:        abstract property(): ?(Data.PeriodIndex | Data.DatetimeIndex | Data.TimedeltaIndex)
  groups:    private abstract property(): ?map<any, any>
  indices:   private abstract property(): ?any
  ndim:      abstract property(): ?any
  ngroups:   abstract property(): ?int
  obj:       abstract property(): ?R
  agg:       abstract member function(func: ?any): ?R
  aggregate: private abstract member function(func: ?any): ?R
  apply:     abstract member function(func: ?any): ?R
  asfreq:    abstract member function(fill_value: ?any): ?R
  backfill:  abstract member function(limit: ?int): ?R
  bfill:     abstract member function(limit: ?int): ?R
  count:     abstract member function(): ?R
  ffill:     abstract member function(limit: ?int): ?R
  fillna:    abstract member function(method: ?any, limit: ?any): ?R
  first:     abstract member function(_method: ?any, min_count: ?any): ?R
  get_group: private abstract member function(name: ?any, obj: ?any): ?R

  interpolate: abstract member function(method: ?any,
                                        axis: ?any,
                                        limit: ?any,
                                        inplace: ?any,
                                        limit_direction: ?any,
                                        limit_area: ?any,
                                        downcast: ?any): ?R

  last:      abstract member function(_method: ?any, min_count: ?any): ?R
  max:       abstract member function(_method: ?any, min_count: ?any): ?R
  mean:      abstract member function(_method: ?any): ?R
  median:    abstract member function(_method: ?any): ?R
  min:       abstract member function(_method: ?any, min_count: ?any): ?R
  nearest:   abstract member function(limit: ?int): ?R
  nunique:   abstract member function(_method: ?any): ?R
  ohlc:      abstract member function(_method: ?any): ?Data
  pad:       abstract member function(limit: ?int): ?R
  prod:      abstract member function(_method: ?any, min_count: ?any): ?R
  quantile:  abstract member function(q: ?any): ?R
  sem:       abstract member function(_method: ?any): ?R
  size:      abstract member function(): ?Data.Series
  std:       abstract member function(ddof: ?any): ?R
  sum:       abstract member function(_method: ?any, min_count: ?any): ?R
  transform: abstract member function(arg: ?any): ?Data.Series
  var:       abstract member function(ddof: ?any): ?R
}
