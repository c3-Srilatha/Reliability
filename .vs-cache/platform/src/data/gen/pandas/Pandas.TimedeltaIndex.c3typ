@deprecated(finalVersion="8.9",
            details="All the pandas subtypes apis are deprecated on Data types and will be removed in a future release")
abstract type Pandas.TimedeltaIndex mixes Value, Pandas.Index<Data.TimedeltaIndex> {

  components: abstract property(): ?Data

  @pandas(canReturnData=true)
  days: abstract property(): ?any

  inferred_type: abstract property(): ?string

  @pandas(canReturnData=true)
  microseconds: abstract property(): ?any

  @pandas(canReturnData=true)
  nanoseconds: abstract property(): ?any

  @pandas(canReturnData=true)
  seconds: abstract property(): ?any

  ceil:           private abstract member function(): ?Data.TimedeltaIndex
  floor:          private abstract member function(): ?Data.TimedeltaIndex
  get_loc:        abstract member function(key: ?any, method: ?any, tolerance: ?any): ?[any]
  median:         private abstract member function(): ?any
  round:          private abstract member function(): ?Data.TimedeltaIndex
  std:            private abstract member function(): ?any
  sum:            private abstract member function(): ?any
  to_pytimedelta: private abstract member function(): ?[any]
  total_seconds:  abstract member function(): ?(Data.Series | Data.Float64Index)
}
