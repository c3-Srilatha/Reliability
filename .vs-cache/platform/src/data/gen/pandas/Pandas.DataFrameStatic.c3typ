// TODO: PLAT-46986 Generate Pandas.Static.c3typ
@deprecated(finalVersion="8.9",
            details="All the pandas subtypes apis are deprecated on Data types and will be removed in a future release")
abstract type Pandas.DataFrameStatic mixes Value {

  from_dict: abstract function(data: ?any, orient: ?any, dtype: ?any, columns: ?any): ?Data

  from_records: abstract function(data: ?any,
                                  index: ?any,
                                  exclude: ?any,
                                  columns: ?any,
                                  coerce_float: ?any,
                                  nrows: ?any): ?Data
}
