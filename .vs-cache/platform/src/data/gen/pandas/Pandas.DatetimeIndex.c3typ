@deprecated(finalVersion="8.9",
            details="All the pandas subtypes apis are deprecated on Data types and will be removed in a future release")
abstract type Pandas.DatetimeIndex mixes Value, Pandas.Index<Data.DatetimeIndex> {

  date: private abstract property(): ?any

  @pandas(canReturnData=true)
  day: abstract property(): ?any

  day_of_week: abstract property(): ?(Data.Series | Data.Index)

  @pandas(canReturnData=true)
  day_of_year: abstract property(): ?any

  dayofweek: abstract property(): ?(Data.Series | Data.Index)

  @pandas(canReturnData=true)
  dayofyear: abstract property(): ?any

  @pandas(canReturnData=true)
  days_in_month: abstract property(): ?any

  @pandas(canReturnData=true)
  daysinmonth: abstract property(): ?any

  dtype: private abstract property(): ?any

  @pandas(canReturnData=true)
  hour: abstract property(): ?any

  inferred_type: abstract property(): ?string

  @pandas(canReturnData=true)
  is_leap_year: abstract property(): ?any

  @pandas(canReturnData=true)
  is_month_end: abstract property(): ?any

  @pandas(canReturnData=true)
  is_month_start: abstract property(): ?any

  is_normalized: abstract property(): ?any

  @pandas(canReturnData=true)
  is_quarter_end: abstract property(): ?any

  @pandas(canReturnData=true)
  is_quarter_start: abstract property(): ?any

  @pandas(canReturnData=true)
  is_year_end: abstract property(): ?any

  @pandas(canReturnData=true)
  is_year_start: abstract property(): ?any

  @pandas(canReturnData=true)
  microsecond: abstract property(): ?any

  @pandas(canReturnData=true)
  minute: abstract property(): ?any

  @pandas(canReturnData=true)
  month: abstract property(): ?any

  @pandas(canReturnData=true)
  nanosecond: abstract property(): ?any

  @pandas(canReturnData=true)
  quarter: abstract property(): ?any

  @pandas(canReturnData=true)
  second: abstract property(): ?any

  time:   private abstract property(): ?any
  timetz: private abstract property(): ?any
  tz:     abstract property(): ?any
  tzinfo: abstract property(): ?any

  @pandas(canReturnData=true)
  week: abstract property(): ?any

  weekday: abstract property(): ?(Data.Series | Data.Index)

  @pandas(canReturnData=true)
  weekofyear: abstract property(): ?any

  @pandas(canReturnData=true)
  year: abstract property(): ?any

  day_name:        abstract member function(): ?Data.Index
  get_loc:         abstract member function(key: ?any, method: ?any, tolerance: ?any): ?int
  indexer_at_time: abstract member function(time: ?any, asof: ?any): ?[any]

  indexer_between_time: private abstract member function(start_time: ?any,
                                                         end_time: ?any,
                                                         include_start: ?any,
                                                         include_end: ?any): ?[any]

  isocalendar:    abstract member function(): ?Data
  month_name:     abstract member function(): ?Data.Index
  normalize:      abstract member function(): ?Data.DatetimeIndex
  slice_indexer:  abstract member function(start: ?any, end: ?any, step: ?any, kind: ?any): ?any
  snap:           abstract member function(freq: ?any): ?Data.DatetimeIndex
  std:            abstract member function(): ?any
  to_julian_date: abstract member function(): ?Data.Float64Index
  to_period:      abstract member function(): ?Data.PeriodIndex
  to_perioddelta: abstract member function(freq: ?any): ?Data.TimedeltaIndex
  to_pydatetime:  private abstract member function(): ?[any]
  to_series:      abstract member function(keep_tz: ?any, index: ?any, name: ?any): ?Data.Series
  tz_convert:     abstract member function(tz: ?any): ?Data.DatetimeIndex
  tz_localize:    abstract member function(tz: ?any, ambiguous: ?any, nonexistent: ?any): ?Data.DatetimeIndex
  union_many:     abstract member function(others: ?any): ?any
}
