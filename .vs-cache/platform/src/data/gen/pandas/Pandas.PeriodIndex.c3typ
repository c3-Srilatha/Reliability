@deprecated(finalVersion="8.9",
            details="All the pandas subtypes apis are deprecated on Data types and will be removed in a future release")
abstract type Pandas.PeriodIndex mixes Value, Pandas.Index<Data.PeriodIndex> {

  @pandas(canReturnData=true)
  day: abstract property(): ?any

  @pandas(canReturnData=true)
  day_of_week: abstract property(): ?any

  @pandas(canReturnData=true)
  day_of_year: abstract property(): ?any

  @pandas(canReturnData=true)
  dayofweek: abstract property(): ?any

  @pandas(canReturnData=true)
  dayofyear: abstract property(): ?any

  @pandas(canReturnData=true)
  days_in_month: abstract property(): ?any

  @pandas(canReturnData=true)
  daysinmonth: abstract property(): ?any

  @pandas(canReturnData=true)
  end_time: abstract property(): ?any

  @pandas(canReturnData=true)
  hour: abstract property(): ?any

  inferred_type: abstract property(): ?string
  is_full:       abstract property(): ?any
  is_leap_year:  abstract property(): ?[boolean]

  @pandas(canReturnData=true)
  minute: abstract property(): ?any

  @pandas(canReturnData=true)
  month: abstract property(): ?any

  @pandas(canReturnData=true)
  quarter: abstract property(): ?any

  @pandas(canReturnData=true)
  qyear: abstract property(): ?any

  @pandas(canReturnData=true)
  second: abstract property(): ?any

  @pandas(canReturnData=true)
  start_time: abstract property(): ?any

  values: abstract property(): ?[any]

  @pandas(canReturnData=true)
  week: abstract property(): ?any

  @pandas(canReturnData=true)
  weekday: abstract property(): ?any

  @pandas(canReturnData=true)
  weekofyear: abstract property(): ?any

  @pandas(canReturnData=true)
  year: abstract property(): ?any

  asfreq:       abstract member function(freq: ?any, how: ?string): ?Data.PeriodIndex
  asof_locs:    private abstract member function(where: ?any, mask: ?any): ?[any]
  astype:       abstract member function(dtype: ?any, copy: ?any, how: ?any): ?Data.Index
  get_loc:      private abstract member function(key: ?any, method: ?any, tolerance: ?any): ?[any]
  strftime:     private abstract member function(): ?[any]
  to_timestamp: abstract member function(freq: ?any, how: ?any): ?Data.DatetimeIndex
}
