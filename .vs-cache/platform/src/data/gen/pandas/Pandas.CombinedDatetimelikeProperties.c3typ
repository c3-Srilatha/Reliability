@deprecated(finalVersion="8.9",
            details="All the pandas subtypes apis are deprecated on Data types and will be removed in a future release")
abstract private type Pandas.CombinedDatetimelikeProperties mixes Value {

  components:       abstract property(): ?Data
  date:             abstract property(): ?Data.Series
  day:              abstract property(): ?Data.Series
  day_of_week:      abstract property(): ?(Data.Series | Data.Index)
  day_of_year:      abstract property(): ?Data.Series
  dayofweek:        abstract property(): ?(Data.Series | Data.Index)
  dayofyear:        abstract property(): ?Data.Series
  days:             abstract property(): ?Data.Series
  days_in_month:    abstract property(): ?Data.Series
  daysinmonth:      abstract property(): ?any
  end_time:         abstract property(): ?Data.Series
  freq:             abstract property(): ?any
  hour:             abstract property(): ?Data.Series
  is_leap_year:     abstract property(): ?Data.Series
  is_month_end:     abstract property(): ?(Data.Series | [any])
  is_month_start:   abstract property(): ?(Data.Series | [any])
  is_quarter_end:   abstract property(): ?(Data.Series | Data.DatetimeIndex)
  is_quarter_start: abstract property(): ?(Data.Series | Data.DatetimeIndex)
  is_year_end:      abstract property(): ?(Data.Series | Data.DatetimeIndex)
  is_year_start:    abstract property(): ?(Data.Series | Data.DatetimeIndex)
  microsecond:      abstract property(): ?Data.Series
  microseconds:     abstract property(): ?Data.Series
  minute:           abstract property(): ?Data.Series
  month:            abstract property(): ?Data.Series
  nanosecond:       abstract property(): ?Data.Series
  nanoseconds:      abstract property(): ?any
  quarter:          abstract property(): ?Data.Series
  qyear:            abstract property(): ?any
  second:           abstract property(): ?Data.Series
  seconds:          abstract property(): ?any
  start_time:       abstract property(): ?Data.Series
  time:             abstract property(): ?Data.Series
  timetz:           abstract property(): ?Data.Series
  tz:               abstract property(): ?any
  weekday:          abstract property(): ?(Data.Series | Data.Index)
  year:             abstract property(): ?Data.Series
  ceil:             abstract member function(): ?any
  day_name:         abstract member function(): ?(Data.Series | Data.Index)
  floor:            abstract member function(): ?any
  isocalendar:      abstract member function(): ?Data
  month_name:       abstract member function(): ?(Data.Series | Data.Index)
  normalize:        abstract member function(): ?any
  round:            abstract member function(): ?any
  strftime:         abstract member function(): ?any
  to_period:        abstract member function(): ?any
  total_seconds:    abstract member function(): ?any
  tz_convert:       abstract member function(): ?any
  tz_localize:      abstract member function(): ?(Data.Series | Data.DatetimeIndex)
}
