abstract type Data.Spark.Index mixes Value {

  T:                       abstract property(): ?any
  asi8:                    abstract property(): ?[any]
  dtype:                   abstract property(): ?any
  empty:                   abstract property(): ?boolean
  has_duplicates:          abstract property(): ?boolean
  hasnans:                 abstract property(): ?boolean
  inferred_type:           abstract property(): ?string
  is_all_dates:            abstract property(): ?boolean
  is_monotonic:            abstract property(): ?boolean
  is_monotonic_decreasing: abstract property(): ?boolean
  is_monotonic_increasing: abstract property(): ?boolean
  is_unique:               abstract property(): ?boolean
  name:                    abstract property(): ?any
  names:                   abstract property(): ?[any]
  ndim:                    abstract property(): ?int
  nlevels:                 abstract property(): ?int
  shape:                   abstract property(): ?any
  size:                    abstract property(): ?int
  all:                     abstract member function(axis: ?any, skipna: ?boolean): ?boolean
  any:                     abstract member function(axis: ?any): ?boolean
  append:                  abstract member function(other: ?any): ?Data.Spark.Index
  argmax:                  abstract member function(): ?int
  argmin:                  abstract member function(): ?int
  asof:                    abstract member function(label: ?any): ?any
  astype:                  abstract member function(dtype: ?any): ?any
  copy:                    abstract member function(name: ?any, deep: ?boolean): ?Data.Spark.Index
  delete:                  abstract member function(loc: ?([int] | int)): ?Data.Spark.Index
  difference:              abstract member function(other: ?any, sort: ?boolean): ?Data.Spark.Index
  drop:                    abstract member function(labels: ?[any]): ?Data.Spark.Index
  drop_duplicates:         abstract member function(keep: ?(boolean | string)): ?Data.Spark.Index
  droplevel:               abstract member function(level: ?any): ?Data.Spark.Index
  dropna:                  abstract member function(how: ?string): ?Data.Spark.Index
  equals:                  abstract member function(other: ?any): ?boolean
  fillna:                  abstract member function(value: ?any): ?Data.Spark.Index
  get_level_values:        abstract member function(level: ?any): ?Data.Spark.Index
  holds_integer:           abstract member function(): ?boolean
  identical:               abstract member function(other: ?any): ?boolean
  insert:                  abstract member function(loc: ?int, item: ?any): ?Data.Spark.Index
  intersection:            abstract member function(other: ?any): ?Data.Spark.Index
  is_boolean:              abstract member function(): ?boolean
  is_categorical:          abstract member function(): ?boolean
  is_floating:             abstract member function(): ?boolean
  is_integer:              abstract member function(): ?boolean
  is_interval:             abstract member function(): ?boolean
  is_numeric:              abstract member function(): ?boolean
  is_object:               abstract member function(): ?boolean
  is_type_compatible:      abstract member function(kind: ?string): ?boolean
  isin:                    abstract member function(values: ?any): ?any
  isna:                    abstract member function(): ?any
  isnull:                  abstract member function(): ?any
  item:                    abstract member function(): ?any
  map:                     abstract member function(mapper: ?any, na_action: ?string): ?Data.Spark.Index
  max:                     abstract member function(): ?any
  min:                     abstract member function(): ?any
  notna:                   abstract member function(): ?any
  notnull:                 abstract member function(): ?any
  nunique:                 abstract member function(dropna: ?boolean, approx: ?boolean, rsd: ?float): ?int
  repeat:                  abstract member function(repeats: ?int): ?Data.Spark.Index
  shift:                   abstract member function(periods: ?int, fill_value: ?any): ?any
  sort:                    abstract member function(): ?any
  sort_values:             abstract member function(return_indexer: ?boolean, ascending: ?boolean): ?any
  symmetric_difference:    abstract member function(other: ?any, result_name: ?any, sort: ?boolean): ?Data.Spark.Index
  take:                    abstract member function(indices: ?any): ?any
  to_frame:                abstract member function(index: ?boolean, name: ?any): ?Data.Spark.DataFrame
  to_list:                 abstract member function(): ?[any]
  to_pandas:               abstract member function(): ?Data.Spark.Index
  to_series:               abstract member function(name: ?any): ?Data.Spark.Series
  tolist:                  abstract member function(): ?[any]
  transpose:               abstract member function(): ?Data.Spark.Index
  union:                   abstract member function(other: ?any, sort: ?boolean): ?Data.Spark.Index
  unique:                  abstract member function(level: ?any): ?Data.Spark.Index

  value_counts: abstract member function(normalize: ?boolean,
                                         sort: ?boolean,
                                         ascending: ?boolean,
                                         bins: ?any,
                                         dropna: ?boolean): ?Data.Spark.Series

  view: abstract member function(): ?Data.Spark.Index
}
