abstract type Data.Spark.DatetimeMethods mixes Value {

  date:             abstract property(): ?Data.Spark.Series
  day:              abstract property(): ?Data.Spark.Series
  dayofweek:        abstract property(): ?Data.Spark.Series
  dayofyear:        abstract property(): ?Data.Spark.Series
  days_in_month:    abstract property(): ?Data.Spark.Series
  daysinmonth:      abstract property(): ?Data.Spark.Series
  hour:             abstract property(): ?Data.Spark.Series
  is_leap_year:     abstract property(): ?Data.Spark.Series
  is_month_end:     abstract property(): ?Data.Spark.Series
  is_month_start:   abstract property(): ?Data.Spark.Series
  is_quarter_end:   abstract property(): ?Data.Spark.Series
  is_quarter_start: abstract property(): ?Data.Spark.Series
  is_year_end:      abstract property(): ?Data.Spark.Series
  is_year_start:    abstract property(): ?Data.Spark.Series
  microsecond:      abstract property(): ?Data.Spark.Series
  minute:           abstract property(): ?Data.Spark.Series
  month:            abstract property(): ?Data.Spark.Series
  nanosecond:       abstract property(): ?Data.Spark.Series
  quarter:          abstract property(): ?Data.Spark.Series
  second:           abstract property(): ?Data.Spark.Series
  time:             abstract property(): ?Data.Spark.Series
  timetz:           abstract property(): ?Data.Spark.Series
  week:             abstract property(): ?Data.Spark.Series
  weekday:          abstract property(): ?Data.Spark.Series
  weekofyear:       abstract property(): ?Data.Spark.Series
  year:             abstract property(): ?Data.Spark.Series
  ceil:             abstract member function(freq: ?any): ?Data.Spark.Series
  day_name:         abstract member function(locale: ?string): ?Data.Spark.Series
  floor:            abstract member function(freq: ?any): ?Data.Spark.Series
  month_name:       abstract member function(locale: ?string): ?Data.Spark.Series
  normalize:        abstract member function(): ?Data.Spark.Series
  round:            abstract member function(freq: ?any): ?Data.Spark.Series
  strftime:         abstract member function(date_format: ?string): ?Data.Spark.Series
}
