abstract type Data.Spark.CategoricalIndex mixes Data.Spark.Index {

  categories: abstract property(): ?any
  codes:      abstract property(): ?Data.Spark.Index
  dtype:      abstract property(): ?any
  ordered:    abstract property(): ?boolean
  all:        abstract member function(): ?any
  map:        abstract member function(mapper: ?any): ?Data.Spark.Index
}
