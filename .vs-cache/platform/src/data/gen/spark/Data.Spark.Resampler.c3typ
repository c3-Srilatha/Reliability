abstract type Data.Spark.Resampler mixes Value {

  get_make_interval: abstract member function(unit: ?string, col: ?any): ?any
  max:               abstract member function(): ?(Data.Spark.DataFrame | Data.Spark.Series)
  mean:              abstract member function(): ?(Data.Spark.DataFrame | Data.Spark.Series)
  min:               abstract member function(): ?(Data.Spark.DataFrame | Data.Spark.Series)
  std:               abstract member function(): ?(Data.Spark.DataFrame | Data.Spark.Series)
  sum:               abstract member function(): ?(Data.Spark.DataFrame | Data.Spark.Series)
  var:               abstract member function(): ?(Data.Spark.DataFrame | Data.Spark.Series)
}
