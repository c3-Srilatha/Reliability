abstract type Data.Spark.DatetimeIndex mixes Data.Spark.Index {

  day:              abstract property(): ?any
  day_of_week:      abstract property(): ?(Data.Spark.Series | Data.Spark.Index)
  day_of_year:      abstract property(): ?any
  dayofweek:        abstract property(): ?(Data.Spark.Series | Data.Spark.Index)
  dayofyear:        abstract property(): ?any
  days_in_month:    abstract property(): ?any
  daysinmonth:      abstract property(): ?any
  hour:             abstract property(): ?any
  is_leap_year:     abstract property(): ?Data.Spark.Index
  is_month_end:     abstract property(): ?Data.Spark.Index
  is_month_start:   abstract property(): ?Data.Spark.Index
  is_quarter_end:   abstract property(): ?Data.Spark.Index
  is_quarter_start: abstract property(): ?Data.Spark.Index
  is_year_end:      abstract property(): ?Data.Spark.Index
  is_year_start:    abstract property(): ?Data.Spark.Index
  microsecond:      abstract property(): ?any
  minute:           abstract property(): ?any
  month:            abstract property(): ?any
  quarter:          abstract property(): ?any
  second:           abstract property(): ?any
  week:             abstract property(): ?any
  weekday:          abstract property(): ?(Data.Spark.Series | Data.Spark.Index)
  weekofyear:       abstract property(): ?any
  year:             abstract property(): ?any
  all:              abstract member function(): ?any
  ceil:             abstract member function(freq: ?any): ?Data.Spark.DatetimeIndex
  day_name:         abstract member function(locale: ?string): ?Data.Spark.Index
  floor:            abstract member function(freq: ?any): ?Data.Spark.DatetimeIndex
  indexer_at_time:  abstract member function(time: ?any, asof: ?boolean): ?Data.Spark.Index

  indexer_between_time: abstract member function(start_time: ?any,
                                                 end_time: ?any,
                                                 include_start: ?boolean,
                                                 include_end: ?boolean): ?Data.Spark.Index

  month_name: abstract member function(locale: ?string): ?Data.Spark.Index
  normalize:  abstract member function(): ?Data.Spark.DatetimeIndex
  round:      abstract member function(freq: ?any): ?Data.Spark.DatetimeIndex
  strftime:   abstract member function(date_format: ?string): ?Data.Spark.Index
}
