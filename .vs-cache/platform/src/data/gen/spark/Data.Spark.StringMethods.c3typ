abstract type Data.Spark.StringMethods mixes Value {

  capitalize: abstract member function(): ?Data.Spark.Series
  cat:        abstract member function(others: ?any, sep: ?any, na_rep: ?any, join: ?any): ?any
  center:     abstract member function(width: ?int, fillchar: ?string): ?Data.Spark.Series

  contains: abstract member function(pat: ?string,
                                     case: ?boolean,
                                     flags: ?int,
                                     na: ?any,
                                     regex: ?boolean): ?Data.Spark.Series

  count:       abstract member function(pat: ?string, flags: ?int): ?Data.Spark.Series
  decode:      abstract member function(encoding: ?any, errors: ?any): ?any
  encode:      abstract member function(encoding: ?any, errors: ?any): ?any
  endswith:    abstract member function(pattern: ?string, na: ?any): ?Data.Spark.Series
  extract:     abstract member function(pat: ?any, flags: ?any, expand: ?any): ?any
  extractall:  abstract member function(pat: ?any, flags: ?any): ?any
  find:        abstract member function(sub: ?string, start: ?int, end: ?int): ?Data.Spark.Series
  findall:     abstract member function(pat: ?string, flags: ?int): ?Data.Spark.Series
  get:         abstract member function(i: ?int): ?Data.Spark.Series
  get_dummies: abstract member function(sep: ?string): ?any
  index:       abstract member function(sub: ?string, start: ?int, end: ?int): ?Data.Spark.Series
  isalnum:     abstract member function(): ?Data.Spark.Series
  isalpha:     abstract member function(): ?Data.Spark.Series
  isdecimal:   abstract member function(): ?Data.Spark.Series
  isdigit:     abstract member function(): ?Data.Spark.Series
  islower:     abstract member function(): ?Data.Spark.Series
  isnumeric:   abstract member function(): ?Data.Spark.Series
  isspace:     abstract member function(): ?Data.Spark.Series
  istitle:     abstract member function(): ?Data.Spark.Series
  isupper:     abstract member function(): ?Data.Spark.Series
  join:        abstract member function(sep: ?string): ?Data.Spark.Series
  len:         abstract member function(): ?Data.Spark.Series
  ljust:       abstract member function(width: ?int, fillchar: ?string): ?Data.Spark.Series
  lower:       abstract member function(): ?Data.Spark.Series
  lstrip:      abstract member function(to_strip: ?string): ?Data.Spark.Series
  match:       abstract member function(pat: ?string, case: ?boolean, flags: ?int, na: ?any): ?Data.Spark.Series
  normalize:   abstract member function(form: ?string): ?Data.Spark.Series
  pad:         abstract member function(width: ?int, side: ?string, fillchar: ?string): ?Data.Spark.Series
  partition:   abstract member function(sep: ?string, expand: ?boolean): ?Data.Spark.Series
  repeat:      abstract member function(repeats: ?int): ?Data.Spark.Series

  replace: abstract member function(pat: ?string,
                                    repl: ?((lambda(a: string): string) | string),
                                    n: ?int,
                                    case: ?boolean,
                                    flags: ?int,
                                    regex: ?boolean): ?Data.Spark.Series

  rfind:      abstract member function(sub: ?string, start: ?int, end: ?int): ?Data.Spark.Series
  rindex:     abstract member function(sub: ?string, start: ?int, end: ?int): ?Data.Spark.Series
  rjust:      abstract member function(width: ?int, fillchar: ?string): ?Data.Spark.Series
  rpartition: abstract member function(sep: ?string, expand: ?boolean): ?Data.Spark.Series

  rsplit: abstract member function(pat: ?string,
                                   n: ?int,
                                   expand: ?boolean): ?(Data.Spark.DataFrame | Data.Spark.Series)

  rstrip:        abstract member function(to_strip: ?string): ?Data.Spark.Series
  slice:         abstract member function(start: ?int, stop: ?int, step: ?int): ?Data.Spark.Series
  slice_replace: abstract member function(start: ?int, stop: ?int, repl: ?string): ?Data.Spark.Series

  split: abstract member function(pat: ?string,
                                  n: ?int,
                                  expand: ?boolean): ?(Data.Spark.DataFrame | Data.Spark.Series)

  startswith: abstract member function(pattern: ?string, na: ?any): ?Data.Spark.Series
  strip:      abstract member function(to_strip: ?string): ?Data.Spark.Series
  swapcase:   abstract member function(): ?Data.Spark.Series
  title:      abstract member function(): ?Data.Spark.Series
  translate:  abstract member function(table: ?map<any, any>): ?Data.Spark.Series
  upper:      abstract member function(): ?Data.Spark.Series
  wrap:       abstract member function(width: ?int): ?Data.Spark.Series
  zfill:      abstract member function(width: ?int): ?Data.Spark.Series
}
