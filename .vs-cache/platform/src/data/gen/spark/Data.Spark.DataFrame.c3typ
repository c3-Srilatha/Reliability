abstract type Data.Spark.DataFrame mixes Value {

  T:       abstract property(): ?Data.Spark.DataFrame
  axes:    abstract property(): ?[any]
  columns: abstract property(): ?any
  dtypes:  abstract property(): ?Data.Spark.Series
  empty:   abstract property(): ?boolean
  iat:     abstract property(): ?any
  iloc:    abstract property(): ?Data.Spark.IlocIndexer

  index: abstract property()
                    : ?(Data.Spark.Index | Data.Spark.MultiIndex | Data.Spark.CategoricalIndex | Data.Spark.DatetimeIndex | Data.Spark.TimedeltaIndex)

  loc:   abstract property(): ?Data.Spark.LocIndexer
  ndim:  abstract property(): ?int
  shape: abstract property(): ?(int, int)
  size:  abstract property(): ?int
  style: abstract property(): ?any

  /**
   * Internal method for implementation of {@link Data.Spark.DataFrameImpl#to_spark}
   * It will send request to  store evaluated DataFrame under unique Id and will return this id to the authoring layer.
   */
  cache: private abstract member function(user_id: string,
                                          session_id: string,
                                          index_col: ?([string] | string)): string

  /**
   * Implements assign semantics
   * @param kwargs
   *        The map or dictionary of new column names to their new values. Can be:
   *            - single value
   *            - Data.Spark.Series
   * @return
   *        {@link Data.Spark.DataFrame} with new column names specified by kwargs
   */
  assign: abstract member function(kwargs: map<string, ?any>): ?Data.Spark.DataFrame

  /**
   * Save content of dataframe into DataLake table.
   * @param table
   *        Table to write to
   * @param spec
   *        write spec for writing table
   */
  write_table: abstract member function(table: !DataLake.Table,
                                        spec: DataLake.Table.WriteSpec): DataLake.Table.Snapshot

  /**
   * Upsert objects from dataframe to C3.
   * @param typeName
   *        C3 type to upsert
   * @param spec
   *        Additional fields that can be passed to upsert like batchSize etc.
   * @return
   *       Count of objects which are upserted to the c3server.
   */
  upsert: abstract member function(typeName: !string, spec: Data.SparkUpsertSpec): int

  /**
   * Apply {@link Transform} on a Data.Spark.DataFrame and return a new Data.Spark.DataFrame.
   * The source DataFrame should match the schema defined in {@link Transform#source}
   * @param transform
   *        Instance of {@link Transform} to be applied. If transform is null, return the same DataFrame.
   */
  applyC3Transform: abstract member function(transform: ?Transform): ?Data.Spark.DataFrame

  /**
   * Returns a preview of the DataFrame, including the schema, the number of rows and first 1000 rows in json format.
   */
  preview: abstract member function(): ?Data.Spark.Preview

  /**
   * Returns all row of the DataFrame as C3 tuples. Calling this method on large DataFrames can lead to memory errors.
   */
  to_tuples: abstract member function(): [tuple]

  /**
   * Returns schema of the dataframe as TupleType.
   */
  schema: abstract member function(): TupleType

  abs:        abstract member function(): ?(Data.Spark.DataFrame | Data.Spark.Series)
  add:        abstract member function(other: ?any): ?Data.Spark.DataFrame
  add_prefix: abstract member function(prefix: ?string): ?Data.Spark.DataFrame
  add_suffix: abstract member function(suffix: ?string): ?Data.Spark.DataFrame
  agg:        abstract member function(func: ?([string] | map<any, [string]>)): ?Data.Spark.DataFrame
  aggregate:  abstract member function(func: ?([string] | map<any, [string]>)): ?Data.Spark.DataFrame

  align: abstract member function(other: ?any,
                                  join: ?string,
                                  axis: ?any,
                                  copy: ?boolean): ?(Data.Spark.DataFrame | Data.Spark.Series)

  all: abstract member function(axis: ?any, bool_only: ?boolean, skipna: ?boolean): ?Data.Spark.Series
  any: abstract member function(axis: ?any, bool_only: ?boolean): ?Data.Spark.Series

  append: abstract member function(other: ?any,
                                   ignore_index: ?boolean,
                                   verify_integrity: ?boolean,
                                   sort: ?boolean): ?Data.Spark.DataFrame

  apply: abstract member function(func: ?lambda(x: any ...): any,
                                  axis: ?any,
                                  args: ?any): ?(Data.Spark.DataFrame | Data.Spark.Series)

  applymap: abstract member function(func: ?lambda(a: any): any): ?Data.Spark.DataFrame
  astype:   abstract member function(dtype: ?any): ?Data.Spark.DataFrame
  at_time:  abstract member function(time: ?any, asof: ?boolean, axis: ?any): ?Data.Spark.DataFrame

  backfill: abstract member function(axis: ?any,
                                     inplace: ?any,
                                     limit: ?int): ?(Data.Spark.DataFrame | Data.Spark.Series)

  between_time: abstract member function(start_time: ?any,
                                         end_time: ?any,
                                         include_start: ?boolean,
                                         include_end: ?boolean,
                                         axis: ?any): ?Data.Spark.DataFrame

  bfill:         abstract member function(axis: ?any,
                                          inplace: ?any,
                                          limit: ?int): ?(Data.Spark.DataFrame | Data.Spark.Series)
  bool:          abstract member function(): ?boolean
  boxplot:       abstract member function(): ?any
  clip:          abstract member function(lower: ?(float | int), upper: ?(float | int)): ?Data.Spark.DataFrame
  combine_first: abstract member function(other: ?any): ?Data.Spark.DataFrame
  copy:          abstract member function(deep: ?boolean): ?Data.Spark.DataFrame
  corr:          abstract member function(method: ?string, min_periods: ?int): ?Data.Spark.DataFrame
  corrwith:      abstract member function(other: ?any,
                                          axis: ?any,
                                          drop: ?boolean,
                                          method: ?string): ?Data.Spark.Series
  count:         abstract member function(axis: ?any, numeric_only: ?boolean): ?Data.Spark.Series
  cov:           abstract member function(min_periods: ?int, ddof: ?int): ?Data.Spark.DataFrame
  cummax:        abstract member function(skipna: ?boolean): ?(Data.Spark.DataFrame | Data.Spark.Series)
  cummin:        abstract member function(skipna: ?boolean): ?(Data.Spark.DataFrame | Data.Spark.Series)
  cumprod:       abstract member function(skipna: ?boolean): ?(Data.Spark.DataFrame | Data.Spark.Series)
  cumsum:        abstract member function(skipna: ?boolean): ?(Data.Spark.DataFrame | Data.Spark.Series)
  describe:      abstract member function(percentiles: ?[float]): ?Data.Spark.DataFrame
  diff:          abstract member function(periods: ?int, axis: ?any): ?Data.Spark.DataFrame
  div:           abstract member function(other: ?any): ?Data.Spark.DataFrame
  divide:        abstract member function(other: ?any): ?Data.Spark.DataFrame
  dot:           abstract member function(other: ?any): ?Data.Spark.Series
  drop:          abstract member function(labels: ?any, axis: ?any, index: ?any, columns: ?any): ?Data.Spark.DataFrame

  drop_duplicates: abstract member function(subset: ?any,
                                            keep: ?(boolean | string),
                                            inplace: ?boolean,
                                            ignore_index: ?boolean): ?Data.Spark.DataFrame

  droplevel: abstract member function(level: ?any, axis: ?any): ?Data.Spark.DataFrame

  dropna: abstract member function(axis: ?any,
                                   how: ?string,
                                   thresh: ?int,
                                   subset: ?any,
                                   inplace: ?boolean): ?Data.Spark.DataFrame

  duplicated: abstract member function(subset: ?any, keep: ?(boolean | string)): ?Data.Spark.Series
  eq:         abstract member function(other: ?any): ?Data.Spark.DataFrame
  equals:     abstract member function(other: ?any): ?Data.Spark.DataFrame
  eval:       abstract member function(expr: ?string, inplace: ?boolean): ?(Data.Spark.DataFrame | Data.Spark.Series)

  ewm: abstract member function(com: ?float,
                                span: ?float,
                                halflife: ?float,
                                alpha: ?float,
                                min_periods: ?int,
                                ignore_na: ?any): ?(Data.Spark.DataFrame | Data.Spark.Series)

  expanding: abstract member function(min_periods: ?int): ?(Data.Spark.DataFrame | Data.Spark.Series)
  explode:   abstract member function(column: ?any, ignore_index: ?boolean): ?Data.Spark.DataFrame
  ffill:     abstract member function(axis: ?any,
                                      inplace: ?any,
                                      limit: ?int): ?(Data.Spark.DataFrame | Data.Spark.Series)

  fillna: abstract member function(value: ?any,
                                   method: ?string,
                                   axis: ?any,
                                   inplace: ?boolean,
                                   limit: ?int): ?Data.Spark.DataFrame

  filter:            abstract member function(items: ?any,
                                              like: ?string,
                                              regex: ?string,
                                              axis: ?any): ?Data.Spark.DataFrame
  first:             abstract member function(offset: ?any): ?Data.Spark.DataFrame
  first_valid_index: abstract member function(): ?any
  floordiv:          abstract member function(other: ?any): ?Data.Spark.DataFrame

  from_dict: abstract function(data: ?map<any, any>,
                               orient: ?string,
                               dtype: ?any,
                               columns: ?[any]): ?Data.Spark.DataFrame

  from_records: abstract function(data: ?any,
                                  index: ?any,
                                  exclude: ?[any],
                                  columns: ?[any],
                                  coerce_float: ?boolean,
                                  nrows: ?int): ?Data.Spark.DataFrame

  ge:               abstract member function(other: ?any): ?Data.Spark.DataFrame
  get:              abstract member function(key: ?any, default: ?any): ?any
  get_dtype_counts: abstract member function(): ?Data.Spark.Series

  groupby: abstract member function(by: ?any,
                                    axis: ?any,
                                    as_index: ?boolean,
                                    dropna: ?boolean): ?Data.Spark.DataFrameGroupBy

  gt:     abstract member function(other: ?any): ?Data.Spark.DataFrame
  head:   abstract member function(n: ?int): ?Data.Spark.DataFrame
  hist:   abstract member function(bins: ?any): ?any
  idxmax: abstract member function(axis: ?any): ?Data.Spark.Series
  idxmin: abstract member function(axis: ?any): ?Data.Spark.Series
  info:   abstract member function(verbose: ?boolean, buf: ?any, max_cols: ?int): ?any
  insert: abstract member function(loc: ?int, column: ?any, value: ?any, allow_duplicates: ?boolean): ?any

  interpolate: abstract member function(method: ?string,
                                        limit: ?int,
                                        limit_direction: ?string,
                                        limit_area: ?string): ?Data.Spark.DataFrame

  isin:       abstract member function(values: ?([any] | map<any, any>)): ?Data.Spark.DataFrame
  isna:       abstract member function(): ?Data.Spark.DataFrame
  isnull:     abstract member function(): ?Data.Spark.DataFrame
  items:      abstract member function(): ?Iterator
  iteritems:  abstract member function(): ?Iterator
  iterrows:   abstract member function(): ?Iterator
  itertuples: abstract member function(index: ?boolean, name: ?string): ?Iterator

  join: abstract member function(right: ?any,
                                 on: ?any,
                                 how: ?string,
                                 lsuffix: ?string,
                                 rsuffix: ?string): ?Data.Spark.DataFrame

  kde:              abstract member function(bw_method: ?any, ind: ?any): ?any
  keys:             abstract member function(): ?Data.Spark.Index
  kurt:             abstract member function(axis: ?any, skipna: ?boolean, numeric_only: ?boolean): ?Data.Spark.Series
  kurtosis:         abstract member function(axis: ?any, skipna: ?boolean, numeric_only: ?boolean): ?Data.Spark.Series
  last:             abstract member function(offset: ?any): ?Data.Spark.DataFrame
  last_valid_index: abstract member function(): ?any
  le:               abstract member function(other: ?any): ?Data.Spark.DataFrame
  lt:               abstract member function(other: ?any): ?Data.Spark.DataFrame
  mad:              abstract member function(axis: ?any): ?Data.Spark.Series
  mask:             abstract member function(cond: ?any, other: ?any): ?Data.Spark.DataFrame
  max:              abstract member function(axis: ?any, skipna: ?boolean, numeric_only: ?boolean): ?Data.Spark.Series
  mean:             abstract member function(axis: ?any, skipna: ?boolean, numeric_only: ?boolean): ?Data.Spark.Series

  median: abstract member function(axis: ?any,
                                   skipna: ?boolean,
                                   numeric_only: ?boolean,
                                   accuracy: ?int): ?Data.Spark.Series

  melt: abstract member function(id_vars: ?any,
                                 value_vars: ?any,
                                 var_name: ?([string] | string),
                                 value_name: ?string): ?Data.Spark.DataFrame

  merge: abstract member function(right: ?any,
                                  how: ?string,
                                  on: ?any,
                                  left_on: ?any,
                                  right_on: ?any,
                                  left_index: ?boolean,
                                  right_index: ?boolean,
                                  suffixes: ?(string, string)): ?Data.Spark.DataFrame

  min:        abstract member function(axis: ?any, skipna: ?boolean, numeric_only: ?boolean): ?Data.Spark.Series
  mod:        abstract member function(other: ?any): ?Data.Spark.DataFrame
  mode:       abstract member function(axis: ?any, numeric_only: ?boolean, dropna: ?boolean): ?Data.Spark.DataFrame
  mul:        abstract member function(other: ?any): ?Data.Spark.DataFrame
  ne:         abstract member function(other: ?any): ?Data.Spark.DataFrame
  nlargest:   abstract member function(n: ?int, columns: ?any, keep: ?string): ?Data.Spark.DataFrame
  notna:      abstract member function(): ?Data.Spark.DataFrame
  notnull:    abstract member function(): ?Data.Spark.DataFrame
  nsmallest:  abstract member function(n: ?int, columns: ?any, keep: ?string): ?Data.Spark.DataFrame
  nunique:    abstract member function(axis: ?any,
                                       dropna: ?boolean,
                                       approx: ?boolean,
                                       rsd: ?float): ?Data.Spark.Series
  pad:        abstract member function(axis: ?any,
                                       inplace: ?any,
                                       limit: ?int): ?(Data.Spark.DataFrame | Data.Spark.Series)
  pct_change: abstract member function(periods: ?int): ?Data.Spark.DataFrame
  pipe:       abstract member function(func: ?lambda(x: any ...): any): ?any
  pivot:      abstract member function(index: ?any, columns: ?any, values: ?any): ?Data.Spark.DataFrame

  pivot_table: abstract member function(values: ?any,
                                        index: ?[any],
                                        columns: ?any,
                                        aggfunc: ?(map<any, string> | string),
                                        fill_value: ?any): ?Data.Spark.DataFrame

  pop: abstract member function(item: ?any): ?Data.Spark.DataFrame
  pow: abstract member function(other: ?any): ?Data.Spark.DataFrame

  prod: abstract member function(axis: ?any,
                                 skipna: ?boolean,
                                 numeric_only: ?boolean,
                                 min_count: ?int): ?Data.Spark.Series

  product: abstract member function(axis: ?any,
                                    skipna: ?boolean,
                                    numeric_only: ?boolean,
                                    min_count: ?int): ?Data.Spark.Series

  /**
   * Compute data quality metrics {@link Data.ColumnMetric} on selected columns in DataFrame.
   * If columns are not supplied all primitive type columns in the dataframe will be included in profiling.
   * If no metrics are supplied default set of metrics will be used for each column depending on the column type.
   */
  profile: abstract member function(columns: [string], metrics: [Data.ColumnMetric]): ?[Data.ColumnMetricValue]

  quantile: abstract member function(q: ?any,
                                     axis: ?any,
                                     numeric_only: ?boolean,
                                     accuracy: ?int): ?(Data.Spark.DataFrame | Data.Spark.Series)

  query: abstract member function(expr: ?string, inplace: ?boolean): ?Data.Spark.DataFrame
  radd:  abstract member function(other: ?any): ?Data.Spark.DataFrame
  rank:  abstract member function(method: ?string, ascending: ?boolean, numeric_only: ?boolean): ?Data.Spark.DataFrame
  rdiv:  abstract member function(other: ?any): ?Data.Spark.DataFrame

  reindex: abstract member function(labels: ?any,
                                    index: ?any,
                                    columns: ?any,
                                    axis: ?any,
                                    copy: ?boolean,
                                    fill_value: ?any): ?Data.Spark.DataFrame

  reindex_like: abstract member function(other: ?any, copy: ?boolean): ?Data.Spark.DataFrame

  rename: abstract member function(mapper: ?((lambda(a: any): any) | map<any, any>),
                                   index: ?((lambda(a: any): any) | map<any, any>),
                                   columns: ?((lambda(a: any): any) | map<any, any>),
                                   axis: ?any,
                                   inplace: ?boolean,
                                   level: ?int,
                                   errors: ?string): ?Data.Spark.DataFrame

  rename_axis: abstract member function(mapper: ?any,
                                        index: ?any,
                                        columns: ?any,
                                        axis: ?any,
                                        inplace: ?boolean): ?Data.Spark.DataFrame

  replace: abstract member function(to_replace: ?any,
                                    value: ?any,
                                    inplace: ?boolean,
                                    limit: ?int,
                                    regex: ?boolean,
                                    method: ?string): ?Data.Spark.DataFrame

  resample: abstract member function(rule: ?string, closed: ?string, label: ?string, on: ?any): ?Data.Spark.Resampler

  reset_index: abstract member function(level: ?any,
                                        drop: ?boolean,
                                        inplace: ?boolean,
                                        col_level: ?int,
                                        col_fill: ?string): ?Data.Spark.DataFrame

  rfloordiv: abstract member function(other: ?any): ?Data.Spark.DataFrame
  rmod:      abstract member function(other: ?any): ?Data.Spark.DataFrame
  rmul:      abstract member function(other: ?any): ?Data.Spark.DataFrame
  rolling:   abstract member function(window: ?int, min_periods: ?int): ?(Data.Spark.DataFrame | Data.Spark.Series)
  round:     abstract member function(decimals: ?any): ?Data.Spark.DataFrame
  rpow:      abstract member function(other: ?any): ?Data.Spark.DataFrame
  rsub:      abstract member function(other: ?any): ?Data.Spark.DataFrame
  rtruediv:  abstract member function(other: ?any): ?Data.Spark.DataFrame

  sample: abstract member function(n: ?int,
                                   frac: ?float,
                                   replace: ?boolean,
                                   random_state: ?int,
                                   ignore_index: ?boolean): ?Data.Spark.DataFrame

  select_dtypes: abstract member function(include: ?([string] | string),
                                          exclude: ?([string] | string)): ?Data.Spark.DataFrame

  sem: abstract member function(axis: ?any, skipna: ?boolean, ddof: ?int, numeric_only: ?boolean): ?Data.Spark.Series

  set_index: abstract member function(keys: ?any,
                                      drop: ?boolean,
                                      append: ?boolean,
                                      inplace: ?boolean): ?Data.Spark.DataFrame

  shift: abstract member function(periods: ?int, fill_value: ?any): ?Data.Spark.DataFrame
  skew:  abstract member function(axis: ?any, skipna: ?boolean, numeric_only: ?boolean): ?Data.Spark.Series

  sort_index: abstract member function(axis: ?any,
                                       level: ?([int] | int),
                                       ascending: ?boolean,
                                       inplace: ?boolean,
                                       kind: ?string,
                                       na_position: ?string,
                                       ignore_index: ?boolean): ?Data.Spark.DataFrame

  sort_values: abstract member function(by: ?any,
                                        ascending: ?([boolean] | boolean),
                                        inplace: ?boolean,
                                        na_position: ?string,
                                        ignore_index: ?boolean): ?Data.Spark.DataFrame

  squeeze: abstract member function(axis: ?any): ?(Data.Spark.DataFrame | Data.Spark.Series)
  stack:   abstract member function(): ?(Data.Spark.DataFrame | Data.Spark.Series)
  std:     abstract member function(axis: ?any,
                                    skipna: ?boolean,
                                    ddof: ?int,
                                    numeric_only: ?boolean): ?Data.Spark.Series
  sub:     abstract member function(other: ?any): ?Data.Spark.DataFrame

  sum: abstract member function(axis: ?any,
                                skipna: ?boolean,
                                numeric_only: ?boolean,
                                min_count: ?int): ?Data.Spark.Series

  swapaxes:     abstract member function(i: ?any, j: ?any, copy: ?boolean): ?Data.Spark.DataFrame
  swaplevel:    abstract member function(i: ?any, j: ?any, axis: ?any): ?Data.Spark.DataFrame
  tail:         abstract member function(n: ?int): ?Data.Spark.DataFrame
  take:         abstract member function(indices: ?[int], axis: ?any): ?Data.Spark.DataFrame
  to_clipboard: abstract member function(excel: ?boolean, sep: ?string): ?any

  to_csv: abstract member function(path: ?string,
                                   sep: ?string,
                                   na_rep: ?string,
                                   columns: ?[any],
                                   header: ?boolean,
                                   quotechar: ?string,
                                   date_format: ?string,
                                   escapechar: ?string,
                                   num_files: ?int,
                                   mode: ?string,
                                   partition_cols: ?([string] | string),
                                   index_col: ?([string] | string)): ?string

  to_delta: abstract member function(path: ?string,
                                     mode: ?string,
                                     partition_cols: ?([string] | string),
                                     index_col: ?([string] | string)): ?any

  to_dict: abstract member function(orient: ?string, into: ?any): ?[any]

  to_excel: abstract member function(excel_writer: ?any,
                                     sheet_name: ?string,
                                     na_rep: ?string,
                                     float_format: ?string,
                                     columns: ?([string] | string),
                                     header: ?boolean,
                                     index: ?boolean,
                                     index_label: ?([string] | string),
                                     startrow: ?int,
                                     startcol: ?int,
                                     engine: ?string,
                                     merge_cells: ?boolean,
                                     encoding: ?string,
                                     inf_rep: ?string,
                                     verbose: ?boolean,
                                     freeze_panes: ?(int, int)): ?any

  to_html: abstract member function(buf: ?any,
                                    columns: ?any,
                                    col_space: ?(int | map<any, int | string> | string),
                                    header: ?boolean,
                                    index: ?boolean,
                                    na_rep: ?string,
                                    formatters: ?([lambda(a: any): string] | map<any, lambda(a: any): string>),
                                    float_format: ?lambda(a: float): string,
                                    sparsify: ?boolean,
                                    index_names: ?boolean,
                                    justify: ?string,
                                    max_rows: ?int,
                                    max_cols: ?int,
                                    show_dimensions: ?boolean,
                                    decimal: ?string,
                                    bold_rows: ?boolean,
                                    classes: ?any,
                                    escape: ?boolean,
                                    notebook: ?boolean,
                                    border: ?int,
                                    table_id: ?string,
                                    render_links: ?boolean): ?string

  to_json: abstract member function(path: ?string,
                                    compression: ?string,
                                    num_files: ?int,
                                    mode: ?string,
                                    orient: ?string,
                                    lines: ?boolean,
                                    partition_cols: ?([string] | string),
                                    index_col: ?([string] | string)): ?string

  to_latex: abstract member function(buf: ?any,
                                     columns: ?[any],
                                     col_space: ?int,
                                     header: ?boolean,
                                     index: ?boolean,
                                     na_rep: ?string,
                                     formatters: ?([lambda(a: any): string] | map<any, lambda(a: any): string>),
                                     float_format: ?lambda(a: float): string,
                                     sparsify: ?boolean,
                                     index_names: ?boolean,
                                     bold_rows: ?boolean,
                                     column_format: ?string,
                                     longtable: ?boolean,
                                     escape: ?boolean,
                                     encoding: ?string,
                                     decimal: ?string,
                                     multicolumn: ?boolean,
                                     multicolumn_format: ?string,
                                     multirow: ?boolean): ?string

  to_markdown: abstract member function(buf: ?any, mode: ?string): ?string

  to_orc: abstract member function(path: ?string,
                                   mode: ?string,
                                   partition_cols: ?([string] | string),
                                   index_col: ?([string] | string)): ?any

  to_parquet: abstract member function(path: ?string,
                                       mode: ?string,
                                       partition_cols: ?([string] | string),
                                       compression: ?string,
                                       index_col: ?([string] | string)): ?any

  to_records: abstract member function(index: ?boolean, column_dtypes: ?any, index_dtypes: ?any): ?[any]

  to_spark_io: abstract member function(path: ?string,
                                        format: ?string,
                                        mode: ?string,
                                        partition_cols: ?([string] | string),
                                        index_col: ?([string] | string)): ?any

  to_string: abstract member function(buf: ?any,
                                      columns: ?any,
                                      col_space: ?(int | map<any, int | string> | string),
                                      header: ?boolean,
                                      index: ?boolean,
                                      na_rep: ?string,
                                      formatters: ?([lambda(a: any): string] | map<any, lambda(a: any): string>),
                                      float_format: ?lambda(a: float): string,
                                      sparsify: ?boolean,
                                      index_names: ?boolean,
                                      justify: ?string,
                                      max_rows: ?int,
                                      max_cols: ?int,
                                      show_dimensions: ?boolean,
                                      decimal: ?string,
                                      line_width: ?int): ?string

  to_table: abstract member function(name: ?string,
                                     format: ?string,
                                     mode: ?string,
                                     partition_cols: ?([string] | string),
                                     index_col: ?([string] | string)): ?any

  transform: abstract member function(func: ?lambda(x: any ...): any, axis: ?any): ?Data.Spark.DataFrame
  transpose: abstract member function(): ?Data.Spark.DataFrame
  truediv:   abstract member function(other: ?any): ?Data.Spark.DataFrame

  truncate: abstract member function(before: ?any,
                                     after: ?any,
                                     axis: ?any,
                                     copy: ?any): ?(Data.Spark.DataFrame | Data.Spark.Series)

  unstack: abstract member function(): ?(Data.Spark.DataFrame | Data.Spark.Series)
  update:  abstract member function(other: ?any, join: ?string, overwrite: ?boolean): ?any
  var:     abstract member function(axis: ?any, ddof: ?int, numeric_only: ?boolean): ?Data.Spark.Series
  where:   abstract member function(cond: ?any, other: ?any, axis: ?any): ?Data.Spark.DataFrame
  xs:      abstract member function(key: ?any, axis: ?any, level: ?int): ?(Data.Spark.DataFrame | Data.Spark.Series)
}
