abstract type Data.Spark.Series mixes Value {

  T:       abstract property(): ?any
  axes:    abstract property(): ?[any]
  dtype:   abstract property(): ?any
  dtypes:  abstract property(): ?any
  empty:   abstract property(): ?boolean
  hasnans: abstract property(): ?boolean
  iat:     abstract property(): ?any
  iloc:    abstract property(): ?Data.Spark.IlocIndexer

  index: abstract property()
                    : ?(Data.Spark.Index | Data.Spark.MultiIndex | Data.Spark.CategoricalIndex | Data.Spark.DatetimeIndex | Data.Spark.TimedeltaIndex)

  is_monotonic:            abstract property(): ?boolean
  is_monotonic_decreasing: abstract property(): ?boolean
  is_monotonic_increasing: abstract property(): ?boolean
  is_unique:               abstract property(): ?boolean
  loc:                     abstract property(): ?Data.Spark.LocIndexer
  name:                    abstract property(): ?any
  ndim:                    abstract property(): ?int
  shape:                   abstract property(): ?any
  size:                    abstract property(): ?int
  str:                     abstract property(): ?Data.Spark.StringMethods
  dt:                      abstract property(): ?Data.Spark.DatetimeMethods
  abs:                     abstract member function(): ?(Data.Spark.DataFrame | Data.Spark.Series)
  add:                     abstract member function(other: ?any,
                                                    fill_value: ?(float | int | string)): ?Data.Spark.Series
  add_prefix:              abstract member function(prefix: ?string): ?Data.Spark.Series
  add_suffix:              abstract member function(suffix: ?string): ?Data.Spark.Series
  agg:                     abstract member function(func: ?([string] | string)): ?Data.Spark.Series
  aggregate:               abstract member function(func: ?([string] | string)): ?Data.Spark.Series

  align: abstract member function(other: ?any,
                                  join: ?string,
                                  axis: ?any,
                                  copy: ?boolean): ?(Data.Spark.DataFrame | Data.Spark.Series)

  all: abstract member function(axis: ?any, skipna: ?boolean): ?boolean
  any: abstract member function(axis: ?any): ?boolean

  append: abstract member function(to_append: ?any,
                                   ignore_index: ?boolean,
                                   verify_integrity: ?boolean): ?Data.Spark.Series

  apply:    abstract member function(func: ?lambda(x: any ...): any, args: ?any): ?Data.Spark.Series
  argmax:   abstract member function(axis: ?any, skipna: ?boolean): ?int
  argmin:   abstract member function(axis: ?any, skipna: ?boolean): ?int
  argsort:  abstract member function(): ?Data.Spark.Series
  asof:     abstract member function(where: ?any): ?Data.Spark.Series
  astype:   abstract member function(dtype: ?any): ?any
  at_time:  abstract member function(time: ?any, asof: ?boolean, axis: ?any): ?Data.Spark.Series
  autocorr: abstract member function(lag: ?int): ?float

  backfill: abstract member function(axis: ?any,
                                     inplace: ?any,
                                     limit: ?int): ?(Data.Spark.DataFrame | Data.Spark.Series)

  between: abstract member function(left: ?any, right: ?any, inclusive: ?(boolean | string)): ?Data.Spark.Series

  between_time: abstract member function(start_time: ?any,
                                         end_time: ?any,
                                         include_start: ?boolean,
                                         include_end: ?boolean,
                                         axis: ?any): ?Data.Spark.Series

  bfill:         abstract member function(axis: ?any,
                                          inplace: ?any,
                                          limit: ?int): ?(Data.Spark.DataFrame | Data.Spark.Series)
  bool:          abstract member function(): ?boolean
  clip:          abstract member function(lower: ?(float | int),
                                          upper: ?(float | int),
                                          inplace: ?boolean): ?Data.Spark.Series
  combine_first: abstract member function(other: ?any): ?Data.Spark.Series
  compare:       abstract member function(other: ?any,
                                          keep_shape: ?boolean,
                                          keep_equal: ?boolean): ?Data.Spark.DataFrame
  copy:          abstract member function(deep: ?boolean): ?Data.Spark.Series
  corr:          abstract member function(other: ?any, method: ?string, min_periods: ?int): ?float
  count:         abstract member function(axis: ?any, numeric_only: ?boolean): ?Data.Spark.Series
  cov:           abstract member function(other: ?any, min_periods: ?int, ddof: ?int): ?float
  cummax:        abstract member function(skipna: ?boolean): ?(Data.Spark.DataFrame | Data.Spark.Series)
  cummin:        abstract member function(skipna: ?boolean): ?(Data.Spark.DataFrame | Data.Spark.Series)
  cumprod:       abstract member function(skipna: ?boolean): ?(Data.Spark.DataFrame | Data.Spark.Series)
  cumsum:        abstract member function(skipna: ?boolean): ?(Data.Spark.DataFrame | Data.Spark.Series)
  describe:      abstract member function(percentiles: ?[float]): ?Data.Spark.Series
  diff:          abstract member function(periods: ?int): ?Data.Spark.Series
  div:           abstract member function(other: ?any): ?Data.Spark.Series
  divide:        abstract member function(other: ?any): ?Data.Spark.Series
  divmod:        abstract member function(other: ?any): ?Data.Spark.Series
  dot:           abstract member function(other: ?any): ?Data.Spark.Series

  drop: abstract member function(labels: ?any,
                                 index: ?any,
                                 columns: ?any,
                                 level: ?int,
                                 inplace: ?boolean): ?Data.Spark.Series

  drop_duplicates: abstract member function(keep: ?(boolean | string), inplace: ?boolean): ?Data.Spark.Series
  droplevel:       abstract member function(level: ?any): ?Data.Spark.Series
  dropna:          abstract member function(axis: ?any, inplace: ?boolean): ?Data.Spark.Series
  duplicated:      abstract member function(keep: ?(boolean | string)): ?Data.Spark.Series
  eq:              abstract member function(other: ?any): ?Data.Spark.Series
  equals:          abstract member function(other: ?any): ?Data.Spark.Series

  ewm: abstract member function(com: ?float,
                                span: ?float,
                                halflife: ?float,
                                alpha: ?float,
                                min_periods: ?int,
                                ignore_na: ?any): ?(Data.Spark.DataFrame | Data.Spark.Series)

  expanding: abstract member function(min_periods: ?int): ?(Data.Spark.DataFrame | Data.Spark.Series)
  explode:   abstract member function(): ?Data.Spark.Series
  ffill:     abstract member function(axis: ?any,
                                      inplace: ?any,
                                      limit: ?int): ?(Data.Spark.DataFrame | Data.Spark.Series)

  fillna: abstract member function(value: ?any,
                                   method: ?string,
                                   axis: ?any,
                                   inplace: ?boolean,
                                   limit: ?int): ?Data.Spark.Series

  filter:            abstract member function(items: ?any,
                                              like: ?string,
                                              regex: ?string,
                                              axis: ?any): ?Data.Spark.Series
  first:             abstract member function(offset: ?any): ?Data.Spark.Series
  first_valid_index: abstract member function(): ?any
  floordiv:          abstract member function(other: ?any): ?Data.Spark.Series
  ge:                abstract member function(other: ?any): ?Data.Spark.Series
  get:               abstract member function(key: ?any, default: ?any): ?any
  get_dtype_counts:  abstract member function(): ?Data.Spark.Series

  groupby: abstract member function(by: ?any,
                                    axis: ?any,
                                    as_index: ?boolean,
                                    dropna: ?boolean): ?Data.Spark.SeriesGroupBy

  gt:     abstract member function(other: ?any): ?Data.Spark.Series
  head:   abstract member function(n: ?int): ?Data.Spark.Series
  hist:   abstract member function(bins: ?any): ?any
  idxmax: abstract member function(skipna: ?boolean): ?any
  idxmin: abstract member function(skipna: ?boolean): ?any

  interpolate: abstract member function(method: ?string,
                                        limit: ?int,
                                        limit_direction: ?string,
                                        limit_area: ?string): ?Data.Spark.Series

  isin:             abstract member function(values: ?any): ?any
  isna:             abstract member function(): ?any
  isnull:           abstract member function(): ?any
  item:             abstract member function(): ?any
  items:            abstract member function(): ?Iterator
  iteritems:        abstract member function(): ?Iterator
  keys:             abstract member function(): ?Data.Spark.Index
  kurt:             abstract member function(axis: ?any, skipna: ?boolean, numeric_only: ?boolean): ?Data.Spark.Series
  kurtosis:         abstract member function(axis: ?any, skipna: ?boolean, numeric_only: ?boolean): ?Data.Spark.Series
  last:             abstract member function(offset: ?any): ?Data.Spark.Series
  last_valid_index: abstract member function(): ?any
  le:               abstract member function(other: ?any): ?Data.Spark.Series
  lt:               abstract member function(other: ?any): ?Data.Spark.Series
  mad:              abstract member function(): ?float
  map:              abstract member function(arg: ?any, na_action: ?string): ?Data.Spark.Series
  mask:             abstract member function(cond: ?any, other: ?any): ?Data.Spark.Series
  max:              abstract member function(axis: ?any, skipna: ?boolean, numeric_only: ?boolean): ?Data.Spark.Series
  mean:             abstract member function(axis: ?any, skipna: ?boolean, numeric_only: ?boolean): ?Data.Spark.Series

  median: abstract member function(axis: ?any,
                                   skipna: ?boolean,
                                   numeric_only: ?boolean,
                                   accuracy: ?int): ?Data.Spark.Series

  min:        abstract member function(axis: ?any, skipna: ?boolean, numeric_only: ?boolean): ?Data.Spark.Series
  mod:        abstract member function(other: ?any): ?Data.Spark.Series
  mode:       abstract member function(dropna: ?boolean): ?Data.Spark.Series
  mul:        abstract member function(other: ?any): ?Data.Spark.Series
  ne:         abstract member function(other: ?any): ?Data.Spark.Series
  nlargest:   abstract member function(n: ?int): ?Data.Spark.Series
  notna:      abstract member function(): ?any
  notnull:    abstract member function(): ?any
  nsmallest:  abstract member function(n: ?int): ?Data.Spark.Series
  nunique:    abstract member function(dropna: ?boolean, approx: ?boolean, rsd: ?float): ?int
  pad:        abstract member function(axis: ?any,
                                       inplace: ?any,
                                       limit: ?int): ?(Data.Spark.DataFrame | Data.Spark.Series)
  pct_change: abstract member function(periods: ?int): ?Data.Spark.Series
  pipe:       abstract member function(func: ?lambda(x: any ...): any): ?any
  pop:        abstract member function(item: ?any): ?Data.Spark.Series
  pow:        abstract member function(other: ?any): ?Data.Spark.Series

  prod: abstract member function(axis: ?any,
                                 skipna: ?boolean,
                                 numeric_only: ?boolean,
                                 min_count: ?int): ?Data.Spark.Series

  product: abstract member function(axis: ?any,
                                    skipna: ?boolean,
                                    numeric_only: ?boolean,
                                    min_count: ?int): ?Data.Spark.Series

  quantile:     abstract member function(q: ?any, accuracy: ?int): ?Data.Spark.Series
  radd:         abstract member function(other: ?any, fill_value: ?(float | int | string)): ?Data.Spark.Series
  rank:         abstract member function(method: ?string,
                                         ascending: ?boolean,
                                         numeric_only: ?boolean): ?Data.Spark.Series
  rdiv:         abstract member function(other: ?any): ?Data.Spark.Series
  rdivmod:      abstract member function(other: ?any): ?Data.Spark.Series
  reindex:      abstract member function(index: ?any, fill_value: ?any): ?Data.Spark.Series
  reindex_like: abstract member function(other: ?any): ?Data.Spark.Series
  rename:       abstract member function(index: ?any): ?Data.Spark.Series
  rename_axis:  abstract member function(mapper: ?any, index: ?any, inplace: ?boolean): ?Data.Spark.Series
  repeat:       abstract member function(repeats: ?any): ?Data.Spark.Series
  replace:      abstract member function(to_replace: ?any,
                                         value: ?any,
                                         regex: ?(boolean | string)): ?Data.Spark.Series
  resample:     abstract member function(rule: ?any, closed: ?any, label: ?any, on: ?any): ?Data.Spark.Resampler

  reset_index: abstract member function(level: ?any,
                                        drop: ?boolean,
                                        name: ?any,
                                        inplace: ?boolean): ?(Data.Spark.DataFrame | Data.Spark.Series)

  rfloordiv: abstract member function(other: ?any): ?Data.Spark.Series
  rmod:      abstract member function(other: ?any): ?Data.Spark.Series
  rmul:      abstract member function(other: ?any): ?Data.Spark.Series
  rolling:   abstract member function(window: ?int, min_periods: ?int): ?(Data.Spark.DataFrame | Data.Spark.Series)
  round:     abstract member function(decimals: ?int): ?Data.Spark.Series
  rpow:      abstract member function(other: ?any): ?Data.Spark.Series
  rsub:      abstract member function(other: ?any): ?Data.Spark.Series
  rtruediv:  abstract member function(other: ?any): ?Data.Spark.Series

  sample: abstract member function(n: ?int,
                                   frac: ?float,
                                   replace: ?boolean,
                                   random_state: ?int,
                                   ignore_index: ?boolean): ?Data.Spark.Series

  searchsorted: abstract member function(value: ?any, side: ?string): ?int
  sem:          abstract member function(axis: ?any,
                                         skipna: ?boolean,
                                         ddof: ?int,
                                         numeric_only: ?boolean): ?Data.Spark.Series
  shift:        abstract member function(periods: ?int, fill_value: ?any): ?any
  skew:         abstract member function(axis: ?any, skipna: ?boolean, numeric_only: ?boolean): ?Data.Spark.Series

  sort_index: abstract member function(axis: ?any,
                                       level: ?([int] | int),
                                       ascending: ?boolean,
                                       inplace: ?boolean,
                                       kind: ?string,
                                       na_position: ?string,
                                       ignore_index: ?boolean): ?Data.Spark.Series

  sort_values: abstract member function(ascending: ?boolean,
                                        inplace: ?boolean,
                                        na_position: ?string,
                                        ignore_index: ?boolean): ?Data.Spark.Series

  squeeze: abstract member function(axis: ?any): ?(Data.Spark.DataFrame | Data.Spark.Series)
  std:     abstract member function(axis: ?any,
                                    skipna: ?boolean,
                                    ddof: ?int,
                                    numeric_only: ?boolean): ?Data.Spark.Series
  sub:     abstract member function(other: ?any): ?Data.Spark.Series

  sum: abstract member function(axis: ?any,
                                skipna: ?boolean,
                                numeric_only: ?boolean,
                                min_count: ?int): ?Data.Spark.Series

  swapaxes:     abstract member function(i: ?any, j: ?any, copy: ?boolean): ?Data.Spark.Series
  swaplevel:    abstract member function(i: ?any, j: ?any, copy: ?boolean): ?Data.Spark.Series
  tail:         abstract member function(n: ?int): ?Data.Spark.Series
  take:         abstract member function(indices: ?any): ?any
  to_clipboard: abstract member function(excel: ?boolean, sep: ?string): ?any

  to_csv: abstract member function(path: ?string,
                                   sep: ?string,
                                   na_rep: ?string,
                                   columns: ?[any],
                                   header: ?boolean,
                                   quotechar: ?string,
                                   date_format: ?string,
                                   escapechar: ?string,
                                   num_files: ?int,
                                   mode: ?string,
                                   partition_cols: ?([string] | string),
                                   index_col: ?([string] | string)): ?string

  to_dataframe: abstract member function(name: ?any): ?Data.Spark.DataFrame
  to_dict:      abstract member function(into: ?any): ?any

  to_excel: abstract member function(excel_writer: ?any,
                                     sheet_name: ?string,
                                     na_rep: ?string,
                                     float_format: ?string,
                                     columns: ?([string] | string),
                                     header: ?boolean,
                                     index: ?boolean,
                                     index_label: ?([string] | string),
                                     startrow: ?int,
                                     startcol: ?int,
                                     engine: ?string,
                                     merge_cells: ?boolean,
                                     encoding: ?string,
                                     inf_rep: ?string,
                                     verbose: ?boolean,
                                     freeze_panes: ?(int, int)): ?any

  to_frame: abstract member function(name: ?any): ?Data.Spark.DataFrame

  to_json: abstract member function(path: ?string,
                                    compression: ?string,
                                    num_files: ?int,
                                    mode: ?string,
                                    orient: ?string,
                                    lines: ?boolean,
                                    partition_cols: ?([string] | string),
                                    index_col: ?([string] | string)): ?string

  to_latex: abstract member function(buf: ?any,
                                     columns: ?[any],
                                     col_space: ?int,
                                     header: ?boolean,
                                     index: ?boolean,
                                     na_rep: ?string,
                                     formatters: ?([lambda(a: any): string] | map<any, lambda(a: any): string>),
                                     float_format: ?lambda(a: float): string,
                                     sparsify: ?boolean,
                                     index_names: ?boolean,
                                     bold_rows: ?boolean,
                                     column_format: ?string,
                                     longtable: ?boolean,
                                     escape: ?boolean,
                                     encoding: ?string,
                                     decimal: ?string,
                                     multicolumn: ?boolean,
                                     multicolumn_format: ?string,
                                     multirow: ?boolean): ?string

  to_list:     abstract member function(): ?[any]
  to_markdown: abstract member function(buf: ?any, mode: ?string): ?string
  to_pandas:   abstract member function(): ?Data.Spark.Series

  to_string: abstract member function(buf: ?any,
                                      na_rep: ?string,
                                      float_format: ?lambda(a: float): string,
                                      header: ?boolean,
                                      index: ?boolean,
                                      length: ?boolean,
                                      dtype: ?boolean,
                                      name: ?boolean,
                                      max_rows: ?int): ?string

  tolist: abstract member function(): ?[any]

  transform: abstract member function(func: ?([lambda(x: any ...): any] | (lambda(x: any ...): any)),
                                      axis: ?any): ?(Data.Spark.DataFrame | Data.Spark.Series)

  transpose: abstract member function(): ?Data.Spark.Series
  truediv:   abstract member function(other: ?any): ?Data.Spark.Series

  truncate: abstract member function(before: ?any,
                                     after: ?any,
                                     axis: ?any,
                                     copy: ?any): ?(Data.Spark.DataFrame | Data.Spark.Series)

  unique:  abstract member function(): ?Data.Spark.Series
  unstack: abstract member function(level: ?int): ?Data.Spark.DataFrame
  update:  abstract member function(other: ?any): ?any

  value_counts: abstract member function(normalize: ?boolean,
                                         sort: ?boolean,
                                         ascending: ?boolean,
                                         bins: ?any,
                                         dropna: ?boolean): ?Data.Spark.Series

  var:   abstract member function(axis: ?any, ddof: ?int, numeric_only: ?boolean): ?Data.Spark.Series
  where: abstract member function(cond: ?any, other: ?any): ?Data.Spark.Series
  xs:    abstract member function(key: ?any, level: ?int): ?Data.Spark.Series
}
