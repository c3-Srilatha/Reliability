/**
 * Abstract interface representing the pandas TimedeltaIndex class.
 */
@beta
abstract type Data.TimedeltaIndex mixes ReClaim, Data.IndexBase, Pandas.TimedeltaIndex {

  // TODO: PLAT-50581 Pandas type generation framework should be able to infer parameters from documentation
  round: abstract member function(freq: any, ambiguous: any, nonexistent: any): Data.TimedeltaIndex | Data.Series

  floor: abstract member function(freq: any, ambiguous: any, nonexistent: any): Data.TimedeltaIndex | Data.Series
  ceil:  abstract member function(freq: any, ambiguous: any, nonexistent: any): Data.TimedeltaIndex | Data.Series
  mean:  abstract member function(skipna: any, axis: int): any
}
