/**
 * For each field of the type, we keep one or more indexes into the dimensions of the mixture model distribution.
 * For fields which are ever null, the first determines whether the value is null or not. If the type is not mappable
 * to a set of scalars, a nested generator is used.
 */
type DataGenMixtureModel.FieldModel mixes Nameable {

  /**
   * field path from parent TypeModel
   */
  name: !~

  /**
   * how the field is modelled
   */
  modelled: !string enum('scalarized', 'enum', 'markov', 'other')

  /**
   * index of null/not null scalar
   */
  nullIndex: int

  /**
   * index of collection size scalar
   */
  sizeIndex: int

  /**
   * indexes of value scalars
   */
  valueIndexes: [int] schema suffix 'VI'

  /**
   * enumerated values
   */
  enumValues: [any]

  /**
   * other generator for values
   */
  valueGen: DataGen
}
