/**
 * List of errors and stats.
 */
type ObjStats mixes Result {

  // TODO: mixes Stats

  /**
   * List of errors encountered during the operation.
   */
  errors: [ObjError]

  /**
   * Various statistics for the operation.
   */
  stats: ActionStats

  /**
   * @return the total number objects created, updated or removed.
   */
  changeCount: member function(): !int

  /**
   * @return the number of errors.
   */
  errorCount: member function(): !int

  /**
   * @return the first error in {@link errors} if there are any and null otherwise.
   */
  firstError: member function(): ObjError

  /**
   * @return combined ObjStats.
   */
  concat: member function(other: !mixing ObjStats): !mixing ObjStats
}
