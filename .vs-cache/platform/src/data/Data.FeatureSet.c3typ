/**
 * A specialization of {@link Data.Lazy} that represents data evaluated from the {@link Feature.Store}.
 */
@beta
type Data.FeatureSet mixes Data.Lazy {

  @reClaim(inherit=true)
  slice: ~

  /**
   * @return {@link Data.FeatureSet.Stream} or {@link Data.Persisted.Stream} based on the most optimal streaming implementation.
   * Please note that when streaming from a snapshot created with {@link CreateSnapshotSpec#combineSubjects}=true:
   * 1. **subjectFilter** argument of {@link FeatureEvaluatable#evalFeatureSetBatch} must be set to **true**.
   * 2. Use of {@link FeaureEvaluatable#evalFeatureSetBatch} method with **batch** argument is not supported.
   * 3. {@link EvalFeatureSpec#start} and {@link EvalFeatureSpec#end} must not be set as time range filter in also not supported.
   * If any the above is not adhered to, then an exception will be thrown when stream() is invoked on the returned Data instance from {@link FeatureEvaluatable#evalFeatureSetBatch}.
   */
  @reClaim(inherit=true)
  stream: ~

  /**
   * Helper for python implementation to call java `super` on {@link #stream}.
   */
  streamHelper: private member function(spec: Data.FeatureSet.StreamSpec): !Data.Stream

  /**
   * @return true if the subjects are specified as a {@link FetchFilterSpec#Filter} and false if its specified as
   * a stream of {@link FeatureEvaluable}s
   *
   * @see FeatureEvaluatable#evalFeatureSetBatch
   * @see FeatureEvaluatable#evalFeatureSet
   * @see EvalFeatureSpec
   */
  hasSubjectFilter: private member function(): boolean

  /**
   * @return the subject filter if specified, null otherwise.
   *
   * @see FeatureEvaluatable#evalFeatureSetBatch
   * @see FeatureEvaluatable#evalFeatureSet
   * @see EvalFeatureSpec
   */
  subjectFilter: private member function(): string serialized Filter

  /**
   * @return the subjects as an array of FeatureEvaluatable instances, null otherwise.
   *
   * @see FeatureEvaluatable#evalFeatureSetBatch
   * @see FeatureEvaluatable#evalFeatureSet
   * @see EvalFeatureSpec
   */
  subjects: private member function(): [FeatureEvaluatable]

  /**
   * @return Feature.Set of the
   *
   * @see FeatureEvaluatable#evalFeatureSetBatch
   * @see FeatureEvaluatable#evalFeatureSet
   * @see EvalFeatureSpec
   */
  featureSet: private member function(): !Feature.Set

  /**
   * @return the subjectType of the `Feature.Set`
   */
  subjectType: private member function(): !Type<<FeatureEvaluatable>>

  /**
   * @return {@link TimeRange} of the evaluation.
   */
  timeRange: private member function(): !TimeRange
}
