/**
 * Base type for data generators that can be trained.
 *
 * Initial training is done using a new instance. For example, a Markov chain:
 * ```js
 * var m = DataGenMarkov.make({ params: 3 }).train(['hello world', 'hey dudes']);
 * ```
 *
 * To add more samples to a trained data generator, use #train:
 * ```js
 * m = m.train(['howdy folks']);
 * ```
 *
 * Restarting training is done using #retrain. For example, to reset the parameters and start new training values:
 * ```js
 * var m = DataGenMarkov.make().retrain(['hola muchachos', 'hola chicos'], 3);
 * ```
 *
 * Note that parameters can be specified to retrain, but _not_ to train. Of course, a fresh instance can always be
 * created as well.
 *
 * @var T the type of values generated (same as for {@link DataGen})
 * @var P the type of the parameter(s), if any
 */
abstract type DataGenTrained<T, P> {

  /**
   * The parameters with which the data generator was trained (if any).
   */
  params: P

  /**
   * Whether this has model has been trained with sufficient data to generate values.
   */
  isTrained: abstract member function(): boolean

  /**
   * Augment training the data generator with the specified input values, if supported. The parameter values specified
   * for initial training remain in effect. If incremental training is not supported (see #incrementalTraining), the
   * previous values may be partly or fully lost.
   */
  train: abstract member function(inputs: [any]): mixing DataGenTrained

  /**
   * Whether this model can support incremental training; that is, calling #train multiple times and having the final
   * model contain the full results of all values passed. If not, values passed to the most recent call to train
   * contribute more heavily, or even solely, to the model. By default this is true, and sub-types that do not support
   * incremental training should override it to return false.
   *
   * Note that this is a member method because some of the models may contain sub-models and the value returned by this
   * method should be the most restrictive.
   */
  incrementalTraining: member function(): boolean

  /**
   * Train the data generator from scratch with the specified input values and the appropriate parameters (if any).
   * If no parameters are specified, the existing parameters are reused.
   */
  retrain: member function(inputs: [any], params: P): mixing DataGenTrained

  /**
   * Train a model for the specified value type using the specified set of values. Various techniques may be used,
   * but only a fully trained model will be returned. If no model can be trained for that type and/or the values
   * provided, null is returned. However, if fallback is true, a generic data generator will be returned.
   *
   * Note that the resulting data generator may be one that is not trained at all. For example, if a the values are
   * all identical, a constant generator will be returned. However, it will return a DataGenTrained if available.
   *
   * @param valueType value type for DataGen binding
   * @param values the actual values to train on
   * @param fallback return a generic DataGen if unable to train
   * @return DataGen instance capable of generating values or null
   */
  forValuesTrained: function(valueType: !ValueType, values: ![any], fallback: boolean): DataGen
}
