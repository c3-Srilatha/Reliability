@beta
abstract type Data.Series mixes Pandas.Series, ReClaim, PyReprProtocol, DataImpl, ArithmeticProtocol, ComparisonProtocol, UnaryArithmeticProtocol, LogicalProtocol, LengthProtocol, ObjProtocol, MutableItemProtocol, Iterable {

  _exec: ~ from DataImpl

  /**
   * Converts this series to a {@link Data.Series.Pandas}. If parent dataset is not provided then will use default data set.
   */
  toDataPandas: private abstract member function(ds: Dataset): Data.Series.Pandas

  @reClaim(inherit=true)
  dereference: private ~: !Data.Series

  @reClaim(inherit=true)
  toDataRef: private ~: !Data.Series.Ref

  cache:    private ~: Data.Series
  isCached: private ~

  @reClaim(inherit=true)
  repr: member function(): string

  @reClaim(inherit=true)
  addition: private ~

  @reClaim(inherit=true)
  subtract: private ~

  @reClaim(inherit=true)
  multiply: private ~

  @reClaim(inherit=true)
  matrixMultiply: private ~

  @reClaim(inherit=true)
  trueDivision: private ~

  @reClaim(inherit=true)
  floorDivision: private ~

  @reClaim(inherit=true)
  modulo: private ~

  @reClaim(inherit=true)
  power: private ~

  @reClaim(inherit=true)
  reflectedAddition: private ~

  @reClaim(inherit=true)
  reflectedSubtract: private ~

  @reClaim(inherit=true)
  reflectedMultiply: private ~

  @reClaim(inherit=true)
  reflectedMatrixMultiply: private ~

  @reClaim(inherit=true)
  reflectedTrueDivision: private ~

  @reClaim(inherit=true)
  reflectedFloorDivision: private ~

  @reClaim(inherit=true)
  reflectedModulo: private ~

  @reClaim(inherit=true)
  reflectedPower: private ~

  @reClaim(inherit=true)
  lessThan: private ~

  @reClaim(inherit=true)
  lessThanEqualTo: private ~

  @reClaim(inherit=true)
  equalTo: private ~

  @reClaim(inherit=true)
  notEqualTo: private ~

  @reClaim(inherit=true)
  greaterThan: private ~

  @reClaim(inherit=true)
  greaterThanEqualTo: private ~

  @reClaim(inherit=true)
  toNegative: private ~

  neg: abstract member function(): Data.Series

  @reClaim(inherit=true)
  toPositive: private ~

  @reClaim(inherit=true)
  toAbsolute: private ~

  @reClaim(inherit=true)
  toInverted: private ~

  invert: abstract member function(): Data.Series

  @reClaim(inherit=true)
  toRounded: private ~

  @reClaim(inherit=true)
  logicalAnd: private ~

  @reClaim(inherit=true)
  logicalOr: private ~

  @reClaim(inherit=true)
  logicalXor: private ~

  @reClaim(inherit=true)
  reflectedLogicalAnd: private ~

  @reClaim(inherit=true)
  reflectedLogicalOr: private ~

  @reClaim(inherit=true)
  reflectedLogicalXor: private ~

  /**
   * @return {@link ValueType} describing this Data.Series
   */
  dataType: private cached abstract member function(): !ValueType

  /**
   * Perform a bitwise "and" operation on the Data.Series with "other"
   */
  and: abstract member function(other: !?any): Data | Data.Series

  /**
   * Perform a bitwise "or" operation on the Data.Series with "other"
   */
  or: abstract member function(other: !?any): Data | Data.Series

  @pandas(canReturnData=true)
  @reClaim(inherit=true)
  _item_: private ~

  @reClaim(inherit=true)
  _setItem_: private ~

  /**
   * Mutably sets selected values in this Data.
   * @param selector
   *        Determines criteria for selection. Legal selectors are:
   *            - single index label
   *            - array of index label(s)
   *            - array of booleans (must be same length as this.shape[0])
   *            - single-column Data (Series) of booleans (must be same length as this.shape[0])
   *        Cannot be null. Deos not support slicing.
   * @param value
   *        Value to set for selected item(s). Can be a:
   *            - value
   *            - array of values
   *            - single-column Data (Series) of values
   */
  @pandas(isMutable=true)
  setItem: private abstract member function(selector: !?any, value: !?any): ?Data.Series

  /**
   * Mutably sets selected values in this Data.
   * @param fst
   *        Determines criteria for row selection. Legal selectors are:
   *            - single index label
   *            - array of index label(s)
   *            - {@link Slice} of index labels
   *            - array of booleans (must be same length as this.shape[0])
   *            - single-column Data (Series) of booleans (must be same length as this.shape[0])
   *        Cannot be null.
   * @param value
   *        Value to set for selected item(s). Can be a:
   *            - value
   *            - array of values
   *            - single-column Data (Series) of values
   *
   * @see DataLocIndexer#set
   */
  @pandas(isMutable=true)
  setLoc: private abstract member function(fst: !any, value: !any): Data.Series

  /**
   * Mutably sets selected values in this Data.
   * @param fst
   *        Determines criteria for row selection. Legal selectors are:
   *            - single index
   *            - array of indices
   *            - {@link Slice} of indices
   *            - array of booleans (must be same length as this.shape[0])
   *            - single-column Data (Series) of booleans (must be same length as this.shape[0])
   *        Cannot be null.
   * @param value
   *        Value to set for selected item(s). Can be a:
   *            - value
   *            - array of values
   *            - single-column Data (Series) of values
   *
   * @see DataIlocIndexer#set
   */
  @pandas(isMutable=true)
  setIloc: private abstract member function(fst: !any, value: !any): Data.Series

  @pandas(canReturnData=true)
  getItem: private abstract member function(fst: any): any

  /**
   * Operation represents using the `_item_` (bracket syntax) protocol on a Pandas iloc Indexer.
   */
  @pandas(canReturnData=true)
  getIloc: private abstract member function(fst: any): any

  /**
   * Operation represents using the `_item_` (bracket syntax) protocol on a Pandas loc Indexer.
   */
  @pandas(canReturnData=true)
  getLoc: private abstract member function(fst: any): any

  /**
   * Access a group of rows and columns by label(s) or a boolean array.
   *
   * Supports a subset of arguments to [pandas.DataFrame.loc](https://pandas.pydata.org/pandas-docs/stable/reference/api/pandas.DataFrame.loc.html)
   */
  @reClaim(inherit=true)
  loc: ~

  /**
   * Purely integer-location based indexing for selection by position.
   *
   * Supports a subset of arguments to [pandas.DataFrame.iloc](https://pandas.pydata.org/pandas-docs/stable/reference/api/pandas.DataFrame.iloc.html)
   */
  @reClaim(inherit=true)
  iloc: ~

  /**
   *  Flatten specified columns. The behavior of flatten is different when:
   *    column dtype is a list-like: list is flattened, similar to `Data#explode`
   *    column dtype is a map-like: dict is expanded such that the keys of the dict become new columns in the Data
   *  Only one of include or level can be specified at a time, otherwise an error will be thrown.
   *  @param include
   *         A comma separated set of columns that determine what data to return from this operation, `a.b.c, z.x`
   *  @param level
   *         The depth at which to flatten and return all nested data
   *  @return
   *         {@link Data} when multiple columns are returned using include or when using level on a {@link Data} with
   *                      multiple columns
   *         {@link Data.Series} when a single column is returned using include
   *
   *  Examples:
   *  ```py
   *  data = c3.Data.Series([{"a": [{"aa": 1, "ab": 1}, {"aa": 2, "ab": 2}], "b": [[{"bb": 1}], [{"bb": 2}]]}])
   *  data.flatten("a") ->
   *   0 {"aa": 1, "ab": 1}
   *   1 {"aa": 2, "ab": 2}
   *
   *  data.flatten("a.aa")
   * .     "aa"
   *   0  1
   *   1  2
   *
   *  data.flatten("b.bb") ->
   * .    "bb"
   *   0  1
   *   1  2
   *
   *  data.flatten("a.ab, b.bb") ->
   * .    "a.ab" "b.bb"
   *   0  1      1
   *   1  2      2
   *
   *  data.flatten(level=-1) ->
   * .        "a.aa"      "a.ab"    "b.bb"
   *   0      1           1         1
   *   1      2           2         2
   *  ```
   */
  @pandas(isNotPandasDispatchable=true)
  flatten: abstract member function(include: ?string, level: ?int): !(Data | Data.Series)

  /**
   * Implements pandas reindex semantics from pandas version 1.3.4 for Data.Series
   */
  reindex: abstract member function(index: any,
                                    method: string,
                                    copy: any,
                                    level: int | string,
                                    fill_value: any,
                                    limit: any,
                                    tolerance: any): Data.Series

  /**
   * Align two objects on their axes with the specified join method.
   *
   * Join method is specified for each axis Index.
   * see: https://pandas.pydata.org/docs/reference/api/pandas.Series.align.html
   */
  // This implementation allows align() to go through exec and return the result in Java, ensuring the
  // deserialization of Data.Series returned within the Collection
  // TODO PLAT-51354: Update return types to tuples
  @reClaim(inherit=true)
  _align: private member function(other: ?any,
                                  join: ?string,
                                  axis: ?any,
                                  level: ?any,
                                  copy: ?any,
                                  fill_value: ?any,
                                  method: ?string,
                                  limit: ?any,
                                  fill_axis: ?any,
                                  broadcast_axis: ?any): ?[any]

  /**
   * Encode the object as an enumerated type or categorical variable.
   *
   * This method is useful for obtaining a numeric representation of an array when all that matters is identifying
   * distinct values. factorize is available as both a top-level function
   *
   * see: https://pandas.pydata.org/pandas-docs/stable/reference/api/pandas.Series.factorize.html
   */
  // This implementation allows factorize() to go through exec and return the result in Java, ensuring the
  // deserialization of Data.Series returned within the Collection
  // TODO PLAT-51354: Update return types to tuples
  @reClaim(inherit=true)
  _factorize: private member function(sort: ?any, na_sentinel: ?int): ?[any]

  /**
   * Return Integer division and modulo of series and other, element-wise (binary operator rdivmod).
   *
   * see: https://pandas.pydata.org/docs/reference/api/pandas.Series.rdivmod.html
   */
  // This implementation allows rdivmod() to go through exec and return the result in Java, ensuring the
  // deserialization of Data.Series returned within the Collection
  // TODO PLAT-51354: Update return types to tuples
  @reClaim(inherit=true)
  _rdivmod: private member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?[any]

  /**
   * Return Integer division and modulo of series and other, element-wise (binary operator divmod).
   *
   * see: https://pandas.pydata.org/docs/reference/api/pandas.Series.divmod.html
   */
  // This implementation allows divmod() to go through exec and return the result in Java, ensuring the
  // deserialization of Data.Series returned within the Collection
  // TODO PLAT-51354: Update return types to tuples
  @reClaim(inherit=true)
  _divmod: private member function(other: ?any, level: ?any, fill_value: ?any, axis: ?any): ?[any]

  /**
   * Iterate over the values.
   */
  @reClaim(inherit=true)
  iter: ~

  // This implementation allows shape to go through exec and return the result in Java, ensuring the
  // deserialization of Data.Series returned within the Collection
  // TODO: PLAT-51354 Update return types to tuples
  @reClaim(inherit=true)
  _shape: private property(): ?[int]

  /**
   * Return an intermediate Data.Series.StringMethods object for the .str operators on Data.Series
   */
  str: property(): ?Data.Series.StringMethods
}
