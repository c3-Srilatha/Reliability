@beta
native py remix type Data.Index {

  /*
   * Pandas.Index.array returns Pandas {{ExtensionArray}}, which is not supported in c3, thus we add this overload to
   * get the pandas {{ExtensionArray}}s by converting the index to native Pandas {{Index}}. For details, go to this url:
   * https://pandas.pydata.org/docs/reference/api/pandas.api.extensions.ExtensionArray.html
   */
  @py(property=true)
  @typesys(todo="PLAT-130527 - Remove Obj#array overrides from Data index types")
  array: ~: native py
}
