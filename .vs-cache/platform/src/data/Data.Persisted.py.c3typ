@beta
native py remix type Data.Persisted {

  /**
   * Constructor of a {@link Data.Persisted} from a python-native `pandas.DataFrame`.
   * @param pandas
   *           the `pandas.DataFrame` native object.
   * @return {@link Data.Persisted} representing the given dataframe.
   */
  from_pandas: function(pandas: !native, dataset_id: string, name: string): mixing DataImpl py

  /**
   * Constructor of a {@link Data.Persisted} from a python-native `numpy.ndarray`.
   * @param ndarray
   *           the `numpy.ndarray` native object.
   * @return {@link Data.Persisted} representing the given dataframe.
   */
  from_numpy: function(ndarray: !native, dataset_id: string, name: string): Data py

  /**
   * Converts to native `pandas.DataFrame` format.
   * @return converted instance of pandas dataframe
   */
  to_pandas: member function(): native py

  /**
   * Converts to native `numpy.ndarray`.
   * @return converted instance of numpy array
   */
  to_numpy: member function(dtype: native, copy: native, na_value: native): native py
}
