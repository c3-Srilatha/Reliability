@beta
private type DataImpl.Arrow {

  /**
   * The reader for this arrow file. The concrete implementation may change based on the use case between Streaming and
   * Random access.
   */
  reader: private @java(class="org.apache.arrow.vector.ipc.ArrowFileReader") !native

  /**
   * Convert to concrete instance of Data based on the content of the arrow buffer.
   */
  @deprecated(finalVersion="8.8", details="This method will be removed in future releases.")
  toData: ~

  /**
   * @param suggestedValueTypes
   *      Is used as a ValueType when the valueType from data is ambiguous or could not be inferred.
   * @return a list of **Data.Column** instances from the arrow file. This is a convenience method that you may
   * use when the intent is to create a 2D dataframe from it, most likely for further processing.
   *
   * @see #groupByDataColumns
   */
  dataColumns: member function(suggestedValueTypes: map<string, ValueType>): ![!Data.Column]

  /**
   * @param suggestedValueTypes
   *      Is used as a ValueType when the valueType from data is ambiguous or could not be inferred.
   * @return a map of subject to **Data.Column** instances after grouping it on the **group** column. You may decide
   * to include the group column by setting includeGroupColumn to **true**.
   *
   * @see #dataColumns
   */
  groupBySortedDataColumn: member function(group: !string,
                                           includeGroupColumn: boolean,
                                           suggestedValueTypes: map<string, ValueType>): map<string, ![!Data.Column]>

  /**
   * @return a DataImpl.Arrow instance by instantiating a reader from the local file path.
   * An error will be thrown if the file is not found or the file is not a valid arrow file.
   */
  fromLocalFile: function(localFilePath: !string): DataImpl.Arrow

  /**
   * Release the buffer or close the reader
   */
  close: member function()

  /**
   * Convert to EvalMetricsResult based on the content of the arrow buffer.
   */
  toEvalMetricsResult: member function(suggestedValueTypes: map<string, ValueType>): EvalMetricsResult
}
