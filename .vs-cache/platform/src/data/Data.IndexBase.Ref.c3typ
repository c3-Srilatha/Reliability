/**
 * Base Index Ref type that all Data.Index Ref subtypes inherit from
 */
@beta
abstract private type Data.IndexBase.Ref mixes DataImpl.Ref, Data.IndexBase {

  _exec:     ~ from DataImpl.Ref
  toDataRef: ~ from Data.IndexBase

  @reClaim(inherit=true)
  dereference: private member function(): Data.IndexBase

  cache:    ~
  isCached: ~
  type:     ~ java
}
