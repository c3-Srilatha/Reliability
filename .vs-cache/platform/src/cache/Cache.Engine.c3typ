/**
 * Cache engine is a component that manages the lifecycle of all caches, i.e. subtypes of Cache & Cached as well as
 * cached methods and properties on types.
 */
// TODO: PLAT-73575 Suggestion: split Engine.New to Controllable, ThreadPooled, etc.
// mixes Engine
private type Cache.Engine {

  /**
   * Primes caches as needed and schedules any maintenance and/or monitoring as needed.
   */
  start: function()

  /**
   * Stops all scheduled running jobs and performs cleanup of all allocated resources.
   */
  stop: function()
}
