/**
 * Kind of cache.
 *
 * @see Cache
 * @see Cache.Histo.Entry
 */
enum type Cache.Kind {

  /**
   * Cache_Impl - main C3 cache implementation.
   */
  CACHE = 'Cache'

  /**
   * SimpleSingletonCache - singleton cache.
   */
  SIMPLE_SINGLETON = 'SimpleSingletonCache'

  /**
   * SimpleCache - simple key-value cache.
   */
  SIMPLE = 'SimpleCache'

  /**
   * Static C3 Map or Java Map field acting as cache.
   */
  STATIC_MAP = 'Static.Map'

  /**
   * Static Java array field acting as cache.
   */
  STATIC_ARRAY = 'Static.Array'

  /**
   * Static Guava Cache field.
   */
  STATIC_GUAVA = 'Static.GuavaCache'

  /**
   * Other static field acting as cache.
   */
  STATIC_OTHER = 'Static.Other'
}
