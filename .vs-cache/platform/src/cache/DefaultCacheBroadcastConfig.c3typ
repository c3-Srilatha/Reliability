/**
 * Config used to determine if ENV/APP broadcast level messages will be sent by default.
 */
@deprecated(finalVersion="8.8", details="Use CacheBroadcastConfig instead, this type is no longer respected in 8.9+")
@action(group+='app-admin')
type DefaultCacheBroadcastConfig mixes Config {

  /**
   * If true, default env/app cache invalidation is not turned on.
   * TODO: PLAT-92970 - Enable DefaultCacheBroadcastConfig
   */
  disabled: boolean = true

  /**
   * Sets the disabled flag to true and broadcasts to all nodes in the level to evict the DefaultCacheBroadcastConfig.
   *      This will disable all cache invalidation for env/app
   * @param level
   *        Either 'ENV' or 'APP' to enable cache invalidation for the specified level.
   */
  @deprecated(finalVersion="8.8", details="Use CacheBroadcastConfig#disble instead")
  disable: function(level: !string enum ConfigOverride)

  /**
   * Sets the disabled flag to false and broadcasts to all nodes in the level to evict the DefaultCacheBroadcastConfig.
   *
   * @param level
   *        Either 'ENV' or 'APP' to enable cache invalidation for the specified level.
   */
  @deprecated(finalVersion="8.8", details="Use CacheBroadcastConfig#enable instead")
  enable: function(level: !string enum ConfigOverride)

  /**
   * Resets the DefaultCacheBroadcastConfig to its default state. Broadcasting will be determined via higher overrides.
   * This clears the config and broadcasts to all nodes in the level to evict the DefaultCacheBroadcastConfig.
   */
  reset: function(level: !string enum ConfigOverride)
}
