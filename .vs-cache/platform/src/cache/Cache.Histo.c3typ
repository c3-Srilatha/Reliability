/**
 * Cache histogram representing memory usage by cache.
 *
 * Obtained via {@link Cache#histo} which collects stats from all registered caches
 * and Java static fields that act as caches.
 *
 * @see Cache#histo
 * @see Cache.Histo.Entry
 */
type Cache.Histo mixes WithToString {

  /**
   * Cache histogram entries, one per cache.
   */
  entries: [Cache.Histo.Entry]

  /**
   * Original spec used to create this histogram.
   */
  spec: Cache.Histo.Spec

  /**
   * Total number of caches.
   */
  @ser(name='totalCaches')
  totalCaches: property(): !int

  /**
   * Total number of entries across all caches.
   */
  @ser(name='totalEntries')
  totalEntries: property(): !int

  /**
   * Total memory across all caches in bytes.
   */
  @ser(name='totalMemoryB')
  totalMemoryB: property(): !int

  /**
   * Total memory formatted as human-readable string.
   */
  @ser(name='totalMemoryF')
  totalMemoryF: property(): !string

  /**
   * Heap used at time of collection.
   */
  heapUsedB: int

  /**
   * Heap max at time of collection.
   */
  heapMaxB: int

  /**
   * Total caches before filtering/limiting (used in header).
   */
  allCaches: int

  /**
   * Total entries across all caches before filtering/limiting (used in header).
   */
  allEntries: int

  /**
   * Total memory across all caches before filtering/limiting in bytes (used in header).
   */
  allMemoryB: int

  /**
   * Number of entries in the histogram.
   */
  @ser(name='size')
  size: property(): !int

  /**
   * Formats the histogram as an ASCII table.
   *
   * @param limit
   *        maximum number of entries to include. Use -1 for all entries. Default is 25.
   * @param width
   *        table width in characters. Default is 180.
   * @return formatted ASCII table string
   */
  print: member function(limit: int = 25, width: int = 180): string

  toString: ~
}
