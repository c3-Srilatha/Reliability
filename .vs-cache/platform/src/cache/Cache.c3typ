// TODO: PLAT-26294 refactor to Cache/Cached.c3typ
@beta
type Cache<K, V> {

  /**
   * Cache name.
   */
  name: string

  /**
   * Number of entries.
   */
  size: int

  /**
   * Cache enabled?
   */
  enabled: boolean

  /**
   * True if this cache is a 'App Aware Cache', basically providing isolation to other apps
   */
  appAware: boolean

  /**
   * Memory size in bytes.
   */
  memoryB: int

  /**
   * Memory size as formatted string.
   */
  memoryF: string

  /**
   * Cache kind.
   */
  kind: string enum Cache.Kind

  /**
   * Consume the key/value pair on evict
   */
  onEvict: lambda(val: V, key: K)

  /**
   * Returns a cache histogram showing memory usage by cache.
   *
   * Collects stats from all registered caches (Cache_Impl, SimpleCache, SimpleSingletonCache)
   * and Java static fields that act as caches (Maps, Arrays, Guava caches, etc.).
   *
   * @param spec optional {@link Cache.Histo.Spec} to control output
   * @return cache histogram with entries
   *
   * @see Cache.Histo
   * @see Cache.Histo.Spec
   * @see Cache.Histo.Entry
   */
  @action(group+='monitor')
  histo: function(spec: Cache.Histo.Spec): !Cache.Histo

  /**
   * List caches. By default only non-empty caches are returned, see {@link CacheListSpec}.
   *
   * @param spec
   *           Optional {@link CacheListSpec} argument.
   * @return
   *        Array of {@link Cache}
   */
  @action(group+='monitor')
  list: function(spec: CacheListSpec): [Cache]

  /**
   * List cache entries. By default only non-null values are returned, see {@link CacheListSpec}.
   *
   * @param name
   *           Cache name.
   * @param spec
   *           Optional {@link CacheListSpec} argument.
   * @return
   *        Array of {@link CacheEntry}
   */
  @action(group+='cluster-admin')
  entries: function(name: !string, spec: CacheListSpec): [CacheEntry]

  /**
   * Empty cache.
   *
   * @param name
   *           Cache name.
   * @param allEntries
   *           If the Cache is Tag Aware and this parameter is TRUE, the cache will be emptied completely.
   *           If FALSE (default) it will only evict the entries for the current tenant and tag.
   * @return
   *        Status message.
   */
  @action(group+='cluster-admin')
  empty: function(name: !string, allEntries: boolean, message: CacheMessage): string

  /**
   * Empty all caches. It will empty all the entries in every cache including Tag Aware caches.
   */
  @action(group+='cluster-admin')
  emptyAll: function(message: CacheMessage)

  /**
   * Empty cache on the node where the action is executed.
   *
   * @param name
   *           Cache name.
   *  @param allEntries
   *           If the Cache is Tag Aware and this parameter is TRUE, the cache will be emptied completely.
   *           If FALSE (default) it will only evict the entries for the current tenant and tag.
   * @return
   *        Status message.
   */
  @action(group+='cluster-admin')
  emptyLocalOnly: function(name: !string, allEntries: boolean): string

  /**
   * Empty all caches on the node where the action is executed. It will empty all the entries in every cache including Tag Aware caches.
   */
  @action(group+='cluster-admin')
  emptyAllLocalOnly: function()

  /**
   * Disable the given cache.
   *
   * @param name
   *           Cache name.
   * @return
   *        Status message.
   */
  @action(group+='cluster-admin')
  disable: function(name: !string): string

  /**
   * Enable the given cache.
   *
   * @param name
   *           Cache name.
   * @return
   *        Status message.
   */
  @action(group+='cluster-admin')
  enable: function(name: !string): string

  /**
   * Number of hits for the given cache
   *
   * @param name
   *           Cache name.
   * @return
   *        Number of hits.
   */
  @action(group+='cluster-admin')
  hitCount: function(name: !string): int

  /**
   * Number of accesses for the given cache
   *
   * @param name
   *           Cache name.
   * @return
   *        Number of accesses.
   */
  @action(group+='cluster-admin')
  accessCount: function(name: !string): int

  /**
   * Cache hit ratio.
   *
   * @param name
   *           Cache name.
   * @return
   *        Ratio.
   */
  @action(group+='cluster-admin')
  hitRatio: function(name: !string): double

  @action(group+='cluster-admin')
  hit: function(name: string, key: string, tag: string): map<string, string>

  /**
   * Update max number of entries allowed for Cache with given name.
   */
  @action(group+='cluster-admin')
  setMaxSize: function(name: !string, size: !int)

  /**
   * @return the max size of the cache
   */
  maxSize: member function(): int

  @action(group+='cluster-admin')
  @deprecated(finalVersion='8.5', details='User clear or evict to invalidate cache entries')
  spec: function(typeName: !string): [string]

  // TODO: PLAT-26294 refactor to Cache/Cached.c3typ
  get: member function(key: !K): V

  get:            member function(key: !K, supplier: lambda(): V): V
  put:            member function(key: !K, value: !V)
  putAll:         member function(keyValues: !map<K, V>)
  containsKey:    member function(key: !K): boolean
  evict:          member function(key: !K, message: CacheMessage): V
  evictLocalOnly: member function(key: !K): V

  /**
   * Evicts any entry whose key matches the supplied regex and also sends remote request
   *
   * @param regex
   * @return true if any entry was evicted
   */
  evictKeyMatch: member function(regex: !string, message: CacheMessage): boolean

  /**
   * Evicts any entry whose key matches the supplied regex in local cache
   *
   * @param regex
   * @return true if any entry was evicted
   */
  evictKeyMatchLocalOnly: member function(regex: !string): boolean

  clear:          member function(message: CacheMessage)
  clearLocalOnly: member function()
  keys:           member function(regex: string): [K]
  values:         member function(): [V]
  isAppAware:     member function(): boolean

  // TODO: PLAT-26728 Implement Cache invalidation APIs
  invalidating: member function(name: string): Cache

  types:    member function(invalidatingTypes: [Type]): Cache
  changes:  member function(dataTypes: [string enum Cache.DataChangeType]): Cache
  keySpec:  member function(regex: string): Cache
  priority: member function(value: int32): Cache
}
