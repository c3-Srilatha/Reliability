/**
 * Config used to determine what broadcast level messages will be sent. {@link CacheMessage#Level}
 */
@action(group+='app-admin')
type CacheBroadcastConfig mixes Config {

  /**
   * Type of broadcast to use.
   *    If set to 'http', will use http connections to broadcast messages.
   *    If set to 'db', will use {@link CacheQueue}
   */
  kind: string enum CacheBroadcastKind = CacheBroadcastKind.HTTP

  /**
   * If true, remote cache invalidation is turned on for app level {@link CacheMessage#Level}
   */
  app: boolean = true

  /**
   * If true, remote cache invalidation is turned on for env level {@link CacheMessage#Level}
   */
  env: boolean = true

  /**
   * If true, remote cache invalidation is turned on for cluster level {@link CacheMessage#Level}
   */
  cluster: boolean

  /**
   * Sets the broadcastLevel flag to false and broadcasts to all nodes at the broadcastLevel to evict the CacheBroadcastConfig.
   *
   * @param broadcastLevel
   *        The level of cache broadcast that you want to be disable {@link Cache.Invalidator.Level}
   * @param override
   *        The override that you want to be disabled across the cluster {@link ConfigOverride}
   */
  disable: function(broadcastLevel: string enum Cache.Invalidator.Level = APP,
                    override: string enum ConfigOverride = APP)

  /**
   * Sets the broadcastLevel flag to true and broadcasts to all nodes at the broadcastLevel to evict the CacheBroadcastConfig.
   *
   * @param broadcastLevel
   *        The level of cache broadcast that you want to be enabled {@link Cache.Invalidator.Level}
   * @param override
   *        The override that you want to be disabled across the cluster {@link ConfigOverride}
   */
  enable: function(broadcastLevel: string enum Cache.Invalidator.Level = APP,
                   override: string enum ConfigOverride = APP)

  /**
   * Resets the CacheBroadcastConfig to its default state. Broadcasting will be determined via higher overrides.
   * This clears the config and broadcasts to all nodes in the Cluster to evict the CacheBroadcastConfig.
   */
  reset: function(override: !string enum ConfigOverride = APP)

  /**
   * Sets the broadcastKind that will be used to broadcast messages.
   *
   * @param kind
   *        The kind of broadcast that you want to be set {@link CacheBroadcastKind}
   */
  setKind: function(kind: !string enum CacheBroadcastKind, override: !string enum ConfigOverride)

  // ================================== Deprecated ==================================

  /**
   * If true, remote cache invalidation is not turned on. If false, will default to http unless specified otherwise.
   */
  @deprecated(finalVersion=8.9, details='Ignored. Has no effect. Use app, env, or cluster instead')
  disabled: boolean = true

  /**
   * If true, performs cache invalidation through {@link CacheQueue}
   */
  @deprecated(finalVersion=8.9, details='Ignored. Has no effect. Use broadcastKind instead')
  db: boolean

  /**
   * If true, performs cache invalidation solely through http connections
   */
  @deprecated(finalVersion=8.9, details='Ignored. Has no effect. Use broadcastKind instead')
  http: boolean
}
