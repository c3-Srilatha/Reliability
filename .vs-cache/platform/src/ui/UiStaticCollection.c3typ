/**
 * This {@link UiCollection collection} implementation supports any Obj type, but does not provide support for saving.
 *
 * @see UiStaticModel
 * @see UiPersistablCollection
 */
type UiStaticCollection mixes UiCollection {

  /**
   * For a static collection, the total count is the same as the loaded size.
   *
   * @see #loadedSize
   */
  totalCount: ~ js-client
}
