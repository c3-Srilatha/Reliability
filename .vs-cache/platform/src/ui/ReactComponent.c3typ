/**
 * Every UI component implemented with React is represented by a type that ultimately mixes in this type.
 *
 * In addition to being a marker type, it is responsible for producing a complete TSX file for use with the client.
 * This extra step allows us to keep the component itself DRY: fields declared on the type are automatically part of
 * its "props" without the need to declare a separate TypeScript type/interface and keep it in sync.
 *
 * Data fields on the concrete component types (and its mixins) become available as the "props" of the component when
 * instantiated/rendered. Thus components should declare their props as part of their types. Primitive, collection and
 * reference types are all supported, but its best for the props to be relatively simple types, directly representable
 * in TypeScript.
 */
abstract type ReactComponent {

  /**
   * Produce the complete TSX file, including the declaration of the interface for the "props" based on the data
   * fields defined on the component type. This interface is always named with the type name plus "Props" and appended
   * to the existing source file.
   */
  tsx: inline function(): string

  /**
   * Produce the "props" interface for an arbitrary type. This will produce a TypeScript interface declaration that
   * includes all the data fields of the specified type, and the public data fields of types it mixes in. The details
   * can be controlled through the spec argument, but the defaults are what gets used by #tsx.
   *
   * @param type the type to examine
   * @param spec options for interface generation
   * @return TypeScript interface declaration
   */
  buildProps: private function(type: !Type, spec: ReactComponentPropsSpec): string

  /**
   * The React component's tsx file path from root folder "/ui". i.e 'common/UiImg.tsx'
   */
  tsxPath: private function(): string js-client

  /**
   * If it has been imported, returns the imported module to render the UiComponent - the module at the tsxPath()
   */
  importedModule: private function(): native js-client
}
