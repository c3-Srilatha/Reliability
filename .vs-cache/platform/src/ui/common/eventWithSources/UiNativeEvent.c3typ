/**
 * An EventWithSource that wraps a native event from a UiComponent or one of its nested types.
 */
// TODO: PLAT-24890 UiNativeEvent parametric should not be `any`
abstract type UiNativeEvent<E: any, S: EventSource> mixes EventWithSource<S> {

  /**
   * The native event from the EventSource
   */
  event: native

  /**
   * Any extra arguments from the native event handler
   */
  extraArgs: [any]
}
