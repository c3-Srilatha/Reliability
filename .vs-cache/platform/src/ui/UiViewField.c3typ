/**
 * A "view field" is the declaration of an expression based on the source type of a view and its presentation for a
 * user interface.
 *
 * @see UiView
 * @see TypeDefaultUiField
 */
type UiViewField mixes Nameable {

  /**
   * The type for the {@link UiView} which this UiViewField is part of.
   */
  sourceType: !Type

  /**
   * The expression by which the value of the field is retrieved. If unspecified, #name must correspond to a field in
   * the source type.
   */
  value: string serialized Expr

  /**
   * The label for this field. If not specified, it will generated as a cleaned-up version of the field name.
   */
  label: string

  /**
   * If the fields should be presented in distinct groups, they can be organized into groups by name.
   */
  group: string

  /**
   * Value type dependent format string for presentation.
   */
  format: string

  /**
   * The short description of this field, typically used as a tool tip.
   */
  description: string

  /**
   * Whether this field should disallow editing (regardless of other permissions).
   */
  readOnly: boolean

  /**
   * Get the type of the value of this field. This is the value type of the final part of the #value expression.
   */
  valueType: inline member function(): ValueType js-client

  /**
   * Get the expression used to access the field from the type on which the parent view is based. If the #value
   * expression is specified, that is used. Otherwise, the #name is assumed to match a field of the type.
   */
  expression: inline member function(): string js-client | java

  /**
   * The name of the field is the key by which it is accessed.
   */
  name: !~
}
