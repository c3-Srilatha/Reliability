/**
 * Make a plot with log scaling on the y axis.
 *
 * # Example: Exponential Y Values
 * ```JavaScript
 * var N = 50,
 *     x = C3.Array.patternOfInt(N, n => n),
 *     y = C3.Array.patternOfDbl(N, n => 1 + Math.random() * 1000000);
 * PlotAxes.make()
 *         .semiLogY({
 *           x: x,
 *           y: y
 *         }).show();
 * ```
 *
 * @see PlotAxes
 * @see https://matplotlib.org/api/_as_gen/matplotlib.axes.Axes.semilogy.html
 */
type PlotSemiLogYSpec mixes PlotPlotSpec {

  /**
   * Base of the y logarithm.
   * (matplotlib basey)
   *
   * Python: scalar
   */
  baseY: double = 10

  /**
   * The location of the minor yticks. If None, reasonable locations are automatically chosen depending on the number of decades in the plot. See Axes.set_yscale for details.
   * (matplotlib subsy)
   *
   * Python: array_like
   */
  subsY: [any]

  /**
   * Non-positive values in y can be masked as invalid, or clipped to a very small positive number.
   * (matplotlib nonposy)
   *
   * Python: {'mask', 'clip'}
   */
  nonPosY: string enum('mask', 'clip') = 'mask'
}
