/**
 * Plot the coherence between x and y.
 *
 * @see PlotAxes
 * @see https://matplotlib.org/api/_as_gen/matplotlib.axes.Axes.cohere.html
 */
type PlotCohereSpec mixes PlotElementSpec {

  x: any
  y: any

  /**
   * The number of data points used in each block for the FFT. A power 2 is most efficient. The default value is 256. This should NOT be used to get zero padding, or the scaling of the result will be incorrect. Use pad_to for this instead.
   */
  NFFT: int = 256

  /**
   * The sampling frequency (samples per time unit). It is used to calculate the Fourier frequencies, freqs, in cycles per time unit. The default value is 2.
   *
   * Python: scalar
   */
  Fs: any = 2

  /**
   * The center frequency of x (defaults to 0), which offsets the x extents of the plot to reflect the frequency range used when a signal is acquired and then filtered and downsampled to baseband.
   */
  Fc: int = 0

  /**
   * The function applied to each segment before fft-ing, designed to remove the mean or linear trend. Unlike in MATLAB, where the detrend parameter is a vector, in matplotlib is it a function. The pylab module defines detrend_none(), detrend_mean(), and detrend_linear(), but you can use a custom function as well. You can also use a string to choose one of the functions. 'default', 'constant', and 'mean' call detrend_mean(). 'linear' calls detrend_linear(). 'none' calls detrend_none().
   * (matplotlib detrend)
   *
   * Python: {'default', 'constant', 'mean', 'linear', 'none'} or callable
   *
   * enum('default', 'constant', 'mean', 'linear', 'none')
   */
  detrEnd: string | (lambda(): any)

  /**
   * A function or a vector of length NFFT. To create window vectors see window_hanning(), window_none(), numpy.blackman(), numpy.hamming(), numpy.bartlett(), scipy.signal(), scipy.signal.get_window(), etc. The default is window_hanning(). If a function is passed as the argument, it must take a data segment as an argument and return the windowed version of the segment.
   *
   * Python: callable or ndarray
   */
  window: (lambda(): any) | [any]

  /**
   * The number of points of overlap between blocks. The default value is 0 (no overlap).
   * (matplotlib noverlap)
   */
  nOverlap: int = 0

  /**
   * The number of points to which the data segment is padded when performing the FFT. This can be different from NFFT, which specifies the number of data points used. While not increasing the actual resolution of the spectrum (the minimum distance between resolvable peaks), this can give more points in the plot, allowing for more detail. This corresponds to the n parameter in the call to fft(). The default is None, which sets pad_to equal to NFFT
   * (matplotlib pad_to)
   */
  padTo: int

  /**
   * Specifies which sides of the spectrum to return. Default gives the default behavior, which returns one-sided for real data and both for complex data. 'onesided' forces the return of a one-sided spectrum, while 'twosided' forces two-sided.
   *
   * Python: [ 'default' | 'onesided' | 'twosided' ]
   */
  sides: string enum('default', 'onesided', 'twosided') = 'default'

  /**
   * Specifies whether the resulting density values should be scaled by the scaling frequency, which gives density in units of Hz^-1. This allows for integration over the returned frequency values. The default is True for MATLAB compatibility.
   * (matplotlib scale_by_freq)
   */
  scaleBYFreq: boolean

  data: any

  /**
   * a filter function, which takes a (m, n, 3) float array and a dpi value, and returns a (m, n, 3) array
   * (matplotlib agg_filter)
   */
  aggFilter: [any]

  /**
   * float (0.0 transparent through 1.0 opaque)
   */
  alpha: double

  /**
   * bool
   */
  animated: boolean

  /**
   * bool
   */
  antialiased: boolean

  /**
   * a Bbox instance
   * (matplotlib clip_box)
   *
   * Python: Bbox
   */
  clipBox: any

  /**
   * bool
   * (matplotlib clip_on)
   */
  clipOn: boolean

  /**
   * [(Path, Transform) | Patch | None]
   * (matplotlib clip_path)
   */
  clipPath: any

  /**
   * any matplotlib color
   */
  color: string

  /**
   * a callable function
   */
  contains: lambda(): any

  /**
   * ['butt' | 'round' | 'projecting']
   * (matplotlib dash_capstyle)
   */
  dashCapStyle: string enum('butt', 'round', 'projecting')

  /**
   * ['miter' | 'round' | 'bevel']
   * (matplotlib dash_joinstyle)
   */
  dashJoinStyle: string enum('miter', 'round', 'bevel')

  /**
   * sequence of on/off ink in points
   */
  dashes: [any]

  /**
   * ['default' | 'steps' | 'steps-pre' | 'steps-mid' | 'steps-post']
   * (matplotlib drawstyle)
   */
  drawStyle: string enum('default', 'steps', 'steps-pre', 'steps-mid', 'steps-post')

  /**
   * a Figure instance
   *
   * Python: Figure
   */
  figure: any

  /**
   * ['full' | 'left' | 'right' | 'bottom' | 'top' | 'none']
   * (matplotlib fillstyle)
   */
  fillStyle: string enum('full', 'left', 'right', 'bottom', 'top', 'none')

  /**
   * an id string
   */
  gid: string

  /**
   * object
   */
  label: any

  /**
   * ['solid' | 'dashed', 'dashdot', 'dotted' | (offset, on-off-dash-seq) | '-' | '--' | '-.' | ':' | 'None' | ' ' | '']
   * (matplotlib linestyle)
   */
  lineStyle: any

  /**
   * float value in points
   * (matplotlib linewidth)
   */
  lineWidth: double

  /**
   * A valid marker style
   */
  marker: any

  /**
   * any matplotlib color
   * (matplotlib markeredgecolor)
   */
  markerEdgeColor: string

  /**
   * float value in points
   * (matplotlib markeredgewidth)
   */
  markerEdgeWidth: double

  /**
   * any matplotlib color
   * (matplotlib markerfacecolor)
   */
  markerFaceColor: string

  /**
   * any matplotlib color
   * (matplotlib markerfacecoloralt)
   */
  markerFaceColorAlt: string

  /**
   * float
   * (matplotlib markersize)
   */
  markerSize: double

  /**
   * [None | int | length-2 tuple of int | slice | list/array of int | float | length-2 tuple of float]
   * (matplotlib markevery)
   */
  markEvery: [int]

  /**
   * AbstractPathEffect
   * (matplotlib path_effects)
   */
  pathEffects: any

  /**
   * float distance in points or callable pick function fn(artist, event)
   */
  picker: double | (lambda(): any)

  /**
   * float distance in points
   * (matplotlib pickradius)
   */
  pickRadius: double

  /**
   * bool or None
   */
  rasterized: boolean

  /**
   * (scale: float, length: float, randomness: float)
   * (matplotlib sketch_params)
   */
  sketchParams: any

  /**
   * bool or None
   */
  snap: boolean

  /**
   * ['butt' | 'round' | 'projecting']
   * (matplotlib solid_capstyle)
   */
  solidCapStyle: string enum('butt', 'round', 'projecting')

  /**
   * ['miter' | 'round' | 'bevel']
   * (matplotlib solid_joinstyle)
   */
  solidJoinStyle: string enum('miter', 'round', 'bevel')

  /**
   * a matplotlib.transforms.Transform instance
   *
   * Python: Transform
   */
  transform: any

  /**
   * a url string
   */
  url: string

  /**
   * bool
   */
  visible: boolean

  /**
   * 1D array
   * (matplotlib xdata)
   */
  xData: [any]

  /**
   * 1D array
   * (matplotlib ydata)
   */
  yData: [any]

  /**
   * float
   * (matplotlib zorder)
   */
  zOrder: double
}
