/**
 * Helper to allow PlotFigure#subPlot to return an object which can be used as a axes builder.
 *
 * @see PlotFigure
 * @see PlotAxes
 */
type PlotSubPlot mixes PlotAxes {

  /**
   * Once all elements are added, call done to return the augmented figure.
   */
  done: member function(): !PlotFigure js

  /**
   * Parent figure on which PlotFigure#subPlot was called.
   */
  figure: private PlotFigure
}
