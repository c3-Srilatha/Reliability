/**
 * Plot vertical lines.
 *
 * # Example: Constant Y Range
 * ```JavaScript
 * PlotAxes.make().vLines({
 *   x: C3.Array.patternOfInt(10, n => n + 1),
 *   yMin: 10,
 *   yMax: 90
 * }).show();
 * ```
 *
 * # Example: Variable Y Range
 * ```JavaScript
 * var N = 10;
 * PlotAxes.make().vLines({
 *   x: C3.Array.patternOfInt(N, n => n + 1),
 *   yMin: C3.Array.patternOfDbl(N, n => 1 + Math.random() * 10),
 *   yMax: C3.Array.patternOfDbl(N, n => 41 + Math.random() * 10),
 * }).show();
 * ```
 *
 * @see PlotAxes
 * @see https://matplotlib.org/api/_as_gen/matplotlib.axes.Axes.vlines.html
 */
type PlotVLinesSpec mixes PlotElementSpec {

  /**
   * x-indexes where to plot the lines.
   *
   * Python: scalar or 1D array_like
   */
  x: any

  /**
   * Respective beginning and end of each line. If scalars are provided, all lines will have same length.
   * (matplotlib ymin)
   *
   * Python: scalar or 1D array_like
   */
  yMin: any

  /**
   * Respective beginning and end of each line. If scalars are provided, all lines will have same length.
   * (matplotlib ymax)
   *
   * Python: scalar or 1D array_like
   */
  yMax: any

  /**
   * Python: array_like of colors
   */
  colors: [string] = 'k'

  /**
   * (matplotlib linestyles)
   *
   * Python: ['solid' | 'dashed' | 'dashdot' | 'dotted']
   */
  lineStyles: string enum('solid', 'dashed', 'dashdot', 'dotted') = 'solid'

  label: ?string
  data:  any
}
