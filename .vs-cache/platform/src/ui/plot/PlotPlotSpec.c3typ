/**
 * Plot y versus x as lines and/or markers.
 *
 * # Example: Single Line Plot
 * ```JavaScript
 * var last, y;
 * y = C3.Array.patternOfDbl(100, function(n) {
 *   var s;
 *   if (n == 0)
 *     last = 10 + Math.random() * 50;
 *   else {
 *     s = last / 20;
 *     last += s * Math.random() - s * 0.5;
 *   }
 *   return last;
 * });
 * PlotAxes.make({
 *   title: 'XYZY'
 * }).plot({ y: y })
 *   .show();
 * ```
 *
 * # Example: Multiple Lines with Legend
 * ```JavaScript
 * var N = 10,
 *     x = C3.Array.patternOfInt(N, n => n + 1);
 * PlotAxes.make({
 *   title: 'Growth',
 *   legend: {
 *     loc: 'upper left',
 *     fontSize: 'small'
 *   },
 * }).plot({ x: x, y: C3.Array.patternOfInt(N, n => 1), label: 'O(1)', color: 'blue' })
 *   .plot({ x: x, y: C3.Array.patternOfInt(N, n => n + 1), label: 'O(n)', color: 'green' })
 *   .plot({ x: x, y: C3.Array.patternOfDbl(N, n => (n + 1) * Math.log(n + 1)), label: 'O(n log n)', color: 'orange' })
 *   .plot({ x: x, y: C3.Array.patternOfInt(N, n => (n + 1) * (n + 1)), label: 'O(n²)', color: 'red' })
 *   .show();
 * ```
 *
 * @see PlotAxes
 * @see https://matplotlib.org/api/_as_gen/matplotlib.axes.Axes.plot.html
 */
type PlotPlotSpec mixes PlotElementSpec {

  /**
   * The horizontal / vertical coordinates of the data points. x values are optional. If not given, they default to [0, ..., N-1].
   *
   * Python: array-like or scalar
   */
  x: any

  /**
   * The horizontal / vertical coordinates of the data points. x values are optional. If not given, they default to [0, ..., N-1].
   *
   * Python: array-like or scalar
   */
  y: any

  /**
   * A format string, e.g. 'ro' for red circles. See the Notes section for a full description of the format strings.
   */
  fmt: string

  /**
   * An object with labelled data. If given, provide the label names to plot in x and y.
   *
   * Python: indexable object
   */
  data: json

  /**
   * These parameters determined if the view limits are adapted to the data limits. The values are passed on to autoscale_view.
   * (matplotlib scalex)
   */
  scaleX: boolean = true

  /**
   * These parameters determined if the view limits are adapted to the data limits. The values are passed on to autoscale_view.
   * (matplotlib scaley)
   */
  scaleY: boolean = true

  /**
   * a filter function, which takes a (m, n, 3) float array and a dpi value, and returns a (m, n, 3) array
   * (matplotlib agg_filter)
   */
  aggFilter: [any]

  /**
   * float (0.0 transparent through 1.0 opaque)
   */
  alpha: double

  /**
   * bool
   */
  animated: boolean

  /**
   * bool
   */
  antialiased: boolean

  /**
   * a Bbox instance
   * (matplotlib clip_box)
   *
   * Python: Bbox
   */
  clipBox: any

  /**
   * bool
   * (matplotlib clip_on)
   */
  clipOn: boolean

  /**
   * [(Path, Transform) | Patch | None]
   * (matplotlib clip_path)
   */
  clipPath: any

  /**
   * any matplotlib color
   */
  color: string

  /**
   * a callable function
   */
  contains: lambda(): any

  /**
   * ['butt' | 'round' | 'projecting']
   * (matplotlib dash_capstyle)
   */
  dashCapStyle: string enum('butt', 'round', 'projecting')

  /**
   * ['miter' | 'round' | 'bevel']
   * (matplotlib dash_joinstyle)
   */
  dashJoinStyle: string enum('miter', 'round', 'bevel')

  /**
   * sequence of on/off ink in points
   */
  dashes: [any]

  /**
   * ['default' | 'steps' | 'steps-pre' | 'steps-mid' | 'steps-post']
   * (matplotlib drawstyle)
   */
  drawStyle: string enum('default', 'steps', 'steps-pre', 'steps-mid', 'steps-post')

  /**
   * a Figure instance
   *
   * Python: Figure
   */
  figure: any

  /**
   * ['full' | 'left' | 'right' | 'bottom' | 'top' | 'none']
   * (matplotlib fillstyle)
   */
  fillStyle: string enum('full', 'left', 'right', 'bottom', 'top', 'none')

  /**
   * an id string
   */
  gid: string

  /**
   * object
   */
  label: any

  /**
   * ['solid' | 'dashed', 'dashdot', 'dotted' | (offset, on-off-dash-seq) | '-' | '--' | '-.' | ':' | 'None' | ' ' | '']
   * (matplotlib linestyle)
   */
  lineStyle: any

  /**
   * float value in points
   * (matplotlib linewidth)
   */
  lineWidth: double

  /**
   * A valid marker style
   */
  marker: any

  /**
   * any matplotlib color
   * (matplotlib markeredgecolor)
   */
  markerEdgeColor: string

  /**
   * float value in points
   * (matplotlib markeredgewidth)
   */
  markerEdgeWidth: double

  /**
   * any matplotlib color
   * (matplotlib markerfacecolor)
   */
  markerFaceColor: string

  /**
   * any matplotlib color
   * (matplotlib markerfacecoloralt)
   */
  markerFaceColorAlt: string

  /**
   * float
   * (matplotlib markersize)
   */
  markerSize: double

  /**
   * [None | int | length-2 tuple of int | slice | list/array of int | float | length-2 tuple of float]
   * (matplotlib markevery)
   */
  markEvery: [int]

  /**
   * AbstractPathEffect
   * (matplotlib path_effects)
   */
  pathEffects: any

  /**
   * float distance in points or callable pick function fn(artist, event)
   */
  picker: double | (lambda(): any)

  /**
   * float distance in points
   * (matplotlib pickradius)
   */
  pickRadius: double

  /**
   * bool or None
   */
  rasterized: boolean

  /**
   * (scale: float, length: float, randomness: float)
   * (matplotlib sketch_params)
   */
  sketchParams: any

  /**
   * bool or None
   */
  snap: boolean

  /**
   * ['butt' | 'round' | 'projecting']
   * (matplotlib solid_capstyle)
   */
  solidCapStyle: string enum('butt', 'round', 'projecting')

  /**
   * ['miter' | 'round' | 'bevel']
   * (matplotlib solid_joinstyle)
   */
  solidJoinStyle: string enum('miter', 'round', 'bevel')

  /**
   * a matplotlib.transforms.Transform instance
   *
   * Python: Transform
   */
  transform: any

  /**
   * a url string
   */
  url: string

  /**
   * bool
   */
  visible: boolean

  /**
   * 1D array
   * (matplotlib xdata)
   */
  xData: [any]

  /**
   * 1D array
   * (matplotlib ydata)
   */
  yData: [any]

  /**
   * float
   * (matplotlib zorder)
   */
  zOrder: double
}
