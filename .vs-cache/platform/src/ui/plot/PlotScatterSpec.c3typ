/**
 * A scatter plot of y vs x with varying marker size and/or color.
 *
 * # Example: Circular Pattern
 * ```JavaScript
 * var N = 100,
 *     Z = 10,
 *     x = [], y = [], colors = [],
 *     sizes, i, a, r;
 * sizes = C3.Array.patternOfDbl(N, n => 10 + Math.random() * 20);
 * for (i = 0; i < N; i++) {
 *   a = Math.random() * 2 * Math.PI;
 *   r = Math.log(Math.random() * Z);
 *   if (r < 0)
 *     r = Math.random();
 *   x[i] = Z + Math.cos(a) * r;
 *   y[i] = Z + Math.sin(a) * r;
 *   if (r < 0.3 * Math.log(Z))
 *     colors[i] = 'red';
 *   else if (r < 0.6 * Math.log(Z))
 *     colors[i] = 'orange';
 *   else if (r < 0.9 * Math.log(Z))
 *     colors[i] = 'green';
 *   else
 *     colors[i] = 'blue';
 * }
 * PlotAxes.make({
 *   axis: 'equal'
 * }).scatter({
 *   x: x, y: y,
 *   s: sizes,
 *   c: colors,
 *   alpha: 0.5
 * }).show();
 * ```
 *
 * @see PlotAxes
 * @see https://matplotlib.org/api/_as_gen/matplotlib.axes.Axes.scatter.html
 */
type PlotScatterSpec mixes PlotElementSpec {

  /**
   * The data positions.
   *
   * Python: array_like, shape (n, )
   */
  x: [any]

  /**
   * The data positions.
   *
   * Python: array_like, shape (n, )
   */
  y: [any]

  /**
   * The marker size in points**2. Default is rcParams['lines.markersize'] ** 2.
   *
   * Python: scalar or array_like, shape (n, )
   */
  s: any

  /**
   * The marker color. Possible values:
   *
   * Python: color, sequence, or sequence of color
   */
  c: string | [string] = 'b'

  /**
   * The marker style. marker can be either an instance of the class or the text shorthand for a particular marker. See markers for more information marker styles.
   *
   * Python: MarkerStyle
   */
  marker: string = 'o'

  /**
   * A Colormap instance or registered colormap name. cmap is only used if c is an array of floats. If None, defaults to rc image.cmap.
   *
   * Python: Colormap
   */
  cmap: string

  /**
   * A Normalize instance is used to scale luminance data to 0, 1. norm is only used if c is an array of floats. If None, use the default colors.Normalize.
   *
   * Python: Normalize
   */
  norm: any

  /**
   * vmin and vmax are used in conjunction with norm to normalize luminance data. If None, the respective min and max of the color array is used. vmin and vmax are ignored if you pass a norm instance.
   * (matplotlib vmin)
   *
   * Python: scalar
   */
  vMin: any

  /**
   * vmin and vmax are used in conjunction with norm to normalize luminance data. If None, the respective min and max of the color array is used. vmin and vmax are ignored if you pass a norm instance.
   * (matplotlib vmax)
   *
   * Python: scalar
   */
  vMax: any

  /**
   * The alpha blending value, between 0 (transparent) and 1 (opaque).
   *
   * Python: scalar
   */
  alpha: any

  /**
   * The linewidth of the marker edges. Note: The default edgecolors is 'face'. You may want to change this as well. If None, defaults to rcParams lines.linewidth.
   * (matplotlib linewidths)
   *
   * Python: scalar or array_like
   */
  lineWidths: any

  /**
   * If marker is None, these vertices will be used to construct the marker. The center of the marker is located at (0, 0) in normalized units. The overall marker is rescaled by s.
   *
   * Python: sequence of (x, y)
   */
  verts: [[any]]

  /**
   * The edge color of the marker. Possible values:
   * (matplotlib edgecolors)
   *
   * Python: color or sequence of color
   */
  edgeColors: string | [string] = 'face'

  data: any
}
