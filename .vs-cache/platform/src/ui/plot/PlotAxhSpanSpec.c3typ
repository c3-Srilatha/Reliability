/**
 * Add a horizontal span (rectangle) across the axis.
 *
 * @see PlotAxes
 * @see https://matplotlib.org/api/_as_gen/matplotlib.axes.Axes.axhspan.html
 */
type PlotAxhSpanSpec mixes PlotElementSpec {

  /**
   * Lower limit of the horizontal span in data units.
   * (matplotlib ymin)
   */
  yMin: double

  /**
   * Upper limit of the horizontal span in data units.
   * (matplotlib ymax)
   */
  yMax: double

  /**
   * Lower limit of the vertical span in axes (relative 0-1) units.
   * (matplotlib xmin)
   */
  xMin: double = 0

  /**
   * Upper limit of the vertical span in axes (relative 0-1) units.
   * (matplotlib xmax)
   */
  xMax: double = 1

  /**
   * a filter function, which takes a (m, n, 3) float array and a dpi value, and returns a (m, n, 3) array
   * (matplotlib agg_filter)
   */
  aggFilter: [any]

  /**
   * float or None
   */
  alpha: double

  /**
   * bool
   */
  animated: boolean

  /**
   * bool or None
   */
  antialiased: boolean

  /**
   * ['butt' | 'round' | 'projecting']
   * (matplotlib capstyle)
   */
  capStyle: string enum('butt', 'round', 'projecting')

  /**
   * a Bbox instance
   * (matplotlib clip_box)
   *
   * Python: Bbox
   */
  clipBox: any

  /**
   * bool
   * (matplotlib clip_on)
   */
  clipOn: boolean

  /**
   * [(Path, Transform) | Patch | None]
   * (matplotlib clip_path)
   */
  clipPath: any

  /**
   * matplotlib color spec
   */
  color: string

  /**
   * a callable function
   */
  contains: lambda(): any

  /**
   * mpl color spec, None, 'none', or 'auto'
   * (matplotlib edgecolor)
   */
  edgeColor: any

  /**
   * mpl color spec, or None for default, or 'none' for no color
   * (matplotlib facecolor)
   */
  faceColor: any

  /**
   * a Figure instance
   *
   * Python: Figure
   */
  figure: any

  /**
   * bool
   */
  fill: boolean

  /**
   * an id string
   */
  gid: string

  /**
   * ['/' | '\' | '|' | '-' | '+' | 'x' | 'o' | 'O' | '.' | '*']
   */
  hatch: string enum('/', '\\', '|', '-', '+', 'x', 'o', 'O', '.', '*')

  /**
   * ['miter' | 'round' | 'bevel']
   * (matplotlib joinstyle)
   */
  joinStyle: string enum('miter', 'round', 'bevel')

  /**
   * object
   */
  label: any

  /**
   * ['solid' | 'dashed', 'dashdot', 'dotted' | (offset, on-off-dash-seq) | '-' | '--' | '-.' | ':' | 'None' | ' ' | '']
   * (matplotlib linestyle)
   */
  lineStyle: any

  /**
   * float or None for default
   * (matplotlib linewidth)
   */
  lineWidth: double

  /**
   * AbstractPathEffect
   * (matplotlib path_effects)
   */
  pathEffects: any

  /**
   * [None | bool | float | callable]
   */
  picker: any

  /**
   * bool or None
   */
  rasterized: boolean

  /**
   * (scale: float, length: float, randomness: float)
   * (matplotlib sketch_params)
   */
  sketchParams: any

  /**
   * bool or None
   */
  snap: boolean

  /**
   * Transform
   */
  transform: any

  /**
   * a url string
   */
  url: string

  /**
   * bool
   */
  visible: boolean

  /**
   * float
   * (matplotlib zorder)
   */
  zOrder: double
}
