/**
 * Create a pseudocolor plot with a non-regular rectangular grid.
 *
 * @see PlotAxes
 * @see https://matplotlib.org/api/_as_gen/matplotlib.axes.Axes.pcolor.html
 */
type PlotPColorSpec mixes PlotElementSpec {

  /**
   * A scalar 2-D array. The values will be color-mapped.
   *
   * Python: array_like
   */
  C: [any]

  /**
   * The coordinates of the quadrilateral corners. The quadrilateral for C[i,j] has corners at:
   *
   * Python: array_like
   */
  X: [any]

  /**
   * The coordinates of the quadrilateral corners. The quadrilateral for C[i,j] has corners at:
   *
   * Python: array_like
   */
  Y: [any]

  data: any

  /**
   * The default antialiaseds is False if the default edgecolors="none" is used. This eliminates artificial lines at patch boundaries, and works regardless of the value of alpha. If edgecolors is not "none", then the default antialiaseds is taken from rcParams["patch.antialiased"], which defaults to True. Stroking the edges may be preferred if alpha is 1, but will cause artifacts otherwise.
   * (matplotlib antialiaseds)
   */
  antialiasedS: boolean = false

  /**
   * a filter function, which takes a (m, n, 3) float array and a dpi value, and returns a (m, n, 3) array
   * (matplotlib agg_filter)
   */
  aggFilter: [any]

  /**
   * bool
   */
  animated: boolean

  /**
   * Boolean or sequence of booleans
   */
  antialiased: boolean | [boolean]

  /**
   * ndarray
   */
  ndarray: [any]

  /**
   * unknown
   * (matplotlib capstyle)
   */
  capStyle: any

  /**
   * a length 2 sequence of floats; may be overridden in methods that have vmin and vmax kwargs.
   * (matplotlib clim)
   */
  cLim: [double]

  /**
   * a Bbox instance
   * (matplotlib clip_box)
   *
   * Python: Bbox
   */
  clipBox: any

  /**
   * bool
   * (matplotlib clip_on)
   */
  clipOn: boolean

  /**
   * [(Path, Transform) | Patch | None]
   * (matplotlib clip_path)
   */
  clipPath: any

  /**
   * matplotlib color arg or sequence of rgba tuples
   */
  color: string | [[any]]

  /**
   * a callable function
   */
  contains: lambda(): any

  /**
   * matplotlib color spec or sequence of specs
   * (matplotlib edgecolor)
   */
  edgeColor: string | [any]

  /**
   * matplotlib color spec or sequence of specs
   * (matplotlib facecolor)
   */
  faceColor: string | [any]

  /**
   * a Figure instance
   *
   * Python: Figure
   */
  figure: any

  /**
   * an id string
   */
  gid: string

  /**
   * [ '/' | '\' | '|' | '-' | '+' | 'x' | 'o' | 'O' | '.' | '*' ]
   */
  hatch: string enum('/', '\\', '|', '-', '+', 'x', 'o', 'O', '.', '*')

  /**
   * unknown
   * (matplotlib joinstyle)
   */
  joinStyle: any

  /**
   * object
   */
  label: any

  /**
   * ['solid' | 'dashed', 'dashdot', 'dotted' | (offset, on-off-dash-seq) | '-' | '--' | '-.' | ':' | 'None' | ' ' | '']
   * (matplotlib linestyle)
   */
  lineStyle: any

  /**
   * float or sequence of floats
   * (matplotlib linewidth)
   */
  lineWidth: double | [double]

  /**
   * [ 'screen' | 'data' ]
   * (matplotlib offset_position)
   */
  offsetPosition: string enum('screen', 'data')

  /**
   * float or sequence of floats
   */
  offsets: double | [double]

  /**
   * AbstractPathEffect
   * (matplotlib path_effects)
   */
  pathEffects: any

  /**
   * [None | bool | float | callable]
   */
  picker: any

  /**
   * float distance in points
   * (matplotlib pickradius)
   */
  pickRadius: double

  /**
   * bool or None
   */
  rasterized: boolean

  /**
   * (scale: float, length: float, randomness: float)
   * (matplotlib sketch_params)
   */
  sketchParams: any

  /**
   * Transform
   */
  transform: any

  /**
   * a url string
   */
  url: string

  /**
   * List[str] or None
   */
  urls: [any]

  /**
   * bool
   */
  visible: boolean

  /**
   * float
   * (matplotlib zorder)
   */
  zOrder: double

  /**
   * A Colormap instance or registered colormap name. The colormap maps the C values to colors. Defaults to rcParams["image.cmap"].
   *
   * Python: str or Colormap
   */
  cmap: string

  /**
   * The Normalize instance scales the data values to the canonical colormap range [0, 1] for mapping to colors. By default, the data range is mapped to the colorbar range using linear scaling.
   *
   * Python: Normalize
   */
  norm: any

  /**
   * The colorbar range. If None, suitable min/max values are automatically chosen by the Normalize instance (defaults to the respective min/max values of C in case of the default linear scaling).
   * (matplotlib vmin)
   *
   * Python: scalar
   */
  vMin: any

  /**
   * The colorbar range. If None, suitable min/max values are automatically chosen by the Normalize instance (defaults to the respective min/max values of C in case of the default linear scaling).
   * (matplotlib vmax)
   *
   * Python: scalar
   */
  vMax: any

  /**
   * The color of the edges. Defaults to 'none'. Possible values:
   * (matplotlib edgecolors)
   *
   * Python: {'none', None, 'face', color, color sequence}
   */
  edgeColors: [any]

  /**
   * The alpha blending value of the face color, between 0 (transparent) and 1 (opaque). Note: The edgecolor is currently not affected by this.
   *
   * Python: scalar
   */
  alpha: any

  /**
   * Whether to snap the mesh to pixel boundaries.
   */
  snap: boolean = false
}
