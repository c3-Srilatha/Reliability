/**
 * Make a plot with log scaling on both the x and y axis.
 *
 * # Example: Exponential Curve
 * ```JavaScript
 * var N = 100,
 *     x = C3.Array.patternOfInt(N, n => n * n),
 *     y = C3.Array.patternOfDbl(N, function(n) { var s = n * n, v = s / 20; return s + n * 10 * Math.random() - n; });
 * PlotAxes.make()
 *         .logLog({
 *           x: x,
 *           y: y
 *         }).show();
 * ```
 *
 * @see PlotAxes
 * @see https://matplotlib.org/api/_as_gen/matplotlib.axes.Axes.loglog.html
 */
type PlotLogLogSpec mixes PlotPlotSpec {

  /**
   * Base of the x/y logarithm.
   * (matplotlib basex)
   *
   * Python: scalar
   */
  baseX: double = 10

  /**
   * Base of the x/y logarithm.
   * (matplotlib basey)
   *
   * Python: scalar
   */
  baseY: double = 10

  /**
   * The location of the minor x/y ticks. If None, reasonable locations are automatically chosen depending on the number of decades in the plot. See Axes.set_xscale / Axes.set_yscale for details.
   * (matplotlib subsx)
   *
   * Python: sequence
   */
  subsX: [any]

  /**
   * The location of the minor x/y ticks. If None, reasonable locations are automatically chosen depending on the number of decades in the plot. See Axes.set_xscale / Axes.set_yscale for details.
   * (matplotlib subsy)
   *
   * Python: sequence
   */
  subsY: [any]

  /**
   * Non-positive values in x or y can be masked as invalid, or clipped to a very small positive number.
   * (matplotlib nonposx)
   *
   * Python: {'mask', 'clip'}
   */
  nonPosX: string enum('mask', 'clip') = 'mask'

  /**
   * Non-positive values in x or y can be masked as invalid, or clipped to a very small positive number.
   * (matplotlib nonposy)
   *
   * Python: {'mask', 'clip'}
   */
  nonPosY: string enum('mask', 'clip') = 'mask'
}
