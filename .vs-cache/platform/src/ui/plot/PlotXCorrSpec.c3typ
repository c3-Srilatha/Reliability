/**
 * Plot the cross correlation between x and y.
 *
 * ```JavaScript
 * let x = [11.37, 14.23, 16.3, 12.36, 6.54, 4.23, 19.11, 12.13, 19.91, 11.00],
 *     y = [15.21, 12.23, 4.76, 9.89, 8.96, 19.26, 12.24, 11.54, 13.39, 18.96];
 * PlotAxes.make().xCorr({ x, y }).show();
 * ```
 *
 * @see PlotAxes
 * @see https://matplotlib.org/api/_as_gen/matplotlib.axes.Axes.xcorr.html
 */
type PlotXCorrSpec mixes PlotElementSpec {

  /**
   * Python: sequence of scalars of length n
   */
  x: [double]

  /**
   * Python: sequence of scalars of length n
   */
  y: [double]

  /**
   * If True, input vectors are normalised to unit length.
   * (matplotlib normed)
   */
  normEd: boolean = true

  /**
   * x is detrended by the detrend callable. Default is no normalization.
   * (matplotlib detrend)
   *
   * Python: callable
   */
  detrEnd: lambda(): any

  /**
   * If True, Axes.vlines is used to plot the vertical lines from the origin to the acorr. Otherwise, Axes.plot is used.
   * (matplotlib usevlines)
   */
  useVLines: boolean = true

  /**
   * Number of lags to show. If None, will return all 2 * len(x) - 1 lags. Default is 10.
   * (matplotlib maxlags)
   */
  maxLags: int

  data: any

  /**
   * Only used if usevlines is False.
   * (matplotlib linestyle)
   *
   * Python: Line2D property, optional
   */
  lineStyle: any

  /**
   * Default is 'o'.
   */
  marker: string
}
