/**
 * Plot filled polygons.
 *
 * # Example: Square
 * ```JavaScript
 * PlotAxes.make({
 *   axis: 'equal'
 * }).fill({
 *   args: [
 *     [ 1, 2, 2, 1, 1 ],
 *     [ 1, 1, 2, 2, 1 ],
 *     'r'
 *   ]
 * }).show();
 * ```
 *
 * # Example: Checkerboard
 * ```JavaScript
 * var ax = PlotAxes.make({
 *   axis: 'equal',
 *   title: 'Checkerboard'
 * });
 * for (var i = 0; i < 8; i++) {
 *   for (var j = 0; j < 8; j++) {
 *     if (i % 2 != j % 2) {
 *       ax = ax.fill({
 *         args: [
 *           [ i, i + 1, i + 1, i, i ],
 *           [ j, j, j + 1, j + 1, j ],
 *           'k'
 *         ]
 *       });
 *     }
 *   }
 * }
 * ax.show();
 * ```
 *
 * @see PlotAxes
 * @see https://matplotlib.org/api/_as_gen/matplotlib.axes.Axes.fill.html
 */
type PlotFillSpec mixes PlotElementSpec {

  /**
   * Each polygon is defined by the lists of x and y positions of its nodes, optionally followed by by a color specifier. See matplotlib.colors for supported color specifiers. The standard color cycle is used for polygons without a color specifier.
   *
   * Python: sequence of x, y, [color]
   */
  args: [any]

  data: any
}
