/**
 * Plot a horizontal sequence of rectangles.
 *
 * # Example: Random Width
 * ```JavaScript
 * var N = 10,
 *     x = C3.Array.pattern(ArrayType.ofDbl(), N, n => C3.Array.ofDbl(n, 0.1 + Math.random() * 0.9)),
 *     y = C3.Array.patternOfDbl(2, n => n + Math.random() * 2);
 * PlotAxes.make().brokenBarH({
 *   xRanges: x,
 *   yRange: y
 * }).show();
 * ```
 *
 * @see PlotAxes
 * @see https://matplotlib.org/api/_as_gen/matplotlib.axes.Axes.broken_barh.html
 */
type PlotBrokenBarHSpec mixes PlotElementSpec {

  /**
   * The x-positions and extends of the rectangles. For each tuple (xmin, xwidth) a rectangle is drawn from xmin to xmin + xwidth.
   * (matplotlib xranges)
   *
   * Python: sequence of tuples (xmin, xwidth)
   */
  xRanges: [[double]]

  /**
   * (matplotlib yrange)
   */
  yRange: [double]

  data: any

  /**
   * The y-position and extend for all the rectangles.
   * (matplotlib yranges)
   *
   * Python: (ymin, ymax)
   */
  yRanges: [[double]]

  /**
   * a filter function, which takes a (m, n, 3) float array and a dpi value, and returns a (m, n, 3) array
   * (matplotlib agg_filter)
   */
  aggFilter: [any]

  /**
   * float or None
   */
  alpha: double

  /**
   * bool
   */
  animated: boolean

  /**
   * Boolean or sequence of booleans
   */
  antialiased: boolean | [boolean]

  /**
   * ndarray
   */
  ndarray: [any]

  /**
   * unknown
   * (matplotlib capstyle)
   */
  capStyle: any

  /**
   * a length 2 sequence of floats; may be overridden in methods that have vmin and vmax kwargs.
   * (matplotlib clim)
   */
  cLim: [double]

  /**
   * a Bbox instance
   * (matplotlib clip_box)
   *
   * Python: Bbox
   */
  clipBox: any

  /**
   * bool
   * (matplotlib clip_on)
   */
  clipOn: boolean

  /**
   * [(Path, Transform) | Patch | None]
   * (matplotlib clip_path)
   */
  clipPath: any

  /**
   * a colormap or registered colormap name
   */
  cmap: any

  /**
   * matplotlib color arg or sequence of rgba tuples
   */
  color: string | [[any]]

  /**
   * a callable function
   */
  contains: lambda(): any

  /**
   * matplotlib color spec or sequence of specs
   * (matplotlib edgecolor)
   */
  edgeColor: string | [any]

  /**
   * matplotlib color spec or sequence of specs
   * (matplotlib facecolor)
   */
  faceColor: string | [any]

  /**
   * a Figure instance
   *
   * Python: Figure
   */
  figure: any

  /**
   * an id string
   */
  gid: string

  /**
   * [ '/' | '\' | '|' | '-' | '+' | 'x' | 'o' | 'O' | '.' | '*' ]
   */
  hatch: string enum('/', '\\', '|', '-', '+', 'x', 'o', 'O', '.', '*')

  /**
   * unknown
   * (matplotlib joinstyle)
   */
  joinStyle: any

  /**
   * object
   */
  label: any

  /**
   * ['solid' | 'dashed', 'dashdot', 'dotted' | (offset, on-off-dash-seq) | '-' | '--' | '-.' | ':' | 'None' | ' ' | '']
   * (matplotlib linestyle)
   */
  lineStyle: any

  /**
   * float or sequence of floats
   * (matplotlib linewidth)
   */
  lineWidth: double | [double]

  /**
   * Normalize
   */
  norm: any

  /**
   * [ 'screen' | 'data' ]
   * (matplotlib offset_position)
   */
  offsetPosition: string enum('screen', 'data')

  /**
   * float or sequence of floats
   */
  offsets: double | [double]

  /**
   * AbstractPathEffect
   * (matplotlib path_effects)
   */
  pathEffects: any

  /**
   * [None | bool | float | callable]
   */
  picker: any

  /**
   * float distance in points
   * (matplotlib pickradius)
   */
  pickRadius: double

  /**
   * bool or None
   */
  rasterized: boolean

  /**
   * (scale: float, length: float, randomness: float)
   * (matplotlib sketch_params)
   */
  sketchParams: any

  /**
   * bool or None
   */
  snap: boolean

  /**
   * Transform
   */
  transform: any

  /**
   * a url string
   */
  url: string

  /**
   * List[str] or None
   */
  urls: [any]

  /**
   * bool
   */
  visible: boolean

  /**
   * float
   * (matplotlib zorder)
   */
  zOrder: double
}
