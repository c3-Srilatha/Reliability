/**
 * Container for individual charts (plots).
 * One or more {@link PlotAxes axes} must be added to make a renderable visualization.
 *
 * # Example: Building a Figure Explicitly
 * ```JavaScript
 * // create some data
 * let N = 25,
 *     x = C3.Array.patternOfInt(N, i => i),
 *     y = C3.Array.patternOfDbl(N, i => {
 *           let s = i * i, v = s / 20;
 *           return s + i * 2 * Math.random() - i;
 *         });
 * // create the axes instance with a single plot element
 * let ax = PlotAxes.make()
 *                  .logLog({
 *                    x: x,
 *                    y: y,
 *                    baseX: 2,
 *                    baseY: 2
 *                  });
 * // create the figure around it to show
 * let fig = PlotFigure.make({ axes: [ax] })
 * fig.show()
 * ```
 *
 * # Example: Figure with Four Charts
 * ```JavaScript
 * PlotFigure.make()
 *           .subPlot()
 *           .plot({ y: [ 2.5, 2.1, 1.9, 2.4 ] })
 *           .done()
 *           .subPlot()
 *           .pie({ x: [ 1, 3, 2, 4 ] })
 *           .done()
 *           .subPlot()
 *           .plot({ y: [ 0, 0, 3, 0 ] })
 *           .done()
 *           .subPlot()
 *           .pie({ x: [ 3, 2.5, 3.3, 2.6 ] })
 *           .done()
 *           .show();
 * ```
 *
 * @see PlotAxes
 * @see PlotElementSpec
 * @see plotting.c3doc
 * @see https://matplotlib.org/faq/usage_faq.html
 */
type PlotFigure {

  /**
   * For multi-chart figures, specify the number of rows in the grid.
   */
  nRows: int

  /**
   * For multi-chart figures, specify the number of columns in the grid.
   */
  nCols: int

  /**
   * Figure dimension (width, height) in inches.
   * (matplotlib figsize)
   *
   * Python: 2-tuple of floats
   */
  figSize: [double]

  /**
   * Dots per inch.
   */
  dpi: double

  /**
   * The figure patch facecolor.
   * (matplotlib facecolor)
   *
   * Python: default: rcParams["figure.facecolor"]
   */
  faceColor: any

  /**
   * The figure patch edge color.
   * (matplotlib edgecolor)
   *
   * Python: default: rcParams["figure.edgecolor"]
   */
  edgeColor: any

  /**
   * The linewidth of the frame (i.e. the edge linewidth of the figure patch).
   * (matplotlib linewidth)
   */
  lineWidth: double = 0.0

  /**
   * If False, suppress drawing the figure frame.
   * (matplotlib frameon)
   */
  frameOn: boolean = true

  /**
   * Subplot parameters. If not given, the default subplot parameters rcParams["figure.subplot.*"] are used.
   * (matplotlib subplotpars)
   *
   * Python: SubplotParams
   */
  subPlotPars: any

  /**
   * If False use subplotpars. If True adjust subplot parameters using tight_layout with default padding. When providing a dict containing the keys pad, w_pad, h_pad, and rect, the default tight_layout paddings will be overridden.
   * (matplotlib tight_layout)
   *
   * Python: bool or dict
   */
  tightLayout: boolean | json

  /**
   * If True use constrained layout to adjust positioning of plot elements. Like tight_layout, but designed to be more flexible. See Constrained Layout Guide for examples. (Note: does not work with subplot() or subplot2grid().) Defaults to rcParams["figure.constrained_layout.use"].
   * (matplotlib constrained_layout)
   */
  constrainedLayout: boolean

  /**
   * The individual charts to appear on this figure.
   */
  axes: [PlotAxes]

  /**
   * Add a chart to the figure, adding a new PlotAxes instance.
   * Once all elements are added, call PlotSubPlot#done to return the augmented figure.
   */
  subPlot: member function(spec: PlotAxes): !PlotSubPlot js

  /**
   * Render the figure to an image and return the content.
   *
   * @return image content
   */
  image: member function(): !Content py-matplotlib-py4j

  /**
   * Render the figure using #image and display it in the local environment.
   */
  show: member function() js-client
}
