/**
 * Plot identical parallel lines at the given positions.
 *
 * # Example: Horizontal
 * ```JavaScript
 * PlotAxes.make().eventPlot({
 *   positions: C3.Array.patternOfDbl(20, n => Math.random() * 100)
 * }).show();
 * ```
 *
 * # Example: Vertical
 * ```JavaScript
 * PlotAxes.make().eventPlot({
 *   positions: C3.Array.patternOfDbl(20, n => Math.random() * 100),
 *   orientation: 'vertical'
 * }).show();
 * ```
 *
 * @see PlotAxes
 * @see https://matplotlib.org/api/_as_gen/matplotlib.axes.Axes.eventplot.html
 */
type PlotEventPlotSpec mixes PlotElementSpec {

  /**
   * Each value is an event. If positions is a 2D array-like, each row corresponds to a row or a column of lines (depending on the orientation parameter).
   *
   * Python: 1D or 2D array-like object
   */
  positions: [any]

  /**
   * Controls the direction of the event collections:
   *
   * Python: {'horizontal', 'vertical'}
   */
  orientation: string enum('horizontal', 'vertical') = 'horizontal'

  /**
   * The offset of the center of the lines from the origin, in the direction orthogonal to orientation.
   * (matplotlib lineoffsets)
   *
   * Python: scalar or sequence of scalars
   */
  lineOffsets: any = 1

  /**
   * The total height of the lines (i.e. the lines stretches from lineoffset - linelength/2 to lineoffset + linelength/2).
   * (matplotlib linelengths)
   *
   * Python: scalar or sequence of scalars
   */
  lineLengths: any = 1

  /**
   * The line width(s) of the event lines, in points. If it is None, defaults to its rcParams setting.
   * (matplotlib linewidths)
   *
   * Python: scalar, scalar sequence or None
   */
  lineWidths: any

  /**
   * The color(s) of the event lines. If it is None, defaults to its rcParams setting.
   *
   * Python: color, sequence of colors or None
   */
  colors: string

  /**
   * Default is 'solid'. Valid strings are ['solid', 'dashed', 'dashdot', 'dotted', '-', '--', '-.', ':']. Dash tuples should be of the form:
   * (matplotlib linestyles)
   *
   * Python: str or tuple or a sequence of such values
   */
  lineStyles: string | [any] = 'solid'

  data: any
}
