/**
 * Plot a pie chart.
 *
 * # Example: Pie Chart
 * ```JavaScript
 * PlotAxes.make({
 *   title: 'Pies'
 * }).pie({
 *   x: [40, 30, 15, 10, 5],
 *   labels: ['Apple', 'Cherry', 'Berry', 'Lemon', 'Key Line'],
 *   colors: ['green', 'red', 'purple', 'yellow', 'chartreuse'],
 *   autoPct: '%1.1f%%',
 *   shadow: true
 * }).show();
 * ```
 *
 * # Example: Double Donut Chart
 * ```JavaScript
 * PlotAxes.make({
 *   axis: 'equal',
 *   title: 'Donuts'
 * }).pie({
 *   x: [30, 45, 25],
 *   radius: 1,
 *   colors: ['#bf4040', '#59bf40', '#4073bf'],
 *   wedgeProps: {
 *     width: 0.3,
 *     edgecolor: 'w'
 *   },
 *   labels: ['Cake', 'Regular', 'Buttermilk'],
 * }).pie({
 *   x: [20, 10, 25, 20, 15, 10],
 *   radius: 0.7,
 *   colors: ['#d98c8c', '#e6b3b3', '#9cd98c', '#bde6b3', '#8cabd9', '#b3c7e6'],
 *   autoPct: '%.1f%%',
 *   wedgeProps: {
 *     width: 0.3,
 *     edgecolor: 'w'
 *   }
 * }).show();
 * ```
 *
 * @see PlotAxes
 * @see https://matplotlib.org/api/_as_gen/matplotlib.axes.Axes.pie.html
 */
type PlotPieSpec mixes PlotElementSpec {

  /**
   * The wedge sizes.
   *
   * Python: array-like
   */
  x: [any]

  /**
   * If not None, is a len(x) array which specifies the fraction of the radius with which to offset each wedge.
   *
   * Python: array-like
   */
  explode: [any]

  /**
   * A sequence of strings providing the labels for each wedge
   *
   * Python: list
   */
  labels: [any]

  /**
   * A sequence of matplotlib color args through which the pie chart will cycle. If None, will use the colors in the currently active cycle.
   *
   * Python: array-like
   */
  colors: [any]

  /**
   * If not None, is a string or function used to label the wedges with their numeric value. The label will be placed inside the wedge. If it is a format string, the label will be fmt%pct. If it is a function, it will be called.
   * (matplotlib autopct)
   *
   * Python: None (default), string, or function
   */
  autoPct: string | (lambda(): any)

  /**
   * The ratio between the center of each pie slice and the start of the text generated by autopct. Ignored if autopct is None.
   * (matplotlib pctdistance)
   */
  pctDistance: double = 0.6

  /**
   * Draw a shadow beneath the pie.
   */
  shadow: boolean = false

  /**
   * The radial distance at which the pie labels are drawn
   * (matplotlib labeldistance)
   */
  labelDistance: double = 1.1

  /**
   * If not None, rotates the start of the pie chart by angle degrees counterclockwise from the x-axis.
   * (matplotlib startangle)
   */
  startAngle: double

  /**
   * The radius of the pie, if radius is None it will be set to 1.
   */
  radius: double

  /**
   * Specify fractions direction, clockwise or counterclockwise.
   * (matplotlib counterclock)
   */
  counterClock: boolean = true

  /**
   * Dict of arguments passed to the wedge objects making the pie. For example, you can pass in wedgeprops = {'linewidth': 3} to set the width of the wedge border lines equal to 3. For more details, look at the doc/arguments of the wedge object. By default clip_on=False.
   * (matplotlib wedgeprops)
   */
  wedgeProps: json

  /**
   * Dict of arguments to pass to the text objects.
   * (matplotlib textprops)
   */
  textProps: json

  /**
   * Center position of the chart. Takes value (0, 0) or is a sequence of 2 scalars.
   *
   * Python: list of float
   */
  center: [double] = [0, 0]

  /**
   * Plot axes frame with the chart if true.
   */
  frame: boolean = false

  /**
   * Rotate each label to the angle of the corresponding slice if true.
   * (matplotlib rotatelabels)
   */
  rotateLabels: boolean = false

  data: any
}
