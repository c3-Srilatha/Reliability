/**
 * Make a step plot.
 *
 * # Example: Progress
 * ```JavaScript
 * var N = 50,
 *     last = 0,
 *     x = C3.Array.patternOfInt(N, n => n)
 *     y = C3.Array.patternOfDbl(N, function(n) { if (n > 0 && Math.random() < 0.5) last += -0.5 + 2 * Math.random(); return last; });
 * PlotAxes.make({ title: 'Progress' }).step({ x: x, y: y }).show();
 * ```
 *
 * @see PlotAxes
 * @see https://matplotlib.org/api/_as_gen/matplotlib.axes.Axes.step.html
 */
type PlotStepSpec mixes PlotElementSpec {

  /**
   * 1-D sequence of x positions. It is assumed, but not checked, that it is uniformly increasing.
   *
   * Python: array_like
   */
  x: [any]

  /**
   * 1-D sequence of y levels.
   *
   * Python: array_like
   */
  y: [any]

  /**
   * An object with labelled data. If given, provide the label names to plot in x and y.
   *
   * Python: indexable object
   */
  data: json

  /**
   * A format string, e.g. 'g' for a green line. See plot for a more detailed description.
   */
  fmt: string

  /**
   * Define where the steps should be placed:
   *
   * Python: {'pre', 'post', 'mid'}
   */
  where: string enum('pre', 'post', 'mid') = 'pre'
}
