/**
 * Plot y versus x as lines and/or markers with attached errorbars.
 *
 * # Example: Simple
 * ```JavaScript
 * PlotAxes.make().errorBar({
 *   x: [1, 2, 3, 4],
 *   y: [1.1, 3.01, 2.01, 4.01],
 *   yErr: [0.1, 0.2, 0.05, 0.6]
 * }).show()
 * ```
 *
 * # Example: X and Y Error Bars
 * ```JavaScript
 * PlotAxes.make().errorBar({
 *   x: [1.1, 2.01, 3.01, 4.01],
 *   y: [1.1, 3.01, 2.01, 4.01],
 *   xErr: [0.1, 0.05, 0.05, 0.2],
 *   yErr: [0.1, 0.2, 0.05, 0.6]
 * }).show();
 * ```
 *
 * @see PlotAxes
 * @see https://matplotlib.org/api/_as_gen/matplotlib.axes.Axes.errorbar.html
 */
type PlotErrorBarSpec mixes PlotElementSpec {

  /**
   * The data positions.
   *
   * Python: scalar or array-like
   */
  x: any

  /**
   * The data positions.
   *
   * Python: scalar or array-like
   */
  y: any

  /**
   * The errorbar sizes:
   * (matplotlib yerr)
   *
   * Python: scalar or array-like, shape(N,) or shape(2,N)
   */
  yErr: any

  /**
   * The errorbar sizes:
   * (matplotlib xerr)
   *
   * Python: scalar or array-like, shape(N,) or shape(2,N)
   */
  xErr: any

  /**
   * The format for the data points / data lines. See plot for details.
   *
   * Python: plot format string
   */
  fmt: ?string

  /**
   * A matplotlib color arg which gives the color the errorbar lines. If None, use the color of the line connecting the markers.
   * (matplotlib ecolor)
   *
   * Python: mpl color
   */
  eColor: string

  /**
   * The linewidth of the errorbar lines. If None, the linewidth of the current style is used.
   * (matplotlib elinewidth)
   *
   * Python: scalar
   */
  eLineWidth: any

  /**
   * The length of the error bar caps in points. If None, it will take the value from rcParams["errorbar.capsize"].
   * (matplotlib capsize)
   *
   * Python: scalar
   */
  capSize: any

  /**
   * If True, will plot the errorbars above the plot symbols. Default is below.
   * (matplotlib barsabove)
   */
  barsAbove: boolean = false

  /**
   * These arguments can be used to indicate that a value gives only upper/lower limits. In that case a caret symbol is used to indicate this. lims-arguments may be of the same type as xerr and yerr. To use limits with inverted axes, set_xlim() or set_ylim() must be called before errorbar().
   * (matplotlib lolims)
   */
  loLims: boolean

  /**
   * These arguments can be used to indicate that a value gives only upper/lower limits. In that case a caret symbol is used to indicate this. lims-arguments may be of the same type as xerr and yerr. To use limits with inverted axes, set_xlim() or set_ylim() must be called before errorbar().
   * (matplotlib uplims)
   */
  upLims: boolean

  /**
   * These arguments can be used to indicate that a value gives only upper/lower limits. In that case a caret symbol is used to indicate this. lims-arguments may be of the same type as xerr and yerr. To use limits with inverted axes, set_xlim() or set_ylim() must be called before errorbar().
   * (matplotlib xlolims)
   */
  xLoLims: boolean

  /**
   * These arguments can be used to indicate that a value gives only upper/lower limits. In that case a caret symbol is used to indicate this. lims-arguments may be of the same type as xerr and yerr. To use limits with inverted axes, set_xlim() or set_ylim() must be called before errorbar().
   * (matplotlib xuplims)
   */
  xUpLims: boolean

  /**
   * Subsamples the errorbars. e.g., if errorevery=5, errorbars for every 5-th datapoint will be plotted. The data plot itself still shows all data points.
   * (matplotlib errorevery)
   *
   * Python: positive integer
   */
  errorEvery: int = 1

  /**
   * An alias to the keyword argument markeredgewidth (a.k.a. mew). This setting is a more sensible name for the property that controls the thickness of the error bar cap in points. For backwards compatibility, if mew or markeredgewidth are given, then they will over-ride capthick. This may change in future releases.
   * (matplotlib capthick)
   *
   * Python: scalar
   */
  capThick: any

  data: any

  /**
   * a filter function, which takes a (m, n, 3) float array and a dpi value, and returns a (m, n, 3) array
   * (matplotlib agg_filter)
   */
  aggFilter: [any]

  /**
   * float (0.0 transparent through 1.0 opaque)
   */
  alpha: double

  /**
   * bool
   */
  animated: boolean

  /**
   * bool
   */
  antialiased: boolean

  /**
   * a Bbox instance
   * (matplotlib clip_box)
   *
   * Python: Bbox
   */
  clipBox: any

  /**
   * bool
   * (matplotlib clip_on)
   */
  clipOn: boolean

  /**
   * [(Path, Transform) | Patch | None]
   * (matplotlib clip_path)
   */
  clipPath: any

  /**
   * any matplotlib color
   */
  color: string

  /**
   * a callable function
   */
  contains: lambda(): any

  /**
   * ['butt' | 'round' | 'projecting']
   * (matplotlib dash_capstyle)
   */
  dashCapStyle: string enum('butt', 'round', 'projecting')

  /**
   * ['miter' | 'round' | 'bevel']
   * (matplotlib dash_joinstyle)
   */
  dashJoinStyle: string enum('miter', 'round', 'bevel')

  /**
   * sequence of on/off ink in points
   */
  dashes: [any]

  /**
   * ['default' | 'steps' | 'steps-pre' | 'steps-mid' | 'steps-post']
   * (matplotlib drawstyle)
   */
  drawStyle: string enum('default', 'steps', 'steps-pre', 'steps-mid', 'steps-post')

  /**
   * a Figure instance
   *
   * Python: Figure
   */
  figure: any

  /**
   * ['full' | 'left' | 'right' | 'bottom' | 'top' | 'none']
   * (matplotlib fillstyle)
   */
  fillStyle: string enum('full', 'left', 'right', 'bottom', 'top', 'none')

  /**
   * an id string
   */
  gid: string

  /**
   * object
   */
  label: any

  /**
   * ['solid' | 'dashed', 'dashdot', 'dotted' | (offset, on-off-dash-seq) | '-' | '--' | '-.' | ':' | 'None' | ' ' | '']
   * (matplotlib linestyle)
   */
  lineStyle: any

  /**
   * float value in points
   * (matplotlib linewidth)
   */
  lineWidth: double

  /**
   * A valid marker style
   */
  marker: any

  /**
   * any matplotlib color
   * (matplotlib markeredgecolor)
   */
  markerEdgeColor: string

  /**
   * float value in points
   * (matplotlib markeredgewidth)
   */
  markerEdgeWidth: double

  /**
   * any matplotlib color
   * (matplotlib markerfacecolor)
   */
  markerFaceColor: string

  /**
   * any matplotlib color
   * (matplotlib markerfacecoloralt)
   */
  markerFaceColorAlt: string

  /**
   * float
   * (matplotlib markersize)
   */
  markerSize: double

  /**
   * [None | int | length-2 tuple of int | slice | list/array of int | float | length-2 tuple of float]
   * (matplotlib markevery)
   */
  markEvery: [int]

  /**
   * AbstractPathEffect
   * (matplotlib path_effects)
   */
  pathEffects: any

  /**
   * float distance in points or callable pick function fn(artist, event)
   */
  picker: double | (lambda(): any)

  /**
   * float distance in points
   * (matplotlib pickradius)
   */
  pickRadius: double

  /**
   * bool or None
   */
  rasterized: boolean

  /**
   * (scale: float, length: float, randomness: float)
   * (matplotlib sketch_params)
   */
  sketchParams: any

  /**
   * bool or None
   */
  snap: boolean

  /**
   * ['butt' | 'round' | 'projecting']
   * (matplotlib solid_capstyle)
   */
  solidCapStyle: string enum('butt', 'round', 'projecting')

  /**
   * ['miter' | 'round' | 'bevel']
   * (matplotlib solid_joinstyle)
   */
  solidJoinStyle: string enum('miter', 'round', 'bevel')

  /**
   * a matplotlib.transforms.Transform instance
   *
   * Python: Transform
   */
  transform: any

  /**
   * a url string
   */
  url: string

  /**
   * bool
   */
  visible: boolean

  /**
   * 1D array
   * (matplotlib xdata)
   */
  xData: [any]

  /**
   * 1D array
   * (matplotlib ydata)
   */
  yData: [any]

  /**
   * float
   * (matplotlib zorder)
   */
  zOrder: double
}
