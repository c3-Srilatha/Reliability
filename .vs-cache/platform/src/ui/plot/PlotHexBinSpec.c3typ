/**
 * Make a hexagonal binning plot.
 *
 * ```JavaScript
 * let N = 500,
 *     r = Rnd.inst(),
 *     x = C3.Array.patternOfDbl(N, _ => r.gaussian(0, 1)),
 *     y = C3.Array.patternOfDbl(N, i => 2 + 3 * x[i] + 4 * r.gaussian(0, 1));
 * PlotAxes.make().hexBin({ x, y, gridSize: 50, cmap: 'inferno' }).show();
 * ```
 *
 * @see PlotAxes
 * @see https://matplotlib.org/api/_as_gen/matplotlib.axes.Axes.hexbin.html
 */
type PlotHexBinSpec mixes PlotElementSpec {

  /**
   * Python: array or masked array
   */
  x: [any]

  /**
   * Python: array or masked array
   */
  y: [any]

  /**
   * Python: array or masked array
   */
  C: [any]

  /**
   * The number of hexagons in the x-direction, default is 100. The corresponding number of hexagons in the y-direction is chosen such that the hexagons are approximately regular. Alternatively, gridsize can be a tuple with two elements specifying the number of hexagons in the x-direction and the y-direction.
   * (matplotlib gridsize)
   *
   * Python: int or (int, int)
   */
  gridSize: int | [int] = 100

  /**
   * If None, no binning is applied; the color of each hexagon directly corresponds to its count value.
   * (matplotlib bins)
   *
   * Python: {'log'} or int or sequence
   *
   * enum('log')
   */
  binS: string | int | [any]

  /**
   * Use a linear or log10 scale on the horizontal axis.
   * (matplotlib xscale)
   *
   * Python: {'linear', 'log'}
   */
  xScale: string enum('linear', 'log') = 'linear'

  /**
   * Use a linear or log10 scale on the vertical axis.
   * (matplotlib yscale)
   *
   * Python: {'linear', 'log'}
   */
  yScale: string enum('linear', 'log') = 'linear'

  /**
   * The limits of the bins. The default assigns the limits based on gridsize, x, y, xscale and yscale.
   *
   * Python: scalar
   */
  extent: any

  cmap: any
  norm: any

  /**
   * (matplotlib vmin)
   */
  vMin: any

  /**
   * (matplotlib vmax)
   */
  vMax: any

  alpha: any

  /**
   * (matplotlib linewidths)
   */
  lineWidths: any

  /**
   * (matplotlib edgecolors)
   */
  edgeColors: string = 'face'

  /**
   * (matplotlib reduce_C_function)
   */
  reduceCFunction: any

  /**
   * If not None, only display cells with more than mincnt number of points in the cell
   * (matplotlib mincnt)
   *
   * Python: int > 0
   */
  minCnt: int

  /**
   * if marginals is True, plot the marginal density as colormapped rectagles along the bottom of the x-axis and left of the y-axis
   */
  marginals: boolean = false

  data: any
}
