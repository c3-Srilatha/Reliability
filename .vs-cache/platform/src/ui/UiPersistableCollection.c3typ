/**
 * This {@link UiCollection collection} implementation supports types which mixin {@link Persistable} (normal `entity`
 * types).
 *
 * @see UiPersistableModel
 */
type UiPersistableCollection mixes UiCollection {

  /**
   * The filter to apply when fetching.
   *
   * @see FetchFilterSpec#filter
   */
  fetchFilter: string

  /**
   * Specifies the order to return Objs.  Default if not specified is by "id".
   *
   * @see FetchSpec#order
   */
  fetchOrder: string

  /**
   * The number of rows to bring back by default when fetching. Note that this can be overridden using the #reload
   * overload that takes two arguments.
   *
   * @see FetchSpec#limit
   */
  fetchLimit: !int = 100

  /**
   * Discard any pending changes and request the next set of underlying objects from the server. Note that the number
   * of models and their order in the collection may change. The argument is a relative page number is the multiple of
   * fetchLimit, representing pages with that many objects.
   *
   * @param delta the number of pages to advance/back up
   */
  nextPage: ~ js-client

  /**
   * Get the current relative page number assuming that #nextPage was used to advance the offset. This value is 1-based
   * for display in a paging UI.
   */
  pageNumber: ~ js-client

  /**
   * For a persistable collection, the whole-collection save operation is supported.
   */
  isSavable: ~ js-client

  m_hasMore: private boolean

  /**
   * Internal method to re-retrieve all fields of an object currently loaded in the client. Note that all changes made
   * to the objects will be discarded and their previous state reloaded. If any objects no longer exist, they will be
   * dropped from the list returned.
   *
   * @see #reload
   */
  sendReload: member function(offset: !int, limit: int): !Promise<mixing UiPersistableCollection>

  /**
   * Internal method to save all changes made to a set of objects currently loaded in the client. If any of the objects
   * have no `id`, they are created, otherwise objects are updated. Objects on the removed list (#m_removed) will be
   * removed from the DB.
   *
   * @see #save
   */
  sendSave: member function(): !Promise<mixing UiPersistableCollection>
}
