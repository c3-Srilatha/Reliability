/**
 * This component manages a chart presentation of one or more timeseries instances.
 *
 * @see NormTimeseries
 */
type TimeseriesChart mixes ReactClass {

  /**
   * The timeseries to be charted. For best results, these should use the same time range and have comparable data
   * values since they will share the same Y axis.
   */
  timeseries: ![Timeseries]
}
