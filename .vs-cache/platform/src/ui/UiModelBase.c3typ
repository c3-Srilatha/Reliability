/**
 * Base type for:
 * @see UiCollection
 * @see UiModel
 *
 * @see UiView
 */
abstract type UiModelBase mixes UiEventSource {

  /**
   * Get the view this model was created for. This will throw an exception if the model has become detached.
   */
  view: member function(): !UiView js-client | java

  /**
   * Submit all pending changes (if any) to the server in a single upsert operation. If this succeeds the model is
   * marked as clean.
   *
   * @return true if any changes were actually saved (sent to the server)
   */
  save: abstract member function(): !Promise<boolean> js-client

  /**
   * Discard any pending changes and re-request the data of the underlying object from the server.
   *
   * @param args extra parameters to pass to reload
   * @return true if the object still exists
   */
  reload: abstract member function(args: map<string, any>): !Promise<boolean> js-client

  /**
   * Return whether there are any local changes to the model (by calling #set) which have not been saved or reverted.
   * If this method returns false, save will have no effect (however reload always fetches new values, regardless of the
   * dirty state).
   */
  isDirty: abstract member function(): boolean js-client

  /**
   * Whether this model as a whole is unmodifiable on the server. This could be due to permissions, view configuration
   * or the mode in which the object was loaded. Any call to #set or #save should throw an exception.
   */
  isReadOnly: abstract member function(): boolean js-client

  /**
   * Determine whether the underlying instance is updatable.
   */
  checkChangeable: private inline member function() js-client

  /**
   * The corresponding parent {@link UiView}.
   */
  parentView: private !UiView
}
