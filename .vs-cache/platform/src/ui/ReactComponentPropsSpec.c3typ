/**
 * Details for generating the TypeScript declaration representing the data fields of a type.
 *
 * @see ReactComponent#buildProps
 */
type ReactComponentPropsSpec mixes Spec {

  /**
   * The name of the TypeScript interface to generate. By default, the name of the type plus "Props" is used.
   * So a component named "Hello" gets "HelloProps".
   */
  name: string

  /**
   * Whether to suppress data fields of mixins (normally included).
   */
  ignoreMixins: boolean

  /**
   * Whether to skip private data fields of the type itself (normally included).
   */
  ignorePrivate: boolean

  /**
   * Whether to add imports of referenced types.
   */
  addImports: boolean

  /**
   * Whether to add export of the type.
   */
  addExport: boolean

  /**
   * Indentation level (in spaces) of the interface declaration itself.
   */
  outerIndentation: int = 0

  /**
   * If there are no data fields at all, return a null string (normally an empty interface).
   */
  nullIfEmpty: boolean
}
