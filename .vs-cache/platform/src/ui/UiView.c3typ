/**
 * A "view" is a metadata object which represents a set of fields and expressions for a single source type.
 * This is used to efficiently load fields which are needed for a particular user interface presentation.
 * The view only configures the presentation. The data is managed by the {@link UiModel model}.
 *
 * Views have a {@link #source source type} and a set of {@link UiViewField fields}. Those fields can add presentation
 * to the fields of the source type, or they can expose more deeply nested structure by using an expression to produce
 * the value. See {@link UiViewField#value} for more info.
 *
 * Views expose {@link UiViewAction actions} which tie logical operations to the UI necessary to invoke them.
 * These end up invoking type methods, but provide the UI that labels the action and even collects values for the
 * method arguments.
 *
 * The data presented by a view comes from a {@link UiModel}. A model is the UI wrapper around an Obj instance,
 * and it provides abstract operations that allow a general UI to be built that works with any Obj instance.
 * The other abstraction is the {@link UiCollection} which provides access to a stream of models.
 *
 * For example, a form control can lay out its fields based on the declarations in the view and interact with Obj
 * instances through the model. Thus, general-purpose UIs can be built from metadata without knowing the details
 * of the objects they will be operating on.
 *
 * @see UiModel
 * @see UiCollection
 * @see UiMap
 * @see TypeDefaultUi
 */
type UiView mixes Metadata, Nameable, Identified {

  /**
   * The type this view is a presentation of.
   */
  sourceType: !Type

  /**
   * The default label for instances of this type or a collection of this type within an UI. If not specified, this is
   * a cleaned-up version of the source type name.
   */
  label: string

  /**
   * The short description of this field, typically used as a tool tip. If unspecified, this is extracted from the
   * documentation of the source type.
   */
  description: string

  /**
   * The fields declared on the view. This represents the data elements of the source type hierarchy that will be
   * available with their presentation.
   */
  viewFields: [UiViewField] schema name 'FLDS'

  /**
   * The actions declared on the view. This represents the implementation of button/menu items available to the user of
   * a UI hosted on this view.
   */
  viewActions: [UiViewAction] schema name 'ACTS'

  /**
   * @return Map of all field names to associated {@link UiViewField} for this {@link UiView}.
   */
  viewFieldMap: cached member function(): map<string, UiViewField> js-client

  /**
   * @return Map of all action names to associated {@link UiViewAction} for this {@link UiView}.
   */
  viewActionMap: cached member function(): map<string, UiViewAction> js-client

  /**
   * @return the specified {@link UiViewField} associated with the input field name.
   */
  viewFieldForName: inline member function(name: !string): UiViewField js-client

  /**
   * @return the specified {@link UiViewAction} associated with the input action name.
   */
  viewActionForName: inline member function(name: !string): UiViewAction js-client

  /**
   * Generate an include spec which contains at least the fields needed for the evaluating the declared field values.
   * It will also always include the `id` of entity types.
   */
  includeSpec: member function(): string java

  /**
   * @param inst
   *           made Obj or initial values for the Obj in the newly created model.
   *
   * @return a model for a single instance of the source type for presentation with this view.
   */
  model: inline member function(inst: !WithType): !UiModel js-client

  /**
   * @return a collection for a set of instances of the source type for presentation with this view. If the array is
   * empty, the returned collection may need to be queried before use (using UiCollection#reload).
   */
  collection: inline member function(insts: !?[WithType]): !UiCollection js-client

  /**
   * @return a map instances of the source type as the element for presentation with this view. If the map is
   * empty, the returned map may need to be queried before use (using UiMap#reload).
   */
  map: inline member function(insts: !?map<string, WithType>): !UiMap js-client

  /**
   * Get the expression used to access a field from the type on which this view is based. If the
   * {@link UiViewField#value value} is specified, that is used. Otherwise, the {@link UiViewField#name view field name}
   * is assumed to match a field in the type.
   *
   * @param name
   *           Name of the view field.
   * @param failIfNone
   *           If the view field doesn't exist, throw an error instead of returning null.
   * @return the field expression.
   *
   * @see UiViewField#value
   */
  fieldExpression: inline member function(name: !string, failIfNone: boolean): string js-client | java

  /**
   * Construct a default UI view for a type by name. This uses anything which is part of the type's
   * {@link TypeDefaultUi default UI}.
   */
  fromType: function(type: !Type): !UiView js-client

  // TODO: from syntax does not work as expected
  // keyFieldType: ~ from Identified
  // keyFieldValue: ~ from Identified
  keyFieldType: ~

  keyFieldValue: ~
}
