/**
 * Each column holds a single child component.
 */
type GridLayout.Col {

  /**
   * The component in this cell.
   */
  component: !ReactComponent

  /**
   * Proportion of left-over space to allocate to this cell if other rows have more cells.
   */
  weight: double
}
