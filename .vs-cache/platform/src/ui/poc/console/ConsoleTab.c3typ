/**
 * Every tab of the Console UI is implemented by a React component. This marker type allows the console to find the
 * components that implement it and associate them with the UI elements.
 */
abstract type ConsoleTab {

  /**
   * The menu item and header title string for this tab.
   */
  label: abstract function(): !string js-client

  /**
   * The icon name for the tab. One of the Semantic UI icon names must be provide for the console UI.
   *
   * @see https://semantic-ui.com/elements/icon.html
   */
  icon: abstract function(): !string js-client

  /**
   * The short descriptive string for this tab.
   */
  toolTip: optional function(): !string js-client

  /**
   * Relative ordering between the items in the menu and the icons on the right. If this order is unspecified or
   * duplicated, the labels are used instead.
   */
  order: optional function(): !int js-client

  /**
   * Hook function called when Console is instantiated, to allow it to register any associated global functions.
   *
   * @param shell the ConsoleShell React component
   * @param global the JavaScript global (usually `window`)
   */
  install: optional function(shell: !native, global: !native) js-client
}
