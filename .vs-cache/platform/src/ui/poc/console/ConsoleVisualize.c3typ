/**
 * The console generic data visualization. This instantiates the console tab labeled "Visualizer" (with the eye icon).
 * It also creates the global function `c3Viz` that can be invoked with any object in JavaScript.
 */
type ConsoleVisualize mixes ReactClass, ConsoleTab {

  /**
   * The data to render. This may be any instance and will be displayed using some appropriate UI depending on its
   * type.
   */
  data: any

  /**
   * Ignore any special renderings and display the value as a JSON tree using {@link DataTree}.
   */
  asTree: boolean

  /**
   * Get the data to visualize by calling the specified action.
   */
  // PartiallyAppliedAction
  action: Obj

  label:   ~ js-client
  icon:    ~ js-client
  toolTip: ~ js-client
  order:   ~ js-client
  install: ~ js-client
}
