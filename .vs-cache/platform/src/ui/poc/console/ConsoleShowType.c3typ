/**
 * The in-console type documentation. This instantiates the console tab labeled "Types" (with the briefcase icon).
 * It also creates the global function `c3ShowType` that can be invoked with a type name, and optionally a field name,
 * in JavaScript.
 */
type ConsoleShowType mixes ReactClass, ConsoleTab {

  /**
   * The type name to show documentation for.
   */
  typeName: string

  /**
   * The field name, of the specified type, to show documentation for.
   */
  fieldName: string

  /**
   * Normally, inherited methods are included in the documentation, but they can be suppressed as well.
   */
  hideInherited: boolean

  /**
   * Normally, type and field declarations (DSL syntax) are hidden in documentation, but they can be shown as well.
   */
  showDeclaration: boolean

  /**
   * Normally, private methods are hidden in the documentation, but they can be shown as well.
   */
  showPrivate: boolean

  /**
   * The field index menu is only shown if there at least this many fields in the index. (Otherwise, the page is
   * presumably too short to need an index).
   */
  minIndexFields: int = 5

  label:   ~ js-client
  icon:    ~ js-client
  toolTip: ~ js-client
  order:   ~ js-client
  install: ~ js-client
}
