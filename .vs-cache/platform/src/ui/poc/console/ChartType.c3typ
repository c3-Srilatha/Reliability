/**
 * Enum of chart kinds that can be supported by the console notebook rendering.
 * The values are currently the Echart types. We can further abstract and interpret in UI layer if necessary.
 */
enum type ChartType {

  PIE = 'pie'

  BAR = 'bar'

  LINE = 'line'

  SCATTER = 'scatter'

  SUNBURST = 'sunburst'
}
