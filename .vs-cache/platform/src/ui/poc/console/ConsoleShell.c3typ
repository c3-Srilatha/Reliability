/**
 * The chrome of the Console itself is implemented as a react component. Note that rendering of the content area is
 * not included in this chrome, only the handling of the menu, toolbar and managing the loading process.
 */
type ConsoleShell mixes ReactClass {

  /**
   * Find the names of all the console tabs components to be displayed.
   */
  findTabs: function(): [string]
}
