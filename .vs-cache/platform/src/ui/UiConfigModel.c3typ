/**
 * This {@link UiConfigModel model} implementation supports any {@link Config} type.
 */
type UiConfigModel mixes UiModel {

  afterMake:       ~ js-client
  isDirty:         ~ js-client
  isReadOnly:      ~ js-client
  isFieldReadOnly: ~ js-client
  reload:          ~ js-client
}
