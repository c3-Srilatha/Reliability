/**
 * UI components implemented by a React function are represented by a type that mixes this type. It must implement
 * the `render` function. An interface named "*Props", representing the data fields defined by the component type,
 * will be generated to define the "props" (passed to render).
 *
 * ```type
 * type Hello mixes ReactFunction {
 *   // who we are saying hello to
 *   who: !string
 * }
 * ```
 *
 * ```tsx
 * import React from 'react';
 *
 * function render(props: HelloProps) {
 *   return <p>Hello, {props.who}</p>;
 * }
 *
 * export default render;
 * ```
 */
abstract type ReactFunction mixes ReactComponent {

  /**
   * The render function must be implemented as the function the TSX implementation exports.
   */
  render: abstract function(props: mixing ReactFunction) tsx-client
}
