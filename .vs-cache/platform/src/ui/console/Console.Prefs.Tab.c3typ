/**
 * Enum of values defining behavior when opening a new Console tab. There are several settings, one for each kind of
 * content that can be displayed.
 *
 * @see Console.Prefs#newNotebookTabs
 */
enum type Console.Prefs.Tab {

  /**
   * Reuse an existing tab for the same visualization, regardless of the content type.
   */
  ALWAYS_REUSE

  /**
   * Reuse an existing tab for the same visualization with the same content type.
   */
  REUSE_SAME

  /**
   * Always open a new tab for this visualization.
   */
  ALWAYS_NEW
}
