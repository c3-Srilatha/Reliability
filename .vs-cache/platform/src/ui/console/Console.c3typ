/**
 * Implementation of all console functions.  These require console permission to the server.
 */
// TODO: PLAT-34625: the order of mixing types matters for deciding which `inst` method is picked
// Need to keep Singleton to front to have the inst to be picked up.
type Console mixes Singleton, Identified, Metadata, Configurable<Console.Prefs> {

  /**
   * This function is called to load the context for the console.  If executed in c3/c3, it
   * verifies access for the user's default env and app.  Otherwise, it verifies access
   * for the target env and app.
   *
   * @param stayInTag
   *           if true, init for the target env/app, even if c3/c3
   * @return information about the current user and tag context
   */
  init: function(stayInTag: boolean): ClientContext

  /**
   * This function is called to verify permissions for the console on a particular env/app.
   */
  @action(authz='always')
  authorize: function()

  /**
   * Get summaries of regular applications in the cluster to which the current user has console access. This filters
   * out test applications (such as "tst1234abcd"). The results are sorted by environment name, then app name.
   *
   * @see User#allApps
   */
  allApps: function(): [App.Summary]

  /**
   * Reload the accessible set of tags.
   * This is useful if new tags have been provisioned since the console was started.
   */
  // Tag
  refreshTags: function(): map<string, [Obj]>

  /**
   * Summarize the metadata and data issues for the current tag. This is used to produce an issue summary when
   * switching to a new tag.
   */
  // TagIssueSummary
  summarizeIssues: function(): !Obj

  /**
   * Visualize in the console.
   */
  visualize: function(value: any) js-client

  /**
   * Logs to the notebook cell executing this statement. Same as Console.print.
   */
  log: function(msg: !string) js-client

  /**
   * Print to the notebook cell executing this statement. Same as Console.log.
   */
  print: function(msg: !string) js-client

  /**
   * @return the metadata stored on the server required by Console.
   */
  metadata: cached function(): map<string, [Metadata]>

  inst: cached ~ java | js-client

  /**
   * Report the Microbench timing measurements from the Console in JavaScript to the PerfMetrics DB.
   *
   * @param metrics map of metric suffixes to times in seconds
   */
  measureTimes: function(metrics: map<string, double>)
}
