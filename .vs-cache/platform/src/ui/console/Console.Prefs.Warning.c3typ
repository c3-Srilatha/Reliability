/**
 * Enum of values defining warning colors used to stripe the navigation header. Note that these aren't fixed colors
 * as different brightnesses may be used in different parts of the page. They may also depend on whether light or
 * dark mode is used.
 *
 * @see Console.Prefs#modeWarning
 * @see AppMode
 */
enum type Console.Prefs.Warning {

  /**
   * Automatically select, for example: #RED for {@link AppMode.PROD prod} mode apps.
   */
  AUTO

  /**
   * Strongest warning, generally for production mode apps.
   */
  RED

  /**
   * General-purpose warning.
   */
  YELLOW

  /**
   * Typically used for "all OK".
   */
  GREEN

  /**
   * Typically used for "info".
   */
  TEAL

  /**
   * Desaturated alternate color.
   */
  GRAY
}
