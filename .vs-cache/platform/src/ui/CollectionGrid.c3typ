/**
 * This component manages a grid presentation of a collection of Obj instances.
 *
 * @see UiCollection
 */
type CollectionGrid mixes ReactClass {

  /**
   * The pre-built collection of instances used by the grid. This must be specified when the component is created.
   */
  collection: !UiCollection

  /**
   * If true, suppress editing of the content, even if the collection allows it.
   */
  readOnly: boolean

  /**
   * If true, suppress pagination of the collection, even if it appears to have multiple pages.
   */
  onePage: boolean

  /**
   * If true, hide columns whose content is empty. This means that the columns could change when moving from page to
   * page, but works well with collections of uniform models or when there is only a single page.
   */
  hideEmptyCols: boolean
}
