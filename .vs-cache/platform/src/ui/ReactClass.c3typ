/**
 * UI components implemented by a React class are represented by a type that mixes this type. It must implement the
 * `render` function as a member of the class it defines. An interface named "*Props", representing the data fields
 * defined by the component type, will be generated to define the "props" (passed to the constructor).
 *
 * ```type
 * type Hello mixes ReactClass {
 *   // who we are saying hello to
 *   who: !string
 * }
 * ```
 *
 * ```tsx
 * import React, { Component } from "react";
 *
 * interface HelloState {
 *   count: number
 * }
 *
 * class Hello extends Component<HelloProps, HelloState> {
 *   readonly state: HelloState = {
 *     count: 0
 *   }
 *
 *   render() {
 *     return <p>
 *              Hello,
 *              {this.props.who}
 *              {this.state.count > 0 ? '(' + this.state.count + ')' : ''}
 *            </p>;
 *   }
 *
 *   repeat() {
 *     this.setState(state => ({
 *       count: state.count + 1
 *     }));
 *   }
 * }
 *
 * export default Hello;
 * ```
 *
 * State management is private to the component and if it has any, it is recommended that a TypeScript type/interface
 * be defined within the file to declare the state.
 */
abstract type ReactClass mixes ReactComponent {

  /**
   * The render function must be implemented on the component as a member of the class the TSX implementation exports.
   */
  render: abstract member function() tsx-client
}
