/**
 * Result type for issue list queries - can represent either aggregated summaries or individual issues.
 * Mixins {@link App.Issue.Dimensions} to inherit all groupable fields (DRY).
 * Fields present depend on the groupBy parameter used in the query.
 */
type App.Issue.List mixes App.Issue.Dimensions, Result {

  /**
   * Count of issues for this grouping (when aggregating).
   */
  count: !int
}
