/**
 * Represents the association between a {@link Member} and a {@link Party}.
 */
type CanonicalMemberToParty mixes Canonical<CanonicalMemberToParty> {

  /**
   * {@link Member} ID.
   */
  memberId: !string

  /**
   * {@link Party} ID.
   */
  partyId: !string
}
