/**
 * Abstract type to represent a configuration value that changes based on the current theme's {@link UiSdlThemeTemplate#themeCategory}.
 */
abstract type UiSdlThemedValue<T> {

  /**
   * The value to use when the current theme's {@link UiSdlThemeTemplate#themeCategory themeCategory} is {@link UiSdlThemeCategory#DARK DARK}.
   */
  DARK: T

  /**
   * The value to use when the current theme's {@link UiSdlThemeTemplate#themeCategory themeCategory} is {@link UiSdlThemeCategory#LIGHT LIGHT}.
   */
  LIGHT: T
}
