@beta
@restful(endpoint='css-library')
type CssLibraryNpmModule {
  /**
   * Generates source files from the cssLibrary scss files in the current tag.
   */
  generateSourceFiles: function(): map<string, ContentValue> js-server

  /**
   * Returns an NPM module containing all the scss files from {@link generateSourceFiles}.
   */
  @restful(subPath='npm-modules/css.tgz')
  produceNpmModule: function(): !ContentValue js-server
}
