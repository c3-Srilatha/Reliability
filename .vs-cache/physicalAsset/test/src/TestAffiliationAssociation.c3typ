/**
 * `TestAffiliationAssociation` represents the association between a physical asset 
 * and the `TestAffiliationCategory`.
 * 
 * This entity is designed to establish a link between the `TestAffiliationCategory` 
 * and physical assets, making it possible to categorize assets for a specific 
 * test scenario or affiliation. It inherits from `PhysicalAssetCategoryAssociation`
 * which provides the fundamental structure for associating physical assets with categories.
 */
entity type TestAffiliationAssociation mixes PhysicalAssetCategoryAssociation<TestAffiliationCategory> schema name 'AFFIL_ASSOC'
