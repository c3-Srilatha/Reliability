/**
 * `TestCountryAssociation` represents the association between a physical asset 
 * and the `TestCountryCategory`.
 * 
 * This entity establishes a relationship between physical assets and a specific 
 * country category, providing a way to associate assets with a country-based classification.
 * It extends `PhysicalAssetCategoryAssociation`, which facilitates the connection of physical assets 
 * with various categories such as `TestCountryCategory`.
 */
entity type TestCountryAssociation extends PhysicalAssetCategoryAssociation<TestCountryCategory> schema name 'COUNTRY_ASSOC'
