/**
 * `PhysicalAssetCategory` represents the classification or grouping of physical assets.
 * It is an extendable entity type, allowing for flexible categorization of assets based on their characteristics or use cases.
 * Each category is associated with a description that provides details about the category's purpose or classification.
 */
entity extendable type PhysicalAssetCategory schema name 'ASST_CAT' {

  /**
   * A description of the category.
   * Provides additional context or information about the asset category, explaining its purpose or use.
   */
  description: string
}
