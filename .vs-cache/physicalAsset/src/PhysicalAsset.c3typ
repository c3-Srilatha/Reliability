/**
 * Represents a generic physical asset within the asset hierarchy graph.
 * It includes key information like location history, real-time locations, asset relations, and physical measurements.
 */
@denorm(target = 'PhysicalAssetHierarchyDenorm')
extendable entity type PhysicalAsset mixes AclEnabled, BaseAsset schema name "ASSET" {

  /**
   * The historical location/address for the asset.
   */
  @db(order='descending(timestamp)')
  locationHistory: [PhysicalAssetLocationHistory](parent)

  /**
   * The current location/address for this asset.
   */
  @db(timedValueHistoryField='locationHistory')
  location: PhysicalAssetLocation

  /**
   * A description of the physical asset.
   */
  description: string

  /**
   * Real-time location data for a moving asset.
   */
  realTimeLocations: [PhysicalAssetRealTimeLocation](asset)

  /**
   * Parent relations, where 'to' refers to this asset.
   */
  parentRelations: [PhysicalAssetHierarchyRelation](to)

  /**
   * Child relations, where 'from' refers to this asset.
   */
  childRelations: [PhysicalAssetHierarchyRelation](from)

  /**
   * Ancestors in the asset hierarchy throughout history.
   */
  denormAncestors: [PhysicalAssetHierarchyDenorm](to)

  /**
   * Descendants in the asset hierarchy throughout history.
   */
  denormDescendants: [PhysicalAssetHierarchyDenorm](from)

  /**
   * The historical relative positions of this physical asset.
   */
  @db(order='descending(timestamp)')
  relativePositionHistory: [PhysicalAssetRelativePositionHistory](parent)

  /**
   * The current relative position of this physical asset.
   */
  @db(timedValueHistoryField='relativePositionHistory')
  relativePosition: PhysicalAssetRelativePosition

  /**
   * Physical measurement series related to this asset.
   */
  measurements: [BasePhysicalMeasurementSeries](asset)

  /**
   * Point measurement series for time-series metrics related to the asset.
   */
  pointMeasurements: [PointPhysicalMeasurementSeries](asset)

  /**
   * The event history for this physical asset.
   */
   @db(order='descending(timestamp)')
  events: [PhysicalAssetEvent] (parent)
}
