/**
 * Represents the linear relationship between PhysicalAssets, where no parent to child heriarchy is needed
 * For instance, An Electric Tranmission Network modeled through series of transmission towers and power lines,
 * the towers and lines connecting the components of the network are modelled as Linearly related PhysicalAssets
 */
entity extendable type PhysicalAssetLinearRelation mixes Relation<PhysicalAsset>, TimedIntervalValue schema name 'PHYS_ASSET_LIN_REL'
