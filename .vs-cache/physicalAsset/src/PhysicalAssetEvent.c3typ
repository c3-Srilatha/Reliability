/**
 * History of events for a {@link PhysicalAsset}.
 */
entity extendable type PhysicalAssetEvent schema name 'PREDMAINT_EVENT' {

  /**
   * Value for the {@link PhysicalAssetEvent}
   */
  value: string

  /**
   * The responses for this event
   */
  responses: [PhysicalAssetEventResponse](event)

  /**
   * The {@link PhysicalAsset} that the event is associated with.
   */
  parent: !PhysicalAsset

  /**
   * The time at which the event occurred.
   */
  timestamp: !datetime = meta.created
}
