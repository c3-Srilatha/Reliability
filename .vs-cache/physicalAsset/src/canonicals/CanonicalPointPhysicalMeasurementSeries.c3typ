/**
 * Represents a series of measurements, which can be loaded from an external source.
 */
type CanonicalPointPhysicalMeasurementSeries mixes Canonical<CanonicalPointPhysicalMeasurementSeries> {

  /**
   * ID of Measurement Series
   */
  tagID: string

  /**
   * Name of Measurement Series
   */
  name: string

  /**
   * Description of Measurement Series
   */
  description: string

  /**
   * Unit of Measurement of Measurement Series
   */
  uom: string

  /**
   * Creation Date
   */
  creationDate: datetime

  /**
   * Sampling rate for measurements (in seconds)
   */
  samplingRate: decimal

  /**
   * Expected compression deviation (value between 0 to 1)
   */
  compressionDeviation: decimal

  /**
   * Maximum compression (in number of seconds)
   */
  compressionMax: decimal
}
