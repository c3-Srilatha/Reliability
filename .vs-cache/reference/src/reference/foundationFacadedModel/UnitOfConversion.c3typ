/**
 * This type stores the source unit, target unit, and the conversion factor between them.
 */
@facade(tenant='reference', tag='prod')
entity type UnitOfConversion schema name 'FNDFM_UNIT_CNVR' {

  /**
   * The source {@link Unit} of measurement.
   */
  sourceUom: string schema name 'SOURCE_UOM'

  /**
   * The target unit of measurement.
   */
  targetUom: string schema name 'TARGET_UOM'

  /**
   * The conversion factor from the source unit to the target unit.
   */
  conversionFactor: double schema name 'CONV_FACT'
}
