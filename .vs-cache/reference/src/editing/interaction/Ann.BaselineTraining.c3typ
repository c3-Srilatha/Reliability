/**
 * Configuration for baseline modelling.
 */
@annotation(appliesTo=['function'])
type Ann.BaselineTraining mixes Annotation {

  /**
   * The duration of time a baseline model is trained upon. Data _must_ be available
   * for this entire period for training to occur.
   *
   * Examples: '365d', '2y', '104w'
   */
  trainingPeriod: string

  /**
   * The interval of data a baseline model is trained and evaluated upon.
   */
  trainingInterval: string enum('QUARTER_HOUR', 'HOUR', 'DAY', 'MONTH')

  /**
   * The minimum percentage of data invalidation to warrant a re-training.
   */
  invalidationThreshold: double

  /**
   * The list of metrics to use as input to baseline training/evaluation.
   */
  featureMetrics: [string]
}
