/**
 * configuration for point time series treatment
 */
@annotation(appliesTo=['field'])
type Ann.Pointtimeseries mixes Annotation {

  /**
   * the field name for the input widget
   */
  inputField: string

  /**
   * the field name effective as of
   */
  dateField: string

  /**
   * the field name of the value field in popup from the ts point
   */
  pointField: string

  /**
   * the field name of the descriptionField field in popup from the ts point
   */
  descriptionField: string
}
