/**
 * Type as an input argument for {@link ReliabilityDataValidationTestDataOptions} to create basic test data for Reliability Data Validation.
 */
type ReliabilityDataValidationTestDataOptions {

  /**
   * Number the {@link Sensor}s, {@link ExpectedSensor}s, and {@link ReliabilityAssetEvent}s created
   * for the test data. The minimum value is 12.
   */
  numberOfRegistries: !int = 12

  /**
   * If is set to COMPLETE create a {@link ReliabilityAsset} with {@link ReliabilityAssetEvent}s.
   */
  assetEventsCheck: !string enum('COMPLETE', 'WARNING') = 'COMPLETE'

  /**
   * If is set to COMPLETE create a {@link ReliabilityAsset} with IS related by a {@link ReliabilityAssetSensorRelation}.
   * If is set to WARNING_NO_SENSORS_RELATION create a {@link ReliabilityAsset} without IS related by a {@link ReliabilityAssetSensorRelation}.
   * If is set to WARNING_SENSORS_NOT_INSTRUMENTED create a {@link ReliabilityAsset} with a not IS related by a {@link ReliabilityAssetSensorRelation}.
   */
  doSensorsExistForMlModeling: !string enum('COMPLETE', 'WARNING_NO_SENSORS_RELATION', 'WARNING_SENSORS_NOT_INSTRUMENTED') = 'COMPLETE'

  /**
   * If set to true, creates 2 Critical Sensors in addition to the {@link #numberOfRegistries} sensors being created.
   *
   * A Sensor is deemed to be critical, if it has abnormal values (like 0,1000) for a certain period of time.
   * The Critical sensors created currently have abnormal values for 2 month period.
   * For example, if `numberOfRegistries` is 6 and `loadCriticalSensors` is set to true, total 8 Sensors will be created, of which 2 are critical.
   */
  loadCriticalSensors: boolean = false

  /**
   * If set to `true`, one of the critical sensors created will have flatlining data for an entire year.
   * This option is not respected if {@link #loadCriticalSensors} is set to `false`.
   */
  makeCriticalSensorFlatLine: boolean = false

  /**
   * If set to COMPLETE create {@link Sensor}s with a {@link PointPhysicalMeasurementSeries} for the {@link ReliabilityAsset}.
   */
  sensorTimeSeriesExist: !string enum('COMPLETE', 'FAILED') = 'COMPLETE'

  /**
   * If set to COMPLETE create normalized {@link Sensor}s for the {@link ReliabilityAsset}.
   */
  sensorsNormalizationCheck: !string enum('COMPLETE', 'FAILED') = 'COMPLETE'

  /**
   * If set to COMPLETE create a {@link ReliabilityAsset} with an {@link AssetClass}.
   */
  assetClassField: !string enum('COMPLETE', 'WARNING') = 'COMPLETE'

  /**
   * If set to COMPLETE create a {@link ReliabilityAsset} with {@link ExpectedSensor}s related with {@link Sensor}s.
   */
  expectedSensorSensorCheck: !string enum('COMPLETE', 'WARNING') = 'COMPLETE'

  /**
   * If set to COMPLETE create a {@link ReliabilityAsset} with {@link Sensor}s related with {@link ExpectedSensor}s.
   */
  sensorExpectedSensorCheck: !string enum('COMPLETE', 'WARNING') = 'COMPLETE'

  /**
   * If set to COMPLETE create a {@link ReliabilityAsset} with {@link ExpectedSensor}s with {@link Feature}.
   */
  expectedSensorFeatureCheck: !string enum('COMPLETE', 'FAILED') = 'COMPLETE'

  /**
   * If set to COMPLETE create a {@link ReliabilityAsset} with {@link Sensor}s with {@link Feature}.
   */
  sensorFeatureCheck: !string enum('COMPLETE', 'FAILED') = 'COMPLETE'

  /**
   * If set to COMPLETE create a {@link ReliabilityAsset} without {@link FailureModeLibrary}.
   */
  failureModeLibraryCheck: !string enum('COMPLETE', 'WARNING') = 'COMPLETE'

  /**
   * The optional name of the {@link ReliabilityAsset} to be created.
   */
  assetName: string = 'Asset'

  /**
   * The optional units of the {@link PointMeasurement}s created on the {@link Sensor}s for the asset.
   * By default, 'rpm' is used.
   */
  unit: string = 'rpm'
}
