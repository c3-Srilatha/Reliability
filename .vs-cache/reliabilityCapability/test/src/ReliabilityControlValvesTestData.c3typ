/**
 * Type with functions to load/remove test data for the Reliability Control Valves Features.
 */
type ReliabilityControlValvesTestData {

  /**
   * Loads {@link ReliabilityAsset} and {@link Sensor} test data for the Reliability Control Valves Features.
   *
   * **NOTE**: The test data construct a CV data model enabling the {@link User} to trigger Sensor Correlation and Model Configuration
   * Jobs from the UI.
   */
  loadTestData: function(options: ReliabilityControlValvesTestDataOptions) js-rhino

  /**
   * Removes {@link ReliabilityAsset} and {@link Sensor} test data for the Reliability Control Valves Features.
   */
  removeTestData: function() js-rhino
}
