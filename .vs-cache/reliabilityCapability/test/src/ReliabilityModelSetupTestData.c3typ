/**
 * Basic test data for Model Setup workflow.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
type ReliabilityModelSetupTestData {

  /**
   * Create test data for Model setup, returns the created assets
   *
   * Creates three {@link ReliabilityAsset}s.

   * 1. A Turbine which has only valid data model without any model setup runs and {@link Sensor}s are not normalized.
   *
   * 2. A Compressor which has valid data model and a completed data preparation run, doesn't have any model configured.
   *
   * 3. A Boiler which has valid data model, a completed data preparation run and a `CHAMPION` model configured.
   *
   * @return An array of the three {@link ReliabilityAsset}s created.
   */
  loadTestData: function(): [!ReliabilityAsset] js-rhino

  /**
   * Remove test data that's created during {@link #loadTestData}.
   * @param assets
   *    The assets whose related test data needs to be removed.
   */
  removeTestData: function(assets: [ReliabilityAsset]) js-rhino

  /**
   * Create a {@link ReliabilityAsset} with different relations with {@link Sensor}s,
   * {@link ExpectedSensor}s, and {@link ReliabilityAssetEvent}s according to the options.
   * @param options
   *    The {@link ReliabilityDataValidationTestDataOptions} that modify the result of the generated data.
   * @return
   *    Returns a {@link ReliabilityAsset} .
   */
  loadDataValidationTestData: function(options: ReliabilityDataValidationTestDataOptions): !ReliabilityAsset js-rhino

  /**
   * Function to remove test data for DataValidation.
   * @param asset
   *    The {@link ReliabilityAsset} to be removed.
   * @return
   *    Returns true if all the informations of the asset is removed, or false otherwise.
   */
  removeDataValidationTestData: function(asset: !ReliabilityAsset): !boolean js-rhino

  /**
   * Generate basic data for DataValidation workflow and DatasetPreparation workflow
   * @param datasetPreparationSettings
   *    The {@link ReliabilityDataPreparationUiSettings} to use for the Data Preparation run.
   * @param dataValidationOptions
   *    The {@link ReliabilityDataValidationTestDataOptions} to use for the Data Validation run.
   * First runs {@link ReliabilityModelSetupTestData#loadDataValidationTestData}
   * Then runs a Data Preparation Job using {@link ReliabilityDataPreparationUiSettings#startJob}
   * @return {@link ReliabilityAsset} that was created.
   */
  loadDatasetPreparationTestData: function(datasetPreparationSettings: ReliabilityDataPreparationUiSettings, dataValidationOptions: ReliabilityDataValidationTestDataOptions): !ReliabilityAsset js-rhino

  /**
   * Function to remove test data for DataValidation and DatasetPreparation.
   * It is important to mention that this method can remove any asset not only the one generated by {@link ReliabilityModelSetupTestData#loadTestData}
   * @param asset
   *    The {@link ReliabilityAsset} to be removed.
   */
  removeDatasetPreparationTestData: function(asset: !ReliabilityAsset) js-rhino

  /**
   * Generate basic data for ModelConfiguration workflow
   * First runs {@link loadDatasetPreparationTestData} creating the asset and one completed run
   * Then runs {@link ReliabilityTestData#createReliabilityRiskModels} which deploys a model on the asset.
   * @param modelStatus
   *    The {@link MlModel.Route.Status.Label} of the dummy model that is deployed on asset.By Default, `CANDIDATE` is used.
   * @param datasetPreparationSettings
   *    The {@link ReliabilityDataPreparationUiSettings} to use for the Data Preparation run.
   * @param dataValidationOptions
   *    The {@link ReliabilityDataValidationTestDataOptions} to use for the Data Validation run.
   * @param timeRange
   *    The {@link TimeRange} used for training models, optional.
   * @returns JSON object with created asset in key `asset` and the deployed model in key `model`.
   */
  loadModelConfigTestData: function(modelStatus: MlModel.Route.Status.Label, datasetPreparationSettings: ReliabilityDataPreparationUiSettings, dataValidationOptions: ReliabilityDataValidationTestDataOptions, timeRange: TimeRange): json js-rhino

  /**
   * Function to remove test data created using {@link #loadModelConfigTestData}
   * @param asset
   *    The {@link ReliabilityAsset} to be removed. Passed subsequently to {@link #removeDatasetPreparationTestData}.
   */
  removeModelConfigTestData: function(asset: !ReliabilityAsset) js-rhino
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
