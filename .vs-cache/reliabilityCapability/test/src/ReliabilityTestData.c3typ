/**
 * Basic test data for Reliability.
*/
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
remix type ReliabilityTestData {

  /**
   * Helper method to generate historical records of feature importance values
   * of {@link GlobalFeatureImportanceHistory} type
   */
  generateGlobalFeatureImportanceHistory: function() js-rhino

  /**
   * Creates an asset with test data, sensors, expected sensors, and units.
   */
  createAsset: function(assetId: !string, assetName: !string, start: datetime, end: datetime): ReliabilityAsset js-rhino
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
