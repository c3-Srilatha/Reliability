/**
 * This type specifies the values used by {@link ModelPredictionChartHelper#parseChartDataMetrics}
 * to hold the {@link EvalMetricsResult}s for the {@link ReliabilityMlModel model} outputs metric, {@link ReliabilityAsset asset}
 * features metric and {@link Sensor sensor}s quantity metric.
 */
type ParseChartDataMetricsSpec mixes Spec {

  /**
   * The {@link ReliabilityMlModel#id} of the model to retrieve outputs for.
   */
  modelId: string serialized ReliabilityMlModel

  /**
   * The {@link ReliabilityAsset#id} of the asset on which the metric is evaluated.
   */
  assetId: string serialized ReliabilityAsset

  /**
   * The metric evaluation result of the {@link Sensor}s quantity metric.
   */
  sensorMetricResults: json

  /**
   * The metric evaluation result of the {@link ReliabilityMlModel} output metric.
   */
  outputMetricResults: json

  /**
   * The metric evaluation result of the {@link ReliabilityAsset} feature metric.
   */
  featureMetricResults: json
}
