/**
 * Type to define the data spec for Scatter Plot.
 */
type ScatterPlotChartDataSpec mixes Spec {
  /**
   * Metric name to be plotted on the x-axis.
   */
  xAxisMetric: !string

  /**
   * Metric name to be plotted on the y-axis.
   */
  yAxisMetric: !string

  /**
   * Start Date for the metric expression.
   */
  startDate: datetime

  /**
   * End Date for the metric expression.
   */
  endDate: datetime

  /**
   * Interval for the metric expression.
   */
  interval: string enum Interval

  /**
   * {@link ReliabilityAsset#id} whose metrics will be plotted.
   */
  assetId: !string

  /**
   * Grouping option used to color the points.
   */
  colorGrouping: string enum ScatterPlotColorByEnum

  /**
   * Metric name for filter metric.
   */
  filterMetric: string

  /**
   * Metric value comparator operator
   */
  filterMetricComparatorOperator: string

  /**
  * Metric value comparator value
  */
  filterMetricComparatorValue: double

}
