/**
 * Helper type for the definition list in the tab inside the Model Setup page.
 */
type ModelConfigDefinitionListHelper {

  /**
   * @param spec
   *    The spec to run the evaluate for {@link ReliabilityAsset}.
   * @param facilities
   *    The array of selected facilities represented in string form, it will call `JSON.parse` to make it an array
   *
   * Returns a json with 2 fields:
   *    - modelsConfigured: the configured models for the {@link ReliabilityAsset}
   *    - datasetsPrepared: this is get by doing a fetchCount on {@link ReliabilityMlDatasetPreparationRun}
   */
  getConfig: function(spec: FetchSpec, facilities: string): json js-rhino
}
