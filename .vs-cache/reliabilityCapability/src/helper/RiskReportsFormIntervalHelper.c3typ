/**
 * A helper type to get the {@link Interval}s for the risk reports form
 * based on the selected {@link ReliabilityAsset}s and the selected {@link Interval}s of alert report period.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
type RiskReportsFormIntervalHelper {

  /**
   * Get a list of {@link Interval}s for the risk reports form.
   * Retain the intervals that are neither finer than the sensor data intervals nor coarser than the period intervals.
   * @param datasetIntervals
   *        The list of {@link Interval}s corresponding to selected asset in the risk reports form.
   * @param beforePeriodInterval
   *        The {@link Interval} corresponding to the before alert report period.
   * @param afterPeriodInterval
   *        The {@link Interval} corresponding to the after alert report period.
   * @return A list of {@link Interval}s.
   */
  getIntervals: function(
    datasetIntervals: [Interval],
    beforePeriodInterval: Interval,
    afterPeriodInterval: Interval
  ): [Interval] js-rhino
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
