/**
 * Specification for {@link CreateMetricConfigurationPreviewChartHelper#getPreviewChartConfig} dynamic chart helper.
 */
type CreateMetricConfigurationPreviewChartHelperSpec mixes Spec {

  /**
   * The name of the {@ReliabilityMetric} to plot.
   */
  name: string

  /**
   * The metrics that are being used to create the new metric.
   * The preview chart will show the metrics that are being used to create the new metric.
   * If this array is empty, it means that the new metric that is being created is a simple metrics, that only involves
   * sensors.
   * If this array is not empty, it means that the new metric that is being created is a compound metric.
   */
  dependencyMetrics: [ReliabilityMetric]

  /**
   * The sensors that are being used to create the new metric.
   * The preview chart will show the sensors that are being used to create the new metric.
   * If this array is empty, it means that the new metric that is being created is a compound metric, that only involves
   * metrics.
   */
  dependencySensors: [Sensor]

  /**
   * The ids of the {@link ReliabilityAsset}s that can be related to the expression based on the sensor it contains.
   */
  relatedAssetIds: [string]

  /**
   * The ids of the {@link Facility} that can be related to the expression based on the sensor it contains.
   */
  relatedFacilityIds: [string]

  /**
   * The expression of the new metric that is being created.
   */
  newMetricExpression: string

  /**
   * The start time of the data to be plotted.
   */
  start: datetime

  /**
   * The end time of the data to be plotted.
   */
  end: datetime

  /**
   * The interval to plot all of the metric data in the chart at.
   */
  interval: string enum Interval
}
