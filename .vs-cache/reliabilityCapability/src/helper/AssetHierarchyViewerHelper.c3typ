// TODO: REL-6868 Add Asset Hierarchy page definition lists
/**
 * Helper type to get data for definition list on definition list on Asset hierarchy viewer page.
 */
@action(group='asset-onboarding-read')
type AssetHierarchyViewerHelper {

  /**
   * Calculates count of ReliabilityAsset and Facility, excluding orphaned assets.
   *
   * Returns
   * total number of {@link ReliabilityAsset}s,
   * number of {@link ReliabilityAsset}s that has not yet been mapped to {@link Sensor}s,
   * number of {@link ReliabilityAsset}s that are being mapped to {@link Sensor}s,
   * number of {@link ReliabilityAsset}s whose mapping to {@link Sensor}s is complete
   * the timestamp when the Asset Hierarchy was last updated
   * static text to view the Uploaded P&IDs
   */
  get: function(): json js-rhino
}
