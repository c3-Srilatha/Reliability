/**
 * Helper type that provides utility methods to retrieve {@link ReliabilityAssetAlert} count information.
 */
type ReliabilityAssetAlertCountHelper {

  /**
   * Helper method to retrieve the alerts information for "Alerts Overview" definition list on "To Do Alerts" page.
   *
   * @returns {@link Map} containing the alerts information.
   *   - `allAlerts`: Total number of alerts.
   *   - `openAlerts`: Number of open alerts.
   *   - `linkedAlerts`: Number of linked alerts.
   *   - `closedAlerts`: Number of closed alerts.
   *   - `mutedAlerts`: Number of muted alerts.
   *
   * It is expected that `allAlerts` = `openAlerts` + `linkedAlerts` + `closedAlerts` + `mutedAlerts`.
   */
  getAlertCountInfo: function(filter: Filter): map<string, int> js-rhino
}
