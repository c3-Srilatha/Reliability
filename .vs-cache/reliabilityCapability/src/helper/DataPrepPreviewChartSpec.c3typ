/**
 * Specification for {@link DataPrepPreviewChart#getChartData} dynamic chart helper.
 */
type DataPrepPreviewChartSpec mixes Spec, ReliabilityDataPreparationUiMaskSettings {

  /**
   * The asset which is undergoing data preparation for modeling purposes.
   */
  asset: !ReliabilityAsset

  /**
   * The user-selected proposed start time for model training.
   */
  windowStart: !datetime

  /**
   * The user-selected proposed end time for model training.
   */
  windowEnd: !datetime

  /**
   * The sensors whose measurements to plot.
   */
  sensors: [Sensor]

  /**
   * Which mask options should be included in the chart's preview of the combined training mask.
   */
  trainingMaskOptions: [string enum('nonOperationalMask', 'eventMask', 'ruleMask', 'dateRangeMask')]

  /**
   * Which mask options should be included in the chart's preview of the combined inference mask.
   */
  inferenceMaskOptions: [string enum('nonOperationalMask', 'eventMask', 'ruleMask')]

  /**
   * If true, will plot across the entire range for which any of the provided
   * {@link sensors} have normalized data. Otherwise, uses {@link windowStart}
   * and {@link windowEnd} as the plotting range.
   */
  showAllSensorData: boolean = false
  /**
   * ID of the spinner component wrapping the chart to disable once data is received.
   */
  spinnerComponentId: string

  /**
   * {@link Interval} used for the dataset preview chart.
   */
  interval: string enum Interval
}
