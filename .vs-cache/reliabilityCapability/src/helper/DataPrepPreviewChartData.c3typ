/**
 * The data used by `Reliability.AssetDataPreparationPreviewChart`.
 * Returned by {@link DataPrepPreviewChart#getChartData} function.
 */
type DataPrepPreviewChartData {

  /**
   * The event data to show.
   */
  eventData: FetchResult<ReliabilityAssetEvent>

  /**
   * The timeseries data to show.
   * The metric expressions in this result are replaced with
   * stringified y-axis field configurations.
   */
  timeseriesData: EvalMetricsResult

  /**
   * The mask data to shade on the chart.
   */
  maskShadedAreas: json
}
