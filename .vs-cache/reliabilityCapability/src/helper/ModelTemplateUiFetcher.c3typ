/**
 * Helper type for fetching ModelTemplates for a particular {@link ReliabilityMl.Project}.
 */
type ModelTemplateUiFetcher {
  /**
   * Fetches the ModelTemplates for a particular {@link ReliabilityMl.Project}.
   * The default model template will be sorted to the front of the list, and any specified sorting will be applied after.
   * Translation fields will also be substituted with the default fields if translations are not available.
   */
  fetch: function(spec: FetchSpec, project: !ReliabilityMl.Project): FetchResultWithTotalCount<ModelTemplate> js-rhino
}
