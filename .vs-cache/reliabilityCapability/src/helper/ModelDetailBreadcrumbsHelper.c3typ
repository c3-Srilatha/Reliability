/**
 * Type to fetch display text in model detail breadcrumbs.
 */
type ModelDetailBreadcrumbsHelper {

  /**
   * A unique identifier for the breadcrumb in the model detail navigation.
   */
  id: !string
  /**
   * Retrieves display text for model detail breadcrumb
   */
  get: member function(include: string): json js-rhino
}
