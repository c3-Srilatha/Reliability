/**
 * Helper type to display model config summary in model setup detail tab.
 */
type ModelConfigUiHelper {

  /**
   * Returns model config summary for the provided {@link ReliabilityAsset}. Returns the following:
   *
   * liveModel: The live {@link ReliabilityRiskMlModel} for the asset
   *
   * daysLive: The number of days the live {@link ReliabilityRiskMlModel} has been live
   *
   * lastTrainedModel: The most recently trained {@link ReliabilityRiskMlModel} for this asset
   *
   * lastUpdatedDate: When the asset last had its {@link ReliabilityRiskMlModel}s modified
   *
   * numUnretiredModels: The number of unretired models currently deployed for this asset
   *
   * numRetiredModels: The number of retired models currently deployed for this asset
   */
  fetchReliabilityRiskModelSummary: function(assetId: !string): json js-rhino
}
