/**
 * Helper type to fetch data for Assets Grids.
 */
type AssetDetailHelper {
  /**
   * Fetch all {@link ReliabilityAsset}s that meet the spec parameters.
   *
   * If the spec, specifies a risk score value filter, only
   * {@link ReliabilityAsset}s that meet the spec parameters will be returned.
   * @param spec
   *           The fetch stream specification to use for the query.
   * @return A {@link FetchResult} containing the reliability assets that match the spec.
   */
  fetch: function(spec: FetchStreamSpec): FetchResult<ReliabilityAsset> js-rhino

  /**
   * Fetch the count all {@link ReliabilityAsset}s that meet the spec parameters.
   *
   * If the spec, specifies a risk score value filter, only the number of
   * {@link ReliabilityAsset}s that meet the spec parameters will be returned.
   * @param spec
   *           The fetch stream specification to use for the query.
   * @return The count of reliability assets that match the spec.
   */
  fetchCount: function(spec: FetchStreamSpec): int js-rhino

  /**
   * @param facilityIdsStr
   *           The serialized string array of {@link Facility#id}s for which the return results have to be filtered.
   *
   * Returns the following filtered for a given `facilityId`.
   *
   * - numAssets: count of {@link ReliabilityAsset}s
   * - numOpenAlerts: Count of all open {@link ReliabilityAssetAlert}s
   * - numOpenSensorAlerts: Count of all open {@link SensorHealthAlert}s
   *
  * @return The filtered counts for the specified facilities, or counts of 0 if `facilityIdsStr` is nullish.
   */
  get: function(facilityIdsStr: string): json js-rhino

  /**
   * If the spec, specifies a risk score value filter,
   * the filters are then processed and modified to subsequently fetch {@link ReliabilityAsset}
   * that match the filter.
   * @param filterSpec
   *           The filter specification string to process.
   * @return A JSON object containing the processed filter.
   */
  processFilter: private inline function(filterSpec: string): json js-rhino
}
