/**
 * Type to fetch chart config for General Model Detail Prediction Chart.
 *
 * See `rel-dev-model-output-features-fetch.c3doc` for more details about model output prediction display.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
type ModelPredictionChartHelper {

  /**
   * Function to fetch general model detail prediction chart config.
   * @param payload
   *           Additional payload data for the chart configuration.
   * @param modelId
   *           The ID of the model to get chart config for.
   * @param alertId
   *           The ID of the alert to get chart config for.
   * @param spinnerId
   *           The ID of the spinner element.
   * @param deploymentStatus
   *           The deployment status of the model.
   * @return JSON object containing the chart configuration.
   */
  getChartConfig: function(payload: json = {}, modelId: string, alertId: string, spinnerId: string, deploymentStatus: string): json js-rhino

  /**
   * Used by the chart's `advancedDataSpec`. This function should return the data to be used in the chart.
   * @param spec
   *           The specification for chart data retrieval.
   * @return JSON object containing the chart data.
   */
  getChartData: function(spec: json = {}): json js-rhino

  /**
   * Generates a list of objects each representing a y-axis field that denotes the model outputs.
   *
   * @param outputNames
   *           The list of model outputs to be converted to y-axis fields.
   * @param modelId
   *           The ID of the model to which the model outputs belong.
   *
   * @return The json array of y-axis fields.
   */
  getYAxisModelOutputs: inline function(outputNames: [string], modelId: !string): json js-rhino

  /**
   * Generates a list of objects each representing a y-axis field that denotes the model features. If optional param run is included, this will calculate and chart training min/max for each feature.
   *
   * @param featureIds
   *           The list of model features to be converted to y-axis fields.
   * @param assetId
   *           The ID of the asset on which the moteric is evaluated.
   * @param model
   *           (Optional) The ReliabilityMlModel from which the the dataset preparation run will be obtained
   *
   * @return The json array of y-axis fields.
   */
  getYAxisModelFeatures: inline function(featureIds: [string], assetId: !string, model: ReliabilityMlModel): json js-rhino

  /**
   * Retrieves the outputs of a model by its ID or by its corresponding alert ID,
   * prefixes each output name based on the model type and if the output is primary or not.
   *
   * @param modelId
   *           The ID of the model to retrieve outputs for.
   * @param alertId
   *           The ID of the alert to retrieve the model outputs for.
   * @param spec
   *           The fetch specification to use.
   *
   * @return The outputs of the model.
   */
  getModelOutputs: function(modelId: string serialized ReliabilityMlModel, alertId: string serialized ReliabilityAssetAlert, spec: FetchSpec): FetchResult<json> js-rhino

  /**
   * Evaluates the metrics for the {@link ReliabilityMlModel model} outputs, {@link ReliabilityAsset asset} features and
   * {@link Sensor sensor}s quantity and returns them as an object.
   *
   * @param spec
   *           A {@link ModelPredictionChartHelper.EvalChartDataMetricsSpec} to extract the data and evaluate the metrics.
   *
   * @return A json object with the output of the {@link EvalMetricsResult}s.
   */
  evalChartDataMetrics: private inline function(spec: ModelPredictionChartHelper.EvalChartDataMetricsSpec): json js-rhino

  /**
   * Groups the {@link EvalMetricsResult}s that are defined into an object.
   *
   * This function stores {@link EvalMetricsResult}s into an object and each {@link EvalMetricsResult}
   * is placed in its corresponding object key.
   *
   * @param spec
   *           A {@link ParseChartDataMetricsSpec} to group the {@link EvalMetricsResult}s.
   *
   * @return An {@link EvalMetricsResult} instance.
   * Example:
   * ```json
   * {
   *    "modelId": {
   *      "ModelOutput0": {
   *        "tsInfo": {...},
   *        "unit": {
   *          "id": "dimensionless"
   *        },
   *        "_data": [...],
   *        "_kind": "REGULAR"
   *      },
   *      ...
   *    },
   *    "assetId": {
   *      "featureid1": {
   *        "tsInfo": {...},
   *        "unit": {
   *          "id": "dimensionless"
   *        },
   *        "_data": [...],
   *        "_kind": "REGULAR"
   *      },
   *      ...
   *    },
   *    "sensorId1": {
   *      "Quantity": {
   *        "tsInfo": {...},
   *        "unit": {
   *          "id": "dimensionless"
   *        },
   *        "_data": [...],
   *        "_kind": "REGULAR"
   *      },
   *      ...
   *    }
   * }
   * ```
   */
  parseChartDataMetrics: private inline function(spec: ParseChartDataMetricsSpec): EvalMetricsResult js-rhino
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
