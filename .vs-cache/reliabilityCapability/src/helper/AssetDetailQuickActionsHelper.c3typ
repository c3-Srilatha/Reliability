/**
 * Helper type used to fetch the quick actions displayed on the Asset Detail Overview tab.
 */
type AssetDetailQuickActionsHelper {

  /**
   * The displayed title of the quick action.
   */
  title: string

  /**
   * The displayed description of the quick action.
   */
  description: string

  /**
   * The action suffix to trigger upon click of the quick action.
   */
  actionSuffix: string

  /**
   * Fetch Quick actions that enable a user to
   *  - Create a {@link ReliabilityAssetCase}
   *  - Create a {@link WorkOrder}
   *  - View and change alerting statuses
   *  - Manage ML Models for an asset
   *  - Show {@link ReliabilityAssetAlert}s for an asset
   */
  fetchQuickActions: function(assetId: !string): FetchResult<AssetDetailQuickActionsHelper> js-rhino
}
