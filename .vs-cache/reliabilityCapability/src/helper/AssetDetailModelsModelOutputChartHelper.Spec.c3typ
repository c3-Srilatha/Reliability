/**
 * Type that defines the specification to fetch chart configs for the Model Output Chart located in the Asset Models tab panel of the Asset Detail Page.
 */
type AssetDetailModelsModelOutputChartHelper.Spec {
  /**
   * The ID of the {@link ReliabilityMlModel} for which the chart is populated.
   */
  modelId: string

  /**
   * The ID of the {@link ReliabilityAsset} for which the chart is to be populated.
   */
  assetId: string

  /**
   * The ID of the {@link ReliabilityAssetToModelRelation} to which the asset and the model belongs to.
   */
  relationId: string

  /**
   * The model outputs to be shown in the chart.
   */
  outputNames: [string]

  /**
   * The model features to be shown on the chart.
   */
  features: [string]

  /**
   * The interval using which the chart is to be evaluated.
   */
  interval: string

  /**
   * The start datetime for which the chart is to be evauluated.
   */
  startDate: datetime

  /**
   * The end datetime for which the chart is to be evaluated.
   */
  endDate: datetime
}
