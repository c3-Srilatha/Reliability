/**
 * Type to retrieve data for the model config UI settings that is used in the RetrainModalContinueActionsEpic in the reliability package.
 */
type RetrainModalContinueActionsHelper {

  /**
   * Get the model config UI settings.
   * @param modelId
   *        A particular model that supplies dataset, template, and pipeline hyperparameters
   *        for configuring the model UI settings.
   * @param assetId
   *        If not null, obtain the dataset from the designated asset rather than the model.
   * @returns The model config UI settings.
   */
  getModelConfigUiSettings: private function(modelId: !string, assetId: string): ModelConfigUiSettings js-rhino
}
