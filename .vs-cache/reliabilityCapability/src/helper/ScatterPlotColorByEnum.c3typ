/**
 * Enum type that specifies the different ways to color the points presented in the scatter plot.
 */
enum type ScatterPlotColorByEnum {
  /**
   * Color points by year
   */
  YEAR = 'Year'

  /**
   * Color points by quarter
   */
  QUARTER = 'Quarter'

  /**
   * Color points by month
   */
  MONTH = 'Month'

  /**
   * Color points by risk score
   */
  RISK_SCORE = 'Risk Score'

  /**
   * Color points by percentage of data missing
   */
  PERCENTAGE_DATA_MISSING = '% Data Missing'
}
