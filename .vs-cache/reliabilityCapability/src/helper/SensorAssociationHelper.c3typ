/**
 * Helper type providing helper functions for BulkSensorAssociationStartUiWorkflow in the UI in the reliability package.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
type SensorAssociationHelper {
  /**
   * Function to retrieve the {@link Sensor} count based on the following parameters.
   *
   * @param assetId
   *     String serialized {@link ReliabilityAsset}. The function will use the provided asset to only retrieve the sensors
   *     linked to overarching plant for that asset.
   * @param includeSensorMatchPatterns
   *     String representation of an array containing the patterns for sensors that should be included in the count.
   * @param excludeSensorMatchPatterns
   *     String representation of an array containing the patterns for sensors that should be excluded in the count.
   * @return
   *     The count of sensors that match the provided patterns and belong to the plant of the provided assets.
   */
  fetchSensorCount: function(assetId: !string serialized ReliabilityAsset, includeSensorMatchPatterns: string = '[]', excludeSensorMatchPatterns: string = '[]'): !int js-rhino
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
