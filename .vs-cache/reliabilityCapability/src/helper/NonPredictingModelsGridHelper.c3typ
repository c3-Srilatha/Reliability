/**
 * Helper type for fetching non-predicting models.
 */
type NonPredictingModelsGridHelper {

  /**
   * Fetches {@link ReliabilityAssetToRiskModelRelation} and return the
   * non-predicting models.
   *
   * @param spec
   *          spec of the fetch call
   *
   * @return a collection of {@link ReliabilityAssetToRiskModelRelation} objects
   */
  fetch: function(spec: FetchSpec): json js-rhino

  /**
   * Fetch count method for the {@link NonPredictingModelsGridHelper#fetch}
   *
   * @param spec
   *          spec of the fetchCount call
   *
   * @return the number of total {@link ReliabilityAssetToRiskModelRelation}
   */
  fetchCount: function(spec: FetchSpec): int js-rhino
}
