/**
 * Type that defines the specification to fetch chart configs for the Sensor Value Chart located in the Protection Loop tab panel of the Protection Loop Alert Detail Page.
 */
type ProtectionLoopAlertDetailChartHelper.Spec mixes Spec {
  /**
   * The timezone conversion boolean for which the chart is to be evaluated.
   */
  noTimeZoneConversion: boolean

  /**
   * The time interval at which the chart should be evaluated.
   */
  interval: string

  /**
   * The start datetime from which the chart evaluation begins.
   */
  start: datetime

  /**
   * The end datetime from which the chart evaluation ends.
   */
  end: datetime
}
