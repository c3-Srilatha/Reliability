/**
 * Fetches data for the model output distribution histogram.
 */
type ModelOutputDistributionHistogramHelper {

/**
 * Fetches the histogram data for a given model.
 * This function retrieves and processes the output distribution data for the specified model.
 * @param modelId The ID of the model to fetch the histogram data for.
 * @returns An {@link EvaluateResult} containing the histogram data.
 */
  getHistogramData: function(modelId: !string): EvaluateResult js-rhino
}
