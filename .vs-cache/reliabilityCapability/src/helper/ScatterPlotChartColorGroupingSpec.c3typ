/**
 * Type to define the a color grouping scheme for scatter plot.
 */
type ScatterPlotChartColorGroupingSpec mixes Spec {
  /**
   * List of right, inclusive bounds for the buckets to use. Implied left-most boundary of 0.
   * For example, if this field is [0.33, 0.67, 1.00], then the buckets are: [0, 0.33], (0.33, 0.67], (0.67, 1.00].
   */
  buckets: ![double]

  /**
   * List of labels corresponding to the buckets. Categories and buckets are matched by index.
   */
  categories: ![string]

  /**
   * List of colors (assumed to be hex) to use for the groupings. Colors and buckets are matched by index.
   */
  colors: ![string]
}
