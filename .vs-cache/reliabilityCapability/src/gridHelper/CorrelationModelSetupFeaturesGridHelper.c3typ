/**
 * Helper type for generating component configuration for the correlation model setup grids.
 */
type CorrelationModelSetupFeaturesGridHelper {

  /**
   * Get latest correlated features for the {@link ReliabilityAsset asset} with the given
   * {@link ReliabilityAsset#id assetId}.
   *
   * @param assetId
   *          The id of the {@link ReliabilityAsset asset} for which to get the latest correlated features data
   * @param spec
   *          The spec for the correlated features data
   * @returns The latest correlated features data. The returned `objs` have the following keys:
   *          `id` - `string`: sensor id
   *          `correlationValue` - `double`: correlationValue
   *          `sensorName` - `string`: sensor.nam
   *          `latestValue` - {@link Dimension}: sensor latest pointMeasurement
   *          `daysSinceLastObservation` - `int`: days since latest pointMeasurement timestamp
   *          `source` - `string`: 'Reliability.CorrelationJob' || 'Reliability.UserAdded'
   */
  getLatestCorrelatedFeaturesData: function(
    assetId: !string,
    spec: FetchSpec
  ): !FetchResultWithTotalCount<json> js-rhino

  /**
   * Get latest excluded features for the {@link ReliabilityAsset asset} with the given
   * {@link ReliabilityAsset#id assetId}.
   *
   * @param assetId
   *          The id of the {@link ReliabilityAsset asset} for which to get the latest excluded correlated features data
   * @param spec
   *          The spec for the excluded correlated features data
   * @returns The latest excluded correlated features data. The returned `objs` have the following keys:
   *          `id` - `string`: sensor id
   *          `correlationValue` - `double`: correlationValue
   *          `sensorName` - `string`: sensor.nam
   *          `latestValue` - {@link Dimension}: sensor latest pointMeasurement
   *          `daysSinceLastObservation` - `int`: days since latest pointMeasurement timestamp
   *          `source` - `string`: 'Reliability.CorrelationJob' || 'Reliability.UserAdded'
   */
  getLatestExcludedFeaturesData: function(
    assetId: !string,
    spec: FetchSpec
  ): !FetchResultWithTotalCount<json> js-rhino
}
