/**
 * Enum to represent the status of a {@link ModelConfigRun}
 */
enum type ReliabilityOrchestrator.RunStatus {
  /**
   * Indicates that the run has not started yet.
   */
  NOT_STARTED = 'NOT STARTED'

  /**
   * Indicates that the run is currently in progress.
   */
  IN_PROGRESS = 'IN PROGRESS'

  /**
   * Indicates that the run has completed successfully.
   */
  COMPLETE = 'COMPLETE'

  /**
   * Indicates that the run has failed.
   */
  FAILED = 'FAILED'
}
