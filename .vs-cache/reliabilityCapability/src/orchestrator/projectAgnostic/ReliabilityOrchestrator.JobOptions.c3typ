/**
 * Job options for customizing execution of ReliabilityOrchestrator jobs.
 */
type ReliabilityOrchestrator.JobOptions mixes JobOptions {

  /**
   * How many {@link MlWorkflowCoordinatableResult} objects may be upserted
   * at a time? If this number is too low, then the job will take a long time
   * to run due to the iterative nature of upserts. If this number is too
   * high, it may cause an overflow during upsert to PostgreSQL. The default
   * value of 2000 works well for most cases.
   */
  upsertBatchSize: private int = 2000

  /**
   * Maximum time allocated for execution of a job.
   */
  jobTimeoutMinutes: int

  /**
   * Maximum time allocated for performing a single operation on a single {@link MlModel}.
   */
  operationTimeoutMinutes: int
}
