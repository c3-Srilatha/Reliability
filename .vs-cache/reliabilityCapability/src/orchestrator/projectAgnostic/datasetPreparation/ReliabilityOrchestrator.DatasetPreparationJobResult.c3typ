/**
 * Represents the dataset preparation workflow that will be executed for a single {@link ReliabilityAsset} and for
 * a specific {@link MlProject}.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
entity type ReliabilityOrchestrator.DatasetPreparationJobResult extends MlWorkflowCoordinatableResult type key 'REL_DP' {

  name: ~ = 'Reliability_DatasetPreparation'

  /**
   * The {@link ReliabilityAsset} for which dataset preparation is executed.
   */
  assets: ![ReliabilityAsset]

  /**
   * Specify the {@link MlProject} for which dataset preparation should be run.
   */
  project: !ReliabilityMl.Project

  /**
   * Spec that was used to specify execution constraints for this dataset preparation run.
   */
  spec: !ReliabilityMlDatasetPreparationSpec

  /**
   * Options to configure the execution of the dataset preparation job.
   */
  options: ReliabilityOrchestrator.JobOptions

  /**
   * Reference to the {@link ReliabilityMlDatasetPreparationRun} which was created as part of this Job.
   */
  datasetPreparationRun: ReliabilityMlDatasetPreparationRun

  /**
   * Creates a dataset preparation run for all {@link ReliabilityAsset}s according to the passed in {@link ReliabilityMlDatasetPreparationSpec}.
   * This workflow:
   * 1) Executes `ReliabilityAsset.prepareMlDatasetsAndSensorDataReports()` for all the assets
   * 2) Refreshes calc fields on asset
   * 3) Creates {@link Feature.Set.Snapshot}s for the {@link ReliabilityMlDatasetPreparationRunCommon#xFeatures} and
   * {@link ReliabilityMlDatasetPreparationRunCommon#yFeatures}, for both the train and validation periods.
   * 4) Outputs {@link ReliabilityMlDatasetPreparationRunCommon}.
   */
  createDatasetPreparationWorkflow: function(
    assets: ![ReliabilityAsset],
    spec: !ReliabilityMlDatasetPreparationSpec,
    operationTimeout: string
  ): Workflow py

  startWorkflow: ~ py
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
