/**
 * Represents a model inference job that can be executed on {@link ReliabilityAsset}s and a given {@link MlProject}.
 */
entity type ReliabilityOrchestrator.DatasetPreparationJob
mixes ReliabilityOrchestrator.Job<ReliabilityOrchestrator.DatasetPreparationJobSpec, ReliabilityOrchestrator.DatasetPreparationJobRun>
schema name 'REL_DP_JOB' {

  createWorkflow: ~ py

  doStart: ~ py
}
