/**
 * Manages the execution of a set of datast preparation jobs run for multiple {@link ReliabilityAsset}s.
 * This is created by {@link ReliabilityOrchestrator.DatasetPreparationJob#start}.
 */
entity type ReliabilityOrchestrator.DatasetPreparationJobRun
extends MlWorkflowCoordinatable<ReliabilityOrchestrator.DatasetPreparationJobResult>
mixes ReliabilityOrchestrator.JobRun<ReliabilityOrchestrator.DatasetPreparationJob, ReliabilityOrchestrator.DatasetPreparationJobSpec>
type key 'REL_DP' {

  generateNextResults: ~ py

  startResult: ~ py

  completeResult: ~ py

  afterComplete: ~ py
}
