/**
 * Defines the specification for executing a dataset preparation job within the {@link ReliabilityOrchestrator}.
 * This type configures parameters for dataset generation and preparation before model training.
 */
type ReliabilityOrchestrator.DatasetPreparationJobSpec mixes ReliabilityOrchestrator.JobSpec {

  /**
   * Specify the assetFilter for which datasets should be prepared.
   */
  assetFilter: !string

  /**
   * Spec to customize the execution of the dataset preparation job.
   */
  spec: !ReliabilityMlDatasetPreparationSpec

  /**
   * If the job is started through the UI, this field will store the settings set through the UI.
   */
  uiSettings: ReliabilityDataPreparationUiBaseSettings
}
