/**
 * Represents the automated retraining workflow that will be executed to retrain a single
 * {@link ReliabilityMlModel} using the project's configured retraining lambda.
 */
entity type ReliabilityOrchestrator.AutomatedRetrainingJobResult extends MlWorkflowCoordinatableResult type key 'REL_AR' {

  name: ~ = 'Reliability_AutomatedRetraining'

  /**
   * The {@link ReliabilityMlModel} to be retrained. This model must have an associated project
   * with a configured retrainingWorkflowLambda.
   */
  model: !ReliabilityMlModel

  /**
   * Contains the retrained {@link ReliabilityMlModel} that is output by the workflow created using lambda.
   */
  retrainedModel: private ReliabilityMlModel

  /**
   * Errors when {@link ReliabilityMl.Project#retrainingWorkflowLambda} failed, did not produce any retrained models, or returned an error.
   */
  errorMessages: [string]

  /**
   * Starts the automated retraining workflow for the specified model using the project's
   * configured retraining lambda.
   */
  startWorkflow: ~ py
}
