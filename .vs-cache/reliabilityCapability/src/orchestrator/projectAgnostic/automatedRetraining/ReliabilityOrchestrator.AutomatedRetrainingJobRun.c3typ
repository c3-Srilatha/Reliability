/**
 * Manages the execution of a set of Automated Retraining jobs run for multiple {@link ReliabilityMlModel}s.
 * This is created by {@link ReliabilityOrchestrator.AutomatedRetrainingJob#start}.
 */
entity type ReliabilityOrchestrator.AutomatedRetrainingJobRun
extends MlWorkflowCoordinatable<ReliabilityOrchestrator.AutomatedRetrainingJobResult>
mixes ReliabilityOrchestrator.JobRun<ReliabilityOrchestrator.AutomatedRetrainingJob, ReliabilityOrchestrator.AutomatedRetrainingJobSpec>
type key 'REL_AR' {
  /**
   * Returns all {@link ReliabilityOrchestrator.AutomatedRetrainingJobResult}s associated with this run.
   * @param spec
   *    Common specifications for fetching the results.
   * @return a list of {@link ReliabilityOrchestrator.AutomatedRetrainingJobResult}.
   */
  retrainingResults: member function(spec: FetchSpec): ![ReliabilityOrchestrator.AutomatedRetrainingJobResult] py

  generateNextResults: ~ py

  startResult: ~ py

  completeResult: ~ py

  afterComplete: ~ py
}
