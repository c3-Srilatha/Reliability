/**
 * Represents an automated retraining job that can be executed on multiple {@link ReliabilityMlModel}s
 * using their associated project's retraining workflow lambda.
 */
entity type ReliabilityOrchestrator.AutomatedRetrainingJob
mixes ReliabilityOrchestrator.Job<ReliabilityOrchestrator.AutomatedRetrainingJobSpec, ReliabilityOrchestrator.AutomatedRetrainingJobRun>
schema name 'REL_AR' {

  name: ~

  createWorkflow: ~ py

  doStart: ~ py
}
