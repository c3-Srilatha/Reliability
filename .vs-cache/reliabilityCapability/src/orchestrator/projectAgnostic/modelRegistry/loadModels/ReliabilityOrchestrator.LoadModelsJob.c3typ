/**
 * Represents a job to load models that have been registered using {@link ReliabilityOrchestrator.RegisterModelsJob}s,
 * using the {@link File}s output by these jobs.
 */
entity type ReliabilityOrchestrator.LoadModelsJob schema name 'REL_LOD' {

  /**
   * Specify the {@link File}s created by {@link ReliabilityOrchestrator.RegisterModelsJob}s, that should be used
   * to load {@link ReliabilityMlModel}s in the target environment.
   */
  files: ![File]

  /**
   * Forces the deployment of the {@link ReliabilityMlModel} in the target environment, even if validation
   * checks fail.
   */
  force: boolean = false

  /**
   * Starts the load models job for the {@link #files} provided.
   * The resulting {@link ReliabilityOrchestrator.LoadModelsJobRun} can be used to summarize the evaluation results.
   *
   * @param options
   *           To customize the execution of the job.
   *
   * @return handle to the async operation.
   */
  start: member function(options: ReliabilityOrchestrator.JobOptions): !MlOperationRun<ReliabilityOrchestrator.LoadModelsJobRun> py
}
