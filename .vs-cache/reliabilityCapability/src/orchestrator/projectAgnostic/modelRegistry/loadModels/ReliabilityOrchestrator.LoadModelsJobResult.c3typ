/**
 * Represents the load models workflow that will be executed to load a single {@link ReliabilityMlModel} in the target
 * environment.
 */
entity type ReliabilityOrchestrator.LoadModelsJobResult extends MlWorkflowCoordinatableResult type key 'REL_LOD' {

  name: ~ = 'Reliability_LoadModels'

  /**
   * The id of the {@link ReliabilityMlModel} in the source environment that is being migrated.
   */
  sourceModelId: !string

  /**
   * The uri of the {@link ModelRegistry.Entry} corresponding to the {@link #sourceModelId} which will be used to
   * migrate the model to the target environment.
   */
  uri: !string

  /**
   * Forces the deployment of the {@link ReliabilityMlModel} in the target environment, even if validation
   * checks fail.
   */
  force: boolean = false

  /**
   * Spec that was used to specify execution constraints for this register models workflow.
   */
  options: ReliabilityOrchestrator.JobOptions

  /**
   * The {@link ReliabilityModelRegistry.TargetEntry} created for the migrated {@link ReliabilityMlModel}, after the load model
   * workflow completes.
   */
  targetEntry: ReliabilityModelRegistry.TargetEntry

  startWorkflow: ~ py
}
