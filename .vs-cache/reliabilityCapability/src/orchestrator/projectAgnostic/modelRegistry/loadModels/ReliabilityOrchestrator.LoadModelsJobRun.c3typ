/**
 * Manages the execution of a set of load model job runs for each {@link ReliabilityMlModel} that should be loaded in
 * the target environment. This is created by {@link ReliabilityOrchestrator.LoadModelsJob#start}.
 */
entity type ReliabilityOrchestrator.LoadModelsJobRun extends MlWorkflowCoordinatable<ReliabilityOrchestrator.LoadModelsJobResult> type key 'REL_LOD' {

  /**
   * {@link ReliabilityOrchestrator.LoadModelsJob} that this job run belongs to
   */
  job: !ReliabilityOrchestrator.LoadModelsJob

  /**
   * Specify the {@link File}s created by {@link ReliabilityOrchestrator.RegisterModelsJob}s, that should be used
   * to load {@link ReliabilityMlModel}s in the target environment.
   */
  files: ![File]

  /**
   * Forces the deployment of the {@link ReliabilityMlModel} in the target environment, even if validation
   * checks fail.
   */
  force: boolean = false

  /**
   * Spec that was used to specify execution constraints for this register models job run.
   */
  options: ReliabilityOrchestrator.JobOptions

  /**
   * Returns the {@link ReliabilityModelRegistry.TargetEntry}s that have been created by this job run, corresponding
   * to the migrated {@link ReliabilityMlModel}s in the target environment.
   */
  getTargetEntries: member function(): ![ReliabilityModelRegistry.TargetEntry] py

  generateNextResults: ~ py

  startResult: ~ py

  completeResult: ~ py

  afterComplete: ~ py
}
