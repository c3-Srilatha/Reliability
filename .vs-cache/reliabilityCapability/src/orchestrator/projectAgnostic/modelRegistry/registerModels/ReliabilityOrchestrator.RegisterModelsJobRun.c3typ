/**
 * Manages the execution of a set of register model job runs for multiple {@link ReliabilityMlModel}s.
 * This is created by {@link ReliabilityOrchestrator.RegisterModelsJob#start}.
 */
entity type ReliabilityOrchestrator.RegisterModelsJobRun extends MlWorkflowCoordinatable<ReliabilityOrchestrator.RegisterModelsJobResult> type key 'REL_REG' {

  /**
   * {@link ReliabilityOrchestrator.RegisterModelsJob} that this job run belongs to
   */
  job: !ReliabilityOrchestrator.RegisterModelsJob

  /**
   * Specify the modelFilter for which models should be registered.
   */
  modelFilter: !string

  /**
   * Spec that was used to specify execution constraints for this register models job run.
   */
  options: ReliabilityOrchestrator.JobOptions

  /**
   * Contains a {@link File} that can be ported to the target environment, and used to load
   * {@link ReliabilityMlModel}s in the target environment.
   */
  file: File

  /**
   * Returns a {@link File} that can be ported to the target environment, and used to load
   * {@link ReliabilityMlModel}s in the target environment.
   */
  getModelRegistryFile: member function(): !File py

  generateNextResults: ~ py

  startResult: ~ py

  completeResult: ~ py

  afterComplete: ~ py
}
