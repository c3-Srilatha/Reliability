/**
 * Represents a model registry job that can be executed on {@link ReliabilityMlModel}s.
 */
entity type ReliabilityOrchestrator.RegisterModelsJob schema name 'REL_REG' {

  /**
   * Specify the modelFilter for which models should be registered.
   */
  modelFilter: string

  /**
   * Starts the register models job for the {@link ReliabilityMlModel}s corresponding to the {@link #modelFilter}
   * The resulting {@link ReliabilityOrchestrator.RegisterModelsJobRun} can be used to summarize the evaluation results.
   *
   * @param options
   *           To customize the execution of the job.
   *
   * @return handle to the async operation.
   */
  start: member function(options: ReliabilityOrchestrator.JobOptions): !MlOperationRun<ReliabilityOrchestrator.RegisterModelsJobRun> py
}
