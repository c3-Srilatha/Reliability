/**
 * Represents the register models workflow that will be executed for a single {@link ReliabilityMlModel}.
 */
entity type ReliabilityOrchestrator.RegisterModelsJobResult extends MlWorkflowCoordinatableResult type key 'REL_REG' {

  name: ~ = 'Reliability_RegisterModels'

  /**
   * The {@link ReliabilityMlModel} that should be registered into model registry.
   */
  model: !ReliabilityMlModel

  /**
   * Spec that was used to specify execution constraints for this register models workflow.
   */
  options: ReliabilityOrchestrator.JobOptions

  /**
   * The {@link ReliabilityModelRegistry.SourceEntry} created for this {@link #model}, after the model registry
   * workflow completes.
   */
  sourceEntry: ReliabilityModelRegistry.SourceEntry

  startWorkflow: ~ py
}
