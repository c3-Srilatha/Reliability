/**
 * Represents a model inference job that can be executed on {@link ReliabilityAsset}s and a given {@link MlProject}.
 */
entity type ReliabilityOrchestrator.InferenceJob
mixes ReliabilityOrchestrator.Job<ReliabilityOrchestrator.InferenceJobSpec, ReliabilityOrchestrator.InferenceJobRun>
schema name 'REL_INF_JOB' {

  name: ~ = 'ReliabilityMl_InferenceJob'

  createWorkflow: ~ py

  doStart: ~ py

  /**
   * Funciton to trigger the {@link Workflow} associated with this
   * {@link ReliabilityOrchestrator.InferenceJob}.
   *
   * @param periodBeforeEnd
   *           The period before the end of the inference period for which the inference job should be triggered.
   *           The end is automatically set to current time using {@link DateTime#now}.
   * @param jobSpecs
   *           The {@link ReliabilityOrchestrator.InferenceJobSpec}s that should be used to configure this inference job.
   * @param options
   *           The {@link ReliabilityOrchestrator.JobOptions} that should be used to configure the inference job.
   * @return
   *          The {@link MlOperationRun} as that represents the inference job run.
   */
  triggerInferenceJob: private function(
    periodBeforeEnd: !Period, jobSpecs: ![ReliabilityOrchestrator.InferenceJobSpec], options: ReliabilityOrchestrator.JobOptions
  ): !MlOperationRun<ReliabilityOrchestrator.InferenceJobRun> py
}
