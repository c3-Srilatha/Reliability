/**
 * Represents a post model training job that can be executed on a {@link ReliabilityAsset} - {@link ReliabilityMlModel}
 * combination for a given {@link MlProject}.
 */
entity type ReliabilityOrchestrator.PostTrainingJob
mixes ReliabilityOrchestrator.Job<ReliabilityOrchestrator.PostTrainingJobSpec, ReliabilityOrchestrator.PostTrainingJobRun>
schema name 'REL_PTR' {

  name: ~ = 'ReliabilityMl_PostTrainingJob'

  createWorkflow: ~ py

  /**
   * @inheritdoc
   *
   * The `additionalParams` map can, optionally, include a `modelConfigRun` key
   * which could contain a reference to a {@link ModelConfigRun}. Other keys in
   * this map are ignored. Example python invocation of the `start()` function below:
   * ```py
   * operation_run = job.start(
         options = c3.ReliabilityOrchestrator.JobOptions(maxConcurrencyPerNode=3)),
         additionalParams = {
             "modelConfigRun": c3.ModelConfigRun(id="foo")
         }
   * )
   * ```
   */
  doStart: ~ py
}
