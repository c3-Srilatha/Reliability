/**
 * Represents the post training workflow that will be executed to validate/classify/generate reports for a single
 * {@link ReliabilityMlModel} - {@link ReliabilityAsset} and for a specific {@link MlProject}.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
entity type ReliabilityOrchestrator.PostTrainingJobResult extends MlWorkflowCoordinatableResult type key 'REL_PTR' {

  name: ~ = 'Reliability_PostModelTraining'

  /**
   * Specify the {@link ReliabilityMl.Project} for which the post model training job should be run.
   */
  project: !ReliabilityMl.Project

  /**
   * The {@link ReliabilityAsset} for which model validation/classification/reporting should be run.
   */
  asset: !ReliabilityAsset

  /**
   * The {@link ReliabilityMlModel} for which the post training job is run.
   */
  model: !ReliabilityMlModel

  /**
   * The reference period for which a {@link ReliabilityMl.ModelOutput}s are generated in order to determine how the
   * model performs. This usually can correspond to the training period for the model, since the model is expected to
   * perform well on the training data
   *
   * Use `ReliabilityMl.TimeRange.TRAIN` to use the training time range associated with a {@link ReliabilityMlModel#datasetPreparationRun},
   * or instead provide your own custom time range.
   *
   * The model outputs from this period can be compared with the model outputs generated for the {@link #comparisonTimeRange} to
   * classify the model.
   */
  referenceTimeRange: !TimeRange | ReliabilityMl.TimeRange

  /**
   * The comparison period for which a {@link ReliabilityMl.ModelOutput}s are generated in order to determine how the
   * model performs. This can correspond to the validation period for the model, since the model is expected to
   * perform well as well on held out validation data as the training data.
   *
   * Use `ReliabilityMl.TimeRange.VAL` to use the validation time range associated with a {@link ReliabilityMlModel#datasetPreparationRun},
   * or instead provide your own custom time range.
   *
   * The model outputs from this period can be compared with the model outputs generated for the {@link #referenceTimeRange} to
   * classify the model.
   */
  comparisonTimeRange: !TimeRange | ReliabilityMl.TimeRange

  /**
   * Specify whether to classify the {@link #model} after it is trained. By default this
   * field is set to False, meaning the model will be classified.
   * The classification logic must be specified in the {@link ReliabilityMl.Project#classifyModelForAssetLambda} associated with the
   * {@link ReliabilityOrchestrator.PostTrainingJob}
   */
  doNotClassify: boolean = false

  /**
   * Specify whether to validate the {@link #model} after it is trained. By default this
   * field is set to False, meaning the model will be validated.
   */
  doNotValidate: boolean = false

  /**
   * Specify whether to generate model validation reports for the {@link #model} after it is trained.
   * By default this field is set to False, meaning that a model report will be generated.
   * The reporting logic must be specified in the {@link ReliabilityMl.Project#reportModelForAssetLambda} associated with the
   * {@link ReliabilityOrchestrator.PostTrainingJob}
   */
  doNotGenerateValidationReports: boolean = false

  /**
   * Creates a {@link ReliabilityAssetToModelValidationRelation} for the given {@link #asset} and {@link #model},
   * for the specified time range provided by start and end. This is used as a step in the
   * @param asset
   *           The reliability asset to create the validation relation for.
   * @param model
   *           The reliability ML model to create the validation relation for.
   * @param start
   *           The start datetime for the validation relation.
   * @param end
   *           The end datetime for the validation relation.
   */
  createModelValidationRelation: function(
    asset: !ReliabilityAsset,
    model: !ReliabilityMlModel,
    start: datetime,
    end: datetime
  ) py

  /**
   * Creates a {@link ReliabilityOrchestrator.ModelMonitoringJobResult}, which contains the outputs of {@link #model} and
   * {@link #model} for either the {@link #referenceTimeRange} or the {@link #comparisonTimeRange}.
   * @param timeRange
   *           The time range for which to create model outputs.
   * @param processOutputs
   *           Tuple containing the process outputs.
   * @param interpretOutputs
   *           Tuple containing the interpret outputs.
   * @return A {@link ReliabilityMl.ModelOutput} object for the specified time range.
   */
  createModelOutputForTimeRange: function(
    timeRange: !TimeRange,
    processOutputs: !Tuple,
    interpretOutputs: Tuple
  ): !ReliabilityMl.ModelOutput py

  /**
   * Creates the {@link Workflow} to run the post training job for the {@link #asset} - @{link-model} combination,
   * that is started by {@link #startWorkflow}.
   * @return A {@link Workflow} object for the post training job.
   */
  createWorkflow: member function(): !Workflow py

  startWorkflow: ~ py
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
