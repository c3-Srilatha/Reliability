/**
 * A type to store the batch outputs for a {@link ReliabilityOrchestrator.PipelineCreationJob}.
 * Each batch stores contains the base {@link ReliabilityMl.Pipeline} and a list of hyperparameter combinations to create
 * each new {@link ReliabilityMl.Pipeline} with.
 */
@beta
type ReliabilityOrchestrator.PipelineCreationJobBatch {

  /**
   * The {@link ReliabilityMl.Pipeline} for which HPO should be run
   */
  pipeline: !ReliabilityMl.Pipeline

  /**
   * A list of hyperparameter combinations to create each new {@link ReliabilityMl.Pipeline} to run HPO with,
   * using the provided {@link #pipeline}.
   */
  hyperparamCombinations: ![map<string, any>]
}
