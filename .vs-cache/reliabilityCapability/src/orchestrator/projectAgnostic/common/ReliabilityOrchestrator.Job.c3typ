/**
 * Base type for all {@link MlWorkflowCoordinatable} jobs.
 */
type ReliabilityOrchestrator.Job<JS: ReliabilityOrchestrator.JobSpec, JR: ReliabilityOrchestrator.JobRun> {

  /**
   * The array of configurations this job run must execute.
   */
  jobSpecs: ![JS]

  /**
   * Member function to create the {@link Workflow} that will start the {@link ReliabilityOrchestrator.JobRun}
   * coordinator.
   * @param options
   *           The job options to configure the workflow.
   * @param additionalParams
   *           Additional parameters for workflow creation.
   * @param name
   *           The name for the workflow.
   * @return A {@link Workflow}.
   */
  createWorkflow: abstract private member function(
    options: ReliabilityOrchestrator.JobOptions,
    additionalParams: map<string, any>,
    name: string
  ): !Workflow

  /**
   * Starts the job and returns a `Pair<{@link ReliabilityOrchestrator.JobRun}, {@link MlOperationRun}>`
   * that may be used to monitor the status of the job run.
   *
   * @param options
   *           Customize the execution of the job run.
   * @param additionalParams
   *           Not all jobs will require only `options`. Any additionally required parameter may be passed in as a map.
   * @return A pair containing the {@link ReliabilityOrchestrator.JobRun} and  {@link MlOperationRun} for monitoring.
   */
  doStart: abstract member function(
    options: ReliabilityOrchestrator.JobOptions,
    additionalParams: map<string, any>
  ): !Pair<JR, MlOperationRun<JR>>

  /**
   * Starts the job and returns an {@link MlOperationRun} that may be used to monitor
   * the status of the job run.
   *
   * @param options
   *           Customize the execution of the job run.
   * @param additionalParams
   *           Not all jobs will require only `options`. Any additionally required parameter may be passed in as a map.
   * @return An {@link MlOperationRun} object for monitoring the job status.
   */
  start: member function(
    options: ReliabilityOrchestrator.JobOptions,
    additionalParams: map<string, any>
  ): !MlOperationRun<JR> py

  /**
   * @return The concrete {@link ReliabilityOrchestrator.JobRun} subType.
   */
  jobRunType: private function(): Type<<JR>> py

  /**
   * @return the concrete {@link ReliabilityOrchestrator.JobSpec} subType.
   */
  jobSpecType: private function(): Type<<JS>> py

  /**
   * Upon calling {@link start}, the returned object is an {@link MlOperationRun}.
   * However, for all tracking purposes, the concrete {@link ReliabilityOrchestrator.JobRun} subType
   * is needed.
   * @param run
   *           The operation run to fetch the job run for.
   * @return The job run, to enable downstream monitoring.
   */
  fetchJobRunForOperationRun: private member function(
    run: !MlOperationRun
  ): JR py

  /**
   * The most common operation is to fetch the latest job run, because that is usually
   * representative of the operation that developers will want to debug / inspect.
   * @return The latest {@link ReliabilityOrchestrator.JobRun} for this job.
   */
  fetchLatestJobRun: private member function(): JR py
}
