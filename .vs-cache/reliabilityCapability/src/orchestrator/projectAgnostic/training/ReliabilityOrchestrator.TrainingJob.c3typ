/**
 * Represents a model training job that can be executed on {@link ReliabilityAsset}s and a given {@link MlProject}.
 */
entity type ReliabilityOrchestrator.TrainingJob
mixes ReliabilityOrchestrator.Job<ReliabilityOrchestrator.TrainingJobSpec, ReliabilityOrchestrator.TrainingJobRun>
schema name 'REL_TRN' {

  name: ~

  /**
   * This job handles creating a {@link ModelConfigRun} when one is not provided by the caller in the #start method.
   * It also takes care of updating the status of the config run when training is in progress, completed, or failed.
   * Having a {@link ModelConfigRun} is useful for tracking the progress of the training job.
   * If this is set to `true`, the job does not update the {@link ModelConfigRun} status when the training
   * process is complete. Instead, the caller is responsible for updating the status of the {@link ModelConfigRun}.
   */
  doNotCompleteModelConfigRun: boolean

  createWorkflow: ~ py

  /**
   * @inheritdoc
   *
   * The `additionalParams` map can, optionally, include a `modelConfigRun` key
   * which could contain a reference to a {@link ModelConfigRun}. Other keys in
   * this map are ignored. Example python invocation of the `start()` function below:
   * ```py
   * operation_run = job.start(
         options = c3.ReliabilityOrchestrator.JobOptions(maxConcurrencyPerNode=3)),
         additionalParams = {
             "modelConfigRun": c3.ModelConfigRun(id="foo")
         }
   * )
   * ```
   */
  doStart: ~ py
}
