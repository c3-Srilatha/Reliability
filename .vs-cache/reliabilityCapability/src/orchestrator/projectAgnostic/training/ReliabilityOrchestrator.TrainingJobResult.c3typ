/**
 * Represents the training workflow that will be executed to train and deploy as `CANDIDATE` a single
 * {@link ReliabilityMlModel} and for a specific {@link MlProject}. {@link ReliabilityOrchestrator.TrainingJobResult#datasetPreparationRun}
 * consists {@link ReliabilityMlDatasetPreparationRun#trainFeatureTimeRanges} map for the start and end time range.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
entity type ReliabilityOrchestrator.TrainingJobResult extends MlWorkflowCoordinatableResult type key 'REL_TRN' {

  name: ~ = 'Reliability_ModelTraining'

  /**
   * The filter corresponding to the {@link ReliabilityAsset}s for which models should be created and trained.
   */
  assetFilter: string

  /**
   * The {@link ReliabilityMlDatasetPreparationRun} that should be used to train the {@link ReliabilityAsset}s
   * corresponding to the {@link #assetFilter}. {@link ReliabilityMlDatasetPreparationRun#trainFeatureTimeRanges}
   * map contains the time range used for model training.
   *
   * Example:
   * start = datasetPreparationRun.trainFeatureTimeRanges.get("features").start
   * end = datasetPreparationRun.trainFeatureTimeRanges.get("features").end
   */
  datasetPreparationRun: ReliabilityMlDatasetPreparationRun

  /**
   * Specify the {@link ReliabilityMl.Project} for which training should be run.
   */
  project: !ReliabilityMl.Project

  /**
   * The {@link ReliabilityMl.Pipeline} to be used to train for the {@link ReliabilityAsset}s.
   * At least one of {@link #pipeline} and {@link #template} must be specified.
   * The {@link ReliabilityMl.Pipeline} should be upserted before passing to the training run.
   * The job will fail immediately if the pipeline is not upserted.
   */
  pipeline: ReliabilityMl.Pipeline

  /**
   * Names to be used for the newly trained model corresponding to the provided {@link #pipeline}.
   * Empty string or null value for a specific entry will lead to that model being unnamed.
   */
  modelName: string

  /**
   * Utilize the {@link ModelTemplate} as {@link ReliabilityMlModel#template} when generating a new model.
   * If specified, it will override the given {@link #pipeline}.
   * If the value is null, no {@link ModelTemplate} was applied to the created model.
   */
  template: ModelTemplate

  /**
   * If specified, represents the already trained {@link ReliabilityMlModel}, that will be used for deployment and
   * optionally, classification and validation.
   */
  model: ReliabilityMlModel

  /**
   * Contains the trained {@link ReliabilityMlModel} that is output by the workflow. Note that if {@link #model}
   * is specified and is trained, then this field just points to the same model, since it is already trained.
   * DO NOT MANUALLY POPULATE THIS FIELD.
   */
  trainedModel: private ReliabilityMlModel

  /**
   * Specify the filter corresponding to {@link ReliabilityAsset}s for which the trained models
   * should be deployed on as `CANDIDATE`.
   */
  deploymentAssetFilter: string

  /**
   * Set the hyperparameters passed into either {@link #pipeline}, or the pipeline created from the
   * {@link #template}/
   */
  hyperparamOverrides: private map<string, any>

  /**
   * This function creates a {@link ReliabilityMlModel} by first constructing a {@link ReliabilityMl.Pipeline} from the
   * provided {@link #pipeline}, {@link #template} and {@link #hyperparamOverrides}, and then calls
   * {@link ReliabilityMlModel#createReliabilityModel).
   */
  createReliabilityModel: function(
    project: !ReliabilityMl.Project,
    datasetPreparationRun: !ReliabilityMlDatasetPreparationRun,
    pipeline: ReliabilityMl.Pipeline,
    template: ModelTemplate,
    name: string,
    id: string,
    replicatedFrom: ReliabilityMlModel,
    hyperparamOverrides: map<string, any>
  ): !ReliabilityMlModel py

  /**
   * Deploy the trainedModel as a `CANDIDATE` model. If a {@link MlModel.DeploySpec#subjectFilter} is specified, the model will be deployed
   * for the {@link ReliabilityAsset}s in the provided subjectFilter.
   * If not specified, the model will be deployed for the {@link ReliabilityAsset}s corresponding to the
   */
  deployModelAsCandidate: function(trainedModel: !ReliabilityMlModel, subjectFilter: string, trainJobRun: ReliabilityOrchestrator.TrainingJobRun) py

  startWorkflow: ~ py
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
