/**
 * Manages the execution of a set of Training jobs run for multiple {@link ReliabilityAsset}s.
 * This is created by {@link ReliabilityOrchestrator.TrainingJob#start}.
 */
entity type ReliabilityOrchestrator.TrainingJobRun
extends MlWorkflowCoordinatable<ReliabilityOrchestrator.TrainingJobResult>
mixes ReliabilityOrchestrator.JobRun<ReliabilityOrchestrator.TrainingJob, ReliabilityOrchestrator.TrainingJobSpec>
type key 'REL_TRN' {

  /**
   * The associated {@link ModelConfigRun} that is tracking the progress of this run.
   */
  modelConfigRun: ModelConfigRun

  /**
   * Returns all {@link ReliabilityOrchestrator.TrainingJobResult}s associated with this run.
   * @param spec
   *    Common specifications for fetching the results.
   * @return a list of {@link ReliabilityOrchestrator.TrainingJobResult}.
   */
  trainResults: member function(spec: FetchSpec): ![ReliabilityOrchestrator.TrainingJobResult] py

  generateNextResults: ~ py

  startResult: ~ py

  completeResult: ~ py

  afterComplete: ~ py
}
