/**
 * Manages the execution of a set of model monitoring jobs run for each {@link ReliabilityAsset} - {@ReliabilityMlModel} combination.
 * This is created by {@link ReliabilityOrchestrator.ModelMonitoringJob#start}.
 */
entity type ReliabilityOrchestrator.ModelMonitoringJobRun
extends MlWorkflowCoordinatable<ReliabilityOrchestrator.ModelMonitoringJobResult>
mixes ReliabilityOrchestrator.JobRun<ReliabilityOrchestrator.ModelMonitoringJob, ReliabilityOrchestrator.ModelMonitoringJobSpec>
type key 'REL_MTR' {

  generateNextResults: ~ py

  startResult: ~ py

  completeResult: ~ py

  afterComplete: ~ py
}
