/**
 * Represents a model monitoring job that can be executed on a {@link ReliabilityAsset} - {@link ReliabilityMlModel}
 * combination for a given {@link ReliabilityMl.Project}.
 */
entity type ReliabilityOrchestrator.ModelMonitoringJob
mixes ReliabilityOrchestrator.Job<ReliabilityOrchestrator.ModelMonitoringJobSpec, ReliabilityOrchestrator.ModelMonitoringJobRun>
schema name 'REL_MTR' {

  name: ~ = 'ReliabilityMl_ModelMonitoringJob'

  createWorkflow: ~ py

  doStart: ~ py
}
