/**
 * An interface for creating a {@link Workflow} that will adjust the inference-only hyperparameters of a {@link ReliabilityMlModel}.
 * The steps are:
 * 1. If the model's project is `reliabilityRisk`, run {@link ReliabilityRiskMlModel#clone}, else run {@link ReliabilityMlModel#replicate} on the given model.
 * 2. Run {@link MlModel#process} on the replicated model.
 * 3. Run {@link MlModel#interpret} on the replicated model.
 * 4. Run {@link ReliabilityMlModel#setExperimentalModel} to store the experiment model.
 * 5. Store the parsed {@link Data} into the {@link ReliabilityMlModelExperiment} entity.
 *
 * Workflow graph:
 * ```
 *                                      ┌──────────────────┐
 *                                      │                  │
 *                                 ┌───►│ MlModel#interpret├──────┐
 *                                 │    │                  │      │
 *       if project is risk        │    └──────────────────┘      │
 *      ┌───────────────────┐      │             ▲                │contribution
 * in   │                   │ model│             │                │data
 * ───┬►│ Model Cloning     ├──┬───┤    ┌────────┴─────────┐      │    ┌───────────────────┐
 *    │ │                   │  │   │    │                  │      └───►│                   │    out
 *    │ └───────────────────┘  │   ├───►│ MlModel#process  │           │ Parse Output Data ├──┬───►
 *    │                        │   │    │                  ├──────────►│                   │  │
 *    │ ┌───────────────────┐  │   │    └──────────────────┘ model     └───────────────────┘  │
 *    │ │                   │  │   │                         outputs                          │
 *    └►│ Model Replication ├──┘   │                                                          │
 *      │                   │      │    ┌──────────────────┐                                  │
 *      └───────────────────┘      │    │                  │ experiment data                  │
 *                                 └───►│ Store Model Ref  ├──────────────────────────────────┘
 *                                      │                  │
 *                                      └──────────────────┘
 * ```
 */
type ReliabilityOrchestrator.AdjustModelHyperparamsProcess.Spec mixes ReliabilityOrchestrator.WorkflowConvertable {

  /**
   * Name of the workflow which will be appended with a random id.
   */
  name: string = 'Reliability_AdjustModelHyperparams'

  /**
   * The {@link ReliabilityMlModel} to be replicated.
   */
  model: ReliabilityMlModel

  /**
   * The name of the replicated Model.
   */
  modelName: string

  /**
   * The new hyperparameters that will be user to replicate the model using {@link ReliabilityMlModel#replicate}
   */
  newHps: map<string, map<string, any>>

  /**
   * Optional start of predictions (if applicable).
   */
  start: date

  /**
   * Optional end of predictions (if applicable).
   */
  end: date

  /**
   * The list of {@link ReliabilityAsset} that will be used to process the model using {@link MlModel#process}.
   */
  assets: [ReliabilityAsset]

  /**
   * The user who created the workflow.
   */
  createdBy: User

  /**
   * @inheritdoc
   */
  createWorkflow: ~ py

  /**
   * @inheritdoc
   */
  createAndStartWorkflow: ~ py
}
