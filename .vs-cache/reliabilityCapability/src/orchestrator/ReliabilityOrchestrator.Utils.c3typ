/**
 * Helper functions for types under the {@link ReliabilityOrchestrator} namespace.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
@beta
type ReliabilityOrchestrator.Utils {
  /**
   * Helper function to create a sequential {@link Workflow} from a list of
   * {@link Workflow.Vertex}-es. All the provided {@link Workflow.Vertex}-es
   * MUST have `$start` and `$success` ports.
   * @param id
   *        Id of the {@link Workflow}
   * @param name
   *        Name of the {@link Workflow}
   * @param vertices
   *        A list of {@link Workflow.Vertex}es, each of which will be connected
   *        from their `$success` port to the next vertex's `$start` port. If any
   *        vertex does not have either the `$success` or `$start` ports, an error
   *        will be thrown
   * @returns a {@link Workflow}
   */
  createSequentialWorkflow: function(
    id: string,
    name: !string,
    vertices: ![Workflow.Vertex]
  ): Workflow py

  /**
   * Helper function to validate the number of files in a canonical URL.
   * Uses {@link ReliabilityRawDataValidationDataType} to determine the
   * {@link FileSourceCollection#name} of each kind of data.
   * @returns A map containing keys for the following raw data types, and the
   *          number of files in their respective canonical URL:
   *          1. `SENSOR_TIME_SERIES`: `CanonicalPointMeasurement`
   *          2. `PPMS`: `CanonicalPointPhysicalMeasurementSeries`
   *          3. `EVENTS`: `CanonicalReliabilityAssetEvent`
   */
  getCanonicalUrlToCountMap: function(): map<string, int> py

  /**
   * Helper function to get the states of all {@link InvalidationQueue}s.
   * @returns A map containing "errors" and "info" keys, each of which contains
   *          a list of strings representing the states of each queue.
   */
  validateInvalidationQueueStates: function(): !map<string, [string]> py

  /**
   * Helper function to get the number of {@link ReliabilityMlModel}s that have
   * been trained for each {@link ModelTemplate}.
   * @param workflowRun
   *          If specified, the evaluation will be performed on the
   *          time range where the workflow ran, i.e. between the
   *          {@link Workflow.Status#started} and {@link Workflow.Status#completed}
   *          timestamps.
   * @returns The {@link Data} resulting from {@link ReliabilityMlModel#eval}
   *          with the `template_id` and `count_id` columns.
   */
  listModelCountsByTemplate: function(workflowRun: Workflow.Run): Data py

  /**
   * Helper method to parse the outputs of the {@link MlModel#process} and {@link MlModel#interpret} operations and
   * are transformed into the following fields:
   *
   * - `alertData`: {@link Data.Persisted} containing the timestamp and normalized feature contribution for them.
   * - `algorithmData`: {@link Data.Persisted} containing the
   *   {@link ReliabilityMl.Project#algorithmOutputs} as columns from the {@link ReliabilityMlModel model}.
   * - `baseModelAlgorithmData`: Same as above but using a "base" {@link ReliabilityMlModel} as comparison.
   *
   * @param model
   *        The {@link ReliabilityMlModel} for which the outputs are being parsed.
   * @param resamplingInterval
   *        The {@link Interval} to use for resampling the data.
   * @param processMlRun
   *        {@link MlOperationRun#result} resulted from {@link MlModel#process} executed.
   * @param interpretMlRun
   *        {@link MlOperationRun#result} resulted from {@link MlModel#interpret} executed.
   * @param baseProcessMlRun
   *        {@link MlOperationRun#result} resulted from {@link MlModel#process} to use as a base comparison.
   * @param inputFeatureData
   *        A pandas `DataFrame` containing the input feature data for the model.
   *
   * @returns A map containing the keys described above and their corresponding parsed {@link Data}.
   */
  // c3-analysis-disable c3-excessive-method-params -- must be refactored to use specs where possible
  parseProcessAndInterpretOutputs: function(
    model: !ReliabilityMlModel,
    resamplingInterval: !string serialized Interval,
    processMlRun: !native,
    interpretMlRun: native,
    baseProcessMlRun: native,
    inputFeatureData: native): native py

  /**
   * Helper method to extract {@link Data} and merge them into a single pandas `DataFrame`.
   *
   * @param mlOperationRunOutput A {@link MlOperationRun#result} containing a map of output key to {@link Data}.
   * @param keysToMerge A list of keys to extract from the `mlOperationRun
   *
   * @return A pandas `DataFrame` containing the merged data from the specified keys.
   */
  extractAndMergeModelOutputs: inline function(mlOperationRunOutput: !native, keysToMerge: ![string]): native py

  /**
   * Helper method to get the overlap between the given time range and the time horizon configured
   * in {@link Feature.Store.Config}.
   *
   * @param timeRange
   *        The time range to check for overlap. If no time zone is provided, it will be assumed to be in UTC.
   * @param alignmentInterval
   *        Optional interval to align the time horizon with.
   * @param lookbackDuration
   *        Optional lookback duration (in seconds) to add to the start of the time horizon.
   * @returns A {@link TimeRange} representing the time horizon overlap.
   */
  getTimeHorizonOverlap: inline function(timeRange: !TimeRange, alignmentInterval: string, lookbackDuration: int): TimeRange py

  /**
   * Converts an {@link Interval} to a {@link Period} for a given count.
   *
   * @param interval
   *        The {@link Interval} to convert.
   * @param count
   *        Integer used to multiply the {@link Interval} to get the {@link Period}.
   * @returns A {@link Period} representing the scaled {@link Interval}
   */
  intervalToPeriod: inline function(interval: !Interval, count: !int): !Period py
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
