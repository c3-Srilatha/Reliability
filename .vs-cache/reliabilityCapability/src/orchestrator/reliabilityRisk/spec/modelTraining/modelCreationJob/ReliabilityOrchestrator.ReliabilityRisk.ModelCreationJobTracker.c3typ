/**
 * A type to store intermediate and final results for a given {@link ReliabilityOrchestrator.ReliabilityRisk.ModelCreationJob}.
 * The final result stored is the {@link MlModel.Train.Job} that is created by the
 * {@link ReliabilityOrchestrator.ReliabilityRisk.ModelCreationJob}. This job can then be used to subsequently train all the
 * {@link ReliabilityRiskMlModel}s that are created by the {@link ReliabilityOrchestrator.ReliabilityRisk.ModelCreationJob}.
 */
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
entity type ReliabilityOrchestrator.ReliabilityRisk.ModelCreationJobTracker {

  /**
   * An {@link ReliabilityRiskMlModel} that is created by the {@link #modelCreationJob}
   */
  model: ReliabilityRiskMlModel

  /**
   * The {@link ReliabilityMlDatasetPreparationRun} that is used to train the given {@link #model}
   */
  datasetPreparationRun: ReliabilityMlDatasetPreparationRun

  /**
   * The {@link MlOperationSpec} that will be used to train the created {@link ReliabilityRiskMlModel}
   */
  mlOperationSpec: MlOperationSpec

  /**
   * The {@link ReliabilityOrchestrator.ReliabilityRisk.ModelCreationJob} that is used to create the given {@link #model}
   */
  modelCreationJob: ReliabilityOrchestrator.ReliabilityRisk.ModelCreationJob

  /**
   * The {@link MlModel.Train.Job} that is created by the {@link #modelCreationJob}
   */
  modelTrainingJob: MlModel.Train.Job
}
