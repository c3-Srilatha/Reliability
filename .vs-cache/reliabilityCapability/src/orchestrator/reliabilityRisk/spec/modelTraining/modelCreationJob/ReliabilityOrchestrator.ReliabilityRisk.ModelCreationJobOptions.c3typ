/**
 * Use this type to configure a {@link ReliabilityOrchestrator.ReliabilityRisk.ModelCreationJob}
 */
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
type ReliabilityOrchestrator.ReliabilityRisk.ModelCreationJobOptions mixes BatchJobOptions {

  /**
   * The number of {@link ReliabilityRiskMlModel}s that will be created per batch.
   */
  batchSize: !int = 1

  /**
   * The {@link ReliabilityOrchestrator.ReliabilityRisk.Spec.ModelTrainingPipeline}s that should be used to create and
   * train {@link ReliabilityRiskMlModel}s
   */
  pipelineSpecs: [ReliabilityOrchestrator.ReliabilityRisk.Spec.ModelTrainingPipeline]

  /**
   * Specify which {@link ReliabilityAsset}s to train the {@link PipelineSpec} on by passing in a {@link Filter}.
   * The function will extract the latest {@link ReliabilityMlDatasetPreparationRun} for each
   * {@link ReliabilityAsset} and use it to train the {@link PipelineSpec}.
   */
  assetFilter: string serialized Filter = 'exists(sensorRelations)'

  /**
   * Use this field to directly specify a filter directly on the {@link ReliabilityMlDatasetPreparationRun}s
   * to use to train models. If specified, it will override the {@link assetFilter}.
   */
  datasetPreparationRunFilter: string serialized Filter
}
