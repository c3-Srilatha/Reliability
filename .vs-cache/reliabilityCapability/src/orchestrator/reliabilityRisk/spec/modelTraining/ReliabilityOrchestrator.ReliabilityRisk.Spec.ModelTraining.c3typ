/**
 * An interface for creating a {@link Workflow} that starts the {@link ReliabilityRiskMlModel} training routine.
 * This {@link Workflow} will create a {@link MlModel.Train.Job} that will train {@link ReliabilityRiskMlModel}s
 * for the {@link ReliabilityAsset}s specified in {@link #assetFilter} or {@link #datasetPreparationRunFilter}.
 * The {@link Workflow} will then classify the trained models, validate the models, generate model reports, and
 * register the models into the Model Registry service.
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
type ReliabilityOrchestrator.ReliabilityRisk.Spec.ModelTraining mixes ReliabilityOrchestrator.WorkflowConvertable, ReliabilityOrchestrator.ReliabilityRisk.Spec.ModelTrainingOptions {

  name: ~

  /**
   * The {@link ReliabilityOrchestrator.ReliabilityRisk.Spec.ModelTrainingPipeline}s that should be used to create,
   * train and deploy {@link ReliabilityRiskMlModel}s for the {@link ReliabilityAsset}s.
   * If specified, it will take precedence over any specified {@link #modelTrainingJob} or {@link #trainedModels}.
   */
  pipelineSpecs: [ReliabilityOrchestrator.ReliabilityRisk.Spec.ModelTrainingPipeline]

  /**
   * Use this field to directly specify an {@link MlModel.Train.Job} to train, whose trained models will then be deployed
   * as `CANDIDATE` models and classified, if {@link #doNotClassify} is set to False. If this field is specified,
   * it will take precedence over any provided {@link #trainedModels}
   */
  modelTrainingJob: MlModel.Train.Job

  /**
   * Use this field to directly specify trained {@link ReliabilityRiskMlModel}s that will then be deployed and also classified,
   * if {@link #doNotClassify} is set to False.
   */
  trainedModels: [ReliabilityRiskMlModel]

  /**
   * The associated {@link ModelConfigRun}.
   */
  modelConfigRun: ModelConfigRun

  /**
   * Specify which {@link ReliabilityAsset}s to train the {@link PipelineSpec} on by passing in a {@link Filter}.
   * The function will extract the latest {@link ReliabilityMlDatasetPreparationRun} for each
   * {@link ReliabilityAsset} and use it to train the {@link PipelineSpec}.
   */
  assetFilter: string serialized Filter = 'exists(sensorRelations)'

  /**
   * Use this field to directly specify which {@link ReliabilityMlDatasetPreparationRun}s to use to train models. If
   * specified, it will override the {@link assetFilter}.
   */
  datasetPreparationRunFilter: string serialized Filter

  /**
   * The {@link MlModel.Train.JobSpec} that should be used to create the {@link MlModel.Train.Job} that will train
   * the {@link ReliabilityRiskMlModel}s.
   */
  jobSpec: !MlModel.Train.JobSpec = {
    'type': 'MlModel.Train.JobSpec',
    'jobTimeoutMinutes': 60,
    'operationTimeoutMinutes': 15,
    'maxConcurrentModelTrain': 1
  }

  /**
   * Use this field to specify the {@link BatchJobOptions} that should be used for the distributed creation of
   * {@link ReliabilityRiskMlModel}s, which will subsequently be trained.
   */
  modelCreationJobOptions: BatchJobOptions

  /**
   * Use this field to specify the {@link MlModel.Evaluation.Spec} that should be used for the distributed classification of trained
   * {@link ReliabilityRiskMlModel}s
   */
  modelEvaluationSpec: MlModel.Evaluation.Spec

  /**
   * Specify whether to classify the models after they are trained. By default this field is set to False,
   * meaning models will be classified after training.
   */
  doNotClassify: !boolean = false

  /**
   * Specify whether to validate the models after they are trained. By default this field is set to False,
   * meaning models will be validate after training.
   */
  doNotValidate: !boolean = false

  /**
   * Use this field to specify the {@link BatchJobOptions} that should be used for the distributed validation of
   * {@link ReliabilityRiskMlModel}s, if {@link #doNotValidate} is set to Fals.e
   */
  modelValidationJobOptions: BatchJobOptions

  /**
   * Specify whether to generate model validation reports for the models after they are trained. By default
   * this field is set to False, meaning that model reports will be generated after model validation.
   * NOTE: If this field is set to False, then the {@link #doNotValidate} field MUST also be False.
   */
  doNotGenerateValidationReports: !boolean = false

  /**
   * Use this field to specify the {@link BatchJobOptions} that should be used for the distributed generation of
   * {@link ReliabilityMlModelReport}s, if {@link #doNotGenerateValidationReports} is set to False.
   */
  modelReportingJobOptions: BatchJobOptions

  /**
   * Specify whether to register models into the model registry service after they are trained. By default this field
   * is set to False, meaning models will be registered after training.
   */
  doNotRegister: !boolean = false

  /**
   * Use this field to specify the {@link BatchJobOptions} that should be used for the distributed registering of
   * models into the Model Registry service.
   */
  registerModelsJobOptions: BatchJobOptions

  /**
   * Fetch the {@link MlModel.Train.Job} that was created by the given {@link ReliabilityOrchestrator.ReliabilityRisk.ModelCreationJob}.
   */
  findModelTrainingJobFromModelCreationJobTracker: private function(
    modelCreationJob: !ReliabilityOrchestrator.ReliabilityRisk.ModelCreationJob
  ): MlModel.Train.Job py

  /**
   * Starts an {@link MlModel.Train.Job} from the given {@link ReliabilityOrchestrator.ReliabilityRisk.ModelCreationJob},
   * if specified, or instead directly starts the provided `modelTrainingJob`.
   */
  startModelTrainingJob: private function(
    modelCreationJob: ReliabilityOrchestrator.ReliabilityRisk.ModelCreationJob,
    modelTrainingJob: MlModel.Train.Job,
    spec: MlModel.Train.JobSpec
  ): !MlOperationRun<MlModel.Train.JobRun> py

  /**
   * Start a {@link Workflow} created by {@link ReliabilityOrchestrator.ReliabilityRisk.Spec.ModelClassification#createWorkflow} and
   * return the {@link Workflow.Run}.
   */
  startModelClassificationWorkflow: private function(
    trainJobRun: MlModel.Train.JobRun,
    trainedModels: [ReliabilityRiskMlModel],
    modelEvaluationSpec: MlModel.Evaluation.Spec
  ): !Workflow.Run py

  /**
   * Start a {@link Workflow} created by {@link ReliabilityOrchestrator.ReliabilityRisk.Spec.ModelValidation#createWorkflow} and
   * return the {@link Workflow.Run}.
   */
  startModelValidationWorkflow: private function(
    trainJobRun: MlModel.Train.JobRun,
    trainedModels: [ReliabilityRiskMlModel],
    modelValidationJobOptions: BatchJobOptions
  ): !Workflow.Run py

  /**
   * Start a {@link Workflow} created by {@link ReliabilityOrchestrator.ReliabilityRisk.Spec.RegisterModels#createWorkflow} and
   * return the {@link Workflow.Run}.
   */
  startRegisterModelsWorkflow: private function(
    trainJobRun: MlModel.Train.JobRun,
    trainedModels: [ReliabilityRiskMlModel],
    registerModelsJobOptions: BatchJobOptions
  ): !Workflow.Run py

  /**
   * Method to set the initial status of the {@link ModelConfigRun} associated with the Model Training {@link Workflow}.
   * Sets the {@link ModelConfigRun#status} to `IN PROGRESS`, and links the {@link Workflow.Run} created after executing
   * {@link Workflow#start}.
   * The {@link Workflow.Run} is identified by matching the provided {@link Workflow#id} to the
   * {@link Workflow.Run#workflowRef} field, which references the associated {@link Workflow}.
   *
   * @param workflowId
   *    The {@link Workflow#id} used to query the corresponding {@link Workflow.Run}.
   * @param modelConfigRunId
   *    The {@link ModelConfigRun#id} to which the {@link Workflow.Run} will be assigned.
   */
  initializeModelConfigRun: private function(
    workflowId: !string serialized Workflow,
    modelConfigRunId: !string serialized ModelConfigRun
  ) py

  validate: ~ py
  preValidate: ~ py
  postValidate: ~ py
  createWorkflow: ~ py
  createAndStartWorkflow: ~ py
}
