/**
 * Represents an inference job within the reliability risk workflow.
 *
 * - Implements a distributed MapReduce job for running inference on `ReliabilityAsset`s.
 * - Uses the configured inference specification to process asset-related data.
 * - Supports large-scale inference execution using distributed computing.
 */
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
extendable entity type ReliabilityOrchestrator.ReliabilityRisk.InferenceJob extends MapReduce<ReliabilityAsset, string, void, void> type key 'RR_IJ' {

  /**
   * The inference specification defining how the job should execute.
   * This controls asset filtering, model selection, and inference period settings.
   */
  spec: !ReliabilityOrchestrator.ReliabilityRisk.Spec.ModelInference

  map: ~ py-data-science
}
