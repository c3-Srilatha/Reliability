/**
  * Defines the dataset preparation specification for the reliability risk workflow.
  * Controls dataset quality, feature/mask preparation, and parallelization settings.
  */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
type ReliabilityOrchestrator.ReliabilityRisk.Spec.DatasetPreparation mixes ReliabilityOrchestrator.WorkflowConvertable {

  name: ~ = 'ReliabilityRisk_DatasetPreparation'

  /**
   * Control the quality of datasets prepared by passing in a
   * {@link ReliabilityMlDatasetPreparationSpec}.
   */
  spec: !ReliabilityMlDatasetPreparationSpec = {
    'type': 'ReliabilityMlDatasetPreparationSpec',
    'interval': 'QUARTER_HOUR',
    'featurePreparationSpec': {
      'type': 'ReliabilityMlFeaturePreparationSpec',
      'createDefaultFeatures': true,
      'featureCreationMethod': 'EXPECTED_SENSOR',
      'flatliningTimeSteps': 24
    },
    'maskPreparationSpec': {
      'type': 'ReliabilityMlMaskPreparationSpec',
      'preAssetEventsWindow': 288,
      'postAssetEventsWindow': 288
    },
    'trainValSplitSpec': {
      'type': 'ReliabilityMlTrainValSplitSpec',
      'percentage': 80,
      'doNotReverse': false
    }
  }

  /**
   * Control the parallelization of dataset preparation with
   * {@link MapReduceOptions}.
   */
  options: !MapReduceOptions = {
    'type': 'MapReduceOptions',
    'filter': 'exists(sensorRelations)',
    'batchSize': 1
  }

  /**
   * Makes a {@link Workflow.MapReduce} vertex to manage the preparation of datasets that would
   * have otherwise been generated by {@link ReliabilityMlDatasetPreparationJob}.
   * @param job - The {@link ReliabilityMlDatasetPreparationJob} that distributes the dataset preparation process.
   * @param options - The {@link MapReduceOptions} to control the execution of the dataset preparation process.
   *
   * @returns a {@link Workflow.MapReduce}
   */
  makeDatasetPreparationWorkflowVertex: private member function(
    job: !ReliabilityMlDatasetPreparationJob,
    options: MapReduceOptions
  ): !Workflow.MapReduce py

  /**
   * Makes a {@link Workflow.Action} vertex to execute the
   * {@link ReliabilityMlDatasetPreparationHelper#initializeJobSpec} method before the dataset preparation workflow
   * vertex is executed.
   * @param job - The {@link ReliabilityMlDatasetPreparationJob} that distributes the dataset preparation process.
   *
   * @returns a {@link Workflow.Action}.
   */
  makeInitializeJobSpecWorkflowVertex: private member function(
    job: !ReliabilityMlDatasetPreparationJob
  ): !Workflow.Action py

  validate: ~ py
  preValidate: ~ py
  postValidate: ~ py
  createWorkflow: ~ py
}
