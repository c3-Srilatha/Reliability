/**
 * Defines the specification for data integration within the reliability risk workflow.
 *
 * - Manages the ingestion of canonical and non-canonical (Excel-based) asset hierarchy data.
 * - Controls processing timeouts and workflow dependencies.
 * - Ensures data consistency and transformation post-ingestion.
 * - Supports synthetic data integration for testing and validation.
 */
@beta
type ReliabilityOrchestrator.ReliabilityRisk.Spec.DataIntegration mixes ReliabilityOrchestrator.WorkflowConvertable {

  name: ~ = 'ReliabilityRisk_DataIntegration'

  /**
   * Determines whether or not to load data through canonicals.
   * Set this to `false` to load canonical data.
   * Set this to `true` to skip the canonical data ingestion process.
   */
  doNotLoadCanonicalData: ?boolean = false

  /**
   * If {@link doNotLoadCanonicalData} is set to `false`, then there is a two step process
   * to loading the canonical data files:
   * 1. `SourceFile#syncAll` --> Returns many {@link FileSystemBatchJob}s
   * 2. `SourceFile#processAll` --> Starts the data ingestion process through SourceQueue
   *
   * This field determines how long to wait for the first step to complete.
   */
  canonicalDataSyncFilesTimeout: Duration = '30m'

  /**
   * If {@link doNotLoadCanonicalData} is set to `false`, then there is a two step process
   * to loading the canonical data files:
   * 1. `SourceFile#syncAll` --> Returns many {@link FileSystemBatchJob}s
   * 2. `SourceFile#processAll` --> Starts the data ingestion process through SourceQueue
   *
   * This field determines how long to wait for the second step to complete.
   */
  canonicalDataProcessFilesTimeout: Duration = '1d'

  /**
   * Asset hierarchy relational data is loaded through Excel spreadsheets. This field determines
   * if that data ingestion step needs to be run.
   * Set this to `false` to load the excel spreadsheet.
   * Set this to `true` to skip this step.
   */
  doNotLoadExcelData: ?boolean = false

  /**
   * If {@link doNotLoadExcelData} is `false`, then specify the url where the excel spreadsheet
   * may be loaded from. If this field is left blank, then the system will try to infer the location
   * from the dataset generation job.
   */
  excelFilepath: string

  /**
   * If relational data must be loaded from an excel spreadsheet created by a
   * {@link ReliabilitySyntheticData.ReliabilityRisk.DataGenerationJob}, specify
   * the job instance. The data integration workflow will extract the replicated
   * excel spreadsheet generated by the job automatically.
   */
  syntheticDataGenerationJob: ReliabilitySyntheticData.ReliabilityRisk.DataGenerationJob

  /**
   * For performing data integration, the standard routine is to, first disable asynchronous processing
   * as DI is in progress, and then enable it post-DI to perform transformation of loaded data, such
   * as refreshing stored calculated fields or normalizing time series.
   * Set this to `false` to disable asynchronous processing during DI.
   * Set this to `true` to enable asynchronous processing during DI.
   */
  enableAsyncProcessing: ?boolean = false

  /**
   * Creates a workflow to enable or disable asynchronous processing during data integration.
   *
   * @param name
   *        The name of the workflow.
   * @param upsertAsyncProcessingDisabled
   *        Boolean flag indicating whether async processing should be disabled.
   * @returns A `Workflow` instance managing async processing configuration.
   */
  createSetAsyncProcessingConfigWorkflow: private function(
    name: !string,
    upsertAsyncProcessingDisabled: !boolean
  ): Workflow py

  /**
   * Creates a {@link Workflow} whose steps are:
   * 1. SourceFile#syncAll
   * 2. Wait for the above to complete
   * 3. SourceFile#processAll
   * 4. Wait for the above to complete
   * @param name
   *        Name of the {@link Workflow}
   * @param syncAllTimeout
   *        {@link Duration} of time to wait for {@link SourceFile#syncAll} to complete
   * @param processAllTimeout
   *        {@link Duration} of time to wait for DI (triggered by {@link SourceFile#processAll}) to complete
   * @returns a {@link Workflow}
   */
  createCanonicalLoadDataWorkflow: private function(
    name: !string,
    syncAllTimeout: Duration,
    processAllTimeout: Duration
  ): Workflow py

  /**
   * Retrieves the Excel file path for non-canonical data ingestion.
   * If a synthetic data generation job is provided, it extracts the generated Excel file path.
   *
   * @param excelFilepath
   *        The manually provided Excel file path (if any).
   * @param syntheticDataGenerationJob
   *        The synthetic data generation job instance.
   * @returns The resolved Excel file path.
   */
  getExcelFilepath: private function(
    excelFilepath: string,
    syntheticDataGenerationJob: ReliabilitySyntheticData.ReliabilityRisk.DataGenerationJob
  ): !string py

  /**
   * Creates a {@link Workflow} that manages {@link ReliabilityExcelParser#loadExcelTemplate}.
   * @param excelFilepath
   *        The full path to the Excel {@link File} that contains the Asset Hierarchy
   * @returns a {@link Workflow}
   */
  createNonCanonicalLoadDataWorkflow: private function(
    excelFilepath: string,
    syntheticDataGenerationJob: ReliabilitySyntheticData.ReliabilityRisk.DataGenerationJob
  ): Workflow py

  validate: ~ py
  preValidate: ~ py
  postValidate: ~ py
  createWorkflow: ~ py
}
