/**
 * Use this type to configure a {@link ReliabilityOrchestrator.ReliabilityRisk.RegisterModelsJob}.
 * Note that at least one of {@link #models}, {@link #modelFilter} and {@link #trainJobRun} should be specified.
 */
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
type ReliabilityOrchestrator.ReliabilityRisk.RegisterModelsJobOptions mixes BatchJobOptions {

  /**
   * The number of {@link ReliabilityMlModel}s that will be registered per batch.
   */
  batchSize: !int = 1

  /**
   * Which {@link ReliabilityMlModel}s to register. If specified, it will take precedence over
   * {@link #modelFilter} and {@link #trainJobRun}.
   */
  models: [ReliabilityMlModel]

  /**
   * {@link Filter} for fetching {@link ReliabilityMlModel}s to register.
   * It will be only used if {@link #models} is not specified, and it overrides the {@link #trainJobRun}.
   */
  modelFilter: string serialized Filter

  /**
   * {@link MlModel.Train.JobRun} for fetching {@link ReliabilityMlModel}s to register.
   * It will be only used if neither {@link #models} nor {@link #modelFilter} is specified.
   */
  trainJobRun: MlModel.Train.JobRun
}
