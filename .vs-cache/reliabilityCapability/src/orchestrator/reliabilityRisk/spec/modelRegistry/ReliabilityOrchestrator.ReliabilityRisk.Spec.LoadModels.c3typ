/**
 * A {@link Spec} to orchestrate a model registry workflow to load {@link ReliabilityMlModel}s. Under the hood,
 * the workflow kicks off a {@link ReliabilityOrchestrator.ReliabilityRisk.LoadModelsJob}. This workflow outputs
 * the {@link ReliabilityOrchestrator.ReliabilityRisk.LoadModelsJob} that was run in the target environment.
 * This job can be used to obtain the {@link ReliabilityModelRegistry.TargetEntry}s which contains information about
 * the newly loaded {@link ReliabilityMlModel}s in the target environment, as well as their corresponding model
 * from the source environment.
 *
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
type ReliabilityOrchestrator.ReliabilityRisk.Spec.LoadModels mixes ReliabilityOrchestrator.WorkflowConvertable {

  name: ~ = 'ReliabilityRisk_LoadModels'

  /**
   * The {@link File}s that should be used to load models in the target environment.
   */
  files: [File]

  /**
   * Use this field to specify the {@link BatchJobOptions} that should be used for the distribute the registering
   * of {@link ReliabilityMlModel}s
   */
  options: BatchJobOptions

  /**
   * Extract the models loaded by the completed {@link ReliabilityOrchestrator.ReliabilityRisk.LoadModelsJob}
   * and deploys the models as candidate models in the target environment.
   */
  deployModels: function(job: ReliabilityOrchestrator.ReliabilityRisk.LoadModelsJob): !Workflow.Run py

  /**
   * Forces the deployment of the {@link ReliabilityMlModel} in the target environment, even if validation
   * checks fail.
   */
  force: boolean = false

  createWorkflow: ~ py
}
