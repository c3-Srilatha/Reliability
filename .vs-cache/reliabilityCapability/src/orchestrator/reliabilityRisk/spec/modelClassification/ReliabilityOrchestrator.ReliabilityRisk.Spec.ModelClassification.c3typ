/**
 * A {@link Spec} to orchestrate a model classification Workflow, which kicks off an {@link MlModel.Evaluation.Job}
 * followed by a {@link ReliabilityOrchestrator.ReliabilityRisk.ModelClassificationJob}. Note that at least one of
 * {@link #models}, {@link #modelFilter} and {@link #trainJobRun} should be specified.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
@beta
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
type ReliabilityOrchestrator.ReliabilityRisk.Spec.ModelClassification mixes ReliabilityOrchestrator.WorkflowConvertable {

  name: ~ = 'ReliabilityRisk_ModelClassification'

  /**
   * Which {@link ReliabilityRiskMlModel}s to classify. If specified, it will take precedence over
   * {@link #modelFilter} and {@link #trainJobRun}.
   */
  models: [ReliabilityRiskMlModel]

  /**
   * {@link Filter} for fetching {@link ReliabilityRiskMlModel}s to classify.
   * It will be only used if {@link #models} is not specified, and it overrides the {@link #trainJobRun}.
   */
  modelFilter: string serialized Filter

  /**
   * {@link MlModel.Train.JobRun} for fetching {@link ReliabilityRiskMlModel}s to classify.
   * It will be only used if neither {@link #models} nor {@link #modelFilter} is specified.
   */
  trainJobRun: MlModel.Train.JobRun

  /**
   * Reference period to use for model classification. If specified, the same value
   * will be applied to all the models specified by {@link #models}, {@link #modelFilter} and {@link #trainJobRun}.
   * If this field is not specified, a default will be set for each model based on {@link ReliabilityMlDatasetPreparationRun#trainFeatureTimeRanges}.
   */
  referencePeriod: TimeRange

  /**
   * Comparison period to use for model classification. If specified, the same value
   * will be applied to all the models specified by {@link #models}, {@link #modelFilter} and {@link #trainJobRun}.
   * If this field is not specified, a default will be set for each model based on {@link ReliabilityMlDatasetPreparationRun#valFeatureTimeRanges}.
   */
  comparisonPeriod: TimeRange

  /**
   * The {@link MlModel.Evaluation.Spec} that should be used for model evaluation.
   */
  evaluationSpec: MlModel.Evaluation.Spec

  /**
   * The {@link ReliabilityRiskMlModel.ClassificationScoreSpec} that should be used for model classification.
   */
  spec: ReliabilityRiskMlModel.ClassificationScoreSpec

  /**
   * Specify whether this {@link ReliabilityOrchestrator.ReliabilityRisk.Spec.ModelClassification} instance is being used to monitor a model, or is being
   * used for model classification.
   */
  isMonitoring: boolean = false

  /**
   * Start an {@link MlModel.Evaluation.Job} and return the corresponding {@link MlModel.Evaluation.JobRun}.
   */
  startModelEvaluationJob: function(
    models: [ReliabilityRiskMlModel],
    modelFilter: string serialized Filter,
    trainJobRun: MlModel.Train.JobRun,
    referencePeriod: TimeRange,
    comparisonPeriod: TimeRange,
    spec: MlModel.Evaluation.Spec
  ): !MlOperationRun<MlModel.Evaluation.JobRun> py

  createWorkflow: ~ py
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
