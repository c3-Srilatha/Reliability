// TODO REL-7046: Remove this type.

/**
 * Spec to be used by {@link TranslationHelper#fetch}.
 */
type TranslationSpec mixes PartiallyAppliedAction, Spec {

  actionName: ?~
  /**
   * Map of ids (key) to translation keys (value) for which to fetch translations.
   * The ids can be defined arbitrarily and are intended to be used
   * in transforms.
   */
  translationMap: !map<string, string>
}
