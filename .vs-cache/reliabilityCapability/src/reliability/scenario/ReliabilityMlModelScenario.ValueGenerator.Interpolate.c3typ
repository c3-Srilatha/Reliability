/**
 * Specialized generator that builds a linear `np.array` with noise.
 */
type ReliabilityMlModelScenario.ValueGenerator.Interpolate mixes ReliabilityMlModelScenario.ValueGenerator {

  /**
   * Start numerical value of the linear interpolation.
   */
  start: !number

  /**
   * End numerical value of the linear interpolation.
   */
  end: !number

  /**
   * Noise factor applied to the linear interpolation.
   */
  noise: !number

  /**
   * Generates a `np.array` with a linear interpolation between #start and #end,
   * and adding normal noise with a standard deviation of #noise.
   *
   * @return A `np.array` instance with the interpolated values.
   */
  generateData: ~ py-data
}
