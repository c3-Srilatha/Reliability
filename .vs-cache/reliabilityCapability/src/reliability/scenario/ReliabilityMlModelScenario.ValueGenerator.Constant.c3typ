/**
 * Specialized generator that builds a "constant" `np.array` from a single numerical value.
 */
type ReliabilityMlModelScenario.ValueGenerator.Constant mixes ReliabilityMlModelScenario.ValueGenerator {

  /**
   * Constant number from which contruct the [identity series](Timeseries)
   */
  constantValue: !number

  /**
   * Generates a `np.array` with #constantValue.
   *
   * @return A `np.array` instance with the constant value.
   */
  generateData: ~ py
}
