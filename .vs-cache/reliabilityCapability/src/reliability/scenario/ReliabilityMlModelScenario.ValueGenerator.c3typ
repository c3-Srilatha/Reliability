/**
 * Base type for `np.array` generators in the context of Model Scenario.
 *
 * To build new generators, mix this type and implement `generateData` for your
 * custom implementation.
 */
type ReliabilityMlModelScenario.ValueGenerator {

  /**
   * Time range used to build the {@link TimeseriesInfo} (#buildTimeseriesInfo).
   */
  timeRange: TimeRange

  /**
   * Interval used to build the {@link TimeseriesInfo} (#buildTimeseriesInfo).
   */
  interval: Interval

  /**
   * Helper function that constructs a {@link TimeseriesInfo} instance using #timeRange and #interval.
   *
   * **NOTE**: This method ensures than the start and end dates in #timeRange are aligned with the given
   *           interval.
   *
   * @return A {@link TimeseriesInfo} object.
   */
  buildTimeseriesInfo: private inline member function(): TimeseriesInfo py

  /**
   * Generates a new `np.array`, in which the "constructor" is custom and individualy defined by
   * whichever type mixes this [type](ReliabilityMlModelScenario.ValueGenerator).
   *
   * @return A `np.array` instance.
   */
  generateData: abstract member function(): native
}
