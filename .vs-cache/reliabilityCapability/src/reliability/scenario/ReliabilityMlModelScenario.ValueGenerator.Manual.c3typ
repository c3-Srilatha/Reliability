/**
 * Specialized generator that returns a static `np.array` from a predefined list of values.
 */
type ReliabilityMlModelScenario.ValueGenerator.Manual mixes ReliabilityMlModelScenario.ValueGenerator {

  /**
   * Numerical data to be returned by #generateData.
   */
  data: ![number]

  /**
   * Generates a `np.array` from #data.
   *
   * @return A `np.array`.
   */
  generateData: ~ py-data
}
