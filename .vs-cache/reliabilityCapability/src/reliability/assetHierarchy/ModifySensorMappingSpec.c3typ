/**
 * Spec to modify the sensor mappings of a {@link ReliabilityAsset}.
 *
 * This spec is used to create new {@link Sensor}s, create new {@link ExpectedSensor}s, upsert {@link ReliabilityAssetSensorRelation}s,
 * remove sensor relations, and mark the asset's sensor mapping status as complete.
 */
type ModifySensorMappingSpec {

  /**
   * List of {@link Sensor}s to create.
   */
  sensorsToCreate: [Sensor]

  /**
   * List of {@link ExpectedSensor}s to create.
   */
  expectedSensorsToCreate: [ExpectedSensor]

  /**
   * List of {@link ReliabilityAssetSensorRelation}s to upsert.
   */
  sensorRelationsToUpsert: [ReliabilityAssetSensorRelation]

  /**
   * List of {@link ReliabilityAssetSensorRelation}s to remove.
   */
  sensorRelationsToRemove: [ReliabilityAssetSensorRelation]

  /**
   * Whether to mark the asset's sensor mapping status as complete.
   */
  markAsComplete: boolean
}
