/**
 * Job type for aggregating model outputs across reliability assets using map-reduce processing.
 * This type provides functionality to create and manage batch jobs that aggregate the latest
 * model predictions and outputs for reliability analysis.
 */
type ReliabilityAsset.AggModelOutputJob {

    /**
     * Creates and starts a map-reduce job to aggregate the latest model outputs across reliability assets.
     * This function processes model predictions in batches to compute aggregated metrics and statistics
     * for reliability analysis and reporting.
     *
     * @param batchSize The number of assets to process in each batch during the map-reduce operation.
     *
     * @returns A job handle that can be used to monitor the progress and retrieve results of the
     *          aggregation operation.
     */
    launchMapReduceJobForLatestModelOutputAggregation : function(batchSize: int, filter: string) : !any py-data
}
