entity remix type PhysicalAsset mixes MemberEntityMapping<MemberToPhysicalAsset> {

  /**
   * The active {@link TimeToEventPrediction} objects directly belonging to this asset
   */
  @db(order='predictedValueExceedsThresholdDate', filter='predictedValueExceedsThresholdDate > now()')
  timeToEventPredictions: [TimeToEventPrediction](physicalAssetEventCategoryRelation.from)

  /**
   * The relations to {@link EventCategory} this asset has
   */
  @db(order='latestPrediction.predictedValueExceedsThresholdDate',
      filter='latestPrediction.predictedValueExceedsThresholdDate > now()')
  eventCategoryRelations: [PhysicalAssetEventCategoryRelation](from)
}
