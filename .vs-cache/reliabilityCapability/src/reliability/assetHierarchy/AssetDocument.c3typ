remix type AssetDocument {
  /**
   * This is typically used to link to an external resource or website associated with the document.
   */
  externalurl: string

  /**
   * URL field useable in the UI.
   */
  displayUrl: string calc exists(externalurl) ? externalurl : fileUrl

  /**
   * Create a new AssetDocument from the data obtained from form.
   *
   * @param formObject
   *           Data collected from form component. It includes asset id, file name and url, description,
   *           and flag indicating if file should be linked  to all asset children.
   */
  createAssetDocument: function(formObject: !json) js-rhino

  /**
   * Returns configuration object containing data for uploading a file to the server.
   *
   * @return The json object with the keys: `{tenant: <tenant>, tag: <tag>}`.
   */
  getUploadConfig: function(): json js-rhino
}
