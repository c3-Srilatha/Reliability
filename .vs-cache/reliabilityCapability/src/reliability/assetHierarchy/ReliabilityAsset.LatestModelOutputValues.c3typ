/**
 * Stores the latest model output values for a {@link ReliabilityAsset}.
 */
entity type ReliabilityAsset.LatestModelOutputValues {

    /**
     * The {@link ReliabilityAsset} for which the latest model output values are stored.
     */
    asset: !ReliabilityAsset

    /**
     * The {@link ReliabilityMl.Project} that produced the model output scores.
     */
    project: !ReliabilityMl.Project

    /**
     * The latest model output score produced by the {@link #project} for the {@link #asset}.
     */
    value: !any
}
