/**
 * Type representing comment on a {@link ReliabilityAssetAlert}
 */
entity type AlertComment mixes FileAttachmentParent<ReliabilityAssetAlertCommentAttachment>, TaggedComment<ReliabilityAssetAlert>, UserInformation, FilterableByFacility {
  /**
   * Flag to determine if the comment was added closing an alert.
   */
  isCloseComment: boolean

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["parent.parent.facility"]

  /**
   * Creates an {@link AlertComment} and its associated {@link ReliabilityAssetAlertCommentAttachment}
   * based on the information provided through the add comment and upload files form.
   *
   * @return The new {@link AlertComment}.
   */
  createFromForm: function(formObject: !json): AlertComment js-rhino

  /**
   * Name of the {@link User} creating the comment.
   */
  createdBy: string = meta.createdBy

  /**
   * @inheritdoc
   */
  createNotificationSubject: abstract ~

  /**
   * @inheritdoc
   */
  createNotificationContent: abstract ~
}
