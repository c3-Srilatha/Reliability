/**
 * Type that allows us to go from ReliabilityAssetAlert to the FailureModeRecommendation(s) associated with it.
 */
@db(unique=['from, to'])
entity extendable type ReliabilityAssetAlertFailureRecommendationRelation extends FailureRecommendationRelation mixes FilterableByFacility type key 'RAAFRR' {

  /**
   * The alert of the relation.
   */
  from: !ReliabilityAssetAlert

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["from.parent.facility"]
}
