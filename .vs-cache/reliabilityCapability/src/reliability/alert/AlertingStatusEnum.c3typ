/**
 * Possible values for the alerting status of a {@link Sensor} or {@link ReliabilityMlModel}.
 */
enum type AlertingStatusEnum {

  /**
   * Indicates that {@link SensorHealthAlert}s or {@link ReliabilityAssetAlert}s are muted for the given {@link Sensor} or {@link ReliabilityMlModel}
   */
  MUTED = 'MUTED'

  /**
   * Indicates that {@link SensorHealthAlert}s or {@link ReliabilityAssetAlert}s are not muted for the given {@link Sensor} or {@link ReliabilityMlModel}.
   */
  UNMUTED = 'UNMUTED'
}
