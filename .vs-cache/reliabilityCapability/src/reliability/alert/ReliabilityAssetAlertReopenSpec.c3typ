/**
 * A type which dicatates when a{@link ReliabilityAssetAlert} is reopened, how are
 * {@link ReliabilityAssetAlert#cases} and the alerts on them are handled.
 */
type ReliabilityAssetAlertReopenSpec {

  /**
   * boolean flag indicating if the cases on alert need to be reopened
   */
  reopenCases: !boolean

  /**
   * A list of cases on the alert which need to be reopened
   * In addition to `Open`ing the case, any closed alerts on these cases will also be `Open`ed.
   */
  casesToBeReopened: [ReliabilityAssetCase]
}
