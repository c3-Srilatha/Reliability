/**
 * Type to store periods to mute alerts for a specific {@link ReliabilityAsset} and {@link ReliabilityMlModel}s or
 * {@link Sensor}s.
 */
entity type AlertMutedPeriod mixes TimedIntervalValue, FilterableByFacility schema name 'RAA_MP' {

  /**
   * The {@link ReliabilityAsset} whose model or sensor is muted by this period.
   */
  parent: ReliabilityAsset

  /**
   * The type of alert to apply this muted status on.
   */
  @deprecated(finalVersion='21.0.1', details='Use #target instead.')
  alertType: ReliabilityAlertType

  /**
   * The start of the muted period.
   * If null, defaults to now.
   */
  start: ~

  /**
   * The end of the muted period.
   */
  end: !~

  /**
   * The specific entity instance that this muted period applies to. Supported types are:
   * - {@link ReliabilityMlModel} - champion models only.
   * - {@link Sensor}.
   * A {@link ReliabilityAlertType#typeName} will correspond to the given target, and the corresponding {@link ReliabilityAlertType#alertType}
   * will be muted for this instance.
   */
  target: !Persistable

  /**
   * The status of this period, indicating whether it is active.
   */
  active: boolean calc start <= now() && end > now()

  /**
   * Merges {@link AlertMutedPeriod}s based on the provided {@link AlertMutedPeriodSpec}s.
   * If an active muted period already exists for the given #parent, and #target, and the
   * {@link AlertMutedPeriodSpec#action} is 'MUTE', the existing period is terminated by setting its #end to now,
   * and a new period is created with the new #start and #end from the spec, in order to preserve historical data.
   * If the {@link AlertMutedPeriodSpec#action} is 'UNMUTE', any active periods for the given #parent and #target
   * are ended immediately by setting their #end to now.
   * @param specs
   *           The specifications to create muted periods from.
   * @return The newly created {@link AlertMutedPeriod}s.
   */
  mergeMutedPeriods: function(specs: ![AlertMutedPeriodSpec]): ![AlertMutedPeriod] js-rhino

  /**
   * As the muted period is created, check that the `start` and `end` parameters
   * of the period are valid.
   */
  @deprecated(finalVersion='21.0.1', details='Use {@link AlertMutedPeriodSpec#validate} instead.')
  beforeCreate: ~ js-rhino

  /**
   * As the muted period is updated, check that the `start` and `end` parameters
   * of the period are valid.
   */
  @deprecated(finalVersion='21.0.1', details='Use {@link AlertMutedPeriodSpec#validate} instead.')
  beforeUpdate: ~ js-rhino

  /**
   * The function to create a new period.
   */
  @deprecated(finalVersion='21.0.1', details='Use #mergeMutedPeriods instead.')
  createMutedPeriod: function(parent: !ReliabilityAsset,
                              alertType: !ReliabilityAlertType,
                              start: datetime,
                              end: datetime,
                              duration: double): !AlertMutedPeriod js-rhino

  /**
   * The function to update the dates of the period.
   */
  @deprecated(finalVersion='21.0.1', details='Use #mergeMutedPeriods instead.')
  updateMutedPeriodDates: member function(start: datetime,
                                          end: datetime,
                                          duration: double): !AlertMutedPeriod js-rhino

  /**
   * The function to update the status of the period.
   */
  @deprecated(finalVersion='21.0.1', details='Use #mergeMutedPeriods instead.')
  updateMutedPeriodStatus: member function(mute: boolean): !AlertMutedPeriod js-rhino

  /**
   * Function to know if a {@link ReliabilityAssetAlert} or {@link SensorHealthAlert} should be muted.
   * @param alert
   *        The {@link ReliabilityAssetAlert} or {@link SensorHealthAlert} to check if it should be muted.
   * @return true if the alert should be muted, false otherwise.
   */
  shouldMuteAlert: function(alert: ReliabilityAssetAlert | SensorHealthAlert): boolean js-rhino

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["parent.facility"]
}
