remix type ReliabilityAssetAlertBase mixes WithPrecomputedFeatures {
  /**
   * Fetches the features for a particular alert based on its {@link #triggeringModel}. Utilizes
   * {@link #featureContributionMap} for fetching contributions if available.
   *
   * This function uses {@link WithPrecomputedFeatures#precomputedFeatures} to store precomputedFeatures. If the
   * result is not updating as expected, remove {@link PrecomputedFeatures} instances.
   *
   * @param spec
   *        The specification for the features to fetch. See {@link FeatureFetchBase#fetchFeatures} for more details
   *        on what the `spec` parameter can contain.
   * @param failureModeIds
   *        The failure mode ids to filter the features by.
   *
   * @returns {@link FetchResultWithTotalCount<FeatureFetchBase>}
   *    A result containing the fetched features along with a total count of matches.
   *
   */
  @action(group='read')
  fetchFeatures: member function(spec: FetchSpec, failureModeIds: [string]): FetchResultWithTotalCount<FeatureFetchBase> js-rhino

  /**
   * Gets all the relevant feature names for this alert.
   *
   * @return The feature names of this alert.
   */
  @action(group='read')
  fetchFeatureNames: inline member function(): [string] js-rhino
}
