/**
 * A batch job that creates the {@link ReliabilityAssetAlertSimilarity} objects for {@ReliabilityAssetAlert}s.
 */
entity type ReliabilityAssetAlertSimilarityCreationBatchJob extends BatchJob<
  ReliabilityAssetAlertSimilarityCreationBatchJob,
  ReliabilityAssetAlertSimilarityCreationJobOptions,
  ReliabilityAssetAlertSimilarityCreationBatch> type key 'RAASCBJ' {

  doStart: ~ py

  processBatch: ~ py
}
