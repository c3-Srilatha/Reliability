/**
 * Type to store common fields between similarity types.
 * For small volume of alerts use {@link ReliabilityAssetAlertSimilaritySmall}
 * For large volume of alerts use {@link ReliabilityAssetAlertSimilarityLarge}
 */
type ReliabilityAssetAlertSimilarity {
  /**
   * {@link ReliabilityAssetAlert} whose creation prompted the generation of this similarity score.
   */
  baseAlert: !ReliabilityAssetAlert

  /**
   * {@link ReliabilityAssetAlert} being compared against the base alert.
   */
  comparableAlert: !ReliabilityAssetAlert

  /**
   * A numeric score representing the extent of similarity for the two {@link ReliabilityAssetAlert}s.
   * For the base app, this will be a number between 0 and 1 inclusive.
   */
  similarityScore: !double

  /**
   * Value of any type representing similarity for the two {@link ReliabilityAssetAlert}s.
   * It can be a numeric percentage, a categorical string (e.g., High, Medium, Low), or another type of value
   * This value will be showed in the UI.
   *
   * For the base app, this will be the similarityScore * 100.
   */
  displaySimilarity: !any
}
