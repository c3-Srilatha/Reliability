/**
 * Type that allows us to go from {@link ReliabilityAssetAlert} to the {@link FailureModeLineItem}(s) associated with it.
 */
@db(unique=['from, to'])
entity extendable type ReliabilityAssetAlertFailureModeRelation extends FailureModeRelation mixes FilterableByFacility type key 'SAMFR' {

  /**
   * The alert of the relation.
   */
  from: !ReliabilityAssetAlert

  /**
   * The name of the alert being linked. Necessary because {@link FailureModeRelation#fromName} is an `anyof` reference, which cannot be traversed.
   */
  fromName: string stored calc from.name

  /**
   * How significant the {@link FailureModeLineItem} is to the {@link ReliabilityAssetAlert}. All significance scores for an alert add up to 1.
   * This is populated upon the creation of the {@link ReliabilityAssetAlert}s.
   */
  significance: ~

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["from.parent.facility"]
}
