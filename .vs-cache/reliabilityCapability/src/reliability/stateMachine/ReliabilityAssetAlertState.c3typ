/**
 * The state of a {@link ReliabilityAssetAlert}.
 */
entity type ReliabilityAssetAlertState mixes StateMachineState<ReliabilityAssetAlertState, ReliabilityAssetAlertStateTransition>, ExemptFromFacilityFilter schema name 'SBSYS_LRT_ST' {

  /**
   * The name of the state, translated based on id,
   * including: Closed, Muted, Open, Case.
   */
  name: string translate by id
}
