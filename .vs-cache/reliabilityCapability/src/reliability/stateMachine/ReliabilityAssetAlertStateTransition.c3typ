/**
 * Represents a state transition for {@link ReliabilityAssetAlertState} within a state machine.
 * This entity defines the valid transitions between different alert states for a reliability asset.
 */
entity type ReliabilityAssetAlertStateTransition mixes StateMachineTransition<ReliabilityAssetAlertState, ReliabilityAssetAlertStateTransition>, ExemptFromFacilityFilter schema name 'SBSYS_LRT_TRNS' {
  // TODO REL-22556: [REL 20.0.0] - Remove workaround in ReliabilityAssetAlert#notClosedCases to avoid state machine transition issues when upgrading to 8.8
  /**
   * Adds retry mechanism to wait for {@link ReliabilityAssetAlertState} to be seeded before
   * executing {@link ReliabilityAssetAlertStateTransition#refreshCalcFields}.
   */
  afterCreate: ~ js-rhino
}
