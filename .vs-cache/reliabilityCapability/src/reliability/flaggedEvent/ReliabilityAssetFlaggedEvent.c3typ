/**
 * The type to store all flagged events happening per {@link ReliabilityAsset} for {@link MlModel}.
 */
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
entity extendable type ReliabilityAssetFlaggedEvent mixes TimedIntervalValue schema name 'RAFE' {

  /**
   * The {@link ReliabilityAsset}.
   */
  parent: !ReliabilityAsset

  /**
   * The {@link FlaggedEventType}.
   */
  eventType: FlaggedEventType

  /**
   * The {@link Sensor}s responsible for the flagged event.
   */
  sensors: [Sensor] schema name 'RAFE_SNS'

  /**
   * Function to update a {@link ReliabilityAssetFlaggedEvent} by adding sensors.
   */
  addSensors: member function(sensors: ![Sensor]): string js-rhino

  /**
   * Function to update a {@link ReliabilityAssetFlaggedEvent} by removing sensors.
   */
  removeSensors: member function(sensors: ![Sensor]): string js-rhino
}
