/**
 * Source type for the APIs to create or update {@link ReliabilityAssetFlaggedEvent}.
 */
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
type ReliabilityAssetFlaggedEventSpec mixes Spec {

  /**
   * ID Matches the ID of the {@link ReliabilityAssetFlaggedEvent}.
   */
  id: string

  /**
   * The start date.
   */
  start: !datetime

  /**
   * The end date.
   */
  end: !datetime

  /**
   * The {@link FlaggedEventType}.
   */
  eventType: FlaggedEventType

  /**
   * The description of the {@link FlaggedEventType} if a new one is created.
   */
  eventTypeDescription: string

  /**
   * The {@link Sensor} to add or remove to an event.
   */
  sensors: [Sensor]
}
