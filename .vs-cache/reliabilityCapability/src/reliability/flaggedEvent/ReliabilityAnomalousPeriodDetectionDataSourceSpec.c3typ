/**
 * Spec to build the dataset on which the anomaly detection method is going to be performed. The dataset is built
 * by calling the `evalMetrics()` method on {@link Sensor} with the metric `Quantity`.
 */
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
type ReliabilityAnomalousPeriodDetectionDataSourceSpec mixes Spec {

  /**
   * Start date for the EvalMetrics call on {@link Sensor}
   */
  start: !datetime

  /**
   * End date for the EvalMetrics call on {@link Sensor}
   */
  end: !datetime

  /**
   * Interval or granularity for the EvalMetrics call on {@link Sensor}
   */
  interval: string enum Interval = QUARTER_HOUR

  /**
   * Array of {@link Sensor}s to build the dataset. By default, `sensors` is populated with every
   * {@link Sensor}s which are below the {@link ReliabilityAsset} the method `detectAnomalousPeriod()` is
   * on in the hierarchy.  Filter of the fetch performed on {@link Sensor} is `currentReliabilityAssetSensorRelations.from==asset.id`
   */
  sensors: [Sensor] schema suffix 'SR'
}
