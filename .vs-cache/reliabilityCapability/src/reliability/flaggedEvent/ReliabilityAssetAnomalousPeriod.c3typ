/**
 * Type to store all anomalous time periods to mask in {@link MlModel}
 * It represents a point-in-time event that occurred on an asset.
 * This is supposed to represent a time range of anomalous activity of the asset, either detected by a SME or through some data-centric methods we will add in the future.
 * Essentially, this representshe user-defined mask on the model config, the mask which will tell the model to ignore certain time periods from training.
 */
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
type ReliabilityAssetAnomalousPeriod extends ReliabilityAssetFlaggedEvent mixes Value type key 'RAAP'
