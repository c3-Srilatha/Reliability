/**
 * Represents the specification for opening existing {@link FailureModeLineItem}s.
 */
type OpenFailureModeLineItemExistingSpec mixes Spec {

  /**
   * {@link FailureModeLibrary} representing the library associated with the failure mode.
   */
  failureModeLibrary: FailureModeLibrary

  /**
   * Name of the sensor expected to be associated with this failure mode.
   */
  expectedSensorName: string

  /**
   * {@link FailureModeDiagnostic} representing the diagnostic details for the failure mode.
   */
  diagnostic: FailureModeDiagnostic

  /**
   * {@link FailureMode} representing the specific failure mode being referenced.
   */
  failureMode: FailureMode

  /**
   * {@link FailureModePriority} representing the priority assigned to this failure mode.
   */
  priority: FailureModePriority

  /**
   * A string detailing any exceptions associated with this spec.
   */
  exceptions: string

  /**
   * A string representing the fault category, which is an enumeration of {@link FailureModeFaultCategory}.
   */
  faultCategory: string enum FailureModeFaultCategory

  /**
   * {@link Unit} representing the unit of measure for this failure mode line item.
   */
  unit: Unit
}
