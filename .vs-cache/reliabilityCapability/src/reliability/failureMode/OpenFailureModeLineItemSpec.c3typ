/**
 * Spec type used to create {@link FailureMode}s and {@link FailureModeLineItem}s
 * from the Config page in Reliability.
 */
type OpenFailureModeLineItemSpec mixes Spec {

  /**
   * The {@link FailureModeLibrary} the new {@link FailureMode} is being added to.
   */
  failureModeLibrary: FailureModeLibrary

  /**
   * The {@link ExpectedSensor#name} which is used to populate {@link FailureModeLineItem#expectedSensor}.
   */
  expectedSensorName: string

  /**
   * The {@link FailureModeDiagnostic} placed on {@link #diagnostic} that runs the logic
   * to automatically link {@link FailureModeLineItem}s to {@link ReliabilityAssetAlert}s.
   */
  diagnostic: FailureModeDiagnostic

  /**
   * The name of the {@link FailureMode} being created.
   */
  failureModeName: string

  /**
   * The priority of the {@link FailureModeLineItem} being created.
   */
  priority: FailureModePriority

  /**
   * The exceptions on the {@link FailureModeLineItem} being created.
   */
  exceptions: string

  /**
   * The kind of fault the {@link FailureModeLineItem} is.
   */
  faultCategory: string enum FailureModeFaultCategory

  /**
   * The unit on the {@link ExpectedSensor} being created.
   */
  unit: Unit

  /**
   * Indicates whether or not the {@link FailureMode} was created by a user in the UI.
   */
  userCreated: boolean = true
}
