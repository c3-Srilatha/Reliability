remix type FailureModeLibrary {

  /**
   * Creates new failure mode library
   */
  createFailureModeLibrary: function(formObject: !json): FailureModeLibrary js-rhino

  /**
   * Copies existing failure mode library into new failure mode library
   */
  duplicateFailureModeLibrary: function(formObject: !OpenFailureModeLibrarySpec): FailureModeLibrary js-rhino
}
