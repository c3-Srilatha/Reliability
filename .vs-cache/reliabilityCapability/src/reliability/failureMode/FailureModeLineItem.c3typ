remix type FailureModeLineItem {

  /**
   * String that denotes how many recommended actions are associated with this entity.
   */
  recommendedActionsCountString: string stored calc (numRecommendations == 1) ? concat(numRecommendations, " Action") : concat(numRecommendations, " Actions")

  /**
   * Foreign key to the {@link ReliabilityAssetAlert} associated with this {@link FailureModeLineItem}.
   */
  alertRelations: [ReliabilityAssetAlertFailureModeRelation](to)

  /**
   * The latest time that {@link FailureModeLineItem} and/or its {@link ExpectedSensor} gets updated, specifically for FailureModeLibraryGrid UI.
   */
  updatedTimestamp: datetime stored calc latest(meta.updated, expectedSensor.meta.updated)

  /**
   * Return the url for the FML data zip file.
   * Zip file includes all the failure mode library types.
   */
  getExportDataUrl: function(filename: string, filter: string): string js-rhino

  /**
   * The method to be edit {@link FailureModeLineItem} after submitting EditFailureModeLibraryDetailForm from the UI.
   */
  editFailureModeLineItemOnFormSubmit: function(formObject: json) js-rhino

  /**
   * Creates a new @{link FailureModeLineItem} from scratch.
   */
  createFailureModeLineItemNew: function(formObject: !OpenFailureModeLineItemSpec): FailureModeLineItem js-rhino

  /**
   * Create Failure Mode From Existing Failure Mode.
   */
  createFailureModeLineItemExisting: function(formObject: !OpenFailureModeLineItemExistingSpec): FailureModeLineItem js-rhino

  /**
   * Helper function for {@link deleteAlertFailureModeLineItemRelations}.
   */
  doDeleteFailureModeLineItemRelations: private function(from: string,
                                                         relation: string,
                                                         recRelationType: !Type) js-rhino

  /**
   * Deletes all {@link ReliabilityAssetAlertFailureRecommendationRelation}s and {@link ReliabilityAssetAlertFailureModeRelation}s associated with
   * the {@link DeleteFailureModeLineItemSpec#alert} and {@link DeleteFailureModeLineItemSpec#failureModeLineItem}.
   */
  deleteAlertFailureModeLineItemRelations: function(formObject: DeleteFailureModeLineItemSpec) js-rhino

  /**
   * Deletes all {@link FailureModeRecommendation}s, {@link FailureRecommendationRelation}s, and {@link FailureModeRelation}s
   * associated with the Line Item and then deletes the FailureModeLineItem instance.
   */
  deleteFailureModeLineItemOnFormSubmit: function(formObject: !DeleteFailureModeLineItemSpec) js-rhino

  /**
   * The method to be create FailureModeRecommendations after submitting FailureModeRecommendationAddModal from the UI.
   */
  @action(group='asset-onboarding-write')
  createFailureModeRecommendation: function(formObject: json) js-rhino
}
