/**
 * Spec type used to delete the relation types associated with a {@link FailureModeLineItem}
 * and/or the {@link FailureModeLineItem} itself.
 */
type DeleteFailureModeLineItemSpec mixes Spec {

  /**
   * ID Matches the ID of the FailureModeLineItem that is being deleted.
   */
  failureModeLineItem: string

  /**
   * The ID of the {@link FailureModeRelation} to remove.
   */
  relation: string

  /**
   * The id of the {@link ReliabilityAssetCase}.
   */
  case: string

  /**
   * The id of the {@link ReliabilityAssetAlert}.
   */
  alert: string
}
