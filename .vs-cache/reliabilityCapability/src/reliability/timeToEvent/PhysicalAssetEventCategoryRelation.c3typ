/**
 * Represents the relation between a {@link PhysicalAsset} and an {@link EventCategory}.
 */
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
entity extendable type PhysicalAssetEventCategoryRelation mixes FeatureEvaluatable schema name 'ASSET_EVENT_CAT_REL' {

  /**
   * The {@link PhysicalAsset} this relation comes from.
   */
  from: !PhysicalAsset

  /**
   * The {@link EventCategory} this relation connects to.
   */
  to: !EventCategory

  /**
   * Display string for UI to represent this relation
   */
  displayStr: string stored calc concat(from.name, " - ", to.name)

  /**
   * The predictions associated with this relation
   */
  @db(order='descending(parent.timestamp)')
  predictions: [TimeToEventPrediction](physicalAssetEventCategoryRelation)

  /**
   * The latest prediction for this asset/event combination
   */
  latestPrediction: TimeToEventPrediction stored calc predictions[0]

  /**
   * How often a prediction is generated for this event-asset combination, in terms of number of hours
   */
  predictionFrequency: int

  /**
   * The last date where a prediction was generated for this event-asset combination
   */
  lastPredictionDate: datetime stored calc predictions[0].parent.timestamp

  /**
   * All instances of {@link ProbabilisticForecastResult} associated with this relation
   */
  @db(order='descending(timestamp)')
  probabilisticForecastResults: [ProbabilisticForecastResult](physicalAssetEventCategoryRelation)
}
