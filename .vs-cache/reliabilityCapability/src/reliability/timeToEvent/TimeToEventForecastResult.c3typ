/**
 * Type to be populated by ML pipeline with "raw" results. Converted to a {@link TimeToEventPrediction} which contains just the results needed for UI purposes.
 */
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
entity extendable type TimeToEventForecastResult schema name 'TTE_RES' {

  /**
   * Description of this prediction, corresponds to description from ML pipeline directly
   */
  description: string

  /**
   * When this forecast was generated
   */
  timestamp: datetime

  /**
   * Equipment-event category combination that this forecast is for
   */
  physicalAssetEventCategoryRelation: !EquipmentEventCategoryRelation

  /**
   * The features which contributed to this forecast
   */
  featureRelations: [TimeToEventForecastResultFeatureRelation](from)
}
