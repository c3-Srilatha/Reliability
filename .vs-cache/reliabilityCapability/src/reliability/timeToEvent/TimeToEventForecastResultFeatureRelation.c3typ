/**
 * Represents the relation between a {@link TimeToEventForecastResult} and a {@link TimeToEventForecastResultFeature}.
 */
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
entity type TimeToEventForecastResultFeatureRelation schema name 'FRCST_FRCST_RSLT' {

  /**
   * The {@link TimeToEventForecastResult} this relation comes from.
   */
  from: !TimeToEventForecastResult

  /**
   * The {@link TimeToEventForecastResultFeature} this relation connects to.
   */
  to: !TimeToEventForecastResultFeature

  /**
   * A stored calc of the sensor value at the time of event prediction
   */
  value: double calc to.sensor.pointSeries[0].data.(year(start)==year(from.timestamp) && month(start)==month(from.timestamp) && day(start)==day(from.timestamp))[0].quantity.value
}
