/**
 * A single measurement on a probabilistic forecast.
 */
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
entity type ProbabilisticForecastMeasurement schema name 'PF_MEAS' {

  /**
   * The {@link ProbabilisticForecastResult} to which this measurement belongs.
   */
  parent: !ProbabilisticForecastResult

  /**
   * The timestamp associated with this measurement.
   */
  timestamp:  !datetime

  /**
   * The forecasted value at the given timestamp.
   */
  value: !double

  /**
   * The upper confidence bound for the forecasted value.
   */
  upperBound: double

  /**
   * The lower confidence bound for the forecasted value.
   */
  lowerBound: double
}
