/**
 * Represents the result of a survival analysis prediction, extending {@link TimeToEventForecastResult}.
 * This type stores predicted survival durations and confidence bounds for an event occurring.
 */
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
entity type SurvivalAnalysisResult extends TimeToEventForecastResult type key 'SA' {

  /**
   * Predicted number of days until the event, as of time of generation.
   */
  predictedDaysUntilEvent: !int

  /**
   * Lower bound on the predicted number of days until the event, as of time of generation.
   */
  predictedDaysUntilEventLowerBound: int

  /**
   * Upper bound on the predicted number of days until the event, as of time of generation.
   */
  predictedDaysUntilEventUpperBound: int

  /**
   * Function to create TimeToEventPrediction with predicted dates from SurvivalAnalysisResult
   * Returns a TimeToEventPrediction obj
   * @return A {@link TimeToEventPrediction} object with predicted dates.
   */
  @dependency(include='id, predictedDaysUntilEvent')
  createTimetoEventPrediction: member function(): TimeToEventPrediction js-rhino

  /**
   * Function to return a TimeToEventPrediction with predicted dates from SurvivalAnalysisResult
   * This method does not upsert TimeToEventPrediction
   * @return A {@link TimeToEventPrediction} object with predicted dates.
   */
  getTimetoEventPredictionFromSAR: member function(): TimeToEventPrediction js-rhino

  /**
   * Function to create batch of TimeToEventPredictions with predicted dates from SurvivalAnalysisResult
   * @param survivalAnalysisResults
   *           Array of survival analysis results to create predictions from.
   * @return An array of newly created {@link TimeToEventPrediction} objects.
   */
  createBatchTimeToEventPredictions: function(survivalAnalysisResults: [SurvivalAnalysisResult])
                                       : [TimeToEventPrediction] js-rhino
}
