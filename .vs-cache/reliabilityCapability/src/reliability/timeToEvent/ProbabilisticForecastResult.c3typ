/**
 * Represents the result of a probabilistic forecast, extending {@link TimeToEventForecastResult}.
 * This entity models time-to-event predictions using probabilistic measurements and thresholds.
 */
@deprecated(
  finalVersion='21.0.0',
  details='The `reliabilityRisk` MlProject, ReliabilityRiskMlModel and associated types are deprecated and will be removed in version 22.0.0 and beyond. Use the `reliabilityRiskWithResidualDiagnostics` project instead.')
entity type ProbabilisticForecastResult extends TimeToEventForecastResult mixes FeatureEvaluatable type key 'PF' {

  /**
   * The threshold value at which the event occurs if the value surpasses it
   */
  threshold: !double

  /**
   * The name of the threshold
   */
  thresholdName: string

  /**
   * Whether the event is triggered by the value being too high or too low.
   */
  diagnostic: !string enum('HIGH', 'LOW') = 'HIGH'

  /**
   * Measurements for this forecast
   */
  @db(order='ascending(timestamp)')
  measurements: [ProbabilisticForecastMeasurement](parent)

  /**
   * Function to create TimeToEventPrediction with predicted dates from ProbabilisticForecastResult
   * @return A {@link TimeToEventPrediction} object with predicted dates.
   */
  @dependency(include='id, measurements.value, measurements.upperBound, measurements.lowerBound, measurements.timestamp, threshold, diagnostic, physicalAssetEventCategoryRelation')
  createTimeToEventPrediction: member function(): TimeToEventPrediction js-rhino

  /**
   * Function to return a TimeToEventPrediction with predicted dates from ProbabilisticForecastResult
   * This method does not upsert TimeToEventPrediction
   * @return A {@link TimeToEventPrediction} object with predicted dates.
   */
  getTimetoEventPredictionFromPFR: member function(): TimeToEventPrediction js-rhino

  /**
   * Function to create batch of TimeToEventPredictions with predicted dates from ProbabilisticForecastResults
   * @param probabilisticForecastResults
   *           Array of probabilistic forecast results to create predictions from.
   * @return An array of newly created {@link TimeToEventPrediction} objects.
   */
  createBatchTimeToEventPredictions: function(probabilisticForecastResults: [ProbabilisticForecastResult]): [TimeToEventPrediction] js-rhino
}
