/**
 * Type housing all statistics for a given {@link InventorySeries#partNumber} part and corresponding {@link WorkOrder}s.
 */
type WorkOrderStats {
  /**
   * Represents number of {@link WorkOrder}s which have a given {@link InventorySeries#partNumber} part allocated/reserved for it's execution.
   * Only considers {@link WorkOrder}s scheduled in the future.
   */
  workOrdersReserved: int

  /**
   * Represents number of {@link WorkOrder}s which have a given {@link InventorySeries#partNumber} required for it's execution, but was not allocated to it.
   * Only considers {@link WorkOrder}s scheduled in the future.
   */
  workOrdersImpacted: int

   /**
  * Calculates number of {@link WorkOrder}s which have sufficient required parts reserved/allocated to them.
  * If no `seriesObj` parameter is passed, gets count of all and any such work orders.
  * If `seriesObj` paramter is passed, get count of only those work orders which have part resevred for them.
  * Only considers {@link WorkOrder}s scheduled in the future.
  */
  calculateWorkOrdersReserved: private function(seriesObj: InventorySeries): int js-rhino

  /**
  * Calculates number of {@link WorkOrder}s which don't have sufficient required parts allocated to them.
  * If no `seriesObj` parameter is passed, gets count of all and any such work orders.
  * If `seriesObj` paramter is passed, get count of only those work orders impacted by that part.
  * Only considers {@link WorkOrder}s scheduled in the future.
  */
  calculateWorkOrdersImpacted: function(seriesObj: InventorySeries): int js-rhino

  /**
   * Calculates {#workOrdersReserved} and {#workOrdersImpacted}
   *
   * 'workOrdersReserved' is the count of {@link WorkOrderPartsForecast} instances that match `part.id`,
   * forecasted based on the {@link WorkOrder}s, and have an `inventoryDelta` greater than or equal to 0
   *
   * `workOrdersImpacted` is the count of {@link WorkOrderPartsForecast} instances that match `part.id`,
   * forecasted based on the {@link WorkOrder}s, and have an `inventoryDelta` less than 0
   *
   * @param seriesObj
   *          The {@link InventorySeries} instance, for which the stats have to be calculated.
   *
   * @returns instance of {@link InventorySeries} object with {#workOrdersReserved} and {#workOrdersImpacted} populated.
   */
  calculateWorkOrderStats: function(seriesObj: !InventorySeries): !InventorySeries js-rhino
}
