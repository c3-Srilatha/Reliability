/**
 * {@link TimedDataHeader} for {@link InventoryMeasurement}
 * This header file is used to track parts tied to {@link WorkOrder}s and items tied to {@link PurchaseOrder}s.
 * Type which introduces various statistics related fields and their calculation capability into {@link InventorySeries}.
 */
remix type InventorySeries mixes InventoryStats, WorkOrderStats, PurchaseOrderStats {
  /**
    * Refreshes and updates the following for the parts resolved through passed in spec:
    * - {#daysOnHand}, {#currentStock}, {#avgDailyUsage} calculated via {@link InventoryStats#calculateInventoryStats}.
    * - {#workOrdersImpacted}, {#workOrdersReserved} calculated via {@link WorkOrderStats#calculateWorkOrderStats}.
    * - {#numberOfReorders} calculated via {@link PurchaseOrderStats#calculatePurchaseOrderStats}.
    *
    * @param spec
    *       The {@link InventorySeriesFetchSpec} will be executed on the {@link InventorySeries} type to retrieve parts whose stats will be refreshed.
    *       The `spec` passed should be compatible with {@link InventorySeries}.
    * @param partsToRefresh
    *       The list of {@link InventorySeries} objects that needs to be refreshed.
    */
    refreshStats: function(spec: InventorySeriesFetchSpec, partsToRefresh: [InventorySeries] = []) js-rhino

  /**
    * function that starts a {@link InventorySeriesRefreshStatsBatchJob} to refresh parts' stats.
    */
  triggerRefreshStatsBatchJob: function(options: InventorySeriesRefreshStatsBatchJobOptions) js-rhino
}
