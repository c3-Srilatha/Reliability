/**
 * Type housing all statistics for a given {@link InventorySeries#partNumber} part and corresponding {@link PurchaseOrder}s.
 */
type PurchaseOrderStats {
  /**
   * Represents number of {@link PurchaseOrderLine}s for a given {@link InventorySeries#partNumber} that have been placed in the past.
   */
  numberOfReorders: int

  /**
   * Calculates {#numberOfReorders}.
   *
   * @param seriesObj
   *          The {@link InventorySeries} instance, for which the stats have to be calculated.
   * @param lookBackTimeRange
   *          The {@link TimeRange} which will be used in calculation fo the stats. Defaults to {@link ReliabilitySparePartsConfig#purchaseOrderLookBackMonths}.
   *
   * @returns instance of {@link InventorySeries} object with {#numberOfReorders} populated.
  */
  calculatePurchaseOrderStats: function(seriesObj: !InventorySeries, lookBackTimeRange: TimeRange): !InventorySeries js-rhino
}
