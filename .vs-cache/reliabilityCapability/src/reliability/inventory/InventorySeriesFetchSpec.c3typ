/**
 * This type allows us to specify fetch parameters for retrieving parts, from {@link InventorySeries}, whose stats will be refreshed.
 */
type InventorySeriesFetchSpec mixes Spec {
  /**
   * {@link Filter} for fetching {@link InventorySeries}s to refresh stats.
   * Only the parts satisfying the filter condition will have the latest stats.
   */
  filter: string serialized Filter

  /**
   * Indicates the maximum number of parts to fetch for refreshing the stats.
   * Set to -1 by default, to fetch all the parts from {@link InventorySeries}
   */
  limit: int = -1

  /**
   * If true, skip calculation of Work Order Stats
   */
  doNotCalculateWorkOrderStats: ?boolean

  /**
   * If true, skip calculation of Purchase Order Stats
   */
  doNotCalculatePurchaseOrderStats: ?boolean

  /**
   * If true, skip calculation of Inventory Stats
   */
  doNotCalculateInventoryStats: ?boolean
}
