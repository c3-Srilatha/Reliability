/**
 * This type defines custom expressions to be applied when masking out data for sensor association
 * {@link ReliabilityAssetSensorAssociationJob} and dataset preparation {@ReliabilityMlDatasetPreparationJob}
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
type ReliabilityAssetExclusionMaskExpressions mixes ExpressionEngineFunction {

  /**
   * This is a custom experession engine function that is used to take an underlying mask, and creates a new mask that
   * additionally masks out periods of data where the data is unmasked for small periods, in between larger periods where
   * the data is masked out.
   *
   * The following steps are implemented to filter out these periods:
   *
   *   1. Convert days to whatever {@link Interval} at which the timeseries is evaluated
   *   2. Get the indices of all the already masked data points i.e. 1
   *   3. Detecting and updating the timeseries with the Short time period (STP) excluded
   *   4. Once the STP is excluded from the beginning and end, excluded indices in step 2 are used to perform the STP exclusion for remaining timeseries
   *   5. Update the timeseries data points and return the timeseries, which will be consumed by other exclusion metrics
   *
   * @param ts Timeseries - The underlying mask metric that should be used to create the new mask with Short Time Periods masked out.
   * @param days The time period in days which should be considered a short window. Any periods of data which is unmasked only for upto these number of days get masked out
   */
  shortTimePeriodExclusionPyTs: function(ts: Timeseries, days: int): Timeseries py

  /**
   * This is a custom experession engine function that is used to mask out periods where the underlying timeseries fluctuates a lot and contains sharp spikes in the data.
   * This function detects where the time series differenced at a specified lag has changed by an amount greater than or equal to threhs. This
   * timestamp along with a window after it are masked out.
   *
   * @param ts the time series to be filtered {@link Timeseries}
   * @param lag the lag at which the difference is evaluated, assumed to be a constant values {@link Timeseries}
   * @param threshold the minimum absolute difference where the filter is triggered, assumed to be a constant values {@link Timeseries}
   * @param delay number of additional time points to filter out, assumed to be a constant values {@link Timeseries}
   */
  fTFExclusion: function(ts : Timeseries, lag: int, threshold: double, delay: int) : Timeseries py


}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
