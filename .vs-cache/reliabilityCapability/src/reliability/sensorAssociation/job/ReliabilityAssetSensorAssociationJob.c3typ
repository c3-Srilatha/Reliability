/**
 * A {@link MapReduce} job to asynchronously run {@link ReliabilityAsset#runSensorAssociation} or
 * {@link ReliabilityAsset#runSensorAssociationBatch} by distributing its compute across multiple compute nodes.
 *
 * Do NOT kick off this job by directly creating an instance of this Type and starting the job. Instead, always
 * use {@link ReliabilityAsset#runSensorAssociation} or {@link ReliabilityAsset#runSensorAssociationBatch}.
 *
 * See the dev topic titled "Sensor Association" for more details.
 */
@beta
extendable entity type ReliabilityAssetSensorAssociationJob extends MapReduce<Sensor, string, ReliabilityAssetSensorAssociationResult, File> mixes FilterableByFacility type key 'RASAJ' {

  /**
   * The spec for running the job. This spec should be passed while calling {@link ReliabilityAsset#runSensorAssociation} or
   * {@link ReliabilityAsset#runSensorAssociationBatch}.
   */
  spec: !ReliabilityAssetSensorAssociationSpec schema suffix 'RASAS'

  /**
   * The number of assets processed by this job.
   */
  numAssets: int calc exists(spec.assets) ? count(spec.assets) : 1

  /**
   * Error message that will be populated with its corresponding error in the worfklow in the case of failure.
   */
  errorMessage: string stored calc exists(run.status.errors[0].id) ? parseJobErrorMessage(run.status.errors[0].id) : ""

  /**
   * The root asset for this job.
   */
  rootAsset: ReliabilityAsset stored calc spec.assets[0].rootAsset

  /**
   * This field holds the unprocessed UI settings set by the user.
   *
   * Used by: {@link LatestSensorAssociationHelper#getLatestUiSettings} to get the latest UI settings, and show them on
   * the UI.
   */
  uiSettings: BulkSensorAssociationUiSettings

  /**
   * If run through the {@link ReliabilityOrchestrator.SensorAssociation} workflow,
   * this field will be the {@link Workflow.Run} that runs this job.
   */
  workflowRun: Workflow.Run

  map: ~ py-data-science

  reduce: ~ py-data-science

  beforeCreate: ~ py

  /**
   * @inheritdoc
   * Will change {@link ReliabilityAssetSensorAssociationRun}'s status to 'FAILED' when this job fails.
   */
  failed: ~ py

  /**
   * A method to fetch individual {@link ReliabilityAssetSensorAssociationRun}s created by this job. Each run
   * represents a sensor association job performed on one {@link ReliabilityAsset}.
   */
  getAssociationRuns: member function(): [ReliabilityAssetSensorAssociationRun] py

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["rootAsset.facility"]
}
