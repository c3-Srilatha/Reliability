/**
 * Helper for getting the latest {@link BulkSensorAssociationUiSettings} for a given [asset](ReliabilityAsset) or
 * [model](ReliabilityMlModel).
 *
 * @var FETCH_TYPE The {@link Persistable} type for which to get the latest sensor association UI settings.
 */
@beta
type LatestSensorAssociationHelper<FETCH_TYPE: Persistable> {

  /**
   * Get the latest {@link BulkSensorAssociationUiSettings} for the given entity, it supports {@link ReliabilityAsset}s
   * and {@link ReliabilityMlModel}s.
   *
   * - `ReliabilityAsset`: It extracts the settings from {@link ReliabilityAsset#latestSensorAssociationRun} in the job
   *   ({@link ReliabilityAssetSensorAssociationJob#uiSettings}).
   * - `ReliabilityMlModel`: It extracts from {@link ReliabilityMlModel#currentAssetRelations} the first related
   *   [asset](ReliabilityAsset) and then gets the settings from the asset as described above.
   *
   * @param entity
   *        The entity for which to get the latest sensor association UI settings.
   * @return The latest [sensor association UI settings](BulkSensorAssociationUiSettings) for the given entity.
   */
  getLatestUiSettings: function (entity: FETCH_TYPE): BulkSensorAssociationUiSettings js-rhino
}
