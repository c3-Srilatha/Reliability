/**
 * A single rule for data validation. Typically corresponds to one desired property of one type. The main type which
 * users will seed/create in their application to define data model validation logic.
 */
remix type DataValidationRule {

  /**
   * The name of the rule with translation.
   */
  name: !~ translate by id

  /**
   * An description of what kind of validation checks this rule performs with translation.
   */
  description: !string translate by id

}
