/**
 * @inheritdoc
 */
entity remix type DataValidationRun mixes FilterableByFacility {

  /**
   * An optional parent {@link ReliabilityAsset} to filter down the scope of entities validated for some rules.
   */
  parentAsset: ReliabilityAsset

  /**
   * A translated representation of {@link DataValidationRun#runStatus} to be used in the UI.
   */
  displayStatus: string translate by runStatus

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["parentAsset.facility"]

}
