/**
 * If training and deploying supervised {@link MlModel}s for any {@link MlProject}s,
 * then use this spec to define the target variable. There can only be one target variable for an
 * {@link MlModel}.
 */
remix type ReliabilityMlTargetPreparationSpec {

  /**
   * This function identifies if, for an {@link ReliabilityMlDatasetPreparationRun}, the target spec used certain
   * {@link Sensor}s. This is useful to help determine the impact of a faulty sensor on the dataset preparation run.
   * See {@link FaultySensor} for more general details.
   *
   * Because of the dynamic nature of the #targetOverride field, it is not possible to determine the sensors used.
   * This function has two options:
   * - `unverifiable`
   *   - If the #targetOverride field is defined.
   * - `notImpacted`
   *   - If the ReliabilityMlTargetPreparationSpec is not defined on the run.
   *   - If the #targetOverride field is not defined.
   */
  wereSensorsUsedInSpecsBatch: inline function(
    datasetPrepRuns: [!ReliabilityMlDatasetPreparationRun],
    sensors: [!Sensor]
  ): !FaultySensor.ImpactedBatchResult<ReliabilityMlDatasetPreparationRun> py-py4j
}
