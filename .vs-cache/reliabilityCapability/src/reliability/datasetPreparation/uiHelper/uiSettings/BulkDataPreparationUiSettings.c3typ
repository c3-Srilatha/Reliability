/**
 * Type to store UI dataset preparation settings for a run of data prep on multiple assets.
 * The settings serve as input arguments to create a {@link ReliabilityMlDatasetPreparationSpec}
 * for multiple assets.
 *
 * To start the job using this settings, use {@link BulkModelSetupUiSettings}.
 */
type BulkDataPreparationUiSettings mixes ReliabilityDataPreparationUiBaseSettings {

  /**
   * Field name containing the desired name for the {@link ReliabilityMlDatasetPreparationJob}.
   */
  jobName: string

  toSpec: ~ py
}
