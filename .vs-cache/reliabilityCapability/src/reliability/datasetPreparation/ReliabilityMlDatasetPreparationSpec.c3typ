/**
 * @inheritdoc
 */
remix type ReliabilityMlDatasetPreparationSpec {

  /**
   * If this field is specified and {@link #doNotUpdateSpecForSensorAssociation} is `false`,
   * the {@link ReliabilityAssetSensorAssociationJob} corresponding to this id
   * will be used to determine and update certain fields of the dataset preparation spec, such as
   * {@link ReliabilityMlDatasetPreparationSpec#materializeStart} and {@link ReliabilityMlDatasetPreparationSpec#materializeEnd}
   */
  sensorAssociationJobId: string

  /**
   * Specifies whether to update the fields of {@link ReliabilityMlDatasetPreparationSpec} based on
   * {@link ReliabilityAssetSensorAssociationSpec}.
   */
  doNotUpdateSpecForSensorAssociation: boolean = false

  /**
   * This function checks if the {@link ReliabilityMlDatasetPreparationSpec} on each of the runs uses the sensors
   * passed in as input. The result will inform which runs are `impacted`, `notImpacted`, or `unverifiable`.
   *
   * The function simply calls other functions and combines the results as a single output using
   * #_combineResultsForSpec:
   * - #_datasetPrepTopLevelSpecUsesSensors
   * - {@link ReliabilityMlFeaturePreparationSpec#wereSensorsUsedInSpecsBatch}
   * - {@link ReliabilityMlTargetPreparationSpec#wereSensorsUsedInSpecsBatch}
   * - {@link ReliabilityMlMaskPreparationSpec#wereSensorsUsedInSpecsBatch}
   */
  wereSensorsUsedInSpecsBatch: inline function(
    datasetPrepRuns: [!ReliabilityMlDatasetPreparationRun],
    sensors: [!Sensor]
  ): !FaultySensor.ImpactedBatchResult<ReliabilityMlDatasetPreparationRun> py-py4j

  /**
   * This function provides guidance on whether the {@link ReliabilityMlDatasetPreparationRun}
   * is impacted by the sensors as it applies specifically to the top level
   * [spec](ReliabilityMlDatasetPreparationSpec). See #wereSensorsUsedInSpecsBatch for details on how other
   * functions are called to validate more complex fields on the spec.
   *
   * This function splits runs into two groups:
   * - unverifiable - there is no `spec` field on the run
   * - notImpacted - the `spec` field is defined on the run.
   */
  _datasetPrepTopLevelSpecUsesSensors: inline function(
    datasetPrepRun: !ReliabilityMlDatasetPreparationRun,
    sensors: [!Sensor]
  ): !FaultySensor.ImpactedBatchResult<ReliabilityMlDatasetPreparationRun> py-py4j

  /**
   * Helper function that takes an array of
   * [results](FaultySensor.ImpactedBatchResult) and combines them into a
   * single output. The results will have the same `run` in each result, but #_currentResultAndNextResultTransition
   * decides how to combine it's results to choose the correct field on {@link FaultySensor.ImpactedBatchResult}.
   */
  _combineResultsForSpec: private inline function(
    results: [!FaultySensor.ImpactedBatchResult<ReliabilityMlDatasetPreparationRun>]
  ): !FaultySensor.ImpactedBatchResult<ReliabilityMlDatasetPreparationRun> py-py4j

  /**
   * Helper function that given two states of an {@link ReliabilityMlDatasetPreparationRun} in the calculation of
   * #wereSensorsUsedInSpecsBatch, it will return how to combine those states.
   *
   * State priority:
   * - unverifiable - highest priority always kept
   * - impacted - second highest priority
   * - notImpacted - lowest priority
   */
  _currentResultAndNextResultTransition: private inline function(
    current_result: string enum ('notImpacted', 'impacted', 'unverifiable'),
    next_result: string enum ('notImpacted', 'impacted', 'unverifiable')
  ): string enum ('notImpacted', 'impacted', 'unverifiable') py-py4j
}
