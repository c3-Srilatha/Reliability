/**
 * Helper type that holds several utility functions to validate the quality of data
 * in the raw data {@link File}s that are in the canonical data format. See the documentation
 * of each function for more information.
 */
type ReliabilityRawDataValidationHelper {

  /**
   * This function will validate the contents of all {@link File}s
   * representing the {@link ReliabilityRawDataValidationDataType#SENSOR_TIME_SERIES}
   * data type.
   * @param file
   *           The file to validate.
   * @return A {@link ReliabilityRawDataValidationFileReport} containing validation results.
   */
  validateCanonicalPointMeasurementFile: function(
    file: !File
  ): ReliabilityRawDataValidationFileReport py-data

  /**
   * This function will validate the contents of all {@link File}s
   * representing the {@link ReliabilityRawDataValidationDataType#PPMS}
   * data type.
   * @param file
   *           The file to validate.
   * @return A {@link ReliabilityRawDataValidationFileReport} containing validation results.
   */
  validateCanonicalPointPhysicalMeasurementSeriesFile: function(
    file: !File
  ): ReliabilityRawDataValidationFileReport py-data

  /**
   * This function will validate the contents of all {@link File}s
   * representing the {@link ReliabilityRawDataValidationDataType#EVENTS}
   * data type.
   * @param file
   *           The file to validate.
   * @return A {@link ReliabilityRawDataValidationFileReport} containing validation results.
   */
  validateCanonicalReliabilityAssetEventFile: function(
    file: !File
  ): ReliabilityRawDataValidationFileReport py-data

  /**
   * Fetches and cleans the asset hierarchy spreadsheet dataframes from `c3.ReliabilityExcelParser.readAssetHierarchyExcelSpreadsheetGeneric`
   * function and returns a `map` of `{sheet_name: pd.DataFrame}`. Cleaning the failure modes and failure mode recommendations dataframes:
   * renaming columns for expected sensors and diagnostics, and removing unnamed columns.
   *
   * @param file
   *           The excel spreadsheet {@link ReliabilitySyntheticData.ReliabilityRisk.AssetHierarchySpreadsheet#templateExcel} containing the asset hierarchy data.
   * @return A map where keys are sheet names (strings) and values are Data objects
   *         containing the corresponding DataFrames read from each sheet.
   */
  readAssetHierarchyExcelSpreadsheetInline: inline function(
    file: !File
  ): native py-data-excel

  /**
   * This function evaluates all errors in the asset hierarchy excel
   * spreadsheet. The returned value is a `map` where the key of the `map`
   * is the name of the specific sheet in the excel file and the value
   * is an array of error messages as individual strings.
   * @param file
   *           The excel file to validate.
   * @return A map from sheet names to arrays of error messages.
   */
  doValidateAssetHierarchySpreadsheetFile: function(
    file: !File
  ): map<string, [string]> py-data-excel

  /**
   * This function will validate the contents of all {@link File}s
   * representing the {@link ReliabilityRawDataValidationDataType#ASSET_HIERARCHY_EXCEL}
   * data type.
   * @param file
   *           The file to validate.
   * @return A {@link ReliabilityRawDataValidationFileReport} containing validation results.
   */
  validateAssetHierarchySpreadsheetFile: function(
    file: !File
  ): ReliabilityRawDataValidationFileReport py-data-excel

  /**
   * Function that wraps around all the below functions:
   * 1. {@link validateCanonicalPointMeasurementFile}
   * 2. {@link validateCanonicalPointPhysicalMeasurementSeriesFile}
   * 3. {@link validateCanonicalReliabilityAssetEventFile}
   * 4. {@link validateAssetHierarchySpreadsheetFile}
   * @param file
   *           The file to validate.
   * @param fileType
   *           The type of file to validate.
   * @return A {@link ReliabilityRawDataValidationFileReport} that contains
   *         an overview of data quality in that {@link File}.
   */
  validateFile: function(
    file: !File,
    fileType: !string enum ReliabilityRawDataValidationDataType
  ): ReliabilityRawDataValidationFileReport py

  /**
   * Combines the data quality overviews from all
   * {@link ReliabilityRawDataValidationFileReport}s generated by
   * running {@link validateFile} on all raw data {@link File}s.
   * @param reports
   *           Array of file validation reports to combine.
   * @return A {@link ReliabilityRawDataValidationReport} which contains
   *         an overall overview of data quality in ALL {@link File}s.
   */
  crossValidateReports: function(
    reports: ![ReliabilityRawDataValidationFileReport]
  ): ReliabilityRawDataValidationReport py-data
}
