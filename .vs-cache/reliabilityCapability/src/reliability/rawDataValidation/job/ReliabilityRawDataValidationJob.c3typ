/**
 * A distributed {@link BatchJob} that parallelizes the validation of raw data source {@link File}s.
 * See individual function documentation for more information.
 * Example python usage of the job:
 * ```py
 * job = c3.ReliabilityRawDataValidationJob().create()
 * job_options = c3.ReliabilityRawDataValidationJobOptions(
 *     rootFolderPath = "stage/rawDataValidationFiles",
 *     assetHierarchyExcelPath = "AssetHierarchyExcelSpreadsheet",
 *     batchSize = 2
 * )
 * status = job.start(job_options)
 * ```
 */
extendable entity type ReliabilityRawDataValidationJob extends BatchJob<ReliabilityRawDataValidationJob, ReliabilityRawDataValidationJobOptions, ReliabilityRawDataValidationJobBatch> type key 'RRDV_JOB' {

  /**
   * In this function, all the raw data {@link File}s will be read, batched,
   * and dispatched to {@link processBatch}.
   */
  doStart: ~ py

  /**
   * In this function, all the files in the dispatched batch from {@link doStart}
   * are validated with a call to {@link ReliabilityRawDataValidationHelper#validateFile}.
   * This will generate a {@link ReliabilityRawDataValidationFileReport} per {@link File}.
   */
  processBatch: ~ py

  /**
   * In this function, all the {@link ReliabilityRawDataValidationFileReport}s from
   * {@link processBatch} will be cross-validated by a call to
   * {@link ReliabilityRawDataValidationHelper#crossValidateReports}. An overall
   * {@link ReliabilityRawDataValidationReport} is generated.
   */
  allComplete: ~ py
}
