/**
 * A batch of raw data {@link File}s dispatched from {@link ReliabilityRawDataValidationJob#doStart}
 * to {@link ReliabilityRawDataValidationJob#processBatch}.
 */
type ReliabilityRawDataValidationJobBatch {

  /**
   * The list of {@link File}s that will be processed by
   * a single {@link ReliabilityRawDataValidationJob#processBatch}.
   */
  files: ![File]

  /**
   * The type of raw data that each {@link File} in {@link files}
   * represents.
   */
  fileType: !string enum ReliabilityRawDataValidationDataType
}
