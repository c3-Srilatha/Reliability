/**
 * Options to control and orchestrate the execution of {@link ReliabilityRawDataValidationJob}.
 * See the documentation on each field for more information.
 */
type ReliabilityRawDataValidationJobOptions mixes BatchJobOptions {

  /**
   * The parent folder under which all the raw data {@link File}s
   * are stored. If any of the following fields are not specified,
   * then the {@link File}s for those data sources are assumed to be
   * stored under a relative path under the {@link rootFolderPath}.
   * The relative file path will be determined by the corresponding
   * {@link ReliabilityRawDataValidationDataType}.
   *
   * For example, if {@link canonicalPointMeasurementPath} is not
   * provided, then the {@link File}s for this data source are assumed
   * to be stored in `rootFolderPath/CanonicalPointMeasurement/`, which,
   * programmatically resolves to
   * `<rootFolderPath>/<ReliabilityRawDataValidationDataType.SENSOR_TIME_SERIES>`.
   */
  rootFolderPath: !string

  /**
   * The absolute folder path to a directory under which raw data
   * {@link File}s for the {@link ReliabilityRawDataValidationDataType#SENSOR_TIME_SERIES}
   * are stored. This is optional. If not provided, it will be auto-determined
   * by the logic specified in the documentation of {@link rootFolderPath}.
   */
  canonicalPointMeasurementPath: string

  /**
   * The absolute folder path to a directory under which raw data
   * {@link File}s for the {@link ReliabilityRawDataValidationDataType#PPMS}
   * are stored. This is optional. If not provided, it will be auto-determined
   * by the logic specified in the documentation of {@link rootFolderPath}.
   */
  canonicalPointPhysicalMeasurementSeriesPath: string

  /**
   * The absolute folder path to a directory under which raw data
   * {@link File}s for the {@link ReliabilityRawDataValidationDataType#EVENTS}
   * are stored. This is optional. If not provided, it will be auto-determined
   * by the logic specified in the documentation of {@link rootFolderPath}.
   */
  canonicalReliabilityAssetEventPath: string

  /**
   * The absolute folder path to a directory under which raw data
   * {@link File}s for the {@link ReliabilityRawDataValidationDataType#ASSET_HIERARCHY_EXCEL}
   * are stored. This is optional. If not provided, it will be auto-determined
   * by the logic specified in the documentation of {@link rootFolderPath}.
   */
  assetHierarchyExcelPath: string

  /**
   * Specify the number of {@link File}s that will be processed by a single
   * batch inside {@link ReliabilityRawDataValidationJob#processBatch}.
   */
  batchSize: int = 5
}
