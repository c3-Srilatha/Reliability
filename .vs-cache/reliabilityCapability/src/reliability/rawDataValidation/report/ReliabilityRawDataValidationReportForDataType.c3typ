/**
 * Used in {@link ReliabilityRawDataValidationReport} to store common (and simple) statistics
 * about each {@link ReliabilityRawDataValidationDataType} of {@link File} in the set of raw data
 * files.
 */
type ReliabilityRawDataValidationReportForDataType {

  /**
   * This is the type of raw data file. See {@link ReliabilityRawDataValidationDataType}
   * for more information.
   */
  dataType: !string enum ReliabilityRawDataValidationDataType

  /**
   * How many {@link File}s of this {@link dataType} exist in the raw data sources?
   */
  numFiles: !int

  /**
   * How many {@link File}s of this {@link dataType} from the raw data sources contain
   * errors?
   */
  numErrorFiles: !int

  /**
   * How many {@link File}s of this {@link dataType} from the raw data sources contain
   * warnings?
   */
  numWarningFiles: !int
}
