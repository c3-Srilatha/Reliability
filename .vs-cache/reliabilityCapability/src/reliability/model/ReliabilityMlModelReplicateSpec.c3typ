/**
 * This spec is used to configure how to replicate a given {@link MlPipeline}.
 */
type ReliabilityMlModelReplicateSpec mixes Spec {

  /**
   * The new hyperparameters to be applied to the replicated model.
   */
   newHps: json

  /**
   * The name for the newly created model.
   */
   replicatedModelName: string

  /**
   * The start time to be used for validating the new model.
   */
   validationStart: DateTime

  /**
   * The end time to be used for validating the new model.
   */
   validationEnd: DateTime

  /**
   * The user who created the workflow for replicating the model.
   */
  createdBy: User
}
