/**
 * Spec for customizing how {@link ReliabilityMlModel#acceptLatestModelExperiment} behaves.
 */
type ReliabilityMlModel.AcceptExperimentSpec mixes Spec {

  /**
   * If true, the model will be deployed as `CHAMPION` after the experiment is accepted.
   * and the current `CHAMPION` model will be demoted to `RETIRED`.
   */
  deployAsChampion: boolean = false
}
