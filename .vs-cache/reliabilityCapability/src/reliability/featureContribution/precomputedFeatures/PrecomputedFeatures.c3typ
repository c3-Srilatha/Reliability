/**
 * Stores precomputed features for an entity mixing {@link WithPrecomputedFeatures}. The {@link PrecomputedFeatures}
 * instance has the same {@link #id} as the {@link WithPrecomputedFeatures} instance it is storing features for.
 *
 * Currently, no pruning is done to make sure the size of this table does not grow indefinitely. If feature fetching
 * queries slow down, use {@link #clearPrecomputedFeatures} to remove old precomputed features.
 *
 * This type is a derived data store.
 * **Do not store any data here that you are unwilling to recompute as it could be removed**
 */
entity type PrecomputedFeatures mixes FilterableByFacility {

  /**
   * The fields of {@link FeatureFetchBase} that will never be precomputed. These fields can change
   * because of updates to entities other than the one that this {@link PrecomputedFeatures} is storing features for.
   */
  blacklistedFields: const [string] = [
    'sensorOperationalStatus',
    'sensorAlert'
  ]
  /**
   * A map of feature id to feature data. Stores the precomputed features with the {@link #precomputedFields} filled in.
   */
  featureIdToPrecomputedFeature: map<string serialized FeatureFetchBase, FeatureFetchBase>

  /**
   * The set of fields on the features that have been precomputed. This is equivalent to the
   * fields present on every value of {@link #featureIdToPrecomputedFeature}.
   *
   * Used to determine if more fields need to be fetched,
   * or if the {@link #featureIdToPrecomputedFeature} is sufficient.
   */
  precomputedFields: set<string>

  /**
   * Dispatches an {@link AsyncAction} to update this {@link PrecomputedFeatures} with the data in `features`.
   *
   * @param features
   *           The features to update this {@link PrecomputedFeatures} with.
   * @param retrySpec
   *           Controls the retrying behavior of the update. Retrying will happen by default.
   * @return The {@link AsyncAction} that will update this {@link PrecomputedFeatures}.
   */
  updatePrecomputedFeaturesAsync: inline member function (
    features: ![FeatureFetchBase],
    retrySpec: RetrySpec
  ): AsyncAction js-rhino

  /**
   * Performs {@link #featureIdToPrecomputedFeature}, but retries the update up to `numRetries` times if it fails.
   * This is to account for version conflicts caused by other concurrent updates to this {@link PrecomputedFeatures}.
   *
   * @param features
   *           The features to update this {@link PrecomputedFeatures} with.
   * @param retrySpec
   *           Controls the retrying behavior of the update. Retrying will happen by default.
   */
  @dependency(include="featureIdToPrecomputedFeature, precomputedFields")
  updatePrecomputedFeaturesWithRetry: member function (
    features: ![FeatureFetchBase],
    retrySpec: RetrySpec
  ) js-rhino

  /**
   * Update the {@link #featureIdToPrecomputedFeature} for this entity with the data in `features`.
   *
   * @param features
   *           The features to update this {@link PrecomputedFeatures} with.
   */
  @dependency(include="featureIdToPrecomputedFeature, precomputedFields")
  updatePrecomputedFeatures: inline member function (features: ![FeatureFetchBase]) js-rhino

  /**
   * Returns the list of features with all their precomputed fields.
   * @return An array of {@link FeatureFetchBase} objects with precomputed fields.
   */
  @dependency(include="featureIdToPrecomputedFeature")
  getPrecomputedFeatures: inline member function(): [FeatureFetchBase] js-rhino

  /**
   * Given a list of features, updates the {@link #featureIdToPrecomputedFeature} with the data in `features`.
   * This function does not actually update the {@link PrecomputedFeatures} instance, and instead returns a new
   * `featureIdToPrecomputedFeature` map that can be used to do this.
   *
   * All the precomputed features will be merged with the corresponding feature in `features` with the fields in
   * `features` taking priority over the precomputed fields if there is a conflict.
   *
   * If `featureIdToPrecomputedFeature` is provided, the {@link #featureIdToPrecomputedFeature} of this
   * {@link PrecomputedFeatures} instance will be ignored, and the parameter map will be updated instead.
   *
   * @param spec
   *           See {@link MergeFeaturesWithPrecomputedFeaturesSpec} for details.
   * @return A map of feature ID to merged feature data.
   */
  mergeFeaturesWithPrecomputedFeatures: inline member function(
    spec: MergeFeaturesWithPrecomputedFeaturesSpec
  ): map<string serialized FeatureFetchBase, FeatureFetchBase> js-rhino


  /**
   * Given a list of fields, returns the fields in that list that have not been precomputed yet.
   *
   * @param fields
   *           The list of fields to check.
   * @return An array of field names that have not been precomputed yet.
   */
  fieldsMissing: inline member function(
    fields: set<string>
  ): [string] js-rhino

  /**
   * Clears the precomputed features by removing them from the database.
   *
   * @param filter
   *           All {@link PrecomputedFeatures} instances matching this filter will be deleted.
   * @return The number of {@link PrecomputedFeatures} instances that were deleted.
   */
  clearPrecomputedFeatures: function(filter: Filter): !int js-rhino

  /**
   * The {@link ReliabilityAssetAlert} that this {@link PrecomputedFeatures} is storing features for.
   */
  alert: ReliabilityAssetAlert(id, id)

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["alert.parent.facility"]
}
