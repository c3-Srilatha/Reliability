/**
 * Represents an entity that stores precomputed features ({@link FeatureFetchBase}) that can be utilized by
 * calling {@link #fetchFeaturesWithPrecomputedFeatures}. Only entities that always fetch the same features for
 * a particular asset, model, and timestamp (via the `asOf` field of the spec) can precompute their features.
 */
abstract entity type WithPrecomputedFeatures {

  /**
   * The precomputed features for this entity.
   */
  precomputedFeatures: PrecomputedFeatures(id)

  /**
   * Whether this entity is a model validation type. These types use a different part of the data model to query
   * feature data. This should be overriden by types that mix {@link WithPrecomputedFeatures} if necessary.
   */
  isValidationType: const boolean = false

  /**
   * Returns the same output as {@link FeatureFetchBase#fetchFeatures}, but reduces the data fetched from Cassandra
   * by using the {@link #precomputedFeatures}. See {@link FeatureFetchBase#fetchFeatures} for more details on
   * parameters and output.
   *
   * `featureNames`, `assetId`, and `modelId` are required to be the same every single time this function is called for
   * this entity. `contributionMap` should not change either, however it is unused after the first time `contribution`
   * is cached in the {@link #precomputedFeatures}
   *
   * {@link FeatureFetchBaseSpec#isValidation} is not utilized by this function.
   */
  fetchFeaturesWithPrecomputedFeatures: member function (
    spec: FeatureFetchBaseSpec
  ): FetchResultWithTotalCount<FeatureFetchBase> js-rhino
}
