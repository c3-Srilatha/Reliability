/**
 * Specifies the available precomputed values that can be used with {@link FeatureFetchBase}. This speeds up
 * query performance by allowing the precomputed values to be used directly instead of having to recompute them.
 */
type WithFeatureFetchBasePrecomputedValues {

  /**
   * A map of {@link FeatureFetchBase} id to its raw contribution value. This map should contain values
   * that correspond to a specific timestamp for a specific {@link ReliabilityMlModel} and {@link ReliabilityAsset}
   * pairing.
   */
  contributionMap: map<string, double>
}
