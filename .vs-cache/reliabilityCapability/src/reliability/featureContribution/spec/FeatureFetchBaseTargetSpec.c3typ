/**
 * For {@link FeatureFetchBase}, specifies which features should be returned, and where data about these
 * features should be retrieved from. In addition to an `include` string, and a timestamp,
 * this type provides full context of how data for the features should be queried.
 *
 */
type FeatureFetchBaseTargetSpec mixes Spec {

  /**
   * The names of the features that data should be retrieved for.
   */
  featureNames: ![string]

  /**
   * The id of the asset that the features are associated with.
   */
  assetId: !string serialized ReliabilityAsset

  /**
   * The id of the model that the features are associated with.
   *
   * If not provided, the champion model of the {@link ReliabilityAsset} with {@link #assetId}
   * will be utilized.
   */
  modelId: string serialized ReliabilityMlModel

  /**
   * If true, model validation types should be queried. Otherwise, normal model types should be queried.
   *
   * More specifically, if true, a {@link ReliabilityAssetToModelValidationRelation} instance should be
   * the source of truth. If false, a {@link ReliabilityAssetToModelRelation} instance should be the source of truth.
   */
  isValidation: boolean
}
