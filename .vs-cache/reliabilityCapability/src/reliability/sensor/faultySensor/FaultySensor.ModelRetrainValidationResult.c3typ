/**
 * Result type for {@link FaultySensor.ModelImpactMapReduceJob#validateModelCanBeRetrained}. This contains
 * all the information about the validation of a single {@link ReliabilityRiskMlModel} as it pertains to retraining
 * the model in the {@link FaultySensor} process.
 */
type FaultySensor.ModelRetrainValidationResult mixes Result {
  /**
   * All relations that were passed in to the function.
   * @see FaultySensor.ModelRetrainValidationInput
   */
  allRelations: ![!ReliabilityAssetToRiskModelRelation]

  /**
   * IDs of the {@link ReliabilityAssetToRiskModelRelation}s that are valid to retrain.
   */
  validRelationIds: [!string]

  /**
   * Errors for the relations that cannot be retrained. See {@link FaultySensor.ModelRetrainValidationError}
   * for additional details.
   *
   * One usage of the errors is to provide a user-friendly message to the user in the form of an email notification.
   */
  errors: [!FaultySensor.ModelRetrainValidationError]

  /**
   * #allRelations filtered to only include the matching #validRelationIds.
   */
  validRelations: property(): [ReliabilityAssetToRiskModelRelation] py-py4j

  /**
   * #allRelations filtered to only include the matching {@link FaultySensor.ModelRetrainValidationError#relationId} in
   * #errors.
   */
  invalidRelations: property(): [ReliabilityAssetToRiskModelRelation] py-py4j

  /**
   * A map of {@link Sensor} ids to the {@link FaultySensor.ModelImpactMapReduceJob.InterValType#impactedRelations}.
   * This is used for generating notifications in {@link FaultySensor.Notification}.
   */
  sensorToImpactedRelations: map<!string, [!ReliabilityAssetToRiskModelRelation]>
}
