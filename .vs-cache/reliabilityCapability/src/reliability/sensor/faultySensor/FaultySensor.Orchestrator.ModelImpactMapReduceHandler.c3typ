/**
 * This type is a handler for the result of {@link FaultySensor.Orchestrator#createAndRunMapReduceNestedWorkflow}.
 *
 * See #resultFromActionOutput and {@link FaultySensor.Orchestrator} for more details.
 */
type FaultySensor.Orchestrator.ModelImpactMapReduceHandler mixes Workflow.Nested.Action.Handler {

  /**
   * Name of the {@link Workflow.Output} that contains the results of the map-reduce job.
   */
  MAP_REDUCE_RESULT_WORKFLOW_OUTPUT_NAME: const string = 'MapReduceResults'

  /**
   * @inheritdoc
   *
   * Return `actionOutput` as is.
   */
  runFromActionOutput: ~(actionOutput: !WorkflowExecutorRun) py

  /**
   * Attempt to read the [output vertices](Workflow.Output) from the resulting workflow run.
   *
   * Returns a result matching the output of {@link FaultySensor.ModelImpactMapReduceJob#retrieveMapReduceResults}.
   *
   * See this type's [top level documentation](FaultySensor.Orchestrator.ModelImpactMapReduceHandler).
   */
  resultFromActionOutput: ~ : map<string, FaultySensor.ModelRetrainValidationResult> py
}
