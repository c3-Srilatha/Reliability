/**
 * A wrapper type to identify the three potential states for the impact of changing sensors on a series of objects.
 * This is used to identify if a series of {@link ReliabilityAssetToRiskModelRelation}s use a sensor as well as
 * if specific {@link ReliabilityMlDatasetPreparationRun}s use a sensor.
 *
 * Key uses to better understand are:
 * - {@link ReliabilityMlFeaturePreparationSpec#wereSensorsUsedInSpecsBatch}
 * - {@link ReliabilityMlTargetPreparationSpec#wereSensorsUsedInSpecsBatch}
 * - {@link ReliabilityMlMaskPreparationSpec#wereSensorsUsedInSpecsBatch}
 * - {@link ReliabilityMlDatasetPreparationSpec#wereSensorsUsedInSpecsBatch}
 * - {@link FaultySensor.ModelImpactMapReduceJob#filterRelationsImpactedBySensorsBatch}
 */
type FaultySensor.ImpactedBatchResult<T> mixes Result {
  /**
   * The list of input types that are impacted by the updates to a series of {@link Sensor}s.
   *
   * See types that mixin this type for more details.
   */
  impacted: [!T]

  /**
   * The list of input types that are not impacted by the updates to the {@link Sensor}s.
   * This is only if it was possible to fully confirm there was no impact.
   *
   * See types that mixin this type for more details.
   */
  notImpacted: [!T]

  /**
   * The list of input types that had special cases for which it was not possible to validate
   * that the instance does or does not use the {@link Sensor}.
   *
   * See types that mixin this type for more details.
   */
  unverifiable: [!T]

  /**
   * A list of relations of an input type to a list {@link Sensor} ids that the type contains.
   */
  impactedSensors: [Pair<!T, [string]>]

  /**
   * Log the IDs from each of the list fields. Logs will be written to [info](Logger#info).
   *
   * The prefix message will be applied to the beginning of the log.
   */
  logResult: inline member function(prefixMessage: string) py-py4j
}
