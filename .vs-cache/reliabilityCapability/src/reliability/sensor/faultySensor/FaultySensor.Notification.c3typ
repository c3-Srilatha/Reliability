/**
 * Type that represents a section of the {@link ReliabilityEmailUpdateNotificationScheduler} corresponding to the
 * {@link FaultySensor} module.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
 entity type FaultySensor.Notification mixes ReliabilityEmailUpdateNotificationSection {

  /**
   * Calls {@link TemplateWithDefaultValue} and gets the corresponding title for this section
   */
  buildTitle: ~

  /**
   * Fetches all the instances of this type that were created in the last {@link ReliabilityEmailUpdateNotificationScheduler}
   * For each notification it builds the content with the properties in this type, with the following structure:
   * <ol>
   *   <li><strong>Sensor</strong>: ${value}
   *     <ul>
   *       <li>Column: ${value}</li>
   *       <li>Column: <a href="${hrefValue}"> ${value}</a></li>
   *     </ul>
   *   </li>
   *   <li><strong>Sensor</strong>: ${value}</li>
   *   <li><strong>Sensor</strong>: ${value}</li>
   * </ol>
   */
  buildContent: ~

  /**
   * Sensor of the current notification.
   */
  sensor: private !Sensor

  /**
   * Name of the #sensor to be included in the notification content.
   */
  sensorName: private !string

  /**
   * Operational status of the #sensor to be included in the notification content.
   */
  updatedOperationalStatus: private !string enum SensorOperationalStatusEnum

  /**
   * Related model of the current notification.
   */
  relatedModel: private !ReliabilityRiskMlModel

  /**
   * Name of the #relatedModel to be included in the notification content.
   */
  relatedModelName: private !string

  /**
   * Feature set cardinality of the #relatedModel to be included in the notification content.
   */
  // TODO REL-12121: Clarify definition and implementation of resultingFeatureSetCardinality
  resultingFeatureSetCardinality: !int

  /**
   * Related asset of the current notification.
   */
  relatedAsset: private !ReliabilityAsset

  /**
   * Name of the #relatedAsset to be included in the notification content.
   */
  relatedAssetName: private !string

  /**
   * Train job of the current notification.
   * If there's a failure that prevents the model from retraining, the job will be empty
   */
  trainJob: private MlModel.Train.JobRun

  /**
   * Name of the #trainJob to be included in the notification content.
   */
  trainJobName: private string

  /**
   * The most recent job status of the current notification. This object will be updated at run time only if the train
   * job exists in order to update the latest status of the job.
   */
  jobStatus: !FaultySensor.Notification.TrainJobStatus

  /**
   * Author of the current notification, it refers to the user who triggered the operating status update.
   */
  author: private !User

  /**
   * Name of the #author to be included in the notification content.
   */
  authorName: private !string

  /**
   * The time of creation of the current notification
   */
  timestamp: private !datetime

  /**
   * Flag that indicates whether a notification instance is intended for testing purposes only. When set to true, the
   * notification should be treated as a test notification and not processed or displayed in the production environment.
   */
  isTest: private boolean = false

  /**
   * Creates {@FaultySensor.Notification}(s) based on the results from {@link FaultySensor.ModelImpactMapReduceJob}. It
   * will only look into its [errors](FaultySensor.ModelRetrainValidationError) and create a notification for each one.
   *
   * @param mrResults
   *     A map of model IDs to the [retrain validation results](FaultySensor.ModelRetrainValidationResult).
   * @param maxErrors
   *     The maximum number of notifications this function will generate.
   * @param isTest
   *     Flag to determine if the content should only include test instances in the content. Used for testing purposes.
   */
  createNotificationsFromMapReduceResult: function(
    mrResults: !map<string, FaultySensor.ModelRetrainValidationResult>,
    maxErrors: int = 2000,
    isTest: boolean = false
  ) py

  /**
   * Helper function to implement #resultingFeatureSetCardinality for a notification of a sensor that comes from
   * {@link FaultySensor.ModelImpactMapReduceJob}.
   *
   * @param model - The model to grab the cardinality from, must contain `xFeatures`
   * @param validation_error - A map from {@link ReliabilityRiskMlModel#id} to the source of truth model
   *        for the model with that ID.
   * @return An int representing the cardinality of the model.
   */
   // TODO REL-12121: Clarify definition and implementation of resultingFeatureSetCardinality
  _get_feature_set_cardinality_from_error: function(
    model: !ReliabilityRiskMlModel,
    validation_error: FaultySensor.ModelRetrainValidationError
  ): int py

  /**
   * Creates {@FaultySensor.Notification}(s) after the {@link ReliabilityRiskMlModel} retraining is complete. For more
   * information see {@link ReliabilityAssetToRiskModelRelation}.
   *
   * @param originalModel
   *     The original model that will be replaced.
   * @param newModels
   *     The new model(s) that will replace the original model.
   * @param retrainValidationResult
   *     The {link FaultySensor.ModelRetrainValidationResult} of the original model.
   * @param modelConfigRun
   *     The model config run which holds the job information for each new model.
   * @param sourceOfTruthModel
   *     The source of truth model for the original model. It's possible that sot and original models are the same.
   * @param isTest
   *     Flag to determine if the content should only include test instances in the content. Used for testing purposes.
   */
  createNotificationsFromModelRetraining: function(
    originalModel: !ReliabilityRiskMlModel,
    newModels: ![!ReliabilityRiskMlModel],
    retrainValidationResult: !FaultySensor.ModelRetrainValidationResult,
    modelConfigRun: ModelConfigRun,
    sourceOfTruthModel: ReliabilityRiskMlModel,
    isTest: boolean = false
  ) py

}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
