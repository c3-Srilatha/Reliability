/**
 * See {@link FaultySensor} for details about the overall faulty sensor process.
 *
 * This type is an orchestrator that manages and creates the overarching {@link Workflow} to retrain models
 * as part of the faulty sensor process. The resulting workflow will likely contain several
 * {@link Workflow.Nested.Action}s that may contain other workflows managed by different orchestrators.
 *
 * See #createAndRunWorkflow for the main entry point to this orchestrator.
 */
type FaultySensor.Orchestrator {

  /**
   * Prefix for the ID and name of the {@link Workflow} created by this orchestrator in #createWorkflow.
   */
  WORKFLOW_PREFIX: const string = "Faulty_Sensor_Orchestrator"

  /**
   * Prefix for the ID and name of the nested {@link Workflow} created by #createAndRunMapReduceNestedWorkflow
   */
  MAP_REDUCE_NESTED_WORKFLOW_PREFIX: const string = "Faulty_Sensor_Orchestrator__MR"

  /**
   * Prefix for the ID and name of the nested {@link Workflow} created by #createAndRunParallelRetrainingWorkflow.
   */
  PARALLEL_RETRAINING_WORKFLOW_PREFIX: const string = "Faulty_Sensor_Orchestrator__ParallelRetraining"

  /**
   * Retrieve the latest time that the orchestrator picked up updates to {@link Sensor#operationalStatus}es.
   * This does not guarantee that the orchestrator has successfully processed all updates before this time.
   *
   * A null datetime means that the orchestrator has never fetched updates.
   *
   * This will fetch on {@link FaultySensor.Orchestrator.History}.
   * @return The latest datetime when sensor updates were fetched, or null if never fetched.
   */
  getLatestTimeSensorUpdatesFetched: function(): datetime py

  /**
   * Generate a workflow to perform the entirety of the {@link FaultySensor} process.
   *
   * The `ID` and `name` of the resulting workflow will be prefixed with #WORKFLOW_PREFIX.
   *
   * The steps of this workflow:
   * - [details](Sensor#fetchSensorsWithOperationalStatusChange) - Retrieve sensors that have recently had their
   *      {@link Sensor#operationalStatus} changed.
   * - [details](FaultySensor.ModelImpactMapReduceJob) - Run a map-reduce job to determine which
   *      {@link ReliabilityRiskMlModel}s are impacted by the sensor updates. See #createAndRunMapReduceNestedWorkflow.
   * - [details](FaultySensor.Orchestrator.Spec.Process#createAndStartWorkflow) - Retrain models individually and in
   *      parallel. See #createAndRunParallelRetrainingWorkflow.
   *   - Within the resulting retraining workflow, the source of truth, model status and notifications will be updated.
   * - [details](FaultySensor.Notification#createNotificationsFromMapReduceResult) - Create notifications to be sent
   *      to users as an email about the impacts of the sensor updates.
   * @return A {@link Workflow} object representing the complete faulty sensor process.
   */
  createWorkflow: function(): Workflow py

  /**
   * Create a workflow using #createWorkflow. Run the resulting workflow on sensors that were updated
   * since the [last time the orchestrator ran](#getLatestTimeSensorUpdatesFetched).
   *
   * This function is also responsible for creating a new {@link FaultySensor.Orchestrator.History} record for this
   * run.
   * @return A {@link WorkflowExecutorRun} object representing the execution of the workflow.
   */
  createAndRunWorkflow: function(): WorkflowExecutorRun py

  /**
   * Create a nested {@link Workflow} specifically to run and retrieve the results for the
   * {@link FaultySensor.ModelImpactMapReduceJob}.
   *
   * Creates a job instance based on the `updatedSensors` param, then runs it.
   * The resulting workflow has an output vertex with name
   * {@link FaultySensor.Orchestrator.ModelImpactMapReduceHandler#MAP_REDUCE_RESULT_WORKFLOW_OUTPUT_NAME} that contains
   * the result of {@link FaultySensor.ModelImpactMapReduceJob#retrieveMapReduceResults}.
   *
   * See
   * - {@link FaultySensor.ModelImpactMapReduceJob}
   * - {@link FaultySensor.Orchestrator.ModelImpactMapReduceHandler}
   * - #createModelImpactMapReduceJobOptions
   * @param updatedSensors
   *           Array of sensors that have been updated and need processing.
   * @return A {@link WorkflowExecutorRun} object for the map-reduce nested workflow.
   */
  createAndRunMapReduceNestedWorkflow: function(updatedSensors: [!Sensor]): !WorkflowExecutorRun py

  /**
   * Helper function that will create the map reduce job options used in #createAndRunMapReduceNestedWorkflow.
   * This has the following filter, limit and batchSize:
   * ```py
   *     filter=..., #champion status and the relation is current based on start/end dates
   *     limit=-1,
   *     batchSize=1000,
   * ```
   * @return {@link MapReduceOptions} configured for the model impact map-reduce job.
   */
  createModelImpactMapReduceJobOptions: function(): !MapReduceOptions py

  /**
   * Create a nested {@link Workflow} that will retrain all models that are impacted by sensor updates and have passed
   * the [validation checks](FaultySensor.ModelRetrainValidationResult) of the
   * [map reduce job](FaultySensor.ModelImpactMapReduceJob).
   *
   * This workflow will iterate over all {@link ReliabilityRiskMlModel#id}s passed in as keys.
   * - Check that the validation result indicates we should retrain.
   *     [details](#shouldRetrainModelBasedOnValidationResult)
   * - Create a spec for the retraining process. [details](#createRetrainSpecFromValidationResult)
   * - Create another internal nested workflow to retrain a single model.
   *     [details](FaultySensor.Orchestrator.Spec.Process#createAndStartWorkflow)
   *
   * The resulting workflow is a single workflow with `N` {@link Workflow.Nested.Action} vertices, each unconnected
   * to each other and running in parallel (where `N` is the number of models to retrain).
   *
   * If there are no models to retrain, a mock workflow is returned that should complete instantaneously.
   * @param modelIdToValidationResultMap
   *           Map from model ID to validation result indicating whether retraining is needed.
   * @return A {@link WorkflowExecutorRun} object for the parallel retraining workflow.
   */
  createAndRunParallelRetrainingWorkflow: function(
    modelIdToValidationResultMap: map<string, !FaultySensor.ModelRetrainValidationResult>
  ): !WorkflowExecutorRun py

  /**
   * @param validationResult
   *           Result of map reduce validation for a single model.
   * @return True if the validation result exists and has no errors.
   */
  shouldRetrainModelBasedOnValidationResult: inline function(
    validationResult: !FaultySensor.ModelRetrainValidationResult
  ): boolean py

  /**
   * Transform a {@link FaultySensor.ModelRetrainValidationResult} into a {@link FaultySensor.Orchestrator.Spec.Process}
   * This copies over the relevant information required to begin retraining the model.
   *
   * @param modelId
   *           The ID of the model to retrain. This is the key for the
   *           {@link FaultySensor.ModelRetrainValidationResult} map reduce result.
   * @param validationResult
   *           The validation result for the model.
   * @return A {@link FaultySensor.Orchestrator.Spec.Process} object configured for retraining.
   *
   * See {@link FaultySensor.Orchestrator.Spec.Process} (specifically
   * [createWorkflow](FaultySensor.Orchestrator.Spec.Process#createWorkflow)) for more details.
   */
  createRetrainSpecFromValidationResult: inline function(
    modelId: string,
    validationResult: !FaultySensor.ModelRetrainValidationResult
  ): !FaultySensor.Orchestrator.Spec.Process py

  /**
   * Helper function to create a set of vertices that represent a mock workflow that can be used in a
   * {@link Workflow.Nested.Action}.
   * @return An array of {@link Workflow.Vertex} objects representing an empty workflow.
   */
  createEmptyWorkflowVertices: private inline function(): ![Workflow.Vertex] py
}
