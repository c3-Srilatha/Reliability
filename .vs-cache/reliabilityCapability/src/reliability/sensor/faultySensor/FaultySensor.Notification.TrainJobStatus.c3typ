/**
 * Type that encapsulates the status of a {@link MlModel.Train.JobRun} and an explanation of that status. This type is
 * used to track and communicate the current state in {@link FaultySensor.Notification}.
 */
 type FaultySensor.Notification.TrainJobStatus {

    /**
     * Status value
     * @see JobStatusEnum
     */
    status: !string enum JobStatusEnum

    /**
     * Status explanation. Only used when #status is JobStatusEnum#failed
     */
     statusExplanation: string
 }
