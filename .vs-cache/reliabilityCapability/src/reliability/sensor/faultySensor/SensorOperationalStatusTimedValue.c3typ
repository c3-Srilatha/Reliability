/**
 * Timed value for {@link SensorOperationalStatus}.
 */
type SensorOperationalStatusTimedValue mixes TimedValue {

    /**
     * Status value
     * @see SensorOperationalStatusEnum
     */
    status: !string enum SensorOperationalStatusEnum

    /**
     * The end date of the operational status. It specifies for how long each sensor will be marked faulty for, once the
     * date arrives the status will be updated to SensorOperationalStatusEnum#OPERATIONAL. This field only applies to
     * a sensor with status of SensorOperationalStatusEnum#FAULTY;
     */
    endDate: datetime
}
