/**
 * This type denotes the result of a call to identify which {@link ReliabilityAssetToRiskModelRelation}s
 * are impacted by updates to a {@link Sensor#operationalStatus}.
 *
 * @see FaultySensor.ModelImpactMapReduceJob
 */
type FaultySensor.ImpactedRelationsBatchResult mixes FaultySensor.ImpactedBatchResult<ReliabilityAssetToRiskModelRelation> {
  /**
   * The {@link ReliabilityAssetToRiskModelRelation}s that are impacted by the updates to the {@link Sensor}s.
   * This means that for the relation, it's source of truth model uses at least one of the {@link Sensor}s as
   * a feature or mask.
   */
  impacted: ~

  /**
   * The {@link ReliabilityAssetToRiskModelRelation}s that are not impacted by the updates to the {@link Sensor}s.
   */
  notImpacted: ~

  /**
   * The {@link ReliabilityAssetToRiskModelRelation}s that had special cases for which it was not possible to validate
   * that the relation's source of truth model uses or does not use the {@link Sensor}s as a feature or mask.
   *
   * For example: If the model's {@link Feature.Set}s use a lambda feature that could use data from any sensor.
   */
  unverifiable: ~

  /**
   * The {@link ReliabilityAssetToRiskModelRelation}s that are impacted with the list of impacted {@link Sensor} ids.
   */
  impactedSensors: ~
}
