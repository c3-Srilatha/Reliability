/**
 * Testing type to help with testing of {@link FaultySensor.ModelImpactMapReduceJob}. This is required because it
 * is not possible to spy on in-engine python functions.
 */
private type FaultySensor.MapReduceMockApis {
  /**
   * Mock for {@link FaultySensor.RiskModelSourceOfTruthRelation#getSourceOfTruthForModelsBatch}.
   * @param models
   *           Set of reliability ML models to get source of truth for.
   * @return A map from model ID to the source of truth model.
   */
  getSourceOfTruthForModelsBatch: function (models: set<!ReliabilityMlModel>): map<string, ReliabilityMlModel> js-rhino

  /**
   * Mock for {@link FaultySensor.ModelImpactMapReduceJob#filterRelationsImpactedBySensorsBatch}
   * @param relations
   *           Array of reliability asset to risk model relations to filter.
   * @param modelIdsToSourceOfTruthModels
   *           Map from model ID to source of truth models.
   * @param updatedSensors
   *           Array of sensors that have been updated.
   * @return A {@link FaultySensor.ImpactedRelationsBatchResult} containing the filtered relations.
   */
  filterRelationsImpactedBySensorsBatch: function(
    relations: ![!ReliabilityAssetToRiskModelRelation],
    modelIdsToSourceOfTruthModels: !map<string, ReliabilityRiskMlModel>,
    updatedSensors: ![!Sensor]
  ): !FaultySensor.ImpactedRelationsBatchResult js-rhino

  /**
   * Mock for {@link FaultySensor.ModelImpactMapReduceJob#validateModelCanBeRetrained}
   * @param validationSpec
   *           The validation specification for model retraining.
   * @return A {@link FaultySensor.ModelRetrainValidationResult} indicating whether the model can be retrained.
   */
  validateModelCanBeRetrained: function(
    validationSpec: !FaultySensor.ModelRetrainValidationInput
  ): !FaultySensor.ModelRetrainValidationResult js-rhino
}
