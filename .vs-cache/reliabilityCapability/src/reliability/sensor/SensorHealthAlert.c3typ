remix type SensorHealthAlert mixes FilterableByFacility {

  /**
   * {@link ReliabilityAsset} linked to this alert
   */
  parent: ReliabilityAsset stored calc sensor.parentAsset

  /**
   * {@link ReliabilityAssetAlert}s that share the same {@link ReliabilityAsset} parent
   */
  assetAlerts: [ReliabilityAssetAlert](parent, parent)

  /**
   * Name of this alert
   */
  name: ~ stored calc parent.name + ": Sensor Alert: " + substring(id, 0, 6)

  /**
   * Formatted timestamp of when this alert was triggered to display in UI.
   */
  formattedTimestamp: string calc exists(timestamp) ? formatDateTime(timestamp, "MM/dd/yyyy hh:mma") : '-'

  /**
   * Transition alerts to "Muted" state and creates {@link UserRecommendation} if applicable.
   */
  doAfterCreate: ~ js-rhino

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["parent.facility"]
}
