/**
 * @inheritdoc
 */
remix type ReliabilityAssetSensorRelation {

  /**
   * Represents the historical records of feature importance values
   * for the current {@link ReliabilityAssetSensorRelation} object
   * The relation is captured in {@link GlobalFeatureImportanceHistory}.
   */
  globalFeatureImportanceHistory: [GlobalFeatureImportanceHistory](parent)

  /**
   * The {@link GlobalFeatureImportanceHistory#importanceValue} of the subsytem tag pair according to the latest trained ML model for the subsytem.
   */
  globalFeatureImportanceValue: double calc exists(globalFeatureImportanceHistory) ? globalFeatureImportanceHistory[0].importanceValue : 0

  /**
   * The global feature importance of the subsytem tag pair according to the latest trained ML model for the subsytem.
   */
  globalFeatureImportancePercentage: double calc globalFeatureImportanceValue * 100

  /**
   * The display value for globalFeatureImportancePercentage in UI, rounded to 2 decimal places
   */
  displayGlobalFeatureImportancePercentage: double calc round(globalFeatureImportanceValue * 100, 2)

  /**
   * Determines if there's a {@link PhysicalAssetHierarchyRelation} with a valid time range.
   */
  isPhysicallyConnected: boolean calc intersects(from.relDenormDescendants.((localStart == null || end == null || localStart < end) && (start == null || localEnd == null || start < localEnd)).to.id, to.id)

  /**
   * Internal use only. Prevents undefined behavior in isPhysicallyConnected.
   */
  localStart: private datetime calc start

  /**
   * Internal use only. Prevents undefined behavior in isPhysicallyConnected.
   */
  localEnd: private datetime calc end

  /**
   * The {@link ReliabilityAssetSensorAssociationJob} associated with this relation. Details can be found on
   * {@link ReliabilityAssetSensorAssociationJob}.
   *
   * See #isUpdatedByJob and #correlationValue.
   */
  sensorAssociationJob: ReliabilityAssetSensorAssociationJob

  /**
   * Whether the relation is created explicitly from a #sensorAssociationJob.
   */
  isUpdatedByJob: boolean

  /**
   * If this relation is associated with a #sensorAssociationJob, then this field stores the corresponding correlation
   * value. This is a value between 0 and 1 where 1 means that the sensor (to) is highly correlated with the asset
   * (from). To better understand the process of calculating this field, see
   * {@link ReliabilityAssetSensorAssociationJob}.
   */
  correlationValue: double
}
