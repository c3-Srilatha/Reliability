/**
 * Type to represent the exported data spec for {@link Sensor}.
 */
type SensorExportDataSpec mixes Spec {

  /**
   * Field for {@link Sensor#id}
   */
  id: string

  /**
   * Field for {@link Sensor#tag}
   */
  sensor: string

  /**
   * Field for {@link Sensor#name}
   */
  sensorDisplayName: string

  /**
   * Field for {@link Sensor#unitConstraint}
   */
  unit: string

  /**
   * Field for {@link ReliabilityAssetSensorRelation#expectedSensor}
   */
  expectedSensor: string

  /**
   * The {@link ReliabilityAsset#id} for the direct parent of the {@link Sensor}
   */
  parentAsset: string
}
