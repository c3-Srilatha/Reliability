/**
 * This enum type describes the possible states when {@link Sensor}s are being mapped to {@link ReliabilityAsset}s.
 */
enum type SensorMappingStatus {

  /**
   * This value indicates that the mapping of {@link Sensor}s to {@link ReliabilityAsset}s has not started.
   */
  NOT_STARTED = 'NotStarted'

  /**
   * This value indicates that the mapping of {@link Sensor}s to {@link ReliabilityAsset}s is in progress.
   */
  SENSOR_MAPPING = 'SensorMappingInProgress'

  /**
   * This value indicates that the mapping of {@link Sensor}s to {@link ReliabilityAsset}s has finished.
   */
  COMPLETE = 'Complete'
}
