/**
 * A recommended action for a {@link User} to take on {@link ReliabilityAsset}s.
 */
entity type ReliabilityUserRecommendation extends UserRecommendation mixes FilterableByFacility type key 'RUR' {

  /**
   * The {@link ReliabilityAsset}s this recommendation is for.
   */
  assets: [ReliabilityAsset] schema suffix 'RA'

  /**
   * @inheritdoc
   */
  redirectUrl: !~

  /**
   * Calls {@link ReliabilityUserRecommendation#fetchForUser} and enhances {@link description} with a string indicating time elapsed since recommendation.
   */
  fetchForUserWithTimeElapsed: function(spec: FetchSpec): FetchResult<ReliabilityUserRecommendation> js-rhino

  /**
   * Returns a human readable string indicating how much time has elapsed since the given datetime, e.g. '2 days ago'.
   */
  getTimeElapsedString: private inline function(timestamp: !datetime): !string js-rhino

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["assets.facility"]
}
