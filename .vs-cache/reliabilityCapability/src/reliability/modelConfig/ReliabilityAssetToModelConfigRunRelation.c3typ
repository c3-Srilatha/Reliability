/**
 * Relation type between {@link ReliabilityAsset} and {@link ModelConfigRun}.
 */
entity type ReliabilityAssetToModelConfigRunRelation mixes FilterableByFacility {

  /**
   * The {@link ReliabilityAsset} for this relation.
   */
  from: ReliabilityAsset

  /**
   * The {@link ModelConfigRun} for this relation.
   */
  to: ModelConfigRun

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["from.facility"]
}
