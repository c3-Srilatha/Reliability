/**
 * Type to store the information set in the Model Config Ui Workflow
 * that is necessary to run training + deployment of a model.
 */
type ModelConfigUiSettings {

  /**
   * The id of the {@link ReliabilityMlDatasetPreparationRun} to use as
   * the dataset of the model.
   */
  datasetId: string

  /**
   * The id of the {@link ModelTemplate} to use.
   */
  modelTemplateId: string

  /**
   * The values used to override the hyperparameters of the pipeline outputted by the model template.
   * Key is hyperparam field name.
   */
  hyperparameterOverrides: map<string, any>

  /**
   * The project that is selected for the model configuration.
   */
  project: ReliabilityMl.Project
}
