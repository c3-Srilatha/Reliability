/**
 * Type to aggregate bulk model setup settings and start the ReliabilityOrchestrator based on these settings.
 */
type BulkModelSetupUiSettings {

  /**
   * Settings set by users in {@link BulkSensorAssociationUiSettings} UI.
   */
  sensorAssociationSettings: BulkSensorAssociationUiSettings

  /**
   * Settings set by users in {@link BulkDataPreparationUiSettings} UI.
   */
  dataPrepSettings: BulkDataPreparationUiSettings

  /**
   * Settings set by users in {@link BulkModelConfigUiSettings} UI.
   */
  modelConfigSettings: BulkModelConfigUiSettings

  /**
   * Converts the UI settings into an orchestrator spec.
   *
   * @returns
   *        The {@link ReliabilityOrchestrator.ReliabilityRisk.Spec}.
   */
  toRiskSpec: member function(): ReliabilityOrchestrator.ReliabilityRisk.Spec py

  /**
   * Create and start workflow.
   *
   * @returns
   *        The underlying {@link Workflow.Run} that executes the bulk model setup.
   */
  startBulkModelSetup: member function(): Workflow.Run py

  /**
   * Create and start workflow specific to the reliability risk project.
   *
   * @returns
   *        The underlying {@link Workflow.Run} that executes the bulk model setup.
   */
  startRiskBulkModelSetup: member function(): Workflow.Run py

  /**
   * Create and start workflow specific to the reliability risk for control valves project.
   *
   * @returns
   *        The underlying {@link Workflow.Run} that executes the bulk model setup.
   */
  startCorrelationBulkModelSetup: member function(): Workflow.Run py
}
