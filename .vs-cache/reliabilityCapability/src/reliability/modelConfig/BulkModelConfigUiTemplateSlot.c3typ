/**
 * Type to represent one selected "template slot" in Bulk Model Config UI.
 */
type BulkModelConfigUiTemplateSlot {

  /**
   * The model template to use for this slot
   */
  template: ModelTemplate

  /**
   * The overrides to apply to the model template for this slot
   */
  hyperparameterOverrides: map<string, any>
}
