/**
 * Interface that provides a structure for creating a notification section with a title and content. This interface can
 * be implemented by various classes to ensure consistent notification formatting for the
 * {@link ReliabilityEmailUpdateNotificationScheduler}.
 */
abstract type ReliabilityEmailUpdateNotificationSection {

  /**
   * Function to construct the title of a section. Each section has its own title, which means that an implementation of
   * this function has to be provided. This is called by {ReliabilityEmailUpdateNotificationScheduler#buildContent}.
   *
   * Expected title is an html, e.g.
   * <h1> Sensor Operating Status Updates </h1>
   */
  buildTitle: abstract function(): string js-rhino

  /**
   * Function to construct the content of a section. Each section must provide its own implementation per instance. This
   * is called by {ReliabilityEmailUpdateNotificationScheduler#buildContent}.
   *
   * Expected content is an html with the information of the notification section, e.g.
   * <ol>
   *   <li> Sensor: Sensor 1 </li>
   *   <li> Status: OPERATIONAL </li>
   * </ol>
   *
   * @param isTest
   *     Flag to determine if the content should only include test instances in the content. Used for testing purposes.
   */
  buildContent: abstract function(isTest: boolean = false): string js-rhino
}
