/**
 * Class is responsible for batching the delivery of notifications via email. It allows scheduling notifications,
 * organizing them into {@link ReliabilityEmailUpdateNotificationSection}s, and sending them out at specified intervals.
 * For more information on the configuration you can look at {@link ReliabilityEmailUpdateNotificationConfig}.
 */
 type ReliabilityEmailUpdateNotificationScheduler {

  /**
   * This function will be called by ReliabilityEmailUpdateCronJob, according to the configured frequency.
   * Has the following logic
   *  - Makes a NotificationSpec with the following format:
   *    {subject: this.buildSubject(), content: this.buildContent(), category: this.notificationCategory}
   *  - Fetches the corresponding user to send the notification using {@link User#c3Groups}
   *  - Calls {@link NotificationUserRecipient#scheduleNotificationToUsers} with data from steps above.
   */
  scheduleNotification: function() js-rhino

  /**
   * Function that constructs the subject of the email by grabbing the current date, and returns the corresponding
   * {@link TemplateWithDefaultValue} as a string.
   */
  buildSubject: private function(): string js-rhino

  /**
   * Function that constructs the content of the email by going through each of the
   * {@link ReliabilityEmailUpdateNotificationConfig#sections}, constructing the title and content from the functions of
   * the interface and concatenating the results in a single html string with breaks.
   */
  buildContent: private function(): string js-rhino
}
