/**
 * Relationship between a {@link ProtectionLoopHealthHistory} and an {@link Sensor} with a health issue that
 * raised the protection loop alert.
 */
entity type SensorHealthIssueRelation schema name 'SNR_HLTH_RLN' {

  /**
   * The {@link ProtectionLoopHealthHistory} which was raised based on the {@link Sensor} with
   * health issues in this relation.
   */
  from: !ProtectionLoopHealthHistory

  /**
   * The {@link Sensor} with the health issue.
   */
  to: !Sensor

  /**
   * The name or id of the {@link SensorHealthCategory} that triggered this health issue.
   */
  healthIssue: !string
}
