/**
 * Represents of group of redundant sensors that are monitoring the same process and simultaneously having their
 * health evaluated as a group.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
remix type ProtectionLoop {

  /**
   * The overall asset for the {@link ProtectionLoop} defined as the lowest asset in the hierarchy tree
   * which is an ancestor to all of the sensors in the {@link #sensorRelations}.
   */
  overallAsset: ReliabilityAsset

  /**
   * The parent asset of the protection loop which is the {@link #overallAsset} when specified or the parent asset
   * of the first sensor otherwise.
   */
  parentAsset: ReliabilityAsset stored calc exists(overallAsset) ? overallAsset : (exists(sensorRelations) ? sensorRelations[0].to.parentAsset : null)

  /**
   * A history of unhealthy sensors and overall risk level for the protection loop.
   */
  healthHistory: [ProtectionLoopHealthHistory](parent)

  /**
   * The latest evaluation of protection loop health.
   */
  @db(timedValueHistoryField='healthHistory')
  currentHealth: ProtectionLoopHealthHistory

  /**
   * The open {@link ProtectionLoopAlert}s on this {@link ProtectionLoop}.
   */
  @db(order='descending(timestamp)', filter='currentState.id == "open"')
  openAlerts: [ProtectionLoopAlert](parent)

  /**
   * The latest open {@link ProtectionLoopAlert}.
   */
  latestOpenAlert: ProtectionLoopAlert stored calc exists(openAlerts) ? openAlerts[0] : null

  /**
   * Overrides the {@link ReliabilityProtectionLoopConfig#mediumRiskPercentage} such that this {@link ProtectionLoop}
   * will be considered medium risk at this count of sensor issues and above.
   */
  mediumRiskCount: int

  /**
   * Overrides the {@link ReliabilityProtectionLoopConfig#highRiskPercentage} such that this {@link ProtectionLoop}
   * will be considered high risk at this count of sensor issues and above.
   */
  highRiskCount: int

  /**
   * The lookback period for evaluating the high and low metric logic for the sensors in the protection loop. Overrides
   */
  highLowLookbackPeriod: Period

  /**
   * The threshold of sensor deviation that should be hit for this
   */
  sensorDeviationThreshold: double

  /**
   * It returns the risk status of the latest alert {@link ProtectionLoopHealthHistory} raised.
   */
  risk: string stored calc exists(currentHealth)? currentHealth.risk : "None"

  /**
   * It calculates total sensors in the {@link ProtectionLoop}.
   */
  totalSensors: int stored calc exists(sensorRelations)? count(unique(sensorRelations.to)) : 0

  /**
   * It calculates total unhealty alerts from the latest {@link ProtectionLoopAlert}.
   */
  totalUnhealthySensors: int stored calc exists(currentHealth)? currentHealth.numUnhealthySensors : 0

  /**
   * It calculates total sensors without an alert.
   */
  totalFunctionalSensors: int stored calc abs(`number(totalSensors - totalUnhealthySensors))

  /**
   * Function to upsert {@link ProtectionLoop} upon form submit.
   */
  upsertFromForm: function(formObject: !json, id: string) js-rhino

  /**
   * Returns the level of risk of the {@link ProtectionLoop} based on the percentage/number of sensors having health problems.
   */
  computeLoopHealth: member function(persistLatestHistory: boolean): !string enum ProtectionLoopRiskStatus js-rhino

  /**
   * Find the sensors in the {@link ProtectionLoop} with sensor health issues including ones which violate
   * the {@link lowLowThreshold} or {@link highHighThreshold}.
   */
  sensorsWithSensorHealthIssues: member function(): !SensorHealthIssuesList js-rhino

  /**
   * For a group of {@link Sensor}s that satisfy the filter expression, this function computes the
   * number of {@link Sensor}s that are deviating from the rest.
   *
   * @param filter
   *     A valid filter expression applicable to the {@link Sensor} Type that refers to a list of {@link Sensor}s.
   * @param spec
   *     A {@link SensorDeviationSpec} that provides the specifics of the computation of {@link Sensor} deviations.
   * @param deviationThreshold
   *     {@link Sensor}s may deviate from one another by a small amount and, yet, be considered similar. This defines the threshold beyond which deviations are considered large enough for {@link Sensor}s to be classified into different buckets.
   * @return int
   *     Returns the number of {@link Sensor}s that are deviating from the rest inside this {@link ProtectionLoop}.
   */
  evaluateNumberOfDeviatingSensors: member function(filter: string, spec: !SensorDeviationSpec, deviationThreshold: double = 5): int js-rhino
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
