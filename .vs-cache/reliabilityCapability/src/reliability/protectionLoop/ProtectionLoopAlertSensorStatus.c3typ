/**
 * Type to display in the protection loop alert details grid.
 */
type ProtectionLoopAlertSensorStatus {

  /**
   * The sensor in a protection loop.
   */
  sensor: !Sensor

  /**
   * The timestamp it was triggered.
   */
  time: !datetime

  /**
   * The health status of the sensor at the time of the alert.
   */
  triggerIssue: !string

  /**
   * The current health status of the sensor.
   */
  currentIssue: !string
}
