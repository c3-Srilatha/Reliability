/**
 * List of sensors and their associated health issues.
 */
type SensorHealthIssuesList {

  /**
   * List of {@link Sensor}s with health issues.
   */
  sensors: [Sensor]

  /**
   * List of health issues for the related {@link Sensor}s
   */
  healthIssues: [string]
}
