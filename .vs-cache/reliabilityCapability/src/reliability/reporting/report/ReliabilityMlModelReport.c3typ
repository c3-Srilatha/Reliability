/**
 * A single exportable PDF model report. May contain information about one or more models.
 */
 entity type ReliabilityMlModelReport extends ReliabilityReport mixes FilterableByFacility type key 'RLBLTY_RK_MDL_RPT' {

  /**
   * @inheritdoc
   */
  spec: !ReliabilityMlModelReportSpec

  /**
   * The models whose information is in the report.
   */
  models: [ReliabilityMlModel]

  /**
   * The model that this report is the model validation report for (if applicable).
   */
  modelForValidation: ReliabilityMlModel

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["models.currentAssetRelations.from.facility"]
}
