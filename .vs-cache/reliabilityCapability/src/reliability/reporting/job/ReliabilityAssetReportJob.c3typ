/**
 * A map reduce job that generates a single PDF file containing reports for multiple {@link ReliabilityAsset}s
 */
type ReliabilityAssetReportJob extends MapReduce<ReliabilityAsset, string, File, File> mixes FilterableByFacility type key "RRJ" {

  /**
   * the {@link ReliabilityAssetReport} based on which to generate a report for {@link ReliabilityAsset}s
   */
  report: !ReliabilityAssetReport

  /**
   * the directory in which the individual {@link ReliabilityAsset assets} would be placed
   * after the map function
   */
  mapDirectory: !string

  /**
   * @inheritdoc
   * Generate in each batch a report for a single {@link ReliabilityAsset},
   * and only create title page for the first asset report
   * Note: Assumes one {@link ReliabilityAsset} per batch!
   */
  map: ~ js-rhino

  /**
   * @inheritdoc
   * Intakes the output map
   * Stitches individual asset report pdfs together into one pdf file
   * Stitches multiple {@link ReliabilityAsset}
   */
  reduce: ~ py-pdf_generation

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["report.facility"]
}
