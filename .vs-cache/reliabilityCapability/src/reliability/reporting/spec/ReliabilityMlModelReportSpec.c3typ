/**
 * Spec type to configure user preferences in a {@link ReliabilityMlModel} report
 */
type ReliabilityMlModelReportSpec mixes ReliabilityReportSpec {

  /**
   * Time range used to evaluate metrics on model
   * If a specific time range is not provided, the report will use the date it is generated
   * as the end date and set the start date to one year before the report generation date.
   */
  modelReportTimeRange: TimeRange

  /**
   * Interval used to evaluate metrics on model
   */
  intervalEvaluation: Interval = Interval.DAY

  /**
   * Preferences specifications for model alert reports
   */
  alertReportSpec: ReliabilityAssetAlertReportSpec = {}

  /**
   * Specifies if the report is for model validation
   */
  isValidation: boolean = false
}
