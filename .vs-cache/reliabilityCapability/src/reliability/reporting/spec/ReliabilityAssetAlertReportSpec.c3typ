/**
 * Spec type to configure user preferences in a {@link ReliabilityAssetAlert} report
 */
type ReliabilityAssetAlertReportSpec mixes ReliabilityReportSpec {

  /**
   * Quantity of time before the alert timestamp used to evaluate metrics on alert
   */
  preAlertTimestampPeriod: Period = '7d'

  /**
   * Quantity of time after the alert timestamp used to evaluate metrics on alert
   */
  postAlertTimestampPeriod: Period = '7d'

  /**
   * Interval used to evaluate metrics on alert
   */
  intervalEvaluation: string enum Interval = Interval.HOUR

  /**
   * Number of features to be shown in the 'Contributing features' section
   */
  numTopFeatures: int = 5
}
