/**
 * Spec type to configure data validation for a {@link ReliabilityMlModel} during the report generation.
 */
type ReliabilityMlModelReportValidationSpec {

  /**
   * Enable validation of training/validation dates. (#validateTrainingValidationDates)
   */
  enableTrainingValidationDatesValidation: boolean = true

  /**
   * Enable validation of asset relations. (#validateHasAsset)
   */
  enableAssetRelationsValidation: boolean = true

  /**
   * Enable validation of the feature related data. (#validateFeatureData)
   */
  enableFeatureDataValidation: boolean = true

  /**
   * Method to validate the given list of [models](ReliabilityMlModel) for the report generation.
   * See #validateModel for more details.
   *
   * @param models
   *        The list of models to be validated.
   * @param reportSpec
   *        The report spec that is used to generate the report.
   * @return A map of model id to the list of errors.
   */
  validateModels: member function(models: ![ReliabilityMlModel], reportSpec: ReliabilityMlModelReportSpec): map<string, [string]> py

  /**
   * Validates that the given model is correctly configured for the report generation using a list of steps retrieved
   * from #getValidationSteps method.
   *
   * The validation steps can be configured by the flags in the type instance. (`enable*:`)
   *
   * **NOTE:** If any error is found, the validation process will stop and return the list of errors.
   *
   * @param model
   *        The model to be validated.
   * @param reportSpec
   *        The report spec that is used to generate the report.
   * @return The list of validation errors.
   */
  validateModel: member function(model: !ReliabilityMlModel, reportSpec: ReliabilityMlModelReportSpec): [string] py

  /**
   * Helper method that returns the list of validation steps to be executed for the given report spec.
   * The list of steps is based on the enabled validation flags.
   *
   * @param reportSpec
   *        The report spec that is used to generate the report.
   * @return The list of lambda functions to be executed for the validation. (`native`)
   */
  getValidationSteps: member function(reportSpec: ReliabilityMlModelReportSpec): native py

  /**
   * Checks that {@link ReliabilityMlDatasetPreparationRun#trainFeatureTimeRanges} and
   * {@link ReliabilityMlDatasetPreparationRun#valFeatureTimeRanges} contains `feature` value that contains the
   * `start` and `end` dates of the training and validation data for the given [model](ReliabilityRiskMlModel).
   *
   * @param model
   *        The model to be validated.
   * @return A list of errors if found.
   */
  validateTrainingValidationDates: private inline function(model: !ReliabilityRiskMlModel): [string] py

  /**
   * Checks that {@link ReliabilityRiskMlModel#currentAssetRelations} contains at least one [asset](ReliabilityAsset)
   * relation.
   *
   * @param model
   *        The model to be validated.
   * @return A list of errors if found.
   */
  validateHasAsset: private inline function(model: !ReliabilityRiskMlModel): [string] py

  /**
   * - Checks that the given model has related features, using {@link ModelFeaturesFetchHelper#fetchFeaturesForModel}
   *   method.
   * - Checks the fetched features for containing {@link FeatureFetchBase#sensorId}.
   * - Checks that the list of sensors ids are referencing to valid {@link Sensor}s entities.
   *
   * @param model
   *        The model to be validated.
   * @param reportSpec
   *        The report spec that is used to generate the report.
   * @return A list of errors if found.
   */
  validateFeatureData: private inline function(model: !ReliabilityRiskMlModel, reportSpec: ReliabilityMlModelReportSpec): [string] py
}
