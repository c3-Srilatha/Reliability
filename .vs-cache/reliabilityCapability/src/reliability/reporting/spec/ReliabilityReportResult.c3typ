/**
 * Represents the result of {@link ReliabilityReportHelper#generateReport} method.
 */
type ReliabilityReportResult {

  /**
   * List of errors that occurred during the validation step of the report generation.
   */
  errors: [string]

  /**
   * The generated report file. This field can be `null` if the report generation failed.
   * See #errors for more information.
   */
  reportFile: File
}
