/**
 * This type is used to update the Data Validation Rules by removing or updating existing rules.
 */
type ReliabilityDataValidationRuleUpdate mixes SchemaUpgrade {

 /**
  * This method is used to remove any {@link DataValidationRule} based on a given action Name.
  */
  removeDataValidationRule_1: private function(actionName: string): any js-rhino

 /**
  * This method updates the {@link DataValidationRule} type by removing the rules with the actionName `doesAssetTemplateExist`
  */
  removeAssetTemplateRule_1: function(): any js-rhino

 /**
  * `doesAssetTemplateExist` actionName to be removed
  */
  ASSET_TEMPLATE_ACTION_NAME: const string = "doesAssetTemplateExist"
}
