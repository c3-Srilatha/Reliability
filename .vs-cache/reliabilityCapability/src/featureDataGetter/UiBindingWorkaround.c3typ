/**
 * Allows the use of the `unit` field of
 * a yAxisField for forcing separate calls of the same metric on different pairs of
 * entityIds and bindings.
 */
type UiBindingWorkaround {

  /**
   * Wrapper for an eval metrics call that avoids the UI merging bindings incorrectly.
   * It expects `unitId` to be populated with the actual type to evaluate on, followed by
   * `-<anything>`.
   */
  evalMetrics: function(spec: EvalMetricsSpec): EvalMetricsResult js-rhino
}
