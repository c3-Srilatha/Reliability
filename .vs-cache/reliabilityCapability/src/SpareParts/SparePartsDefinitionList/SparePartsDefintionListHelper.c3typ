/**
 * Helper to get data for definition list on Spare Parts page in the UI.
 */
type SparePartsDefintionListHelper {

  /**
   * Function to get the required details for definition list
   * Returns an object with the following keys:
   * - totalUniquePartsInInventory - The total number of distinct spare parts currently available in the inventory.
   * - numberOfSuppliers - The total count of distinct suppliers providing parts for the inventory.
   * - impactedWorkOrders - The number of work orders that are affected due to insufficient parts.
   * - percentageOfInsufficientWorkOrders - The percentage of work orders that lack the necessary parts to be completed.
   */
  get: function(): json js-rhino
}
