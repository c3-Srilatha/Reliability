/**
 * Helper type to fetch data for Spare Parts Grid from Inventory series.
 */
type InventorySeriesHelper {
  /**
   * function that retrieves data from the Inventory Series based on specified criteria.
   * @param spec
   *           The fetch specification to use for retrieving inventory series data.
   * @return A {@link FetchResult} containing the inventory series items.
   */
  fetch: function(spec: FetchSpec): FetchResult<InventorySeries> js-rhino

  /**
   * function that retrieves the count of inventory series items based on specified criteria.
   * @param spec
   *           The fetch filter specification to use for counting inventory series items.
   * @return The count of inventory series items matching the criteria.
   */
  fetchCount: function(spec: FetchFilterSpec): int js-rhino

}
