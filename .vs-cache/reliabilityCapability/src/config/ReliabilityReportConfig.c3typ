/**
 * Default configurations for exportable report user workflows.
 */
type ReliabilityReportConfig mixes Singleton, Config {

  /**
   * Defaults for asset reports. Applied in {@link ReliabilityAsset#generateReport}.
   */
  assetReportDefaults: ReliabilityAssetReportSpec

  /**
   * Defaults for model validation reports.
   */
  modelValidationDefaults: ReliabilityMlModelReportSpec

  /**
   * Directory in C3 file system where generated reports are stored.
   */
  reportDirectory: string
}
