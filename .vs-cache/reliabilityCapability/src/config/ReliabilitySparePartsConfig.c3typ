/**
 * Configurations for Spare parts related application logic.
 */
type ReliabilitySparePartsConfig mixes Config, Singleton {

  /**
   * The look back window, expressed in months, to be used during {@link InventoryStats#calculateInventoryStats}
   * Defaults to previous 3 months.
   */
  lookBackTimeWindow: int = 3

  /**
   * The look ahead window, expressed in months.
   */
  lookAheadTimeWindow: int = 3

  /**
   * The look back window, expressed in months, to be used during {@link PurchaseOrderStats#calculatePurchaseOrderStats}.
   * Defaults to previous 12 months.
   */
  purchaseOrderLookBackMonths: int = 12
}
