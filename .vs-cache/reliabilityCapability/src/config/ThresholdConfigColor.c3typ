/**
* Enum specifying the available colors for {@link ThresholdConfig#color}.
*/
enum type ThresholdConfigColor {
  /**
   * Red
   */
  RED = '#DB1C3C'

  /**
   * Orange
   */
  ORANGE = '#ED6921'

  /**
   * Yellow
   */
  YELLOW = '#F2950A'

  /**
   * Green
   */
  GREEN = '#6CA11D'

  /**
   * Light Green
   */
  LIGHT_GREEN = '#01b696'

  /**
   * Grey
   */
  GREY = '#596881'

  /**
   * Cyan
   */
  CYAN = '#0CA0AB'

  /**
   * Blue
   */
  BLUE = '#4F8DFF'

  /**
   * Olive
   */
  OLIVE = '#9E933F'

  /**
   * Purple
   */
  PURPLE = '#B073FF'

  /**
   * Plum
   */
  PLUM = '#D96AB6'

  /**
   * White
   */
  WHITE = '#FFFFFF'
}
