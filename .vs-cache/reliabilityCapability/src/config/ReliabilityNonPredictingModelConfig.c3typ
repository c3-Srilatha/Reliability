/**
 * Configuration for Non-Predicting Models application logic.
 */
type ReliabilityNonPredictingModelConfig mixes Singleton, Config {
  /**
   * The threshold duration (in days) equal to or above which, if the model is not generating predictions
   * the model will be classifed as non-predicting.
   */
  nonPredictingThresholdDays: int = 1
}
