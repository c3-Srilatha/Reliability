/**
 * Actual dates corresponding to identified holidays
 * Many holidays vary year by year with unpredictable rules
 * Business Key: scheduleHoliday+date
 */
@db(unique=['calendarDay,scheduleHoliday'])
@seed(userUpdatable=true, userRemovable=true, userCreatable=true)
entity type ScheduleHolidayDate mixes SeedData schema name 'SCHD_HLDYDAT' {

  calendarDay: !datetime

  /**
   * FK references FROM parents
   */
  scheduleHoliday: !ScheduleHoliday
}
