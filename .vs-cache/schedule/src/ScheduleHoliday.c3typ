/**
 * A day that repeats annually that is typically not a workday, recognized by the
 * country's government or a major industry (Banking) as a holiday.
 *   Labor Day
 *   Christmas Day
 * Business Key: name+region
 */
@db(unique=['geoPoliticalRegion, name'])
@seed(userUpdatable=true, userRemovable=true, userCreatable=true)
entity type ScheduleHoliday mixes SeedData schema name 'SCHD_HOLIDAY' {

  description: string

  /**
   * FK references FROM parents
   * State or Country holiday applies
   */
  geoPoliticalRegion: !Region

  /**
   * FK references TO children
   */
  scheduleHolidayDate: [ScheduleHolidayDate](scheduleHoliday)

  scheduleHolidaySchedule: [ScheduleHolidaySchedule](scheduleHoliday)

  /**
   * i.e. Labor Day, Thanksgiving
   */
  name: !~
}
