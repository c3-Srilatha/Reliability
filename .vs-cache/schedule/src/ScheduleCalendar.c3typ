/**
 * Base type for a schedule
 * Associates standard workday time schedules and/or holidays to a single entity
 * that may be associated to other entities (i.e. a Facility, Utility for rate schedules, etc)
 * Business Key: partyRole + name
 */
entity type ScheduleCalendar mixes SeedData schema name 'SCHD_SCHEDCAL' {

  /**
   * CPPD critical peak pricing date and time windows, HoursOfOperation - Operational hours schedule
   */
  scheduleType: !string enum('CPPD', 'HoursOfOperation')

  /**
   * inclusive
   */
  effectiveDate: datetime

  /**
   * exclusive
   */
  effectiveEndDate: datetime

  /**
   * FK references TO children
   * related holidays
   */
  scheduleHolidaySchedule: [ScheduleHolidaySchedule](scheduleCalendar)

  /**
   * exception dates to standard schedule
   */
  scheduleExceptionDatetimeWindow: [ScheduleExceptionDatetimeWindow](scheduleCalendar)

  /**
   * standard daily schedule rules
   */
  scheduleRecurringDayRule: [ScheduleRecurringDayRule](scheduleCalendar)

  name: !~
}
