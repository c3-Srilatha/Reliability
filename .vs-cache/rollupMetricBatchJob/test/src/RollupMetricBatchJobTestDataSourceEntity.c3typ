/**
 * This type is only used in `test_RollupMetricBatchJob.js` for testing purposes.
 */
entity type RollupMetricBatchJobTestDataSourceEntity mixes MetricEvaluatable {
  /**
   * The {@link RollupMetricBatchJob}.
   */
  job: RollupMetricBatchJob

  /**
   * A number used for testing purposes.
   */
  number: int

  /**
   * The timeseries data for the {@link RollupMetricBatchJob}.
   */
  data: [RollupMetricBatchJobTestDataPoint](parent)

  /**
   * Function to test partially applied action.
   * @param number
   *          The number used for testing purposes
   * @param job
   *          The {@link RollupMetricBatchJob}.
   */
  testAction: function(number: int, job: RollupMetricBatchJob) js-rhino
}
