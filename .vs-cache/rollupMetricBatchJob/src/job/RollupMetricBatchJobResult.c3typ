/**
 * Final result for {@link RollupMetricBatchJob}
 */
@db(compactType=true,
    datastore='cassandra',
    partitionKeyField='parent',
    persistenceOrder='expression',
    persistDuplicates=false,
    shortId=true,
    shortIdReservationRange=100000)
entity type RollupMetricBatchJobResult mixes RollupMetricBatchJobResultSpec
