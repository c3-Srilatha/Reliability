/**
 * Batch job options for {@link RollupMetricBatchJob}.
 */
type RollupMetricBatchJobOptions mixes RollupMetricSpec {

  /**
   * Size of each batch.
   */
  batchSize: int = 100

  /**
   * C3 type name.
   */
  srcType: !string
}
