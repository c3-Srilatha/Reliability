/**
 * Intermediate output for {@link RollupMetricBatchJob}.
 */
@db(compactType=true,
    datastore='cassandra',
    partitionKeyField='parent',
    persistenceOrder='expression',
    persistDuplicates=false,
    shortId=true,
    shortIdReservationRange=100000)
private entity type RollupMetricBatchJobBatchResult mixes RollupMetricBatchJobResultSpec {

  /**
   * #timeseries.data is the result of those `ids`.
   * This field is created for debugging purposes.
   */
  ids: ![string]

  /**
   * rollupFunc used to generate the data
   * This field is created for debugging purposes.
   */
  rollupFunc: string

  /**
   * A 0-indexed batch number
   * This field is created for debugging purposes.
   */
  batchId: !int
}
