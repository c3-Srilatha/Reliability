/**
 * This type is created for ui components because we cannot add extra arguments to the rollupMetrics call from charts.
 * For example, to create a chart that uses the persisted rollupMetrics result for the `Organization` type,
 * there are two options:
 * 1. In the chart configuration, set RollupMetricFromPersistedResult<Organization> as the data type.
 * 2. Create type OrganizationRollupMetricFromPersistedResult mixes RollupMetricFromPersistedResult<Organization>,
 * set OrganizationRollupMetricFromPersistedResult as the data type in the chart.
 */
type RollupMetricFromPersistedResult<S> {

  /**
   * Similar to {@link RollupMetricPersistedResult#rollupMetrics}.
   * `srcType` is derived from the binding for `S`.
   * Because this function is intended for the UI components, {@link RollupMetricSpec} is used as the argument type.
   * However, only fields in {@link RollupMetricPersistedResultRollupMetricSpec} are supported.
   * Other fields are ignored.
   * @param spec
   *          The {@link RollupMetricSpec} which specifies which rollupFunc to use, as well as the relevant metric fields.
   * @returns a mapping from the expression to the resulting {@link Timeseries}.
   */
  @action(group='rollupMetricsGroup')
  rollupMetrics: function(spec: !RollupMetricSpec): map<string, Timeseries<any>> js-rhino
}
