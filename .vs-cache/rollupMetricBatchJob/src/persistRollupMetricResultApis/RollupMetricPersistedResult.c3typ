/**
 * Persisting the result of rollupMetrics. Main functions are #startRollupMetricBatchJobs,
 * #startRollupMetricBatchJob, and #rollupMetrics.
 *
 * @see RollupMetricCacheConfig
 */
@db(datastore='cassandra',
    compactType=true,
    partitionKeyField='srcType',
    persistenceOrder='expression',
    persistDuplicates=false,
    shortId=true,
    shortIdReservationRange=100000)
entity type RollupMetricPersistedResult {

  /**
   * Type name to run #rollupMetrics on.
   */
  srcType: !string

  /**
   * {@link RollupMetricSpec#filter}
   */
  filter: !string serialized Filter

  /**
   * {@link RollupMetricSpec#rollupFunc}
   * 'OR', 'AND', 'VARIANCE' and 'STDDEV' are supported
   * only by {@link RollupMetricPersistedResult#startRollupMetricMapReduceJobs}.
   */
  rollupFunc: !string

  /**
   * {@link RollupMetricSpec#interval}
   */
  interval: !string enum Interval

  /**
   * {@link RollupMetricSpec#expressions}
   */
  expression: !string

  /**
   * {@link RollupMetricSpec#timeZone}
   */
  timeZone: !string serialized TimeZone

  /**
   * Timeseries
   */
  ts: Timeseries<double>

  /**
   * Get rollupMetrics result from {@link RollupMetricPersistedResult}
   * If the time range in `spec` exceeds the time range in the persisted timeseries, 0 (missing) will be returned
   * for the non-overlapping time range.
   * @param spec
   *          The {@link RollupMetricPersistedResultRollupMetricSpec} which specifies which rollupFunc to use, as well as the relevant metric fields.
   * @param srcType
   *          The {@link RollupMetricPersistedResult#srcType} to run on.
   * @returns a mapping from the expression to the resulting {@link Timeseries}.
   */
  rollupMetrics: function(spec: !RollupMetricPersistedResultRollupMetricSpec, srcType: !string): map<string, Timeseries<double>> js-rhino

  /**
   * Save rollupMetrics result to {@link RollupMetricPersistedResult}
   * @param spec
   *          The {@link RollupMetricPersistedResultRollupMetricSpec} which specifies which rollupFunc to use, as well as the relevant metric fields.
   * @param srcType
   *          The {@link RollupMetricPersistedResult#srcType} to run on.
   * @param result
   *          The result from {@link RollupMetricPersistedResult#rollupMetrics}.
   * @param replace
   *          If `true`, the existing {@link RollupMetricPersistedResult} will be replaced with the new result.
   *          If `false`, the existing {@link RollupMetricPersistedResult} will be concatenated with the new result.
   */
  persistResult: private function(spec: !RollupMetricSpec, srcType: !string, result: !map<string, Timeseries<double>>, replace: boolean) js-rhino

  /**
   * Save the result from a {@link RollupMetricBatchJob} to {@link RollupMetricPersistedResult}
   * @param job
   *          The {@link RollupMetricBatchJob} to run and persist.
   * @param replace
   *          If `true`, the existing {@link RollupMetricPersistedResult} will be replaced with the new result.
   *          If `false`, the existing {@link RollupMetricPersistedResult} will be concatenated with the new result.
   */
  persistResultFromJob: private function(job: !?RollupMetricBatchJob, replace: boolean) js-rhino

  /**
   * Start a {@link RollupMetricBatchJob} and save the result of the job to {@link RollupMetricPersistedResult}.
   * If multiple [time zones](RollupMetricStartPersistenceJobSpec#timeZones) are specified, multiple jobs will be started.
   * @param spec
   *          The {@link RollupMetricStartPersistenceJobSpec} to use in the job.
   * @returns The started {@link RollupMetricBatchJob}s.
   */
  @deprecated(finalVersion="15.0", details="Use {@link #startRollupMetricMapReduceJobs}.")
  startRollupMetricBatchJob: function(spec: !RollupMetricStartPersistenceJobSpec): ![RollupMetricBatchJob] js-rhino

  /**
   * Start multiple {@link RollupMetricBatchJob}s and save the result of the jobs to {@link RollupMetricPersistedResult}.
   * @param specs
   *          An array of {@link RollupMetricStartPersistenceJobSpec}s to use in the jobs.
   * @returns The started {@link RollupMetricBatchJob}s.
   */
  @deprecated(finalVersion="15.0", details="Use {@link #startRollupMetricMapReduceJobs}.")
  startRollupMetricBatchJobs: function(specs: ![RollupMetricStartPersistenceJobSpec]): ![RollupMetricBatchJob] js-rhino

  /**
   * Replace the old {@link Timeseries} with a new one in this record.
   * @param timeseries
   *    The {@link Timeseries} that will be persisted in this record.
   * @returns
   *    The updated object containing the {@link Timeseries}.
   */
  persistRollupMetric: private member function(timeseries: !Timeseries): !RollupMetricPersistedResult js-rhino

  /**
   * Custom constructor that returns the rollupMetric if persisted or creates it with the given params.
   * @param srcType
   *    Type of the {@link FeatureEvaluatable#rollupMetrics} to retrieve.
   * @param expression
   *    The metric to retrieve.
   * @param metricSpec
   *    The spec of the metric to retrieve.
   * @returns
   *    The retrieved object of this type.
   */
  createRollupMetricCache:private function(srcType: !string, expression: !string, metricSpec: !RollupMetricSpec): !RollupMetricPersistedResult  js-rhino

   /**
   * Runs the {@link RollupMetricMapReduceJob} and persits the results in {@link RollupMetricPersistedResult}.
   * @param spec
   *   The spec with the parameters used to run the rollupMetrics. map<string, Timeseries>
   * @returns
   *    The {@link RollupMetricMapReduceJob} ran to compute the metrics.
   */
  startRollupMetricMapReduceJobs: function(spec: !RollupMetricStartPersistenceJobSpec): ![RollupMetricMapReduceJob] js-rhino

  /**
   * Fetch the cache according to the field values given.
   * @param spec
   *    The spec of the metric to retrieve.
   * @param srcType
   *    The type of the metric to retrieve.
   * @param include
   *    The fields to include in the fetch.
   * @returns
   *    The {@link RollupMetricPersistedResult} resulting from the fetch.
   */
  fetchResultForSpec: private function(spec: !RollupMetricSpec, srcType: !string, include: string): [RollupMetricPersistedResult] js-rhino

    /**
   * Helper function to align the start and end dates in an EvalMetricsSpec
   * based on the interval and time zone.
   *
   * @param spec
   *    The EvalMetricsSpec for metric evaluation.
   * @returns
   *    The updated EvalMetricsSpec with aligned start and end dates.
   */
  _alignSpecDates: private function(spec: !EvalMetricsSpec): EvalMetricsSpec js-rhino

  /**
   * For a given EvalMetricsSpec, generates the correct expression(s) with bindings.
   *
   * If the bindings are not an array, converts them to an array to ensure consistent processing logic.
   *
   * @param spec
   *    The EvalMetricsSpec for which to retrieve expressions with bindings.
   * @returns
   *    The list of expressions, each with bindings applied.
   */
  _getExpressionsWithBindings: private function(spec: !EvalMetricsSpec): [string] js-rhino

  /**
   * For a given EvalMetricsSpec, generates the list of resultKey-based expressions.
   * Used for mapping the "default" and "customized" result keys.
   *
   * @param spec
   *    The EvalMetricsSpec for which to retrieve resultKey-based expressions.
   * @returns
   *    The list of expression strings, each with its corresponding result key.
   */
  _getExpressionsWithResultKey: private function(spec: !EvalMetricsSpec): [string] js-rhino

  /**
   * Helper function to determine the set of time zones to use for metrics persistence.
   *
   * If no time zones are provided, reads RollupMetricCacheConfig#timeZones,
   * and if still empty defaults to TimeZone.NONE.
   *
   * @param timeZones
   *    Set of time zones to check and potentially update.
   * @returns
   *    The effective set of time zones to use for persistence.
   */
  _getTimeZones: private function(timeZones: set<TimeZone>): set<TimeZone> js-rhino

}
