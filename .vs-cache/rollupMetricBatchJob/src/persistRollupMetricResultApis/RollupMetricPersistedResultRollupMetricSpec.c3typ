/**
 * A subset of {@link RollupMetricSpec} that is supported by {@link RollupMetricPersistedResult#rollupMetrics}
 */
type RollupMetricPersistedResultRollupMetricSpec mixes Spec {

  /**
   * Same as {@link RollupMetricSpec#rollupFunc}
   */
  rollupFunc: string

  /**
   * Same as {@link RollupMetricSpec#filter}
   * It has to be an exact match to the filter used in {@link RollupMetricPersistedResult#startRollupMetricBatchJob}.
   */
  filter: string

  /**
   * Same as {@link RollupMetricSpec#expressions}
   */
  expressions: !set<string>

  /**
   * Same as {@link RollupMetricSpec#bindings}
   */
  bindings: map<string, any> | [map<string, any>]

  /**
   * Same as {@link RollupMetricSpec#resultKey}
   */
  resultKey: lambda(expression: string, bindings: map<string, any>): !string

  /**
   * Same as {@link RollupMetricSpec#start}
   */
  start: !datetime

  /**
   * Same as {@link RollupMetricSpec#end}
   */
  end: !datetime

  /**
   * Same as {@link RollupMetricSpec#interval}
   */
  interval: !string enum Interval = DAY

  /**
   * Same as {@link RollupMetricSpec#timeZone}
   */
  timeZone: TimeZone = NONE
}
