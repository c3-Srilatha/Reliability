/**
 * Refers to money in any form when in actual use or circulation as a medium of exchange,
 * especially circulating banknotes and coins.
 */
entity type Currency extends FinancialAsset type key 'CRNCY' {

  /**
   * Name of the {@link Currency}.
   */
  name: !~

  /**
   * Code used to represent the {@link Currency} in iso format e.g. USD, EUR.
   */
  code: !string

  /**
   * Shorthand for the {@link Currency}'s name, especially in reference to amounts of money e.g. $.
   */
  symbol: string

  /**
   * Subdivision of the {@link Currency}.
   */
  fractionalUnit: string

  /**
   * Conversion factor from subdivision unit to basic unit of the {@link Currency}.
   */
  numberToBasic: int
}
