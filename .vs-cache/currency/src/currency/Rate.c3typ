/**
 * Price history of a {@link Currency} into another {@link Currency}.
 */
entity type Rate mixes IntervalDataHeader<RateData>, SeedData schema name 'CURRENCY_RATE' {

  /**
   * Symbole of the {@link Rate}.
   */
  symbol: !string = concat(from.name, ' / ', to.name)

  /**
   * {@link Exchange} used for the {@link Rate}.
   */
  exchange: Exchange

  /**
   * Domestic {@link Currency} for the {@link Rate}.
   */
  from: !Currency

  /**
   * Foreign {@link Currency} for the {@link Rate}.
   */
  to: !Currency

  /**
   * Name of the {@link Rate}.
   */
  name: !~ = symbol
}
