/**
 * An icon configuration setting for a {@link UiGanttChart}.
 *
 * For example, if the configuration looks like this:
 * "primaryPuckLabelIcon": {
 *   "fieldName": "isConverted",
 *   "iconClassConfigurationStrategy": {
 *     "value": [{
 *        "icon": "check",
 *        "mappedValue": {
 *          "type": "boolean",
 *          "value": true
 *        }
 *      }]
 *    }
 *  }
 * This means the component will look up `isConverted` field,
 * if the value is `true`, component will display `check` icon.
 */
type UiGanttChartIconDataSpecSetting mixes UiSdlFieldBasedDataSpecSetting {
  /**
   * The strategy to display the icon.
   */
  iconClassConfigurationStrategy: UiGanttChartIconCategoricalSetting
}
