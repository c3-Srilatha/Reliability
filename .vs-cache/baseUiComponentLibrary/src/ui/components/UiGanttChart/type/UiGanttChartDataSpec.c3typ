/**
 * The specification of data retrieval for instances of the {@link UiGanttChart} component type.
 * Conceptually the dataType in this data spec represent a row in the final Gantt Chart.
 */
@beta
@typeScript
type UiGanttChartDataSpec mixes UiSdlFieldBasedDataSpec, WithDataTransforms {
  /**
   * The action used to retrieve data.
   */
  actionName: string = 'fetch'

  /**
   * The arguments that needs to pass to the action.
   */
  actionArgs: map<string, any>

  /**
   * Filter string to be used in fetch call in toPartiallyAppliedActions method.
   */
  filter: string

  /**
   * The field of the dataType that represents the collection of pucks associated with a row.
   */
  pucks: !UiSdlFieldBasedDataSpecSetting

  /**
   * The data spec for the pucks.
   */
  puckDataSpec: !UiGanttChartPuckDataSpec

  /**
   * The field of the dataType that provides a specific color mapping.
   * The color mapping would be used to overwrite the default puck coloring logic.
   * If a given puck is specified in this mapping, then the color would be overwritten.
   * If the puck does not appear in this mapping, then the default logic would be used.
   *
   * This field can be used in combination with {@link UiGanttChart#defaultColors}.
   *
   * Mapping key: values provided from `puckDataSpec.puckColor`
   * Mapping value: hex color values (e.g. '#2266F0')
   */
  puckColorOverwrite: UiSdlFieldBasedDataSpecSetting

  /**
   * The field of the dataType used to label each row.
   */
  rowLabel: UiSdlFieldBasedDataSpecSetting

  /**
   * Converts the data spec into an array of partially applied actions.
   */
  toPartiallyAppliedActions: ~ ts-client
}
