/**
 * Type defines allowed {@link UiGanttChartInteractionConfig} actions.
 */
@beta
@typeScript
type UiGanttChartInteractionConfig {
  /**
   * Allows a puck to be edited by being horizontally dragged.
   */
  horizontallyDraggable: boolean

  /**
   * Allows a puck to be edited by being vertically dragged.
   */
  verticallyDraggable: boolean

  /**
   * Allows to select a puck by clicking on the chart.
   */
  allowPointSelect: boolean

  /**
   * Allows the x-axis to be scrolled.
   */
  horizontallyScrollable: boolean
}
