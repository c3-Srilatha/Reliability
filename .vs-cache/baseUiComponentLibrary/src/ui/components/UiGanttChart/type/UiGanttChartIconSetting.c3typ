/**
 * An icon configuration for a single field at {@link UiGanttChart}.
 */
@beta
@typeScript
type UiGanttChartIconSetting {
  /**
   * The name of the icon.
   */
  icon: !string

  /**
   * The value of the target field that corresponding to the icon.
   * If the result value matches this field, component will render the icon.
   * Look up {@link UiGanttChartIconDataSpecSetting} for more details.
   */
  mappedValue: !(string | boolean)
}
