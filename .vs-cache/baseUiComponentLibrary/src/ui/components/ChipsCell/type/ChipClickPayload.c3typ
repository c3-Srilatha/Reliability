/**
 * Payload for a {@link ChipClickAction}.
 */
type ChipClickPayload mixes UiSdlComponentActionPayload {

  /**
   * The record for the currently selected/focused row in a {@link UiSdlDataGrid}.
   */
  dataItem: json

  /**
   * The specific value of the chip that was clicked inside a {@link ChipsCell}. See
   * {@link ChipsCell#fieldPath} for more information on the shape of this value.
   */
  selectedValue: string | json
}
