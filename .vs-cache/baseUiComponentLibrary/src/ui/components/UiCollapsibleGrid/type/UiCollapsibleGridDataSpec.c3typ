/**
 * The specification of data retrieval for instances of the {@link UiCollapsibleGrid} component type.
 */
type UiCollapsibleGridDataSpec mixes UiSdlFieldBasedDataSpec, WithDataTransforms {
  /**
   * The action used to retrieve data.
   */
  actionName: string

  /**
   * The arguments that needs to pass to the action.
   */
  actionArgs: map<string, any>

  /**
   * Converts the data spec into an array of partially applied actions.
   */
  @typeScript(env='client')
  toPartiallyAppliedActions: ~
}
