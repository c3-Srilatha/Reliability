/**
 * {@link UiCollapsibleGrid#rightClickActions}
 */
type UiCollapsibleGridRightClickAction {
  /**
   * The name of the Redux action to be triggered.
   * When this action is clicked a Redux action will be triggered with suffix RIGHT_CLICK_{actionSuffix}.
   */
  actionSuffix: !string

  /**
   * The arguments for the action.
   */
  args: private json

  /**
   * The human readable label of the action to display as text.
   */
  label: !string
}
