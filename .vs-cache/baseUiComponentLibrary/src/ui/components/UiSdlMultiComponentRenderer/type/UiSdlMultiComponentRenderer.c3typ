/**
 * This Type is different from {@link UiSdlDynamicComponentRenderer} and it used for dynamically rendering static components. Which static components to render are unknown at runtime.
 * Whereas, {@link UiSdlDynamicComponentRenderer} is used when component definition is unknown and also does not map to an existing file.
 */
@typeScript
type UiSdlMultiComponentRenderer mixes UiSdlComponent<UiSdlNoData> {
  /**
   * Optional className to put on the wrapping <div> surrounding the nested component. Helpful for styling specific
   * renderers if required.
   */
  className: string

  /**
   * The id of the component to render.
   */
  componentToRender: string

  /**
   * The possible components to render, must be defined in application metadata and part of the Webpack bundle.
   */
  allComponents: [UiSdlComponentRef<UiSdlComponent>]

  /**
   * The initial component to render.
   */
  initialComponent: string

  /**
   * Triggered when the component update needs to happen.
   *
   * @param id
   *           Id of the {@link UiSdlMultiComponentRenderer}.
   * @param component
   *           Id of the new component.
   * @returns a `COMPONENT_UPDATE` action for this instance.
   */
  @uiSdlActionCreator(actionType='COMPONENT_UPDATE')
  updateComponentAction: private function(id: !string, component: !string): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `COMPONENT_UPDATE` and updates the internal field {@link #componentToRender}.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   * @returns a new Redux state.
   */
  @uiSdlReducer(actionType='COMPONENT_UPDATE')
  componentUpdateReducer: private function(state: !UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxState ts-client
}
