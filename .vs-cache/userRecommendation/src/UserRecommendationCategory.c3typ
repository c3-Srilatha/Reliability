/**
 * Type which specifies the logic to generate {@link UserRecommendation}s which are recommended actions
 * that users should take on a specific type.
 */
entity type UserRecommendationCategory schema name 'USR_REC_CAT' {

  /**
   * The name of the recommendation category.
   */
  name: ~

  /**
   * Description of the {@link UserRecommendation}s this recommendation category is generating.
   */
  description: string

  /**
   * Whether or not any recommendation generated by {@link generateRecommendation} is automatically dismissed for the current user (as defined by `c3Context().username`).
   * Useful if recommendations are directly triggered by user actions.
   */
  autoDismissTriggeringUser: boolean

  /**
   * Specifies whether or not this recommendation category is currrently enabled to generate {@link UserRecommendation}s.
   */
  inactive: boolean

  /**
   * The user-defined API to call which will generate {@link UserRecommendation}s.
   */
  recommendationGenerator: PartiallyAppliedAction schema suffix 'ACTION'

  /**
   * Base function which will call the {@link UserRecommendationCategory#recommendationGenerator} action.
   */
  generateRecommendation: member function(args: map<string, any>) js-rhino
}
