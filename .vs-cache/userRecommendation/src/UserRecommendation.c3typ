/**
 * A recommended action that {@link User}s should take.
 */
entity extendable type UserRecommendation schema name 'USR_REC' {

  /**
   * The {@link UserRecommendationCategory} which generated this.
   */
  category: !UserRecommendationCategory

  /**
   * A redirect url used to help {@link User}s take the recommended action represented by this recommendation.
   */
  redirectUrl: string

  /**
   * Information specific to the recommended action.
   */
  description: !string

  /**
   * Whether or not the recommendation has been dismissed for all {@link User}s.
   */
  dismissedGlobally: boolean

  /**
   * The dismissal history of this recommendation for {@link User}s.
   */
  dismissedHistory: [UserRecommendationDismissedHistory](parent)

  /**
   * The set of {@link User}s that have dismissed this recommendation.
   */
  dismissedUsers: [string] stored calc dismissedHistory.user.id schema suffix 'DU'

  /**
   * Fetches the recommendations for the current {@link User} based on if those recommendations have not been dismissed for that user.
   */
  @action(group='read')
  fetchForUser: function(spec: !FetchSpec): !FetchResult<mixing UserRecommendation> js-rhino

  /**
   * Dismisses this recommendation for the current {@link User}.
   */
  @action(group='write')
  dismissForUser: member function() js-rhino

  /**
   * Dismisses this recommendation globally for all {@link User}s.
   */
  @action(group='write')
  dismissGlobally: member function() js-rhino
}
