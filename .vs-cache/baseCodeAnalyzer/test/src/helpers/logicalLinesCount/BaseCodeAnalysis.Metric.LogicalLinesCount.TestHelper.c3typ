/**
 * Type to store helper functions to test functionality for {@link BaseCodeAnalysis.Metric.LogicalLinesCount}.
 */
type BaseCodeAnalysis.Metric.LogicalLinesCount.TestHelper {
  /**
   * Returns a mock c3typ file content string.
   * @returns a mock c3typ file content string.
   */
  getC3typeFileContent: function(): string js-rhino

  /**
   * Returns a mock js file content string.
   * @returns a mock js file content string.
   */
  getJsFileContent: function(): string js-rhino

  /**
   * Returns a mock py file content string.
   * @returns a mock py file content string.
   */
  getPyFileContent: function(): string js-rhino

  /**
   * Returns a mock tsx file content string.
   * @returns a mock tsx file content string.
   */
  getTsxFileContent: function(): string js-rhino

  /**
   * Returns a mock ts file content string.
   * @returns a mock ts file content string.
   */
  getTsFileContent: function(): string js-rhino

  /**
   * Returns a mock jsx file content string.
   * @returns a mock jsx file content string.
   */
  getJsxFileContent: function(): string js-rhino
}
