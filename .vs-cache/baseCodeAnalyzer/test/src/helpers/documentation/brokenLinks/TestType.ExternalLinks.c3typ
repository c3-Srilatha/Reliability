/**
 * Test Type for broken links with {@link https://www.google.com/}
 */
type TestType.ExternalLinks {

  /**
   * A field with a [URL](https://www.google.com/404)
   */
  fieldA: int

  /**
   * B field with a URL <https://www.google.com/>
   *
   * Here's a raw URL: https://www.google.com
   */
  fieldB: int
}
