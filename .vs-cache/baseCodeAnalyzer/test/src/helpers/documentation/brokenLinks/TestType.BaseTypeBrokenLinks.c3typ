/**
 * Test Type for ensuring broken links on mixins are only reported on the base Type.
 */
type TestType.BaseTypeBrokenLinks {

  /**
   * A field. {@link BaseCodeAnalysiss}
   *
   * @see BaseCodeAnalyzerr
   */
  fieldA: string

  /**
   * B field. [broken link](BaseCodeAnalysis.Metricc)
   *
   * @see #fieldC
   */
  fieldB: string

  /**
   * This is the first overload of `methodA`.
   *
   * @param a
   *           A parameter
   * @return An integer
   *
   * @see BaseCodeqeAnalysis
   */
  methodA: function(a: int): int js-rhino

  /**
   * This is the first overload of `methodB`.
   *
   * @param a
   *           A parameter
   * @return A string
   *
   * @see baseCodeAnalyzer-overvie.c3doc.md
   */
  methodB: function(a: string): string js-rhino
}
