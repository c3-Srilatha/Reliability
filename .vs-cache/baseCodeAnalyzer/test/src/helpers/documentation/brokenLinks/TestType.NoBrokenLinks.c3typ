/**
 * Test Type for broken links. The following links should work:
 * - {@link BaseCodeAnalysis}
 * - {@link BaseCodeAnalysis label}
 * - {@link BaseCodeAnalysis#analyzeCodeWithSpec}
 * - {@link BaseCodeAnalysis#analyzeCodeWithSpec label}
 * - {@link #fieldA}
 * - {@link fieldB}
 * - {@link baseCodeAnalyzer-overview.c3doc.md}
 * - {@link baseCodeAnalyzer-overview.c3doc.md label}
 * - {@link baseCodeAnalyzer-overview.c3doc.md#overview}
 * - {@link baseCodeAnalyzer-overview.c3doc.md#overview label}
 * - {@link baseCodeAnalyzer-overview}
 * - {@link baseCodeAnalyzer-overview label}
 * - {@link baseCodeAnalyzer-overview#overview}
 * - {@link baseCodeAnalyzer-overview#overview label}
 *
 * @see BaseCodeAnalysis
 * @see BaseCodeAnalysis label
 * @see BaseCodeAnalysis#analyzeCodeWithSpec
 * @see BaseCodeAnalysis#analyzeCodeWithSpec label
 * @see #fieldA
 * @see fieldB
 * @see baseCodeAnalyzer-overview.c3doc.md
 * @see baseCodeAnalyzer-overview.c3doc.md label
 * @see baseCodeAnalyzer-overview.c3doc.md#overview
 * @see baseCodeAnalyzer-overview.c3doc.md#overview label
 * @see baseCodeAnalyzer-overview
 * @see baseCodeAnalyzer-overview label
 * @see baseCodeAnalyzer-overview#overview
 * @see baseCodeAnalyzer-overview#overview label
 */
type TestType.NoBrokenLinks {

  /**
   * A field.
   * - [](BaseCodeAnalysis)
   * - [label](BaseCodeAnalysis)
   * - [](BaseCodeAnalysis#analyzeCodeWithSpec)
   * - [label](BaseCodeAnalysis#analyzeCodeWithSpec)
   * - [](#fieldB)
   * - [](fieldC)
   * - [](baseCodeAnalyzer-overview.c3doc.md)
   * - [label](baseCodeAnalyzer-overview.c3doc.md)
   * - [](baseCodeAnalyzer-overview.c3doc.md#overview)
   * - [label](baseCodeAnalyzer-overview.c3doc.md#overview)
   * - [](baseCodeAnalyzer-overview)
   * - [label](baseCodeAnalyzer-overview)
   * - [](baseCodeAnalyzer-overview#overview)
   * - [label](baseCodeAnalyzer-overview#overview)
   */
  fieldA: int

  /**
   * B field. [label](#fieldC) [label](fieldC)
   */
  fieldB: int

  /**
   * C field. #fieldA BaseCodeAnalysis.Metric#filterFileSpecsByExtension
   */
  fieldC: int
}
