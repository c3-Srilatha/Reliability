/**
 * Test Type for broken links. The following links should work:
 *
 * ![alt text](img/test-image.png)
 * {@img img/test-image.png alt text}
 * ![alt text](../../../doc/img/test-image.png)
 * ![alt text](img/test-image.png@24x36)
 */
type TestType.BrokenImageLinks {

  /**
   * A field. These links won't work:
   *
   * ![label](img/fake-image.png)
   * {@img fake/fake-image.png label}
   */
  fieldA: int

  /**
   * B field. This link won't work ![label](fake/fake-image.png)
   */
  fieldB: int
}
