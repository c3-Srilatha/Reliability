/**
 * This Type is used in the test cases for the IncompleteDocumentation metric.
 */
type BaseCodeAnalysis.Metric.IncompleteDocumentation.TestOutOfDate {

  /**
   * Documentation has an extra param
   *
   * @param paramA
   *           First param.
   * @param paramB
   *           Second param.
   * @return The return value.
   */
  funcWithExtraParamDoc: function(paramA: string): string js-server

  /**
   * Documentation has unnecessary return
   *
   * @param paramA
   *           First param.
   * @param paramB
   *           Second param.
   * @return The return value.
   */
  funcWithExtraReturnDoc: function(paramA: string, paramB: string) js-server
}
