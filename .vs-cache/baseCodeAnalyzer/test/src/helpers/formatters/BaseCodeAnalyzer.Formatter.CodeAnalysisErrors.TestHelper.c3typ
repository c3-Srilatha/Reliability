/**
 * Type to store helper functions to test functionality for {@link BaseCodeAnalyzer.Formatter.InvalidAstErrors}.
 */
type BaseCodeAnalyzer.Formatter.CodeAnalysisErrors.TestHelper {
  /**
   * Function to return a mock {@link BaseCodeAnalysis.Result.Processed} to test the formatted result
   * of {@link BaseCodeAnalyzer.Formatter.InvalidAstErrors#summarizeResults}.
   *
   * @returns a set of mock {@link BaseCodeAnalysis.Result.Processed results}.
   */
  getProcessedResults: function(): [BaseCodeAnalysis.Result.Processed] js-rhino

  /**
   * The expected result of the {@link BaseCodeAnalyzer.Formatter.InvalidAstErrors#summarizeResults} test.
   *
   * @returns expected result of the {@link BaseCodeAnalyzer.Formatter.InvalidAstErrors#summarizeResults} test.
   */
  getErrorsExpectedSummarySection: function(): BaseCodeAnalyzer.Formatter.SummarySection js-rhino

  /**
   * The expected result of the {@link BaseCodeAnalyzer.Formatter.InvalidAstErrors#summarizeResults} test,
   * when there are no AST errors.
   *
   * @returns expected result of the {@link BaseCodeAnalyzer.Formatter.InvalidAstErrors#summarizeResults} test.
   */
  getNoErrorsExpectedSummarySection: function(): BaseCodeAnalyzer.Formatter.SummarySection js-rhino
}
