/**
 * Type to store helper functions to test functionality for {@link BaseCodeAnalyzer.Formatter.InvalidAstErrors}.
 */
type BaseCodeAnalyzer.Formatter.InvalidAstErrors.TestHelper {
  /**
   * The expected result of the {@link BaseCodeAnalyzer.Formatter.InvalidAstErrors#summarizeResults} test.
   * This is the expected result if the AST generation errors are raised on both changed and unchanged files.
   *
   * @returns expected result of the {@link BaseCodeAnalyzer.Formatter.InvalidAstErrors#summarizeResults} test.
   */
  getAstErrorsBothExpectedSummarySection: function(): BaseCodeAnalyzer.Formatter.SummarySection js-rhino

  /**
   * The expected result of the {@link BaseCodeAnalyzer.Formatter.InvalidAstErrors#summarizeResults} test.
   * This is the expected result if the AST generation errors are raised only changed files.
   *
   * @returns expected result of the {@link BaseCodeAnalyzer.Formatter.InvalidAstErrors#summarizeResults} test.
   */
  getAstErrorsChangedExpectedSummarySection: function(): BaseCodeAnalyzer.Formatter.SummarySection js-rhino

  /**
   * The expected result of the {@link BaseCodeAnalyzer.Formatter.InvalidAstErrors#summarizeResults} test.
   * This is the expected result if the AST generation errors are raised only unchanged files.
   *
   * @returns expected result of the {@link BaseCodeAnalyzer.Formatter.InvalidAstErrors#summarizeResults} test.
   */
  getAstErrorsUnchangedExpectedSummarySection: function(): BaseCodeAnalyzer.Formatter.SummarySection js-rhino

  /**
   * The expected result of the {@link BaseCodeAnalyzer.Formatter.InvalidAstErrors#summarizeResults} test,
   * when there are no AST errors.
   *
   * @returns expected result of the {@link BaseCodeAnalyzer.Formatter.InvalidAstErrors#summarizeResults} test.
   */
  getNoAstErrorsExpectedSummarySection: function(): BaseCodeAnalyzer.Formatter.SummarySection js-rhino
}
