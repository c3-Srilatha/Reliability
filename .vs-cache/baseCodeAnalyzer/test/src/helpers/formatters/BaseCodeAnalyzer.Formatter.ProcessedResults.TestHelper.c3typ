/**
 * Type to store helper functions to test functionality for {@link BaseCodeAnalyzer.Formatter.ProcessedResults}.
 */
type BaseCodeAnalyzer.Formatter.ProcessedResults.TestHelper {
  /**
   * Function to return a mock {@link BaseCodeAnalysis.Result.Processed} to test the formatted result
   * of {@link BaseCodeAnalyzer.Formatter#getCodeAnalysisSummaryMessage}.
   *
   * @returns a set of mock {@link BaseCodeAnalysis.Result.Processed messages}.
   */
  getMetricChangeMockProcessedResults: function(): [BaseCodeAnalysis.Result.Processed] js-rhino

  /**
   * The expected result of the {@link BaseCodeAnalyzer.Formatter#getCodeAnalysisSummaryMessage} test.
   *
   * @returns expected result of the {@link BaseCodeAnalyzer.Formatter#getCodeAnalysisSummaryMessage} test.
   */
  getMetricChangeExpectedSummarySection: function(): BaseCodeAnalyzer.Formatter.SummarySection js-rhino

  /**
   * Function to return a mock {@link BaseCodeAnalysis.Result.Processed} to test the formatted result
   * of {@link BaseCodeAnalyzer.Formatter#getCodeAnalysisSummaryMessage} when there are no metric results
   * to report, i.e., it's a successful packages results.
   *
   * @returns a set of mock {@link BaseCodeAnalysis.Result.Processed messages}.
   */
  getNoMetricChangeMockProcessedResults: function(): [BaseCodeAnalysis.Result.Processed] js-rhino

  /**
   * The expected result of the {@link BaseCodeAnalyzer.Formatter#getCodeAnalysisSummaryMessage} test.
   * when there are no metric results to report, i.e., it's a successful packages results.
   *
   * @returns expected result of the {@link BaseCodeAnalyzer.Formatter#getCodeAnalysisSummaryMessage} test.
   */
  getNoMetricChangeExpectedSummarySection: function(): BaseCodeAnalyzer.Formatter.SummarySection js-rhino
}
