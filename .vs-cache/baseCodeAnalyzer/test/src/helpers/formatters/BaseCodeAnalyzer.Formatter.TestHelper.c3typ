/**
 * Type to store helper functions to test functionality for {@link BaseCodeAnalyzer.Formatter}.
 */
type BaseCodeAnalyzer.Formatter.TestHelper {
  /**
   * A mock set of summary sections to be passed into the
   * {@link BaseCodeAnalyzer.Formatter#getCodeAnalysisSummaryMessage} function.
   *
   * @returns a set of mock summary sections.
   */
  getSummarySections: function(): [BaseCodeAnalyzer.Formatter.SummarySection] js-rhino

  /**
   * The expected summary message.
   *
   * @returns the expected summary message.
   */
  getExpectedSummaryMessage: function(): string js-rhino

  /**
   * A mock set of anchors to be passed into the
   * {@link BaseCodeAnalyzer.Formatter#getReviewCommentBody} function.
   *
   * @returns a set of mock anchors.
   */
  getReviewCommentBodyAnchors: function(): BaseCodeAnalyzer.SourceControlGadget.Anchors js-rhino

  /**
   * A mock set of previous comments to be passed into the
   * {@link BaseCodeAnalyzer.Formatter#getReviewCommentBody} function.
   *
   * @returns a set of mock processed results.
   */
  getReviewCommentBodyProcessedResults: function(): [BaseCodeAnalysis.Result.Processed] js-rhino

  /**
   * The expected review comment message when there are zero new comments and non-zero (3) previous comments.
   *
   * @returns the expected review comment message.
   */
  getZeroNewAndNonZeroPrevExpectedMsg: function(): string js-rhino

  /**
   * The expected review comment message when there are zero new comments and zero previous comments.
   *
   * @returns the expected review comment message.
   */
  getZeroNewAndPrevExpectedMsg: function(): string js-rhino

  /**
   * The expected review comment message when there are non-zero (5) new comments and non-zero (3) previous comments.
   *
   * @returns the expected review comment message.
   */
  getNonZeroNewAndPrevExpectedMsg: function(): string js-rhino
}
