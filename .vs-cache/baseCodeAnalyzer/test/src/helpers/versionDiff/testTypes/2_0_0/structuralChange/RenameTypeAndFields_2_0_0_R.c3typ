/**
 * This Type is renamed, and several fields are renamed with varying levels of
 * completeness for deprecation.
 */
type RenameTypeAndFields_2_0_0_R {

  /**
   * This field is unchanged.
   */
  sameField: string

  /**
   * (Deprecated field) This field is renamed and properly deprecated with a final
   * version and details.
   */
