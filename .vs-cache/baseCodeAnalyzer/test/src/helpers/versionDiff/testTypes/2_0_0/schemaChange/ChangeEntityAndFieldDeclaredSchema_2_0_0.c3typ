/**
 * Test entity Type whose declared schema name changes.
 */
entity type ChangeEntityAndFieldDeclaredSchema_2_0_0 schema name 'CEAFDS_2_0_0_R' {

  /**
   * The schema name of this field changes.
   */
  changeSchemaName: string schema name 'CSN_R'

  /**
   * The schema name of this field stays the same.
   */
  sameSchemaName: string schema name 'SSN'

  /**
   * The schema suffix of this field changes.
   */
  changeSchemaSuffix: [string] schema suffix 'CSS_R'

  /**
   * The schema suffix of this field stays the same.
   */
  sameSchemaSuffix: [string] schema suffix 'SSS'
}
