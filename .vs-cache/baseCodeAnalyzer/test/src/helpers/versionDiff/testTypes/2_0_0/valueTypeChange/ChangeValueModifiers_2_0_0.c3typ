/**
 * Test Type for {@link ValueModifier} changes.
 */
type ChangeValueModifiers_2_0_0 {

  /**
   * Changed value modifier from optional to non-empty. This field is renamed
   * without proper deprecation.
   */
  renameOriginalOptionalField_R: !string

  /**
   * Changed value modifier from non-empty to optional.
   */
  originalNonEmptyField: string

  /**
   * This field's value modifier is unchanged, but an inherited declaration of
   * this field changes its value modifier.
   */
  changeInheritedField: string

  /**
   * Test function.
   *
   * @return Changed value modifier from optional to non-empty.
   */
  originalOptionalReturnFunc: function(): !string

  /**
   * Test function.
   *
   * @return No change.
   */
  originalNonEmptyReturnFunc: function(): !string

  /**
   * Function to test param value modifier changes.
   *
   * @param originalRequiredParam
   *           No change.
   * @param originalNonOptionalParam
   *           Changed value modifier from non-optional to non-empty.
   * @param originalOptionalParam
   *           Changed value modifier from optional to preserves empty.
   */
  testFunc: function(
    originalRequiredParam: !int,
    originalNonOptionalParam: ![int],
    originalOptionalParam: ?int
  ) js-rhino
}
