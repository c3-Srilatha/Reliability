/**
 * Several optional fields are added to this Type.
 */
type ChangeAddOptionalFields_1_0_0 {

  /**
   * This field stays the same, but a Type that mixes this Type adds an inherited
   * declaration for this field.
   */
  addInheritedField: string

  /**
   * An optional parameter is added to this method.
   */
  addOptionalParam: function() js-rhino
}
