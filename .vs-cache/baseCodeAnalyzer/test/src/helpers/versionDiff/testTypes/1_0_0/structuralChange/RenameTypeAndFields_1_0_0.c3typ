/**
 * This Type is renamed, and several fields are renamed with varying levels of
 * completeness for deprecation.
 */
type RenameTypeAndFields_1_0_0 {

  /**
   * This field is unchanged.
   */
  sameField: string

  /**
   * This field is renamed and properly deprecated with a final version and details.
   */
  renameFieldWithDeprecation: int

  /**
   * This field is renamed and deprecated, but doesn't specify a final version or
   * details.
   */
  renameFieldIncompleteDeprecation: string

  /**
   * This field is renamed without being deprecated.
   */
  renameFieldNoDeprecation: [double]
}
