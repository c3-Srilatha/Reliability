   */
  removePersistableField: string

  /**
   * This non-persistable field is removed, so it shouldn't be flagged by the
   * schema change metric.
   */
  removeNonPersistableField: string not persistable

  /**
   * This (non-stored) calculated field is removed, so it shouldn't be flagged
   * by the schema change metric.
   */
  removeCalcField: string calc removePersistableField

  /**
   * This translated field is removed, so it shouldn't be flagged by the schema
   * change metric.
   */
  removeTranslatedField: string translate by removePersistableField
