/**
 * The declared schema name of some of the fields on this entity Type change, and
 * some fields are removed.
 */
entity type ChangeEntityRenameFieldRemoveFieldDeclaredSchema_1_0_0 schema name 'CERFRFDS_1_0_0' {

  /**
   * This field is renamed, but its schema name stays the same.
   */
  renameFieldSameSchema: string schema name 'RFSS'

  /**
   * The field is renamed and its schema name changes.
   */
