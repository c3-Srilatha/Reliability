   * This function is used to test parsing directives in Python files.
   */
  getExpectedDirectivesForDisableWithMetricPy: function(): [BaseCodeAnalysis.Metric.Directive] js-rhino

  /**
   * Helper function to get an array of expected {@link BaseCodeAnalysis.Metric.Directive}s for
