   * the `c3-analysis-enable` directives with a metric.
   * This function is used to test parsing directives in C3typ files.
   */
  getExpectedDirectivesForEnableWithMetricC3typ: function(): [BaseCodeAnalysis.Metric.Directive] js-rhino

  /**
   * Helper function to get an array of expected {@link BaseCodeAnalysis.Metric.Directive}s for
   * the `c3-analysis-enable` directives without a metric.
   * This function is used to test parsing directives in C3typ files.
   */
  getExpectedDirectivesForEnableWithoutMetricC3typ: function(): [BaseCodeAnalysis.Metric.Directive] js-rhino
