/**
 * **TESTING PURPOSES ONLY**
 *
 * The Type that contains helper functions for testing functions in {@link BaseCodeAnalysis.Metric}.
 */
final type BaseCodeAnalysis.Metric.TestHelper {

  /**
   * Helper function to generate a {@link BaseCodeAnalysis.FileSpec} to test the functionality of
   * parsing directives with invalid labels in JS file.
   */
  getJsFileSpecForInvalidLabels: function(): BaseCodeAnalysis.FileSpec js-rhino

  /**
   * Helper function to generate a {@link BaseCodeAnalysis.FileSpec} to test the functionality of
   * parsing `c3-analysis-disable` directives in JS file.
   */
  getJsFileSpecForDisable: function(): BaseCodeAnalysis.FileSpec js-rhino

  /**
   * Helper function to generate a {@link BaseCodeAnalysis.FileSpec} to test the functionality of
   * parsing `c3-analysis-disable-next-line` directives in JS file.
   */
  getJsFileSpecForDisableNextLine: function(): BaseCodeAnalysis.FileSpec js-rhino

  /**
   * Helper function to generate a {@link BaseCodeAnalysis.FileSpec} to test the functionality of
   * parsing `c3-analysis-enable` directives in JS file.
   */
  getJsFileSpecForEnable: function(): BaseCodeAnalysis.FileSpec js-rhino

  /**
   * Helper function to generate a {@link BaseCodeAnalysis.FileSpec} to test the functionality of
   * parsing directives with invalid labels in Python file.
   */
  getPyFileSpecForInvalidLabels: function(): BaseCodeAnalysis.FileSpec js-rhino

  /**
   * Helper function to generate a {@link BaseCodeAnalysis.FileSpec} to test the functionality of
   * parsing `c3-analysis-disable` directives in Python file.
   */
  getPyFileSpecForDisable: function(): BaseCodeAnalysis.FileSpec js-rhino

  /**
   * Helper function to generate a {@link BaseCodeAnalysis.FileSpec} to test the functionality of
   * parsing `c3-analysis-disable-next-line` directives in Python file.
   */
  getPyFileSpecForDisableNextLine: function(): BaseCodeAnalysis.FileSpec js-rhino

  /**
   * Helper function to generate a {@link BaseCodeAnalysis.FileSpec} to test the functionality of
   * parsing `c3-analysis-enable` directives in Python file.
   */
  getPyFileSpecForEnable: function(): BaseCodeAnalysis.FileSpec js-rhino

  /**
   * Helper function to generate a {@link BaseCodeAnalysis.FileSpec} to test the functionality of
   * parsing directives with invalid labels in C3typ file.
   */
  getC3typFileSpecForInvalidLabels: function(): BaseCodeAnalysis.FileSpec js-rhino

  /**
   * Helper function to generate a {@link BaseCodeAnalysis.FileSpec} to test the functionality of
   * parsing `c3-analysis-disable` directives in C3typ file.
   */
  getC3typFileSpecForDisable: function(): BaseCodeAnalysis.FileSpec js-rhino

  /**
   * Helper function to generate a {@link BaseCodeAnalysis.FileSpec} to test the functionality of
   * parsing `c3-analysis-disable-next-line` directives in C3typ file.
   */
  getC3typFileSpecForDisableNextLine: function(): BaseCodeAnalysis.FileSpec js-rhino

  /**
   * Helper function to generate a {@link BaseCodeAnalysis.FileSpec} to test the functionality of
   * parsing `c3-analysis-enable` directives in C3typ file.
   */
  getC3typFileSpecForEnable: function(): BaseCodeAnalysis.FileSpec js-rhino

  /**
   * Helper function to get an array of expected {@link BaseCodeAnalysis.Metric.Directive}s for
   * the `c3-analysis-disable` directives with a metric.
   * This function is used to test parsing directives in JS files.
   */
  getExpectedDirectivesForDisableWithMetricJs: function(): [BaseCodeAnalysis.Metric.Directive] js-rhino

  /**
   * Helper function to get an array of expected {@link BaseCodeAnalysis.Metric.Directive}s for
   * the `c3-analysis-disable` directives without a metric.
   * This function is used to test parsing directives in JS files.
   */
  getExpectedDirectivesForDisableWithoutMetricJs: function(): [BaseCodeAnalysis.Metric.Directive] js-rhino

  /**
   * Helper function to get an array of expected {@link BaseCodeAnalysis.Metric.Directive}s for
   * the `c3-analysis-disable-next-line` directives with a metric.
   * This function is used to test parsing directives in JS files.
   */
  getExpectedDirectivesForDisableNextLineWithMetricJs: function(): [BaseCodeAnalysis.Metric.Directive] js-rhino

  /**
   * Helper function to get an array of expected {@link BaseCodeAnalysis.Metric.Directive}s for
   * the `c3-analysis-disable-next-line` directives without a metric.
   * This function is used to test parsing directives in JS files.
   */
  getExpectedDirectivesForDisableNextLineWithoutMetricJs: function(): [BaseCodeAnalysis.Metric.Directive] js-rhino

  /**
   * Helper function to get an array of expected {@link BaseCodeAnalysis.Metric.Directive}s for
   * the `c3-analysis-enable` directives with a metric.
   * This function is used to test parsing directives in JS files.
   */
  getExpectedDirectivesForEnableWithMetricJs: function(): [BaseCodeAnalysis.Metric.Directive] js-rhino

  /**
   * Helper function for  to get an array of expected {@link BaseCodeAnalysis.Metric.Directive}s for
   * the `c3-analysis-enable` directives without a metric.
   * This function is used to test parsing directives in JS files.
   */
  getExpectedDirectivesForEnableWithoutMetricJs: function(): [BaseCodeAnalysis.Metric.Directive] js-rhino

  /**
   * Helper function to get an array of expected {@link BaseCodeAnalysis.Metric.Directive}s for
