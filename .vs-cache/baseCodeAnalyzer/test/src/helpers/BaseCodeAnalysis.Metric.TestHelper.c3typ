  /**
   * Helper function to get an array of expected {@link BaseCodeAnalysis.Metric.Directive}s for
   * the `c3-analysis-disable-next-line` directives with a metric.
   * This function is used to test parsing directives in Python files.
   */
  getExpectedDirectivesForDisableNextLineWithMetricPy: function(): [BaseCodeAnalysis.Metric.Directive] js-rhino

  /**
   * Helper function to get an array of expected {@link BaseCodeAnalysis.Metric.Directive}s for
   * the `c3-analysis-disable-next-line` directives without a metric.
   * This function is used to test parsing directives in Python files.
   */
  getExpectedDirectivesForDisableNextLineWithoutMetricPy: function(): [BaseCodeAnalysis.Metric.Directive] js-rhino

  /**
   * Helper function to get an array of expected {@link BaseCodeAnalysis.Metric.Directive}s for
   * the `c3-analysis-enable` directives with a metric.
   * This function is used to test parsing directives in Python files.
   */
  getExpectedDirectivesForEnableWithMetricPy: function(): [BaseCodeAnalysis.Metric.Directive] js-rhino

  /**
   * Helper function to get an array of expected {@link BaseCodeAnalysis.Metric.Directive}s for
   * the `c3-analysis-enable` directives without a metric.
   * This function is used to test parsing directives in Python files.
   */
  getExpectedDirectivesForEnableWithoutMetricPy: function(): [BaseCodeAnalysis.Metric.Directive] js-rhino

  /**
   * Helper function to get an array of expected {@link BaseCodeAnalysis.Metric.Directive}s for
   * the `c3-analysis-disable` directives with a metric.
   * This function is used to test parsing directives in C3typ files.
   */
  getExpectedDirectivesForDisableWithMetricC3typ: function(): [BaseCodeAnalysis.Metric.Directive] js-rhino

  /**
