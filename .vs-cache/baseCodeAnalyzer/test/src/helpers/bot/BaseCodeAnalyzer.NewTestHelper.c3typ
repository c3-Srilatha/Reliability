/**
 * Type to store helper functions to test functionality for {@link BaseCodeAnalyzer}.
 */
type BaseCodeAnalyzer.NewTestHelper {

  /**
   * Returns the code analysis results for the base branch.
   *
   * @returns The code analysis results for the base branch.
   */
  getBaseBranchCodeAnalysisResults: function(): [BaseCodeAnalysis.Result] js-server

  /**
   * Returns the code analysis results for the feature branch.
   *
   * @returns The code analysis results for the feature branch.
   */
  getFeatureBranchCodeAnalysisResults: function(): [BaseCodeAnalysis.Result] js-server

  /**
   * Returns the file specs for the base branch.
   *
   * @returns The file specs for the base branch.
   */
  getBaseBranchFileSpecs: function(): [BaseCodeAnalysis.FileSpec] js-server

  /**
   * Returns the file specs for the feature branch.
   *
   * @returns The file specs for the feature branch.
   */
  getFeatureBranchFileSpecs: function(): [BaseCodeAnalysis.FileSpec] js-server

  /**
   * Returns the file diffs between the base and feature branches.
   *
   * @returns The file diffs between the base and feature branches.
   */
  getFeatureBranchFileDiffs: function(): map<string, BaseCodeAnalyzer.SourceControlGadget.FileDiff> js-server

  /**
   * Returns the processed code analysis results for the base branch.
   *
   * @returns The processed code analysis results for the base branch.
   */
  getProcessedBaseBranchResults: function(): [BaseCodeAnalysis.Result.Processed] js-server

  /**
   * Returns the expected processed code analysis results for the feature branch.
   *
   * @returns The expected processed code analysis results for the feature branch.
   */
  getExpectedProcessedFeatureBranchResults: function(): [BaseCodeAnalysis.Result.Processed] js-server

  /**
   * Returns the expected processed code analysis results for the feature branch when there are no base branch results.
   *
   * @returns The expected processed code analysis results for the feature branch when there are no base branch results.
   */
  getExpectedProcessedFeatureBranchResultsWithNoBaseBranchResults: function(): [BaseCodeAnalysis.Result.Processed] js-server
}
