/**
 * Code analysis metric to verify references to Types, fields, methods, and topics in
 * [.c3typ](FileExt#TYPE) and [.c3doc.md](FileExt#DOC) files.
 *
 * Within the context of this metric, "mark**down**" refers to raw {@link Markdown} content and
 * "mark**up**" refers to {@link DocumentationMarkup} content parsed by {@link DocumentationParser}.
 */
type BaseCodeAnalysis.Metric.BrokenDocumentationLinks mixes BaseCodeAnalysis.Metric js-rhino {

  /**
   * Link to the features documentation for the newest server version.
   */
  DOCUMENTATION_FEATURES_LINK: private const string = 'https://developer.c3.ai/docs/${platformVersion}/topic/documentation-features.md'

  /**
   * Helper function to get all slugs of headings in the provided {@link Markdown} content.
   * A slug is a unique, user-friendly text string that identifies a specific heading in a
   * document. It's derived from the original heading text by:
   *
   * - Trimming leading and trailing whitespace.
   * - Converting all characters to lowercase.
   * - Replacing all spaces with hyphens.
   * - Removing all other whitespace and non-alphanumeric characters.
   * - Suffixing occurrences of duplicate slugs with a hyphen and an auto-incrementing integer.
   *
   * @param content
   *           The markdown content to extract heading slugs from.
   * @return A set of all heading slugs in the content.
   *
   * @see https://docs.github.com/en/get-started/writing-on-github/getting-started-with-writing-and-formatting-on-github/basic-writing-and-formatting-syntax#section-links GitHub Flavored Markdown heading anchors
   */
  getDocHeadingSlugs: private function(content: string serialized Markdown): set<string>

  /**
   * Helper function to get all slugs of headings in [.c3doc.md](FileExt#DOC) files.
   *
   * @return A map of topic file name to a set of all heading slugs for that file.
   *
   * @see getDocHeadingSlugs
   */
  getAllDocHeadingSlugs: private function(): map<string, set<string>>

  /**
   * Enhanced version of {@link Markdown#visit} that invokes `visitor` with a list of all
   * parent nodes of the current node, from the root to the parent of the current node.
   *
   * @param markdown
   *           The markdown content to traverse.
   * @param visitor
   *           Lambda to invoke for each traversed node. If the lambda explicitly returns `false`,
   *           the traversal will not continue into a node's children.
   */
  visitMarkdown: function(
    markdown: Markdown,
    visitor: lambda(node: !MarkdownNode, parents: [!MarkdownNode]): ?boolean
  )

  /**
   * Helper function to recursively traverse through a {@link DocumentationMarkup} node
   * (usually generated by the {@link DocumentationParser}) and invoke the provided
   * `visitor` for each node. If a node is a {@link DocumentationBlock} it will traverse
   * its [spans](DocumentationBlock#spans) and [blocks](DocumentationBlock#blocks) after
   * invoking `visitor`.
   *
   * @param markup
   *           The parsed documentation markup to traverse.
   * @param visitor
   *           Lambda to invoke for each traversed node. If the lambda explicitly returns `false`,
   *           the traversal will not continue into a block's children.
   */
  visitMarkup: function(
    markup: DocumentationMarkup,
    visitor: lambda(node: !DocumentationMarkup): ?boolean
  )

  /**
   * Helper function to search for any broken links in a [.c3doc.md](FileExt#DOC) file.
   *
   * @param fileSpec
   *           The file spec for the `.c3doc.md` file.
   * @param topicNameToHeadingSlugs
   *           The result of #getAllDocHeadingSlugs to use for resolving section heading
   *           references in the document.
   * @return A list of messages for any broken links in the file.
   */
  findBrokenLinksInDocFile: function(
    fileSpec: !BaseCodeAnalysis.FileSpec,
    topicNameToHeadingSlugs: map<string, set<string>>
  ): [BaseCodeAnalysis.Metric.Message]

  /**
   * Helper function to search for any broken links in {@link TypeDocumentation}.
   *
   * @param fileSpec
   *           The file spec for the [.c3typ](FileExt#TYPE) file.
   * @param topicNameToHeadingSlugs
   *           The result of #getAllDocHeadingSlugs to use for resolving section heading
   *           references in the document.
   * @return A list of messages for any broken links in the file.
   */
  findBrokenLinksInTypeFile: function(
    fileSpec: !BaseCodeAnalysis.FileSpec,
    topicNameToHeadingSlugs: map<string, set<string>>
  ): [BaseCodeAnalysis.Metric.Message]

  calculateResults: ~
}
