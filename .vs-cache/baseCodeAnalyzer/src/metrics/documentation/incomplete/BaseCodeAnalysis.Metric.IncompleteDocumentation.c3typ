/**
 * Code analysis metric that checks incomplete documentation in c3typ files
 */
type BaseCodeAnalysis.Metric.IncompleteDocumentation mixes BaseCodeAnalysis.Metric {

  /**
   * Function to identify incomplete documentation errors in a provided {@link BaseCodeAnalysis.FileSpec}.
   *
   * @param typeMetadata
   *           Metadata for the methods defined on the non-remixed type files in the package.
   * @return A list of {@link BaseCodeAnalysis.Metric.Result}s corresponding to incomplete documentation.
   */
  searchForIncompleteDocumentation: inline function(typeMetadata: json): [BaseCodeAnalysis.Metric.Result] js-codeanalysis-node

  calculateResults: ~
}
