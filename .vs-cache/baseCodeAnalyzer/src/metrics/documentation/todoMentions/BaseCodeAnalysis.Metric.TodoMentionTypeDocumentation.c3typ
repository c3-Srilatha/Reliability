/**
 * Code analysis metric to catch mentions to JIRA tickets or TODOs in customer-facing documentation.
 * The correct method to use TODOs in Type files is to place them in a single-line comment using `//`
 * instead of the field/Type JSDoc string.
 */
type BaseCodeAnalysis.Metric.TodoMentionTypeDocumentation mixes BaseCodeAnalysis.Metric {

  /**
   * Function to identify TODO, FIXME or JIRA mentions in Type documentation in a provided line.
   *
   * @param line
   *           The docstring line in which to look for violations.
   * @param lineIdx
   *           The index of the line in the Type file.
   * @return A {@link BaseCodeAnalysis.Metric.Message} if the line includes TODOs, FIXMEs or tickets in
   *         customer-facing documentation.
   */
  searchDocumentationForTodoMentions: private inline function(line: !string, lineIdx: int): BaseCodeAnalysis.Metric.Message js-rhino

  calculateResults: ~
}
