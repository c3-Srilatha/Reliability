/**
 * Code analysis metric that checks missing documentation in c3typ files
 */
type BaseCodeAnalysis.Metric.MissingDocumentation mixes BaseCodeAnalysis.Metric {

  /**
   * Function to identify missing documentation errors in a provided {@link BaseCodeAnalysis.FileSpec}.
   *
   * @param fileSpec
   *           The file spec to search for missing documentation in.
   * @returns a list of {@link BaseCodeAnalysis.Metric.Message}s corresponding to missing documentation.
   */
  searchForMissingDocumentation: private inline function(fileSpec: BaseCodeAnalysis.FileSpec): [BaseCodeAnalysis.Metric.Message] js-rhino

  calculateResults: ~
}
