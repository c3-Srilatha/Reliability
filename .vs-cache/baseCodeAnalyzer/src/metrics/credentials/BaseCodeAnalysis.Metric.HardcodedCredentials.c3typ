/**
 * Code analysis metric that checks hardcoded credentials.
 */
type BaseCodeAnalysis.Metric.HardcodedCredentials mixes BaseCodeAnalysis.Metric {

  /**
   * Function to identify hardcoded credentials in a {@link BaseCodeAnalysis.FileSpec}s based on
   * a list of {@link BaseCodeAnalysis.Metric.HardcodedCredentials.RegexRule enabledRegexRules}.
   *
   * @param fileSpec
   *           The file spec to check hardcoded credentials in.
   * @param enabledRegexRules
   *           The list of enabled regex rules to check for hardcoded credentials against.
   * @returns a list of {@link BaseCodeAnalysis.Metric.Message} raised for hardcoded credentials.
   */
  searchHardcodedCredentials: private inline function(fileSpec: BaseCodeAnalysis.FileSpec,
                                                      enabledRegexRules: [BaseCodeAnalysis.Metric.HardcodedCredentials.RegexRule]): [BaseCodeAnalysis.Metric.Message] js-server

  /**
   * Function to identify hardcoded credentials and return {@link BaseCodeAnalysis.Result}s.
   *
   * @param fileSpecs
   *           The file specifications for code analysis.
   * @param options
   *           The options to pass to the metric computation.
   */
  calculateResults: ~
}
