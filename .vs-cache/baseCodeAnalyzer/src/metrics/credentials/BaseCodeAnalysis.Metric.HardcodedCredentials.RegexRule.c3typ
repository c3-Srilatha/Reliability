/**
 * The entity that represents the rule for detecting hardcoded credentials.
 * The rules in seed data, gitleaks-rules.json are imported from
 * https://github.com/gitleaks/gitleaks/blob/master/config/gitleaks.toml.
 * All rules in custom-rules.json are created by C3.
 */
entity type BaseCodeAnalysis.Metric.HardcodedCredentials.RegexRule mixes SeedData {

  /**
   * The unique identifier of the rule.
   */
  id: string

  /**
   * The description of the rule to construct the message.
   */
  description: string

  /**
   * The regex to detect the hardcoded credentials.
   */
  regex: string

  /**
   * These modifiers are applied to the regex in addition to the default modifiers 'd' and 'm'.
   * Additional modifiers like 'i' can be added to the regex to make it case-insensitive as
   * JavaScript regex does not support inline modifiers.
   */
  modifiers: string

  /**
   * Configuration to enable/disable the rule.
   */
  enabled: boolean
}
