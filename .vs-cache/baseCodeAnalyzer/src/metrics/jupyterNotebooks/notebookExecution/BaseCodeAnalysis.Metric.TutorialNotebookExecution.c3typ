/**
 * Code analysis metric that checks the execution order on Jupyter tutorial notebook code blocks.
 * All tutorial notebook cells must be executed in order starting from 1 to serve as a clean,
 * professional training resource for customers.
 */
type BaseCodeAnalysis.Metric.TutorialNotebookExecution mixes BaseCodeAnalysis.Metric {

  calculateResults: ~
}
