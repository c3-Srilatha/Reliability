/**
 * The Type that contains information a metric violation that has been suppressed.
 */
type BaseCodeAnalysis.Metric.SuppressedMessage mixes BaseCodeAnalysis.Metric.Message {

  /**
   * The reason for the error being suppressed.
   */
  reason: string

  /**
   * The kind of suppression.
   */
  kind: !string enum BaseCodeAnalysis.Metric.SuppressedMessage.Kind
}
