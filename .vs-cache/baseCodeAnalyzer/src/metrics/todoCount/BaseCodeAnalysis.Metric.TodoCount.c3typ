/**
 * Code analysis metric that identifies FIXMEs and TODOs with a missing ticket number.
 */
type BaseCodeAnalysis.Metric.TodoCount mixes BaseCodeAnalysis.Metric {

  calculateResults: ~

  /**
   * Function that search js comment string for FIXMEs and TODOs with missing tickets in comment strings.
   *
   * @param line
   *           The line to search for unticketed FIXMEs/TODOs in.
   * @param lineNumber
   *           The line number associated with this line.
   * @param includeCommentIdentifier
   *           Boolean to indicate whether the regex should check for comment string identifiers.
   * @return A message is this line includes a FIXME or unticketed TODO. Null otherwise.
   */
  searchJsDocForTodos: inline function(line: string, lineNumber: int, includeCommentIdentifier: boolean): BaseCodeAnalysis.Metric.Message js-codeanalysis-node

  /**
   * Function that traverses ECMAScript files to search for FIXMEs and un-ticketed TODOs
   * in the comment strings.
   *
   * @param fileSpecs
   *           The file specs to search for FIXMEs and un-ticketed TODOs in.
   * @return The results of the metric computation.
   */
  searchJsFileTodos: inline function(fileSpecs: [BaseCodeAnalysis.FileSpec]): [BaseCodeAnalysis.Metric.Result] js-codeanalysis-node

  /**
   * Function that traverses C3 Type files to search for FIXMEs and un-ticketed TODOs
   * in the comment strings.
   *
   * @param fileSpecs
   *           The file specs to search for FIXMEs and un-ticketed TODOs in.
   * @return The results of the metric computation.
   */
  searchTypeFiles: inline function(fileSpecs: [BaseCodeAnalysis.FileSpec]): [BaseCodeAnalysis.Metric.Result] js-codeanalysis-node

  /**
   * Function that traverses Python files to search for FIXMEs and un-ticketed TODOs
   * in the comment strings.
   *
   * @param fileSpecs
   *           The file specs to search for FIXMEs and un-ticketed TODOs in.
   * @return The results of the metric computation.
   */
  searchPyFileTodos: inline function(fileSpecs: [BaseCodeAnalysis.FileSpec]): [BaseCodeAnalysis.Metric.Result] py-codeanalysis
}
