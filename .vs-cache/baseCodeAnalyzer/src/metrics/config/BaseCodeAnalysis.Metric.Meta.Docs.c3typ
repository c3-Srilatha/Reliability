/**
 * All documentation information for a particular {@link BaseCodeAnalysis.Metric}.
 */
type BaseCodeAnalysis.Metric.Meta.Docs {

  /**
   * The full length display name of this metric.
   */
  description: !string

  /**
   * A link to the documentation topic for this metric.
   */
  url: string serialized Url
}
