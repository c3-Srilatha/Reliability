/**
 * This Type represents configurations for certain behaviors of {@link BaseCodeAnalysis}
 * that can change depending on the environment it's run in.
 *
 * @see BaseCodeAnalysis.Metric.Config
 * @see BaseCodeAnalysis.Metric.Meta
 */
type BaseCodeAnalysis.Config mixes BaseCodeAnalysis.ConfigBase, Metadata, Named {

  /**
   * Optional overrides for these configurations. If a [file](BaseCodeAnalysis.FileSpec#filePkgPathUrl)
   * matches multiple overrides, the last match in the list will be used.
   *
   * You can use `GlobPattern.make('<pattern>').isMatch('<pkgPath>')` to test if a file
   * matches a pattern.
   */
  overrides: [!BaseCodeAnalysis.Config.Override]

  /**
   * Function to generate the correct configurations for a given {@link Pkg.Path}. If
   * the path matches any patterns in the #overrides, the matched configs are deep merged
   * (using {@link Jsn#merge}) with the existing configurations. If multiple overrides
   * match, they're applied in order such that the last matching override takes precedence.
   *
   * @param pkgPath
   *           The full path of the file to resolve configurations for.
   * @return The resolved configuration for the given path.
   */
  resolveConfigForFile: inline member function(pkgPath: !string serialized Pkg.Path): BaseCodeAnalysis.Config js-rhino

  /**
   * Function to generate the correct configurations for a given {@link Pkg.Path}. If
   * the path matches any patterns in the #overrides, the matched configs are deep merged
   * (using {@link Jsn#merge}) with the existing configurations. If multiple overrides
   * match, they're applied in order such that the last matching override takes precedence.
   *
   * @param pkgPath
   *           The full path of the file to resolve configurations for.
   * @return The resolved configuration for the given path.
   */
  resolvedMetricConfigForFile: inline member function(
    pkgPath: !string serialized Pkg.Path,
    metricCode: !string serialized BaseCodeAnalysis.Metric.Code
  ): BaseCodeAnalysis.Metric.Config js-rhino
}
