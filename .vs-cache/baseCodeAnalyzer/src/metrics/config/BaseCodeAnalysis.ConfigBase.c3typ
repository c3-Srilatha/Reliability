/**
 * Base Type for {@link BaseCodeAnalysis.Config}. The fields on this Type can be set in either the
 * [top-level config](BaseCodeAnalysis.Config) or in an [override](BaseCodeAnalysis.Config.Override).
 */
type BaseCodeAnalysis.ConfigBase {

  /**
   * A map of metric codes to their configurations. If a configuration is not provided, the
   * [metric's default config](BaseCodeAnalysis.Metric.Meta#defaultConfig) will be used.
   */
  metricConfigs: map<string enum BaseCodeAnalysis.Metric.BaseCode, !BaseCodeAnalysis.Metric.Config>

  /**
   * A map of version diff metric codes to their configurations. If a configuration isn't
   * provided, the [metric's default config](BaseCodeAnalysis.Metric.Meta#defaultConfig)
   * will be used.
   */
  versionDiffMetricConfigs: map<string enum BaseCodeAnalysis.VersionDiff.Metric.Code, !BaseCodeAnalysis.VersionDiff.Metric.Config>
}
