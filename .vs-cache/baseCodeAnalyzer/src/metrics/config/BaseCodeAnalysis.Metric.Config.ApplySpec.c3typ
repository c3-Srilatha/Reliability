/**
 * Spec to apply a {@link BaseCodeAnalysis.Metric.Config} to code analysis messages.
 */
private type BaseCodeAnalysis.Metric.Config.ApplySpec mixes Spec {

  /**
   * The messages to apply the configuration to. JSON objects are supported as an input Type since metric messages
   * are stored as untyped JSON objected on the code analytics dashboard.
   */
  messages: [json] | [BaseCodeAnalysis.Metric.Message]

  /**
   * The metric code to apply the configuration to.
   */
  metricCode: !string enum BaseCodeAnalysis.Metric.Code

  /**
   * The {@link BaseCodeAnalysis.Metric.Config} to apply.
   */
  metricConfig: BaseCodeAnalysis.Metric.Config
}
