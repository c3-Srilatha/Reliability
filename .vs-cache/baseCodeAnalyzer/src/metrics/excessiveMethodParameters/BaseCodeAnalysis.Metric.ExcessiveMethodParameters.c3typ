/**
 * Code analysis metric that checks if any of the fields on a Type has a large number of function parameters.
 */
type BaseCodeAnalysis.Metric.ExcessiveMethodParameters mixes BaseCodeAnalysis.Metric {

  /**
   * Function to identify if any fields in a provided {@link BaseCodeAnalysis.FileSpec} have a
   * large number of function parameters.
   *
   * @param fileSpec
   *           The file spec to search for excessive method parameters.
   * @returns a list of {@link BaseCodeAnalysis.Metric.Message}s corresponding to excessive method parameters.
   */
  searchForExcessiveMethodParameters: private inline function(fileSpec: BaseCodeAnalysis.FileSpec): [BaseCodeAnalysis.Metric.Message] js-server

  calculateResults: ~
}
