/**
 * Code analysis metric that counts the logical lines of code in file with the following extensions:
 * ['js', 'jsx', 'ts', 'tsx', 'py']
 */
type BaseCodeAnalysis.Metric.LogicalLinesCount mixes BaseCodeAnalysis.Metric {

  calculateResults: ~

  /**
   * Nodejs function to compute the logical lines of code for js, jsx, ts, tsx and python files and
   * return {@link BaseCodeAnalysis.Result}s. This function runs in the nodejs environment and is
   * used by the #calculateResults function.
   *
   * @param fileSpecs
   *           The file specifications to get the logical lines of codes for. Files that don't have
   *           one of the following extensions are ignored: ['js', 'jsx', 'ts', 'tsx', 'py']
   * @return The results providing the logical lines of code each file.
   */
  countLogicalLines: function(fileSpecs: [BaseCodeAnalysis.FileSpec]): [BaseCodeAnalysis.Metric.Result] js-codeanalysis-node
}
