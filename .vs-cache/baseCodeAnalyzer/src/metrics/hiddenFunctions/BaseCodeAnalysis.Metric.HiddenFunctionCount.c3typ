/**
 * Code analysis metric that hidden functions in implementation files. A function is defined as "hidden"
 * if it is not declared on the c3typ file.
 */
type BaseCodeAnalysis.Metric.HiddenFunctionCount mixes BaseCodeAnalysis.Metric {

  calculateResults: ~

  /**
   * Function that traverses ECMAScript files to search for hidden functions and raises warnings
   * when they are not.
   *
   * @param fileSpecs
   *           The file specs to search for hidden functions in.
   * @param functionDeclaredOnTypes
   *           A map of a Type name to the list of functions declared on that type.
   * @return The results of the metric computation.
   */
  searchJsHiddenFunctions: inline function(fileSpecs: [BaseCodeAnalysis.FileSpec],
                                           functionDeclaredOnTypes: map<string, [string]>): [BaseCodeAnalysis.Metric.Result] js-codeanalysis-node

  /**
   * Function that traverses Python files to search for hidden functions and raises warnings
   * when they are not.
   *
   * @param fileSpecs
   *           The file specs to search for hidden functions in.
   * @param functionDeclaredOnTypes
   *           A map of a Type name to the list of functions declared on that type.
   * @return The results of the metric computation.
   */
  searchPyHiddenFunctions: inline function(fileSpecs: [BaseCodeAnalysis.FileSpec],
                                           functionDeclaredOnTypes: map<string, [string]>): [BaseCodeAnalysis.Metric.Result] py-codeanalysis
}
