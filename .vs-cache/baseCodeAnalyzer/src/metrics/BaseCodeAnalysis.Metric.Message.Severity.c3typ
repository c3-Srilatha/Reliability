/**
 * Severity level indication of a {@link BaseCodeAnalysis.Metric.Message}
 */
enum type BaseCodeAnalysis.Metric.Message.Severity {

  /**
   * Indication of a warning-level code analysis metric message.
   */
  WARNING = 'warning'

  /**
   * Indication of an error-level code analysis metric message.
   */
  ERROR = 'error'

  /**
   * Indication of a suggestion-level code analysis metric message.
   *
   *   - There's a potential error or warning but it can't be verified programmatically.
   *   - There's room for improvement for a certain metric, but it's fine if kept as-is.
   */
  SUGGESTION = 'suggestion'
}
