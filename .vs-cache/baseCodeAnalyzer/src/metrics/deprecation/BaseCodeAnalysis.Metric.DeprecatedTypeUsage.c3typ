/**
 * Code analysis metric that identifies deprecated Type usage.
 */
type BaseCodeAnalysis.Metric.DeprecatedTypeUsage mixes BaseCodeAnalysis.Metric {

  /**
   * Function that traverses ASTs and finds deprecated Types in js files.
   *
   * @param deprecatedTypes
   *           The list of deprecated Types to look for.
   * @param fileSpecs
   *           The file specifications for code analysis.
   * @return The results of the metric computation.
   */
  jsDeprecatedTypeUsage: private function(deprecatedTypes: [json], fileSpecs: [BaseCodeAnalysis.FileSpec]): [BaseCodeAnalysis.Metric.Result] js-codeanalysis-node

  /**
   * Function that traverses ASTs and finds deprecated Types in py files.
   *
   * @param deprecatedTypes
   *           The list of deprecated Types to look for.
   * @param fileSpecs
   *           The file specifications for code analysis.
   * @return The results of the metric computation.
   */
  pyDeprecatedTypeUsage: private function(deprecatedTypes: [json], fileSpecs: [BaseCodeAnalysis.FileSpec]): [BaseCodeAnalysis.Metric.Result] py-codeanalysis

  calculateResults: ~
}
