/**
 * Code analysis metric that identifies invocations of the `fetch` function with a limit of -1.
 * This is known to cause PSR issues in production environments with large amounts of data.
 */
type BaseCodeAnalysis.Metric.PsrFetchLimit mixes BaseCodeAnalysis.Metric {

  calculateResults: ~

  /**
   * Function that traverses ECMAScript files to search for invocations to `fetch` calls with limit set to -1
   * and generates an error message if any are found.
   *
   * @param fileSpecs
   *           The file specs to search for `fetch` calls with limit set to -1.
   * @return The results of the metric computation.
   */
  searchJsForUnlimitedFetch: inline function(fileSpecs: [BaseCodeAnalysis.FileSpec]): [BaseCodeAnalysis.Metric.Result] js-codeanalysis-node

  /**
   * Function that traverses Python files to search for invocations to `fetch` calls with limit set to -1
   * and generates an error message if any are found.
   *
   * @param fileSpecs
   *           The file specs to search for `fetch` calls with limit set to -1.
   * @return The results of the metric computation.
   */
  searchPyForUnlimitedFetch: inline function(fileSpecs: [BaseCodeAnalysis.FileSpec]): [BaseCodeAnalysis.Metric.Result] py-codeanalysis
}
