/**
 * Code analysis metric that checks for any `time.sleep()` calls on a python file.
 */
type BaseCodeAnalysis.Metric.SleepCall mixes BaseCodeAnalysis.Metric {

  calculateResults: ~

  /**
   * Function that traverses Python files to search for any `time.sleep()` commands.
   * and generates an error message if any are found.
   *
   * @param fileSpecs
   *           The file specs to search for `time.sleep()` commands.
   * @return The results of the metric computation.
   */
  searchPyForThreadSleep: inline function(fileSpecs: [BaseCodeAnalysis.FileSpec]): [BaseCodeAnalysis.Metric.Result] py-codeanalysis

  /**
   * Function that traverses ECMAScript files to search for any {@link Thread#sleep} commands.
   * and generates an error message if any are found.
   *
   * @param fileSpecs
   *           The file specs to search for {@link Thread#sleep} commands.
   * @return The results of the metric computation.
   */
  searchJsForThreadSleep: inline function(fileSpecs: [BaseCodeAnalysis.FileSpec]): [BaseCodeAnalysis.Metric.Result] js-codeanalysis-node
}
