/**
 * Code analysis metric that checks for any unsafe invocations of the `clearCollection` call
 */
type BaseCodeAnalysis.Metric.PsrClearCollection mixes BaseCodeAnalysis.Metric {

  calculateResults: ~

  /**
   * Function that traverses ECMAScript files to search for invocations to `clearCollection` commands.
   * and generates an error message if any are found.
   *
   * @param fileSpecs
   *           The file specs to search for `clearCollection` commands.
   * @return The results of the metric computation.
   */
  searchJsForClearCollection: inline function(fileSpecs: [BaseCodeAnalysis.FileSpec]): [BaseCodeAnalysis.Metric.Result] js-codeanalysis-node

  /**
   * Function that traverses Python files to search for invocations to `clearCollection` commands.
   * and generates an error message if any are found.
   *
   * @param fileSpecs
   *           The file specs to search for `clearCollection` commands.
   * @return The results of the metric computation.
   */
  searchPyForClearCollection: inline function(fileSpecs: [BaseCodeAnalysis.FileSpec]): [BaseCodeAnalysis.Metric.Result] py-codeanalysis
}
