/**
 * Enumeration of {@link BaseCodeAnalysis.Result} kinds.
 */
enum type BaseCodeAnalysis.Result.Kind {

  /**
   * File-level code analysis result.
   */
  FILE = 'file'

  /**
   * Package-level code analysis result, which is the aggregation of all file-level ones.
   */
  PACKAGE = 'package'
}
