/**
 * Configuration object passed to {@link BaseCodeAnalysis#analyzeCodeWithSpec} to indicate which
 * file to analyze.
 */
type BaseCodeAnalysis.FileSpec mixes Spec {

  /**
   * The full path for the file in the server's filesystem.
   */
  filePkgPathUrl: !string

  /**
   * If this file is associated with a C3 Type (e.g., JavaScript code, JSON content, Type DSL, etc.)
   * then the name of that Type.
   */
  targetType: string

  /**
   * The raw content of the file.
   */
  content: string

  /**
   * The parsed AST of the file.
   */
  ast: json

  /**
   * The parsed variable assignments of the file.
   */
  variableAssignments: json
}
