/**
 * Enum type for the list of display names for the metrics being evaluated in {@link BaseCodeAnalysis}. This list
 * includes names for both {@link BaseCodeAnalysis.Metric}s and {@link BaseCodeAnalysis.VersionDiff.Metric}s.
 */
// TODO: ENGR-23346 Remove this Type in version 13
@deprecated(finalVersion='13', details='Use {@link BaseCodeAnalysis.Metric.Code} instead.')
enum type BaseCodeAnalysis.Metric.Name {

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.MissingDocumentation}.
   */
  MISSING_DOCS = 'Missing Documentation'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.IncompleteDocumentation}.
   */
  INCOMPLETE_METHOD_DOCS = 'Incomplete Method Documentation'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.TodoMentionTypeDocumentation}.
   */
  TODO_MENTION_TYPE_DOCS = 'TODO Mentions in Type Documentation'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.MissingPackageOverview}.
   */
  MISSING_PKG_OVERVIEW = 'Missing/Multiple Package Overview(s)'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.HardcodedCredentials}.
   */
  HARDCODED_CREDENTIALS = 'Hardcoded Credentials'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.ExpiredDeprecations}.
   */
  EXPIRED_DEPRECATIONS = 'Expired Deprecations'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.DeprecatedTypeUsage}.
   */
  DEPRECATIONS_USAGE = 'Deprecated Type Usage'

  /**
   * The metric name for the ES {@link BaseCodeAnalysis.Metric.Linter}.
   */
  ESLINT = 'ESLint'

  /**
   * The metric name for the Python {@link BaseCodeAnalysis.Metric.Linter}.
   */
  PYTHON_LINT = 'Python Lint'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.LogicalLinesCount}.
   */
  LOGICAL_LINES = 'Logical Lines of Code'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.TodoCount}.
   */
  TODO_FIXME_COUNT = 'Un-ticketed TODOs / FIXMEs'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.HiddenFunctionCount}.
   */
  HIDDEN_FUNCTION = 'Hidden Functions'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.TicketMentionCount}.
   */
  TICKET_MENTION_COUNT = 'Ticket Mention Count'

  /**
   * Catch-all for errors encountered during code analysis.
   */
  ANALYSIS_ERROR = 'Code Analysis Error'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.TypeCount}.
   */
  TYPE_COUNT = 'Type Count'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.FieldCount}.
   */
  FIELD_COUNT = 'Field Count'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.PsrRemoveAll}.
   */
  PSR_REMOVE_ALL = 'PSR Anti-pattern: Un-filtered `removeAll` call'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.PsrFetchLimit}.
   */
  PSR_FETCH_LIMIT = 'PSR Anti-pattern: Un-limited `fetch` call'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.PsrLoopSingleDbWrite}.
   */
  PSR_LOOP_SINGLE_DB_WRITE = 'PSR Anti-pattern: Single database write in a loop'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.CanonicalTestCoverage}.
   */
  CANONICAL_TEST_COVERAGE = 'Canonical Test Coverage'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.PsrKvStoreCalcField}.
   */
  PSR_KV_STORED_CALC_FIELDS = 'PSR Anti-Pattern: Stored calc field on key-value Type'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.PsrClearCollection}.
   */
  PSR_CLEAR_COLLECTION = 'PSR Anti-pattern: Unsafe invocation of `clearCollection` call'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.ExcessiveMethodParameters}.
   */
  EXCESSIVE_METHOD_PARAMETERS = 'Extensibility Anti-Pattern: Too many method parameters'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.BrokenDocumentationLinks}.
   */
  BROKEN_DOCUMENTATION_LINKS = 'Broken Documentation Links'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.SleepCall}.
   */
  PSR_SLEEP_CALL = 'PSR Anti-Pattern: time.sleep() or Thread.sleep() Call'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.NotebookCount}.
   */
  JUPYTER_NOTEBOOK_COUNT = 'Jupyter Notebook Count'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.TutorialNotebookCount}.
   */
  TUTORIAL_NOTEBOOK_COUNT = 'Tutorial Notebook Count'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.TutorialNotebookExecution}.
   */
  TUTORIAL_NOTEBOOK_EXECUTION = 'Tutorial Notebook Execution'

  /**
   * The metric name for {@link BaseCodeAnalysis.Metric.OrphanedDocumentation}.
   */
  ORPHANED_DOCUMENTATION = 'Orphaned Documentation'

  /* ----------------- BaseCodeAnalysis.VersionDiff.Metric ----------------- */

  /**
   * The display name for {@link BaseCodeAnalysis.VersionDiff.Metric.Addition}.
   */
  ADDITION = 'Added Type, Field, Method, or Method Param'

  /**
   * The display name for {@link BaseCodeAnalysis.VersionDiff.Metric.Removal}.
   */
  REMOVAL = 'Backward-Incompatible Change: Removed Type, Field, Method, or Method Param'

  /**
   * The display name for {@link BaseCodeAnalysis.VersionDiff.Metric.Rename}.
   */
  RENAME = 'Backward-Incompatible Change: Renamed Type, Field, Method, or Method Param'

  /**
   * The display name for {@link BaseCodeAnalysis.VersionDiff.Metric.Deprecation}.
   */
  DEPRECATION = 'Deprecated Type, Field, or Method'

  /**
   * The display name for {@link BaseCodeAnalysis.VersionDiff.Metric.SchemaChange}.
   */
  SCHEMA_CHANGE = 'Backward-Incompatible Change: Changed `schema name` / `type key` / `schema suffix`'

  /**
   * The display name for {@link BaseCodeAnalysis.VersionDiff.Metric.ValueTypeChange}.
   */
  VALUE_TYPE_CHANGE = 'Backward-Incompatible Change: Value Type Change'

  /**
   * The display name for {@link BaseCodeAnalysis.VersionDiff.Metric.ValueModifierChange}.
   */
  VALUE_MODIFIER_CHANGE = 'Backward-Incompatible Change: Value Modifier Change'
}
