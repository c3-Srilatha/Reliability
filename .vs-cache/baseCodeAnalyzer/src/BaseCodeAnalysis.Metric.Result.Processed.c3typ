/**
 * The processed code analysis results to extract the impact of changes made in the build for which
 * code analysis was run.
 */
type BaseCodeAnalysis.Metric.Result.Processed mixes BaseCodeAnalysis.Metric.Result {

  /**
   * The metric stats as computed in the base branch.
   */
  baseBranchStats: BaseCodeAnalysis.Metric.Result.Stats

  /**
   * The delta between the metric stats in the base branch and current branch.
   */
  deltaStats: !BaseCodeAnalysis.Metric.Result.Stats

  /**
   * The {@link BaseCodeAnalysis.Metric.Message.Processed}s associated with this code analysis result.
   * Only includes the subset of {@link #codeAnalysisMetricMessages} that are applicable to the
   * changes made in the build for which code analysis was run.
   */
  processedMetricMessages: [BaseCodeAnalysis.Metric.Message.Processed]
}
