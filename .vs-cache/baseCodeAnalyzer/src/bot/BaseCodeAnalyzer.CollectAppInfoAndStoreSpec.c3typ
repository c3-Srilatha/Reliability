/**
 * @inheritdoc BaseCodeAnalyzer.CollectAppInfoSpec
 *
 * This Type also contains additional configurations for storing the collected
 * {@link BaseCodeAnalysis.AppInfo} in a centralized repository.
 */
type BaseCodeAnalyzer.CollectAppInfoAndStoreSpec mixes BaseCodeAnalyzer.CollectAppInfoSpec {

  /**
   * Source control gadget used to store the collected {@link BaseCodeAnalysis.AppInfo}.
   */
  platformRestInst: !GitHub
}
