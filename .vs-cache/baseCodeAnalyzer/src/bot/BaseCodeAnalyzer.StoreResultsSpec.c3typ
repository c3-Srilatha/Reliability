/**
 * Base Type that represents the structure of the results to be stored in the centralized repository.
 */
private type BaseCodeAnalyzer.StoreResultsSpec mixes Spec {

  /**
   * The source control gadget to use for storing results in a centralized repository.
   */
  gadget: !BaseCodeAnalyzer.GitHubGadget

  /**
   * The code analysis results to push to the centralized repository.
   */
  codeAnalysisResults: [json]

  /**
   * The code analysis step duration results to store for performance regression analysis.
   */
  codeAnalysisStepsWithDuration: json

  /**
   * The build configurations tracked for assessing the integrity of code analysis and code coverage results.
   */
  buildConfigurations: json

  /**
   * The JSON file contents of the `.c3standardsrc` file in this repository. This information is stored track the
   * whether the repository's Release Management infrastructure is up to date.
   */
  c3standardsrc: json
}
