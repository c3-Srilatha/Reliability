/**
 * Type to store code coverage results for a package.
 */
private type BaseCodeAnalysis.CodeCoverage.Result mixes BaseCodeAnalysis.CodeCoverage.Metadata {

  /**
   * The code coverage summary for the package. This includes a results in the following format:
   * ```json
   * {
   *   "total": {
   *     <aggregate results across all file types>
   *   },
   *   JS: {
   *     filesBelow80: [<file coverage results for JS files with less than 80% coverage>],
   *     statistics: <aggregate statistics for all JS files>,
   *     },
   *   PY: {
   *     filesBelow80: [<file coverage results for PY files with less than 80% coverage>],
   *     statistics: <aggregate statistics for all PY files>,
   *   },
   *   UI: {
   *     filesBelow80: [<file coverage results for UI files with less than 80% coverage>],
   *     statistics: <aggregate statistics for all UI files>,
   *   },
   * }
   * ```
   */
  codeCoverageSummary: json
}
