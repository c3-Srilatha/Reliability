/**
 * Type to store code coverage metadata for a package. This includes the following:
 * - The code coverage instrumentation spec to monitor which file paths are being excluded.
 * - The list of files being excluded under those paths in the current package.
 */
private type BaseCodeAnalysis.CodeCoverage.Metadata mixes Result {

  /**
   * The {@link CodeCoverageInstrumentationSpec} applied to the package.
   */
  codeCoverageInstrumentationSpec: CodeCoverageInstrumentationSpec

  /**
   * The list of file paths that are excluded from code coverage. As of 8.7 Platform, this is only applied to
   * `js-server` or `js-rhino` files that match a path regex in {@link CodeCoverageInstrumentationSpec#excludePaths}.
   */
  excludedFilePaths: [string]
}
