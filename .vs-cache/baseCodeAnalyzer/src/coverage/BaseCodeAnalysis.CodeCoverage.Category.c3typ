/**
 * Enum to represent the code coverage category.
 */
private enum type BaseCodeAnalysis.CodeCoverage.Category {

  /**
   * Category for code coverage results corresponding to `js-rhino` / `js-server` files.
   */
  JS

  /**
   * Category for code coverage results corresponding to `py` files that run in the py4j or jep runtimes.
   * Note that code coverage needs to be enabled explicitly for the py4j and jep runtimes separately.
   */
  PY

  /**
   * Category for code coverage results corresponding to UI files. This includes files of the following extensions:
   * - `ts`
   * - `tsx`
   * - `jsx`
   */
  UI
}
