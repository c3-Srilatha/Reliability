/**
 * A REST API that serves resources for code analysis.
 */
@restful(endpoint='codeanalysis-resources')
type BaseCodeAnalysis.ResourceRestApi {

  /**
   * Returns the ESLint plugin tarball.
   * Note that the subpath should contain "npm-modules" to bypass authentication; otherwise, the
   * npm module will not be downloaded in the node runtime.
   */
  @restful(subPath='npm-modules/:fileName')
  downloadNodeModule: function(fileName: string): !ContentValue js-server
}
