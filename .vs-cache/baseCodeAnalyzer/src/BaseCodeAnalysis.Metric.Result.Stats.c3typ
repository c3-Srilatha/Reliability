/**
 * Type to store the aggregated statistics to be reported for a {@link BaseCodeAnalysis.Metric.Result}.
 * This type enables metric results to return a more granular breakdown of values based on severity.
 */
type BaseCodeAnalysis.Metric.Result.Stats {

  /**
   * The number of errors in the metric result.
   */
  errorCount: !int = 0

  /**
   * The number of warnings in the metric result.
   */
  warningCount: !int = 0

  /**
   * The number of suggestions in the metric result.
   */
  suggestionCount: !int = 0

  /**
   * The informational value being returned by the metric result. This could be used to present information
   * for metrics that are computing non-code quality violations like "lines of code" etc.
   */
  value: !double = 0

  /**
   * The number of suppressed errors in the metric result.
   */
  suppressedErrorCount: int = 0

  /**
   * The number of suppressed warnings in the metric result.
   */
  suppressedWarningCount: int = 0

  /**
   * The number of suppressed suggestions in the metric result.
   */
  suppressedSuggestionCount: int = 0

  /**
   * The informational value being returned by the metric result that is suppressed.
   */
  suppressedValue: double = 0

  /**
   * Function to add values for two {@link BaseCodeAnalysis.Metric.Result.Stats} objects.
   *
   * @param stats1
   *           The first stats obj operand.
   * @param stats2
   *           The second stats obj operand. If missing, all values are treated as 0.
   * @returns a {@link BaseCodeAnalysis.Metric.Result.Stats} object that has the added results.
   */
  add: inline function(stats1: !BaseCodeAnalysis.Metric.Result.Stats,
                       stats2: BaseCodeAnalysis.Metric.Result.Stats): BaseCodeAnalysis.Metric.Result.Stats js-rhino

  /**
   * Function to subtract values for two {@link BaseCodeAnalysis.Metric.Result.Stats} objects.
   *
   * @param stats1
   *           The first stats obj operand.
   * @param stats2
   *           The second stats obj operand. If missing, all values are treated as 0.
   * @returns a {@link BaseCodeAnalysis.Metric.Result.Stats} object that has the subtracted results.
   */
  subtract: inline function(stats1: !BaseCodeAnalysis.Metric.Result.Stats,
                            stats2: BaseCodeAnalysis.Metric.Result.Stats): BaseCodeAnalysis.Metric.Result.Stats js-rhino
}
