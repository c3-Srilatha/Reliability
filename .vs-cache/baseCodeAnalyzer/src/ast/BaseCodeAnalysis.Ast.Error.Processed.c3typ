/**
 * Type to store the result of an unsuccessful attempt to generate an AST for a file.
 */
type BaseCodeAnalysis.Ast.Error.Processed mixes BaseCodeAnalysis.Ast.Error {
  /**
   * The name of the file for which the diff is being parsed in the source control repository.
   */
  filename: !string

  /**
   * The path of the file for which the diff is being parsed in the source control repository.
   */
  filePathInSourceControlRepo: !string

  /**
   * The encoded anchor to the line that's causing this AST generation error.
   *
   * For instance, for GitHub, an anchor to line 15 for the `TestType.js` file in the `c3repo`
   * folder would look as follows:
   * `https://github.com/c3-e/c3repo/blob/<commitSha>/<path/to>/TestType.js#L15`
   */
  encodedAnchor: string

  /**
   * Boolean to indicate whether the file that raised this AST generation error was changed.
   */
  isChanged: !boolean = false
}
