/**
 * Type to store the result of an unsuccessful attempt to generate an AST for a file.
 */
type BaseCodeAnalysis.Ast.Error {
  /**
   * The file package path url in the server of the file for which encountered the
   * AST-generation error.
   */
  filePkgPathUrl: !string

  /**
   * The error message encountered during AST generation.
   */
  errorMessage: !string

  /**
   * The line on which the AST generation issue occurred.
   */
  line: int

  /**
   * The column in the {@link #line} on which the AST generation issue occurred.
   */
  column: int
}
