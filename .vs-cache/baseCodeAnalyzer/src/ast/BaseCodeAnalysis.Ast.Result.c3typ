/**
 * Result type of the {@link BaseCodeAnalysis.Ast#addAstToFileSpecs} function.
 */
type BaseCodeAnalysis.Ast.Result {
  /**
   * The list of file specs with valid ASTs.
   */
  fileSpecs: [BaseCodeAnalysis.FileSpec]

  /**
   * The list of errors encountered during AST generation.
   */
  invalidAstErrors: [BaseCodeAnalysis.Ast.Error]
}
