/**
 * The Type contains information about a comment in code.
 */
type BaseCodeAnalysis.Ast.Comment {

  /**
   * The value of the comment.
   */
  value: string

  /**
   * The start position of the comment in the file.
   */
  start: BaseCodeAnalysis.Ast.Position

  /**
   * The end position of the comment in the file.
   */
  end: BaseCodeAnalysis.Ast.Position
}
