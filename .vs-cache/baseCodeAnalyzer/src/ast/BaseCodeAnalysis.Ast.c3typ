/**
 * A Type that contains methods to generate the ASTs for different file extensions.
 */
type BaseCodeAnalysis.Ast {

  /**
   * Function that populates the fileSpecs with the ASTs of the files. Internally calls corresponding helper
   * methods to generate the ASTs for different file extensions.
   *
   * @param fileSpecs
   *           The list of original {@link BaseCodeAnalysis.FileSpec}s.
   * @return The {@link BaseCodeAnalysis.Ast.Result}.
   */
  addAstToFileSpecs: function(fileSpecs: [BaseCodeAnalysis.FileSpec]): BaseCodeAnalysis.Ast.Result js-server

  /**
   * Function that populates the fileSpecs with the ASTs of all js family of files.
   *
   * @param fileSpecs
   *           The list of original {@link BaseCodeAnalysis.FileSpec}s.
   * @return The {@link BaseCodeAnalysis.Ast.Result}.
   */
  addAstToJsFileSpecs: function(fileSpecs: [BaseCodeAnalysis.FileSpec]): BaseCodeAnalysis.Ast.Result js-codeanalysis-node

  /**
   * Function that attempts to generate AST for fileSpecs in the py family of files.
   * Unlike #addAstToJsFileSpecs, this function does not add an AST to the fileSpec
   * since the Python-generated ASTs are not json-serializable.
   *
   * This function simply attempts to generate an AST for the Python content and populates them into
   * the {@link BaseCodeAnalysis.Ast.Result#fileSpecs} array for valid ASTs and creates an error in
   * in the {@link BaseCodeAnalysis.Ast.Result#invalidAstErrors} array for invalid ASTs.
   *
   * This workflow ensures downstream metrics only consume files with valid ASTs and enables the
   * Code Analyzer to propagate the AST-generation error message to developers so that they can be fixed.
   *
   * @param fileSpecs
   *           The list of original {@link BaseCodeAnalysis.FileSpec}s.
   * @return The {@link BaseCodeAnalysis.Ast.Result}.
   */
  addAstToPyFileSpecs: function(fileSpecs: [BaseCodeAnalysis.FileSpec]): BaseCodeAnalysis.Ast.Result py-codeanalysis
}
