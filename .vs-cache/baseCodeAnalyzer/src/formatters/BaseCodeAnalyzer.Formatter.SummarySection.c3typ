/**
 * Type to store the components of the summary message section to be displayed in the
 * summary message posted by the C3 AI Code Analyzer.
 *
 * If #content is present, each section is rendered in a `<details>` disclosure widget that
 * is closed by default.
 */
type BaseCodeAnalyzer.Formatter.SummarySection {

  /**
   * The title of the summary section dropdown.
   */
  title: !string

  /**
   * The content of the summary section dropdown.
   */
  content: string
}
