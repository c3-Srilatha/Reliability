/**
 * Code analysis result containing analysis metrics on a file or package level.
 */
type BaseCodeAnalysis.Metric.Result {

  /**
   * The name of the metric this code analysis result is associated with.
   */
  // TODO: ENGR-23346 Remove this field in version 13
  @deprecated(finalVersion='13', details='Use #metricCode instead.')
  metricName: string enum BaseCodeAnalysis.Metric.Name

  /**
   * The kebab-case code of the metric this code analysis result is associated with.
   */
  metricCode: string enum BaseCodeAnalysis.Metric.Code

  /**
   * The name of the item being analyzed, which could be a file or a package name.
   */
  itemName: !string

  /**
   * The kind of code analysis result.
   * Can be either file level result, or package level result.
   */
  kind: !string enum BaseCodeAnalysis.Result.Kind = FILE

  /**
   * The test kind this code analysis result is associated with, if the metric is related to a test.
   */
  testKind: string enum TestRunnerKind

  /**
   * Stores any internal errors that might have been raised during metric evaluation.
   *
   * If non-empty, it is inferred that code analysis failed for this {@link #metricCode}-{@link #itemName} pair
   * with the error message stored here.
   */
  internalErrorMessage: string

  /**
   * The aggregated statistic values for this metric result.
   */
  stats: !BaseCodeAnalysis.Metric.Result.Stats

  /**
   * The {@link BaseCodeAnalysis.Metric.Message}s associated with this code analysis result.
   */
  codeAnalysisMetricMessages: [BaseCodeAnalysis.Metric.Message]

  /**
   * A compressed representation of {@link BaseCodeAnalysis.Metric.Message}s. Only populated for
   * {@link BaseCodeAnalysis.Result#packageMetricResults}. The array of #codeAnalysisMetricMessages
   * across all {@link BaseCodeAnalysis.Result#fileMetricResults} for a package are transformed to
   * be dictionary where the key is the filePkgPathUrl and value is the list of objects that store the line, column
   * and additional info json.
   */
  // TODO: ENGR-19524 - [BaseCodeAnalyzer] Improve BaseCodeAnalysis.Metric.Result data model.
  compressedMetricMessages: json

  /**
   * The {@link BaseCodeAnalysis.Metric.SuppressedMessage}s associated with this code analysis result.
   */
  suppressedCodeAnalysisMetricMessages: [BaseCodeAnalysis.Metric.SuppressedMessage]

  /**
   * A compressed representation of {@link BaseCodeAnalysis.Metric.SuppressedMessage}s. Only populated for
   * {@link BaseCodeAnalysis.Result#packageMetricResults}. The array of {@link #suppressedCodeAnalysisMetricMessages}
   * across all {@link BaseCodeAnalysis.Result#fileMetricResults} for a package are transformed to
   * be dictionary where the key is the filePkgPathUrl and value is the list of objects that store the line, column
   * and additional info json.
   */
  compressedSuppressedMetricMessages: json

  /**
   * Helper function to recompute the stats for this metric result when the #codeAnalysisMetricMessages
   * and/or #suppressedCodeAnalysisMetricMessages have been updated by {@link BaseCodeAnalysis#applyDirectivesToMetricResult}
   * or {@link BaseCodeAnalysis#applyConfigToResult}.
   *
   * @return The updated metric result with recomputed stats.
   */
  withComputedStats: private inline member function(): !mixing BaseCodeAnalysis.Metric.Result js-rhino
}
