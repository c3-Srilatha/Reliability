/**
 * Type to represent the structure of the response for {@link BaseCodeAnalyzer.SourceControlGadget#getPrEncodedAnchors}.
 * These maps help redirect users to the appropriate diff to which a comment is referring to.
 */
type BaseCodeAnalyzer.SourceControlGadget.Anchors {
  /**
   * A map from a filepath to it's anchor in the source control host's UI.
   */
  filepathAnchors: map<string, string>

  /**
   * The encoded anchors for all the lines that on which a new comment is being posted, grouped by
   * the path of the file to which it belongs.
   *
   * ```
   * {
   *   <filepath>: {
   *     <line>: <line_anchor>
   *   }
   * }
   * ```
   */
  lineAnchorsByFile: map<string, map<string, string>>
}
