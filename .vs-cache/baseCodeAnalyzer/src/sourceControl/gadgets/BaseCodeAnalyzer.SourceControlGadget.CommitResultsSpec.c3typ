/**
 * Spec to create a commit processed results to a centralized repository
 * {@link BaseCodeAnalyzer.SourceControlGadget#commitProcessedResults}.
 */
private type BaseCodeAnalyzer.SourceControlGadget.CommitResultsSpec mixes Spec {

  /**
   * The centralized repository to commit the processed results to.
   */
  repo: !string

  /**
   * The branch in the centralized repository to commit the processed results to.
   */
  branch: !string

  /**
   * The JSON contents contents containing the processed results to be committed.
   */
  content: json

  /**
   * The relative path to the file containing the processed results.
   */
  resultPath: !string

  /**
   * The message to be used when committing the changes.
   */
  commitMessage: !string
}
