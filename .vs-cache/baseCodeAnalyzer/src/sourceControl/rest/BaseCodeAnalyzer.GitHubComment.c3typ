/**
 * Wrapper around the base {@link GitHubComment} Type to capture more fields returned
 * by the GitHub `/repos/{owner}/{repo}/pulls/{pull_number}/comments` API.
 */
type BaseCodeAnalyzer.GitHubComment mixes GitHubComment {

  /**
   * The start line number on the file to which the comment applied when it was first created.
   */
  original_start_line: int

  /**
   * The start line number on the file to which the comment applies.
   */
  start_line: int

  /**
   * The starting side of the diff that the comment applies to. Required when using multi-line
   * comments unless using #in_reply_to.
   */
  start_side: string enum ('LEFT', 'RIGHT', 'side')

  /**
   * The level at which the comment is targeted.
   */
  subject_type: string enum ('line', 'file')

  /**
   * The ID of the review comment to reply to. When specified, all parameters other than
   * #body in the request body are ignored.
   */
  in_reply_to: string
}
