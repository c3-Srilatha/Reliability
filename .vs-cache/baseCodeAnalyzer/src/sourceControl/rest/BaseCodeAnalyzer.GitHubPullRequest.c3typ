/**
 * Wrapper around the base {@link GitHubPullRequest} Type to capture more fields returned
 * by the GitHub `/repos/{owner}/{repo}/pulls/{pull_number}` API.
 */
type BaseCodeAnalyzer.GitHubPullRequest mixes GitHubPullRequest {

  /**
   * Information about the base branch.
   */
  base: json
}
