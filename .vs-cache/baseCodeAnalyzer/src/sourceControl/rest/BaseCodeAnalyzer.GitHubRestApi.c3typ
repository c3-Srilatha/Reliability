/**
 * REST type to include the {@link #createPullRequestReview} GitHub API that allows {@link BaseCodeAnalyzer}
 * to publish all review comments as part of single request to a PR.
 */
type BaseCodeAnalyzer.GitHubRestApi mixes REST {

  /**
   * Returns a single pull request info under the queried repository.
   * GitHub URI: `GET /repos/:owner/:repo/pulls/:pull_number`.
   * Example: `GitHub.pullRequest("c3-e/c3repo", 1)`
   *
   * This function is the same as {@link GitHub#pullRequest} with the sole change of the return type,
   * which captures more information about the base branch than the function implemented in the platform.
   *
   * @param fullRepositoryName
   *           GitHub's full repository path. (e.g. `c3-e/c3repo`)
   * @param pullRequestNumber
   *           The number of the pull request.
   * @return The pull request info.
   */
  @rest(uri='repos', method='GET')
  pullRequest: abstract member function(@rest(partOfURI=true, uriPrefix='/')
                                        fullRepositoryName: !string,
                                        @rest(partOfURI=true, uriPrefix='/pulls/')
                                        pullRequestNumber: !string): BaseCodeAnalyzer.GitHubPullRequest

  /**
   * List all review comments for a pull request in the pull request diff
   * GitHub URI: `GET /repos/:owner/:repo/pulls/:pull_number/comments`.
   *
   * This function is the same as {@link GitHub#pullRequestComments} with the sole change of the
   * return type, which captures more information about each comment than the function implemented
   * in the platform.
   *
   * @param fullRepositoryName
   *           GitHub's full repository path. (e.g. `c3-e/c3server`)
   * @param pullRequestNumber
   *           The number of the pull request.
   * @return The list of comments for the pull request, sorted by creation timestamp.
   */
  @rest(uri='repos', method='GET', acceptHeader='application/vnd.github.v3+json')
  pullRequestComments: abstract member function(@rest(partOfURI=true, uriPrefix='/', uriSuffix='/pulls')
                                                fullRepositoryName: !string,
                                                @rest(partOfURI=true, uriPrefix='/', uriSuffix='/comments')
                                                pullRequestNumber: !int): [BaseCodeAnalyzer.GitHubComment]

  /**
   * Creates a review for a pull request.
   * GitHub URI: `POST /repos/:owner/:repo/pulls/:pull_number/reviews`.
   *
   * @param fullRepositoryName
   *           GitHub's full repository path. (e.g. `c3-e/c3base`)
   * @param pullRequestNumber
   *           The pull request number
   * @param commitId
   *           The SHA of the commit that needs a review
   * @param event
   *           The review action you want to perform. Can be APPROVE, REQUEST_CHANGES, or COMMENT.
   * @param body
   *           The text of the review comment.
   * @param comments
   *           The comments that should be added to the review.
   */
  @rest(uri='repos', method='POST', acceptHeader='*/*', skipThis=true)
  createPullRequestReview: abstract member function(@rest(partOfURI=true, uriPrefix='/', uriSuffix='/pulls')
                                                    fullRepositoryName: !string,
                                                    @rest(partOfURI=true, uriPrefix='/', uriSuffix='/reviews')
                                                    pullRequestNumber: !int,
                                                    commitId: !string,
                                                    event: !string,
                                                    body: string,
                                                    comments: [BaseCodeAnalyzer.GitHubComment])

  /**
   * Invokes the GitHub GraphQL API (<https://docs.github.com/en/graphql>) and returns the response.
   * GitHub URI: `POST /graphql`.
   *
   * @param query
   *           The GraphQL query string payload.
   * @return The response from the GraphQL API.
   */
  @rest(uri='graphql', method='POST')
  graphql: abstract member function(query: !string): json
}
