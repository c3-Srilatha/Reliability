/**
 * Information about a specific dependency of a {@link Pkg}.
 *
 * @see BaseCodeAnalysis.AppInfo#pkgDependencyInfos
 * @see BaseCodeAnalyzer#collectPkgDependencyInfos
 * @see BaseCodeAnalyzer#collectAppInfo
 */
type BaseCodeAnalysis.PkgDependencyInfo mixes Result {

  /**
   * The current version of the package.
   */
  version: !string serialized SemanticVersion

  /**
   * True if this is either the [root package](BaseCodeAnalysis.AppInfo#rootPkgName)
   * or explicitly declared in the root package's {@link Pkg.Decl#dependencies}.
   */
  isDeclared: !boolean

  /**
   * All {@link Pkg#name}s that this {@link Pkg} depends on, ordered from closest to
   * farthest dependency.
   */
  upstreamPkgDeps: @indexed set<!string>

  /**
   * All {@link Pkg#name}s that depend on this {@link Pkg}, ordered from closest to
   * farthest dependency.
   */
  downstreamPkgDeps: @indexed set<!string>
}
