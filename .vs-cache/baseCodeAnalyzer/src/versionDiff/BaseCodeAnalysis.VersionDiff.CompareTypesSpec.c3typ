/**
 * Spec Type for comparing two versions of a Type.
 *
 * **NOTE:** None of these fields are required, so any user of this spec must implement their
 *           own validation logic based on the specific use case.
 *
 * @see BaseCodeAnalysis.VersionDiff.Metric
 * @see BaseCodeAnalysis.VersionDiff.Metric#scanTypeMeta
 */
type BaseCodeAnalysis.VersionDiff.CompareTypesSpec mixes Spec {

  /**
   * The previous version of the Type.
   */
  prevTypeInfo: BaseCodeAnalysis.TypeInfo

  /**
   * The current version of the Type.
   */
  curTypeInfo: BaseCodeAnalysis.TypeInfo

  /**
   * If this Type was revised between the two versions, this field should be populated with
   * the details of the revision.
   *
   * @see BaseCodeAnalysis.VersionDiff#detectStructuralChanges
   */
  typeRevisionDetails: BaseCodeAnalysis.VersionDiff.TypeMetaChangesBase.RevisionDetails
}
