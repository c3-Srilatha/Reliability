/**
 * Spec Type for comparing two versions of a {@link FunctionParam}.
 *
 * **NOTE:** None of these fields are required, so any user of this spec must implement
 *           their own validation logic based on the specific use case.
 *
 * @see BaseCodeAnalysis.VersionDiff.Metric
 * @see BaseCodeAnalysis.VersionDiff.Metric#scanTypeMeta
 */
type BaseCodeAnalysis.VersionDiff.CompareParamsSpec mixes BaseCodeAnalysis.VersionDiff.CompareFieldsSpec {

  /**
   * The previous version of the parameter.
   */
  prevParamMeta: FunctionParam

  /**
   * The current version of the parameter.
   */
  curParamMeta: FunctionParam
}
