/**
 * Spec Type for comparing two versions of a {@link DeclaredFieldType}. This could represent
 * a field or method.
 *
 * **NOTE:** None of these fields are required, so any user of this spec must implement
 *           their own validation logic based on the specific use case.
 *
 * @see BaseCodeAnalysis.VersionDiff.Metric
 * @see BaseCodeAnalysis.VersionDiff.Metric#scanTypeMeta
 */
type BaseCodeAnalysis.VersionDiff.CompareFieldsSpec mixes BaseCodeAnalysis.VersionDiff.CompareTypesSpec {

  /**
   * The previous version of the field or method.
   */
  prevFieldMeta: DeclaredFieldType

  /**
   * The current version of the field or method.
   */
  curFieldMeta: DeclaredFieldType

  /**
   * If this field or method was revised between the two versions, this field should be
   * populated with the details of the revision.
   *
   * @see BaseCodeAnalysis.VersionDiff#detectStructuralChanges
   */
  fieldRevisionDetails: BaseCodeAnalysis.VersionDiff.TypeMetaChangesBase.RevisionDetails
}
