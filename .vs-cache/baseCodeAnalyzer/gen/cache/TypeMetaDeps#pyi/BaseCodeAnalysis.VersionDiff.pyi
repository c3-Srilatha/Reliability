             │   func: optional function(a: int)       │
             │ }                                       │
             ├────────────────────┬────────────────────┤
             │       1.0.0        │       2.0.0        │
             ├────────────────────┼────────────────────┤
             │ type B mixes A     │ type B mixes A {   │
             │                    │   func: ~ js-rhino │
             │                    │ }                  │
             ├────────────────────┼────────────────────┤
             │ type B mixes A {   │ type B mixes A     │
             │   func: ~ js-rhino │                    │
             │ }                  │                    │
             └────────────────────┴────────────────────┘
             ```
        
