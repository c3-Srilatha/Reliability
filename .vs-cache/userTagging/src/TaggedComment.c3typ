/**
 * This type defines user tagging from within the comments.
 */
@db(datastore='kv',
    partitionKeyField='parent',
    persistDuplicates=false,
    persistenceOrder='meta.updated',
    shortId=true,
    shortIdReservationRange=100000)
abstract entity type TaggedComment<P> {

  /**
   * Raw comment that may contained tagged users.
   *
   * To tag a user will use `[~userId]` format.
   */
  comment: !string

  /**
   * The entity this message is a comment for.
   */
  parent: !P

  /**
   * List of users mentioned in comment.
   *
   * This be the list of recipients of the notification.
   */
  taggedUsers: [User]

  /**
   * If exists, the page url the tagged mention was submitted from.
   *
   * A user will use this link to go directly to page that contains this mentioned comment.
   */
  url: string

  /**
   * This method is called in beforeCreate to create the subject for NotificationUserRecipient.scheduleNotificationToUsers
   * Developers can override this function to have different subject formats for different types of tagged comments.
   *
   * @return A string of the notification subject.
   */
  createNotificationSubject: abstract member function(): string js-server

  /**
   * This method is called in beforeCreate to create the content for NotificationUserRecipient.scheduleNotificationToUsers
   * Developers can override this function to have different content formats for different types of tagged comments.
   *
   * @return A string of the notification content.
   */
  createNotificationContent: abstract member function(): string js-server

  beforeCreate: ~ js-server
}
