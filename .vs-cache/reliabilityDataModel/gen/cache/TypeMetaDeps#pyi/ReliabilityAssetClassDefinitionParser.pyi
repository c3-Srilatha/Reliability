    def getWorkflow(cls) -> Union[Workflow]:
    """
    Gets the workflow that is used to run the parser. Creates it if it doesn't already exist. The workflow
    feeds options to the {@link ReliabilityAssetClassDefinitionParserJob} and waits for it to complete. Then it
    fetches the results for use as {@link Workflow.Run#executionResults} and deletes these results from the db.
    
    @return The workflow used to run the parser.
    """
        ...
    @classmethod
    def getLatestResults(cls) -> Union[any]:
    """
    Gets the latest results from the workflow that was used to run the parser. This function will return the
