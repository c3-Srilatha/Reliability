/**
 * Contains apis only to be used for reliability tests.
 */
type ReliabilityTestApi {

  /**
   * Waits for the given workflow run to complete.
   *
   * @param run
   *        The workflow run to wait for.
   * @param timeout
   *        The timeout in seconds.
   * @param checkInterval
   *        The interval in seconds to check the workflow status.
   */
  waitForWorkflowRun: function(run: Workflow.Run, timeout: int = 300, checkInterval: int = 5) js-rhino
}
