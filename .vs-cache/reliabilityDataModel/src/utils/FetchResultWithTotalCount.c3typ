/**
 * Helper type that allows returning a fetch result with a total count in cases
 * where the result is paginated in memory.
 */
type FetchResultWithTotalCount<T> mixes FetchResult<T> {

  /**
   * The total count of objs.
   */
  totalCount: int
}
