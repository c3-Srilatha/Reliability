/**
 * Type that contains common utility APIs for Reliability
 */
type ReliabilityUtils {

  /**
   * Checks whether a passed in obj has been persisted to the database and return true if so,
   * and false otherwise.
   *
   * @param obj
   *        The object to check if it's persisted in the database.
   * @return True if the object is persisted in the database, false otherwise.
   */
  isObjInDb: function(obj: Persistable): !boolean py | js-rhino


  /**
  * Queries array fields within a persisted entity to fetch objects matching specific criteria.
  *
  * This function is designed to query and retrieve data from a collection field in a persisted entity,
  * supporting filtering, pagination, and inclusion of specific fields. The function calculates the total count
  * of objects in the collection field that match the specified filter, retrieves the requested subset of objects,
  * and determines if there are more objects to fetch. Currently it supports {@link AssetClass}
  *
  * @param entity - The persisted {@link Persistable} entity to query. Must have a valid `id` property.
  * @param collectionFieldPath - Path to the collection field within the entity to query.
  * @param spec - The {@link FetchSpec} specifications for fetching data, including filters, pagination, and fields to include.
  *   - `filter` {string} : The condition to filter objects within the collection field.
  *   - `offset` {number} : The starting index for pagination.
  *   - `limit` {number}  : The maximum number of objects to fetch.
  *   - `include` {string}: Specifies additional fields to include in the fetched objects.
  *
  * @return {FetchResult<any>} An object containing:
  *   - `objs` {Array<any>}: The fetched objects from the collection field.
  *   - `count` {number}: Total count of objects in the collection field matching the filter.
  *   - `hasMore` {boolean}: Indicates whether there are more objects to fetch beyond the current range.
  *
  * NOTE: If the limit does not work, set the filter "true" to use an in-memory pagination strategy
   */
  fetchFromCollectionField: function(entity: !Persistable,
                                    collectionFieldPath: !string,
                                    spec: FetchSpec): FetchResultWithTotalCount<any> js-rhino

  /**
   * Iterates through a map or array of nested objects, and execute the given function on each object
   * of the specified type. Only works for objects that are well defined and one level of nesting (Ex:
   * `map<string, map<string, Timeseries>>`).
   *
   * @param input The map or array to iterate through.
   * @param typeName The name of the type that objects should have to have the function executed on them.
   * @param fn The function to execute on each object of the specified type. Should take three arguments:
   *            the key (or index), the object itself, and the parent key (or null if at the top level).
   *
   */
  forEachOfSpecifiedType: inline function(input: native, typeName: string, fn: native) js-rhino

}
