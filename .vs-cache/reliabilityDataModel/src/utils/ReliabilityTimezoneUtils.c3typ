/**
 * Type that contains timezone utility APIs for Reliability
 */
type ReliabilityTimezoneUtils {

  /**
   * Recursively converts all ISO datetime strings with timezone info in the input object
   * to the specified target timezone, returning a new object.
   *
   * Datetimes without timezone info are left unchanged.
   *
   * @param obj - The input object which can be dict, list, str, type, Obj or json.
   * @param targetTimezone - The timezone to convert datetime to.
   * @param replacementTimezone - The timezone whose offset needs to be added to timestamps
   * @returns A new version of the object with converted datetime strings.
   */
  convertTimestampsToZone: inline function(obj: !?any, targetTimezone: string, replacementTimezone: ?string): !?any js-rhino | ts-client | py
}
