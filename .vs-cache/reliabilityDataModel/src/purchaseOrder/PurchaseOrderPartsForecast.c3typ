/**
 * A purchase order forecast represents a predicted point in time when a {@link PurchaseOrderLine} must be placed.
 * The prediction is made during {@link WorkOrderPartsForecast#updatePartsForecast} when a given part's forecasted inventory
 * is expected go below it's minimum inventory level.
 */
entity type PurchaseOrderPartsForecast {

  /**
   * The {@link InventorySeries} part for which the forecast was made.
   */
  part: !InventorySeries

  /**
   * The date at which the purchase order line must be placed.
   */
  purchaseDate: !datetime

  /**
   * The date at which purchase order line is expected to be delivered.
   * Calculated by adding {#part.avgLeadTime} to {#purchaseDate}.
   */
  expectedDeliveryDate: !datetime

  /**
   * The amount of quantity that must be ordered.
   */
  quantity: !Dimension
}
