/**
 * Represents the relationship between a {@link Facility} and a child {@link Facility}.
 */
entity type FacilityHierarchicalRelation extends PhysicalAssetHierarchyRelation mixes FilterableByFacility type key 'FHR' {

  /**
   * The parent {@link Facility} in the relation.
   */
  from: Facility

  /**
   * The child {@link Facility} in the relation.
   */
  to:   Facility

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["from", "to"]
}
