/**
 * Type to represent the importance level of an asset.
 * This type is used to categorize assets based on their criticality or importance
 * in the {@link ReliabilityAsset} hierarchy.
 */
@db(unique=['importanceLevel'])
entity type ReliabilityAssetImportance mixes ExemptFromFacilityFilter {

  /**
   * Importance level for the specific asset.
   * importanceLevel must be unique and can hold anywhere from 1 to n with 1 being most critical.
   */
  importanceLevel: !int

  /**
   * The name of the assetImportance importanceLevel.
   */
  name: !string

  /**
   * Translated description for the assetImportance importanceLevel.
   */
  translationMap: json

  /**
   * Translated name for the assetImportance importanceLevel.
   */
  displayName: string stored calc getAssetImportanceName(translationMap, name)

}
