/**
 * Historical value for facility characteristics. Holds value as of date defined by timestamp for
 * a characteristic defined by name.
 */
@db(index+=['meta.timestamp', 'name, parent'])
extendable entity type ReliabilityAssetCharacteristicValue mixes TimedCharacteristicHistory<ReliabilityAsset>, FilterableByFacility schema name 'REL_AST_CHAR_VAL' {

  /**
   * The value of the facility characteristic
   */
  value: !string

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["parent.facility"]
}
