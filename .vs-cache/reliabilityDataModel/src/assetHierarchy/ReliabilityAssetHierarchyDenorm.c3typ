/**
 * Represents the hierarchy denorm for the Reliability Asset Hierarchy
 */
@denorm(sources=[
                  {
                    type: 'DenormSource',
                    parentFieldName: 'currentParentRelations',
                    startFieldName: 'start',
                    childFieldName: 'currentChildRelations',
                    endFieldName: 'end',
                    source: 'ReliabilityAssetHierarchicalRelation'
                  }
                ])
entity extendable type ReliabilityAssetHierarchyDenorm mixes TimedIntervalHierarchyDenorm<ReliabilityAsset>, FilterableByFacility schema name 'RA_DENORM' {
  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["from.facility", "to.facility"]
}
