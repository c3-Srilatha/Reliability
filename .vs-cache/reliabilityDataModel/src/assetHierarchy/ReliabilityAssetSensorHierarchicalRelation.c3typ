/**
 * Represents the relationship between a {@link ReliabilityAsset} and a child {@link Sensor}.
 */
entity type ReliabilityAssetSensorHierarchicalRelation extends PhysicalAssetHierarchyRelation type key "RASHR" {

  /**
   * The parent {@link ReliabilityAsset} in the relation.
   */
  from: !ReliabilityAsset

  /**
   * The child {@link Sensor} in the relation.
   */
  to: !Sensor
}
