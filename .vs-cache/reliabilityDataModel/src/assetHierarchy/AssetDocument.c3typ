/**
 * A type to link a diagram, which is used a `UiSdlImage` to a {@link ReliabilityAsset}
 */
@db(index+=['asset'])
entity type AssetDocument mixes UserInformation, FilterableByFacility schema name 'SBSTM_DGRM' {

  /**
   * Description of the document.
   */
  description: string

  /**
   * The relative URL of attached document used by File API to upload and download document. Starts with `/file/`.
   */
  fileUrl: string

  /**
   * The {@link ReliabilityAsset} associated with this document.
   */
  asset: !ReliabilityAsset

  /**
   * File containing image for the Subsystem
   */
  imageFile: File

  /**
   * Used to populate AssetDocument#fileUrl upon creation
   */
  beforeCreate: ~ js-rhino

  /**
   * Used to populate AssetDocument#fileUrl upon update
   */
  beforeUpdate: ~ js-rhino

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["asset.facility"]
}
