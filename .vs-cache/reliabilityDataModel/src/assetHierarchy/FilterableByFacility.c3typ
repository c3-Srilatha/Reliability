/**
 * Mixin for types that can be filtered by {@link Facility}. If a type mixes this type,
 * it must be filtered by the {@link Facility}s that the user has access to. Otherwise,
 * users will be able to see data that they should not be able to see.
 */
abstract entity type FilterableByFacility {
  /**
   * All paths that can be used to filter this type by {@link Facility}.
   * The paths are relative to the type.
   * For example, if the type is {@link ReliabilityAsset}, the path is "facility".
   */
  facilityFilterPaths: const [string]

  /**
   * Get a filter that can be used to filter this type by {@link Facility}.
   *
   * @param facilities
   *        The list of {@link Facility}s to filter by.
   * @returns
   *        A string serialized {@link Filter} that can be used to filter this type by {@link Facility}.
   */
  getFacilityFilter: function(facilities: [Facility]): string serialized Filter js-rhino
}
