/**
 * A batch job that updates the parts forecast for all parts
 */

type ReliabilitySparePartsForecastJob extends BatchJob<ReliabilitySparePartsForecastJob, ReliabilitySparePartsForecastJobOptions, ReliabilitySparePartsForecastBatch> type key 'RSPFJ' {
  /**
   * @inheritdoc
   */
  doStart: ~ py

  /**
   * @inheritdoc
   */
  processBatch: ~ py

  /**
   * @inheritdoc
   */
  allComplete: ~py

  /**
   * @inheritdoc
   */
  failed: ~py
}
