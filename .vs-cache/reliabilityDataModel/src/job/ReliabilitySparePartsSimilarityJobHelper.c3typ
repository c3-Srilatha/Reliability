/**
 * Helper entity type to store the MapReduce job id and similar work orders,
 * which will be used after map reduce job has been completed
 */
entity type ReliabilitySparePartsSimilarityJobHelper {
    /**
     * MapReduce job id
     */
    jobId: string

    /**
     * Similar work orders present in one batch of map reduce job
     */
    similarWorkOrders: [WorkOrder]
}
