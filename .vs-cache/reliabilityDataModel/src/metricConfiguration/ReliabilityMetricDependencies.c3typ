/**
 * This type is used to maintain relation between different {@link ReliabilityMetric}s objects.
 * It lists row by row relation between two {@link ReliabilityMetric}s objects.
 * For example, if we have a metric expression A = B + C, where all three metrics are of type {@link ReliabilityMetric}.
 * This type will store the relation like below,
 *
 * | from | relatedMetric  | relationType |
 * |------|----------------|--------------|
 * | A    | B              | child        |
 * | A    | C              | child        |
 * | B    | A              | dependency   |
 * | C    | A              | dependency   |
 */
entity type ReliabilityMetricDependencies {
  /**
   * Reference from the {@link ReliabilityMetric}.
   */
  from: ReliabilityMetric

  /**
   * For a given {@link ReliabilityMetric} object, it stores the the associated/related {@link ReliabilityMetric} object.
   */
  relatedMetric: ReliabilityMetric

  /**
   * For a given {@link ReliabilityMetric} object, it stores the the relation type with
   * associated/related {@link ReliabilityMetric} object.
   */
  relationType: string enum ('child', 'dependency')
}
