/**
* Enum type to store the permission assigned to {@link ReliabilityMetric}.
* Indicating if {@link ReliabilityMetric} can be shared or not.
*/
enum type ReliabilityMetricPermissionEnum {
  /**
  * User created {@link ReliabilityMetric} will be shared with the public.
  */
  SHARED = 'Public'

  /**
  * User created {@link ReliabilityMetric} will not be shared with the public.
  */
  NOT_SHARED = 'For Me Only'
}
