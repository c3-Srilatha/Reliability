/**
 * This type represents stored metric functions that can be used with
 * timeseries data.
 */
entity type ReliabilityFunction mixes ExemptFromFacilityFilter schema name 'RLFNC' {

  /**
   * The expression of the function i.e. sum(value)
   */
  expression: !string

  /**
   * A detailed description of how to use the function. This field is used to help the user understand which arguments
   * can be placed when calling the function plus the expected output.
   */
  description: !string

  /**
   * Name of the function. Helps the user to identify the function.
   */
  name: !string
}
