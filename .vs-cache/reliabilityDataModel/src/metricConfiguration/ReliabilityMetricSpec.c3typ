/**
 * A Spec type that holds the information related to a {@link ReliabilityMetric} that has been
 * created or modified by a user in the UI.
 */
type ReliabilityMetricSpec mixes Spec {

  /**
  * Id of the {@link ReliabilityMetric}. Will be associated with the {@link ReliabilityMetric} during edit or delete.
  */
  id: string

  /**
   * The user who created this {@link ReliabilityMetric}.
   */
  createdBy: User

  /**
  * The name of the {@link ReliabilityMetric}.
  */
  name: !string

  /**
   * The detailed description of how to uses the {@link ReliabilityMetric}. This is how the
   * user understands which arguements can be placed within the call.
   */
  description: !string

  /**
   * The permission that has been assigned to this {@link ReliabilityMetric}.
   * Indicates whther the {@link ReliabilityMetric} can be shared or not.
   */
  permission: string enum ReliabilityMetricPermissionEnum

  /**
  * The expression of the {@link ReliabilityMetric}.
  */
  expression: !string

  /**
   * The expanded expression of the metric, which is used for metric calculations.
   */
  expandedExpression: !string

  /**
   * A list of related assets that this {@link ReliabilityMetric} is associated with.
   */
  assets: [ReliabilityAsset]

  /**
   * The {@link Facility} associated with this {@link ReliabilityMetric}.
   */
  facility: !Facility

  /**
   * Get the time at which the custom metric was updated.
   */
  lastUpdated: !DateTime
}
