/**
 * This type represents stored metric expressions defined by the user.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
entity type ReliabilityMetric mixes FilterableByFacility schema name 'RLMTRC' {

  /**
   * Creates a new metric from the UI, and promotes the childMetrics to Shared/Public if the metric that is being
   * created is Shared/Public and the childMetrics are private.
   * @param formObject - The form object that is being passed from the UI. See more in {@link ReliabilityMetricSpec}.
   * @param childMetrics - The list of child metrics that are associated with the metric being created.
   * @return The newly created metric.
   */
  createMetric: function(formObject: !ReliabilityMetricSpec, childMetrics: [ReliabilityMetric]): ReliabilityMetric js-rhino

  /**
   * Function to modify the metric. This will update the metric and its child metrics if the metric is promoted to
   * Shared/Public and the child metrics are private.
   * @param formObject - The form object that is being passed from the UI. See more in {@link ReliabilityMetricSpec}.
   * @param childMetrics - The list of child metrics that are associated with the metric being modified.
   * @return The modified metric.
   */
  modifyMetric: function(formObject: !ReliabilityMetricSpec, childMetrics: [ReliabilityMetric]): ReliabilityMetric js-rhino

  /**
   * Function to delete the metric.
   *
   * @param metricId
   *        The ID of the metric to delete.
   * @return The deleted metric.
   */
  deleteMetric: function(metricId: string): ReliabilityMetric js-rhino

  /**
   * Return true if the name is a duplicate among all {@link ReliabilityMetric}s shown to the user. Case and
   * leading/trailing whitespace are ignored during comparison.
   *
   * @param name - The string name that we want to ensure is unique among all the {@link ReliabilityMetric}s.
   * @param id - The id of the ReliabilityMetric that we are currently editing. This will be excluded from the
   *            check.
   * @return True if the name is duplicated, false otherwise.
   */
  isNameDuplicated: function(name: !string, id: string): boolean js-rhino

  /**
   * Fetches {@link ReliabilityMetric} only for the metrics that the current user has access to; this includes the
   * metrics that are shared and the metrics that are created by the current user.
   *
   * @param spec - The {@link FetchSpec} wiith specifications for fetching data, including filters, pagination, and fields to include.
   *   - `filter` {string} : The condition to filter objects within the collection field.
   *   - `offset` {number} : The starting index for pagination.
   *   - `limit` {number}  : The maximum number of objects to fetch.
   *   - `include` {string}: Specifies additional fields to include in the fetched objects.
   * @return {@link FetchResult} of {@link ReliabilityMetric} that the current user has access to.
   */
  fetchMetricByCurrentUser: function(spec: FetchSpec): FetchResult<ReliabilityMetric> js-rhino

  /**
   * The user visible name of this {@link ReliabilityMetric}. This must be unique among all reliability metrics shown
   * to the user and must use just valid characters (This includes alphanumeric characters and underscore). See
   * {@link #isNameDuplicated} for more information.
   */
  name: !string

  /**
   * A list of dependency metrics. This is needed, so when a deletion happens,
   * the user is alerted that the following chained metrics will be deleted as well.
   * Will be fetched from the {@link ReliabilityMetricDependencies} based on the `relationType`.
   */
  @db(filter='relationType == "dependency"')
  dependencyMetrics: [ReliabilityMetricDependencies](from)

  /**
   * A list of child metrics. This is needed, so when a user tries to promote a metric to Shared/Public,
   * the user is alerted that the following chained metrics will be promoted to Shared/Public as well.
   * Will be fetched from the {@link ReliabilityMetricDependencies} based on the `relationType`.
   */
  @db(filter='relationType == "child"')
  childMetrics: [ReliabilityMetricDependencies](from)

  /**
   * The detailed description of how to uses the metric. This is how the
   * user understands which arguements can be placed within the call.
   */
  description: !string

  /**
   * The name of the user who created this metric and imposed a restriction
   * so that only they can view it. If this field is blank, all can view the
   * custom created metric.
   */
  allowedUser: User

  /**
   * A list of related assets that this metric is associated with.
   */
  assets: [ReliabilityAsset]

  /**
   * If the #allowedUser field is populated, then we assume this is a private
   * created record.
   */
  permission: string stored calc exists(allowedUser) ? 'For Me Only' : 'Shared'

  /**
   * Translation of {@link permission}.
   */
  displayPermission: string translate by permission

  /**
   * The expression of the metric, which is shown and defined by the user.
   */
  expression: !string

  /**
   * The expanded expression of the metric, which is used for metric calculations.
   */
  expandedExpression: !string

  /**
   * The {@link Facility} associated with this metric.
   */
  facility: !Facility

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["facility"]

  /**
   * This is meant to represent the last user updated execution.
   * There will be backend jobs that run to update #dependencyMetrics
   * so you should never use meta data.
   */
  lastUpdated: !DateTime

  /**
  * This `#afterCreate` processes an object of {@link ReliabilityMetric}, updates related metrics based on
  * their expressions and updates their dependency metrics if the permission is 'For Me Only'.
  * Parses and extracts metrics from an expression like, metricA = metricB + metricC, retrieving metricB and metricC.
  * Identifies private metrics (e.g., metricB and metricC in this case), and adds metricA to the
  * dependency metrics list of metricB and metricC.
  */
  afterCreate:  ~ js-rhino

  /**
  * Private helper function to parse the metric expression.
  *
  * @param metricExpression
  *        The metric expression to parse.
  * @return List of metric names extracted from the expression.
  */
  parseExpression: private function(metricExpression: !string): [string] js-rhino

  /**
  * Private helper function to remove deleted metric from the `#dependencyMetrics` list of its `#childMetrics`.
  * Example: Metric3 = Metric1 + Metric2, if we delete Metric2, Metric3 will also be deleted since, Metric3 is dependent on Metric2.
  * Now, we need to remove Metric3 from the `#dependencyMetrics` list of Metric1.
  *
  * @param metricToDelete
  *        The metric that is being deleted.
  */
  clearDependencyMetrics: private function(metricToDelete: !ReliabilityMetric) js-rhino

  /**
  * This `#beforeUpdate` processes an object of {@link ReliabilityMetric}, looks for modification of {@link ReliabilityMetric} object.
  * If the `#expression` is modified, then `#dependencyMetrics` and `#childMetrics` will be updated.
  * This method id also used to promote the {@link ReliabilityMetric} to Shared/Public along with its `#childMetrics`.
  */
  @dependency(include='id, expression')
  beforeUpdate: ~ js-rhino

  /**
   * Transforms metric config expression by replacing 'sensor(' with 'evalSensorForAnyAsset('. It also expands the
   * parameters of the function in order to make it valid. For more information see
   * {@link ReliabilityExpressionEngineFunction#evalSensorForAnyAsset}
   *
   * @param expression
   *    Expression that needs to be transformed
   * @return string representing the expression transformed
   */
  replaceSensorTag: inline function(expression: string): string py-data

  /**
   * Transforms metric config expression by replacing each of the metric ids with its corresponding #expandedExpression
   *
   * @param expression
   *        The expression to transform.
   * @param metrics
   *        The list of metrics to use for expansion.
   * @return The transformed expression with expanded metric expressions.
   */
  replaceMetricExpandedExpression: inline function(expression: string, metrics: [ReliabilityMetric]): string py-data

  /**
   * Evaluates the given {@link ReliabilityMetric}s for the given time range and interval.
   *
   * @param metrics
   *        The metrics to evaluate.
   * @param start
   *        The start time for evaluation.
   * @param end
   *        The end time for evaluation.
   * @param interval
   *        The interval for evaluation.
   * @return A map from metric to timeseries data.
   */
  evalMetrics: function (metrics: ![ReliabilityMetric], start: !DateTime, end: !DateTime, interval: !Interval): map<string serialized ReliabilityMetric, Timeseries<any>> js-rhino
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
