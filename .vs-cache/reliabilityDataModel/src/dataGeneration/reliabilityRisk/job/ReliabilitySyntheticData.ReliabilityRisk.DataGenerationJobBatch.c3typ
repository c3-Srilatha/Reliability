/**
 * Represents each `batch` in the {@link ReliabilitySyntheticData.ReliabilityRisk.DataGenerationJob}
 */
type ReliabilitySyntheticData.ReliabilityRisk.DataGenerationJobBatch {

  /**
   * The replicated asset hierarchy file for each batch.
   */
  assetHierarchyReplicatedFile: !File

  /**
   * A JSON representation of the asset hierarchy batches for each batch.
   */
  assetHierarchyBatches: ![json]
}
