/**
 * Spec for {@link ReliabilitySyntheticData.ReliabilityRisk.AssetHierarchySpreadsheet#generateHistoricalCanonicalPointMeasurementDataForBatch}.
 */
type ReliabilitySyntheticData.ReliabilityRisk.AssetHierarchySpreadsheet.GeneratePointMeasurementSpec {

  /**
   * The Excel workbook containing asset hierarchy and sensor data.
   */
  file: !File

  /**
   * The current batch of replicated {@link ReliabilityAsset}s / {@link Sensor}s to generate
   * {@link PointMeasurement}s for within a single {@link Facility}.
   *
   * @see ReliabilitySyntheticData.ReliabilityRisk.DataGenerationJobFields#intrafacilityReplicationFactor
   */
  intrafacilityBatch: !int

  /**
   * The current batch of replicated [Facilities](Facility) to generate {@link PointMeasurement}s
   * for its {@link Sensor}s.
   *
   * @see ReliabilitySyntheticData.ReliabilityRisk.DataGenerationJobFields#interfacilityReplicationFactor
   */
  interfacilityBatch: !int

  /**
   * See {@link ReliabilitySyntheticData.ReliabilityRisk.DataGenerationJobFields#overrideTimeRange}.
   */
  overrideTimeRange: TimeRange

  /**
   * See {@link ReliabilitySyntheticData.ReliabilityRisk.DataGenerationJobFields#chunkDuration}.
   */
  chunkDuration: !Duration

  /**
   * The path to the directory the generated measurement CSVs should be written to. Files will be
   * chunked based on #chunkDuration.
   */
  folderPath: !string

  /**
   * The number of external sensors to associate with each asset.
   */
  numberOfExternalSensorsPerAsset: !int

  /**
   * The target expected sensor name for external sensors.
   */
  targetExpectedSensorForExternalSensors: string

  /**
   * A map of failure mode names to lambda functions.
   */
  failureModeLambdas: map<string, Lambda<function(df: any, expected_sensor_to_sensor_id: any, abnormal_sensor_bounds_for_failure_mode: any): any>>
}
