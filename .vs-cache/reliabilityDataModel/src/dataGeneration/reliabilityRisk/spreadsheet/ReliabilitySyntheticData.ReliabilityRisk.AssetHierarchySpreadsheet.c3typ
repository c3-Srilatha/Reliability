/**
 * Represents the asset hierarchy excel spreadsheet which MUST have the following tabs/sheets:
 * 1. REL_Asset_Hierarchy
 * 2. Expected_Sensors
 * 3. ExpSens_Diag_FailureModes
 * 4. FailureModes_to_RecActions
 * 5. Sensor_Measurement_Bounds
 * 6. Time_Range
 * 7. Events
 *
 * The first four sheets are the same as what {@link ReliabilityExcelParser} requires. The remaining three sheets
 * contain information used to tune the quality of the data generated.
 */
extendable entity type ReliabilitySyntheticData.ReliabilityRisk.AssetHierarchySpreadsheet schema name 'RSD_RR_AHS' {

  /**
   * A {@link File} object that contains the excel spreadsheet data
   */
  templateExcel: !File

  /**
   * DO NOT MANUALLY POPULATE.
   * This field is intended to be set by the {@link ReliabilitySyntheticData.ReliabilityRisk.DataGenerationJob}
   * that creates this instance.
   */
  job: private ReliabilitySyntheticData.ReliabilityRisk.DataGenerationJob

  /**
   *
   * @return {@link templateExcel} {@link File}. If not present, throws an error.
   */
  excelFile: member function(): !File py

  /**
   * Fetches and cleans the asset hierarchy spreadsheet dataframes from `c3.ReliabilityExcelParser.readAssetHierarchyExcelSpreadsheetGeneric`
   * function and returns a `map` of `{sheet_name: pd.DataFrame}`. Cleaning the failure modes and failure mode recommendations dataframes:
   * renaming columns for expected sensors and diagnostics, and removing unnamed columns.
   *
   * @param file
   *     The excel spreadsheet {@link templateExcel} containing the asset hierarchy data.
   * @return
   *     A map where keys are sheet names (strings) and values are Data objects
   *     containing the corresponding DataFrames read from each sheet.
   */
  readAssetHierarchyExcelSpreadsheet: inline function(
    file: !File
  ): native py-data-excel

  /**
   * Given a python dictionary whose keys represent the name of the excel sheets and the values
   * are pandas dataframes holding data for that sheet, this function will write the data to an
   * excel file and return the {@link File} object.
   * @param data
   *        A map of string to pandas dataframe. Allowed keys of the map are:
   *        `REL_Asset_Hierarchy`, `Expected_Sensors`, `ExpSensors_Diag_FailureModes`,
   *        `FailureModes_to_RecActions`, `Sensor_Measurement_Bounds`, `Time_Range`,
   *        and `Events`.
   * @param outputPath
   *        The data will be stored as an excel spreadsheet {@link File}. This parameter
   *        specifies the full filename, including the filepath.
   * @return an excel spreadsheet {@link File}.
   */
  writeAssetHierarchyExcelSpreadsheet: private inline function(
    data: !map<string, native>,
    outputPath: !string
  ): File py-data-excel

  /**
   * Given the `REL_Asset_Hierarchy` pandas dataframe after calling
   * {@link readAssetHierarchyExcelSpreadsheet}, this function will return the
   * maximum depth of the template defined in that sheet.
   *
   * Returns the max of `L0, L1, L2, L3` --> In this case, `3`.
   *
   * @param df
   *        The asset hierarchy dataframe.
   * @return The maximum depth of the template.
   */
  getMaxDepthOfTemplateFromAssetHierarchyDataframe: inline private function(
    df: !native
  ): !int py-data-excel

  /**
   * Given the `REL_Asset_Hierarchy` pandas dataframe after calling
   * {@link readAssetHierarchyExcelSpreadsheet}, this function will return the
   * maximum depth of the hierarchy defined in that sheet.
   *
   * Returns the max of `Customer L0 ID, Customer L1 ID, Customer L2 ID` --> In this case, `2`.
   *
   * @param df
   *        The asset hierarchy dataframe.
   * @return The maximum depth of the hierarchy.
   */
  getMaxDepthOfHierarchyFromAssetHierarchyDataframe: inline private function(
    df: !native
  ): !int py-data-excel

  /**
   * Given an excel {@link File} object, validates if the data in the different sheets are all
   * valid. If incorrect data are found, then helpful messages are returned to guide the user to
   * rectify these mistakes. Returns a map, whose keys are the sheet names in the excel file and
   * values are prescriptive error messages.
   *
   * @param file
   *        The Excel file to validate.
   * @return A map from sheet names to error messages.
   */
  validate: function(
    file: !File
  ): map<string, string> py-data-excel

  /**
   * Runs the {@link validate} function and if no error messages are returned for ALL sheets, then
   * returns true, else returns false.
   * This function is called inside the {@link beforeCreate} of this Type so that every persisted object
   * is guaranteed to represent a valid excel file.
   *
   * @param file
   *        The Excel file to validate.
   * @return True if the file is valid, false otherwise.
   */
  isValidExcel: function(
    file: !File
  ): !boolean py-data-excel

  beforeCreate: ~ py-data-excel

  /**
   * Helper function to construct `this` object from an excel {@link File}
   *
   * @param file
   *        The Excel file to construct the object from.
   * @return The constructed AssetHierarchySpreadsheet object.
   */
  fromExcel: function(
    file: !File
  ): mixing ReliabilitySyntheticData.ReliabilityRisk.AssetHierarchySpreadsheet py-data-excel

  beforeRemove: ~ py

  /**
   * To help with the easy generation of "at-scale" datasets, users can call this function
   * on an asset hierarchy excel file, which represents just one system/facility and
   * generate thousands of replica systems/facilities by running this function.
   *
   * @param file
   *        The Excel file to replicate.
   * @param intrafacilityReplicationFactor
   *        The factor for replicating within facilities.
   * @param interfacilityReplicationFactor
   *        The factor for replicating across facilities.
   * @return The replicated Excel file.
   */
  replicateAssetHierarchyExcelSpreadsheet: function(
    file: !File,
    intrafacilityReplicationFactor: !int,
    interfacilityReplicationFactor: !int
  ): !File py-data-excel

  /**
   * To help with the easy generation of "at-scale" datasets, users can call this function
   * from a template object, which represents just one system/facility and generate thousands
   * of replica systems/facilities by running this function.
   *
   * @param intrafacilityReplicationFactor
   *        The factor for replicating within facilities.
   * @param interfacilityReplicationFactor
   *        The factor for replicating across facilities.
   * @return The replicated AssetHierarchySpreadsheet object.
   */
  replicate: member function(
    intrafacilityReplicationFactor: !int,
    interfacilityReplicationFactor: !int
  ): !mixing ReliabilitySyntheticData.ReliabilityRisk.AssetHierarchySpreadsheet py-data-excel

  /**
   * This function returns the independent batches in the asset hierarchy excel
   * spreadsheet file, where a batch represents the atomic unit for which data may be
   * generated independent of how data is generated for other batches.
   *
   * @param file
   *        The Excel file to get batches from.
   * @param numberOfExternalSensorsPerAsset
   *        The number of external sensors per asset.
   * @return List of batch information.
   */
  getBatches: private function(
    file: !File,
    numberOfExternalSensorsPerAsset: int = 0
  ): [json] py-data-excel

  /**
   * This function returns the number of independent batches in the asset hierarchy excel
   * spreadsheet file, where a batch represents the atomic unit for which data may be
   * generated independent of how data is generated for other batches.
   *
   * @param file
   *        The Excel file to count batches from.
   * @param numberOfExternalSensorsPerAsset
   *        The number of external sensors per asset.
   * @return The number of batches.
   */
  numberOfBatches: private function(
    file: !File,
    numberOfExternalSensorsPerAsset: int = 0
  ): !int py-data-excel

  /**
   * For every batch returned by {@link getBatches}, this function will extract the relevant
   * portions of the large, replicated asset hierarchy excel spreadsheet such that data may
   * then be generated on just the information present in the subset excel spreadsheet, returned
   * as a map of pandas dataframes, similar to {@link readAssetHierarchyExcelSpreadsheet}.
   *
   * @param file
   *        The Excel file to read from.
   * @param intrafacilityBatch
   *        The intrafacility batch number.
   * @param interfacilityBatch
   *        The interfacility batch number.
   * @return A map of sheet names to dataframes for the specified batch.
   */
  readAssetHierarchyExcelSpreadsheetForBatch: private inline function(
    file: !File,
    intrafacilityBatch: !int,
    interfacilityBatch: !int
  ): native py-data-excel

  /**
   * Returns an array of all external sensor ids, generated for all assets across all facilities
   * present in the asset hierarchy excel spreadsheet file.
   *
   * @param file
   *        The Excel file to get external sensors from.
   * @param numberOfExternalSensorsPerAsset
   *        The number of external sensors per asset.
   * @return List of external sensor IDs.
   */
  getAllExternalSensors: private function(
    file: !File,
    numberOfExternalSensorsPerAsset: int = 0
  ): [string] py-data-excel

  /**
   * Returns the external sensor ids for only the specified batch, i.e., a subset of the excel
   * spreadsheet. See {@link getBatches} for more information on what a batch is.
   *
   * @param file
   *        The Excel file to get external sensors from.
   * @param intrafacilityBatch
   *        The intrafacility batch number.
   * @param interfacilityBatch
   *        The interfacility batch number.
   * @param numberOfExternalSensorsPerAsset
   *        The number of external sensors per asset.
   * @return List of external sensor IDs for the specified batch.
   */
  getExternalSensorsForBatch: private function(
    file: !File,
    intrafacilityBatch: !int,
    interfacilityBatch: !int,
    numberOfExternalSensorsPerAsset: int = 0
  ): [string] py-data-excel

  /**
   * From the asset hierarchy excel spreadsheet file, generate a csv {@link File} with
   * the schema of {@link CanonicalPointPhysicalMeasurementSeries}.
   *
   * @param file
   *        The Excel file to generate data from.
   * @param numberOfExternalSensorsPerAsset
   *        The number of external sensors per asset.
   * @param folderPath
   *        The folder path to save the generated CSV file.
   * @return The generated CSV file.
   */
  generateCanonicalPpmsData: function(
    file: !File,
    numberOfExternalSensorsPerAsset: !int,
    folderPath: !string
  ): !File py-data-excel

  /**
   * From the asset hierarchy excel spreadsheet file, generate a csv {@link File} with
   * the schema of {@link CanonicalReliabilityAssetEvent}.
   *
   * @param file
   *        The Excel file to generate data from.
   * @param folderPath
   *        The folder path to save the generated CSV file.
   * @return The generated CSV file.
   */
  generateCanonicalEventsData: function(
    file: !File,
    folderPath: !string
  ): !File py-data-excel

  /**
   * Given a start and end datetimes and a {@link Duration} to chunk them by, this function
   * will return an array of `(chunk_start, chunk_end)` tuples where the `chunk_end` of one
   * tuple will be the `chunk_start` of the next. And so on, until `end` is reached.
   *
   * @param start
   *        The start datetime.
   * @param end
   *        The end datetime.
   * @param chunkDuration
   *        The duration to chunk the time range by.
   * @return Array of (chunk_start, chunk_end) tuples.
   */
  generateTimeRangeChunks: private inline function(
    start: !datetime,
    end: !datetime,
    chunkDuration: !Duration
  ): !native py

  /**
   * Given the `Events` pandas dataframe for one asset, this function will remove any duplicated
   * time ranges where there could be more than one failure mode. If there are overlapping time
   * ranges, this function will collapse them into one time range, as well.
   *
   * @param df_events
   *        The events dataframe for one asset.
   * @return A pandas dataframe where the events are deduplicated.
   */
  dedupEventsForAsset: private inline function(
    df_events: !native
  ): !native py-data

  /**
   * Given the `Events` pandas dataframe for all assets, this function will remove any duplicated
   * time ranges where there could be more than one failure mode. If there are overlapping time
   * ranges, this function will collapse them into one time range, as well. Returns a pandas
   * dataframe where the events are deduplicated. For every unique asset, this function
   * calls {@link dedupEventsForAsset}.
   *
   * @param df_events
   *        The events dataframe for all assets.
   * @param max_depth_of_hierarchy
   *        The maximum depth of the asset hierarchy.
   * @return The deduplicated events dataframe.
   */
  getDedupedEvents: private inline function(
    df_events: !native,
    max_depth_of_hierarchy: !int
  ): !native py-data

  /**
   * Return a list of all events in the specified time range.
   *
   * @param df_events
   *        The events dataframe.
   * @param start
   *        The start datetime.
   * @param end
   *        The end datetime.
   * @return The filtered events dataframe.
   */
  getEventsInTimeRange: private inline function(
    df_events: !native,
    start: !datetime,
    end: !datetime
  ): !native py-data

  /**
   * For a specified time range of chunkDuration length, divide it up into smaller time ranges of normal
   * and abnormal asset operation based on the `Events` tab in the excel spreadsheet.
   *
   * @param start
   *        The start datetime.
   * @param end
   *        The end datetime.
   * @param df_events
   *        The events dataframe.
   * @return Array of time range chunks with failure mode information.
   */
  getSubsetTimeRangesWithFailureModeInTimeRange: private inline function(
    start: !datetime,
    end: !datetime,
    df_events: !native
  ): !native py-data

  /**
   * Divide the overall time range specified in the `Time_Range` tab of the excel spreadsheet
   * into chunks of `chunkDuration` length and for each `chunkDuration`, further sub-divide it
   * into smaller time ranges of normal and abnormal asset operation based on the `Events` tab
   * in the excel spreadsheet by calling {@link getSubsetTimeRangesWithFailureModeInTimeRange}
   * for each `chunkDuration` time range.
   *
   * @param df_time_range
   *        The time range dataframe.
   * @param chunkDuration
   *        The duration to chunk the time range by.
   * @param df_events
   *        The events dataframe.
   * @param max_depth_of_hierarchy
   *        The maximum depth of the asset hierarchy.
   * @return Array of time range chunks with failure mode information.
   */
  getSubsetTimeRangesWithFailureModesForOverallTimeRange: private inline function(
    df_time_range: !native,
    chunkDuration: !Duration,
    df_events: !native,
    max_depth_of_hierarchy: !int
  ): !native py-data

  /**
   * Get the lower and upper bounds of normal sensor values for every sensor.
   * This information is extracted from the `Sensor_Measurement_Bounds` tab
   * of the excel spreadsheet.
   *
   * @param df_sensor_measurement_bounds
   *        The sensor measurement bounds dataframe.
   * @return The normal sensor bounds.
   */
  getNormalSensorBounds: private inline function(
    df_sensor_measurement_bounds: !native
  ): any py-data

  /**
   * Given a failure mode, return the abnormal sensor bounds for that failure mode
   * based on information in the `Sensor_Measurement_Bounds` tab of the excel spreadsheet.
   *
   * @param df_sensor_measurement_bounds
   *        The sensor measurement bounds dataframe.
   * @param df_failure_modes
   *        The failure modes dataframe.
   * @param df_asset_hierarchy
   *        The asset hierarchy dataframe.
   * @param failure_mode
   *        The failure mode to get bounds for.
   * @return The abnormal sensor bounds for the failure mode.
   */
  getAbnormalSensorBoundsForFailureMode: private inline function(
    df_sensor_measurement_bounds: !native,
    df_failure_modes: !native,
    df_asset_hierarchy: !native,
    failure_mode: !string
  ): any py-data

  /**
   * For all failure modes, return the abnormal sensor bounds for that failure mode
   * based on information in the `Sensor_Measurement_Bounds` tab of the excel spreadsheet.
   *
   * @param df_sensor_measurement_bounds
   *        The sensor measurement bounds dataframe.
   * @param df_failure_modes
   *        The failure modes dataframe.
   * @param df_asset_hierarchy
   *        The asset hierarchy dataframe.
   * @return The abnormal sensor bounds for all failure modes.
   */
  getAbnormalSensorBoundsForFailureModes: private inline function(
    df_sensor_measurement_bounds: !native,
    df_failure_modes: !native,
    df_asset_hierarchy: !native
  ): any py-data

  /**
   * Specified a time range, generate the time series data for asset sensors.
   * This time series data will be in accordance with the normal sensor measurement
   * bounds specified in the `Sensor_Measurement_Bounds` tab of the excel spreadsheet.
   *
   * @param sensor_ids
   *        The list of sensor IDs.
   * @param start
   *        The start datetime.
   * @param end
   *        The end datetime.
   * @param frequency
   *        The frequency of the time series data.
   * @param sensor_bounds
   *        The sensor bounds data.
   * @param window_len
   *        The window length for data generation.
   * @return The generated sensor time series data.
   */
  generateSensorTimeSeriesDataInTimeRange: private inline function(
    sensor_ids: ![string],
    start: !datetime,
    end: !datetime,
    frequency: !string,
    sensor_bounds: any,
    window_len: int = 15
  ): !native py-data-science

  /**
   * Specified a time range, generate the time series data for any external sensors, if
   * specified.
   *
   * @param external_sensor_ids
   *        The list of external sensor IDs.
   * @param df_sensors
   *        The sensors dataframe.
   * @param target_sensor
   *        The target sensor.
   * @return The generated external sensor time series data.
   */
  generateExternalSensorTimeSeriesDataInTimeRange: private inline function(
    external_sensor_ids: ![string],
    df_sensors: !native,
    target_sensor: !string
  ): !native py-data-science

  /**
   * From the data returned by {@link generateSensorTimeSeriesDataInTimeRange} and the
   * specified failure mode, adjust the distribution of relevant sensors for that failure
   * mode to a range of values as specified in the `Sensor_Measurement_Bounds` tab of
   * the excel spreadsheet.
   *
   * @param df
   *        The sensor data dataframe.
   * @param expected_sensor_to_sensor_id
   *        The mapping from expected sensors to sensor IDs.
   * @param abnormal_sensor_bounds_for_failure_mode
   *        The abnormal sensor bounds for the failure mode.
   * @return The adjusted sensor data for the failure mode.
   */
  adjustSensorDataForFailureMode: private inline function(
    df: !native,
    expected_sensor_to_sensor_id: native,
    abnormal_sensor_bounds_for_failure_mode: native
  ): !native py-data-science

  /**
   * Given the asset hierarchy excel spreadsheet file, generate the time series data
   * for asset sensors and any external sensors, if specified, for the entire time
   * range. The asset sensor time series values will be in accordance with their bounds
   * and the failure modes that occur in time ranges specified in the excel spreadsheet.
   *
   * @param spec
   *        The specification for generating point measurement data.
   * @return The list of generated files.
   */
  generateHistoricalCanonicalPointMeasurementDataForBatch: function(
    spec: ReliabilitySyntheticData.ReliabilityRisk.AssetHierarchySpreadsheet.GeneratePointMeasurementSpec
  ): !FileList py-data-science-excel
}
