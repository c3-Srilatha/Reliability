/**
 * This type enables specifying configurable parameters for initializing the {@link ReliabilitySparePartsSimilarityJob} BatchJob.
 */
type ReliabilitySparePartsSimilarityJobSpec mixes Spec {
    /**
     * Represents the projection that is passed to evaluate
     */
    projection: !string

    /**
     * Represents the batch size for {@link ReliabilitySparePartsSimilarityJob}
     */
    batchSize: int

    /**
     * Represents the filter for getting unique tuples
     */
    filter: string

    /**
     * Represents the limit that is passed to evaluate
     */
    limit: int = -1

    /**
     * Represents an array of fields used for getting unique projections
     */
    fields: [string]
}
