/**
 * Enum type for part status in {@link WorkOrder}
 */
enum type WorkOrderPartStatusEnum {

  /**
   * Insufficient parts to complete the work order enum field.
   */
  insufficientParts = 'Insufficient Parts'

  /**
   * Sufficient parts to complete the work order enum field.
   */
  sufficientParts = 'Sufficient Parts'

  /**
   * No parts needed to complete the work order enum field.
   */
  noPartsNeeded = 'No Parts Needed'
}
