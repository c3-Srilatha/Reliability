/**
 * @inheritdoc
 */
remix type WorkOrder mixes FilterableByFacility {

  /**
   * {@link ReliabilityAsset} associated with the work order.
   */
  parent: !ReliabilityAsset

  /**
   * {@link User} who has been assigned to perform this work order.
   */
  assignee: User

  /**
   * {@link User} who created this work order.
   * Calculated by piping `meta.createdBy` through {@link ReliabilityExpressionEngineFunction#userInformation}.
   */
  createdBy: User calc userInformation(meta.createdBy)

  /**
   * The status of the WorkOrder. Enumerated via {@link WorkOrderStatusEnum}.
   * Defaults to {@link WorkOrderStatusEnum#CREATED}.
   */
  status: string enum WorkOrderStatusEnum = CREATED

  /**
   * A translated representation of {@link WorkOrder#status} to be used in the UI.
   */
  displayStatus: string translate by status

  /**
   * The status of the parts for the WorkOrder. Enumerated via {@link WorkOrderPartStatusEnum}
   */
  partStatus : string enum WorkOrderPartStatusEnum

  /**
   * A translated representation of {@link WorkOrder#partStatus} to be used in the UI.
   */
  uiPartStatus: string translate by partStatus

  /**
   * The date that the work order is due.
   */
  workDueDate: datetime

  /**
   * The priority of the work order.
   */
  priority: string

  /**
   * The maintenance cost of the work order (worker cost + plant loss + parts cost)
   */
  workOrderCost: MonetaryValue

  /**
   * Functional location that ensures connection between work order and subsystem.
   */
  functionalLocation: string

  /**
   * Type of the maintenance activity of this work order.
   */
  maintActivityType: string enum('Predictive', 'Corrective')

  /**
   * Symptom code of the work order to help understand root cause.
   */
  symptomCode: string

  /**
   * Apparent cause of the work order to help understand root cause.
   */
  apparentCause: string

  /**
   * Cause text of the work order to help understand root cause.
   */
  causeText: string

  /**
   * Coding that includes text field to help understand the root cause.
   */
  codingIncludingTextField: string

  /**
   * Reference to {@link Item} for maintenance in this work order.
   */
  maintItem: Item

  /**
   * Total cost of activity to identify importance of the work order.
   */
  totalActCosts: decimal

  /**
   * Description according to the priority code.
   */
  priorityDescription: string

  /**
   * Date time when work order was requested.
   */
  requiredStartDatetime: datetime

  /**
   * The priority field that is populated directly from customer data source.
   * We don't know what values would be in here so we don't use enum field of priority. DS team will decide how to map this field to priority.
   */
  workOrderPriority: string

  /**
   * The list of parts associated with this work order tied to {@link InventorySeries}.
   * The structure is a map, with the {@link InventorySeries} id as the key and the quantity as the value.
   */
  partsList: map<string, int>

  /**
   * The list of parts associated with this work order tied to {@link InventorySeries}.
   * The structure is a map, with the {@link InventorySeries} id as the key and the quantity avaliable
   * at the time the work order is to be executed as the value.
   */
  partsListInventory: map<string, int>

  /**
   * The failure mode for this work order, if applicable.
   * This should come from the `name` field in {@link FailureMode}.
   */
  failureMode: string

  /**
   * This is the preventive maintenance type for this work order, if applicable.
   */
  preventiveMaintenanceType: string

  /**
   * The list of similar work orders tied to this work order from {@link WorkOrderSimilarityPredictions}.
   */
  workOrderSimilarity: [WorkOrderSimilarityPredictions](parent)

  /**
   * The list of similar parts from work orders tied to this work order from {@link WorkOrderPartsSimilarityPredictions}.
   */
  workOrderPartsSimilarity: [WorkOrderPartsSimilarityPredictions](parent)

  /**
   * Updates work order and parts similarity predictions by starting a {@link ReliabilitySparePartsSimilarityJob} BatchJob.
   */
  updateSimilarityPredictions: function(spec: ReliabilitySparePartsSimilarityJobSpec) py

  /**
   * Retrieves and evaluates the parts list and inventory status associated with the work order specified via id.
   * The `fetchSpec` parameter is propogated onto {@link WorkOrderPartsDenormalized}.
   * The returned json is very much identical to {@link FetchResult} and has the following format:
   *```json
   * {
   *   "objs": [
   *   {
   *     "partNumber": ...,
   *     "cost": ...,
   *     "description": ...,
   *     "supplier": ...,
   *     "quantity": ...,
   *     "inventory": ...,
   *     "workOrderDate": ..,
   *   }
   * ]
   *   "count": ...,
   *   "totalCount": ...,
   *   "hasMore": true/false
   * }
   *```
   * Each object's information is populated from {@link WorkOrderPartsDenormalized} filtered for `workOrderId` passed in.
   */
  getPartsList: function(workOrderId: string, spec: FetchSpec): json py

  /**
   * Retrieves and evaluates the parts list and inventory status associated with the specified work order.
   * The `spec` parameter is propagated onto {@link WorkOrderPartsSimilarityPredictions} as {@link FetchSpec}. Only `limit` and `offset` are respected.
   * The returned json is very much identical to {@link FetchResult} and has the following format:
   *```json
   * {
   *   "objs": [
   *   {
   *     "id": ...,
   *     "partNumber": ...,
   *     "cost": ...,
   *     "name": ...,
   *     "supplier": ...,
   *     "inventory": ...,
   *     "workOrderDate": ..,
   *   }
   * ]
   *   "count": ...,
   *   "totalCount": ...,
   *   "hasMore": true/false
   * }
   *
   * Each object's information is populated from a part's {@link InventorySeries} which is evaluated to be similar to.
   */
  getSimilarPartsByIds: function(workOrderId: string, partIds: string, spec: FetchSpec): json py

  /**
   * Retrieves statistics related to work orders, including the total count of work orders,
   * the count of work orders with insufficient parts, and the count of work orders with
   * no parts list.
   */
  getWorkOrderStatistics: function(facilityIds: string): json py

  /**
   * function retrieves work orders similar to workOrderId based on specified criteria.
   */
  getSimilarPartsForWorkOrder: function(workOrderId: string, spec: FetchSpec): json py

  /**
   * Returns the `totalCount` of parts returned from {#getPartsList}.
   */
  getPartsListCount: function(workOrderId: string, spec: FetchSpec): int py

  /**
   * Returns the `totalCount` of work orders returned from {#getSimilarPartsForWorkOrder}.
   */
  getSimilarPartsForWorkOrderCount: function(workOrderId: string, spec: FetchSpec): int py

  /**
   * Returns the projected inventory based on {@link WorkOrderPartsForecast}
   */
  getProjectedInventory: function(workOrderId: string, partId: string): int py

  /**
   * Retrieves similar {@link WorkOrder}s for a given Part ID and Work Order ID.
   * Only `limit` and `offset` are respected.
   * The returned json is very much identical to {@link FetchResult} and has the following format:
   *```json
   * {
   *   "objs": [
   *   {
   *     "id": ...,
   *     "description": ...,
   *     "workEndDate": ...,
   *     "comments": ...,
   *   }
   * ]
   *   "count": ...,
   *   "totalCount": ...,
   *   "hasMore": true/false
   * }
   *
   * Each object's information is populated from {@link WorkOrder}s similar to the {@link WorkOrder} whose id is `workOrderId`.
   */
  getSimilarWorkOrders: function(partId: string, workOrderId: string, spec: FetchSpec): json py

  /**
   * Returns the `totalCount` of work orders returned from {#getSimilarWorkOrders}.
   */
  getSimilarWorkOrdersCount: function(partId: string, workOrderId: string, spec: FetchSpec): int py

  /**
   * After update will create the denormalized view of the work order parts
   * by placing the new records from a Work order parts list modification into
   * {@link WorkOrderPartsDenormalized}.
   */
  @dependency(include='partsList, partsListInventory')
  afterUpdate: ~ js-rhino

  /**
  * After remove will remove the {@link WorkOrderPartsDenormalized} instances
  * associated with the {@link WorkOrder}s after they are deleted.
  */
  afterRemove: ~ js-rhino

  /**
   * Updates parts forecast by starting a {@link ReliabilitySparePartsForecastJob} BatchJob.
   */
  updateWorkOrderPartsForecast: function(options: ReliabilitySparePartsForecastJobOptions) py

  /**
   * The creation date for the workorder, to be used in UI.
   */
  creationDate: datetime stored calc exists(timestamp) ? timestamp : meta.created

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["parent.facility"]
}
