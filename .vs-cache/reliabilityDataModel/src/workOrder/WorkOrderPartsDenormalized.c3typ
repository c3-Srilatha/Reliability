/**
 * This is a denormalized view of all work orders and parts.
 * It lists row by row the parts associated with a unique work order.
 */
@db(index+=['part', 'workOrder, part', 'part, workOrderDate, priorityInt, partName, cost, supplier, description'])
entity type WorkOrderPartsDenormalized schema name 'WOPD' {

  /**
   * The {@link WorkOrder} assocaited with the {@link #part}.
   */
  workOrder: WorkOrder

  /**
   * The {@link InventorySeries} associated with the {@link #workOrder}.
   */
  part: InventorySeries

  /**
   * The quantity of the {@link #part} used in the {@link #workOrder}.
   */
  quantity: int

  /**
   * The expected/required start date of the {@link WorkOrder}
   * deduced from workOrder.requiredStartDatetime
   */
  requiredStartDate: datetime stored calc workOrder.requiredStartDatetime

  /**
   * The start date of the {@link #workOrder}.
   */
  workOrderDate: datetime stored calc workOrder.workStartDate

  /**
   * The end date of the {@link WorkOrder}.
   */
  workOrderEndDate: datetime stored calc workOrder.workEndDate

  /**
   * The status of the {@link WorkOrder}.
   */
  workOrderStatus: WorkOrderStatusEnum stored calc workOrder.status

  /**
   * The priority of the {@link #workOrder} in a numeric version to use for the
   * sorting of work orders used for forecasting predictions.
   */
  priorityInt: int stored calc workOrder.workOrderPriority == 'HIGH' ? 1 : workOrder.workOrderPriority == 'MEDIUM' ? 2 : workOrder.workOrderPriority == 'LOW' ? 3 : 4

  /**
   * The unique identifier of the persisted {#part}.
   */
  partId: string stored calc part.id

  /**
   * The name of the part
   */
  partName: string stored calc part.partName

  /**
   * The cost of the part
   */
  cost: double stored calc part.cost

  /**
   * A description of the part
   */
  description: string stored calc part.description

  /**
   * The supplier of the part
   */
  supplier: string stored calc part.supplier

  /**
   * The number of the part
   */
  partNumber: string stored calc part.partNumber
}
