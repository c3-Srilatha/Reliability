/**
 * This is a prediction for similar work order in an {@link WorkOrder} to other {@link WorkOrder}s
 * and their associated parts.
 */
@db(unique=['parent, similarWorkOrder, part'])
entity type WorkOrderSimilarityPredictions mixes FilterableByFacility schema name 'WOSP' {

/**
 * The {@link WorkOrder} for which the prediction is made.
 */
parent: !WorkOrder

/**
 * The similar {@link WorkOrder} for which the prediction is made.
 */
similarWorkOrder: !WorkOrder

/**
 * The {@link InventorySeries} which is a unique object for a part.
 * This is tied back to the {@link #similarWorkOrder}
 */
part: !InventorySeries

/**
 * The quantity of the {@link #part} used by {#similarWorkOrder}.
 */
quantity: int

/**
 * @inheritdoc
 */
facilityFilterPaths: const ~ = ["parent.parent.facility"]
}
