/**
 * Log to store updates that happen during {@link ReliabilitySparePartsForecastJob} to `WorkOrder#partsListInventory`
 */
entity type WorkOrderUpdateLog {
    /**
     * ID of the {@link WorkOrder}
     */
    workOrderId: !string

    /**
     * Represents the `InventorySeries#id`
     */
    partId: !string

    /**
     * Represents the updated `WorkOrder#partsListInventory` for the above `partId`
     */
    quantity: !int
}
