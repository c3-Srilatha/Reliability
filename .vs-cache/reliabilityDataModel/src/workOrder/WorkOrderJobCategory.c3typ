/**
 * Type used to populate work order type through UI.
 */
entity type WorkOrderJobCategory schema name 'WOJC' {

  /**
   * The name used to populate {@link WorkOrder#workOrderType} through the UI.
   */
  name: ~

  /**
   * Translated {@link WorkOrderJobCategory#id}, to be used in the UI.
   */
  displayName: string translate by id
}
