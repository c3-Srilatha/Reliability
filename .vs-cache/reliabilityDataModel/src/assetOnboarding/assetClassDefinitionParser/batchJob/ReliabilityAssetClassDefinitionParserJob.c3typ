/**
 * Given {@link ReliabilityAssetClassDefinitionParserJobOptions}, this job will parse multiple {@link ReliabilityAssetClassDefinitionVersion}s
 * and create {@link AssetClass}es from them.
 */
entity type ReliabilityAssetClassDefinitionParserJob extends BatchJob<ReliabilityAssetClassDefinitionParser, ReliabilityAssetClassDefinitionParserJobOptions, ReliabilityAssetClassDefinitionVersion> mixes Singleton type key 'REL_ASST_CLS_DEF_PSRR' {
  doStart: ~ py

  processBatch: ~ py

  /**
   * The results generated by each call of {@link #processBatch}.
   */
  results: [ReliabilityAssetClassDefinitionParserJobBatchResult](job)

  /**
   * Gets all the successful {@link #results} with a given trackingId.
   *
   * @param trackingId
   *        The tracking ID to filter results by.
   * @return List of successful batch results.
   */
  getSuccessResults: member function(trackingId: !string): [ReliabilityAssetClassDefinitionParserJobBatchResult] js-rhino

  /**
   * Gets all the failed {@link #results} with a given trackingId.
   *
   * @param trackingId
   *        The tracking ID to filter results by.
   * @return List of failed batch results.
   */
  getFailResults: member function(trackingId: !string): [ReliabilityAssetClassDefinitionParserJobBatchResult] js-rhino

  /**
   * Removes all the {@link #results} with a given trackingId.
   *
   * @param trackingId
   *        The tracking ID of the results to remove.
   */
  cleanupResults: function(trackingId: !string) js-rhino
}
