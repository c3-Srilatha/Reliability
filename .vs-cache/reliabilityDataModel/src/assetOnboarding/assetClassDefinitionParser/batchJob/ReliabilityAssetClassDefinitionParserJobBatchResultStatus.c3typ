/**
 * Represents whether the job batch result was successful or not.
 */
enum type ReliabilityAssetClassDefinitionParserJobBatchResultStatus {

  /**
   * Indicates that the job batch result was successful.
   */
  SUCCESS = 'success',

  /**
   * Indicates that the job batch result failed.
   */
  FAIL = 'fail'
}
