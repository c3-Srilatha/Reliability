/**
 * Parser for the AssetClassDefinition files stored in the `resource/AssetClassDefinition/<version>` directories.
 * When parsing these files, a hierarchy of {@link AssetClass}es, {@link ExpectedSensor}s, and Failure Modes are created.
 */
type ReliabilityAssetClassDefinitionParser mixes Value {
  /**
   * @return The id prefix to give the parent {@link AssetClass}es generated by this parser.
   */
  getParentClassIdPrefix: inline function(): string py

  /**
   * Gets the workflow that is used to run the parser. Creates it if it doesn't already exist. The workflow
   * feeds options to the {@link ReliabilityAssetClassDefinitionParserJob} and waits for it to complete. Then it
   * fetches the results for use as {@link Workflow.Run#executionResults} and deletes these results from the db.
   *
   * @return The workflow used to run the parser.
   */
  getWorkflow: inline function(): Workflow js-rhino

  /**
   * Gets the latest results from the workflow that was used to run the parser. This function will return the
   * {@link Workflow.Run#executionResults} of the latest run of the workflow. This will be a JSON object with two keys
   * `successfulResults` and `failedResults`,
   * which contain {@link ReliabilityAssetClassDefinitionParserJobBatchResult}s
   *
   * @return JSON object containing successful and failed results from the latest workflow run.
   */
  getLatestResults: function(): json js-rhino

  /**
   * This function assumes that the file name follows " - " in the file name.
   * @param file
   *        The file to pull the name from
   * @return The {@link AssetClass} to create based on the name of the given file.
   */
  extractParentClassFromDefinitionFile: inline function(file: File): AssetClass py

  /**
   * This function assumes that the semantic version is the name of the directory the file is in.
   *
   * @return the semantic version of the given file
   */
  extractSemanticVersionFromDefinitionFile: inline function(): string py

  /**
   * Based on the `resource/{srcFolder}` directory, returns the best versions for
   * parent {@link AssetClass} that is defined by some AssetClassDefinition file.
   * This function assumes that the names of each {@link AssetClass} is unique.
   * @param srcFolder
   *       The directory to search for AssetClassDefinition files. If not specified, the default is "AssetClassDefinition".
   * @return The latest semantic version definition for each parent {@link AssetClass}.
   */
  fetchBestParentClassVersions: function(srcFolder: string): [ReliabilityAssetClassDefinitionVersion] py

  /**
   * Starts the parser to parse the `AssetClassDefinition` files in the `resource/<srcFolder>/<version>`
   * directories - see {@link ReliabilityAssetClassDefinitionParserSpec#srcFolder}.
   * Utilizes {@link ReliabilityAssetClassDefinitionParserJob} to do the actual parsing, and
   * stores and cleans up its results in a {@link Workflow.Run} for ease of access and to minimize db usage.
   * The input given to {@link ReliabilityAssetClassDefinitionParserJob} is the output of
   * {@link fetchBestParentClassVersions} and the {@link ReliabilityAssetClassDefinitionParserSpec#shouldOverwrite}
   * parameter.
   *
   * After the run has completed, the results can be accessed using `run.executionResults()`.
   * This will return a map with keys `successfulResults` and `failedResults`, which contain the
   * {@link ReliabilityAssetClassDefinitionParserJobBatchResult}s from the
   * {@link ReliabilityAssetClassDefinitionParserJob} that was executed.
   *
   * @param inputs
   *        The specification defining the workflow's input parameters.
   * @return A workflow run that contains the results and status of parsing.
   */
  start: function(inputs: ReliabilityAssetClassDefinitionParserSpec): Workflow.Run js-rhino
}
