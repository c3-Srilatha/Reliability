/**
 * Represents a version of an AssetClassDefinition. The actual data to persist
 * is stored entirely within the `file` field.
 */
type ReliabilityAssetClassDefinitionVersion {
  /**
   * The {@link AssetClass} that will be persisted by this version. Children {@link AssetClass}es
   * , {@link ExpectedSensor}s, and Failure Modes will be persisted as well.
   */
  assetClass: !AssetClass

  /**
   * The version of this definition.
   */
  semanticVersion: !string

  /**
   * The file object that contains the data to persist.
   * This file must be a `csv` file, since Excel files need a runtime installation before processing.
   */
  file: !Pkg.File

  /**
   * Persists the data from the file. If the file data has already been persisted, this method will return false.
   * If `shouldOverwrite` is true, then any previous data for the {@link #assetClass} will be removed first.
   * @param shouldOverwrite
   *        If true, any previous data for the {@link #assetClass} will be removed first.
   * @return True if the data was persisted, false if it was already persisted.
   */
  persistVersion: member function (shouldOverwrite: boolean): boolean py

  /**
   * Validates and cleans up the data that has been already persisted for this {@link #assetClass}.
   *
   * @param shouldOverwrite
   *        Whether to overwrite existing data.
   * @return True if data should be persisted, false otherwise.
   */
  validateAndCleanupBeforePersist: inline member function(shouldOverwrite: boolean): boolean py

  /**
   * Cleans up all the data that was persisted previously by some {@link ReliabilityAssetClassDefinitionVersion}
   * of this {@link #assetClass}.
   * Cleans up the {@link FailureModeLibrary} of the persisted asset class as well.
   * Does not delete any {@link ExpectedSensor}s.
   *
   */
  cleanupPersistedVersion: member function () py

  /**
   * Reads the {@link #file} and returns the failure modes, recommended action data, and asset class data.
   *
   * The recommended action data is a dictionary with keys of recommended action text, and value of list
   * of failure modes that this recommended action text pertains to.
   * ```
   * {
   *   'Conduct performance test on blower and assess for lost efficiency': ['Downstream flow restriction', 'Internal wear']
   *   ...
   * }
   * ```
   * The asset class data is a dictionary with keys of asset class name, and value of a dictionary with key
   * {@link ExpectedSensor} name and value of dict containing two keys: `failureModeMapping` and `unitType`.
   * `failureModeMapping` contains a dictionary of failure mode to {@link FailureModeDiagnostic} abbreviations.
   * `unitType` is the unit type for that particular {@link ExpectedSensor}.
   * ```
   * {
   *   'Blower Performance': {
   *     'Compressor dP': {
   *       'unitType': 'Pressure',
   *       'failureModeMapping': {'Process contamination': 'ID', 'Process overheating' : 'D' ...}
   *     },
   *     ...
   *   },
   *   ...
   * }
   *
   * @return Native Python object containing the parsed file data.
   */
  readFile: inline member function (): native py

  /**
   * Given a string that represents the diagnostics for a failure mode, returns a list of {@link FailureModeDiagnostic}
   * ids. In the base implementation, these strings are expected to have format "DI", where I is "Increasing" and D
   * is "Decreasing."
   *
   * @param diagnosticsString
   *        String representing the diagnostics for a failure mode.
   * @return List of FailureModeDiagnostic IDs.
   */
  diagnosticsStringToFailureModeDiagnostics: inline function(diagnosticsString: !string): ![string serialized FailureModeDiagnostic] py

  /**
   * Given a list of children {@link AssetClass}es makes a hierarchy template for the {@link #assetClass}.
   * Results in a 1 level hierarchy, with the root being an instance of {@link #assetClass} and
   * the children being "instantiations" of the children {@link AssetClass}es.
   *
   * @param childAssetClasses
   *        List of child asset classes to include in the hierarchy template.
   * @return The created asset hierarchy template.
   */
  makeHierarchyTemplate: inline member function(childAssetClasses: ![AssetClass]): AssetHierarchyTemplate py
}
