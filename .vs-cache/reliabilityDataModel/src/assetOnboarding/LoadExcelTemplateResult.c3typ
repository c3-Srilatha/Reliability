/**
 * Statistics about the results of the {@link ReliabilityExcelParser#loadExcelTemplate} function.
 * Including the number of assets newly-created, edited, and deleted.
 */
type LoadExcelTemplateResult {

  /**
   * Number of new {@link ReliabilityAsset}s created by the {@link ReliabilityExcelParser#loadExcelTemplate} function.
   */
  numberNew: int

  /**
   * Number of {@link ReliabilityAsset}s edited by the {@link ReliabilityExcelParser#loadExcelTemplate} function.
   */
  numberEdited: int

  /**
   * Number of {@link ReliabilityAsset}s deleted by the {@link ReliabilityExcelParser#loadExcelTemplate} function.
   */
  numberDeleted: int

  /**
   * Entities of assets deleted by the {@link ReliabilityExcelParser#loadExcelTemplate} function.
   * Asset type is based on the {@link ReliabilityAssetOnboardingConfig#assetTypeName}.
   */
  assetsDeleted: [Obj]

  /**
   * Add together two result objects. This will pair up the fields between the two objects and sum each of them.
   *
   * @param other
   *        The other result object to add to this one.
   * @return A new result object with the combined values.
   */
  add: inline member function(other: !LoadExcelTemplateResult): !LoadExcelTemplateResult js-rhino

}
