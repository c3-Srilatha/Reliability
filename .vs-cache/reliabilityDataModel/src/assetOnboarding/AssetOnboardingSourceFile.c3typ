/**
 * Type used to manage asset template spreadsheets and the data generated by them.
 */
entity type AssetOnboardingSourceFile mixes ExemptFromFacilityFilter {

  /**
   * The uploaded Excel file.
   */
  file: !File

  /**
   * Directory which contains all csvs generated by this source file.
   */
  parsedCsvFileDirectory: string

  /**
   * String representing an identifier for the same file being uploaded more than once.
   * Populated with file name alone without directory path.
   */
  fileIndex: !string

  /**
   * Previous versions of this file which have been uploaded before.
   */
  previousVersions: [AssetOnboardingSourceFile](fileIndex, fileIndex)

  /**
   * Removes existing data which originated from a previous version of this source file.
   * @param spec
   *           The spec for removing all entities from a previous version of this source file.
   * @param result
   *           The {@link LoadExcelTemplateResult} to contain the results.
   * @return
   *    The number of type entities based on {@link ReliabilityAssetOnboardingConfig#assetTypeName}.
   *    The type entities removed based on {@link ReliabilityAssetOnboardingConfig#returnAssetsClearedOnExcelReuploads}.
   */
  clearPreviousEntities: member function(spec: RemoveAllSpec, result: !LoadExcelTemplateResult): LoadExcelTemplateResult js-rhino

  /**
   * This API removes all entities uploaded by that specific sourcefile
   * @param deleteSourceFilesWithSameName
   *           This is a flag when set true deletes all the sourceFiles from {@link AssetOnboardingSourceFile} with the same name.
   * @param spec
   *           The spec for removing all entities from a previous version of this source file.
   * @return True if the operation was successful.
   */
  clearUploadedEntities: member function(deleteSourceFilesWithSameName: boolean, spec:RemoveAllSpec): boolean js-rhino

  /**
   * Gets the string to populate the {@link fileIndex} field used to group subsequent Excel files together.
   *
   * @param file
   *        The file to get the index for.
   * @return The file index string.
   */
  getFileIndex: function(file: !File): string js-rhino
}
