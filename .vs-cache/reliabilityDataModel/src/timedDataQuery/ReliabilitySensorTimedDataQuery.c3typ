/**
 * Allows the construction and execution of queries for sensor timeseries data.
 *
 * Usage example:
 * ```
 * // Query sensor timeseries data for specific sensors.
 * ReliabilitySensorTimedDataQuery.make({
 *   sensors: ['sensor1', 'sensor2']
 * }).execute({start: '2020-01-01', end: '2021-01-01', interval: 'QUARTER_HOUR'})
 * ```
 */
type ReliabilitySensorTimedDataQuery mixes ReliabilityTimedDataSubquery<map<string serialized Sensor, Timeseries<any>>> {

  /**
   * The sensors to get timeseries data for.
   */
  sensors: [Sensor]

  execute: ~ js-rhino
}
