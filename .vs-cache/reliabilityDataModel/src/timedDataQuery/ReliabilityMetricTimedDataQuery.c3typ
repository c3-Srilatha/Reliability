/**
 * Allows the construction and execution of queries for {@link ReliabilityMetric}s.
 *
 * Usage example:
 * ```
 * ReliabilityMetricTimedDataQuery.make({
 *   reliabilityMetric: ['metric1', 'metric2']
 * }).execute({start: '2020-01-01', end: '2021-01-01', interval: 'QUARTER_HOUR'})
 * ```
 */
type ReliabilityMetricTimedDataQuery mixes ReliabilityTimedDataSubquery<map<string serialized ReliabilityMetric, Timeseries<any>>> {

  /**
   * The {@link ReliabilityMetric}s to evaluate.
   */
  reliabilityMetrics: ![ReliabilityMetric]

  execute: ~ js-rhino
}
