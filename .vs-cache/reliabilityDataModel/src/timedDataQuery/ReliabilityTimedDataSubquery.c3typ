/**
 * Allows a query of a specific type of timed data to be defined, then executed.
 * This type should be mixed by subquery implementations so that they can be used individiually or
 * as part of a {@link ReliabilityTimedDataQuery}.
 *
 * `R` is the type of the result of the query.
 */
type ReliabilityTimedDataSubquery<R> {

  /**
   * Executes this query
   *  @param timeInfo
   *        Determines the time range and interval for the query. The {@link TimeInfo#timeZone} is ignored, and data
   *        timestamps are not changed after the query is executed.
   * @returns
   *        The result of the query.
   */
  execute: abstract inline member function(timeInfo: !TimeInfo): R

  /**
   * Converts the timeInfo to UTC. Only the {@link TimeInfo#start} and {@link TimeInfo#end} are converted.
   * This should be done before executing any evalMetrics calls.
   *
   * @param timeInfo
   *        The timeInfo to convert.
   * @returns
   *        The converted timeInfo.
   */
  convertTimeInfoRangeToUtc: inline function(timeInfo: !TimeInfo): TimeInfo js-rhino
}
