/**
 * Allows the construction and execution of queries to get Reliability {@link Feature} data. Intended mainly for
 * querying `ReliabilityMlModel` features.
 * Only functions properly for {@link Feature}s with `subjectType` set to {@link ReliabilityAsset}.
 *
 *
 * Note that non metric backed feature evaluation does not support missing data correctly due to platform limits.
 * Missing data is treated as zeros. This means that aggregations can have incorrect values if missing data is
 * present in an aggregation period.
 *
 * To avoid this, use metric backed features, which also have better performance for this function.
 *
 * This query will return the data as a map of feature name to timeseries.
 *
 * Usage Example:
 * ```
 * ReliabilityFeatureTimedDataQuery.make({
 *   targetAsset: 'asset id',
 *   featureNames: ['feature1', 'feature2']
 * }).execute({
 *   startTime: '2023-01-01T00:00:00Z',
 *   endTime: '2023-01-02T00:00:00Z',
 *   interval: 'QUARTER_HOUR',
 * })
 * ```
 */
type ReliabilityFeatureTimedDataQuery mixes ReliabilityTimedDataSubquery<map<string, Timeseries<any>>> {

  /**
   * The {@link ReliabilityAsset} to evaluate the features on.
   */
  targetAsset: !ReliabilityAsset

  /**
   * The names of the {@link Feature}s to evaluate.
   */
  featureNames: !set<string>

  /**
   * Get the data of the given metric backed features.
   * {@link ReliabilityFeatureTimedDataQuery#execute} should be used directly instead of this function.
   *
   * Assumes all `features` are metric backed (`legacy.metric` is populated).
   *
   * @param timeInfo
   *        The time information for the query.
   * @param features
   *        The features to get data for.
   * @return A map from feature name to timeseries data.
   */
  getMetricBackedFeatureData: private inline member function(timeInfo: TimeInfo, features: [Feature]): map<string, Timeseries> py

  /**
   * Get the data of the given features which are ** not ** metric backed.
   * Aggregation is always done using an average.
   * {@link ReliabilityFeatureTimedDataQuery#execute} should be used directly instead of this function.
   * Note that feature evaluation does not support missing data correctly. Missing data is treated as zeros.
   *
   * @param timeInfo
   *        The time information for the query.
   * @param features
   *        The features to get data for.
   * @return A map from feature name to timeseries data.
   */
  getCustomFeatureData: private inline member function(timeInfo: TimeInfo, features: [Feature]): map<string, Timeseries> py

  /**
   * Executes the feature timed data query.
   *
   * @return A map from feature name to timeseries data.
   */
  execute: ~ py
}
