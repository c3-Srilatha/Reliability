/**
 * Type that allows us to go from ReliabilityAssetAlert to the {@link FailureModeRecommendation}(s) associated with it.
 * This type should not be used as is, but should be extended and defined with a specific reference type for the from field.
 */
entity extendable type FailureRecommendationRelation schema name 'SAFRR' {

  /**
   * The failure recommendation of the relation.
   */
  to: !FailureModeRecommendation

  /**
   * The feedbacks of the relation
   */
  @db(order='descending(timestamp)')
  feedbacks: [FailureRecommendationFeedback](parent)

  /**
   * Latest feedback on this {@link FailureModeRecommendation}
   */
  latestFeedback: FailureRecommendationFeedback stored calc feedbacks[0]

  /**
   * Text to be displayed in UI for this {@link FailureModeRecommendation}
   */
  latestFeedbackText: string stored calc latestFeedback ? (latestFeedback.feedback == 0 ? "Not Helpful" : "Helpful") : "Leave Feedback"
}
