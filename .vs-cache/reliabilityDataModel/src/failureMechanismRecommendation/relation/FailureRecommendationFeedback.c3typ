/**
 * Represents feedback on failure recommendations, including rank and parent relationship.
 */
entity extendable type FailureRecommendationFeedback mixes TimedValueHistory<FailureRecommendationRelation>, FailureModeFeedbackTimedValue schema name 'SAFRF' {

  /**
   * The function that adds a {@link FailureRecommendationFeedback} to specified {@link FailureRecommendationRelation}.
   * @param feedback
   *    The rank of associated {@link FailureRecommendationRelation}. 0 - Unhelpful, 2 - Helpful
   * @param parent
   *    The {@link FailureRecommendationRelation} this feedback belongs to. Optional argument because it is not required in old UI.
   * @return
   *     The feedback that will be used to trigger a Card Click Action from UI, used to reshow SubsystemFailureModeRecommendations Modal. It is used in UIAsyncEffectAlertDetailProvideFailureModeFeedback(Not)Useful.js.
   */
  leaveFeedback: function(feedback: !int, parent: !string): !json js-rhino
}
