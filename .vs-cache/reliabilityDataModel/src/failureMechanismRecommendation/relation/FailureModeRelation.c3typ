/**
 * Type that allows us to go from an entity (most commonly, alert or case) to the {@link FailureModeLineItem}s associated with it.
 */
entity extendable type FailureModeRelation schema name 'PHYAST_ALERAT_REL' {

  /**
   * The {@link FailureModeLineItem} related to by this relation.
   */
  to: !FailureModeLineItem

  /**
   * The name of the entity in the from field. Should be implemented as a stored calc in any type extending this type.
   */
  fromName: string

  /**
   * If true, the {@link FailureModeLineItem} is recommended by user.
   * Otherwise, it is recommended by the failure mode reommendation engine.
   */
  userRecommended: boolean

  /**
   * User feedback for the recommendation
   */
  @db(order='descending(timestamp)')
  feedbacks: [FailureModeFeedback](parent)

  /**
   * Most recent feedback for the failure mode
   */
  @db(timedValueHistoryField='feedbacks')
  latestFeedback: FailureModeFeedbackTimedValue

  /**
   * How significant the {@link FailureModeLineItem} is to the {@link FailureModeRelation#fromName} instance.
   */
  significance: double

  /**
   * Displayed text of significance field. Round to 2 decimal precision.
   */
  displaySignificance: double calc round(significance, 2)

  /**
   * Only used to show the icon on the UI.
   * Ranges from -1 to 2.
   * -1: no feedback
   * 0: bad
   * 1: so-so
   * 2: good
   */
  feedbackIcon: private int stored calc exists(latestFeedback) ? latestFeedback.feedback : -1

  /**
   * Text of latest feedback to be displayed in UI. 0 - "Not Helpful", 2 - "Helpful"
   */
  latestFeedbackText: string stored calc latestFeedback ? (latestFeedback.feedback == 0 ? "Not Helpful" : "Helpful") : "-"
}
