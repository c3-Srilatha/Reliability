/**
 * Entity representing the feedback for a failure mode, extendable with the `TimedValueHistory<FailureModeRelation>`
 * and `FailureModeFeedbackTimedValue`. 
 * 
 * The `FailureModeFeedback` is used to track and submit feedback related to failure modes from the Case/Alert Detail 
 * Top Failure Modes CardList. The feedback provides insights into the usefulness of a specific `FailureModeLineItem` 
 * in the context of the failure mode.
 */
entity extendable type FailureModeFeedback mixes TimedValueHistory<FailureModeRelation>, FailureModeFeedbackTimedValue schema name 'PAFMF' {

  /**
   * Used for submitting a {@link FailureModeFeedback} from the Case/Alert Detail Top Failure Modes CardList.
   * @param parent
   *    The {@link FailureModeRelation} that this feedback is associated with
   * @param feedback
   *    The rank of associated {@link FailureModeLineItem}. 0 - Unhelpful, 2 - Helpful
   */
  leaveFeedback: function(parent: !string, feedback: !int) js-rhino
}
