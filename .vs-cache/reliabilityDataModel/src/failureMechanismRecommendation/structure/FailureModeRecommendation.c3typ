/**
 * A denormalized view of all {@link FailureMode}s with their unique recommendations.  This type is
 * used for ease of extraction for all recommendations an {@link FailureMode} can have.  The
 * table in it's intended use is to have a unique key on {@linke FailureModeRecommendation}s
 * and {@link FailureMode}s - which should be given consideration when populating this table.
 * Future versions will make this a hard requirement.
 */
@db(index+=['failureMode'], versionHistory=true)
entity type FailureModeRecommendation mixes AssetOnboardingMeta, ExemptFromFacilityFilter schema name 'FLRR' {

  /**
   * All {@link FailureModeLineItem}s associated with the
   * {@link #failureMode}.
   */
  failureModeLineItems: [FailureModeLineItem](failureMode, failureMode)

  /**
   * The {@link FailureMode} associated with the recommendation.
   */
  failureMode: FailureMode

  /**
   * Name and Id of the recommendation to mitigate failure
   */
  name: string

  /**
   * The recommendation mitigating failure
   */
  recommendation: string

  /**
   * Whether the recommendation should be acted or reviewed online or offline
   */
  detail: string

  /**
   * Comments
   */
  comments: string
}
