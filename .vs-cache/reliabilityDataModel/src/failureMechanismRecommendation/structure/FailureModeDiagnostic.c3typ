/**
 * Represents the failure mode diagnostic for assessing failure modes.
 */
@db(versionHistory=true)
entity type FailureModeDiagnostic mixes Value, ExemptFromFacilityFilter schema name 'FMDGT' {

  /**
   * The name of the diagnostic.
   */
  name: ~

  /**
   * The display name of the diagnostic translated based on id.
   */
  displayName: string translate by id

  /**
   * Description to display translated based on id.
   */
  displayDescription: string translate by id

  /**
   * The font awesome icon that represents a diagnostic.
   */
  faIconConfig: FaIconConfig

  /**
   * Lambda function to determine if the diagnostic should be triggered.
   *
   * param data
   *       Sensor data for diagnostic evaluation.
   * param threshold
   *       Threshold value for triggering the diagnostic.
   * param diagnosticMode
   *       Evaluation mode for the diagnostic.
   * return `true` if diagnostic is triggered, otherwise `false`.
   */
  lambda: lambda(data: ![double], threshold: !double, diagnosticMode: !string enum FailureModeEvaluationMode): boolean schema suffix 'LMD'

  /**
   * Performs linear regression on the provided data to estimate the trend.
   *
   * @param data The input data to perform regression on.
   * @return A pair of <slope, intercept> values.
   */
  linearRegression: function(data: ![double]): Pair<double, double> js-rhino
}
