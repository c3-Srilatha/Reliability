/**
 * A collection of {@link FailureMode}s which are relevant to a single kind of asset..
 */
@db(versionHistory=true)
entity extendable type FailureModeLibrary mixes AssetOnboardingMeta, ExemptFromFacilityFilter schema name 'FMLIB' {

  /**
   * Failure modes which belong to this library.
   */
  failureModes: [FailureMode](failureModeLibrary)

  /**
   * Number of {@link FailureMode}s this {@link FailureModeLibrary} has.
   */
  countFailureModes: int calc count(failureModes)

  /**
   * Evaluates data for {@link ExpectedSensor}s and recommends {@link FailureModeLineItem}.
   *
   * @param data
   *        The data to evaluate.
   * @param diagnosticMode
   *        The diagnostic mode to use for evaluation.
   * @param failureModeLibrary
   *        The failure mode library to use for evaluation.
   * @return The recommended {@link FailureModeLineItem}s.
   */
  evaluateFailureModeRecommendation: function(
    data: ![FailureModeRecommendationEvaluationSensorDataSpec],
    diagnosticMode: !string enum FailureModeEvaluationMode,
    failureModeLibrary: FailureModeLibrary
    ): [FailureModeLineItem] js-rhino

  /**
   * Creates a copy of this {@link FailureModeLibrary} with the {@link FailureModeLineItem}s and
   * {@link FailureModeRecommendation}s duplicated.
   * @param newName
   *        The name to give to the new {@link FailureModeLibrary}
   * @return The new {@link FailureModeLibrary}
   */
  createCopy: member function(newName: string): FailureModeLibrary js-rhino

  /**
   * Removes this {@link FailureModeLibrary} along with its {@link FailureMode}s and {@link FailureModeLineItem}s.
   * Also remove the {@link FailureModeRecommendation}s.
   */
  removeWithRelatedEntities: member function() js-rhino
}
