/**
 * Do not persist this type. It is only used to return the result of the FailureModeWithNumActiveLineItems function.
 * A {@link FailureMode} with an additional field to indicate the number of active {@link FailureModeLineItem}s and a field to indicate whether it is active.
 */
type FailureModeWithNumActiveLineItems mixes FailureMode {
  /**
    * The number of active {@link FailureModeLineItem}s on the {@link FailureMode}.
   */
  numActiveLineItems: int

  /**
    * Whether the {@link FailureMode} is active. Represents if the {@link FailureMode} can be triggered.
   */
  isActive: boolean
}
