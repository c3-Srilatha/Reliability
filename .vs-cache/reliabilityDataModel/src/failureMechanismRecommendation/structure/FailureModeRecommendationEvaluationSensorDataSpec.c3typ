/**
 * Specifies the sensor data used for evaluating failure mode recommendations.
 */
type FailureModeRecommendationEvaluationSensorDataSpec mixes Spec {

  /**
   * If the diagnostic mode is {@link FailureModeEvaluationMode#SENSOR_BASED},
   * data represents the measurement data from the sensor.
   * If the diagnostic mode is {@link FailureModeEvaluationMode#RESIDUAL_BASED},
   * data represents residual / sensor measurement
   */
  data: ![double]

  /**
   * {@link data} comes from a sensor linked with this {@link ExpectedSensor}
   */
  expectedSensor: !ExpectedSensor
}
