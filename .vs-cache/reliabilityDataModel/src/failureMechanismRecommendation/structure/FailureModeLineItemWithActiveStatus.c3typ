/**
 * Do not persist this type. It is only used to return the result of the fetchWithActiveStatus function.
 * A {@link FailureModeLineItem} with an additional field to indicate whether it is active.
 */
type FailureModeLineItemWithActiveStatus mixes FailureModeLineItem {
  /**
    * Whether the {@link FailureModeLineItem} active. Represents if the {@link FailureModeLineItem} can be triggered.
   */
  isActive: boolean
}
