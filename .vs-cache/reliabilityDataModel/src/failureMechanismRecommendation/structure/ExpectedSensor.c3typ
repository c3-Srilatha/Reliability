/**
 * An abstract, conceptual representation of a sensor which serves some function in the context
 * of an asset. Can be associated with actual sensors providing measurements.
 */
@db(versionHistory=true)
entity type ExpectedSensor mixes AssetOnboardingMeta, ExemptFromFacilityFilter schema name 'FMES' {

  /**
   * Failure mode line items where this expected sensor is used.
   */
  failureModeLineItems: [FailureModeLineItem](expectedSensor)

  /**
   * Failure mode libraries this expected sensor belongs to.
   */
  failureModeLibraries: [FailureModeLibrary] stored calc unique(failureModeLineItems.failureModeLibrary)

  /**
   * Expected {@link Unit} of the sensor measurement.
   */
  unit: Unit

  /**
   * The type of unit represented by this {@link ExpectedSensor}. For example "Temperature", "Pressure", etc.
   */
  unitType: string

  /**
   * Whether this is a minimum required sensor for asset class purposes.
   */
  isMinRequired: boolean

  /**
   * This field answers the question, "If the actual value
   * of the sensor is more than the expected value, then
   * how much of a weight does it have on determining the
   * seriousness of the anomaly?"
   */
  sensorPositiveAnomalyWeight: double

  /**
   * This field answers the question, "If the actual value
   * of the sensor is less than the expected value, then
   * how much of a weight does it have on determining the
   * seriousness of the anomaly?"
   */
  sensorNegativeAnomalyWeight: double

  /**
   * A sensor can (broadly) be a CONTROL, INDEPENDENT,
   * or DEPENDENT sensor.
   * A CONTROL sensor is a process parameter that is set to a
   * pre-determined value by an operator. Eg. a setpoint sensor.
   * An INDEPENDENT sensor is a parameter whose values change
   * independent of the process. Eg. ambient temperature.
   * A DEPENDENT sensor is a parameter whose values change because
   * of the CONTROL and INDEPENDENT sensors. Eg. yield of a reactor.
   * If there are other types of sensors in your project, `remix` this
   * Type and add to the `string enum`s in this field.
   */
  sensorType: string enum('CONTROL', 'INDEPENDENT', 'DEPENDENT')

  /**
   * Display name which attempts to use {@link ExpectedSensor#name name} field; otherwise, uses the {@link ExpectedSensor#id id} field.
   */
  displayName: string stored calc exists(name) ? name : id;

  /**
   * The values of a sensor may fall into different buckets:
   * 1. CATEGORICAL - sensor outputs are from a specific set
   * 2. CONTINUOUS - sensor outputs can be any numeric value in a finite/infinite range
   * If there are other types of sensor data in your project, `remix` this
   * Type and add to the `string enum`s in this field.
   */
  sensorDataType: string enum('CATEGORICAL', 'CONTINUOUS')

  /**
   * All related {@link ReliabilityAssetSensorRelation}. See {@link ExpectedSensor} top level doc.
   */
  assetSensorRelations: [ReliabilityAssetSensorRelation](expectedSensor)
}
