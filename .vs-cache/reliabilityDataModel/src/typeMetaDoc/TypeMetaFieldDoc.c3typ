/**
 * Type to represent properties for a specific field on a type. Return value of `TypeMetaDocGetter#getFieldDocs`.
 */
type TypeMetaFieldDoc {

  /**
   * The name of the respective field.
   */
  name: string

  /**
   * Type name for the respective field.
   */
  typeName: !string

  /**
   * A list of values that the respective field can be set to.
   */
  values: set<any>

  /**
   * The original documentation provided in the c3typ
   */
  doc: string

  /**
   * Documentation properties for the respective field.
   */
  docProperties: map<string, string>

  /**
   * The {@link TypeMetaDocFieldType} value for the respective field if any.
   */
  fieldType: TypeMetaDocFieldType

  /**
   * Indication for whether the field is required.
   */
  required: !boolean

  /**
   * Indication for whether the field is a hyperparameter for a model.
   *
   * **NOTE**: This field is populated by looking at the
   * {@link Ann.ML#hyperparameter} annotation.
   */
  isHyperparam: boolean
}
