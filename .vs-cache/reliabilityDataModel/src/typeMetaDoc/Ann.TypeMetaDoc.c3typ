/**
 * Type Meta Doc annotation for fields
 */
@annotation(appliesTo=['field'])
type Ann.TypeMetaDoc mixes Annotation {

  /**
   * Boolean value representing if an annotation is inherited by mixins or not
   */
  isAdditional: boolean
}
