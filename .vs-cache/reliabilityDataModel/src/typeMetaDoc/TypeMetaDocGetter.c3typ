/**
 * Helper type to get the translated documentation for fields on a type.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
type TypeMetaDocGetter {

  /**
   * Gets the fields of a type and returns them with properties that contain translated text.
   * This function will look for seeded translations for each `fieldDocProperty` in the following convention:
   *
   * 'TypeMetaDoc' + '.' + `prefix` + {name of the field on `type`} + '.' + `fieldDocProperty`.
   *
   * @param type
   *     The type whose fields have to be returned.
   * @param tmdFieldType
   *     The {@link TypeMetaDocFieldType} of the fields for which documentation should be returned.
   * @param fields
   *     The set of fields which are returned with documentation.
   * @param prefix
   *     The prefix to add behind the field name to generate the translation key for a field documentation property.
   * @param overrideSettings
   *     TypeMetaDocSettings to use instead of the metadata settings for this stype
   * @param isInferenceOnly
   *     Whether to only return inference-related documentation.
   * @return A json object with `fields` of the `type` with the translated text.
   */
  getFieldDocs: function(
    type: !Type,
    fields: set<string>,
    prefix: string = '',
    tmdFieldType: string enum TypeMetaDocFieldType = ALL,
    overrideSettings: TypeMetaDocSettings,
    isInferenceOnly: boolean
  ): [TypeMetaFieldDoc] js-rhino

  /**
   * Formats a type field doc to remove `{@link ...}` syntax and newlines.
   *
   * @param docString
   *        The documentation string to format.
   * @return The formatted documentation string.
   */
  docToTranslation: function(docString: string): string py


  /**
   * Takes the fieldname as input and returns the translation of its label based on locale
   *
   * @param fieldName
   *        The name of the field to get the hint text translation for.
   * @return The translated hint text for the field.
   */
  getHintTextTranslation: function(fieldName: string): string js-rhino
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
