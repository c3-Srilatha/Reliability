/**
 * {@link TimedDataHeader} for {@link InventoryMeasurement}
 *
 * This header file is used to track parts tied to {@link WorkOrder}s and items tied to {@link PurchaseOrder}s.
 */
entity extendable type InventorySeries mixes TimedDataHeader<InventoryMeasurement>, MetricEvaluatable schema name 'INVSRS' {

  /**
   * The item facility associated with this series
   */
  itemFacility: string

  /**
   * The treatment to apply to {@link InventoryMeasurement#quantity}
   */
  treatment: string enum AggOp


  /**
   * All the inventory related {@link WorkOrderPartsForecast}s that have been made for this part.
   */
  forecasts: [WorkOrderPartsForecast](part)


  /**
   * The {@link Unit} to apply to {@link InventoryMeasurement}s if none is provided
   * directly on the measurement
   */
  unitConstraint: Unit

  /**
   * A unique identifier for the part.  This should never be duplicated across unique parts
   */
  partNumber: string

  /**
   * A description of the part
   */
  description: string

  /**
   * The supplier of the part
   */
  supplier: string

  /**
   * The cost of the part
   */
  cost: double

  /**
   * The name of the part
   */
  name: string

  /**
   * {@link TimedDataFields#timeZone} gets overridden by this field. If not set, the default value is 'UTC'.
   *
   * The timezone to use for the timeseries.
   */
  timeZone: string = 'UTC'
}
