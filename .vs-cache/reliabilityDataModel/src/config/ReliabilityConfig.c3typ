/**
 * Configurations for Reliability application.
 */
type ReliabilityConfig mixes Singleton, Config {

  /**
   * Base url for the application. Used for embedding links into email notifications.
   */
  baseURL: string = 'http://localhost:8080/reliability'

  /**
   * The business entity that the application is being deployed for. Displayed at the top of {@link WorkOrder} reports.
   */
  companyName: string = 'C3 AI Reliability'

  /**
   * The id of the {@link HardwareProfile} that will be used to all DataValidationBatchJob instances.
   */
  dataValidationHardwareProfile: string

  /**
   * The priority to be assigned to all DataValidationBatchJob instances.
   */
  dataValidationJobPriority: int

  /**
   * Specifies the filter used to fetch the user's cases. Use {{userId}} as a placeholder for the current user's id.
   */
  myCasesFilter: !Filter = 'contains(allAssets.rootAsset.members, "{{userId}}") || assignee.value == "{{userId}}" || meta.createdBy == "{{userId}}" || contains(collaborators, "{{userId}}")'

  /**
   * The limit for the fetch call used to retrieve activities related to actions performed on ReliabilityAssetAlert and ReliabilityAssetCase instances. The default value is set to 2000.
   */
  activitiesFetchLimit: int = 2000

  /**
   * The name of the LLM Model used for Expected Sensor Matching.
   */
  modelName: string
}
