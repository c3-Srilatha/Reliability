/**
 * Configurations for Reliability application UI. See `rel-dev-general-configuration.c3doc` for more detail about these configurations.
 */
type ReliabilityUIConfig mixes Singleton, Config {
  /**
   * Get current locale as string, for example `en` or `pt`
   * The preference order is as follows:
   *   First: `UiSdlUserPreference#preferredLocale`
   *   Second: First language in the list `iSdlConfig#i18n`
   *   Third: as a fallback default to `en` for English.
   *
   * @return The current locale as a string.
   */
  getLocale: function(): string js-rhino
}
