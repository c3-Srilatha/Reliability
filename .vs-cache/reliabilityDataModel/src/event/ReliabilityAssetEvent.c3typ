/**
 * Represents an point-in-time event that occurred on an asset.
 */
extendable type ReliabilityAssetEvent extends PhysicalAssetEvent mixes FilterableByFacility type key 'REL_PREDMAINT_EVNT' {


  /**
   * A user-provided name for this event.
   */
  name: ~

  /**
   * The {@link ReliabilityAsset} this event is for
   */
  parent: !ReliabilityAsset

  /**
   * Planned vs Unplanned Indicator
   */
  eventType: string enum EventTypeEnum

  /**
   * Start Date
   */
  eventStartDatetime: datetime

  /**
   * End Date
   */
  eventEndDatetime: datetime

  /**
   * Total Losses Quantity (in Barrel of Oil Equivalent)
   */
  eventLossGrossQuantity: double

  /**
   * Overall Cause Code for the event (if any)
   */
  eventCauseCode: string

  /**
   * Cause Category
   */
  eventCauseCategory: string

  /**
   * Cause Sub Category
   */
  eventCauseSubCategory: string

  /**
   * Event Description
   */
  eventDescription: string

  /**
   * Equipment associated with the event
   */
  equipment: ReliabilityAsset

  /**
   * Equipment Number
   */
  equipmentNo: string

  /**
   * Equipment Area
   */
  equipmentArea: string

  /**
   * Equipment Class
   */
  equipmentClass: string

  /**
   * Equipment Generic/Catalog Profile
   */
  equipmentProfile: string

  /**
   * Root cause analysis code
   */
  rootCauseAnalysisCode: string

  /**
   * Facility associated with this Event
   */
  facility: Facility

  /**
   * Well associated with this Event
   */
  well: string

  /**
   * {@link ReliabilityAsset} associated with this event.
   */
  asset: ReliabilityAsset

  /**
   * The category the event can be classified as
   */
  category: string enum EventCategoryEnum

  /**
   * Yes or No depending on if this event was detected
   */
  detected: boolean = false

  /**
   * The `MLProject` that this event is associated with
   */
  detectedBy: MlProject

  /**
   * The entity that logged this event
   */
  loggedBy: User

  /**
   * When this event was logged
   */
  loggedDate: datetime

  /**
   * Event duration in milliseconds.
   */
  eventDuration: int calc (eventEndDatetime - eventStartDatetime)

  /**
   * The method computes maximum, minimum, and average {@link eventDuration} in milliseconds for {@link ReliabilityAssetEvent} specified by spec.
   * @param spec - FetchSpec
   *        fetchSpec for {@link ReliabilityAssetEvent}
   * @return JSON object containing the computed statistics.
   */
  getEventDurationStatistics: function(spec: !FetchSpec): json js-rhino

  /**
   * @inheritdoc
   */
  facilityFilterPaths: const ~ = ["parent.facility"]
}
