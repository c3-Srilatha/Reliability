/**
 * This type represents a tag hierarchy that has been denormalized.
 */
type CanonicalTagHierarchyDenormalized mixes Canonical<CanonicalTagHierarchyDenormalized> {

  /**
   * Name of the Facility.
   */
  facilityName: string

  /**
   * Name of the System.
   */
  systemName: string

  /**
   * Name of the Subsystem.
   */
  subsystemName: string

  /**
   * Subsystem description.
   */
  subsystemDescription: string

  /**
   * Name of the Equipment.
   */
  equipmentName: string

  /**
   * Equipment description.
   */
  equipmentDescription: string

  /**
   * Name of the tag.
   */
  tag: string

  /**
   * Tag description.
   */
  tagDescription: string

  /**
   * Alias of tag.
   */
  expectedSensor: string

  /**
   * Name of the reference diagram.
   */
  referenceDiagram: string

  /**
   * Name of the instrument.
   */
  instrumentName: string

  /**
   * Failure mode library associated to a tag.
   */
  failureModeLibrary: string
}
