/**
 * The base canonical for {@link PurchaseOrderLine}.
 *
 */
type CanonicalPurchaseOrderLineReceipt mixes Canonical<CanonicalPurchaseOrderLineReceipt> {
  /**
   * A unique identifier of this purchase order line receipt.
   */
  id: string

  /**
   * {@link PurchaseOrderLine} to which this purchase order receipt belongs to.
   */
  orderLineId: string

  /**
   * The quantity of the item which was delivered as part of this receipt.
   */
  deliveredQuantity: string

  /**
   * The unit of measurement for the item which was delivered as part of this receipt.
   */
  uom: string

  /**
   * The date and time when this order was delivered.
   */
  deliveredDate: string
}
