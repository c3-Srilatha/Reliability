/**
 * This type represents a {@link FacilityCharacteristicValue} that can be loaded in from an external source.
 */
type CanonicalFacilityCharacteristicValue mixes Canonical<CanonicalFacilityCharacteristicValue> {

  /**
   * The name of this characteristic value
   */
  name: !string

  /**
   * The value of this characteristic value
   */
  value: !string

  /**
   * The {@link Facility} name that this characteristic value relates to
   */
  parent: !string

  /**
   * The timestamp for this recorded characteristic value
   */
  timestamp: !datetime
}
