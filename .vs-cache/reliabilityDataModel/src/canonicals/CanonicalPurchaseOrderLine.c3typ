/**
 * The base canonical for {@link PurchaseOrderLine}.
 *
 */
type CanonicalPurchaseOrderLine mixes Canonical<CanonicalPurchaseOrderLine> {
  /**
   * Unique identifier of the {@link PurchaseOrderLine}.
   */
  id: string

  /**
   * The quantity of the {#item_item_number} being ordered as part of this purchase order line.
   */
  quantity: string

  /**
   * Unit of measurement of the {#item_item_number}.
   */
  uom: string

  /**
   * The requested date of delivery of this purchase order line.
   */
  need_by_date: string

  /**
   * The total cost of this purchase order line.
   */
  accounting_total: float

  /**
   * The currency code used for this purchase order line.
   */
  accounting_total_currency_code: string

  /**
   * The item number that is being ordered as part of this purchase order line.
   */
  item_item_number: string

  /**
   * {@link PurchaseOrder} ID to which this purchase order line belongs to.
   */
  purchase_order_id: string
}
