/**
 * The base canonical for {@link InventorySeries}.
 */
type CanonicalInventorySeries mixes Canonical<CanonicalInventorySeries> {
  /**
   * Unique identifier of the {@link InventorySeries}.
   */
  id: string

  /**
   * The item storage location to which this initial inventory balance series corresponds.
   */
  itemStorageLocation: string

  /**
   * The item facility to which this initial inventory balance series corresponds.
   */
  itemFacility: string

  /**
   * The part number for the part being processed.
   */
  partNumber: string

  /**
   * The description for the part.  Ideally under 255 characters.
   */
  description: string

  /**
   * The supplier for the part. This should be a human readable string, and not a supplier code.
   */
  supplier: string

  /**
   * The most recent known cost for the part.
   */
  cost: string

  /**
   * A human readable version of the name for this part.
   */
  name: string

  /**
   * The optional setting for the interval at which to normalize the series.
   */
  interval: string enum Interval

  /**
   * The optional setting for the treatment to use when normalizing the series.
   */
  treatment: string enum AggOp
}
