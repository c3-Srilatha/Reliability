/**
 * This type represents a Reliability asset event.
 */
type CanonicalReliabilityAssetEvent mixes Canonical<CanonicalReliabilityAssetEvent> {

  /**
   * Unique identifier of the event
   */
  id: !string

  /**
   * Name of the event
   */
  eventName: string

  /**
   * Scheduled or Unscheduled Indicator
   */
  eventType: !string

  /**
   * Start Date (YYYY-MM-DDTHH:mm:ss)
   */
  eventStartDatetime: datetime

  /**
   * End Date (YYYY-MM-DDTHH:mm:ss)
   */
  eventEndDatetime: datetime

  /**
   * Total Losses Quantity (in Barrel of Oil Equivalent)
   */
  eventLossGrossQuantity: double

  /**
   * General category
   */
  category: string

  /**
   * Overall Cause Code for the event (if any)
   */
  eventCauseCode: string

  /**
   * Cause Category
   */
  eventCauseCategory: string

  /**
   * Cause Sub Category
   */
  eventCauseSubCategory: string

  /**
   * Event Description
   */
  eventDescription: string

  /**
   * Equipment associated with the event
   */
  equipment: string

  /**
   * Equipment Number
   */
  equipmentNo: string

  /**
   * Equipment Area
   */
  equipmentArea: string

  /**
   * Equipment Class
   */
  equipmentClass: string

  /**
   * Equipment Generic/Catalog Profile
   */
  equipmentProfile: string

  /**
   * Root cause analysis code
   */
  rootCauseAnalysisCode: string

  /**
   * Facility Id associated with this Event
   */
  facility: string

  /**
   * Well Id associated with this Event
   */
  well: string

  /**
   * Subsystem associated with this Event
   */
  subsystem: string
}
