/**
 * {@link Jarvis} type used to share large content efficiently between {@link Jarvis.Step}s.
 * Inherited {@link Content} APIs can be used like they normally would for other subtypes (ex. {@link File}).
 */
type Jarvis.Content mixes Microservice.Content {

  /**
   * Whether the content should be kept as long as the build entity exists or not.
   */
  expiresWithBuildEntity: boolean

  /**
   * The kind of the content.
   */
  kind: string enum Jarvis.Content.Kind
}
