/**
 * Allows for streaming {@link Jarvis.Content} in a low memory way.
 */
@restful(endpoint='jarviscontent')
type Jarvis.RestfulContentHandler mixes Restful {
  handle: ~

  @action(authz='always')
  doGet: private function(path: !string): HttpResponse
}
