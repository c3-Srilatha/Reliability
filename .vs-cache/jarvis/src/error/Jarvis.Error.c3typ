/**
 * Type that contains metadata about errors thrown within {@link Jarvis.Executor}
 */
type Jarvis.Error mixes Error {

    /**
    * Indicates whether the error is retryable.
    */
    notRetryable: boolean = false

    /**
    * Formats the error message and return a Throwable object.
    */
    constructError: function(notRetryable: boolean, format: string, args: any ...): Jarvis.Error
}
