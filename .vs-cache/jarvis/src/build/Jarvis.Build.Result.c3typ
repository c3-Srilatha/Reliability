type Jarvis.Build.Result mixes Identified  {

  /**
   * The commit that was used during this build.
   */
  sha: !string

  /**
   * The final status of the build.
   */
  status: !string enum Jarvis.Build.Status

  /**
   * Formatted error message if status is ERROR
   */
  error: string

  /**
   * Error sub-type name
   */
  errorType: string

  /**
   * The results of each step in the build
   */
  stepResults: [Jarvis.Step.Result]

  /**
   * All packages that were built in this build
   */
  pkgsArtifacts: [Jarvis.Step.PkgArtifactResult]
}
