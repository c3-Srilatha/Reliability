/**
 * Enum of all possible outcomes of a build
 */
// TODO: PLAT-46904 enable enum mixin and remove SUCCESS/NON_FATAL_ERROR/ERROR/TIMED_OUT
enum type Jarvis.Build.Status {// mixes Jarvis.Status {

  /**
   * The execution was successful
   */
  SUCCESS

  /**
   * The execution completed, but has non fatal errors.
   */
  NON_FATAL_ERROR

  /**
   * An error was thrown in the execution.
   */
  ERROR

  /**
   * The execution did not complete in allocated time so was canceled by Jarvis.
   */
  TIMED_OUT

  /**
   * The build was aborted by the user.
   */
  ABORTED
}
