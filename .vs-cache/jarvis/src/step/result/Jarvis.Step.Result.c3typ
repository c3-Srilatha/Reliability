/**
 * Represents result of a single pipeline step execution
 */
type Jarvis.Step.Result mixes Identified {

  /**
   * Parent pipeline step
   */
  step: !Jarvis.Step

  /**
   * Status of the result. In most cases the final status - with exception to PARTIAL
   */
  status: !string enum Jarvis.Step.Status

  /**
   * Formatted error message if status is ERROR
   */
  error: string

  /**
   * Error sub-type name
   */
  errorType: string
}
