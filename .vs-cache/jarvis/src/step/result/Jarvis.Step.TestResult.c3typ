/**
 * Result data for the execution of a test.
 */
type Jarvis.Step.TestResult mixes Jarvis.Step.Result {

  /**
   * The package name for the test
   */
  pkgName: !string

  /**
   * The action engine that ran the test
   */
  actionEngine: string

  /**
   * Fully qualified name of the test suite containing package any implementation language runtime etc.
   */
  testSuite: !string

  /**
   * Reference to test suite result
   */
  result: TestSuiteResult schema suffix 'TST'
}
