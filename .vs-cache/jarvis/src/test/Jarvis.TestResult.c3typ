/**
 * The return value of {@link JarvisExecutor.TestManager#runTest}
 */
type Jarvis.TestResult {

  /**
   * The {@link TestSuiteResult} associated with this test result.
   */
  testSuiteResult: TestSuiteResult

  /**
   * The status of the result, indicating whether the test completed with/without errors,
   * or there is another error while running the test.
   */
  status: Jarvis.Step.Status

  /**
   * Whether the test should be retried if it fails.
   */
  retryable: boolean

}
