type Jarvis.Lambda mixes Identified, Nameable {

  name: !~
  // originally had Jarvis.Lambda mixing Lambda<function(inputStep: Jarvis.Step): Jarvis.Step.Result>
  // but cant forName that since there would be no name in the js file
  value: lambda(inputStep: Jarvis.Step): Jarvis.Step.Result

  /**
   * The ID of the {@link Jarvis.Build} that this lambda belongs to.
   * If this is a platform lambda, this field will be empty.
   */
  buildId: string

  /**
   * The name of the {@link Jarvis.Step} that the custom step should hook into
   */
  hookStep: string

  /**
   * Whether the custom step should be a blocking step or an async step
   */
  hookStrategy: string enum Jarvis.PipelineHookStrategy

  /**
   * The name of the package the lambda should be run in.
   * If package name is provided, the {@link packageVersion} has to be provided too.
   */
  packageName: string

  /**
   * The version of the package the lambda should be run in.
   * If {@link #packageName} is provided, the version has to be provided too.
   */
  packageVersion: string

  /**
   * Read in list of custom lambda source files, resolve dependencies,
   * and create `Jarvis.Lambda`s for each source file.
   */
  createCustomLambdas: function(srcStrings: [string]): [Jarvis.Lambda]

  /**
   * Runs the lambda with the given input step.
   */
  apply: member function(inputStep: Jarvis.Step): Jarvis.Step.Result
}
