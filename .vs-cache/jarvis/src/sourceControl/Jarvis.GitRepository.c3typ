/**
 * A git repository folder containing C3 packages
 */
type Jarvis.GitRepository mixes Identified, Nameable {

  /**
   * The url of the repository
   */
  url: !string serialized Url

  /**
   * The base url for making REST API calls against the repository.
   */
  restUrl: !string serialized Url

  /**
   * The type of source control service backing this repository. Used to format REST API requests.
   */
  sourceControlType: !string enum SourceControlHost
}
