/**
 * A grouping of branches
 */
type Jarvis.BranchGroup mixes Identified, Nameable {

  /**
   * The name of the branch group. Must be unique by repository
   */
  name: !~

  /**
   * The repository this branch grouping belongs to
   */
  repository: !Jarvis.GitRepository

  /**
   * The regex that will group tests
   */
  regex: !string

  /**
   * The branch to compare diffs against
   * TODO: TOOLS-13748 not all repos have concept of base branch on PR
   */
  baseBranch: string = 'develop'

  /**
   * Configuration for how to trigger builds
   */
  triggerOptions: !Jarvis.BranchGroup.TriggerOptions schema suffix 'TO'

  /**
   * The path to the packages to be built
   */
  packagesPath: string

  /**
   * Path to the jarvis file
   */
  jarvisFilePath: string
}
