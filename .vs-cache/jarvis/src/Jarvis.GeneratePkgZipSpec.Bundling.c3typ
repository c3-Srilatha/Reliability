/**
 * Spec for UiBundler.generateBundles
 */ 
type Jarvis.GeneratePkgZipSpec.Bundling {
  
  /**
   * Timeout for generate bundles process
   */
  timeout: double = 30

  /**
   * String serialized UiSdlConfig
   */
  uiSdlConfig: string

  /**
   * String serialized UiBundlerConfig
   */
  uiBundlerConfig: string
}
