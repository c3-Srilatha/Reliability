/**
 * Describes a type in Jarvis that has state history.
 */
abstract type Jarvis.WithStateHistory mixes Jarvis.WithState {

  /**
   * The history of state transition. The most recent state is at the last index and
   * will have the same value as {@link #state}.
   * This is managed by the system and should never be set directly.
   */
  stateHistory: [Jarvis.State.Detail] schema suffix 'ST_HST'

  /**
   * The amount of time between {@link Jarvis.State#RUNNING} and {@link Jarvis.State#DONE} (or now, if DONE is not the
   * {@link #state}).
   * If the object was never {@link Jarvis.State#RUNNING}, then `0s`.
   * Enure that `state` and `stateHistory` are populated prior to calling this.
   */
  duration: member function(): string serialized Duration

  /**
   * The elapsed time in the current state.
   * Enure that `state` and `stateHistory` are populated prior to calling this.
   */
  durationOnCurrentState: member function(): string serialized Duration

  /**
   * Return the {@link Jarvis.State.Detail} from state history for the given state.
   */
  stateTimestamp: member function(state: !string): DateTime

  /**
   * Return the time (as milliseconds) between two states.
   * If either states don't exist, return null.
   */
  timeBetween: member function(startState: !string, endState: !string): Duration
}
