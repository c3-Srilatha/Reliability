/**
 * Helper functions which setup an environment and data to use for luke testing jarvis UI pages/components.
 * Copied from setupData.js but with smaller amount of data and higher minimum numbers of test cases + failures.
 */
type JarvisTestHelper {
   /**
    * Sets up testing environment
    *
    * @return snapshot - a snapshot of Jarvis-related entities
    */
   setup: function(): json js-server

   /**
    * Tears down testing environment
    * @param snapshot
    *             a snapshot of Jarvis-related entities to restore. If not provided, all Jarvis-related entities will be removed.
    */
   teardown: function(snapshot: json) js-server

   /**
    * Generates new test data for testing environment
    */
   generateTestData: function(branchGroupRegex: !string, gitRepositoryUrl: !string, gitRepositoryPackagesPath: !string, sourceControlToken: !string) js-server

   /**
    * Writes test data to seed data
    */
   writeToSeedData: function() js-server

   /**
    * Takes a snapshot of the data stored by the {@link JarvisService} microservice.
    * @param writeToSeedData
    *             if true, test data will be written to seed data.
    */
   snapshot: private function(writeToSeedData: boolean): json js-server

   /**
    * Restores a snapshot of the data stored by the {@link JarvisService} microservice.
    * @param snapshot
    *             a snapshot of Jarvis-related entities to restore. If not provided, all Jarvis-related entities will be removed.
    */
   restoreSnapshot: private function(snapshot: json) js-server

   /**
    * Tears down {@link JarvisService} test data.
    */
   teardownTestData: private function() js-server

   /**
    * Upserts all test data stored in the resources directory for luke tests.
    */
   upsertTestData: private function() js-server
}
