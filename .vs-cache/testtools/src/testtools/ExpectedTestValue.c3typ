/**
 * Container for expected test value used in {@see timeseriesResultsErrors}
 */
type ExpectedTestValue {

  /**
   * Starting point. Check each index of results starting at start
   * Stop when the next ExpectedTestValue.start is reached
   */
  start: int

  /**
   * Expected value
   */
  value: double

  /**
   * Expected missing amount (0 to 100)
   */
  missing: byte

  /**
   * Expected estimates amount (0 to 1)
   */
  estimates: double
}
