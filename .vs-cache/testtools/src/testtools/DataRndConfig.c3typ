/**
 * Randomization configuration used in pulse and periodic functions.
 *
 * Note that the use of mag is mutually exclusive with lo and hi.
 *
 * @see DataApi.pulse
 * @see DataApi.periodic
 */
type DataRndConfig {

  /**
   * magnitude of randomness to add to each point
   */
  mag: int

  /**
   * minimum amount of randomness to add to each point
   */
  lo: int

  /**
   * maximum amount of randomness to add to each point
   */
  hi: int
}
