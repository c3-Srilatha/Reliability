/**
 * Main container for TestApi. Contains all of the information and functionality necessary for
 * TestApi to operate properly. The majority of tests will not need to use TestApiContext methods
 * directly.
 */
entity type TestApiContext schema name 'TESTAPICTX' {

  /**
   * The uuid
   */
  id: string

  /**
   * The file name
   */
  filename: string

  /**
   * To debug or not to debug
   */
  debugEnabled: boolean

  /**
   * Set to false if we timeout in waitFor...
   */
  setupOK: boolean

  /**
   * Has the context's locale change
   */
  localeChanged: boolean

  /**
   * The original locale in this context
   */
  originalLocale: string

  /**
   * Max number of entities you can remove with external filter
   */
  removeLimit: int = 100

  /**
   * Parent context
   */
  parent: TestApiContext

  /**
   * Fail a test if a queue error is detected
   */
  failOnQueueErrors: boolean

  /**
   * Call waitForSetup on teardown for _waitForTeardown seconds
   */
  waitForTeardown: int

  /**
   * Don't check these queues in waitForSetup
   */
  queueBlacklist: [Type] schema name 'QB'

  /**
   * A number of attempts to recover
   */
  tryToRecover: int

  /**
   * FileSystem (e.g. S3 or Azure) file names
   */
  fsFiles: [string] schema name 'FSF'

  /**
   * ActionMocks that have been registered with this context.
   */
  mocks: [Action.Spy] schema name 'MCKS'

  /**
   * TestApiObjs
   */
  @db(order='descending(toUTC(meta.created))')
  testApiObjs: [TestApiObj](parent)

  /**
   * An array of TestApiObj ids for {@link User}s created using this test context
   */
  testUsers: [string]

  /**
   * Filters for tearing down
   */
  teardownFilters: [TestApiTearDownFilter] schema name 'TDF'

  /**
   * Counter for creating unique ids or names for test objects
   */
  uuidCounter: int

  /**
   * Return the unique identifier for this context.
   * @return unique context identifier
   */
  contextID: member function(): string js

  /**
   * Generate a unique id starting with the contextID
   * @return unique identifier
   */
  uuid: inline member function(uuidCounterValue: int): string js

  reserveUuids: member function(count: !int): int js

  /**
   * c3 queues
   */
  c3Queues: [Type] schema name 'C3Q'

  /**
   * Generate a unique name with the form <contextID>_<name>_<uniqueId>
   * @param name string to include in the unique name output
   * @return unique name
   */
  uniqueName: inline member function(name: string, uuidCounterValue: int): string js

  /**
   * Find an object in this context with 'id'
   * @param id Id to search for
   * @param typeref
   *           The type for which to search. If unspecified and multiple objs match the id, the first will be returned.
   * @return Object with id 'id'
   */
  findObjectById: member function(id: !string, typeRef: !Type): TestApiObj js

  /**
   * Remove an object in this context with 'id'
   * @param id Id to remove
   * @param typeref
   *           The type for which to search. If unspecified and multiple objs match the id, the first will be removed.
   * @return count of objs removed (0 or 1)
   */
  removeObjectById: member function(id: !string, typeRef: !Type): int js

  /**
   * Remove all objects in this context by parent.id
   * @param id parent.id to remove
   * @param typeref
   *           The type for which to search. If unspecified and multiple objs match the id, the first will be removed.
   * @return count of objs removed
   */
  removeObjectByParent: member function(id: !string, typeRef: !Type): int js

  /**
   * Return number of objects tracked by this context
   * @return
   */
  numObjects: member function(): int js

  /**
   * Clear this context. After calling this function, the context should be back in its initial
   * state
   */
  clear: member function() js-server

  /**
   * Add a filter to be used during teardown.
   *
   * addTeardownFilter has a safety mechanism built in that prevents deleting more than 100 objects
   * This limit can be increased on a per call basis using the third argument, or context-wide using
   * @see testtool.TestApiContext#setRemoveLimit
   *
   * @param filter Filter string
   * @param typeRef TypeRef specifying the type of the objects to be removed
   * @param limit Optional limit.
   */
  addTeardownFilter: member function(filter: string, typeRef: Type, limit: int) js-server

  /**
   * Return list of teardownFilters
   * @default []
   * @return
   */
  getTeardownFilters: member function(): [TestApiTearDownFilter] js-server

  /**
   * Set a context wide limit on the number of objects that can be removed using a remove filter
   * (e.g., addTeardownFilter or removeEntitiesByFilter)
   * @param limit New limit value
   */
  setRemoveLimit: member function(limit: int) js-server

  /**
   * Return current remove filter limit
   * @default 100
   * @return
   */
  getRemoveLimit: member function(): int js-server

  /**
   * Set a number of attempts to recover failed jobs from a queue
   * @param numberOfAttempts New number of recovery attempts
   */
  setTryToRecover: member function(numberOfAttempts: int) js-server

  /**
   * Return current number of attempts to recover
   * @default 1
   * @return
   */
  getTryToRecover: member function(): int js-server

  /**
   * Enable TestApi debug mode.
   *
   * When in debug mode, TestApi will print a message anytime it does anything. Don't forget to
   * turn it back off when you're done debugging.
   * @param debug
   */
  setDebug: member function(debug: boolean) js-server

  /**
   * Return true if debug mode enabled
   * @default false
   * @return
   */
  isDebugEnabled: member function(): boolean js-server

  /**
   * Print message listing what queues are enabled/disabled.
   */
  printQueueInformation: member function() js-server

  /**
   * Disable InvalidationQueues.
   *
   * When an InvalidationQueue is disabled, it is paused and ignored by TestApi.
   *
   * @param var_args InvalidationQueue(s) to disable
   */
  disableQueues: member function(queues: [Type]) js-server

  /**
   * Enable InvalidationQueues.
   *
   * When an InvalidationQueue is enabled, it is cleared and resumed. Once resumed, TestApi starts
   * tracking it again.
   *
   * @param var_args InvalidationQueue(s) to disable
   */
  enableQueues: member function(queues: [Type]) js-server

  /**
   * Return list of blacklisted (disabled) queues
   * @return
   */
  getQueueBlacklist: member function(): [Type] js-server

  /**
   * Set SetupOK flag in TestApi.
   *
   * SetupOK indicates whether or not there have been any waitFor* functions have failed. jasmine.setupGuard
   * uses SetupOK via @see testtool.TestApiContext#isSetupOK
   *
   * @param ok Turn SetupOK on or off
   */
  setSetupOK: member function(ok: boolean) js-server

  /**
   * Return SetupOK
   * @default true
   * @return
   */
  isSetupOK: member function(): boolean js-server

  /**
   * Return the parent context
   * @return
   */
  getParent: member function(): TestApiContext js-server

  /**
   * Enable/disable failing a test if queue errors have been detected
   * @param failOnQueueErrors
   */
  setFailOnQueueErrors: member function(failOnQueueErrors: boolean) js-server

  /**
   * Return true if failing a test on queue errors is enabled, false otherwise
   * @default true
   * @return
   */
  isFailOnQueueErrors: member function(): boolean js-server

  /**
   * Enable/disable wait for teardown
   *
   * If enabled, wait for any downstream actions spawned by teardown to complete.
   * @param waitForTeardown
   */
  setWaitForTeardown: member function(waitForTeardown: int) js-server

  /**
   * Return true if waitForTeardown is enabled false otherwise
   * @default 60 (seconds)
   * @return
   */
  getWaitForTeardown: member function(): int js-server

  /**
   * Return list of FileSystem (e.g. S3 or Azure) files associated with the context
   * @return [string]
   */
  getFileNames: member function(): [string] js-server

  /**
   * When impersonating, this stores the original user.
   */
  // user: User

  /**
   * Hostname for vanity url (private)
   */
  vanityHostname: string

  /**
   * Vanity url
   */
  getVanityUrl: member function(): !string js-server

  setField: private member function(fieldName: string, value: any) js-server
}
