/**
 * JobStatusTracker is used to run jobs and generate information about the jobs run.
 */
entity type JobStatusTracker schema name 'JSTR' {

  /**
   * Indicating whether the job status tracker is actively tracking the job status
   */
  active: boolean

  /**
   * Total job duration in milliseconds
   */
  duration: int

  /**
   * The job status reports for jobs tracked by this tracker {@see JobStatusReport}
   */
  reports: [JobStatusReport](tracker)

  /**
   * IDs for the jobs being tracked by the tracker
   */
  jobIds: [string] schema name 'JID'

  /**
   * Takes an array of jobs and runs them synchronously or asynchronously. One run will
   * create a JobStatusReport for each job.
   * @param jobs
   *    An array of jobs to be run. These can be any kinds of jobs
   * @param spec
   *    Spec for the job status tracker {@see JobStatusTrackerSpec}
   */
  run: function(jobs: ![any], spec: JobStatusTrackerSpec): JobStatusTracker js-server

  /**
   * Generate the job status report for a job
   */
  generateJobStatusReport: member function(job: !any): JobStatusReport js-server

  /**
   * Start the jobs & asynchronously poll the status of the jobs
   * @param jobs
   *    The jobs being tracked
   * @param cronExpression
   *    Cron schedule expression to poll the job status
   */
  startJobAndPollAsync: member function(jobs: ![any], cronExpression: !string): CronJob js-server

  /**
   * Check the status of a list of jobs
   * If the job has completed or failed, generate the {@see JobStatusReport}
   */
  checkJobStatus: member function(jobs: ![any]): boolean js-server

  /**
   * Finish tracking the jobs and aggregate the reports {@see JobStatusReport}
   */
  finishTracking: member function() js-server

  /**
   * Get the status tracker with the aggregated reports {@see JobStatusReport}
   */
  statusReport: member function(): JobStatusTracker js-server
}
