/**
 * Report holds status information and measurements for one job
 */
entity type JobStatusReport schema name 'TESTJR' {

  /**
   * The job this report is for
   */
  job: !any

  /**
   * The final status of the tracked job
   */
  jobStatus: string

  /**
   * The job tracker instance
   */
  tracker: !JobStatusTracker

  /**
   * Job duration in milliseconds
   */
  duration: int
}
