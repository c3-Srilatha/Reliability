/**
 * This type enables partial matching on the type's value. The matching rule is that every key-value pair in this
 * type's value field must be present in the object from the {@link ActionMock} callArg.
 *
 * For example, the following expecation would pass:
 * ```javascript
 * var spy = TestApi.spyOn(context, 'SomeType', 'spiedApi');
 * SomeType.spiedApi({ foo1: 'bar', foo2: 'baz' });
 * expect(spy.toHaveBeenCalledWith({
 *   someArgName: TestApiPartialMatcherObjectContaining.from({
 *     foo1: 'bar'
 *   })
 * });
 * ```
 *
 * While this expectation would fail:
 * ```javascript
 * var spy = TestApi.spyOn(context, 'SomeType', 'spiedApi');
 * SomeType.spiedApi({ foo1: 'bar' });
 * expect(spy.toHaveBeenCalledWith({
 *   someArgName: TestApiPartialMatcherObjectContaining.from({
 *     foo1: 'bar'
 *     foo2: 'baz'
 *   })
 * });
 * ```
 */
type TestApiPartialMatcherObjectContaining mixes TestApiPartialMatcher {

  partialMatcherValueType: ~ = 'object'
  from:                    ~
}
