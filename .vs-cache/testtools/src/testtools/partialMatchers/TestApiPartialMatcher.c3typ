/**
 * This base type is used for partial property matching during expectations in testing
 */
type TestApiPartialMatcher {

  /**
   * This field contains the data structure that is being wrapped by the partial matcher
   */
  value: any

  /**
   * Designates the type of partial matcher. This is necessary instead of relying on type().typeName() because type
   * names are not preserved when nested data structures are passed into a field of 'any' or 'json'
   */
  partialMatcherValueType: private string

  /**
   * This method is used to create instances of specific partial matcher objects. For example, a
   * {@link TestApiPartialMatcherObjectContaining} could be created in the following way:
   * ```javascript
   * var spy = TestApi.spyOn(context, 'SomeType', 'spiedApi');
   * SomeType.spiedApi({ foo1: 'bar', foo2: 'baz' });
   * expect(spy.toHaveBeenCalledWith({
   *   someArgName: TestApiPartialMatcherObjectContaining.from({
   *     foo1: 'bar'
   *   })
   * });
   * ```
   *
   * @param dataStructure
   *           the data structure (object, array, etc.) for which partial matching rules will apply
   * @return a TestApiPartialMatcher wrapping the provided data structure
   */
  from: abstract function(dataStructure: json): !mixing TestApiPartialMatcher js-server
}
