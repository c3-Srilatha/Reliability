/**
 * This type enables partial matching on the type's value. The matching rule is that every element in this type's value
 * field must be present in the array from the {@link ActionMock} callArg.
 *
 * For example, the following expecation would pass:
 * ```javascript
 * var spy = TestApi.spyOn(context, 'SomeType', 'spiedApi');
 * SomeType.spiedApi([1, 2, 3, 4])
 * expect(spy.toHaveBeenCalledWith({
 *   someArgName: TestApiPartialMatcherArrayContaining.from([1, 2, 3])
 * });
 * ```
 *
 * While this expectation would fail:
 * ```javascript
 * var spy = TestApi.spyOn(context, 'SomeType', 'spiedApi');
 * SomeType.spiedApi([1, 2, 3])
 * expect(spy.toHaveBeenCalledWith({
 *   someArgName: TestApiPartialMatcherArrayContaining.from([1, 2, 3, 4])
 * });
 * ```
 */
type TestApiPartialMatcherArrayContaining mixes TestApiPartialMatcher {

  partialMatcherValueType: ~ = 'array'
  from:                    ~
}
