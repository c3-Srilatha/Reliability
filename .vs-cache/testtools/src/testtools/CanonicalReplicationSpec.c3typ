/**
 * Spec that specifies replication logic for canonicals
 */
type CanonicalReplicationSpec {

  /**
   * Whether to use canonical
   */
  useCanonical: boolean = true

  /**
   * Name of the canonical
   */
  name: string

  /**
   * Replication logic for the canonical.
   * We can have multiple files per canonical and a different replication logic per file.
   * The replicationLambda is called for each file. The filename is passed as an argument to replicationLambda.
   * @param objs Stream of objects in the file, null if useCanonical is false
   * @param start The start of the replication period
   * @param end The end of the replication period
   * @param fileName Name of the file, null if useCanonical is false
   * @return Map of canonical name to list of objects to be processed, null if useCanonical is false
   */
  replicationLambda: lambda(objs: stream<Obj>, start: datetime, end: datetime, fileName: !string): map<string, [Obj]> schema suffix 'RL'
}
