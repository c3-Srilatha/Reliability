entity type MetricProfilerSpec schema name 'TSTL_MTRCPRFRS' {

  srcType:      Type
  ids:          [string] schema suffix 'IDS'
  expressions:  [string] schema suffix 'EXPRS'
  interval:     string enum('QUARTER_HOUR', 'HOUR', 'DAY', 'MONTH', 'YEAR')
  start:        datetime
  end:          datetime
  iterations:   int
  numThreads:   int
  idsPerThread: int
}
