/**
 * Base type for TestApi helper functions configuration
 *
 * @see testtool.TestApi.createSPMAToMeasurement
 * @see testtool.TestApi.createSPToMeasurement
 * @see testtool.TestApi.createMAToMeasurement
 */
type TestMetricConfig {

  /**
   * The kind of system: MDM or HeadEnd
   */
  sourceSystem: string

  /**
   * The resource: electricity, Electricity, NaturalGas, Air
   */
  resource: string

  /**
   * The measurement:
   *   Consumption, Production, Voltage, VoltHour,
   *   VoltSquaredHour, Temperature, ApparentPower, Demand,
   *   LoadSidePotentialSpecialReadLG,
   *   InductiveConsumption, InductiveProduction,
   *   CapacitiveConsumption, CapacitiveProduction
   */
  measure: string

  /**
   * The unit for each measurement.
   *
   * There are no constraints. If you use an unknown or incorrect unit, bad things might happen.
   */
  unit: string

  /**
   * The treatment type.
   *
   * Legacy, Integral, Rate, Register, Monthly
   */
  treatment: string
}
