entity extendable type TSPerfTest extends BatchJob<TSPerfTest, TSPerfTestConfig, TSPerfTestConfig> type key 'PRFTSTST' {

  /**
   * async root id for splunk query
   */
  asyncRootId: string

  startCreate:   function(numberOfThreads: int, config: TSPerfTestConfig): TSPerfTest js-server
  startEvaluate: function(numberOfThreads: int, config: TSPerfTestConfig): TSPerfTest js-server

  /**
   * 1. This test will create 'noOfDays' worth of data for 'noOfHeaders' headers with AsyncProcessingProcessingDisabled = true
   * 2. The data created will be normalized using refreshNormalization API and we wait until everything drains out from the ActionQueue
   * 3. After ActionQueue is empty, we create data for 'noOfIncrementalDays' worth of data 1 DAY AT A TIME for 'noOfHeaders' headers
   *    and AsyncProcessingDisabled = false, Normalize = ALL, which means when new data points are created, they will be invalidated
   * 4. The entries in the NormalizationQueue are then allowed to be drained (which performs incremental normalization)
   * 5. After one day is completed, we create a result object which gives us timing information and a splunk query to
   *    investigate exactly what happened.
   */
  startPerfTest: function(noOfHeaders: int,
                          noOfDays: int,
                          noOfIncrementalDays: int,
                          targetObjIdSuffix: string,
                          grain: string): TSPerfTestResult js-server

  /**
   * 1. This test will concurrently create data for headerIdNo at the desired grain
   * 2. After all the concurrent data creation is complete, raw data is compared with normalized data
   */
  startConcurrencyTest: function(headerIdNo: int,
                                 noOfConcurrentJobs: int,
                                 grain: string,
                                 noOfIterations: int) js-server

  /**
   * 1. This test will concurrently create data for headerIdNo at the desired grain
   * 2. After every random point is created, it calls tsEval for a random date & validates raw vs normalized
   * 2. After all the concurrent data creation is complete, raw data is compared with normalized data again
   */
  startConcurrencyAndValidate: function(headerIdNo: int,
                                        noOfConcurrentJobs: int,
                                        grain: string,
                                        noOfIterations: int) js-server

  /**
   * 1. This test will serially call concurrencyTest at the desired grain for headerIdNo
   * 2. After each of the concurrent job is complete, raw data is compared with normalized data
   */
  startSerialTest: function(headerIdNo: int,
                            noOfSerialJobs: int,
                            grain: string,
                            noOfConcurrentInSerial: int,
                            noOfIterations: int) js-server

  doStart:      ~ js-server
  processBatch: ~ js-server
  allComplete:  ~ js-server
}
