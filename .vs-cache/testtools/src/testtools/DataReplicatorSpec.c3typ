/**
 * Spec that configures the replication, post-replication and sanity check processes during setup
 */
entity type DataReplicatorSpec schema name 'DT_RP' {

  /**
   * The start of the replication period
   */
  start: !datetime

  /**
   * The end of the replication period
   */
  end: !datetime

  /**
   * Array of {@link CanonicalReplicationSpec} that specifies replication logic for canonicals
   */
  data: ![CanonicalReplicationSpec] schema name 'RP_LB'

  /**
   * Logic for post-replication process
   * @param start The start of the replication period
   * @param end The end of the replication period
   */
  postReplication: lambda(start: datetime, end: datetime) schema suffix 'PR'

  /**
   * Logic for sanity check process.
   * @param start The start of the replication period
   * @param end The end of the replication period
   * @return True if sanity check passes successfully, false otherwise
   */
  sanityCheck: lambda(start: datetime, end: datetime): boolean schema suffix 'SC'
}
