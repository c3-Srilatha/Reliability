/**
 * The performance budget interface.
 * More info: https://github.com/GoogleChrome/lighthouse/issues/6053#issuecomment-428385930
 * Example:
 *       {
 *         resourceSizes: [
 *           {
 *             resourceType: 'script',
 *             budget: 1000,
 *           },
 *         ],
 *       }
 */
type LighthouseConfigSettingsBudget {

  /**
   * Budgets based on resource count.
   */
  resourceCounts: [LighthouseConfigSettingsBudgetResource]

  /**
   * Budgets based on resource size.
   */
  resourceSizes: [LighthouseConfigSettingsBudgetResource]

  /**
   * Budgets based on timing metrics.
   */
  timings: [LighthouseConfigSettingsBudgetTiming]
}
