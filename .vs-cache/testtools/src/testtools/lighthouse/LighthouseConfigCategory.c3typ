/**
 * The category defines how to score and organize the audit results in the report
 */
type LighthouseConfigCategory {

  /**
   * The display name of the category.
   */
  title: string

  /**
   * The audits to include in the category.
   */
  auditRefs: [LighthouseConfigCategoryAudit]

  /**
   * The displayed description of the category.
   */
  description: string

  /**
   * Manual description
   */
  manualDescription: string
}
