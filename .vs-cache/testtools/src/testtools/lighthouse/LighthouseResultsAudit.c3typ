/**
 * An object containing the results of the audits
 */
type LighthouseResultsAudit {

  /**
   * The string identifier of the audit in kebab case.
   */
  id: string

  /**
   * The display name of the audit. The text can change depending on if the audit passed or failed. It may contain markdown code.
   */
  title: string

  /**
   * A more detailed description that describes why the audit is important and links to Lighthouse documentation on the audit, markdown links supported.
   */
  description: string

  /**
   * A string indicating the reason for audit failure.
   */
  explanation: string

  /**
   * Messages identifying potentially invalid cases
   */
  warnings: [string]

  /**
   * A message set.
   */
  errorMessage: string

  /**
   * The unscored value determined by the audit. Typically this will match the score if there's no additional information to impart. For performance audits, this value is typically a number indicating the metric value.
   */
  numericValue: double

  /**
   * The unit of `numericValue`, used when the consumer wishes to convert numericValue to a display string
   */
  numericUnit: string enum('byte', 'millisecond', 'element', 'unitless')

  /**
   * The string to display in the report alongside audit results. If empty, nothing additional is shown. This is typically used to explain additional information such as the number and nature of failing items.
   */
  displayValue: string

  /**
   * The scored value determined by the audit as a number 0-1, representing displayed scores of 0-100.
   */
  score: double

  /**
   * A string identifying how the score should be interpreted for display i.e. is the audit pass/fail (score of 1 or 0), did it fail, should it be ignored, or are there shades of gray (scores between 0-1 inclusive).
   */
  scoreDisplayMode: string enum('binary', 'numeric', 'error', 'manual', 'notApplicable', 'informative')

  /**
   * Extra information found by the audit necessary for display. The structure of this object varies from audit to audit. The structure of this object is somewhat stable between minor version bumps as this object is used to render the HTML report.
   */
  details: json
}
