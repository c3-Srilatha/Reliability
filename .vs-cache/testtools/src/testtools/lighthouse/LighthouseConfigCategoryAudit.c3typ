/**
 * How to score and group an audit
 * Example:
 *      {
 *        id: 'accesskeys',
 *        weight: 1,
 *        group: 'a11y-correct-attributes'
 *      }
 */
type LighthouseConfigCategoryAudit {

  /**
   * The ID of the audit to include.
   */
  id: string

  /**
   * The weight of the audit in the scoring of the category.
   */
  weight: double

  /**
   * The ID of the display group of the audit.
   */
  group: string
}
