/**
 * Timing budget object.
 *
 * Example:
 *       {
 *         "metric": "interactive",
 *         "budget": 2000,
 *         "tolerance": 1000
 *       }
 */
type LighthouseConfigSettingsBudgetTiming {

  /**
   * The type of timing metric
   */
  metric: string enum('first-contentful-paint', 'first-cpu-idle', 'interactive', 'first-meaningful-paint', 'max-potential-fid')

  /**
   * Budget for timing measurement, in milliseconds.
   */
  budget: double

  /**
   * Tolerance, i.e. buffer, to apply to a timing budget. Units: milliseconds.
   * Tolerance is optional, it is possible to not provide it.
   */
  tolerance: double
}
