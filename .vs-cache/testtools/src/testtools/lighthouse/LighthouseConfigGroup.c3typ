/**
 * An object containing the display groups of audits for the report, keyed by the group ID found in the config.
 * Example of the `a11y-correct-attributes` category:
 *      {
 *        title: 'Elements Use Attributes Correctly',
 *        description: 'These are opportunities to improve the configuration of your HTML elements.',
 *      }
 */
type LighthouseConfigGroup {

  /**
   * The title of the display group.
   */
  title: string

  /**
   * A brief description of the purpose of the display group.
   */
  description: string
}
