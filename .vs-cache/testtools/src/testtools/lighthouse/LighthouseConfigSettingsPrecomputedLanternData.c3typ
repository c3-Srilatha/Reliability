/**
 * Precomputed Lantern Data object.
 * See https://github.com/GoogleChrome/lighthouse/blob/master/lighthouse-cli/test/smokehouse/lantern-config.js
 * Example:
 *      {
 *        additionalRttByOrigin: {
 *          'http://localhost:10200': 500
 *        },
 *        serverResponseTimeByOrigin: {
 *         'http://localhost:10200': 1000,
 *        },
 *      }
 */
type LighthouseConfigSettingsPrecomputedLanternData {

  /**
   * Additional RTT by origin
   */
  additionalRttByOrigin: map<string, double>

  /**
   * Server response time by origin
   */
  serverResponseTimeByOrigin: map<string, double>
}
