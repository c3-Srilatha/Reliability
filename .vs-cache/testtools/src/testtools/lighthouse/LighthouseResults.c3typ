/**
 * Lighthouse Results is the output of lighthouse, it contains some metadata about the run and the results in the various subproperties.
 * see https://github.com/GoogleChrome/lighthouse/blob/master/docs/understanding-results.md
 */
type LighthouseResults {

  /**
   * The Lighthouse Result Object (LHR)
   */
  lhr: LighthouseResultObject

  /**
   * An object containing gatherer results.
   */
  artifacts: json

  /**
   * The HTML, JSON, and/or CSV string, depending on settings.output in lighthouse configuration.
   */
  report: string

  /**
   * The error message if an error occurs.
   */
  errorMessage: string
}
