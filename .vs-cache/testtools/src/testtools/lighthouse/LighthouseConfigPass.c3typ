/**
 * A pass object defines basic settings such as how long to wait for the page to load and whether to record a trace file.
 * Additionally a list of gatherers to use is defined per pass.
 * Example of a pass config:
 *      {
 *        passName: 'redirectPass',
 *        useThrottling: false,
 *        // Just wait for onload
 *        networkQuietThresholdMs: 0,
 *        // Speed up the redirect pass by blocking stylesheets, fonts, and images
 *        blockedUrlPatterns: ['*.css', '*.jpg', '*.jpeg', '*.png', '*.gif', '*.svg', '*.ttf', '*.woff', '*.woff2'],
 *        gatherers: [
 *          'http-redirect',
 *          'html-without-javascript',
 *        ],
 *      }
 */
type LighthouseConfigPass {

  /**
   * A unique identifier for the pass used in audits and during config extension.
   */
  passName: string

  /**
   * Records a trace of the pass when enabled. Available to gatherers during afterPass as traceData.trace and to audits in artifacts.traces.
   */
  recordTrace: boolean = true

  /**
   * Enables throttling of the pass when enabled.
   */
  useThrottling: boolean = true

  /**
   * The number of milliseconds to wait after the load event before the pass can continue.
   * Used to ensure the page has had time for post-load JavaScript to execute before ending a trace. (Default: 0)
   */
  pauseAfterLoadMs: int = 5250

  /**
   * The number of milliseconds since the last network request to wait before the page should be considered to have reached 'network quiet'.
   * Used to ensure the page has had time for the full waterfall of network requests to complete before ending a trace. (Default: 5000)
   */
  networkQuietThresholdMs: int = 5250

  /**
   * The number of milliseconds to wait after 'cpu quiet' before the pass can continue
   */
  cpuQuietThresholdMs: int = 5250

  /**
   * The number of milliseconds to wait after 'network quiet' before the pass can continue.
   * Used to ensure the page has had time for post-network-quiet JavaScript to execute before ending a trace. (Default: 0)
   */
  pauseAfterNetworkQuietMs: int

  /**
   * URLs of requests to block while loading the page. Basic wildcard support using *.
   */
  blockedUrlPatterns: [string]

  /**
   * The list of gatherers to run on this pass. This property is required and on extension will be concatenated with the existing set of gatherers.
   */
  gatherers: [string]
}
