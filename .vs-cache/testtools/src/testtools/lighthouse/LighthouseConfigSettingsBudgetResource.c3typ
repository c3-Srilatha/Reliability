/**
 * Resource budget object
 *
 * Example:
 *       {
 *         "resourceType": "script",
 *         "budget": 123
 *       }
 */
type LighthouseConfigSettingsBudgetResource {

  /**
   * The resource type that a budget applies to.
   */
  resourceType: string enum('stylesheet', 'image', 'media', 'font', 'script', 'document', 'other', 'total', 'third-party')

  /**
   * Budget for resource. Depending on context, this is either the count or size (KB) of a resource.
   */
  budget: double
}
