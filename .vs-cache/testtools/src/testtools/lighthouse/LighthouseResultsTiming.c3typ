/**
 * An object containing information about how long Lighthouse spent auditing.
 */
type LighthouseResultsTiming {

  /**
   * An array of entries
   */
  entries: [json]

  /**
   * The total time spent in milliseconds loading the page and evaluating audits.
   */
  total: double
}
