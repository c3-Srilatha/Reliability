/**
 * This table should be empty unless there is a test running.
 *
 * The main, and only use, is to keep track of the state of the random number generator
 * being used in a particular DataApiContext. Users should always
 * remove any DataApiContext's at the end of a test/use-case.
 *
 * @see DataApi.createContext
 * @see DataApi.destroyContext
 */
entity type DataApiContext schema name 'TSTL_DARNGCTX' {

  /**
   * The initial random number generator seed
   */
  seed: int

  /**
   * The random number generator seed, or the next value returned from the random number generator.
   */
  next: int
}
