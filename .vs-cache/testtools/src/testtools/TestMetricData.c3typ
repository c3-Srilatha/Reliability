/**
 * A type to store test data of a child metric
 */
@seed(userUpdatable=true, userRemovable=true, userCreatable=true)
entity type TestMetricData mixes SeedData schema name 'TSTL_TSTMCDATA' {

  /**
   * The id of the test data
   */
  id: string

  /**
   * The name of the child metric
   */
  metricName: !string

  /**
   * The id of the child metric
   */
  metricId: !string

  /**
   * The data array of the child metric
   */
  data: ![double] schema name 'DATA'

  /**
   * The missing array of the child metric
   */
  missing: [byte] schema name 'MISS'

  /**
   * The flag for predefined test data
   */
  isPredefined: boolean

  /**
   * The name of test data
   */
  name: string

  /**
   * The url of the preview image of the test data
   */
  previewImg: string
}
