/**
 * Use this to run skywalker tests with different user permissions.
 */
type TestApiUserConfig {

  /**
   * The id of the user
   */
  userId: string

  /**
   * The username of the user
   */
  username: string

  /**
   * The password for the user
   */
  password: string

  /**
   * The email of the user (to match v7 naming convention)
   */
  email: string

  /**
   * The givenName of the user (to match v7 naming convention)
   */
  givenName: string

  /**
   * The familyName of the user (to match v7 naming convention)
   */
  familyName: string

  /**
   * The id of the user (to match v7 naming convention)
   */
  id: string
}
