entity type TSPerfTestResult schema name 'TSTL_PTRSLT' {

  noOfHeaders: int
  noOfDays:    int

  /**
   * either refreshNormalization or NormalizationQueue.compute
   */
  normMode: string

  /**
   * in seconds
   */
  totalDataLoadTime: double

  /**
   * in seconds
   */
  totalNormTime: double

  /**
   * normalization start time
   */
  normStartTime: datetime

  /**
   * normalization end time
   */
  normEndTime: datetime

  splunkQuery:   string
  isInitialLoad: boolean
}
