entity type TestActionMock schema name 'TST_ACT_MCK' {

  /**
   * Target action for this action mock.
   */
  targetAction: !ActionRef

  /**
   * Call the real action when called if true, use mocked action otherwise.
   */
  callThrough: boolean = false

  /**
   * Declaration of this action mock.
   */
  decl: !TestActionMockDecl

  /**
   * Group of action mocks.
   */
  group: string

  /**
   * If provided determines order in which all registered action mocks will be evaluated for claim.
   */
  sequence: int

  actionSpy: private Action.Spy

  /**0
   * Register action mock across all nodes in cluster.
   */
  @action(group+="cluster-admin")
  register: member function() js-server

  /**
   * Unregister action mock across all nodes in cluster.
   */
  unregister: member function() js-server

  /**
   * Initialized to 0 when `register` is called, this counts the number of calls this TestActionMock has handled
   * on the current server since this TestActionMock was registered.
   */
  callCount: member function(): !int js-server

  /**
   * Initialized to [] when `register` is called, this returns all the arguments this {@link TestActionMock} is called with
   * on the current server since this TestActionMock was registered.
   * Warning: The collection of arguments an {@link TestActionMock} has been called with is _local_ to the node.
   */
  callArgs: member function(): [map<string, any>] js-server

  /**
   * Register all action mocks.
   */
  @action(group+="cluster-admin")
  registerAll: function(group: string) js-server

  /**
   * Unregister action mocks.
   */
  unregisterAll: function(group: string) js-server

  /**
   * @return all registered action mocks.
   */
  @action(group+="cluster-admin")
  allRegistered: function(group: string): [TestActionMock] js-server

  internalSpy: private member function(): Action.Spy js-server

}
