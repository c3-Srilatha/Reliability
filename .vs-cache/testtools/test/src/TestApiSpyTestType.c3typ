/**
 * Test type for testing TestApiSpy
 */
type TestApiSpyTestType {

  /**
   * Test function, should return true
   */
  shouldReturnTrue: function(): boolean js-server

  /**
   * Test function, should return null
   */
  shouldReturnNull: function(): string js-server

  /**
   * Test function, should return the first function input
   */
  shouldReturnFirstArgument: function(firstArg: !string, secondArg: string): string js-server

  /**
   * Test function, should return all input strings being concatenated
   */
  shouldReturnConcatArgs: function(firstArg: string, secondArg: string, thirdArg: string): string js-server

  /**
   * Test function, should return all nested strings in inputs being concatenated
   */
  shouldReturnConcatNestedArgs: function(firstArg: TestApiObjectContainingArrayTestType,
                                         secondArg: TestApiObjectContainingArrayTestType): string js-server

  /**
   * Test function, should return the function arg input
   */
  shouldReturnArgument: member function(arg: string): string js-server

  /**
   * Test function, should return a time 10k days ealier than now
   */
  shouldReturnPast: function(): datetime js-rhino
}
