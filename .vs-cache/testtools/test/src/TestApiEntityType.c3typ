/**
 * Test entity type
 */
entity type TestApiEntityType schema name 'TAET' {

  /**
   * Int field for testing sorting.
   */
  intField: int

  /**
   * Reference field for testing sample data generation.
   */
  referenceField: DataApiEntityType

  /**
   * Fetch-like method for this type.
   */
  fetchThisType: function(spec: !FetchSpec): FetchResult<TestApiEntityType>

  /**
   * Fetch-like method for another type.
   */
  fetchOtherType: function(spec: !FetchSpec): FetchResult<TestApiOtherEntityType> js-server

  /**
   * Fetch-like method that returns just the objects instead of a {@link FetchResult}.
   */
  fetchOtherTypeAsArray: function(spec: !FetchSpec): [TestApiOtherEntityType] js-server
}
