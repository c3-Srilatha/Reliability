/**
 * {@link Workflow} used for testing {@link TestApi#waitForJob}.
 */
type TestApiWorkflow {
  /**
   * Function used to create either a {@link Workflow} that will succeed or fail. The {@link Workflow} has a single
   * step which is {@link workflowFunction}.
   * @param throwError
   *          If true then an error will be thrown during the {@link Workflow} execution. Passed through to
   *          {@link workflowFunction}.
   * @param stallTime
   *          The amount of time to stall (in ms) before invoking the function. Passed through to
   *          {@link workflowFunction}.
   * @returns The {@link Workflow} that will either succeed or fail.
   */
  createWorkflow: function(throwError: boolean, stallTime: int = 0): Workflow js-rhino

  /**
   * Function used as part of a {@link Workflow} only used to force an error in a {@link Workflow}.
   * @param throwError
   *          If true then an error will be thrown.
   * @param stallTime
   *          The amount of time to stall (in ms) before throwing an error. Used by {@link Thread#sleep}.
   */
  workflowFunction: private function(throwError: boolean, stallTime: int = 0) js-rhino
}
