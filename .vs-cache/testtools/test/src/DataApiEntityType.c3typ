/**
 * Test entity type
 */
entity type DataApiEntityType mixes DataApiEntityMixinType schema name 'DAET' {

  /**
   * Int field
   */
  intField: int

  /**
   * Datetime field
   */
  datetimeField: datetime

  /**
   * Double field
   */
  doubleField: double

  /**
   * Boolean field
   */
  booleanField: boolean

  /**
   * Reference field
   */
  referenceField: TestApiEntityType

  /**
   * Required field
   */
  requiredField: !int

  /**
   * Foreign key reference field
   */
  foreignKeyReferenceField: TestApiEntityType(id, referenceField)

  /**
   * Foreign key reference collection field
   */
  foreignKeyReferenceCollectionField: [TestApiEntityType](referenceField)

  /**
   * Dimension field
   */
  dimensionField: Dimension

  /**
   * Unit field
   */
  unitField: Unit

  /**
   * Stored calc field
   */
  storedCalcField: double stored calc doubleField + 10

  /**
   * Stored collection field
   */
  storedCollectionField: [TestApiEntityType] schema name 'TAET'

  /**
   * Duration field
   */
  durationField: Duration

  /**
   * Test method
   */
  testMethod: function() js-server
}
