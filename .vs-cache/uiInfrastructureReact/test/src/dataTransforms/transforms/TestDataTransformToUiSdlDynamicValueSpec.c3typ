/**
 * A {@link UiSdlDataTransform} for unit testing {@link UiSdlDynamicValueSpecParam#dataTransforms}.
 */
@typeScript
private type TestDataTransformToUiSdlDynamicValueSpec mixes UiSdlDataTransform<int, UiSdlDynamicValueSpecParam> {

  /**
   * Returns a {@link UiSdlCustomDynamicValueSpecParam} with {@link UiSdlCustomDynamicValueSpecParam#valueToAddFive valueToAddFive}
   * set to the given `string` input value.
   *
   * @param data
   *           The input value to set to {@link UiSdlCustomDynamicValueSpecParam#valueToAddFive}.
   * @returns a {@link UiSdlCustomDynamicValueSpecParam} with the given `data` input value.
   */
  transform: ~ ts-client
}
