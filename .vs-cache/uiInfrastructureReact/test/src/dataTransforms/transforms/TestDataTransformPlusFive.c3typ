/**
 * A {@link UiSdlDataTransform} for unit testing purposes.
 */
@typeScript
private type TestDataTransformPlusFive mixes UiSdlDataTransform<[int], [int]> {

  /**
   * Override abstract function, to specifically transform array of integers to an array of integers all of which have
   * had 5 added to them.
   *
   * @param data
   *           The list of integers to add by 5.
   * @returns The addition result.
   */
  transform: ~ ts-client
}
