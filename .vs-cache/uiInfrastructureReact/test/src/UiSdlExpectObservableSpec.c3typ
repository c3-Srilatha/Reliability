/**
 * A test spec for {@link UiSdlEpic#effect effect} or {@link UiSdlEpic} methods
 */
type UiSdlExpectObservableSpec {

  /**
   * The epic method to be tested.
   */
  epic: lambda(actionStream: UiSdlObservable,
               stateStream: UiSdlObservable<UiSdlReduxState>): UiSdlObservable<UiSdlReduxState>

  /**
   * The input observable stream as a pair: marble diagram string,
   * observables object.
   *
   * input[0] Marble diagram string
   * input[1] Observables mapping
   */
  input: Pair<string, map<string, UiSdlReduxAction>>

  /**
   * The expected observable stream as a triplet: marble diagram string,
   * observables object, observable error.
   *
   * output[0] Marble diagram string
   * output[1] Observables mapping
   * output[2] UiSdlObservable error
   */
  output: Triple<string, map<string, UiSdlReduxAction>, map<string, any>>
}
