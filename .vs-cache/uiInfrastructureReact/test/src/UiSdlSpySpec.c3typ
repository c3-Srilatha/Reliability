/**
 * The implementation spec for a spy
 */
type UiSdlSpySpec {

  /**
   * If `true`, calls the original function's real implementation.
   */
  callThrough: boolean

  /**
   * Return value if desired, which will be passed to
   * `jasmine.spy().and.returnValue`.
   * If `undefined` is the desired return value, simply do not
   * set a return value or `callThrough`.
   */
  returnValue: any

  /**
   * Function to call in place of the spied on function.
   */
  callFake: lambda(): any
}
