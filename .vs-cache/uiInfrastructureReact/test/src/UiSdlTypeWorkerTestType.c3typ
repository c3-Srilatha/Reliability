/**
 * Type used for testing the logic in the functions of {@link UiSdlTypeWorker}.
 */
@uiSdlDesignerComponent(designable=true)
private type UiSdlTypeWorkerTestType mixes UiSdlComponent<UiSdlTypeWorkerTestTypeDataSpec> {

  /**
   * Dummy field for testing purposes.
   */
  dummyField: string = 'testing default value'

  /**
   * Dummy private field for testing purposes.
   */
  dummyPrivateField: private string

  /**
   * Dummy required field for testing purposes.
   */
  dummyRequiredField: !string

  /**
   * Dummy array field for testing purposes.
   */
  dummyArrayField: [string]

  /**
   * Dummy reference field for testing purposes.
   */
  dummyReferenceField: UiSdlTypeWorkerTestReferenceType

  /**
   * The children components to render within this component.
   */
  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]

  /**
   * Dummy array reference field for testing purposes.
   */
  dummyArrayReferenceField: [UiSdlTypeWorkerTestReferenceType]

  /**
   * Dummy enum field for testing purposes.
   */
  dummyEnumField: string enum('one', 'Two', 'THREE')

  /**
   * Dummy enum Type field for testing purposes.
   */
  dummyEnumTypeField: string enum UiSdlTypeWorkerTestEnum

  /**
   * Dummy field with binding for testing purposes.
   */
  dummyFieldWithBinding: UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>

  /**
   * Dummy field with custom renderer for testing purposes.
   */
  @uiSdlDesignerCustomRenderer(rendererType='SDLInput')
  dummyFieldWithCustomRenderer: string

  /**
   * Dummy method for testing purposes.
   */
  dummyMethod: function(): any ts-client
}
