/**
 * A React Hook to find {@link UiSdlApplicationState} metadata in the Redux store and use it in connected components.
 */
@typeScript
private type UiSdlUseApplicationMetadata {

  /**
   * Finds the metadata for the given {@link UiSdlApplicationState#id} and initializes it if not found.
   *
   * @param applicationId
   *           The `id` of the {@link UiSdlApplicationState} whose metadata you want to use.
   *           This corresponds to the filename of your application state metadata JSON.
   * @param initialMetadata
   *           The metadata to be used if no metadata is found.
   */
  useApplicationMetadata: function(applicationId: !string,
                                   initialMetadata: UiSdlApplicationState): UiSdlApplicationState ts-client
}
