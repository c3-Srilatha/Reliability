/**
 * A React Hook for triggering initial render and register triggers
 */
@typeScript
private type UiSdlUseTriggerRegister {

  /**
   * Triggers an action to register triggers and fires the initial render action
   *
   * @param metadataId
   *           The id of the component whose metadata you want to use.
   * @param registered
   *           The boolean returned after registerTriggers finishes registering triggers
   * @param registerTriggerAction
   *           An action to be called the first time the given component registers
   *           effect triggers. This will not be called on subsequent mounts nor
   *           subsequent renders
   * @param onInitialRender
   *           A function to be called the first time the given component renders,
   *           and only on the first render. This will not be called on
   *           subsequent mounts nor subsequent renders.
   * @returns the current state of the component in the Redux state.
   */
  useTriggerRegister: function(metadataId: string,
                        registered: boolean,
                        registerTriggerAction: UiSdlRegisterTriggersAction,
                        onInitialRender: lambda()): UiSdlComponent ts-client
}
