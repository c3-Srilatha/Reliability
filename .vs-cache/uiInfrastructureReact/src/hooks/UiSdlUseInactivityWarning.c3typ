/**
 * A React Hook for tracking user inactivity, with automatic logout.
 *
 * This is automatically enabled in {@link UiSdlSiteReact}. To configure the inactivity logout,
 * see {@link UiSdlSecurityConfig}.
 *
 * @see UiSdlConfig
 * @see UiSdlSecurityConfig
 */
@typeScript
private type UiSdlUseInactivityWarning {

  /**
   * Keeps track of user activity in local storage and calls an action dispatcher when the warning
   * period specified in UiSdlConfig.security.inactivityWarningPeriod has elapsed.
   *
   * When {@link UiSdlUseInactivityWarning#inactivityLogoutPeriod}
   * has elapsed without activity, the user will be logged out.
   *
   * @param openWarningModalAction
   *           The action creator to call when the warning period has elapsed.
   */
  useInactivityWarning: function(openWarningModalAction: lambda(args: any ...)) ts-client
}
