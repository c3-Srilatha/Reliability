/**
 * A React Hook that returns the {@link UiSdlRoute routes} available to the current {@link UiSdlSite}.
 */
@typeScript
private type UiSdlUseRoutes {

  /**
   * Obtains the routes stored in the site's state (see {@link UiSdlSite#routes}). This will return the current
   * value of the field, which may be undefined if the routes have not been retrieved from the server yet.
   *
   * @returns the current list of routes, or `undefined` if they have not been loaded yet.
   */
  useRoutes: function(): [UiSdlRoute] ts-client
}
