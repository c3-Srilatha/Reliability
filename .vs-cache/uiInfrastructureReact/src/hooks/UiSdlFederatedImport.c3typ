/**
 * Dynamic importer for components and types generated in a federated module
 * as defined by Webpack.
 *
 * @see uiInfrastructureReact/ui/c3/config/webpack.config.js
 */
@typeScript
private type UiSdlFederatedImport {

  /**
   * Import a type or component from a given federated module.
   *
   * @param moduleName
   *           The name of the federated module, the c3 application
   *           package name is used as module name
   * @param kind
   *           A string, 'types' or 'components'
   * @param name
   *           The name of the value to import
   */
  federatedImport: function(moduleName: string, kind: string enum('types', 'components'), name: string): any ts-client

  /**
   * Import a type or component from a given federated module and external url.
   * @param url
   *           The url of the external server that hosts the federated module
   * @param moduleName
   *           The name of the federated module, the c3 application
   *           package name is used as module name
   * @param kind
   *           A string, 'types' or 'components'
   * @param name
   *           The name of the value to import
   */
  tunneledFederatedImport: function(url: string,
                                    moduleName: string,
                                    kind: string enum('types', 'components'),
                                    name: string): any ts-client
}
