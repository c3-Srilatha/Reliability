/**
 * A React Hook that returns the reference of a timeout function.
 */
@typeScript
type UiSdlUseIsOverflow {

  /**
   * The useIsOverflow hook checks if content within an HTML element is overflowing
   * in the specified direction X, Y or both.
   * It returns a boolean and optionally calls a callback function.
   * It is useful for conditional rendering or styling based on overflow.
   *
   * @param ref
   *          A reference to the HTML element that needs to be checked for overflow. This is a required parameter.
   * @param direction
   *              overflowX: A boolean value that indicates whether to check for overflow in the X direction. If this property is not provided, it defaults to true.
   *              overflowY: A boolean value that indicates whether to check for overflow in the Y direction. If this property is not provided, it defaults to false.
   * @param callback
   *          An optional function that is called with the boolean value of the overflow check. This function is
   *          called every time the overflow status of the element changes.
   * @returns
   *          A boolean value that indicates whether the content within the referenced HTML element is overflowing or not.
   */
  useIsOverflow: function(ref: any, direction: UiSdlUseIsOverflowDirection={}, callback: any): boolean ts-client
}
