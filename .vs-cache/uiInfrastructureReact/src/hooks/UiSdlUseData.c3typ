/**
 * A React Hook for loading data for a given component's {@link UiSdlComponentDataSpec data specs}.
 */
@typeScript
private type UiSdlUseData {

  /**
   * Finds the data for the given component ID.
   *
   * @param componentId
   *           The `id` of the component whose data you want to use.
   *           This corresponds to the filename of your UI component metadata.
   * @param dataSpecs
   *           A list of the component's data specs.
   * @param metadata
   *           The component metadata.
   * @return an array containing two elements. The first element is a map of
   *           field names to data for each field. The second element is a map
   *           of field names to a status for loading the data.
   */
  useData: inline function(componentId: !string,
                           dataSpecs: [UiSdlDataSpecDetails],
                           metadata: UiSdlComponent): [map<string, any> | map<string, string enum UiSdlUseDataStatus>] ts-client
}
