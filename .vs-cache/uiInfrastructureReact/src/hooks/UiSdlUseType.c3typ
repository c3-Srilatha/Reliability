/**
 * A React Hook to import the TypeScript module for a {@link Type}.
 */
@typeScript
private type UiSdlUseType {

  /**
   * Asynchronously imports the TypeScript module for the Type with the given name.
   *
   * @param typeName
   *           The name of the Type to import.
   * @returns the Type being imported, or `null` while import is pending
   *
   * @see https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Statements/import
   */
  useType: function(typeName: string): Type ts-client
}
