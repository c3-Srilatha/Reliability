/**
 * A React Hook to resolve a set of dynamic values from the Redux store.
 */
@typeScript
private type UiSdlUseDerivedProps {

  /**
   * Resolves the given {@link UiSdlConnected#derivedProps}.
   *
   * @param derivedProps
   *           A map of dynamic values to resolve, indexed by prop name.
   * @returns the resolved dynamic values, indexed by prop name.
   */
  useDerivedProps: function(derivedProps: !map<string, UiSdlStateValueParam>): map<string, any> ts-client
}
