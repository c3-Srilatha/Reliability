/**
 * A React hook to get the current {@link UiSdlSite}'s tunnel configuration from the Redux store.
 */
@typeScript
private type UiSdlUseTunnelConfiguration {

  /**
   * Gets the application's current tunnel configuration from the Redux state.
   *
   * @returns the current tunnel configuration.
   */
  useTunnelConfiguration: function(): UiSdlTunnelConfiguration ts-client
}
