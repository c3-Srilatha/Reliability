/**
 * A React Hook for initializing the metadata and reading the current state of a given component in the Redux store.
 */
@typeScript
private type UiSdlUseMetadata {

  /**
   * Finds the metadata for the given component ID and initializes it if not found.
   *
   * @param metadataId
   *           The id of the component whose metadata you want to use.
   *           This corresponds to the filename of your component metadata JSON.
   * @param initialMetadata
   *           The metadata to be used if no metadata is found.
   * @returns the current state of the component in the Redux state.
   */
  useMetadata: function(metadataId: string,
                        initialMetadata: UiSdlComponent): UiSdlComponent ts-client
}
