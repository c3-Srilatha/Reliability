/**
 * A React Hook that returns the reference of a timeout function.
 */
@typeScript
type UiSdlUseTimeout {

  /**
   * Registers a timeout function in the component that will be waiting
   * for the component to trigger and if there's an event excuting multiple times,
   * it will reset the timer and avoid registering the function the same amount of times
   *
   * @param callback
   *          The callback setTimeout function that is registered to be executedonce the timer stops.
   * @param delay
   *          The initial delay (in ms) that represents the duration of the waiting period to trigger the timeout function
   * @returns clear and reset functions that allows the controller to reset the timer as needed and clear the timeout when it's done.
   */
  useTimeout: function(callback: any, delay: int): any ts-client
}
