/**
 * Provides a hook that allows a component to wrap itself with a div that contains a class name
 * suitable for targeting that component by its metadata id.
 */
@typeScript
private type UiSdlUseMetadataIdWrapper {

  /**
   * The hook which conditionally wraps a div around the passed component.
   */
  useMetadataIdWrapper: function(component: UiSdlComponent,
                                 metadataId: string,
                                 shouldUseMetadataIdWrapper: boolean): UiSdlComponent ts-client
}
