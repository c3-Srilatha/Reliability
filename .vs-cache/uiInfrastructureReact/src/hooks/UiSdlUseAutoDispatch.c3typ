/**
 * A React Hook auto-dispatch wrapper for action creators.
 *
 * This is used to generate a set of props that can be passed to React components, which when invoked will
 * automatically call a component's action creator function with the first argument (`id`) populated and
 * then automatically dispatch that action to the Redux store.
 */
@typeScript
private type UiSdlUseAutoDispatch {

  /**
   * Given a map of string to action creator functions, wraps them to automatically dispatch their
   * returned action when called.
   *
   * @param actionCreators
   *           The action creators, indexed by function name.
   * @param componentId
   *           The id of the component that is wrapping them.
   * @returns a new map of wrapped action creators with partially applied arguments for `id`.
   */
  useAutoDispatch: function(actionCreators: map<string, lambda(id: string, args: any ...): UiSdlReduxAction>,
                            componentId: string): map<string, lambda(args: any ...)> ts-client
}
