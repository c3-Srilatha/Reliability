/**
 * A React Hook to recursively resolve context variables from a data spec.
 */
@typeScript
private type UiSdlUseResolveContextVars {

  /**
   * Resolves the given {@link WithContextVars#contextVars}.
   *
   * @param dataSpec
   *           A data spec with context variables to resolve
   * @returns the resolved data spec
   */
  useResolveContextVars: function(dataSpec: !map<string, native>): UiSdlComponentDataSpec ts-client
}
