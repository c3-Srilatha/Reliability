/**
 * A React Hook for making network requests to `api/8/` to perform actions on C3 Types.
 */
@typeScript
type UiSdlUseC3Action {
  /**
   * A react hook to make a network call for a C3 Action via `api/8/{typeName}/{actionName}`.
   *
   * @param spec
   *          The {@link C3ActionSpec} to specify the behavior for the hook.
   *
   * @returns A {@link C3ActionResponse} specifying the current state of the network response.
   */
  useC3Action: function(spec: C3ActionSpec, invalidators: [any]): C3ActionResponse ts-client

  /**
   * A function to make a single network call for a C3 Action via `api/8/{typeName}/{actionName}`.
   *
   * @param spec
   *          The {@link C3ActionSpec} to specify the arguments for the network call.
   *
   * @returns The response body as either a string or json.
   */
  postC3Action: private function(spec: C3ActionSpec): Promise<json> | string ts-client
}
