/**
 * The response from {@link UiSdlUseC3Action#useC3Action} that gives information about the current state of the action.
 */
type C3ActionResponse {
  /**
   * The error message if any from the action performed by {@link UiSdlUseC3Action}.
   */
  error: string

  /**
   * The data returned by an action performed by {@link UiSdlUseC3Action}.
   */
  data: any

  /**
   * The current status of the network call from {@link UiSdlUseC3Action}.
   */
  status: string enum('done', 'loading', 'error')
}
