/**
 * A React Hook for getting a `dispatch` function bound to the current Redux store.
 *
 * Additional `meta` information, including the current {@link UiSdlSite}'s `id` is added
 * to each action.
 */
@typeScript
private type UiSdlUseDispatch {

  /**
   * Enhanced dispatch function that adds the current {@link UiSdlSite}'s `id` to the action metadata.
   */
  useDispatch: function(): lambda(args: any ...) ts-client
}
