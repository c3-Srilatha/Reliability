/**
 * A React Hook to get the data specs of a {@link Type}.
 */
@typeScript
private type UiSdlUseTypeDataSpecs {

  /**
   * Asynchronously retrieves the data specs of the Type with the given typeName.
   *
   * @param typeName
   *           The name of the Type.
   * @returns A Promise that resolves to the data specs of the Type.
   *
   * @see https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Statements/import
   */
  useTypeDataSpecs: function(typeName: string): Promise<[UiSdlDataSpecDetails]> ts-client
}
