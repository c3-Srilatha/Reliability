/**
 * Implements UiSdlRenderCondition for component rendering based on a {@link UiSdlDynamicValueSpecParam} value.
 */
@typeScript
type UiSdlDynamicValueSpecParamCondition mixes UiSdlComparisonCondition {

  /**
   * The UiSdlDynamicValueSpecParam that contains the value to extract
   */
  param: !UiSdlDynamicValueSpecParam

  produceSubject: ~ ts-client
}
