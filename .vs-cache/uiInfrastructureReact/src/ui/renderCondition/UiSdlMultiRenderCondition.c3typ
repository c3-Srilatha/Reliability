/**
 * Evaluates multiple {@link UiSdlComparisonCondition}s to determine a final result.
 * The conditions can be `AND`ed or `OR`ed together.
 */
@typeScript
type UiSdlMultiRenderCondition mixes UiSdlRenderCondition {

  /**
   * Conditions to evaluate
   */
  conditions: [UiSdlComparisonCondition]

  /**
   * How to combine the conditions
   */
  operator: string enum ('AND', 'OR') = 'AND'

  useCondition: ~
}
