/**
 * Implements {@link UiSdlRenderCondition} for permission-based component rendering.
 *
 * If specified in {@link UiSdlConditionalRenderer#condition}, it will render the
 * thenComponent when the logged-in user belongs to the given admin group, otherwise,
 * the elseComponent will be rendered.
 *
 * A null value will be returned if admin groups were not properly retrieved for the user,
 * in other words, when the parent {@link UiSdlSite} doesn't have a groups array in the user state.
 * This behavior will tell the {@link UiSdlConditionalRenderer} to display a spinner by default, in
 * case the state is pending because of an async XHR but can be made to display the elseComponent
 * with {@link UiSdlConditionalRenderer#useElseComponentAsFallback}.
 *
 * Example:
 *
 * The following component will only render `MyApp.AdminGrid` when the logged in user
 * belongs to the `C3.Group.ClusterAdmin` AdminGroup.
 *
 *     {
 *       type: "UiSdlConditionalRenderer",
 *       condition: {
 *         type: "UiSdlPermissionRenderCondition",
 *         adminGroup: {"id": "C3.Group.ClusterAdmin"}
 *       },
 *       thenComponent: {
 *         id: "MyApp.AdminGrid"
 *       }
 *     }
 */
@typeScript
type UiSdlPermissionRenderCondition mixes UiSdlRenderCondition {

  /**
   * Admin group that has permission. The component will render for users who belong to the given admin group.
   */
  adminGroup: UserGroup

  useCondition: ~
}
