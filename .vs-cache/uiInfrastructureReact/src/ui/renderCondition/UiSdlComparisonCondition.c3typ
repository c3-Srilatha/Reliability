/**
 * Render condition that compares a subject value against a target value
 */
@typeScript
abstract type UiSdlComparisonCondition mixes UiSdlRenderCondition {

  /**
   * Produces a subject for comparison
   */
  produceSubject: abstract function(condition: mixing UiSdlComparisonCondition, state: UiSdlReduxState): any ts-client

  /**
   * An optional operator to evaluate the resolved {@link #produceSubject} value against the
   * {@link #value}. The subject value will be on the left hand side of the operator,
   * ${subject} < ${value} where operator is LESS_THAN.
   */
  operator: string enum UiSdlConditionalOperator = EQUAL

  /**
   * The target value for comparison
   */
  value: any

  useCondition: ~
}
