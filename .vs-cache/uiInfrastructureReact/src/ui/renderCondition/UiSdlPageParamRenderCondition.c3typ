/**
 * Implements UiSdlRenderCondition for component rendering based on page param conditions.
 *
 * It will render the thenComponent when the page param requested from pageParamId is empty, otherwise,
 * the elseComponent will be rendered.
 *
 * Example:
 *
 * The following component will only render `SDLDemo.PageTitleAutoFillGrid` when page param exists.
 *
 * {
 *   "type": "UiSdlConditionalRenderer",
 *   "condition": {
 *     "type": "UiSdlPageParamRenderCondition",
 *     "pageParamId": "SDLDemo.GlobalFilterInputWithAutoFillValue"
 *   },
 *   "elseComponent": {
 *     "id": "SDLDemo.PageTitleAutoFillGrid"
 *   },
 *   "thenComponent": {
 *     "id": "SDLDemo.PageTitleAutoFillEmptyContent"
 *   }
 * }
 */
@typeScript
type UiSdlPageParamRenderCondition mixes UiSdlComparisonCondition {

  /**
   * The Id of the page param
   */
  pageParamId: string

  operator: ~= EMPTY

  produceSubject: ~
}
