/**
 * Payload for a {@link UiSdlGlobalRedirectPayload}
 */
type UiSdlGlobalRedirectPayload {

  /**
   * Url path used to redirect site, it can be a relative or absolute path.
   */
  url: string

  /**
   * A map of url params and their respective values.
   */
  params: map<string, string>

  /**
   * Whether to go back.
   */
  back: boolean

  /**
   * Whether to replace the url in the browser history.
   */
  replace: boolean
}
