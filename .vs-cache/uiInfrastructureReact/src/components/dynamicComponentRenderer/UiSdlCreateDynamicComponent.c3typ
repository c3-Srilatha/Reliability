/**
 * Uses a {@link UiSdlDynamicComponentRenderer} to create a connected component.
 */
@typeScript
type UiSdlCreateDynamicComponent {

  /**
   * Returns a dynamic connected component given parent and component props.
   *
   * @param parentProps
   *           The props of the parent component.
   * @param componentProps
   *           The props of the dynamic component.
   * @returns A connected dynamic component.
   */
  createDynamicComponent: function(parentProps: any, componentProps: any): ReactFunction ts-client
}
