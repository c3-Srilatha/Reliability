/**
 * React Context for the current set of {@link Translation} data.
 */
@typeScript
type UiSdlTranslationContext {

  /**
   * The set of {@link Translation} data for the current {@link Locale}.
   * Indexed by {@link Translation#key}, each value is the {@link Translation#value}.
   */
  value: !map<string, string>
}
