/**
 * Provides methods for producing pseudolocalized Translations.
 */
@typeScript
private type UiSdlPseudolocale {

  /**
   * Pseudolocalizes the given Translation bundle to the given pseudolocale.
   *
   * @param translations
   *           The Translation bundle to pseudolocalize.
   * @param targetLanguageTag
   *           The pseudolocale language tag to produce.
   * @returns A full pseudolocalized Translation bundle.
   */
  psuedolocalizeBundle: private function(translations: map<string, string>,
                                         targetLanguageTag: string): map<string, string> ts-client

  /**
   * Determines if the given language tag is that of a pseudolocale, e.g. `en-XA` and `ar-XB`.
   *
   * @param languageTag
   *           The locale language tag to check if it is a pseudolocale.
   * @return `true` if it is a pseudolocale, `false` otherwise.
   */
  isPseudolocale: private function(languageTag: string): boolean ts-client
}
