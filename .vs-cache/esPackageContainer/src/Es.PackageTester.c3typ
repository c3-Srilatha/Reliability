/**
 * Type to run tests for a {@link Es#Package} based on its configurations.
 */
type Es.PackageTester {
    /**
     * Function to run tests for a given {@link Es#Package}.
     */
    @nodejs(typeSystem=true, async=false)
    testEsPackage: function(package: Es.Package) js-node

    /**
     * Helper function to merge multiple `json` reports into one single report.
     */
    @nodejs(typeSystem=false, async=false)
    mergeReports: private function(reports: [string]): string js-merge-node
}
