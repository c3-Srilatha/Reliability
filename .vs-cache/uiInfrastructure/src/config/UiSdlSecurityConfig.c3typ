/**
 * Specifies the security settings for UI applications.
 */
type UiSdlSecurityConfig mixes ConfigChild<UiSdlConfig> {

  /**
   * The period of inactivity before the user is automatically logged out. By default the users will not be logged out.
   */
  inactivityLogoutPeriod: string serialized Period

  /**
   * The period of inactivity before the user is shown a warning message. By default the users will not be warned.
   *
   * Only applicable when inactivityLogoutPeriod is greater than 0
   */
  inactivityWarningPeriod: string serialized Period
}
