/**
 * Specifies user configurations for UI applications.
 */
@config(minOverride=USER, maxOverride=USER)
type UiSdlUserPreference mixes Config, DefaultInstance {

  inst: ~ js-server

  /**
   * Preferred locale.
   *
   * - This {@link Locale} should be present in the application's seed data.
   * - If the user's preference does not match any of the available locales
   *   specified in {@link UiSdlI18nConfig#locales}, the application will use the first
   *   locale in the available locales list.
   * - If this available locales list is empty, the application will fallback to `'en'`.
   */
  preferredLocale: Locale

  /**
   * @inheritdoc Config
   *
   * UiSdlUserPreference overrides this to make sure non-type aware clients can retrieve configurations with defaults.
   */
  //configValue: ~ js-server
}
