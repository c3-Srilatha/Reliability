/**
 * Specifies the style settings for UI applications.
 */
type UiSdlStyleConfig mixes ConfigChild<UiSdlConfig> {

  /**
   * The theme of the application
   */
  theme: UiSdlThemeTemplate

  /**
   * The density of the application
   */
  density: UiSdlDensityTemplate

  /**
   * Prefix to be added to all css selectors
   */
  @beta
  namespace: private string;

  /**
   * Style all <button> tags with C3 look-and-feel.
   * @see enable-default-button-styles.c3doc.md
   */
  @beta
  useDefaultButtonStyle: boolean = false;
}
