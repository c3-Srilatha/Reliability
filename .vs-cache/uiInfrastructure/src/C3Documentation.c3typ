/**
 * Represents the structure of the result from DocService.
 * This type is used to encapsulate the documentation content and its title.
 */
type C3Documentation {

  /**
   * Title of the topic. Only defined if not included inside the documentation HTML
   */
  title: string

  /**
   * The documentation HTML
   */
  doc: string
}
