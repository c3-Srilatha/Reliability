/**
* UiSdlUserContext serves as a in between the User and the UI.
*/

type UiSdlUserContext {

  /*
   * Information about the current {@link User}.
   */
  user: User

  /*
   * Roles associated with the current {@link User}.
   */
  roles: [Role]

  /*
   * Security level associated with the current {@link User}.
   */
  securityLevel: int

  /*
   * Provides the current {@link User}'s preferred locale. See {@link UiSdlUserPreference#preferredLocale} for more details.
   */
  preferredLocale: Locale

  /*
   * Provides information about the current {@link User}'s {@link App#rootPkg} he or she is using.
   */
  appRootPkgName: string

  /**
   * Retrieves the current user's info including roles and security level, preferred locale, and app root package name.
   */
  getUser: function(): UiSdlUserContext js-server
}
