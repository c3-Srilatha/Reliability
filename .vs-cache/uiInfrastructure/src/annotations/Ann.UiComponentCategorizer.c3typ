/**
 * An {@link Annotation} to specify a component's name and category
 */
@annotation(appliesTo=['type'])
@typeScript
type Ann.UiComponentCategorizer mixes Annotation {

  /**
   * The human-readable name for the component
   */
  name: !string

  /**
   * The category for the component
   */
  category: string enum ('Patterns', 'Components', 'Data Visualization')

  /**
   * Other names this component might go by.
   */
  aliases: [string]

  /**
   * Whether or not this component should show in the components page for documentationPortal package.
   */
  hide: private boolean = false
}
