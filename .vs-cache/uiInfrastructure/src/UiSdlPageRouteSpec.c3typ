/**
 * Encapsulates the settings used to create a new {@link UiSdlRoute} and its corresponding UI page.
 */
type UiSdlPageRouteSpec {

  /**
   * See {@link UiSdlRoute#id}
   */
  id: !string

  /**
   * See {@link UiSdlRoute#urlPath}
   */
  urlPath: !string

  /**
   * See {@link UiSdlRoute#targetPageName}
   */
  targetPageName: !string

  /**
   * See {@link UiSdlRoute#targetModuleName}
   */
  targetModuleName: string

  /**
   * The name of the template type to use for the new page.
   */
  templateTypeName: string serialized Type = 'UiSdlConnected<UiSdlLayoutNavigation>'

  /**
   * The name of the nav menu component to use for the new page.
   */
  navMenuComponentName: string = 'ApplicationNavMenu'
}
