/**
 * A type to cache manifest as computing manifest is expensive.
 */
entity type UiSdlMetadataFileManifestCache {

  /**
   * Cached content of the manifest.
   */
  content: map<string, UiSdlMetadataFileManifestEntry>

  /**
   * Returns the cached manifest. The manifest will be generated if it is missing or `regenerate` is true.
   */
  generateManifest: function(regenerate: boolean, files: map<string, UiSdlMetadataFile>): map<string, UiSdlMetadataFileManifestEntry> js-server
}
