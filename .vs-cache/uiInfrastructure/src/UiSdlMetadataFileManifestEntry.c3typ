/**
 * An entry inside a UiSdlMetadataFile manifest.
 *
 * @see UiSdlMetadataFileManifestCache.generateManifest
 */
type UiSdlMetadataFileManifestEntry {

  /**
   * The digest for the file
   */
  md5: string

  /**
   * The federated module where this file is bundled
   */
  federatedModule: [string] schema suffix 'FMD'

  /**
   * The file category
   */
  category: string enum UiSdlMetadataFileCategory

  /**
   * The EcmaScript Module name. This is the name used to extract a ESM from a Federated Module remote entry.
   */
  moduleName: string

  /**
   * The C3 package where the file is defined (first in remix order).
   */
  package: string
}
