/**
 * Data Spec type source code loader.
 */
private type UiSdlTypeDataSpecsSourceCodeLoader mixes UiSdlFileLoader {

  /**
   * Generates source code for each data spec type
   */
  produceAll: ~ js-server

  /**
   * Generates the import statements for components that have data specs
   * @param componentTypeNames
   *          The names of the {@link UiSdlComponent} types that should have the import
   *          statements generated
   * @return import statement
   */
  dataSpecImportStatementsForComponentType: function(componentTypeNames: [string]): string js-server

  /**
   * Returns the list of {@link FieldType} that have the {@Ann.UiSdlDataSpec} annotation
   * declared on it for the given {@link UiSdlComponent} type
   * @param componentTypeName
   *            The {@link UiSdlComponent} type name
   * @return the list of {@link FieldType}
   */
  dataSpecFieldTypesForComponent: function(componentTypeName: string): [FieldType] js-server
}
