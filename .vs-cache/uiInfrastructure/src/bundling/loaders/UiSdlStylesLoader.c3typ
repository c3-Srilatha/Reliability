/**
 * Style source code loader.
 */
private type UiSdlStylesLoader mixes UiSdlFileLoader {

  /**
   * Generates files with style source code.
   */
  produceAll: ~ js-server

  /**
   * Replaces base css import with individual imports of each base css file.
   */
  generateNewCssImports: private function(oldFile: string): string js-server

}
