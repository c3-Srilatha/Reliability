/**
 * Spec to provide when fetching UiSdlComponent subtypes
 */
type UiSdlComponentSubTypeSpec { 

  /**
   * If true, will include abstract definitions of {@link UiSdlComponent} subtypes
   */
  includeAbstract: boolean

  /**
   * If true, will include {@link UiSdlComponent} itself
   */
  includeUiSdlComponent: boolean

  /**
   * If true, will include {@link ReactComponent} and its subtypes
   */
  includeReactComponents: boolean
}
