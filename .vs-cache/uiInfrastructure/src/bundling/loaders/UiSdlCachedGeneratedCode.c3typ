/**
 * House the implementation for caching generated code.
 */
type UiSdlCachedGeneratedCode {
  /**
   * Checks if a cached file exists. If it does, and the content hasn't changed, return it. Otherwise,
   * run the code gen function, and either create a cache entry or update the existing one with the new fingerprint.
   *
   * @param id
   *          The unique identifier for the pre-generated code.
   * @param sourceContent
   *          The source content for the code-genned code.
   * @param sourceContentType
   *          The type of the source content.
   * @param codeGenFunction
   *          The function that generates the code.
   * @returns The generated code.
   */
  useCachedIfAvailable: function (id: string, sourceContent: string, sourceContentType: UiSdlCachedGeneratedFileSourceType, codeGenFunction: lambda(): string): string js-server

  /**
   * Gets a cached generated file from the in-memory cache
   *
   * @param id
   *          The cache key
   * @returns The cached generated file, or null if there is no entry for that cache key.
   */
  getCachedGeneratedFile: function (id: string): UiSdlCachedGeneratedFile js-server

  /**
   * Check if a component has invalid metadata, based on if its backing type has changed. If it does have invalid metadata,
   * it should be removed from the cache.
   *
   * @param cachedGeneratedFile
   *           The cached file
   * @param sourceContentType
   *           The type of source content
   * @param sourceContentFingerprint
   *           The fingerprint of the source content
   * @param associatedTypeName
   *           The associated type name for the component
   */
  checkForInvalidComponentMetadata: private function (cachedGeneratedFile: UiSdlCachedGeneratedFile, sourceContentType: UiSdlCachedGeneratedFileSourceType, sourceContentFingerprint: string, associatedTypeName: string) js-server

  /**
   * Checks if content has changed since it was cached.
   *
   * @param cachedGeneratedFile
   *          The cached file
   * @param sourceContentFingerprint
   *          The fingerprint of the source content
   * @returns true if there is cached content and it is different than the current content
   */
  contentHasChanged: private function (cachedGeneratedFile: UiSdlCachedGeneratedFile, sourceContentFingerprint: string): boolean js-server

  /**
   * Creates or updates a cached generated file.
   *
   * @param id
   *          The unique identifier for the cached file.
   * @param fingerprint
   *          The fingerprint of the source content.
   * @param generatedCode
   *          The generated code to cache.
   * @param associatedTypeName
   *          The associated type name for the cached file.
   * @param cachedGeneratedFile
   *          The existing cached generated file for this content, if any.
   */
  updateCachedGeneratedFile: function (
    id: string,
    fingerprint: string,
    generatedCode: string,
    associatedTypeName: string,
    sourceContentType: UiSdlCachedGeneratedFileSourceType,
    cachedGeneratedFile: UiSdlCachedGeneratedFile
  ) js-server

  /**
   * Gets the type name of a cached generated file, based on the id and what kind of content it is.
   *
   * @param id
   *          The unique identifier for the cached file.
   * @param sourceContent
   *          The source content.
   * @param sourceContentType
   *          The type of the source content.
   * @returns The type name for the given source content type.
   */
  getTypeNameForSourceContentType: function (id: string, sourceContent: string, sourceContentType: UiSdlCachedGeneratedFileSourceType): string js-server

  /**
   * Remove an item from the cache
   */
  removeFromCache: private function (id: string) js-server
}
