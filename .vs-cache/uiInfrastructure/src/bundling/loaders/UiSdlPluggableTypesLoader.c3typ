/**
 * Produces source files mappings for pluggable types.
 */
private type UiSdlPluggableTypesLoader mixes UiSdlFileLoader {

  /**
   * The {@link Pkg} the TypeScript code is being generated for
   */
  rootPackage: Pkg

  /**
   * Generates an implementation file for each pluggable category
   */
  produceAll: ~ js-server

}
