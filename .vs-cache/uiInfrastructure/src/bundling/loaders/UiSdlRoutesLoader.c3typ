/**
 * UiSdlRoute loader.
 */
private type UiSdlRoutesLoader mixes UiSdlFileLoader {

  /**
   * Generates an implementation file with UiSdlRoute data
   */
  produceAll: ~ js-server

  /**
   * Return all routes defined in tag.
   */
  getRoutes: function(): [UiSdlRouteWithTitle] js-server
}
