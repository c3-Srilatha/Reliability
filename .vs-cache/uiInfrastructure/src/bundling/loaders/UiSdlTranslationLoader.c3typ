/**
 * Produces source files for {@link Translation} data.
 */
private type UiSdlTranslationLoader mixes UiSdlFileLoader {

  /**
   * Generates translation source files for all {@link Locale}s. One `.json` file will be returned
   * for each locale. See {@link produce} for details regarding the file contents.
   *
   * The name of each file is `<language-tag>.json`, where `<language-tag>` corresponds to the
   * {@link Locale#languageTag}.
   *
   * @return a map of source file path to source file content.
   */
  produceAll: ~ js-server

  /**
   * Generates a translation source file for a single {@link Locale}s. The content of the file
   * is a JSON object whose keys are {@link Translation#key} and whose values are the corresponding
   * {@link Translation#value}.
   *
   * @return a stringified JSON object.
   */
  produce: private function(locale: !Locale): @db(clob=true) string js-server

  /**
   * Generates translation source files for a list of locale ids.
   */
  produceBatch: function(localeIds: ![string]): UiSdlCodeGenBatchResult js-server
}
