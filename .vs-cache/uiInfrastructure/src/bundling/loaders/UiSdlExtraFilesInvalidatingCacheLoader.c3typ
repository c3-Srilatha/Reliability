/**
 * Produces source files for extra files that should invalidate the Manifest cache.
 */
@deprecated(finalVersion="8.6")
private type UiSdlExtraFilesInvalidatingCacheLoader mixes UiSdlFileLoader {

  /**
   * Generates source files for cache-invalidating purposes.
   * When one of those files change, they will invalidate all previously built bundles.
   */
  produceAll: ~ js-server

}
