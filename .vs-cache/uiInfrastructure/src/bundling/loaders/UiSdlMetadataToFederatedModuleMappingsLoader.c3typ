/**
 * Metadata to federated module mapping loader.
 */
private type UiSdlMetadataToFederatedModuleMappingsLoader mixes UiSdlFileLoader {

  /**
   * The character to use to separate the package name from the module count
   */
  MODULE_SEPARATOR: const string = '_'

  /**
   * The maximum number of files to include in each module.
   * Note: this value might be slightly exceeded for optimization purposes
   */
  MAX_PER_MODULE: const int = 100

  /**
   * Generates a json file for each mapping
   */
  produceAll: ~ js-server

  /**
   * Generates a set of TypeScript source files containing mappings from
   * the names of various metadata entities to the names of the packages that
   * those metadata entities are defined in.
   *
   * The return value contains the following files:
   * - `typeToFederatedModuleMapping.ts`: A module that exports the return value from
   *   {@link generateTypeToFederatedModuleMapping}.
   * - `testToFederatedModuleMapping.ts`: A module that exports the return value
   *   from {@link generateTestToFederatedModuleMapping}.
   *
   * @param rootPackageName
   *            The name of the root package
   * @return a map of source file path to source file content.
   *
   * @see generateTypeToFederatedModuleMapping
   */
  generateMetadataToFederatedModuleMappingsFiles: function(rootPackageName: string): map<string, UiSdlMetadataFile> js-server

  /**
   * Generates a map whose keys are C3 Type names and where each value is the
   * name of the package where the given type is defined. This map will contain
   * only {@link UiSdlComponent} and {@link UiSdlEpic} types that are also have a
   * {@link Ann#TypeScript} annotation.
   *
   * @return a map of type name to package name.
   */
  generateTypeToFederatedModuleMapping: private function(): map<string, string> js-server

    /**
   * Internal: Used by generateComponentToFederatedModuleMapping.
   */
  populateComponentToFederatedModuleMappingByPage: private function(pages: map<string, map<string, json>>, componentToPackage: json, componentsPerModule: int): map<string, string> js-server

  /**
   * Generates a map whose keys are UI component metadata ids and where each
   * value is the name of the package where the given component is defined.
   *
   * @return a map of UI component metadata id to package name.
   */
  generateComponentToFederatedModuleMapping: private function(): map<string, string> js-server

  /**
   * Generates a map whose keys are test file names and where each
   * value is the name of the package where the given test is defined.
   *
   * @return a map of test file name to package name.
   */
  generateTestToFederatedModuleMapping: private function(): map<string, string> js-server

  /**
   * Generates a map whose keys are data spec type names and where each
   * value is the name of the package where the given type is defined.
   *
   * @return a map of type name to package name.
   */
  generateTypeDataSpecsToFederatedModuleMapping: private function(): map<string, string> js-server

  /**
   * Transforms a package name into one that is appropriate for a federated module
   */
  packageNameAsFederatedModule: private function(packageName: string): string js-server
}
