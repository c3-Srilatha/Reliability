/**
 * Entity type to store the generated code for a given source code.
 */
@db(index=['id'])
@cache(maxSize=20000)
entity type UiSdlCachedGeneratedFile mixes Cached schema name 'UI_SDL_CGF' {
  /**
   * The id of the item that is being cached. Generally the id of the component or the name of a type.
   */
  id: string

  /**
   * The fingerprint of the source code for the item that is being cached.
   */
  fingerprintStr: string

  /**
   * The generated code for the item.
   */
  generatedCode: string

  /**
   * The type associated with this item.
   */
  associatedTypeName: string

  /**
   * The type of this cached content.
   */
  sourceContentType: UiSdlCachedGeneratedFileSourceType
}
