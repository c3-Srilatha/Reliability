/**
 * Extension for UiBundler to allow caching of bundles between runs.
 */
type UiSdlBundleCachingExtension mixes UiBundlerExtension {

  onAllCompleteBeforeBundleDeployment: ~ js-server
  onStart:                             ~ js-server

  /**
   * Gets binary content of list of files
   *
   */
  getFileListAsBinary: private function(): json js-server

  /**
   * Gets binary content of file manifests
   *
   */
  getManifestAsBinary: private function(): json js-server
}
