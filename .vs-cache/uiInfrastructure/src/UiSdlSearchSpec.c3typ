/**
 * some apps can save the searches as an included type in their own state
 */
type UiSdlSearchSpec {

  /**
   * mainly for the filters and ordering but could also have a default include spec
   */
  spec: FetchSpec schema suffix 'SP'

  /**
   * The current evaluation spec.
   */
  evaluateSpec: EvaluateSpec schema suffix 'ESP'

  /**
   * The current sort spec.
   */
  sort: [UiSdlSortSpec] schema suffix 'S'

  typeName: !string
}
