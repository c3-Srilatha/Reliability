/**
 * This type is used to store the last metadata manifest from UiSdlMetadataFileManifestCache.generateManifest().
 *
 * The purpose of this singleton record is to allow reusability of UiBundlerResults by storing a manifest
 * that mirrors the content stored in UiBundlerResult records, this is used at different points to detect changes
 * and restore unchanged UiBundlerResult records.
 */
entity type UiSdlMetadataFileManifest schema name 'UiSdlMNFST' {

  /**
   * The UiBundler job that generated this manifest.
   *
   * If the reference in invalid, the UiBundlerResults will be deemed unusable since it means
   * we cannot reliably find the right records (we prefer to do more work than restoring stale
   * files)
   */
  job: UiBundler

  /**
   * The contents of the manifest.
   * @see UiSdlMetadataFileManifestCache.generateManifest
   */
  content: map<string, UiSdlMetadataFileManifestEntry> schema name 'CNTNT'
}
