/**
 * Type that holds all containers-level components used to wrap UI pages.
 *
 * This is used as a singleton through the `SDL.DefaultPageWrapper` component. To add or remove containers,
 * see the linked doc with examples on how to use it to integrate web analytics tools.
 * @see bring-your-own-analytics-tool.c3doc.md
 */
type UiSdlPageWrapper mixes Metadata, Identified {
  /**
   * List of containers for the page.
   */
  @merge(MERGE)
  containers: [UiSdlComponentRef<any>]
}
