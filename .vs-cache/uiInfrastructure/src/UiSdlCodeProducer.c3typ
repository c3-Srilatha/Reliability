/**
 * Produces ui files for incremental bundling.
 */
type UiSdlCodeProducer {
  /**
   * Matches file subpath with regex and produces ui related file.
   *
   *   @param files
   *            A list of all changed files.
   *   @param uiNamespace
   *            ui namespace.
   */
  matchRegexAndProduce: function(files: [string], uiNamespace: string): map<string, map<string, string>> js-server
}
