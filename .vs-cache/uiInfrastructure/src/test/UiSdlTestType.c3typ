/**
 * A dummy test type to test {@link UiDesignableValidator}.
 */
@typeScript
@uiComponentCategorizer(name='Test type', category='Components', hide=true)
type UiSdlTestType mixes UiSdlComponent<UiSdlTestTypeDataSpec> {

  /**
   * The type header description.
   */
  header: json

  /**
   * Timezone configuration for displayed data.
   */
  noTimeZoneConversion: boolean = false

  @uiSdlDataSpec(dataDestinationField='dataCollection')
  dataSpec: ~

  /**
   * Holds the data to display in this type.
   */
  dataCollection: private int

  /**
   * An array of value for of this type.
   */
  value: [string]
}
