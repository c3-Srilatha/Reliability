/**
 * Batch code-gen result by a UiSdlFileLoader.
 */
type UiSdlCodeGenBatchResult {

  /**
   * Mapping of file id to file details, e.g. file path in working dir and file content.
   */
  fileDetails: map<string, map<string, string>>

  /**
   * Enum types used by the generated files.
   */
  usedEnums: map<string, boolean>
}
