/**
 * Provides functionality to render documentation.
 */
type DocService {

  /**
   * Function to get the title and content of a c3doc.
   *
   * @param topicName
   *        The name of the c3doc
   * @param fileExt
   *        The type of document to render.
   * @returns Title and content of the documentation.
   */
  renderTopic: function (topicName: !string, fileExt: string) : C3Documentation js-server

}
