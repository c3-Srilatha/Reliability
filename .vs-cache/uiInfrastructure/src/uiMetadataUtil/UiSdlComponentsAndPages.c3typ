/**
 * A set of UI components and pages, indexed by {@link UiSdlComponent#id}.
 */
@typeScript
type UiSdlComponentsAndPages {

  /**
   * Mapping between component id and component object.
   */
  componentById: private map<string, json>

  /**
   * Mapping between page id and page object.
   */
  pageById: private map<string, json>
}
