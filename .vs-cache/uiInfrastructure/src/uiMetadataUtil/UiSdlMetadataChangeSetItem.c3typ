/**
 * The UI metadata that is affected by an app development operation, e.g. as part of
 * creating new pages, deleting pages, creating components, etc.
 */
type UiSdlMetadataChangeSetItem {

  /**
   * The set of {@link UiSdlRoute} metadata that is part of this change set.
   */
  routes: [UiSdlRoute]

  /**
   * The set of components and pages that are part of this change set, indexed by metadata ID.
   */
  configurableUiMetadata: UiSdlComponentsAndPages
}
