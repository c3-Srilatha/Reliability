/**
 * An audit trail of changes to UI metadata as part of an app development operation,
 * e.g. creating new pages, deleting pages, creating components, etc.
 *
 * An instance of this type should be treated as an atomic change, i.e. no single portion
 * of this change set makes sense without the rest. Any undo/redo features should
 * be sure to rollback/apply *all* changes in this change set at the same time.
 */
@typeScript
type UiSdlMetadataChangeSet {

  /**
   * The set of UI metadata that was created.
   */
  created: UiSdlMetadataChangeSetItem

  /**
   * The set of UI metadata that was updated.
   */
  updated: ObjUpdate<UiSdlMetadataChangeSetItem>

  /**
   * The set of UI metadata that was removed.
   */
  removed: UiSdlMetadataChangeSetItem

  merge: private function(changeSetA: UiSdlMetadataChangeSet,
                          changeSetB: UiSdlMetadataChangeSet): !UiSdlMetadataChangeSet ts-client
}
