@typeScript
final type UiSdlAddDefaultProps {
  /**
   * This function recursively adds default props to props
   *  @param defaltProps
   *         the default props provided by the component
   *  @param props
   *         the props passed down by parent
   * @returns the merged props
   */
  addDefaultProps: function(defaltProps: json, props:json): json ts-client
}
