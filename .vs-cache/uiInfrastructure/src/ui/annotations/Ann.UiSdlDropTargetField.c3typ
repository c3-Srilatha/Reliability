/**
 * Fields that have this annotation will show up as a drop target field at UiDesigner.
 */
@annotation(appliesTo=['field'])
@typeScript
type Ann.UiSdlDropTargetField mixes Annotation {

  /**
   * Default message to show when the field is empty.
   */
  emptyDropMessage: string
}
