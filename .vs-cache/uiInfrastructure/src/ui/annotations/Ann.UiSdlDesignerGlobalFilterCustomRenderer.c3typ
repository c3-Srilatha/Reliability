/**
 * A field-level annotation indicating which renderer to be used based on whether the global filter
 * component has a data specification that is field-based or metric-based
 *
 * This should only be applied to a single field in a component library.
 */
@annotation(appliesTo=['field'])
type Ann.UiSdlDesignerGlobalFilterCustomRenderer mixes Annotation
