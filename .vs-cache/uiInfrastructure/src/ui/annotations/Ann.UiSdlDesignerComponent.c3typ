/**
 * The type-level annotation to filter out components you want to show in UI Designer.
 *
 * @example
 *     @uiSdlDesignerComponent(designable=true, category="UiSdlDataGrid.categoryNameTranslationKey", name="UiSdlDataGrid.componentNameTranslationKey")
 *     type UiSdlDataGrid mixes UiSdlComponent {
 *       title: string
 *     }
 */
@annotation(appliesTo=['type'])
type Ann.UiSdlDesignerComponent mixes Annotation {

  /**
   * Indicates whether this component is configurable in UI Designer.
   * If set to `true`, the component will appear in the UI Designer menu of available components.
   */
  designable: boolean

  /**
   * Attributes of this component.  Different from category in that there may be multiple,
   * and they are only used internally so they do not need to be translated.
   */
  attributes: [string]

  /**
   * The translation key of the component category name. This allows for components to be grouped
   * into categories in the UI Designer menu of available components.
   */
  category: string

  /**
   * The translation key of the human-readable name of this component.
   */
  name: string

  /**
   * The icon name of this component.
   */
  icon: string
}
