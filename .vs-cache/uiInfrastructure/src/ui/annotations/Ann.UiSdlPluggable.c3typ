/**
 * The type-level annotation to identify types which are dynamically plugged into other types.
 * Check uiInfrastructure/src/UiSdlMetadataLoader.js to see how uipluggable types are generated.
 * Check uiInfrastructure/src/ui/dynamic/UiSdlDynamicValueSpec.ts to see how uipluggable types are used.
 *
 * @example
 *     @typeScript
 *     @uiSdlPluggable(namespace='dynamicValueSpec')
 *     abstract type UiSdlDynamicValueSpecParam mixes StringSerializable {
 *     }
 */
@annotation(appliesTo=['type'])
type Ann.UiSdlPluggable mixes Annotation {

  /**
   * The namespace the pluggable type belongs to.
   * Exported functions will be available at @c3/ui/pluggables/namespace.
   */
  namespace: !string
}
