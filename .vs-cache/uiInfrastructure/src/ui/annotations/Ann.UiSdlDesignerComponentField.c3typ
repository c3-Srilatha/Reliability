/**
 * The field level annotation to filter out component fields you don't want to show in UiDesigner.
 * All fields will show up in UiDesigner by default if the component is designable.
 *
 * Example:
 *      @uiSdlDesignerComponent(designable=true, category='UiSdlDataGrid.categoryNameTranslationKey', name="UiSdlDataGrid.componentNameTranslationKey")
 *      type UiSdlDataGrid mixes UiSdlComponent {
 *          header: string
 *
 *          @uiSdlDesignerComponentField(nonDesignable=true) // Hide pagination configuration field
 *          pagination: boolean
 *      }
 */
@annotation(appliesTo=['field'])
type Ann.UiSdlDesignerComponentField mixes Annotation {

  /**
   * Indication whether this field is designable.
   * If set to true, this field will not show up in UiDesigner.
   */
  nonDesignable: boolean
}
