/**
 * Logger for use in the UI Infrastructure.  The UiSdlLogger utilizes the console.log to output messages
 * of different logging types (info, warn, error, and debug).
 *
 * Usage:
 * import * as UiSdlLogger from '@c3/ui/UiSdlLogger';
 * let logger = UiSdlLogger.withName('log-test');
 * logger.info('info text');
 * logger.warn('warning text');
 * logger.error('error text');
 * logger.debug('debug text');
 */
@typeScript
type UiSdlLogger {

  /**
   * Generate a new {@link UiSdlLogger} instance with the specified name
   * @param name
   *            Instance name for the object. This is used for separation between files.
   * @return A {@link UiSdlLogger} object with the following functions:
   *            info(msg)
   *            warn(msg)
   *            error(msg)
   *            debug(msg)
   */
  withName: function(name: string): UiSdlLogger ts-client
}
