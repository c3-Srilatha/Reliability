/**
 * A type that creates mappings between a field, defined outside of data spec type but
 * is used at data spec, to an request argument spec field.
 * For example:
 * {@link UiSdlTimeseriesLineBarChart#xAxis} and {@link UiSdlTimeseriesLineBarChart#xAxis range
 * is used at {@link UiSdlTimeseriesLineBarChartDataSpec#toPartiallyAppliedActions}
 * The {@link UiSdlTimeseriesLineBarChartDataSpec#dataSpecDependence} should look like
 *
 *      [{
 *         "configField": "xAxis.interval",
 *         "argumentSpecField": "interval"
 *       }, {
 *         "configField": "xAxis.range",
 *         "argumentSpecField": "start",
 *         "transformFunction": "getStartDate"
 *       }, {
 *         "configField": "xAxis.range",
 *         "argumentSpecField": "end",
 *         "transformFunction": "getEndDate"
 *      }]
 */
@typeScript
type UiSdlCrossTypeDataSpecDependence {

  /**
   * The field that is used in data spec toPartiallyAppliedActions
   */
  configField: string

  /**
   * The argument spec field that is associated with config field
   */
  argumentSpecField: string

  /**
   * The transform function name to use to transform the original field value.
   * This function should be implemented at component's data spec type. If configDependence
   * is defined, the function will be called with two arguments: the value of the configField
   * and the component configuration. Otherwise, the function will be called with
   * only the value of the configField as the argument.
   */
  transformFunction: string

  /**
   * This is a flag that indicates that the transformFunction depends on other fields
   * in the component configuration and thus the component configuration should be passed
   * in along with the configField value.
   */
  configDependence: boolean

  /**
   * This field serves as the value to be used instead of the configField value.
   */
  overrideValue: any
}
