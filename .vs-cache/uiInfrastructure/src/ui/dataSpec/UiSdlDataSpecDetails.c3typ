/**
 * Abbreviated information regarding a field type annotated with
 * {@link Ann#UiSdlDataSpec}.
 */
@typeScript
type UiSdlDataSpecDetails {

  /**
   * The name of the field.
   */
  dataSpecFieldName: !string

  /**
   * The value type of the field.
   */
  dataSpecType: !Type

  /**
   * The value of the field's {@link Ann#UiSdlDataSpec#dataDestinationField}.
   */
  dataDestinationFieldName: !string
}
