/**
 * A specification that describe sortable field.
 */
@typeScript
type UiSdlComponentDataSpecSortableFieldSetting mixes UiSdlFieldBasedDataSpecSetting {

  /**
   * Whether or not this field can be used to sort the data displayed.
   */
  sortable: boolean = false

  /**
   * The order to sort this field on.
   */
  sortOrder: string enum UiSdlSortOrderEnum
}
