/**
 * Type to allow developers to define their own API to be used in a {@link UiSdlComponentDataSpec}.  When developers need
 * to use an API outside of the components expected API developers define a {@link UiSdlComponentDataSpec#advancedDataSpec}
 * and the API requested will be derived from this type.
 */
@typeScript
type UiSdlComponentAdvancedDataSpec {

  /**
   * The action used to retrieve data
   */
  actionName: string = 'fetch'

  /**
   * The arguments that need to be passed to the action
   */
  actionArgs: json
}
