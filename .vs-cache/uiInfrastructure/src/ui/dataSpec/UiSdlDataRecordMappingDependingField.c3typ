/**
 * A specification for a data record mapping which depends on the value of another field in
 * the data record.
 *
 * @see UiSdlComponentDataSpecSetting
 */
@typeScript
type UiSdlDataRecordMappingDependingField {

  /**
   * The field in the data record whose value is used to determine the field mapped to.
   */
  dependingField: string

  /**
   * A mapping of the possible values of the depending field and the corresponding field on the
   * data record that is mapped to.
   */
  dependingValues: map<string, string>
}
