/**
 * A placeholder type for dynamic value dropdowns. The given enumeration options are merely placeholders.
 * Each type that uses this enumeration type must define its own custom logic to dynamically fetch actual options
 * e.g. {@link UiSdlCategoricalLineBarChartXAxisDataSpecSetting#getDynamicOptionsForField}
 */
enum type UiSdlDynamicOptionsEnum {

  /**
   * Placeholder option 1
   */
  Option1

  /**
   * Placeholder option 2
   */
  Option2
}
