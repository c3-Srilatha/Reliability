/**
 * Describes a condition that determines which component will be rendered inside a
 * {@link UiSdlConditionalRenderer}.
 *
 * This type should not be used directly, see mixins of this type for particular
 * config fields and examples.
 */
abstract type UiSdlRenderCondition {

  /**
   * Used by UiSdlUseRenderCondition to evaluate the condition.
   *
   * Each mixin has to implement this function. When implemented for React, it must
   * be treated as a hook and follow the rules of hooks.
   *
   * @return true when the condition is satisfied,
   *         false when the condition is not satisfied or
   *         null if the condition depends on async operations and its value is not yet known
   *
   * @see UiSdlConditionalRenderer.condition
   */
  useCondition: function(condition: mixing UiSdlRenderCondition): boolean ts-client
}
