/**
 * A partner to {@link Filter}. Creates filters compatible with {@link Filter}.
 */
@typeScript
type UiSdlFilter {
  /**
   * The string representation of the Filter.
   */
  value: private string = ''

  /**
   * Adds a string literal to the expression. This can be used for syntax that isn't supported by the builder directly
   * or for other special formatting purposes.
   *
   * @param literal
   *           string literal to be added
   * @return new filter
   */
  lit: member function(literal: !string): !UiSdlFilter ts-client

  /**
   * Adds an equality element to the expression. This consists of a simple comparison of a field with a single value,
   * as in the SQL expression "name = *value*".  The actual expression language syntax is "name == *value*" where
   * *value* is formatted and escaped appropriately.
   *
   * Note that if the value argument is a lambda, it will be called to produce the value used.
   *
   * @param name
   *           field to compare against
   * @param value
   *           value to compare
   * @return new filter
   */
  eq: member function(name: !string, value: !any): !UiSdlFilter ts-client

  /**
   * Adds a negative equality element to the expression.
   *
   * @param name
   *           field to compare against
   * @param value
   *           value to compare
   * @return new filter
   */
  ne: member function(name: !string, value: !any): !UiSdlFilter ts-client

  /**
   * Adds a less-than inequality element to the expression.
   *
   * @param name
   *           field to compare against
   * @param value
   *           value to compare
   * @return new filter
   */
  lt: member function(name: !string, value: !any): !UiSdlFilter ts-client

  /**
   * Adds a less-than-or-equal-to inequality element to the expression.
   *
   * @param name
   *           field to compare against
   * @param value
   *           value to compare
   * @return new filter
   */
  le: member function(name: !string, value: !any): !UiSdlFilter ts-client

  /**
   * Adds a greater-than inequality element to the expression.
   *
   * @param name
   *           field to compare against
   * @param value
   *           value to compare
   * @return new filter
   */
  gt: member function(name: !string, value: !any): !UiSdlFilter ts-client

  /**
   * Adds a greater-than-or-equal-to inequality element to the expression.
   *
   * @param name
   *           field to compare against
   * @param value
   *           value to compare
   * @return new filter
   */
  ge: member function(name: !string, value: !any): !UiSdlFilter ts-client

  /**
   * Adds a field existence check to the expression.
   * @param name
   *           field to check existence of
   * @return new filter
   */
  exists: member function(name: !string): !UiSdlFilter ts-client

  /**
   * Adds a multi-comparison to the expression.
   * "intersects" is used as a shorthand for an *or* of many values, particularly when
   * the number of values is not known in advance.
   *
   * null and undefined values are skipped in the array.
   *
   * @param name
   *           field to check existence of
   * @param values
   *           array of values to intersect
   * @return new filter
   */
  intersects: member function(name: !string, values: ![any]): !UiSdlFilter ts-client

  /**
   * Adds a prefix match to the expression.
   * @param name
   *           field to check the prefix of
   * @param value
   *           prefix to compare against
   * @return new filter
   */
  startsWith: member function(name: !string, value: !any): !UiSdlFilter ts-client

  /**
   * Adds a suffix match to the expression.
   * @param name
   *           field to check the suffix of
   * @param value
   *           suffix to compare against
   * @return new filter
   */
  endsWith: member function(name: !string, value: !any): !UiSdlFilter ts-client

  /**
   * Adds a infix match to the expression.
   * @param name
   *           field to check the infix of
   * @param value
   *           infix to compare against
   * @return new filter
   */
  contains: member function(name: !string, value: !any): !UiSdlFilter ts-client

  /**
   * Adds `!` to the expression.
   * @return new filter
   */
  not: member function(): !UiSdlFilter ts-client

  /**
   * Adds ` && ` to the expression.
   * @return new filter
   */
  and: member function(): !UiSdlFilter ts-client

  /**
   * Adds ` || ` to the expression.
   * @return new filter
   */
  or: member function(): !UiSdlFilter ts-client

  /**
   * Adds `(` to the expression.
   * @return new filter
   */
  lp: member function(): !UiSdlFilter ts-client

  /**
   * Adds `)` to the expression.
   * @return new filter
   */
  rp: member function(): !UiSdlFilter ts-client

  /**
   * Equivalent to `.lp().lit(value).rp()`. May be used to like
   * `Filter.eq('id', id).or().paren(Filter.startsWith('name', prefix).and().endsWith('name', suffix))`
   *
   * @param lit
   *           The filter literal to append in parens. Note this should not be an unquoted value.
   * @return new filter
   */
  paren: member function(lit: !any): !UiSdlFilter ts-client

  /**
   * Returns the current `value` field of the {@link Filter}.
   *
   * @return the value.
   */
  toString: member function(): string ts-client

  /**
   * Generates a {@link Filter} from a string.
   *
   * @param s
   *           The string to set as the value of the filter.
   * @return the constructed {@link Filter}.
   */
  fromString: function(value: !string): UiSdlFilter ts-client
}
