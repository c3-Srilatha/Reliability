/**
 * Describes a condition that determines which component will be rendered inside a
 * {@link UiSdlSwitchRenderer}.
 *
 * This type should not be used directly, see mixins of this type for particular
 * config fields and examples.
 */
abstract type UiSdlRenderSwitchCondition{

  /**
   * Each mixin has to implement this function. When implemented for React, it must
   * be treated as a hook and follow the rules of hooks.
   *
   * @see {@link UiSdlSwitchRenderer#condition}
   */
  useSwitchCondition: function(condition: mixing UiSdlRenderSwitchCondition): any ts-client
}
