/**
 * The status of a {@link UiSdlWebWorker}.
 */
enum type UiSdlWebWorkerStatus {

  /**
   * The status represents the thread is running and possibly ready for any incoming request.
   */
  RUNNING = 'running'

  /**
   * Terminated status. The web worker is terminated and not available.
   */
  TERMINATED = 'terminated'
}
