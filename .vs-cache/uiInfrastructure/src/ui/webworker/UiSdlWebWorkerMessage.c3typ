/**
 * Message type that UiSdlWebWorker posts back to the main browser WebWorker thread
 */
type UiSdlWebWorkerMessage {

  /**
   * Action name of the message.
   */
  action: string

  /**
   * Payload of the message.
   */
  payload: map<string, any>

  /**
   * Id of the message.
   */
  messageId: string

  /**
   * Id of the request.
   */
  requestId: string

  /**
   * Error message of the request.
   */
  failure: map<string, any>

  /**
   * Content of the message.
   */
  content: map<string, any>
}
