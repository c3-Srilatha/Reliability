/**
 * Helper methods used in ui Types
 */
@typesys
@typeScript
final type UiSdlHelpers {

  /**
   * Generates a nested object from a array of strings and a value
   * @param keyPath
   *          The array of strings to use as nested keys
   * @param value
   *          The json value to use in the most nested object
   * @param parentObject
   *          The object that will be the parent of the converted nestedObject
   * @returns A JSON where each key is a string array entry
   *          For example: if keyPath is ['Foo','Bar','Baz'] and value is 'Quo', result:
   *          { 'Foo': { 'Bar': { 'Baz': 'Quo' } } }
   */
  convertKeyPathToNestedObj: function(keyPath: [string],
                                      value: map<string, any>,
                                      parentObject: map<string, any>): map<string, any> ts-client

  /**
   * Returns a nested value from an object. Sample usage:
   *   obj = {
   *     child: 'child',
   *     nested: {
   *       grandchild: 'some value'
   *     }
   *   };
   *
   *   C3.util.getDescendantProp(obj, 'nested.grandchild');
   * @param {Object} obj  The object from which to get the data. Required.
   * @param {String} path  A dot-delimited path to the field from which to get the value,
   * for example: "nested.grandchild"
   * @param {Boolean} keepDuplicates  When extracting values from an aray, whether or not
   * to return all the values including duplicates (true), or return the unique values (false)
   * @return {Mixed} the values found in {@link obj} at the specified {@link path}
   */
  @deprecated(finalVersion='7.32', details='Use `lodash/get` instead.')
  getDescendantProp: function(obj: any, propPath: string, keepDuplicates: boolean): any ts-client

  /**
   * Returns a nested value from an object if path is defined.
   *
   * @param {Object} obj
   *           The object from which to get the data. Required.
   * @param {String} path
   *           A dot-delimited path to the field from which to get the value, for example: "nested.grandchild".
   * @param {Boolean} keepDuplicates
   *           When extracting values from an aray, whether or not to return all the values including duplicates (true),
   *           or return the unique values (false). Defaults to false.
   * @return {Mixed} The values found in {@link obj} at the specified {@link path}, or null if the {@link path} is not
   *           defined.
   */
  @deprecated(finalVersion='7.32', details='Use `lodash/get` instead.')
  getDescendantPropIfPathDefined: function(obj: any, path: string, keepDuplicates: boolean): any ts-client

  /**
   * The counterpart to `getDescendantProp` that allows you to set a value at
   * a given path within an object. If any object layers in the nested path are missing, this
   * utility function will go ahead and make them instead of erroring. If shouldOverwrite is
   * set to false, an existing field at {@link desc} or at any level in that path will not be
   * changed.
   * @example
   *   obj = {
   *     child: 'child',
   *     nested: {
   *       grandchild: 'some value'
   *     }
   *   };
   *
   *   C3.util.setDescendantProp(obj, 'nested.otherGrandchild', "Blue Skies");
   *
   *   Now obj will be:
   *   {
   *     child: 'child',
   *     nested: {
   *       grandchild: 'some value',
   *       otherGrandchild: 'Blue Skies'
   *     }
   *   };
   * @param {Object} obj  The object in which to set the data
   * @param {String} desc  A dot-delimited path to the field to be updated with the new value
   * @param {Mixed} value   The value to set
   * @param {Boolean} [shouldOverwrite=true]  Whether or not to overwrite an existing value at
   * {@link desc}. This defaults to true.
   */
  @deprecated(finalVersion='7.32', details='Use `lodash/set` instead.')
  setDescendantProp: function(obj: any, desc: string, value: any, shouldOverwrite: boolean) ts-client

  /**
   * Helper function for rendering children from within a React component. React throws an error if `render` returns
   * `undefined`, so an undefined check must be performed instead of blindly returning `props.children`.
   *
   * @param {Object} props
   *                    React element props
   * @param {React node} [props.children]
   *                        React children
   * @return `props.children` if defined, otherwise `null`.
   */
  safeChildren: function(props: any): any ts-client

  /**
   * containsPressedKey checks if the pressed key is an expected key.
   * @param expectedKeys A string array to check for the pressed key e.g. ['Space', 'Enter']
   * @param keyboardEvent Triggered keyboard event
   * @returns Whether the pressed key is an expected key
   */
  containsPressedKey: function(expectedKeys: [string], keyboardEvent: any): boolean ts-client

  /**
   * Checks if the pressed key in the keyboard is a Space or Enter.
   */
  containsPressedKeySpaceOrEnter: function(keyboardEvent: any): boolean ts-client

  /**
   * Interpolates values from record and pageParams into content.
   * The interpolation delimiters are {{ and }}
   */
  matchDynamicContent: function(record: any,
                                content: string,
                                pageParams: any,
                                encodeContent: boolean,
                                environment: any): string ts-client

  /**
   * Gets the cookies for the document and returns them in an object
   */
  getCookies: function(): map<string, string> ts-client

  /**
   * Judge if value is not null and not undefined.
   * @param  {Mixed} value - The value to be judged.
   * @return {Boolean} if the value exists or not.
   */
  @deprecated(finalVersion='7.31', details='Use `value != null` instead')
  exists: function(values: any ...): boolean ts-client

  /**
   * Judge if a value is not null and not undefined and not empty.
   * @param  {Mixed} value  The value to test for emptiness
   * @return {Boolean} boolean representing whether or not the value is not empty
   */
  @deprecated(finalVersion='7.32', details='Use `lodash/isEmpty` instead.')
  notEmpty: function(values: any ...): boolean ts-client
}
