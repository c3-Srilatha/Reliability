/**
 * A wrapper on top of window performance APIs.
 * NOTE:
 *    measure_perf cookie needs to be set to true to enable APIs.
 * USAGE:
 *    import * as UiSdlPerformance from "@c3/ui/UiSdlPerformance";
 *
 *    UiSdlPerformance.mark('mark1')
 *    UiSdlPerformance.mark('mark2')
 *    UiSdlPerformance.measure('measure1', 'mark1', 'mark2')
 */
@typeScript
type UiSdlPerformance  {
  /**
   * Returns true if performance measurement is enabled.
   * UiSdlPerformance is enabled by setting cookie 'measure_perf=true'.
   */
  isEnabled: function(): boolean ts-client

  /**
   * Returns true if cookie 'measure_perf' is set to true or {@link UiSdlPerformanceMeasureConfig} is enabled.
   */
  shouldMeasurePerformance: function(): boolean ts-client

  /**
   * Returns true if window.performance APIs are available.
   */
  isAvailable: function(): boolean ts-client

  /**
   * Creates a performance mark.
   * @param markName
   *          Name of the mark to create.
   * @param markOptions
   *          An object for specifying a timestamp and additional metadata for the mark
   */
  mark: function(markName: !string, markOptions: map<string, any>) ts-client

  /**
   * Clears a performance mark.
   * @param markName
   *          Name of the mark to clear.
   */
  clearMark: function(markName: !string) ts-client

  /**
   * Creates a performance measure.
   * @param measureName
   *          measure's name
   * @param startMarkName
   *          name of the start mark
   * @param endMarkName
   *          name of the end mark
   */
  measure: function(measureName: !string, startMarkName: string, endMarkName: string) ts-client

  /**
   * Creates a performance measure with measure options.
   *
   * @param measureName
   *          measure's name
   * @param measureOptions
   *          An object that may contain measure options.
   * @param endMarkName
   *          name of the end mark
   */
  measureWithOptions: function(measureName: !string, measureOptions: map<string, any>, endMarkName: string) ts-client

  /**
   * Clears a performance measure.
   * @param measureName
   *          measure's name
   */
  clearMeasure: function(measureName: !string) ts-client

  /**
   * Returns all performance entries in the performance timeline.
   */
  getEntries: function(): any ts-client

  /**
   * Returns all performance entries in the performance timeline with the specified name and entryType.
   * @param name
   *          name of the entry
   * @param entryType
   *          type of the entry, mark or measure
   */
  getEntriesByName: function(name: !string, entryType: string enum('mark', 'measure') = 'mark'): any ts-client

  /**
   * Returns all performance entries in the performance timeline with the specified entryType.
   * @param entryType
   *          type of the entry, mark or measure
   */
  getEntriesByType: function(entryType: string enum('mark', 'measure') = 'mark'): any ts-client

  /**
   * Enables performance measurement and reloads the page.
   */
  enableAndReload: function() ts-client

  /**
   * Disables performance measurement and reloads the page.
   */
  disableAndReload: function() ts-client

  /**
   * Count number of dynamic components mounted.
   */
  countDynamicComponentMounted: function() ts-client

  /**
   * Count number of dynamic imports.
   */
  countDynamicImports: function() ts-client

  /**
   * Returns true if window object __C3_PERFORMANCE__ is present.
   */
  isC3PerformancePresent: function(): boolean ts-client

  /**
   * Returns true if window object __XHR_REQUESTS__ is present.
   */
  isXhrRequestsArrayEmpty: function(): boolean ts-client
}
