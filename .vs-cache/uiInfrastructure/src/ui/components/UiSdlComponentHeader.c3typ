/**
 * A type that represents the configuration of a header subcomponent
 */
@typeScript
type UiSdlComponentHeader mixes UiSdlComponentTitle, UiSdlComponentSubtitle {

  /**
   * The visual alignment of this header title.
   */
  alignment: string enum('LEFT', 'RIGHT') = 'LEFT'

  /**
   * The url to which the user is redirected upon clicking the header title.
   */
  redirectLink: UiSdlLinkTemplate

  /**
   * The description that appears when hovering over this header title.
   */
  hoverDescription: string
}
