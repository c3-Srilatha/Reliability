/**
 * A type to be used by any Type using {@link Ann#UiImportGenerator}. This specifies the structure for how generated imports will
 * be passed into the component.
 */
type UiSdlImportGeneratable {

  /**
   * The map of generated imports from {@link Ann#UiImportGenerator} that are of the structure {importName:  import object, function, string, etc.}
   */
  generatedImports: private map<string, any>
}
