/**
 * A nested component can be lazy loaded and rendered within this component
 */
@typeScript
@uiComponentCategorizer(name='Nested component', category='Components', hide=true)
type UiSdlNestedComponent mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The child component to render within this component.
   */
  componentId: !string

  /**
   * If provided, the id of the {@link dataItem} is concatenated with {@link componentId} to
   * create a unique instance for each {@link componentId} and {@link dataItem} combination.
   */
  dataItem: map<string, any>

  /**
   * An optional array of children to be passed into this component.
   */
  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]
}
