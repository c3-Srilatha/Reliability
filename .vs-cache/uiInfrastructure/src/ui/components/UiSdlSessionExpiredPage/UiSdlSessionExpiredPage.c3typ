/**
 * When session expiration is detected, we want to redirect the user to a page that notifies them that their session has expired.
 * UiSdlSessionExpiredPage type can be used to create the page displaying a message 'Your session has expired. Please <a>login</a> again.'
 */
@typeScript
@uiComponentCategorizer(name='Session expired page', category='Patterns', hide=true)
type UiSdlSessionExpiredPage mixes UiSdlComponent<UiSdlNoData> {

  /**
   * Hyperlink 'login' displayed in session expired page points to the redirectUrl.
   * Login page url, home page url etc. can be configured as a redirectUrl.
   */
  redirectUrl: string
}
