/**
 * A component that determines what style the application should use and applies
 * it. This component also handles changes to the style at runtime. Application style can refer
 * to either the theme (color) or the density (padding, margin).
 */
@typeScript
@uiComponentCategorizer(name='Style context', category='Components', hide=true)
type UiSdlStyleContext mixes UiSdlComponent<UiSdlStyleContextDataSpec> {

  @uiSdlDataSpec(dataDestinationField='styles')
  dataSpec: ~ = {}

  /**
   * A list of styles available to the application.
   */
  styles: private [UiSdlThemeTemplate | UiSdlDensityTemplate]

  /**
   * The id of the current style. Should correspond to a {@link UiSdlThemeTemplate#id} or {@link UiSdlDensityTemplate#id}.
   */
  styleId: private string

  /**
   * Whether this is the root style context. If `true`, this style context will
   * apply its style variables to the DOM's `html` element. If `false`, this
   * style context will render its children inside a wrapper `div` element which
   * has the style variables
   */
  isRoot: private boolean = false

  /**
   * Whether to enalbe the tunneling for the ajax call to get {@link UiSdlConfig} config value.
   */
  enableTunneling: private boolean = false

  /**
   * Components to render inside this style context.
   */
  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]

  /**
   * Returns an action for updating the current style.
   *
   * @param componentId
   *           Id of the component.
   * @param styleId
   *           Id of the {@link UiSdlThemeTemplate} or {@link UiSdlDensityTemplate} to set as the current style.
   * @return a 'STYLE_ID_SET' action for this instance with the following properties:
   * - payload.styleId {string} The id of the style to set as the current style.
   */
  @uiSdlActionCreator(actionType='STYLE_ID_SET')
  setStyleIdAction: function(componentId: !string, styleId: !string): UiSdlStyleIdSetAction ts-client

  /**
   * Sets the current style id in the state.
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='STYLE_ID_SET')
  styleIdSetReducer: private function(state: !UiSdlReduxState,
                                      action: !UiSdlStyleIdSetAction): !UiSdlReduxState ts-client
}
