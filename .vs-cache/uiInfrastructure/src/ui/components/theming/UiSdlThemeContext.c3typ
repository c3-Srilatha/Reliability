/**
 * A component that determines what style the application should use and applies
 * it. This component also handles changes to the style at runtime. Application style can refer
 * to either the theme (color) or the density (padding, margin).
 */
@typeScript
@uiImportGenerator(generator=UiSdlStyleImport)
@uiComponentCategorizer(name='Theme context', category='Components', hide=true)
type UiSdlThemeContext mixes UiSdlComponent<UiSdlNoData> {

  /**
   * A list of styles available to the application.
   */
  styles: [UiSdlThemeTemplate | UiSdlDensityTemplate]

  /**
   * The id of the current themeId. Should correspond to a {@link UiSdlThemeTemplate#id}.
   */
  themeId: string

  /**
   * The id of the current density. Should correspond to a {@link UiSdlDensityTemplate#id}.
   */
  densityId: string

  /**
   * The generated default themes passed into the component.
   */
  defaultThemes: private map<string, UiSdlThemeTemplate | UiSdlDensityTemplate>

  /**
   * Whether this is the root style context. If `true`, this style context will
   * apply its style variables to the DOM's `html` element. If `false`, this
   * style context will render its children inside a wrapper `div` element which
   * has the style variables
   */
  isRoot: private boolean = false

  /**
   * Components to render inside this style context.
   */
  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]

  /**
   * The current UiSdlConfig
   */
  configs: UiSdlConfig

  /**
   * A function that is called when either a `densityId` or `themeId` is not found in the current
   * {@link UiSdlThemeContext#styles}
   */
  idNotFoundCallback: function(id: string, category: string enum('density', 'theme'))

}
