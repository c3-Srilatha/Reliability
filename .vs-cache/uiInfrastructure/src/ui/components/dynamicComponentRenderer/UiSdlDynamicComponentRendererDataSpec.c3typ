/**
 * A data spec for dynamically retrieving {@link UiSdlComponent} configuration.
 */
@typeScript
type UiSdlDynamicComponentRendererDataSpec mixes UiSdlComponentDataSpec {

  toPartiallyAppliedActions: ~ ts-client

  /**
   * The action used to retrieve data
   */
  actionName: string = 'fetch'

  /**
   * The arguments to pass to the action, where the keys are the parameter names and the values are the corresponding arguments.
   */
  actionArgs: json
}
