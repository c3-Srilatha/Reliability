/**
 * A dynamic container that takes metadata of components and renders them as children.
 * The dataSpec partially applied action should return the metadata for a component to render.
 *
 * Please make sure you read the "Constraints and limitations" and "Alternatives" sections in
 * [Dynamic Component Renderer](ui-dynamic-component-renderer.c3doc.md) before you invest in using
 * this component as it can produce damaging effects on the performance of your application's pages.
 */
@typeScript
@uiComponentCategorizer(name='Dynamic component renderer', category='Components', hide=true)
type UiSdlDynamicComponentRenderer mixes UiSdlComponent<UiSdlDynamicComponentRendererDataSpec> {

  /**
   * The specification used for retrieving ui metadata to be displayed by the component renderer
   */
  @uiSdlDataSpec(dataDestinationField='metadataToRender')
  dataSpec: ~

  /**
   * Metadata for the component(s) to render dynamically.
   */
  metadataToRender: UiSdlDynamicComponentMetadata

  /**
   * Flag indicating for a component to use the initial metadata provided to it. This is useful for
   * dynamic components which obtain their metadata from another source (i.e. application state).
   */
  useInitialMetadata: boolean = false

  /**
   * The metadata ids of children that are dynamically added through {@link #updateChildrenMetadataAction}.
   */
  childIds: [string]

  /**
   * The metadata ids of children that are dynamically added through {@link #updateChildrenMetadataAction}.
   */
  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]

  /**
   * The metadata ids of all componentRefs that are dynamically added through {@link #updateChildrenMetadataAction}.
   */
  componentRefIds: [string]

  /**
   * Triggered when the component needs to load its data
   * @param id
   *            Id of the component.
   * @returns a `DATA_LOAD` action for this instance
   */
  @uiSdlActionCreator(actionType='DATA_LOAD')
  loadDataAction: function(id: string): UiSdlDataLoadAction ts-client

  /**
   * Triggered when the component needs to update the arguments of its data spec
   * @param id
   *            Id of the component.
   * @returns a `DATA_SPEC_ARGUMENTS_MERGE` action for this instance
   */
  @uiSdlActionCreator(actionType='DATA_SPEC_ARGUMENTS_MERGE')
  mergeDataSpecArgumentsAction: function(id: string,
                                         args: map<string, any>): UiSdlDataSpecArgumentsMergeAction ts-client

  /**
   * Triggered when the children elements need to be updated.
   *
   * @param id
   *            Id of the component.
   * @returns a `CHILDREN_UPDATE` action
   * - payload.orderedChildrenIds {[string]} Ordered list of component ids to render
   * - payload.childIds {[string]} The ids of the children
   * - payload.componentRefIds {[string]} The ids of the componentRefs
   */
  @uiSdlActionCreator(actionType='CHILDREN_UPDATE')
  updateChildrenAction: inline function(id: string,
                                                orderedChildrenIds: [string],
                                                childIds: [string],
                                                componentRefIds: [string]): UiSdlChildrenUpdateAction ts-client

  /**
   * Triggered when a {@link UiSdlConnected} Dynamic component is mounted every time.
   *
   * @param id
   *            Id of the component that's being mounted.
   * -payload.componentId {string} just the id of the component being mounted. You can extend the payload by merging other arguments.
   */
  @uiSdlActionCreator(actionType='DYNAMIC_COMPONENT_MOUNTED')
  dynamicComponentMountedAction: inline function(id: string): UiSdlDynamicComponentMountedAction

  /**
   * Listens for actions of type `CHILDREN_UPDATE` and
   * (1) clears all state(initialMetadata, metadata)
   * of the current child components as well as their componentRefs(only those of which metadata is dynamically propagated
   * through this dynamic container and not written as code in a json file)
   * (2) updates the children
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='CHILDREN_UPDATE')
  childrenUpdateReducer: private inline function(state: UiSdlReduxState,
                                                 action: UiSdlChildrenUpdateAction): UiSdlReduxState ts-client

  /**
   * Triggered when the metadata of children needs to be updated.
   *
   * @param id
   *            Id of the component.
   * @returns a `CHILDREN_METADATA_UPDATE` action
   * - payload.children {[json]} The metadata of direct children
   *   A child can be either
   *   (1) configs for a component, and it must provide `metadataId`, or
   *   (2) a componentRef, and it should only specify `component` without `metadataId`
   * - payload.componentRefs {[json]} The metadata of componentRefs the direct children depend on.
   *   Note that the metadata of a componentRef is only required if it is not statically written as code (in a json file)
   *   but needs to be dynamically generated.
   */
  @uiSdlActionCreator(actionType='CHILDREN_METADATA_UPDATE')
  updateChildrenMetadataAction: function(id: string,
                                         children: [map<string, any>],
                                         componentRefs: [map<string, any>]): UiSdlChildrenMetadataUpdateAction ts-client

  /**
   * Listens for actions of type `CHILDREN_METADATA_UPDATE` and updates the metadata of direct children
   * and componentRefs (if their configurations are also dynamically generated)
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='CHILDREN_METADATA_UPDATE')
  childrenMetadataUpdateReducer: private inline function(state: UiSdlReduxState,
                                                         action: UiSdlChildrenMetadataUpdateAction): UiSdlReduxState ts-client

  /**
   * Listens for `DATA_LOAD`
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='DATA_LOAD')
  dataLoadEpic: private function(actionStream: UiSdlActionsObservable,
                                 stateStream: UiSdlStatesObservable): UiSdlActionsObservable ts-client

  /**
   * Listens for actions of type `DATA_SPEC_ARGUMENTS_MERGE`
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='DATA_SPEC_ARGUMENTS_MERGE')
  dataSpecArgumentsMergeEpic: private function(actionStream: UiSdlActionsObservable,
                                       stateStream: UiSdlStatesObservable): UiSdlActionsObservable ts-client

  /**
   *  Listens for actions of type `CHILDREN_METADATA_UPDATE`.
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='CHILDREN_METADATA_UPDATE')
  childrenMetadataUpdateEpic: private inline function(actionStream: UiSdlActionsObservable,
                                                      stateStream: UiSdlStatesObservable): UiSdlActionsObservable ts-client
}
