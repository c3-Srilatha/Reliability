/**
 * Metadata for components to be rendered dynamically.
 */
@typeScript
type UiSdlDynamicComponentMetadata {

  /**
   * Components to render as direct children of this dynamic component.
   */
  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>> | UiSdlConnected | UiSdlComponent]

  /**
   * A list of components that are allowed to be rendered by {@link children}
   * components and by other {@link componentRefs} components.
   */
  componentRefs: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>> | UiSdlConnected | UiSdlComponent]
}
