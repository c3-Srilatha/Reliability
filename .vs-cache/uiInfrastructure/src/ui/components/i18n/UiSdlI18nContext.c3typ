/**
 * A component that determines what internationalization (i18n) settings the application
 * should use and applies it. This component also handles changes to the locale at runtime.
 */
@typeScript
@uiComponentCategorizer(name='Internationalization context', category='Components', hide=true)
type UiSdlI18nContext mixes UiSdlComponent<UiSdlNoData> {

  /**
   * Whether this is the root internationalization context. If `true`, this context
   * will apply its locale ID as the [lang](https://developer.mozilla.org/en-US/docs/Web/API/HTMLElement/lang)
   * of the DOM's `html` element. If `false`, this context will render its children
   * inside a wrapper `div` element which has its `lang` attribute set accordingly.
   */
  isRoot: private boolean = false

  /*
   * Provides the current {@link User}'s preferred locale. See {@link UiSdlUserPreference#preferredLocale} for more details.
   */
  preferredLocale: Locale

  /**
   * Components to render inside this internationalization context.
   */
  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]
}
