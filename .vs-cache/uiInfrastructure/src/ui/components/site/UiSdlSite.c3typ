/**
 * Container for all rendered components.
 *
 * By default, all your components will be rendered under a UiSdlSite instance
 * and you might not need to configure it.
 *
 * If you want to embed pages inside other pages, you'll have to first
 * create your UiSdlSite instance with a particular initialRoute because
 * redirects should be managed inside the embedded UiSdlSite.
 *
 * It can use the browser's history to drive the current url or manage
 * it internally.
 */
@uiImportGenerator(generator=UiSdlStyleImport)
@uiComponentCategorizer(name='Site', category='Components', hide=true)
type UiSdlSite mixes UiSdlComponent<UiSdlNoData>, WithTunnelConfiguration, UiSdlImportGeneratable {

  /**
   * Children components to render.
   */
  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]

  /**
   * The modal to be shown when the user has been inactive for the time specified in {@link UiSdlSecurityConfig#inactivityWarningPeriod}.
   */
  inactivityWarningModal: UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>

  /**
   * The route that determines what page will be rendered first.
   */
  initialRoute: string

  /**
   * The params passed to the page on first render
   */
  initialParams: json

  /**
   * The metadata ID of the current page.
   */
  currentPage: string

  /**
   * When not empty, imported modules
   */
  importsTunnel: UiSdlTunnelConfiguration

  /**
   * The available routes for this site.
   */
  routes: [UiSdlRoute]

  /**
   * A list of styles available to the application.
   */
  styles: [UiSdlThemeTemplate | UiSdlDensityTemplate]

  /**
   * The id of the current style. Should correspond to a {@link UiSdlThemeTemplate#id}.
   */
  themeId: string

  /**
   * The id of the current style. Should correspond to a {@link UiSdlDensityTemplate#id}.
   */
  densityId: string

  /**
   * Private field to represent a `themeId` that can't yet be found. This is required to limit the number of network requests made searching for {@link UiSdlThemeTemplate}
   */
  themeHiddenId: private string

  /**
   * Private field to represent a `densityId` that can't yet be found. This is required to limit the number of network requests made searching for {@link UiSdlDensityTemplate}
   */
  densityHiddenId: private string

  /**
   * Data spec to get the available densities.
   */
  @uiSdlDataSpec(dataDestinationField="densityCollection")
  densityDataSpec: UiSdlThemeContextDataSpec

  /**
   * Data spec to get the available themes.
   */
  @uiSdlDataSpec(dataDestinationField="themeCollection")
  styleDataSpec: UiSdlThemeContextDataSpec

  /**
   * Storage place for the most recent {@link UiSdlDensityTemplate} fetched.
   */
  densityCollection: private [UiSdlDensityTemplate]

  /**
   * Storage place for the most recent {@link UiSdlThemeTemplate} fetched.
   */
  themeCollection: private [UiSdlThemeTemplate]

  /**
   * @inheritdoc
   */
  tunnelConfiguration: ~

  /**
   * A list of RegExp patterns that indicate what routes can be handled by the router.
   *
   * If a route doesn't match any pattern, it will be ignored and reported via
   * {@see onUnhandledRoute}.
   */
  onlyAllowMatchingRoutes: [string]

  /**
   * Callback triggered when a route was ignored based on onlyAllowMatchingRoutes.
   */
  onUnhandledRoute: private function(route: string)

  /**
   * A map of WebWorkers that the site holds.
   */
  webWorkers: map<string, UiSdlWebWorker>

  /**
   * Function to start a worker and updated the {@link UiSdlSite#webWorkers} field.
   * @param workerId
   *            the id of the worker.
   * @param workerType
   *            the type name of the worker to be started, ex. {@link UiSdlTypeWorker}. If no type is provided, it will
   *            use the base type
   * @return the {@link UiSdlWebWorker} instance that was started
   */
  startWorker: member function(workerId: !string,
                               workerType: string = 'UiSdlWebWorker'): Promise<UiSdlWebWorker> ts-client

  /**
   * Function to start the typeworker and update the {@link UiSdlSite#webWorkers} field.
   * @param tunnelConfiguration
   *            the tunnel configuration used when loading the types
   * @param workerId
   *            the id of the worker.
   * @param workerType
   *            the worker type.
   * @param forceReloadTypes
   *            Whether to force reload types from server
   * @param timeout
   *            The timeout for the webworker request
   * @return the instance that was started
   */
  startTypeWorker: member function(tunnelConfiguration: UiSdlTunnelConfiguration,
                                   workerId: string,
                                   workerType: string,
                                   forceReloadTypes: boolean,
                                   timeout: int): Promise<UiSdlWebWorker> ts-client

  /**
   * If true, a browser history listener will be initialized and
   * used as source for the initial url and redirects will be published
   * to the browser history so the address bar is updated.
   *
   * Default value is 'false' because that is the most common use when a UiSdlSite has to be created
   * manually. The DefaultSite, the one used when no explicit UiSdlSite is created, is
   * using the browser history.
   */
  useBrowserHistory: boolean = false

  /**
   * Contains the user object in the redux store. It stores the logged in user's information
   */
  user: private User

  /*
   * Contains the user object as well as extra fields like roles and security level needed by UI about the User.
   */
  userContext: UiSdlUserContext

  /**
   * Contains the configs object in the redux store. It stores the site configuration information
   */
  configs: private map<string, any>

  /**
   * Triggered whenever the global user information needs to be fetched from the server.
   * @param id
   *            Id of the component.
   *
   * @return a 'USER_GET' action for this instance with empty payload
   */
  @uiSdlActionCreator(actionType='USER_GET')
  getUserAction: function(id: string): UiSdlUserGetAction ts-client

  /**
   * Triggered whenever the global user information needs to be set with fetched User details.
   * @param id
   *            Id of the component.
   * @param user
   *            The user object.
   *
   * @return an 'USER_INIT' action for this instance with the following properties:
   * - payload.user {json} The field that contains user data
   */
  @uiSdlActionCreator(actionType='USER_INIT')
  initUserAction: function(id: string, user: User): UiSdlUserInitAction ts-client

  /**
   * Triggered whenever the global user information needs to be set with fetched {@link UiSdlUserContext} details.
   * @param id
   *            Id of the component.
   * @param user
   *            The {@link UiSdlUserContext} object.
   *
   * @return an 'USER_CONTEXT' action for this instance with the following properties:
   * - payload.user {json} The field that contains user context data
   */
  @uiSdlActionCreator(actionType='USER_CONTEXT')
  initUserContextAction: function(id: string, user: UiSdlUserContext): UiSdlUserContextInitAction ts-client

  /**
   * Triggered whenever there is a chunk loading error caused by a user logout.
   * @param id
   *           Id of the component.
   *
   * @return an 'USER_SESSION_EXPIRED' action for this instance.
   */
  @uiSdlActionCreator(actionType='USER_SESSION_EXPIRED')
  expiredUserSessionAction: function(id: string): UiSdlUserSessionExpiredAction ts-client

  /**
   * Triggered whenever the page parameters need to be updated.
   * @param id
   *            Id of the component.
   * @param pageParams
   *            The mapping of page params to their corresponding values.
   *
   * @return an 'PAGE_PARAMS_SET' action for this instance with the following properties:
   * - payload.pageParams {map<string, string | [string]>} The field that contains the page params
   */
  @uiSdlActionCreator(actionType='PAGE_PARAMS_SET')
  setPageParamsAction: function(id: string,
                                pageParams: map<string, string | [string]>): UiSdlPageParamsSetAction ts-client

  /**
   * Triggered whenever the current path needs to be updated.
   * @param id
   *            Id of the component.
   * @param currentPath
   *            The string which contains the current path.
   *
   * @return an 'CURRENT_PATH_SET' action for this instance with the following properties:
   * - payload.currentPath {string} The field that contains the current path.
   */
  @uiSdlActionCreator(actionType='CURRENT_PATH_SET')
  setCurrentPathAction: function(id: string, currentPath: string): UiSdlCurrentPathSetAction ts-client

  /**
   * Triggered whenever the current path and page params have been successfully updated.
   *
   * @param id
   *            Id of the component.
   * @param currentPath
   *            The string which contains the current path.
   * @param pageParams
   *            The mapping of page params to their corresponding values.
   *
   * @return an 'PATH_AND_PARAMS_SET' action for this instance with the following properties:
   * - payload.currentPath {string} The field that contains the current path.
   * - payload.pageParams {map<string, string | [string]>} The field that contains the page params
   */
  @uiSdlActionCreator(actionType='PATH_AND_PARAMS_SET')
  confirmPathAndPageParamsAction: function(id: string, currentPath: string, pageParams: map<string, string | [string]>): UiSdlPathAndPageParamsConfirmAction ts-client

  /**
   * An action to update the site's tunnel configuration.
   * @param id
   *            Id of the component.
   * @param tunnelConfiguration
   *            The query string which contains the query params.
   *
   * @return an 'TUNNEL_CONFIGURATION_SET' action for this instance with the following properties:
   * - payload.queryString {string} The field that contains the query string.
   */
  @uiSdlActionCreator(actionType='TUNNEL_CONFIGURATION_SET')
  setTunnelConfigurationAction: function(id: string,
                                         tunnelConfiguration: UiSdlTunnelConfiguration)
                                  : !UiSdlTunnelConfigurationSetAction ts-client

  /**
   * An action to update the site's configuration for the given path.
   * @param siteId
   *            The id of the site being used
   * @param typeName
   *            Name of the component.
   * @param configPath
   *            The path of the configuration to update.
   * @param configId
   *            Optional. The id of the configuration to update.
   * @param value
   *            The value to use for the configuration.  This is not limited strings but can also be objects.
   *
   * @return an 'CONFIG_SET' action for this instance with the following properties:
   * - payload.siteId {string} The current site id.
   * - payload.key {string} The combined path for the configuration.
   * - payload.value {any} The value assigned to the configuration key path.
   */
  @uiSdlActionCreator(actionType='CONFIG_SET')
  setConfigAction: function(siteId: !string,
                            typeName: !string,
                            configPath: !string,
                            configId: string,
                            value: any): !UiSdlConfigSetAction ts-client

  /**
   * Triggered when the routes need to be set.
   * @param id
   *            Id of the site.
   * @param routes
   *            The routes available to this site.
   *
   * @return a 'ROUTES_SET' action for this instance with the following properties:
   * - payload.routes {[UiSdlRoute]} The field that contains the routes
   */
  @uiSdlActionCreator(actionType='ROUTES_SET')
  setRoutesAction: function(id: string, routes: [UiSdlRoute]): !UiSdlRoutesSetAction ts-client

  /**
   * An action triggered when the user has been inactive. Internally it is used to show a modal.
   *
   * @see UiSdlSecurityConfig.inactivityWarningTime.
   *
   * @param siteId
   *            The id of the site being used
   *
   * @return an 'INACTIVITY_WARNING_MODAL_SHOW' action for this instance
   */
  @uiSdlActionCreator(actionType='INACTIVITY_WARNING_MODAL_SHOW')
  showInactivityWarningModalAction: function(siteId: !string): !UiSdlInactivityWarningModalShowAction ts-client

  /**
   * An action to fetch the site configuration for the given type and path.
   * @param siteId
   *            The id of the site being used
   * @param typeName
   *            Name of the component.
   * @param configPath
   *            The path of the configuration to fetch.
   *
   * @return an 'CONFIG_GET' action for this instance with the following properties:
   * - payload.siteId {string} The current site id.
   * - payload.typeName {string} The name of the type used to fetch the configuration.
   * - payload.configPath {string} The path for the configuration.
   * - payload.configId {string} Optional, the ID for the instance of the config.
   */
  @uiSdlActionCreator(actionType='CONFIG_GET')
  getConfigAction: function(siteId: !string,
                            typeName: !string,
                            configPath: !string,
                            configId: string): !UiSdlConfigGetAction ts-client

  /**
   * Listens for actions of type `USER_CONTEXT`, and sets the user context information in redux store.
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='USER_CONTEXT')
  userContextReducer: private inline function(state: !UiSdlReduxState,
                                           action: !UiSdlUserInitAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `PAGE_PARAMS_SET`, and builds a map of query parameters
   * from the query string and updates the state.
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='PAGE_PARAMS_SET')
  pageParamsSetReducer: private inline function(state: !UiSdlReduxState,
                                                action: !UiSdlPageParamsSetAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `CURRENT_PATH_SET` and stores the currentPath into the state.
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='CURRENT_PATH_SET')
  currentPathSetReducer: private inline function(state: !UiSdlReduxState,
                                                 action: !UiSdlCurrentPathSetAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `TUNNEL_CONFIGURATION_SET`, sets the given tunnel configuration in
   * the site's state.
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='TUNNEL_CONFIGURATION_SET')
  tunnelConfigurationSetReducer: private inline function(state: !UiSdlReduxState,
                                                         action: !UiSdlTunnelConfiguration): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `ROUTES_SET` and updates the state.
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='ROUTES_SET')
  routesSetReducer: private inline function(state: !UiSdlReduxState,
                                            action: !UiSdlRoutesSetAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `USER_GET`, internally fetches user details by calling User.myUser()
   * through an ajax request.
   *
   * @param actionStream
   *           UiSdlObservable action stream
   * @param stateStream
   * @returns an UiSdlObservable action stream
   */
  @uiSdlEpic(actionType='USER_GET')
  userGetEpic: private function(actionStream: UiSdlActionsObservable,
                                stateStream: UiSdlStatesObservable): UiSdlActionsObservable ts-client

  /**
   * Listens for actions of type `CHUNK_LOADING_ERROR` and returns an action to handle the error
   *
   * @param actionStream
   *           UiSdlObservable action stream
   * @param stateStream
   *           UiSdlObservable state stream
   * @returns an UiSdlObservable action stream
   */
  @uiSdlEpic(actionType='CHUNK_LOADING_ERROR')
  chunkLoadingErrorEpic: private function(actionStream: UiSdlActionsObservable,
                                          stateStream: UiSdlStatesObservable): UiSdlActionsObservable ts-client

  /**
   * Listens for actions of type `USER_SESSION_EXPIRED` and returns an action to redirect the user to a
   * `/session-expired` page
   *
   * @param actionStream
   *           UiSdlObservable action stream
   * @param stateStream
   *           UiSdlObservable state stream
   * @returns an UiSdlObservable action stream
   */
  @uiSdlEpic(actionType='USER_SESSION_EXPIRED')
  userSessionExpiredEpic: private function(actionStream: UiSdlActionsObservable,
                                           stateStream: UiSdlStatesObservable): UiSdlActionsObservable ts-client

  /**
   * Listens for actions of type `CONFIG_GET`, internally gets the configuration and then sets it in the redux state.
   *
   * @param actionStream
   *           UiSdlObservable action stream
   * @param stateStream
   * @returns an UiSdlObservable action stream
   */
  @uiSdlEpic(actionType='CONFIG_GET')
  configGetEpic: private function(actionStream: UiSdlActionsObservable,
                                  stateStream: UiSdlStatesObservable): UiSdlActionsObservable ts-client

  /**
   * Listens for actions of type INACTIVITY_WARNING_MODAL_SHOW and returns the action to show the modal component
   * specified in the inactivityWarningModal field.
   *
   * @param actionStream
   *           UiSdlObservable action stream
   * @param stateStream
   * @returns an UiSdlObservable action stream of inactivityWarningModal.openCloseModalAction to open the modal
   */
  @uiSdlEpic(actionType='INACTIVITY_WARNING_MODAL_SHOW')
  showInactivityWarningModalEpic: private function(actionStream: UiSdlActionsObservable,
                                                   stateStream: UiSdlStatesObservable): UiSdlActionsObservable ts-client

  /**
   * Listens for actions of type `CONFIG_SET`, sets the given tunnel configuration in
   * the site's state.
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='CONFIG_SET')
  configSetReducer: private inline function(state: !UiSdlReduxState,
                                            action: !UiSdlConfigSetAction): !UiSdlReduxState ts-client

  /**
   * Returns the metadata ID of the given site's current page.
   *
   * @param siteId
   *           The metadata ID of the {@link UiSdlSite}.
   * @param state
   *           Redux state
   * @returns the metadata ID of the site's current page.
   */
  getCurrentPageFromState: private function(siteId: !string, state: !UiSdlReduxState): string ts-client

  /**
   * Returns the Id of the user for a given site.
   *
   * @param siteId
   *           The metadata ID of the {@link UiSdlSite}.
   * @param state
   *           Redux state
   * @returns the metadata ID of the site's current page.
   */
  getCurrentUserFromState: private function(siteId: !string, state: !UiSdlReduxState): string ts-client

  /**
   * Returns the routes stored in the site's state.
   *
   * @param siteId
   *           The metadata ID of the {@link UiSdlSite}.
   * @param state
   *           Redux state
   * @returns the routes available to the site.
   */
  getRoutesFromState: private function(siteId: !string, state: !UiSdlReduxState): [UiSdlRoute] ts-client

  /**
   * Creates and starts a worker.
   *
   * @param workerId
   *           The id to be assigned to the worker.
   * @param WorkerClass
   *           The Class to be used to create a new instance of a worker from.
   * @returns the created worker.
   */
  createAndStartWorker: private function(workerId: !string, WorkerClass: @java !native): !UiSdlWebWorker ts-client


  /**
   * Returns an action for updating the current style.
   *
   * @param componentId
   *           Id of the component.
   * @param styleId
   *           Id of the {@link UiSdlThemeTemplate} to set as the current style.
   * @return a 'THEME_ID_SET' action for this instance with the following properties:
   * - payload.styleId {string} The id of the style to set as the current style.
   */
  @uiSdlActionCreator(actionType='THEME_ID_SET')
  setThemeIdAction: function(componentId: !string, styleId: !string): UiSdlThemeIdSetAction ts-client

  /**
   * Sets the current style id in the state.
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='THEME_ID_SET')
  themeIdSetReducer: private function(state: !UiSdlReduxState,
                                      action: !UiSdlStyleIdSetAction): !UiSdlReduxState ts-client

  /**
   * Returns an action for updating the current style.
   *
   * @param componentId
   *           Id of the component.
   * @param styleId
   *           Id of the {@link UiSdlDensityTemplate} to set as the current style.
   * @return a 'DENSITY_ID_SET' action for this instance with the following properties:
   * - payload.styleId {string} The id of the style to set as the current style.
   */
  @uiSdlActionCreator(actionType='DENSITY_ID_SET')
  setDensityIdAction: function(componentId: !string, styleId: !string): UiSdlDensityIdSetAction ts-client

  /**
   * Sets the current style id in the state.
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='DENSITY_ID_SET')
  densityIdSetReducer: private function(state: !UiSdlReduxState,
                                      action: !UiSdlStyleIdSetAction): !UiSdlReduxState ts-client

  /**
   * Returns an action for updating the current style.
   *
   * @param componentId
   *           Id of the component.
   * @param styleId
   *           Id of the {@link UiSdlThemeTemplate} or {@link UiSdlDensityTemplate} to set as the current style.
   * @param styleType
   *           Which of either `density` or `theme` needs to be updated
   * @return a 'HIDDEN_ID_SET' action for this instance with the following properties:
   * - payload.styleId {string} The id of the style to set as the current style.
   * - payload.styleType {string} Which theming id needs to be  updated.
   */
  @uiSdlActionCreator(actionType='HIDDEN_ID_SET')
  setHiddenIdAction: function(componentId: !string, styleId: !string, styleType: !string enum('density', 'theme')): UiSdlHiddenThemingIdSetAction ts-client

  /**
   * Sets the current style id in the state.
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='HIDDEN_ID_SET')
  hiddenIdSetReducer: private function(state: !UiSdlReduxState,
                                      action: !UiSdlStyleIdSetAction): !UiSdlReduxState ts-client
}
