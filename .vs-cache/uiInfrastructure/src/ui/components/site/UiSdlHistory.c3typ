/**
 * Type representation of a browser's history
 */
@typesys
final private type UiSdlHistory {

  /**
   * The number of entries in the history stack
   */
  length: int

  /**
   * The current location
   */
  location: UiSdlHistoryLocation

  /**
   * The current navigation action
   */
  action: string enum('PUSH', 'REPLACE', 'POP')
}
