/**
 * UiSdlRouter manages rendered pages based on {@type UiSdlRoute} metadata.
 *
 * This component type is private because it is automatically rendered
 * from a {@type UiSdlSite} and should not be used directly.
 */
@uiComponentCategorizer(name='Router', category='Patterns', hide=true)
type UiSdlRouter mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The user context used to display user-specific information.
   */
  user: UiSdlUserContext

  /**
   * A UiSdlRoute path. Will be matched to all the available routes to find
   * a page to render.
   */
  currentPath: string

  /**
   * The routes that can be handled by this router
   */
  routes: [UiSdlRoute]

  /**
   * The browser history to be used by all components inside this router.
   */
  history: UiSdlHistory

  /**
   * Children components to render in this layout.
   */
  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]

  /**
   * A list of patterns that indicate what routes can be handled by the router.
   *
   * If a route doesn't match any pattern, it will be ignored and reported via
   * {@see onUnhandledRoute}.
   */
  onlyAllowMatchingRoutes: [string]

  /**
   * Callback triggered when a route was ignored based on onlyAllowMatchingRoutes.
   */
  onUnhandledRoute: private function(route: string)

  /**
   * Identifies a {@link UiSdlRoute} that matches the given URL path.
   *
   * @param urlPath
   *           The URL path to match against routes.
   * @param routes
   *           The list of routes in the application.
   * @returns a map of route variable names to values.
   */
  findMatchingRoute: private function(urlPath: !string, routes: ![UiSdlRoute]): UiSdlRoute ts-client

  /**
   * Parses the given route's variables from the given URL path.
   *
   * @param urlPath
   *           The URL path to parse.
   * @param routePath
   *           The {@link UiSdlRoute#urlPath} whose variables to parse from the URL path.
   * @returns a map of route variable names to values.
   */
  parseRouteVariables: private function(urlPath: !string, routePath: !string): !map<string, string> ts-client

  /**
   * Parses page params (route variables and query params) from the given location.
   * In case of parameter name conflicts, route variables take precedence over query params.
   *
   * @param location
   *           The current browser location. This has the same properties as a
   *           [URL](https://developer.mozilla.org/en-US/docs/Web/API/URL).
   * @param routes
   *           The list of routes in the application.
   * @returns a map of page param names to values.
   *
   * @example
   *     parsePageParams(
   *       { pathname: '/multi-var/foo/route/bar', search: '?param3=baz&param4=quz' },
   *       [{ urlPath: '/multi-var/{{param1}}/route/{{param2}}' }]
   *     );
   *     // { param1: "foo", param2: "bar", param3: "baz", param4: "quz" }
   */
  parsePageParams: private function(location: !UiSdlHistoryLocation,
                                    routes: ![UiSdlRoute]): !map<string, string | [string]> ts-client
}
