/**
 * Payload for a {@link UiSdlConfigSetAction}
 */
type UiSdlConfigSetPayload {

  /**
   * The id of the site being used
   */
  siteId: !string

  /**
   * The combined path for the configuration
   */
  key: string

  /**
   * The value assigned to the configuration key path
   */
  value: any
}
