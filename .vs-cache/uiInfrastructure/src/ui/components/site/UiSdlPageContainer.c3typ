/**
 * A container for the page. This can be used to add additional functionality to all pages in an application.
 *
 * By default, {@link UiSdlRouter} uses the pre-defined page container `SDL.DefaultPageContainer`.  This should not be
 * overridden.  Instead, create your own instance of `UiSdlPageContainer`.
 *
 * The page container component is rendered in the router based on a naming convention. The router will first look
 * for a component instance with the metadata id `[packageName].PageContainer`.  If it is not found, the default
 * page container instance will be used.
 *
 * An example of that might look like:
 *
 * myPackage.PageContainer.json
 * {
 *   "type": "UiSdlPageContainer",
 *   "component": {
 *     "children": [
 *       { "id": "myPackage.myComponent" }
 *     ]
 *   }
 * }
 *
 * Optionally, you can provide your own implementation by mixing {@link UiSdlPageContainer} and
 * creating a new React type and .tsx file.
 */
@uiComponentCategorizer(name='Page container', category='Components', hide=true)
type UiSdlPageContainer mixes UiSdlComponent<UiSdlNoData> {

  /**
   * Children components to render within this component
   */
  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]
}
