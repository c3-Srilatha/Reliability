/**
 * TODO: UI-6773 [Core - State Management] Clean up/implement UiSdlEffectableState and UiSdlState
 */
@typeScript
abstract type UiSdlEffectableState mixes UiSdlState {

  /**
   * Determines whether or not the `UiSdlState` can update state outside of its own state
   * @return true if the `UiSdlState` should not be able to set state outside of its own state
   */
  isLimitEffectOnState: private abstract function(): boolean ts-client
}
