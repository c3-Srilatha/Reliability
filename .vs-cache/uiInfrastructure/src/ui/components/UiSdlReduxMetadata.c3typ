/**
 * The type that represents the location where the data is stored in the Redux store.
 * This is mixed by things that store states in the Redux store, e.g. UI components, data sources {@link UiSdlDataRedux} or application state.
 */
type UiSdlReduxMetadata {

  /**
   * The data Redux namespace that indicates where the data is stored in the Redux state.
   */
  REDUX_METADATA_NAMESPACE: string = ''

  /**
   * TODO: ENGR-7636 Move to UiEffectable
   */
  effectTriggers: [UiSdlEffectTrigger]
}
