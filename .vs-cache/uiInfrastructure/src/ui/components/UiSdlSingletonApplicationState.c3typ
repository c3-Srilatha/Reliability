/**
 * Singleton Application State that will only have 1 metadata instance with a known id.
 *
 * Any Type that mixes UiSdlSingletonApplicationState will need to manage their
 * own id field so each Type methods can internally use the same one.
 */
@typeScript
abstract type UiSdlSingletonApplicationState mixes UiSdlApplicationState
