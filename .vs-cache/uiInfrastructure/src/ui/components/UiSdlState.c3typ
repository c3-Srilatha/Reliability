/**
 * The ultility type that provides methods to interact with the Redux state.
 */
@typeScript
abstract type UiSdlState {

  /**
   * Gets the namespace for this state
   * @return the namespace
   */
  getStateNamespace: abstract function(): string ts-client

  /**
   * Gets the namespace for the initial state
   * @return the namespace
   */
  getInitialStateNamespace: abstract function(): string ts-client

  /**
   * Gets the entire path to the state
   * @param id
   *           The id of the stateful entity
   * @return an array of the entire path to the state
   */
  getConfigStatePath: private function(id: string): [string] ts-client

  /**
   * Gets the enire path to the initial state
   * @param id
   *           The id of the stateful entity
   * @return an array of the entire path to the initial state
   */
  getInitialConfigStatePath: private function(id: string): [string] ts-client

  /**
   * Helper method to retrieve config values from the state.
   *
   * @param id The stateful entity holding the config
   * @param state The Redux state
   * @param dataPath The path to the config
   * @returns The config value as UiSdlImmutableJS
   */
  getConfigFromState: function(id: string,
                                        state: UiSdlReduxState,
                                        dataPath: [string]): UiSdlImmutableJS ts-client

  /**
   * Helper method to retrieve config values from the state.
   *
   * @param id The stateful entity holding the config
   * @param state The Redux state
   * @param dataPath The path to the config
   * @param value The value to set
   * @returns The new state as UiSdlImmutableJS
   */
  setConfigInState: function(id: string,
                                      state: UiSdlReduxState,
                                      dataPath: [string],
                                      value: any): UiSdlImmutableJS ts-client

  /**
   * Helper method to retrieve initial config values from the state.
   *
   * @param id The stateful entity holding the config
   * @param state The Redux state
   * @param dataPath The path to the config
   * @returns The config value as UiSdlImmutableJS
   */
  getInitialConfigFromState: private function(id: string,
                                                       state: UiSdlReduxState,
                                                       dataPath: [string]): UiSdlImmutableJS ts-client

  /**
   * Helper method to retrieve initial config values from the state.
   *
   * @param id The stateful entity holding the config
   * @param state The Redux state
   * @param dataPath The path to the config
   * @param value The value to set
   * @returns The new state as UiSdlImmutableJS
   */
  setInitialConfigInState: private function(id: string,
                                                     state: UiSdlReduxState,
                                                     dataPath: [string],
                                                     value: any): UiSdlImmutableJS ts-client
}
