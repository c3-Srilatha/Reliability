/**
 * Abstract UiSdlDynamicValueSpecParam that assists in extracting values from the UI State.
 * Subtypes of this must implement `extract` to extract the portion of the relevant portion of the state.
 */
@typeScript
abstract type UiSdlStateValueParam mixes UiSdlDynamicValueSpecParam {

  /**
   * The id of the component to inspect
   */
  id: string

  /**
   * The path from the root state of the `id` to the desired value.
   * Each level in the state should be traversed through a dot (.) delimiter.
   * Ex: 'c3arguments.arg1.field1'
   */
  path: string

  /**
   * javascript action (expression) to perform on the state information.
   * References to the state path object can be made through 'statePathValue' variable.
   * The output of the action is expected to be stringifiable.
   */
  action: string = ''

  /**
   * Helper function to evaluate the action (if specified) on the stateValue
   * @param statePathValue
   *           The value of the state at the path specified
   * @param action
   *            The `UiSdlStateValueParam.action`
   * @returns the stateValue after the action has been applied
   */
  evalAction: private function(statePathValue: any, action: string): any ts-client

  /**
   * Converts the dot (.) delimited path to an array of strings
   * @param path
   *           The `UiSdlStateValueParam.path`
   * @return array of strings with the dot delimiter parsed
   */
  convertPathToArray: private function(path: string): [string] ts-client
}
