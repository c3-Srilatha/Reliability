@typeScript
type UiSdlComponentStateParam mixes UiSdlStateValueParam {

  /**
   * The type of the component specified by the `id`
   */
  componentType: string enum('component', 'dataSource') = 'dataSource'

  /**
   * The state type to retrieve. Applicable when componentType = 'dataSource'.
   * `config` means the current data source configurations (ex: `c3arguments`)
   * `value` means the actual data of the data source
   */
  stateType: string enum('config', 'value') = 'value'

  extract: ~ ts-client
}
