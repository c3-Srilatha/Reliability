/**
 * {@link UiSdlDynamicValueSpecParam} that allows the resolution of multiple parameters at once. Useful in
 * {@link UiSdlConnected#derivedProps} when the derivedProp may need to be calculated from multiple slices of state.
 */
@typeScript
type UiSdlMultiDynamicValueParam mixes UiSdlDynamicValueSpecParam {

  /**
   * Map of {@link UiSdlDynamicValueSpecParam} to resolve. Return value will have each element in the map resolved.
   */
  params: map<string, UiSdlDynamicValueSpecParam>

  extract: ~ ts-client

  toString: ~ js
}
