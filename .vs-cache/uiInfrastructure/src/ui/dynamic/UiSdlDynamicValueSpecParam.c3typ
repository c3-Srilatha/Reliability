@typeScript
/* If importing the pluggable generated from this type, use a relative import rather than `@c3/ui` */
@uiSdlPluggable(namespace='dynamicValueSpec')
abstract type UiSdlDynamicValueSpecParam mixes StringSerializable, WithDataTransforms {

  /**
   * Extracts the parameter value.
   * @param context
   *            A context object to assist in the resolution of the parameter value
   * @return the extracted parameter value or a {@link UiSdlDynamicValueSpec} that can be further resolved
   */
  extract: abstract function(param: mixing UiSdlDynamicValueSpecParam,
                             context: UiSdlParamExtractionContext): any ts-client

  /**
   * Specifies the format options of the param kind
   */
  format: UiSdlDynamicValueSpecParamFormat

  fromString: ~ ts-client

  /**
   * Specifies how to transform the extracted value. The default is string, but depending on the use case
   * it may be useful to transform the value to a value type like numbers, arrays, etc.
   */
  valueType: string enum('string', 'number') = 'string'
}
