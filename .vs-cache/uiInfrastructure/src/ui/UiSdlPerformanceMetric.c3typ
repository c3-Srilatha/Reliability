/**
 * A type to represent runtime perfomance measurement metrics.
 */
enum type UiSdlPerformanceMetric {

  UI_FRAMEWORK_BOOT_TIME = 'UI Framework boot time'

  UI_FRAMEWORK_DATA_LOAD_TIME = 'UI Framework data load time'

  PAGE_LOAD_TIME = 'Page load time'

  PAGE_DATA_LOAD_TIME = 'Page data load time'

  DYNAMIC_COMPONENT_MOUNTED = 'Dynamic component mounted'

  DYNAMIC_IMPORTS_NUMBER = 'Number of dynamic imports'

  SLOWEST_API_REQUEST = 'Slowest API request'
}
