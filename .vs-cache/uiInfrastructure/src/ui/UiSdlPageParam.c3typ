/**
 * A dynamic value resolved from page params.
 */
@typeScript
type UiSdlPageParam mixes UiSdlDynamicValueSpecParam {

  extract: ~ ts-client

  /**
   * Path from the component to the state information.
   * Each level in the state should be traversed through a dot (.) delimiter.
   * Ex: 'c3arguments.arg1.field1'
   */
  path: string
}
