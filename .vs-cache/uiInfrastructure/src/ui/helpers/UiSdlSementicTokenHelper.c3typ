/**
 * Semantic Token Helper methods used in uiComponentLibraryReact
 */
@typeScript
final type UiSdlSementicTokenHelper {

  /**
   * Retrieves the default font size of a browser. Falls back to 16px if one is not found.
   * @returns an int which represents the default font size of a browser in number form.
   */
  getDefaultFontSize: function(): int ts-client

  /**
   * Converts `rem` string value into its number form.
   * @param remString
   *          String version of `rem` css value. ex: 1rem, 1.5rem.
   * @returns a double which represents a rem string value in number form.
   */
  remValueToNumber: function(remString: string): double ts-client

  /**
   * Calculates rem number into pixel value.
   * @param remString
   *          Size of component in rem.
   * @returns a double which represents pixel rem conversion.
   */
  textRemToBrowserPixel: function(remString: string): double ts-client
}
