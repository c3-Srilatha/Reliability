/**
 * A partner to {@link Period}. Creates periods compatible with {@link Period}.
 */
@typeScript
type UiSdlPeriod {
  /**
   * The number of units in period.
   */
  count: !int

  /**
   * The period unit, which is a subset of the possible time series intervals.
   */
  unit: !string enum UiSdlTemporalUnit

  /**
   * Return a {@link Duration} that corresponds to this period. Note that without an absolute time reference, this
   * assumes canonical values for day and larger periods (month, year). Also, durations are always in units of
   * milliseconds, so large periods may not fit in any case.
   */
  toDuration: member function(): !UiSdlDuration ts-client

  /**
   * Return a string with the period in the serialization format.
   */
  toString: member function(): string ts-client

  /**
   * Construct a Period from the serialization format.
   *
   * The period is a single integer/unit pair: "1h" and "60m" would represent the same {@link Duration duration}, but
   * are different periods because both the count and interval are different.
   *
   * The supported intervals are:
   *  - year (y)
   *  - month (mo)
   *  - day (d)
   *  - hour (h)
   *  - minute (m)
   *  - second (s)
   *
   * @param s
   *           input string
   * @return the parsed duration
   *
   * @see Duration#fromString
   */
  fromString: function(s: string): UiSdlPeriod ts-client
}
