/**
 * A partner to {@link Duration}. Creates durations compatible with {@link Duration}.
 */
@typeScript
type UiSdlDuration {

  NANOS_IN_MICROS: const !int = 1000
  NANOS_IN_MILLIS: const !int = 1000000
  NANOS_IN_SEC: const !int = 1000000000
  NANOS_IN_MIN: const !int = 60000000000

  MICROS_IN_MILLIS: const !int = 1000
  MICROS_IN_SEC: const !int = 1000000
  MICROS_IN_MIN: const !int = 60000000

  MILLIS_IN_SEC: const !int = 1000
  MILLIS_IN_MIN: const !int = 60000
  MILLIS_IN_HOUR: const !int = 3600000

  /*
   * Actual duration in microseconds.
   */
  @constraint(condition='$ > 0')
  microseconds: !int

  /**
   * @return the number of milliseconds in the duration
   */
  milliseconds: member function(): !int ts-client

  /**
   * @return the number of seconds in the duration
   */
  seconds: member function(): !double ts-client

  /**
   * @return the number of minutes in the duration
   */
  minutes: member function(): !double ts-client

  /**
   * @return the number of hours in the duration
   */
  hours: member function(): !double ts-client

  /**
   * @return the number of days in the duration
   */
  days: member function(): !double ts-client

  /**
   * Converts the {@link UiSdlDuration} to a string serialized version.
   */
  toString: member function(): string ts-client

  /**
   * Construct a UiSdlDuration from the serialization format.
   *
   * The duration is specified by any combination of integer/unit pairs.
   * Pairs may be separated by spaces or concatenated.
   * For example, "1h 15m" and "75m" both mean 1 hour 15 minutes.
   *
   * The supported units are:
   *  - day (d)
   *  - hour (h)
   *  - minute (m)
   *  - second (s)
   *  - millisecond (ms)
   *  - microseconds (μs)
   *
   * If the value is a string containing only a number, the units are assumed to be microseconds.
   *
   * @param s
   *           input string
   * @return the parsed duration
   */
  fromString: function(s: string): UiSdlDuration ts-client
}
