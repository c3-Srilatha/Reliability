/**
 * A partner to {@link datetime_}. Creates durations compatible with {@link datetime_}.
 */
@typeScript
type UiSdlDateTime {

  dateDiff: function(date1: UiSdlDateTime, date2: UiSdlDateTime, unit: string serialized UiSdlTemporalUnit): int ts-client

 /**
  * Get the day of month field value in 1..31.
  */
  dayOfMonth: member function(): !int ts-client

  /**
   * Get the day of week field value in 1..7 (Monday is 1).
   */
  dayOfWeek: member function(): !int ts-client

  /**
   * Get the day of year field value in 1..366.
   */
  dayOfYear: member function(): !int ts-client

  /**
   * Get the hour of day field value in 0..23.
   */
  hourOfDay: member function(): !int ts-client

  /**
   * Get the millis of day field value in 0..86400000.
   */
  millisOfDay: member function(): !int ts-client

  /**
   * Get the millis of second field value in 0..999.
   */
  millisOfSecond: member function(): !int ts-client

  /**
   * Get the minute of day field value in 0..1440.
   */
  minuteOfDay: member function(): !int ts-client

  /**
   * Get the minute of hour field value in 0..59.
   */
  minuteOfHour: member function(): !int ts-client

  /**
   * Get the month of year field value in 1..12.
   */
  monthOfYear: member function(): !int ts-client

  /**
   * Get the second of day field value in 0..59.
   */
  secondOfDay: member function(): !int ts-client

  /**
   * Get the second of minute field value in 0..59.
   */
  secondOfMinute: member function(): !int ts-client

  /**
   * Get the year field value in 1..9999.
   */
  year: member function(): !int ts-client

  /**
   * Get the time zone offset. Note that this will be null if the date has no associated zone.
   */
  zone: member function(): TimeZone ts-client

  @deprecated(finalVersion="7.32", details="use dayOfMonth instead")
  getDayOfMonth: member function(): !int ts-client

  @deprecated(finalVersion="7.32", details="use dayOfWeek instead")
  getDayOfWeek: member function(): !int ts-client

  @deprecated(finalVersion="7.32", details="use dayOfYear instead")
  getDayOfYear: member function(): !int ts-client

  @deprecated(finalVersion="7.32", details="use hourOfDay instead")
  getHourOfDay: member function(): !int ts-client

  @deprecated(finalVersion="7.32", details="use millisOfDay instead")
  getMillisOfDay: member function(): !int ts-client

  @deprecated(finalVersion="7.32", details="use millisOfSecond instead")
  getMillisOfSecond: member function(): !int ts-client

  @deprecated(finalVersion="7.32", details="use minuteOfDay instead")
  getMinuteOfDay: member function(): !int ts-client

  @deprecated(finalVersion="7.32", details="use minuteOfHour instead")
  getMinuteOfHour: member function(): !int ts-client

  @deprecated(finalVersion="7.32", details="use monthOfYear instead")
  getMonthOfYear: member function(): !int ts-client

  @deprecated(finalVersion="7.32", details="use secondOfDay instead")
  getSecondOfDay: member function(): !int ts-client

  @deprecated(finalVersion="7.32", details="use secondOfMinute instead")
  getSecondOfMinute: member function(): !int ts-client

  @deprecated(finalVersion="7.32", details="use year instead")
  getYear: member function(): !int ts-client

  @deprecated(finalVersion="7.32", details="use zone instead")
  getZone: member function(): TimeZone ts-client

  /**
   * Whether or not this date/time has a time zone offset.
   */
  hasZone: member function(): boolean ts-client

  /**
   * Is this date/time after the date/time passed in comparing solely by millisecond.
   */
  isAfter: member function(rhs: !UiSdlDateTime): boolean ts-client

  /**
   * Is this date/time before the date/time passed in comparing solely by millisecond.
   */
  isBefore: member function(rhs: !UiSdlDateTime): boolean ts-client

  /**
   * Is this date/time equal to the date/time passed in comparing solely by millisecond.
   */
  isEqual: member function(rhs: !UiSdlDateTime): boolean ts-client

  /**
   * Returns a copy of this UiSdlDateTime with the specified duration taken away.
   */
  minus: member function(duration: !Duration): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime minus the specified number of days.
   */
  minusDays: member function(days: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime minus the specified number of hours.
   */
  minusHours: member function(hours: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime minus the specified number of millis.
   */
  minusMillis: member function(millis: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime minus the specified number of minutes.
   */
  minusMinutes: member function(minutes: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime minus the specified number of months.
   */
  minusMonths: member function(months: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime minus the specified number of seconds.
   */
  minusSeconds: member function(seconds: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime minus the specified number of weeks.
   */
  minusWeeks: member function(weeks: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime minus the specified number of years.
   */
  minusYears: member function(years: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime minus the specified number of intervals.
   */
  minusIntervals: member function(interval: !Interval, count: int = 1): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime with the specified duration added.
   */
  plus: member function(duration: !UiSdlDuration): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime plus the specified number of days.
   */
  plusDays: member function(days: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime plus the specified number of hours.
   */
  plusHours: member function(hours: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime plus the specified number of millis.
   */
  plusMillis: member function(millis: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime plus the specified number of minutes.
   */
  plusMinutes: member function(minutes: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime plus the specified number of months.
   */
  plusMonths: member function(months: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime plus the specified number of seconds.
   */
  plusSeconds: member function(seconds: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime plus the specified number of weeks.
   */
  plusWeeks: member function(weeks: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime plus the specified number of years.
   */
  plusYears: member function(years: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime plus the specified number of intervals.
   */
  plusIntervals: member function(interval: !Interval, count: int = 1): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime with the specified date, retaining the time fields.
   */
  withDate: member function(year: !int, monthOfYear: int = 1, dayOfMonth: int = 1): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime with the day of month field updated.
   */
  withDayOfMonth: member function(dayOfMonth: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime with the day of week field updated.
   */
  withDayOfWeek: member function(dayOfWeek: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime with the day of year field updated.
   */
  withDayOfYear: member function(dayOfYear: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime with the hour of day field updated.
   */
  withHourOfDay: member function(hour: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime with the millis of day field updated.
   */
  withMillisOfDay: member function(millis: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime with the millis of second field updated.
   */
  withMillisOfSecond: member function(millis: !int): !UiSdlDateTime

  /**
   * Returns a copy of this UiSdlDateTime with the minute of hour updated.
   */
  withMinuteOfHour: member function(minute: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime with the month of year field updated.
   */
  withMonthOfYear: member function(monthOfYear: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime with the second of minute field updated.
   */
  withSecondOfMinute: member function(second: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime with the specified time, retaining the date fields.
   */
  withTime: member function(hourOfDay: !int, minuteOfHour: int, secondOfMinute: int, millisOfSecond: int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime with the time set to the start of the day.
   */
  withTimeAtStartOfDay: member function(): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime with the year field updated.
   */
  withYear: member function(year: !int): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime with a different time zone, preserving the millisecond instant. I.e., this will
   * print as a different time value, along with the different zone.
   */
  withZone: member function(newZone: TimeZone): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime with a different time zone, preserving the field values. I.e., this will print as
   * an identical time value, but in the different zone.
   */
  withZoneRetainFields: member function(newZone: TimeZone): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime with no time zone, preserving the field values. I.e., this will print as an
   * identical time value, but without a time zone.
   */
  withoutZone: member function(): !UiSdlDateTime ts-client

  /**
   * Returns a copy of this UiSdlDateTime with a zero millis of second.
   */
  withoutMillis: member function(): !UiSdlDateTime ts-client

  /**
   * Format with the specified date format. See #parse for the full syntax. If no format is specified, use the full
   * ISO 8601 date format, incuding milliseconds and time zone (if present).
   *
   * @param format custom format string
   *
   * @see #parse
   */
  toString: member function(format: string): !string ts-client

  /**
   * Produce a date/time in the current time zone (UTC for the server) at the current millisecond instant.
   */
  now: function(): !UiSdlDateTime ts-client

  /**
   * Parse the ISO 8601 date format and produce a corresponding value. Null or empty string will return a null value,
   * but anything else must match the expected format, without any extraneous characters.
   */
  fromString: function(str: string): !UiSdlDateTime ts-client

  /**
   * Checks if a string has a valid date format by parsing it using the `fromString` function.
   * @param str - The string to be checked for a date format.
   * @returns A boolean indicating whether the string has a valid date format.
   */
  isDateFormat: function(str: any): !boolean ts-client

  /**
   * Checks if an array of strings contains valid date formats by parsing them using the `fromString` function.
   * @param arr - The array of strings to be checked for date formats.
   * @returns A boolean indicating whether all strings in the array have valid date formats.
   */
  isDateFormatArray: function(strArray: [any], allowAll: boolean): !boolean ts-client

  /**
   * Parses a DateTime from the specified string using a custom format. The format string includes one or more of the
   * following format characters:
   *
   * | F | meaning                      | expected | example          |
   * | - | ---------------------------- | -------- | ---------------- |
   * | e | day of week                  | number   | 2                |
   * | E | day of week                  | text     | Tuesday; Tue     |
   * | y | year                         | year     | 1996             |
   * | M | month of year                | month    | July; Jul; 07    |
   * | d | day of month                 | number   | 10               |
   * | a | halfday of day               | text     | PM               |
   * | K | hour of halfday (0-11)       | number   | 0                |
   * | h | clockhour of halfday (1-12)  | number   | 12               |
   * | H | hour of day (0-23)           | number   | 0                |
   * | k | clockhour of day (1-24)      | number   | 24               |
   * | m | minute of hour               | number   | 30               |
   * | s | second of minute             | number   | 55               |
   * | S | fraction of second           | number   | 978              |
   * | z | ~time zone name~             | zone     | PDT              |
   * | Z | time zone offset             | zone     | -0800; -08:00, Z |
   *
   * Literal letters must be escaped with single quotes (`'`).  A literal quote must be doubled. For example, the ISO
   * date string format is `yyyy-MM-dd'T'HH:mm:ss.SSSZ`.
   *
   * The 'z' format is deprecated as there is not a unique mapping from short time zone names to offset.
   * *It may work in some cases, or or work in unexpected ways.*
   * In general, use the 'Z' format and specify the time zone offset in the ISO 8601 format.
   *
   * If no time zone is part of the format, the date will be in the local time zone (UTC in the server).
   *
   * @param str string to parse
   * @param format expected format for date/time
   */
  parse: function(str: !string, format: !string): !UiSdlDateTime ts-client
}
