/**
 * Spec that will be used to define an "internal" action on a component,
 * directly on the type, rather than via c3ui metadata definition.
 */
@typeScript
type UiSdlEffectActionSpec mixes UiSdlEffectPayloadForwarder {

  /**
   * Redux action type that will be dispatched. Preferred format: NOUN_VERB.
   */
  @ser(name='type')
  actionType: string

  /**
   * If true, the payload contains the error message.
   */
  error: boolean

  /**
   * Metadata
   */
  meta: any
}
