/**
 * An UiSdlObservable of {@link UiSdlReduxAction} (aka action stream) as defined by
 * redux-observable.
 *
 * This is used by {@link UiSdlEpic#effect} and {@Ann.UiSdlEpic}
 * to process actions and map them to other actions to allow chaining.
 *
 * @see https://redux-observable.js.org/docs/basics/Epics.html
 */
type UiSdlActionsObservable mixes UiSdlObservable
