/**
 * A lazy push collection of multiple values.
 *
 * @param T the type of elements that the observable can contain
 *
 * @see http://reactivex.io/rxjs/manual/overview.html#observable
 */
type UiSdlObservable {

  /**
   * Used to stitch together functional operators into a chain or in other terms,
   * the result each operator is the input of the next one.
   *
   * @param operators a variable number of Rx operators
   *
   * @returns The result of applying all the operators as a chain.
   */
  pipe: function(operators: any ...): UiSdlObservable
}
