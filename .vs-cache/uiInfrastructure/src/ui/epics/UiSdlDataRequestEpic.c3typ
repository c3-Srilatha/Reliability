/**
 * Listens for actions of type 'DATA_REQUEST' and 'CANCEL_DATA_REQUEST'.
 * May trigger an action with type 'DATA_RECEIVE'.
 *
 * @param actionStream A stream of actions of this AsyncEffect actionType
 * @param stateStream An observable that emits the application state
 * @return an action stream
 */
@typeScript
type UiSdlDataRequestEpic mixes UiSdlEpic {

  epic: ~ ts-client
}
