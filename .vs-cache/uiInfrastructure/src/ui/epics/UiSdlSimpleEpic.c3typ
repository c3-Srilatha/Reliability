/**
 * Simplified version of {@link UiSdlEpic}.
 *
 * Simple epics are synchronous, operate on a single action (instead of on an observable of actions)
 * and return a collection of actions (instead of an observable of actions)
 *
 * It is recommended to use UiSdlSimpleEpic when you are only interested in one action at a time
 * and you don't need any RxJs operators (like delay, skipUntil, throttle, etc).
 */
@typeScript(sourceCodeType="Script")
type UiSdlSimpleEpic mixes UiSdlEpic {

  /**
   * Do not implement! Simple epics should overload `simpleEpic`.
   */
  epic: private ~ ts-client

  /**
   * Allows mapping actions without applying any Rx observable operators.
   *
   * This is useful if you don't need complex logic and only want to map a single action to other actions
   * @param action
   *          A redux action object
   * @param state
   *          The current Redux state
   * @return A collection of redux actions
   */
  simpleEpic: abstract function(action: UiSdlReduxAction, state: UiSdlReduxState) : [UiSdlReduxAction]
}
