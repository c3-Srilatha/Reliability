/**
 * Type that represents transformation from some arbitrary data format to
 * the format for {@link UiSdlChartData} type.
 */
@typeScript
@uiSdlPluggable(namespace='dataTransform')
abstract type UiSdlDataTransform<I, O> {

  /**
   * Transforms data from an object such as evalMetricsResult, to UiSdlChartData type.
   */
  transform: abstract function(data: !I, context: UiSdlDataTransform.Context): O ts-client

  /**
   * A function that transforms the action's arguments.
   *
   * @param arguments
   *            The search argument spec object to be sent to backend
   * @param componentId
   *            Component Id.
   * @param state
   *            Redux state.
   * @param context
   *            Transformation context
   * @returns The action argument with a new filter query.
   *
   * {
   *    spec: {
   *      filter: "contains(lowerCase(string(fieldName)), \"transformed value\")"
   *    }
   * }
   */
  transformArgs: abstract function(arguments: map<string, any>, componentId: string, state: !UiSdlReduxState, context: UiSdlDataTransform.Context): map<string, any> ts-client
}
