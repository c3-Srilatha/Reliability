/**
 * Payload for a {@link UiSdlArbitraryComponentValueDangerouslySetAction} (`GLOBAL_DANGEROUSLY_SET_ARBITRARY_COMPONENT_VALUE`).
 */
type UiSdlArbitraryComponentValueDangerouslySetPayload {

  /**
   * The new value to place into the component's redux state at the specified path.
   */
  value: any

  /**
   * The path to set a new value at from the component. Ex. ['dataSpec', 'actionName']
   */
  path: [string]

  /**
   * The id of the component whose state should be updated.
   */
  componentId: string
}
