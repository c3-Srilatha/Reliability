/**
 * Payload for a {@link UiSdlDataConfigUpdateAction}
 */
type UiSdlDataConfigUpdatePayload mixes UiSdlComponentActionPayload {

  /**
   * The name of the type.
   */
  typeName: string

  /**
   * The name of the action.
   */
  actionName: string

  /**
   * The arguments to be provided with the data request.
   */
  args: json = {}

  /**
   * List of data transform types, which will be applied after the data is
   * received but before saving it in the state.
   */
  dataTransforms: [string serialized Type]

  /**
   * When not empty, data and metadata will be retrieved from the specified tunnel.
   */
  tunnelConfiguration: UiSdlTunnelConfiguration

  /**
   * Any fields that are used in data spce to request data but are not defined inside
   * of data spec type
   */
  dataSpecDependence: [UiSdlCrossTypeDataSpecDependence]

  /**
   * New config for the data source
   */
  newConfig: !map<string, any>

  /**
   * An object that holds context variable information
   */
  contextVars: map<string, any>

  /**
   * The MetadataId of the component
   */
  metadataId: string
}
