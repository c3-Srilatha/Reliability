/**
 * Payload for a {@link UiSdlDataAddAction}
 */
type UiSdlDataAddPayload {

  /**
   * Id of the component's datasource
   */
  id: string

  /**
   * The location to insert the new record in the existing object array
   */
  insertLocation: string
}
