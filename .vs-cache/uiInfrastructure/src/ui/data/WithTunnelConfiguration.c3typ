/**
 * Utility type for adding a {@link tunnelConfiguration} field to the mixing type.
 */
private type WithTunnelConfiguration {

  /**
   * When not empty, data and metadata will be retrieved from the specified tunnel.
   */
  tunnelConfiguration: private UiSdlTunnelConfiguration
}
