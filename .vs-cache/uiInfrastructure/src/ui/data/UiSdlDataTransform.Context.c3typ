/**
 * Context for data transforms. Not all fields are guaranteed to be present.
 */
type UiSdlDataTransform.Context {

  /**
   * The content being transformed
   */
  content: json

  /**
   * dataSource id associated with the transformation
   */
  dataSourceId: string

  /**
   * Component id associated with the transformation
   */
  componentId: string

  /**
   * The redux state at the time of transformation
   */
  state: UiSdlReduxState
}
