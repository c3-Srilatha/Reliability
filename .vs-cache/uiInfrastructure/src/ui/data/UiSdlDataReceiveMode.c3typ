enum type UiSdlDataReceiveMode {

  /**
   * The received data will entirely replace the stored data.
   */
  REPLACE

  /**
   * The received data will replace one record and its descendants.
   * The first record in the data will be used as the root of the data and all related data will be replaced with the new data.
   */
  REPLACE_RECORD

  /**
   * The received data will be appended to the stored data.
   *
   * Only supports FetchResult and values returned by Hierarchy.fetchData.
   */
  APPEND
}
