/**
 * Allows packages to determine which files are exposed as part of its federated modules.
 *
 * If this mapping is not present for a given package, then all files will be exposed.
 * 
 * The id has to match the package name and the exposed modules key has to match the file name
 * in the @c3/ui npm package.
 */
type UiSdlPackageExports mixes Metadata, Identified {
    /**
     * The name of the package
     */
    id: ~

    /**
     * Determines which modules 
     */
    exposedModules: !map<string, boolean>
}
