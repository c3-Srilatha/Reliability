/**
 * Url object used for routing.
 */
type UiSdlPageUrl {

  /**
   * The url.  If parameterized, the params should also be specified.
   * @example
   * vanityUrl/users/{{id}}
   */
  url: string

  /**
   * Page params for the url
   * @example
   * {id: '123'}
   */
  params: map<string, string>
}
