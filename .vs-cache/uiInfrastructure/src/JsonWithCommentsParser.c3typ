/**
 * Node runtime type to leverage functionality in `comment-json` node module
 */
type JsonWithCommentsParser mixes SingleTenantEngine {

  /**
   * Parse json that may have comments.
   * @param jsonString
   *           The json to parse
   * @return the parsed json
   */
  @nodejs(typeSystem=false)
  parseJson: member function(jsonString: !string): json js-helpers-node
}
