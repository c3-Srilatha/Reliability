{
  "name": "uiInfrastructure",
  "description": "UI infrastructure for C3 Type based frontends",
  "author": "studio <studio@c3.ai>",
  "version": "8.9.0",
  "compatibleToVersion": "8.7",
  "dependencies": {
    "hierarchy": "8.9",
    "units": "8.9",
    "uiBundler": "8.9",
    "cssLibrary": "8.9",
    "uiMicrobench": "8.9",
    "uiPrimitives": "8.9"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@c3/c3-base",
      "plugin:@c3/typescript",
      "plugin:prettier/recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2018,
      "sourceType": "module"
    },
    "plugins": [
      "@c3"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^e$|^_",
          "ignoreRestSiblings": true
        }
      ]
    }
  }
}
