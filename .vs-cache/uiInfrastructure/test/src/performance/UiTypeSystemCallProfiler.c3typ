type UiTypeSystemCallProfiler {

    /**
     * Runs a benchmark that calls a method via a fully dispatched action
     *
     *       UiTypeSystemCallProfiler.publicMethod()
     */
    benchmarkWithDispatch: function (): MicrobenchResult js-server

    /**
     * Runs a benchmark that calls a function directly.
     *
     *       publicMethod()
     */
    benchmarkWithoutDispatch: function (): MicrobenchResult js-server

    /**
     * Runs a benchmark that calls an inline method via a fully dispatched action
     *
     *       UiTypeSystemCallProfiler.publicInlineMethod()
     */
    benchmarkWithInline: function (): MicrobenchResult js-server

    /**
     * Runs a benchmark that calls an external inline method via a fully dispatched action
     *
     *       UiTypeSystemExternalInlineDispatch.publicInlineMethod()
     */
    benchmarkWithExternalInline: function (): MicrobenchResult js-server

    /**
     * Dummy method to perform the test, it just returns 10 + 10;
     */
    publicMethod: function (): int js-server

    /**
     * Dummy method to perform the test, it just returns 10 + 10;
     */
    publicInlineMethod: inline function () : int js-server
}
