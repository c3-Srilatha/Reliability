/**
 * Type used for testing the functions of SpecHelper.  In order for this component to be imported it MUST start with Ui
 */
type UiSdlSpecHelperTestTypeChild mixes UiSdlComponent<any> {

  /**
   * Function to help test using spies.  This function is imported by UiSdlSpecHelperTestType to test spying on imported
   * functions
   */
  fetch: ~ ts-client
}
