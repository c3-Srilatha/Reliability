/**
 * Test type created to test doDataMerge importing on the {@link UiMetadataLoader} generated files
 */
type BundlerTestAppDoDataMerge mixes UiSdlComponent<any> {

  /**
   * The doDataMerge function of this component. It modifies the props before they are passed to the rendering function.
   * It must be defined by the current component and not inherited to be imported in the generated .tsx file.
   */
  doDataMerge: ~ ts-client
}
