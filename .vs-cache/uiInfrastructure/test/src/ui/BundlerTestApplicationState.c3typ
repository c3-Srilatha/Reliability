/**
 * A simple application state component for testing {@link UiSdlMetadataBundler} and {@link UiSdlMetadataLoader}.
 */
@typeScript
type BundlerTestApplicationState mixes UiSdlApplicationState {

  /**
   * The total count of the application state.
   */
  totalCount: private int

  /**
   * The map object that stores button id and how many time it was clicked.
   */
  buttonClickCountById: private map<string, int>

  /**
   * The heading of the application state.
   */
  heading: BundlerTestAppHeading

  /**
   * The status of the machine.
   */
  machineStatus: string = 'RUNNING'
}
