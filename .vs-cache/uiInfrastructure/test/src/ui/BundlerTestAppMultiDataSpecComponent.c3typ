/**
 * A component with multiple dataSpecs for testing {@link UiSdlMetadataBundler} and {@link UiSdlMetadataLoader}.
 */
type BundlerTestAppMultiDataSpecComponent mixes Identifiable {

  id: private ~

  /**
   * The data settings for this component.
   */
  @uiSdlDataSpec(dataDestinationField='dataCollection')
  dataSpec: BundlerTestAppMultiDataSpecComponentDataSpec

  /**
   * The data collection for this component.
   */
  dataCollection: [BundlerTestAppMultiDataSpecComponentDataSpec]

  /**
   * The options settings for this component.
   */
  @uiSdlDataSpec(dataDestinationField='options')
  optionSpec: BundlerTestAppMultiDataSpecComponentDataSpec

  /**
   * An array of option settings for this component.
   */
  options: [BundlerTestAppMultiDataSpecComponentDataSpec]
}
