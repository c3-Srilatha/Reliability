/**
 * A type to test that when mixed in, the default value for this type exists in the initial metadata
 * of the grandparent component.
 */
type BundlerTestAppReferenceTypeBase {

  /**
   * A field with a default value
   */
  fieldWithDefaultValue: string = 'This is the default value'
}
