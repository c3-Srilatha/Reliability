/**
 * A type with many different valueTypes to test the `getValueTypeName` function
 */
type BundlerTestAppValueTypes {

  /**
   * A generic `any` valueType
   */
  anyValueType: any

  /**
   * A generic reference valueType
   */
  referenceValueType: BundlerTestAppComponent

  /**
   * An array of reference valueType
   */
  arrayValueType: [BundlerTestAppComponent]

  /**
   * A nested array of reference valueType
   */
  nestedArrayValueType: [[BundlerTestAppComponent]]

  /**
   * An anyof valueType with array of reference and nested array of reference
   * Mimics our {@link UiSdlForm} fieldSets valueType
   */
  anyOfWithNestedArraysValueType: [BundlerTestAppComponent] | [[BundlerTestAppComponent]]

  /**
   * An anyof valueType with reference types
   */
  anyOfMultipleTypes: BundlerTestAppAmbiguousType | BundlerTestAppComponent
}
