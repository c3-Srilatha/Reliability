/**
 * A type for testing inheritance of methods in {@link UiSdlMetadataBundler} and {@link UiSdlMetadataLoader}.
 */
@typeScript
type BundlerTestAppInheritanceChild mixes BundlerTestAppInheritanceParent {

  /**
   * The child epic.
   */
  @uiSdlEpic(actionType=['CHILD_ACTION', 'CHILD_ACTION_2'])
  childEpic: function() ts

  /**
   * The child reducer.
   */
  @uiSdlReducer(actionType='CHILD_ACTION')
  childReducer: function() ts

  /**
   * The child creator action.
   */
  @uiSdlActionCreator
  childActionCreator: function() ts

  /**
   * A dummy function for testing that overrides the parent type's implementation.
   */
  dummyFuncOverride: ~ ts
}
