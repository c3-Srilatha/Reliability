/**
 * A heading component for testing {@link UiSdlMetadataBundler} and {@link UiSdlMetadataLoader}.
 */
type BundlerTestAppHeading mixes UiSdlComponent<any> {

  /**
   * The section heading level. Must be between 1 and 6, inclusive.
   * @see https://developer.mozilla.org/en-US/docs/Web/HTML/Element/Heading_Elements
   */
  headingLevel: int = 1

  /**
   * The title of the component
   */
  title: string

  /**
   * Dummy test reference type field.
   */
  extraInfo: BundlerTestAppReferenceType = {}
}
