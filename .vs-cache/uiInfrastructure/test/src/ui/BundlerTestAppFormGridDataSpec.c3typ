/**
 * A data spec for testing {@link UiSdlMetadataBundler} and {@link UiSdlMetadataLoader}.
 */
type BundlerTestAppFormGridDataSpec mixes UiSdlComponentDataSpec {

  /**
   * The field to use for the title of this component.
   */
  titleFieldName: string

  toPartiallyAppliedActions: ~ ts-client

  /**
   * The random set config for this data spec type.
   */
  randomSet: json

  /**
   * A dummy object for this data spec type.
   */
  randomObjects: json
}
