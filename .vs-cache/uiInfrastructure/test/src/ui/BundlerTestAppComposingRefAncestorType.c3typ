/**
 * A type used to test composing componentRefs. This type has a field
 * whose value type has fields, whose value type in turn contains {@link UiSdlComponentRef} fields.
 * Refer description from ticket Id MIG8-1127 for more context.
 */
type BundlerTestAppComposingRefAncestorType mixes UiSdlComponent<any> {

  /**
   * The content of the type.
   */
  content: BundlerTestAppComposingRefParentType
}
