/**
 * A type for testing inheritance of methods in {@link UiSdlMetadataBundler} and {@link UiSdlMetadataLoader}.
 */
@typeScript
type BundlerTestAppInheritanceParent {

  /**
   * The parent epic.
   */
  @uiSdlEpic(actionType='PARENT_ACTION')
  parentEpic: function() ts

  /**
   * The parent reducer.
   */
  @uiSdlReducer(actionType='PARENT_ACTION')
  parentReducer: function() ts

  /**
   * The parent creator action.
   */
  @uiSdlActionCreator
  parentActionCreator: function() ts

  /**
   * A dummy function for testing.
   */
  dummyFunc: function() ts

  /**
   * A dummy function for testing that will be override by child type.
   */
  dummyFuncOverride: function() ts
}
