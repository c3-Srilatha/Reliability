/**
 * A chart component for testing {@link UiSdlMetadataBundler}, {@link UiSdlMetadataLoader} and {@link UiSdlDynamicComponentRendererReact}.
 */
@uiImportGenerator(generator=BundlerTestAppGenerator)
type BundlerTestAppChart mixes UiSdlComponent<any> {

  /**
   * The title of this component.
   */
  title: string = 'This is the default value'

  /**
   * The subtitle of this component. This field is resolved from {@link UiSdlConnected#derivedProps}.
   */
  subtitle: string

  /**
   * A boolean field initialized to false to test {@link UiSdlTsTypesSourceCodeLoader#addDefaultValuesExport}.
   */
  boolean: boolean = false

  /**
   * An integer field initialized to 0 to test {@link UiSdlTsTypesSourceCodeLoader#addDefaultValuesExport}.
   */
  number: int = 0

  /**
   * A {@link UiSdlDynamicValueSpec} field.
   */
  text: string serialized UiSdlDynamicValueSpec = 'BundlerTestAppChart.text'

  /**
   * A string serialized field.
   */
  backgroundColor: string serialized Color

  /**
   * A string serializable field.
   */
  chartColor: Color
}
