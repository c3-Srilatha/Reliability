/**
 * A component for testing {@link UiSdlMetadataBundler} and {@link UiSdlMetadataLoader}.
 */
type BundlerTestAppComponent mixes UiSdlComponent<any> {

  /**
   * A dummy boolean prop for this component.
   */
  booleanProp: boolean

  /**
   * An anyof value type with reference types.
   */
  anyOfMultipleTypesWithoutDefault: BundlerTestAppAmbiguousType | BundlerTestAppChart

  /**
   * An anyof value type with reference types and a default value.
   * Similar to UiSdlMap.zoom
   */
  anyOfMultipleTypesWithDefault: BundlerTestAppAmbiguousType | BundlerTestAppComponent = {"type": "BundlerTestAppComponent"}

  /**
   * An anyof value type with reference collection types.
   */
  anyOfCollectionTypes: [BundlerTestAppAmbiguousType] | [BundlerTestAppChart]

  /**
   * A field reference to itself.
   */
  selfReferenceField: BundlerTestAppComponent

  /**
   * A string enum with default value named size. Similar to UiSdlModal.size.
   * Used to test that the special 'size' field name doesn't get in the way
   */
  size: string enum('TINY', 'SMALL', 'MEDIUM', 'LARGE', 'FULLSCREEN') = 'SMALL'

  /**
   * For testing purposes, a type ref without default values
   */
  referenceFieldWithoutDefault: BundlerTestAppReferenceType

  /**
   * For testing purposes, a type ref with default values
   */
  referenceFieldWithDefault: BundlerTestAppReferenceType = {}

  /**
   * For testing purposes, a type ref with some default values
   */
  referenceFieldWithSomeDefault: BundlerTestAppReferenceType = { someField: 'Some Field' }

  /**
   * For testing purposes, a type ref with overridden default values
   */
  referenceFieldWithOverrideDefault: BundlerTestAppReferenceType = { fieldWithDefaultValue: 'Updated Value' }
}
