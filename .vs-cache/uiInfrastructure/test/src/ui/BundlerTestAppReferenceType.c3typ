/**
 * A type to test that when a type is mixed into this type, and that mixed in type has a field
 * with a default value, that default value should exist in the initial metadata of this type's parent
 * (i.e., the type that contains this type as a reference field.)
 */
type BundlerTestAppReferenceType mixes BundlerTestAppReferenceTypeBase {

  /**
   * A string field
   */
  someField: string
}
