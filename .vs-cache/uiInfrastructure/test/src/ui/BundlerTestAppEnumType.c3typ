/**
 * An enum test type with string values.
 * The @typeScript annotation here is for test purpose only. Enum types do not need this.
 */
@typeScript
enum type BundlerTestAppEnumType {
  /**
   * A test field without value.
   */
  NO_VALUE

  /**
   * A test field with value.
   */
  WITH_VALUE = 'withValue'
}
