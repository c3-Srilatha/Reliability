/**
 * Abstract type to represent a customization component.
 *
 * @param C
 *           Reference to the component type for which the results are being returned.
 */
private final abstract type BaseCustomizationAnalysis.Component.Result<C> {
  /**
   * Reference to the component type for which the results are being returned.
   */
  results: C

  /**
   * The list of errors encountered during customization analysis calculations.
   */
  errors: [BaseCustomizationAnalysis.Error]
}
