/**
 * Type to structure the override information for methods parameters.
 */
private final type BaseCustomizationAnalysis.Type.Overrides.Method.Param {
  /**
   * The name of the overridden method parameter.
   */
  parameterName: string

  /**
   * Field to store the modification of the {@link ValueType} of the parameter. Set to null if no modification is
   * made to the parameter's value type.
   */
  modifiedParameterType: BaseCustomizationAnalysis.Modification

  /**
   * Field to store the modification of the {@link ValueModifier} of the parameter. Set to null if no modification is
   * made to the parameter's value modifier.
   */
  modifiedParameterModifier: BaseCustomizationAnalysis.Modification
}
