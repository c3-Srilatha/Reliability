/**
 * Type to capture information about overridden types and the nature of the override.
 */
private final type BaseCustomizationAnalysis.Type.Overrides.Type mixes BaseCustomizationAnalysis.Ann.Overrides {
  /**
   * The name of the overridden type.
   */
  typeName: string

  /**
   * The first package in which this type was declared.
   */
  firstDeclaringPkg: string

  /**
   * The count of net-new non-calc fields added to this type.
   */
  addedNonCalcFieldCount: int

  /**
   * The count of net-new read-calc fields added to this type.
   */
  addedReadCalcFieldCount: int

  /**
   * The count of net-new stored-calc fields added to this type.
   */
  addedStoredCalcFieldCount: int

  /**
   * The count of net-new methods added to this type.
   */
  addedMethodCount: int

  /**
   * The list of overridden fields on this type. Captures the nature of the overrides.
   */
  overriddenFields:  [BaseCustomizationAnalysis.Type.Overrides.Field]

  /**
   * The list of overridden methods on this type. Captures the nature of the overrides.
   */
  overriddenMethods:  [BaseCustomizationAnalysis.Type.Overrides.Method]
}
