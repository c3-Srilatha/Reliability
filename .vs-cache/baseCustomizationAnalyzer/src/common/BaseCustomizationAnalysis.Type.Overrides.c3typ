/**
 * Type to provide APIs for collecting Type override information.
 */
private final type BaseCustomizationAnalysis.Type.Overrides {
  /**
   * Function to get override information for a Type.
   *
   * @param typeName
   *           The Type name for which to get override information.
   * @param customerPackages
   *           The list of customer packages to ignore in the override customization analysis.
   * @return the override infromation for the Type.
   */
  getTypeOverrides: function(typeName: string, customerPackages: [string]): BaseCustomizationAnalysis.Type.Overrides.Type js-server
}
