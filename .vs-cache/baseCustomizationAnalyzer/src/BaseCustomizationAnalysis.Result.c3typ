/**
 * A type representing the customization analysis result.
 */
private final type BaseCustomizationAnalysis.Result {
  /**
   * The timestamp at which this result was generated.
   */
  timestamp: datetime

  /**
   * The {@link User} who generated this report.
   */
  generatedBy: string

  /**
   * The cluster on which this report was generated.
   */
  cluster: string

  /**
   * The server version of the cluster on which this report was generated.
   */
  serverVersion: string

  /**
   * The list of base packages in the dependency tree for the customer package being analyzed.
   */
  basePackageStats: map<string, BaseCustomizationAnalysis.BasePackageStats>

  /**
   * The list of customer packages specified in the call to {@link BaseCustomizationAnalysis#analyzeCode}.
   */
  customerPackages: [string]

  /**
   * The file counts for customer packages.
   */
  customerFileCounts: BaseCustomizationAnalysis.FileCounts

  /**
   * The customization analysis result for source types.
   */
  srcTypes: BaseCustomizationAnalysis.Component.Result<BaseCustomizationAnalysis.SrcType>

  /**
   * The customization analysis result for the user interface.
   */
  userInterface: BaseCustomizationAnalysis.Component.Result<BaseCustomizationAnalysis.Ui>

  /**
   * The customization analysis result for metrics.
   */
  tsMetrics: BaseCustomizationAnalysis.Component.Result<BaseCustomizationAnalysis.TsMetric>

  /**
   * The customization analysis result for data integration.
   */
  dataIntegration: BaseCustomizationAnalysis.Component.Result<BaseCustomizationAnalysis.Di>
}
