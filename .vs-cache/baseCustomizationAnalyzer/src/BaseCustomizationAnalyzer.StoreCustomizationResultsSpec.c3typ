/**
 * Type that contains customization analysis results and other information to be pushed to the centralized repository.
 */
private type BaseCustomizationAnalyzer.StoreCustomizationResultsSpec mixes BaseCodeAnalyzer.StoreResultsSpec {

  /**
   * The customization analysis results to push to the centralized repository.
   */
  customizationAnalysisResults: json

  /**
   * The code analysis step duration results to store for performance regression analysis.
   */
  codeAnalysisStepsWithDuration: json
}
