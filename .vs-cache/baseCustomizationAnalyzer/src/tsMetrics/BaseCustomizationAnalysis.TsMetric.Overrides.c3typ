/**
 * Type to capture information about overridden metrics and the nature of the override.
 */
private final type BaseCustomizationAnalysis.TsMetric.Overrides {
  /**
   * The list of overridden {@link SimpleMetric}s. Captures the nature of the overrides.
   */
  overriddenSimpleMetrics:  [BaseCustomizationAnalysis.TsMetric.Overrides.Metric]

  /**
   * The list of overridden {@link CompoundMetric}s. Captures the nature of the overrides.
   */
  overriddenCompoundMetrics:  [BaseCustomizationAnalysis.TsMetric.Overrides.Metric]
}
