/**
 * Type to store base package statistics. These counts wil used to compute aggregate statistics for
 * base customization levels in customer packages.
 */
private final type BaseCustomizationAnalysis.BasePackageStats {
  /**
   * The file counts for the base package.
   */
  fileCounts: BaseCustomizationAnalysis.FileCounts

  /**
   * The number of {@link Persistable} types.
   */
  persistableTypeCount: int

  /**
   * The number of non-{@link Persistable} types.
   */
  nonPersistableTypeCount: int

  /**
   * The number of {@link Canonical} types.
   */
  canonicalCount: int

  /**
   * The number of {@link Transform} instances.
   */
  transformCount: int

  /**
   * The number of {@link UiSdlComponent} types introduced.
   */
  uiSdlComponentTypeCount: int

  /**
   * The number of {@link UiSdlComponent} metadata files.
   */
  uiSdlComponentMetadataCount: int

  /**
   * The number of {@link UiSdlEpic} type files.
   */
  uiSdlEpicCount: int

  /**
   * The number of {@link UiSdlTransform} type files.
   */
  uiSdlDataTransformCount: int

  /**
   * The number of {@link UiSdlApplicationState} type files.
   */
  uiSdlApplicationStateCount: int

  /**
   * The number of {@link SimpleMetric} instances.
   */
  simpleMetricCount: int

  /**
   * The number of {@link CompoundMetric} instances.
   */
  compoundMetricCount: int

  /**
   * The list of errors encountered during base package statistic calculations.
   */
  errors: [BaseCustomizationAnalysis.Error]

  /**
   * Function to calculate statistics for a base package.
   *
   * @param basePackage
   *           The name of the base package for which to compute statistics.
   * @returns the {@link BaseCustomizationAnalysis.BasePackageStats} result.
   */
  calculateStatsForBasePackage: function(basePackage: string): BaseCustomizationAnalysis.BasePackageStats js-server
}
