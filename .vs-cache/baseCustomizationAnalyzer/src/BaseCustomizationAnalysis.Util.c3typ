/**
 * Type for running customization analysis on customer repositories to understand the usage and extension
 * patterns of base applications.
 */
private final type BaseCustomizationAnalysis.Util {

  /**
   * Function to get counts by file extensions.
   *
   * @param packageNames
   *           The list of package names for which to get counts by file extensions.
   * @returns the {@link BaseCustomizationAnalysis.FileCounts} for the provided packages.
   */
  getCountsByFileExts: inline function(packageNames: ![string]): BaseCustomizationAnalysis.FileCounts js-rhino

  /**
   * Function to get the list of Type files defined in the provided list of customer repositories.
   *
   * @param customerPackages
   *           The list of customer packages to analyze customizations in.
   * @returns an map from the Type file to the list of file specs for that type.
   */
  getTypeFilesForPkgs: inline function(customerPackages: ![string]): map<string, [BaseCodeAnalysis.FileSpec]> js-rhino

  /**
   * Function to get a json file string content as a json object. The C3 AI Platform allows
   *
   * @param content
   *           The string content to be parsed as a json object.
   * @returns a json object representation of the json string content.
   */
  getCleanedJsonContentString: inline function(content: string): string js-rhino

  /**
   * Function to get the difference between the base and customer json contents.
   *
   * @param baseJsonContent
   *           The object of the base JSON file.
   * @param customerJsonContent
   *           The object of the customer JSON file.
   * @returns the difference between the two json file contents.
   */
  getJsonDiff: inline function(baseJsonContent: string, customerJsonContent: string): json js-rhino
}
