/**
 * Type to store error messages encountered during a customization analysis run.
 */
private final type BaseCustomizationAnalysis.Error {
  /**
   * Additional information regarding the source of the error message.
   */
  info: json

  /**
   * Error message.
   */
  errorMessage: string
}
