/**
 * Type to store base package statistics. These counts wil used to compute aggregate statistics for
 * base customization levels in customer packages.
 */
private final type BaseCustomizationAnalysis.FileCounts {
  /**
   * Total file count.
   */
  totalFileCount: int

  /**
   * File counts by file extension.
   */
  countsByFileExtension: map<string, int>

  /**
   * File counts by category and by file extension.
   */
  countsByCategoryFileExtension: map<string, map<string, int>>
}
