/**
 * Abstract type to represent a customization component.
 *
 * @param A
 *           Type to represent non-descriptive, statistical information about additions made to this component.
 * @param O
 *           Type to represent descriptive information about overrides made to this component.
 * @param U
 *           Type to represent utilitization information about this component.
 * @param C
 *           Self-reference to the component type.
 */
private final abstract type BaseCustomizationAnalysis.Component<A, O, U, C> {
  /**
   * The additions component can only store non-descriptive, statistical information
   * about net-new additions made to the package. Example:
   * - # new transforms
   * - # new canonicals
   */
  additions: A

  /**
   * The overrides component can descriptive customizations made to base types
   * and APIs made in the customer's repository. Example:
   * - Method `myFunction` remixed on the `AssetType` from `basePackageA`.
   */
  overrides: O

  /**
   * The utilizations component can optionally provide descriptive information of
   * which base functionalities were utilized in the customer's repo. Example:
   * - Canonical `canonicalA` used.
   */
  utilizations: U

  /**
   * Function to calculate the customization analysis results for this component.
   *
   * @param customerPackages
   *           The list of customer packages.
   * @returns the {@link BaseCustomizationAnalysis.Component} analysis result.
   */
  calculateResults: abstract function(customerPackages: [string]): BaseCustomizationAnalysis.Component.Result<C> js-server
}
