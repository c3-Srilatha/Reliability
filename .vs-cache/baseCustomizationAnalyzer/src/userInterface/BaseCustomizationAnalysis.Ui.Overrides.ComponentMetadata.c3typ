/**
 * Type to capture information about an overridden {@link UiSdlComponent} and the nature of the override.
 */
private final type BaseCustomizationAnalysis.Ui.Overrides.ComponentMetadata {
  /**
   * The name of the overridden {@link UiSdlComponent}.
   */
  metadataId: string

  /**
   * Boolean to indicate whether the component type was changed.
   */
  changedComponentType: boolean

  /**
   * The list of modified props.
   */
  modifiedProps: [string]

  /**
   * The list of removed props.
   */
  removedProps: [string]
}
