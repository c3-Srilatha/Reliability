/**
 * Type to capture the nature of customization to the user interface.
 */
private final type BaseCustomizationAnalysis.Ui mixes
  BaseCustomizationAnalysis.Component<
    BaseCustomizationAnalysis.Ui.Additions,
    BaseCustomizationAnalysis.Ui.Overrides,
    Obj,
    BaseCustomizationAnalysis.Ui
  > {

  /**
   * A comprehensive list of UI Types. Any Types that mix in a UI Type, the addition/override information
   * is considered in the user interface component opposed to any of the other components.
   */
  UI_TYPES: private const [string] = ['UiSdlEpic', 'UiSdlDataTransform', 'UiSdlComponent', 'UiSdlApplicationState', 'ReactFunction']

  calculateResults: ~
}
