/**
 * Type to capture information about overridden types and the nature of the override.
 */
private final type BaseCustomizationAnalysis.Ui.Overrides {
  /**
   * The list of overridden {@link UiSdlEpic}s. Captures the nature of the overrides.
   */
  overriddenComponentMetadatas:  [BaseCustomizationAnalysis.Ui.Overrides.ComponentMetadata]

  /**
   * The list of overridden {@link UiSdlEpic}s. Captures the nature of the overrides.
   */
  overriddenUiSdlEpics:  [BaseCustomizationAnalysis.Type.Overrides.Type]

  /**
   * The list of overridden {@link UiSdlDataTransform}s. Captures the nature of the overrides.
   */
  overriddenUiSdlDataTransforms:  [BaseCustomizationAnalysis.Type.Overrides.Type]

  /**
   * The list of overridden {@link UiSdlComponent}s. Captures the nature of the overrides.
   */
  overriddenUiSdlComponents:  [BaseCustomizationAnalysis.Type.Overrides.Type]

  /**
   * The list of overridden {@link UiSdlApplicationState}s. Captures the nature of the overrides.
   */
  overriddenUiSdlApplicationStates:  [BaseCustomizationAnalysis.Type.Overrides.Type]
}
