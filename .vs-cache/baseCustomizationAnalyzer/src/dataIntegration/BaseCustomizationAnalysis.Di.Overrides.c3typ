/**
 * Type to capture information about overridden data integration types and the nature of the override.
 */
private final type BaseCustomizationAnalysis.Di.Overrides {
  /**
   * The list of overridden {@link Transform}s. Captures the nature of the overrides.
   */
  overriddenTransforms:  [BaseCustomizationAnalysis.Di.Overrides.Transform]

  /**
   * The list of overridden {@link Canonical}s. Captures the nature of the overrides.
   */
  overriddenCanonicals:  [BaseCustomizationAnalysis.Type.Overrides.Type]
}
