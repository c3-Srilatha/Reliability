/**
 * Type to capture information about an overridden {@link Transform} and the nature of the override.
 */
private final type BaseCustomizationAnalysis.Di.Overrides.Transform {
  /**
   * The name of the overridden {@link Transform}.
   */
  transformName: string

  /**
   * Count of the number of added fields to the {@link Transform}.
   */
  addedFieldCount: int

  /**
   * Field to store the modification of the {@link Transform#source}. Set to null if no modification is
   * made to the transform's source.
   */
  modifiedSource: BaseCustomizationAnalysis.Modification

  /**
   * Field to store the modification of the {@link Transform#target}. Set to null if no modification is
   * made to the transform's target.
   */
  modifiedTarget: BaseCustomizationAnalysis.Modification

  /**
   * Field to store the modification of the {@link Transform#targetCollection}. Set to null if no modification is
   * made to the transform's targetCollection.
   */
  modifiedTargetCollection: BaseCustomizationAnalysis.Modification

  /**
   * Field to store the modification of the {@link Transform#condition}. Set to null if no modification is
   * made to the transform's condition.
   */
  modifiedCondition: BaseCustomizationAnalysis.Modification

  /**
   * Field to store the modification of the {@link Transform#transformer}. Set to null if no modification is
   * made to the transform's transformer.
   */
  modifiedTransformer: BaseCustomizationAnalysis.Modification

  /**
   * The list of overridden transform fields.
   */
  overriddenFields: [BaseCustomizationAnalysis.Di.Overrides.Transform.Field]
}
