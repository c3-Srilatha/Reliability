/**
 * Type to capture the nature of customization to the user interface.
 */
private final type BaseCustomizationAnalysis.Di mixes
  BaseCustomizationAnalysis.Component<
    BaseCustomizationAnalysis.Di.Additions,
    BaseCustomizationAnalysis.Di.Overrides,
    Obj,
    BaseCustomizationAnalysis.Di
  > {

  /**
   * A comprehensive list of data integration Types. Any Types that mix in a DI Type, the addition/override information
   * is considered in the user interface component opposed to any of the other components.
   */
  DI_TYPES: private const [string] = ['Canonical']

  calculateResults: ~
}
