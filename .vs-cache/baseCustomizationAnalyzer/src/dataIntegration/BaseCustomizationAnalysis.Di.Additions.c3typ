/**
 * Type to capture non-descriptive statistics on the net-new DI type / metadata additions made
 * to the customer's packages.
 */
private final type BaseCustomizationAnalysis.Di.Additions {
  /**
   * The number of new {@link Canonical} types introduced in the customer package.
   */
  addedCanonicalCount: int

  /**
   * The number of new {@link Transform} metadata files introduced in the customer package.
   */
  addedTransformCount: int
}
