/**
 * Type to capture information about an overridden {@link Transform} and the nature of the override.
 */
private final type BaseCustomizationAnalysis.Di.Overrides.Transform.Field {
  /**
   * The name of the overridden {@link Transform}.
   */
  fieldName: string

  /**
   * Field to store the modification of the {@link Transform#transformer}. Set to null if no modification is
   * made to the transform's transformer.
   */
  modification: BaseCustomizationAnalysis.Modification
}
