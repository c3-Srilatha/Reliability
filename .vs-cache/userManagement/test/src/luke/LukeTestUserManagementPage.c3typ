/**
 * LukeTestUserManagementPage is a UI test for the User Management page
 */
type LukeTestUserManagementPage mixes LukeTestAutomationPage {

  path:  ~ = 'user-management'
  _init: ~

  /**
   * Selectors to determine if the page rendered properly
   */
  renderingSelectors: ~ = ['.c3-sdl-tabpanel']

  /**
   * The tab panel that contains different grid views for users, groups, and page access summary
   */
  tabPanel: LukeTestUiSdlTabPanel

  /**
   * Grid for users, groups, and page access summary from the tab panel
   */
  tabPanelGrid: LukeTestUiSdlDataGrid

  /**
   * Details modal containing additional tabs and access info
   */
  modal: LukeTestUiSdlModal

  modalTabPanel:     LukeTestUiSdlTabPanel
  modalGrid:         LukeTestUiSdlDataGrid
  banner:            LukeTestUiSdlMessageContainer
  bannerInModal:     LukeTestUiSdlMessageContainer
  formInModal:       LukeTestUiSdlForm
  formInModalStatus: LukeTestComponent

  /**
   * Add Users modal
   */
  addUserModal: LukeTestUserManagementAddUsersModal

  /**
   * Edit Users modal
   */
  editUserModal: LukeTestUserManagementEditUsersModal
}
