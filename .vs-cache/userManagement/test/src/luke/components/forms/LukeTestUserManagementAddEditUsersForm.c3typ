/**
 * Representation of a Add/Edit Users form for testing purposes
 */
type LukeTestUserManagementAddEditUsersForm mixes LukeTestUiSdlForm {

  /**
   * The selector for the add users form
   */
  parentSelector: ~ = '.c3-modal .c3-sdl-form'

  modalParentSelector: const string = '.c3-modal .c3-sdl-form'

  /**
   * Initializes all helper components and returns an instance of {@link LukeTestUserManagementAddEditUsersForm}
   */
  init: function(luke: !LukeBrowser): LukeTestUserManagementAddEditUsersForm js-client

  /**
   * The testing {@link LukeTestUiSdlSelectInput} selected groups of the form
   */
  selectedGroupsInput: LukeTestUiSdlSelectInput
}
