/**
 * Representation of a "Add/Edit Users" modal in User Management for testing purposes
 */
type LukeTestUserManagementAddEditUsersModal mixes LukeTestUiSdlModal {

  /**
   * Initializes all helper components and returns an instance of {@link LukeTestUserManagementAddUsersModal}
   */
  init: function(luke: !LukeBrowser): LukeTestUserManagementAddUsersModal js-client

  /**
   * The testing {@link LukeTestUserManagementAddEditUsersForm} add users form
   */
  usersForm: LukeTestUserManagementAddEditUsersForm

  /**
   * Submits the form, adding the userIds with the corresponding groupIds
   */
  submit: abstract inline member function(userIds: !string, groupIds: ![string]): LukeAsyncQueueNode js-client
}
