/**
 * Transforms a user group to a {@link UiSdlDataGrid} column field setting.
 */
@typeScript
type UserGroupsToColumnFieldSettings mixes UiSdlDataTransform<[UserGroup], [UiSdlDataGridDataSpecColumnFieldSetting]> {

  @typeScript(env='client')
  transform: ~
}
