/**
 * Enum type representing the different mapping operations on the Idp Group
 */
enum type IdpGroupMappingOperation {
  /**
   * Add a new Idp Group mapping
   */
  ADD

  /**
   * Update an existing IdpGroup mapping
   */
  UPDATE

  /**
   * Remove an existing IdpGroup mapping
   */
  REMOVE

  /**
   * Reset all the edited mapping to its original state
   */
  RESET_ALL
}
