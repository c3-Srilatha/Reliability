@typeScript
type UserManagementActionUtil {

  /**
   * Simple wrapper that extracts the current major.minor.patch server version and passes to `versionCallback` to get the {@link PartiallyAppliedAction}
   * that is appropriate for the given server version
   * @param state
   *     Redux state
   * @param context
   *     Any context the consumer can provide to assist in constructing the PartiallyAppliedAction
   * @param versionCallback
   * @return a PartiallyAppliedAction that can be executed in the appropriate server version
   *      
   */
  typeActionForServerVersion: function(state: !UiSdlReduxState,
                                       context: !?any,
                                       versionCallback: !lambda(version: !string, context: !?any): !PartiallyAppliedAction
                                      ): !PartiallyAppliedAction ts-client

  /**
   * Makes an ajax request to the `typeAction` with the end goal of displaying some message banner to the user.
   * Follows the path of `successSpec` when call does not throw an error and `failureSpec` when call results in an error.
   */
  banneredAjaxObservable: function(spec: !UserManagementActionSpec, state: !UiSdlReduxState): UiSdlActionsObservable ts-client

  /**
   * {@see UserManagementActionUtil#banneredAjaxObservable}
   * Assumes the action is dispatching from a modal and thus:
   *   1. sets the primary button to disabled and loading
   *   2. sets the second button to disabled
   *  while ajax is running.
   * Upon a successful response - optionally closes the modal and resets the buttons
   */
  modalBasedBanneredAjaxObservable: function(spec: !UserManagementModalActionSpec, state: !UiSdlReduxState): UiSdlActionsObservable ts-client

  /**
   * {@see UserManagementActionUtil#modalBasedBanneredAjaxObservable}
   * Assumes that the modal contains a form and will display a form status error if the action errors.
   * In this case, since the modal presumably will remain open - the consumer is responsible for clearing the form status.
   */
  modalWithFormBanneredAjaxObservable: function(spec: !UserManagementFormModalActionSpec, state: !UiSdlReduxState): UiSdlActionsObservable ts-client                  
}
