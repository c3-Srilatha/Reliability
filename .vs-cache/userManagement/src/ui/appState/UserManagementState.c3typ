/**
 * Application state to manage data related to User Management.
 */
@typeScript
type UserManagementState mixes UiSdlSingletonApplicationState {

  /**
   * Stores the selected {@link User} in state.
   */
  selectedUser: User

  /**
   * Stores the selected {@link UserGroup} in state.
   */
  selectedUserGroup: UserGroup

  /**
   * Stores the current state of the selectedUserGroup
   */
  selectedUserGroupState: string enum('NOT_MAPPED', 'MAPPING', 'MAPPED')

  /**
   * Stores the current {@link App} instance
   */
  application: App

  /**
   * Stores the user groups in the application.
   */
  userGroups: [UserGroup]

  /**
   * Whether or not the parent package depends on uiInfrastructure
   */
  uiInfraDependent: boolean

  /**
   * An action to set the uiInfraDependent boolean.
   *
   * @returns a `SET_UI_INFRA_DEPENDENT` action
   */
  @uiSdlActionCreator(actionType='SET_UI_INFRA_DEPENDENT')
  setUiInfraDependentAction: function(uiInfraDependent: boolean): !UiSdlReduxAction ts-client

  /**
   * Sets the `uiInfraDependent` variable in state
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='SET_UI_INFRA_DEPENDENT')
  uiInfraDependentSetReducer: private inline function(state: !UiSdlReduxState,
                                                      action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * An action to store the `selectedUserGroup`.
   *
   * @returns a `SET_SELECTED_USER_GROUP` action
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_USER_GROUP')
  setSelectedUserGroupAction: function(selectedUserGroup: UserGroup): !UiSdlReduxAction ts-client

  /**
   * Sets the `selectedUserGroup`
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='SET_SELECTED_USER_GROUP')
  selectedUserGroupSetReducer: private inline function(state: !UiSdlReduxState,
                                                       action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * An action to store the selected user group state.
   *
   * @returns a `SET_SELECTED_GROUP_STATE` action
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_GROUP_STATE')
  setSelectedUserGroupStateAction: function(selectedGroupState: string): !UiSdlReduxAction ts-client

  /**
   * Sets the `selectedUserGroupState`
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='SET_SELECTED_GROUP_STATE')
  selectedUserGroupStateSetReducer: private inline function(state: !UiSdlReduxState,
                                                            action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * An action to store the user groups.
   *
   * @returns a `SET_USER_GROUPS` action
   */
  @uiSdlActionCreator(actionType='SET_USER_GROUPS')
  setUserGroupsAction: function(userGroups: [UserGroup]): !UiSdlReduxAction ts-client

  /**
   * Returns the active user groups
   */
  getUserGroups: function(state: !UiSdlReduxState): [UserGroup] ts-client

  /**
   * An action to fetch the user groups.
   *
   * @param spec
   *          The {@link FetchSpec} to apply on the {@link UserGroup}s.
   * @returns a `FETCH_USER_GROUPS` action
   */
  @uiSdlActionCreator(actionType='FETCH_USER_GROUPS')
  fetchUserGroupsAction: function(spec: FetchSpec): !UiSdlReduxAction ts-client

  /**
   * Sets the `userGroups`.
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='SET_USER_GROUPS')
  userGroupsSetReducer: private inline function(state: !UiSdlReduxState,
                                                action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Fetches and sets the `userGroups` in the application state.
   */
  @uiSdlEpic(actionType='FETCH_USER_GROUPS')
  userGroupsFetchEpic: private function(actionStream: !UiSdlActionsObservable,
                                        stateStream: !UiSdlStatesObservable): !UiSdlActionsObservable ts-client

  /**
   * An action to set the {@link #application}
   *
   * @returns a `SET_APPLICATION` action
   */
  @uiSdlActionCreator(actionType='SET_APPLICATION')
  setApplicationAction: function(application: string): !UiSdlReduxAction ts-client

  /**
   * An action to fetch the {@link App#inst}.
   *
   * @returns a `FETCH_APPLICATION` action
   */
  @uiSdlActionCreator(actionType='FETCH_APPLICATION')
  fetchApplicationAction: function(): !UiSdlReduxAction ts-client

  /**
   * Sets the {@link #application}.
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='SET_APPLICATION')
  applicationSetReducer: private inline function(state: !UiSdlReduxState,
                                                 action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Fetches and sets the {@link #application} in the application state.
   */
  @uiSdlEpic(actionType='FETCH_APPLICATION')
  applicationFetchEpic: private function(actionStream: !UiSdlActionsObservable,
                                         stateStream: !UiSdlStatesObservable): !UiSdlActionsObservable ts-client

  /**
   * Returns the selected {@link UserGroup}
   */
  getSelectedUserGroup: private function(state: !UiSdlReduxState): UserGroup ts-client

  /**
   * Returns the current {@link #application}
   */
  getApplication: function(state: !UiSdlReduxState): App ts-client

  /**
   * The Users grids are versioned, depending on application version - return the current user grid
   */
  currentUsersGrid: function(state: !UiSdlReduxState,
                             gridContext: string enum('all-users', 'usergroup-users')): string ts-client

  /**
   * An action to store the `selectedUser`.
   *
   * @returns a `SET_SELECTED_USER` action
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_USER')
  setSelectedUserAction: function(selectedUser: User): !UiSdlReduxAction ts-client

  /**
   * Sets the `selectedUser`. `action` can either have the {@link User} as `action.payload.selectedUser` or `action.payload.obj`.
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='SET_SELECTED_USER')
  setSelectedUserReducer: private inline function(state: !UiSdlReduxState,
                                                  action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * An action to notify that SOMETHING about Users has changed.
   *
   * @returns a `USERS_CHANGED` action
   */
  @uiSdlActionCreator(actionType='USERS_CHANGED')
  usersChangedAction: function(): !UiSdlReduxAction ts-client

  /**
   * Dispatches actions to make sure the UI is reflecting the latest data when {@link User}s change.
   */
  @uiSdlEpic(actionType='USERS_CHANGED')
  usersChangedEpic: private function(actionStream: !UiSdlActionsObservable,
                                     stateStream: !UiSdlStatesObservable): !UiSdlActionsObservable ts-client

  /**
   * Clear the entire app state
   */
  @uiSdlActionCreator(actionType='CLEAR_APP_STATE')
  clearAppStateAction: private function(): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `CLEAR_APP_STATE` and clears the state.
   */
  @uiSdlReducer(actionType='CLEAR_APP_STATE')
  clearAppStateReducer: private function(state: !UiSdlReduxState): !UiSdlReduxState ts-client
}
