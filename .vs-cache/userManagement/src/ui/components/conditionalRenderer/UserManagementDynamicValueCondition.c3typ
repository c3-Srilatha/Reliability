/**
 * Implements UiSdlRenderCondition for component rendering based on an redux state value.
 *
 * It will render the thenComponent when the value of the evaluated `param`
 * is the `expectedValue` otherwise, the elseComponent will be rendered.
 *
 * Example:
 * {
 *   "type": "UiSdlConditionalRenderer",
 *   "condition": {
 *     "type": "UiSdlDynamicValueSpecParamCondition",
 *     "param": {
 *        "type": "UiSdlApplicationStateValueParam",
 *        "id": "UserManagement.ApplicationState",
 *        "path": "selectedUserGroupState",
 *     },
 *     "expectedValue": "Mapped"
 *   },
 *   "thenComponent": {
 *     "id": "UserManagement.Mapped"
 *   }
 *   "elseComponent": {
 *      "id": "UserManagement.Mapping"
 *   },
 * }
 */
@typeScript
type UserManagementDynamicValueCondition mixes UiSdlRenderCondition, UiSdlRenderSwitchCondition {
  /**
   * The UiSdlDynamicValueSpecParam that contains the value to extract
   */
  param: UiSdlDynamicValueSpecParam

  /**
   * The expected value of the state. Applicable when used as a {@link UiSdlRenderCondition}
   */
  expectedValue: any

  useCondition: ~

  useSwitchCondition: ~

}
