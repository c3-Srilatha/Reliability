/**
 * An implementation of {@link UiSdlDataGridCell} which renders a custom cell of a collection, optionally
 * can make each element a link that dispatch Redux actions.
 */
@typeScript
type CollectionCell mixes UiSdlDataGridCell {

  /**
   * The field in the dataItem to use for getting the data for the collection to display.
   */
  collectionsField: string

  /**
   * Whether each item should be rendered as a link
   */
  asLinks: boolean

  /**
   * The field to use for displaying the text of each element.
   */
  displayField: string
}
