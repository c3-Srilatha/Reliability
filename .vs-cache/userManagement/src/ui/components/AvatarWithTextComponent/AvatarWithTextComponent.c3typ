/**
 * A clickable component that supports avatar, title and subtitle
 */
@typeScript
type AvatarWithTextComponent mixes UiSdlComponent<any> {

  /**
   * The displayed title content of the button
   */
  titleContent: UiSdlDynamicValueSpec

  /**
   * The displayed subtitle content of the button
   */
  subtitleContent: [UiSdlDynamicValueSpec]

  /**
   * Props for the prepended avatar
   */
  prependedAvatar: json

  /**
   * Props for the prepended avatar
   */
  isClickable: boolean

  /**
   * Arguments for the click action
   */
  actionArgs: json

  /**
   * Triggered when the component is clicked.
   *
   * @param id
   *            Id of the component.
   * @returns A `CLICK_ACTION` action for this instance.
   */
  @uiSdlActionCreator(actionType='CLICK_ACTION')
  clickAction: private function(id: string, args: json): !UiSdlReduxAction ts-client
}
