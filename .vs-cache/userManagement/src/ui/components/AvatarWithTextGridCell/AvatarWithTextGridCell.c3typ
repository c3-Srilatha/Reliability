/**
 * Custom cell to display {@link AvatarWithTextComponent}
 */
@typeScript
type AvatarWithTextGridCell mixes UiSdlDataGridCell {

  /**
   * The displayed title content of the button
   */
  titleContent: UiSdlFieldBasedDataSpecSetting

  /**
   * Map of field value to display title text. If undefined, display text will default to field value.
   * {@link UiSdlDynamicValueSpec} only works with {@link UiSdlFieldBasedDataSpecSetting}
   */
  titleContentMap: map<string, UiSdlDynamicValueSpec>

  /**
   * Settings for avatar to be prepended to the content
   */
  prependedAvatar: GridCellAvatarSetting

  /**
   * The displayed subtitle content of the button
   */
  subtitleContent: UiSdlFieldBasedDataSpecSetting

  /**
   * Map of field value to display subtitle text. If undefined, display text will default to field value.
   * {@link UiSdlDynamicValueSpec} only works with {@link UiSdlFieldBasedDataSpecSetting}
   */
  subtitleContentMap: map<string, UiSdlDynamicValueSpec>

  /**
   * Can be click if its a link
   */
  isClickable: boolean
}
