/**
 * Entity type `CustomizedTestStateMachineHistory` represents the history of a state machine for a customized
 * process. It tracks the state transitions and includes additional fields for storing relevant information.
 */
entity type CustomizedTestStateMachineHistory mixes StateMachineHistory<CustomizedTestStateMachine, CustomizedTestStateMachineState, CustomizedTestStateMachineTransition> schema name 'CTST_MCHN_HSTRY' {

  /**
   * `fieldA`: A `string` field used to store additional information related to the state machine's history.
   */
  fieldA: string

  /**
   * `fieldB`: A `string` field used to store another piece of information or identifier for the state machine's history.
   */
  fieldB: string
}
