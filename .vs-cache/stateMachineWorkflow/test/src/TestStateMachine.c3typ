/**
 * Entity type `TestStateMachine` represents a state machine schema that includes fields for tracking the
 * state of a system. This schema is used to manage and evaluate the state transitions of a process, 
 * such as work orders, and includes metrics on work order status.
 */
entity type TestStateMachine mixes StateMachine<TestStateMachineHistory, TestStateMachineState, TestStateMachineTransition> schema name 'TST_ST_MCHN' {

  /**
   * `fieldA`: A `string` field that holds general information or identifier for the state machine.
   */
  fieldA: string

  /**
   * `fieldB`: A `string` field that holds additional information related to the state machine.
   */
  fieldB: string

  /**
   * `numWorkOrdersOpen`: A calculated `int` field that stores the count of work orders that are currently
   * in the 'open' status. It uses a calculation based on the status of work orders.
   */
  numWorkOrdersOpen: int stored calc count(workOrders.(status == 'open').status)

  /**
   * `workOrders`: A relationship field that holds a list of `WorkOrderPerfTest` entities related to this
   * state machine instance. This field tracks the associated work orders and their performance data.
   */
  workOrders: [WorkOrderPerfTest](parent)
}
