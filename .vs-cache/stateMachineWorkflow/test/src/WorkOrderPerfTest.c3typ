/**
 * Entity type `WorkOrderPerfTest` represents a work order performance test schema used to track the status
 * of work orders within a given state machine. The entity includes fields for the work order status 
 * and its parent state machine.
 */
@db(datastore='kv', partitionKeyField='parent', persistDuplicates=true)
entity type WorkOrderPerfTest schema name 'WRKRDR_PRF_TST' {

  /**
   * `status`: A required `string` field that indicates the current status of the work order. It can either
   * be 'open' or 'closed'.
   */
  status: !string enum('open', 'closed')

  /**
   * `parent`: A required reference to the `TestStateMachine` entity that acts as the parent of this work order.
   * It establishes the relationship between the work order and the state machine that controls its state.
   */
  parent: !TestStateMachine
}
