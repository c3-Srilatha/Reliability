/**
 * Entity type `CustomizedTestStateMachineState` represents a state within a customized state machine.
 * It defines the different states that a state machine can be in and the transitions between those states.
 */
entity type CustomizedTestStateMachineState mixes StateMachineState<CustomizedTestStateMachineState, CustomizedTestStateMachineTransition> schema name 'CTST_MCHN_ST'
