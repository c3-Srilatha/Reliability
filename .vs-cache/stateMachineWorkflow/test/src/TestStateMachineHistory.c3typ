/**
 * Entity type `TestStateMachineHistory` represents the history of a state machine for testing
 */
entity type TestStateMachineHistory mixes StateMachineHistory<TestStateMachine, TestStateMachineState, TestStateMachineTransition> schema name 'ST_MCHN_HSTRY'
