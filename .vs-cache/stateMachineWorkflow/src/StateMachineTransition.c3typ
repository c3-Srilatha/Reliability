/**
 * Type to represent a transition between two {@link StateMachineState}s.
 */
@seed(userUpdatable=true, userRemovable=true, userCreatable=true)
@db(unique=['from, to, condition'], index+=['from, isValid', 'to, isValid'])
@constraint(condition='!exists(trigger) || (trigger.triggerKind == "AUTOMATIC" && exists(condition)) || (trigger.triggerKind == "PERIODIC" && exists(trigger.periodicity))',
            message='Must provide condition for automatic trigger or periodicity for periodic trigger')
@cache(all=true)
type StateMachineTransition<S: StateMachineState, T: StateMachineTransition> mixes SeedData, AclEnabled {

  /**
   * The {@link StateMachineState} to transition from.
   */
  from: !S

  /**
   * The {@link StateMachineState} to transition to.
   */
  to: !S

  /**
   * Used to soft delete a record so all state histories still have valid pointers.
   */
  deleted: boolean

  /**
   * A transition is only valid if the {@link from}, {@link to}, and itself are not deleted.
   */
  isValid: boolean stored calc deleted == false && exists(from.name) && from.deleted == false && exists(to.name) && to.deleted == false

  /**
   * The trigger that must be satisfied in order for this transition to take place.
   */
  trigger: TransitionTrigger schema suffix 't'

  /**
   * An expression that will be evaluated on the state machine.
   * If defined, the transition can only be invoked when the condition is evaluated to true
   * If not defined, the transition can be invoked at anytime.
   */
  condition: string

  /**
   * Used to include fields on the source type for exitAction and entryAction.
   */
  includeSpec: string

  /**
   * The action to be taken during this {@link StateMachineTransition}.
   */
  action: lambda(srcObj: any) schema suffix 'a'
}
