/**
 * Type to record the history of a {@link StateMachine}.
 */
@db(datastore='kv',
    partitionKeyField='parent',
    persistenceOrder='descending(stateOrderCounter)',
    unique=['parent, stateOrderCounter'])
type StateMachineHistory<P, S: StateMachineState, T: StateMachineTransition> mixes TimedValueHistory<P> {

  /**
   * Parent/owning obj instance.
   */
  parent: !~

  /**
   * All transition are disabled when `error` is true.
   */
  error: boolean

  /**
   * A field for populating an error message if an error occurs.
   */
  errorMessage: string

  /**
   * Will be incremented every time state changes. This is to be able to differentiate state history if more than 1 automatic transition occurs in a second.
   * Note: DateTime milliseconds are not persisted.
   */
  stateOrderCounter: !int

  /**
   * The state of this step in the {@link StateMachineHistory}.
   */
  state: !S

  /**
   * If null, the new state is set through automatic transition.
   */
  updatedBy: User

  /**
   * If null, the new state is set without evaluating any transition conditions.
   */
  transition: T
}
