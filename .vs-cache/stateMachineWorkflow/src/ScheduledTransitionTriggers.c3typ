/**
 * In job, trigger all transitions where trigger.peridocity == the inputed periodicity.
 *
 * Will limit the resources given to the job so it doesn’t use all of the resources of the c3server.
 * Will achieve that by setting `maxConcurrency`  and `maxConcurrencyPerNode` to small numbers on a job.
 * The exact config can be specified by the customer based on use case.
 */
entity type ScheduledTransitionTriggers extends BatchJob<ScheduledTransitionTriggers, ScheduledTransitionsBatchJobOptions, ScheduledTransitionsBatchJobBatch> mixes Value type key 'STTBJ' {

  /**
   * Starts the batch job with the given options.
   *
   * @param options The options to configure the batch job.
   * @return The started ScheduledTransitionTriggers job instance.
   */
  startJob: function(options: !ScheduledTransitionsBatchJobOptions): !ScheduledTransitionTriggers js-server

  /**
   * @inheritdoc
   */
  doStart:      ~ js-server

  /**
   * @inheritdoc
   */
  processBatch: ~ js-server
}
