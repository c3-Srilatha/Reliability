/**
 * Enum for the different kinds of errors that can occur during a state machine transition.
 */
enum type StateMachineTransitionError {

  /**
   * The transition failed due to an error when executing the {@link StateMachineTransition#action}.
   */
  ACTION_ERROR

  /**
   * The transition failed due to an error due to one of the following issues with the {@link StateMachine}'s state:
   * - The {@link StateMachine} to transition does not exist.
   * - The {@link StateMachineTransition} failed previously and requires manual intervention.
   */
  STATE_MACHINE_ERROR

  /**
   * The transition failed due to a synchronization error. This occurs when trying to transition when another transition
   * is already in progress.
   */
  SYNCHRONIZATION_ERROR

  /**
   * The transition failed due to an error because any of the following conditions weren't satisfied:
   * - There a no valid transitions for the entity from the current state.
   * - The {@link StateMachineTransition#condition} wasn't satisfied.
   */
  TRANSITION_ERROR
}
