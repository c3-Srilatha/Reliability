/**
 * Type to represent a batch of scheduled transitions.
 */
type ScheduledTransitionsBatchJobBatch {

  /**
   * The Type for which to trigger state transitions.
   */
  typeRef: !Type

  /**
   * The state machine IDs to trigger transitions for.
   */
  stateMachineIdsToCurrentStateIds: map<string, string>
}
