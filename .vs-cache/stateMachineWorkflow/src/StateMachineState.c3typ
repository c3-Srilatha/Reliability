/**
 * Type to represent a state in a state machine.
 */
@seed(userUpdatable=true, userRemovable=true, userCreatable=true)
@cache(all=true)
type StateMachineState<S: StateMachineState, T: StateMachineTransition> mixes SeedData {

  /**
   * The name of this {@link StateMachineState}.
   */
  name: string

  /**
   * The translated display name of this {@link StateMachineState}.
   * Format to use: `data.{typeName}.{state id}.displayName` as translation key.
   */
  displayName: string translate by id

  /**
   * Whether or not this is the original {@link StateMachineState} in a {@link StateMachine}.
   * A {@link StateMachine} can have one and only one initial state.
   */
  initialState: boolean

  /**
   * Used to soft delete a record so all state histories still have valid pointers.
   */
  deleted: boolean

  /**
   * Used to include fields on the source type for exitAction and entryAction.
   */
  includeSpec: string

  /**
   * Action to be triggered when leaving this state.
   */
  exitAction: lambda(srcObj: any) schema suffix 'x'

  /**
   * Action to be triggered when entering this state.
   */
  entryAction: lambda(srcObj: any) schema suffix 'n'

  /**
   * The list of automatic transitions from this state to another that are {@link StateMachineTransition#isValid}.
   */
  @db(filter='isValid == true && trigger.triggerKind == "AUTOMATIC"')
  autoTransitions: [T](from)

  /**
   * Whether this state has automatic transitions.
   */
  hasAutoTransition: boolean stored calc exists(autoTransitions)

  /**
   * The list of periodic transitions from this state to another that are {@link StateMachineTransition#isValid}.
   */
  @db(filter='isValid == true && trigger.triggerKind == "PERIODIC"')
  periodicTransitions: [T](from)

  /**
   * Whether this state has periodic transitions.
   */
  hasPeriodicTransitions: boolean stored calc exists(periodicTransitions)

  /**
   * {@link StateMachineTransition}s that originate from this {@link StateMachineState}.
   */
  @db(filter='isValid == true')
  fromTransitions: [T](from)

  /**
   * {@link StateMachineTransition}s that lead into this {@link StateMachineState}.
   */
  @db(filter='isValid == true')
  toTransitions: [T](to)
}
