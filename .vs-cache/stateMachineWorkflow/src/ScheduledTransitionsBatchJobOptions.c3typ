/**
 * Options for a batch job that triggers scheduled transitions.
 */
type ScheduledTransitionsBatchJobOptions mixes BatchJobOptions, Spec {

  /**
   * The periodicity with which to trigger transitions.
   */
  periodicity: !string enum TransitionPeriodicity

  /**
   * The batch size to use when triggering transitions.
   */
  batchSize: int = 100
}
