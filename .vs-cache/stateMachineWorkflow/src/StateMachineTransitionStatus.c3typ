/**
 * Type to represent the status of a state machine transition.
 */
type StateMachineTransitionStatus<SMH: StateMachineHistory, SMT: StateMachineTransition> {

  /**
   * The {@link StateMachineHistory} instance created to record the state transition.
   */
  stateHistory: SMH

  /**
   * The transition taken or available.
   */
  transition: SMT

  /**
   * The error message if the transition failed.
   */
  errorMessage: string

  /**
   * The error code if the transition failed.
   */
  errorCode: string enum StateMachineTransitionError
}
