/**
 * Type to get the template for the code editor.
 */
type CodeEditorTemplate {

  /**
   * Get the template content for the code editor.
   * @param pkgPath The {@link Pkg.Path} of the template to get.
   * @return The template as a string.
   */
  getTemplateContent: function(pkgPath: !string serialized Pkg.Path): string js-server

  /**
   * Get the list of available templates for the code editor.
   * @return The list of template names as an array of strings.
   */
  getTemplateList: function(): [json] js-server

  /**
   * Sanitizes the template for the code editor by removing the copy-right header and the codeEditorTemplate annotation from the template.
   * @param content The template code as a string
   * @return the sanitized code template
   */
  sanitizeTemplateContent: private function(content: !string): !string js-server
}
