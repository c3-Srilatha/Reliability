/**
 * Ties a start and end timestamp to the relationship between 2 entities.
 */
@codeEditorTemplate(name="Timed Interval Relation",
                    description="A relation between two entities with a start and end timestamp.",
                    displayIcon="clock")
entity type SampleTimedInterval<F, T> mixes TimedIntervalValue {

  /**
   * The from side of the relation.
   */
  from: F

  /**
   * The to side of the relation.
   */
  to: T
}
