@codeEditorTemplate(name="Simple Calc", description="Entity with simple calc fields", displayIcon="calculator")
entity type SampleCalc {

  intField:      int
  intField2:     int
  doubleField:   double
  arry:          [int] schema name 'AR'
  calcInt:       int stored calc intField
  calcArry:      [int] schema name 'CALCA' stored calc arry
  calcInt2:      int stored calc intField + intField2
  calcInt3:      int stored calc exists(intField) ? intField : parent.calcInt2
  calcIntNested: int stored calc calcInt
}
