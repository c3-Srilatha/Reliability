@codeEditorTemplate(name="Simple Timeseries consisting of IntervalDataPoints",
                    description="Entity with a timeseries consisting of IntervalDataPoints.",
                    displayIcon="chart-bar")
entity type SampleIntervalDataPoint mixes IntervalDataPoint<SampleCollectionTimeSeries> schema name 'SMRT_BLB_MSRMNT' {

  /**
   * The measured number of lumens.
   */
  @ts(treatment='rate')
  lumens: double

  /**
   * The measured power consumption.
   */
  @ts(treatment='rate')
  power: double

  /**
   * The measured temperature.
   */
  @ts(treatment='rate')
  temperature: double

  /**
   * The measured voltage.
   */
  @ts(treatment='rate')
  voltage: double

  /**
   * The status of the smart bulb (on or off).
   */
  @ts(treatment='previous')
  status: int
}
