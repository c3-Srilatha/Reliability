/**
 * A type to represent a timeseries which may be partitioned across multiple timeseries headers.
 * Evaluating a timeseries should be done with the provided Quantity compound metric, which will
 * perform inter-partition interpolation to ensure correctness and simulate evaluation as if all
 * measurements were under the same header.
 *
 * Partitioning across multiple timeseries headers is recommended for timeseries of very high volume,
 * e.g. minute-level data for more than six months, or hour-level data for several years.
 */
@codeEditorTemplate(name="Sample Time Series Complex Partitioning",
                    description="Entity with a timeseries consisting of complex partitioning.",
                    displayIcon="chart-line")
entity type SampleTimeSeriesComplexPartitioning mixes FeatureEvaluatable type key 'SENSOR' {

  /**
   * Additional display name for the sensor. This is the secondary name used to display this sensor in the UI.
   */
  name: string

  /**
   * The type of data series that describes a measurement value on an asset.
   * In a typical deployment, the types of sensors include, but are not limited to,
   * TAGs, LMIs, VSLs, etc.
   */
  sensorType: string

  /**
   * Reference to a data series describing a measurement value on an asset
   * (e.g., pressure, temperature, flow rate, setpoint, process value);
   * usually an alphanumeric identifier "61PI0207"
   * This is the primary name field used to display this sensor in the UI. Ideally matches the id.
   */
  tag: string

  /**
   * Description of the sensor.
   */
  description: string

  /**
   * Tag creation datetime.
   */
  creationDate: datetime

  /**
   * Sampling rate for measurements (in seconds).
   */
  samplingRate: decimal

  /**
   * Expected compression deviation (value between 0 to 1).
   */
  compressionDeviation: decimal

  /**
   * Maximum compression for Pi data (in number of seconds).
   */
  compressionMax: decimal

  /**
   * Name of the reference diagram.
   */
  referenceDiagram: string

  /**
   * Name of the instrument.
   */
  instrumentName: string

  /**
   * The transmitting status of the sensor.
   */
  status: string enum('Transmitting', 'NotTransmitting')

  /**
   * Unit for the series
   */
  unitConstraint: Unit calc series[0].unitConstraint
}
