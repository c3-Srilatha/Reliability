/**
 * A smart bulb entity that can be used to derive features for machine learning.
 */
@codeEditorTemplate(name="Entity with Feature Evaluatable",
                    description="An entity that can be used to derive features for machine learning.",
                    displayIcon="microchip")
entity type SampleFeatureEvaluatable mixes FeatureEvaluatable {

  /**
   * The unique identifier for the smart bulb.
   */
  id: string

  /**
   * The type of bulb.
   */
  bulbType: string

  /**
   * The manufacturer of the bulb.
   */
  manufacturer: string

  /**
   * The power consumption of the bulb.
   */
  power: double

  /**
   * The expected lifetime of the bulb.
   */
  lifetime: double

  /**
   * The latitude of the bulb location.
   */
  latitude: double

  /**
   * The longitude of the bulb location.
   */
  longitude: double

  /**
   * The voltage of the bulb.
   */
  voltage: double

  /**
   * The temperature of the bulb.
   */
  temperature: double

  /**
   * A function that returns the average temperature of the bulb.
   *
   * @param timestamp The timestamp to calculate the average temperature.
   * @return The average temperature of the bulb.
   */
  getAverageTemperature: function(timestamp: datetime): double js-server
}
