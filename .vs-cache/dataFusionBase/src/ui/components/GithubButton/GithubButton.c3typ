/**
 * Custom component for github button in data fusion
 */
@typeScript
type GithubButton mixes UiSdlComponent<UiSdlNoData> {

  /**
   * Stores the git connection status
   */
  gitConnectionStatus: boolean

  /**
   * Stores the configured git branch
   */
  gitBranch: Pkg.Store.Git.Branch

  /**
   * List of files changed
   */
  fileChangeList: [Git.FileChange]

  /**
   * The commits to display in this component
   */
  commitList: [Git.CommitInfo]

  /**
   * List of files changed
   */
  fileChangesApiCallStatus: boolean

  /**
   * Action triggers for the options in github dropdown menu
   */
  @uiSdlActionCreator(actionType='${actionSuffix}')
  actionsOnCurrentVersion: private function(id: string): !UiSdlReduxAction ts-client

  /**
   * Action trigger to fetch the configured branch info and file changes list
   */
  @uiSdlActionCreator(actionType='FETCH_CONFIGURED_BRANCH')
  fetchConfiguredBranch: private function(id: string): !UiSdlReduxAction ts-client

  /**
   * Opens the discard current changes modal
   */
  @uiSdlActionCreator(actionType='DISCARD_CURRENT_CHANGES')
  discardCurrentChanges: function(id: string): !UiSdlReduxAction ts-client
}
