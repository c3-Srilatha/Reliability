/**
 * The information card fields with fields required for informationCard display/identification
 */
type InformationCardFields {

  /**
   * A unique identifier for the information card. This will be passed when a card is clicked.
   */
  id: string

  /**
   * Path to image used by UI element. Takes precedence over {@link iconName}.
   */
  image: string

  /**
   * An alternative to {@link image}.
   */
  iconName: string

  /**
   * Title of the information card
   */
  title: string | UiSdlDynamicValueSpec

  /**
   * Subtitle of the information card
   */
  subtitle: string | UiSdlDynamicValueSpec

  /**
   * Description of the information card
   */
  description: string | UiSdlDynamicValueSpec
}
