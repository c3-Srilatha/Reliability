/**
 * The information card group monitoring each information card component
 */
@typeScript
type InformationCardGroup mixes UiSdlComponent<UiSdlNoData>, UiSdlComponentTitle {

  /**
   * The information card objects to render in the group
   */
  informationCardItems: [InformationCard]

  /**
   * Triggered when the InformationCard is clicked.
   *
   * @param id
   *            Id of the component.
   * @param selectedCardId
   *            The title that was clicked.
   * @returns A `INFORMATION_CARD_CLICK` action for this instance.
   */
  @uiSdlActionCreator(actionType='INFORMATION_CARD_CLICK')
  clickInformationCardAction: private function(id: string, selectedCardId: string): !UiSdlButtonClickAction ts-client

  // -------------- GET SELECTED INFORMATION CARD TITLE --------------

  /**
   * Stores the title selected in the information card
   */
  selectedCardId: string

  /**
   * Creates an action to update the title that is selected
   *
   * @param componentId
   *            Id of the component.
   * @param selectedCardId
   *            The title that was selected.
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_CARD_ID')
  setSelectedCardIdAction: private function(componentId: string, selectedCardId: string): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SELECTED_CARD_ID` and sets selected title in the state.
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='SET_SELECTED_CARD_ID')
  setSelectedCardIdReducer: private function(state: !UiSdlReduxState,
                                             action: !UiSdlReduxAction): !UiSdlReduxState ts-client
}
