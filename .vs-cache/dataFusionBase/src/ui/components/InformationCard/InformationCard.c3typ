/**
 * The information card component containing image, title and subtitle
 */
@typeScript
type InformationCard mixes InformationCardFields, UiSdlComponent<UiSdlNoData> {
  
  /**
   * An onClick action to be performed when the information card is clicked. Passed down as a prop from a parent
   * component.
   */
  clickInformationCardAction: lambda(id: string)

  /**
   * An onClick action to be performed when the information card is clicked. Passed down as a prop from a parent
   * component. Does not need to be passed in.
   */
  setSelectedInformationCardAction: lambda(selectedInformationCard: InformationCard)
}
