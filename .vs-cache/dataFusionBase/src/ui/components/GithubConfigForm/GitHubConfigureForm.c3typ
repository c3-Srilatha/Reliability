/**
 * Custom github form that wraps github form of studioComponentLibrary
 */
@typeScript
type GitHubConfigureForm mixes UiSdlComponent<UiSdlNoData> {

  /**
   * Stores the environment Id of the current app
   */
  envId: string

  /**
   * Boolean to check whether a reconfiguration is being made in a running app
   */
  reConfigureInRunningApp: boolean

  /**
   * Action to set form field values of github configure form
   */
  @uiSdlActionCreator(actionType='SET_GIT_FORM_FIELD_VALUES')
  setGitFormFieldValues: private function(githubFormFieldValues: json): !UiSdlReduxAction ts-client

  /**
   * Action to set form field values of github configure form
   */
  @uiSdlActionCreator(actionType='GIT_CONFIGURE_MODAL_BUTTONS_(ENABLE|DISABLE)')
  disableEnableConfigureModalButtons: private function(isValid: boolean): !UiSdlReduxAction ts-client
}
