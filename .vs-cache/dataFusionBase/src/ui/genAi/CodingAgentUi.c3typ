/**
 * An Interface for interacting with {@link AiAssistant#askV2} T2 option.
 */
type CodingAgentUi mixes ChatAgentUi, Configurable<CodingAgentUi.Config> {

  name:            ~ = "coding"
  icon:            ~ = "infinity"
  loadingMessages: ~ = "DataFusionBase.GenAiAgent.LoadingMessage.CodingAgent.1\nDataFusionBase.GenAiAgent.LoadingMessage.CodingAgent.2\nDataFusionBase.GenAiAgent.LoadingMessage.CodingAgent.3\nDataFusionBase.GenAiAgent.LoadingMessage.CodingAgent.4\nDataFusionBase.GenAiAgent.LoadingMessage.CodingAgent.5\nDataFusionBase.GenAiAgent.LoadingMessage.CodingAgent.6"
  enabled:         ~
  ask:             ~
}
