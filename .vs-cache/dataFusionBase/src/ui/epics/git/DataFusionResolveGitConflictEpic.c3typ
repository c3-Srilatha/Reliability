/**
 * Handles selected conflict resolution option (local/remote/manual)
 */
@typeScript
type DataFusionResolveGitConflictEpic mixes UiSdlEpic {

  /**
   * Action creator to pull the changes from remote
   */
  @uiSdlActionCreator(actionType='PULL_CHANGES')
  triggerPullChanges: function(resetStatus: boolean,
                               primaryMessage: string,
                               secondaryMessage: string): !UiSdlReduxAction ts-client

  /**
   * Action creator to publish changes to github
   */
  @uiSdlActionCreator(actionType='PUBLISH_CHANGES')
  triggerPublishChanges: function(forceStatus: boolean,
                                  commitMessage: string,
                                  onConflictCreatePrStatus: boolean,
                                  primaryMessage: string,
                                  secondaryMessage: string): !UiSdlReduxAction ts-client

  epic: ~ ts-client
}
