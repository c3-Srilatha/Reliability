/**
 * Epic to fetch the configured branch for git publish flow
 */
@typeScript
type FetchConfiguredBranchEpic mixes UiSdlEpic {

  /**
   * Action creator to trigger file change list api call
   */
  @uiSdlActionCreator(actionType='FETCH_FILE_CHANGE_LIST')
  fetchFileChanges: private function(id: string): !UiSdlReduxAction ts-client

  epic: ~ ts-client
}
