/**
 * Epic to fetch git file changes.
 */
@typeScript
type FetchGitFileChangesEpic mixes UiSdlEpic {

  /**
   * Action creator to trigger api call that fetches git instance
   */
  @uiSdlActionCreator(actionType='FETCH_GIT_INSTANCE')
  fetchGitInstance: private function(id: string): !UiSdlReduxAction ts-client

  epic: ~ ts-client
}
