/**
 * Options to select when resolving conflicts in git publish flow.
 */
@typeScript
type DataFusionGitConflictRadioButtonOptions {

  /**
   * Option when user opts to overwrite remote with local changes(force push)
   */
  LOCAL: string = 'local'

  /**
   * Option when user opts to overwrite local with remote(github repo) changes
   */
  REMOTE: string = 'remote'

  /**
   * Option when user resolve conflicts manual
   */
  MANUAL: string = 'manual'
}
