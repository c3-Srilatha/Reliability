/**
 * Epic to validate the commit message in publishing changes to github
 */
@typeScript
type ValidatePublishChangesFormEpic mixes UiSdlEpic {

  /**
   * Action creator for publishing changes to github
   */
  @uiSdlActionCreator(actionType='VALIDATE_PUBLISH_CHANGES_FORM')
  validatePublishChangesFormAction: function(modalId: string,
                                             bannerId: string,
                                             formId: string,
                                             commitMessage: string): !UiSdlReduxAction ts-client

  epic: ~ ts-client
}
