/**
 * Param to allow access to {@link UiMetadataConfiguration} available insance(s)
 * as properties of {@link UiSdlComponent}.
 */
type UiMetadataConfigurationParam mixes UiSdlDynamicValueSpecParam {

  /**
   * The key to extract from the uiMetadataConfiguration map
   */
  configurationKey: !string

  /**
   * The name of a specific instance to extract
   */
  instanceName: string

  /**
   * Extracts the parameter value. When only a configurationKey is provided,
   * returns [{@link UiMetadataConfiguration}].
   * Otherwise, returns an instance of {@link UiMetadataConfiguration} dependent on the provided instanceName
   */
  extract: ~
}
