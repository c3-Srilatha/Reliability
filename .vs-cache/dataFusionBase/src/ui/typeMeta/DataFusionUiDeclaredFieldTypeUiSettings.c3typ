/**
 * Holds the UI related settings for the {@link DeclaredFieldType}
 */
@typeScript
type DataFusionUiDeclaredFieldTypeUiSettings {

  id: string

  /**
   * Whether we have an invalid alias name
   */
  invalidAlias: boolean

  /**
   * If we have an invalid alias name, what is the hint text to show
   */
  aliasHintText: string

  /**
   * Whether we have an invalid description
   */
  invalidDescription: boolean

  /**
   * If we have an invalid description, what is the hint text to show
   */
  descriptionHintText: string

  /**
   * Whether a field type is selected. a local field type is selected by default, and a remote field type is unselected by default
   */
  selected: boolean

  /**
   * Whether this field should always be disabled. (e.g the column with id alias name)
   */
  alwaysDisable: boolean

  /**
   * Indicates whether the time format is invalid.
   * This field is set to true if the provided time format does not match any of the valid formats.
   */
  invalidTimeFormat: boolean

  /**
   * The format of the time.
   * This field stores the time format string, such as 'HH:mm:ss', e.t.c.
   */
  timeFormat: string

  /**
   * Hint text for the time format.
   * This field provides a hint or error message related to the time format, displayed to the user.
   */
  timeFormatHintText: string

  /**
   * Whether we have a schema mismatch on this field type
   */
  mismatch: SourceCollectionUiSchemaMismatchError
}
