/**
 * A perspective is a subsection of the complete selfService application.
 */
type SelfService.Perspective mixes Prioritized {

  /**
   * The componentId for the top-level component that represents this perspective
   */
  content: string

  /**
   * The icon associated with this Perspective
   */
  icon: string

  /**
   * The label/text associated with this Perspective
   */
  label: string | UiSdlDynamicValueSpec
}
