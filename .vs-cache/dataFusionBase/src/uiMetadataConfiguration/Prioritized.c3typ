/**
 * Type to expose priority as a mechanism for ordering. Types that mixin `Prioritized`
 * specify a natural ordering between Prioritized elements
 */
abstract type Prioritized mixes UiMetadataConfiguration {

  /**
   * The value associated with this prioritized instance.
   */
  priority: !int

  /**
   * Whether prioritized value should be omitted from the ordering
   */
  hidden: boolean = false

  fetchSpec: ~ js-server
}
