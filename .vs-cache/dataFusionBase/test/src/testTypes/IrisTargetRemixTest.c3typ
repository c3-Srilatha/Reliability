/**
 * Am entity type for integrating the Iris Species dataset. See `https://www.kaggle.com/datasets/uciml/iris/data` for more information
 */
entity type IrisTargetRemixTest schema name 'IRS_TGT' {

  /**
   * The length of the sepal of this iris flower.
   * The sepal is the outers of a flower that enclose a developing bud.
   */
  sepalLengthCm: !double

  /**
   * The width of the sepal of this iris flower.
   * The sepal is the outers of a flower that enclose a developing bud.
   */
  sepalWidthCm: !double

  /**
   * The length of the petal of this iris flower.
   */
  petalLengthCm: !double

  /**
   * The width of the petal of this iris flower.
   */
  petalWidthCm: !double

  /**
   * The sub-species of iris. Used for classification of the flower.
   */
  species: string enum('Iris-setosa', 'Iris-versicolor', 'Iris-virginica')
}
