/**
 * This type represents a data generator that generates batches of sequential windows of the input. Furthermore, this
 * data generator only extracts windows where all points in the window have the same time interval. This data generator
 * can be used by any model that accepts an iterable as input. The `x` argument to all the type's methods must be
 * a `pandas.DataFrame` object.
 */
type Reconstruction.WindowedDataGenerator {

  /**
   * Generate the indices of the input where a valid index is an index where a window of size `windowSize` that ends at
   * the index contains points that have the same time interval in between.
   */
  generateIndices: inline function(x: native, windowSize: int): native py-tf

  /**
   * Generate batches of windows where each window contains points that have the same time interval in between.
   */
  generateBatches: inline function(x: native, batchSize: int, windowSize: int): native py-tf

  /**
   * @return a native `tensorflow` data generator.
   */
  makeGenerator: inline function(x: native, batchSize: int, windowSize: int): native py-tf
}
