/**
 * This type represents a process-only {@link MlPipe} that concatenates a map of {@link Data} column-wise. The inputs
 * should all have the same number of rows and the same indices.
 */
entity type Reconstruction.ConcatenationPipe<DX> extends MlTemplate.AtomicPipe<DX, void, Data> type key 'RCDC'{
  /**
   * The expected keys of the input {@link Map<String, Data>}
   */
  inputNames: ![string]
  doProcess: ~ py

  generatePipe: ~ py
  generateTypeBindings: ~ py
}
