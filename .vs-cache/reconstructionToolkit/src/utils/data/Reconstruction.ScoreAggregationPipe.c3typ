/**
 * This type represents a process-only pipe that aggregates scores from an {@link MlScoringMetric} based on the
 * specified aggregation function.
 */
entity type Reconstruction.ScoreAggregationPipe<DX> extends MlTemplate.AtomicPipe<DX, void, double> type key 'RCSAP' {
  /**
   * The list of input score names. This is required in order to properly build an {@link MlPipeline} using this
   * pipe.
   */
  scoreNames: ![string]

  /**
   * The aggregation function to use to aggregate the scores.
   */
  aggFunc: string enum ("mean", "median", "max", "min") = "mean"

  doProcess: ~ py

  generatePipe: ~ py
  generateTypeBindings: ~ py
}
