/**
 * This type represents a process-only pipe that sets the {@link Feature.TIMESTAMP} and {@link Feature.SUBJECT}
 * columns of the input {@link Data} as indices.
 */
entity type Reconstruction.SetIndexPipe extends MlAtomicPipe<Data, void, Data> type key 'RCSIP'{
  doProcess: ~ py
}
