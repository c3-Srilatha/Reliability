/**
 * This type represents a process-only {@link MlPipe} that extracts a target column and feature columns from an input
 * {@link Data}.
 */
entity type Reconstruction.TargetExtractionPipe extends MlAtomicPipe<Data, void, {x: Data, y: Data}> type key 'RCDTE' {
  /**
   * The target column to extract
   */
  target: !string

  /**
   * The features to extract. If empty, this pipe will assume all other columns but the {@link #target} are features
   */
  features: [string]

  doProcess: ~ py
}
