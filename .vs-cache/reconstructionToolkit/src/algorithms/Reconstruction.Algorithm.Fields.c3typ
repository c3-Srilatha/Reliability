/**
 * This Type represents a base reconstruction algorithm by defining a set of fields that all reconstruction algorithm
 * Types should contain. This Type is intended to be mixed-in by developers of concrete reconstruction algorithms.
 */
type Reconstruction.Algorithm.Fields {

  /**
   * An optional suffix that is added to the column names of the reconstruction {@link Data}.
   */
  reconstructionSuffix: string = "_reconstruction"

  /**
   * An optional suffix that is added to the column names of the residual {@link Data}.
   */
  residualSuffix: string = "_residual"
}
