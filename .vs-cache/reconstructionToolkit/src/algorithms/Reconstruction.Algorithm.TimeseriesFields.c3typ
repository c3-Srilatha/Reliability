/**
 * This Type represents a reconstruction algorithm that operates solely on timeseries data. All concrete reconstruction
 * algorithms that model timeseries data should mixin this Type.
 */
type Reconstruction.Algorithm.TimeseriesFields {

  /**
   * A lookback duration for the current reconstruction algorithm that helps determine the time interval in which data
   * should be fetched.
   */
  lookbackDuration: private Duration
}
