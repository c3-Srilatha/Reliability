/**
 * This Type represents all reconstruction atomic pipes that use autoencoders as their base model. This base Type
 * defines a set of fields that all autoencoders require to create the model and perform training/inference.
 */
abstract extendable entity type Reconstruction.Algorithm.Autoencoder<DO> extends Reconstruction.Algorithm.Pipe<DO> type key 'RCAA'{

  /**
   * Training epochs
   */
  @ML(hyperparameter=true)
  epochs: !int = 10

  /**
   * Training batch size
   */
  @ML(hyperparameter=true)
  batchSize: !int = 128

  /**
   * Number of features
   */
  @ML(hyperparameter=true)
  numFeatures: !int = 5

  /**
   * Random seed used during model training. Use the same number for reproducible training results.
   */
  @ML(hyperparameter=true)
  randomSeed: int = 0

  /**
   * Learning rate used to override the learning rate specified in the `optimizer` during training.
   * Will use optimizer's learning rate if `learningRateOverride` is unspecified.
   */
  @ML(hyperparameter=true)
  learningRateOverride: float
}
