/**
 * This Type represents all autoencoders that model solely time-series data.
 */
abstract extendable entity type Reconstruction.Algorithm.TimeseriesAutoencoder<DO> extends Reconstruction.Algorithm.Autoencoder<DO>
                                                                                   mixes Reconstruction.Algorithm.TimeseriesFields
                                                                                   type key 'RCATA' {

  /**
   * A window length specifying how many time stamps to reconstruct at a time. The {@link Data} input will be batched
   * into consecutive, single-stride windows of size {@link #windowSize}, and the number of windows to be fed into the
   * model at a time is defined by {@link #batchSize}.
   */
  @ML(hyperparameter=true)
  windowSize: !int = 6
}
