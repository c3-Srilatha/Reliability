/**
 * This Type represents all pipes that compute a risk score based on a reconstruction model's output. All risk score
 * computation pipes should extend from this Type and output a single `Data` containing the risk scores.
 *
 * DEVELOPER NOTE: Developers may override {@link #succeed} to customize how a risk score pipe is appended to a central
 * pipe.
 */
abstract extendable entity type Reconstruction.Post.RiskScorePipe<DX> extends MlTemplate.AtomicPipe<DX, void, {riskScore: Data}> mixes Reconstruction.Post.Postprocessor type key 'RCPRS' {

  /**
   * The name of the column in the {@link Data} output. Default is "riskScore"
   */
  riskScoreColumnName: string

  generatePipe: ~ py

  /**
   * This method constructs a new {@link MlPipeline} that appends this risk score pipe to any {@link MlPipe} that has
   * `residuals` as an output. The returned pipeline will have a new output `riskScore`. See
   * {@link Reconstruction.Post.Postprocessor#suceed} for the list of accepted keyword arguments.
   *
   * It is recommended to use this method with a {@link Reconstruction.Algorithm.Pipe} or
   * {@link Reconstruction.Algorithm.Pipeline}. For example,
   * ```py
   * # Create a new Reconstruction.Algorithm
   * autoencoder = c3.Reconstruction.Algorithm.TransformerAutoencoder(name="trans_ae").withDefaults()
   *
   * # Create a new risk score pipe
   * risk_score_pipe = c3.Reconstruction.Post.SimpleRiskScorePipe(aggFunc="mean", name="simple_risk_score")
   *
   * # To connect the risk score pipe to the `residuals` output of the autoencoder, simply invoke `succeed` on the risk
   * # score pipe.
   * pipeline = risk_score_pipe.succeed(autoencoder)
   * ```
   */
  succeed: ~ py
}
