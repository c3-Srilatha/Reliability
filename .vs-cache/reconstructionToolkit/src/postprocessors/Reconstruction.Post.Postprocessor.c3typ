/**
 * This type provides an interface for users to attach a post-processor to their central reconstruction pipe.
 * This type is intended to be mixed-in by developers with the primary method {@link #succeed} overridden to provide
 * users with a convenience API to construct a larger {@link MlPipeline} that connects the central pipe to a
 * post-processor.
 */
type Reconstruction.Post.Postprocessor mixes Reconstruction.Processor {

  /**
   * Generate a new {@link MlPipeline} that connects the specified {@link MlPipe} to this post-processor. The
   * resulting pipeline may or may not include additional pipes and introduce new outputs, but should not change any
   * inputs of the `pipe`. The output(s) of the `pipe` should, either directly or indirectly, connect to one or more
   * input ports of the post-processor. Developers must override this method to orchestrate the creation of the new,
   * larger {@link MlPipeline}.
   * @param pipe
   *           The {@link MlPipe} whose outputs should be post-processed by this instance. In the returned
   *           {@link MlPipeline}, the pipe will come before the post-processor.
   *           DEVELOPER NOTE: It is the developer's responsibility to perform any necessary validation to avoid returning
   *           an incorrect pipeline.
   * @param kwargs
   *           A map of keyword arguments to configure the output {@link MlPipeline}.
   *           DEVELOPER NOTE: It is the developer's responsibility to expose any keyword argument names and types
   *           through proper documentation.
   */
  succeed: abstract optional member function(pipe: !(MlPipe | map<string, MlPipe>), kwargs: map<string, any>): !MlPipeline

  /**
   * Connect the `center` pipe to the `post` pipeline, using the `inputMap` to determine which outputs of `center` get
   * connected to which inputs of `post`. This method accepts the following `kwargs`:
   * - `mergePipelines`: If set, do not wrap `center` in a nested pipeline and directly merge the `center` and `post` pipes.
   * - `keepOutputs`: If set, keep the outputs of `center` that are also being connected to `post`.
   *
   * @param center
   *          The central pipe.
   * @param post
   *          The pipeline that orchestrates post-processing steps
   * @param inputMap
   *          A map of output name in `center` to input name in `post`
   * @param kwargs
   *          A map of keyword arguments to configure the returned {@link MlPipeline}
   */
  connect: function(center: !MlPipe,
                    post: !MlPipeline,
                    inputMap: !map<string, string>,
                    kwargs: map<string, any>): !MlPipeline py

  /**
   * Raise an `AssertionError` if the `pipe` does not have the `outputKeys` in its declared output Type. If the `pipe`
   * has a single output, the only possible output key is `"out"`.
   */
  validate: function(pipe: !MlPipe, outputKeys: ![string]) py
}
