/**
 * Luke Test Automation User Config to handle user/password for automation purposes
 */
type LukeTestAutomationUser mixes Config, Named {

  /**
   * Default user name
   */
  username: string = 'BA'

  /**
   * Default user name
   */
  password: string = 'BA'

  /**
   * @return single instance of this Nameable type by name. Note that if this type is also Cached then it will
   * retrieve instance from cache.
   */
  forName: ~ js-server

  /**
   * Set Tester User into the luke instance
   * @param luke
   *          The {@link LukeBrowser} instance
   * @param configName
   *          The {@link LukeTestAutomationUser} User Config Name to set
   */
  setTesterUser: function(luke: !LukeBrowser, configName: !string): string js-client

  /**
   * Get Tester User
   * @param luke
   *          The {@link LukeBrowser} instance
   * @return {@link LukeTestAutomationUser} if previously set
   */
  getTesterUser: function(luke: !LukeBrowser): string js-client
}
