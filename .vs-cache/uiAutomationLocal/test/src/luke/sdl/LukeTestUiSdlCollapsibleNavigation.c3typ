/**
 * Fill in type description here.
 */
type LukeTestUiSdlCollapsibleNavigation mixes LukeTestComponent {

  parentSelector:      ~ = '.c3-sdl-collapsible-navigation-open'
  renderingSelectors:  ~ = ['.c3-sdl-collapsible-navigation', '.c3-sdl-collapsible-navigation-header', '.c3-sdl-side-navigation-accordion-container']
  tabNamesSelector:    string = '.c3-sdl-side-navigation-accordion-container .c3-sdl-internal-hyperlink'
  navTitleSelector:    string = '.c3-sdl-collapsible-navigation-header-title'
  navSubtitleSelector: string = '.c3-sdl-collapsible-navigation-header-subtitle'

  /**
   * Clicks on the nav item
   */
  clickOnNavItem: member function(itemName: string): LukeAsyncQueueNode js-client
}
