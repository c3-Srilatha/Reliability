/**
 * A test component for LukeTestUiSdlInlineNotification
 */
type LukeTestUiSdlInlineNotification mixes LukeTestComponent {

  /**
   * The selector for the LukeTestUiSdlInlineNotification
   */
  parentSelector: ~ = '.c3-sdl-inline-notification-box-container'

  /**
   * The selector for the status icon
   */
  iconSelector: string = '.icon'

  /**
   * The selector for the title container
   */
  titleSelector: string = '.c3-sdl-inline-notification-title'

  /**
   * The selector for the subtitle container
   */
  subtitleSelector: string = '.c3-sdl-inline-notification-subtitle'

  /**
   * Returns title text of the inline notification
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the title text
   */
  getTitleText: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Returns subtitle text of the inline notification
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the title text
   */
  getSubtitleText: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Checks if there is not an inline notification
   *
   * @return the assertion of whether the inline notification is not present
   */
  assertNoInlineNotification: inline member function() js
}
