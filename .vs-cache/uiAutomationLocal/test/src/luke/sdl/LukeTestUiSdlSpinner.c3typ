type LukeTestUiSdlSpinner mixes LukeTestComponent {

  /**
   * The selector for spinner if it has gone away
   */
  spinnerSelector: string = '.ui.inverted.dimmer'

  /**
   * checks if the spinner is not present
   * @param timeout
   *           Timeout in seconds for the chain.
   */
  spinnerNotExist: inline member function(timeout: int): LukeAsyncQueueNode js
}
