/**
 * Configures denormalization sources for RegionHierarchyDenorm.
 *
 * - Includes both `BusinessRegionRelation` and `GeoPoliticalRegionRelation` as sources.
 * - Each source specifies parent and child field names to define hierarchical relationships.
 * - `strictHierarchy=false` allows for non-strict (possibly cyclic or multi-parent) hierarchies.
 *
 * This setup enables RegionHierarchyDenorm to represent both business and geopolitical region hierarchies
 * in a single denormalized structure for efficient querying and traversal.
 */
@db(index+=['relationship, to', 'relationship, from, to', 'relationship, isRoot'])
@denorm(sources=[
                  {
                    type: 'DenormSource',
                    source: 'BusinessRegionRelation',
                    parentFieldName: 'businessRegionParents',
                    childFieldName: 'businessRegionChildren'
                  },
                  {
                    type: 'DenormSource',
                    source: 'GeoPoliticalRegionRelation',
                    parentFieldName: 'geoPoliticalRegionParents',
                    childFieldName: 'geoPoliticalRegionChildren'
                  }
                ],
        strictHierarchy=false)
entity type RegionHierarchyDenorm mixes HierarchyDenorm<Region> schema name 'STRUCT_RGNHDNRM' {

  /**
   * The unique name of the region hierarchy denormalization entity instance.
   */
  name:         ~ not persistable
  /**
   * The version identifier for this entity instance.
   */
  version:      ~ not persistable
  /**
   * Metadata associated with this entity instance.
   */
  meta:         ~ not persistable
  /**
   * Edits made to the version of this entity instance.
   */
  versionEdits: ~ not persistable
}
