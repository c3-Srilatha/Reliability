/**
 * Represents a geographical region with hierarchical, business, and geopolitical relationships.
 * Extends {@link SeedData}, {@link WeatherAware}, and {@link MetricEvaluatable} types for additional weather 
 * and metric data storage.
 */
@denorm(target='RegionHierarchyDenorm', strictHierarchy=false)
entity extendable type Region mixes SeedData, WeatherAware, MetricEvaluatable type key 'RGN' schema name 'STRUCT_REGION' {

  /**
   * A description of the region.
   */
  description: string

  /**
   * Relationships to child regions.
   */
  regionRelations: [RegionRelation](child)
  
  /**
   * Parent regions, denormalized from `regionRelations`.
   */
  parents: [Region] stored calc regionRelations.parent schema name 'PAR'

  /**
   * Geographical entity associated with the region.
   */
  geography: GeographicalEntity;

  /**
   * Denormalized list of parent regions from `RegionHierarchyDenorm`.
   */
  denormChildren: [RegionHierarchyDenorm](from);

  /**
   * Business region parent relationships.
   */
  businessRegionParents: [BusinessRegionRelation](to);

  /**
   * Geopolitical region parent relationships.
   */
  geoPoliticalRegionParents: [GeoPoliticalRegionRelation](to);

  /**
   * Business region child relationships.
   */
  businessRegionChildren: [BusinessRegionRelation](from);

  /**
   * Geopolitical region child relationships.
   */
  geoPoliticalRegionChildren: [GeoPoliticalRegionRelation](from);
}
