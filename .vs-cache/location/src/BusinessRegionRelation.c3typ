/**
 * Represents the relationship between two business regions.
 * 
 * This entity defines a relation where a parent BusinessRegion is associated with a child BusinessRegion. 
 * entity
 * key 'BRR'
 */
entity type BusinessRegionRelation extends RegionRelation type key 'BRR' {

  /**
   * The parent business region in the relationship.
   */
  parent: BusinessRegion;
  
  /**
   * The child business region in the relationship.
   */
  child: BusinessRegion;
  
  /**
   * The type of relationship between the business regions, defaulting to 'RREL:BRR'.
   */
  relationship: ~ = 'RREL:BRR';
}
