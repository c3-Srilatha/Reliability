/**
 * Type for defining components of an address
 */
type GeoAddressComponent {

  /**
   * string representing the Address Component value e.g.,'San Mateo'
   */
  name: string

  /**
   * abbreviation of Address Component value
   */
  abbr: string

  /**
   * possible componet types
   * e.g., [{id:'room'},{id:'apt'}, {id:'suite'}]
   */
  types: [GeoAddressComponentType] schema suffix 'T'
}
