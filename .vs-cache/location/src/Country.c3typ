/**
 * Representation of countries using the ISO 3166-1 standard.
 */
@db(unique=['name', 'alphaTwoCode', 'alphaThreeCode', 'numericCode'])
entity type Country mixes SeedData schema name 'GEO_CNTRY' {

  /**
   * English short name of the Country.
   */
  name: ~

  /**
   * Two-letter country code by ISO 3166-1 standard.
   */
  alphaTwoCode: string

  /**
   * Three-letter country code by ISO 3166-1 standard.
   */
  alphaThreeCode: string

  /**
   * Three-digit country code by ISO 3166-1 standard.
   */
  numericCode: string

  /**
   * Official {@link Currency} of the {@link Country}.
   */
  currency: Currency

  /**
   * Identifier by ISO 3166-2 standard.
   */
  iso3166dash2: string
}
