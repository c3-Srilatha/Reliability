/**
 * Entity representing the relationship between two geopolitical regions.
 *
 * This entity type defines how a parent {@link GeoPoliticalRegion} is related to a child {@link GeoPoliticalRegion}.
 * 
 */
entity type GeoPoliticalRegionRelation extends RegionRelation type key 'GPR' {
  /**
   * The parent geopolitical region in the relationship.
   * This region is considered the "parent" in a hierarchical relationship between regions.
   */
  parent: GeoPoliticalRegion

  /**
   * The child geopolitical region in the relationship.
   * This region is considered the "child" in a hierarchical relationship between regions.
   */
  child: GeoPoliticalRegion

  /**
   * The type of relationship between the two geopolitical regions.
   * This is typically set to 'RREL:GPR' to indicate a Geopolitical Region Relationship.
   */
  relationship: ~ = 'RREL:GPR'
}
