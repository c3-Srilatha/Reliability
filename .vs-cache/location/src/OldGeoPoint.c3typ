/**
 * Type can be used to define the global position
 */
type OldGeoPoint mixes LatLong {

  /**
   * latitude as decimal in degrees. ex: 48.8583 degreess for 48° 51' 29"
   */
  latitude: !~

  /**
   * longitude as decimal in degrees. ex: 48.8583 degreess for 48° 51' 29"
   */
  longitude: !~
}
