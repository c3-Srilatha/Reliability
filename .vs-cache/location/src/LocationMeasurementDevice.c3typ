 /**
 * A device that measures location-related data, such as GPS coordinates or address information.
 *
 * This type is extendable, allowing for the creation of more specific types of location measurement devices.
 *
 * The {@link LocationMeasurementDevice} type is designed to be used in conjunction with the {@link Location} type,
 * which represents a geographic location. The {@link location} field on this type stores a reference to the
 * associated {@link Location} object.
 *
 * `@db(index+=['meta.timestamp'])`
 *           This type is indexed on the `meta.timestamp` field, which allows for efficient querying and sorting
 *           of location measurement devices based on when they were last updated.
 */
@db(index+=['meta.timestamp'])
entity extendable type LocationMeasurementDevice type key 'LMD' schema name 'STRUCT_LOCMDEV' {

  /**
   * The geographic location for a location measurement device.
   * Designed, but not required, to facilitate data loading of partial objects.
   */
  location: Location

  /**
   * A character string appended to a postal address for the purpose of sorting mail.
   */
  postalCode: string stored calc location.postalCode
}
