/**
 * Represents a business region in a hierarchy.
 * 
 * This entity extends the `Region` type and provides information on the business region's relationships 
 * and its depth in the hierarchy.
 * 
 * entity
 * key 'BRN'
 */
entity type BusinessRegion extends Region type key 'BRN' {

  /**
   * Depth: 0 - is root parent,
   * : null - is not part of hierarchy
   * : n (n>0) is nth level from root
   */
  depthFromRootParent: int stored calc max(denormParents.(startsWith(relationship, 'RREL:BRR')).distance)

  /**
   * Parents of this region
   */
  regionRelations: [BusinessRegionRelation]
}
