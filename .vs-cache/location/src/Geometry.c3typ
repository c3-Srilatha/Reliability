/**
 * Type can be used to define shape or boundary using the global position
 */
type Geometry {

  /**
   * set global positions defined to identify the object
   */
  points: [OldGeoPoint] schema name 'PT'

  /**
   * a rectangle indicating the influence/spen of the object
   */
  envelope: GeoEnvelope

  /**
   * defines  what the points represent
   * If mode is 'Points',  we plot them as points.
   * If mode is 'Polyline', we draw a path using this points in order.
   * If mode is 'Polygon', we draw a path using this points in order, looping back at the end.
   */
  mode: !string enum('Points', 'Polyline', 'Polygon') = 'Points'
}
