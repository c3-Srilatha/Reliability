/**
 * Entity representing a geopolitical region. This entity extends the {@link Region} type and mixes in {@link SeedData} functionality.
 *
 * It defines a region with its associated relationships to other geopolitical regions.
 */
@seed(userUpdatable=true)
entity type GeoPoliticalRegion extends Region mixes SeedData type key 'GPRN' {

  /**
   * A list of relationships between this region and other geopolitical regions.
   *
   * Each relationship is represented by a {@link GeoPoliticalRegionRelation}, which links the current region to
   * other regions, establishing hierarchical or relational connections.
   */
  regionRelations: [GeoPoliticalRegionRelation]
}
