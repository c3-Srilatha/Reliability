/**
 * Utility functions for diagram parsing related to image manipulation and bounding box operations.
 * Includes functionality for resizing images and computing Intersection over Union (IoU) between bounding boxes.
 */
@beta
type DiagramParsingCvUtils {

  /**
   * Rescale an image using opencv. The input and output are native numpy arrays.
   */
  resizeImage: inline function(
    image: !native,
    zoom: !float
  ): !native py-diagramparsing-cv

  /**
   * Compute the iou between two bounding boxes [xmin, ymin, xmax, ymax]
   */
  iou: inline function(
    box1: ![int],
    box2: ![int]
  ): !float py-diagramparsing-cv

  /**
   * Compute iou matrix among n and m bounding boxes with shape n x m
   */
  ious: inline function(
    boxes1: ![[int]],
    boxes2: ![[int]]
  ): ![[float]] py-diagramparsing-cv
}
