/**
 * Utility functions for performing operations related to the YOLO (You Only Look Once) object detection model.
 * These utilities handle model loading, image preprocessing, Non-Maximum Suppression (NMS), and converting detection boxes.
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
@beta
type DiagramParsingYoloUtils {

  /**
   * A private function that is only used for test coverage to validate that all models within _torch_yolo_model_wrapper can predict.
   * This function will merely tell you if your JSON file represents a deserializable model that can be used through YOLO deployment.
   * Reference test_DiagramParsingYoloUtils for implementation.
   */
  attemptPredict: private function(
    jsonFile: !json
  ): !native py-diagramparsing-torch

  /**
   * Load pretrained model where pthFile stores the trained PyTorch model's state dictionary and yamlFile contains the model's configuration..
   */
  attemptLoad: inline function(
    pthFile: !File,
    yamlFile: !File
  ): !native py-diagramparsing-torch

  /**
   * Verify img_size is a multiple of stride size
   */
  checkImgSize: inline function(
    imgSize: !native,
    s: !int
  ): !native py-diagramparsing-torch

  /**
    * Runs Non-Maximum Suppression (NMS) on inference results
    *
    * Returns: list of detections, on (n,6) tensor per image [xyxy, conf, cls]
    *
   */
  nonMaxSuppression: inline function(
    prediction: !native,
    confThres: !float,
    iouThres: !float,
    classes: ![int],
    agnostic: !boolean,
    multiLabel: boolean,
    labels: native
  ): !native py-diagramparsing-torch

  /**
   * Convert nx4 boxes from [x1, y1, x2, y2] to [x, y, w, h] where xy1=top-left, xy2=bottom-right
   */
  xyxy2xywh: inline function(
    x: !native
  ): !native py-diagramparsing-torch

  /**
   * Divide images are into smaller (possibly overlapped) patches.
   */
  image2Patches: inline function(
    imgOrigin: !native,
    imgSize: !int,
    overlapRatio: !float,
    imgsz: !native,
    stride: !int,
    device: !string
  ): !native py-diagramparsing-torch

  /**
   * Convert predictions made on each patch into a prediction on the original image.
   */
  patches2Image: inline function(
    pred: !native,
    imgSize: !int,
    overlapRatio: !float,
    numRows: !int,
    numCols: !int
  ): !native py-diagramparsing-torch

}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
