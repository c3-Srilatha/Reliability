/**
 * Utility functions for downloading pretrained models, creating diagram parsing pipeline templates,
 * and performing other setup tasks for diagram parsing with C3 AI.
 */
@beta
type DiagramParsingSetupUtils {

  /**
   * Helper function to download content from a `url` using the
   * `requests` python library. The content will be downloaded in
   * chunks and written to a {@link File} with the `remoteFilepath`
   * url in the C3 FileSystem.
   */
  downloadWithRequests: function(
    url: !string,
    remoteFilepath: !string,
    chunkSizeInKilobytes: int = 10000
  ): File py-diagramparsing-cv

  /**
   * Download the pre-trained model files that have not been downloaded yet,
   * and return the list of downloaded model files.
   */
  downloadPretrainedModels: private function(): [File] py-diagramparsing-cv

  /**
   * Download the pre-trained model files that have not been downloaded yet,
   * and return the list of downloaded model files.
   */
  downloadPretrainedYoloModels: private function(): [File] py-diagramparsing-cv

  /**
   * Create a template of {@link PdfToImagePipe} with id of `PdfToImagePipe_Template`.
   * If the template already exists, return that template.
   */
  createPdfToImagePipeTemplate: private function(): !PdfToImagePipe py

  /**
   * Create a template of {@link ImageToTextPipe} with id of `ImageToTextPipe_Template`.
   * If the template already exists, return that template.
   */
  createImageToTextPipeTemplate: private function(): !ImageToTextPipe py

  /**
   * Create a template of {@link TwoStageSymbolDetectionPipe} with id of `TwoStageSymbolDetectionPipe_Template`.
   * If the template already exists, return that template.
   */
  createTwoStageSymbolDetectionPipeTemplate: function(): !TwoStageSymbolDetectionPipe py

  /**
   * Create a template of {@link YoloSymbolDetectionPipe} with id of `YoloSymbolDetectionPipe_Template`.
   * If the template already exists, return that template.
   */
  createYoloSymbolDetectionPipeTemplate: function(): !YoloSymbolDetectionPipe py

  /**
   * Create a template of {@link DiagramParsingPipeline} with id of `DiagramParsingPipeline_Template`.
   * If the template already exists, return that template.
   */
  createDiagramParsingPipelineTemplate: function(): !DiagramParsingPipeline py

  /**
   * Create a Yolo-based template of {@link DiagramParsingPipeline} with id of `DiagramParsingPipeline_Template`.
   * If the template already exists, return that template.
   */
  createDiagramParsingYoloPipelineTemplate: function(): !DiagramParsingPipeline py

}
