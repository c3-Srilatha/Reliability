/**
 * Abstract type for symbol detection sample generator
 */
abstract type SymbolDetectionSampleGenerator mixes SymbolDetectionSampleGeneratorFields {

  /**
   * Create the python generator which will generate train/validation samples that can be passed to Keras
   *
   * @return native python generator
   */
  getPythonGenerator: abstract inline member function(
    mode: string enum('train', 'valid') = 'train'
  ): !native py-diagramparsing-cv

  /**
   * Use imgaug package to augment an numpy array image
   */
  augment: private inline function(
    image: !native
  ): !native py-diagramparsing-cv

}
