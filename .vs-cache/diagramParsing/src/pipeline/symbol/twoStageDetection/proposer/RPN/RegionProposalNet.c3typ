/**
 * Region proposal network from Faster-RCNN
 */
type RegionProposalNet extends RegionProposer type key "RPN" {

  /**
   * Anchor boxes that are rough estimate of the target object sizes, the closer
   * the number is, the easier the task for the model to learn.
   */
  anchorBoxShapes: ![Pair<int, int>] schema name "AKRSHP"

  /**
   * Trained tensorflow model file
   */
  h5: !File schema name "MDLFLE"

  train: ~ py-diagramparsing-cv

  propose: ~ py-diagramparsing-cv

  /**
   * Compute the anchor boxes "grid" over the entire image
   *
   */
  generateAnchorBoxes: inline function(
    rpnShape : ![int],
    imgShape : ![int],
    boxShapes: ![Pair<int, int>]
  ): !native py
}
