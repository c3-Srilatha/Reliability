/**
 * Sample generator that generates augmented diagrams for training {@link RegionProposalNet}.
 */
type RpnSampleGenerator mixes SymbolDetectionSampleGenerator {

  /**
   * Backbone feature extractor for the region proposal net
   */
  backbone: !Backbone

  /**
   * Shape of the anchor boxes
   */
  anchorBoxShapes: ![Pair<int, int>]

  getPythonGenerator: ~ py-diagramparsing-cv
}
