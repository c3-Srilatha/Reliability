/**
 * Base region proposer type controlling the logic for selecting the potential
 * regions that the detector should be run onto. For example, in P&ID diagram
 * regions containing only white pixels can be filtered directly without being
 * feed into the detector
 */
extendable entity type RegionProposer schema name "RPR" {

  /**
   * Backbone feature extractor
   */
  backbone: !Backbone schema name "BKBN"

  /**
   * Train the current instance of region proposer inplace
   */
  train: inline member function(
    spec: !RegionProposerTrainingSpec
  ): !RegionProposer

  /**
   * Propose bounding boxes coordinates that defines the regions that detector
   * should be applied and filter out the unnecessary regions
   *
   * @param image in np.ndarray.
   * @param features in [obj]. Used for avoid repeat feature extractions
   * @return bboxes, bounding boxes coordinates [[xmin, ymin, xmax, ymax]]
   */
  propose: abstract inline member function(
    image   : !native,
    features: native
  ): !native

}
