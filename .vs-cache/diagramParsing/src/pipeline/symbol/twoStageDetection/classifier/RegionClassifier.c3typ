/**
 * Base symbol detector that takes in images and output (n target clss + 1)
 * probabilities for each image. +1 is for all the negative classes. This type
 * is used in symbol detection pipe to handle the classifiction work
 * the model definition can be modified by override the buildModel method,
 * and the customized training logic can be implemented by override the train
 * method
 */
/*
 * c3-analysis-disable c3-excessive-method-params -- existing functions should not cause error
 */
extendable entity type RegionClassifier schema name "RNCLR" {

  /**
   * Backbone feature extractor
   */
  backbone: !Backbone schema name "BKBN"

  /**
   * Target symbols that the detector can detect
   */
  targets: ![string enum DiagramParsingClassLabel] schema name "TRGTS"

  /**
   * Detect the probabilities for all target classes for the input images
   *
   * @param image [np.ndarray] that might contains the target symbol
   * @param features [obj]. Used for avoid repeat feature extraction
   * @return probs np.ndarray of shape (n_imgs, n_cls+1) for the probabilities
   *   of each target classes, each row sum to 1.0
   */
  classify: abstract inline member function(
    image   : !native,
    features: native,
    boxes: ![native],
    thresholds: ![float]
  ): ![DiagramParsingPredictedSymbolType]

  /**
   * Train the current detector instance and update the model fields to the
   * trained MLPipe
   */
  train: abstract inline member function(
    spec: !RegionClassifierTrainingSpec
  )
}

/*
 * c3-analysis-enable c3-excessive-method-params
 */
