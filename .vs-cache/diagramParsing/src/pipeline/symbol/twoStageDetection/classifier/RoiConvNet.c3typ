/**
 * Region of Interest Pooling + CNN classifier with feature pyramid
 */
type RoiConvNet extends RegionClassifier type key "ROICNN" {

  /**
   * Pooling size of each of the target regions, output will be
   * n x n x c, where n is the pool size and c is the feature channel
   * number
   */
  poolSizes: ![int] schema name "PLSZS"

  /**
   * Trained tensorflow model file
   */
  h5: !File schema name "MDLFLE"

  train: ~ py-diagramparsing-cv

  classify: ~ py-diagramparsing-cv

  /**
   * Pool features with ROI pooling on an image and its feature pyramid
   * @param image np.ndarray(uint8) representation of an image
   * @param boxes bounding box coordinates in np.ndarray [[xmin, ymin, xmax, ymax]]
   * @return features in [level1 feature, level2 feature, ..., level k feature]
   */
  poolRois: inline member function(
    image   : !native,
    features: native,
    boxes   : !native
  ): !native py-diagramparsing-cv
}
