/**
 * Sample generator that generates augmented diagrams for training {@link RoiConvNet}.
 */
type RoiConvNetSampleGenerator mixes SymbolDetectionSampleGenerator {

  /**
   * Backbone feature extractor for the region proposal net
   */
  backbone: !Backbone

  /**
  * Trained region proposer for the symbol detector
  */
  proposer: !RegionProposalNet

  /**
  * Untrained classifier that predicts the class of each detected region
  */
  classifier: !RoiConvNet

  /**
   * Number of times an sample can be continuously reused for training
   */
  numReuse: int = 1

  getPythonGenerator: ~ py-diagramparsing-cv
}
