/**
 * Parameters controlling the model training behavior of an region classifier.
 */
type RegionClassifierTrainingSpec mixes Spec, SymbolDetectionSampleGeneratorFields {

  /**
   * The number of training epochs
   */
  numEpochs: int = 512

  /**
   * The number of steps per training epoch. Each step processes {@link trainBatchSize} of samples.
   */
  stepsPerEpoch: int = 128

  /**
   * The number of epochs with no validation score improvement after which training will be stopped
   */
  patience: int = 10

  /**
   * Number of times an sample can be continuously reused for training
   */
  numReuse: int = 1

  /**
   * Trained region proposer for the symbol detector
   */
  proposer: private RegionProposer

  /**
   * If true, the pipe will be trained from scratch. If false, the pipe will load a pre-trained h5 file and
   * fine-tune it.
   */
  trainFromScratch: private boolean = false
}
