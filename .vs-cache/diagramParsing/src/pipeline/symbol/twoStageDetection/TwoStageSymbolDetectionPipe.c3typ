/**
 * This type represents an {@link MlPipe} template for two-stage symbol detection in diagrams.
 */
@beta
extendable entity type TwoStageSymbolDetectionPipe extends SymbolDetectionPipe type key 'TWSTG_SYMBL_DTCTN' {

  /**
  * Region proposer for the symbol detector. This field is required if the user wants to directly run {@link process}
  * without training the pipe first. For running {@link train}, this field is optional. If it is provided, the pipe
  * will further fine-tune the proposer on the input training data.
  */
  proposer: RegionProposer schema name "PRPSR"

  /**
  * Classifier that predicts the class of each detected region. This field is required if the user wants to
  * directly run {@link process} without training the pipe first. For running {@link train}, this field is optional.
  * If it is provided, the pipe will further fine-tune the classifier on the input training data.
  */
  classifier: RegionClassifier schema name "CLSSFR"

  /**
   * Parameters to control the training process for the region proposer and classifier. This field is required
   * if the user wants to train the pipe using {@link train}.
   */
  trainingSpec: TwoStageSymbolDetectionTrainingSpec schema name "TRNG_SPC"

 /**
  * Probability thresholds for each symbol type. The parameter would be used for {@link RegionClassifier} during inference.
  */
  thresholds: ![float]


  isTrainable: ~ py

  processSync: ~ from super py-diagramparsing-cv

  doProcess: ~ py-diagramparsing-cv

  trainSync: ~ from super py-diagramparsing-cv

  doTrain: ~ py-diagramparsing-cv

  afterTrain: ~ py

  isTrained: ~ py
}
