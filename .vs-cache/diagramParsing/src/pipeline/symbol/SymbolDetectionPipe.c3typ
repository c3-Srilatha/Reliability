/**
 * This type represents an abstract {@link MlPipe} template for symbol detection in diagrams.
 */
@beta
extendable entity type SymbolDetectionPipe extends MlTemplate.AtomicPipe<Data, void, Data> type key 'SYMBL_DTCTN_PP' {

  /**
   * The name of the column containing the urls of the images to be processed.
   */
  imageColumnName: !string

  /**
   * A list of {@link DiagramAugmenter}s to be used, such as {@link DiagramRandomCropper}. This field is required
   * if the user wants to train the pipe using {@link train}.
   */
  augmenters: [DiagramAugmenter] schema name 'AMTS'

  generatePipe: ~ py

}
