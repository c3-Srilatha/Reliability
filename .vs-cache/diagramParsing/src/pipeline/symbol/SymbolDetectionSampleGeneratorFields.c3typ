/**
 * Fields common to {@link SymbolDetectionSampleGenerator}-extending types and their associated model
 * training specs.
 */
type SymbolDetectionSampleGeneratorFields {

  /**
   * A list of {@link DiagramAugmenter}s to be used, such as {@link DiagramRandomCropper}
   */
  augmenters: private [DiagramAugmenter]

  /**
   * Diagrams for the training set
   */
  trainDiagrams: private [LabeledDiagram]

  /**
   * Diagrams for the validation set
   */
  validDiagrams: private [LabeledDiagram]

  /**
   * Batch size for training samples
   */
  trainBatchSize: !int = 8

  /**
   * Batch size for validation samples
   */
  validBatchSize: !int = 32

  /**
   * IOU (Intersection over Union) threshold above which should be considered as a true label
   */
  iouThreshold: !float = 0.6
}
