/**
 * Pipeline that takes a list of P&IDs in PDF format, detects the symbols (LMI, TAG, etc) on those digrams
 * and recognizes the texts on each symbol. The pipeline consists of three steps each implemented by
 * an {@link MlPipe}: {@link PdfToImagePipe}, {@link SymbolDetectionPipe}, and {@link ImageToTextPipe}.
 */
@beta
extendable entity type DiagramParsingPipeline<DX, DO> extends MlTemplate.Pipeline<DX, void, void, DO, void> type key 'DPP' {

    /**
     * First step of diagram parsing: {@link SymbolDetectionPipe}.
     * If the `symbolDetectionPipe` is not given during the object initialization,
     * the function `DiagramParsingPipeline#beforeCreate` will instantiate a pipe with
     * the function `DiagramParsingSetupUtils#createTwoStageSymbolDetectionPipeTemplate`
     */
    @ML(containsHyperparams=true)
    symbolDetectionPipe: SymbolDetectionPipe

    /**
     * Second step of diagram parsing: {@link ImageToTextPipe}.
     * If the `imageToTextPipe` is not given during the object initialization,
     * the function `DiagramParsingPipeline#beforeCreate` will instantiate a pipe with
     * the function `DiagramParsingSetupUtils#createImageToTextPipeTemplate`
     */
    @ML(containsHyperparams=true)
    imageToTextPipe: ImageToTextPipe

    /**
     * Third step of diagram parsing: {@link ConnectionDetectionPipe}.
     * Detects connections between elements in the diagram, helping to identify relationships and interactions
     * between the symbols in the parsed diagram.
     */
    @db(persistAllFields=true)
    @ML(containsHyperparams=true)
    connectionDetectionPipe: MlPipe

    generatePipeline: ~ py

    generateTypeBindings: ~ py

    isTrainable: ~ py

    beforeCreate: ~ py
}
