/**
 * The Backbone of object detection
 */
extendable entity type Backbone schema name "BCKBN" {

  /**
   * The layers will be used to generate the output.
   * E.g, ['block4a_activation','top_conv']
   */
  layerNames: ![string] schema name "LRNS"

  /**
   * Whether the backbone layers are trainable. The length needs to be one or
   * match the number of layers in the model
   */
  trainable: boolean

  /**
   * Convert backbone to native tensorflow, keras, pytorch, ... type object
   * so it can be used together with downstream models
   */
  toNative: abstract inline member function(): !native py-diagramparsing-cv

  /**
   * Apply backbone and extract features from the inputs
   *
   * @param inputs images or other formats compatible with the backbone
   * @return feature tensors or features vectors for the inputs
   */
  extract: abstract inline member function(
    inputs: ![native]
  ): ![native] py-diagramparsing-cv

}
