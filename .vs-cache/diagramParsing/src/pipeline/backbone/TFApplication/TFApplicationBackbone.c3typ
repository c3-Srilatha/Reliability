/**
 * The Backbone of object detection
 */
type TFApplicationBackbone extends Backbone type key "TFAB" {

  /**
   * Class of the backbone models, for example EfficientNet contains several
   * different size of models like B0, B1 ...
   */
  className: !string

  /**
   * Type of the model like EfficientNetB0, DenseNet121, etc ...
   */
  modelName: !string

  /**
   * Trained tensorflow model file
   */
  h5: !File schema name "MDLFLE"

  /**
   * Parameters used for backbone initialization in training. This will
   * default to {'include_top': True, 'weights': 'imagenet'} if not given
   */
  initParams: map<string, any> schema name "INTPRMS"

  toNative: ~ py-diagramparsing-cv

  extract: ~ py-diagramparsing-cv

  /**
   * Save a native tensorflow/keras model to a h5 file and create a new persisted
   * {@link TFApplicationBackbone} entity. The other fields, such as {@link modelName},
   * {@link layerNames}, and {@link trainable} will remain the same.
   */
  updateWithNative: inline member function(
    model: !native
  ): !TFApplicationBackbone py-diagramparsing-cv
}
