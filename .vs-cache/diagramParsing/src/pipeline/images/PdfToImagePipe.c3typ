/**
 * This type represents an abstract {@link MlPipe} template for converting pdfs to images.
 */
@beta
extendable entity type PdfToImagePipe extends MlTemplate.AtomicPipe<Data, void, Data> type key 'PTIP' {

  /**
   * The name of the column containing the urls of the files to convert.
   */
  columnName: !string

  /**
   * Format that extracted images should be saved in. The full list of supported formats can be
   * found [here](https://pillow.readthedocs.io/en/latest/handbook/image-file-formats.html).
   */
  format: string = "PNG"

  /**
   * The number of pixels per inch in the generated images. A higher value will increase the image resolution, but will
   * also increase the output image size. Normally, 300dpi is needed for a sharp image.
   */
  dpi: int = 300

  /**
   * Whether to resize images to target dimensions.
   * If false (default), images keep their original dimensions from PDF rendering.
   */
  resizeImages: boolean = false

  /**
   * Target height to resize images to (when resizeImages=true).
   * Defaults to config value if not specified.
   */
  imageHeight: float

  /**
   * Target width to resize images to (when resizeImages=true).
   * Defaults to config value if not specified.
   */
  imageWidth: float

  /**
   * Whether to maintain aspect ratio when resizing (when resizeImages=true).
   * If false (default), images are stretched to exact dimensions.
   */
  maintainAspectRatio: boolean = false

  isTrainable: ~ py

  processSync: ~ from super py-diagramparsing-cv

  doProcess: ~ py-diagramparsing-cv

  generatePipe: ~ py

  /**
   * A version of {@link #doProcess} that takes a native input and returns a native output.
   * This is used to avoid creating {@link Data.Persisted}.
   */
  doProcessNative: inline member function (input: native): native py-diagramparsing-cv

}
