/**
 * ConnectionDetectionPipe: A pipeline component for detecting connections between symbols in diagrams.
 * It processes data to detect the connections and identifies symbols' bounding boxes and image URLs.
 * This is an abstract type that extends {@link MlTemplate.AtomicPipe}.
 */
abstract type ConnectionDetectionPipe extends MlTemplate.AtomicPipe<Data, void, Data> type key 'CNCDTG'{

  /**
   * The name of the column containing {@link DiagramParsingBoundingBox}s for the detected symbols.
   */
  boundingBoxColumnName: !string

  /**
   * The name of the column containing the urls of the files to convert.
   */
  imageColumnName: !string
}
