/**
 * Pipe that detects the text inside each asset (LMI, TAG, etc) of a diagram
 * and uses OCR to recognize the content of the detected texts.
 * By default, the pipe uses the EasyOCR technique: {@link https://github.com/JaidedAI/EasyOCR}.
 */
@beta
extendable entity type ImageToTextPipe extends MlTemplate.AtomicPipe<Data, void, Data> type key 'ITTP' {

  /**
   * The name of the column containing the urls of the images to be processed.
   */
  imageColumnName: !string

  /**
   * Image zoom/magnification ratio
   */
  zoom: float = 1.0

  isTrainable: ~ py

  processSync: ~ from super py-diagramparsing-cv

  doProcess: ~ py-diagramparsing-cv

  generatePipe: ~ py
}
