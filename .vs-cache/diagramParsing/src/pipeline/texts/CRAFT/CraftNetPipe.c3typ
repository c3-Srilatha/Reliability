/**
 * Pipe that detects texts using the CRAFT (Character-Region Awareness For Text detection) technique.
 * See {@link https://github.com/clovaai/CRAFT-pytorch} and {@link https://arxiv.org/pdf/1904.01941.pdf}
 * for more information on CRAFT.
 */
@beta
type CraftNetPipe extends ImageToTextPipe type key 'CNP' {

  /**
   * File for saving the pytorch pth file of the main text detection net.
   */
  mainNetPth: !File

  /**
   * File for saving the pytorch pth file of the text detection refining net.
   */
  refineNetPth: !File

  processSync: ~ from super py-diagramparsing-torch

  doProcess: ~ py-diagramparsing-torch
}
