/**
 * Private Helper module type for CRAFT (Character-Region Awareness For Text detection).
 * See {@link https://github.com/clovaai/CRAFT-pytorch} and {@link https://arxiv.org/pdf/1904.01941.pdf}
 * for more information on CRAFT.
 */
@beta
private type CraftNetLib {
    /**
     * CraftNet: Initialize and return the CRAFT (Character Region Awareness for Text detection) network model.
     * This function creates the base CRAFT model and prepares it for text detection tasks.
     */
    CraftNet: inline function(): !native py-diagramparsing-torch

    /**
     * RefineNet: Initialize and return the RefineNet model used for refining text regions in the CRAFT-based architecture.
     * This function applies additional post-processing to improve text boundary predictions.
     */
    RefineNet: inline function(): !native py-diagramparsing-torch

    /**
     * utils: Auxiliary utility functions for image preprocessing and postprocessing.
     * This module provides helper functions for coordinate transformation, text detection, and result adjustments.
     */
    utils: inline function(): !native py-diagramparsing-torch


    /**
     * imgproc: Utilities for image loading, normalization, resizing, and heatmap generation.
     * This module provides functions for common image processing tasks like loading, normalizing, resizing while preserving aspect ratio,
     * and converting images to heatmap format.
     */
    imgproc: inline function(): !native py-diagramparsing-torch
}
