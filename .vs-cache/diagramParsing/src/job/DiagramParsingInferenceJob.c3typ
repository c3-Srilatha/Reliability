/**
 * A MapReduce job to run inference on a batch of {@link ParsableDiagram}s.
 */
entity type DiagramParsingInferenceJob extends MapReduce<ParsableDiagram, void, void, void> type key 'DPJ' {

  /**
   * The {@link DiagramParsingMatchingSpec} to use for end-to-end parsing of
   * a batch of {@link ParsableDiagram}'s.
   */
  spec: !DiagramParsingMatchingSpec

  @action(group='write')
  map: ~ py
}
