/**
 * Extends {@link MlModel} to create a specialized model for diagram parsing tasks.
 * This model is specifically designed to handle parsing of diagrams within the context of machine learning.
 */
extendable entity type DiagramParsingMlModel extends MlModel type key 'DPMDL' {

  createModel: ~ py

}
