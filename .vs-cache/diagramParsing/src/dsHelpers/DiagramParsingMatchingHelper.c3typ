/**
 * Helper type to run diagram parsing and string matching for {@link SourceParsableDiagram}.
 */
@beta
type DiagramParsingMatchingHelper {

  /**
   * A function that kicks off a {@link Workflow} to asynchronously run diagram parsing for
   * one {@link SourceParsableDiagram} and then run {@link StringMatchingPipe} to match the
   * {@link ParsedSensor}s to actual {@link Sensor}s. The output of this function is a {@ Workflow.Run}.
   */
  parseAndMatch: member function(
    spec: DiagramParsingMatchingSpec, user: User
  ): Workflow.Run py

  /**
   * A function that kicks off a {@link Workflow} to asynchronously run diagram parsing for
   * multiple {@link SourceParsableDiagram}s and then run {@link StringMatchingPipe} to match the
   * {@link ParsedSensor}s to actual {@link Sensor}s. The output of this function is a {@ Workflow.Run}.
   */
  parseAndMatchBatch: function(
    spec: DiagramParsingMatchingSpec, user: User
  ): Workflow.Run py

  /**
   * A private helper function to create the inputs for {@link StringMatchingPipe#process} from the
   * output of {@link SourceParsableDiagram#processBatch} and a list of {@link Sensor}s.
   */
  getMatchingPipeInputs: private function(
    result: !MlSubject.ProcessResult, targets: ![MasterSensor]
  ): !map<string, Data> py-data

  /**
   * A private helper function to update already upserted {@link ParsedSensor}s with the matching results
   * from {@link StringMatchingPipe#process}.
   */
  updateParsedSensors: private function(
    matchingOutput: !Data, dropMultipleMatches: !boolean
  ): ![ParsedSensor] py-data

  /**
   * A private helper function to convert pdf files to images using a {@link PdfToImagePipe}, create entities
   * of {@link ParsableDiagram}, and then materialize the features of these entities based on the
   * {@link Feature.Set} of a {@link DiagramParsingMlModel}
   */
  generateParsableDiagrams: private function(
    sources: [SourceParsableDiagram], pdfToImagePipe: PdfToImagePipe, model: !DiagramParsingMlModel, parsableDiagrams: [ParsableDiagram], user: User
  ): ![ParsableDiagram] py-diagramparsing-cv

  /**
   * A private helper function to convert pdf files to images using a {@link PdfToImagePipe} and create entities
   * of {@link ParsableDiagram}.
   */
  uploadParsableDiagrams: private function(
    sources: ![SourceParsableDiagram], dpi: !int, isParsingEnabled: !boolean, user: User
  ): ![ParsableDiagram] py-diagramparsing-cv

  /**
   * A private helper function to update the parsing status for a {@link ParsableDiagram}.
   */
  updateParsableDiagramStatus: private function(
    parsableDiagrams: ![ParsableDiagram]
  ): ![ParsableDiagram] py-data
}
