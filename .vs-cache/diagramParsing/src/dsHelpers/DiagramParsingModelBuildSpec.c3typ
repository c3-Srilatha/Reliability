/**
 * A spec in {@link DiagramParsingMatchingSpec} that is used to hold information necessary to
 * create a {@link DiagramParsingMlModel}.
 */
@beta
type DiagramParsingModelBuildSpec mixes Spec {

  /**
   * The image zoom/magnification ratio used by {@link ImageToTextPipe}.
   */
  zoom: float = 1.0

  /**
   * A pre-trained {@link SymbolDetectionPipe}.
   */
  symbolDetectionPipe: !SymbolDetectionPipe

  /**
   * Optional input to modify the `thresholds` field of the provided {@link symbolDetectionPipe} and
   * upsert a new copy of {@link SymbolDetectionPipe}.
   */
  thresholdsOverride: [float]
}
