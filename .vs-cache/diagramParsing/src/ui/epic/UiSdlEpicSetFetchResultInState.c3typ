/**
 * This epic is used to update/initialize a field in {@link DiagramParsingApplicationState} with {@link FetchResult}
 * The payload to this epic should match payload expected by {@link DiagramParsingEpicUtil#setFetchResultInStateUtil}.
 * See {@link DiagramParsingEpicUtil#setFetchResultInStateUtil} for more information.
 *
 * For example, paylod to fetch {@link Sensor}s which are unverified (indicated by fetchSpec.spec.filter)
 * into fields `field1` and `field2` in the application state would be:
 *
 * ```
 * fetchOn: 'Sensor',
 * fieldsToStoreAt: [
 *  'field1',
 *  'field2',
 * ],
 * fetchSpec: {
 *  spec: {
 *    filter: '!exists(diagramParsedSensor)',
 *    include: 'id,displayName',
 *   },
 * },
 * ```
 *
 */
type UiSdlEpicSetFetchResultInState mixes UiSdlEpic {

    epic: ~ ts-client
}
