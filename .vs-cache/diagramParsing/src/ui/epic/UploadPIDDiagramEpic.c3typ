/**
 * The epic takes the form object containing the file urls and `enableDiagramParsing` flag.
 * If `enableDiagramParsing` is set to `true` then it will upload the file and trigger the parsing job.
 * Else if `enableDiagramParsing` is set to `false` then it will only upload the file.
 */

@typeScript
type UploadPIDDiagramEpic mixes UiSdlEpic {

    epic: ~ ts-client
}
