/**
 * Helper type for the sensor matching workflow.
 */
type SensorMatchHelper {
  /**
   * Validates that the selected master sensors belong to the same facilities as the P&ID.
   *
   * This function checks whether the facilities associated with the provided `masterSensors`
   * are the same as those associated with the assets of the given `diagramId`. It compares
   * the facility IDs for both the `masterSensors` and the `assets` in the diagram, and ensures
   * that both sets of facility IDs are identical.
   * Assumes the asset type configured has a facility. Else it return false.
   */
  validateMasterSensor: function(masterSensors: [MasterSensor], diagramId: string): boolean js-rhino
}
