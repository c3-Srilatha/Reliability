/**
 * Helper type to fetch data for DiagramParsing Existing Assets Form Dropdown.
 */
type ExistingAssetDropdownOption {
  /**
   * Returns a list of assets of the type specified by DiagramParsingConfig#assetTypeName.
   */
  fetch: function(spec: FetchSpec): FetchResult js-rhino
}
