/**
 * Transforms the `imageFile.url` property of a {@link ParsableDiagram} by prepending "file:/",
 * if the `url` exists. This transform addresses the PLAT-106661 bug and can be removed
 * once the issue is resolved.
 */
type UiSdlTransformUpdateImageExternalURL mixes UiSdlDataTransform<ParsableDiagram, json> {

  transform: ~ ts-client
}
