/**
 * Transform to map {@link ParsedSensor#matchConfidenceScore} to {@link ParsedSensor#matchConfidenceLevel}
 * to enable sorting by the confidence score.
 *
 * Sets the match confidence score to the lowest confidence category if the match confidence score does not exist or if the current actual sensor
 * is different from the actual sensor original match
 */
@typeScript
type UiSdlTransformSensorMatchVerificationGrid mixes UiSdlDataTransform<FetchResult<json>, FetchResult<json>> {

  transform: ~ ts-client
}
