 * Transform to add percent sign, number of verified sensors and total sensors to the {@link ParsedDiagramExtract#percentVerifiedSensors}
 * field of a {@link ParsableDiagram} entity.
 */
type UiSdlTransformDiagramSensorVerificationProgress mixes UiSdlDataTransform<ParsableDiagram, json> {

  transform: ~ ts-client
}
