/**
 * Transform to add percent sign and number of verified {@link ParsedSensor}s to the {@link ParsedDiagramExtract#percentVerifiedSensors}
 * field of a collection of {@link ParsableDiagram} entities.
 */
type UiSdlTransformDiagramVerifiedSensorCount mixes UiSdlDataTransform<FetchResult<ParsableDiagram>, FetchResult<json>> {

  transform: ~ ts-client
}
