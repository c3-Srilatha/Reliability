/**
 * This is a type housing utility functions used by diagram parsing
 */
@typeScript
type DiagramParsingEpicUtil {

  /**
   * This function helps to make an fetch ajax call, and store the {@link FetchResult} of the call in {@link DiagramParsingApplicationState}.
   * @param payload for the ajax call which expects the following parameters to be defined
   *  - fields => list of fields to store in application state.
   *  - fetchOn => Which type to perform fetch action on.
   *  - path => Which field within fetchResult to access, Supports dot(.) notation. Use `id` by default.
   *  - fetchSpec => spec for the fetch action.
   *
   * For example, paylod to fetch names of all {@link Sensor}s which are unverified and populate into a field called `options` in
   * the application state would be:
   *
   * ```
   * payload: {
   *  fetchOn: "Sensor",
   *  path : "name",
   *  fields: ["options"],
   *    fetchSpec: {
   *      spec: {
   *        "filter": "!exists(diagramParsedSensor)"
   *      }
   *    }
   * }
   *
   * NOTE: Even though `path` supports (.) notation,
   * i.e, you can pass `meta.created` for `path` in payload, it has to be included in `fetchSpec`.
   * ```
   */
  setFetchResultInStateUtil: function(payload: !any): !any ts-client

  /**
   * Wrapper on {@link BaseUiEpicUtil#getRefreshActions} to get refresh actions for diagram parsing components.
   * Intercepts `SensorMatchVerificationGrid_dataSpec_ds` merge arguments in the dataspec fetch before refreshing.
   */
  getRefreshDiagramParsingComponentActions: function(state: !UiSdlReduxState, dataSourceIds: [string]): !any ts-client
}
