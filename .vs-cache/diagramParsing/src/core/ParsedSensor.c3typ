/**
 * This type represents a detected sensor from a parsed diagram.
 */
entity type ParsedSensor schema name "PRSD_SNSR" {

  /**
   * {@link ParsedDiagramExtract} this ParsedSensor is from.
   */
  diagramExtract: ParsedDiagramExtract

  /**
   * {@link ParsableDiagram} this asset is extracted from.
   */
  diagram: !ParsableDiagram

  /**
   * {@link DiagramParsingBoundingBox} of the detected sensor.
   */
  boundingBox: DiagramParsingBoundingBox

  /**
   * The text associated with the detected sensor.
   */
  parsedText: string = 'N/A'

  /**
   * Reference to the currently proposed {@link MasterSensor} entity corresponding to this detected sensor.
   */
  actualSensor: MasterSensor

  /**
   * Reference to the original {@link MasterSensor} entity matched to this {@link ParsedSensor} by the {@link StringMatchingPipe}.
   * This field should not be changed after it is set.
   */
  @db(writeOnce=true)
  originalMatchedActualSensor: MasterSensor

  /**
   * Flag indicating if this parsed sensor has been manually verified to be a match to the linked {@link actualSensor}.
   */
  isVerified: boolean calc actualSensor.diagramParsedSensor.id == id

  /**
   * All parsed sensors from any {@link ParsableDiagram} which is currently matched to the same {@link Sensor}.
   */
  collidingSensors: [ParsedSensor](actualSensor, actualSensor)

  /**
   * Flag indicating if any other parsed sensors are matched to the same {@link actualSensor} as this parsed sensor.
   */
  isDuplicate: boolean calc count(collidingSensors.(diagram.latestExtract.id == diagramExtract.id)) > 1

  /**
   * Match confidence score of this {@link ParsedSensor} computed in the {@link ImageToTextPipe}.
   */
  matchConfidenceScore: double = 0

  /**
   * The current match confidence level of this {@link ParsedSensor} calculated based on {@link matchConfidenceScore}.
   */
  matchConfidenceLevel: string stored calc getMatchConfidenceLevel(matchConfidenceScore)

  /**
   * Deletes parsed sensors, along with the following:
   *   Clears {@link MasterSensor#diagramParsedSensor} for verified parsed sensors,
   *   Updates {@link ParsableDiagram#lastUpdate} for related diagram,
   *
   * @param parsedSensorObjs
   *        A list of parsedSensors to be deleted,
   * @returns {@link ObjList} type containing count of removed objects in {@link ActionStats#removedObjCount}.
   */
  deleteBatch: function(parsedSensorObjs: !?[mixing ParsedSensor]): !ObjList<mixing Persistable> js-rhino

  /**
   * Manually creates a {@link ParsedSensor} entity with the passed in {@link Sensor}
   */
  createArtificialParsedSensor: function(formObject: !json, diagramId: string): [ParsedSensor] js-rhino

  /**
   * Verifies parsed sensors, along with the following:
   *  Initializes/Overrides {@link MasterSensor#diagramParsedSensor} for target {@link Sensor}s,
   *  Updates {@link ParsableDiagram#lastUpdate} for all the related diagrams,
   *
   * @param parsedSensorObjs
   *        A list of parsedSensors/ids to be deleted,
   * @returns count of verified sensors.
   */
  verifyBatch: function(parsedSensorObjs: !?[mixing ParsedSensor]): int js-rhino

  /**
   * Un-verifies this {@link ParsedSensor} by removing the #actualSensor's reference
   * to this parsed sensor.
   */
  unVerify: member function() js-rhino

  /**
   * Custom fetch for the diagram viewer, which returns the {@link ParsedSensor} entities
   * with an additional color field determined by the {@link matchConfidenceLevel}.
   * See {@link DiagramParsingConfig#matchConfidenceLevelColors}.
   */
  fetchForDiagramViewer: function(spec: FetchSpec): !json js-rhino
}
