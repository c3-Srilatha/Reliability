/**
 * Specify possible diagram parsing status.
 */
enum type DiagramParsingStatus {

  /**
   * The parsable diagram has been parsed.
   */
  PARSED = 'Parsed'

  /**
   * The parsable diagram has not been parsed.
   */
  NOT_PARSED = 'Not Parsed'

  /**
   * The parsable diagram is in progress of parsing.
   */
  IN_PROGRESS = 'In Progress'
}
