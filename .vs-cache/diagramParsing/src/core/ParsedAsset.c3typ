/**
 * This type represents each asset from a parsed diagram
 */
entity type ParsedAsset schema name "PRSD_ASST" {

  /**
   * {@link ParsedDiagramExtract} this asset is from
   */
  diagramExtract: private ParsedDiagramExtract

  /**
   * {@link ParsableDiagram} this asset is extracted from
   */
  diagram: !ParsableDiagram

  /**
   * {@link DiagramParsingBoundingBox} of the detected symbol
   */
  boundingBox: !DiagramParsingBoundingBox

  /**
   * Symbol ID of the Asset
   */
   symbolID: int

  /**
   * Type of the detected symbol
   */
   symbolType: string

  /**
   * Collection of {@link BoundingBox}'s parsed for this asset
   */
  // textBoundingBoxes: [BoundingBox] schema suffix "TXTBBXS"

  /**
   * Associated text inside the symbol
   */
  // associatedText: [string] schema suffix "ASCTXT"

  /**
   * Symbols connected to each symbol
   */
   connectedSymbols: [int] schema suffix "CNCTDSYM"

  /**
   * Generate parsed id using associated texts
   */
  // @py(env="diagram_digitization")
  // parsedId: inline member function(): !string

}
