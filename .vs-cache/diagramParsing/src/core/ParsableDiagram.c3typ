/**
 * Represents an industrial engineering diagram such as P&ID. For details on other information
 * stored in this Type, refer to the documentation on each of the fields of this Type.
 */
extendable entity type ParsableDiagram mixes MlSubject schema name 'PRSBL_DGRM' {

  /**
   * The {@link File} which has the original diagrams in either a pdf or an image. Notice that
   * multiple {@link ParsableDiagram} can reference to the same single-page or multi-page pdf.
   */
  source: !File

  /**
   * To parse a diagram, it has to be in an image format that can be consumed by downstream
   * computer vision routines. If {@link source} is not an image file, then this field will
   * contain a reference to an image-field version of {@link source}. If {@link source} is already
   * an image, this field will be the same as {@link source}.
   */
  imageFile: !File

  /**
   * The {@link SourceParsableDiagram} which has the original source of diagrams in either a pdf or an image.
   * Notice that multiple {@link ParsableDiagram} can reference to the same {@link SourceParsableDiagram}.
   */
  sourceDiagram: SourceParsableDiagram

  /**
   * pid number, default to p&id file name, might be duplicate if p&id have multiple pages
   */
  pidNumber: string stored calc removePdfExtension(sourceDiagram.name || "")

  /**
   * Upon parsing the {@link imageFile}, the results will be stored in a {@link ParsedDiagramExtract}.
   * The {@link imageFile} may be parsed several times with different algorithms. All of the
   * {@link ParsedDiagramExtract}s are accessbile from this field.
   */
  @db(order='descending(meta.created)')
  extracts: [ParsedDiagramExtract] (diagram)

  /**
   * Latest {@link ParsedDiagramExtract} created for this diagram.
   */
  latestExtract: ParsedDiagramExtract stored calc extracts[0]

  /**
   * Latest {@link ParsedDiagramExtract}'s sensor count created for this diagram.
   */
  latestExtractSensorCount: int stored calc !exists(extracts[0]) ? 0 : latestExtract.numSensors

  /**
   * Collection of {@link ParsedAsset}s extracted by parsing the diagram.
   */
  assets: [ParsedAsset] (diagram)

  /**
   * Collection of {@link ParsedSensor}s associated with all the `extracts` of this diagram.
   */
  sensors: [ParsedSensor] (diagram)

  /**
   * {@link PhysicalAsset} relations associated with this diagram.
   */
  connectedAssetRelations: [ParsableDiagramToPhysicalAssetRelation](from)

  /**
   * The number of connected {@link PhysicalAsset}s.
   */
  numConnectedAssets: int calc count(connectedAssetRelations)

  /**
   * Information about the last tracked update to the P&ID done by a user.
   * Tracked updates include:
   *   verifying/unverifying {@link ParsedSensor}s,
   *   adding/deleting {@link ParsedSensor}s,
   *   connecting {@link PhysicalAsset}s
   */
  lastUpdate: ParsableDiagramUpdateInfo

  /**
   * Helper function to create the {@link imageFile} from {@link File}.
   */
  createImageFileFromFile: private member function()

  /**
   * Creates a {@link PhysicalAsset} if no asset with assetId found. Creates {@link ParsableDiagramToPhysicalAssetRelation} for this diagram and respective asset.
   */
  connectAssetToDiagram: member function(asset: PhysicalAsset) js-rhino

  /**
   * Helper that takes in the formfields and passes only the {@link PhysicalAsset} to `connectAssetToDiagram`
   */
  submitConnectForm: member function(formObject: json): ParsableDiagram js-rhino

  /**
   * Updates the names of both, the {@link ParsableDiagram} entity and its associated #imageFile.
   *
   * @param formObj
   *          Form contents. This object must contain a {@link ParsableDiagram} Id and the desired name for the entity.
   * @returns ParsableDiagram with updated name
   */
  updateDiagramAndImageNames: function(formObj: json): ParsableDiagram js-rhino

  /**
   * Deletes a diagram, along with the following associated types:
   *   {@link ParsedSensor}s,
   *   {@link ParsableDiagramToPhysicalAssetRelation}s
   */
  deleteBatch: function(diagrams: !?[mixing ParsableDiagram]): ObjList<mixing ParsableDiagram> js-rhino

  /**
   * Unverifies all {@link ParsedSensor}s on the latest extract of each {@link ParsableDiagram} passed into the function.
   * Unverification for a parsed sensor happens by setting the matched Sensor's `diagramParsedSensor` field to null.
   *
   * @param diagramIds
   *          Collection of {@link ParsableDiagram} Ids to inform which parsedSensors to unverify.
   */
  unverifySensorsOnLatestExtract: function(diagramIds: [string]) js-rhino

  /**
   * The status of diagram parsing for this diagram. If the diagram was uploaded without triggering the parsing job,
   * then the status will be set to {@link DiagramParsingStatus#NOT_PARSED}.
   * When the parsing job starts each diagram is updated with a status of {@link DiagramParsingStatus#IN_PROGRESS}.
   * Once the parsing job finishes, each diagram is updated with a status of {@link DiagramParsingStatus#PARSED}.
   */
  parsingStatus: string enum DiagramParsingStatus = DiagramParsingStatus.NOT_PARSED

  /**
   * A translated representation of {@link ParsableDiagram#parsingStatus} to be used in the UI.
   */
  displayStatus: string translate by parsingStatus
}
