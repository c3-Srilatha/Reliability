/**
 * Represents a predicted symbol in diagram parsing, including the predicted class label and confidence score.
 * @see DiagramParsingClassLabel
 */
@beta
type DiagramParsingPredictedSymbolType {
  /**
   * The predicted "class" of symbol from classifier. For example, a "TAG" or a "LMI"
   */
  classLabel: !string enum DiagramParsingClassLabel

  /**
   * The confidence/probability output from classifier
   */
  confidenceScore: !float
}
