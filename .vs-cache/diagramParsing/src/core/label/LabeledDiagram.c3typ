/**
 * Represents a {@link ParsableDiagram} with labeled bounding boxes.
 */
extendable entity type LabeledDiagram extends ParsableDiagram type key 'LBLD_DGRM' {

  /**
   * Bounding boxes contains all the label information and the location information
   */
  boxes: ![DiagramParsingBoundingBox] schema suffix "LBBX"

  /**
   * Bounding box contains all the label information and the location information
   */
  classToBoxes: private map<string, [DiagramParsingBoundingBox]> schema suffix "CLSTBX"

  /**
   * Check if a class label is present in the one of the bounding boxes
   */
  hasTarget: member function(target: !string): !boolean py

  /**
   * Convert the diagram to a numpy array.
   *
   * @param zoom the zoom factor for scaling the image. The default value is 1.0.
   */
  toArray: inline member function(zoom: double = 1.0): !native py-diagramparsing-cv

  /**
   * Rescale the image and bounding boxes and create a new entity of LabeledDiagram.
   *
   * @param zoom the zoom factor for scaling the image.
   * @param destImageUrl the destination url to save the rescaled image.
   */
  rescale: inline member function(zoom: double, destImageUrl: string): !LabeledDiagram py-diagramparsing-cv

  /**
   * Constructor method that combines a {@link ParsableDiagram} and an XML from image annotation
   * tools to form a unified {@link LabeledDiagram} with {@link boxes}
   *
   * @param diagram an existing {@link ParsableDiagram}
   * @param xml the text read from a XML file. For example, you can use the python code below to read
   * an xml file into text:
   * ```py
   * with open("./dummy.xml") as f: xml = f.read()
   * ```
   */
  fromXml: function(
    diagram: !ParsableDiagram,
    xml: !string
  ): !LabeledDiagram py-diagramparsing-xml

  beforeCreate: ~ py

  /**
   * Visualize the labeled diagram with bounding boxes
   */
  show: inline member function(targets: [string]) py-diagramparsing-cv
}
