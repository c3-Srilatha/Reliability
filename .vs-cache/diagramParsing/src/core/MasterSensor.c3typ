remix type MasterSensor {
  /**
   * Reference to {@link ParsedSensor} which has been verified against this {@link MasterSensor}.
   */
  diagramParsedSensor: ParsedSensor

  /**
   * Display name which attempts to use {@link MasterSensor#name name} field;
   * otherwise, uses the {@link MasterSensor#id id} field.
   */
  displayName: string stored calc exists(name) ? name : id;

  /**
   * A collection of all {@link ParsedSensor} instances that reference this {@link MasterSensor}
   * as their currently proposed sensor.
   *
   * This collection links this {@link MasterSensor} to all {@link ParsedSensor}s, including both
   * verified and unverified {@link ParsedSensor}s.
   */
  relatedParsedSensors: [ParsedSensor](actualSensor)
}
