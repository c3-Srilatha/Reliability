/**
 * This type represents a collection of {@link ParsableDiagram}s for which a parsing job is triggered.
 * An entity of this type is created upon starting the parsing job for the {@link ParsableDiagram}s.
 */
entity type UploadedParsableDiagramCollection {
  /**
   * The collection of {@link ParsableDiagram}s associated with this collection.
   */
  parsableDiagrams: ![ParsableDiagram]

  /**
   * The DS {@link Workflow.Run} triggered on the {@link #parsableDiagrams} in this collection.
   */
  workflowRun: Workflow.Run

  /**
   * Flag indicating whether user has dismissed a card notification corresponding to this `UploadedParsableDiagramCollection ` in the UI.
   * Used to handle hiding of card notifications from `ParsingJobsSidePanelCardList`, but still run the parsing job in background.
   * This flag is set to `true` when user dismisses a notification in the UI through {@link DismissParsingJobEpic}.
   */
  userDismissed: boolean = false

  /**
   * The number of {@link SourceParsableDiagram}s being tracked
   */
  numFiles: int calc count(parsableDiagrams)

  /**
   * The current status of the parsing job, populated by {@link #getParsingStatus}
   */
  parsingStatus: string enum ParsingStatusEnum = WAITING_IN_QUEUE

  /**
   * Gets the current {@link ParsingStatusEnum} of this file collection
   * The status depends on the `workflowRun` status.
   * @param returnInclude Any valid include spec is supported, the returned object has these fields in addition to `parsingStatus`
   * @returns this collection with updated `parsingStatus`.
   */
  getParsingStatus: member function(returnInclude: string): UploadedParsableDiagramCollection js-rhino

  /**
   * Returns UploadedParsableDiagramCollection fetchResult with latest parsingStatus
   * @param spec
   *        accepts {@link FetchSpec}
   * @returns {@link FetchResult} of UploadedParsableDiagramCollection with `parsingStatus` updated
   */
  fetchWithLatestStatus: function(spec: FetchSpec): !FetchResult<UploadedParsableDiagramCollection> js-rhino
}
