/**
 * Augmenter that can simulate a labeled image based on the original diagram.
 */
extendable entity type DiagramSimulator extends DiagramAugmenter type key 'SMLTR' {

  /**
   * Maximum number of elements appears on the simulated diagram image.
   */
  numElements: !int

  /**
   * Random scale range that each element is augmented by.
   * If not provided, use scale=1 by default.
   */
  scaleRange: [float]

   /**
   * Whether to use white background when generating simualtion images.
   */
  useWhiteBackground: boolean = false

  /**
   * The corresponding frequency for each target when doing simulation.
   * If nothing is provided, use the existing frequency of symbols on the raw diagram.
   */
  frequency: map<string, int>

  /**
   * Generate a single labeled image using parameters that can be changed in
   * runtime instead of just construction time.
   */
  generate: member function(
    diagram: !LabeledDiagram
  ): !LabeledImage py-diagramparsing-cv
}
