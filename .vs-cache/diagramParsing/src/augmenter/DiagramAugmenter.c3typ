/**
 * Augmenter that can generate augmented version of the original diagram and
 * enlarge the training set for the computer vision model training tasks.
 */
abstract extendable entity type DiagramAugmenter schema name 'DGRM_AGMT' {

  /**
   * The target classes the augmenter will be using. If nothing is provided here,
   * all the available classes in a labeled diagram will be used.
   */
  targets: [string enum DiagramParsingClassLabel]

  /**
   * Output shape of the augmented image
   */
  outputShape: ![int]

  /**
   * Generate a single labeled image using parameters that can be changed in
   * runtime instead of just construction time
   */
  generate: abstract member function(
    diagram: !LabeledDiagram
  ): !LabeledImage py
}
