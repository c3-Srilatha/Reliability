/**
 * Augmenter that can generate randomly cropped versions of the original diagram.
 */
extendable entity type DiagramRandomCropper extends DiagramAugmenter type key 'RNDM_CRP' {

  /**
   * Random zoom factor before applying random cropping on the diagram
   */
  zooms: ![float]

  /**
   * Generate a single labeled image using parameters that can be changed in
   * runtime instead of just construction time
   */
  generate: member function(
    diagram: !LabeledDiagram
  ): !LabeledImage py-diagramparsing-cv
}
