/**
 * Generates a PDF based on a {@link PdfGenerationSpec} and places it at {@link PdfGenerationSpec#url}.
 */
type PdfGenerator {

  /**
   * Generate a PDF according to the provided {@link PdfGenerationSpec}.
   *
   * @return the url in the C3 File System where the pdf is stored.
   */
  generatePdf: function(spec: !PdfGenerationSpec): File py-pdf_generation

  /**
   * Creates a {@link PdfComponentFieldSpec} component
   * @param fieldNames
   *    Names of each field in the spec
   * @param labelMap
   *    Map that links each label name with the text it displays
   * @param fillColor
   *    Hex color used to fill the fields in the definition list
   * @param fillType
   *    Specifies how to fill each field in the definition list
   */
  makePdfComponentFieldSpec: private function(fieldNames: ![string], labelMap: map<string, string>, fillColor: string, fillType: string): [PdfComponentFieldSpec] js-rhino
}
