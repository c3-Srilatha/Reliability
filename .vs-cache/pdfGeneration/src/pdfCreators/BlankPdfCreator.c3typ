/**
 * {@link PdfCreator} which returns a blank PDF from the FPDF2 python library.
 */
type BlankPdfCreator mixes PdfCreator {

  /**
   * Returns a blank PDF from the FPDF library.
   */
  createPdf: inline function(spec: PdfGenerationSpec): !native py-pdf_generation

}
