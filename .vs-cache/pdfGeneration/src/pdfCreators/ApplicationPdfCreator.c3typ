/**
 * Standard PDF creator to be used for SaaS applications.
 */
type ApplicationPdfCreator mixes PdfCreator, Config, Singleton {
  /**
   * Whether or not a timestamp should appear at the top right of each page.
   * When {@link PdfGenerationSpec#headerText} is provided and passed into {@link ApplicationPdfCreator#createPdf}
   * it will override includeTimestamp, and the headerText will appear at the top right instead
   */
  includeTimestamp: boolean

  /**
   * The path to the application logo image to display on the bottom left of each page. Path is relative to the resource directory in the {@Pkg.Store}.
   */
  applicationLogoImagePath: string

  /**
   * The path to the application logo image to display on the top left of each page. Path is relative to the resource directory in the {@Pkg.Store}.
   */
  applicationMainLogoImagePath: string

  /**
   * The font family of all the text in the pdf.
   * Ex. Helvetica
   */
  fontFamily: string

  /**
   * The font size of all the text in the {@link PdfComponent}s in the pdf.
   */
  fontSize: int

  /**
   * Function which creates an initial PDF for a SaaS application to be consumed by the {@link PdfGenerator}.
   */
  createPdf: inline function(spec: PdfGenerationSpec): !native py-pdf_generation

}
