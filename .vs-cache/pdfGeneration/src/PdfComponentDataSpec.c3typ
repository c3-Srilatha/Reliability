/**
 * Base component data spec that specifies the data to present in a {@link PdfComponent}.
 */
type PdfComponentDataSpec {

  /**
   * The Type that should be invoked to retrieve data for the {@link PdfComponent}.
   */
  dataType: !Type

  /**
   * The name of the action defined on {@link PdfComponentDataSpec#dataType}.
   */
  actionName: string

  /**
   * The arguments supplied to {@link PdfComponentDataSpec#actionName}. No arguments supplied
   * if not specified.
   */
  actionArgs: map<string, any> schema suffix 'AA'

  /**
   * Returns the actionName for the {@link PdfComponentDataSpec} by first looking at
   * {@link PdfComponentAdvancedDataSpec#actionName} and then {@link PdfComponentDataSpec#actionName}.
   *
   * Throws error if no actionName defined for the dataSpec.
   */
  getActionName: member function(): !string js-rhino

  /**
   * An advanced data spec that can be supplied in order to override the API that exists for
   * a {@link PdfComponent}. A {@link PdfComponent} and its {@link PdfComponentDataSpec}
   * will expect the {@link PdfComponentDataSpec#actionName} to take in at least the arguments specified by
   * its default action name. To avoid this, the {@link PdfComponentDataSpec#advancedDataSpec}
   * can be used.
   */
  advancedDataSpec: PdfComponentAdvancedDataSpec

  /**
   * Transforms a {@link PdfComponentDataSpec} into {@link PartiallyAppliedAction}s which will
   * subsequently be called in the {@link PdfComponent#renderComponent} function.
   */
  toPartiallyAppliedActions: member function(): [PdfPartiallyAppliedActionInfo] js-rhino

  /**
   * Called by {@link PdfComponentDataSpec#toPartiallyAppliedActions} if the specific
   * {@link PdfComponentDataSpec} has an advancedDataSpec specified.
   */
  toAdvancedPartiallyAppliedActions: member function(): [PdfPartiallyAppliedActionInfo] js-rhino

  /**
   * Function to send the {@link PdfComponentDataSpec} to {@link PartiallyAppliedAction}s that will
   * subsequently be applied to retrieve the data necessary for the {@link PdfComponent}.
   */
  componentPartiallyAppliedActions: abstract member function(): [PdfPartiallyAppliedActionInfo] js-rhino
}
