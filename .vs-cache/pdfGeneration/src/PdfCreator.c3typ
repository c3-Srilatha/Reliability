/**
 * Type should be extended to define a custom PdfCreator that has implemented the
 * {@link PdfCreator#createPdf} function.
 */
type PdfCreator {

  /**
   * Function which creates an initial PDF to be consumed by the {@link PdfGenerator}.
   *
   * @return the PDF created.
   */
  createPdf: abstract inline function(spec: PdfGenerationSpec): !native py-pdf_generation

}
