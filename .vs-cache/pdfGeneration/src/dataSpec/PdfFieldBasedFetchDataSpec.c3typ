/**
 * Extension of {@link PdfComponentDataSpec} that specifies data retrieval for an
 * {@link PdfComponent} using the fetch action.
 */
type PdfFieldBasedFetchDataSpec mixes PdfFieldBasedDataSpec {

  /**
   * The default actionName to use in the {@link PartiallyAppliedAction} returned by
   * {@link PdfFieldBasedFetchDataSpec#componentPartiallyAppliedActions}.
   */
  actionName: ~ = 'fetch'

  /**
   * Creates a {@link PartiallyAppliedAction} used to retrieve data for the {@link PdfComponent}.
   */
  componentPartiallyAppliedActions: ~ js-rhino
}
