/**
 * Specifies the common data retrieval arguments used in PDF Components.
 */
type PdfFieldBasedDataSpec mixes PdfComponentDataSpec {

  /**
   * List of {@link PdfComponentFieldSpec}s that specify the fields on the type
   * to display in the definition list.
   */
  fieldSpecs: ![PdfComponentFieldSpec]

  /**
   * Return an include string to be used in a get/fetch call.
   */
  getIncludeString: member function(): string js-rhino

  /**
   * @inheritdoc
   */
  componentPartiallyAppliedActions: abstract ~
}
