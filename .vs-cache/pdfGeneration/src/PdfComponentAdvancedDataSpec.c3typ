/**
 * Data Spec used to override the API generally used by an extending {@link PdfComponent}.
 * Allows input for the API to take any specified form in the calling action name.
 */
type PdfComponentAdvancedDataSpec {

  /**
   * The name of the action to be called on {@link PdfComponentDataSpec#dataType}.
   */
  actionName: !string

  /**
   * The arguments used to call {@PdfComponentAdvancedDataSpec#actionName}.
   */
  actionArgs: map<string, any> schema suffix 'AAA'
}
