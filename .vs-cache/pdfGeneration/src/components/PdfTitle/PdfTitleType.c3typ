/**
 * Title specific characteristics, including font size, alignment and font style
 */
type PdfTitleType mixes Metadata, Identified {

  /**
   * The font size of the title.
   */
  fontSize: !int

  /**
   * Whether to align the title to the center, left, or right of the page.
   */
  alignment: !string enum('C', 'L', 'R')

  /**
   * Sets the text font style
   * - B => Bold
   * - I => Italics
   * - U => Underline
   * - R => Regular (text without style)
   */
  style: !string enum('B', 'I', 'U', 'R')
}
