/**
 * A {@link PdfComponent} which adds title text to a PDF.
 */
type PdfTitle mixes PdfComponent {

  /**
   * The title text to add to the given PDF.
   */
  title: !string

  /**
   * Specification of the title characteristics like font, alignment and style
   */
  titleType: !PdfTitleType

  /**
   * Adds title text to the given PDF.
   */
  renderComponent: inline member function(pdf: !native) py-pdf_generation
}
