/**
 * Base configuration for all chart axes in PDF charts.
 */
type PdfChartAxisConfig {

  /**
   * The title of the chart axis.
   */
  title: !string

  /**
   * The text style of the chart axis title.
   */
  textConfig: PdfChartTextConfig

  /**
   * The rotation of the tick labels on the axis.
   */
  labelRotation: int = 0
}
