/**
 * Specifies the style of the text on a chart.
 */
enum type PdfChartFontStyleEnum {

  /**
   * Normal font style with no slant or emphasis.
   */
  NORMAL = 'normal'

  /**
   * Italic font style, typically slanted and used for emphasis.
   */
  ITALIC = 'italic'

  /**
   * Oblique font style, similar to italic but with a less stylized slant.
   */
  OBLIQUE = 'oblique'
}
