/**
 * Configuration for a piece of text in a chart such as a chart title or axis title.
 */
type PdfChartTextConfig {

  /**
   * The size of the text font.
   */
  fontSize: string enum PdfChartFontSizeEnum = MEDIUM

  /**
   * The style of the text font.
   */
  fontStyle: string enum PdfChartFontStyleEnum = NORMAL

  /**
   * The weight of the text font.
   */
  fontWeight: string enum PdfChartFontWeightEnum = NORMAL

  /**
   * The color of the text. can take ina string name of the color, hex-RGBA, and other formats.
   * See Matplotlib API for more information about color formatting of text.
   */
  color: string = 'black'
}
