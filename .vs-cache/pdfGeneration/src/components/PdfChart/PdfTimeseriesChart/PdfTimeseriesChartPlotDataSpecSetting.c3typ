/**
 * The style and data specification for a single timeseries plot in the {@link PdfTimeseriesChartDataSpec}.
 */
type PdfTimeseriesChartPlotDataSpecSetting {

  /**
   * The type the chart is plotting timeseries data for.
   */
  dataType: Type

  /**
   * The entity to evaluate the metric for.
   */
  entityId: !string

  /**
   * The metric to be called.
   */
  metricName: !string

  /**
   * The unit used in the metric evaluation.
   */
  unit: Unit

  /**
   * The legend label for the metric. Not used if `bindings` and `bindingsLegendLabels` is supplied.
   */
  legendLabel: !string

  /**
   * The bindings to pass into the metric call.
   */
  bindings: json

  /**
   * The legend labels for each set of bindings passed in.
   */
  bindingsLegendLabels: [string]

  /**
   * The colors to use in the plot for each set of bindings passed in.
   */
  bindingsColors: [string]

  /**
   * The kind of visualization to use for the timeseries plot.
   */
  visualizationType: !(PdfTimeseriesChartLineVisualization | PdfTimeseriesChartBarVisualization)

  /**
   * The color of the timeseries plot.
   */
  color: !string

  /**
   * The kind of metric call to make.
   */
  evaluateAction: string enum('EVAL', 'ROLLUP') = 'EVAL'

  /**
   * Rollup function options for collection fields.
   */
  aggregation: string enum('OR', 'AND', 'SUM', 'AVG', 'MEAN', 'MIN', 'MAX', 'MEDIAN', 'VARIANCE', 'STDDEV', 'PERCENTILE') = 'AVG'
}
