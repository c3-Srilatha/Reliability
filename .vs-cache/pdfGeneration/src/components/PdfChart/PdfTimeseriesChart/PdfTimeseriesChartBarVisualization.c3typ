/**
 * Style configuration for the bar plot for the timeseries chart.
 */
type PdfTimeseriesChartBarVisualization {

  /**
   * The width of the bars.
   */
  width: double = 0.8

  /**
   * How the bars align with the x-ticks.
   */
  align: string enum('center', 'edge') = 'center'
}
