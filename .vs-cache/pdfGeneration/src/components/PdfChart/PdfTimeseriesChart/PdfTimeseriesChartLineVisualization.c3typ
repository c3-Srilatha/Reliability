/**
 * Style configuration for the line plot for the timeseries chart.
 */
type PdfTimeseriesChartLineVisualization {

  /**
   * The width of the line.
   */
  lineWidth: int = 1

  /**
   * The marker at each timestep plotted. See Matplotlib API for the options.
   * <https://matplotlib.org/stable/api/markers_api.html#module-matplotlib.markers>
   */
  marker: string = ''

  /**
   * The size of the markers.
   */
  markerSize: int = 1

  /**
   * The style of line. See the Matplotlib API for the options.
   * <https://matplotlib.org/stable/api/_as_gen/matplotlib.lines.Line2D.html#matplotlib.lines.Line2D.set_linestyle>
   */
  lineStyle: string = '-'
}
