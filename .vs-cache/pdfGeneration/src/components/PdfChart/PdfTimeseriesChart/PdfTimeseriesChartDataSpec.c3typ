/**
 * The data specification for the {@link PdfTimeseriesChart}. Specifies the data to be plotted in the chart.
 */
type PdfTimeseriesChartDataSpec mixes PdfComponentDataSpec {

  /**
   * The start time of the data to be plotted.
   */
  start: !datetime

  /**
   * The end time of the data to be plotted.
   */
  end: !datetime

  /**
   * The interval to plot all of the metric data in the chart at.
   */
  interval: !string enum Interval

  /**
   * Whether or not the time zone should be converted to local browser time (i.e. if the event happened
   * at 1 AM EST then it will be displayed at 1 AM in the PDF if noTimeZoneConversion is false).
   */
  noTimeZoneConversion: boolean

  /**
   * The timeseries plots to be visualized in the chart.
   */
  plotSpecs: ![PdfTimeseriesChartPlotDataSpecSetting]

  /**
   * The time-based events to be plotted in the chart.
   */
  eventSpecs: [PdfTimeseriesChartEventDataSpecSetting]

  /**
   * Returns the {@link PartiallyAppliedAction}s to be called in the
   * {@link PdfTimeseriesChart#renderComponent} function to retrieve the metric results
   * to plot in the chart.
   */
  componentPartiallyAppliedActions: ~ js-rhino

  /**
   * Returns the {@link PdfPartiallyAppliedActionInfo}s relevant to the {@link PdfTimeseriesChartPlotDataSpecSetting}s
   * passed into the dataSpec.
   */
  partiallyAppliedPlotActions: member function(): ![PdfPartiallyAppliedActionInfo] js-rhino

  /**
   * Returns the {@link PdfPartiallyAppliedActionInfo}s relevant to the {@link PdfTimeseriesChartEventDataSpecSetting}s
   * passed into the dataSpec.
   */
  partiallyAppliedEventActions: member function(): [PdfPartiallyAppliedActionInfo] js-rhino

  /**
   * Uses a hash algorithm in order to generate unique hashes for all the metrics and bindings pairs passed into an
   * {@link EvalMetricsSpec} for the dataSpec.
   */
  generateEvalMetricResultKey: function(expression: string, values: map<string, any>): string js-rhino
}
