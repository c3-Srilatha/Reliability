/**
 * The main component for plotting timeseries charts through metrics and placing them in PDFs.
 */
type PdfTimeseriesChart mixes PdfBaseChart<PdfTimeseriesChartDataSpec> {

  /**
   * Adds a timeseries chart presentational component to the given PDF based on the
   * {@link PdfTimeseriesChartDataSpec}. Creates the chart through Maplotlib,
   * saves it as an image, and then adds the image to the PDF.
   */
  renderComponent: inline member function(pdf: !native) py-pdf_generation

  /**
   * Creates a PdfChartRenderer depending on the graphing library selected
   */
  withRenderLibrary: member function(): PdfChartRenderer py-pdf_generation
}
