/**
 * The style and data specification for a single event series plot in the {@link PdfTimeseriesChartDataSpec}.
 */
type PdfTimeseriesChartEventDataSpecSetting mixes PdfComponentDataSpec {

  /**
   * The default action is fetch for the event data spec.
   */
  actionName: ~ = 'fetch'

  /**
   * The label of the events in the legend of the chart.
   */
  legendLabel: !string

  /**
   * The color of the events.
   */
  color: !string

  /**
   * The style of the marker.
   */
  marker: string = 'v'

  /**
   * The size of the marker displayed.
   */
  markerSize: int = 1

  /**
   * The field on the `dataType` which will be used to display the events on the timeseries chart
   * and is filtered within the range of {@link PdfTimeseriesChartDataSpec#start} and {@link PdfTimeseriesChartDataSpec#end}.
   */
  timeField: !string

  /**
   * Returns the {@link PartiallyAppliedAction} corresponding to this event series.
   */
  componentPartiallyAppliedActions: ~ js-rhino
}
