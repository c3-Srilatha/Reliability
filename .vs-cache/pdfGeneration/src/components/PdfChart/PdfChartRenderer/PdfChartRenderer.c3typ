/**
 * Abstract type that provides methods for rendering a {@link PdfTimeseriesChart} into a PDF
 */
abstract type PdfChartRenderer {

  /**
   * Renders the timeseries chart in the pdf by calling the rest of the chart configuration methods
   * @param chartComponent
   *     PDF component where all chart configurations are stored
   * @param pdf
   *     PDF file where the timeseries will be renderer
   */
  render: abstract inline member function(chartComponent: !PdfTimeseriesChart, pdf: !native) py-pdf_generation

  /**
   * Plots evaluation metrics based on the given specifications.
   * @param figure
   *    A Figure object containing the configured chart.
   * @param dataSpec
   *    Data specifications.
   * @param action
   *    Action containing evaluation metric information.
   * @param dataToPlot
   *    Data to be plotted.
   */
  plotEvalMetrics: private member function(figure: native, dataSpec: PdfTimeseriesChartDataSpec, action: PdfPartiallyAppliedActionInfo, dataToPlot: EvalMetricsResult) py-pdf_generation

  /**
   * Plots event data on the x-axis based on the given specifications.
   * @param figure
   *    A Figure object containing the configured chart.
   * @param dataSpec
   *    Data specifications.
   * @param numFetchPlotted
   *    Number of fetched data already plotted.
   * @param dataToPlot
   *    Data to be plotted.
   */
  plotEventData: abstract private member function(figure: native, dataSpec: PdfTimeseriesChartDataSpec, numFetchPlotted: int, dataToPlot: FetchResult) py-pdf_generation

  /**
   * Plots visualization data based on the given specifications.
   * @param figure
   *    A Figure object containing the configured chart.
   * @param data
   *    Data to be plotted.
   * @param plotSpec
   *    Plot specifications.
   * @param color
   *    Color of the plot.
   * @param label
   *    Label of the plot.
   */
  plotVisualization: abstract private member function(figure: native, data: any, plotSpec: PdfTimeseriesChartPlotDataSpecSetting, color: string, label: string) py-pdf_generation
}
