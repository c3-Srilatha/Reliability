/**
 * The type that defines the base chart configuration for charts made in Matplotlib.
 */
type PdfBaseChart<PCDS: PdfComponentDataSpec> mixes PdfComponent<PCDS> {

  /**
   * Graphing library used to generate the chart
   */
  plottingLibrary: string enum('matplotlib') = 'matplotlib'

  /**
   * Title configuration for the chart.
   */
  titleConfig: PdfChartTitleConfig

  /**
   * Size configuration for the chart.
   */
  chartSizeConfig: !PdfChartSizeConfig

  /**
   * X-axis configuration for the chart.
   */
  xAxisConfig: PdfChartXAxisConfig

  /**
   * Y-axis configuration for the chart.
   */
  yAxisConfig: PdfChartYAxisConfig

  /**
   * Legend configuration for the chart.
   */
  legendConfig: PdfChartLegendConfig

  /**
   * @inheritdoc
   */
  renderComponent: abstract ~
}
