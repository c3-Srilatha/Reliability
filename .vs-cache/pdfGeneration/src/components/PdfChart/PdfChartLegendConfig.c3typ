/**
 * Configuration of the legend for a chart in the PDF.
 */
type PdfChartLegendConfig {

  /**
   * Number of columns for the legend labels.
   */
  ncol: int = 1

  /**
   * Location of the legend on the chart.
   */
  location: string enum PdfChartLegendLocationEnum = UPPER_RIGHT

  /**
   * Style configuration for the text in the legend.
   */
  textConfig: PdfChartTextConfig
}
