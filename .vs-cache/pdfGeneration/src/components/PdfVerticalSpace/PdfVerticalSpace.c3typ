/**
 * A {@link PdfComponent} which adds empty vertical spaces to a PDF.
 */
type PdfVerticalSpace mixes PdfComponent {

  /**
   * Number of empty vertical units to added to a pdf.
   */
  units: int = 50

  /**
   * Adds empty lines to a component.
   */
  renderComponent: inline member function(pdf: !native) py-pdf_generation
}
