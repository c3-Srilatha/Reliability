/**
 * A {@link PdfComponent} used by {@link PdfDefinitionList} and {@link PdfMultiDefinitionList} to
 * place a definition list in a PDF.
 */
type PdfBaseDefinitionList<PCDS: PdfComponentDataSpec> mixes PdfComponent<PCDS> {

  /**
   * Places a definition list on the supplied PDF.
   */
  renderDefinitionList: inline member function(pdf: !native, obj: !Obj) py-pdf_generation

  /**
   * @inheritdoc
   */
  renderComponent: abstract ~

}
