/**
 * {@link PdfComponent} that adds multiple definition lists to a PDF. Uses {@link PdfBaseDefinitionList#renderDefinitionList}
 * to add each definition list to the PDF.
 */
type PdfMultiDefinitionList mixes PdfBaseDefinitionList<PdfFieldBasedFetchDataSpec> {

  /**
   * Adds multiple defintion list presentational components to the given PDF based on the
   * {@link PdfFieldBasedFetchDataSpec#fieldSpecs}.
   */
  renderComponent: inline member function(pdf: !native) py-pdf_generation

}
