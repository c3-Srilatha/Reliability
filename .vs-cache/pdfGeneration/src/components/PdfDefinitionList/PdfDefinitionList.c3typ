/**
 * {@link PdfComponent} that adds a definition list to a PDF. Uses {@link PdfBaseDefinitionList#renderDefinitionList}
 * to add the list.
 */
type PdfDefinitionList mixes PdfBaseDefinitionList<PdfFieldBasedDataSpec> {

  /**
   * Data to be shown in the definition list. If this field is specified, the data spec
   * action will not be applied.
   */
  data: json

  /**
   * Adds a definition list presentational component to the given PDF based on the
   * {@link PdfFieldBasedGetDataSpec#fieldSpecs}.
   */
  renderComponent: inline member function(pdf: !native) py-pdf_generation
}
