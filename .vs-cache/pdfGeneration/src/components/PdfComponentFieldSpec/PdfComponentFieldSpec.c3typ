/**
 * Base PDF spec that specifies the information about a field in a {@link PdfComponent}.
 */
type PdfComponentFieldSpec {

  /**
   * The name of the field on a type that is used inside a {@link PdfComponent}.
   */
  fieldName: !string

  /**
   * The label used to display on the field in the {@link PdfComponent}.
   */
  label: string

  /**
   * The text to display in the component field if no value is present for the {@link PdfComponentFieldSpec#fieldName}.
   */
  placeholder: string = '-'

  /**
   * Specifies the color and how to fill the color for each field.
   */
  colorSpec: PdfComponentFieldColorSpec

  /**
   * Takes in an object and returns the data in it defined by the {@link PdfComponentFieldSpec#fieldName}s
   * passed in.
   */
  getObjFieldData: function(obj: !any, fieldSpecs: ![PdfComponentFieldSpec]): ![any] js-rhino
}
