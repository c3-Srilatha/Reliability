/**
 * Specifies the data retrieval arguments used by {@link PdfDataGrid}.
 */
type PdfDataGridDataSpec mixes PdfFieldBasedFetchDataSpec {

  /**
   * List of {@link PdfDataGridFieldSpec}s that specify the fields on the type
   * to display in the definition list.
   */
  fieldSpecs: ![PdfDataGridFieldSpec]
}
