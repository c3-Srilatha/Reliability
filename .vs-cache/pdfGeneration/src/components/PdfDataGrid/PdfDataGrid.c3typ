/**
 * {@link PdfComponent} that adds a data grid to a PDF.
 */
type PdfDataGrid mixes PdfComponent<PdfDataGridDataSpec> {

  /**
   * Data to be shown in the grid. This should be If a list of objects whose attributes match the columns specified in the data spec.
   * When this field is specified, the data spec action will not be applied.
   */
  data: json

  /**
   * Adds a data grid presentational component to the given PDF based on the
   * {@link PdfDataGridDataSpec#fieldSpecs}.
   */
  renderComponent: inline member function(pdf: !native) py-pdf_generation

}
