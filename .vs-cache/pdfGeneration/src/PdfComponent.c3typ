/**
 * Base PDF Component which represents a presentational unit that can be added to a PDF document.
 */
type PdfComponent<PCDS: PdfComponentDataSpec> {

  /**
   * The {@link PdfComponentDataSpec} which specifies the data to be displayed in the {@link PdfComponent}.
   */
  dataSpec: !PCDS

  /**
   * Function which consumes a PDF (an FPDF Python object) and has logic to add a presentational component to that PDF.
   */
  renderComponent: abstract inline member function(pdf: !native) py-pdf_generation

}
