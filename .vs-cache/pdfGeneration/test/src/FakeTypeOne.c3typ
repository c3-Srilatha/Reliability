/**
 * Type needed in order to evaluate some metrics for the {@link PdfTimeseriesChart}.
 */
entity type FakeTypeOne mixes FeatureEvaluatable schema name 'FK_TPE_ONE' {

  /**
   * The children of the type, needed for tsDecl metrics.
   */
  children: [FakeTypeTwo](parent)
}
