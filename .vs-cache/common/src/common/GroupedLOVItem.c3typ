/**
 * `GroupedLOVItem` is an entity that extends the `LOVItem` type and is used to represent a grouped list 
 * of values, where each item is associated with a parent of type `T`.
 */
entity type GroupedLOVItem<T> extends LOVItem type key 'GLOV' {

  /**
   * `parent`: The parent item associated with this grouped list of values. 
   * The type of the parent is defined as `T`, which can be any valid type.
   */
  parent: T
}
