/**
 * Defines a numerical value that can be used with time series data points where
 * timereseries header holds {treatment} of the value
 */
type MonetaryAmount {

  /**
   * The numerical value of the monetary amount.
   *
   * The treatment of this value is determined by the parent time series header.
   */
  @ts(treatmentPath='parent.treatment')
  amount: decimal
}
