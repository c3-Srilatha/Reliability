/**
 * Entity type `RecursiveLOVItem` represents a recursive list of values (LOV) item that can have
 * a parent and children of the same type. The recursive structure allows nesting of LOV items.
 * The parametric type T represents the type of the parent and children items.
 */
entity type RecursiveLOVItem<T> extends LOVItem type key 'RLOV' {

  /**
   * `parent`: Represents the parent item of the current LOV item.
   * It is of type `T` and defines a relationship between items in the recursive structure.
   */
  parent:   T

  /**
   * `children`: Represents the child items of the current LOV item.
   * It is an array of items of type `T`, allowing for recursive nesting.
   */
  children: [T](parent)
}
