/**
 * `ContactUrl` type is used to represent a contact method with a specific name (such as 'Web site' or 'E-mail') 
 * and a location (the actual URL or email address).
 */
type ContactUrl {

  /**
   * `name`: The type of contact method. It is an enum with values like 'Web site' or 'E-mail'.
   */
  name:     !string enum('Web site', 'E-mail')

  /**
   * `location`: The location associated with the contact method, either a URL or an email address.
   */
  location: !string
}
