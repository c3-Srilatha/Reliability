/**
 * A set of filter values and column visibility settings for a {@link UiApFilterBar}.
 */
entity type UiApFilterBar.View {
  /**
   * The id of the {@link UiApFilterBar} that this view is associated with.
   */
  filterBarId: !string

  /**
   * Whether this view is the default view for the {@link UiApFilterBar}.
   */
  isDefault: boolean

  /**
   * The display name of this view. This is shown to users when selecting or managing views.
   */
  name: !string

  /**
   * The saved filter values for this view. This JSON object stores the state of all filters
   * that were applied when this view was saved, allowing users to restore the exact filtering
   * configuration.
   */
  filterValue: !json

  /**
   * The column visibility settings for this view. This JSON object stores which columns
   * are shown or hidden in the associated grid when this view is applied. Only used when
   * the filter bar is connected to a grid via {@link UiApFilterBar#gridId}.
   */
  columnVisibility: json

  beforeCreate: ~ js-rhino
  beforeUpdate: ~ js-rhino

}
