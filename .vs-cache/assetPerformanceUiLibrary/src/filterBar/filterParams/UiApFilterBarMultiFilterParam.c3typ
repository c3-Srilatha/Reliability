/**
 * {@link UiSdlMultiDynamicValueParam} that allows the resolution of multiple filter values at once.
 * Once resolved, the filters are `AND`ed together.
 *
 * Used by dynamic value specs to drive queries based on UI filter state.
 */
@typeScript
type UiApFilterBarMultiFilterParam mixes UiSdlMultiDynamicValueParam {

  /**
   * Map of params that should all resolve to a filter string. These filters are `AND`ed together.
   */
  params: ~
  extract: ~ ts-client
}
