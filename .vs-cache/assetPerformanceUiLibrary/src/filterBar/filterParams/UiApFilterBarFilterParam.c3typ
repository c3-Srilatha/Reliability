/**
 * Parameters for reading a specific filter value from a filter bar.
 * Used by dynamic value specs to drive queries based on UI filter state.
 */
type UiApFilterBarFilterParam mixes UiSdlDynamicValueSpecParam {
  /**
   * Extraction expression used to transform the resolved value.
   * Leave unset for default behavior provided by the consumer.
   */
  extract: ~
  /**
   * Identifier of the filter bar providing the filter value.
   * Should match the `id` of the corresponding `UiApFilterBar`.
   */
  filterBarId: string
  /**
   * Name of the filter field as defined in the filter bar configuration.
   */
  filterField: string
  /**
   * Key identifying the specific option/value within the filter field.
   * For multi-select fields, this can reference which selected value to read.
   */
  filterKey: string


}
