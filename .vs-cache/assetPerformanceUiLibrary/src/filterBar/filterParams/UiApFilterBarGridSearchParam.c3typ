/**
 * Parameters used to extract grid selection or search context for a filter bar.
 * Mixed with `UiSdlDynamicValueSpecParam` to support dynamic value resolution.
 */
type UiApFilterBarGridSearchParam mixes UiSdlDynamicValueSpecParam {
  /**
   * Extraction expression used to transform the resolved value.
   * Leave unset to use the default extractor defined by the consumer.
   */
  extract: ~
  /**
   * Identifier of the filter bar to read values from.
   * Should match the `id` of the corresponding `UiApFilterBar`.
   */
  filterBarId: string
  /**
   * Identifier of the grid whose selection or search state should be read.
   */
  gridId: string

}
