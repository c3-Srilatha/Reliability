/**
 * A section of the add filters modal of a {@link UiApFilterBar}.
 *
 * See {@link UiApFilterBar#allFiltersLayout} for more information.
 */
type UiApFilterBar.AllFiltersLayoutSection {
  /**
   * The title of the section. Should be a translation key.
   */
  title: string

  /**
   * The ordered list of filter keys to display in the section. This
   * must be a key into the {@link UiApFilterBar#filterConfigs} map.
   */
  filters: [string]
}
