/**
 * Card component to hold configuration and display individual card in {@link UiApCardGrid}.
 */
type UiApCardConfig {

  /**
   * The unique identifier for the card.
   */
  id: string

  /**
   * The title of the card.
   */
  titleField: string

  /**
   * The description of the card.
   */
  descriptionField: string

  /**
   * icon Config when every card has different icon and icon color
   * Ex:
   * iconConfig: {
   *   "field": "name", // field or expression whose value is used to lookup in mapping
   *   "mapping": {
   *     "Pump-001": { "icon": "sitemap", "color": "" },
   *     "Compressor-A1": { "icon": "bolt", "color": "" }
   *   }
   * }
   */
  iconConfig: json

  /**
   * Tags associated with the card.
   * Renders in the bottom of the card.
   */
  tagFields: [string]

  /**
   * button for the card actions.
   */
  actionButton: UiSdlAction

  /**
   * Configurable list field
   */
  configurableListField: [string]

  /**
   * support Tag
   * renders on the top right corner of the card
   */
  supportTagField: string

  /**
   * The color of the support tag.
   * Specifies the color to display tags based on supportTagField value. The key is the data value, and the corresponding value is a color.
   */
  supportTagIndicatorMapping: map<string, string>

  /**
   * if the card is selectable or not
   */
  selectable: boolean = true

}
