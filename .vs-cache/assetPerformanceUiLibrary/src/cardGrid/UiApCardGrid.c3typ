/**
 * Card grid component to display a collection of card components defined in {@link UiApCardConfig} in a grid layout.
 */
type UiApCardGrid mixes UiSdlComponent<UiSdlNoData> {

  /**
   * Data store id to fetch cards from.
   */
  dataStoreId: string

  /**
   * The list of cards to display in the UiApCardGrid.
   */
  cardConfig: UiApCardConfig

  /**
   * The number of columns to display in the grid.
   */
  numColumns: int

  /**
   * The name of the field in the data store that holds the currently selected card's ID.
   */
  dataStorePathForSelectedCard: string

  /**
   * The name of the field in the data store that holds the card data.
   */
  dataStorePathForCardData: string

}
