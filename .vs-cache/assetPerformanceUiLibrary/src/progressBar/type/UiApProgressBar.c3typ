/**
 * A full-page progress bar component that polls an API for progress updates.
 * The component displays overall progress and individual step statuses.
 */
@typeScript
type UiApProgressBar mixes UiSdlComponent<UiSdlNoData> {
  /**
   * The data store ID that provides polling data for the progress bar.
   * The datastore should be a {@link UiApDataStore} that provides data for polling.
   */
  dataStoreId: string

  /**
   * The polling interval in milliseconds.
   */
  pollingInterval: int

  /**
   * The title to display at the top of the progress bar.
   */
  title: string

  /**
   * The subtitle/description text to display below the title.
   */
  subtitle: string

  /**
   * The text for the back button.
   */
  backButtonText: string

  /**
   * The overall failure message to display when the process fails.
   */
  failureMessage: string

  /**
   * Whether to show the failed reason for individual steps when they fail.
   */
  showFailedReason: boolean = false

  /**
   * The current progress data received from polling.
   * If the `dataStoreId` is not provided, this will be the only source of progress data. Will be used as a fallback.
   */
  progressData: UiApProgressResponse
}
