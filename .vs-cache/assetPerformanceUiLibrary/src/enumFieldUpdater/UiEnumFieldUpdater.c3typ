/**
 * Enum field updater component for updating enum fields of an entity.
 *
 * This component provides a dropdown for selecting and updating the value of an enum field
 * on a specified entity. It retrieves available enum options and the current value from a
 * {@link UiApDataStore}, and triggers an update action when the user selects a new value.
 */
@typeScript
type UiEnumFieldUpdater mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The key to the enum options in the {@link UiApDataStore#actionMap}.
   * The {@link UiApDataStore} is specified by {@link #dataStoreId}.
   * This key is used to retrieve the available enum options for the field.
   */
  dataStorePathForEnumOptions: string

  /**
   * The key in the {@link UiApDataStore#actionMap} that points to the current value of the enum field for the entity.
   * This value is used to display the currently selected option in the dropdown.
   * The {@link UiApDataStore} is specified by {@link #dataStoreId}.
   */
  dataStorePathForCurrentValue: string

  /**
   * The key in the {@link UiApDataStore#actionMap} that specifies the action to update the enum field value for the entity.
   * This action is triggered when the user selects a new value from the dropdown.
   * The {@link UiApDataStore} is specified by {@link #dataStoreId}.
   */
  dataStorePathForUpdateValue: string

  /**
   * The name of the enum field within the entity that will be updated.
   */
  fieldName: string

  /**
   * The data store id to use for the enum updater.
   */
  dataStoreId: string

  /**
   * The translation key prefix for enum option display texts.
   */
  translationKey: string

  /**
   * The placeholder text to display in the dropdown when no value is selected.
   */
  placeholder: string
}
