/**
 * User settings for {@link UiApTimeseriesChart}s.
 */
@config(minOverride=USER, maxOverride=USER)
type UiApTimeseriesChartUserConfig mixes Config, UserSingleton {

  /**
   * The minimum height in pixels for plots in {@link UiApTimeseriesChart}s.
   */
  minPlotHeight: int = 200

  /**
   * Whether to show the series name in the tooltip when hovering over the plot area.
   */
  showSeriesNameInTooltip: boolean = true
}
