/**
 * Represents shaded time ranges for the {@link UiApTimeseriesChart}.
 * This is used to highlight specific time periods in the chart background with a colored overlay.
 */
type UiApTimeseriesChartShadedTimeRanges {
  /**
   * The time ranges to shade in the chart.
   */
  timeRanges: ![TimeRange]

  /**
   * The label to show for the shaded time ranges. This can be a translation key.
   */
  label: !string

  /**
   * The color to use for shading the time ranges.
   */
  color: !string

}
