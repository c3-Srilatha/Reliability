/**
 * Represents a dataset for events to be plotted in a {@link UiApTimeseriesChart}.
 */
type UiApTimeseriesChartEventDataset {
  /**
   * The data to be directly used as a ECharts dataset. The shape is the following:
   * ```
   * {
   *   "source": <array of event objects>
   * }
   */
  data: json

  /**
   * The label that will be used by any series that use this dataset.
   */
  label: string

  /**
   * The field that represents the time of the event. Use to determine the x value of each event
   * point in the chart.
   */
  timestampField: string

  /**
   * An array of pairs of strings that determines the field labels for this event dataset.
   * These both determine what is shown in the tooltip when hovering an event and the labels
   * for the values in the tooltip.
   */
  fieldLabels: [[string]]

}
