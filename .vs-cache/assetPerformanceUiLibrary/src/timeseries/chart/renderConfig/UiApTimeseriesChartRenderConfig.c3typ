/**
 * Determines how a {@link UiApTimeseriesChart} should render its data.
 */
type UiApTimeseriesChartRenderConfig {

  /**
   * Represents the series to be plotted in the chart.
   * Each series is a mapping of data to a plot, with configurations for how to display the data.
   */
  series: [UiApTimeseriesChartSeriesConfig]

  /**
   * The plots to be displayed in the chart. Allows the splitting of the chart into multiple plots.
   */
  plots: [UiApTimeseriesChartPlotConfig]
}
