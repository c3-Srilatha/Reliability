/**
 * Configuration for Y-axis layout
 */
type UiApTimeseriesChartYAxisLayoutConfig {
  /**
   * Offset for multiple Y-axes in pixels
   */
  offset: double

  /**
   * Buffer percentage for axis range calculation
   */
  bufferPercentage: double

  /**
   * Width of Y-axis labels in pixels
   */
  labelWidth: double

  /**
   * Margin for Y-axis labels in pixels
   */
  labelMargin: double

  /**
   * Gap between Y-axis and its name in pixels
   */
  nameGap: double

  /**
   * Width of Y-axis dataZoom in pixels
   */
  dataZoomWidth: double

  /**
   * Font size of Y-axis labels in pixels
   */
  labelFontSize: double

  /**
   * Margin between Y-axis labels and Y-axis dataZoom in pixels
   */
  dataZoomMargin: double
}
