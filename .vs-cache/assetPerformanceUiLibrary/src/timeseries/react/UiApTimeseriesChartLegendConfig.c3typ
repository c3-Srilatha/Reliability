/**
 * Configuration for legend layout
 */
type UiApTimeseriesChartLegendConfig {
  /**
   * Height of legend in pixels
   */
  height: double

  /**
   * Top margin above legend in pixels
   */
  topMargin: double

  /**
   * Height of individual legend items in pixels
   */
  itemHeight: double

  /**
   * Width of individual legend items in pixels
   */
  itemWidth: double

  /**
   * Default colors to use for legend items. These colors will be used cyclically
   * when no specific color is provided for a series.
   */
  defaultColors: [string] = [
    '#8A90AB',
    '#2266F0',
    '#26BFC9',
    '#B073FF',
    '#8C316E',
    '#7DBA92',
    '#99606A',
    '#057C87',
    '#F7B5E4',
    '#9E933F',
    '#6932BA',
    '#395C45',
  ]
}
