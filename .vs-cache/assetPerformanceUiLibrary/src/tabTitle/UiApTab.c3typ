/**
 * Configurable component for individual tabs related to {@link UiApTabTitle}.
 */
type UiApTab {

  /**
   * The name of the tab.
   */
  name: string

  /**
   * The icon to display for the tab.
   */
  icon: string

  /**
   * The url for the tab.
   */
  url: string

  /**
   * Indicates whether the tab is disabled.
   */
  disabled: boolean = false

  /**
   * Tooltip text to display when the tab is disabled.
   */
  disabledToolTip: string

}
