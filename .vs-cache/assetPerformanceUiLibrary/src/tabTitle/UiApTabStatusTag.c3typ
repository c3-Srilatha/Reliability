/**
 * Configurable component for the status tag for a {@UiApTabTitle}.
 */
type UiApTabStatusTag {

  /**
   * The label of the tab status Tag.
   */
  label: string

  /**
   * The icon to display for the tab status tag.
   */
  icon: string

  /**
   * The tooltip text to display for the tab status tag.
   */
  labelToolTip: string
}
