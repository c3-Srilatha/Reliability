/**
 * Configurable component for displaying tab action Buttons related to a {@UiApTabTitle}.
 */
type UiApTabActionButton {

  /**
   * The label of the button.
   */
  label: string

  /**
   * The action suffix for the action button.
   */
  actionSuffix: string

  /**
   * The icon suffix for the action button.
   */
  iconSuffix: string

  /**
   * The action button type.
   */
  variant: string enum('primary', 'secondary', 'link', 'danger', 'danger-secondary', 'danger-link', 'icon-with-text', 'icon') = 'primary'

  /**
   * The tooltip text to display for the action button.
   */
  tooltip: string

  /**
   * Whether the action button is disabled.
   */
  disabled: boolean = false

}
