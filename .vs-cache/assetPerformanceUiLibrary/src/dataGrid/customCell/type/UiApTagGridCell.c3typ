/**
 * A grid cell that displays a tag based on the cell's value.
 */
type UiApTagGridCell mixes UiSdlDataGridCell {

  /**
   * Mapping from value of the field to the desired tag configuration.
   */
  valueToTagMapping: map<string, UiApTagGridCellConfig>
}
