/**
 * @inheritdoc UiApDataStore
 *
 * Implements {@link UiApTimeseriesChart}-specific data store helpers.
 */
type UiApTimeseriesDataStore mixes UiApDataStore {

  /**
   * Creates an action to remove the indicated plots and all associated series.
   * If `clearTsDataset` is true, the related data in `tsDataset` will also be cleared.
   *
   * @param id - The id of the application state to clear the plots from.
   * @param plotIds - The IDs of the plots to clear.
   * @param clearTsDataset - If true, the related data in `tsDataset` will also be cleared.
   * @return - Redux action of type `CLEAR_PLOTS`.
   */
  @uiSdlActionCreator(actionType='CLEAR_PLOTS')
  clearPlotsAction: function(id: !string, plotIds: ![string], clearTsDataset: boolean): !UiSdlReduxAction ts-client

  /**
   * Reducer that listens for action of type `CLEAR_PLOTS` and removes the indicated plots, all associated series,
   * and, optionally, the related data in `tsDataset`.
   *
   * @param state - Redux state.
   * @param action - Redux action.
   * @return - Redux state with cleared plots.
   */
  @uiSdlReducer(actionType='CLEAR_PLOTS')
  clearPlotsReducer: function(state: !UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Creates an action to remove the indicated dimensions from `tsDataset` and related labels, units and source data.
   *
   * @param id - The id of the application state to clear the dimensions from.
   * @param dimensions - The dimensions to remove from `tsDataset`.
   * @return - Redux action of type `CLEAR_DIMENSIONS`.
   */
  @uiSdlActionCreator(actionType='CLEAR_DIMENSIONS')
  clearDimensionsAction: function(id: !string, dimensions: ![string]): !UiSdlReduxAction ts-client

  /**
   * Reducer that listens for action of type `CLEAR_DIMENSIONS` and removes the indicated dimensions from `tsDataset`.
   *
   * @param state - Redux state.
   * @param action - Redux action.
   * @return - Redux state with cleared dimensions in tsDataset.
   */
  @uiSdlReducer(actionType='CLEAR_DIMENSIONS')
  clearDimensionsReducer: function(state: !UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxState ts-client
}
