/**
 * Demo asset criticality level classification for UI testing.
 *
 * This type defines the criticality levels used to categorize demo assets
 * in the Asset Performance UI library. Levels determine maintenance priority
 * and monitoring requirements.
 *
 *
 * // Create critical level
 * UiApDemoAssetLevel.make({
 *   name: "Critical"
 * }).create()
 *
 * // Create normal level
 * UiApDemoAssetLevel.make({
 *   name: "Normal"
 * }).create()
 */
entity type UiApDemoAssetLevel {
  /**
   * The name of the criticality level (e.g., "Critical", "High", "Normal", "Low").
   * Used for display purposes and level identification in UI components.
   */
  name: string
}
