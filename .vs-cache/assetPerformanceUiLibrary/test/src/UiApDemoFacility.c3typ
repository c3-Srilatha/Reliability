/**
 * Demo facility entity for UI testing and demonstration purposes.
 *
 * This type represents a simplified facility model used in the Asset Performance UI library
 * for testing organizational structures and facility-based filtering.
 *
 *
 * // Create a demo facility
 * UiApDemoFacility.make({
 *   name: "Plant Alpha"
 * }).create()
 *
 * // Create another facility
 * UiApDemoFacility.make({
 *   name: "Plant Beta"
 * }).create()
 */
entity type UiApDemoFacility {
  /**
   * Human-readable name identifier for the facility.
   * Used for display purposes and facility identification in UI components.
   */
  name: string

  /**
   * Status of the facility.
   */
  status: UiApDemoAssetStatusEnum
}
