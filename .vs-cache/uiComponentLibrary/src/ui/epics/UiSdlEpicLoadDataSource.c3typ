/**
 * Async effect for loading a data source. Useful for loading a data source in response to an action. This async effect
 * expects the following parameters in the action payload:
 *    dataSourceToLoad: the name of the data source to load
 *    dataSourceArgs: any arguments to merge into the data source before loading it.
 */
@typeScript
type UiSdlEpicLoadDataSource mixes UiSdlEpic {

  epic: ~ ts-client
}
