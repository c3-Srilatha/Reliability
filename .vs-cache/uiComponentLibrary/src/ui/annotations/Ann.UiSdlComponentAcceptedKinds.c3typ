/**
 * Annotation to show accepted kinds of UI component of the field.
 */
@annotation(appliesTo=['field'])
@typeScript
type Ann.UiSdlComponentAcceptedKinds mixes Annotation {

  /**
   * The categories of components that this field accepts (may be dropped into).
   */
  includeCategories: [string]

  /**
   * The attributes of components that this field accepts (only components with these attributes may be dropped).
   */
  includeAttributes: [string]
}
