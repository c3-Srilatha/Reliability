/**
 * Configuration type for group of actions for a UI component.
 */
@typeScript
type UiSdlActionGroup mixes UiSdlAction {

  /**
   * If true, show a spinner over the button.
   */
  loading: private boolean

  /**
   * Optional dropdown content to display when table action button is clicked.
   */
  dropdownContent: [UiSdlAction]
}
