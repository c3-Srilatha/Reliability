/**
 * Spec used by UIAsyncEffectRedirect#generateUrl.
 */
@typeScript
type UiSdlUrlPayloadSpec {

  /**
   * The base url to redirect to.
   */
  url: string

  /**
   *  The additional parameters to append to the url.
   *
   * ```json
   *    paramName: {
   *      excludeName: boolean,
   *      element: string
   *    }
   * ```
   */
  params: map<string, UiSdlUrlParamSpec>

  /**
   * When true redirect to the previous page. Url and params will be ignored in this case.
   */
  back: boolean
}
