/**
 * Configuration type for actions for a UI component.
 */
@typeScript
type UiSdlAction {

  /**
   * The name of the Redux action to be triggered.
   * When this action is clicked a Redux action will be triggered with this action suffix.
   */
  actionSuffix: string

  /**
   * The type of icon to render.
   */
  iconSuffix: string

  /**
   * The human readable name of the action to display as text.
   */
  name: string

  /**
   * The arguments for the action.
   */
  args: json

  /**
   * Whether the action is currently triggerable.
   */
  disabled: boolean

  /**
   * Where an error will be placed by epicRegistry if one is found. Will be undefined or false if there is no error.
   */
  error: boolean | Error

  /**
   * Condition in which the action should appear disabled. If specified, takes precedence over {@link #disabled}.
   * If both {@link #disabledCondition} and {@link #hiddenCondition} are specified, the action will be hidden if
   * {@link hiddenCondition} is true.
   */
  disabledCondition: UiSdlRenderCondition

  /**
   * The tooltip to display when the action is disabled
   */
  disabledTooltip: string serialized UiSdlDynamicValueSpec

  /**
   * Condition in which the action should be hidden.
   * If both {@link #disabledCondition} and {@link #hiddenCondition} are specified, the action will be hidden if
   * {@link hiddenCondition} is true.
   */
  hiddenCondition: UiSdlRenderCondition
}
