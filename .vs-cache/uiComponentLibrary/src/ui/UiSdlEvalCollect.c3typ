/**
* The type to use {@link FeatureEvaluatable}.eval().toEvalMetricsResult() and {@link EvalMetricsResultBase}.toPeriod()
* in a single server call.
*/
type UiSdlEvalCollect {

  /**
   * The period to convert to.
   */
  period: Period | string serialized Period

  /**
   * Aggregation function per metric if we are merging features in this set by aggregating or disaggregating on given
   * period. If not provided, will choose default agg function of SUM
   * Example for multiple metrics with different agg function: {"metric1": "SUM", "metric2": "AVG"}
   */
  periodAggregationStrategy: map<string, string serialized AggOp> | string serialized AggOp

  /**
   * Helper function to validate the period string.
   */
  validatePeriod: function(period: string serialized Period): Period js-server
  /**
   * A wrapper function to pass in period and agg arguments to {@EvalMetricsResultBase.toPeriod} function.
   * See more docs from the platform type.
   */
  evalMetricsResultAndToPeriod: function (spec: EvalSpec, type: Type, period: Period | string serialized Period, aggregationStrategy: map<string, string> | string): EvalMetricsResult js-server
}
