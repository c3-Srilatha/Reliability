/**
 * Transform {@link Data} to {@link UiSdlChartData}.
 */
@typeScript
type UiSdlTransformDataToUiSdlChartData mixes UiSdlDataTransform<Data, UiSdlChartData> {

  /**
   * Override abstract function to transform {@link Data} to {@link UiSdlChartData}.
   */
  transform: function(data: !Data): UiSdlChartData ts-client

  /**
   * Generate unique series id being used by SDLChart.
   *
   * @param id
   *        Source id.
   * @param projectionName
   *        Projection name the series is used for.
   *
   * @return Unique series id used by SDLChart.
   */
  generateSeriesId: function(id: !string, metricName: !string, bindingsSuffix: string = ''): string ts-client

  /**
   * Generate a string interval from two adjacent timestamp labels
   */
  getIntervalFromTimestamps: function(timestamp1: !string, timestamp2: !string): string ts-client

   /**
   * Convert the number of milliseconds between two timestamps to an interval
   */
  getIntervalFromMS: function(milliseconds: !number): string ts-client
}
