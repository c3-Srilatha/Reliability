/**
 * Transform {@link UiSdlChartData} to {@link UiSdlChartEChartConfig}.
 */
@typeScript
type UiSdlTransformUiSdlChartDataToEChartConfig mixes UiSdlDataTransform<UiSdlChartData, UiSdlChartEChartConfig> {

  /**
   * Override abstract function to transform {@link UiSdlChartData} to {@link UiSdlChartEChartConfig}.
   *
   * Each {@link UiSdlChartDataSeries} will be transformed into a {@link UiSdlChartEChartSeries}.
   *
   * All series will be assigned to an axis ({@link UiSdlChartEChartAxis}) based on the {@link Unit} of its data. Multiple
   * series that share units will also share an axis (e.g. if two series use 'kWh' as their units, they will both use
   * the 'kWh' axis). All series with unitless data will share an axis with the id "unitless".
   */
  transform: function(data: !UiSdlChartData): UiSdlChartEChartConfig ts-client
}
