/**
 * Type to represent a content frame.
 */
@typeScript
@uiComponentCategorizer(name='Content frame', category='Patterns')
type UiSdlContentFrame mixes UiSdlComponent<UiSdlNoData> {
  /**
   * Whether or not to show the top bar of the content frame.
   */
  showTop: boolean = true

  /**
   * The component for the top bar. We accept UiSdlContentFrameTopBar or UiSdlContentFrameTopBarSegmented.
   */
  topBar: UiSdlComponentRef<UiSdlContentFrameTopBarBase>

  /**
   * Configuration for bottom bar.
   */
  bottomBar: UiSdlComponentRef<UiSdlContentFrameBottomBar>

  /**
   * Whether or not to show the bottom bar.
   */
  showBottom: boolean = true

  /**
   * Whether or not the content frame should wrap the whole page.
   * Global indicates that all of the content in the page is scrollable and will take up the screen's view height
   * Local indicates that the content frame will only wrap the content passed into it (not scrollable)
   * Default is global
   */
  coverage: string enum('global', 'local') = 'global'

  /**
   * The content to be framed by the Content Frame.
   */
  content: [UiSdlGridContainer | UiSdlComponentContainer]
}
