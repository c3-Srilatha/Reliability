/**
 * Type to represent a the top bar of a {@link UiSdlContentFrame}.
 */
@typeScript
type UiSdlContentFrameTopBarBase mixes UiSdlComponentTitle {
  /**
   * An icon to appear on the left side of the title.
   */
  iconSuffix: string

  /**
   * Whether or not to make the title editable. Adds icon to the right of the title.
   */
  editableTitle: boolean = false

  /**
   * Color of the bar in any valid CSS format
   */
  color: string serialized Color | string = 'colorBgPrimaryWeak'

  /**
   * Action for setting the color of the content frame top bar.
   *
   * @param id
   *            Id of the component.
   * @param color
   *            The string for the color.
   * @returns A `CONTENT_FRAME_TOP_COLOR_SET` action for this instance.
   */
  @uiSdlActionCreator(actionType='CONTENT_FRAME_TOP_COLOR_SET')
  setContentFrameTopColorAction: function(id: string, color: string): !UiSdlContentFrameTopColorSetAction ts-client

  /**
   * Action for setting the title of the content frame.
   *
   * @param id
   *            Id of the component.
   * @param title
   *            The DynamicValueSpec for the title.
   * @returns A `CONTENT_FRAME_TITLE_SET` action for this instance.
   */
  @uiSdlActionCreator(actionType='CONTENT_FRAME_TITLE_SET')
  setContentFrameTitleAction: function(id: string, title: UiSdlDynamicValueSpec): !UiSdlContentFrameTitleSetAction ts-client

  /**
   * Action for setting the icon of the content frame.
   *
   * @param id
   *            Id of the component.
   * @param icon
   *            The string for the icon.
   * @returns A `CONTENT_FRAME_ICON_SET` action for this instance.
   */
  @uiSdlActionCreator(actionType='CONTENT_FRAME_ICON_SET')
  setContentFrameIconAction: function(id: string, icon: string): !UiSdlContentFrameIconSetAction ts-client

  /**
   * Listens for actions of type `CONTENT_FRAME_TOP_COLOR_SET` and sets the {@link #color} state
   * to the payload values.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='CONTENT_FRAME_TOP_COLOR_SET')
  contentFrameTopColorSetReducer: private function(state: !UiSdlReduxState,
                                     action: !UiSdlContentFrameTopColorSetAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `CONTENT_FRAME_TITLE_SET` and sets the {@link #title} state
   * to the payload values.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='CONTENT_FRAME_TITLE_SET')
  contentFrameTitleSetReducer: private function(state: !UiSdlReduxState,
                                     action: !UiSdlContentFrameTitleSetAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `CONTENT_FRAME_ICON_SET'` and sets the {@link #iconSuffix} state
   * to the payload values.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='CONTENT_FRAME_ICON_SET')
  contentFrameIconSetReducer: private function(state: !UiSdlReduxState,
                                     action: !UiSdlContentFrameIconSetAction): !UiSdlReduxState ts-client
}
