/**
 * Type to represent a top bar of a {@link UiSdlContentFrame}.
 */
@typeScript
@uiComponentCategorizer(name='Content frame top bar segmented', category='Patterns')
type UiSdlContentFrameTopBarSegmented mixes UiSdlComponent<UiSdlNoData>, UiSdlContentFrameTopBarBase {
  /**
   * Actions to appear on the right side of the top bar.
   */
  segments: [UiSdlContentFrameTopBarSegment]
}
