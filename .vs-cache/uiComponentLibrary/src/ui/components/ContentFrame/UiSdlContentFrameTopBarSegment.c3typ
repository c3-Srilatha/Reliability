/**
 * Type to represent a the top bar of a {@link UiSdlContentFrame}.
 */
@typeScript
type UiSdlContentFrameTopBarSegment mixes UiSdlComponentTitle {
  /**
   * Actions to appear on the right side of the top bar.
   * We expect one of these components: UiSdlTextField, UiSdlAtomicSegmentedButton, UiSdlSingleSearch, UiSdlMultipleSearch
   */
  items: [UiSdlComponentContainer]
}
