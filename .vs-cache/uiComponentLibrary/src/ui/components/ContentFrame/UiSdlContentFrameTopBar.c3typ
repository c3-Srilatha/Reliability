/**
 * Type to represent a the top bar of a {@link UiSdlContentFrame}.
 */
@typeScript
@uiComponentCategorizer(name='Content frame top bar', category='Patterns')
type UiSdlContentFrameTopBar mixes UiSdlComponent<UiSdlNoData>, UiSdlContentFrameTopBarBase, UiSdlComponentSubtitle {
  /**
   * Actions to appear on the right side of the top bar.
   */
  actions: [UiSdlComponentRef<UiSdlAtomicButton>]

  /**
   * Map to show/hide action on the right side of the top bar.
   * This config will be used as a reference to whether show or hide the actions of the top bar.
   * If no `actionsVisibilityMap` is provided, all `actions` will be shown by default.
   * If an action is not provided to the map and it exists in the `actions` array,
   * that action will be shown by default.
   *
   * Have the following configuration as an example:
   * ```
   * "actions": [
   *  { "id": "SDLDemo.TextDangerGhostLarge" },
   *  { "id": "SDLDemo.IconArrow" },
   *  { "id": "SDLDemo.LoadingPrimaryOutlineMedium" }
   * ],
   * "actionsVisibilityMap": {
   *  "SDLDemo.IconArrow": true,
   *  "SDLDemo.TextDangerGhostLarge": false
   * }
   * ```
   * The `SDLDemo.IconArrow` and `SDLDemo.LoadingPrimaryOutlineMedium` actions will be shown,
   * while the `SDLDemo.TextDangerGhostLarge` action will be hidden.
   *
   */
  actionsVisibilityMap: map<string, boolean> = {}

  // TODO: implement UiAtomicToggle and UiAtomicDateTimeInput and add to this list
  /**
   * Input group to appear on the left side of the top bar. Maximum 8 inputs.
   */
  inputs: [UiSdlComponentRef<UiSdlTextField | UiSdlAtomicSegmentedButton | UiSdlSingleSearch | UiSdlMultipleSearch>] = []

  /**
   * Map to show/hide inputs of the top bar.
   * This config will be used as a reference to whether show or hide the inputs of the top bar.
   * If no `inputsVisibilityMap` is provided, all `inputs` will be shown by default.
   * If an input is not provided to the map and it exists in the `inputs` array,
   * that input will be shown by default.
   *
   * Have the following configuration as an example:
   * ```
   * "inputs": [
   *  { "id": "SDLDemo.TextFieldLg" },
   *  { "id": "SDLDemo.TopBarSegmentedButton" },
   *  { "id": "SDLDemo.TopBarTextInput" },
   *  { "id": "SDLDemo.TopBarSegmentedButton" }
   * ],
   * "inputsVisibilityMap": {
   *   "SDLDemo.TopBarTextInput": false,
   *   "SDLDemo.TextFieldLg": true
   * }
   * ```
   * The `SDLDemo.TextFieldLg` and `SDLDemo.TopBarSegmentedButton` inputs will be shown,
   * while the `SDLDemo.TopBarTextInput` input will be hidden.
   *
   */
  inputsVisibilityMap: map<string, boolean> = {}

  /**
   * Action for setting the subtitle of the content frame.
   *
   * @param id
   *            Id of the component.
   * @param subtitle
   *            The DynamicValueSpec for the subtitle.
   * @returns A `CONTENT_FRAME_SUBTITLE_SET` action for this instance.
   */
  @uiSdlActionCreator(actionType='CONTENT_FRAME_SUBTITLE_SET')
  setContentFrameSubtitleAction: function(id: string, subtitle: UiSdlDynamicValueSpec): !UiSdlContentFrameSubtitleSetAction ts-client

  /**
   * Action to show/hide a corresponding input of the content frame.
   *
   * @param id
   *            Id of the component.
   * @param componentInputId
   *            Input Id of the component to be shown or hidden.
   * @param flag
   *            The boolean value to decide whether the componentInputId is going to be shown or hidden.
   * @returns A `CONTENT_FRAME_TOGGLE_INPUTS_VISIBILITY` action for this instance.
   */
  @uiSdlActionCreator(actionType='CONTENT_FRAME_TOGGLE_INPUTS_VISIBILITY')
  toggleInputsVisibilityContentFrameAction: function(id: !string, componentInputId: !string, flag: !boolean): !UiSdlContentFrameToggleInputsVisibilityAction ts-client

  /**
   * Action to show/hide a corresponding action of the content frame.
   *
   * @param id
   *            Id of the component.
   * @param componentActionId
   *            Action Id of the component to be shown or hidden.
   * @param flag
   *            The boolean value to decide whether the componentActionId is going to be shown or hidden.
   * @returns A `CONTENT_FRAME_TOGGLE_ACTIONS_VISIBILITY` action for this instance.
   */
  @uiSdlActionCreator(actionType='CONTENT_FRAME_TOGGLE_ACTIONS_VISIBILITY')
  toggleActionsVisibilityContentFrameAction: function(id: !string, componentActionId: !string, flag: !boolean): !UiSdlContentFrameToggleActionsVisibilityAction ts-client

 /**
   * Listens for actions of type `CONTENT_FRAME_SUBTITLE_SET` and sets the {@link #subtitle} state
   * to the payload values.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='CONTENT_FRAME_SUBTITLE_SET')
  contentFrameSubtitleSetEffect: private function(state: !UiSdlReduxState,
                                     action: !UiSdlContentFrameSubtitleSetAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `CONTENT_FRAME_TOGGLE_INPUTS_VISIBILITY`
   * and shows or hides a corresponding input of the content frame.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='CONTENT_FRAME_TOGGLE_INPUTS_VISIBILITY')
  contentFrameToggleInputsVisibilityReducer: private function(state: !UiSdlReduxState,
                                     action: !UiSdlContentFrameToggleInputsVisibilityAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `CONTENT_FRAME_TOGGLE_ACTIONS_VISIBILITY`
   * and shows or hides a corresponding action of the content frame.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='CONTENT_FRAME_TOGGLE_ACTIONS_VISIBILITY')
  contentFrameToggleActionsVisibilityReducer: private function(state: !UiSdlReduxState,
                                     action: !UiSdlContentFrameToggleActionsVisibilityAction): !UiSdlReduxState ts-client
}
