/**
 * Payload for a {@link UiSdlContentFrameToggleLeftButtonsVisibilityAction} and {@link UiSdlContentFrameToggleRightButtonsVisibilityAction}.
 */
type UiSdlContentFrameToggleButtonsVisibilityPayload mixes UiSdlComponentActionPayload {

  /**
   * The name of the buttonId to toggle.
   */
  buttonId: string

  /**
   * The boolean value to whether show or hide the button.
   */
  toBeRendered: boolean
}
