/**
 * Type to represent the bottom bar of a {@link UiSdlContentFrame}
 */
@typeScript
@uiComponentCategorizer(name='Content frame bottom bar', category='Patterns')
type UiSdlContentFrameBottomBar mixes UiSdlComponent<UiSdlNoData> {
  /**
   * The buttons that will appear on the left side of the bottom bar.
   */
  leftButtons: [UiSdlComponentRef<UiSdlAtomicButton>]

  /**
   * Map to show/hide buttons on the left bottom side of the bottom bar.
   * This config will be used as a reference to whether show or hide the left buttons of the bottom bar.
   * If no `leftButtonsVisibilityMap` is provided, all `leftButtons` will be shown by default.
   * If a leftButton is not provided to the map and it exists in the `leftButtons` array,
   * that leftButton will be shown by default.
   *
   * Have the following configuration as an example:
   * ```
   * "leftButtons": [
   *  { "id": "SDLDemo.TextDangerGhostLarge" },
   *  { "id": "SDLDemo.IconArrow" },
   *  { "id": "SDLDemo.LoadingPrimaryOutlineMedium" }
   * ],
   * "leftButtonsVisibilityMap": {
   *  "SDLDemo.TextDangerGhostLarge": false
   * },
   * ```
   * The `SDLDemo.IconArrow` and `SDLDemo.LoadingPrimaryOutlineMedium` inputs will be shown,
   * while the `SDLDemo.TextDangerGhostLarge` button will be hidden.
   *
  */
  leftButtonsVisibilityMap: map<string, boolean> = {}

  /**
   * The buttons that will appear on the right side of the bottom bar.
   */
  rightButtons: [UiSdlComponentRef<UiSdlAtomicButton>]

  /**
   * Map to show/hide buttons on the right bottom side of the bottom bar.
   * This config will be used as a reference to whether show or hide the right buttons of the bottom bar.
   * If no `rightButtonsVisibilityMap` is provided, all `rightButtons` will be shown by default.
   * If a rightButton is not provided to the map and it exists in the `rightButtons` array,
   * that rightButton will be shown by default.
   *
   * Have the following configuration as an example:
   * ```
   * "rightButtons": [
   *  { "id": "SDLDemo.TextDangerGhostLarge" },
   *  { "id": "SDLDemo.IconArrow" },
   *  { "id": "SDLDemo.LoadingPrimaryOutlineMedium" }
   * ],
   * "rightButtonsVisibilityMap": {
   *  "SDLDemo.TextDangerGhostLarge": false
   * },
   * ```
   * The `SDLDemo.IconArrow` and `SDLDemo.LoadingPrimaryOutlineMedium` inputs will be shown,
   * while the `SDLDemo.TextDangerGhostLarge` button will be hidden.
   *
  */
  rightButtonsVisibilityMap: map<string, boolean> = {}

  /**
   * Color of the bar in any valid CSS format.
   */
  color: string serialized Color | string = 'colorBgPrimaryWeak'

  /**
   * Action for setting the color of the content frame bottom bar.
   *
   * @param id
   *            Id of the component.
   * @param color
   *            The string for the color.
   * @returns A `CONTENT_FRAME_BOTTOM_COLOR_SET` action for this instance.
   */
  @uiSdlActionCreator(actionType='CONTENT_FRAME_BOTTOM_COLOR_SET')
  setContentFrameBottomColorAction: function(id: string, color: string): !UiSdlContentFrameBottomColorSetAction ts-client

  /**
   * Action to show/hide a corresponding left button of the content frame.
   *
   * @param id
   *            Id of the component.
   * @param componentButtonId
   *            Button Id of the component to be shown or hidden.
   * @param flag
   *            The boolean value to decide whether the componentInputId is going to be shown or hidden.
   * @returns A `CONTENT_FRAME_TOGGLE_LEFT_BUTTONS_VISIBILITY` action for this instance.
   */
  @uiSdlActionCreator(actionType='CONTENT_FRAME_TOGGLE_LEFT_BUTTONS_VISIBILITY')
  toggleLeftButtonsVisibilityContentFrameAction: function(id: !string, componentButtonId: !string, flag: !boolean): !UiSdlContentFrameToggleLeftButtonsVisibilityAction ts-client

  /**
   * Action to show/hide a corresponding right button of the content frame.
   *
   * @param id
   *            Id of the component.
   * @param componentButtonId
   *            Button Id of the component to be shown or hidden.
   * @param flag
   *            The boolean value to decide whether the componentInputId is going to be shown or hidden.
   * @returns A `CONTENT_FRAME_TOGGLE_RIGHT_BUTTONS_VISIBILITY` action for this instance.
   */
  @uiSdlActionCreator(actionType='CONTENT_FRAME_TOGGLE_RIGHT_BUTTONS_VISIBILITY')
  toggleRightButtonsVisibilityContentFrameAction: function(id: !string, componentButtonId: !string, flag: !boolean): !UiSdlContentFrameToggleRightButtonsVisibilityAction ts-client

  /**
   * Listens for actions of type `CONTENT_FRAME_BOTTOM_COLOR_SET` and sets the {@link #color} state
   * to the payload values.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='CONTENT_FRAME_BOTTOM_COLOR_SET')
  contentFrameBottomColorSetEffect: private function(state: !UiSdlReduxState,
                                     action: !UiSdlContentFrameBottomColorSetAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `CONTENT_FRAME_TOGGLE_LEFT_BUTTONS_VISIBILITY`
   * and shows or hides a corresponding left button of the content frame.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='CONTENT_FRAME_TOGGLE_LEFT_BUTTONS_VISIBILITY')
  contentFrameToggleLeftButtonsVisibilityReducer: private function(state: !UiSdlReduxState,
                                     action: !UiSdlContentFrameToggleLeftButtonsVisibilityAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `CONTENT_FRAME_TOGGLE_RIGHT_BUTTONS_VISIBILITY`
   * and shows or hides a corresponding left button of the content frame.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='CONTENT_FRAME_TOGGLE_RIGHT_BUTTONS_VISIBILITY')
  contentFrameToggleRightButtonsVisibilityReducer: private function(state: !UiSdlReduxState,
                                     action: !UiSdlContentFrameToggleRightButtonsVisibilityAction): !UiSdlReduxState ts-client
}
