/**
 * Type representing the header of a tooltip for {@link UiSdlDiagramViewer}
 */
type UiSdlDiagramViewerTooltipHeader {
  /**
   * Title of the tooltip
   */
  title: string | UiSdlDynamicValueSpec | UiSdlFieldBasedDataSpecSetting
  
  /**
   * Subtitle of the tooltip
   */
  subtitle: string | UiSdlDynamicValueSpec | UiSdlFieldBasedDataSpecSetting
  
  /**
   * Icon to be to the left of the title. Color will match the addOn color
   */
  icon: string | UiSdlFieldBasedDataSpecSetting
}
