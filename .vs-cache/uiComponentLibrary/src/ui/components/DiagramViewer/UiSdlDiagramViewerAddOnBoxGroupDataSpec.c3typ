/**
 * A specification for an individual addOn or group of addOns on a {@link UiSdlDiagramViewer},
 * that will all be of rectangular shape, grabbing the fields specified at UiSdlDiagramAddonBox
 */
@typeScript
type UiSdlDiagramViewerAddOnBoxGroupDataSpec mixes UiSdlDiagramViewerAddOnGroupBaseDataSpec {

  /**
   * The setting to get heights for the rectangles
   */
  height: UiSdlFieldBasedDataSpecSetting

  /**
   * The setting to get widths for the rectangles
   */
  width: UiSdlFieldBasedDataSpecSetting

  /**
   * The setting to get border colors for the rectangles
   */
  borderColor: UiSdlFieldBasedDataSpecSetting | string
}
