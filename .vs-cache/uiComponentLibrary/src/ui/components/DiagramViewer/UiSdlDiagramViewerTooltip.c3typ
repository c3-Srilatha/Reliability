/**
 * Type representing a tooltip to appear for addOns on a {@link UiSdlDiagramViewer}
 */
type UiSdlDiagramViewerTooltip {
  /**
   * The configuration for the header of the tooltip
   */
  header: UiSdlDiagramViewerTooltipHeader
  
  /**
   * The fields to display on the tooltip
   */
  fields: [UiSdlDiagramViewerTooltipField]
}
