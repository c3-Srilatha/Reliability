/**
 * Type to represent a diagram parser.
 */
@typeScript
@uiComponentCategorizer(name='Diagram viewer', category='Patterns')
type UiSdlDiagramViewer mixes UiSdlComponent<UiSdlDiagramViewerDataSpec>{
  @uiSdlDataSpec(dataDestinationField='data')
  dataSpec: ~

  /**
   * Holds the data to display in the diagram viewer.
   */
  data: Obj

  /**
   * The specification used to retrieve addOns to be displayed.
   *
   * An addOn is something that will be placed on top of the diagram. They come in 3 varieties: boxes/rectangles, dots, and text.
   * Each can have a tooltip as well as hover/click interactions.
   */
  @uiSdlDataSpec(dataDestinationField='addOns')
  addOnDataSpec: UiSdlDiagramViewerAddOnDataSpec

  /**
   * The x coordinate for the top left of what should show in the initial state of the diagram
   * Likely to be used when focused on a specific addOn
   */
  startX: number

  /**
   * Message to be displayed if there is an issue loading a file.
   */
  extraErrorMessage: string | UiSdlDynamicValueSpec

  /**
   * The y coordinate for the top left of what should show in the initial state of the diagram
   * Likely to be used when focused on a specific addOn
   */
  startY: number

  /**
   * The id of an addOn to be the only addOn showing.
   */
  emphasizedAddonId: private string

  /**
   * The list of ids/groups of addOns to hide
   */
  hiddenSeries: private [string] = []

  /**
   * Width of the diagram in percentage. Not putting a width will default to 100% width.
   */
  width: int | double = 100

  /**
   * Height of the diagram in pixels.
   */
  height: int = 500

  /**
   * The interaction event that triggers a tooltip on an addOn
   */
  tooltipInteraction:  string enum('click', 'hover') = 'click'

  /**
   * Id of the addOn to focus on when the diagram loads in, setting the diagram to show this addOn in the center.
   */
  focusedAddOnId: string | UiSdlDynamicValueSpec

  /**
   * Configuration for zooming
   */
  zoom: !UiSdlDiagramViewerZoomConfig

  /**
   * Position for 'zoom-in', 'zoom-out', 'reset' buttons
   */
  controllerPosition: string enum('bottom-right', 'top-right', 'bottom-left', 'top-left') = 'bottom-right'

  /**
   * Whether or not to show a legend
   */
  legend: boolean = false

  /**
   * The criteria for grouping addOns on the legend.
   * 'color' will group addOns based on color.
   * 'shape' will group addOns based on shape (box, text, dot).
   * 'colorAndShape' will group addOns based on both color and shape (ex. 'dot-blue').
   * 'all' will group addOns based on their id.
   */
  legendStrategy: string enum('color', 'shape', 'colorAndShape', 'all') = 'color'

  /**
    * The component id to be displayed when the diagram is empty.
    */
  emptyState: UiSdlComponentRef<UiSdlEmptyState>

  doDataMerge: ~ ts-client

  /**
   * Triggered to update the hidden addOns.
   *
   * @param id
   *           Id of the component.
   * @param addOnIds
   *           List of ids for the addOns or groups of addOns to hide
   * @param mergeWithExisting
   *           Whether or not to add these to the existing hidden addOns
   *
   * @return A `HIDDEN_ADDON_UPDATE` action for this instance with the following properties:
   * - payload [string] The ids/group names of addOns to hide.
   */
  @uiSdlActionCreator(actionType='HIDDEN_ADDON_UPDATE')
  updateHiddenAddonAction: function(id: string,
                                    addOnIds: [string],
                                    mergeWithExisting: boolean): UiSdlHiddenAddonUpdateAction ts-client

  /**
   * Triggered when an addOn is clicked.
   *
   * @param id
   *           Id of the component.
   * @param addOnId
   *           The Id for the addOn that was clicked
   *
   * @return A `ADDON_CLICK` action for this instance with the following properties:
   * - payload string of the id addOn that was clicked
   */
  @uiSdlActionCreator(actionType='ADDON_CLICK')
  clickAddonAction: function(id: string,
                              addOnId: string) : UiSdlAddonClickAction ts-client

  /**
   * Triggered to emphasize an addOn
   *
   * @param id
   *           Id of the component.
   * @param addOnId
   *           The Id for the addOn to emphasize and focus (meaning it will also center the diagram view on this addOn)
   *
   * @return A `EMPHASIZE_ADDON` action for this instance with the following properties:
   * - payload string of the id addOn to emphasize
   */
  @uiSdlActionCreator(actionType='EMPHASIZE_ADDON')
  emphasizeAddonAction: function(id: string,
                                  addOnId: string): UiSdlAddonEmphasizeAction ts-client

  /**
   * Triggered to focus on an addon
   *
   * @param id
   *           Id of the component.
   * @param newAddOnId
   *           The Id for the addOn to focus
   *
   * @return A `UPDATE_FOCUSED_ADDON` action for this instance with the following properties:
   * - payload string of the id addOn to focus
   */
  @uiSdlActionCreator(actionType='UPDATE_FOCUSED_ADDON')
  updateFocusedAddonAction: function(id: string,
                                      newAddOnId: string): UiSdlUpdateFocusedAddonAction ts-client

  /**
   * Triggered when an addOn is hovered.
   *
   * @param id
   *           Id of the component.
   * @param addOnId
   *           The Id for the addOn that was hovered
   *
   * @return A `ADDON_HOVER` action for this instance with the following properties:
   * - payload string of the id addOn that was hovered
   */
  @uiSdlActionCreator(actionType='ADDON_HOVER')
  hoverAddonAction: function(id: string,
                              addOnId: string): UiSdlAddonHoverAction ts-client

  /**
   * Updates the focusedAddOnId in the redux state of the component
   */
  @uiSdlReducer(actionType='UPDATE_FOCUSED_ADDON')
  focusedAddonUpdateReducer: private function(state: UiSdlReduxState,
                                              action: UiSdlUpdateFocusedAddonAction): UiSdlReduxState ts-client



  /**
   * Updates the focusedAddOnId and emphasizedAddonId in the redux state of the component
   */
  @uiSdlReducer(actionType='EMPHASIZE_ADDON')
  addOnEmphasizeReducer: private function(state: UiSdlReduxState,
                                              action: UiSdlAddonEmphasizeAction): UiSdlReduxState ts-client

  /**
   * Updates the hiddenSeries in the redux state of the component
   */
  @uiSdlReducer(actionType='HIDDEN_ADDON_UPDATE')
  hiddenAddonUpdateReducer: private function(state: UiSdlReduxState,
                                              action: UiSdlHiddenAddonUpdateAction): UiSdlReduxState ts-client

  /**
   * Creates a mapping from event specification indices in {@link #eventDataSpec}
   * to data source ids. Used by {@link #doDataMerge} to merge data into the props
   * in a way that's easy to match with the corresponding configuration.
   */
  getIndexedAddOnDataSourceIds: private function(componentId: string,
                                                 state: UiSdlReduxState): map<int, string> ts-client

  /**
   * Given a data source id, return the index of the corresponding {@link UiSdlTimeseriesLineBarChartEventSeriesDataSpec}
   * in {@link UiSdlTimeseriesLineBarChartEventDataSpec#events}.
   * If the data source id is not for an event, returns `null`.
   */
  getAddOnDataSourceIndex: private function(dataSourceId: string): int

}
