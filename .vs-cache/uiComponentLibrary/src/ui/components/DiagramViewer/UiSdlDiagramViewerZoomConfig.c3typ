/**
 * Type representing the configuration of zooming in a {@link UiSdlDiagramViewer}
 */
type UiSdlDiagramViewerZoomConfig {
  /**
   * The initial zoom on the diagram, where 1 is 100% scale and 1.5 is 150% scale.
   * startingZoom should be greater than {@link UiSdlDiagramViewerZoomConfig#minZoom} and less than {@link UiSdlDiagramViewer#maxZoom}
   * Must be a number greater than 0.
   */
  @constraint(condition='startingZoom > 0')
  startingZoom: double = 1
  
  /**
   * The maximum amount to allow zooming in.
   * Must be a number greater than 0.
   */
  @constraint(condition='maxZoom > 0')
  maxZoom: double
  
  /**
   * The minimum amount of zoom to allow (.1 = 1/10th scale)
   * Must be a number greater than or equal to 0. Having it equal 0 will mean there is no min zoom.
   */
  @constraint(condition='minZoom >= 0')
  minZoom: double = 0.1
  
  /**
   * The zoom multiplier where newScale = oldScale * zoomMultiplier for zooming in and 
   * oldScale / zoomMultiplier for zooming out
   */
  @constraint(condition='zoomMultiplier > 1')
  zoomMultiplier: double = 1.1
}
