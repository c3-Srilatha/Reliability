/**
 * A specification that describes which addOns (if any) should be included
 * on this diagram.
 */
@typeScript
type UiSdlDiagramViewerAddOnDataSpec mixes UiSdlFieldBasedDataSpec {

  /**
   * Converts the data spec to an array of partially applied actions.
   */
  toPartiallyAppliedActions: ~ ts-client

  /**
   * Filter string to filter fetched events.
   */
  filter: string

  /**
   * A list of specifications for different event series.
   */
  addOns: [UiSdlDiagramViewerAddOnBoxGroupDataSpec | UiSdlDiagramViewerAddOnDotGroupDataSpec | UiSdlDiagramViewerAddOnTextGroupDataSpec]

  /**
   * The path for finding the addOns within the action result.
   */
  dataPath: string = 'objs'

  /**
   * The specification for the addOn tooltips UiSDlDiagramViewerTooltip
   */
  tooltip: UiSdlDiagramViewerTooltip

  /**
   * How individual addOn group's tooltips should interact with the tooltip configured here.
   *
   * merge means that the individual group's header will be respected (if one exists) and all fields will be shown from both this configuration and the group's config
   * if no individual group header is configured, the header from here will be used.
   *
   * standalone means that each group should only care about the tooltip configuration in that group's dataSpec
   */
  tooltipStrategy: string enum('merge', 'standalone') = 'merge'
}
