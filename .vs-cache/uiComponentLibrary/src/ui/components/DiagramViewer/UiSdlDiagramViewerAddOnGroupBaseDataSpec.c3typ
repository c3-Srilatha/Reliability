/**
 * A base specification for an individual addOn or group of addOns on a {@link UiSdlDiagramViewer},
 * that, grabbing the fields specified at UiSdlDiagramAddonBase
 */
@typeScript
type UiSdlDiagramViewerAddOnGroupBaseDataSpec mixes UiSdlFieldBasedDataSpec {
  /**
   * Filter string to filter fetched events.
   */
  filter: string

  /**
   * The specification for x positioning of the addOn.
   */
  xPos: !UiSdlFieldBasedDataSpecSetting

  /**
   * The specification for y positioning of the addOn.
   */
  yPos: !UiSdlFieldBasedDataSpecSetting

  /**
   * The specification for color of the addOn.
   */
  color: UiSdlFieldBasedDataSpecSetting | string serialized Color

  /**
   * Where in the addOnDataSpec result to find the addOn
   */
  dataPath: string = 'objs'

  /**
   * The label to used for this addOn in the legend. 
   *
   * NOTE: only the first addOn from each category based on {@link UiSdlDiagramViewer#legendStrategy}
   * will be taken into account for labels. For example, for the strategy 'color', only
   * the first addOn in the nested structure of {@link UiSdlDiagramViewerAddOnDataSpec} with the color 'green'
   * would get to decide the label for the 'green' group, and if no legendLabel is configured, simply 
   * 'green' would be displayed.
   */
  legendLabel: string | UiSdlDynamicValueSpec | UiSdlFieldBasedDataSpecSetting

  /**
   * Specifications for this group of addOn's tooltip
   */
  tooltip: UiSdlDiagramViewerTooltip
}
