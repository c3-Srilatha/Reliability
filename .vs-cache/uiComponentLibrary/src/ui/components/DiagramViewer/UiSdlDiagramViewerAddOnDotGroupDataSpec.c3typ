/**
 * A specification for an individual addOn or group of addOns on a {@link UiSdlDiagramViewer},
 * that will all be of circular shape, grabbing the fields specified at UiSdlDiagramAddonDot
 */
@typeScript
type UiSdlDiagramViewerAddOnDotGroupDataSpec mixes UiSdlDiagramViewerAddOnGroupBaseDataSpec {
  
  /**
   * Specification for the radius/radii of the dot(s).
   */
  radius: UiSdlFieldBasedDataSpecSetting
}
