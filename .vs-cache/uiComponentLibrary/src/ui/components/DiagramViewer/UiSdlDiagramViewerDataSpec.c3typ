/**
 * The DataSpec type for {@link UiSdlDiagramViewer}
 */
type UiSdlDiagramViewerDataSpec mixes UiSdlFieldBasedDataSpec {
  /**
   * The field name for the url on the dataType
   */
  fieldNameForUrl: string

  /**
   * the action name to make on the dataType
   */
  actionName: string = 'fetch'

  /**
   * action arguments
   */
  actionArgs: json

  toPartiallyAppliedActions: ~ ts-client
}
