/**
 * A base specification for an individual addOn or group of addOns on a {@link UiSdlDiagramViewer},
 * that will be shown as text, grabbing the fields specified at UiSdlDiagramAddonText
 */
@typeScript
type UiSdlDiagramViewerAddOnTextGroupDataSpec mixes UiSdlDiagramViewerAddOnGroupBaseDataSpec {

  /**
   * The specification for the text to display
   */
  text: !UiSdlFieldBasedDataSpecSetting

  /**
   * The specification for the color of the text (vs the color field which is the background color)
   */
  textColor: UiSdlFieldBasedDataSpecSetting
}
