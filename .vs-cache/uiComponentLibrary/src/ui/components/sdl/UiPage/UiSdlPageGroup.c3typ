/**
 * Type to represent the a top-level menu item that has a sub menu in {@link UiSdlNavMenu}.
 */
@typeScript
entity type UiSdlPageGroup schema name 'UISDL_P_G' {

  /**
   * Unique ID of this page group.
   */
  id: !string

  /**
   * The title to display for this page group.
   */
  title: string

  /**
   * Pages that are in this page group.
   * The order of pages defined here will determine the order it shows up at UiDesigner.
   */
  pages: [UiSdlPage] schema name 'UI_P'
}
