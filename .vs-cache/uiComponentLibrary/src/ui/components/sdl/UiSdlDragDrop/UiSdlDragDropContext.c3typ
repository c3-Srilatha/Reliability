/**
 * Layout to provide drag and drop context for the children components.
 */
@typeScript
@uiComponentCategorizer(name='Drag and drop context', category='Components', hide=true)
type UiSdlDragDropContext mixes UiSdlLayoutBase {

  /**
   * The components to be wrapped for drag and drop functionality.
   */
  children: ~
}
