/**
 * Component to send drag and drop information.
 */
@typeScript
@uiComponentCategorizer(name='Drag and drop source', category='Components', hide=true)
type UiSdlDragDropSource mixes UiSdlComponent<UiSdlNoData> {

  /**
   * Data provided by this component when the dragging starts.
   */
  sourceData: json

  /**
   * The components to be wrapped for drag and drop functionality.
   */
  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]

  /**
   * Triggered when an item is being dragged.
   *
   * @param id
   *            Id of the current component.
   * @param sourceData
   *            Data from the source component.
   *
   * @returns An `ITEM_DRAG` action for this instance.
   */
  @uiSdlActionCreator(actionType='ITEM_DRAG')
  dragItemAction: function(id: string, sourceData: json): !UiSdlItemDragAction ts-client
}
