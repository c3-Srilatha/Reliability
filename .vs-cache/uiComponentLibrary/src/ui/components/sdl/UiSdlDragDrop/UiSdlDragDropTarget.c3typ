/**
 * Component to receive drag and drop information.
 */
@typeScript
@uiComponentCategorizer(name='Drag and drop target', category='Components', hide=true)
type UiSdlDragDropTarget mixes UiSdlComponent<UiSdlNoData> {

  /**
   * Actual components that would be accepted for dropping.
   * e.g. "acceptedDropKinds": ["SDLDemo.DragDropDemoDragCollectionList"].
   */
  acceptedDropKinds: [string]

  /**
   * Data received by this component during dropping.
   */
  targetData: json

  /**
   * Whether to include offset values in the targetData.
   */
  addDropOffsetValues: boolean

  /**
   * The components to be wrapped for drag and drop functionality.
   */
  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]

  /**
   * Custom CSS class name for this target component.
   * Refer to `_dragDropTarget.scss` for examples.
   */
  className: string

  /**
   * Triggered when an item is dropped.
   *
   * @param id
   *            Id of the current component.
   * @param sourceData
   *            Data from the source component.
   * @param targetData
   *            Additional data received by the target component.
   *
   * @returns An `ITEM_DROP` action for this instance.
   */
  @uiSdlActionCreator(actionType='ITEM_DROP')
  dropItemAction: function(id: string, sourceData: json, targetData: json): !UiSdlItemDropAction ts-client
}
