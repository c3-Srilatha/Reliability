/**
 * Payload for a {@link UiSdlSankeyChart#clickEdgeAction}.
 */
type UiSdlSankeyChartEdgeClickPayload mixes UiSdlComponentActionPayload {

  /**
   * The {@link UiSdlSankeyChartNodeDataSpec#id label} field of the source node of an edge
   */
  source: string

  /**
   * The {@link UiSdlSankeyChartNodeDataSpec#id label} field of the target node of an edge
   */
  target: string

  /**
   * The {@link UiSdlSankeyChartNodeDataSpec#id id} field of the source node of an edge
   */
  sourceId: string

  /**
   * The {@link UiSdlSankeyChartNodeDataSpec#id id} field of the target node of an edge
   */
  targetId: string
}
