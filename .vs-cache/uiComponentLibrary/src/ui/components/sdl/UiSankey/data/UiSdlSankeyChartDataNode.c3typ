/**
 * A generic type to hold Sankey chart data.
 */
type UiSdlSankeyChartDataNode {

  /**
   * The data structure which contains the node attributes.
   * This field has the following structure:
   * ```json
   * {
   *   "id": "test",
   *   "nodeField1": 4,
   *   "nodeField2": "foo"
   * }
   * ```
   */
  originalData: json

  /**
   * The number of connections the node has
   */
  numConnectors: int
}
