/**
 * This means that the fetch function will provide a string field for the hex color of the Sankey node or edge
 */
@typeScript
type UiSdlSankeyCustomColorSetting mixes UiSdlFieldBasedDataSpecSetting {

  fieldName: ~ = 'color'
}
