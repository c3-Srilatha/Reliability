/**
 * Type to represent the Sankey edge data spec
 */
@typeScript
type UiSdlSankeyChartEdgeDataSpec {

  /**
   * The {@link UiSdlSankeyChartNodeDataSpec#id id} of the source node
   */
  source: !UiSdlFieldBasedDataSpecSetting = {fieldName: 'source'}

  /**
   * The {@link UiSdlSankeyChartNodeDataSpec#id id} of the target node
   */
  target: !UiSdlFieldBasedDataSpecSetting = {fieldName: 'target'}

  /**
   * The value of the edge which decides the width of the edge
   */
  value: !UiSdlSankeyChartEdgeValueFieldSetting

  /**
   * The unit of the edge
   */
  unit: UiSdlFieldBasedDataSpecSetting = {fieldName: 'unit'}

  /**
   * The specification for a field on the data type that is used in determining Sankey node colors.
   */
  color: UiSdlSankeyColorFieldSetting

  /**
   * The default opacity for this node that is overwritten when a node/edge is hovered over
   */
  defaultOpacity: UiSdlFieldBasedDataSpecSetting = {fieldName: 'defaultOpacity'}
}
