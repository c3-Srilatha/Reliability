/**
 * A specification that describes how to use a field of the {@link UiSdlSankeyChartData data} for determining the value of the nodes.
 * on a {@link UiSdlSankeyChart} instance.
 */
@typeScript
type UiSdlSankeyChartNodeValueFieldSetting mixes UiSdlFieldBasedDataSpecSetting {

  fieldName: ~ = 'value'

  /**
   * The decimal precision to show on the label's value.
   */
  labelDecimalPrecision: int = 0
}
