/**
 * A specification that describes how to use a field of the {@link UiSdlSankeyChartData data} for determining the color of the nodes or edges.
 * on a {@link UiSdlSankeyChart} instance.
 */
@typeScript
type UiSdlSankeyColorFieldSetting mixes UiSdlFieldBasedDataSpecSetting {

  /**
   * The strategy used for determining the colors of the nodes or edges
   */
  colorConfigurationStrategy: UiSdlSankeyCustomColorSetting
}
