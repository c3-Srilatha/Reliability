/**
 * Type to represent the Sankey node data spec
 */
@typeScript
type UiSdlSankeyChartNodeDataSpec {

  /**
   * The id of the the node
   */
  id: !UiSdlFieldBasedDataSpecSetting = {fieldName: 'id'}

  /**
   * The icon for this node
   */
  icon: UiSdlFieldBasedDataSpecSetting = {fieldName: 'icon'}

  /**
   * The label when displaying the node
   */
  label: !UiSdlFieldBasedDataSpecSetting = {fieldName: 'label'}

  /**
   * The placement of the node. In a horizontal Sankey, level 0 is the far left side
   */
  level: !UiSdlFieldBasedDataSpecSetting = {fieldName: 'level'}

  /**
   * The value of the node which decides the width of the node
   */
  value: UiSdlSankeyChartNodeValueFieldSetting

  /**
   * The unit of the node
   */
  unit: UiSdlFieldBasedDataSpecSetting = {fieldName: 'unit'}

  /**
   * The specification for a field on the data type that is used in determining Sankey node colors.
   */
  color: UiSdlSankeyColorFieldSetting

  /**
   * The default opacity for this node that is overwritten when a node/edge is hovered over
   */
  defaultOpacity: UiSdlFieldBasedDataSpecSetting = {fieldName: 'defaultOpacity'}
}
