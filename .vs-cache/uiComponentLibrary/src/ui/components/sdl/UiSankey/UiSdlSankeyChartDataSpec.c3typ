/**
 * The specification of data retrieval for instances of the {@link UiSdlSankeyChart} component type.
 * Conceptually the dataType in this data spec represents nodes and edges in a graph.
 */
@typeScript
type UiSdlSankeyChartDataSpec mixes UiSdlFieldBasedDataSpec {

  /**
   * Converts the data spec to an array of partially applied actions.
   */
  toPartiallyAppliedActions: ~ ts-client

  /**
   * The action to call
   */
  actionName: string = 'fetch'

  /**
   * The actionArgs to be passed to the API
   */
  actionArgs: map<string, any>

  /**
   * The data spec of nodes in the Sankey chart
   */
  nodeDataSpec: UiSdlSankeyChartNodeDataSpec

  /**
   * The data spec of edges in the Sankey chart
   */
  edgeDataSpec: UiSdlSankeyChartEdgeDataSpec
}
