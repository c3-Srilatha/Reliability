/**
 * A specification that describes how to display each field of the {@link UiSdlDefinitionListDataSpec}
 * in the {@link UiSdlDefinitionList}.
 */
@typeScript
type UiSdlDefinitionListDataSpecFieldSetting mixes UiSdlFieldBasedDataDynamicValueSpecSetting {

  /**
   * Displays large font size for field values if true.
   */
  fieldFontLarge: boolean

  /**
   * Map of data to icon class.
   * The icon class is when concatenated with `fa-` yields the
   * Font Awesome icon to render.
   *
   * Example:
   * if class = 'hashtag', the Font Awesome icon to render is `fa-hashtag`
   */
  valueIconMap: map<string, string>

  /**
   * The name of the icon for the label.
   */
  labelIcon: string

  /**
   * Text for the tooltip displayed off of the icon in the header.
   */
  tooltipText: string | UiSdlDynamicValueSpec

  /**
   * The label for the field.
   */
  label: string

  /**
   * Text that provides some secondary information
   */
  subInfo: string | UiSdlDefinitionListSubInfoFieldSetting

  /**
   * A placeholder to be used when the field is null and thus undefined client-side.
   */
  placeholder: string

  /**
   * Whether the value of the field should be truncated.
   */
  truncate: boolean = false

  /**
   * The url to which the user is redirected upon clicking the field value.
   *
   * TODO: UI-8456 Replace this value type with the new link configuration type.
   */
  redirectLink: UiSdlLinkTemplate
}
