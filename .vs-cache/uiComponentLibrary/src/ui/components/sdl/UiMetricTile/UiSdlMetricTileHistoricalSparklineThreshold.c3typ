/**
 * Sparkline threshold configuration.
 */
@typeScript
type UiSdlMetricTileHistoricalSparklineThreshold {

  /**
   * The threshold metric. It's latest value will be used as a threshold to compare with historical sparkline's latest value.
   */
  @uiSdlDropTargetField(emptyDropMessage='UiManager.UiSdlManagerComponentSettingsForm.emptyMetricDropMessage')
  metricName: string

  /**
   * The operator that is used for comparison to the threshold value.
   */
  operator: !string enum UiSdlMetricTileThresholdOperator

  /**
   * The color used for the sparkline plot if the threshold is met.
   */
  color: string enum UiSdlChartColor = DARK_BLUE
}
