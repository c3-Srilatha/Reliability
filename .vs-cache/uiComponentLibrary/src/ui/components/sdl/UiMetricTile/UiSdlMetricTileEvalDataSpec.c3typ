/**
 * The specification of data retrieval for instances of the {@link UiSdlTimeseriesLineBarChart} component type.
 */
@beta
@typeScript
type UiSdlMetricTileEvalDataSpec mixes UiSdlEvalBasedDataSpec {

  /**
   * Spec describing how to evaluate the main value of the {@link UiSdlMetricTile}
   */
  mainValue: UiSdlMetricTileEvalDataSpecMainValueSetting

  /**
   * Spec describing how to evaluate the KPI trend comparison section of the {@link UiSdlMetricTile}
   */
  kpiTrendComparison: UiSdlMetricTileEvalDataSpecKPITrendComparisonSetting

  /**
   * Spec describing how to evaluate the historic sparkline plot for the {@link UiSdlMetricTile}.
   */
  historicSparkline: UiSdlMetricTileEvalDataSpecHistoricalSparklineSetting

  /**
   * Spec describing how to evaluate the forecast sparkline plot for the {@link UiSdlMetricTile}.
   */
  forecastSparkline: UiSdlMetricTileEvalDataSpecForecastSparklineSetting

  /**
   * Spec describing how to evaluate the plan sparkline plot for the {@link UiSdlMetricTile}.
   */
  planSparkline: UiSdlMetricTileEvalDataSpecPlanSparklineSetting

  /**
   * Converts the data spec to an array of partially applied actions.
   */
  toPartiallyAppliedActions: ~ ts-client

  /**
   * The transform functions to use for this data spec.
   * Functions that are available are {@link UiSdlTransformUiSdlChartDataToEChartConfig}
   * and {@link UiSdlTransformEvalMetricsResultToUiSdlChartData}.
   */
  dataTransforms: ~ = ['UiSdlTransformDataToUiSdlChartData', 'UiSdlTransformUiSdlChartDataToEChartConfig']
}
