/**
 * UiSdlMetricTileDataSources type enumerates all possible data sources that will be filled using {@link UiSdlMetricTileDataSpec}.
 */
enum type UiSdlMetricTileDataSources {
  /**
  * Data source name for advanced data spec usage.
  */
  ADVANCED_DATA_SPEC = 'advancedDataSpec'

  /** 
  * Historic sparkline data source name.
  */
  HISTORIC_SPARKLINE = 'historicSparkline'

  /**
  * KPI trend comparison data source name.
  */
  KPI_TREND_COMPARISON = 'kpiTrendComparison'

  /**
  * Forecast sparkline data source name.
  */
  FORECAST_SPARKLINE = 'forecastSparkline'

  /**
  * Plan sparkline data source name.
  */
  PLAN_SPARKLINE = 'planSparkline'

  /**
  * Sparkline data source name.
  */
  SPARKLINE_THRESHOLD = 'sparklineThreshold'

  /**
  * Main value data source name.
  */
  MAIN_VALUE = 'mainValue'
}
