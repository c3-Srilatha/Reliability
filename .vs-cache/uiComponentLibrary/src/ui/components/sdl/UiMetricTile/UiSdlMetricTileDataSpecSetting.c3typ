/**
 * A {@link UiSdlMetricTile} data spec that is based on one or more {@link Metric}s.
 */
@typeScript
type UiSdlMetricTileDataSpecSetting mixes UiSdlMetricBasedDataSpecSetting {

  /**
   * Number of digits after decimal, default is 0.
   */
  precision: int = 0

  /**
   * Interval at which metric will be evaluated. Default value is DAY.
   */
  interval: string enum('HOUR', 'DAY', 'MONTH', 'YEAR') = 'DAY'

  /**
   * Keeps track of the evalute action triggered in the datasource. Possible values
   * are evalMetric or rollupMetrics. Defaults to 'EVAL'.
   */
  evaluateAction: string enum('EVAL', 'ROLLUP') = 'EVAL'

  /**
   * Aggregation function to be used for rolling up results of all individual sources into 1 timeseries.
   * Default value is 'AVG'
   */
  aggregation: string enum('OR', 'AND', 'SUM', 'AVG', 'MEAN', 'MIN', 'MAX', 'MEDIAN', 'VARIANCE', 'STDDEV', 'PERCENTILE') = 'AVG'

  /**
   * Filter string used in the evalMetrics/rollupMetrics call, defaults to '1==1'.
   */
  filter: string = '1==1'

  /**
   * The data record mapping used to map records to fields in UiDesigner.
   */
  dataRecordMapping: ~ = {metricName: {dependingField: 'metricType', dependingValues: {SimpleMetric: 'name', CompoundMetric: 'id'}}, fieldName: {dependingField: 'metricType', dependingValues: {SimpleMetric: 'name', CompoundMetric: 'id'}}, label: 'name'}
}
