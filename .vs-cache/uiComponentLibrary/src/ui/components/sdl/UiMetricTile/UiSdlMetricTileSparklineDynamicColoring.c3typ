/**
 * The configuration to dynamically color a metric tile
 */
@typeScript
type UiSdlMetricTileSparklineDynamicColoring {

  /**
   * If this is set to true, then the direction for dynamic coloring will be reversed.
   */
  invertColors: boolean = false

  /**
   * The color for the positive trend direction.
   * The default hexcode is equivalent to design token green-50
   */
  positiveTrendColor: string enum UiSdlChartColor = GREEN50

  /**
   * The color for the negative trend direction.
   * The default hexcode is equivalent to design token red-50
   */
  negativeTrendColor: string enum UiSdlChartColor = RED50
}
