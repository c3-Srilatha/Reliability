/**
 * The header for the metric tile which describes how to render the title.
 */
@typeScript
type UiSdlMetricTileHeader mixes UiSdlComponentTitle {

  /**
   * Link on the header.
   */
  redirectLink: UiSdlLinkTemplate

  /**
   * This is the config for the optional icon that will be displayed in the header.
   */
  iconConfig: UiSdlMetricTileHeaderIconConfig
}
