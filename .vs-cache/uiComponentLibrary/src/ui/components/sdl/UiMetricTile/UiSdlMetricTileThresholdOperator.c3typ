/**
 * The threshold operator in UiSdlMetricTile HistoricalSparkline.
 */
enum type UiSdlMetricTileThresholdOperator {

  /**
   * Equals.
   */
  EQUALS

  /**
   * Less than.
   */
  LESS_THAN

  /**
   * Greater than.
   */
  GREATER_THAN

  /**
   * Less than or equal to.
   */
  LESS_THAN_OR_EQUAL_TO

  /**
   * Greater than or equal to.
   */
  GREATER_THAN_OR_EQUAL_TO
}
