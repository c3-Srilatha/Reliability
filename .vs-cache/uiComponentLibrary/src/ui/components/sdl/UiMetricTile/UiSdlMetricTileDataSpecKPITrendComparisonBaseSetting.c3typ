/**
 * Spec describing how to calculate KPI trend comparison result.
 */
@typeScript
type UiSdlMetricTileDataSpecKPITrendComparisonBaseSetting {

  /**
   * Comparison text displayed next to KPI trend comparison section.
   */
  comparisonText: string = ''

  /**
   * Whether or not an increase in the metric will be colored red.
   */
  invertTrendDirectionColor: boolean = false

  /**
   * If true, KPI trend comparison result is also displayed in percentage in addition to the absolute value. Defaults
   * to false.
   */
  percentage: boolean = false

  /**
    * If trend value is invalid, this message is displayed instead of the trend value.
    */
  invalidValueMessage: string | UiSdlDynamicValueSpec = 'UiSdlMetricTile.trendValue.placeholderHintMessage'

  /**
   * Length of time period in multiples of {@link UiSdlMetricTileDataSpecSetting#interval} over which we want to calculate
   * trend indicator value.
   * Example, if interval is DAY and intervalLength is 5, trend indicator value will be the difference the metric
   * value at today's date and (today - 5 days) date.
   */
  @constraint(condition='isEmpty(timeHorizon)', message='timeHorizon must be empty to use intervalLength')
  intervalLength: int

  /**
   * Time horizon for which kpi trend comparison is evaluated, defaults to 12 months.
   */
  @constraint(condition='isEmpty(intervalLength)', message='intervalLength must be empty to use timeHorizon')
  timeHorizon: string enum('36MONTHS', '24MONTHS', '12MONTHS', '3MONTHS', '2MONTHS', '1MONTH', '7DAYS', '24HOURS', '1HOUR')
}
