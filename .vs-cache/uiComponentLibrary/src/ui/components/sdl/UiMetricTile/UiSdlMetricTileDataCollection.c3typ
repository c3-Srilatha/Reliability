/**
 * The data sources type definition for {@link UiSdlMetricTile#dataCollection}.
 * Each data source holds the data to display the corresponding sparkline.
 */
type UiSdlMetricTileDataCollection {

  /**
   * The eChart config to display a metric tile historic sparkline.
   */
  historicSparkline: UiSdlChartEChartConfig

  /**
   * The eChart config to display a metric tile forecast sparkline.
   */
  forecastSparkline: UiSdlChartEChartConfig

  /**
   * The eChart config to display a metric tile plan sparkline.
   */
  planSparkline: UiSdlChartEChartConfig

  /**
   * The eChart config to display a metric tile main value in the title.
   */
  mainValue: UiSdlMetricTileMainValue
}
