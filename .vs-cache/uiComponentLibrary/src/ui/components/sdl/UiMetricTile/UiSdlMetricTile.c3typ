/**
 * A UI component type that displays metric information and/or sparkline plot in a tile along with a header.
 */
@uiSdlDesignerComponent(designable=true,
                        attributes=['nestable'],
                        category='UiSdlMetricTile.CategoryName',
                        name='UiSdlMetricTile.ComponentName',
                        icon='percentage')
@typeScript
@uiComponentCategorizer(name='Metric tile', category='Patterns')
type UiSdlMetricTile mixes UiSdlComponent<UiSdlMetricTileDataSpec>, UiSdlFilterable, UiSdlChartColorConfig, UiSdlTimeZoneLabel {

  /**
   * The header for the metric tile which describes how to render the title.
   */
  header: UiSdlMetricTileHeader

  /**
   * Whether or not to show the sparkline.
   */
  showSparkline: boolean = true

  /**
   * Whether or not to hide the legend for the sparkline.
   */
  hideLegend: boolean = false

  /**
   * Whether or not to hide the time horizon label below sparkline chart.
   * Only applicable if sparkline is not hidden.
   */
  hideTimeHorizonLabel: boolean = true

  /**
   * Whether or not to show the timezone label below chart.
   * {@link hideTimeHorizonLabel} flag will take precedence over this flag.
   */
  showTimeZoneLabel: ~

  /**
   * Timezone configuration for displayed data.
   * E.g. if an event happened at 1am EST, we will show the event as happened at 1am to browsers in any timezone.
   */
  noTimeZoneConversion: boolean = false

  /**
   * The component that handles the empty state.
   * It will appear if the metric tile has no data.
   */
  emptyState: UiSdlComponentRef<UiSdlEmptyState>

  /**
   * The specification used for retrieving data displayed by the metric tile.
   */
  @uiSdlDataSpec(dataDestinationField='dataCollection')
  dataSpec: ~

  /**
   * Holds the data to display in the metric tile.
   */
  dataCollection: UiSdlMetricTileDataCollection

  /**
   * The specification used to retrieve data displayed by this chart.
   * Note: evalDataSpec takes priviledge over dataSpec. Developer cannot combine both.
   * If `evalDataSpec` and `dataSpec` are both defined, `evalDataSpec` will be used and `dataSpec` will be ignored.
   */
  @beta
  @uiSdlDataSpec(dataDestinationField='dataCollection')
  evalDataSpec: UiSdlMetricTileEvalDataSpec

  /**
   * Contains custom logic to map data returned from datasources to the dataDestinationField.
   */
  doDataMerge: ~ ts-client

  /**
   * Whether the mouse can hover over the tooltip (and make it stick).
   */
  isTooltipSticky: boolean = true

  /**
   * Describes where the tooltip will be displayed. If undefined, default ReactEcharts tooltip positioning is used.
   * For example, 'Right' means that there will be a bias of positioning the tooltip to the right of the mouse pointer.
   */
  tooltipPositionBias: string enum('None', 'Right', 'Left') = 'None'

  /**
   * Triggered when {@link Unit#symbol} is fetched from the server through {@link UiSdlEpicFetchUnitSymbol}.
   */
  @uiSdlReducer(actionType='UPDATE_UNIT_SYMBOL')
  updateUnitSymbolEffect: private inline function(state: UiSdlReduxState,
                                                  action: UiSdlReduxAction): UiSdlReduxState ts-client

  /**
   * Whether or not to plot and hide data at timestamps where there are 100% missing values.
   */
  hideMissing: boolean = false

  /**
   * Replacement value for missing data, in order to plot a non-broken chart
   * Developer needs to set a numerical value here to make the chart keep plotting
   * If not set, default is `0`.
   */
  missingValueHolderValue: float = 0

  filterSubmitEpic: ~ ts-client

  /**
   * Tooltip title interval display value in the chart.
   */
  displayTooltipTitleInterval: string enum Interval = DAY
}
