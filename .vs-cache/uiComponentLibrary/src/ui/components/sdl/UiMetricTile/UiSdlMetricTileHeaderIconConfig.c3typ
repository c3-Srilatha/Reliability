/**
 * The icon for the header of the metric tile.
 */
@typeScript
type UiSdlMetricTileHeaderIconConfig {

  /**
   * This is the optional icon that will be displayed in the header.
   */
  icon: string

  /**
   * Text for the tooltip displayed off of the icon in the header.
   */
  tooltipText: string
}
