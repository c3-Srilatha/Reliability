/**
 * The following type represents the Code Editor Title.
 */
@typeScript
type UiSdlCodeEditorHeader {

  /**
   * This will be either the name or the path option to infer the component title as defined by {@link UiSdlCodeEditorDynamicTitle#option} or a hardcoded-value.
   */
  title: UiSdlCodeEditorDynamicTitle | string

  /**
   * The actions to be displayed in the code editor title section
   * Each action can specify `iconSuffix` to have an icon displayed.
   */
  actionButtons: [UiSdlAction]
}
