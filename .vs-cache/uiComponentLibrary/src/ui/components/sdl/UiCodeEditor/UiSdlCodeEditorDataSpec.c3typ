/**
 * The specification of data retrieval for instances of the {@link UiSdlCodeEditor} component type.
 */
@typeScript
type UiSdlCodeEditorDataSpec mixes UiSdlComponentDataSpec {

  dataType: ~ = {
    "typeName": "MetadataUtil"
    }

  /**
   * The arguments to pass to the action, where the keys are the parameter names and the values are the corresponding arguments.
   */
  actionArgs: json

  /**
   * The action used to retrieve the code editor contents. By default, contents are retrieved
   * from the `TagMetadataStore`.
   */
  actionName: string = 'fetchMetadataFileContentByPath'

  /**
   * URI of the target file.
   */
  fileUri: string

  toPartiallyAppliedActions: ~ ts-client
}
