/**
 * The following type represents the Code Editor editing state.
 */
@typeScript
type UiSdlCodeEditorEditState {

  /**
   * Whether or not the code editor should be read only.
   */
  readOnly: boolean = false

  /**
   * The list of code editor action buttons to disable. The list should be made up of action suffixes defined in
   * each {@link UiSdlAction}. Note that the list is only in effect if #readOnly is true.
   *
   * @example
   *     ['SAVE_FILE', 'DELETE']
   */
  disabledButtons: [string]
}
