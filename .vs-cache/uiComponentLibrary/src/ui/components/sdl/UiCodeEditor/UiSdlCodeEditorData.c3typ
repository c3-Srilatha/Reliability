/**
 * Data to be rendered by a @{link UiSdlCodeEditor} component.
 */
@typeScript
type UiSdlCodeEditorData {

  /**
   * A title for the code content, to be displayed in the code editor header.
   */
  title: string

  /**
   * The code content to render in the code editor.
   */
  content: string
}
