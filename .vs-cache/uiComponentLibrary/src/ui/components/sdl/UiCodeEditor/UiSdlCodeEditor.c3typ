/**
 * The following type represents the UI Code Editor Component.
 */
@typeScript
@uiComponentCategorizer(name='Code editor', category='Patterns')
type UiSdlCodeEditor mixes UiSdlComponent<UiSdlCodeEditorDataSpec> {

  @uiSdlDataSpec(dataDestinationField='textData')
  dataSpec: !~

  /**
   * Holds the file content for the code editor.
   */
  textData: UiSdlCodeEditorData

  /**
   * The height of the code editor.
   */
  height: string

  /**
   * The width of the code editor.
   */
  width: string

  /**
   * Holds the code editor content when it does not come from an existing file.
   * i.e. New file, Content generated in memory, etc....
   */
  content: string

  /**
   * Whether or not the code editor should be read only along with the list of disabled buttons names.
   */
  editState: UiSdlCodeEditorEditState

  /**
   * Whether the text of the code editor should wrap.
   * If false, users will have to horizontally scroll to see the overflowed content.
   * If true, the overflowed content will wrap to the next line.
   */
  wrap: boolean = false

  /**
   * Color theme for the code editor.
   * Two C3 provided themes are `DARK` and `LIGHT`.
   * If set to `AUTO`, the code editor will use the current application theme.
   * Other available themes are at: https://github.com/ajaxorg/ace/tree/v1.31.1/src/theme
   */
  theme: string = 'AUTO'

  /**
   * The component header.
   */
  header: UiSdlCodeEditorHeader

  /**
   * The programming language of the code editor's content.
   */
  language: string enum('JAVASCRIPT', 'PYTHON')

  /**
   * A spec describing how to save the code editor contents. By default, saving is done through
   * the `TagMetadataStore`.
   */
  saveSpec: UiSdlCodeEditorSaveSpec

  /**
   * Triggered when an action button in the component header is clicked on.
   *
   * @param id
   *            Id of the component.
   * @param actionSuffix
   *            The action suffix for the specific action button that was clicked.
   * @param args
   *            Additional args that can be passed to this action.
   * @returns An `EDITOR_HEADER_ACTION_CLICK_${actionSuffix}` action for this instance.
   */
  @uiSdlActionCreator(actionType='EDITOR_HEADER_ACTION_CLICK_${actionSuffix}')
  clickEditorHeaderButtonAction: function(id: string,
                                          actionSuffix: string,
                                          args: json): UiSdlEditorHeaderActionClickAction ts-client

  /**
   * Triggered when the code editor content is changed.
   *
   * @param id
   *            Id of the component.
   * @param newContent
   *            The new content within the code editor
   * @returns An `EDITOR_CONTENT_UPDATE` action for this instance.
   */
  @uiSdlActionCreator(actionType='EDITOR_CONTENT_UPDATE')
  updateEditorContentAction: function(id: string, newContent: string): UiSdlEditorContentUpdateAction ts-client

  /**
   * Triggered when the code editor read only mode is intended to be changed.
   *
   * @param id
   *            Id of the component.
   * @param readOnly
   *            Whether or not the code editor contents should be read only.
   * @returns An `EDITOR_READ_ONLY_UPDATE` action for this instance.
   */
  @uiSdlActionCreator(actionType='EDITOR_READ_ONLY_UPDATE')
  updateEditorReadOnlyAction: function(id: string, readOnly: boolean): UiSdlEditorReadOnlyUpdateAction ts-client

  /**
   * An action to change the theme of a code editor.
   *
   * @param id
   *            Id of the component.
   * @param theme
   *            Theme to get changed to
   * @returns An `EDITOR_THEME_UPDATE` action for this instance.
   */
  @uiSdlActionCreator(actionType='EDITOR_THEME_UPDATE')
  updateEditorThemeAction: function(id: string, theme: string): UiSdlEditorThemeUpdateAction ts-client


  /**
   * Triggered when the loading state of the code editor header action buttons are intended to be changed.
   *
   * @param id
   *            Id of the component.
   * @param loadingButtons
   *            The array of action buttons whose loading property should be true, specified through the actionSuffix
   *            of a {@link UiSdlAction}.
   * @param nonLoadingButtons
   *            The array of action buttons whose loading property should be false, specified through the actionSuffix
   *            of a {@link UiSdlAction}.
   * @returns An `EDITOR_HEADER_BUTTONS_LOADING_UPDATE` action for this instance.
   */
  @uiSdlActionCreator(actionType='EDITOR_HEADER_BUTTONS_LOADING_UPDATE')
  updateEditorHeaderButtonsLoadingAction: function(id: string,
                                                   loadingButtons: [string],
                                                   nonLoadingButtons: [string])
                                            : UiSdlEditorHeaderButtonsLoadingUpdateAction ts-client

  /**
   * Listens for actions of type `EDITOR_THEME_UPDATE` to update the redux store when changes are made to the code editor.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='EDITOR_THEME_UPDATE')
  editorThemeUpdateReducer: private function(state: !UiSdlReduxState,
                                                  action: !UiSdlEditorThemeUpdateAction): UiSdlActionsObservable ts-client

  /**
   * Listens for actions of type `EDITOR_CONTENT_UPDATE` to update the redux store when changes are made to the code editor.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='EDITOR_CONTENT_UPDATE')
  codeEditorContentChangeEffect: private function(state: !UiSdlReduxState,
                                                  action: !UiSdlEditorContentUpdateAction): UiSdlActionsObservable ts-client

  /**
   * Listens for actions of type `EDITOR_READ_ONLY_UPDATE` to update the readOnly mode of the code editor.
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='EDITOR_READ_ONLY_UPDATE')
  editorReadOnlyUpdateEffect: private function(state: !UiSdlReduxState,
                                               action: !UiSdlEditorReadOnlyUpdateAction): UiSdlActionsObservable ts-client

  /**
   * Listens for actions of type `EDITOR_HEADER_BUTTONS_LOADING_UPDATE` to update the loading property of individual action buttons.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='EDITOR_HEADER_BUTTONS_LOADING_UPDATE')
  editorHeaderButtonsLoadingUpdateEffect: private function(state: !UiSdlReduxState,
                                                           action: !UiSdlEditorHeaderButtonsLoadingUpdateAction)
                                                    : UiSdlActionsObservable ts-client

  doDataMerge: ~ ts-client

  /**
   * Triggers 'EDITOR_READ_ONLY_UPDATE', and `EDITOR_HEADER_BUTTONS_LOADING_UPDATE` actions to save file when component header is clicked on.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='EDITOR_HEADER_ACTION_CLICK_SAVE_FILE')
  editorFileSaveEpic: private function(actionStream: UiSdlActionsObservable,
                                       stateStream: UiSdlStatesObservable): UiSdlActionsObservable ts-client
}
