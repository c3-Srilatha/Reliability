/**
 * The specification for saving the contents of the {@link UiSdlCodeEditor} component.
 */
@typeScript
type UiSdlCodeEditorSaveSpec {

  /**
   * The action used to update the code editor contents.
   */
  actionName: !string = 'updateMetadataFileContentByPath'

  /**
   * The name of the parameter for the action that is being called. Note, the shape of this parameter
   * must be a map where the key represents the file URI and the value is the content to be saved.
   */
  actionParamName: !string = 'fileContents'

  /**
   * The type name of the API to use to save the code editor contents.
   */
  typeName: !string = 'MetadataUtil'
}
