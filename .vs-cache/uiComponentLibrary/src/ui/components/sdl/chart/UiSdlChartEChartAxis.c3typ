/**
 * Type to represent data shape of eCharts axis config.
 */
@typeScript
type UiSdlChartEChartAxis {

  /**
   * The unique identifier of this axis in a chart.
   */
  id: string

  /**
   * The display name of this axis.
   */
  name: string

  /**
   * Used in x or y axis.
   */
  axisType: string enum('category', 'time', 'value')

  /**
   * Used in x axis, represents the labels for the axis.
   */
  data: [string | datetime]

  /**
   * The config for the eChart axis label.
   */
  axisLabel: json

  /**
   * Represents the axis data unit
   */
  unit: string
}
