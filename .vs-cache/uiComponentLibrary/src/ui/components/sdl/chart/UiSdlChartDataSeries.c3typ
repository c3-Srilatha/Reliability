/**
 * Type to represent a value series of data, to be plotted on a chart.
 */
@typeScript
type UiSdlChartDataSeries {

  /**
   * The unique identifier of the series.
   */
  id: string

  /**
   * The series data values.
   */
  values: [double]

  /**
   * The name for the series.
   */
  name: string

  /**
   * The unit for this data.
   */
  unit: Unit
}
