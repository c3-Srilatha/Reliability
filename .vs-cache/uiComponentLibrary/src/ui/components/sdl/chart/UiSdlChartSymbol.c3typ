/**
 * A type to represent the shape of the symbol for chart data points.
 */
enum type UiSdlChartSymbol {
  
  /**
   * Line.
   */
  LINE = 'line'

  /**
   * Circle.
   */
  CIRCLE = 'circle'

  /**
   * Rectangle.
   */
  RECT = 'rect'

  /**
   * Round rectangle.
   */
  ROUNDRECT = 'roundRect'

  /**
   * Triangle.
   */
  TRIANGLE = 'triangle'

  /**
   * Diamond.
   */
  DIAMOND = 'diamond'

  /**
   * Ellipsis.
   */
  ELLIPSIS = 'ellipsis'

  /**
   * Pin.
   */
  PIN = 'pin'

  /**
   * Arrow.
   */
  ARROW = 'arrow'

  /**
   * No shape.
   */
  NONE = 'none'
}
