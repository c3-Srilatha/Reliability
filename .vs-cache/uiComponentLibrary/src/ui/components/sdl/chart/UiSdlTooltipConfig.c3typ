/**
 * This types represents the config for echart tooltips.
 */
@typeScript
type UiSdlTooltipConfig {

  /**
   * Whether to enable tooltips.
   */
  tooltipEnabled: boolean = true

  /**
   * The decimal precision to show on tooltip values.
   */
  tooltipValuesDecimalPrecision: int = 2

  /**
   * Whether or not to show units in tooltip
   */
  tooltipUnitEnabled: boolean = true

  tooltipConfig: UiSdlTooltipBaseSettings = {}
}
