/**
 * This type represents the series part of an eCharts config.
 */
@typeScript
type UiSdlChartEChartSeries {

  /**
   * Unique identifier of this series.
   */
  id: string

  /**
   * The unique name of the {@link UiSdlChartEChartSeries} to which this series is mapped.
   */
  name: string

  /**
   * The index of the y-axis ({@link UiSdlChartEChartAxis}) that this series maps to. If none is specified, 0 will be used.
   */
  yAxisIndex: int

  /**
   * An array of data that will be charted. Each value must be an array with two elements: [x-value, y-value], where
   * <x-value> is of type string (including stringified dates) and <y-value> is of type double.
   */
  data: [[string | datetime | double]]
}
