/**
 * All the options for UiDesigner components that have enum types for their color selection.
 */
enum type UiSdlChartColor {

  /**
   * Blue.
   */
  DARK_BLUE = '#253EB5'

  /**
   * Red-50 design token color.
   */
  RED50 = '#FF5271'

  /**
   * Green-50 design token color.
   */
  GREEN50 = '#30A18A'

  /**
   * Red.
   */
  RED = '#EA2D2B'

  /**
   * Green.
   */
  GREEN = '#228630'

  /**
   * Orange.
   */
  ORANGE = '#FB8839'

  /**
   * Lilac.
   */
  LILAC = '#6D18C3'

  /**
   * Light blue.
   */
  LIGHT_BLUE = '#2271E7'

  /**
   * Yellow.
   */
  YELLOW = '#E8CD01'

  /**
   * Olive.
   */
  OLIVE = '#82903C'

  /**
   * Sky.
   */
  SKY = '#2693DD'

  /**
   * Teal.
   */
  TEAL = '#009877'

  /**
   * Carbon.
   */
  CARBON = '#596881'

  /**
   * Mauve.
   */
  MAUVE = '#7B3F93'

  /**
   * Slate.
   */
  SLATE = '#8A90AB'

  /**
   * Purple.
   */
  PURPLE = '#B073FF'
}
