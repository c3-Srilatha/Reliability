/**
 * Type of legend.
 */
@typeScript
type UiSdlChartLegend {

  /**
   * Position of the legend.
   *
   * If the number of legend items is greater than 3, the legend position will
   * always be 'BELOW_CHART'
   */
  legendPosition: string enum('BELOW_CHART', 'WITHIN_PLOT_AREA') = 'WITHIN_PLOT_AREA'

  /**
   * If the {@link legendPosition} is configured to be 'WITHIN_PLOT_AREA', how to align it horizontally.
   */
  legendHorizontalAlignment: string enum('LEFT', 'RIGHT') = 'RIGHT'

  /**
   * If {@link legendPosition} is configured to be 'WITHIN_PLOT_AREA', how to align it vertically.
   */
  legendVerticalAlignment: string enum UiSdlVerticalAlignment = TOP

  /**
   * If the legend is configured to be 'WITHIN_PLOT_AREA', how to layout the items in the legend.
   */
  legendLayout: string enum('VERTICAL', 'HORIZONTAL') = 'VERTICAL'

  /**
   * Icon of the legend
   */
  legendIcon: string
}
