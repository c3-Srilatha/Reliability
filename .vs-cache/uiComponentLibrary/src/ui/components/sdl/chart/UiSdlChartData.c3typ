/**
 * A generic type to hold chart data.
 * Transformers that have the name "From" are assumed to transform data from
 * some other format into this type.
 * Transformers that have the name "To" are assumed to transform data from
 * this type to some other format.
 */
@typeScript
type UiSdlChartData {

  /**
   * Metric evaluation interval.
   */
  interval: string enum Interval

  /**
   * Corresponds to x-axis values.
   */
  labels: [string | datetime]

  /**
   * Corresponds to y-axis values, plus unit.  Multiple series are represented as array of arrays.
   */
  series: [UiSdlChartDataSeries]

  /**
   * The type of xAxis data, category or timeseries.
   */
  xAxisType: string enum('category', 'timeseries')

  /**
   * Indicates how much missing data there is for each of the sets of values in series.
   */
  missing: [[byte | int]]
}
