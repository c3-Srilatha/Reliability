/**
 * This types represents a fragment of the config object for eCharts.visualMap
 *
 * @see https://echarts.apache.org/en/option.html#visualMap
 */
@typeScript
type UiSdlChartEChartVisualMapConfig {
  /**
   * Whether or not to show the visual map
   */
  show: boolean = true
}
