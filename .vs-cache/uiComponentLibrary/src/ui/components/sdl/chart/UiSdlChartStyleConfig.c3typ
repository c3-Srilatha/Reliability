/**
 * Type to represent a chart style configuration
 */
type UiSdlChartStyleConfig {

  /**
   * Style of the chart background.
   */
  backgroundStyle: string enum('FULL_GRID', 'FREE_FORM', 'HORIZONTAL_LINES', 'VERTICAL_LINES') = 'FREE_FORM'
}
