/**
 * Type to represent echart grid config
 */
@typeScript
type UiSdlChartPlotAreaMargin {

  /**
   * Left padding that map to grid.left in echarts
   */
  left: int = 9

  /**
   * Right padding that map to grid.right in echarts
   */
  right: int = 9

  /**
   * Top padding that map to grid.top in echarts
   */
  top: int = 8

  /**
   * Bottom padding that map to grid.bottom in echarts
   */
  bottom: int = 2

  /**
   * ContainLabel that map to grid.containLabel param in echarts
   */
  containLabel: boolean = true
}
