/**
 * This types represents a fragment of the config object for eCharts.
 */
@typeScript
type UiSdlChartEChartConfig {

  /**
   * Can't use types here, because the eChart axis uses field
   * 'type' which breaks everything.
   */
  xAxes: [UiSdlChartEChartAxis]

  /**
   * Can't use types here, because the eChart axis uses field
   * 'type' which breaks everything.
   */
  yAxes: [UiSdlChartEChartAxis]

  /**
   * Maps to the echart config grid property;
   */
  grid: [UiSdlChartEChartsGrid]

  /**
   * Maps to the eChart config series property; contains the data that will
   * be charted.
   */
  series: [UiSdlChartEChartSeries]

  /**
   * Indicates how much missing data there is for each of the sets of values in series.
   */
  missing: [[byte | int]]
}
