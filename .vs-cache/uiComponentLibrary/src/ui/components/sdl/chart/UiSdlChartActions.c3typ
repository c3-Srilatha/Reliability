/**
 * Actions that can be performed on a chart.
 */
 @typeScript
type UiSdlChartActions {

  /**
   * Action to update the title for the time series line bar chart.
   *
   * @param id
   *           Id of the component.
   * @param title
   *           Title to update
   *
   * @returns a `TITLE_UPDATE` action for this instance with the following properties:
   * - payload {
   *      header: {
   *        titles: string
   *      },
   *      componentId: string
   *   }
   */
  @uiSdlActionCreator(actionType='TITLE_UPDATE')
  updateTitleAction: function(id: !string,
                              title: !string): UiSdlTitleUpdateAction ts-client

  /**
   * Listens for actions of type 'TITLE_UPDATE' and updates the title
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='TITLE_UPDATE')
  updateTitleReducer: private inline function( state: UiSdlReduxState,
                                              action: UiSdlTitleUpdateAction): UiSdlReduxState ts-client

  /**
   * Action to update the xAxis configuration for the time series.
   *
   * @param id
   *           Id of the component.
   * @param xAxis
   *           xAxis configuration to update
   *
   * @returns a `X_AXIS_UPDATE` action for this instance with the following properties:
   * - payload {
   *      xAxis: UiSdlLineBarChartXAxisConfig,
   *      componentId: string
   *   }
   */
  @uiSdlActionCreator(actionType='X_AXIS_UPDATE')
  updateXAxisAction: function(id: !string,
                              xAxis: !(UiSdlLineBarChartXAxisConfig | UiSdlHistogramXAxisConfig)): UiSdlUpdateXAxisAction ts-client

  /**
   * Listens for actions of type 'X_AXIS_UPDATE' and updates the xAxis configuration
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='X_AXIS_UPDATE')
  updateXAxisReducer: private inline function( state: UiSdlReduxState,
                                              action: UiSdlUpdateXAxisAction): UiSdlReduxState ts-client
                                              
  /**
   * Action to update the yAxis configuration for the time series.
   *
   * @param id
   *           Id of the component.
   * @param yAxis
   *           yAxis configuration to update
   *
   * @returns a `Y_AXIS_UPDATE` action for this instance with the following properties:
   * - payload {
   *      yAxis: UiSdlLineBarChartYAxisConfig,
   *      componentId: string
   *   }
   */
  @uiSdlActionCreator(actionType='Y_AXIS_UPDATE')
  updateYAxisAction: function(id: !string,
                              yAxis: !(UiSdlLineBarChartYAxisConfig | UiSdlHistogramYAxisConfig)): UiSdlUpdateYAxisAction ts-client

  /**
   * Listens for actions of type 'Y_AXIS_UPDATE' and updates the yAxis configuration
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='Y_AXIS_UPDATE')
  updateYAxisReducer: private inline function( state: UiSdlReduxState,
                                              action: UiSdlUpdateYAxisAction): UiSdlReduxState ts-client
}
