/**
 * The UI component type that displays data in pie chart
 */
@typeScript
@uiComponentCategorizer(name='Pie chart', category='Data Visualization')
type UiSdlPieChart mixes UiSdlComponent<UiSdlPieChartDataSpec>, UiSdlHideChartSeries, UiSdlChartColorConfig {

  /**
   * Chart header.
   */
  header: UiSdlComponentHeader

  /**
   * Chart legend configuration
   */
  legendConfig: UiSdlChartLegend

  /**
   * Chart type: 'Pie'
   */
  chartType: string enum('PIE') = 'PIE'

  /**
   * Setting for chartActions selection.
   */
  chartActions: [UiSdlAction] = [{name: 'UiSdlPieChart.chartActions.EXPORT_CHART_CSV.name', actionSuffix: 'EXPORT_CHART_CSV', iconSuffix: 'table'}, {name: 'UiSdlPieChart.chartActions.EXPORT_CHART_JPEG.name', actionSuffix: 'EXPORT_CHART_JPEG', iconSuffix: 'file-image'}, {name: 'UiSdlPieChart.chartActions.EXPORT_CHART_PNG.name', actionSuffix: 'EXPORT_CHART_PNG', iconSuffix: 'file-image'}]

  /**
   * Whether or not to show tooltip
   */
  tooltip: boolean = true

  /**
   * Whether or not to show label
   */
  showLabel: boolean = true

  /**
   * Holds the data to display on the chart
   */
  data: json

  /**
   * Breakpoints for combining backend data into groups.
   * Values between breakpoints will be combined into different chart groups
   */
  breakpoints: [float]

  /**
   * Whether it is possible or not to export the data
   */
  exportable: boolean = true

  /**
   * The specification used for retrieving data displayed on the chart
   */
  @uiSdlDataSpec(dataDestinationField='data')
  dataSpec: ~

  /**
   * Triggered when plotted item on the chart is clicked
   * @param id
   *            Id of the component.
   * @param payload
   *           object with any key-value data
   */
  @uiSdlActionCreator(actionType='ITEM_CLICK')
  triggerItemClick: function(id: string, payload: json): UiSdlReduxAction ts-client
}
