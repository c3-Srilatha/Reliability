/**
 * Setting for {@link UiSdlFieldSetFilterField}.
 */
@typeScript
type UiSdlFieldSetFilterFieldSetting mixes UiSdlFieldBasedDataSpecSetting, UiSdlFieldSetInputField, UiSdlFieldSetFormBaseFieldSetting {

  /**
   * The filter element to use for this field set filter.
   *
   * @see UiSdlFieldSetFilterField
   */
  filterElement: UiSdlFieldSetFilterField | UiSdlRadioButtonGroupFilterField | UiSdlTextInputFilterField | UiSdlTextAreaInputFilterField | UiSdlSelectInputFilterField | UiSdlIconSelectInputFilterField | UiSdlSingleSearchFilterField | UiSdlMultipleSearchFilterField | UiSdlSegmentedButtonFilterField | UiSdlToggleFilterField | UiSdlCheckboxTreeFilterField | UiSdlDateTimeInputFilterField | UiSdlNumberComparatorFilterField | UiSdlNumberRangeInputFilterField | UiSdlDateTimeRangeInputFilterField | UiSdlRadioButtonWithInputValueGroupFilterField

  /**
   * Another filter element that is used to filter the options for this input
   * element.
   */
  conditionalFilter: UiSdlFieldSetFilterFieldConditionalFilter

  /**
  * Whether the field's uppercase and lowercase letters are treated as distinct (caseSensitive = false)
  * or equivalent (caseSensitive = true)
  */
  caseSensitive: boolean = false

  /**
   *  Each {@link UiSdlFieldSetFilterFieldSetting} can filter multiple components on a page
   *  and each page can have multiple components that are expected to respond to a filter panel.
   *  This is a mapping that binds:
   *   types and their associated fields, that back the other components on a page
   *     ->
   *   this instance of {@link UiSdlFieldSetFilterFieldSetting}.
   *
   *  @example
   *  ```json
   *  {
   *    "MyApp.MyGridComponent": { "LightBulb": "manufacturer.name" },
   *    "MyApp.MyChartComponent": { "Manufacturer": "name" }
   *  }
   * ```
   */
  @uiSdlDesignerCustomRenderer(rendererType='SDLDataGrid')
  componentsToFilterMapping: UiSdlFieldSetFilterFieldComponentToFilterMapping
}
