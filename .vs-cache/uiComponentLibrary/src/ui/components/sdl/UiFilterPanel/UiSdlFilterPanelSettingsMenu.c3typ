/**
 * Dropdown items in a settings menu.
 */
@typeScript
type UiSdlFilterPanelSettingsMenu {

  /**
   * Gives users the option to save and load filter searches.
   */
  allowSaveAndLoadConfiguration: boolean

  /**
   * Gives users the option to switch to an advanced filtering mode. In this mode the filter panel
   * switches to a command line form where a user can type detailed queries to create more complex
   * filter requests.
   */
  allowAdvancedFilterMode: boolean
}
