/**
 * Setting for {@link UiSdlFieldSetInputField}.
 */
@typeScript
type UiSdlFieldSetInputFieldSetting mixes UiSdlFieldBasedDataSpecSetting, UiSdlFieldSetInputField, UiSdlFieldSetFormBaseFieldSetting {

  /**
   * The input element for this field set input field.
   */
  inputElement: UiSdlCustomInputBase | UiSdlTextInput | UiSdlTextAreaInput | UiSdlSelectInput | UiSdlIconSelectInput | UiSdlSingleSearch | UiSdlMultipleSearch | UiSdlSegmentedButton | UiSdlToggle | UiSdlCheckboxTree | UiSdlDateTimeInput | UiSdlNumberComparator | UiSdlNumberRangeInput | UiSdlDateTimeRangeInput | UiSdlRadioButtonGroup

  /**
   *  Each {@link UiSdlFieldSetInputFieldSetting} can filter multiple components on a page
   *  and each page can have multiple components that are expected to respond to a filter panel.
   *  This is a mapping that binds:
   *   types and their metric expression, that back the other components on a page
   *     ->
   *   this instance of {@link UiSdlFieldSetInputFieldSetting}.
   *  Input/Expression field is only used to filter at metric expression.
   *  All components that show up in the grid must have dataspec that extends {@link UiSdlMetricBasedDataSpec}
   *  @example
   *  ```json
   *  {
   *    "MyApp.MyTimeSeriesChartComponent": { "TestMetricEvaluatable ": "expression" },
   *    "MyApp.MyMetricTileComponent": { "TestMetricEvaluatable": "expression" },
   *  }
   * ```
   */
  @uiSdlDesignerCustomRenderer(rendererType='SDLDataGrid')
  metricBasedComponentsToInputMapping: UiSdlFieldSetInputFieldComponentToInputMapping
}
