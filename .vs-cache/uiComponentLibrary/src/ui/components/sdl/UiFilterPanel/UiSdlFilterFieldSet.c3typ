/**
 * A group of several controls as well as labels within a filter panel form.
 */
@typeScript
type UiSdlFilterFieldSet mixes UiSdlFormBaseFieldSet {

  /**
   * The group of fields within this field set.
   */
  fields: [UiSdlFieldSetInputFieldSetting | UiSdlFieldSetFilterFieldSetting]

  /**
   * Whether the field set is currently collapsed.
   */
  collapsed: boolean = false
}
