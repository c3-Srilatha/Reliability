/**
 * A type which represents a filter panel, which may be composed of 1-N form fields.
 * Generally used to create a filtered configuration to pass to a {@link UiSdlFilterable} component.
 */
@uiSdlDesignerComponent(designable=true,
                        category='UiSdlFilterPanel.CategoryName',
                        name='UiSdlFilterPanel.ComponentName',
                        icon='filter')
@typeScript
@uiComponentCategorizer(name='Filter panel', category='Patterns')
@uiBuildNestedDataSpecs
type UiSdlFilterPanel mixes UiSdlFormBase<UiSdlFilterPanelDataSpec> {

  /**
   * The data spec that will hold the the internal datasources for UiSdlFilterPanel.
   */
  @uiSdlDataSpec(dataDestinationField='internalData')
  internalDataSpec: private UiSdlFilterPanelInternalDataSpec

  /**
   * Stores the internal data defined in UiSdlFilterPanelInternalDataSpec.
   */
  internalData: private Obj

  /**
   * Component level boolean to disable a data fetch on first render.
   */
  disableDataRequestOnFirstRender:  ~ = false

  /**
   * Filter spec.
   */
  filterSpec: string

  /**
   * The text to display on the primary button in the filter panel.
   */
  filterButtonText: string = 'UiSdlFilterPanel.filterButtonText'

  /**
   * The text to display on the secondary button in the filter panel.
   */
  clearButtonText: string = 'UiSdlFilterPanel.clearButtonText'

  /**
  * Whether or not there was an error when trying to delete a saved search.
  */
  deleteSavedSearchesError: private boolean = false

  /**
   * A list of saved searches that have been deleted from the filter panel.
   */
  deletedSavedSearches: private [UiSdlSavedSearch]

  /**
   * A mapping from saved search id to its new name.
   */
  renamedSavedSearches: private map<string, string>

  /**
   * Text for the `Save Search` button.
   */
  saveSearchButtonText: string = 'UiSdlCommon.saveButtonText'

  /**
   * Text for the `Cancel` button on the save search subpanel.
   */
  cancelSaveSearchText: string = 'UiSdlCommon.cancelButtonText'

  /**
   * Text for the save search subtitle.
   */
  saveSearchSubtitle: string = 'UiSdlFilterPanel.saveSearchSubtitle'

  /**
   * Text for the save search title.
   */
  saveSearchTitle: string = 'UiSdlFilterPanel.saveSearchTitle'

  /**
   * Text for the rename search subpanel's subtitle.
   */
  renameSearchPanelSubtitle: string = 'UiSdlFilterPanel.renameSearchPanelSubtitle'

  /**
   * Text for the rename search subpanel's title.
   */
  renameSearchPanelTitle: string = 'UiSdlFilterPanel.renameSearchPanelTitle'

  /**
   * Text for the save search field label.
   */
  saveSearchFieldLabel: string = 'UiSdlFilterPanel.saveSearchFieldLabel'

  /**
   * Text for the advanced field label.
   */
  advancedFieldLabel: string = 'UiSdlFilterPanel.advancedFieldLabel'

  /**
   * Text for the load save search panel subtitle.
   */
  loadSearchPanelSubtitle: string = 'UiSdlFilterPanel.loadSearchPanelSubtitle'

  /**
   * Text for the load save search panel title.
   */
  loadSearchPanelTitle: string = 'UiSdlFilterPanel.loadSearchPanelTitle'

  /**
   * Subtitle for the filter panel.
   */
  subtitle: string

  /**
   * Text for the load save search panel's cancel button.
   */
  cancelLoadSearchButtonText: string = 'UiSdlFilterPanel.cancelLoadSearchButtonText'

  /**
   * Text for the save as private toggle button.
   */
  saveAsPrivateToggleText: string = 'UiSdlFilterPanel.saveAsPrivateToggleText'

  /**
   * Dropdown items in a settings menu.
   */
  settingsMenu: UiSdlFilterPanelSettingsMenu = {}

  /**
   * Helper function for updating the redux store with changes made to several field values.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   * @param componentId
   *           The component ID triggering the action.
   *
   * @returns A new Redux state.
   */
  inputChangeEffectHelper: private inline function(state: !UiSdlReduxState,
                                                   updatedFieldValues: [any],
                                                   componentId: string): !UiSdlReduxState ts-client

  /**
   * Triggered when the user submits the filter.
   *
   * @param id
   *            Id of the component.
   * @param event
   *           Browser event.
   * @param data
   *           A map of filter panel field values indexed by filter panel field name.
   *
   * @returns A `FILTER_SUBMIT` action for this instance.
   */
  @uiSdlActionCreator(actionType='FILTER_SUBMIT')
  submitFilterAction: function(id: !string, event: any, data: any): !UiSdlFilterPanelSubmitAction ts-client

  /**
   * Triggered when the user submits the filter.
   *
   * @param id
   *            Id of the component.
   * @param event
   *           Browser event.
   * @param advancedFilterString
   *           The filter string to use for filtering the component's datasource.
   *
   * @returns An `ADVANCED_FILTER_SUBMIT` action for this instance.
   */
  @uiSdlActionCreator(actionType='ADVANCED_FILTER_SUBMIT')
  submitAdvancedFilterAction: function(id: !string,
                                       event: any,
                                       advancedFilterString: string): !UiSdlAdvancedFilterSubmitAction ts-client

  /**
   * Triggered when input dataSources need to be loaded.
   *
   * @param id
   *            Id of the component.
   *
   * @returns An `INPUT_DS_LOAD` action for this instance.
   */
  @uiSdlActionCreator(actionType='INPUT_DS_LOAD')
  loadInputDataSourcesAction: function(id: !string): !UiSdlInputDsLoadAction ts-client

  /**
   * Triggered when a single input value changes.
   *
   * @param id
   *            Id of the component.
   * @param data
   *           The data passed from the presentational components.
   *
   * @returns A `SINGLE_INPUT_CHANGE` action for this instance with the following properties:
   * - payload.value {any} The value(s) of the input. Generally a string or int.
   * - componentId {string} The `id` of the component to which the items belong.
   */
  @uiSdlActionCreator(actionType='SINGLE_INPUT_CHANGE')
  changeSingleInputAction: function(id: !string, data: any): !UiSdlChangeInputAction ts-client

  /**
   * Triggered when Filter Panel is mounted.
   *
   * @param id
   *            Id of the component.
   *
   * @returns An `FIELD_VALUES_INIT` action for this instance.
   */
  @uiSdlActionCreator(actionType='FIELD_VALUES_INIT')
  initFieldValuesAction: function(id: !string): !UiSdlComponentActionPayload ts-client

  /**
   * Triggered when multiple inputs' values change at once.
   *
   * @param id
   *            Id of the component.
   * @param event
   *           Browser event.
   * @param data
   *           The data passed from the presentational components.
   *
   * @returns An `INPUT_CHANGE` action for this instance.
   */
  @uiSdlActionCreator(actionType='MULTIPLE_INPUTS_CHANGE')
  changeMultipleInputsAction: function(id: !string, data: any): !UiSdlChangeInputAction ts-client

  /**
   * Triggered when the user saves a search.
   *
   * @param id
   *           Id of the component.
   * @param savedSearchName
   *           The name of the search they want to save
   * @param saveAsPrivate
   *           The boolean to determine whether or not this is a global or private search.
   *
   * @returns A `SAVED_SEARCH_SUBMIT` action for this instance.
   */
  @uiSdlActionCreator(actionType='SAVED_SEARCH_SUBMIT')
  submitSavedSearchAction: function(id: !string,
                                    savedSearchName: string,
                                    saveAsPrivate: boolean): !UiSdlSavedSearchSubmitAction ts-client

  /**
   * Triggered when the user deletes a saved search.
   * @param id
   *           Id of the component.
   * @param savedSearch
   *           The saved search they want to delete.
   *
   * @returns A `SAVED_SEARCH_DELETE` action for this instance.
   */
  @uiSdlActionCreator(actionType='SAVED_SEARCH_DELETE')
  deleteSavedSearchAction: function(id: !string,
                                    savedSearch: UiSdlSavedSearch): !UiSdlSavedSearchDeleteAction ts-client

  /**
   * Triggered when the user renames a saved search.
   *
   * @param id
   *           Id of the component.
   * @param savedSearch
   *           The saved search they want to rename.
   * @param newName
   *           The new name for the saved search.
   *
   * @returns A `SAVED_SEARCH_RENAME` action for this instance.
   */
  @uiSdlActionCreator(actionType='SAVED_SEARCH_RENAME')
  renameSavedSearchAction: function(id: !string,
                                    savedSearch: !UiSdlSavedSearch,
                                    newName: !string,
                                    privateSearch: !boolean): !UiSdlSavedSearchRenameAction ts-client

  /**
   * Triggered when the user loads a search.
   *
   * @param id
   *           Id of the component.
   * @param savedSearchName
   *           The name of the search they want to save.
   *
   * @returns A `SAVED_SEARCHES_LOAD` action for this instance.
   */
  @uiSdlActionCreator(actionType='SAVED_SEARCHES_LOAD')
  loadSavedSearchesAction: function(id: !string): !UiSdlSavedSearchesLoadAction ts-client

  /**
   * Triggered when the user enters a filter string.
   *
   * @param id
   *            Id of the component.
   * @param filterString
   *           The filter string to validate.
   *
   * @returns A `FILTER_STRING_VALIDATE` action for this instance.
   */
  @uiSdlActionCreator(actionType='FILTER_STRING_VALIDATE')
  validateFilterStringAction: function(id: !string, filterString: string): !UiSdlFilterStringValidateAction ts-client

  /**
   * Listens for actions of type `SINGLE_INPUT_CHANGE` and updates the redux store with the updated field value.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='SINGLE_INPUT_CHANGE')
  singleInputChangeEffect: private inline function(state: !UiSdlReduxState,
                                                   action: !UiSdlChangeInputAction): !UiSdlReduxState ts-client


  /**
    * Listens for actions of type `FIELD_VALUES_INIT` and updates the redux store with the initial form field values.
    *
    * @param state
    *           Redux state.
    * @param action
    *           Redux action.
    *
    * @returns A new Redux state.
    */
  @uiSdlReducer(actionType='FIELD_VALUES_INIT')
  fieldValuesInitReducer: private function(state: !UiSdlReduxState,
                                                   action: !UiSdlChangeInputAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `MULTIPLE_INPUTS_CHANGE` and updates the redux store with updated field values.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='MULTIPLE_INPUTS_CHANGE')
  multipleInputsChangeEffect: private inline function(state: !UiSdlReduxState,
                                                      action: !UiSdlChangeInputAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `SAVED_SEARCH_DELETE`.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='SAVED_SEARCH_DELETE')
  savedSearchDeleteEffect: private inline function(state: !UiSdlReduxState,
                                                   action: !UiSdlSavedSearchDeleteAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `SAVED_SEARCH_RENAME`.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='SAVED_SEARCH_RENAME')
  savedSearchRenameEffect: private inline function(state: !UiSdlReduxState,
                                                   action: !UiSdlSavedSearchRenameAction): !UiSdlReduxState ts-client

  prepareFieldSetsForRendering: ~ ts-client

  /**
   * Triggers `FILTER_SUBMIT` on all filterable components that are filtered by this filter panel.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='FILTER_SUBMIT')
  filterSubmitEpic: private function(actionStream: !UiSdlActionsObservable,
                                     stateStream: !UiSdlStatesObservable): !UiSdlActionsObservable ts-client

  /**
   * Triggers `ARGUMENTS_MERGE` and `DATA_REQUEST` actions for a data source to save the current filters.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='SAVED_SEARCH_SUBMIT')
  savedSearchPersistEpic: private function(actionStream: !UiSdlActionsObservable,
                                           stateStream: !UiSdlStatesObservable): !UiSdlActionsObservable ts-client

  /**
   * Triggers `ARGUMENTS_MERGE` and `DATA_REQUEST` actions for a data source to load the saved searches.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='SAVED_SEARCHES_LOAD')
  savedSearchesLoadEpic: private function(actionStream: !UiSdlActionsObservable,
                                          stateStream: !UiSdlStatesObservable): !UiSdlActionsObservable ts-client

  /**
   * Triggers `ARGUMENTS_MERGE` and `DATA_REQUEST` actions for a data source to delete the given saved search.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='SAVED_SEARCH_DELETE')
  savedSearchDeleteEpic: private function(actionStream: !UiSdlActionsObservable,
                                          stateStream: !UiSdlStatesObservable): !UiSdlActionsObservable ts-client

  /**
   * Triggers 'NOTIFICATION_HIDDEN_SET' action to hide the notification.
   */
  @uiSdlActionCreator(actionType='NOTIFICATION_HIDDEN_SET')
  notificationHiddenSetAction: function(id: !string): !UiSdlInlineNotificationSetHiddenAction ts-client

  /**
   * Listens for actions of type `NOTIFICATION_HIDDEN_SET` and sets the 'hidden' property on the notification to the payload value.
   */
  @uiSdlReducer(actionType='NOTIFICATION_HIDDEN_SET')
  setNotificationHiddenReducer: private function(actionStream: !UiSdlActionsObservable,
                                              stateStream: !UiSdlStatesObservable): !UiSdlActionsObservable ts-client

  /**
   * Triggers `ARGUMENTS_MERGE` and `DATA_REQUEST` actions for a data source to rename the given saved search.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='SAVED_SEARCH_RENAME')
  savedSearchRenameEpic: private function(actionStream: !UiSdlActionsObservable,
                                          stateStream: !UiSdlStatesObservable): !UiSdlActionsObservable ts-client

  /**
   * Triggers `ARGUMENTS_MERGE` and `DATA_REQUEST` actions for a data source to validate the given filter string.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='FILTER_STRING_VALIDATE')
  filterStringValidateEpic: private function(actionStream: !UiSdlActionsObservable,
                                             stateStream: !UiSdlStatesObservable): !UiSdlActionsObservable ts-client

  /**
   * Triggers `ARGUMENTS_MERGE` and `DATA_REQUEST` actions for all filter fields which are dependent
   * on the changed input.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='SINGLE_INPUT_CHANGE')
  singleInputChangeEpic: private function(actionStream: !UiSdlActionsObservable,
                                          stateStream: !UiSdlStatesObservable): !UiSdlActionsObservable ts-client

  /**
   * Triggers `ARGUMENTS_MERGE` and `DATA_REQUEST` actions for each filter fields which are dependent
   * on the changed input when there's a multipleInputsChanged event.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='MULTIPLE_INPUTS_CHANGE')
  multipleInputsChangeEpic: private function(actionStream: !UiSdlActionsObservable,
                                          stateStream: !UiSdlStatesObservable): !UiSdlActionsObservable ts-client

  doDataMerge: ~ ts-client

  /**
   * Checks for existence of saved search with the given name; if none exists, persists it.
   *
   * @param name
   *           The name of the saved search.
   * @param typeName
   *           The name of the type on which the search would be executed.
   * @param serializedFilterFieldValues
   *           The JSON-serialized filter field values.
   * @param metadataId
   *           Metadata ID of react component on which the saved search is applicable.
   * @param privateSearch
   *           The boolean to determine whether or not this is a global or private search.
   *
   * @return `true` if save was successful, `false` if name already exists.
   */
  validateAndPersistSavedSearch: private function(name: !string,
                                          typeName: !string serialized Type,
                                          serializedFilterFieldValues: !string,
                                          metadataId: !string,
                                          privateSearch: boolean): boolean js-server

  /**
   * Checks to see if the given filter string + type name combo is valid.
   *
   * TODO: UI-8457 Change the return type to ExprValidateResult.
   *
   * @param typeName
   *           The name of the type on which the search would be executed.
   * @param filterString
   *           The filter string to validate.
   *
   * @return `true` if the filter string is valid for the given type,
   *         `error` if the filter string is incomplete or fields do not belong to type,
   *         `false` if the type does not exist.
   */
  validateFilterString: private function(typeName: !string serialized Type, filterString: string): string js-server

  /**
   * Triggered whenever a particular input is intended to be enabled or disabled.
   * @param id
   *            Id of the component.
   * @param field
   *            The field name to be enabled/disabled.
   * @param disable
   *            Whtether to enable or to disable the input. Setting to true will disable the input and setting to false
   *            will enable it.
   *
   * @return An 'FILTER_INPUT_(ENABLE|DISABLE)' action for this instance with the following properties:
   * - payload.field {string} The field the input is responsible for.
   */
  @uiSdlActionCreator(actionType='FILTER_INPUT_(ENABLE|DISABLE)')
  enableDisableFilterInputAction: function(id: !string,
                                     field: !string,
                                     disable: boolean): !UiSdlFilterInputEnableDisableAction ts-client

  /**
   * Helper function to enable or disable a filter input.
   *
   * @param state
   *          Redux state.
   * @param fieldName
   *          Name of the field to be enabled/disabled.
   * @param disable
   *          Whether to disable the field or not.
   * @param componentId
   *          Id of the current component instance.
   *
   * @returns A new Redux state.
   */
  enableDisableFilterInputHelper: private function(state: !UiSdlReduxState,
                                             fieldName: !string,
                                             disable: boolean,
                                             componentId: !string): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `FILTER_INPUT_ENABLE`, and sets the 'disabled' property on the input to be false.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='FILTER_INPUT_ENABLE')
  filterInputEnableReducer: function(state: !UiSdlReduxState,
                              action: !UiSdlFilterInputEnableDisableAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `FILTER_INPUT_DISABLE`, and sets the 'disabled' property on the input to be true.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='FILTER_INPUT_DISABLE')
  filterInputDisableReducer: function(state: !UiSdlReduxState,
                               action: !UiSdlFilterInputEnableDisableAction): !UiSdlReduxState ts-client
}
