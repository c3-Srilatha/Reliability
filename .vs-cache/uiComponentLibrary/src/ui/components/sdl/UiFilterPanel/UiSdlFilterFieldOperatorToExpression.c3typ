/**
 * Enum type for operator to expression on filter.
 */
enum type UiSdlFilterFieldOperatorToExpression {

  /**
   * Equal.
   */
  EQUALS = 'eq'

  /**
   * Contains.
   */
  CONTAINS = 'contains'

  /**
   * Starts with.
   */
  STARTS_WITH = 'startsWith'

  /**
   * Ends with.
   */
  ENDS_WITH = 'endsWith'

  /**
   * Less than.
   */
  LESS_THAN = 'lt'

  /**
   * Greater than.
   */
  GREATER_THAN = 'gt'

  /**
   * Less than or equal to.
   */
  LESS_THAN_OR_EQUAL_TO = 'le'

  /**
   * Greater than or equal to.
   */
  GREATER_THAN_OR_EQUAL_TO = 'ge'

  /**
   * Not equal.
   */
  NOT_EQUAL = 'ne'

  /**
   * In between.
   */
  IN_BETWEEN = ''

  /**
   * Outside of.
   */
  OUTSIDE_OF = ''
}
