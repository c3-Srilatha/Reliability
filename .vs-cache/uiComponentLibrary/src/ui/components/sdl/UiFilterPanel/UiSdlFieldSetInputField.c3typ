/**
 * Base type for input fields.
 */
@typeScript
abstract type UiSdlFieldSetInputField {

  /**
   * A label to be shown above the input.
   */
  label: !string

  /**
   * Descriptive text to aid the user in interacting with this input.
   */
  hintText: string
}
