/**
 * Allows the possible values of a filter field to be controlled by the value
 * of another filter field.
 */
@typeScript
type UiSdlFieldSetFilterFieldConditionalFilter mixes UiSdlDynamicOptionsGeneratable {

  /**
   * A reference to the parent filter field that should control the values of
   * this filter field.
   */
  parentFilter: string

  /**
   * The name of the field to use as an operand in the generated filter string
   * for this input.
   */
  field: string = 'id'

  getDynamicOptionsForField: ~
}
