/**
 * Base type for filter fields.
 */
@typeScript
@uiSdlPluggable(namespace='filterComponents')
abstract type UiSdlFieldSetFilterField<I> {

  /**
   * The input element for this filter field.
   */
  inputElement: I

  /**
   * The operator to use in the filter generated from the value provided by the
   * input element.
   */
  operator: string
}
