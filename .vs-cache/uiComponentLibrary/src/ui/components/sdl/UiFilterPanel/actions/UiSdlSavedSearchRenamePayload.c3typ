/**
 * Payload for a {@link UiSdlSavedSearchRenameAction}.
 */
type UiSdlSavedSearchRenamePayload mixes UiSdlComponentActionPayload {

  /**
   * The saved search they want to rename.
   */
  savedSearch: !UiSdlSavedSearch

  /**
   * The new name for the saved search.
   */
  name: !string
}
