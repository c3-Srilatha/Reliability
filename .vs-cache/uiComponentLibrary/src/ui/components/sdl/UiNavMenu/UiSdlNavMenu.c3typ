/**
 * A UI component type for the primary navigation menu.
 */
@typeScript
@uiComponentCategorizer(name='Nav menu', aliases=['Navigation Menu'], category='Components')
type UiSdlNavMenu mixes UiSdlComponent<any> {

  /**
   * Optional configuration to display menu items' names in a tooltip when hovering.
   */
  showMainMenuItemLabelInTooltip: boolean = false

  /**
   * Optional configuration of the logo to display at the top of the menu.
   * If not provided, logo will be loaded using token `--c3-style-logoIconUrls`, which is theme aware.
   */
  logoImageUrl: string

  /**
   * A group of items in a primary menu.
   */
  itemSections: ![UiSdlNavMenuSection]

  /**
   * Optional items to display within the menu's footer.
   */
  footer: UiSdlNavMenuSection

  /**
   * Whether its sub menu is collapsed.
   */
  subMenuCollapsed: boolean

  /**
   * The nav menu item that it's currently hovered.
   */
  hoveredNavMenuItemId: string

  /**
   * Triggered when an item is clicked.
   *
   * @param id
   *           Id of the component.
   * @param item
   *           {@link UiSdlNavMenuItem}.
   *
   * @returns A `MENU_ITEM_CLICK` action for this instance.
   */
  @uiSdlActionCreator(actionType='MENU_ITEM_CLICK')
  clickItemAction: function(id: string, siteId: !string, item: !UiSdlNavMenuItem): UiSdlMenuItemClickAction ts-client

  /**
   * Triggered when the sub menu action is clicked to toggle the submenu.
   *
   * @param id
   *           Id of the component.
   * @param itemId
   *           ID of the menu item.
   *
   * @returns A `MENU_ITEM_CLICK` action for this instance.
   */
  @uiSdlActionCreator(actionType='SUB_MENU_ACTION_CLICK')
  clickSubMenuActionAction: function(id: string): UiSdlSubMenuActionClickAction ts-client

  /**
   * Triggered to update {@link hoveredNavMenuItemId} in state.
   *
   * @param id
   *           Id of the component.
   * @param event
   *           Hover event.
   * @param navMenuItemId
   *           Hovered navigation menu item id.
   *
   * @return A `NAV_MENU_ITEM_HOVER_ON` action for this instance.
   */
  @uiSdlActionCreator(actionType='NAV_MENU_ITEM_HOVER_ON')
  hoverOnNavMenuItemAction: function(id: string,
                                     event: json,
                                     navMenuItemId: string): UiSdlNavMenuItemHoverOnAction ts-client

  /**
   * Triggered to clear {@link hoveredNavMenuItemId} in state.
   *
   * @param id
   *           Id of the component.
   *
   * @return A `NAV_MENU_ITEM_HOVER_OFF` action for this instance.
   */
  @uiSdlActionCreator(actionType='NAV_MENU_ITEM_HOVER_OFF')
  hoverOffNavMenuItemAction: function(id: string): UiSdlNavMenuItemHoverOffAction ts-client

  /**
   * Listens for actions of type `NAV_MENU_ITEM_HOVER_ON` and updates internal
   * field {@link hoveredNavMenuItemId}.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='NAV_MENU_ITEM_HOVER_ON')
  navMenuItemHoverOnEffect: private inline function(state: !UiSdlReduxState,
                                                    action: !UiSdlNavMenuItemHoverOnAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `NAV_MENU_ITEM_HOVER_OFF` and clear {@link hoveredNavMenuItemId} field value.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='NAV_MENU_ITEM_HOVER_OFF')
  navMenuItemHoverOffEffect: private inline function(state: !UiSdlReduxState,
                                                     action: !UiSdlNavMenuItemHoverOffAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `SUB_MENU_ACTION_CLICK` and updates the {@link subMenuCollapsed} value.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='SUB_MENU_ACTION_CLICK')
  subMenuActionClickEffect: private inline function(state: !UiSdlReduxState,
                                                    action: !UiSdlSubMenuActionClickAction): !UiSdlReduxState ts-client

  /**
   * Recursively finds the first available url from the nav item {@link UiSdlNavMenuItem}.
   * It gets the first available link from the nav item itself or its item from hoveredSubMenu.
   *
   * @param item
   *         The nav item that's where the url is from.
   */
  getRedirectUrl: private inline function(item: UiSdlNavMenuItem): string ts-client

  /**
   * Triggers a `${siteId}.REDIRECT` when site ID is provided or a `GLOBAL_REDIRECT` action otherwise,
   * when an item is clicked.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='MENU_ITEM_CLICK')
  itemClickEpic: private function(actionStream: UiSdlActionsObservable,
                                  stateStream: UiSdlStatesObservable): UiSdlActionsObservable ts-client
}
