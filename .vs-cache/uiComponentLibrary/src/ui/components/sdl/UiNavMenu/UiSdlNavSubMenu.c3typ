/**
 * A UI component type for the secondary menu component within the navigation menu.
 */
@typeScript
type UiSdlNavSubMenu {

  /**
   * Optional configuration of the logo to display at the top of the menu, next to the title.
   */
  logoImageUrl: string

  /**
   * The title to display at the top of the submenu.
   */
  title: string | UiSdlDynamicValueSpec

  /**
   * The subtitle to display at the top of the submenu. Will appear below the {@link #title}.
   */
  subtitle: string | UiSdlDynamicValueSpec

  /**
   * The detail text to display at the top of the submenu. Will appear below the {@link #subtitle}.
   */
  detail: string | UiSdlDynamicValueSpec

  /**
   * The items to display within the submenu.
   */
  items: ![UiSdlNavMenuItem | UiSdlNavMenuSection]
}
