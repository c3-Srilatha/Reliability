/**
 * A UI component type to represent a single item within the navigation menu.
 */
@typeScript
type UiSdlNavMenuItem {

  /**
   * Unique ID of the item.
   */
  id: !string

  /**
   * The title to display within the item.
   */
  title: string

  /**
   * The tooltip to display when hovered.
   */
  tooltip: string

  /**
   * The submenu for the navigation item.
   */
  subMenu: UiSdlNavSubMenu

  /**
   * Optional name of the FontAwesome icon to display within the item.
   */
  icon: string

  /**
   * Optional route to redirect to when the item is clicked.
   */
  redirectRoute: UiSdlRoute

  /**
   * Optional submenu that should appear when the mouse hovers over the item.
   */
  hoveredSubMenu: UiSdlNavSubMenu
}
