/**
 * A UI component type to represent a group of items in the navigation menu.
 */
@typeScript
type UiSdlNavMenuSection {

  /**
   * Title to display at the top of the section.
   */
  title: string

  /**
   * The items to display within the group.
   */
  items: [UiSdlNavMenuItem]
}
