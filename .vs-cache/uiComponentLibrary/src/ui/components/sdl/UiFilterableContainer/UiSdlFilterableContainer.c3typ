/**
 * A UI component type that holds a filter and an array of other components.
 */
@typeScript
@uiComponentCategorizer(name='Filterable container', category='Components')
type UiSdlFilterableContainer mixes UiSdlComponent<UiSdlNoData>, UiSdlComponentTitle, UiSdlComponentSubtitle {
  /**
   * Label text for the filter
   */
  filterLabel: string serialized UiSdlDynamicValueSpec

  /**
   * A single search component serves as a filter
   * Note: Use a componentRef to make this filter connect to backend and make API calls
   * Only define a `UiSdlSingleSearch` will just get the UI component, no API connect to it. It is just for backward compatibility.
   */
  filterComponent: UiSdlComponentRef<UiSdlSingleSearch> | UiSdlSingleSearch

  /**
   * Interval field to set the value of the filter
   */
  filterValue: string

  /**
   * An array of children components
   */
  children: [UiSdlComponentRef<UiSdlComponent>]

  /**
   * Listens for actions of type `SINGLE_INPUT_CHANGE`, and sets a filter value to the component state.
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='SINGLE_INPUT_CHANGE')
  singleInputChangeReducer: private inline function(state: !UiSdlReduxState,
                                                               action: !UiSdlReduxAction): !UiSdlReduxState ts-client


  /**
   * Triggered when the filter component value changes.
   *
   * @param id
   *            Id of the component.
   * @param data
   *           The data passed from the presentational components.
   *
   * @returns A `SINGLE_INPUT_CHANGE` action for this instance with the following properties:
   * - payload.value {any} The value(s) of the input. Generally a string or int.
   * - componentId {string} The `id` of the component to which the items belong.
   */
  @uiSdlActionCreator(actionType='SINGLE_INPUT_CHANGE')
  changeSingleInputAction: function(id: !string, data: any): !UiSdlChangeInputAction ts-client
}
