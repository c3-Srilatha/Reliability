/**
 * DateTime range input component type.
 */
@typeScript
@uiComponentCategorizer(name='Date time range input', category='Components')
type UiSdlDateTimeRangeInput mixes UiSdlComponent<UiSdlDateTimeRangeDataSpec>, UiSdlDateTimeInputBase {

  /**
   * The specification used for retrieving data for the range of available dates.
   */
  @uiSdlDataSpec(dataDestinationField='dataCollection')
  dataSpec: ~

  /**
   * Holds the data to set the range of available dates.
   */
  dataCollection: [Obj]

  /**
   * Label to display above the start date.
   */
  startLabel: string

  /**
   * Label to display above the end date.
   */
  endLabel: string

  /**
   * Placeholder to display for the start date.
   */
  startPlaceholder: string

  /**
   * Placeholder to display for the end date.
   */
  endPlaceholder: string

  /**
   * Whether the end date is inclusive when {@link UiSdlDateTimeInputBase#showTimePicker} is false
   */
  endDateInclusive: boolean = false

  /**
   * Whether to disable the start and end date inputs
   */
  disabled: boolean
}
