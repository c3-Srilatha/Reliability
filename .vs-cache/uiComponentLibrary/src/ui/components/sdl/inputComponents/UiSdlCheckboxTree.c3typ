/**
 * Checkbox tree component type.
 */
@typeScript
@uiComponentCategorizer(name='Checkbox', category='Components')
type UiSdlCheckboxTree mixes UiSdlComponent<UiSdlCheckboxTreeDataSpec> {

  /**
   * The specification used for retrieving data displayed in checkbox.
   */
  @uiSdlDataSpec(dataDestinationField='options')
  dataSpec: ~

  /**
   * Holds the data to display in the checkbox.
   */
  @uiSdlDesignerCustomRenderer(rendererType='SDLDataGrid')
  options: [json]

  /**
   * A list of preconfigured nodes.
   */
  nodes: [json]

  /**
   * Whether the checkbox can be cleared.
   */
  clear: boolean

  /**
   * A list of expanded node values.
   */
  expanded: [string]

  /**
   * The field path used for the display text of each checkbox option.
   */
  displayField: string

  /**
   * The field path used for the underlying value of each checkbox option.
   */
  valueField: string
}
