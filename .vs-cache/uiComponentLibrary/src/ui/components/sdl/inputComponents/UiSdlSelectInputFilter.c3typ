/**
 * Input component type for select input filter.
 */
@typeScript
@uiComponentCategorizer(name='Select input filter', category='Components', hide=true)
type UiSdlSelectInputFilter mixes UiSdlSelectInput {

  /**
   * The specification used for retrieving data displayed in the dropdown.
   */
  @uiSdlDataSpec(dataDestinationField='options')
  @uiSdlDesignerCustomRenderer(rendererType='FilterFieldDataSpec')
  dataSpec: ~

  /**
   * Holds the data to display in the dropdown.
   */
  options: ~
}
