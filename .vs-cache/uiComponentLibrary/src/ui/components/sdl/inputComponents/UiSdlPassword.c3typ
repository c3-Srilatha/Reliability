/**
 * Input element type for password.
 */
@typeScript
@uiComponentCategorizer(name='Password', category='Components')
type UiSdlPassword mixes UiSdlComponent<UiSdlNoData> {

  /**
   * HTML for an icon to be appended to the input element.
   */
  appendedIcon: any

  /**
   * If used in a form, the field this component is associated with.
   */
  field: string

  /**
   * The config for the hint link located below the field.
   */
  hintLink: json

  /**
   * HTML attributes to set on the 'input' HTML tag; see SDLInput for more information.
   */
  inputProps: any

  /**
   * The placeholder text to display in the input element.
   */
  placeholder: string

  /**
   * HTML for an icon to be prepended to the input element.
   */
  prependedIcon: any

  /**
   * The initial value to display in the input element.
   */
  value: string

  /**
   * Whether the dropdown will take the full width of its parent.
   */
  fluid: boolean
}
