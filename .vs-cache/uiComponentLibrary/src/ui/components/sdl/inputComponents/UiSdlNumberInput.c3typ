/**
 * Number input component type.
 */
@typeScript
@uiComponentCategorizer(name='Number input', category='Components')
type UiSdlNumberInput mixes UiSdlComponent<UiSdlNoData>, UiSdlDebounceableInput {

  /**
   * The maximum value allowed.
   */
  max: double

  /**
   * The minimum value allowed.
   */
  min: double

  /**
   * The amount by which the value is increased or decreased when stepping. Button click or arrow key up / down.
   */
  step: double

  /**
   * Content to appear in the input when the input is empty.
   */
  placeholder: string

  /**
   * Whether the dropdown will take the full width of its parent.
   */
  fluid: boolean
}
