/**
 * Input component type for an atomic segmented button.
 */
@typeScript
@uiComponentCategorizer(name='Segmented button (new)', aliases=['Atomic Segmented Button'], category='Components')
type UiSdlAtomicSegmentedButton mixes UiSdlComponent<UiSdlNoData> {

  /**
   * A list of buttons to display in the segment button group
   * Should be an array of 2-5 buttons
   */
  buttons: ![UiSdlSegmentedButtonConfig]

  /**
   * What mode the segmented button should operate under
   */
  mode: string enum('single-select', 'multi-select') = 'single-select'

  /**
   * A configuration to ensure that at least one button is selected at all times.
   * if no value is set, then the first button will be selected.
   */
  minOneSelected: boolean = false

  /**
   * The height of the segmented button
   */
  height: string enum('small', 'medium', 'large') = 'medium'

  /**
   * Whether the width should be 'full' - take up as much space as possible
   * and scale each button accordingly - or 'fixed' - each button takes up only the
   * space required with a fixed spacing on either side of the label/icon
   */
  layout: string enum('fixed', 'full') = 'full'

  /**
   * The value(s) that the segmented button will originally have selected.
   * If multiple are entered but the button is set to 'single-select', only
   * the first will be honored.
   */
  value: [string] = []

  /**
   * Extra status states that the segmented button could be in.
   */
  status: string enum('readonly', 'disabled', 'none') = 'none';

  /**
   *  The variant of the segmented button, where 'outlined' has a border around each button, and 'ghost' has no border.
   *  The default is 'outlined'.
   */
  variant: string enum('outlined', 'ghost') = 'outlined'

  /**
   * Action dispatched to set the value of segmented button.
   */
  @uiSdlActionCreator(actionType='SET_SEGMENTED_BUTTON_VALUE')
  segmentedButtonValueSetAction: function(id: string, value: any): !UiSdlSegmentedButtonValueSetAction ts-client

  /**
   * Action dispatched to set text field status.
   */
  @uiSdlActionCreator(actionType='SET_SEGMENTED_BUTTON_STATUS')
  segmentedButtonStatusSetAction: function(id: string, value: any): !UiSdlSegmentedButtonStatusSetAction ts-client

  /**
   * Reducer to set the value of segmented button.
   */
  @uiSdlReducer(actionType='SET_SEGMENTED_BUTTON_VALUE')
  segmentedButtonValueSetReducer: function(state: UiSdlReduxState, action: UiSdlSegmentedButtonValueSetAction): UiSdlReduxState ts-client

  /**
   * Reducer to set the status of segmented button.
   */
  @uiSdlReducer(actionType='SET_SEGMENTED_BUTTON_STATUS')
  segmentedButtonStatusSetReducer: function(state: UiSdlReduxState, action: UiSdlSegmentedButtonStatusSetAction): UiSdlReduxState ts-client
}
