/**
 * Details for an actionable option on the dropdown component.
 * For more details, refer to {@link UiSdlSearchActionableOptionsConfig}.
 */
@typeScript
type UiSdlSearchActionableOption {

  /**
   * Raw text to show on the option. This would be a combination of static and dynamic texts.
   * The dynamic portion would come from user's search input from the dropdown.
   * Format: Use `${INPUT}` to specify in the rawText string.
   * e.g. "Create ${INPUT} as a new option"
   */
  rawText: string | UiSdlDynamicValueSpec

  /**
   * The action to dispatch when the user selects this option.
   */
  actionSuffix: string
}
