/**
 * Base type representing all the different input types available.
 * Generally used in {@link UiSdlForm} and {@link UiSdlFilterPanel}.
 */
@typeScript
type UiSdlComponentInput {

  /**
   * The SDL input to use.
   */
  componentType: !string
}
