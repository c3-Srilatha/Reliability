@typeScript
type UiSdlDateTimeInputBase {
  /**
   * Whether to allow user type with keyboard or not
   * NOTE: Keyboard editing only support en_US locale
   * Meaning format dates as `MM/DD/YYYY, hh:mm`
   * Other locale should disable keyboard edit
   */
  allowKeyboardEdit: boolean = false

  /**
   * Whether to show time picker or not
   */
  showTimePicker: boolean = true

  /**
   * The step minutes of time picker, unit is minute
   * if timePickerStepMinutes = 15, meaning time selector displays in 15 minutes gap
   * 12:00 AM, 12:15 AM, 12:30 AM etc. and more
   */
  timePickerStepMinutes: int = 15


  /**
   * Whether or not the dateTimeInput should be only in UTC time
   */
  noTimeZoneConversion: boolean = false

  /**
   * Triggered to validate input date time.
   *
   * @param id
   *            Id of the parent component.
   * @param inputValue
   *            User typed raw string value.
   *
   * @returns An `INPUT_DATETIME_VALIDATE` action for this instance.
   */

  @uiSdlActionCreator(actionType='INPUT_DATETIME_VALIDATE')
  validateInputDatetimeAction: function(id: !string, inputValue: string): !UiSdlValidateInputDatetimeAction ts-client
}
