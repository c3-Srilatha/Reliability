/**
 * This component is similar to {@link UiSdlSelectInput}, with the only difference being that the text values
 * configured to be displayed for each field is translated to an icon (i.e. 'basketball ball' is translated
 * to an icon depicting a basketball).
 */
@typeScript
@uiComponentCategorizer(name='Icon select input', aliases=['Icon Select Input'], category='Components')
type UiSdlIconSelectInput mixes UiSdlSelectInput
