/**
 * The type to represent a range of dates for use in {@link UiSdlDateTimeRangeDataSpec}
 */
@typeScript
type UiSdlDateRange {
  /**
  * The datetime or {@link UiSdlFieldBasedDataSpecSetting} to represent the beginning of the date range, included in dates.
  */
  rangeStart: datetime | UiSdlFieldBasedDataSpecSetting

  /**
  * The datetime or {@link UiSdlFieldBasedDataSpecSetting} to represent the end of the date range, excluded from dates.
  */
  rangeEnd: datetime | UiSdlFieldBasedDataSpecSetting
}
