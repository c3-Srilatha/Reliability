/**
 * NumberRange input component type.
 */
@uiComponentCategorizer(name='Number range input', category='Components')
type UiSdlNumberRangeInput mixes UiSdlNumberInput {

  /**
   * The value to step by when adding interval marks to the slider. Steps will be added starting at
   * min by markStep up to and include min.
   * Example min = 0; max = 100; markStep = 25 A mark will be located at each point [0, 25, 50, 75, 100]
   * These are the visual tick marks along the bottom of the slider bar and have no functional implications
   * on the slider.
   */
  markStep: double

  /**
   * The label to apply to the max field.
   */
  @uiSdlDesignerCustomRenderer(rendererType='SDLInput')
  maxLabel: string | UiSdlDynamicValueSpec

  /**
   * The label to apply to the min field.
   */
  @uiSdlDesignerCustomRenderer(rendererType='SDLInput')
  minLabel: string | UiSdlDynamicValueSpec

  /**
   * Whether or not to show inputs.
   */
  hideInput: boolean = false

  /**
   * Whether or not to show the range slider.
   */
  hideSlider: boolean = false
}
