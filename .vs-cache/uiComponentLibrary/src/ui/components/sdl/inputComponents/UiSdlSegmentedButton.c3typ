/**
 * Input component type for segmented button.
 */
@typeScript
@uiComponentCategorizer(name='Segmented button', category='Components')
type UiSdlSegmentedButton mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The value that the button holds.
   */
  value: string

  /**
   * A list of buttons to display in the segment button group.
   */
  buttons: [UiSdlSegmentedButtonConfig]

  /**
   * A configuration to ensure that once a button is selected (has a value), it cannot be deselected
   */
  noDeselect: boolean = false

  /**
   * The name of the field.
   */
  fieldName: string

  /**
   * The size of the segmented button that controls font and height.
   */
  size: string enum('small', 'medium', 'large') = 'large'

  /**
   * The width of the segmented button, where 'fixed' has a fixed padding around
   * each button label, and 'full' takes up the full width of the container.
   */
  layout: string enum('fixed', 'full') = 'fixed'

  /**
   * Allow multiple selections
   */
  multiple: boolean = false

  /**
   *  The variant of the segmented button, where 'outlined' has a border around each button, and 'ghost' has no border.
   *  The default is 'outlined'.
   */
  variant: string enum('outlined', 'ghost') = 'outlined'
}
