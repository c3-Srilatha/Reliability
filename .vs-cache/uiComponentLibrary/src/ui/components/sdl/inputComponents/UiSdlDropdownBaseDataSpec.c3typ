/**
 * The specification of data retrieval for instances of the {@link UiSdlMultipleSearch} component type.
 */
@typeScript
type UiSdlDropdownBaseDataSpec mixes UiSdlFieldBasedDataSpec {

  /**
   * The pre-specified parameters of the action, keyed by parameter name.
   */
  args: json

  /**
   * Action on the {@link dataType}.
   */
  actionName: string = 'fetch'

  /**
   * Field path to the data in the response type of the action.
   * e.g. for fetch action, dataPath is usually 'objs'
   */
  dataPath: string

  /**
   * Field to show as value.
   */
  valueField: string

  /**
   * Field to display.
   */
  displayField: string

  /**
   * Converts the data spec to a partially applied action.
   */
  toPartiallyAppliedActions: ~ ts-client
}
