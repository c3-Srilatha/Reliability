/**
 * Input component type for text input.
 */
@typeScript
@uiSdlDesignerGlobalFilterComponent
@uiComponentCategorizer(name='Text input', category='Components')
type UiSdlTextInput mixes UiSdlInputBase<UiSdlNoData>, UiSdlDebounceableInput {

  /**
   * Content to appear in the input when the input is empty.
   */
  placeholder: string

  /**
   * Whether the dropdown will take the full width of its parent.
   */
  fluid: boolean

  /**
   * Right-aligned static text, which can be up to 4 characters. Text input greater than 4 characters will
   * be truncated.
   */
  appendedTag: string

  /**
   * Whether the input will utilize inline editing and confirmation.
   */
  confirmable: boolean
}
