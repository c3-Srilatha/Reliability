/**
 * Input component type for a group of fields.
 */
@typeScript
@uiComponentCategorizer(name='Field group', category='Components', hide=true)
type UiSdlFieldGroup mixes UiSdlComponent<UiSdlNoData> {

  /**
   * Array of fields that belong to the field group, each representing a component to be
   * rendered within the group.
   */
  fieldGroupFields: [UiSdlFieldSetFormFieldSetting]

  /**
   * Array that holds the widths of each field in the order that the fields are rendered.
   */
  widthRatio: [float]
}
