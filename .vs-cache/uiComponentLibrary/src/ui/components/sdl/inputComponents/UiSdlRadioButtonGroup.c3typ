/**
 * Input component type for a group of radio buttons.
 */
@typeScript
@uiComponentCategorizer(name='Radio button group', aliases=['Radio Button'], category='Components')
type UiSdlRadioButtonGroup mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The configurations of the radio buttons. Each button should have its `value` and `label`:
   * ```
   * "radioButtons": [
   *   {
   *     "value": "true",
   *     "label": "Yes",
   *   },
   *   {
   *     "value": "false",
   *     "label": "No"
   *   }
   * ]
   */
  radioButtons: [map<string, string | UiSdlDynamicValueSpec>]
}
