@typeScript
@uiComponentCategorizer(name='Radio button with input value group', category='Components', hide=true)
type UiSdlRadioButtonWithInputValueGroup mixes UiSdlComponent<UiSdlNoData> {

  /**
   * All the radio options. In contrast to {@link UiSdlRadioButtonGroup}, each option will have
   * its own "fieldName" as identifiers when selected.
   */
  radioButtons: [UiSdlRadioButtonWithInputValue]

  /**
   * Whether or not to store the value as an array in the format of:
   * [<selectedRadioButtonFieldName>, <valueOfInput>]
   * This is particularly useful if used in a filter panel and the value needs to be
   * serialized into a filter string. Note that with this though, a custom parse of
   * the filter string will likely need to happen in the backend.
   * If not set, the filter string will contain JSON.stringify version of the object.
   */
  valueAsArray: boolean
}
