/**
 * Input Item type for the selected value of the component.
 */
@typeScript
type UiSdlSelectedInputItem {

  /**
   * Text displayed in the input component for the selected value.
   */
  text: string

  /**
   * Value of the selected input component.
   */
  value: string | boolean | int | [string | boolean | int]
}
