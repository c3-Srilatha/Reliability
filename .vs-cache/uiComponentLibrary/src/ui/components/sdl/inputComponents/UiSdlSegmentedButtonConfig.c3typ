/**
 * Configuration type for {@link UiSdlSegmentedButton}.
 */
@typeScript
type UiSdlSegmentedButtonConfig {

  /**
   * The string label to show on the button.
   */
  label: string

  /**
   * The value the button holds in component props.
   */
  value: string

  /**
   * The icon to show on the button.
   * If both icon and label are defined, icon will be rendered to 
   * the left of the label.
   * Should be the icon suffix, e.g. c3-icon-caret-up --> "caret-up"
   */
  icon: string
}
