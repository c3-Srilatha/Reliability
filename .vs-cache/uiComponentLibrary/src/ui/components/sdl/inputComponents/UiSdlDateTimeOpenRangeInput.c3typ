/**
 * DateTime open range input component type.
 * Same as UiSdlDateTimeRangeInput but with a start or end date being required.
 * In order for the start or end validation to occur, the field must be marked as required, along with the start or end.
 */
@typeScript
@uiComponentCategorizer(name='Date time range open input', category='Components')
type UiSdlDateTimeOpenRangeInput mixes UiSdlDateTimeRangeInput {
  /**
   * Whether the start date is required.
   */
  requiredStart: boolean = false

  /**
   * Whether the end date is required.
   */
  requiredEnd: boolean = false
}
