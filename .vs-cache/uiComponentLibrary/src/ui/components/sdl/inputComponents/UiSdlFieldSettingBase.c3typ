/**
 * The base type for {@link UiSdlFieldSettingNested} and {@link UiSdlFieldSetFormFieldSetting}.
 * It is used to as a base to create more specialized field setting types, which are used in {@link UiSdlForm}.
 */
@typeScript
type UiSdlFieldSettingBase mixes UiSdlFieldBasedDataSpecSetting {

  /**
   * The current value of the field.
   */
  value: any

  /**
   * The default value of the field, if any.
   */
  defaultValue: any

  /**
   * Whether the value in the input is not acceptable as a valid value.
   */
  invalid: boolean

  /**
   * Descriptors for how to obtain the value for a prop from data.
   * Specifies the path to the data and the prop to populate.
   */
  dataPropSpecs: [UiSdlFormDataToPropSpec]
}
