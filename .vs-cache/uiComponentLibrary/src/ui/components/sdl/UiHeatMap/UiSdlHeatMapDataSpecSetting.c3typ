/**
 * A specification that describes how to use the field of the {@link dataType} for display in the {@link UiSdlHeatMap}.
 */
@typeScript
type UiSdlHeatMapDataSpecSetting mixes UiSdlMetricBasedDataSpecSetting {

  /**
   * Keeps track of the evalute action triggered in the datasource. Possible values
   * are evalMetric or rollupMetrics. Defaults to 'EVAL'.
   */
  evaluateAction: string enum('EVAL', 'ROLLUP') = 'EVAL'

  /**
   * Rollup function options for collection fields.
   */
  @restriction(filter="evaluateAction=='ROLLUP'")
  aggregation: string enum('OR', 'AND', 'SUM', 'AVG', 'MEAN', 'MIN', 'MAX', 'MEDIAN', 'VARIANCE', 'STDDEV', 'PERCENTILE') = 'AVG'

  /**
   * The specification for a field on the data type that is used in determining bucket colors.
   */
  colorStrategy: !UiSdlHeatMapColorFieldSetting

  dataRecordMapping: ~ = {metricName: {dependingField: 'metricType', dependingValues: {SimpleMetric: 'name', CompoundMetric: 'id'}}, fieldName: {dependingField: 'metricType', dependingValues: {SimpleMetric: 'name', CompoundMetric: 'id'}}}
}
