/**
 * This type represents the series part of an eCharts config.
 */
@typeScript
type UiSdlHeatMapEChartSeries {

  /**
   * Unique identifier of this series.
   */
  id: string

  /**
   * The unique name to which this series is mapped.
   */
  name: string

  /**
   * An array of data that will be charted. Each value must be an array with three elements: [x-index, y-index, data value], where
   * <x-index> is the column index on the heat map and <y-index> is the row index on the heat map.
   */
  data: [UiSdlHeatMapDataValue]
}
