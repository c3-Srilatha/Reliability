/**
 * Transform {@link UiSdlChartData} to {@link UiSdlHeatMapEChartConfig}.
 */
@typeScript
type UiSdlTransformUiSdlChartDataToUiSdlHeatMapEChartConfig mixes UiSdlDataTransform<UiSdlChartData, UiSdlHeatMapEChartConfig> {

  /**
   * Override abstract function to transform {@link UiSdlChartData} to {@link UiSdlHeatMapEChartConfig}.
   *
   * Each {@link UiSdlChartDataSeries} will be transformed into a {@link UiSdlHeatMapEChartSeries}.
   */
  transform: function(data: !UiSdlChartData): UiSdlHeatMapEChartConfig ts-client

  /**
   * Generate an array of all hours from start to end time.
   *
   * @param startDate   Start date.
   * @param endDate     End date.
   *
   * return An array of hours between start and end time.
   */
  getHours: function(startDate: datetime, endDate: datetime): [string] ts-client

  /**
   * Generate an array of all weeks from start to end date. The array includes days in the format of 'yyyy-MM-dd',
   * increasing by one week.
   *
   * @param startDate   Start date.
   * @param endDate     End date.
   *
   * return An array of weeks between start and end time.
   */
  getWeeks: function(startDate: datetime, endDate: datetime): [string] ts-client

  /**
   * Generate an array of all years from start to end date.
   *
   * @param startDate   Start date.
   * @param endDate     End date.
   *
   * return An array of years between start and end time.
   */
  getYears: function(startDate: datetime, endDate: datetime): [string] ts-client

  /**
   * Transform given data to an array of {@link UiSdlHeatMapDataValue} for {@link UiSdlHeatMapEChartSeries}.
   *
   * @param xResult      X-axis values.
   * @param yResult      Y-axis values.
   * @param data         {@link UiSdlChartData} to be transformed.
   * @param interval     Interval of data
   *
   * return  An array of {@link UiSdlHeatMapDataValue}.
   */
  generateDataArray: function(xResult: [string],
                              yResult: [string],
                              data: !UiSdlChartData,
                              interval: string): [UiSdlHeatMapDataValue] ts-client
}
