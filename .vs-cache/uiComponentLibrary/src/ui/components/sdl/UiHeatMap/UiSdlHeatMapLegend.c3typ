/**
 * Type to represent a {@link UiSdlHeatMap} legend.
 */
@typeScript
type UiSdlHeatMapLegend {

  /**
   * Whether the user can interact with the legend.
   */
  title: string

  /**
   * Label to show at the low end of the legend. Default is the minimum value.
   */
  lowLabel: string

  /**
   * Label to show at the high end of the legend. Default is the maximum value.
   */
  highLabel: string

  /**
   * Whether the user can interact with the legend.
   */
  interact: boolean = false

  /**
   * Horizontal alignment position of the legend.
   */
  legendHorizontalAlignment: string enum('LEFT', 'CENTER', 'RIGHT') = 'LEFT'
}
