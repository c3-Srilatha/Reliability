/**
 * A specification that describes how to color buckets
 * on a {@link UiSdlHeatMap} instance.
 */
@typeScript
type UiSdlHeatMapColorFieldSetting {

  /**
   * The strategy used for determining the colors of the buckets.
   */
  colorConfigurationStrategy: UiSdlHeatMapManualColorSetting | UiSdlHeatMapAbsoluteColorSetting | UiSdlHeatMapPercentileColorSetting
}
