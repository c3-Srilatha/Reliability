/**
 * This type represents a bucket of data in the heat map (data, label, color).
 */
@typeScript
type UiSdlHeatMapDataValue {

  /**
   * In the format [ column #, row #, value OR '-' if missing].
   */
  value: [any]

  /**
   * Label of the heat map data value.
   */
  label: string

  /**
   * Item style of the heat map data value.
   */
  itemStyle: any
}
