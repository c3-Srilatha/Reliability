/**
 * Type to represent the X-axis configuration for a {@link UiSdlHeatMap}.
 */
@typeScript
type UiSdlHeatMapXAxisConfig {

  /**
   * Name of X-axis.
   */
  name: string = 'x-axis'

  /**
   * The interval for X-axis values.
   */
  interval: string enum('HOUR', 'DAY', 'MONTH') = 'DAY'

  /**
   * Determines whether x axis intervals will show value or name (Ex. 1 or "Monday").
   */
  displayName: boolean = false

  /**
   * Number of days prior to current day for which to display values.
   */
  period: string enum('LAST_WEEK', 'LAST_MONTH', 'LAST_YEAR', 'LAST_TWO_YEARS', 'LAST_THREE_YEARS', 'LAST_FOUR_YEARS', 'LAST_FIVE_YEARS') = 'LAST_YEAR'
}
