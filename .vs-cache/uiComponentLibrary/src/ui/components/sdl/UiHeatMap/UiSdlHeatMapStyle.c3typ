/**
 * Gradient options for the Heat Map.
 */
enum type UiSdlHeatMapStyle {

  /**
   * Gradient 1.
   */
  GRADIENT1 = 'gradient1'

  /**
   * Gradient 1 reverse.
   */
  GRADIENT1_INV = 'gradient1_inverse'

  /**
   * Gradient 2.
   */
  GRADIENT2 = 'gradient2'

  /**
   * Gradient 2 reverse.
   */
  GRADIENT2_INV = 'gradient2_inverse'

  /**
   * Gradient 3.
   */
  GRADIENT3 = 'gradient3'

  /**
   * Gradient 3 reverse.
   */
  GRADIENT3_INV = 'gradient3_inverse'
}
