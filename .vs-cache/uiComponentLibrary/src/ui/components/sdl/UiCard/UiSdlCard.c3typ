/**
 * A UI component type that displays a card with content
 */
@beta
@uiComponentCategorizer(name='Card', category='Components')
type UiSdlCard mixes UiSdlComponent {

  /**
   * Content of card
   */
  content: [UiSdlComponentRef<UiSdlComponent> | UiSdlCard] = []

  /**
   * Display direction of all content in Card component
   */
  contentDisplay: string enum("HORIZONTAL", "VERTICAL") = "HORIZONTAL"

  /**
   * Styling of nested card components in content
   *
   * This prop will only be valid when card is nested
   */
  nestedStyling: string enum("WITH_BORDER", "WITH_BACKGROUND") = "WITH_BACKGROUND"

  /**
   * Whether or not each part of content should have padding on top and bottom
   */
  topBottomPadding: boolean = true

  /**
   * Whether or not each part of content should have padding on right and left
   */
  leftRightPadding: boolean = true
}
