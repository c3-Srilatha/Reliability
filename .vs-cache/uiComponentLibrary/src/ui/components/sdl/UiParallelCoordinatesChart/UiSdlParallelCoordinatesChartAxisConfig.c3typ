/**
* Configuration for parallelAxes
*/

type UiSdlParallelCoordinatesChartAxisConfig {
  /**
  * Id of the axis
  */
  id: string

  /**
  * Name of the axis
  */
  name: string | UiSdlDynamicValueSpec

  /**
  * Type of axis.
  * 'value' - Numeric axis
  * 'category' - Categorical axis, suitable for discrete category data.
  * 'time' - Time axis, suitable for continuous time series data
  */
  parallelAxisType: string enum ('category', 'value', 'time') = 'value'

  /**
  * If parallelAxisType is defined, this is the list of values for the axis.
  */
  values: [string]
}
