/**
 * A UI component type that displays data in a parallel coordinates chart.
 *
 * Developers must mix {@link UiSdlParallelCoordinatesChartHelper} and
 * override the defined abstract functions in order to utilize this chart.
 */
@typeScript
@uiComponentCategorizer(name='Parallel coordinates chart', category='Data Visualization')
type UiSdlParallelCoordinatesChart mixes UiSdlComponent<UiSdlParallelCoordinatesChartDataSpec>, UiSdlHideChartSeries, UiSdlTooltipConfig {

  /**
   * The specification used for defining the axes of the chart which invokes fetchAxes.
   */
  @uiSdlDataSpec(dataDestinationField='axes')
  axesDataSpec: UiSdlParallelCoordinatesAxesDataSpec

  /**
   * The data spec that will hold the the internal datasources for {@link UiSdlParallelCoordinatesChart}
   * which invokes fetchData.
   */
  @uiSdlDataSpec(dataDestinationField='data')
  dataSpec: ~

  /**
   * Holds the data that defines the axes.
   */
  axes: [string]

  /**
   * Defines if the chart series should be straight or smooth.
   */
  smoothLine: boolean = true

  /**
   * Chart header.
   */
  header: UiSdlComponentHeader

  /**
   * Set to true if you want to enable the axes dropdown list.
   * This allows showing/hiding with checkboxes as well as reordering of the axes.
   */
  enableAxesDropdownList: boolean = true

  /**
   * Configuration for parallel axes.
   */
  parallelAxes: [UiSdlParallelCoordinatesChartAxisConfig]

  /**
   * A list of indices of inverted axis.
   */
  invertedAxes: private [int]

  /**
   * Chart legend configuration
   */
  legend: UiSdlChartLegend

  /**
   * An array of hex string colors to use for a group of series data.
   * May be overwritten if defined in metadata '#' prepended. e.g., #12ef3b.
   * This is specifically not the same colors as {@link UiSdlChartColorConfig#defaultColors}.
   */
  colors: [string] = ['#df4839', '#ff942c', '#f4d464', '#85c17e', '#415b9f', '#5591cf', '#737373', '#50c3df', '#f0a63a', '#dcc5e6']

  /**
   * Setting for chartActions selection.
   */
  chartActions: [UiSdlAction]

  /**
   * Triggered to update chart axes order.
   *
   * @param id
   *        Id of the component.
   * @param listId
   *        The id of the list being reordered.
   * @param fromIndex
   *        The index of the element within the list.
   * @param toIndex
   *        The target index of the element.
   *
   * @return An `AXIS_REORDER` action for this instance with the following properties:
   * - payload[data] {string} sourceIndex, targetIndex, componentId.
   */
  @uiSdlActionCreator(actionType='AXIS_REORDER')
  reorderAxisAction: function(id: string,
                              listId: string,
                              fromIndex: int,
                              toIndex: int): UiSdlAxisReorderAction ts-client

  /**
   * Action invoked when any of the axis are toggled on or off. Listens for actions of type `HIDDEN_AXES_UPDATE` and updates internal
   * field {@link hiddenAxis}.
   *
   * @param id
   *           Id of the component.
   * @param data
   *           Data used to update hidden axes.
   *
   * @returns A `HIDDEN_AXES_UPDATE` action for this instance
   */
  @uiSdlActionCreator(actionType='HIDDEN_AXES_UPDATE')
  updateHiddenAxesAction: function(id: string, data: [string]): UiSdlHiddenAxesUpdateAction ts-client

  /**
   * Listens for actions of type `HIDDEN_AXES_UPDATE` and updates internal
   * field {@link hiddenAxis} to change its visibility on the chart.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='HIDDEN_AXES_UPDATE')
  hiddenAxisUpdateEffect: private inline function(state: UiSdlReduxState,
                                                  action: UiSdlHiddenAxesUpdateAction): UiSdlReduxState ts-client

  /**
   * Triggered to update the sort order of any of the axis on the chart.
   *
   * @param id
   *        Id of the component.
   * @param axisIndex
   *        The index of the parallel axis to invert.
   *
   * @return An `AXIS_INVERT` action for this instance with the following properties:
   * - payload {int} The axis index.
   */
  @uiSdlActionCreator(actionType='AXIS_INVERT')
  invertAxisAction: function(id: string, axisName: string): UiSdlAxisInvertAction ts-client

  /**
   * Listens for actions of type `AXIS_INVERT` and updates internal
   * field {@link invertedAxes  } to change its sort order on the chart.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='AXIS_INVERT')
  axisInvertEffect: private inline function(state: UiSdlReduxState,
                                            action: UiSdlAxisInvertAction): UiSdlReduxState ts-client

  /**
   * Listens for actions of type `AXIS_REORDER` and updates the data within
   * {@link dataSpec} and {@link axes} to change its sort order on the chart.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='AXIS_REORDER')
  axisReorderEffect: private inline function(state: UiSdlReduxState,
                                             action: UiSdlAxisReorderAction): UiSdlReduxState ts-client
}
