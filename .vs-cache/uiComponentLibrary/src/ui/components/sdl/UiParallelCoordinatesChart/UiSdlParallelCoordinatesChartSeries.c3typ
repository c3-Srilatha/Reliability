/**
 * A UI component the defines the series data used in {@link UiSdlParallelCoordinatesChart}.
 */
@typeScript
type UiSdlParallelCoordinatesChartSeries {

  /**
   * The name of the group for this data series. These will be toggled on or off together on the chart.
   */
  groupName: string

  /**
   * The series data values. Value type is any because series data can be int, decimal or categorical (string).
   */
  seriesData: [any]

  /**
   * The name of the series (i.e. 'Iteration 1').
   */
  seriesName: string
}
