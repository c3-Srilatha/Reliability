/**
 * The specification of data retrieval for instances of the {@link UiSdlParallelCoordinatesChart} component type.
 */
@typeScript
type UiSdlParallelCoordinatesChartDataSpec mixes UiSdlComponentDataSpec {

  /**
   * Invoke fetchData.
   */
  toPartiallyAppliedActions: ~ ts-client

  /**
   * Provided from json file right now to be used by toPartiallyAppliedActions to generate the id.
   */
  entityId: string

  /**
   * Any applicable dataTransform types.
   */
  dataTransforms: [string]
}
