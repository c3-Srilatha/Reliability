/**
 * Type defining the API structure for usage in {@link UiSdlParallelCoordinatesChart}.
 */
@typeScript
type UiSdlParallelCoordinatesChartHelper {

  /**
   * Maximum number of parallel axes to display.
   */
  MAX_AXES: int = 15

  /**
   * Minimum number of parallel axes required to display the chart.
   */
  MIN_AXES: int = 2

  /**
   * API to fetch axes for a {@link UiSdlParallelCoordinatesChart}.
   *
   * @param id
   *         Id of the entity for which we are evaluating the results.
   *
   * @return An array containing the names of the parallel axes.
   */
  fetchAxes: abstract function(id: string): [json] ts-client

  /**
   * API to fetch series data for a {@link UiSdlParallelCoordinatesChart}.
   *
   * @param id
   *         Id of the entity for which we are evaluating the results.
   *
   * @return An array containing the different series and the data for each series.
   */
  fetchData: abstract function(id: string): [UiSdlParallelCoordinatesChartSeries] ts-client

  /**
   * API to fetch series data for a {@link UiSdlParallelCoordinatesChart}.
   *
   * @return An array containing the different series and the data for each series.
   */
  fetchCategoricalData: abstract function (): [UiSdlParallelCoordinatesChartSeries] ts-client

  /**
   * API to fetch axes for a {@link UiSdlParallelCoordinatesChart}.
   *
   * @return An array containing the configuration of the parallel axes.
   */
  fetchCategoryAxes: private function (): [json] ts-client
}
