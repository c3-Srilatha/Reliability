/**
 * Type to use grid as an input in forms. When this type is used, {@link UiSdlDataGrid}'s in-built
 * editor will be disabled and columns will always be in edit mode.
 */
@typeScript
@uiComponentCategorizer(name='Form data grid', aliases=['Table Form', 'Table with inputs'], category='Patterns')
@uiBuildNestedDataSpecs
type UiSdlFormDataGrid mixes UiSdlBaseDataGrid<UiSdlFormDataGridDataSpec>, UiSdlFilterable, UiSdlSearchable {

  removableRows:  ~ = true
  insertableRows: ~ = true

  /**
   * Placeholder text in search bar.
   */
  searchBarPlaceHolderText: string = 'UiSdlFormDataGrid.searchBarPlaceHolderText'

  /**
   * Specifies whether to render the filter bar subcomponent.
   */
  filterBar: boolean = false

  /**
   * Helper function to get the deleted, added, or edited data record IDs for a specific {@link UiSdlFormDataGrid}.
   *
   * @param state
   *           The Redux state.
   * @param dataLocation
   *           The type of data modifications requested.
   * @param componentId
   *           The component id of the form data grid.
   *
   * @return The list of modified (deleted, added, or edited) data record IDs.
   */
  getDataModificationsFromState: function(state: !UiSdlReduxState,
                                          dataLocation: !string enum('DELETIONS', 'ADDITIONS', 'EDITS'),
                                          componentId: !string): [string] ts-client

  /**
   * The location to insert an added row.  Prepend will add to the front of the array of objects populating the grid
   * and append will add to the end of the array.
   */
  insertLocation: string enum('PREPEND', 'APPEND') = 'PREPEND'

  /**
   * Triggered when a row is added to the grid.
   *
   * @param id
   *           Id of the component.
   * @param row
   *           Information about the row that was added.
   *
   * @returns A `ROW_ADDED` action for this instance with the following properties:
   * - payload.row - {json} The row that was added.
   */
  @uiSdlActionCreator(actionType='ROW_ADDED')
  addedRowAction: function(id: string, row: json): UiSdlRowAddedAction

  /**
   * Triggered when a row is deleted from the grid.
   *
   * @param id
   *           Id of the component.
   * @param row
   *           Information about the row that was deleted.  Will have the shape `{id: string}`.
   *
   * @returns A `ROW_DELETED` action for this instance with the following properties:
   * - payload.row - {json} The row that was deleted.
   */
  @uiSdlActionCreator(actionType='ROW_DELETED')
  deletedRowAction: function(id: string, row: json): UiSdlRowDeletedAction

  /**
   * A function that will be called when an item in this grid is reordered.
   *
   * @param id
   *           Id of the component.
   * @param fromIndex
   *           The current index of the reordered item.
   * @param toIndex
   *           The target index of the reordered item. If the item is
   *           being moved to the end of the list, this will be the length of
   *           the list.
   *
   * @return An `ITEM_REORDER` action with the following payload properties:
   * - fromIndex {int} The index of the reordered item, before reordering.
   * - toIndex {int} The index of the reordered item, after reordering.
   */
  @uiSdlActionCreator(actionType='ITEM_REORDER')
  reorderItemAction: function(id: string, fromIndex: !int, toIndex: !int): !UiSdlItemReorderAction ts-client

  /**
   * Returns the current rows in the grid.
   *
   * @param state
   *           The Redux state.
   * @param componentId
   *           Id of the component.
   *
   * @return All the rows in the form grid.
   */
  getCurrentRows: function(state: UiSdlReduxState, componentId: string): [json]

  @uiSdlEpic(actionType='DATA_LOAD')
  dataLoadEpic: ~ ts-client

  @uiSdlEpic(actionType='ITEM_CHANGE')
  itemChangeEpic: ~ ts-client

  @uiSdlEpic(actionType='TABLE_ACTION_CLICK_ADD_ROW')
  rowAddEpic: ~ ts-client

  @uiSdlEpic(actionType='ROW_ACTION_CLICK_DELETE')
  rowDeleteEpic: ~ ts-client

  /**
   * Triggers `DATA_RECEIVE` action when an item in this grid is reordered.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='ITEM_REORDER')
  itemReorderEpic: private function(actionStream: UiSdlActionsObservable,
                                    stateStream: UiSdlStatesObservable): UiSdlActionsObservable ts-client

  filterSubmitEpic:         ~ ts-client
  advancedFilterSubmitEpic: ~ ts-client
  searchQueryChangeEpic:    ~ ts-client
}
