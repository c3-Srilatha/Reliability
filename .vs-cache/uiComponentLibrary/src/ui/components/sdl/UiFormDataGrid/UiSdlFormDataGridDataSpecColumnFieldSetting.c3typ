/**
 * A specification that describe how to use each field of the {@link dataType} for display in the {@link UiSdlFormDataGrid}. A
 * single field is mapped to a single column, so an instance of this type specifies how to display a single column
 * (and its cells) within a grid.
 */
@typeScript
type UiSdlFormDataGridDataSpecColumnFieldSetting mixes UiSdlBaseDataGridDataSpecColumnFieldSetting {

  /**
   * The element to render in the cell if the user is allowed to interact with the cell.
   */
  cellElement: UiSdlTextInputFormDataGrid | UiSdlSelectInputFormDataGrid | UiSdlSearchInputFormDataGrid | UiSdlNumberInputFormDataGrid | UiSdlDateTimeInputFormDataGrid

  editable: ~ = true

  /**
   * Whether the field set is currently hidden.
   */
  hidden: boolean = false
}
