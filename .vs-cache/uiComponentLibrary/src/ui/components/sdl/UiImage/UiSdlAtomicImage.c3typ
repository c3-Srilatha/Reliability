/**
 * A UI component type that holds other components.
 */
@uiSdlDesignerComponent(designable=true,
                        category='UiSdlImage.CategoryName',
                        name='UiSdlImage.ComponentName',
                        icon='image')
@typeScript
@uiComponentCategorizer(name='Image (new)', category='Components')
type UiSdlAtomicImage mixes UiSdlComponent<UiSdlImageDataSpec> {

  /**
   * Alt text for images.
   */
  altText: string | UiSdlDynamicValueSpec

  /**
   * Background color for behind the image. These correspond to the theme's primary,
   * secondary, and tertiary background colors.
   */
  @constraint(blurBackground=false)
  backgroundColor: string enum('PRIMARY', 'SECONDARY', 'TERTIARY')

  /**
   * Whether to show a blurred version of the image as the background behind the image.
   */
  blurBackground: boolean = false

  /**
   * How much of a border radius to have on the image.
   */
  @constraint(shape='RECTANGULAR')
  borderRadius: string enum('NONE', 'SMALL', 'MEDIUM', 'LARGE', 'XLARGE') = 'NONE'

  /**
   * Description / secondary text for error image state.
   * If nothing is passed, it will show nothing.
   * This property is only visible when used inside a Grid Layout component.
   */
  descriptionText: string

  /**
   * Header / primary text for error image state.
   * If nothing is passed, it will show by default 'Image load error'.
   * This property is only visible when used inside a Grid Layout component.
   */
  headerText: string = 'UiSdlAtomicImage.ErrorImage.header'

  /**
   * Horizontal alignment.
   */
  horizontalAlign: string enum('CENTER', 'LEFT', 'RIGHT')

  /**
   * Image ratio in width:height format
   */
  ratio: string enum('1:1', '4:3', '3:4', '16:9', '9:16' )

  /**
   * How the image should fit itself into the ratio
   */
  ratioBehavior: string enum('fitHeight', 'fitWidth', 'STRETCH')

  /**
   * Circular will only apply on square images.
   */
  shape: string enum('CIRCULAR', 'RECTANGULAR')

  /**
   * Whether or not to show a border around the background if blurBackground is true or backgroundColor is set.
   * Otherwise, having true here puts a border around the image.
   */
  showBorder: boolean = true

  /**
   * Size to render image.
   */
  size: string enum('MINI', 'SMALL', 'MEDIUM', 'LARGE', 'MASSIVE', 'parentWidth', 'parentHeight')

  /**
   * URL where to get image.
   */
  url: string | UiSdlImageSrcSpec | UiSdlDynamicValueSpec

  /**
   * Vertical alignment.
   */
  verticalAlign: string enum('BOTTOM', 'MIDDLE', 'TOP')

  /**
   * The specification used for retrieving image to be displayed.
   */
  @uiSdlDataSpec(dataDestinationField='dataRecord')
  dataSpec: ~

  /**
   * Holds the data for where to find the image.
   */
  dataRecord: Obj
}
