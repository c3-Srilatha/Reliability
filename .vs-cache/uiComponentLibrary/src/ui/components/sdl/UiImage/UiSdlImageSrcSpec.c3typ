/**
 * Spec for UiSdlImage component for image being passed in.
 */
@typeScript
type UiSdlImageSrcSpec {

  /**
   * File extension of image.
   */
  extension: string enum('.gif', '.jpg', '.png')

  /**
   * Should pass in params.id or name of image file without extension.
   */
  imageFileName: string

  /**
   * Root url of where image is located.
   */
  rootUrl: string
}
