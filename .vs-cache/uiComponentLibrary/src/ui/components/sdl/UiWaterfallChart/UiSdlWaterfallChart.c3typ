/**
 * Waterfall Chart Component
 */
@typeScript
@uiComponentCategorizer(name='Waterfall chart', category='Data Visualization')
type UiSdlWaterfallChart mixes UiSdlComponent<UiSdlWaterfallChartDataSpec>, UiSdlHideChartSeries, UiSdlChartColorConfig, UiSdlChartStyleConfig, UiSdlLineBarChartToolboxZoomable {

  /**
   * Waterfall chart data.
   */
  data: json

  /**
   * Chart header.
   */
  header: UiSdlComponentHeader

  /**
   * Configuration of y-Axis.
   */
  yAxis: UiSdlWaterfallChartYAxisConfig

  /**
   * Configuration of x-Axis.
   */
  xAxis: UiSdlWaterfallChartXAxisConfig

  /**
   * Boolean for showing the label. If set to true, each element in the waterfall chart will have a label
   */
   displayLabel: boolean = false

  /**
   * The component that handles the empty state.
   * It will appear if the grid has no data.
   */
  emptyState: UiSdlComponentRef<UiSdlEmptyState>

  /**
   * Configuration of legend.
   */
  legendStyle: string enum UiSdlWaterfallChartLegendStyle = HISTOGRAM

  /**
   * Chart background style.
   */
  backgroundStyle: ~ = 'HORIZONTAL_LINES'

  /**
   * Configuration of tooltip.
   */
  tooltip: UiSdlWaterfallChartTooltip

  /**
   * Boolean for exportable. If set to true, the waterfall chart can be exported as a CSV, JPEG, or PNG.
   */
  exportable: boolean = true

  /**
   * Setting for chartActions selection.
   */
  chartActions: [UiSdlAction] = [{name: 'UiSdlWaterfallChart.chartActions.EXPORT_CHART_CSV.name', actionSuffix: 'EXPORT_CHART_CSV', iconSuffix: 'table'}, {name: 'UiSdlWaterfallChart.chartActions.EXPORT_CHART_JPEG.name', actionSuffix: 'EXPORT_CHART_JPEG', iconSuffix: 'file-image'}, {name: 'UiSdlWaterfallChart.chartActions.EXPORT_CHART_PNG.name', actionSuffix: 'EXPORT_CHART_PNG', iconSuffix: 'file-image'}]

  /**
   * Settings for gradient.
   */
  gradientSettings: [UiSdlWaterfallChartGradientColorSettings]

  /**
   * Total gradient settings.
   */
  totalGradientSettings: [UiSdlWaterfallChartGradientColorSettings]

  @uiSdlDataSpec(dataDestinationField='data')
  dataSpec: ~

  /**
   * Triggered when bar item on the chart is clicked.
   *
   * @param id
   *           Id of the component.
   * @param payload
   *           Object with any key-value data.
   */
  @uiSdlActionCreator(actionType='TRIGGER_ITEM_CLICK')
  triggerItemClick: function(id: string, payload: json): UiSdlClickItemAction ts-client
}
