/**
 * Type represents gradient settings.
 */
type UiSdlWaterfallChartGradientColorSettings {

  /**
   * The threshold value.
   */
  threshold: !double

  /**
   * The color to use if the field value meets the threshold. If not met, the default color is used.
   */
  thresholdColor: !string serialized Color
}
