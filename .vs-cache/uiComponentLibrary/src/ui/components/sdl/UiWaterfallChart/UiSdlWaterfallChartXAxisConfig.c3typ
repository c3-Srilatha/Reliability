/**
 * Waterfall X axis configuration
 */
type UiSdlWaterfallChartXAxisConfig mixes UiSdlChartAxisConfig {

  /**
   * X-axis color scheme
   */
  colorScheme: string enum UiSdlWaterfallChartColorScheme = STANDARD

  /**
   * Boolean for showing the axis. If set to false, the axis will not be visible
   */
  displayAxis: boolean = true
}
