/**
 * A UI component data spec for the header of a collapsible component.
 */
@typeScript
type UiSdlCollapsibleComponentDataSpec mixes UiSdlComponentDataSpec {

  /**
   * Id of the record that has the fields of interests.
   */
  entityId: string

  /**
   * Spec describing where to get the title from.
   */
  title: UiSdlFieldBasedDataSpecSetting

  /**
   * Spec describing where to get the subtitle from.
   */
  subtitle: UiSdlFieldBasedDataSpecSetting

  /**
   * Spec describing the secondaryTitle.
   */
  secondaryTitle: UiSdlFieldBasedDataSpecSetting

  /**
   * Whether the secondaryTitle is rendered as text or a button.
   */
  secondaryTitleType: string enum('TEXT', 'BUTTON')

  toPartiallyAppliedActions: ~ ts-client
}
