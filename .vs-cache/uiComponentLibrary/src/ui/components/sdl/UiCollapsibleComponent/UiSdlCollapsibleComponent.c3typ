/**
 * A UI component that is collapsible.
 */
@typeScript
@uiComponentCategorizer(name='Collapsible component', category='Components')
type UiSdlCollapsibleComponent mixes UiSdlComponent<UiSdlCollapsibleComponentDataSpec> {

  /**
   * The specification used for retrieving data displayed by the header.
   */
  @uiSdlDataSpec(dataDestinationField='dataRecord')
  dataSpec: ~

  /**
   * Holds the data to display in the header.
   */
  dataRecord: Obj

  /**
   * Components that will be in collapsed section.
   */
  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]

  /**
   * Whether the component is originally collapsed.
   */
  collapsed: boolean = false

  /**
   * The title and secondary title of the component.
   */
  header: UiSdlCollapsibleComponentHeader

  /**
   * The tooltip text for the info icon.
   */
  infoTooltipText: string

  /**
   * Triggered when the component is expanded or collapsed.
   *
   * @param id
   *    Id of the component.
   * @param collapsed
   *    If true the collapsible component was collapsed.  If false the component was expanded.
   *
   * @returns A `COLLAPSIBLE_COMPONENT_(EXPANDED|COLLAPSED)` action for this instance.
   */
  @uiSdlActionCreator(actionType='COLLAPSIBLE_COMPONENT_(OPEN|CLOSE)')
  openCloseCollapsibleComponentAction: function(id: string,
                                                collapsed: boolean): UiSdlCollapsibleComponentAction ts-client

  /**
   * Triggered when the secondary title of the component is clicked.
   *
   * @param id
   *    Id of the component.
   * @param title
   *    The title of the collapsible component clicked.
   *
   * @returns A `SECONDARY_TITLE_CLICK` action for this instance.
   */
  @uiSdlActionCreator(actionType='SECONDARY_TITLE_CLICK')
  secondaryTitleClickAction: function(id: string, title: string): UiSdlSecondaryTitleClickAction ts-client

  /**
   * Triggered to change the title of the component.
   *
   * @param id
   *    Id of the component.
   * @param title
   *    The new title of the component
   *
   * @returns A `COLLAPSIBLE_COMPONENT_TITLE_UPDATE` action for this instance.
   */
  @uiSdlActionCreator(actionType='COLLAPSIBLE_COMPONENT_TITLE_UPDATE')
  collapsibleComponentTitleUpdateAction: function(id: string,
                                                title: string): UiSdlCollapsibleComponentTitleUpdateAction ts-client

  /**
   * Triggered to change the subtitle of the component.
   *
   * @param id
   *    Id of the component.
   * @param subtitle
   *    The new subtitle of the component
   *
   * @returns A `COLLAPSIBLE_COMPONENT_SUBTITLE_UPDATE` action for this instance.
   */
  @uiSdlActionCreator(actionType='COLLAPSIBLE_COMPONENT_SUBTITLE_UPDATE')
  collapsibleComponentSubtitleUpdateAction: function(id: string,
                                                title: string): UiSdlCollapsibleComponentSubtitleUpdateAction ts-client

  /**
   * Listens for actions of type `COLLAPSIBLE_COMPONENT_OPEN` and updates internal
   * field {@link collapsed}
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='COLLAPSIBLE_COMPONENT_OPEN')
  openCollapsibleComponentEffect: private inline function(state: UiSdlReduxState,
                                            action: UiSdlCollapsibleComponentAction): UiSdlReduxState ts-client

  /**
   * Listens for actions of type `COLLAPSIBLE_COMPONENT_CLOSE` and updates internal
   * field {@link collapsed}
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='COLLAPSIBLE_COMPONENT_CLOSE')
  closeCollapsibleComponentEffect: private inline function(state: UiSdlReduxState,
                                            action: UiSdlCollapsibleComponentAction): UiSdlReduxState ts-client

  /**
   * Listens for actions of type `COLLAPSIBLE_COMPONENT_TITLE_UPDATE` and updates internal
   * field {@link title}
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='COLLAPSIBLE_COMPONENT_TITLE_UPDATE')
  collapsibleComponentTitleUpdateEffect: private inline function(state: UiSdlReduxState,
                                            action: UiSdlCollapsibleComponentTitleUpdateAction): UiSdlReduxState ts-client

  /**
   * Listens for actions of type `COLLAPSIBLE_COMPONENT_SUBTITLE_UPDATE` and updates internal
   * field {@link subtitle}
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='COLLAPSIBLE_COMPONENT_SUBTITLE_UPDATE')
  collapsibleComponentSubtitleUpdateEffect: private inline function(state: UiSdlReduxState,
                                            action: UiSdlCollapsibleComponentSubtitleUpdateAction): UiSdlReduxState ts-client
}
