/**
 * A type which represents a form, which may be composed of 1-N form fields.
 * Generally used to collect information from a user to be submitted in some way.
 */
@typeScript
@uiComponentCategorizer(name='Form', category='Patterns')
@uiBuildNestedDataSpecs
type UiSdlForm mixes UiSdlFormBase<UiSdlFormDataSpec> {

  /**
   * This enum field determines whether the form is a multi-step form, or a traditional, single-step form.
   * Possible values are 'single', 'multiStep'.
   * Defaults to 'single'.
   */
  formType: string enum UiSdlFormType = SINGLE

  /**
   * The subtitle of the form.
   */
  subtitle: UiSdlComponentTitle

  /**
   * The status and state for form.
   */
  formStatus: UiSdlFormStatus

  /**
   * Whether store values through changeDefaultConfigAction
   */
  useDefaultConfig: boolean = true

  /**
   * Button configuration for the `Submit` button.
   */
  submitButtonText: string serialized UiSdlDynamicValueSpec = 'UiSdlForm.submitButtonText'

  /**
   * Button configuration for the `Cancel` button.
   */
  cancelButtonText: string serialized UiSdlDynamicValueSpec = 'UiSdlForm.cancelButtonText'

  /**
   * Button configuration for the `Continue` button.
   */
  continueButtonText: string serialized UiSdlDynamicValueSpec = 'UiSdlForm.continueButtonText'

  /**
   * Button configuration for the `Back` button.
   */
  backButtonText: string serialized UiSdlDynamicValueSpec = 'UiSdlForm.backButtonText'

  /**
   * When true the cancel and submit buttons will be hidden.  Useful when the form is used for collecting data and then
   * the developer needs more control for what they want to do with that information.
   */
  hideFooterButtons: boolean

  /**
   * Whether the primary action button is in the loading state.
   */
  primaryActionButtonLoading: boolean

  /**
   * Whether the secondary action button is in the loading state.
   */
  secondaryActionButtonLoading: boolean

  /**
   * Whether the primary action button is disabled.
   */
  primaryActionButtonDisabled: boolean

  /**
   * Whether the secondary action button is disabled.
   */
  secondaryActionButtonDisabled: boolean

  /**
   * A map of various fields and the associated validities. 'true' is considered valid, 'false' is considered invalid.
   * Additionally, if validity if null or undefined, it is indeterminate. This state is useful when you do not want to apply
   * any additional classes to the input and want to bring it to a state where it appears 'untouched'.
   */
  fieldValidity: private map<string, boolean>

  /**
   * Flag to determine if the form should be reset to the original data {@link UiSdlConnected#getInitialConfigFromState}
   * when the user clicks cancel.
   * If true clicking cancel will trigger {@link cancelFormAction} then {@link resetFormAction}.
   * If false clicking cancel will only trigger {@link cancelFormAction}.
   */
  clearOnCancel: boolean

  /**
   * Current step index for multi-step form.
   */
  currentStepIndex: int = 0

  /**
   * Whether a custom submit action should be fired instead of the default submission actions.
   */
  customSubmit: boolean

  /**
   * Debounce timer for all the input fields in milliseconds. Default is 300.
   * You can still use individual debounceTime for each input element.
   */
  debounceTime: int = 300

  /**
   * The orientation of the progress bar for {@link UiSdlMultiStepFormFieldSet}.
   */
  multiStepProgressBarOrientation: string enum('HORIZONTAL', 'VERTICAL') = 'HORIZONTAL'

  /**
   * Flag to determine whether or not a multistep form could be filled out of order.
   * Only set this value to true if the form is multistep and contains NO REQUIRED FIELDS.
   * If this value is set to true for forms with required fields, then it is possible the form could be submitted
   * without the required fields filled in.
   */
  multiStepAnyOrder: boolean = false

  /**
   * Width of the form, int or double as percentage value or UiSdlFormWidth as value with its unit.
   */
  width: int | double | UiSdlFormWidth

  /**
   * Max width of the form, int or double as percentage value or UiSdlFormWidth as value with its unit.
   * By default it uses css token: `$sdl-form-max-width` which is 770px. With this option you override this value
   */
  maxWidth: int | double | UiSdlFormWidth

  /**
   * The data spec for the default action to take when form is valid and `Submit` button is clicked.
   */
  @uiSdlDataSpec(dataDestinationField='submitRecord')
  submitDataSpec: UiSdlFormSubmitDataSpec

  /**
   * A dummy field that is here to satisfy the requirement for `uiSdlDataSpec`.
   */
  submitRecord: private Obj

  /**
   * Triggered when form status changes.
   *
   * @param id
   *            Id of the component.
   * @param formStatus
   *           The status, title, and message of the form status.
   *
   * @returns A `FORM_STATUS_UPDATE` action for this instance.
   */
  @uiSdlActionCreator(actionType='FORM_STATUS_UPDATE')
  updateFormStatusAction: function(id: !string,
                                           formStatus: UiSdlFormStatus): !UiSdlFormStatusUpdateAction ts-client

  /**
   * Listens for actions of type `FORM_STATUS_UPDATE`, then change the form status appropriately.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='FORM_STATUS_UPDATE')
  formStatusUpdateReducer: private function(state: !UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Triggered when the form status should be cleared.
   *
   * @param id
   *            Id of the component.
   *
   * @returns A `FORM_STATUS_CLEAR` action for this instance.
   */
  @uiSdlActionCreator(actionType='FORM_STATUS_CLEAR')
  clearFormStatusAction: function(id: !string): !UiSdlFormStatusClearAction ts-client

  /**
   * Listens for actions of type `FORM_STATUS_CLEAR`, then clear the form status.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='FORM_STATUS_CLEAR')
  formStatusClearReducer: private function(state: !UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Triggered when a button state needs to be changed.
   * This can be loading state for a button.
   *
   * @param id
   *           Id of the component.
   * @param buttonType
   *           The button type clicked.  Valid values are
   *           'PRIMARY' or 'SECONDARY'.
   * @param loading
   *           Whether or not this button should be loading or not.
   *
   * @returns An `ACTION_BUTTON_STATE_CHANGE` action for this instance.
   */
  @uiSdlActionCreator(actionType='ACTION_BUTTON_STATE_CHANGE')
  changeActionButtonStateAction: function(id: !string,
                                                  buttonType: !string enum('PRIMARY', 'SECONDARY'),
                                                  disable: boolean,
                                                  loading: boolean): !UiSdlActionButtonStateChangeAction ts-client

  /**
   * Listens for actions of type `ACTION_BUTTON_STATE_CHANGE`, then renders the action button appropriately.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='ACTION_BUTTON_STATE_CHANGE')
  actionButtonStateChangeEffect: private function(state: !UiSdlReduxState,
                                          action: !UiSdlActionButtonStateChangeAction): !UiSdlReduxState ts-client

  /**
   * Triggered on each input when multiple inputs values change. This is used for backward compatibility only.
   *
   * @param id
   *           Id of the component.
   * @param event
   *           Browser event.
   * @param data
   *           The data passed from the presentational components.
   * @param inputHasChanged
   *           If the input has already been changed. If true, the state doesn't need to be changed any more.
   *
   * @returns An `INPUT_CHANGE` action for this instance with the following properties:
   * - payload.field {string} The field the input is responsible for filtering.
   * - payload.value {any} The value(s) of the input.  Generally a string or int.
   * - payload.inputHasChanged {boolean} Indicating whether the input has changed in the state.
   */
  @uiSdlActionCreator(actionType='INPUT_CHANGE')
  inputHasChangedAction: function(id: !string, event: any, data: any, inputHasChanged: boolean): !UiSdlInputChangeAction ts-client

  /**
   * Triggered when multiple inputs' values change at once. Also triggers `INPUT_CHANGE` action on each of the fields.
   *
   * @param id
   *            Id of the component.
   * @param data
   *           The data passed from the presentational components.
   *
   * @returns A `MULTIPLE_INPUTS_CHANGE` action for this instance.
   */
  @uiSdlActionCreator(actionType='MULTIPLE_INPUTS_CHANGE')
  changeMultipleInputsAction: function(id: !string, data: any): !UiSdlInputChangeAction ts-client

  /**
   * Triggered on form mount and update, sets the defaults to revert to on FORM_RESET.
   *
   * @param id
   *            Id of the component.
   * @param config
   *           The array of UiSdlInputChangePayload objects to become the default input values.
   *
   * @returns A `DEFAULT_CONFIG_CHANGE` action for this instance.
   */
  @uiSdlActionCreator(actionType='DEFAULT_CONFIG_CHANGE')
  changeDefaultConfigAction: function(id: !string, config: any): !UiSdlDefaultConfigChangeAction ts-client

  /**
   * Triggered whenever a particular input is intended to be enabled or disabled.
   * @param id
   *            Id of the component.
   * @param field
   *            The field to be enabled/disabled.
   * @param disable
   *            Whtether to enable or to disable the input. Setting to true will disable the input and setting to false
   *            will enable it.
   *
   * @return An 'INPUT_(ENABLE|DISABLE)' action for this instance with the following properties:
   * - payload.field {string} The field the input is responsible for.
   */
  @uiSdlActionCreator(actionType='INPUT_(ENABLE|DISABLE)')
  enableDisableInputAction: function(id: !string,
                                     field: !string,
                                     disable: boolean): !UiSdlInputEnableDisableAction ts-client

  /**
   * Listens for actions of type `INPUT_ENABLE`,and sets the 'disabled' property on the input to be false.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='INPUT_ENABLE')
  inputEnableEffect: private function(state: !UiSdlReduxState,
                              action: !UiSdlInputEnableDisableAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `INPUT_DISABLE`, and sets the 'disabled' property on the input to be true.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='INPUT_DISABLE')
  inputDisableEffect: private function(state: !UiSdlReduxState,
                               action: !UiSdlInputEnableDisableAction): !UiSdlReduxState ts-client

  /**
   * Helper function to enable or disable an input.
   *
   * @param state
   *          Redux state.
   * @param fieldName
   *          Name of the field to be enabled/disabled.
   * @param disable
   *          Whether to disable the field or not.
   * @param componentId
   *          Id of the current component instance.
   *
   * @returns A new Redux state.
   */
  enableDisableInputEffect: private function(state: !UiSdlReduxState,
                                             fieldName: !string,
                                             disable: boolean,
                                             componentId: !string): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `MULTIPLE_INPUTS_CHANGE` and updates the redux store with updated field values.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='MULTIPLE_INPUTS_CHANGE')
  multipleInputsChangeEffect: private inline function(state: !UiSdlReduxState,
                                                      action: !UiSdlInputChangeAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `DEFAULT_CONFIG_CHANGE` and updates the redux store with a default config to revert to on FORM_RESET.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='DEFAULT_CONFIG_CHANGE')
  changeDefaultConfigReducer: private inline function(state: !UiSdlReduxState,
                                                      action: !UiSdlDefaultConfigChangeAction): !UiSdlReduxState ts-client

  /**
   * Triggers `INPUT_CHANGE` actions on all fields without changing the state.
   *
   * @param id
   *            Id of the component.
   * @param data
   *           The data passed from the presentational components.
   *
   * @returns A `MULTIPLE_INPUTS_CHANGE` action for this instance.
   */
  @uiSdlEpic(actionType='MULTIPLE_INPUTS_CHANGE')
  multipleInputsChangeEpic: private function(actionStream: !UiSdlActionsObservable,
                                     stateStream: !UiSdlStatesObservable): !UiSdlActionsObservable ts-client

  /**
   * Helper function to recursively travel the fieldsets and fields and produce a flat list of all fields.
   *
   * @param fieldConfigs
   *           The set of top level fields to get the fields from.
   *
   * @returns A flat list of all fields in the fieldsets.
   */
  getFields: private function(fieldConfigs: [UiSdlFormFieldSet] | [[UiSdlFormFieldSet]] | [UiSdlFieldSetFormFieldSetting])
                       : [UiSdlFieldSetFormFieldSetting] ts-client

  /**
   * Helper function to find the configuration for the given field name from the given set of field configurations.
   *
   * @param fieldName
   *          The name of the field for which to find the configuration.
   * @param fieldSets
   *          Array of field sets to search for the configuration.
   * @returns The config for the given `fieldName`.
   */
  @typeScript(env='client')
  configForField: private function(fieldName: !string, fieldSets: [UiSdlFormFieldSet] | [UiSdlMultiStepFormFieldSet]): UiSdlFieldSetFormFieldSetting

  /**
   * Sets the validity of various fields in the {@link fieldValidity} map.
   *
   * @param id
   *            Id of the component.
   * @param field
   *            The field to set the validity for.
   * @param valid
   *            The validity for the field.
   *
   * @returns A `FIELD_VALIDITY_UPDATE` action for this instance with the following properties:
   * - payload.field {string} The field the input is responsible for.
   * - payload.valid {boolean} The validity of the input.  true indicates input is valid, false indicates invalid,
   *                          null/undefined indicates indeterminate.
   */
  @uiSdlActionCreator(actionType='FIELD_VALIDITY_UPDATE')
  updateFieldValidityAction: function(id: !string,
                                      field: !string,
                                      valid: boolean): !UiSdlFieldValidityUpdateAction ts-client

  /**
   * Listens for actions of type `FIELD_VALIDITY_UPDATE`, and sets the {@link fieldValidity}
   * with the results of the external validation.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='FIELD_VALIDITY_UPDATE')
  fieldValidityUpdateEffect: private function(state: !UiSdlReduxState,
                                      action: !UiSdlFieldValidityUpdateAction): !UiSdlReduxState ts-client

  /**
   * Triggered when the form needs to be reset to default configurations specified by
   * its UI metadata.
   *
   * @param id
   *            Id of the component.
   * @returns A `FORM_RESET` action for this instance.
   */
  @uiSdlActionCreator(actionType='FORM_RESET')
  resetFormAction: function(id: !string): !UiSdlFormResetAction ts-client

  /**
   * Listens for actions of type `FORM_RESET`, and creates a new instance of the uncontrolled
   * presentational react component using the default configurations specified by the UI metadata.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='FORM_RESET')
  formResetEffect: private inline function(state: !UiSdlReduxState,
                                           action: !UiSdlFormResetAction): !UiSdlReduxState ts-client

  /**
   * Triggered when the validity of an input has to be checked by external async effects.
   *
   * @param id
   *           Id of the component.
   * @param field
   *           The field which was changed.
   * @param value
   *           The value of the input.
   *
   * @returns An `INPUT_EXTERNAL_VALIDITY` action for this instance with the following properties:
   * - payload.field {string} The field the input is responsible for.
   * - payload.value {any} The value of the input.
   */
  @uiSdlActionCreator(actionType='INPUT_EXTERNAL_VALIDITY')
  externalValidateInputAction: function(id: !string,
                                        field: !string,
                                        value: any): !UiSdlInputExternalValidityAction ts-client

  /**
   * Check the validation of all fields and submit the form.
   *
   * @param id
   *           Id of the component.
   * @param event
   *           Browser event
   *
   * @returns A `VALIDATE_AND_SUBMIT` action.
   */
  @uiSdlActionCreator(actionType='VALIDATE_AND_SUBMIT')
  validateAndSubmitAction: function(id: !string, event: any): !UiSdlValidateAndSubmitAction ts-client

  /**
   * Triggered when the user submits the form.
   *
   * @param id
   *            Id of the component.
   *
   * @returns A `FORM_SUBMIT` action for this instance.
   */
  @uiSdlActionCreator(actionType='FORM_SUBMIT')
  submitFormAction: function(id: !string): !UiSdlFormSubmitAction ts-client

  /**
   * Private function to generate a form object from the {@link formFieldValues}.
   *
   * @param state
   *         The redux store state.
   * @param formDataSourceId
   *         Data source used for the original data on the form.
   * @param componentId
   *         Id of the current component instance.
   *
   * @returns The form object representing the {@link formFieldValues}.
   */
  generateFormObject: private function(state: !UiSdlReduxState,
                                       formDataSourceId: string,
                                       componentId: string): map<string, any> ts-client

  /**
   * Triggered when the user submits the form and {@link customSubmit} is set to true.
   *
   * @param id
   *           Id of the component.
   * @param event
   *           Browser event.
   *
   * @returns A `CUSTOM_FORM_SUBMIT` action for this instance.
   */
  @uiSdlActionCreator(actionType='CUSTOM_FORM_SUBMIT')
  customSubmitFormAction: function(id: !string, event: any): !UiSdlCustomFormSubmitAction ts-client

  /**
   * Triggered when the user cancels the form.
   *
   * @param id
   *            Id of the component.
   *
   * @returns A `FORM_CANCEL` action for this instance.
   */
  @uiSdlActionCreator(actionType='FORM_CANCEL')
  cancelFormAction: function(id: !string): !UiSdlFormCancelAction ts-client

  /**
   * Triggered when input value changes so that it can be validated.
   *
   * @param id
   *           Id of the component.
   * @param event
   *           Browser event.
   * @param data
   *           The data passed from the presentational components.
   *
   * @returns An `INPUT_VALIDATE` action for this instance with the following properties:
   * - payload.field {string} The field the input is responsible for.
   * - payload.value {any} The value(s) of the input. Generally a string or int.
   */
  @uiSdlActionCreator(actionType='INPUT_VALIDATE')
  validateInputAction: function(id: !string, event: any, data: map<string, any>): !UiSdlInputValidateAction ts-client

  /**
   * Triggered after the input value has been validated
   *
   * @param id
   *           Id of the component.
   * @param fieldName
   *           Name of the form field.
   * @param fieldValue
   *           Value of the form field.
   * @returns an `INPUT_CHANGED` action for this instance with the following properties:
   * - payload.componentId {string} Id of the component
   * - payload.fieldName {string} Name of the form field
   * - payload.fieldValue {map<string, any>} Value of the form field
   */
  @uiSdlActionCreator(actionType='INPUT_CHANGED')
  changedInputAction: function(id: !string,
                               fieldName: string,
                               fieldValue: map<string, any>): !UiSdlInputChangedAction ts-client

  /**
   * Triggered when the user wants to change the `required` value of a form input
   *
   * @param id
   *           Id of the component.
   * @param fieldName
   *           Name of the form field.
   * @param required
   *           Whether the field is required or not.
   * @returns an `INPUT_CHANGED` action for this instance with the following properties:
   * - payload.componentId {string} Id of the component
   * - payload.fieldName {string} Name of the form field
   * - payload.required {boolean} Whether the field is required or not
   */
  @uiSdlActionCreator(actionType='FIELD_REQUIRE')
  requireFieldAction: function(id: !string, fieldName: string, required: boolean): !UiSdlFieldRequireAction ts-client

  /**
   * Listens for actions of type `FIELD_REQUIRE`.
   *
   * @param actionStream
   *           UiSdlObservable action stream
   * @param stateStream
   *           UiSdlObservable state stream
   * @returns an UiSdlObservable action stream
   */
  @uiSdlReducer(actionType='FIELD_REQUIRE')
  fieldRequireReducer: private function(state: !UiSdlReduxState, action: !UiSdlFieldRequireAction): !UiSdlReduxState ts-client

  /**
   * Triggered when `VALIDATE_AND_SUBMIT` is triggered.
   *
   * @param id
   *            Id of the component.
   *
   * @returns A `BEFORE_SUBMIT_ACTION` action for this instance.
   */
  @uiSdlActionCreator(actionType='BEFORE_SUBMIT_ACTION')
  beforeSubmitFormAction: function(id: !string): !UiSdlBeforeSubmitFormAction ts-client

  /**
   * Triggered when `STEP_INDEX_UPDATE` is triggered.
   * @param id
   *            Id of the component.
   * @param updateToIndex
   *            Target step of the form.
   *
   * @returns A `STEP_INDEX_UPDATE` action for this instance.
   */
  @uiSdlActionCreator(actionType='STEP_INDEX_UPDATE')
  updateStepIndexAction: function(id: !string, updateToIndex: !int): !UiSdlStepIndexUpdateAction ts-client

  /**
   * Listens for actions of type `STEP_INDEX_UPDATE`.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlReducer(actionType='STEP_INDEX_UPDATE')
  stepIndexUpdateEffect: private function(state: !UiSdlReduxState,
                                          action: !UiSdlStepIndexUpdateAction): !UiSdlReduxState ts-client

  /**
   * Triggered when a form section should change its visibility.
   *
   * @param id
   *            Id of the component.
   * @param index
   *            The index of the form section in the form.
   * @param hidden
   *            True if the form section should be hidden.
   * @returns A `FORM_SECTION_VISIBILITY_UPDATE` action for this instance.
   */
  @uiSdlActionCreator(actionType='FORM_SECTION_VISIBILITY_UPDATE')
  updateFieldSetVisibilityAction: function(id: !string,
                                                   index: int,
                                                   hidden: boolean): !UiSdlFormSectionVisibilityUpdateAction ts-client

  /**
   * Triggered when a form section is collapsed or opened.
   *
   * @param id
   *            Id of the component.
   * @param index
   *            The index of the form section in the form.
   * @param collapsed
   *            True if the form section should be collapsed.
   * @returns A `FORM_SECTION_COLLAPSED_STATE_UPDATE` action for this instance.
   */
  @uiSdlActionCreator(actionType='FORM_SECTION_COLLAPSE_STATE_UPDATE')
  updateFieldSetCollapseStateAction: function(id: !string,
                                                   index: int,
                                                   collapsed: boolean): !UiSdlFormSectionCollapseStateUpdateAction ts-client

  /**
   * Listens for actions of type `FIELD_SET_ACTION_BUTTON_STATE_CHANGE` and update disabled state properly.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlReducer(actionType='FIELD_SET_ACTION_BUTTON_STATE_CHANGE')
  fieldSetButtonStateChangeReducer: private function(state: !UiSdlReduxState,
                                                     action: !UiSdlFieldSetActionButtonStateChangeAction)
                                              : !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `FORM_SECTION_VISIBILITY_UPDATE` and sets the corresponding hidden value on the state on the
   * form section.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlReducer(actionType='FORM_SECTION_VISIBILITY_UPDATE')
  fieldSetVisibilityUpdateEffect: private function(state: !UiSdlReduxState,
                                                   action: !UiSdlFormSectionVisibilityUpdateAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `FORM_SECTION_COLLAPSED_STATE_UPDATE` and sets the corresponding hidden value on the state on the
   * form section.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlReducer(actionType='FORM_SECTION_COLLAPSE_STATE_UPDATE')
  fieldSetCollapseStateUpdateReducer: private function(state: !UiSdlReduxState,
                                                   action: !UiSdlFormSectionCollapseStateUpdateAction): !UiSdlReduxState ts-client

  /**
   * Triggered when a form section button state changed.
   *
   * @param id
   *           Id of the component.
   * @param actionSuffix
   *           The suffix of the action that should be triggered.
   * @param disable
   *           Boolean if button should be disabled or not.
   *
   * @returns A `FIELD_SET_ACTION_BUTTON_STATE_CHANGE` action.
   */
  @uiSdlActionCreator(actionType='FIELD_SET_ACTION_BUTTON_STATE_CHANGE')
  changeFieldSetActionButtonStateAction: function(id: !string,
                                                  actionSuffix: !string,
                                                  disable: boolean): UiSdlFieldSetActionButtonStateChangeAction ts-client

  /**
   * Triggered when a form section button is clicked.
   *
   * @param id
   *           Id of the component.
   * @param actionSuffix
   *           The suffix of the action that should be triggered.
   *
   * @returns A `FIELD_SET_ACTION_BUTTON_CLICK_${actionSuffix}` action.
   */
  @uiSdlActionCreator(actionType='FIELD_SET_ACTION_BUTTON_CLICK_${actionSuffix}')
  clickFieldSetButtonAction: function(id: !string,
                                      actionSuffix: !string): UiSdlFieldSetActionButtonClickAction ts-client

  /**
   * Triggered when a form section link is clicked.
   *
   * @param id
   *           Id of the component.
   * @param actionSuffix
   *           The suffix of the action that should be triggered.
   *
   * @returns A `FIELD_SET_LINK_CLICK_${actionSuffix}` action.
   */
  @uiSdlActionCreator(actionType='FIELD_SET_LINK_CLICK_${actionSuffix}')
  clickFieldSetLinkAction: function(id: !string, actionSuffix: !string): UiSdlFieldSetLinkClickAction ts-client

  /**
   * Triggers `FIELD_VALIDITY_UPDATE` and `INPUT_EXTERNAL_VALIDITY` actions for each form field,
   * followed by a `BEFORE_SUBMIT_ACTION` action.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='VALIDATE_AND_SUBMIT')
  validateAndSubmitEpic: private function(actionStream: !UiSdlActionsObservable,
                                          stateStream: !UiSdlStatesObservable): !UiSdlActionsObservable ts-client

  /**
   * Triggers `ARGUMENTS_MERGE` and `DATA_REQUEST` actions for the {@link submitDataSpec}.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='FORM_SUBMIT')
  formSubmitEpic: private function(actionStream: !UiSdlActionsObservable,
                                   stateStream: !UiSdlStatesObservable): !UiSdlActionsObservable ts-client

  /**
   * Validates the given form field (i.e. checks if required fields are present),
   * then triggers `FIELD_VALIDITY_UPDATE` and `INPUT_EXTERNAL_VALIDITY` actions as appropriate.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='INPUT_VALIDATE')
  validateInputEpic: private inline function(actionStream: !UiSdlActionsObservable,
                                             stateStream: !UiSdlStatesObservable): !UiSdlActionsObservable ts-client

  /**
   * Triggers a `FORM_SUBMIT` action if the submit button is enabled.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='BEFORE_SUBMIT_ACTION')
  beforeSubmitFormEpic: private inline function(actionStream: !UiSdlActionsObservable,
                                                stateStream: !UiSdlStatesObservable): !UiSdlActionsObservable ts-client

  /**
   * Triggers a 'FIELD_VALIDITY_UPDATE' action based on the updated `required` field
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   * @returns an Observable action stream.
   */
  @uiSdlEpic(actionType='FIELD_REQUIRE')
  fieldRequireEpic: private function(actionStream: !UiSdlActionsObservable,
                             stateStream: !UiSdlStatesObservable): !UiSdlActionsObservable ts-client
}
