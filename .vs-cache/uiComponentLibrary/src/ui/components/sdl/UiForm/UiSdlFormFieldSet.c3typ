/**
 * A type which represents a grouping of fields on a {@link UiSdlForm}.
 */
@typeScript
type UiSdlFormFieldSet mixes UiSdlFormBaseFieldSet {

  /**
   * Whether or not the form sections should be collapsed on initial load.
   * Only takes effect if {@link UiSdlFormFieldSet#collapsible} is true.
   *
   */
  @deprecated(finalVersion='8.7')
  collapseOnLoad: boolean

  /**
   * Whether or not the form sections should be collapsed on initial load.
   * Only takes effect if {@link UiSdlFormFieldSet#collapsible} is true.
   */
  collapsed: boolean = false

  /**
   * Whether the field set should be collapsible.
   */
  collapsible: boolean = false

  /**
   * The group of fields within this fieldSet.
   */
  fields: [UiSdlFieldSetFormFieldSetting]

  /**
   * Whether the field set is currently hidden.
   */
  hidden: boolean = false

  /**
   * The hint text shown in the tooltip (as an info icon).
   */
  infoTooltipText: string | UiSdlDynamicValueSpec

  /**
   * Optional link displayed at the bottom of a form section used to trigger an action.
   */
  link: UiSdlFormFieldSetLink

  /**
   * An optional action button displayed next to a form section title, disabled by default.
   */
  actionButton: UiSdlActionGroup
}
