/**
 * Payload for a {@link UiSdlFieldValidityUpdateAction}.
 */
type UiSdlFieldValidityUpdatePayload mixes UiSdlComponentActionPayload {

  /**
   * The field to set the validity for.
   */
  field: !string

  /**
   * The validity for the field.
   */
  valid: boolean
}
