/**
 * The data specification for {@link UiSdlForm}.  This represents the data used to populate the information for the form.
 * Example.  If the Form is used to edit information about a {@link User} the record would populate fields such as name,
 * address, and email.
 */
@typeScript
type UiSdlFormDataSpec mixes UiSdlFormBaseDataSpec {

  /**
   * The fieldSets on this form.
   */
  fieldSets: [UiSdlFormFieldSet] | [UiSdlMultiStepFormFieldSet]
}
