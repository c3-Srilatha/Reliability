/**
 * A specification that describes how to display field set in the {@link UiSdlForm}.
 */
@typeScript
type UiSdlFieldSetFormFieldSetting mixes UiSdlFieldSettingBase, UiSdlFieldSetFormBaseFieldSetting {

  /**
   * Insert a component into this field.
   */
  componentRef: UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>

  /**
   * The label that should appear above the field.
   */
  label: !(string | UiSdlDynamicValueSpec)

  /**
   * The hint text to be shown below the field.
   */
  hintText: string | UiSdlDynamicValueSpec

  /**
   * The hint text shown in the tooltip (as an info icon).
   */
  infoTooltipText: string | UiSdlDynamicValueSpec

  /**
   * Whether or not this field is required.
   */
  required: boolean

  /**
   * Whether the field should be disabled.
   */
  disabled: boolean = false

  /**
   * Whether the field should be hidden.
   */
  hidden: boolean = false

  /**
   * The input element for this field set input field.
   */
  inputElement: UiSdlCustomInputBase | UiSdlTextInput | UiSdlTextAreaInput | UiSdlDateTimeInput | UiSdlToggle | UiSdlNumberInput | UiSdlNumberRangeInput | UiSdlDateTimeRangeInput | UiSdlDateTimeOpenRangeInput | UiSdlSelectInput | UiSdlIconSelectInput | UiSdlSingleSearch | UiSdlMultipleSearch | UiSdlSegmentedButton | UiSdlCheckboxTree | UiSdlSlider | UiSdlPassword | UiSdlFieldGroup | UiSdlGroupedInput | UiSdlRadioButtonGroup | UiSdlRadioButtonWithInputValueGroup

  /**
   * Width of the field, int or double as percentage value or UiSdlFormWidth as value with its unit.
   */
  width: int | double | UiSdlFormWidth

  /**
   * Max width of the field, int or double as percentage value or UiSdlFormWidth as value with its unit.
   */
  maxWidth: int | double | UiSdlFormWidth

}
