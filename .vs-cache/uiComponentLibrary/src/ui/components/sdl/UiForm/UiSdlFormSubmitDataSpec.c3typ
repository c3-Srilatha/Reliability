/**
 * `UiSdlComponentDataSpec` to allow `UiSdlForm` component instance to specify the `PartiallyAppliedAction`
 * to execute when submit is executed.
 */
@typeScript
type UiSdlFormSubmitDataSpec mixes UiSdlFieldBasedDataSpec {

  /**
   * Converts the data spec to an array of partially applied actions.
   */
  toPartiallyAppliedActions: ~ ts-client

  /**
   * We should not be making the request to save when the form is rendered.
   */
  disableDataRequestOnFirstRender: ~ = true

  /**
   * We should not be making the request to save outside of directly wanting to.
   */
  ignoreAllContextVarResolution: ~ = true

  /**
   * Name of the action to call on the dataType.
   */
  actionName: string

  /**
   * Name of the argument the action expects. The argument value will be the form object.
   */
  submitArgument: !string
}
