/**
 * The data specification for a field on a form, for example, a select dropdown that is backed by a collection of data.
 */
@typeScript
type UiSdlFormFieldDataSpec mixes UiSdlFieldBasedDataSpec {

  /**
   * Name of the action to call on the dataType.
   */
  actionName: string

  /**
   * The args of the action.
   */
  args: map<string, any>

  /**
   * Path from the result of the partially applied action to the array that will populate the field.
   */
  dataPath: string

  /**
   * The field that should be displayed in the field collection.
   */
  displayField: string

  /**
   * The field that will be used as the value of the collection input field; may or may not be the same as displayField.
   */
  valueField: string

  /**
   * The field that will be used as the source of the description in the row of the dropdown of the item.
   */
  descriptionField: string
}
