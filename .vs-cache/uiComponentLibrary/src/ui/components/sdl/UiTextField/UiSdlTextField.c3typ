/**
 * A UI component type that displays a single line text field.
 */
@uiComponentCategorizer(name='Text input (new)', aliases=['Atomic Text Input'], category='Components')
type UiSdlTextField mixes UiSdlComponent {

  /**
   * Size of text field area.
   */
  size: string enum("SMALL", "MEDIUM", "LARGE") = "MEDIUM"

  /**
   * Status of text field.
   */
  status: string enum("IDLE", "ERROR", "SUCCESS", "DISABLED", "READ_ONLY") = "IDLE"

  /**
   * Width of text field.
   */
  width: string enum("X-SMALL", "SMALL", "MEDIUM", "LARGE", "X_LARGE", "FILL") = "MEDIUM"

  /**
   * Placeholder text to appear in the text field when the input is empty.
   */
  placeholder: string | UiSdlDynamicValueSpec

  /**
   * The value of this text field component.
   */
  value: string

  /**
   * The initial value of this text field component.
   */
  initialValue: string | UiSdlDynamicValueSpec

  /**
   * An action that is dispatched to set the value of the text field component.
   *
   * @param id
   *           Id of the text field component.
   * @param value
   *           The value of the text field component.
   */
  @uiSdlActionCreator(actionType='SET_TEXT_FIELD_VALUE')
  setTextFieldValueAction: function(id: !string, value: string): !UiSdlTextFieldValueSetAction ts-client

  /**
   * Triggered when a text field needs to change status.
   *
   * @param id
   *           Id of the component.
   * @param status
   *           The status of the text field.
   *
   * @returns A `SET_TEXT_FIELD_STATUS` action for this instance.
   */
  @uiSdlActionCreator(actionType='SET_TEXT_FIELD_STATUS')
  setTextFieldStatusAction: function(id: !string, status: !string enum("IDLE", "ERROR", "SUCCESS", "DISABLED", "READ_ONLY") = "IDLE"): !UiSdlTextFieldStatusSetAction ts-client

  /**
   * Listens for actions of type `SET_TEXT_FIELD_VALUE` and sets the {@link UiSdlTextField#value} field of the
   * input component.
   */
  @uiSdlReducer(actionType='SET_TEXT_FIELD_VALUE')
textFieldValueSetReducer: private function(state: UiSdlReduxState, action: UiSdlTextFieldValueSetAction): UiSdlReduxState ts-client

  /**
   * Listens for actions of type `SET_TEXT_FIELD_STATUS` and sets the {@link UiSdlTextField#status} field of the
   * input component.
   */
  @uiSdlReducer(actionType='SET_TEXT_FIELD_STATUS')
  textFieldStatusSetReducer: private function(state: UiSdlReduxState, action: UiSdlTextFieldStatusSetAction): UiSdlReduxState ts-client
}
