/**
 * The modal bodies (child steps) should be provided in
 * the {@link #children} array as references to components that are {@link UiSdlMultiStepModalStep}s.
 */
@typeScript
@uiComponentCategorizer(name='Multi-step modal', category='Components')
type UiSdlMultiStepModal mixes UiSdlModalBase {

  /**
   * The index of the current step that is being displayed.
   */
  currentIndex: int = 0

  /**
   * Triggered when the modal step needs to be updated.
   *
   * @param id
   *          Id of the component.
   * @param index
   *          The new index to be set.
   *
   * @returns A `STEP_UPDATE` action for this instance.
   *   - payload {int} The new index to be set.
   */
  @uiSdlActionCreator(actionType='STEP_UPDATE')
  updateStepAction: function(id: !string, index: !int): !UiSdlStepUpdateAction ts-client

  /**
   * Listens for actions of type `STEP_UPDATE` and sets the {@link #currentIndex}.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='STEP_UPDATE')
  stepUpdateReducer: private function(state: !UiSdlReduxState,
                                      action: !UiSdlStepUpdateAction): !UiSdlReduxState ts-client
}
