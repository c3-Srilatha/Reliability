/**
 * An icon configuration for a single item category for {@link UiSdlTreeList}.
 */
@typeScript
type UiSdlTreeListIconSetting {

  /**
   * The category.
   */
  category: !string

  /**
   * The name of the icon.
   */
  icon: string

  /**
   * The color of the icon.
   * Its value should be one of the keys in {@link UiSdlTreeListIconColor} (not case-sensitive).
   */
  iconColor: string enum UiSdlTreeListIconColor
}
