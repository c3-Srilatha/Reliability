/**
 * The specification of data retrieval for instances of the {@link UiSdlTreeList} component type.
 */
@typeScript
type UiSdlTreeListDataSpec mixes UiSdlComponentDataSpec {

  /**
   * The name of the function to call to retrieve data.
   */
  actionName: string

  /**
   * Any parameters needed by the action.  These could be object ids, FetchSpecs, or other information that
   * is independent of which nodes are currently expanded.  Information about expanded nodes will be sent separately.
   */
  params: map<string, any>

  /**
   * The name of the field in UiSdlTreeListNode.obj that contains the text to display for each item.
   */
  displayField: !string

  /**
   * A specification of which icon to display with each item.
   */
  icon: UiSdlTreeListIconFieldSetting

  /**
   * A specification of the color of the icon to display with each item.
   */
  iconColor: UiSdlTreeListIconFieldSetting

  toPartiallyAppliedActions: ~ ts-client
}
