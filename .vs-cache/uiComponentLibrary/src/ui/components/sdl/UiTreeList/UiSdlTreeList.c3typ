/**
 * A UI component type shows a tree list, which can be used to visualize hierarchical data. All nodes can be disabled and
 * parent nodes can be expanded or collapsed. A search bar can be rendered to search on given data source.
 */
@typeScript
@uiComponentCategorizer(name='Tree list', category='Components')
type UiSdlTreeList mixes UiSdlComponent<UiSdlTreeListDataSpec>, UiSdlSearchable {

  @uiSdlDataSpec(dataDestinationField='topLevelNodes')
  dataSpec: ~

  /**
   * A data spec for providing auto-completed search suggestions.
   */
  @uiSdlDataSpec(dataDestinationField='searchSuggestions')
  searchSuggestionsSpec: UiSdlTreeListSearchDataSpec

  /**
   * Specifies whether to render the search bar subcomponent.
   */
  searchable: boolean = false

  /**
   * The message to show when there are no search results.
   */
  noSearchResultsMessage: string

  /**
   * Holds the data to display in the list.  This is a list of the top-level nodes.
   */
  topLevelNodes: [UiSdlTreeListNode]

  /**
   * The string inputted into the search bar.
   */
  searchString: string

  /**
   * The list of auto-completed suggestions that match the search term.
   */
  searchSuggestions: [string]

  /**
   * A list to keep track of the ids of the currently expanded parent nodes.
   */
  expandedParentList: [string]

  /**
   * A list to keep track of disabled nodes.
   */
  disabledNodeList: [string]

  /**
   * Clickable actions that are rendered to the right of each item, similar to row actions in a grid.
   */
  itemActions: [UiSdlTreeListItemAction]

  /**
   * If true, when initially rendered, all expandable nodes start out expanded.
   */
  initiallyExpanded: boolean

  /**
   * Trigger when users click on treelist expand icon
   *
   * @param id
   *           Id of the component.
   * @param nodeId
   *           The id of the node that the user is clicking.
   *
   * @returns A `TREE_LIST_EXPAND` action for this instance.
   */
  @uiSdlActionCreator(actionType='TREE_LIST_EXPAND')
  expandTreeListAction: function(id: string, nodeId: string): UiSdlTreeListNodeAction ts-client

  /**
   * Trigger to add or remove nodes from {@link expandedParentList}.
   *
   * @param id
   *           Id of the component.
   * @param nodeId
   *           The id of the clicked node.
   *
   * @returns An `EXPANDED_PARENT_LIST_TOGGLE` action for this instance.
   */
  @uiSdlActionCreator(actionType='EXPANDED_PARENT_LIST_TOGGLE')
  toggleExpandedParentListAction: function(id: string, nodeId: string): UiSdlTreeListNodeAction ts-client

  /**
   * Trigger merge argument and request data actions after passing in the latest {@link expandedParentList}
   * and currently clicked data item.
   *
   * @param id
   *           Id of the component.
   *
   * @returns A `BEFORE_REQUEST_DATA` action for this instance.
   */
  @uiSdlActionCreator(actionType='BEFORE_REQUEST_DATA')
  beforeRequestDataAction: function(id: string): UiSdlTreeListBeforeRequestDataAction ts-client

  /**
   * Trigger to add or remove nodes from {@link disabledNodeList}.
   *
   * @param id
   *           Id of the component.
   * @param nodeId
   *           The id of the clicked node.
   *
   * @returns A `DISABLED_NODE_LIST_TOGGLE` action for this instance.
   */
  @uiSdlActionCreator(actionType='DISABLED_NODE_LIST_TOGGLE')
  toggleDisabledNodeListAction: function(id: string, nodeId: string): UiSdlTreeListNodeAction ts-client

  /**
   * Trigger to set the {@link searchString}.
   *
   * @param id
   *           Id of the component.
   * @param searchString
   *           The search string to set.
   * @returns A `SEARCH_STRING_SET` action for this instance.
   */
  @uiSdlActionCreator(actionType='SEARCH_STRING_SET')
  setSearchStringAction: function(id: string, searchString: string): UiSdlSearchStringSetAction ts-client

  /**
   * Triggers an item action.
   *
   * @param id
   *           Id of the component.
   * @param actionSuffix
   *           The action that was clicked on the row.
   * @param nodeId
   *           The id of the node on the row.
   *
   * @returns An `ITEM_ACTION_CLICK_${actionSuffix}` action with the node id of the item that triggered the action.
   */
  @uiSdlActionCreator(actionType='ITEM_ACTION_CLICK_${actionSuffix}')
  triggerItemAction: function(id: string, actionSuffix: string, nodeId: string): UiSdlTreeListNodeAction ts-client

  /**
   * Listens for action of type `EXPANDED_PARENT_LIST_TOGGLE` and update {@link expandedParentList}.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='EXPANDED_PARENT_LIST_TOGGLE')
  expandedParentListToggleReducer: private inline function(state: UiSdlReduxState,
                                                           action: UiSdlTreeListNodeAction): UiSdlReduxState ts-client

  /**
   * Listens for action of type `DISABLED_NODE_LIST_TOGGLE` and update {@link disabledNodeList}.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='DISABLED_NODE_LIST_TOGGLE')
  disabledNodeListToggleReducer: private inline function(state: UiSdlReduxState,
                                                         action: UiSdlTreeListNodeAction): UiSdlReduxState ts-client

  /**
   * Listens for action of type `SEARCH_STRING_SET` and update {@link searchString}.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='SEARCH_STRING_SET')
  searchStringSetReducer: private inline function(state: UiSdlReduxState,
                                                  action: UiSdlSearchStringSetAction): UiSdlReduxState ts-client

  /**
   * Helper for {@link expandedParentListToggleReducer} and {@link disabledNodeListToggleReducer} that adds or removes
   * the id of the clicked item from the specified list.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   * @param fieldName
   *           The name of the field containing the list to update.
   *
   * @returns A new Redux state.
   */
  toggleListEffectHelper: private inline function(state: UiSdlReduxState,
                                                  action: UiSdlReduxAction,
                                                  fieldName: string): UiSdlReduxState ts-client

  /**
   * Listens for actions of type `TREE_LIST_EXPAND`, then triggers
   * {@link toggleExpandedParentListAction} and {@link beforeRequestDataAction}.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='TREE_LIST_EXPAND')
  treeListExpandEpic: private function(actionStream: UiSdlActionsObservable,
                                       stateStream: UiSdlStatesObservable): UiSdlActionsObservable ts-client

  /**
   * Listens for action of type `BEFORE_REQUEST_DATA` and triggers
   * {@link UiSdlDataRedux#mergeArgumentsAction} and {@link UiSdlDataRedux#requestDataAction} of component's datasource.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='BEFORE_REQUEST_DATA')
  beforeDataRequestEpic: private inline function(actionStream: UiSdlActionsObservable,
                                                 stateStream: UiSdlStatesObservable): UiSdlActionsObservable ts-client

  searchQueryChangeEpic: ~ ts-client
}
