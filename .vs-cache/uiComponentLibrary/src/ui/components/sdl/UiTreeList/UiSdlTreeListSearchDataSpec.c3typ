/**
 * Data spec for providing auto-completed search suggestions for {@link UiSdlTreeList}.
 */
@typeScript
type UiSdlTreeListSearchDataSpec mixes UiSdlComponentDataSpec {

  /**
   * The name of the function to call to retrieve data.
   */
  actionName: string

  /**
   * The string to search against.
   */
  searchString: string

  toPartiallyAppliedActions: ~ ts-client
}
