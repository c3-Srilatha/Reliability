/**
 * Category-based icon configuration settings for a {@link UiSdlTreeList}.
 * Used by {@link UiSdlTreeListIconFieldSetting}.
 */
type UiSdlTreeListIconCategoricalSetting {

  /**
   * The configuration values and the corresponding categories.
   */
  values: [UiSdlTreeListIconSetting]
}
