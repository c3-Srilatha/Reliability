/**
 * A representation of an item of a {@link UiSdlTreeList}.
 */
@typeScript
type UiSdlTreeListNode {

  /**
   * The id of this node.
   */
  nodeId: !string

  /**
   * The object represented by this node.
   */
  obj: !json

  /**
   * The id of this node's parent, if any.
   */
  parentId: string

  /**
   * The amount of indentation to display for this node.  It does not need to equal
   * the actual depth of the node in the tree - we can set all the depths to 0 if
   * no indentation is desired at all.
   */
  depth: int

  /**
   * Whether this node has any children (visible or not).  This controls whether an
   * expand icon is displayed for the node.
   */
  hasChildren: boolean

  /**
   * Whether this node is expanded.
   */
  expanded: boolean

  /**
   * Child nodes in the order that will be displayed.
   */
  children: [UiSdlTreeListNode]
}
