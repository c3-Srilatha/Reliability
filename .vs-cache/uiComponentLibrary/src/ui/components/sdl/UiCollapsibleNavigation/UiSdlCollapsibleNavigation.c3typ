/**
 * A UI component type for the Side Navigation Panel
 */
@typeScript
@uiComponentCategorizer(name='Collapsible navigation', category='Components')
type UiSdlCollapsibleNavigation mixes UiSdlComponent<UiSdlCollapsibleNavigationDataSpec> {

  /**
   * Side Navigation Panel Header.
   */
  header: UiSdlCollapsibleNavigationHeader

  /**
   * Whether the Side Navigation Panel will be collapsible or not.
   */
  collapsible: boolean = true

  /**
   * Whether the Side Navigation Panel is collapsed.
   */
  collapsed: boolean = false

  /**
   * The item that is selected
   */
  selectedItemId: string

  /**
   * Whether the Collapsible Navigation Panel will be resizable or not.
   * If the {@link UiSdlCollapsibleNavigation} is used inside {@link UiSdlGridLayout} this field
   * will automatically be set to `false`.
   */
  resizable: boolean = true

  /**
   * The specification used for retrieving data displayed on the navigation
   */
  @uiSdlDataSpec(dataDestinationField='data')
  dataSpec: ~

  /**
   * Holds the data to display on the navigation
   */
  data: [UiSdlCollapsibleNavigationItem] = []

  /**
   * Used internally to rectify the data specified in the dataSpec, and any downstream changes to data, such as
   * modifying via derived props
   */
  navItems: private [UiSdlCollapsibleNavigationItem] = []

  /**
   * Triggered when a navigation item is clicked
   * @param id
   *            Id of the component.
   * @param item
   *           the item object.
   */
  @uiSdlActionCreator(actionType='NAVIGATION_ITEM_CLICK')
  clickNavigationItemAction: function(id: string, item: json): UiSdlReduxAction ts-client

  /**
   * Triggered when a navigation item is clicked
   * @param id
   *            Id of the component.
   * @param item
   *           the item object.
   */
  @uiSdlActionCreator(actionType='NAVIGATION_ITEMS_UPDATE')
  updateNavigationItemsAction: function(id: string, navigationItems: [UiSdlCollapsibleNavigationItem]): UiSdlReduxAction ts-client

  /**
   * Reducer to change item active state when the item is clicked
   * Deprecated in 8.9, use NAVIGATION_SET_SELECTED_ITEM to set an item to selected
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   * @param componentId
   *           Component id of the item.
   * @returns Potentially modified Redux state.
   */
  @uiSdlReducer(actionType='NAVIGATION_ITEM_CLICK')
  @deprecated(finalVersion='8.9')
  navigationItemClickReducer: private inline function(state: UiSdlReduxState,
                                                action: UiSdlItemDropFromToListAction,
                                                componentId: !string): UiSdlReduxState ts-client

  /**
   * Triggered when setting an item to selected
   * @param id
   *            Id of the component.
   * @param item
   *           the item object.
   */
  @uiSdlActionCreator(actionType='NAVIGATION_SET_SELECTED_ITEM')
  navigationSetSelectedItem: function(id: string, itemId: string): UiSdlCollapsibleNavigationSetItemSelectedAction ts-client

  /**
   * Reducer to change item active state when the item is clicked
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   * @param componentId
   *           Component id of the item.
   * @returns Potentially modified Redux state.
   */
  @uiSdlReducer(actionType='NAVIGATION_SET_SELECTED_ITEM')
  navigationSetSelectedItemReducer: private inline function(state: UiSdlReduxState,
                                                action: UiSdlCollapsibleNavigationSetItemSelectedAction,
                                                componentId: !string): UiSdlReduxState ts-client
  /**
   * Reducer to update navigation items when data changes.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   * @returns Potentially modified Redux state.
   */
  @uiSdlReducer(actionType='NAVIGATION_ITEMS_UPDATE')
  navigationItemsUpdateReducer: private inline function(state: UiSdlReduxState,
                                                action: UiSdlReduxAction
                                                ): UiSdlReduxState ts-client
}
