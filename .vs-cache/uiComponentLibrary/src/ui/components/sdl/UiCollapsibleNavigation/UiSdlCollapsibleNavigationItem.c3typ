type UiSdlCollapsibleNavigationItem {

  /**
   * The string or {@link UiSdlFieldBasedDataSpecSetting} to represent the item's unique ID.
   */
  id: !string | UiSdlFieldBasedDataSpecSetting

  /**
   * The string or {@link UiSdlFieldBasedDataSpecSetting} to represent the item's label.
   */
  label: !string | UiSdlFieldBasedDataSpecSetting

  /**
   * The string or {@link UiSdlFieldBasedDataSpecSetting} to represent the icon of the item.
   * (e.g. "folder", "file", "house")
   */
  icon: string | UiSdlFieldBasedDataSpecSetting

  /**
   * Array of children that the subItems has.
   */
  subItems: [UiSdlCollapsibleNavigationItem] = []

  /**
   * Boolean to control if the section is open
  */
  active: boolean | UiSdlFieldBasedDataSpecSetting

  /**
   * The string or {@link UiSdlFieldBasedDataSpecSetting} to represent the expanded state of the item.
   */
  @constraint(condition='subItems.length >= 0')
  expanded: boolean | UiSdlFieldBasedDataSpecSetting = true

  /**
   * The {@link UiSdlRoute} or {@link UiSdlFieldBasedDataSpecSetting} to represent the route to redirect to when an item is clicked.
   */
  redirectLink: UiSdlRoute | UiSdlFieldBasedDataSpecSetting
}
