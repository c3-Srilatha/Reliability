/**
 * The specification of data retrieval for instances of the {@link UiSdlAreaChart} component type.
 */

@typeScript
type UiSdlAreaChartDataSpec mixes UiSdlTimeseriesLineBarChartDataSpec {
  /**
   * Converts the data spec to an array of partially applied actions.
   */
  @typeScript(env='client')
  toPartiallyAppliedActions: ~ ts-client

  /**
   * Specs that describe how to use each  field of the {@link dataType} in {@link UiSdlAreaChart} y axis.
   */
  yAxisFields: [UiSdlAreaChartYAxisDataSpecSetting]

  /**
   * Specs that describe how to use each projection field of the {@link dataType} in {@link UiSdlAreaChart} y axis.
   */
  yAxisProjectionFields: [UiSdlAreaChartYAxisDataSpecSetting]
}
