/**
 * The specification of data retrieval for instances of the {@link UiSdlAreaChart} component type.
 */

@typeScript
type UiSdlAreaChartYAxisDataSpecSetting mixes UiSdlTimeseriesLineBarChartYAxisDataSpecSetting {

  /**
   * The type of visualization.
   */
  visualizationType: ~

  /**
   * Label for legend group. Series with the same labels will be added to the one group
   * If label is not set for all series, then no groups will be created.
   */
  legendGroupLabel: string
}
