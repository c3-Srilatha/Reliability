/**
 * A UI component type that displays data in area chart
 */
@typeScript
@uiComponentCategorizer(name='Area chart', category='Data Visualization')
type UiSdlAreaChart mixes UiSdlLineBarChart<UiSdlAreaChartDataSpec> {

  /**
   * Chart header.
   */
  header: UiSdlComponentHeader

  /**
   * The specification used to retrieve event data displayed by this chart.
   */
  @uiSdlDataSpec(dataDestinationField='eventData')
  eventDataSpec: UiSdlTimeseriesLineBarChartEventDataSpec

  /**
   * Stores the FetchResults retrieved by {@link #eventDataSpec}.
   */
  eventData: Obj

  /**
   * Only timeseries chart will have xAxis component configuration.  Categorical charts will define their
   * X-axis configuration in the dataSpec types.
   */
  xAxis: UiSdlTimeseriesLineBarChartXAxisConfig | UiSdlTimeseriesLineBarChartXAxisStaticConfig

  /**
   * Whether or not to display the "now" line on the chart.
   */
  showNowLine: boolean = false

  /**
   * Whether or not to smooth chart lines
   */
  smooth: boolean = false

  /**
   * Opacity for chart areas
   */
  @constraint(condition='areaOpacity >= 0 && areaOpacity <= 1')
  areaOpacity: float = 0.9

  /**
   * Setting for chartActions selection.
   */
  chartActions: [UiSdlAction] = [{name: 'UiSdlAreaChart.chartActions.EXPORT_CHART_CSV.name', actionSuffix: 'EXPORT_CHART_CSV', iconSuffix: 'table'}, { name: 'UiSdlAreaChart.chartActions.EXPORT_CHART_EVENTS_CSV.name', actionSuffix: 'EXPORT_CHART_EVENTS_CSV', iconSuffix: 'table'}, { name: 'UiSdlAreaChart.chartActions.EXPORT_CHART_JPEG.name', actionSuffix: 'EXPORT_CHART_JPEG', iconSuffix: 'file-image'}, { name: 'UiSdlAreaChart.chartActions.EXPORT_CHART_PNG.name', actionSuffix: 'EXPORT_CHART_PNG', iconSuffix: 'file-image'}]

  /**
   * Configuration to use tooltip for single item or whole axis
   */
  tooltipTrigger: string enum('item','axis')

  /**
   * Whether or not to plot and show data at timestamps where there are 100% missing values.
   */
  hideMissingDataPoints: boolean = false

  /**
   * Timezone configuration for displayed data.
   * E.g. if an event happened at 1am EST, we will show the event as happened at 1am to browsers in any timezone.
   */
  noTimeZoneConversion: boolean = false

  /**
   * Start date displayed in the chart shown only when dataSelection is enabled
   */
  displayStartDate: datetime

  /**
   * End date displayed in the chart shown only when dataSelection is enabled
   */
  displayEndDate: datetime

  /**
   * Interval display value in the chart shown only when dataSelection is enabled
   */
  displayInterval: string = 'DAY'

  /**
   * Whether or not to override user config ID with data generated ID
   */
  shouldOverrideUserConfigIdWithDataGeneratedId: boolean = false

  /**
   * Whether or not to show the data selector. For example, the date range and interval selectors.
   */
  dataSelection: boolean

  doDataMerge: ~ ts-client

  /**
   * Creates a mapping from event specification indices in {@link #eventDataSpec}
   * to data source ids. Used by {@link #doDataMerge} to merge data into the props
   * in a way that's easy to match with the corresponding configuration.
   * @param componentId
   *            Id of the component
   * @param state
   *            Redux state
   * @return The mapping of indicies
   */
  getIndexedEventDataSourceIds: private function (componentId: string, state: UiSdlReduxState): map<int, string> ts-client

  /**
   * Given a data source id, return the index of the corresponding UiSdlAreaChartEventSeriesDataSpec
   * in {@link UiSdlTimeseriesLineBarChartEventDataSpec#events}
   * If the data source id is not for an event, returns `null`.
   * @param dataSourceId
   *            Id of the data source
   */
  getEventDataSourceIndex: private function (dataSourceId: string): int ts-client

  generateSpec: ~ ts-client

  /**
   * Triggered to update the filter for the time series
   * @param id
   *            Id of the component.
   * @param start
   *           Start date for the filter spec {@link EvalMetricSpec}
   * @param end
   *           End date for the filter spec
   * @param interval
   *           interval for the filter spec
   * @return An `DATA_FILTER_UPDATE` action for this instance with the following properties:
   * - payload {string} The name of the series
   */
  @uiSdlActionCreator(actionType='DATA_FILTER_UPDATE')
  updateDataFilterAction: function(id: string, start: string, end: string, interval: string): UiSdlDataFilterUpdateAction ts-client

  /**
   * Listens to actions of type `DATA_FILTER_UPDATE` and update the filter for the time series
   *
   * @param actionStream
   *            UiSdlObservable action stream.
   * @param stateStream
   *            UiSdlObservable state stream.
   * @returns an UiSdlObservable action stream.
   */
  @uiSdlEpic(actionType='DATA_FILTER_UPDATE')
  dataFilterUpdateEpic: private function(actionStream: UiSdlActionsObservable,
                                         stateStream: UiSdlStatesObservable): UiSdlActionsObservable ts-client

  /**
   * Triggered to update the date range and interval selector in the chart
   * @param id
   *            Id of the component.
   * @param start
   *           Start date for the filter spec {@link EvalMetricSpec}
   * @param end
   *           End date for the filter spec
   * @param interval
   *           interval for the filter spec
   */
  @uiSdlActionCreator(actionType='DISPLAY_DATE_UPDATE')
  updateDisplayDateAction: function(id: string, start: string, end: string, interval: string): UiSdlDisplayDateUpdateAction ts-client

  /**
   * Updates the date selector and interval values in the redux state of the component
   * @param state
   *          The redux state
   * @param action
   *          THe result of the display update action
   * @ return The redux state
   */
  @uiSdlReducer(actionType='DISPLAY_DATE_UPDATE')
  displayDateUpdateReducer: private inline function(state: UiSdlReduxState, action: UiSdlDisplayDateUpdateAction): UiSdlReduxState ts-client

  filterSubmitEpic: ~ ts-client

  /**
   * Triggers `DISPLAY_DATE_UPDATE` action when the chart renders the first time.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='INITIAL_RENDER')
  areaChartInitialRenderEpic: private function(actionStream: UiSdlActionsObservable, stateStream: UiSdlStatesObservable): UiSdlActionsObservable ts-client
}
