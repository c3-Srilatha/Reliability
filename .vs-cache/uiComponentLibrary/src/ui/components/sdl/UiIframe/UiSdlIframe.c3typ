/**
 * A UI component type that renders an iFrame.
 */
@typeScript
@uiComponentCategorizer(name='IFrame', category='Components', hide=true)
type UiSdlIframe mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The src attribute of the iFrame.
   */
  src: string

  /**
   * The width of the iFrame.
   */
  width: string = '100%'

  /**
   * The height of the iFrame.
   */
  height: string = '100%'

  /**
   * The title of the iframe.
   */
  title: string | UiSdlDynamicValueSpec

  /**
   * Triggered when the iframe needs to be reloaded (it will go through the authentication flow).
   *
   * @returns An `IFRAME_RELOAD` action for this instance.
   */
  @uiSdlActionCreator(actionType='IFRAME_RELOAD')
  reloadIframeAction: member function(id: !string): UiSdlIframeReloadAction ts-client

  /**
   * Triggered when the iframe needs to update its src.
   *
   * @returns A `SRC_UPDATE` action for this instance.
   * - payload {string} The new src value for the iframe.
   */
  @uiSdlActionCreator(actionType='SRC_UPDATE')
  updateSrcAction: member function(id: !string, src: !string): UiSdlSrcUpdateAction ts-client

  /**
   * Listens for actions of type `SRC_UPDATE` and updates internal field {@link #src}.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='SRC_UPDATE')
  srcUpdateEffect: private inline function(state: UiSdlReduxState,
                                           action: UiSdlSrcUpdateAction): UiSdlReduxState ts-client
}
