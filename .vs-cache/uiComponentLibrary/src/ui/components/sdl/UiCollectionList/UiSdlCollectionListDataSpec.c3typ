/**
 * The specification of data retrieval for instances of the {@link UiSdlCollectionList} component type.
 */
@typeScript
type UiSdlCollectionListDataSpec mixes UiSdlFieldBasedDataSpec {

  /**
   * Primary value for list item.
   */
  primaryValueField: UiSdlCollectionListDataSpecSetting

  /**
   * Secondary value for list item.
   */
  secondaryValueField: UiSdlCollectionListDataSpecSetting

  /**
   * Configuration for the collection list value bar.
   */
  valueBarConfig: UiSdlCollectionListDataSpecValueBarSetting

  /**
   * Configuration for the collection list item icon.
   */
  iconConfig: UiSdlCollectionListDataSpecIconSetting

  /**
   * Specifies how many records to show.
   */
  limit: int

  /**
   * Filter for the collection list.
   * Same format as {@link FetchSpec#filter}.
   */
  filter: string

  /**
   * Converts the data spec to a partially applied action.
   */
  toPartiallyAppliedActions: ~ ts-client
}
