/**
 * A specification that describes field in the {@link UiSdlCollectionList}.
 */
@typeScript
type UiSdlCollectionListDataSpecSetting mixes UiSdlComponentDataSpecSortableFieldSetting {

  /**
   * The url to which the user is redirected upon clicking the cell value.
   * TODO: UI-8454 Change this value type when the refactored link configuration is available.
   */
  redirectLink: UiSdlLinkTemplate

  /**
   * The formatting to be applied on the {@link UiSdlCollectionList} field description.
   */
  format: UiSdlDynamicValueSpecParamFormat
}
