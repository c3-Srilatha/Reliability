/**
 * A specification that describes the value bar field for a {@link UiSdlCollectionList}.
 */
type UiSdlCollectionListDataSpecValueBarSetting mixes UiSdlFieldBasedDataSpecSetting {

  /**
   * The type of value being provided.
   * UiSdlCollectionListValueBarTypePartOfWhole: Value will be displayed as a percentage of the sum of all values
   */
  valueType: UiSdlCollectionListValueBarTypePartOfWhole
}
