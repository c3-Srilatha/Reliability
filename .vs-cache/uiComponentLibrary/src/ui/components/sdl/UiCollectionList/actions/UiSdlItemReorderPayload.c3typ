/**
 * Payload for a {@link UiSdlItemReorderAction}.
 */
type UiSdlItemReorderPayload mixes UiSdlComponentActionPayload {

  /**
   * The identifier of the list that contains the item being
   *           reordered.
   */
  listId: !string

  /**
   * The index of the reordered item, before reordering.
   */
  fromIndex: !int

  /**
   * The index of the reordered item, after reordering.
   */
  toIndex: !int
}
