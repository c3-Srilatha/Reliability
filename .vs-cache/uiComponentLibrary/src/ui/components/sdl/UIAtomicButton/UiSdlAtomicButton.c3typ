/**
 * A UI component type button.
 */
@typeScript
@uiComponentCategorizer(name='Button (new)', category='Components')
type UiSdlAtomicButton mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The button text.
   */
  textContent: string serialized UiSdlDynamicValueSpec

  /**
   * The icon in the button
   */
  leftIcon: string

  /**
   * The icon in the button
   */
  rightIcon: string

  /**
   * The button variant.
   */
  variant: string enum('accent', 'primary','danger') = 'accent'

  /**
   * The size of the button.
   */
  size: string enum('small', 'medium', 'large') = 'medium'

  /**
   * The type the button.
   */
  buttonType: string enum('fill', 'outline', 'ghost') = 'fill'

  /**
   * Whether or not the button is disabled
   */
  disabled: boolean = false

  /**
   * Sets the button to show a loading spinner instead of the content.
   */
  loading: boolean = false

  /**
   * The type of content in the button.
   */
  @constraint(condition='option="text"')
  textStyle: string enum('textOnly', 'iconLeft', 'iconRight') = 'textOnly'

  /**
   * Triggered when the button is clicked.
   *
   * @param id
   *            Id of the component.
   * @returns A `ATOM_BUTTON_CLICK` action for this instance.
   */
  @uiSdlActionCreator(actionType='ATOM_BUTTON_CLICK')
  clickAtomicButtonAction: function(id: string): !UiSdlAtomicButtonClickAction ts-client

  /**
   * Action for setting the disabled state of the button.
   *
   * @param id
   *            Id of the component.
   * @param disabled
   *          True will set the button to disabled.
   * @returns A `ATOM_BUTTON_DISABLED_SET` action for this instance.
   */
  @uiSdlActionCreator(actionType='ATOM_BUTTON_DISABLED_SET')
  setAtomicButtonDisabledAction: function(id: string, disabled: boolean): !UiSdlAtomicButtonSetDisabledAction ts-client

  /**
   * Action for setting the loading state of the button.
   *
   * @param id
   *            Id of the component.
   * @param loading
   *          True will set the button to loading, show the spinner
   *          and disable the click action.  False will hide the spinner
   *          and re-enable the button click action.
   * @returns A `ATOM_BUTTON_LOADING_SET` action for this instance.
   */
  @uiSdlActionCreator(actionType='ATOM_BUTTON_LOADING_SET')
  setAtomicButtonLoadingAction: function(id: string, loading: boolean): !UiSdlAtomicButtonSetLoadingAction ts-client

  /**
   * Action for setting the content of the button.
   *
   * @param id
   *            Id of the component.
   * @param content
   *            The DynamicValueSpec for the content.
   * @returns A `ATOM_BUTTON_CONTENT_SET` action for this instance.
   */
  @uiSdlActionCreator(actionType='ATOM_BUTTON_CONTENT_SET')
  setAtomicButtonContentAction: function(id: string, content: UiSdlDynamicValueSpec): !UiSdlAtomicButtonSetContentAction ts-client

  /**
   * Listens for actions of type `ATOM_BUTTON_DISABLED_SET` and sets the {@link #disabled} state.
   * to the payload value (true/false)
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='ATOM_BUTTON_DISABLED_SET')
  disabledAtomicButtonSetEffect: private function(state: !UiSdlReduxState,
                                      action: !UiSdlAtomicButtonSetDisabledAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `ATOM_BUTTON_LOADING_SET` and sets the {@link #loading} state
   * to the payload value (true/false).
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='ATOM_BUTTON_LOADING_SET')
  loadingAtomicButtonSetEffect: private function(state: !UiSdlReduxState,
                                     action: !UiSdlAtomicButtonSetLoadingAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `ATOM_BUTTON_CONTENT_SET` and sets the {@link #content} state
   * to the payload values.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='ATOM_BUTTON_CONTENT_SET')
  contentAtomicButtonSetEffect: private function(state: !UiSdlReduxState,
                                     action: !UiSdlAtomicButtonSetContentAction): !UiSdlReduxState ts-client
}
