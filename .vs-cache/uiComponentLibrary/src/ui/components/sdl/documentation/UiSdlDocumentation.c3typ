/**
 * A component used in documenting and demoing other components. For documented usages of components in
 * the uiComponentLibrary, refer to the uiDemo package.
 */
@typeScript
@uiComponentCategorizer(name='Documentation', category='Components', hide=true)
type UiSdlDocumentation mixes UiSdlComponent<UiSdlNoData> {

  /**
   * Children components to render.
   */
  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]

  /**
   * A string that defines the purpose of the component.
   */
  purpose: string serialized UiSdlDynamicValueSpec
}
