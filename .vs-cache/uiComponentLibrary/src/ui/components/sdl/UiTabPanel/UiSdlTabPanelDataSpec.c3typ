/**
 * The specification of data retrieval for instances of the {@link UiSdlTabPanel} component type.
 */
@typeScript
type UiSdlTabPanelDataSpec mixes UiSdlFieldBasedDataSpec {

  /**
   * Provided from json file right now to be used by toPartiallyAppliedActions to generate the id.
   */
  entityId: string

  /**
   * Title for the current tab panel.
   */
  title: !UiSdlFieldBasedDataSpecSetting

  /**
   * Sub-title text for the current tab panel.
   */
  subTitle: UiSdlTabPanelDataSpecLinkSetting

  /**
   * Body text for the current tab panel.
   */
  bodyText: UiSdlFieldBasedDataSpecSetting

  /**
  * An array of body texts
  */
  bodyParagraph: [TabPanelParagraphDataSpecSetting]

  toPartiallyAppliedActions: ~ ts-client
}
