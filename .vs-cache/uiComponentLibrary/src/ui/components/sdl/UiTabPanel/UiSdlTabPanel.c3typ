/**
 * A UI component type that is very similar to the page title but without the page name delineator, and with
 * additional space for tiles to be added on top of it.
 */
@uiSdlDesignerComponent(designable=true,
                        category='UiSdlTabPanel.CategoryName',
                        name='UiSdlTabPanel.ComponentName',
                        icon='window-maximize')
@typeScript
@uiComponentCategorizer(name='Tab panel', category='Patterns')
type UiSdlTabPanel mixes UiSdlComponent<UiSdlTabPanelDataSpec> {

  /**
   * The specification used for retrieving data displayed by the tab panel.
   */
  @uiSdlDataSpec(dataDestinationField='texts')
  dataSpec: ~

  /**
   * Holds text information for the tab panel, including title, sub-title, and body text.
   */
  texts: Obj

  /**
   * Static title for the tab panel.
   */
  title: UiSdlTabPanelDataSpecTextSetting

  /**
   * Static sub-title for the tab panel.
   */
  subTitle: UiSdlTabPanelDataSpecTextSetting

  /**
   * Static body text for the tab panel.
   */
  bodyText: UiSdlTabPanelDataSpecTextSetting

  /**
  * Body paragraph that has a set of label-value objects than will appear in the tab panel.
  */
  bodyParagraph: [TabPanelParagraph]

  /**
   * The visual look of the tab bar
   */
  tabBarStyle: string enum('regular', 'segmented', 'pill') = 'regular'

  /**
   * Configurations of components to be rendered as child tabs.
   * Id is required, title is optional.
   */
  tabComponents: ![UiSdlTabComponentRef]

  /**
   * Configurations of components to be rendered as tiles in the title section.
   * Id is required.
   */
  tileComponents: [UiSdlTileComponentRef]

  /**
   * Props derived from tabComponents for the presentational React component.
   * It has an id and a title.
   */
  tabs: [json]

  /**
   * The ids of tabs with notifications.
   */
  tabsWithNotification: [string]

  /**
   * Props derived from tileComponents for the presentational React component.
   * It has an id and a title.
   */
  tiles: [json]

  /**
   * The id of the active tab.
   */
  activeTab: string

  /**
   * The text to render on the primary action button.
   */
  primaryActionButtonTitle: string

  /**
   * The text to render on the secondary action button.
   */
  secondaryActionButtonTitle: string

  /**
   * Whether the primary action button is in the loading state.
   */
  primaryActionButtonLoading: boolean

  /**
   * Whether the secondary action button is in the loading state.
   */
  secondaryActionButtonLoading: boolean

  /**
   * Whether the primary action button is disabled.
   */
  primaryActionButtonDisabled: boolean

  /**
   * Whether the secondary action button is disabled.
   */
  secondaryActionButtonDisabled: boolean

  /**
   * The icon action configs to render in the tab panel title section.
   */
  iconActions: [UiSdlAction]

  /**
   * Whether or not to render the tertiary action button.  On click {@link clickActionButton} will be fired and submit a
   * `TERTIARY_ACTION_CLICK` action.
   */
  tertiaryAction: boolean

  /**
   * Triggered when the active tab needs to be changed.
   *
   * @param id
   *           Id of the component.
   * @param activeTab
   *           The id of the active tab.
   *
   * @returns An `ACTIVE_TAB_CHANGE` action for this instance.
   *   - payload {string} The id of the active tab.
   */
  @uiSdlActionCreator(actionType='ACTIVE_TAB_CHANGE')
  changeActiveTabAction: function(id: string, activeTab: !string): !UiSdlActiveTabChangeAction ts-client

  /**
   * Triggers setting the notification on a tab.
   *
   * @param id
   *           Id of the component.
   * @param tabId
   *           The id of the tab to notify.
   *
   * @returns A `NOTIFICATION_ON_TAB_SET` action for this instance.
   *   - payload {string} The id of the tab.
   */
  @uiSdlActionCreator(actionType='NOTIFICATION_ON_TAB_SET')
  setNotificationOnTabAction: function(id: string, tabId: !string): !UiSdlNotificationOnTabAction ts-client

  /**
   * Removes the notification on a tab.
   *
   * @param id
   *           Id of the component.
   * @param tabId
   *           The id of the tab to remove the notification from.
   *
   * @returns A `NOTIFICATION_ON_TAB_REMOVE` action for this instance.
   *   - payload {string} The id of the tab.
   */
  @uiSdlActionCreator(actionType='NOTIFICATION_ON_TAB_REMOVE')
  removeNotificationOnTabAction: function(id: string, tabId: !string): !UiSdlNotificationOnTabAction ts-client

  /**
   * Triggered when an action button is clicked.
   *
   * @param id
   *          Id of the component.
   * @param actionSuffix
   *          The action button that was clicked.
   *
   * @returns An `ACTION_CLICK_${actionSuffix}` action for this instance.
   */
  @uiSdlActionCreator(actionType='ACTION_CLICK_${actionSuffix}')
  clickActionButton: function(id: string, actionSuffix: string): !UiSdlActionClickAction ts-client

  /**
   * Triggered when a button state needs to be changed.
   * This can be disabled or loading state for a button.
   *
   * @param id
   *           Id of the component.
   * @param buttonType
   *           The button type clicked.  Valid values are 'PRIMARY' or 'SECONDARY'.
   * @param disable
   *           Whether or not this button should be disabled or enabled.
   * @param loading
   *           Whether or not this button should be loading or not.
   *
   * @returns An `ACTION_BUTTON_STATE_CHANGE` action for this instance.
   */
  @uiSdlActionCreator(actionType='ACTION_BUTTON_STATE_CHANGE')
  changeActionButtonStateAction: function(id: string,
                                                  buttonType: string enum('PRIMARY', 'SECONDARY'),
                                                  disable: boolean,
                                                  loading: boolean): UiSdlTabPanelActionButtonStateChangeAction ts-client

  /**
   * Triggered when a button content needs to be changed.
   *
   * @param id
   *           Id of the component.
   * @param content
   *           The content of the button
   *
   * @returns An `PRIMARY_BUTTON_CONTENT_UPDATE` action for this instance.
   */
  @uiSdlActionCreator(actionType='PRIMARY_BUTTON_CONTENT_UPDATE')
  updatePrimaryButtonContentAction: function(id: string,
                                                  content: string): UiSdlTabPanelPrimaryButtonContentChangeAction ts-client

  /**
   * Listens for actions of type `ACTIVE_TAB_CHANGE`, then renders
   * the tab component if it hasn't been rendered.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='ACTIVE_TAB_CHANGE')
  activeTabChangeReducer: private function(state: !UiSdlReduxState,
                                           action: UiSdlActiveTabChangeAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `NOTIFICATION_ON_TAB_SET`, then adds the notification to that tab.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='NOTIFICATION_ON_TAB_SET')
  notificationOnTabSetReducer: private function(state: !UiSdlReduxState,
                                                action: UiSdlNotificationOnTabAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `NOTIFICATION_ON_TAB_REMOVE`, then removes the notification from that tab.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='NOTIFICATION_ON_TAB_REMOVE')
  notificationOnTabRemoveReducer: private function(state: !UiSdlReduxState,
                                                   action: UiSdlNotificationOnTabAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `ACTION_BUTTON_STATE_CHANGE`, then renders the action button appropriately.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='ACTION_BUTTON_STATE_CHANGE')
  actionButtonStateChangeReducer: private function(state: !UiSdlReduxState,
                                           action: !UiSdlTabPanelActionButtonStateChangeAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `PRIMARY_BUTTON_CONTENT_UPDATE`, then renders the action button appropriately.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='PRIMARY_BUTTON_CONTENT_UPDATE')
  primaryButtonTextUpdateReducer: private function(state: !UiSdlReduxState,
                                           action: !UiSdlTabPanelPrimaryButtonContentChangeAction): !UiSdlReduxState ts-client
}
