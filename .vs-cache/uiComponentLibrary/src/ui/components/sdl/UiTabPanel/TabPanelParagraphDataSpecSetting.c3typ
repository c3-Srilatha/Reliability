/**
* Data Spec setting for bodyParagraph in UiSdlTanPanelDataSpec
*/
@typeScript
type TabPanelParagraphDataSpecSetting mixes UiSdlFieldBasedDataSpecSetting {
  /**
  * The label that will be rendered as bold text.
  */
  label: string
  /**
  * The text that will be rendered as regular text
  */
  text: UiSdlFieldBasedDataSpecSetting
}
