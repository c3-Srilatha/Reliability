/**
 * Configurations of a component to be rendered as child tabs for a {@link UiSdlTabPanel}.
 */
@typeScript
type UiSdlTabComponentRef mixes UiSdlComponentRef<UiSdlComponent<any>> {

  /**
   * Id of the tab component.
   */
  id: !string

  /**
   * Optional title of the tab component.
   */
  title: string

  /**
   * Id of the component to be rendered.
   */
  component: string
}
