/**
 * A specification that describes how the link is configured and text is used in {@link UiSdlTabPanel}.
 */
@typeScript
type UiSdlTabPanelDataSpecLinkSetting mixes UiSdlFieldBasedDataSpecSetting, UiSdlLinkTemplate {

  /**
   * Field from {@link UiSdlTabPanelDataSpec#dataType} used to construct the link. The value of this field is appended
   * to {@link UiSdlLinkTemplate#href} location.
   *
   * @example
   * The following config will link to /myapp/mypage/<MyType.parent.id>
   * "dataSpec": {
   *   "dataType": {
   *     "typeName": "MyType"
   *   },
   *   "subTitle": {
   *     "fieldName": "name",
   *     "href": "/myapp/mypage/",
   *     "redirectLinkFieldName": "parent.id"
   *   }
   * }
   */
  redirectLinkFieldName: private string
}
