/**
 * A UI component type that displays data in a list of cards.
 */
@uiSdlDesignerComponent(designable=true,
                        category='UiSdlCardList.CategoryName',
                        name='UiSdlCardList.ComponentName',
                        icon='th-large')
@typeScript
@uiComponentCategorizer(name='Card list', category='Patterns')
type UiSdlCardList mixes UiSdlComponent<UiSdlCardListDataSpec> {

  /**
   * Orientation of Card List either vertical or horizontal. Defaults to Horizontal.
   */
  orientation: string enum('HORIZONTAL', 'VERTICAL') = 'HORIZONTAL'

  /**
   * The configurations for the optional first action button at the bottom of each card.
   */
  primaryActionButton: UiSdlAction

  /**
   * The configurations for the optional second action button at the bottom of each card.
   */
  secondaryActionButton: UiSdlAction

  /**
   * The configurations for the link to be used for the `See All` text.
   */
  containerHeaderLink: UiSdlCardListHeaderLinkAction | UiSdlLinkTemplate

  /**
   * The text that will be shown in the header of the list container.
   */
  @uiSdlDesignerCustomRenderer(rendererType='SDLInput')
  containerHeaderText: string serialized UiSdlDynamicValueSpec
  /**
   * The tooltip text for the info icon.
   * It accepts a string or a `UiSdlDynamicValueSpec` object.
   */
  infoTooltipText: string serialized UiSdlDynamicValueSpec

  /**
   * The text that will be shown as the subtitle of the list container.
   */
  @uiSdlDesignerCustomRenderer(rendererType='SDLInput')
  containerSubtitleText: string serialized UiSdlDynamicValueSpec
  /**
   * The component that handles the empty state.
   * It will appear if the cardlist has no data.
   */
  emptyState: UiSdlEmptyState

  /**
   * The specification used for retrieving data displayed by the card list.
   */
  @uiSdlDataSpec(dataDestinationField='dataCollection')
  dataSpec: ~

  /**
   * Holds the data to display in the card list.
   */
  dataCollection: [Obj]

  /**
   * Triggers an action when either `primaryActionButton` or `secondaryActionButton` is clicked.
   *
   * @param id
   *            Id of the component.
   * @param actionSuffix
   *           The suffix of the action that should be triggered.
   * @param dataItem
   *           The record that represents the card in the card list.
   * @returns a `CARD_ACTION_CLICK_${actionSuffix}` action
   */
  @uiSdlActionCreator(actionType='CARD_ACTION_CLICK_${actionSuffix}')
  clickCardAction: function(id: string, actionSuffix: string, dataItem: json): UiSdlCardActionClickAction ts-client

  /**
   * Triggers an action when "See All" button is clicked.
   *
   * @param id
   *            Id of the component.
   * @returns A `SEE_ALL_CLICK` action.
   */
  @uiSdlActionCreator(actionType='SEE_ALL_CLICK')
  clickSeeAllAction: function(id: string): UiSdlSeeAllClickAction ts-client

  /**
   * Triggers an action when either `primaryActionButton` or `secondaryActionButton` is clicked at empty state.
   *
   * @param id
   *            Id of the component.
   * @param actionSuffix
   *           The suffix of the action that should be triggered.
   *
   * @returns A `EMPTY_STATE_ACTION_CLICK_${actionSuffix}` action.
   */
  @uiSdlActionCreator(actionType='EMPTY_STATE_ACTION_CLICK_${actionSuffix}')
  clickEmptyStateButtonAction: function(id: string, actionSuffix: !string): UiSdlEmptyStateActionClickAction ts-client
}
