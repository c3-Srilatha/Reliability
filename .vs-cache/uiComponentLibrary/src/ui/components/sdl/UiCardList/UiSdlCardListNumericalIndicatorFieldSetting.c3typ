/**
 * A specification that describes how to display a numerical indicator of a card in the {@link UiSdlCardList}.
 */
@typeScript
type UiSdlCardListNumericalIndicatorFieldSetting mixes UiSdlFieldBasedDataSpecSetting {

  /**
   * The minimum value, used to calculate the progress ratio.
   */
  minimum: int

  /**
   * The maximum value, used to calculate the progress ratio.
   */
  maximum: int

  /**
   * The color gradient selection.
   */
  gradient: string enum('gradient1', 'gradient1-inv', 'gradient2', 'gradient2-inv', 'gradient3', 'gradient3-inv')

  /**
   * Whether to show the indicator number
   */
  showNumber: boolean = true
}
