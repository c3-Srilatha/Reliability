/**
 * Payload for a {@link UiSdlCardActionClickAction}.
 */
type UiSdlCardActionClickPayload mixes UiSdlComponentActionPayload {

  /**
   * Id of the component. This is the same as componentId only that {@link UiSdlCardActionClickAction} explicitly look for this {#id} field.
   */
  id: string

  /**
   * The record that represents the card in the card list.
   */
  cardData: json
}
