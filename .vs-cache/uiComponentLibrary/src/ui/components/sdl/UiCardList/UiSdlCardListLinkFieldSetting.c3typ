/**
 * A specification that describes how to display a header of a card in the {@link UiSdlCardList}.
 *
 * TODO: UI-6427 Implement redirect links for UiSdlCardList in UI Designer.
 */
@typeScript
type UiSdlCardListLinkFieldSetting mixes UiSdlFieldBasedDataSpecSetting {

  /**
   * The target page for the URL redirect link.
   */
  targetPage: string

  /**
   * The route for the URL redirect link.
   */
  route: string

  /**
   * The page variable for the URL redirect link.
   */
  pageVariable: string

  /**
   * Defines if a link is internal or external
   */
  internal: boolean = false
}
