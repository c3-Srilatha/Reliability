/**
 * Enum type for tracking a message banner's status when displayed through {@link UiSdlMessageContainer}.
 */
enum type UiSdlMessageBannerStatus {

  /**
   * Signifies a message is in the queue, or has not yet finished its initial displaying animation.
   */
  INIT

  /**
   * Signifies the banner has been displayed and the opening animation has finished.
   */
  VISIBLE

  /**
   * Signifies the banner has been closed, and the closing animation should begin.
   */
  CLOSED
}
