/**
 * A type defining the structure of a payload for {@link UiSdlMessageContainer#showBannerAction}.
 * It mixes the options from {@link UiSdlMessageBannerConfig} and adds an optional width property.
 */
@typeScript
type UiSdlShowMessageActionPayload mixes UiSdlMessageBannerConfig {
  width: string enum('SMALL', 'MEDIUM', 'LARGE', 'FULLSCREEN') = 'LARGE'
}
