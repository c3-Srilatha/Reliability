/**
 * An enum type describing the available message banner styles when displayed through {@link UiSdlMessageContainer}.
 */
enum type UiSdlMessageBannerType {

  /**
   * A red colored banner with an exclamation circle icon.
   */
  ERROR

  /**
   * A yellow colored banner with an exclamation triangle icon.
   */
  WARNING

  /**
   * A green colored banner with a check mark circle icon.
   */
  SUCCESS

  /**
   * A blue colored banner with an information circle icon.
   */
  INFO
}
