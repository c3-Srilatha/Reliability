/**
 * An enum type describing the available render positions for an {@link UiSdlMessageContainer}.
 */
enum type UiSdlMessageContainerRenderPosition {

  /**
   * Top of the screen, centered horizontally.
   */
  TOP_CENTER

  /**
   * Bottom of the screen, centered horizontally.
   */
  BOTTOM_CENTER
}
