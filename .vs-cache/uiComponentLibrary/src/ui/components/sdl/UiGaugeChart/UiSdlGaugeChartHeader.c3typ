/**
 * A type that represents the configuration of a gauge chart.
 */
type UiSdlGaugeChartHeader mixes UiSdlComponentTitle, UiSdlComponentSubtitle {

  /**
   * The visual alignment of this header title.
   */
  alignment: string enum('LEFT', 'CENTER') = 'LEFT'

  /**
   * The url to which the user is redirected upon clicking the header title.
   */
  redirectLink: UiSdlLinkTemplate
}
