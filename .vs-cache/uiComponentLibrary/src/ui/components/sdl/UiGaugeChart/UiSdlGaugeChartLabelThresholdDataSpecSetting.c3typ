/**
 * The data specification for the labels thresholds of the {@link UiSdlGaugeChart}.
 */
type UiSdlGaugeChartLabelThresholdDataSpecSetting {

  /**
   * The lower bound (inclusive) of which the particular label should be displayed.
   */
  fromValue: double

  /**
   * The upper bound (inclusive) of which the particular label should be displayed.
   */
  toValue: double

  /**
   * The label (overrides {@link UiSdlGaugeChartValueFieldDataSpecSetting#label}) for the given bounds.
   */
  label: string | UiSdlDynamicValueSpec
}
