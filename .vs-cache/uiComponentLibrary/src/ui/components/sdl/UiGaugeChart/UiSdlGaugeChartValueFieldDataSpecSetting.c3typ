/**
 * The specification of data for the secondary field of the {@link UiSdlGaugeChart} component type.
 */
type UiSdlGaugeChartValueFieldDataSpecSetting mixes UiSdlFieldBasedDataSpecSetting {

  /**
   * A label for the field.
   */
  label: string

  /**
   * The formatting style to use.
   */
  style: string enum('decimal', 'currency', 'unit') = 'decimal'

  /**
   * The unit to use in unit formatting.
   */
  unit: string

  /**
   * The currency to use in currency formatting. Possible values are the ISO 4217 currency codes.
   * If {@link style} is "currency", the currency field must be provided.
   */
  currency: string

  /**
   * The minimum possible value to be displayed by the {@link UiSdlGaugeChart}.
   * Default value is 0.
   */
  min: double = 0

  /**
   * The maximum possible value to be displayed by the {@link UiSdlGaugeChart}.
   * If max is not specified then default value will be equal to the value displayed by the gauge chart.
   */
  max: double

  /**
   * Setting for configuring the color thresholds for a gauge chart.
   */
  colorThresholds: [UiSdlGaugeChartColorThresholdDataSpecSetting]

  /**
   * Setting for configuring the label thresholds for a gauge chart.
   * This will override {@link UiSdlGaugeChartValueFieldDataSpecSetting#label}
   */
  labelThresholds: [UiSdlGaugeChartLabelThresholdDataSpecSetting]
}
