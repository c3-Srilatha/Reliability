/**
 * The specification of data retrieval for instances of the {@link UiSdlGaugeChart} component type.
 */
@typeScript
type UiSdlGaugeChartDataSpec mixes UiSdlFieldBasedDataSpec {

  /**
   * Converts the data spec to an array of partially applied actions.
   */
  toPartiallyAppliedActions: ~ ts-client

  /**
   * The secondary field for the gauge chart.
   * This is the specification for the field of the displayed value for the gauge chart.
   */
  valueField: UiSdlGaugeChartValueFieldDataSpecSetting
}
