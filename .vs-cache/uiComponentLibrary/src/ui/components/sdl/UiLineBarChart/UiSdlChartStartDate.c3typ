/**
 * Enumeration of relative start dates to be used for a {@link UiSdlTimeseriesLineBarChart}.
 */
enum type UiSdlChartStartDate {

  /**
   * Last hour.
   */
  LAST_HOUR

  /**
   * Last day.
   */
  LAST_DAY

  /**
   * Last week.
   */
  LAST_WEEK

  /**
   * Last month.
   */
  LAST_MONTH

  /**
   * Last three months.
   */
  LAST_THREE_MONTHS

  /**
   * Last year.
   */
  LAST_YEAR

  /**
   * Last two year.
   */
  LAST_TWO_YEARS
}
