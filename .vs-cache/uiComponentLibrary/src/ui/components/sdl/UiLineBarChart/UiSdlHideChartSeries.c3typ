/**
 * A UI component type that displays data in a chart.
 */
@typeScript
abstract type UiSdlHideChartSeries {

  /**
   * A list of hidden series id.
   */
  hiddenSeries: private [string]

  /**
   * Triggered to update chart hidden series.
   *
   * @param id
   *            Id of the component.
   * @param name
   *            The name of the series to hide.
   *
   * @return A `HIDDEN_SERIES_UPDATE` action for this instance with the following properties:
   * - payload {string} The name of the series.
   */
  @uiSdlActionCreator(actionType='HIDDEN_SERIES_UPDATE')
  updateHiddenSeriesAction: function(id: string,
                                     name: !string): UiSdlHideChartSeriesHiddenSeriesUpdateAction ts-client

  /**
   * Listens for actions of type `HIDDEN_SERIES_UPDATE` and updates internal field {@link hiddenSeries}.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='HIDDEN_SERIES_UPDATE')
  hiddenSeriesUpdateEffect: private inline function(state: UiSdlReduxState,
                                                    action: UiSdlHideChartSeriesHiddenSeriesUpdateAction)
                                             : UiSdlReduxState ts-client
}
