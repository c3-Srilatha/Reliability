/**
 * The spec to for each date line to be made through {@link UiSdlTimeseriesLineBarChartDateLineDataSpec}
 */
@typeScript
type UiSdlTimeseriesLineBarChartDateLineDataSpecSetting {
  /**
   * The configuration for the line, but date will be overridden by the result from the data fetch.
   */
  dateLineConfig: !UiSdlTimeseriesLineBarChartDateLineConfig

  /**
   * Id for the entity
   */
  entityId: !string

  /**
   * The field name of the entity to pull the date from.
   */
  fieldName: !string
}
