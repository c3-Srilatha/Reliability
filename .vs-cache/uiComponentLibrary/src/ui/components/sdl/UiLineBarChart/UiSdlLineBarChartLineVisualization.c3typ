/**
 * A type to visualize chart data in lines. This is used at
 * {@link UiSdlCategoricalLineBarChartYAxisDataSpecSetting#visualizationType}.
 */
@typeScript
type UiSdlLineBarChartLineVisualization mixes UiSdlLineBarChartVisualization {
  /**
   * The visualization type.
   */
  visualizationType: string enum UiSdlLineBarChartVisualizationType = LINE

  /**
   * The style of lines.
   */
  lineStyle: string enum('Solid', 'Dotted', 'Dashed') = 'Solid'

  /**
   * The width of lines, thin = 2, medium = 4, thick = 6.
   */
  lineWidth: int enum('2', '4', '6') = 2

  /**
   * Data point style.
   */
  itemStyle: string enum('CIRCLE')

  /**
   * Whether the line is smoothed or not.
   */
  smooth: boolean = false
}
