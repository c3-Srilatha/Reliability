/**
 * A type to visualize chart data as bars. This is used at
 * {@link UiSdlCategoricalLineBarChartYAxisDataSpecSetting#visualizationType}.
 */
@typeScript
type UiSdlLineBarChartBarVisualization mixes UiSdlLineBarChartVisualization {
  /**
   * The visualization type
   */
  visualizationType: string enum UiSdlLineBarChartVisualizationType = BAR

  /**
   * The width of every bar.
   */
  width: int

  /**
   * Space between every bar.
   */
  spacing: int
}
