/**
 * Type to represent the X-axis configuration for a {@link UiSdlTimeseriesLineBarChart}.
 */
@typeScript
type UiSdlTimeseriesLineBarChartXAxisConfig mixes UiSdlLineBarChartXAxisConfig {

  /**
   * The interval for X-axis values.
   */
  interval: string enum Interval = DAY

  /**
   * Number of days prior to current day for which to display values.
   */
  startDate: string enum UiSdlChartStartDate = LAST_YEAR

  /**
   * The end of date to display values.
   */
  endDate: string enum UiSdlChartEndDate = TODAY
}
