/**
  * A configuration for the axis markers in the line bar chart.
  */
type UiSdlLineBarChartAxisMarkersSetting<T> {

  /**
   * The value of the axis marker. Used to display a line/area shading on the chart on Y or X axis.
   */
  markerAxisValue: T

  /**
   * The identifier of the marker. Used to identify the marker in the chart and associate other series with it, if needed.
   */
  markerIdentifier: !string
}
