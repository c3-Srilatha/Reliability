/**
 * Type to represent the data spec for a {@link UiSdlCategoricalLineBarChart}.
 */
@typeScript
type UiSdlCategoricalLineBarChartDataSpec mixes UiSdlFieldBasedDataSpec, UiSdlLineBarChartDataSpec {

  /**
   * Converts the data spec to an array of partially applied actions.
   */
  toPartiallyAppliedActions: ~ ts-client

  /**
   * Setting for configuring a custom order string for the component's network request.
   */
  orderString: UiSdlCategoricalLineBarChartDataSpecOrderSetting

  /**
   * Group by xAxis if set to true.
   */
  groupByX: boolean = true

  /**
   * The xAxis field for the categorical chart (can be only one).
   */
  xAxisField: UiSdlCategoricalLineBarChartXAxisDataSpecSetting = {}

  /**
   * The yAxis fields for the categorical chart.
   */
  yAxisFields: [UiSdlCategoricalLineBarChartYAxisDataSpecSetting]

  /**
   * This field is set to true if ordering needs to be done on aggregation of multiple fields on the Y axis.
   */
  orderOnAggregateYAxisFields: boolean = false

  /**
   * Helper function to build group string.
   */
  buildGroupString: private member function(): string ts-client

  /**
   * Helper function to build projection string.
   */
  buildProjectionString: private member function(): string ts-client

  /**
   * Helper function to build order string.
   */
  buildOrderString: private member function(): string ts-client

  /**
   * The transform functions to use for this data spec.
   * Functions that are available are {@link UiSdlTransformUiSdlChartDataToEChartConfig}
   * and {@link UiSdlTransformEvaluateResultToUiSdlChartData}.
   */
  dataTransforms: ~ = ['UiSdlTransformEvaluateResultToUiSdlChartData', 'UiSdlTransformUiSdlChartDataToEChartConfig']

  /**
   * Upper limit for number of objects returned from the fetch call.
   */
  limit: int

  /**
   * Filter to be used in the evaluate call.
   */
  filter: string
}
