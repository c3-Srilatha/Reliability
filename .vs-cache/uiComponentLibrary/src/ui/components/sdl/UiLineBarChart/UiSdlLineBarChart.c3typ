/**
 * A UI component type that displays data in a chart.
 */
@typeScript
abstract type UiSdlLineBarChart<DataType> mixes UiSdlComponent<DataType>, UiSdlHideChartSeries, UiSdlChartColorConfig, UiSdlChartStyleConfig, UiSdlFilterable, UiSdlHeight, UiSdlTooltipConfig, UiSdlChartActions, UiSdlLineBarChartToolboxZoomable  {

  /**
   * The specification used for retrieving data displayed by the grid.
   */
  @uiSdlDataSpec(dataDestinationField='data')
  dataSpec: ~

  /**
   * Holds the data to display in the grid.
   */
  data: [Obj]

  /**
   * Chart header.
   */
  header: UiSdlComponentHeader

  /**
   * Y-axis config type.
   */
  yAxis: UiSdlLineBarChartYAxisConfig = {}

  /**
   * Configuration for the grid.
     Includes left, right, top, bottom padding for the chart
   */
  grid: UiSdlChartEChartsGrid

  /**
   * The chart legend - information for each series.
   */
  legend: UiSdlChartLegend

  /**
   * Whether to allow users to zoom the chart data via a scrubber tool
   * displayed directly below the chart.
   */
  zoomEnabled: boolean = true

  /**
   * The default type of chart to be displayed. This is a fallback value used
   * when a series does not have a specific series type configured.
   */
  defaultChartType: string enum('line', 'bar', 'scatter') = 'line'

  /**
   * Show a dropdown menu in the chart header to download the chart.
   * The user can choose to download one of the following file types: .png, .jpeg, .csv
   */
  showDownloadOptions: boolean = true

  /**
   * Show a toggle next to the download options that will display data labels
   */
  showDataLabelsToggle: boolean = false

  /**
   * The background style for the chart.
   */
  backgroundStyle: string enum('FULL_GRID', 'FREE_FORM', 'HORIZONTAL_LINES', 'VERTICAL_LINES') = 'FREE_FORM'

  /**
   * If `true`, stack all series whose series type is `'bar'`.
   */
  stackBars: boolean = false

  /**
   * The height of the component in pixels.
   */
  height: ~ = 400

  /**
   * The component that handles the empty state.
   * It will appear if the grid has no data.
   */
  emptyState: UiSdlComponentRef<UiSdlEmptyState>

  /**
   * The number of actions to display on the chart header.
   */
  chartActionsCollapseThreshold: int = 1

  /**
   * What is used to fill in missing seriesData when exporting to .csv data
   */
  csvMissingDataFiller: string = 'undefined'

  /**
   * Generates the spec that is merged into the chart's data source in {@link UiSdlLineBarChart#filterSubmitEpic}.
   *
   * @param relevantFields
   *           A mapping of relevant field names to values.
   * @param componentId
   *           The componentId that the generated spec applies to.
   * @param typeName
   *           The type applying to the component.
   *
   * @returns A spec.
   */
  generateSpec: function(relevantFields: map<string, any>,
                         componentId: string,
                         typeName: string): map<string, any> ts-client

  /**
   * Triggered when a point on the chart is clicked.
   *
   * @param id
   *            Id of the component.
   * @param point
   *           An object which represents data for the point that was clicked
   *           with the following shape:
   *     {
   *         data: an array with x and y values
   *         dataIndex: the index in the series of the point clicked
   *         name: the point label (what appears on the x axis)
   *         seriesIndex: the index of the series that was clicked (among all series on the chart)
   *         seriesName: the series label
   *         type: the type of event, e.g. "click", "hover" etc.
   *         value: an array of x and y values
   *     }
   * @return A `CHART_CLICK` action with the passed in series array as the payload.
   */
  @uiSdlActionCreator(actionType='CHART_CLICK')
  clickChartAction: function(id: string, point: Obj): UiSdlChartClickAction ts-client

  /**
   * Triggered to add a Y axis marker to the chart that is related to an specific metric.
   *
   * @param id
   *           Id of the component.
   * @param markerSpec
   *           The marker spec to add.
   */
  @uiSdlActionCreator(actionType='ADD_Y_AXIS_MARKER')
  addYAxisMarkerAction: function(id: string, markerSpec: UiSdlLineBarChartYAxisMarkerLineSpec): UiSdlLineBarChartAddYAxisMarkerAction ts-client

  /**
   * Adds a Y axis marker to the chart from redux state of the component.
   */
  @uiSdlReducer(actionType='ADD_Y_AXIS_MARKER')
  yAxisMarkerAddReducer: private function(state: UiSdlReduxState,
                                                   action: UiSdlLineBarChartAddYAxisMarkerAction): UiSdlReduxState ts-client

  /**
   * Triggered to update the grid value.
   *
   * @param id
   *           Id of the component.
   * @param grid
   *           New grid value.
   */
  @uiSdlActionCreator(actionType='CHART_GRID_UPDATE')
  updateChartGridAction: function(id: string, grid: UiSdlChartEChartsGrid): UiSdlChartGridUpdateAction ts-client

  /**
   * Updates the chart grid from redux state of the component.
   */
  @uiSdlReducer(actionType='CHART_GRID_UPDATE')
  chartGridUpdateReducer: private inline function(state: UiSdlReduxState,
                                                   action: UiSdlChartGridUpdateAction): UiSdlReduxState ts-client

  @uiSdlActionCreator(actionType='ADD_XAXIS_SHADING')
  addXAxisShadingAction: function(id: string, markerIdentifier: string, fromDate: datetime, toDate: datetime, areaLabel: string): UiSdlXAxisShadingAddAction ts-client

  @uiSdlReducer(actionType='ADD_XAXIS_SHADING')
  xAxisShadingAddReducer: private inline function(state: UiSdlReduxState,
                                                   action: UiSdlXAxisShadingAddAction): UiSdlReduxState ts-client

  filterSubmitEpic:         ~ ts-client
  advancedFilterSubmitEpic: ~ ts-client
}
