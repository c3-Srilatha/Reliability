/**
 * A type to visualize axis markers in a chart as area shading.
 */
@typeScript
@uiSdlPluggable(namespace='axisMarkerVisualization')
type UiSdlLineBarChartXAxisMarkerRangeShadingVisualization mixes UiSdlTimeseriesLineBarChartLineVisualization, UiSdlChartAxisMarkerVisualization, UiSdlLineBarChartAxisMarkersSetting<[UiSdlChartAxisMarkersRangeValue<datetime>]> {
  convertToMarkerConfig: function (): json ts-client

  axisType: string enum UiSdlChartAxisMarkerAxisType = X

  lineStyle: string enum('Solid', 'Dotted', 'Dashed', 'roundRect') = 'roundRect'
}
