/**
 * Configuration for a {@link UiSdlLineBarChart}'s Y-axis.
 */
@typeScript
type UiSdlLineBarChartYAxisConfig mixes UiSdlChartAxisConfig, UiSdlChartNumericalAxisConfig {

  nameGap: ~ = 30
  name:    ~ = 'y-axis'

  /**
   * Whether to show units.
   */
  units: boolean = false

  /**
   * Whether to show separators (for example, commas) in numbers on Y axis.
   */
  showSeparators: boolean = false
}
