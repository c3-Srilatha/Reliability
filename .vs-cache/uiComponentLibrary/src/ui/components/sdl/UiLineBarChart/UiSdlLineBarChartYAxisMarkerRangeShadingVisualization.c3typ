/**
 * A type to visualize axis markers in a chart as area shading.
 */
@typeScript
@uiSdlPluggable(namespace='axisMarkerVisualization')
type UiSdlLineBarChartYAxisMarkerRangeShadingVisualization mixes UiSdlChartAxisMarkerVisualization, UiSdlLineBarChartAxisMarkersSetting<UiSdlChartAxisMarkersRangeValue<number>>, UiSdlLineBarChartVisualization {
  /**
   * Converts the range value to a marker area configuration for the chart.
   * It can use static range values or range values coming from metric result.
   */
  convertToMarkerConfig: function (): json ts-client

  /**
   * Opacity of the area shading.
   */
  opacity: number = 0.25

  /**
   * Opacity of the area shading when is highlighted.
   */
  highlightOpacity: number = 0.3

  axisType: string enum UiSdlChartAxisMarkerAxisType = Y

  syncWithRelatedSeriesVisibility: ~ = true
}
