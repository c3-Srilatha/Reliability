/**
 * {@link UiSdlLineBarChartAddYAxisMarkerPayload} marker spec type definition.
 */
type UiSdlLineBarChartYAxisMarkerLineSpec {

  /**
   * The id of the data series to which this marker will be tied.
   * Use {@link UiSdlTransformEvalMetricsResultToUiSdlChartData#generateSeriesId} to get the right id for the series.
   */
  relatedSerieId: !string

  /**
   * The label to be shown in the legend.
   */
  legendLabel: string | UiSdlDynamicValueSpec

  /**
   * The description of the legend label on hover
   */
  legendDescription: string | UiSdlDynamicValueSpec

  /**
   * The icon of all legend items
   */
  legendIcon: string

  /**
   * The default color to be shown for this data series.
   */
  color: string enum UiSdlChartColor

  /**
   * The visualization type of the marker.
   * This can be a line or a range shading.
   */
  visualizationType: !UiSdlLineBarChartYAxisMarkerLineVisualization | !UiSdlLineBarChartYAxisMarkerRangeShadingVisualization
}
