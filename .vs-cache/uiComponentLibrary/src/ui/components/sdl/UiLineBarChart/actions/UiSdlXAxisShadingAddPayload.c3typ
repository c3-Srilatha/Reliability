/**
 * Payload for a {@link UiSdlXAxisShadingAddAction}.
 */
type UiSdlXAxisShadingAddPayload mixes UiSdlComponentActionPayload {

  /**
   * Unique identifier for the shading instance.
   * If not set, reducer will create an uuid.
   */
  markerIdentifier: string
  /**
   * The date for the start of the shading
   */
  fromDate: datetime

  /**
   * The date for the end of the shading
   */
  toDate: datetime

  /**
   * The label for the shading area, showing on top of the chart
   */
  areaLabel: string
}
