/**
 * Type to represent the Mark Line configuration for a {@link UiSdlCategoricalLineBarChart}.
 */
@typeScript
type UiSdlLineBarChartMarkLinesConfig mixes UiSdlTimeseriesLineBarChartMarkLineConfig {

  /**
   * Entity Id of the markline
   */
  entityId: string

  /**
   * The point of the vertical mark should appear at.
   */
  markLineDataPoint: string | number

  /**
   * The width of the date line in pixels.
   */
  lineWidth: number = 2

  /**
   * Name of the field to use for the markline.
   */
  fieldName: string
}
