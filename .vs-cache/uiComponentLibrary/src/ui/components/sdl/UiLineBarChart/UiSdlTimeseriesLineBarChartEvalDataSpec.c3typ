/**
 * The specification of data retrieval for instances of the {@link UiSdlTimeseriesLineBarChart} component type.
 */
@beta
@typeScript
type UiSdlTimeseriesLineBarChartEvalDataSpec mixes UiSdlMetricBasedDataSpec, UiSdlLineBarChartDataSpec {

  /**
   * Converts the data spec to an array of partially applied actions.
   */
  toPartiallyAppliedActions: ~ ts-client

  /**
   * Specs that describe how to use each field of the {@link dataType} in {@link UiSdlTimeseriesLineBarChart} y axis.
   */
  yAxisFields: [UiSdlTimeseriesLineBarChartEvalYAxisDataSpecSetting]

  dataSpecDependence: ~ = [{configField: 'xAxis.interval', argumentSpecField: 'interval'}, {configField: 'xAxis.startDate', argumentSpecField: 'start', transformFunction: 'getStartDate'}, {configField: 'xAxis.endDate', argumentSpecField: 'end', transformFunction: 'getEndDate'}]

  /**
   * The transform functions to use for this data spec.
   * Functions that are available are {@link UiSdlTransformUiSdlChartDataToEChartConfig}
   * and {@link UiSdlTransformEvalMetricsResultToUiSdlChartData}.
   */
  dataTransforms: ~ = ['UiSdlTransformEvalMetricsResultToUiSdlChartData', 'UiSdlTransformUiSdlChartDataToEChartConfig']
}
