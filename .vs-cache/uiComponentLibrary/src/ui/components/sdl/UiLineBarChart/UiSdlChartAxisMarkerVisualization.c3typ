/**
 * Abstract type to visualize axis markers in a chart.
 */
abstract type UiSdlChartAxisMarkerVisualization {
  /**
   * Converts the data to a marker configuration for the chart.
   */
  convertToMarkerConfig: abstract function (): json ts-client

  /**
   * Whether this is x or y axis marker visualization
   */
  axisType: !string enum UiSdlChartAxisMarkerAxisType

  /**
  * Flag that indicates if the series and the related marker visibility will be synchronized. For example, if series is hidden then marker will be hidden too.
  */
  syncWithRelatedSeriesVisibility: boolean = false
}
