/**
 * A type to visualize Y axis markers as a line.
 */
@typeScript
@uiSdlPluggable(namespace='axisMarkerVisualization')
type UiSdlLineBarChartYAxisMarkerLineVisualization mixes UiSdlChartAxisMarkerVisualization, UiSdlLineBarChartAxisMarkersSetting<number>, UiSdlLineBarChartLineVisualization {
  /**
   * Converts the static number value to a marker configuration for the chart or single values coming from metric result.
   */
  convertToMarkerConfig: function (): json ts-client

  visualizationType: string enum UiSdlLineBarChartVisualizationType = LINE

  axisType: string enum UiSdlChartAxisMarkerAxisType = Y

  syncWithRelatedSeriesVisibility: ~ = true
}
