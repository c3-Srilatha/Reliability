/**
 * A base type for Y axis data spec setting in {@link UiSdlLineBarChart}.
 */
@typeScript
abstract type UiSdlLineBarChartYAxisDataSpecSetting mixes UiSdlComponentDataSpecSetting {

  /**
   * The title to be shown above the yAxis line. This will override {@link UiSdlLineBarChartYAxisConfig#name}
   * default yAxis line title
   */
  yAxisTitle: string | UiSdlDynamicValueSpec

  /**
   * An object that contains some overrides for Y Axis config such as Y Axis name location, rotation and gap.
  */
  yAxisStyleOverride: UiSdlLineBarChartYAxisConfigOverride

  /**
   * The label to be shown in the legend.
   */
  legendLabel: string | UiSdlDynamicValueSpec

  /**
   * The description of the legend label on hover
   */
  legendDescription: string | UiSdlDynamicValueSpec

  /**
   * The icon of all legend items
   */
  legendIcon: string

  /**
   * The default color to be shown for this data series.
   */
  color: string enum UiSdlChartColor
}
