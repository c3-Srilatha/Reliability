@typeScript
@uiSdlPluggable(namespace='axisMarkerVisualization')
type UiSdlTimeseriesLineBarChartXAxisAreaShadingVisualization mixes UiSdlTimeseriesLineBarChartLineVisualization, UiSdlChartAxisMarkerVisualization {
  /**
   * Opacity of the shaded area.
   */
  opacity: double = 0.5

  /**
   * Function to convert the data to marker config that eCharts uses.
   */
  convertToMarkerConfig: function (): json ts-client

  /**
   * The ID of this marker.
   */
  markerIdentifier: !string

  /**
   * The axis type.
   */
  axisType: string enum UiSdlChartAxisMarkerAxisType = X
}
