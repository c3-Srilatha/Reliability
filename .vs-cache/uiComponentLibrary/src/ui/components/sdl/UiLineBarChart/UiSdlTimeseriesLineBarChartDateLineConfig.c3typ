/**
 * Type to represent the Date Line configuration for a {@link UiSdlTimeseriesLineBarChart}.
 */
@typeScript
type UiSdlTimeseriesLineBarChartDateLineConfig mixes UiSdlTimeseriesLineBarChartMarkLineConfig {

  /**
   * The date the vertical dateLine should appear at.
   */
  date: datetime

  /**
   * The width of the date line in pixels.
   */
  lineWidth: string enum('1', '2') = '1'

  /** 
   * The label for this line on the legend. Overwriting so that the default will instead
   * become the date.
   */
  legendLabel: ~= ''
}
