/**
 * Type to represent a categorical line bar chart.  We will use this type if the user selects to configure
 * a categorical line bar chart rather than a timeseries chart.
 */
@uiSdlDesignerComponent(designable=true,
                        category='UiSdlCategoricalLineBarChart.CategoryName',
                        name='UiSdlCategoricalLineBarChart.ComponentName',
                        icon='chart-bar')
@typeScript
@uiComponentCategorizer(name='Categorical line bar chart', category='Data Visualization')
type UiSdlCategoricalLineBarChart mixes UiSdlLineBarChart<UiSdlCategoricalLineBarChartDataSpec> {

  /**
   * Chart data layout. If 'HORIZONTAL' is chosen, the x- and y-axis positions
   * will reverse and data will render horizontally.
   */
  chartLayout: string enum('VERTICAL', 'HORIZONTAL') = 'VERTICAL'

  /**
   * X-axis configuration.
   */
  xAxis: UiSdlLineBarChartXAxisConfig = {}

  /**
   * Whether or not to remove series not specified in the xAxisField or yAxisField of dataSpec
   */
  removeExtraSeries: boolean = false

  /**
   * Configurations to add vertical line on the graph.
   */
  @uiSdlDataSpec(dataDestinationField='markLinesData')
  markLinesDataSpec: UiSdlCategoricalLineBarChartMarkLineDataSpec
}
