/**
 * A field to display in the body of the tooltip for each event in the chart.
 */
@typeScript
type UiSdlTimeseriesLineBarChartTooltipAdditionalFieldDataSpecSetting mixes UiSdlFieldBasedDataSpecSetting {

  /**
   * A label for the field.
   */
  label: string

  /**
   * The decimal precision to show for this tooltip value. Defaults to
   * {@link UiSdlTimeseriesLineBarChart#tooltipValuesDecimalPrecision}.
   */
  decimalPrecision: int
}
