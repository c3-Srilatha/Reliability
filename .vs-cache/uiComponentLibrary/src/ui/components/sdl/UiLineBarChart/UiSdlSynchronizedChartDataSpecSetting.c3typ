/**
 * Spec for controlling grids in synchronized charts.
 */
type UiSdlSynchronizedChartDataSpecSetting {
  // TODO: PLAT-111978 - Synchronize chart | Explicitly assign multiple series to grids, based on yAxisField configuration
  /**
   * Controls the height of the grid for this series
   * The global chart height could be resized to fit all grids.
   */
  gridHeight: int = 200
}
