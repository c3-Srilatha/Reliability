/**
 * A specification that describes which event series (if any) should be included
 * on this chart.
 */
@typeScript
type UiSdlTimeseriesLineBarChartEventDataSpec mixes UiSdlFieldBasedDataSpec {

  /**
   * Converts the data spec to an array of partially applied actions.
   */
  toPartiallyAppliedActions: ~ ts-client

  /**
   * Filter string to filter fetched events.
   */
  filter: string

  /**
   * A list of specification for different event series.
   */
  events: [UiSdlTimeseriesLineBarChartEventSeriesDataSpec]

  dataSpecDependence: ~ = [{configField: 'xAxis.interval', argumentSpecField: 'interval'}, {configField: 'xAxis.range', argumentSpecField: 'start', transformFunction: 'getStartDate'}, {configField: 'xAxis.range', argumentSpecField: 'end', transformFunction: 'getEndDate'}]

  /**
   * Convert date into start date to filter events.
   *
   * @param date
   *          Number of days prior to current day for which to display values {@link UiSdlLineBarChartXAxisConfig#startDate}.
   *
   * @return Data time in string format.
   */
  getStartDate: function(date: string, interval: Interval, noTimeZoneConversion: boolean): string ts-client

  /**
   * Convert date into end date to filter events.
   *
   * @param date
   *          Number of days after current day for which to display values {@link UiSdlLineBarChartXAxisConfig#endDate}.
   *
   * @return Data time in string format.
   */
  getEndDate: function(date: string, interval: Interval, noTimeZoneConversion: boolean): string ts-client
}
