/**
 * Used by {@link UiSdlGradientColorSetting#method}.
 * See documentation on {@link UiSdlGradientColorSetting#method}.
 */
type UiSdlGradientColorSettingWeightedMethod {

  /**
   * The minimum value used to calculate weighted gradient.
   * If null, the minimum data point is used as the minimum
   */
  minimum: double

  /**
   * The maximum value used to calculate weighted gradient.
   * If null, the maximum data point is used as the maximum
   */
  maximum: double
}
