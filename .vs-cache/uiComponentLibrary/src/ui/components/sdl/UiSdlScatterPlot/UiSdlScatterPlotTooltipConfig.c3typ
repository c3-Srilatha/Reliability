/**
 * Type for configuration of {@link UiSdlScatterPlot} tooltip.
 */
type UiSdlScatterPlotTooltipConfig mixes UiSdlTooltipBaseSettings{

  /**
   * The precision for xAxis.
   */
  xPrecision: int = 2

  /**
   * The precision for yAxis.
   */
  yPrecision: int = 2

  /**
   * Precision for the size field.
   */
  sizePrecision: int = 2

  /**
   * Precision for the additional fields.
   */
  additionalFieldsPrecision: int = 2

  /**
   * Hide size field in tooltip is set to true
   */
  hideSize: boolean = false

  /**
   * Hide xAxis field in tooltip is set to true
   */
  hideXAxis: boolean = false

  /**
   * Hide yAxis field in tooltip is set to true
   */
  hideYAxis: boolean = false

  /**
   * Hide category field in tooltip is set to true
   */
  hideCategory: boolean = false
}
