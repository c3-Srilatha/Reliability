/**
 * A UI component data spec that is based on a type and one or more fields for the {@link UiSdlScatterPlotDataSpec} type
 * xValue.fieldName is dot delimited path of the field used as x-axis value starting from {@link UiSdlScatterPlotDataSpec#dataType}.
 * The value at this path must be numerical.
 */
type UiSdlScatterPlotDataSpec mixes UiSdlFieldBasedDataSpec {

  /**
   * Converts the data spec to a partially applied action.
   */
  toPartiallyAppliedActions: ~ ts-client

  /**
   * The field on the data type that maps to the xAxis.
   */
  xAxisField: UiSdlScatterPlotDataSpecFieldSetting

  /**
   * The field on the data type that maps to the yAxis.
   */
  yAxisField: UiSdlScatterPlotDataSpecFieldSetting

  /**
   * The field on the data type that maps to the size.
   */
  size: UiSdlScatterPlotSizeSetting

  /**
   * The field on the data type that maps to the size.
   */
  tooltipHeader: UiSdlScatterPlotDataSpecFieldSetting

  /**
   * The field on the data type that maps to the category.
   */
  category: UiSdlScatterPlotCategoryFieldSetting

  /**
   * The field on the data type that maps to the tooltip.
   */
  tooltipAdditionalFields: [UiSdlScatterPlotDataSpecFieldSetting]
}
