/**
 * A UI component type that displays data in a scatter plot.
 */
@typeScript
@uiComponentCategorizer(name='Scatter plot', category='Data Visualization')
type UiSdlScatterPlot mixes UiSdlComponent<UiSdlScatterPlotDataSpec>, UiSdlHideChartSeries, UiSdlChartColorConfig, UiSdlChartStyleConfig, UiSdlHeight {

  /**
   * The specification used for retrieving data displayed by the grid.
   */
  @uiSdlDataSpec(dataDestinationField='data')
  dataSpec: ~

  /**
   * The height of the component in pixels.
   */
  height: ~ = 400

  /**
   * Holds the data to display in the grid.
   */
  data: json

  /**
   * Chart header.
   */
  header: UiSdlComponentHeader

  /**
   * Configuration of x-Axis.
   */
  xAxisConfig: UiSdlScatterPlotAxisConfig

  /**
   * Configuration of y-Axis.
   */
  yAxisConfig: UiSdlScatterPlotAxisConfig

  /**
   * Configuration for the grid.
   * Includes left, right, top, bottom padding for the chart
   */
  grid: UiSdlChartEChartsGrid

  /**
   * Configuration of legend.
   */
  legendConfig: UiSdlChartLegend

  /**
   * Configuration for the visualMap.
   */
  visualMapConfig: UiSdlChartEChartVisualMapConfig = {}

  /**
   * Boolean for data area zooming. If set to `true`, a zoom icon will be displayed in the
   * toolbox and users be able to zoom in by dragging within the chart area.
   */
  dragToZoom: boolean = true

  /**
   * Only export data in the selected zoom area.
   */
  exportSelectedData: boolean = false

  /**
   * Configuration of tooltip.
   */
  tooltipConfig: UiSdlScatterPlotTooltipConfig = {}

  /**
   * Boolean for enabling tooltip.
   */
  tooltipEnabled: boolean = true

  /**
   * Boolean for exportable. If set to true, the scatter plot can be exported as a CSV, JPEG, or PNG.
   */
  exportable: boolean = true

  /**
   * The number of actions to display on the chart header.
   */
  chartActionsCollapseThreshold: int = 1

  /**
   * Setting for chartActions selection.
   */
  chartActions: [UiSdlAction] = [{name: 'UiSdlScatterPlot.chartActions.EXPORT_CHART_CSV.name', actionSuffix: 'EXPORT_CHART_CSV', iconSuffix: 'table'}, {name: 'UiSdlScatterPlot.chartActions.EXPORT_CHART_JPEG.name', actionSuffix: 'EXPORT_CHART_JPEG', iconSuffix: 'file-image'}, {name: 'UiSdlScatterPlot.chartActions.EXPORT_CHART_PNG.name', actionSuffix: 'EXPORT_CHART_PNG', iconSuffix: 'file-image'}]

  /**
   * Triggered when plotted item on the chart is clicked.
   *
   * @param id
   *           Id of the component.
   * @param payload
   *           Object with any key-value data.
   */
  @uiSdlActionCreator(actionType='TRIGGER_ITEM_CLICK')
  triggerItemClick: function(id: string, payload: json): UiSdlReduxAction ts-client

  /**
  * Triggers an action.
  *
  * @param id
  *           Id of the component.
  * @param actionSuffix
  *           The suffix of the action that should be triggered.
  * @returns a `CHART_ACTION_CLICK_${actionSuffix}` action
  */
  @uiSdlActionCreator(actionType='CHART_ACTION_CLICK_${actionSuffix}')
  triggerChartActionsAction: function(id: !string,
                                      actionSuffix: !string): UiSdlReduxAction<UiSdlComponentActionPayload> ts-client
}
