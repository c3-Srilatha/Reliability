/**
 * Enum type for {@link UiSdlDataGrid} view mode.
 */
enum type UiSdlViewGridViewMode {

  /**
   * Data will be displayed in multiple pages.
   */
  PAGINATION = 'pagination'

  /**
   * Data will be loaded as user scrolls up and down.
   */
  INFINITE_SCROLL = 'infinite_scroll'

  /**
   * Show all data in one page.
   */
  ALL = 'all'
}
