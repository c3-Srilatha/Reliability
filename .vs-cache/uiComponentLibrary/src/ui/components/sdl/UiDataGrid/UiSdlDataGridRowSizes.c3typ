/**
 * Config for the size of each row in the grid.
 */
enum type UiSdlDataGridRowSizes {

  /**
   * value will change both row height and font size.
   */
  xs

  /**
   * value will change both row height and font size.
   */
  sm

  /**
   * value will change both row height and font size.
   */
  md

  /**
   * value will change both row height and font size.
   */
  lg

  /**
   * value will change both row height and font size.
   */
  xl
}
