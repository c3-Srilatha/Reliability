/**
 * Configuration type for row-specific actions in a {@link UiSdlDataGrid}.
 */
@typeScript
type UiSdlDataGridRowAction mixes UiSdlAction {

  /**
   * The name of the Redux action to be triggered.
   *
   * When this action is clicked a Redux action will be triggered with this name `ROW_ACTION_CLICK_${actionSuffix}`.
   */
  actionSuffix: ~
}
