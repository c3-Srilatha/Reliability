/**
 * A type that represents the pagination configuration of a {@link UiSdlDataGrid}.
 */
@typeScript
type UiSdlDataGridPaginationConfig {

  /**
   * Number of records to show per page.
   */
  pageSize: int enum('5', '10', '20', '30', '40') = '10'

  /**
   * The list of page size options displayed in the page size dropdown.
   */
  pageSizes: [int] = [5, 10, 20, 30, 40]

  /**
   * Specifies whether the grid will be paginated.
   */
  pagination: boolean = false
}
