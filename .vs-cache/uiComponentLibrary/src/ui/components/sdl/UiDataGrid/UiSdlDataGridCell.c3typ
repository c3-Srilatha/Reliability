/**
 * A cell to render in {@link UiSdlDataGrid}.
 * Not all UiSdlDataGridCells will be compatible with {@link UiSdlDataGridDataSpecColumnFieldSetting#sticky}
 */
@typeScript
@uiComponentCategorizer(name='Data grid cell', category='Components', hide=true)
type UiSdlDataGridCell mixes UiSdlComponent<UiSdlNoData> {

  /**
   * Read-only. The wrapped data object for the current row.
   * Property `obj` is an object containing data for the current row.
   */
  dataItem: UiSdlDataGridDataItem

  /**
   * Read-only. The elements to render as children of this element.
   */
  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]

  /**
   * Read-only. Configuration of the column to which the cell belongs.
   */
  columnProps: UiSdlDataGridDataSpecColumnFieldSetting

  /**
   * Read-only. Configuration of the grid to which the cell belongs.
   */
  gridProps: UiSdlDataGridConfig
}
