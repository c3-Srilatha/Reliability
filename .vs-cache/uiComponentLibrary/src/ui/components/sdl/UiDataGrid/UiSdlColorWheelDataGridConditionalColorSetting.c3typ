/**
 * Type containing configurations for a color threshold for a color wheel custom grid cell.
 */
type UiSdlColorWheelDataGridConditionalColorSetting {

  /**
   * The color of the wheel when the value is within this range.
   */
  color: string serialized Color

  /**
   * A string to be displayed when the value is within this range.
   * If no string is specified, the value will be displayed.
   */
  label: string

  /**
   * The minimum value (inclusive) required to display this color.
   */
  min: double

  /**
   * The maximum value (exclusive) that must not be met or exceeded to display this color.
   */
  max: double
}
