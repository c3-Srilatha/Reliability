/**
 * Configuration type for the grid section of the {@link UiSdlDataGridConfig#treeView}.
 */
@typeScript
type UiSdlTreeViewConfig {

  /**
   * Field path to look for parent-children relationships. Data from this field should contain the parent id of each
   * node, and is required to show the grid in a tree/hierarchy view.
   */
  parentField: !string
}
