/**
 * Type containing configurations for the font of the value displayed in a
 * custom color wheel grid cell.
 */
type UiSdlColorWheelDataGridFontSetting {

  /**
   * The font family.
   */
  family: string

  /**
   * The font size.
   *
   *   xxs -  8px
   *   xs  - 10px
   *   sm  - 11px
   *   md  - 12px
   *   lg  - 13px
   *   xl  - 14px
   *   xxl - 18px (classic) 16px (dense)
   */
  size: string enum('xxs', 'xs', 'sm', 'md', 'lg', 'xl', 'xxl') = 'md'
}
