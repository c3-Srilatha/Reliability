/**
 * Payload for a {@link UiSdlSortColumnChangeAction}.
 */
type UiSdlSortColumnChangePayload mixes UiSdlComponentActionPayload {

  /**
   * The field to sort on.
   */
  field: string

  /**
   * True to sort in descending order, false to sort in descending order.
   */
  descending: boolean
}
