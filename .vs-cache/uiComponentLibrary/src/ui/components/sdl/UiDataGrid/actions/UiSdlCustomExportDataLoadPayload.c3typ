/**
 * Payload for a {@link UiSdlExportDataLoadAction}.
 */
type UiSdlCustomExportDataLoadPayload mixes UiSdlComponentActionPayload {

  /**
   * Function for the data request.
   */
  c3function: string

  /**
   * The type from the data request.
   */
  c3type: string

  /**
   * The arguments for the data request.
   */
  c3args: json
}
