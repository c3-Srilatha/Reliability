/**
 * Type containing configurations for a value-based color wheel
 * in a {@link UiSdlDataGrid} cell.
 */
@typeScript
@uiComponentCategorizer(name='Color wheel data grid', category='Components', hide=true)
type UiSdlColorWheelDataGrid mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The minimum value (which results in an empty wheel) for the color wheel.
   */
  minValue: double

  /**
   * The maximum value (which results in a full wheel) for the color wheel.
   */
  maxValue: double

  /**
   * The configs for how to display the numerical value in the grid.
   * By default the numbers will display without formatting.
   */
  valueFormatSpec: UiSdlNumberParamKindFormatSpec

  /**
   * The configurations for each value threshold. The first min value and the
   * last max value should be equivalent to `minValue` and `maxValue`, respectively.
   */
  colorThresholds: [UiSdlColorWheelDataGridConditionalColorSetting]

  /**
   * The font configurations for the value in the center of the color wheel.
   */
  fontConfigs: UiSdlColorWheelDataGridFontSetting

  /**
   * The size of the color wheel in the grid cell.
   * Diameters of the wheel based on size are as follows:
   *
   *   sm - 24px (classic) 18px (dense)
   *   md - 34px (classic) 24px (dense)
   *   lg - 44px (classic) 30px (dense)
   */
  wheelSize: string enum('sm', 'md', 'lg') = 'lg'

  /**
   * Specifies the position of a value relative to the color wheel: either inside the color wheel or to its right.
   * @default 'inside'
   */
  valuePosition: string enum('inside', 'right') = 'inside'

  /**
   * Read-only. The default set of colors to be used for thresholds in the event that none are specified.
   */
  defaultColors: [string serialized Color] = ['#01b696', '#fda249', '#f44c48']
}
