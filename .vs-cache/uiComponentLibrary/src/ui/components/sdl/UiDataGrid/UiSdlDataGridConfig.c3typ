/**
 * Configuration type for the grid section of the {@link UiSdlDataGrid} component.
 */
@typeScript
type UiSdlDataGridConfig {

  /**
   * The id of the grid.
   */
  id: string

  /**
   * The view mode of the grid.
   */
  viewMode: string = 'pagination'

  /**
   * Config to show grid as a treeView.
   */
  treeView: UiSdlTreeViewConfig

  /**
   * When a component is provided, it is shown as detail when a row is expanded.
   */
  detailComponent: UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>

  /**
   * When true, a new row can be added in the grid.
   */
  canAddRow: boolean

  /**
   * Show checkboxes in the first column if true.
   */
  checkBoxes: boolean = false

  /**
   * Defines the number of data items show on each page that is used by the Grid pager.
   * It is applicable when the {@link viewMode} is {@link UiSdlViewGridViewMode#INFINITE_SCROLL} or {@link UiSdlViewGridViewMode#PAGINATION}.
   */
  pageSize: int = 15

  /**
   * The set of row-specific actions to be rendered in each row.
   */
  rowActions: [UiSdlDataGridRowAction]

  /**
   * When true, rows can be deleted from the grid.
   * If grid has checkboxes, the `Delete` button appears in the filter bar.
   * If grid does not have checkboxes, `Delete` icon appears on hovering over a row.
   */
  canDeleteRow: boolean

  /**
   * Configures the pager of the Grid.
   * It is only applicable when the {@link viewMode} is {@link UiSdlViewGridViewMode#PAGINATION}
   */
  paginationConfig: UiSdlDataGridPaginationConfig = {}

  /**
   * Configures the style and density of the rows in the Grid.
   */
  rowConfig: UiSdlDataGridRowConfig = {}
}
