/**
 * The specification of data retrieval for instances of the {@link UiSdlDataGrid} component type.
 */
@typeScript
type UiSdlDataGridDataSpec mixes UiSdlBaseDataGridDataSpec {

  columnFields:       [UiSdlDataGridDataSpecColumnFieldSetting]
  dataSpecDependence: ~ = [{configField: 'paginationConfig.pageSize', argumentSpecField: 'limit'}, {configField: 'paginationConfig.pagination', argumentSpecField: 'limit', transformFunction: 'getPageSize', configDependence: true}, {configField: 'paginationConfig.pageSize', argumentSpecField: 'offset', overrideValue: '0'}]

  /**
   * Mapping between fields that depend on each other. See {@link UiSdlFieldsDependenceMapping}.
   */
  fieldsDependenceMapping: [UiSdlFieldsDependenceMapping] = [{updatedField: 'paginationConfig.pageSize', relatedField: 'paginationDataSkipSize', value: '0'}]

  /**
   * Helper method to fetch the limit on the number of records to fetch.  If the grid is
   * set for infinite scroll, then the limit is by default -1.
   *
   * @param config
   *        The metadata based configuration of the component.
   *
   * @return
   *        The number of records to fetch.
   */
  getLimit: function(config: json): int ts-client

  /**
   * Helper function to get the pageSize according to pagination.
   */
  getPageSize: function(pagination: boolean, config: json): int ts-client

  toPartiallyAppliedActions: ~ ts-client
}
