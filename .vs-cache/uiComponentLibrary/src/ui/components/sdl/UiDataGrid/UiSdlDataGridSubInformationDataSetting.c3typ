/**
 * A type that represents the sub information configuration of a {@link UiSdlDataGridDataSpecColumnFieldSetting}.
 */
@typeScript
type UiSdlDataGridSubInformationDataSetting mixes UiSdlComponentDataSpecSetting, UiSdlDynamicOptionsGeneratable {

  /**
   * The name of the field to which these settings apply.
   */
  fieldName: string

  /**
   * The formatting to apply to the subtext.
   * See {@link UiSdlDynamicValueSpecParamFormat} for config/options.
   */
  format: UiSdlDynamicValueSpecParamFormat

  dataRecordMapping:         ~ = {fieldName: 'id', label: 'name'}
  getDynamicOptionsForField: ~
}
