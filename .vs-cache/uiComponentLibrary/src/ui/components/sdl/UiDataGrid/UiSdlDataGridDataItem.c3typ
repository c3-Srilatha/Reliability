/**
 * The wrapped data object for the current row.
 */
@typeScript
type UiSdlDataGridDataItem {

  /**
   * A map of field names to edit error messages.
   */
  error: map<string, string>

  /**
   * When rendering hierarchical data, whether the current row is expanded to show its child rows.
   */
  expanded: boolean

  /**
   * The column that is currently in edit mode, or `true` if all columns are in edit mode.
   */
  inEdit: string | boolean

  /**
   * Applicable only when representing hierarchical data, this contains metadata about the current row's relationship to
   * other nodes in the hierarchy.
   */
  node: HierarchyNode

  /**
   * An object containing data for the current row.
   */
  obj: map<string, any>
}
