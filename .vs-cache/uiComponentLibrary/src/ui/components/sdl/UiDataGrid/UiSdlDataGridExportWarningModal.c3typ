/**
 * A UI component type that represents a warning modal that will appear when the user attempts to export a grid
 * with more than {@link UiSdlDataGrid#exportWarningRecordThreshold} rows.
 */
@typeScript
@uiComponentCategorizer(name='Data grid export warning modal', category='Components', hide=true)
type UiSdlDataGridExportWarningModal mixes UiSdlModal {

  /**
   * Component id of the {@link UiSdlDataGrid} which spawned the event modal.
   */
  uiDataGridComponentId: string

  /**
   * Triggered to set the parent {@link UiSdlDataGrid} that is emitting the event.
   * @param id
   *           Id of the component.
   * @param uiDataGridComponentId
   *           The component id of the UiSdlDataGrid instance
   * @return {@link UiSdlUiDataGridComponentIdSetAction}.
   */
  @uiSdlActionCreator(actionType='UI_DATA_GRID_COMPONENT_ID_SET')
  setUiSdlDataGridComponentIdAction: function(id: string,
                                              uiDataGridComponentId: string): UiSdlUiDataGridComponentIdSetAction ts-client

  /**
   * Listens for actions of type `UI_DATA_GRID_COMPONENT_ID_SET` and updates the redux store with the UiSdlFileUpload component id.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='UI_DATA_GRID_COMPONENT_ID_SET')
  uiDataGridComponentIdSetEffect: private function(state: !UiSdlReduxState,
                                                   action: UiSdlUiDataGridComponentIdSetAction): !UiSdlReduxState ts-client
}
