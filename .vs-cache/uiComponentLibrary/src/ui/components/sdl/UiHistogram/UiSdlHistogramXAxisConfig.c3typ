/**
 * Type to represent the X-axis config for a {@link UiSdlLineBarChart}.
 */
@typeScript
type UiSdlHistogramXAxisConfig mixes UiSdlHistogramAxisConfig {

  nameGap:          ~ = 35
  decimalPrecision: ~ = 2

  /**
   * Number of bins.
   */
  numBins: int = 10

  /**
   * Whether to format bin labels as percentage.
   */
  percentage: boolean = false

  /**
   * Whether to only render the min and max value xAxis labels.
   */
  onlyRenderMinMaxAxisLabel: boolean = false
}
