/**
 * Payload for a {@link UiSdlHistogramClickAction}.
 */
type UiSdlHistogramClickPayload {

  /**
   * An array with x and y values.
   */
  data: [any]

  /**
   * The index in the series of the point clicked.
   */
  dataIndex: int

  /**
   * The point label (what appears on the x axis).
   */
  name: string

  /**
   * The index of the series that was clicked (among all series on the chart).
   */
  seriesIndex: int

  /**
   * The series label.
   */
  seriesName: string

  /**
   * The type of event, e.g. "click", "hover" etc.
   */
  @ser(name='type')
  eventType: string

  /**
   * An array of x and y values.
   */
  value: [any]
}
