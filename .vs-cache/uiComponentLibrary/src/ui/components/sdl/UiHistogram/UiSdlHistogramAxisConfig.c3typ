/**
 * Type to represent a {@link UiSdlHistogram} axis configuration.
 */
@typeScript
type UiSdlHistogramAxisConfig mixes UiSdlChartNumericalAxisConfig {

  /**
   * The title to be displayed for the axis.
   */
  title: string | UiSdlDynamicValueSpec

  /**
   * Whether to hide the axis labels.
   */
  hideLabels: boolean = false
}
