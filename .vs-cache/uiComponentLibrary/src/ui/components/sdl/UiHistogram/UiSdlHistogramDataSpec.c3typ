/**
 * Type to represent the data spec for a {@link UiSdlHistogram}.
 */
@typeScript
type UiSdlHistogramDataSpec mixes UiSdlFieldBasedDataSpec {

  /**
   * Converts the data spec to an array of partially applied actions.
   */
  toPartiallyAppliedActions: ~ ts-client

  /**
   * Filter to be used in the evaluate call.
   */
  filter: string

  /**
   * The yAxis field for histogram to project.
   */
  @constraint(condition='count(yAxisFields)<=2')
  yAxisFields: [UiSdlHistogramYAxisDataSpecSetting]

  /**
   * The transform functions to use for this data spec.
   * Functions that are available are {@link UiSdlTransformEvaluateResultToHistogramChartData}
   * and {@link UiSdlTransformUiSdlChartDataToEChartConfig}.
   */
  dataTransforms: ~ = ['UiSdlTransformEvaluateResultToHistogramChartData', 'UiSdlTransformUiSdlChartDataToEChartConfig']

  /**
   * Helper function to build projection string.
   *
   * @return A string used for projection in the fetch spec.
   */
  buildProjectionString: private member function(dataSpec: json): string ts-client

  /**
   * Helper function to build a filter string for this data spec.
   *
   * @param dataSpec
   *           This data spec.
   * @param additionalFilter
   *           An optional filter string to append to any filters generated
   *           from this data spec's configuration.
   *
   * @return A string used for filter in the fetch spec.
   */
  buildFilterString: private function(dataSpec: UiSdlHistogramDataSpec, additionalFilter: string): string ts-client
}
