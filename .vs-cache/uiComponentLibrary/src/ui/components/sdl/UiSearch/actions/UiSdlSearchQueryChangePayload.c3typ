/**
 * Payload for a {@link UiSdlSearchQueryChangeAction}.
 */
type UiSdlSearchQueryChangePayload mixes UiSdlComponentActionPayload {

  /**
   * Data Source Id associated with this component.
   */
  searchDataSourceId: string

  /**
   * Whether the search should be case sensitive or not.
   */
  caseSensitive: boolean

  /**
   * The data source reference that will be filtered with the new query.
   */
  dataSource: string

  /**
   * The value field for each result.
   */
  field: string

  /**
   * Comparator to use in the filter.
   */
  filterComparator: string

  /**
   * `true` if filter should be generated.
   */
  generateFilter: boolean

  /**
   * The query string that the data source will be filtered on.
   */
  queryString: string

  /**
   * If the data source is a fetch call, the fields that the filter will search on.
   */
  searchFields: [string]
}
