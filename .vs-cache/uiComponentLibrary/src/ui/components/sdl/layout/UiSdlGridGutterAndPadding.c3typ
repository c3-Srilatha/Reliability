/**
 * The padding and gutter values available for {@link UiSdlGridLayout}, 
 * {@link UiSdlGridContainer} and {@link UiSdlComponentContainer}.
 */

enum type UiSdlGridGutterAndPadding {
   GP0 = 0
   GP2 = 2
   GP4 = 4
   GP8 = 8
   GP12 = 12
   GP16 = 16
   GP24 = 24
   GP32 = 32
   GP40 = 40
   GP80 = 80
}
