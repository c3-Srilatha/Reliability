 * Refer to {@link UiSdlLayoutNavigation} for more details.
 */
@deprecated(finalVersion='8.11', details="Use UiSdlGridLayout instead.")
@typeScript
@uiComponentCategorizer(name='Content layout', category='Components', hide=true)
type UiSdlContentLayout mixes UiSdlLayoutBase
