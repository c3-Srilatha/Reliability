/**
 * A UI component type that represents a layout container.
 */
@typeScript
@uiComponentCategorizer(name='Layout container', category='Components')
type UiSdlLayoutContainer mixes UiSdlComponent<UiSdlNoData>, UiSdlComponentSubtitle {

  /**
   * The title for layout container, a {@link UiSdlLayoutContainerTitle} instance.
   */
  title: UiSdlLayoutContainerTitle

  /**
   * Whether to wrap the children components in a card layout. When
   * {@link title} is defined, this is forced to `true`.
   */
  wrapped: boolean

  /**
   * An nested array of {@link UiSdlVariableWidthComponentRef} to be rendered in the main content.
   */
  children: [[UiSdlVariableWidthComponentRef]]

  /**
   * Triggers an action that applies to the whole component.
   *
   * @param id
   *            Id of the component.
   * @param actionSuffix
   *           The suffix of the action that should be triggered.
   * @param args
   *           The extra arguments that should be sent through the action.
   * @returns a `LAYOUT_CONTAINER_ACTION_CLICK_${actionSuffix}` action
   *   - payload {object} The arguments defined for the layout container action and component id.
   */
  @uiSdlActionCreator(actionType='LAYOUT_CONTAINER_ACTION_CLICK_${actionSuffix}')
  triggerLayoutContainerAction: function(id: string,
                                         actionSuffix: string,
                                         args: json): UiSdlLayoutContainerTriggerAction ts-client
}
