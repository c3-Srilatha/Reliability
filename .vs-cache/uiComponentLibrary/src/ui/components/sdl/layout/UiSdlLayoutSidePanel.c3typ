/**
 * A page content layout with a left and a right side panel.
 */
@deprecated(finalVersion='8.11', details="Use UiSdlGridLayout instead.")
@typeScript
@uiComponentCategorizer(name='Side panel layout', category='Components')
type UiSdlLayoutSidePanel mixes UiSdlContentLayout {

  /**
   * The component to be rendered in the left side bar.
   */
  @uiSdlComponentAcceptedKinds(includeCategories=['filter-component'])
  leftSidePanel: UiSdlComponentRef<UiSdlFilterPanel>

  /**
   * The component to be rendered in the right side bar.
   */
  @uiSdlComponentAcceptedKinds(includeCategories=['filter-component'])
  rightSidePanel: UiSdlComponentRef<UiSdlFilterPanel>

  /**
   * The components to be rendered in the main content.
   */
  @uiSdlComponentAcceptedKinds(includeCategories=['data-visual-component', 'container-component'])
  children: ~
}
