/**
 * Page layout with navigation menu
 *
 *     +----+ -----------+
 *     |    | |          |
 *     |    | |          |
 *     |    | |          |
 *     | 1  | |     2    |
 *     |    | |          |
 *     |    | |          |
 *     |    | |          |
 *     +----+ -----------+
 *
 * 1) #nav-menu
 * 2) #content
 */
@deprecated(finalVersion='8.11', details="Use UiSdlGridLayout instead.")
@uiComponentCategorizer(name='Nav menu layout', category='Components', hide=true)
type UiSdlLayoutNavMenu mixes UiSdlLayoutBase {

  /**
   * The component to be rendered in `#nav-menu`.
   */
  navMenu: UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>

  /**
   * The components to be rendered in `#content`.
   */
  children: ~
}
