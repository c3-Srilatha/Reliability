/**
 * Page layout with navigation menu and page title
 * The entirety of parts 1 and 3 consists of 12 columns.
 *     +----+ -----------+
 *     |    |      1     |
 *     |    |------------+
 *     |    |            |
 *     |    |            |
 *     |    |            |
 *     | 2  |      3     |
 *     |    |            |
 *     |    |            |
 *     |    |            |
 *     +----+ -----------+
 * 1) #header
 * 2) #nav-menu
 * 3) #content
 */
@uiComponentCategorizer(name='Grid layout', category='Components')
type UiSdlGridLayout mixes UiSdlComponent<UiSdlNoData>  {

  /**
   * The header for the page. Includes things like tabs, title, etc.
   *
   * NOTE: If {@link UiSdlTabPanel} is used, it should be used in {@link #header}, and {@link #children} should remain empty
   */
  header: UiSdlGridLayoutHeader = {}

  /**
   * The style for the grid aspect of the layout.
   * FIXED layout will take up a minimum of a fixed amount of space centered
   * in the middle of the content area. Amount based on fixedSize.
   * FLUID layout will fill content area.
   */
  gridStyle: string enum("FIXED", "FLUID") = "FIXED"

  /**
   * The size to be used as the minimum width for the FIXED gridStyle.
   * MEDIUM: 1024px, LARGE: 1440px, XLARGE: 1920px
   */
  fixedSize: string enum("MEDIUM", "LARGE", "XLARGE") = "XLARGE"

  /**
   * The children components to be displayed in the content area of the layout.
   * Must be UiSdlGridContainer, so they adhere to the grid system.
   *
   * NOTE: If {@link UiSdlTabPanel} is used, it should be used in {@link #header}, and {@link #children} should remain empty.
   */
  children: [UiSdlGridContainer | string serialized UiSdlComponentContainer | UiSdlComponentContainer | UiSdlConditionalComponentContainer | UiSdlSwitchComponentContainer]

  /**
   * The direction children components should be displayed in.
   */
  display: string enum("VERTICAL", "HORIZONTAL") = "VERTICAL"

  /**
   * Whether or not there should be spacing between children components.
   */
  gutter: int enum UiSdlGridGutterAndPadding = GP8

  /**
   * Whether or not we should include padding around the sides of the content area.
   * {@link #header} is not affected by this padding.
   */
  pagePadding: int enum UiSdlGridGutterAndPadding = GP16

  /**
   * This field is meant to place components that will be placed "outside" of the grid system
   * i.e. {@link UiSdlModal} {@link UiSdlMultiStepModal} {@link UiSdlSidePanel} and {@link UiSdlMessageContainer}
   */
  detachedFields: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]

  /**
   * The component to be rendered in `#nav-menu`.
   */
  navMenu: UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>

  /**
   * Indicates whether or not to highlight the grid layout borders.
   */
  highlightBorders: boolean = false

  /**
   * Action for toggling the grid highlight borders flag.
   *
   * @param id
   *            Id of the component.
   * @returns A `TOGGLE_GRID_LAYOUT_HIGHLIGHT` action for this instance.
   */
  @uiSdlActionCreator(actionType='TOGGLE_GRID_LAYOUT_HIGHLIGHT')
  toggleGridLayoutHighlightAction: private function(id: !string): !UiSdlGridLayoutToggleHighlightAction ts-client

  /**
   * Listens for actions of type `TOGGLE_GRID_LAYOUT_HIGHLIGHT` and toggles the value {@link #highlightBorders} state.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *~
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='TOGGLE_GRID_LAYOUT_HIGHLIGHT')
  toggleGridLayoutHighlightReducer: private function(state: !UiSdlReduxState,
                                      action: !UiSdlGridLayoutToggleHighlightAction): !UiSdlReduxState ts-client
}
