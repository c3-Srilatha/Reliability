/**
 * The overflow values available for {@link UiSdlGridContainer}
 */

enum type UiSdlOverflow {
   VISIBLE="visible"
   HIDDEN="hidden"
   CLIP="clip"
   SCROLL="scroll"
   AUTO="auto"
   UNSET="unset"
}
