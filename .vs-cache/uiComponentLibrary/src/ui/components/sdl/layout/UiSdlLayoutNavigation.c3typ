/**
 * A page layout for a page that has both page content and a navigation menu.
 * This layout does not extend {@link UiSdlLayoutBase} because `children` is replaced by multiple specific {@link UiSdlComponentRef}.
 * For layout usage in most cases, refer to {@link UiSdlLayoutNavMenu}. This layout is created for UI Designer purposes.
 */
@deprecated(finalVersion='8.11', details="Use UiSdlGridLayout instead.")
@typeScript
@uiComponentCategorizer(name='Navigation layout', category='Components', hide=true)
type UiSdlLayoutNavigation mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The component that handles navigation.
   */
  navigation: UiSdlComponentRef<UiSdlNavMenu>

  /**
   * The component that handles content layout.
   */
  content: UiSdlComponentRef<UiSdlContentLayout>

  /**
   * The component that handles the page title.
   */
  pageTitle: UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>

  /**
   * The component that handles the page breadcrumbs.
   */
  pageBreadcrumbs: UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>
}
