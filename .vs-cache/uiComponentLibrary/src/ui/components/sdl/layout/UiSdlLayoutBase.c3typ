/**
 * A base type for any page layout.
 */
@typeScript
type UiSdlLayoutBase mixes UiSdlComponent<any> {

  /**
   * The components to be rendered in the layout.
   */
  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]

  /**
   * Whether the drag and drop context is enabled for this layout.
   * Similar to {@link UiSdlDragDropContext}.
   */
  dragAndDropEnabled: boolean = false
}
