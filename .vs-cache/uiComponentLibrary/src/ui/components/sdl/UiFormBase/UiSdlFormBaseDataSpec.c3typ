/**
 * The data specification for a form type.  This represents the data used to populate the information for the form.
 */
@typeScript
type UiSdlFormBaseDataSpec mixes UiSdlFieldBasedDataSpec {

  /**
   * Converts the data spec to an array of partially applied actions.
   */
  toPartiallyAppliedActions: ~ ts-client

  /**
   * The arguments that needs to pass to the action.
   */
  @deprecated(details='Use {@link actionArgs}')
  args: json

  /**
   * The arguments that needs to pass to the action.
   */
  actionArgs: json

  /**
   * The action used to retrieve data.
   */
  actionName: string = 'fetch'

  /**
   * The fieldSets on this form.
   */
  fieldSets: [UiSdlFormBaseFieldSet] | [[UiSdlFormBaseFieldSet]]

  /**
   * Helper function to recursively create partiallyAppliedActionInfos for each applicable {@link UiSdlFieldSetFormFieldSetting}.
   */
  handleFieldSettingCollection: function(fieldSettingCollection: json,
                                         pathSoFar: [string],
                                         partiallyAppliedActionInfos: [json]) ts-client
}
