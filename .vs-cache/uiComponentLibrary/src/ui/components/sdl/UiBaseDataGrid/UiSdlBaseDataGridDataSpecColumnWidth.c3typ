/**
 * Specify the width and unit for a column.
 */
@typeScript
type UiSdlBaseDataGridDataSpecColumnWidth {

  /**
   * The width value of the column.
   */
  value: int

  /**
   * The width unit, may be px or %.
   * Note!  Percentage width is not currently supported by KendoGrid. When support is added,
   * we can add `%` to this enum.
   */
  unit: string enum('px') = 'px'
}
