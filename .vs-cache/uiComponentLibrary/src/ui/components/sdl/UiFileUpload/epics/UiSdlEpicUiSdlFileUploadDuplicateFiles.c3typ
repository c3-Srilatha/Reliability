/**
 * Custom epic for duplicating files by appending `(versionNumber)` as suffix.
 */
@typeScript
type UiSdlEpicUiSdlFileUploadDuplicateFiles mixes UiSdlEpic {

  epic: ~ ts-client

  /**
   * Appending `(versionNumber)` as suffix to the name or file path of a duplicate file.
   */
  getFileNameOrPathForDuplicateFile: private function(allFiles: [json],
                                                      targetFileString: string,
                                                      key: string): string ts-client
}
