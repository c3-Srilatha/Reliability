/**
 * Constructed frontend fileRef from JavaScript File object.
 */
@typeScript
type UiSdlFileUploadFileRef {

  /**
   * The name of the file.
   */
  name: string

  /**
   * The local file system path of the file, used as ID.
   */
  path: string

  /**
   * The size of the file in bytes.
   */
  size: int

  /**
   * The type of the file.
   */
  @ser(name='type')
  fileType: string enum MediaType

  /**
   * The status of the file.
   */
  status: string enum UiSdlFileUploadFileStatus
}
