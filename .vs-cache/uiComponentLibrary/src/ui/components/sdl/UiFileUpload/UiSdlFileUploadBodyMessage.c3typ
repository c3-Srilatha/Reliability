/**
 * A set of messages to show in a {@link UiSdlFileUpload} component.
 */
@typeScript
type UiSdlFileUploadBodyMessage {

  /**
   * The main text message that shows at the file upload box.
   */
  text: string serialized UiSdlDynamicValueSpec = 'UiSdlFileUploadBodyMessage.text'

  /**
   * The sub-text message that shows at the file upload box.
   */
  subText: string serialized UiSdlDynamicValueSpec
}
