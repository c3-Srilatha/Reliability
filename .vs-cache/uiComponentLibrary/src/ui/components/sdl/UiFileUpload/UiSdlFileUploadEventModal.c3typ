/**
 * A UI component type that represents a file uploader event.
 */
@typeScript
@uiComponentCategorizer(name='File upload event modal', category='Components', hide=true)
type UiSdlFileUploadEventModal mixes UiSdlModal {

  /**
   * Component id of the UiSdlFileUpload which spawned the event modal.
   */
  uiFileUploadComponentId: string

  /**
   * Button layout configuration on the modal.
   */
  modalType: UiSdlTwoButtonModal = {}

  /**
   * Trigger to set the parent UiSdlFileUpload that is emitting event.
   *
   * @param id
   *           Id of the component.
   * @param uiFileUploadComponentId
   *           The component id of the UiSdlFileUpload instance.
   *
   * @return {@link UiSdlUiFileUploadComponentIdSetAction}.
   */
  @uiSdlActionCreator(actionType='UI_FILE_UPLOAD_COMPONENT_ID_SET')
  setUiSdlFileUploadComponentIdAction: function(id: string,
                                                        uiFileUploadComponentId: string)
                                                 : UiSdlUiFileUploadComponentIdSetAction ts-client

  /**
   * Listens for actions of type `UI_FILE_UPLOAD_COMPONENT_ID_SET` and updates the redux store with the UiSdlFileUpload component id.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='UI_FILE_UPLOAD_COMPONENT_ID_SET')
  uiFileUploadComponentIdSetEffect: private function(state: !UiSdlReduxState,
                                                     action: UiSdlUiFileUploadComponentIdSetAction): !UiSdlReduxState ts-client
}
