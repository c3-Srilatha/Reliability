/**
 * A UI component type that represents a file uploader.
 */
@typeScript
@uiComponentCategorizer(name='File upload', category='Components')
type UiSdlFileUpload mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The text messages to show alongside the file upload input.
   */
  bodyMessage: UiSdlFileUploadBodyMessage

  /**
   * The boolean that specify whether the file uploader takes multiple files or not.
   */
  multiSelect: boolean = true

  /**
   * The limit of all files combined in bytes.
   */
  fileSizeLimit: int = 2100000000

  /**
   * An array of extension strings that are acceptable.
   */
  allowableFileExtensions: [string]

  /**
   * Whether or not to reject files that don't end in one of the file extensions from allowableFileExtensions.
   * Will be ignored if text/txt, video/*, text/csv, etc. format is used for file extension.
   * Only used for instances where an invalid file can be selected due to https://bugs.chromium.org/p/chromium/issues/detail?id=646941
   */
  rejectInvalidFiles: boolean = true

  /**
   * A map for file uploading status { fileName: status }.
   * Status can be {@link UiSdlFileUploadFileStatus}.
   * example: { 'image.jpg': 'QUEUED' }
   */
  fileStatus: private map<string, string>

  /**
   * The aggregate size of all files in bytes.
   * This amount only considers the current instance of the UiSdlFileUpload component.
   */
  totalFilesSize: int = 0

  /**
   * A {@link UiSdlFileUploadFileRef} data structure to store all duplicate files.
   *
   * Example:
   * ```
   * "duplicateFiles": [
   *   {
   *     "name": "helloWorld.js",
   *     "type": "text/javascript"
   *   },
   *   {
   *     "name": "hello_world.py",
   *     "type": "text/x-python-script"
   *   }
   * ]
   * ```
   */
  duplicateFiles: private [UiSdlFileUploadFileRef]

  /**
   * A {@link UiSdlFileUploadFileRef} data structure to store the valid file(s) from the most recent submission.
   * This will store an empty array `[]` or the valid file(s) from the most recent submission.
   * If a list of all valid and processed files is needed, use {@link UiSdlFileUpload#files}.
   *
   * Example:
   * ```
   * "validFiles": [
   *   {
   *     "name": "helloWorld.csv",
   *     "type": "text/csv"
   *   }
   * ]
   * ```
   */
  validFiles: private [UiSdlFileUploadFileRef]

  /**
   * A {@link UiSdlFileUploadFileRef} data structure to store all invalid files.
   * If you submit a file that is not included in the {@link UiSdlFileUpload#allowableFileExtensions},
   * it will be stored in this data structure.
   *
   * Example:
   * ```
   * "invalidExtensionFiles": [
   *   {
   *     "name": "helloWorld.csv",
   *     "type": "text/csv"
   *   },
   *   {
   *     "name": "goodbyeWorld.csv",
   *     "type": "text/csv"
   *   }
   * ]
   * ```
   */
  invalidExtensionFiles: private [UiSdlFileUploadFileRef]

  /**
   * A {@link UiSdlFileUploadFileRef} data structure to store all invalid size files.
   * If you submit a file that is larger than the {@link UiSdlFileUpload#fileSizeLimit},
   * it will be stored in this data structure.
   *
   * Example:
   * ```
   * "invalidSizeFiles": [
   *   {
   *     "name": "helloWorld.csv",
   *     "size": 4096,
   *     "type": "text/csv"
   *   },
   *   {
   *     "name": "goodbyeWorld.csv",
   *     "size": 8192,
   *     "type": "text/csv"
   *   }
   * ]
   * ```
   */
  invalidSizeFiles: private [UiSdlFileUploadFileRef]

  /**
   * A {@link UiSdlFileUploadFileRef} data structure to store all the valid and processed files.
   * Example:
   * ```
   * "files": [
   *   {
   *     "name": "helloWorld.js",
   *     "type": "text/javascript"
   *   },
   *   {
   *     "name": "hello_world.py",
   *     "type": "text/x-python-script"
   *   }
   * ]
   * ```
   */
  files: [UiSdlFileUploadFileRef]

  /**
   * Construct frontend fileRef from JavaScript File object.
   *
   * @param file
   *           The file instance that need to upload.
   *           A JavaScript `File` object https://developer.mozilla.org/en-US/docs/Web/API/File
   *
   * @returns A fileRef object.
   * {
   *    name: the name of the file,
   *    path: the local file system path of the file, used as ID,
   *    type: the type of the file,
   *    status: one of the {@link UiSdlFileUploadFileStatus} status
   *  }
   */
  constructFileRef: private function(file: json): UiSdlFileUploadFileRef

  /**
   * A reference to the modal that appears when the user leaves the UiSdlFileUpload parent component
   * when files have been selected.
   */
  cancelConfirmationModalId: string = 'SDL.UiSdlFileUploadCancelConfirmationModal'

  /**
   * A reference to the modal that appears when the user uploads files with the same name.
   */
  duplicateFilesWarningModalId: string = 'SDL.UiSdlFileUploadDuplicateFilesWarningModal'

  /**
   * Triggers an action that updates file status.
   *
   * @param id
   *            Id of the component.
   * @param fileName
   *           The absolute local file name of where the file is loaded from.
   * @param status
   *           The status that needs to update to
   *
   * @returns A 'FILE_UPDATE_UPLOAD_STATUS' action.
   *   - payload.fileName {string} The file name.
   *   - payload.status {@link UiSdlFileUploadFileStatus} The status that needs to update to.
   *   - payload.componentId {string} The id of the component on which the action was triggered.
   */
  @uiSdlActionCreator(actionType='FILE_UPDATE_UPLOAD_STATUS')
  updateFileUploadStatusAction: function(id: string,
                                                 fileName: string | [string],
                                                 status: string enum UiSdlFileUploadFileStatus)
                                          : !UiSdlFileUpdateUploadStatusAction ts-client

  /**
   * Listens for actions of type `FILE_UPDATE_UPLOAD_STATUS`, then updates corresponding file status.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='FILE_UPDATE_UPLOAD_STATUS')
  fileUpdateUploadStatusEffect: private function(state: !UiSdlReduxState,
                                                 action: UiSdlFileUpdateUploadStatusAction): !UiSdlReduxState ts-client

  /**
   * Triggers an action that updates file status.
   *
   * @param id
   *           Id of the component.
   * @param fileRefs
   *           The representation of a file constructed by #constructFileRef,
   * example: [{
   *    name: 'fileUpload.js',
   *    path: 'Users/Desktop/fileUpload.js',
   *    type: 'application/javascript',
   *    status: 'QUEUED'
   *  }]
   * @param files
   *           An array of file instance that need to be uploaded.
   *           A JavaScript `File` object https://developer.mozilla.org/en-US/docs/Web/API/File
   *
   * @returns A 'FILE_QUEUED' action.
   *   - payload.fileRefs {[json]} FileRefs that need to uploaded.
   *   - payload.files {[json]} Array of file instance that need to be uploaded.
   *   - payload.componentId {string} The id of the component on which the action was triggered.
   */
  @uiSdlActionCreator(actionType='FILE_QUEUED')
  queuedFilesAction: function(id: string, fileRefs: [json], files: [json]): !UiSdlFileQueuedAction ts-client

  /**
   * Listens for actions of type `FILE_QUEUED`, then stores fileRefs to redux.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='FILE_QUEUED')
  filesQueuedEffect: function(state: UiSdlReduxState, action: UiSdlFileQueuedAction): UiSdlReduxState ts-client

  /**
   * Triggers an action that removes a file.
   *
   * @param id
   *           Id of the component.
   * @param fileNames
   *           An array of target files' file name.
   * @returns A 'FILES_REMOVE' action.
   *   - payload.files {[object]} Files instances that need to upload.
   *   - payload.componentId {string} The id of the component on which the action was triggered.
   */
  @uiSdlActionCreator(actionType='FILES_REMOVE')
  removeFilesAction: function(id: string,
                                      fileNames: [string],
                                      status: string enum UiSdlFileUploadFileStatus): !UiSdlFilesRemoveAction ts-client

  /**
   * Listens for actions of type `FILES_REMOVE`, then removes the file refs from redux.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='FILES_REMOVE')
  filesRemoveEffect: function(state: UiSdlReduxState, action: UiSdlFilesRemoveAction): UiSdlReduxState ts-client

  /**
   * Triggers an action that remove all queued and uploading files.
   *
   * @param id
   *            Id of the component.
   *
   * @returns An 'ALL_UPLOADING_FILES_CANCEL' action.
   *   - payload.files {[object]} Files instances that need to upload.
   *   - payload.componentId {string} The id of the component on which the action was triggered.
   */
  @uiSdlActionCreator(actionType='ALL_UPLOADING_FILES_CANCEL')
  cancelAllFilesUploadAction: function(id: string): !UiSdlAllUploadingFilesCancelAction ts-client

  /**
   * Listens for actions of type `ALL_UPLOADING_FILES_CANCEL`, then removes all files ref from redux.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='ALL_UPLOADING_FILES_CANCEL')
  allFilesUploadCancelEffect: function(state: UiSdlReduxState,
                                       action: UiSdlAllUploadingFilesCancelAction): UiSdlReduxState ts-client

  /**
   * Triggers an action that validates files before queueing them.
   * Frontend validation so that no duplicate file names are allowed.
   *
   * @param id
   *           Id of the component.
   * @param files
   *           The file instances that need to upload.
   *           An array of JavaScript `File` object https://developer.mozilla.org/en-US/docs/Web/API/File
   *
   * @returns A 'FILE_VALIDATE' action.
   *   - payload.files {[object]} Files instances that need to be queued.
   *   - payload.componentId {string} The id of the component on which the action was triggered.
   */
  @uiSdlActionCreator(actionType='FILE_VALIDATE')
  validateFilesAction: function(id: string, files: [json]): !UiSdlFileValidateAction ts-client

  /**
   * Listens for actions of type `FILE_VALIDATE`, then validates files to make sure no duplicate file name.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='FILE_VALIDATE')
  filesValidateEffect: function(state: UiSdlReduxState, action: UiSdlFileValidateAction): UiSdlReduxState ts-client

  /**
   * Triggers an action of type `DUPLICATE_FILES_WARNING_MODAL_OPEN`.
   *
   * @param id
   *            Id of the component.
   *
   * @returns A 'FILE_DUPLICATE_MODAL' action.
   */
  @uiSdlActionCreator(actionType='DUPLICATE_FILES_WARNING_MODAL_OPEN')
  openDuplicateFilesWarningModalAction: function(id: string): !UiSdlDuplicateFilesWarningModalOpenAction ts-client

  /**
   * Triggers an action of type `CANCEL_CONFIRMATION_MODAL_OPEN`.
   * @param id
   *            Id of the component.
   */
  @uiSdlActionCreator(actionType='CANCEL_CONFIRMATION_MODAL_OPEN')
  openCancelConfirmationModalAction: function(id: string): !UiSdlCancelConfirmationModalOpenAction ts-client

  /**
   * Triggers `FILE_QUEUED` and `FILE_UPDATE_UPLOAD_STATUS` actions when all files are valid.
   * Triggers `DUPLICATE_FILES_WARNING_MODAL_OPEN` action when all files are invalid.
   * Triggers `FILE_QUEUED` and `DUPLICATE_FILES_WARNING_MODAL_OPEN` actions when there are both invalid and valid files.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='FILE_VALIDATE')
  filesValidateEpic: private function(actionStream: UiSdlActionsObservable,
                                      stateStream: UiSdlStatesObservable): UiSdlActionsObservable ts-client

  /**
   * Triggers `UI_FILE_UPLOAD_COMPONENT_ID_SET`, `MODAL_OPEN`, and `MODAL_CONTENT_UPDATE` actions.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='DUPLICATE_FILES_WARNING_MODAL_OPEN')
  duplicateFilesWarningModalOpenEpic: private function(actionStream: UiSdlActionsObservable,
                                                       stateStream: UiSdlStatesObservable): UiSdlActionsObservable ts-client

  /**
   * Triggers `ALL_UPLOADING_FILES_CANCEL` when there are no files for user to verify.
   * Triggers `UI_FILE_UPLOAD_COMPONENT_ID_SET` and `MODAL_OPEN` actions to ask user to confirm cancel uploading files.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='CANCEL_CONFIRMATION_MODAL_OPEN')
  cancelConfirmationModalOpenEpic: private function(actionStream: UiSdlActionsObservable,
                                                    stateStream: UiSdlStatesObservable): UiSdlActionsObservable ts-client
}
