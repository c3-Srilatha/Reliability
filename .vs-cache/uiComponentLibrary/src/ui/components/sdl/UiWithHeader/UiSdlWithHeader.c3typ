/*
 * A UI Component that shows a header for a UI Section.
 */
@typeScript
type UiSdlWithHeader {
  /**
   * The title text of the current section.
   * It accepts a string or a `UiSdlDynamicValueSpec` object.
   */
  title: string serialized UiSdlDynamicValueSpec

  /**
   * The subtitle text of the current section.
   * It accepts a string or a `UiSdlDynamicValueSpec` object.
   */
  subtitle: string serialized UiSdlDynamicValueSpec

  /**
   * The tooltip text for the info icon.
   * It accepts a string or a `UiSdlDynamicValueSpec` object.
   */
  infoTooltipText: string serialized UiSdlDynamicValueSpec

  /**
   * The size of the current section header.
   */
  size: string enum('SMALL', 'MEDIUM', 'LARGE') = 'MEDIUM'

  /**
  * The collapse threshold to put the actions in the dropdown menu.
  */
  actionButtonsCollapseThreshold: int = 2

  /**
   * The action buttons of the current header.
   */
  actionButtons: [UiSdlAction]

  /**
   * Triggers an action that applies to the whole component.
   *
   * @param id
   *            Id of the component.
   * @param actionSuffix
   *           The suffix of the action that should be triggered.
   *
   * @returns A `HEADER_ACTION_CLICK_${actionSuffix}` action with the following properties:
   * - `meta.dataSourceId` {string} The `id` of the `UiSdlWithHeader`.
   */
  @uiSdlActionCreator(actionType='HEADER_ACTION_CLICK_${actionSuffix}')
  triggerHeaderAction: function(id: string, actionSuffix: string): UiSdlHeaderActionClickAction ts-client

}
