/*
 * A UI Component that shows a header for a UI Section.
 */
@typeScript
@uiComponentCategorizer(name='Section header', category='Components')
type UiSdlSectionHeader mixes UiSdlComponent, UiSdlWithHeader {
  /**
   * The category text (top uppercase text) of the current section.
   * It accepts a string or a `UiSdlDynamicValueSpec` object.
   */
  category: string serialized UiSdlDynamicValueSpec

}
