/**
 * Used to render different component based on switch condition at runtime.
 *
 * IMPORTANT: This is not an authorization feature. If you need to limit access to APIs,
 * please use {@link Permission} and `AdminGroup`.
 */
@typeScript
@uiComponentCategorizer(name='Switch renderer', category='Components', hide=true)
type UiSdlSwitchRenderer mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The switch condition that will decide which component to render.
   *
   * While the condition type is being imported, a spinner will be temporarily shown,
   * this behavior cannot be changed but due to optimizations you may not see the spinner
   * in some cases.
   *
   * For possible condition types see mixins of {@link UiSdlRenderSwitchCondition}.
   */
  condition: UiSdlRenderSwitchCondition

  /**
   * The mapping of the value resulting from evaluation of the switch condition, to the component to render for that condition.
   */
  componentsToRender: map<any, UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>>

  /**
   * The component to render when the value from the {@link UiSdlRenderSwitchCondition}
   * is not present as a key in {@link #componentsToRender}
   */
  fallbackComponent: UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>
}
