/**
 * A UI component type that represents a {@link UiSdlComponentRef} that has an alignment variable.
 */
@typeScript
type UiSdlAlignedComponentRef<C> mixes UiSdlComponentRef<C> {

  /**
   * The alignment of the component.
   */
  alignment: string enum UiSdlHorizontalAlignment = LEFT
}
