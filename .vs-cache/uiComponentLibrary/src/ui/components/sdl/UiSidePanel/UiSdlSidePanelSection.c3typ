/**
 * Sections in {@link UiSdlSidePanel}.
 */
@typeScript
@uiComponentCategorizer(name='Side panel section', category='Components', hide=true)
type UiSdlSidePanelSection mixes UiSdlComponent<UiSdlNoData>, UiSdlComponentTitle {

  /**
   * The title string of the section.
   */
  @constraint(required=false)
  title: ~

  open: boolean
  /**
   * The Font Awesome icon(s) to display when the parent {@link UiSdlSidePanel} is closed.
   */
  closedIcons: [string]

  /**
   * The children to render in this section.
   */
  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]
}
