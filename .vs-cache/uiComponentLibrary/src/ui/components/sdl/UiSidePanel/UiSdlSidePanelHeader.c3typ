/**
 * The header component for a {@link UiSdlSidePanel}.
 */
@typeScript
type UiSdlSidePanelHeader mixes UiSdlComponentTitle {

  /**
   * The subtitle underneath the title.
   */
  subtitle: string | UiSdlDynamicValueSpec | UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>

  /**
   * The action button element to the right of title.
   */
  actionButton: UiSdlActionGroup

  /**
   * The optional Font Awesome icon to display next to the title.
   */
  titleIcon: string

  /**
   * The icon users click to close the {@link UiSdlSidePanel}.
   */
  closeIcon: string

  /**
   * The icon users click to open the {@link UiSdlSidePanel}. Only applicable when {@link UiSdlSidePanel#closeBehavior} is
   * 'COLLAPSE'.
   */
  openIcon: string
}
