/**
 * The container for a {@link UiSdlSidePanel}.
 */
@typeScript
@uiComponentCategorizer(name='Side panel container', category='Components', hide=true)
type UiSdlSidePanelContainer mixes UiSdlComponent<UiSdlNoData> {

  /**
   * An instance of {@link UiSdlSidePanel}.
   */
  sidePanel: UiSdlAlignedComponentRef<UiSdlSidePanel>

  /**
   * An instance of {@link UiSdlComponent}.
   */
  child: UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>
}
