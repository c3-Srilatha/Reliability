/**
 * Enum type for behavior of {@link UiSdlSidePanel} when it is closed.
 */
enum type UiSdlSidePanelCloseBehavior {

  /**
   * The {@link UiSdlSidePanel} will be removed visually from the DOM.
   */
  HIDE

  /**
   * The {@link UiSdlSidePanel} will be collapsed and rendered in a collapsed state.
   */
  COLLAPSE
}
