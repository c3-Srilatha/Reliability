/**
 * Enum type for position of {@link UiSdlSidePanel}.
 */
enum type UiSdlSidePanelPosition {

  /**
   * The {@link UiSdlSidePanel} will be rendered on the {@link UiSdlSidePanel#alignment} side and "push" the content of
   * the {@link UiSdlSidePanel#parentSelector}.
   */
  PUSH

  /**
   * The {@link UiSdlSidePanel} will be rendered on the {@link UiSdlSidePanel#alignment} side and "overlay" on top of
   * the content of the {@link UiSdlSidePanel#parentSelector}.
   */
  OVERLAY
}
