/**
 * Used in {@link UiSdlBreadcrumbsDataSpec#breadcrumbsDataMapping} to configure the mapping of page params to entity types.
 */
type UiSdlBreadcrumbsDataSource {

  /**
   * Static text for the bread crumb.
   */
  staticText: string

  /**
   * Page param represents the record id in this type.
   */
  dataType: Type

  /**
   * Value of this field is used as the breadcrumb text.
   */
  fieldName: string
}
