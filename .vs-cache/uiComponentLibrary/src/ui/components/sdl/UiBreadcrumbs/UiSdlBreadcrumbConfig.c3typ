/**
 * Configuration type for a breadcrumb.
 */
@typeScript
type UiSdlBreadcrumbConfig {

  /**
   * The text to display for the breadcrumb.
   */
  text: !string

  /**
   * The link to use for the breadcrumb.
   */
  link: !string

  /**
   * Data associated with the breadcrumb.
   */
  data: any

  /**
   * The route of for this breadcrumb. Dynamic variables should be wrapped in `{`.  Such as `{{id}}`.
   */
  route: !string

  /**
   * The params for the route. Dynamic variables in the route should have a corresponding value in params.
   * Example:
   * ```
   *  route: "/users/{{id}}""
   *  params: {"id:"" 1}
   * ```
   */
  params: map<string, string>
}
