/**
 * The specification of data retrieval for instances of the {@link UiSdlBreadcrumbs} component type.
 */
@typeScript
type UiSdlBreadcrumbsDataSpec mixes UiSdlFieldBasedDataSpec {

  /**
   * Used to show another field in the breadcrumb text.
   * The key is the page params id. The value describes how to get the display value for the breadcrumb.
   * e.g.
   * {
   *   id: {
   *      dataType: {
   *        typeName: 'FixedAsset'
   *      },
   *      fieldName: 'name'
   *   }
   * }
   * The above value will display the FixedAsset.name field as the breadcrumb text.
   */
  breadcrumbsDataMapping: map<string, UiSdlBreadcrumbsDataSource>

  toPartiallyAppliedActions: ~ ts-client
}
