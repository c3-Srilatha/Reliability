/**
 * Configuration for {@link UiSdlBreadcrumbs}.
 */
@typeScript
type UiSdlBreadcrumbsConfig {

  /**
   * url with page params populated.
   */
  link: string

  /**
   * Display text in the breadcrumb.
   */
  text: string

  /**
   * Page parameters.
   */
  params: map<string, string>

  /**
   * urlPath in {@link UiSdlRoute}.
   */
  route: string

  /**
   * e.g. id for urlPath /sdl-demo/detail/{{id}}.
   */
  pageParamsIdentifier: string
}
