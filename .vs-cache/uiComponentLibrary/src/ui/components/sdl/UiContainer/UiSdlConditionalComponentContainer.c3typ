/**
 * A conditional container that can actually render a {@link UiSdlComponentRef} inside
 * of the {@link UiSdlGridLayout}.
 * Use this component to render one of two components based on a condition at runtime.
 */
type UiSdlConditionalComponentContainer mixes UiSdlConditionalRenderConfig<UiSdlComponentContainer>, UiSdlComponent<UiSdlNoData> {

}
