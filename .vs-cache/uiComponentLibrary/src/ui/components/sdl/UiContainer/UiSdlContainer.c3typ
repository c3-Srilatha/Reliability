/**
 * A UI component type that holds other components.
 */
@uiSdlDesignerComponent(designable=true,
                        category='UiSdlContainer.CategoryName',
                        name='UiSdlContainer.ComponentName',
                        icon='rectangle-landscape')
@typeScript
@uiComponentCategorizer(name='Container', category='Components')
type UiSdlContainer mixes UiSdlComponent<UiSdlNoData>, UiSdlComponentSubtitle {

  dataSpec: ~

  /**
   * Title of container.
   */
  title: string

  /**
   * How to arrange children.
   */
  orientation: string enum('HORIZONTAL', 'VERTICAL') = 'VERTICAL'

  /**
   * Description going into popup.
   */
  hoverDescription: string

  /**
   * A data record.
   * If provided, the record will be passed to all the {@link children},
   * and {@link children} can use it in the data spec.
   */
  dataItem: json

  /**
   * Components that will be in container.
   */
  @uiSdlComponentAcceptedKinds(includeCategories=['data-visual-component'], includeAttributes=['nestable'])
  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]
}
