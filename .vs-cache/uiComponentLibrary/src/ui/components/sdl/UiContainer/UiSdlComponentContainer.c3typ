/**
 * A container that can actually render a {@link UiSdlComponentRef} inside
 * of the {@link UiSdlGridLayout}.
 *
 * "> 3 SDLDemo.TableTypesBasic" => padded, 3 column, child
 * " 3 SDLDemo.TableTypesBasic" => no padding, 3 column, child
 * "SDLDemo.TableTypesBasic" => no padding, 12 column, child
 */
@uiComponentCategorizer(name='Component container', category='Components')
type UiSdlComponentContainer mixes UiSdlComponent<UiSdlNoData>, StringSerializable {

  /**
   * Padding to squeeze the whole content inside
   */
  padding: int enum UiSdlGridGutterAndPadding = GP0

  /**
   * Stretch to fill the container
   */
  stretch: boolean = true

  /**
   * The number of columns (1-12) that the container should take up.
   * 12 will take up the entire content area of the page.
   */
  column: int

  /**
   * The component that should be rendered inside the container.
   */
  childComponent: UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>

  fromString: ~ js

}
