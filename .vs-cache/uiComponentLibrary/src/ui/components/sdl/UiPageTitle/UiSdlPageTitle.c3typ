/**
 * A UI component type for the page title.
 */
@typeScript
@uiComponentCategorizer(name='Page title', category='Patterns')
type UiSdlPageTitle mixes UiSdlComponent<any> {

  /**
   * Tab id indicating which tab to be shown. This is the highlighted item in the component.
   * Each page has to set its active tab according to the page that is being shown.
   */
  activeTab: string

  /**
   * List of tabs to show to the right of the page title.
   */
  tabs: [UiSdlPageTab]

  /**
   * The default page title if a {@link title} is not defined and if the {@link tabs} can not resolve to a title.  This
   * is used to set the browser's {@link https://developer.mozilla.org/en-US/docs/Web/API/Document/title title}
   * property.
   */
  defaultPageTitle: string | UiSdlDynamicValueSpec = "UiSdlPageTitle.defaultPageTitle.title"

  /**
   * The name of the page.
   */
  title: string | UiSdlDynamicValueSpec

  /**
   * The title text for broswer tab.
   * {@link UiSdlPageTab} also has HTMLTitle to configure text
   * for individual tab, therefore that field will take precedence when both exist.
   */
  HTMLTitle: string

  /**
   * The page description rendered as a tooltip upon hover.
   */
  titleInfoTooltip: string | UiSdlDynamicValueSpec

  /**
   * The action group to show to the right.
   */
  actionGroup: UiSdlPageTitleActionGroup

  /**
   * Whether the page title position will be fixed.
   */
  fixedPosition: boolean = false

  /**
   * The right-aligned global input field.
   */
  @uiSdlDesignerGlobalFilterComponentRef
  globalInputField: UiSdlComponentRef<UiSdlInputBase>

  /**
   * Used for global filter to automatically apply the first available selection of the input field as the default filter.
   */
  autoFill: boolean = false

  /**
   * Triggered when the page title is clicked.
   *
   * @param id
   *           Id of the component.
   *
   * @returns A `TITLE_CLICK` action for this instance with a payload {@link UiSdlTitleClickPayload}.
   */
  @uiSdlActionCreator(actionType='TITLE_CLICK')
  clickTitleAction: function(id: string): UiSdlTitleClickAction ts-client

  /**
   * Triggered when the tab is clicked.
   *
   * @param id
   *           Id of the component.
   * @param tab
   *           The tab object with id and url.
   *
   * @returns A `TAB_CLICK` action for this instance with a payload {@link UiSdlTabClickPayload}.
   */
  @uiSdlActionCreator(actionType='TAB_CLICK')
  clickTabAction: function(id: string, tab: UiSdlPageTab): UiSdlTabClickAction ts-client

  /**
   * Action triggered in the {@link tabClickEpic} to redirect to the given url.
   *
   * @param id
   *           Id of the component.
   * @param url
   *           The url used to redirect the page.
   *
   * @returns A `TAB_REDIRECT` action for this instance with a payload {@link UiSdlTabRedirectPayload}.
   */
  @uiSdlActionCreator(actionType='TAB_REDIRECT')
  redirectTabAction: function(id: string, url: string): UiSdlTabRedirectAction ts-client

  /**
   * Action triggered in the {@link tabClickEpic} to set the new active tab.
   *
   * @param id
   *           Id of the component.
   * @param tabId
   *           The new active tab id.
   *
   * @returns An `ACTIVE_TAB_SET` action for this instance with a payload {@link UiSdlActiveTabSetPayload}.
   */
  @uiSdlActionCreator(actionType='ACTIVE_TAB_SET')
  setActiveTabAction: function(id: string, tabId: string): UiSdlActiveTabSetAction ts-client

  /**
   * Triggered when one of the {@link actionGroup} buttons is clicked.
   *
   * @param id
   *           Id of the component.
   * @param actionSuffix
   *           The suffix of the action that should be triggered.
   *
   * @returns A `PAGE_TITLE_ACTION_CLICK_${actionSuffix}` action with a payload {@link UiSdlPageTitleActionClickPayload}.
   */
  @uiSdlActionCreator(actionType='PAGE_TITLE_ACTION_CLICK_${actionSuffix}')
  triggerPageTitleAction: function(id: string,
                                   actionSuffix: string,
                                   args: json): UiSdlPageTitleActionClickAction ts-client

  /**
   * Listens for actions of type `ACTIVE_TAB_SET`, then sets the active tab in the redux store.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='ACTIVE_TAB_SET')
  activeTabSetEffect: private inline function(state: UiSdlReduxState,
                                              action: UiSdlActiveTabSetAction): UiSdlReduxState ts-client

  /**
   * Triggers `ACTIVE_TAB_SET` and `TAB_REDIRECT` actions to set the new active tab and redirect to the given url.
   *
   * @param actionStream
   *           Observable action stream.
   * @param stateStream
   *           Observable state stream.
   *
   * @returns An Observable action stream.
   */
  @uiSdlEpic(actionType='TAB_CLICK')
  tabClickEpic: private function(actionStream: UiSdlActionsObservable,
                                 stateStream: UiSdlStatesObservable): UiSdlActionsObservable ts-client
}
