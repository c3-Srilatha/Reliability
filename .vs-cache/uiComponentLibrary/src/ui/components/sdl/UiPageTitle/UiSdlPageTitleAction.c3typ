/**
 * Action buttons shown to the right of {@link UiSdlPageTitle}.
 */
@typeScript
type UiSdlPageTitleAction mixes UiSdlAction {

  /**
   * The action button size. One of: small, large, condensed.
   */
  size: string enum('small', 'large', 'condensed')

  /**
   * The usage type for this action button.
   */
  usage: string enum('primary', 'secondary', 'link', 'danger', 'danger-secondary', 'danger-link', 'icon', 'icon-with-text')
}
