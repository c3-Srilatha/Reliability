/**
 * A UI component type that represents a markdown renderer.
 */
@typeScript
@uiComponentCategorizer(name='Markdown renderer', category='Patterns', hide=true)
type UiSdlMarkdownRenderer mixes UiSdlComponent<UiSdlMarkdownRendererDataSpec> {

  @uiSdlDataSpec(dataDestinationField='dangerousInnerHtml')
  dataSpec: ~

  /**
   * Holds the HTML to display in SDLHtmlRenderer.
   * Since directly setting inner HTML is susceptible to XSS attacks,
   * we always need to make sure we are sanitizing anything coming from a 3rd party.
   */
  dangerousInnerHtml: string

  /**
   * Enum type to identify which file type is rendering.
   */
  fileType: string enum UiSdlMarkdownRendererFileType
}
