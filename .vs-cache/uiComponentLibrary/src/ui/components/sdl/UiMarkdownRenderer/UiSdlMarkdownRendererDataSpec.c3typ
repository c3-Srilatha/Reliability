/**
 * A UI component type that represents a markdown renderer data spec.
 */
@typeScript
type UiSdlMarkdownRendererDataSpec mixes UiSdlComponentDataSpec {

  /**
   * The C3 type name for fetching the Markdown file content and rendering it as HTML.
   */
  typeName: !string

  /**
   * The C3 type action to apply on {@link UiSdlMarkdownRendererDataSpec#typeName} name for fetching the Markdown file content and rendering it as HTML.
   */
  actionName: !string

  /**
   * The C3 type action arguments for fetching the Markdown file content and rendering it as HTML.
   */
  actionArgs: json

  toPartiallyAppliedActions: ~ ts-client
}
