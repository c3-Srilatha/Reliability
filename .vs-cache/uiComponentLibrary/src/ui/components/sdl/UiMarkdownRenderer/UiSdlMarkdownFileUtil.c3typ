/**
 * Helper functions for rendering HTML from markdown file.
 */
type UiSdlMarkdownFileUtil {

  /**
   * Render HTML content from Markdown content.
   *
   * @param markdownContent
   *           The source content to render from.
   * @param sanitize
   *           If true, sanitize the result. (Callers might prefer to do this at the front end instead.)
   *
   * @return The rendered content.
   */
  renderHTMLContent: function(markdownContent: !string, sanitize: boolean): string js-server

  /**
   * Get the markdown file content from the given filePath and Internally call {@link renderHTMLContent}
   * to render HTML from the markdown file content.
   *
   * @param filePath
   *          The url of the markdown file.
   *
   * @return Rendered HTML from the markdown file content.
   */
  renderHTMLFromMarkdownFile: function(filePath: !string): string js-server
}
