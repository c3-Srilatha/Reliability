/**
 * Used to render either one of two components based on a condition at runtime.
 *
 * IMPORTANT: This is not an authorization feature. If you need to limit access to APIs,
 * please use {@link Permission} and `AdminGroup`.
 */
@typeScript
@uiComponentCategorizer(name='Conditional renderer', category='Components', hide=true)
type UiSdlConditionalRenderer mixes UiSdlComponent<UiSdlNoData>, UiSdlConditionalRenderConfig<UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>> {

}
