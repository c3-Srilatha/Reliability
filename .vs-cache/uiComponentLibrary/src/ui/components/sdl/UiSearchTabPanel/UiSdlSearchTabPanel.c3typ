@typeScript
@uiComponentCategorizer(name='Search tab panel', category='Patterns')
 type UiSdlSearchTabPanel mixes UiSdlComponent {

  /**
    * The title of the search tab panel.
  */
  title: string = "UiSdlSearchTabPanel.searchTitle"

  /**
   * The placeholder text for the search input.
   */
  searchPlaceholderText: string = "UiSdlSearchTabPanel.searchPlaceholderText"

  /**
    * Indicates if the search section is loading.
  */
  searchLoading: boolean = false

  /**
    * Indicates if the search section is disabled.
  */
  searchDisabled: boolean = false

  /**
   * The search term.
   */
  searchTerm: string | UiSdlDynamicValueSpec

  /**
   * Configurations of components to be rendered as child tabs.
   * Id is required, title is optional.
   */
  tabComponents: ![UiSdlTabComponentRef]

  /**
   * The ids of tabs with notifications.
   */
  tabsWithNotification: private [string]

  /**
   * The id of the active tab.
   */
  activeTab: string

  /**
   * Triggered when search button is clicked.
   *
   * @param id
   *          Id of the component.
   * @param searchTerm
   *          The search term coming from input search.
   *
   * @returns An `SEARCH_BUTTON_CLICK` action for this instance.
   */
  @uiSdlActionCreator(actionType='SEARCH_BUTTON_CLICK')
  clickSearchButtonAction: function(id: string, searchTerm: string): !UiSdlTabPanelSearchClickAction ts-client

  /**
   * Triggered when a button state needs to be changed.
   * This can be disabled or loading state for a button.
   *
   * @param id
   *           Id of the component.
   * @param disable
   *           Whether or not this button should be disabled or enabled.
   * @param loading
   *           Whether or not this button should be loading or not.
   *
   * @returns An `SEARCH_BUTTON_STATE_CHANGE` action for this instance.
   */
  @uiSdlActionCreator(actionType='SEARCH_BUTTON_STATE_CHANGE')
  changeSearchButtonStateAction: function(id: string,
                                                  disable: boolean,
                                                  loading: boolean): UiSdlTabPanelSearchButtonStateChangeAction ts-client

  /**
   * Triggered when the active tab needs to be changed.
   *
   * @param id
   *           Id of the component.
   * @param activeTab
   *           The id of the active tab.
   *
   * @returns An `ACTIVE_TAB_CHANGE` action for this instance.
   *   - payload {string} The id of the active tab.
   */
  @uiSdlActionCreator(actionType='ACTIVE_TAB_CHANGE')
  changeActiveTabAction: function(id: string, activeTab: !string): !UiSdlActiveTabChangeAction ts-client

  /**
   * Triggers setting the notification on a tab.
   *
   * @param id
   *           Id of the component.
   * @param tabId
   *           The id of the tab to notify.
   *
   * @returns A `NOTIFICATION_ON_TAB_SET` action for this instance.
   *   - payload {string} The id of the tab.
   */
  @uiSdlActionCreator(actionType='NOTIFICATION_ON_TAB_SET')
  setNotificationOnTabAction: function(id: string, tabId: !string): !UiSdlNotificationOnTabAction ts-client

  /**
   * Removes the notification on a tab.
   *
   * @param id
   *           Id of the component.
   * @param tabId
   *           The id of the tab to remove the notification from.
   *
   * @returns A `NOTIFICATION_ON_TAB_REMOVE` action for this instance.
   *   - payload {string} The id of the tab.
   */
  @uiSdlActionCreator(actionType='NOTIFICATION_ON_TAB_REMOVE')
  removeNotificationOnTabAction: function(id: string, tabId: !string): !UiSdlNotificationOnTabAction ts-client

  /**
   * Listens for actions of type `SEARCH_BUTTON_CLICK` and sets the searchTerm value in the state.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='SEARCH_BUTTON_CLICK')
  searchTermSubmitReducer: private function(state: !UiSdlReduxState,
                                           action: UiSdlTabPanelSearchClickAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `SEARCH_BUTTON_STATE_CHANGE`, then renders the action button appropriately.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='SEARCH_BUTTON_STATE_CHANGE')
  changeSearchButtonStateReducer: private function(state: !UiSdlReduxState,
                                           action: !UiSdlTabPanelSearchButtonStateChangeAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `ACTIVE_TAB_CHANGE`, then renders
   * the tab component if it hasn't been rendered.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='ACTIVE_TAB_CHANGE')
  activeTabChangeReducer: private function(state: !UiSdlReduxState,
                                           action: UiSdlActiveTabChangeAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `NOTIFICATION_ON_TAB_SET`, then adds the notification to that tab.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='NOTIFICATION_ON_TAB_SET')
  notificationOnTabSetReducer: private function(state: !UiSdlReduxState,
                                                action: UiSdlNotificationOnTabAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `NOTIFICATION_ON_TAB_REMOVE`, then removes the notification from that tab.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='NOTIFICATION_ON_TAB_REMOVE')
  notificationOnTabRemoveReducer: private function(state: !UiSdlReduxState,
                                                   action: UiSdlNotificationOnTabAction): !UiSdlReduxState ts-client
 }
