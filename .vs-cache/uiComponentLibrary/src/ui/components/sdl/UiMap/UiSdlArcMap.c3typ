/**
 * `UiSdlArcMap` is a component focused on visualizing connections, movements, or relationships
 * between entities or assets on a map. Through this component, users can get
 * a geographical overview of their assets and the links between them, get additional information on
 * specific assets or arcs when clicking on them, and use this component to
 * create a geographic filtering for the page that it is on.
 */
@deprecated(finalVersion='8.8', details='Use a React library like Mapbox instead of this UI component')
/**
 * `UiSdlArcMap` is not a widely used component and is being deprecated. It will be removed in a future release.
 * We reccoment using `UiSdlGraphVisualization` instead.
 */
@uiSdlDesignerComponent(designable=true,
                        category='UiSdlArcMap.CategoryName',
                        name='UiSdlArcMap.ComponentName',
                        icon='map')
@typeScript
@uiComponentCategorizer(name='Arc map', category='Data Visualization')
type UiSdlArcMap mixes UiSdlComponent<UiSdlArcMapDataSpec>, UiSdlComponentTitle, UiSdlStandardFetchFilterable {

  /**
   * The specification used for retrieving data displayed by the map.
   */
  @uiSdlDataSpec(dataDestinationField='arcData')
  dataSpec: ~

  /**
   * The data for markers to display on the map.
   */
  arcData: FetchResult<Obj>

  /**
   * The width of an arc.
   */
  arcWidth: double = 5

  /**
   * If true, create the arc along the shortest path on the earth surface.
   * The shortest path between two points on a 2d projection is not a straight line.
   */
  shortestPath: boolean = false

  /**
   * The style of the background map tiles.
   */
  mapStyle: string enum UiSdlMapStyle = THEMED

  /**
   * Map Legend - information for coloring of arcs.
   */
  legend: UiSdlMapLegend

  /**
   * The default color that will be used for arcs on the map.
   */
  defaultArcColor: string enum UiSdlThresholdColor = DARK_BLUE
}
