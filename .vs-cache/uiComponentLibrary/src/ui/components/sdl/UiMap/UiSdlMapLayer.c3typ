/**
 * A type that represents a layer displayed on {@link UiSdlMap}.
 */
@typeScript
type UiSdlMapLayer {

  /**
   * Name of the layer. This is now being used to ensure that layers create unique Source ids.
   * The layer's index will be concatenated to this string to ensure uniqueness.
   */
  name: string

  /**
   * Set of Markers included in this layer.
   */
  layerMarkers: [UiSdlMapMarker]

  /**
   * Coordinates to draw the layer polygons.
   */
  layerPolygonCoordinates: json

  /**
   * What color the layer is.
   */
  color: string

  /**
   * String for attribute shared by all markers in this layer.
   */
  layerAttribute: string

  /**
   * Whether or not the layer is displayed by default.
   */
  isOnByDefault: boolean

  /**
   * Whether or not the layer is displayed.
   */
  isSelected: boolean = false

  /**
   * Whether or not the layer can be displayed with other layers.
   */
  isMultiLayerVisualizable: boolean

  /**
   * The opacity for the layer. Default is 0.3
   * Must be from 0 to 1
   */
  opacity: double = 0.3
}
