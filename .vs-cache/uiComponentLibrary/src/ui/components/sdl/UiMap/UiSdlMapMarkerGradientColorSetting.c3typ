/**
 * Type used to configure the color gradient for markers used in {@link UiSdlMap}.
 */
@typeScript
type UiSdlMapMarkerGradientColorSetting mixes UiSdlFieldBasedDataSpecSetting {

  /**
   * The minimum value used in the gradient.
   */
  minimum: double

  /**
   * The minimum value used in the gradient.
   */
  maximum: double

  /**
   * The color gradient selections.
   */
  gradient: string enum('gradient1', 'gradient1-inv', 'gradient2', 'gradient2-inv', 'gradient3', 'gradient3-inv')
}
