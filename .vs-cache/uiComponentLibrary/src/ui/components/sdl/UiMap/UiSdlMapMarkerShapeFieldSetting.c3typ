/**
 * A specification that describes how to use a field of the dataType for determining the shape of the markers
 * on a {@link UiSdlMap} instance.
 */
@typeScript
type UiSdlMapMarkerShapeFieldSetting mixes UiSdlFieldBasedDataSpecSetting {

  /**
   * Field value to shape mappings.
   */
  categoryShapes: ![UiSdlMapCategoryShapeSetting]
}
