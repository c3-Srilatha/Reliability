/**
 * `UiSdlMap` is a component focused on visualizing entities or assets on a map as
 * well as visualizing layers or clusters. Through this component, users can get
 * a geographical overview of their assets, get additional information on
 * specific assets or clusters when clicking on them, and use this component to
 * create a geographic filtering for the page that it is on.
 *
 * The map tiles display is backed by Mapbox and requires an access token
 * to be set, via `UiSdlMapbox.setAccessToken()`, for the map to render.
 * See {@link UiSdlMapbox} and {@link UiSdlMapboxConfig}.
 */
@uiSdlDesignerComponent(designable=true, category='UiSdlMap.CategoryName', name='UiSdlMap.ComponentName', icon='map')
@typeScript
@uiComponentCategorizer(name='Map', category='Data Visualization')
type UiSdlMap mixes UiSdlComponent<UiSdlMapDataSpec>, UiSdlComponentTitle, UiSdlStandardFetchFilterable, UiSdlHeight {

  /**
   * The specification used for retrieving data displayed by the map.
   */
  @uiSdlDataSpec(dataDestinationField='markerData')
  dataSpec: ~

  /**
   * The data for markers to display on the map.
   */
  markerData: FetchResult<Obj>

  /**
   * The data for layers to display on the map.
   * The {@link UiSdlMapLayer#name} is used to ensure that layers create sources with unique ids.
   * The layer index will be concatenated to the name before passing through for rendering.
   */
  layers: [UiSdlMapLayer]

  /**
   * The default color that will be used for markers on the map.
   */
  defaultMarkerColor: string enum UiSdlThresholdColor = DARK_BLUE

  /**
   * The default shape that will be used for markers on the map.
   */
  defaultMarkerShape: string enum UiSdlMapMarkerShape = CIRCLE

  /**
   * The style of the background map tiles.
   */
  mapStyle: string enum UiSdlMapStyle = THEMED

  /**
   * Whether or not to hide the navigation and full screen control within the map.
   */
  hideControls: boolean = false

  /**
   * Map Legend - information for coloring of markers.
   */
  legend: UiSdlMapLegend

  /**
   * Centering - configuration for the center button displayed on the map.
   */
  centering: UiSdlMapFixedCentering

  /**
   * Zoom Type of the Map.
   * {@link UiSdlMapFixedZoom} (developer provides exact zoom level),
   * {@link UiSdlMapAutoZoom} (default option, based on plotted data)
   */
  zoom: UiSdlMapAutoZoom | UiSdlMapFixedZoom = {"type": "UiSdlMapAutoZoom"}

  /**
   * Transition duration is required to zoom in on markers on first render (in ms).
   */
  transitionDuration: int

  /**
   * The height of the component in pixels.
   */
  height: ~ = 600
}
