/**
 * Type to represent a {@link UiSdlMap} and {@link UiSdlArcMap} fixed zoom configuration.
 */
@typeScript
type UiSdlMapFixedZoom {

  /**
   * Exact zoom level for the map.
   * REQUIRES: Integer between 0 (lowest zoom, Earth level) 22 (highest zoom, buildings level).
   */
  fixedZoomLevel: int
}
