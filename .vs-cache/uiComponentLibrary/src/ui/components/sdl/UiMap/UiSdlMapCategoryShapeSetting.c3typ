/**
 * A field to map a shape to a specific category of a field.
 */
@typeScript
type UiSdlMapCategoryShapeSetting {

  /**
   * A label for the field.
   */
  label: !string

  /**
   * The shape to use if the field value is equal to the label.
   */
  shape: !string enum UiSdlMapMarkerShape = CIRCLE
}
