/**
 * The styles available for {@link UiSdlMap}.
 */
enum type UiSdlMapStyle {

  /**
   * The Road style.
   */
  ROAD

  /**
   * The Dark style.
   */
  DARK

  /**
   * The Satellite style.
   */
  SATELLITE

  /**
   * The Hybrid style.
   */
  HYBRID

  /**
   * The Terrain style.
   */
  TERRAIN

  /**
   * The Themed style. This indicates that the Map will respect an application theme, if present.
   * See {@link UiSdlThemeCategory}.
   * If no theme is present, the ROAD style is used instead.
   */
  THEMED
}
