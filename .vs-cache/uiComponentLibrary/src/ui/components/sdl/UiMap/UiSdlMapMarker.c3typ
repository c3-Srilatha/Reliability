/**
 * A type that represents a marker included in {@link UiSdlMapLayer} on the a {@link UiSdlMap}.
 */
@typeScript
type UiSdlMapMarker {

  /**
   * Data for the marker from the dataspec.
   */
  data: any

  /**
   * Markers Latitude.
   */
  latitude: double

  /**
   * Markers Longitude.
   */
  longitude: double

  /**
   * Markers color.
   */
  color: string

  /**
   * Marker opacity.
   */
  opacity: double

  /**
   * Data for the marker tooltip header.
   */
  tooltipHeader: any

  /**
   * Data for the marker tooltip subheader.
   */
  tooltipSubHeader: any

  /**
   * Additional fields for the marker tooltip.
   */
  tooltipAdditionalFields: any

  /**
   * WHich layer the marker is grouped with.
   */
  layerAttribute: string

  /**
   * Shape of marker icon.
   */
  shape: string
}
