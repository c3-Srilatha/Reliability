/**
 * The specification of data retrieval for instances of the {@link UiSdlArcMap} component type.
 */
@typeScript
type UiSdlArcMapDataSpec mixes UiSdlFieldBasedDataSpec {

  /**
   * The field on the data type that maps to the latitude of the start point.
   */
  startLatitude: !UiSdlFieldBasedDataSpecSetting

  /**
   * The field on the data type that maps to the longitude of the start point.
   */
  startLongitude: !UiSdlFieldBasedDataSpecSetting

  /**
   * The field on the data type that maps to the latitude of the end point.
   */
  endLatitude: !UiSdlFieldBasedDataSpecSetting

  /**
   * The field on the data type that maps to the longitude of the end point.
   */
  endLongitude: !UiSdlFieldBasedDataSpecSetting

  /**
   * The specification for a field on the data type that is used in determining arc colors.
   */
  arcColor: UiSdlMapMarkerColorFieldSetting

  /**
   * The specification for a field on the data type that is used in determining start marker colors.
   */
  startMarkerColor: UiSdlMapMarkerColorFieldSetting

  /**
   * The specification for a field on the data type that is used in determining end marker colors.
   */
  endMarkerColor: UiSdlMapMarkerColorFieldSetting

  /**
   * The field on the data type that maps to the arc tooltip's header.
   */
  arcTooltipHeader: UiSdlFieldBasedDataSpecSetting

  /**
   * The field on the data type that maps to the arc tooltip's subheader.
   */
  arcTooltipSubHeader: UiSdlFieldBasedDataSpecSetting

  /**
   * Additional fields that are specified to be added in the arc tooltip.
   */
  arcTooltipAdditionalFields: [UiSdlMapTooltipAdditionalFieldDataSpecSetting]

  /**
   * The field on the data type that maps to the start point tooltip's header.
   */
  startTooltipHeader: UiSdlFieldBasedDataSpecSetting

  /**
   * The field on the data type that maps to the start point tooltip's subheader.
   */
  startTooltipSubHeader: UiSdlFieldBasedDataSpecSetting

  /**
   * Additional fields that are specified to be added in the start point tooltip.
   */
  startTooltipAdditionalFields: [UiSdlMapTooltipAdditionalFieldDataSpecSetting]

  /**
   * The field on the data type that maps to the end point tooltip's header.
   */
  endTooltipHeader: UiSdlFieldBasedDataSpecSetting

  /**
   * The field on the data type that maps to the end point tooltip's subheader.
   */
  endTooltipSubHeader: UiSdlFieldBasedDataSpecSetting

  /**
   * Additional fields that are specified to be added in the end point tooltip.
   */
  endTooltipAdditionalFields: [UiSdlMapTooltipAdditionalFieldDataSpecSetting]

  /**
   * Converts the data spec to a partially applied action.
   */
  toPartiallyAppliedActions: ~ ts-client
}
