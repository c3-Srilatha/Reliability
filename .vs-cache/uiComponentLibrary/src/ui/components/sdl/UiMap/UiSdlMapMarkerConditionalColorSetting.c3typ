/**
 * A type that represents the conditional coloring strategy configuration of a {@link UiSdlMapMarkerColorFieldSetting}.
 */
@typeScript
type UiSdlMapMarkerConditionalColorSetting {

  /**
   * The threshold value.
   */
  threshold: !double

  /**
   * The operator that is used for comparison to the threshold value.
   */
  operator: !string enum('EQUALS', 'LESS_THAN', 'GREATER_THAN', 'LESS_THAN_OR_EQUAL_TO', 'GREATER_THAN_OR_EQUAL_TO')

  /**
   * The color to use if the field value meets the threshold. If not met, the default color is used.
   */
  thresholdColor: !string enum UiSdlThresholdColor = DARK_BLUE
}
