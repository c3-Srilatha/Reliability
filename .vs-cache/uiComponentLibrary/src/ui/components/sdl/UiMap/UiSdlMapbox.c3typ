/**
 * UiSdlMapbox type provides access to UiSdlMapbox configuration settings defined in {@link UiSdlMapboxConfig} type.
 *
 * The recommended usage pattern is shown below:
 * * Getting the UiSdlMapbox instance:
 *   ```
 *   var mapbox = UiSdlMapbox.inst();
 * * Setting the UiSdlMapbox access token:
 *   ```
 *   mapbox.setAccessToken('access_token');
 *   ```
 * * Getting the UiSdlMapbox access token:
 *   ```
 *   const accessToken = mapbox.getAccessToken();
 *   ```
 * * Resetting the UiSdlMapbox access token:
 *   ```
 *   mapbox.resetAccessToken();
 *   ```
 */
type UiSdlMapbox mixes Configurable<UiSdlMapboxConfig>, Singleton {

  /**
   * Field path to UiSdlMapbox access token defined in {@link UiSdlMapboxConfig} type.
   */
  accessTokenFieldPath: string = 'accessToken'

  /**
   * Field path to UiSdlMapbox API url defined in {@link UiSdlMapboxConfig} type.
   */
  apiUrlFieldPath: string = 'url'

  /**
   * Sets the given UiSdlMapbox access token.
   *
   * @param accessToken
   *     the UiSdlMapbox access token to set.
   */
  setAccessToken: member function(accessToken: !string) js-server

  /**
   * Gets the UiSdlMapbox access token.
   *
   * @return
   *     the UiSdlMapbox access token.
   */
  getAccessToken: member function(): string js-server

  /**
   * Gets the associated {@link UiSdlMapboxConfig} with the associated UiSdlMapbox access token.
   *
   * @return
   *     the UiSdlMapbox config with the UiSdlMapbox access token.
   */
  configWithAccessToken: member function(): UiSdlMapboxConfig js-server

  /**
   * Clears the UiSdlMapbox access token.
   */
  clearAccessToken: member function(): string js-server

  /**
   * Sets the given UiSdlMapbox api url. This is not usually required, as the
   * default behavior (calling https://api.mapbox.com) is sufficient for most use cases.
   */
  setApiUrl: member function(apiUrl: !string) js-server

  /**
   * Gets the configured UiSdlMapbox API url.
   */
  getApiUrl: member function(): string js-server

  /**
   * Clears the configured UiSdlMapbox API url. The default API url (https://api.mapbox.com) will be used.
   */
  clearApiUrl: member function() js-server
}
