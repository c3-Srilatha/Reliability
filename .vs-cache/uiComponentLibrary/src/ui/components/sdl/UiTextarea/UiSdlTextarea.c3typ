/**
 * A UI component type that displays a multi-line textarea.
 */
@uiComponentCategorizer(name='Textarea (new)', aliases=['Atomic Textarea'], category='Components')
type UiSdlTextarea mixes UiSdlComponent {

  /**
   * Size of text area area.
   */
  size: string enum("SMALL", "MEDIUM", "LARGE") = "MEDIUM"

  /**
   * Status of text area.
   */
  status: string enum("IDLE", "ERROR", "SUCCESS", "DISABLED", "READ_ONLY") = "IDLE"

  /**
   * Width of text area.
   */
  width: string enum("LARGE", "X_LARGE", "FILL") = "LARGE"

  /**
   * Placeholder text to appear in the text area when the input is empty.
   */
  placeholder: string | UiSdlDynamicValueSpec

  /**
   * The value of this text area component.
   */
  value: string

  /**
   * The initial value of this text area component.
   */
  initialValue: string | UiSdlDynamicValueSpec

  /**
   * An action that is dispatched to set the value of the text area component.
   *
   * @param id
   *           Id of the textarea component.
   * @param value
   *           The value of the textarea component.
   * @returns A `SET_TEXTAREA_VALUE` action for this instance.
   */
  @uiSdlActionCreator(actionType='SET_TEXTAREA_VALUE')
  setTextareaValueAction: function(id: !string, value: string): !UiSdlTextareaValueSetAction ts-client

  /**
   * Triggered when a textarea needs to change status.
   *
   * @param id
   *           Id of the component.
   * @param status
   *           The status of the text area.
   *
   * @returns A `SET_TEXTAREA_STATUS` action for this instance.
   */
  @uiSdlActionCreator(actionType='SET_TEXTAREA_STATUS')
  setTextareaStatusAction: function(id: !string, status: !string enum("IDLE", "ERROR", "SUCCESS", "DISABLED", "READ_ONLY") = "IDLE"): !UiSdlTextareaStatusSetAction ts-client

  /**
   * Listens for actions of type `SET_TEXTAREA_VALUE` and sets the {@link UiSdlTextarea#value} area of the
   * input component.
   */
  @uiSdlReducer(actionType='SET_TEXTAREA_VALUE')
  textareaValueSetReducer: private function(state: UiSdlReduxState, action: UiSdlTextareaValueSetAction): UiSdlReduxState ts-client

  /**
   * Listens for actions of type `SET_TEXTAREA_STATUS` and sets the {@link UiSdlTextarea#status} area of the
   * input component.
   */
  @uiSdlReducer(actionType='SET_TEXTAREA_STATUS')
  textareaStatusSetReducer: private function(state: UiSdlReduxState, action: UiSdlTextareaStatusSetAction): UiSdlReduxState ts-client
}
