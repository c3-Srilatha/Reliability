/**
 * A type that represents a three button modal configuration of a {@link UiSdlModal}.
 */
@typeScript
type UiSdlThreeButtonModal mixes UiSdlTwoButtonModal {

  /**
   * Whether or not to close the modal when the tertiary button is clicked.
   */
  closeModalOnTertiaryButtonClick: boolean = true

  /**
   * The label available for the tertiary button in a modal.
   */
  tertiaryButtonLabel: string

  /**
   * The styles available for the tertiary button in a modal.
   */
  tertiaryButtonStyle: string enum('primary', 'danger', 'secondary', 'danger-secondary', 'link', 'danger-link')
}
