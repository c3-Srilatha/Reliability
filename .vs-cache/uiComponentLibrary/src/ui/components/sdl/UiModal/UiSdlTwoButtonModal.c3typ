/**
 * A type that represents a two button modal configuration of a {@link UiSdlModal}.
 * The label for the secondary button is default to `UiSdlModal.secondaryButtonLabel` translation.
 */
@typeScript
type UiSdlTwoButtonModal mixes UiSdlOneButtonModal {

  /**
   * Whether or not to close the modal when the secondary button is clicked.
   */
  closeModalOnSecondaryButtonClick: boolean = true

  /**
   * The label available for the secondary button in a modal.
   */
  secondaryButtonLabel: string

  /**
   * The styles available for the secondary button in a modal.
   */
  secondaryButtonStyle: string enum('primary', 'danger', 'secondary', 'danger-secondary', 'link', 'danger-link')
}
