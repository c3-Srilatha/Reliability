/**
 * Payload for a {@link UiSdlModalButtonTextUpdateAction}.
 */
type UiSdlModalButtonTextUpdatePayload mixes UiSdlComponentActionPayload {

  /**
   * The type of the button whose text is to be updated. Should be one of "PRIMARY",
   * "SECONDARY" or "TERTIARY".
   */
  buttonType: string enum('PRIMARY', 'SECONDARY', 'TERTIARY')

  /**
   * The text corresponding to the button.
   */
  buttonText: string
}
