/**
 * Base type for {@link UiSdlModal} and {@link UiSdlMultiStepModalStep}.
 */
@typeScript
abstract type UiSdlModalBody {

  /**
   * Components to render in the body of the modal container.
   */
  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]

  /**
   * Correspond to SDLModalBody config.
   *
   * Text to be rendered in the header section.
   */
  header: UiSdlModalHeaderConfig = {}

  /**
   * Text to be rendered in the header section beneath the header.
   */
  subHeader: UiSdlModalSubHeaderConfig = {}

  /**
   * Whether the modal should render a divider above content.
   */
  showTopDivider: boolean

  /**
   * Whether the modal should render a divider below content.
   */
  showBottomDivider: boolean

  /**
   * String content to be rendered in the body of the modal.
   * Note that if the translation value contains dynamic variables,
   * e.g. "Hello {name}", do not wrap the translation key with
   * '{~' and '~}'
   */
  content: UiSdlModalContentConfig = {}

  /**
   * Button layout configuration on the modal.
   */
  modalType: UiSdlOneButtonModal | UiSdlTwoButtonModal | UiSdlThreeButtonModal = {}

  /**
   * Whether or not to disable the Primary Button.
   */
  disablePrimaryButton: boolean

  /**
   * Whether or not to disable the Secondary Button.
   */
  disableSecondaryButton: boolean

  /**
   * Whether or not to disable the Tertiary Button.
   */
  disableTertiaryButton: boolean

  /**
   * Whether or not to set primary button to loading (spinner).
   */
  isLoadingPrimaryButton: boolean = false

  /**
   * Whether or not to set secondary button to loading (spinner).
   */
  isLoadingSecondaryButton: boolean = false

  /**
   * Whether or not to set tertiary button to loading (spinner).
   */
  isLoadingTertiaryButton: boolean = false

  /**
   * Ms to debounce clicks on primary button.
   * Defaulted to 300ms.
   */
  primaryButtonClickDebounce: int = 300

  /**
   * Ms to debounce clicks on secondary button.
   * Defaulted to 300ms.
   */
  secondaryButtonClickDebounce: int = 300

  /**
   * Ms to debounce clicks on tertiary button.
   * Defaulted to 300ms.
   */
  tertiaryButtonClickDebounce: int = 300

  /**
   * Update component metadata.
   *
   * @param id
   *          Id of the component.
   * @param metadata
   *          Metadata to update.
   *
   * @return A `METADATA_UPDATE` action for this instance.
   */
  @uiSdlActionCreator(actionType='METADATA_UPDATE')
  updateMetadataAction: function(id: !string, metadata: json): !UiSdlMetadataUpdateAction ts-client

  /**
   * Triggered externally by epics intending to update the modal's button text. A use case is when
   * the alert modal or confirm modal needs to be displayed with button texts updated on the fly.
   *
   * @param id
   *           Id of the component.
   * @param buttonType
   *           The type of the button whose text is to be updated. Should be one of "PRIMARY", "SECONDARY"
   *           or "TERTIARY".
   * @param buttonText
   *           The text corresponding to the button.
   *
   * @returns A `MODAL_BUTTON_TEXT_UPDATE` action for this instance.
   *   - payload {object} The object with the buttonType and buttonText specified.
   */
  @uiSdlActionCreator(actionType='MODAL_BUTTON_TEXT_UPDATE')
  updateModalButtonTextAction: function(id: !string,
                                                buttonType: string,
                                                buttonText: string): !UiSdlModalButtonTextUpdateAction ts-client

  /**
   * Triggered externally by epics intending to update the modal's content. A use case is when
   * the alert modal or confirm modal needs to be displayed with the modal content updated on the fly.
   *
   * @param id
   *           Id of the component.
   * @param content
   *           The modal object.
   *
   * @returns A `MODAL_CONTENT_UPDATE` action for this instance.
   *   - payload {object} The object with the content specified.
   */
  @uiSdlActionCreator(actionType='MODAL_CONTENT_UPDATE')
  updateModalContentAction: member function(id: !string,
                                                    content: string | UiSdlDynamicValueSpec)
                                             : !UiSdlModalContentUpdateAction ts-client

  /**
   * Triggered externally by epics intending to update the modal's header. A use case is when
   * the modal needs to be displayed with the modal header updated on the fly.
   *
   * @param id
   *            Id of the component.
   * @param header
   *           The modal object.
   *
   * @returns A `MODAL_HEADER_UPDATE` action for this instance.
   *   - payload {object} The object with the header specified.
   */
  @uiSdlActionCreator(actionType='MODAL_HEADER_UPDATE')
  updateModalHeaderAction: function(id: !string, header: string): !UiSdlModalHeaderUpdateAction ts-client

  /**
   * Triggered when a button needs to be disabled or enabled.
   *
   * @param id
   *           Id of the component.
   * @param buttonType
   *           The button type clicked.
   * @param disable
   *           Whether or not this button should be disabled or enabled.
   *
   * @returns A `(DISABLE|ENABLE)_(PRIMARY|SECONDARY|TERTIARY)_BUTTON` action for this instance.
   */
  @uiSdlActionCreator(actionType='(DISABLE|ENABLE)_(PRIMARY|SECONDARY|TERTIARY)_BUTTON')
  disableEnableButtonAction: function(id: !string,
                                              buttonType: string enum('PRIMARY', 'SECONDARY', 'TERTIARY'),
                                              disable: boolean): !UiSdlDisableEnableButtonAction ts-client

  /**
   * Triggered when the loading state of a modal button needs to be changed (turn spinner on/off).
   *
   * @param id
   *           Id of the component.
   * @param buttonType
   *           The button type clicked.
   *
   * @returns A 'LOADING_(ON|OFF)_(PRIMARY|SECONDARY|TERTIARY)_BUTTON' action for this instance.
   */
  @uiSdlActionCreator(actionType='LOADING_(ON|OFF)_(PRIMARY|SECONDARY|TERTIARY)_BUTTON')
  loadingOnOffButtonAction: function(id: !string,
                                             buttonType: !string enum('PRIMARY', 'SECONDARY', 'TERTIARY'),
                                             on: boolean = false): !UiSdlLoadingOnOffButtonAction ts-client

  /**
   * Triggered when the action buttons are clicked.
   * Note: Add an effect function with the actionType: '(PRIMARY|SECONDARY|TERTIARY)_BUTTON_CLICK'
   *       to add custom functionality for the modal action buttons.
   *
   * @param id
   *           Id of the component.
   * @param buttonType
   *           The button type clicked.
   *
   * @returns A `(PRIMARY|SECONDARY|TERTIARY)_BUTTON_CLICK` action for this instance.
   */
  @uiSdlActionCreator(actionType='(PRIMARY|SECONDARY|TERTIARY)_BUTTON_CLICK')
  clickButtonAction: function(id: !string,
                                      buttonType: string enum('PRIMARY', 'SECONDARY', 'TERTIARY'))
                               : !UiSdlButtonClickAction ts-client

  /**
   * Listens for actions of type `METADATA_UPDATE` and update metadata.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='METADATA_UPDATE')
  metadataUpdateReducer: private inline function(state: !UiSdlReduxState,
                                                 action: !UiSdlMetadataUpdateAction): !UiSdlReduxState ts-client

  /**
   * Listen for actions of type `DISABLE_PRIMARY_BUTTON`
   * and sets the internal {@link disablePrimaryButton} to true.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='DISABLE_PRIMARY_BUTTON')
  primaryButtonDisableReducer: private function(state: !UiSdlReduxState,
                                                action: !UiSdlDisableEnableButtonAction): !UiSdlReduxState ts-client

  /**
   * Listen for actions of type `DISABLE_SECONDARY_BUTTON`
   * and sets the internal {@link disableSecondaryButton} to false.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='DISABLE_SECONDARY_BUTTON')
  secondaryButtonDisableReducer: private function(state: !UiSdlReduxState,
                                                  action: !UiSdlDisableEnableButtonAction): !UiSdlReduxState ts-client

  /**
   * Listen for actions of type `DISABLE_TERTIARY_BUTTON`
   * and sets the internal {@link disableTertiaryButton} to true.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='DISABLE_TERTIARY_BUTTON')
  tertiaryButtonDisableReducer: private function(state: !UiSdlReduxState,
                                                 action: !UiSdlDisableEnableButtonAction): !UiSdlReduxState ts-client

  /**
   * Listen for actions of type `ENABLE_PRIMARY_BUTTON`
   * and sets the internal {@link disablePrimaryButton} to false.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='ENABLE_PRIMARY_BUTTON')
  primaryButtonEnableReducer: private function(state: !UiSdlReduxState,
                                               action: !UiSdlDisableEnableButtonAction): !UiSdlReduxState ts-client

  /**
   * Listen for actions of type `ENABLE_SECONDARY_BUTTON`
   * and sets the internal {@link disableSecondaryButton} to true.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='ENABLE_SECONDARY_BUTTON')
  secondaryButtonEnableReducer: private function(state: !UiSdlReduxState,
                                                 action: !UiSdlDisableEnableButtonAction): !UiSdlReduxState ts-client

  /**
   * Listen for actions of type `ENABLE_TERTIARY_BUTTON`
   * and sets the internal {@link disableTertiaryButton} to false.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='ENABLE_TERTIARY_BUTTON')
  tertiaryButtonEnableReducer: private function(state: !UiSdlReduxState,
                                                action: !UiSdlDisableEnableButtonAction): !UiSdlReduxState ts-client

  /**
   * Listen for actions of type `LOADING_ON_PRIMARY_BUTTON`
   * and sets the internal {@link isLoadingPrimaryButton} to true.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='LOADING_ON_PRIMARY_BUTTON')
  primaryButtonLoadingOnReducer: private function(state: !UiSdlReduxState,
                                                  action: !UiSdlLoadingOnOffButtonAction): !UiSdlReduxState ts-client

  /**
   * Listen for actions of type `LOADING_ON_SECONDARY_BUTTON`
   * and sets the internal {@link isLoadingSecondaryButton} to true.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='LOADING_ON_SECONDARY_BUTTON')
  secondaryButtonLoadingOnReducer: private function(state: !UiSdlReduxState,
                                                    action: !UiSdlLoadingOnOffButtonAction): !UiSdlReduxState ts-client

  /**
   * Listen for actions of type `LOADING_ON_TERTIARY_BUTTON`
   * and sets the internal {@link isLoadingTertiaryButton} to true
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='LOADING_ON_TERTIARY_BUTTON')
  tertiaryButtonLoadingOnReducer: private function(state: !UiSdlReduxState,
                                                   action: !UiSdlLoadingOnOffButtonAction): !UiSdlReduxState ts-client

  /**
   * Listen for actions of type `LOADING_OFF_PRIMARY_BUTTON`
   * and sets the internal {@link isLoadingPrimaryButton} to false.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='LOADING_OFF_PRIMARY_BUTTON')
  primaryButtonLoadingOffReducer: private function(state: !UiSdlReduxState,
                                                   action: !UiSdlLoadingOnOffButtonAction): !UiSdlReduxState ts-client

  /**
   * Listen for actions of type `LOADING_OFF_SECONDARY_BUTTON`
   * and sets the internal {@link isLoadingSecondaryButton} to false.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='LOADING_OFF_SECONDARY_BUTTON')
  secondaryButtonLoadingOffReducer: private function(state: !UiSdlReduxState,
                                                     action: !UiSdlLoadingOnOffButtonAction): !UiSdlReduxState ts-client

  /**
   * Listen for actions of type `LOADING_OFF_TERTIARY_BUTTON`
   * and sets the internal {@link isLoadingTertiaryButton} to false.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='LOADING_OFF_TERTIARY_BUTTON')
  tertiaryButtonLoadingOffReducer: private function(state: !UiSdlReduxState,
                                                    action: !UiSdlLoadingOnOffButtonAction): !UiSdlReduxState ts-client

  /**
   * Listens to actions of type 'MODAL_BUTTON_TEXT_UPDATE' and internally sets the {@link modalType#primaryButtonLabel}, {@link modalType#secondaryButtonLabel}, and {@link modalType#tertiaryButtonLabel} of the
   * modal to what was specified in the payload.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='MODAL_BUTTON_TEXT_UPDATE')
  modalButtonTextUpdateReducer: private function(state: !UiSdlReduxState,
                                              action: !UiSdlModalButtonTextUpdateAction): !UiSdlReduxState ts-client

  /**
   * Listens to actions of type 'MODAL_CONTENT_UPDATE' and internally sets the {@link content} of the
   * modal to what was specified in the payload.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='MODAL_CONTENT_UPDATE')
  modalContentUpdateReducer: private function(state: !UiSdlReduxState,
                                              action: !UiSdlModalContentUpdateAction): !UiSdlReduxState ts-client

  /**
   * Listens to actions of type 'MODAL_HEADER_UPDATE' and internally sets the {@link header} of the
   * modal to what was specified in the payload.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='MODAL_HEADER_UPDATE')
  modalHeaderUpdateReducer: private function(state: !UiSdlReduxState,
                                             action: !UiSdlModalHeaderUpdateAction): !UiSdlReduxState ts-client
}
