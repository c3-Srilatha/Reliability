/**
 * A filter field may be of type 'filter' or 'expression'.
 * A filter will have a predetermined set of options.
 * An expression may have 0-N options.
 */
enum type UiSdlFieldSetFilterFieldType {

  /**
   * Filter field type EXPRESSION.
   */
  EXPRESSION = 'expression'

  /**
   * Filter field type FILTER.
   */
  FILTER = 'filter'
}
