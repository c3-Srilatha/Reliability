/**
 * Produces component schemas for each JSON instantiable component in this package.
 */
private type UiComponentSchemaGenerator  {

  getUiComponents: function(): set<string> js-server

  generateComponentSchemas: function() js-server

  extractTypeNamesFromSchema: private function(schema: !json): [string] js-server
}
