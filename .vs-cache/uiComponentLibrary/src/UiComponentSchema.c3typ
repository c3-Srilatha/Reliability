/**
 * An entity type to represent the mapping between an instantiable component and its schema.
 * The specifications for running an npm command via {@link Es#Package#runNpmCommand}.
 */
entity type UiComponentSchema mixes SeedData, Identified {
  /**
   * The JSON schema for that type.
   */
  jsonSchema: json
}
