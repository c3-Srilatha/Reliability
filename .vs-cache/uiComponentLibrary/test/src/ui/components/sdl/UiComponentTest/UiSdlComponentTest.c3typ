/**
 * Test component to test {@link UiSdlComponent} functionality
 */
@typeScript
type UiSdlComponentTest mixes UiSdlComponent<UiSdlComponentDataSpecTest> {

  @uiSdlDataSpec(dataDestinationField='data')
  dataSpec: ~

  /**
   * Data of this component.
   */
  data: any

  /**
   * Trigger a `TEST_UI_ACTION`.
   */
  @uiSdlActionCreator(actionType='TEST_UI_ACTION')
  testUiAction: function(id: string, testStringData: string, testJsonData: json): UiSdlReduxAction ts-client

  /**
   * Triggers a `TEST_ACTION`.
   */
  @uiSdlActionCreator(actionType='TEST_ACTION')
  testAction: function(id: string, payload: json): UiSdlReduxAction ts-client

  /**
   * Listens to `TEST_UI_ACTION`.
   */
  @uiSdlReducer(actionType='TEST_UI_ACTION')
  uiTestEffect: function(state: UiSdlReduxState, action: UiSdlReduxAction): UiSdlReduxState ts-client
}
