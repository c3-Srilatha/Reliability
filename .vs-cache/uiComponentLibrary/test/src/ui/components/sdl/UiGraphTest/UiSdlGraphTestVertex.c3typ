/**
 * Vertex to assist in testing `UiSdlGraphData#uiGraphDataFetch`.
 */
entity type UiSdlGraphTestVertex schema name 'UIGTESTV' {

  /**
   * Category of the node.
   */
  category: string

  /**
   * Size of the nodes displayed in the graph.
   */
  symbolSize: double

  /**
   * Value of the nodes displayed in the graph.
   */
  value: int

  /**
   * The value of x-axis position of the node.
   */
  xAxis: double

  /**
   * The value of x-axis position of the node.
   */
  yAxis: double

  /**
   * The datetime this node is associated with.
   */
  event: datetime

  /**
   * A string describing the location of the entity the node represents.
   */
  location: string
}
