/**
 * Wrapprt component to test {@link UiSdlForm} functionality.
 */
@typeScript
type UiSdlFormPageTest mixes UiSdlComponent<UiSdlNoData> {

  /**
   * Selector for component reference.
   */
  componentReferenceSelector: string = '.form-section-item button'

  /**
   * Title of the page.
   */
  title: string

  /**
   * Children of the page component.
   */
  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]
}
