/**
 * Representation of the {@link UiSdlCardList} component for testing purposes.
 */
type LukeTestUiSdlCardList mixes LukeTestComponent {

  parentSelector: ~ = '.page-content'

  /**
   * The selector for the card list.
   */
  cardListSelector: private string = '.c3-sdl-card-list'

  /**
   * The selector for card list title.
   */
  cardListTitleSelector: private string = '.c3-card-title .c3-sdl-card-list-title'

  /**
   * The selector for the card list header.
   */
  cardListHeaderSelector: private string = '.c3-sdl-card-list-header a'

  /**
   * The selector for a card within the card list component.
   */
  cardSelector: private string = '.c3-sdl-card'

  /**
   * The selector for the card headline.
   */
  cardHeadlineSelector: private string = '.c3-sdl-card-headline'

  /**
   * The selector for an indicator bar within a card component.
   */
  indicatorBarSelector: private string = '.c3-sdl-indicator-bar'

  /**
   * The selector for card buttons.
   */
  cardButtonsSelector: private string = '.c3-sdl-card-buttons'

  /**
   * Get the number of cards in this card list.
   *
   *  @param index: Zero-based index of which cardlist component to return
   *  @return: LukeAsyncQueueNode
   */
  getNumberOfCardsWithIndex: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Gets the title of the CardList
   *
   *  @param index: Zero-based index of which cardlist component to return
   *  @return: LukeAsyncQueueNode
   */
  getCardListTitleWithIndex: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Get the CardList Component at specified index
   *
   *  @param index: Zero-based index of which cardlist component to return
   *  @return: LukeAsyncQueueNode
   */
  getCardListComponentWithIndex: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Get the CardList Component with specified title
   *
   *  @param title: Title to search for
   *  @return: LukeAsyncQueueNode
   */
  getCardListComponentWithTitle: inline member function(title: string): LukeAsyncQueueNode js

}
