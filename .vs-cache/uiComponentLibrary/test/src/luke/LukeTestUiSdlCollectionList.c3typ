/**
 * Representation of the {@link UiSdlCollectionList} component for testing purposes.
 */
type LukeTestUiSdlCollectionList mixes LukeTestComponent {

  /**
   * Selector for collection list
   */
  collectionListSelector: string = '.c3-sdl-collection-list'

  /**
   * Selector for collection list item
   */
  listItemSelector: string = '.c3-sdl-list-item'

  /**
   * Selector for collection list primary values
   */
  primaryValueSelector: string = '.c3-sdl-collection-list .c3-list-primary-description'

  /**
   * Selector for collection list secondary values
   */
  secondaryValueSelector: string = '.c3-sdl-collection-list .c3-list-secondary-description'

  /**
   * Selector for collection list delete option in the dropdown menu
   */
  deleteItemOptionSelector: string = '.c3-button-times'

  /**
   * Get all list items in the collection list
   * @return All found elements.
   */
  getAllListItems: inline member function(): [LukeWebElement] js

   /**
   * Get primary values array from collection list
   *
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the primary values
   */
  getPrimaryValues: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Get secondary values array from collection list
   *
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the secondary values
   */
  getSecondaryValues: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Clicks on the nth item in the collection list using a zero-based index.
   *
   * @param index
   *           The index of the item to click. Zero-indexed.
   * @param timeout
   *            Timeout in seconds for the chain.
   * @return the clicked element.
   */
  clickItemAtIndex: inline member function(index: !int, timeout: int): LukeWebElement js

  /**
   * Click the item in the collection list with the matching text
   */
  clickItemWithText: inline member function(text: !string, timeout: int): LukeAsyncQueueNode js

  /**
   * Drags and drops a list item to the specified selector.
   *
   * @param index
   *           The index of the item to drag and drop. Zero-indexed.
   * @param toSelector
   *           A selector indicating where to drop the list item.
   * @param timeout
   *            Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the drag and drop elements in type `LukeDragAndDropResult`
   */
  dragAndDropItemFromIndex: inline member function(index: !int,
                                                   toSelector: !string,
                                                   timeout: int): LukeAsyncQueueNode js
}
