/**
 * Luke test type that changes the value of `inputEl`, so it works for an input
 * in a grid cell.
 */
type LukeTestUiSdlBaseDataGridTextInput mixes LukeTestUiSdlTextInput {

  /**
   * Selector for the editable input element in a grid
   */
  inputEl: ~ = 'input.k-textbox'
}
