/**
 * Representation of the {@link UiSdlDefinitionList} component for testing purposes.
 */
type LukeTestUiSdlDefinitionList mixes LukeTestComponent {

  /**
   * Definition list
   */
  definitionList: string = '.c3-sdl-definition-list'

  /**
   * Definition list labels
   */
  definitionListHeaders: string = '.c3-sdl-definition-list .header'

  /**
   * Definition list contents
   */
  definitionListDescriptions: string = '.c3-sdl-definition-list .description'

  /**
   * Get header array from definition list
   *
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the headers
   */
  getHeaders: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Get description array from definition list
   *
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the descriptions
   */
  getDescriptions: inline member function(timeout: int): LukeAsyncQueueNode js
}
