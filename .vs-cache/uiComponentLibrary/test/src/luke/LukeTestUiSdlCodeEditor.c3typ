/**
 * Representation of the {@link UiSdlCodeEditor} component for testing purposes.
 */
type LukeTestUiSdlCodeEditor mixes LukeTestComponent {

  parentSelector: ~ = '.page-content'
  
  renderingSelectors: ~ = ['.c3-sdl-code-editor']

  /**
   * Selector for the code editor's title
   */
  titleSelector: string = '.c3-sdl-code-editor .c3-sdl-code-editor-title'

  /**
   * Selector for the code editor's action group
   */
  actionsSelector: string = '.c3-sdl-code-editor .c3-sdl-code-editor-actions'

  /**
   * Selector for the code editor's content
   */
  contentSelector: string = '.c3-sdl-code-editor .c3-sdl-code-editor-content .ace_content'

   /**
   * Gets the text of the title
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the text
   */
  getTitleText: inline member function(timeout: int): LukeAsyncQueueNode js

   /**
   * Gets the content of the code editor
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the content
   */
  getCodeContent: inline member function(timeout: int): LukeAsyncQueueNode js
}
