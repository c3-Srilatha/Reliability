/**
 * Representation of the {@link UiSdlTextInput} component for testing purposes.
 */
type LukeTestUiSdlTextInput mixes LukeTestComponent {

  parentSelector: ~ = '.page-content .c3-sdl-filterpanel'

  /**
   * Selector for the input element
   */
  inputEl: string = 'input.c3-form-field'

  /**
   * The selector to click to enable the confirmable input
   */
  confirmableInputActivationSelector: string = 'input.c3-form-field'

  /**
   * Selector for the confirmable input button containers
   */
  confirmableButtonContainerSelector: string = '.c3-input-confirmable-container'

  /**
   * Selector for check button on a confirmable text input
   */
  confirmableCheckButtonSelector: string = '.c3-button-check'

  /**
   * Selector for cancel button on a confirmable text input
   */
  confirmableCancelButtonSelector: string = '.c3-button-times'

  /**
   * Clicks on the input to enable the confirmation buttons
   */
  enableConfirmableInput: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Confirms the confirmable input
   */
  confirmConfirmableInput: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Cancels the confirmable input
   */
  cancelConfirmableInput: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Sets value on the input
   * @param value
   *          The value to be set
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the value is set
   */
  setValue: inline member function(value: string, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets value on the input
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the value
   */
  getValue: inline member function(timeout: int): LukeAsyncQueueNode js
}
