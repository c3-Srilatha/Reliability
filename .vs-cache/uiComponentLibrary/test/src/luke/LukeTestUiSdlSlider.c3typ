/**
 * Representation of the {@link UiSdlSlider} component for testing purposes.
 */
type LukeTestUiSdlSlider mixes LukeTestComponent {

  parentSelector: ~ = '.c3-slider'

  /**
   * The selector for the handle on the slider that changes its value
   */
  sliderHandle: string = 'div.rc-slider-handle'

  /**
   * The text input for the slider that changes its value
   */
  sliderInput: string = 'input.slider-input'

  /**
   * Sets the value of the slider to a specific number
   */
  setValue: member function(value: int): LukeAsyncQueueNode js-client

  /**
   * Get the value of the slider
   */
  getValue: member function(): LukeAsyncQueueNode js-client

  /**
   * Gets the maximum value that the slider can be set to
   * @return The maximum value of the slider
   */
  getMaxValue: member function(): LukeAsyncQueueNode js-server
}
