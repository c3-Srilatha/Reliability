/**
 * Representation of the {@link UiSdlSelectInput} component for testing purposes.
 */
type LukeTestUiSdlSelectInput mixes LukeTestComponent {

  rendered:       ~ js-server
  parentSelector: ~ = '.page-content .c3-form-group'

  /**
   * A class that identifies whether the input is a multi-select dropdown
   */
  multipleSelectClass: string = '.multiple'

  /**
   * The clear button
   */
  clearButton: string = 'i.delete'

  /**
   * Selector for the dropdown button (expand)
   */
  dropdownButtonEl: string = 'i.c3-icon-caret-down'

  /**
   * Selector for the dropdown button (collapse)
   */
  dropdownCollapseButtonSelector: string = 'i.c3-icon-caret-up'

  /**
   * Selector for the dropdown element where class names for various states (disabled, active, etc) are set
   */
  dropdownEl: string = '.c3-select-field-dropdown'

  /**
   * Selector for the option items
   */
  optionItem: string = 'div[role=option]'

  /**
   * Selector for a selected item in a single-select dropdown
   */
  selectedOptionItem: string = '.dropdown > .text:not(.default)'

  /**
   * Selector for a selected item in a multi-select dropdown
   */
  selectedOptionItemMultiple: string = '.multiple.dropdown > a'

  /**
   * Selector for a single-select dropdown without a selection
   */
  unselectedOptionItem: string = '.dropdown > .text.default'

  /**
   * Opens the dropdown to show the selectable options
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the selected values as an array of strings
   */
  openOptions: inline member function(timeout: int): LukeAsyncQueueNode js-client

  /**
   * Closes the dropdown to hide the selectable options
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the selected values as an array of strings
   */
  closeOptions: inline member function(timeout: int): LukeAsyncQueueNode js-client

  /**
   * Returns the current value
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the selected values as an array of strings
   */
  getValue: inline member function(timeout: int): LukeAsyncQueueNode js-client

  /**
   * Sets value on the input
   * @param value
   *          The value(s) to be set
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the value is set
   */
  setValue: inline member function(value: string | [string], timeout: int): LukeAsyncQueueNode js

  /**
   * Clears all selected options, if the select field is clearable.
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the values are cleared
   */
  clear: inline member function(timeout: int): LukeAsyncQueueNode js
}
