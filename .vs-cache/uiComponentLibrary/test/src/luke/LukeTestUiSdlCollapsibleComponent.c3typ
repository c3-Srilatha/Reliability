/**
 * Representation of the {@link UiSdlCollapsibleComponent} component for testing purposes.
 */
type LukeTestUiSdlCollapsibleComponent mixes LukeTestComponent {

  parentSelector: ~ = '.c3-sdl-collapsible-component'

  /**
   * Selector for the collapsible component's title section {@link UiSdlCollapsibleComponent}
   */
  titleSectionSelector: private string = '.title-section'

  /**
   * Selector for the collapsible component's title {@link UiSdlCollapsibleComponent}
   */
  titleSelector: private string = '.title.c3-button-lg'

  /**
   * Selector for the collapsible component's secondaryTitle when it's a button {@link UiSdlCollapsibleComponent}
   */
  secondaryTitleAsButtonSelector: private string = '.c3-sdl-collapsible-component-secondary-title-link'

  /**
   * Selector for the collapsible component's secondaryTitle when it's text {@link UiSdlCollapsibleComponent}
   */
  secondaryTitleAsTextSelector: private string = '.c3-sdl-collapsible-component-secondary-title'

  /**
   * Selector for the collapsible component's content (child components) {@link UiSdlCollapsibleComponent}
   */
  contentSelector: private string = '.content'

  /**
   * Gets the childNum child element of the collapsible component
   * @param childSelector
   *           The selector for the child
   * @param childNum
   *           Indicates which child to return
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the tab text
   */
  getChildEl: inline member function(childSelector: string, childNum: int, timeout: int): LukeAsyncQueueNode js

  /**
   * Determines if the content is active or hidden
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the tab text
   */
  hasVisibleContent: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Clicks title element to toggle collapsing of component
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the tab text
   */
  toggleCollapse: inline member function(timeout: int): LukeAsyncQueueNode js

  rendered: ~ js-client
}
