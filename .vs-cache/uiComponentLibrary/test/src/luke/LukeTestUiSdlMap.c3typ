/**
 * Representation of the {@link UiSdlMap} component for testing purposes.
 */
type LukeTestUiSdlMap mixes LukeTestComponent {

  rendered: ~ js

  /**
   * The selector of the map's surrounding element
   */
  mapSelector: string = '.c3-sdl-map'

  /**
   * The selector of a marker on the map.
   */
  mapMarkerSelector: string = '.c3-sdl-map-marker'

  /**
   * The selector of the tooltip.
   */
  tooltipSelector: string = '.c3-sdl-map-tooltip'

  /**
   * The selector of the tooltip header.
   */
  tooltipHeaderSelector: string = '.c3-sdl-map-tooltip-header'

  /**
   * The selector of the tooltip subheader.
   */
  tooltipSubHeaderSelector: string = '.c3-sdl-map-tooltip-sub-header'

  /**
   * The selector of the tooltip additional fields.
   */
  tooltipAdditionalFieldsSelector: string = '.c3-sdl-map-tooltip-additional-fields'

  /**
   * The definition list used for the tooltip additional fields.
   */
  tooltipAdditionalFields: LukeTestUiSdlDefinitionList

  /**
   * The selector for the title of the map.
   */
  titleSelector: string = '.c3-card-title'

  /**
   * The selector of the map's "Zoom In" button.
   */
  zoomInButtonSelector: string = '.mapboxgl-ctrl-zoom-in'

  /**
   * The selector of the map's "Zoom Out" button.
   */
  zoomOutButtonSelector: string = '.mapboxgl-ctrl-zoom-out'

  /**
   * Returns the title of the map.
   *
   * @returns a {@link LukeAsyncQueueNode} that will be resolved with the title of the map.
   */
  getTitle: inline member function(): LukeAsyncQueueNode js-client

  /**
   * Zooms in to the map.
   *
   * @returns a {@link LukeAsyncQueueNode} that will be resolved when the zoom in button has been clicked.
   */
  zoomIn: inline member function(): LukeAsyncQueueNode js-client

  /**
   * Zooms out from the map.
   *
   * @returns a {@link LukeAsyncQueueNode} that will be resolved when the zoom out button has been clicked.
   */
  zoomOut: inline member function(): LukeAsyncQueueNode js-client

  /**
   * Returns count of number of markers on map.
   *
   * @returns a {@link LukeAsyncQueueNode} that will be resolved with the number of markers.
   */
  numberOfMarkers: inline member function(): LukeAsyncQueueNode js-client

  /**
   * Clicks on a marker with the given label. The marker must be clickable (i.e. have a label and be in view on the map).
   * @param label
   *           The aria-label of the marker
   * @returns a {@link LukeAsyncQueueNode} that will be resolved when the marker is clicked.
   */
  clickMarker: inline member function(label: string): LukeAsyncQueueNode js-client

  /**
   * Returns the color of the marker with the given label.
   *
   * @returns a {@link LukeAsyncQueueNode} that will be resolved with the six-digit hex value color of the marker.
   */
  getMarkerColor: inline member function(label: string): LukeAsyncQueueNode js-client

  /**
   * Returns the tooltip header.
   *
   * @returns a {@link LukeAsyncQueueNode} that will be resolved with the tooltip header.
   */
  getTooltipHeader: inline member function(): LukeAsyncQueueNode js-client

  /**
   * Returns the tooltip subheader.
   *
   * @returns a {@link LukeAsyncQueueNode} that will be resolved with the tooltip subheader.
   */
  getTooltipSubHeader: inline member function(): LukeAsyncQueueNode js-client

  /**
   * Returns the tooltip additional fields.
   *
   * @returns a {@link LukeAsyncQueueNode} that will be resolved with the tooltip additional fields.
   */
  getTooltipAdditionalFields: inline member function(): LukeAsyncQueueNode js-client

  /**
   * Returns the CSS class name of a marker based on its label
   * @param markerSelector
   *          The selector of a marker on the map.
   * @param label
   *          The label of the marker
   * @return a CSS class name
   */
  markerSelectorWithLabel: inline member function(markerSelector: string, label: string): string js-client
}
