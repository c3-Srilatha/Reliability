/**
 * Representation of the {@link UiSdlCheckboxTree} component for testing purposes.
 */
type LukeTestUiSdlCheckboxTree mixes LukeTestComponent {

  parentSelector: ~ = '.page-content .c3-form-group'

  /**
   * Selector for checkbox node
   */
  checkboxNodeSelector: string = '.rct-node .rct-text'

  /**
   * Selector for checkbox label
   */
  checkboxLabelSelector: string = '.rct-title'

  /**
   * Selector for checkbox input. The hidden input indicates the value of the checkbox
   */
  checkboxInputSelector: string = 'input[type=checkbox]'

  /**
   * Selector for checkbox button. The button triggers input change.
   */
  checkboxButtonSelector: string = 'span.rct-checkbox'

  /**
   * Selector for selected checkbox button. The button triggers input change.
   */
  checkboxIconSelectedSelector: string = '.rct-icon-check'

  /**
   * Selector for unselected checkbox button. The button triggers input change.
   */
  checkboxIconUnselectedSelector: string = '.rct-icon-uncheck'

  /**
   * Selector for half selected checkbox button. The button triggers input change.
   */
  checkboxIconHalfSelectedSelector: string = '.rct-icon-half-check'

  /**
   * Selector for checkbox collapse button.
   */
  checkboxCollapseButtonSelector: string = '.rct-collapse-btn'

  /**
   * Selector for opened checkbox collapse button.
   */
  checkboxCollapseButtonOpenedSelector: string = '.rct-icon-expand-open'

  /**
   * Clears all selections
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the values are cleared
   */
  clearAll: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Sets value on the checkbox tree
   * @param value
   *          The values to be checked
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the values are set
   */
  setValue: inline member function(value: [string], timeout: int): LukeAsyncQueueNode js

  /**
   * Returns the current value
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the checked values as an array of strings
   */
  @deprecated
  getValue: inline member function(timeout: int): LukeAsyncQueueNode js-client

  /**
   * Clicks checkbox by index
   * @param index
   *          The index to be checked
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the values are set
   */
  clickCheckboxByIndex: inline member function(index: int, timeout: int): LukeAsyncQueueNode js

  /**
   * Get all checkbox elements in the checkbox tree.
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueCollection} of all {@link LukeAsyncQueueNode} checkbox elements
   */
  getAllCheckboxes: inline member function(timeout: int): LukeAsyncQueueCollection<LukeAsyncQueueNode> js

  /**
   * Clicks the collapse button by index.
   * @param index
   *          Index value
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the collapse button is clicked
   */
  clickCollapseButtonByIndex: inline member function(index: int, timeout: int): LukeAsyncQueueNode js

  /**
   * Collapses all opened nested checkboxes.
   * @return a {@link LukeAsyncQueueNode} that will be resolved when all the collapse buttons are in closed state.
   */
  collapseAllCheckboxes: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Get all selected checkbox elements in the checkbox tree.
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueCollection} of all {@link LukeAsyncQueueNode} selected checkbox elements
   */
  getAllSelectedCheckboxes: inline member function(timeout: int): LukeAsyncQueueCollection<LukeAsyncQueueNode> js

  /**
   * Get all unselected checkbox elements in the checkbox tree.
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueCollection} of all {@link LukeAsyncQueueNode} unselected checkbox elements
   */
  getAllUnselectedCheckboxes: inline member function(timeout: int): LukeAsyncQueueCollection<LukeAsyncQueueNode> js

  /**
   * Get all the half selected checkbox elements in the checkbox tree.
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueCollection} of all {@link LukeAsyncQueueNode} half selected checkbox elements
   */
  getAllHalfSelectedCheckboxes: inline member function(timeout: int): LukeAsyncQueueCollection<LukeAsyncQueueNode> js

  /**
   * Asserts total checkbox length
   * @param length
   *          Length of checkbox
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the length is asserted
   */
  assertCheckboxLength: inline member function(length: int, timeout: int): LukeAsyncQueueNode js

  /**
   * Asserts the values passed in with the current selected value
   * @param values
   *          Array of string of values to check against current selected value
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the length is asserted
   */
  assertAllCheckboxValues: inline member function(values: [string], timeout: int): LukeAsyncQueueNode js
}
