/**
 * Test React components helper functions for LukeTests.
 */

@beta
type LukeTestReactComponentsHelper  {

  /**
   * The Luke instance attached to this component.
   */
  // TODO: use !mixing LukeCore
  luke: !LukeBrowser

  /**
   * Serialize a function to an array of strings and a string.
   * The result can be use to create a new function using the Function constructor.
   * @param func 
   *            The function to serialize
   * @return [[string], string]
   *            The serialized function as an array of strings and a string.
   *            The first element of the array is the function arguments.
   *            The second element of the array is the function body.
   */
  serializeFunction: inline member function(func: any): any js-client

  /**
   * Find React component using a dom selector.
   * @param domSelector
   *            The dom element selector where it should start looking for the React component
   * @param traverseUp 
   *            How many levels to traverse up from the given element (ancestry level)
   * @param callback
   *            Callback function to be called when the React component is found.
   *            It will be called with the React component as the first argument.
   * @return {@link UiSdlReactElement} 
   *            The result of the callback function. 
   *            As default it will return the React component props.
   */
  findReactComponent: inline member function(domSelector: !string, traverseUp: int = 0, callback: any): any js-client
}
