/**
 * Representation of the {@link UiSdlTabPanel} component for testing purposes.
 */
type LukeTestUiSdlTabPanel mixes LukeTestComponent {

  rendered:       ~ js-server
  parentSelector: ~ = '.c3-sdl-tabpanel'

  /**
   * Selector for the tab panel's title section {@link UiSdlTabPanel}
   */
  titleSectionSelector: private string = '.c3-sdl-tabpanel-title-section'

  /**
   * Selector for the tab panel's title {@link UiSdlTabPanel}
   */
  titleSelector: string = '.c3-sdl-tabpanel-title-content'

  /**
   * Selector for the tab panel's sub-title {@link UiSdlTabPanel}
   */
  subTitleSelector: private string = '.c3-sdl-tabpanel-subtitle-content'

  /**
   * Selector for the tab panel's detail text {@link UiSdlTabPanel}
   */
  bodyTextSelector: private string = '.c3-sdl-tabpanel-detail-content'

  /**
   * Selector for the tab panel's tile section {@link UiSdlTabPanel}
   */
  tileParentSelector: private string = '.c3-sdl-tabpanel-title'

  /**
   * Selector for the tab panel's tiles {@link UiSdlTabPanel}
   */
  tileSelector: private string = '.c3-sdl-tabpanel-tile'

  /**
   * Selector for the tab panel's button section {@link UiSdlTabPanel}
   */
  buttonParentSelector: private string = '.c3-sdl-tabpanel-actions'

  /**
   * Selector for the tab panel's primary button {@link UiSdlTabPanel}
   */
  primaryButtonSelector: private string = '.c3-button-primary'

  /**
   * Selector for the tab panel's secondary button {@link UiSdlTabPanel}
   */
  secondaryButtonSelector: private string = '.c3-button-secondary'

  /**
   * Selector for the tab panel's tab section {@link UiSdlTabPanel}
   */
  tabParentSelector: private string = '.tab-container-inner'

  /**
   * Selector for the tab panel's tabs {@link UiSdlTabPanel}
   */
  tabSelector: private string = '.c3-sdl-tab'

  /**
   * Selector for the tab panel's current active tab {@link UiSdlTabPanel}
   */
  activeTabSelector: private string = '.c3-sdl-tab.active'

  /**
   * Gets the title of the tab panel
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the title
   */
  title: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the subtitle of the tab panel
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the subtitle
   */
  subTitle: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the body text of the tab panel
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the body text
   */
  bodyText: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the texts of the tiles
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with an array of tile text
   */
  tilesText: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the text of the primary button
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the button text
   */
  primaryButtonText: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the text of the secondary button
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the button text
   */
  secondaryButtonText: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the text of the tabs
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with an array of tab text
   */
  tabsText: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the text of the active tab
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the tab text
   */
  activeTabText: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Clicks the given tab name
   * @param tabName
   *          The name of the tab
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the target tab is clicked
   */
  clickTab: inline member function(tabName: !string, timeout: int): LukeAsyncQueueNode js

  /**
   * Clicks the given button type
   * @param buttonType
   *          The type of the button
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the target button is clicked
   */
  clickButton: inline member function(buttonType: !string enum('PRIMARY', 'SECONDARY'),
                                      timeout: int): LukeAsyncQueueNode js
}
