/**
 * A test type used for verifying a single item in a {@link UiSdlTreeList}.
 * This is used by {@link LukeTestUiSdlTreeList#checkItems}.
 */
private type LukeTestUiSdlTreeListItem {

  /**
   * The text that should appear for the item.
   */
  text: string

  /**
   * The icon that should appear for the item.  Ex. "database"
   */
  icon: string

  /**
   * The color of the icon that should appear for the item.  Ex. "lilac"
   */
  iconColor: string

  /**
   * If true, the item should have a button to collapse it.
   */
  isExpanded: boolean

  /**
   * If true, the item should have a button to expand it.
   */
  isCollapsed: boolean

  /**
   * If true, the item should be grayed out.
   */
  isDisabled: boolean

  /**
   * The expected item action icon names from left to right.  Ex. ["eye"]
   */
  itemActions: [string]
}
