/**
 * Representation of the {@link UiSdlDataGrid} component for testing purposes
 */
type LukeTestUiSdlFormDataGrid mixes LukeTestUiSdlBaseDataGrid {

  parentSelector:      ~ = '.c3-sdl-grid'
  columnNameWrapper: ~ = 'th .c3-k-header-content-wrapper'
  checkAllCheckbox:  ~ = 'th label.k-checkbox-label'
  rendered:          ~ js

  /**
   * Selector for the grid action bar
   */
  gridActionBar: string = '.c3-sdl-grid-action-bar'

  /**
   * Selector for the grid table action bar
   */
  gridTableActionBar: string = '.c3-sdl-grid-table-actions'

  /**
   * Selector for action buttons in the grid action bar
   */
  gridActionBarButton: string = '.c3-sdl-grid-action-bar .c3-sdl-action-button-group button'

  /**
   * Selector for the add row button in the grid action bar
   */
  gridAddRowButton: string = '.c3-sdl-grid-action-bar .c3-sdl-grid-table-actions button.c3-button-add-row'

  /**
   * Selector for action buttons in a grid row action
   */
  gridRowActionButton: string = '.action-cell .c3-sdl-action-button-group button'

  /**
   * Selector for a grid without any displayed records
   */
  noGridRecords: string = 'tr.k-grid-norecords'

  /**
   * Selector for the input element inside the search bar built into the SDLGrid
   */
  searchBarInput: string = '.c3-sdl-grid-filter-bar input'

  /**
   * Selector for filter bar in SDLGrid
   */
  gridFilterBarEl: string = '.c3-sdl-grid-filter-bar'

  /**
   * Selector for the first expand icon
   */
  expandIconSelector: string = '.k-grid tbody tr:not(.k-grid-norecords) td i:nth-of-type(1)'

  /**
   * Selector for the detail component that shows when a row is expanded
   */
  detailComponentSelector: string = '.k-grid tbody tr.k-detail-row td.k-detail-cell'

  /**
   * Asserts that the component rendered with content in the grid.
   * @param timeout
   *           Timeout in seconds of the assertion chain.
   */
  renderedWithContent: inline member function(timeout: int) js

  /**
   * Checks for the grid action bar to be rendered.
   * @param timeout
   *           Timeout in seconds of the chain.
   */
  renderedActionBar: inline member function(timeout: int): boolean js

  /**
   * Clicks an action cell
   * @param rowIndex
   *           The row index (1-based) of the action cell
   * @param colIndex
   *           The column index (1-based) of the action cell
   * @param additionalSelectors
   *           Additional css selectors to narrow the scope of content in a cell to click
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the action cell is clicked
   */
  clickCellAction: inline member function(rowIndex: int,
                                          colIndex: int,
                                          additionalSelectors: [string],
                                          timeout: int): LukeAsyncQueueNode js

  /**
   * Clicks a row
   * @param rowIndex
   *           The row index (1-based) of the action cell
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the row is clicked
   */
  clickRow: inline member function(rowIndex: int, timeout: int): LukeAsyncQueueNode js

  /**
   * Clicks a row action
   * @param rowIndex
   *           The row index (1-based) of the action cell
   * @param actionSelector
   *           The selector for the action button
   * @param nested
   *           Whether the action button is nested inside a dropdown list
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the row action is clicked
   */
  clickRowAction: inline member function(rowIndex: int,
                                         actionSelector: string,
                                         nested: boolean,
                                         timeout: int): LukeAsyncQueueNode js

  /**
   * Clicks a table action
   * @param actionSelector
   *           The selector for the action button
   * @param dropdownSelector
   *           Optional, only needed when the action is nested inside a dropdown
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the row action is clicked
   */
  clickTableAction: inline member function(actionSelector: string,
                                           dropdownSelector: string,
                                           timeout: int): LukeAsyncQueueNode js

  /**
   * Searches for all detail components ({@link #detailComponentSelector})
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with all found nested components
   */
  detailComponents: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Applies a search to the grid.  The grid must have search enabled for this to apply
   * @param searchString
   *            The string to apply when searching
   * @param timeout
   *            Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the result
   */
  searchInGrid: inline member function(searchString: string, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the text for all cells in the column with the given index.
   *
   * @param colIndex
   *           The index of the column (zero-indexed).
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the text of all cells in the given column.
   */
  getTextForCellsInColumn: inline member function(colIndex: !int, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the text for all cells in the row with the given index.
   *
   * @param rowIndex
   *           The index of the row (zero-indexed).
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the text of all cells in the given row.
   */
  getTextForCellsInRow: inline member function(rowIndex: !int, timeout: int): LukeAsyncQueueNode js

  /**
   * Clicks on a sortable column header to sort the grid by that column.
   * @param columnName
   *            The name of the column to sort
   * @param order
   *            (Optional) The desired sorting order, where a value of `none` will return the column to the default
   *            sorting order. If not provided, the sortable column header will be clicked once.
   * @param timeout
   *            Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the result
   */
  sortColumn: inline member function(columnName: !string,
                                     order: string enum('ascending', 'descending', 'none'),
                                     timeout: int): LukeAsyncQueueNode js

  /**
   * Returns a list of grid column elements.
   * @param includeHidden
   *            include hidden columns
   * @param detailGridOnly
   *            show detail Grid Only
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with column elements ({@link SeleniumWebElement})
   */
  columns: inline member function(includeHidden: boolean,
                                  detailGridOnly: boolean,
                                  timeout: int): LukeAsyncQueueNode js

  /**
   * Returns the number of columns.
   * @param includeHidden
   *  include hidden columns
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the number of rows
   */
  numColumns: inline member function(includeHidden: boolean, timeout: int): LukeAsyncQueueNode js
}
