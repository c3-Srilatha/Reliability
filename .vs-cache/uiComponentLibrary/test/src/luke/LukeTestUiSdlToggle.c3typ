/**
 * Representation of the {@link UiSdlToggle} component for testing purposes.
 */
type LukeTestUiSdlToggle mixes LukeTestComponent {

  /**
   * Selector for checkbox button
   */
  checkboxSelector: private string = '.c3-sdl-checkbox'

  /**
   * Selector for checkbox input saving the check value
   */
  checkboxInputSelector: private string = 'input[type="checkbox"]'

  /**
   * Selector for checking if the checkbox is selected
   */
  checkboxValueSelector: private string = '.checked'

  /**
   * Toggles the checkbox on the page
   */
  toggleCheckbox: inline member function() js-client

  /**
   * asserts whether the checkbox is checked or not
   */
  assertCheckboxValue: inline member function(checked: boolean) js-client
}
