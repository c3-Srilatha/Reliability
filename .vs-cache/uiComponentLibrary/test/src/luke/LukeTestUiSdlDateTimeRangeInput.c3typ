/**
 * Representation of the {@link UiSdlDateTimeRangeInput} component for testing purposes.
 */
type LukeTestUiSdlDateTimeRangeInput mixes LukeTestUiSdlTextInput {

  parentSelector: ~ = '.page-content .c3-sdl-daterange'

  /**
   * Selector for the starting date in the date range.
   */
  startDateSelector: string = '.c3-sdl-datetime:nth-of-type(1)'

  /**
   * Selector for the ending date in the date range.
   */
  endDateSelector: string = '.c3-sdl-datetime:nth-of-type(2)'

  /**
   * Helper function to set the start and end dates.
   *
   * @param startDate
   *            Datetime field to set the starting date in the range
   * @param endDate
   *            Datetime field to set the ending date in the range
   */
  setDateRange: inline member function(startDate: DateTime, endDate: DateTime): LukeAsyncQueueNode js

  /**
   * Helper function to set the start and end dates.
   *
   * @param startDateTime
   *            Datetime field to set the starting date time in the range
   * @param endDateTime
   *            Datetime field to set the ending date time in the range
   */
  setDateTimeRange: inline member function(startDateTime: DateTime, endDateTime: DateTime): LukeAsyncQueueNode js

}
