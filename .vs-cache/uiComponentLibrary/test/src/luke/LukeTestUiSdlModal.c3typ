/**
 * Representation of the {@link UiSdlModal} component for testing purposes.
 */
type LukeTestUiSdlModal mixes LukeTestComponent {

  /**
   * Selectors to check whether modal is rendered correctly
   */
  renderingSelectors: ~ = ['.c3-modal-body', '.c3-modal-close-button', '.c3-modal-content-total-container']

  /**
   * The selector of the modal's surrounding element
   */
  parentSelector: ~ = '.c3-modal'

  /**
   * The selector of the modal body's surrounding element
   */
  modalBodySelector: string = '.c3-modal-body'

  /**
   * Selector for the close button. Use {@link clickCloseButton} to close the modal.
   */
  closeButtonSelector: string = '.c3-modal-close-button button'

  /**
   * Selector for the background that is blurred out when a modal is rendered
   */
  dimmerSelector: string = '.dimmer'

  /**
   * Selector for the header
   */
  headerSelector: string = '.header'

  /**
   * Selector for the sub-header
   */
  subHeaderSelector: string = '.c3-modal-sub-header'

  /**
   * Selector for the content
   */
  contentSelector: string = '.c3-modal-content-total-container'

  /**
   * Selector for the primary button
   */
  primaryButtonSelector: string = '.c3-modal-actions .c3-button-primary'

  /**
   * Selector for the danger button
   */
  dangerButtonSelector: string = '.c3-modal-actions .c3-button-danger'

  /**
   * Selector for the secondary button
   */
  secondaryButtonSelector: string = '.c3-modal-actions .c3-button-secondary'

  /**
   * Selector for the danger secondary button
   */
  secondaryDangerButtonSelector: string = '.c3-modal-actions .c3-button-danger-secondary'

  /**
   * Selector for the tertiary button
   */
  tertiaryButtonSelector: string = '.c3-modal-actions .c3-button-link'

  /**
   * Selector for the division line at the top of the content
   */
  topDivisionLineSelector: string = '.c3-modal-content-viewport.top-border'

  /**
   * Selector for the division line at the bottom of the content
   */
  bottomDivisionLineSelector: string = '.c3-modal-content-viewport.bottom-border'

  /**
   * Clicks a modal button and optionally waits for the modal to close
   * @param buttonType
   *            The type of button to click
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the button is clicked
   */
  clickButton: inline member function(buttonType: !string enum('primary', 'danger', 'secondary', 'secondary-danger', 'tertiary', 'close'))
                               : LukeAsyncQueueNode js-client

  /**
   * Gets the text rendered in the modal header.
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the modal header text.
   */
  getHeaderText: inline member function(timeout: int): LukeAsyncQueueNode js-client

  /**
   * Gets the text rendered in the modal content.
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the modal content text.
   */
  getContentText: inline member function(timeout: int): LukeAsyncQueueNode js-client

  /**
   * Checks if the primary button is enabled
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with whether or not the primary button is enabled
   */
  isPrimaryButtonEnabled: inline member function(timeout: int): LukeAsyncQueueNode js-client

  rendered: ~ js-client
}
