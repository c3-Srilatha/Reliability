/**
 * The base type for data grid component test types, e.g. {@link LukeTestUiSdlDataGrid}.
 */
type LukeTestUiSdlBaseDataGrid mixes LukeTestComponent {

  /**
   * Mappings of field types to their helper types
   */
  fieldHelperMapping: json = {SDLInput: 'LukeTestUiSdlBaseDataGridTextInput', SDLSelectField: 'LukeTestUiSdlSelectInput', SDLCheckboxTree: 'LukeTestUiSdlCheckboxTree'}

  /**
   * Selector for the grid
   */
  gridSelector: string

  /**
   * Selector for the header
   */
  headerSelector: string = '.c3-card-title-subtitle-container'

  /**
   * Selector for the grid title
   */
  titleSelector: string = '.c3-card-title-subtitle-container label'

  /**
   * Selector for the grid subtitle
   */
  subtitleSelector: string = '.c3-card-title-subtitle-container .c3-card-subtitle-content'

  /**
   * Selector for the grid content
   */
  contentEl: string = '.k-grid-content'

  /**
   * Selector for a grid row
   */
  rowEl: string = 'tbody tr:not(.k-grid-norecords)'

  /**
   * Selector for element that wraps the column names
   */
  columnNameWrapper: string = 'th span:not(.header-addition):not(.k-icon)'

  /**
   * Selector for the "check all" checkbox in the header
   */
  checkAllCheckbox: string = '.c3-kendogrid thead tr:first-child th:first-child input[type=checkbox]'

  /**
   * Selector for [+] button to add a row to the grid
   */
  addRowButton: string = '.c3-button-add-row'

  /**
   * Selector for the button to save data added or edited in the grid
   */
  saveDataButton: string = '.c3-sdl-grid-action-bar .c3-button-primary'

  /**
   * Selector for the save button loading state (spinner)
   */
  saveDataButtonLoadingState: string = '.c3-sdl-grid-action-bar .c3-button-primary.c3-button-loading'

  /**
   * Selector for the save button in normal state, distinguished from loading state.  Need this selector
   * because using saveDataButton would also match saveDataButtonLoadingState
   */
  saveDataButtonNonLoadingState: string = '.c3-sdl-grid-action-bar .c3-button-primary:not(.c3-button-loading)'

  /**
   * Gets the title text of the grid
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the text of the title
   */
  getHeaderTitleText: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the subtitle text of the grid
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the text of the subtitle
   */
  getHeaderSubtitleText: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the number of rows.
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the number of rows
   */
  numberOfRows: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the text for the cell given a row index and column index
   *
   * @param rowIndex
   *           The index of the row (one-based index)
   * @param colIndex
   *           The index of the column (one-based index)
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the cell text
   */
  cellText: inline member function(rowIndex: !int, colIndex: !int, timeout: int): LukeAsyncQueueNode js

  /**
   * Get text from all cells in this grid
   *
   * @return an array of cells text
   */
  getAllCellsText: inline member function(timeout: int): LukeAsyncQueueCollection<LukeAsyncQueueNode> js

  /**
   * Returns an array of rows where each row is an object that maps the column name to its value.
   *
   * Ex:
   * ```
   * [
   *   { APPLICATION_NAME: 'tools', STATUS: 'Responsive' }, // row 1
   *   { APPLICATION_NAME: 'uiDemo', STATUS: 'Inactive' } // row 2
   * ]
   * ```
   */
  getAllCellsTextMap: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Returns all grid cells
   */
  getAllCells: inline member function(timeout: int): LukeAsyncQueueCollection<LukeWebElement> js

  /**
   * Click on a cell
   * @param rowNumber
   *           The row whose cell needs to be clicked, 1-indexed
   * @param colNumber
   *           The column whose cell needs to be clicked, 1-indexed
   * @param additionalSelectors
   *           Additional css selectors to narrow the scope of content in a cell to click
   *           In the case of editable cells with content that needs to be clicked the narrowing down to a part of the
   *           cell is required
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the cell is clicked
   */
  clickCell: inline member function(rowNumber: !int,
                                    colNumber: !int,
                                    additionalSelectors: [string],
                                    timeout: int): LukeAsyncQueueNode js

  /**
   * Click a link that resides in a Kendo Grid cell. Clicks the first link with the matching text.
   *
   * @param  linkText
   *            The text of the link to click
   */
  clickLinkInCell: inline member function(linkText: !string): LukeAsyncQueueNode js

  /**
   * Generates the selector for the cell of the given row index and column index
   *
   * @param rowIndex
   *           The index of the row (one-based index)
   * @param colIndex
   *           The index of the column (one-based index)
   * @param additionalSelectors
   *           Additional css selectors to narrow the scope of content in a cell to click
   *           In the case of editable cells with content that needs to be clicked the narrowing down to a part of the
   *           cell is required
   * @return the selector for the cell
   */
  cellSelector: inline member function(rowIndex: !int, colIndex: !int, additionalSelectors: [string]): string js

  /**
   * Generates the selector for the row of the given index
   *
   * @param rowIndex
   *           The index of the row (one-based index)
   * @return the selector for the row
   */
  rowSelector: inline member function(rowIndex: !int): string js

  /**
   * Selects all rows by clicking {@link #checkAllCheckbox}
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the selectAll checkbox is clicked
   */
  selectAll: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Checks whether a row is selected
   * @param rowIndex
   *           The index of the row (one-based index)
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the result
   */
  rowSelected: inline member function(rowIndex: !int, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the names of the columns
   * @return the name of the columns
   */
  columnNames: inline member function(): LukeAsyncQueueCollection<LukeAsyncQueueNode> js-client

  /**
   * Sets the value of the indicated field.
   * @param rowNumber
   *            The index of the row, 1-indexed
   * @param colIndex
   *            The index of the column, 1-indexed
   * @param additionalSelectors
   *           Additional css selectors to narrow the scope to the input field parent
   * @param fieldType
   *          The type of the field in the cell. Valid values: SDLSelectField, SDLInput, SDLCheckboxTree
   * @param value
   *          The value to be set.
   * @param timeout
   *           Timeout in seconds for the chain
   */
  setCellFieldValue: inline member function(rowNumber: int,
                                            colNumber: int,
                                            additionalSelectors: [string],
                                            fieldType: string enum('SDLSelectField', 'SDLInput', 'SDLCheckboxTree'),
                                            value: string | [string],
                                            timeout: int): LukeAsyncQueueNode js

  /**
   *  Gets the current value of the indicated field.
   *  @param rowNumber
   *            The index of the row, 1-indexed
   * @param colIndex
   *            The index of the column, 1-indexed
   * @param additionalSelectors
   *           Additional css selectors to narrow the scope to the input field parent
   * @param fieldType
   *          The type of the field in the cell. Valid values: SDLSelectField, SDLInput, SDLCheckboxTree
   * @param timeout
   *           Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the cell field value
   */
  getCellFieldValue: inline member function(rowNumber: int,
                                            colNumber: int,
                                            additionalSelectors: [string],
                                            fieldType: string enum('SDLSelectField', 'SDLInput', 'SDLCheckboxTree'),
                                            timeout: int): LukeAsyncQueueNode js
}
