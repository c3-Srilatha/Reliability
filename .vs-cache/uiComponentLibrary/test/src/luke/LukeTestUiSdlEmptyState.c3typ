/**
 * Representation of the {@link UiSdlEmptyState} component for testing purposes.
 */
type LukeTestUiSdlEmptyState mixes LukeTestComponent {

  parentSelector: ~ = '.c3-sdl-empty-state'

  /**
   * Selector for the image selector
   */
  imageSelector: string = 'img'

  /**
   * Selector for header text
   */
  headerTextSelector: string = '.c3-label-lg'

  /**
   * Selector for description text
   */
  descriptionTextSelector: string = '.c3-text-sm'

  /**
   * Selector for primary button
   */
  primaryButtonSelector: string = '.c3-button-primary'

  /**
   * Selector for secondary button
   */
  secondaryButtonSelector: string = '.c3-button-secondary'

  /**
   * Gets the header text of the empty state component
   *
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the header text
   */
  getHeaderText: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the description text of the empty state component
   *
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the description text
   */
  getDescriptionText: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Clicks an empty state button
   * @param buttonType
   *            The type of button to click
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the button is clicked
   */
  clickButton: inline member function(buttonType: !string enum('primary', 'secondary')): LukeAsyncQueueNode js-client
}
