/**
 * Representation of the {@link UiSdlPageTitle} component for testing purposes.
 */
type LukeTestUiSdlPageTitle mixes LukeTestComponent {

  rendered:       ~ js-server
  parentSelector: ~ = '.page-content .c3-sdl-page-title'

  /**
   * Selector for the page title element
   */
  titleSelector: string = '.sdl-page-title'

  /**
   * Selector for tab elements
   */
  tabSelector: string = '.c3-sdl-tab'

  /**
   * Selector for active tab selector
   */
  activeTabSelector: string = '.c3-sdl-tab.active'

  /**
   * Selector for global input field
   */
  globalInputFieldSelector: string = '.c3-sdl-page-title-input'

  /**
   * Switches to the tab with the given text
   *
   * @param tabName
   *           The tab to switch to
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved after switching the tab
   */
  switchTab: inline member function(tabName: !string, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the name of the currently active tab
   *
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the action tab name
   */
  activeTab: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the names of all the tabs
   *
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the tab names
   */
  getTabTitles: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Searches for a button element by title
   */
  getButtonElByTitle: inline member function(title: !string, timeout: int): LukeWebElement js

  /**
   * Sets value on the global input field
   * @param value
   *          The value(s) to be set
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the value is set
   */
  setGlobalFilterValue: inline member function(inputType: string enum('text', 'select'),
                                               value: string | [string],
                                               timeout: int): LukeAsyncQueueNode js
}
