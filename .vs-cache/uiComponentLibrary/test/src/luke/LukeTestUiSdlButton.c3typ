/**
 * Representation of the {@link UiSdlButton} component for testing purposes.
 */
type LukeTestUiSdlButton mixes LukeTestComponent {

  rendered: ~ js

  /**
   * The parent selector for this button.  Should be provided because many buttons may exist on a page and the specificity or the
   * parent selector is the only way to safely find buttons
   */
  parentSelector: ~

  /**
   * The selector for the button
   */
  buttonSelector: string

  /**
   * Checks if the button is enabled.  Wrapper for {@link LukeWebElement#enabled}
   * @param timeout
   *        Luke async timeout for this operation
   * @return
   *        a {@link LukeAsyncQueueNode} that will be resolved with the result
   */
  enabled: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Clicks the button.  Wrapper for {@link LukeWebElement#click}
   * @return
   *        a {@link LukeWebElement} that will be resolved when the click succeeds
   */
  clickButton: inline member function(): LukeWebElement js
}
