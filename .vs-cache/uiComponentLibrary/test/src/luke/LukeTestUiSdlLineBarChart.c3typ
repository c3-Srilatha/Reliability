/**
 * Representation of the {@link UiSdlLineBarChart} component for testing purposes.
 */
type LukeTestUiSdlLineBarChart mixes LukeTestComponent {

  parentSelector: ~ = 'div.c3-sdl-chart'

  /**
   * The canvas where the chart is drawn.
   */
  canvas: string = 'canvas'

  /**
   * The canvas where the chart is drawn.
   */
  eChartsForReact: string = 'div.echarts-for-react'

  /**
   * The legend label
   */
  legendLabel: string = '.c3-sdl-chart-legend-label .c3-sdl-chart-series-name'

  /**
   * The tooltip
   */
  tooltip: string = '.c3-sdl-chart-tooltip'

  /**
   * The download dropdown selector
   */
  headerDropdownButtonSelector: string = '.c3-button-ellipsis-h'

  /**
   * The download dropdown menu item selector
   */
  downloadOptionSelector: string = '.c3-sdl-action-button-dropdown .item .text'

  /**
   * Returns the base64 string representation of the chart content
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with a base 64 string representation of the chart content
   */
  getChartContentBase64: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Returns the the number of legends
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the number of legends for the chart
   */
  numberOfLegends: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * The function to click a dropdown menu option to download the chart.
   * @param index
   *          index is 0-based, choose which item in the dropdown menu to click
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode}
   */
  clickDownloadDropdown: inline member function(index: int, timeout: int): LukeAsyncQueueNode js

  /**
   * Returns the text content of the chart tooltip
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the text content of the chart tooltip
   */
  getTooltipTextContent: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Hovers and clicks at the given coordinates relative to the chart canvas.
   * @param offsetX The x-coordinate offset for the events
   * @param offsetY The y-coordinate offset for the events
   * @return a {@link LukeAsyncQueueNode} returned from the {@link LukeBrowser#realClick}
   */
  clickChartCanvasAt: inline member function(offsetX: int, offsetY: int): LukeAsyncQueueNode js
}
