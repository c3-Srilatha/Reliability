/**
 * Representation of the {@link UiSdlRadioButtonGroup} component for testing purposes.
 */
type LukeTestUiSdlRadioButtonGroup mixes LukeTestComponent {

  parentSelector: ~ = '.c3-sdl-radio-button-group'

  /**
   * Selector for radio button
   */
  radioButtonInputSelector: string = '.c3-sdl-checkbox input'

  /**
   * Selector for radio button label
   */
  radioButtonLabelSelector: string = '.c3-sdl-checkbox label'

  /**
   * Sets the value of the radio button group
   *
   * @param value
   *          The value to set
   *
   * @param timeout
   *          The timeout in seconds
   */
  setValue: member function(value: string, timeout: int): json js-client
}
