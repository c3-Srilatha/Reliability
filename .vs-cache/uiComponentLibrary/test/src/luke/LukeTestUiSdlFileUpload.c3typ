/**
 * Representation of the {@link UiSdlFileUpload} component for testing purposes.
 */
type LukeTestUiSdlFileUpload mixes LukeTestComponent {

  rendered: ~ js-client

  /**
   * Main component seletor for component
   */
  componentSelector: string = '.c3-sdl-file-upload'

  /**
   * File Upload Input field selector
   */
  fileInputSelector: string = 'input.custom-file-input'

  /**
   * File upload collection selector
   */
  fileUploadCollectionSelector: string = '.c3-sdl-collection-list .c3-sdl-list-item'

  /**
   * Uploads a file to an input @param filePath
   * @param filePath
   *   Location of file to be uploaded
   * @returns
   *   a {@link LukeAsyncQueueNode} that will be resolved with files added to file upload
   */
  uploadFile: inline member function(filePath: string): LukeAsyncQueueNode js-client

  /**
   * Returns number of objects uploaded to component
   * @returns
   *  a {@link LukeAsyncQueueNode} that will be resolved with number of objects uploaded to component
   */
  numFilesUploaded: inline member function(): LukeAsyncQueueNode js-client
}
