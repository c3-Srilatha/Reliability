/**
 * Representation of the {@link UiSdlMetricTile} component for testing purposes.
 */
type LukeTestUiSdlMetricTile mixes LukeTestComponent {

  /**
   * The parent selector for the metric tile title.
   */
  parentSelector: ~ = '.c3-sdl-metric-tile'

  /**
   * The selector for the metric tile.
   */
  metricTileSelector: string = '.c3-sdl-metric-tile'

  /**
   * The selector for the metric tile title.
   */
  metricTileTitleSelector: string = '.c3-sdl-tile .c3-sdl-tile-title'

  /**
   * The selector for the metric tile title icon.
   */
  metricTileTitleIconSelector: string = '.c3-sdl-tile .c3-sdl-tile-title .c3-sdl-tile-header-icon'

  /**
   * The selector for the metric tile icon.
   */
  metricTileValueIconSelector: string = '.c3-sdl-tile-value-container .c3-icon'

  /**
   * The selector for the trend indicator
   */
  metricTileTrendIndicatorSelector: string = '.c3-sdl-tile .c3-sdl-tile-trend-indicator-value'

  /**
   * The selector for the trend indicator
   */
  metricTileTrendPercentageSelector: string = '.c3-sdl-tile .c3-sdl-tile-trend-indicator-percentage'

  /**
   * The selector for the metric tile value
   */
  metricTileValueSelector: string = '.c3-sdl-tile .c3-sdl-tile-value-container .c3-sdl-tile-value'

  /**
   * The seelctor for the horizontal labels of the sparkline
   */
  metricTileSparklineHorizontalLabelsSelector: string = '.c3-sdl-chart-content .c3-sdl-time-horizon-label'

  /**
   * The selector for the e-chart of the sparkline
   */
  metricTileSparklineChartSelector: string = '.c3-sdl-chart-content .echarts-for-react'

  /**
   * Gets the text of the metric tile title
   * @param timeout
   *          Timeout in seconds for the search
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the title text
   */
  getTitleText: inline member function (timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the icon of the metric tile title
   * @param timeout
   *          Timeout in seconds for the search
   * @return a {@link LukeWebElement} of the title icon element
   */
  getTitleIcon: inline member function (timeout: int): LukeWebElement js

  /**
   * Gets the text of the metric tile title icon tooltip
   * @param timeout
   *          Timeout in seconds for the search
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the tooltip text
   */
  getTitleIconTooltipText: inline member function (timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the text of the metric tile main value
   * @param timeout
   *          Timeout in seconds for the search
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the main value text
   */
  getTileMainValueText: inline member function (timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the text of the metric tile trend indicator
   * @param timeout
   *          Timeout in seconds for the search
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the trend indicator text
   */
  getTrendIndicatorText: inline member function (timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the percentage indicator of the metric tile
   * @param timeout
   *          Timeout in seconds for the search
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the trend indicator text
   */
  getTrendPercentage: inline member function (timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the text of the metric tile trend percentage indicator
   * @param timeout
   *          Timeout in seconds for the search
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the trend indicator text
   */
  getTrendPercentageText: inline member function (timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the text of the sparkline label 
   * @param timeout
   *          Timeout in seconds for the search
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the label text
   */
  getSparklineLabelText: inline member function (timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the text of the metric tile sparkline popup
   * @param timeout
   *          Timeout in seconds for the search
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the popup text
   */
  getSparklinePopupText: inline member function (timeout: int): LukeAsyncQueueNode js
}
