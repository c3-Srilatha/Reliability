{
  "name": "uiComponentLibrary",
  "description": "The type definitions for all UI components available in C3 AI UI Component Library",
  "author": "studio <studio@c3.ai>",
  "version": "8.9.0",
  "compatibleToVersion": "8.7",
  "dependencies": {
    "uiInfrastructure": "8.9"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@c3/c3-base",
      "plugin:@c3/typescript",
      "plugin:prettier/recommended"
    ],
    "plugins": [
      "@c3"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^e$|^_",
          "ignoreRestSiblings": true
        }
      ],
      "import/prefer-default-export": "off"
    }
  }
}
