/**
 * Specifies all of the props needed to render the legend on a {@link NodeDiagram}.
 */
@typeScript
type NodeDiagramLegend mixes UiSdlComponent<UiSdlNoData> {

  /**
   * A list of items to be displayed in the edge section of the legend
   */
  edgeItems: [NodeDiagramLegendEdgeItem]

  /**
   * A list of the node category registrations that specify how to render the node section of the legend
   */
  nodeItems: [NodeDiagramLegendNodeItem]

  /**
   * Title for the legend button.
   */
  legendBtnTitle: string = 'NodeDiagramLegend.LegendBtnTitle'

  /**
   * Title text for the nodes.
   */
  nodesTitle: string | UiSdlDynamicValueSpec = 'NodeDiagramLegend.NodeTitle'

  /**
   * Title text for the edges.
   */
  edgesTitle: string = 'NodeDiagramLegend.EdgeTitle'
}
