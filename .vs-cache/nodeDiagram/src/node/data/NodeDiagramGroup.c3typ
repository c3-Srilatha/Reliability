/**
 * A node that can group multiple nodes
 */
type NodeDiagramGroup mixes NodeDiagramNodeData, WithConnector {

  /**
   * The color associated with this node in RGB form. When specified the border and background will be this color.
   */
  color: string

  /**
   * Font awesome icon associated with this node. Will be rendered on the left hand side of the node.
   */
  icon: string

  /**
   * Icon color associated with this node.
   */
  iconColor: string
}
