/**
 * Base react rendering of custom nodes.
 * Note that this type only mixes `UiSdlComponent` so that `uiBundler` will pick up the `React.tsx` file.
 * Reference https://reactflow.dev/api-reference/types/node-props for the true props of the components.
 */
@typeScript
@uiSdlPluggable(namespace='nodeDiagramShapes')
abstract type NodeDiagramNodeReact<D> mixes ReactFunction, UiSdlComponent<any>, NodeDiagramNode<D> {
  render: ~ tsx-client
}
