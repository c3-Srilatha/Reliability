/**
 * Renders a basic rectangular node. Assumes single port for input, output. This also serves as the default node
 * if {@link NodeDiagramEdge#data#type} is not provided.
 */
type BasicDiagramNode mixes NodeDiagramNodeData, WithConnector {

  /**
   * The color associated with this node. When specified the left border and icon will be of this color.
   */
  color: string

  /**
   * Font awesome icon associated with this node. Will be rendered on the left hand side of the node.
   */
  icon: string
}
