/**
 * A very basic edge that renders as a solid Bezier path. This also serves as the default edge if {@link NodeDiagramEdge#data#type}
 * is not provided.
 */
type BasicDiagramEdge mixes NodeDiagramEdgeData {

  /**
   * Path type for the edge. {@link https://reactflow.dev/examples/edges/edge-types}
   */
  pathType: string enum('bezier', 'smoothstep', 'straight', 'step') = 'bezier'
}
