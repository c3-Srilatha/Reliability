/**
 * Base type for all edge rendering in a {@link NodeDiagram}.
 * Note that this type only mixes `UiSdlComponent` for bundling to process correctly. Do not treat this type
 * as an actual `UiSdlComponent`.
 * Reference https://reactflow.dev/api-reference/types/edge-props for true props coming into the component.
 */
@uiSdlPluggable(namespace='nodeDiagramShapes')
abstract type NodeDiagramEdgeReact<D> mixes ReactFunction, UiSdlComponent<any>, NodeDiagramEdge<D> {
  render: ~ tsx-client
}
