/**
 * Simple edge marker
 */
type NodeDiagramEdge.Marker {

  /**
   * 'arrow' will render an arrow (drawn with 2 lines)
   * 'arrowclosed' will render an arrow with the triangle filled
   */
  kind: string enum ('arrow', 'arrowclosed') = 'arrow'

  /**
   * The color of the arrow. Note that this color is not dynamic with edge selection.
   */
  color: string

  /**
   * Width of the arrow in {@link #markerUnits}
   */
  width: number

  /**
   * Height of the arrow in {@link #markerUnits}
   */
  height: number

  /**
   * https://developer.mozilla.org/en-US/docs/Web/SVG/Attribute/markerUnits
   */
  markerUnits: string

  /**
   * https://developer.mozilla.org/en-US/docs/Web/SVG/Attribute/orient
   */
  orient: string

  /**
   * https://developer.mozilla.org/en-US/docs/Web/SVG/Attribute/markerUnits#strokewidth
   */
  strokeWidth: number
}
