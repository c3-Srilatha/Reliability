/**
 * Represents panel in a {@link NodeDiagram}.
 * Allows for positional confuguration of components to be rendered above the main graph view.
 */
@typeScript
type NodeDiagramPanel mixes UiSdlComponent<UiSdlNoData> {

    /**
     * Child components to render within the panel
     */
    children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]

    /**
     * The position of the panel
     */
    position: string enum ('top-left', 'top-center', 'top-right', 'bottom-left', 'bottom-center', 'bottom-right') = 'bottom-left'

    /**
     * Determines whether or not the panel is hidden
     */
    hidden: boolean = false

    /**
     * Triggers an action that shows or hides the side panel.
     *
     * @param id
     *           Id of the component.
     * @param hidden
     *           Whether the NodeDiagramPanel should be hidden or not.
     *
     * @returns A `DIAGRAM_PANEL_(HIDE|SHOW)` action for this instance.
     */
    @uiSdlActionCreator(actionType='DIAGRAM_PANEL_(HIDE|SHOW)')
    showHideDiagramPanelAction: function(id: string, hidden: boolean): !UiSdlReduxAction ts-client

    /**
     * Listens for actions of type 'DIAGRAM_PANEL_SHOW' or 'DIAGRAM_PANEL_HIDE' and updates {@link hidden} field.
     *
     * @param state
     *           Redux state.
     * @param action
     *           Redux action.
     *
     * @returns A new Redux state.
     */
    @uiSdlReducer(actionType=['DIAGRAM_PANEL_SHOW', 'DIAGRAM_PANEL_HIDE'])
    showHideDiagramPanelReducer: private function(state: UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxState
}
