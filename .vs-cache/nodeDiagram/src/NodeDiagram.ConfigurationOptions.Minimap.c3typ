/**
 * Configurations for the minimap
 */
type NodeDiagram.ConfigurationOptions.Minimap {

  /**
   * Defines dimensions for minimap ex. { width: 100, height: 200 }
   */
  dimensions: { width: int, height: int }

  /**
   * Generates a class name for the minimap node. Variables are derived from the node's {@link NodeDiagramNodeData},
   * ex: `${name}_${category}`
   */
  nodeClassTemplate: string serialized Template
}
