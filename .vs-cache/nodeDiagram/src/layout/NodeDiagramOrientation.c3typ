/**
 * Enumerates the types orientations available for the {@link NodeDiagram} when fitting the diagram's viewport
 */
enum type NodeDiagramOrientation {

  LEFT = 'left'

  CENTER = 'center'

  RIGHT = 'right'

  TOP = 'top'

  BOTTOM = 'bottom'
}
