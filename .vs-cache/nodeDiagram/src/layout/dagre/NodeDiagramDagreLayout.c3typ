/**
 * Layout for a directed graph
 */
@typeScript
type NodeDiagramDagreLayout mixes NodeDiagramLayout {

  /**
   * The direction/orientation of the graph
   */
  direction: string enum('left_right', 'right_left', 'top_bottom', 'bottom_top') = 'left_right'

  /**
   * The minimum separation between adjacent nodes in the same rank. Default is 50.
   */
  nodesep: int = 50

  /**
   * The minimum separation between adjacent nodes in different ranks. Default is 50.
   */
  ranksep: int = 50

  /**
   * The minimum separation between adjacent edges. Default is 10.
   */
  edgesep: int = 10

  /**
   * Estimated width for nodes that haven't been measured yet. Default is 150.
   */
  estimatedNodeWidth: int = 150

  /**
   * Estimated height for nodes that haven't been measured yet. Default is 50.
   */
  estimatedNodeHeight: int = 50

  execute:                    ~ ts-client
  initialNodeHandlePositions: ~ ts-client
  getInitialNodePositions:    ~ ts-client
  executeLocalLayout:         ~ ts-client
}
