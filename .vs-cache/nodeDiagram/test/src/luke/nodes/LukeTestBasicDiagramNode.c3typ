/**
 * Luke component for {@link BasicDiagramNode}, the default node. Component renders a node with an icon.
 */
type LukeTestBasicDiagramNode mixes LukeTestNodeDiagramNode {

  nodeType: ~ = 'BasicDiagramNode'

  /**
   * Main icon selector for the node type (if applicable).
   */
  iconSelector: const string = '.c3-basicnode-icon'

  nameSelector: const string = '.c3-basicnode-name'

  name: ~

  /**
   * Asserts the main iconClass of the node
   */
  assertIcon: inline member function(iconClass: string): LukeAsyncQueueNode js-client
}
