/**
 * Base Luke component for NodeDiagramNode Luke types.
 * Ideally `LukeTestNodeDiagramNode` mixes `LukeBrowserWebElement` and `LukeTestNodeDiagram` can make instances with
 * `nodeEl`, however that results in a "Call stack exceeded" error.
 * Another alternative is for `LukeTestNodeDiagramNode` to mix `LukeTestComponent` but for that to be helpful,
 * we need to set `parentSelector`. However, `LukeBrowserWebElement#webElementSelector` (and LukeBrowserWebElement#selector)
 * resolve to undefined.
 * Last resort is to just wrap the `nodeEl` and supply some common functions that are on `LukeBrowserWebElement`.
 */
abstract type LukeTestNodeDiagramNode {

  /**
   * Initializes LukeTestNodeDiagramNode with nodeEl and returns an instance of @{link LukeTestNodeDiagramNode}
   */
  init: function(luke: !LukeBrowser, nodeEl: !LukeBrowserWebElement): mixing LukeTestNodeDiagramNode js-client

  /**
   * Luke browser instance
   */
  luke: !LukeBrowser

  /**
   * Underlying node instance
   */
  nodeEl: !LukeBrowserWebElement

  /**
   * The {@link NodeDiagramNodeData} this node represents
   */
  nodeType: string

  /**
   * The CSS selector for a node's right-click context menu item
   */
  nodeContextMenuActionItem: string = '.c3-nodediagram-context-menu'

  /**
   * Base selector for a {@link NodeDiagramNode}
   */
  selector: inline function(): string js-client

  /**
   * Returns the name of the node. Each node determines their own definition of a name.
   */
  name: abstract inline member function(): LukeAsyncQueueNode js-client

  /**
   * Asserts that the node exists
   */
  exists: inline member function() js-client

  /**
   * Resolves to an object with `x`, `y` position (the `translate` of the node)
   */
  position: inline member function(): LukeAsyncQueueNode js-client

  /**
   * Clicks the context menu item on the node
   */
  clickContextMenuItem: inline member function(itemLabel: string): LukeAsyncQueueNode js-client

  /**
   * Asserts the text of the context menu items
   */
  assertContextMenuItems: inline member function(itemLabels: [string]): LukeAsyncQueueNode js-client

  /**
   * Click the node instance
   */
  click: inline member function(): LukeAsyncQueueNode js

  /**
   * {@see LukeBrowserWebElement#search}
   */
  search: inline member function(selector: !string, resolveOnFound: boolean, timeout: int): LukeWebElement js

  /**
   * {@see LukeBrowserWebElement#searchAll}
   */
  searchAll: inline member function(selector: !string, resolveOnFound: boolean, timeout: int): LukeAsyncQueueNode js

  /**
   * Drag the node instance
   */
  realDrag: inline member function(endClientX: !int, endClientY: !int): LukeAsyncQueueNode js
}
