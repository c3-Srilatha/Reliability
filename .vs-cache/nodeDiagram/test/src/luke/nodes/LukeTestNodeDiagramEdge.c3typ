/**
 * LukeTestNodeDiagramEdge is a test component for {@link NodeDiagramEdge}
 */
type LukeTestNodeDiagramEdge mixes LukeTestComponent {

  /**
   * Initializes LukeTestNodeDiagramEdge with nodeEl and returns an instance of @{link LukeTestNodeDiagramEdge}
   */
  init: function(luke: !LukeBrowser, edgeEl: !LukeBrowserWebElement): mixing LukeTestNodeDiagramEdge js-client

  /**
   * Luke browser instance
   */
  luke: !LukeBrowser

  /**
   * Underlying edge instance
   */
  edgeEl: !LukeBrowserWebElement

  /**
   * Base selector for edges
   */
  selector: inline function(): string js-client

  /**
   * Asserts that the edge exists
   */
  exists: inline member function() js-client

  /**
   * Click the edge instance
   */
  click: inline member function() js
}
