/**
 * Test component for {@link NodeDiagramLegend}
 */
type LukeTestNodeDiagramLegend mixes LukeTestComponent {

  /**
   * The parent selector for the diagram legend
   */
  parentSelector: string = '.c3-nodediagram'

  /**
   * Selectors to determine if the legend rendered properly
   */
  renderingSelectors: ~ = ['.legend-container']

  /**
   * The CSS selector for the diagram legend button
   */
  legendButtonSelector: string = '.c3-expandable-nodediagram-legend-container button'

  /**
   * The CSS selector for the diagram legend
   */
  legendSelector: string = '.c3-nodediagram-legend'

  /**
   * The CSS selector for the diagram legend title
   */
  titleSelector: string = '.c3-nodediagram-legend-title'

  /**
   * The CSS selector for the diagram legend lines section
   */
  linesSelector: string = '.c3-nodediagram-legend-lines-section'

  /**
   * The CSS selector for the diagram legend node section
   */
  nodesSelector: string = '.c3-nodediagram-legend-node-section'

  /**
   * The CSS selector for a diagram legend item
   */
  itemSelector: string = '.c3-nodediagram-legend-item'

  /**
   * The CSS selector for a diagram legend line item's icon
   */
  lineItemIconSelector: string = 'img.c3-nodediagram-legend-item-icon'

  /**
   * The CSS selector for a diagram legend node item's icon
   */
  nodeItemIconSelector: string = '.c3-nodediagram-legend-item .icon'

  /**
   * The CSS selector for a diagram legend item's text
   */
  textSelector: string = '.c3-nodediagram-legend-item-text'

  /**
   * Gets the text of the line and node titles
   *
   * @param timeout
   *          The timeout for search
   *
   * @return {@link LukeAsyncQueueNode} that will be resolved with an array of title text
   */
  getTitlesText: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the src path of the line icons (which are img tags)
   *
   * @param timeout
   *          The timeout for search
   *
   * @return {@link LukeAsyncQueueNode} that will be resolved with an array of icon srcs
   */
  getLineIconsSrc: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the icon classes of node icons (i.e: c3-icon-server)
   *
   * @param timeout
   *          The timeout for search
   *
   * @return {@link LukeAsyncQueueNode} that will be resolved with an array of icon classes
   */
  getNodeIconsClass: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the text of all legend items (both line and node items)
   *
   * @param timeout
   *          The timeout for search
   *
   * @return {@link LukeAsyncQueueNode} that will be resolved with an array of item text
   */
  getItemsTextSelector: inline member function(timeout: int): LukeAsyncQueueNode js
  
}
