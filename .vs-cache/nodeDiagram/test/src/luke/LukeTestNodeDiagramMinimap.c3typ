/**
 * Test component for the Minimap component and its controls within a {@link NodeDiagram}
 */
type LukeTestNodeDiagramMinimap mixes LukeTestComponent {

  /**
   * The parent selector for the diagram legend
   */
  parentSelector: string = '.c3-nodediagram-flow'

  /**
   * The CSS selector for the diagram minimap
   */
  minimapSelector: string = '.react-flow__minimap'

  /**
   * The CSS selector for the diagram minimap controls
   */
  minimapControlsSelector: string = '.react-flow__controls'

  /**
   * The CSS selector for the diagram minimap control view button
   */
  minimapControlViewButtonSelector: string = '.minimap-control-button'

  /**
   * Clicks the zoom in button a number of times
   * @param clickCount: the number of times the click the zoom in button
   */
  zoomIn: inline member function(clickCount: number) js-client

  /**
   * Clicks the zoom out button a number of times
   * @param clickCount: the number of times the click the zoom out button
   */
  zoomOut: inline member function(clickCount: number) js-client

  /**
   * Clicks the fit view button
   */
  fitView: inline member function() js-client
}
