/**
 * Custom edge that renders ducks in a row
 */
type TestDuckyEdge mixes NodeDiagramEdgeData {

  DUCK_CLICK_SUFFIX: const string = 'CUSTOM_EDGE_DUCK_CLICK'

  /**
   * The number of ducks to render.
   */
  count: int = 1
}
