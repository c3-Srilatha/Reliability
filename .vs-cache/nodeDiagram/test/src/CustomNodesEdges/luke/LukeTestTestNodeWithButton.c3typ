/**
 * Sample Luke component for custom node. This node simply renders a button with the number of clicks displayed.
 * Any {@link LukeTestBasicDiagramNode} that mixes in a {@link LukeTestComponent}, such as
 * {@link LukeTestUiSdlButton} should be done at the developer's own risk - not all
 * APIs are guaranteed to work because {@link LukeTestBasicDiagramNode} itself is not a
 * {@link LukeTestComponent}.
 */
type LukeTestTestNodeWithButton mixes LukeTestNodeDiagramNode, LukeTestUiSdlButton {

  nodeType: ~ = 'TestNodeWithButton'

  /**
   * Selector for button within node
   */
  buttonSelector: ~ = 'button'

  name: ~

  /**
   * Returns text from button within node
   */
  getButtonText: inline member function(timeout: int): LukeAsyncQueueNode js-client
}
