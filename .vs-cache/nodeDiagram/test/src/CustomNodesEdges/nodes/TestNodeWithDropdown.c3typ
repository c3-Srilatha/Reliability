/**
 * A node that renders a text and dropdown with specified options.
 */
@typeScript
type TestNodeWithDropdown mixes NodeDiagramNodeData {

  DROPDOWN_CHANGE_SUFFIX: const string = 'CUSTOM_NODE_DROPDOWN_CHANGE'

  /**
   * Text to render above the dropdown
   */
  title: string

  /**
   * The options to supply in the dropdown. json should be have `value` and `text` field.
   */
  options: [json]
}
