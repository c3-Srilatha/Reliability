/**
 * Optional overrides to provide for documentation generation.
 *
 * @see DocSiteExport.DocGenSpec
 */
private type JarvisBaseToolkit.DocGen.Overrides mixes Spec {

  /**
   * See {@link DocSiteExport.DocGenSpec#skipTypeExamples}.
   */
  skipTypeExamples: boolean

  /**
   * See {@link DocSiteExport.DocGenSpec#typeDocBatchOptions}.
   */
  typeDocBatchOptions: DocSiteExport.DocGenSpec.BatchJobOptions

  /**
   * See {@link DocSiteExport.DocGenSpec#topicDocBatchOptions}.
   */
  topicDocBatchOptions: DocSiteExport.DocGenSpec.BatchJobOptions
}
