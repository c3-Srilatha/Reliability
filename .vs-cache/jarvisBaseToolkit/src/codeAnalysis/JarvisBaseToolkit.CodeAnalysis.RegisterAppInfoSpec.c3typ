/**
 * Spec for storing {@link BaseCodeAnalysis.AppInfo} in the centralized repository
 * and local {@link ArtifactHub}.
 */
type JarvisBaseToolkit.CodeAnalysis.RegisterAppInfoSpec mixes Spec {

  /**
   * The {@link Pkg#name} of the package being analyzed.
   */
  packageName: !string

  /**
   * The _full_ semantic version of the package being analyzed.
   */
  packageVersion: !string serialized SemanticVersion

  /**
   * Used for {@link BaseCodeAnalyzer.CollectAppInfoSpec#resolvedVersionsMap}.
   */
  packageNameToSemanticVersionMap: map<string, !string serialized SemanticVersion>

  /**
   * Source control gadget used to store the collected {@link BaseCodeAnalysis.AppInfo}.
   */
  platformRestInst: !GitHub
}
