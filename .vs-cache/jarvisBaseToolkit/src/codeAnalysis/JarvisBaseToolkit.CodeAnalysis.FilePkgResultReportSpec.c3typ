/**
 * The Type that contains spec for storing the result of code analysis in Jarvis report.
 */
type JarvisBaseToolkit.CodeAnalysis.FilePkgResultReportSpec {

  /**
   * The name of the package that the result is for.
   */
  packageName: string

  /**
   * The status of the code analysis.
   */
  status: JarvisBaseToolkit.CodeAnalysis.Status

  /**
   * The result of the code analysis.
   * The JSON object of a {@link BaseCodeAnalysis.Result} object.
   */
  result: json

  /**
   * The error message if the code analysis failed.
   */
  errorMessage: string
}
