/**
 * The Type that contains information needed to store the code analysis summary report.
 */
type JarvisBaseToolkit.CodeAnalysisSummary.StoreReportSpec mixes Spec {

  /**
   * The REST API to interact with the source control system in the Jarvis build.
   */
  restApi: !SourceControlRestApi

  /**
   * The source control gadget to use for storing processed results or customization results.
   */
  sourceControlGadget: !BaseCodeAnalyzer.GitHubGadget

  /**
   * The list of code analysis results to be stored in the Jarvis.Report and centralized code analytics GitHub repo.
   */
  codeAnalysisResults: [BaseCodeAnalysis.Result]

  /**
   * The code analysis step duration results to store for performance regression analysis.
   */
  codeAnalysisStepsWithDuration: json

  /**
   * The top-level customer package ultimately deployed to prod.
   */
  topLevelCustomerPackage: string

  /**
   * The list of customer packages to perform customization analysis on.
   */
  customerPackages: [string]

  /**
   * The branch the Jarvis build is running on.
   */
  branch: string

  /**
   * Build configurations used to monitor variables affecting the code analysis process.
   */
  buildConfigurations: json

  /**
   * The build configurations tracked for assessing the integrity of code analysis and code coverage results.
   */
  c3standardsrc: json

  /**
   * The Jarvis build ID
   */
  buildId: string
}
