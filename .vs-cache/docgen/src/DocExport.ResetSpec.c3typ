/**
 * Documentation generation is stateful, i.e, variables are stored in state to be used by asynchronously running
 * jobs. This Spec controls how variables should be reset before a new documentation generation run
 */
@deprecated(finalVersion='13', details='This is a legacy Type from {@link DocExport}. Use {@link DocSiteExport} instead.')
private type DocExport.ResetSpec mixes Spec {

  /**
   * Set to true to not remove the temporary directory from a previous docgen run.
   */
  doNotRemoveDirectory: boolean = true
}
