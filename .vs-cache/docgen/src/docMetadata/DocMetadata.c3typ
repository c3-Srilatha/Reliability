/**
 * Type to represent metadata for a topic, guide or c3 Type documentation.
 */
@deprecated(finalVersion='13', details='This is a legacy Type from {@link DocExport}. Use {@link DocSiteExport} instead.')
type DocMetadata {
  /**
   * The topic type of the documentation.
   */
  topicType: string

  /**
   * The intended audience for the documentation.
   */
  audience: string

  /**
   * The category under which this documentation falls.
   */
  category: string

  /**
   * The title of the documentation.
   */
  title: string

  /**
   * The abstract text for this documentation.
   */
  abstractTxt: string

  /**
   * The name of the package in which this documentation was created.
   */
  packageName: string

  /**
   * The name of the source file for this documentation.
   */
  sourceFileName: string

  /**
   * The server version used by this documentation.
   */
  serverVersion: string

  /**
   * The URL alias for this documentation.
   */
  urlAlias: string

  /**
   * The document number for this documentation.
   */
  documentNumber: string

  /**
   * The identifier for this documentation.
   */
  docIdentifier: string

  /**
   * The legal notice for this documentation.
   */
  legalnotice: string

  /**
   * The preface for this documentation.
   */
  preface: string

  /**
   * The tags for this documentation.
   */
  tags:[string]
}
