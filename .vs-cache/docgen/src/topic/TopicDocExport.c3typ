/**
 * Batch job to export documentation for C3 topics.
 */
@deprecated(finalVersion='13', details='This is a legacy Type from {@link DocExport}. Use {@link DocSiteExport} instead.')
type TopicDocExport extends BatchJob<TopicDocExport, TopicDocExportOptions, TopicDocExportBatch> type key 'BTOPDE' {
  doStart:      ~ js-server
  processBatch: ~ js-server
}
