/**
 * Config Type to store documentation export variables.
 */
@deprecated(finalVersion='13', details='This is a legacy Type from {@link DocExport}. Use {@link DocSiteExport} instead.')
type DocExportConfig mixes Singleton, Config {

  /**
   * The versions of packages for which documentation artifacts are being generated.
   */
  packageVersions: map<string, string serialized SemanticVersion>

  /**
   * The portal host link to use when construction documentation links.
   */
  portalHost: string

  /**
   * The temporary directory url created for holding the documentation artifacts.
   */
  tmpDirectoryUrl: string

  /**
   * The configured server version on which documentation artifacts were generated.
   */
  configuredServerVersion: string serialized SemanticVersion
}
