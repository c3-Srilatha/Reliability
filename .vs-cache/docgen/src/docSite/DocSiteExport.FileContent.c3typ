/**
 * Type to represent the different kinds of file content that can be exported.
 */
type DocSiteExport.FileContent {

  /**
   * The kind of file content (Type, topic, guide, etc.)
   */
  kind: !string enum DocSiteExport.FileContent.Kind

  /**
   * The original source content of the file. Will be exported with its original file extension.
   */
  source: string

  /**
   * - For Types this will be {@link TypeDocumentation}.
   * - For topics this will be {@link TopicDocumentation}.
   * - For notebooks this is not populated.
   * - For guides this will be a structure that looks like the following:
   *
   *   ```json
   *   {
   *     "title": "Type System",
   *     "metadata": TopicDocumentation#topicMetadata,
   *     "sections": [
   *       {
   *         "title": "Overview",
   *         "sections": [
   *           {
   *             "title": "Overview of the Type System",
   *             "link": DocumentationReference
   *           }
   *         ]
   *       },
   *       {
   *         "title": "Getting Started",
   *         "isHeading": true,
   *         "headingKind": "H2",
   *         "sections": [
   *           {
   *             "title": "Types",
   *             "link": DocumentationReference
   *           },
   *           {
   *             "title": "Fields",
   *             "link": DocumentationReference
   *           },
   *           {
   *             "title": "Methods",
   *             "link": DocumentationReference,
   *             "sections": [
   *               {
   *                 "title": "Implement C3 AI Methods",
   *                 "link": DocumentationReference
   *               },
   *               {
   *                 "title": "Implement Python Methods",
   *                 "link": DocumentationReference
   *               }
   *             ]
   *           }
   *         ]
   *       },
   *       "BREAK",
   *       {
   *         "title": "Additional Resources",
   *         "link": DocumentationReference,
   *         "icon": "external-link"
   *       }
   *     ]
   *   }
   *   ```
   */
  parsed: json

  /**
   * The rendered HTML content of the file.
   *
   * For notebooks, this contains the rendered HTML using [nbconvert](https://nbconvert.readthedocs.io/en/latest/).
   */
  html: string

  /**
   * The metadata for the file.
   */
  fileMeta: json
}
