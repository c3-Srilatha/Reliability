/**
 * Type to represent a batch to be processed in the {@link DocSiteExport.Topic.Job} job.
 */
private type DocSiteExport.Topic.Job.Batch {

  /**
   * List of topic files ([.c3doc.md](FileExt#DOC)) to be processed as part of this batch.
   */
  files: [Pkg.File]
}
