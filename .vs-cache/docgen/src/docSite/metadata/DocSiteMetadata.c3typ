/**
 * Type to represent metadata for Type or topic documentation.
 */
private type DocSiteMetadata {

  /**
   * The name of the {@link Pkg} this documentation belongs to.
   */
  pkgName: string

  /**
   * The version of the {@link Pkg} this documentation belongs to.
   */
  pkgVersion: string serialized SemanticVersion

  /**
   * The original path of the source file for this documentation.
   */
  sourceFilePath: string serialized Pkg.Path

  /**
   * The server version used by this documentation.
   */
  serverVersion: string serialized SemanticVersion

  /**
   * The URL alias for this documentation.
   */
  urlAlias: string

  /**
   * The tags for this documentation.
   */
  tags: [string]
}
