/**
 * Documentation link builder for the doc site.
 */
private type DocSiteLinkBuilder mixes DocumentationLinkBuilder {

  /**
   * The root package documentation generation is being run for. This **won't** always
   * match {@link App#rootPkg}.
   */
  rootPkgName: !string

  /**
   * The file being rendered or parsed. This is used to resolve relative links to images.
   */
  file: !Pkg.File

  /**
   * Function to extract relevant info for a [type link](TypeDocumentation).
   *
   * @param typeName
   *           The name of the Type.
   * @return All relevant info for the Type link. If the provided Type name doesn't exist,
   *         all keys will be empty strings or `null`.
   */
  getTypeLinkInfo: inline member function(typeName: string): !DocSiteLinkInfo js-rhino

  /**
   * Function to determine the URL path for a given Type.
   *
   * @param typeName
   *           The name of the Type.
   * @return The URL path for the Type.
   */
  getTypePath: inline member function(typeName: !string): !string js-rhino

  /**
   * Function to determine the URL path for a given [field](FieldType) or [method](Method).
   *
   * @param name
   *           The name of the field or method
   * @param isMethod
   *           Whether the name is a method or field.
   * @return The URL path for the field or method.
   */
  getFieldOrMethodPath: inline member function(name: !string, isMethod: boolean = false): !string js-rhino

  /**
   * Function to extract relevant info for a [topic link](TopicDocumentation).
   *
   * @param topicName
   *           The name of the topic.
   * @return All relevant info for the topic link. If the provided topic name doesn't exist,
   *         all keys will be empty strings or `null`.
   */
  getTopicLinkInfo: inline member function(topicName: string): !DocSiteLinkInfo js-rhino

  /**
   * Function to determine the URL path for a given [topic](TopicDocumentation).
   *
   * @param topicName
   *           The name of the topic.
   * @return The URL path for the topic.
   */
  getTopicPath: inline member function(topicName: !string): !string js-rhino

  href:  ~ js-rhino
  attrs: ~ js-rhino
  src:   ~ js-rhino
}
