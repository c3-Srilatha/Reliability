/**
 * Information about a documentation link.
 */
private type DocSiteLinkInfo {

  /**
   * Whether the link points to an existing resource.
   */
  exists: !boolean

  /**
   * The name of the package this link goes to.
   */
  pkgName: string

  /**
   * The `major.minor` version of the [package](#pkgName) this link goes to.
   */
  pkgVersion: string serialized SemanticVersion.MajorMinor

  /**
   * The normalized name used to identify this link for routing in the doc site.
   */
  normalizedName: string
}
