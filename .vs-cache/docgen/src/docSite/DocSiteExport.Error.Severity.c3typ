/**
 * Different levels of severity for a {@link DocSiteExport.Error}
 */
enum type DocSiteExport.Error.Severity {

  /**
   * The file couldn't be parsed. Documentation artifacts for the file weren't generated.
   */
  FATAL

  /**
   * The file was parsed, but some issues were discovered while parsing. Documentation artifacts for the file were generated.
   */
  NON_FATAL
}
