/**
 * Any file-level errors encountered during documentation generation are reported in this entity.
 */
entity type DocSiteExport.Error schema name 'DOC_SITE_EXPORT_ERROR' {

  /**
   * The category of the error (for example, `Type Documentation`, `Topic Documentation`).
   */
  kind: !string

  /**
   * The severity of this error.
   */
  severity: !string enum DocSiteExport.Error.Severity = FATAL

  /**
   * The message associated with the error.
   */
  message: string

  /**
   * Any additional information about the error.
   */
  info: json
}
