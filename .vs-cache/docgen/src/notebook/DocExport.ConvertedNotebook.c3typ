/**
 * Type containing information of the a Jupyter notebook converted to HTML.
 */
@deprecated(finalVersion='13', details='This is a legacy Type from {@link DocExport}. Use {@link DocSiteExport} instead.')
type DocExport.ConvertedNotebook mixes Result {

  /**
   * The content of the Jupyter notebook in the form of a HTML string.
   */
  content: !string

  /**
   * The version of the package to which this converted notebook belongs.
   */
  version: !string

  /**
   * The name of the package to which this converted notebook belongs.
   */
  packageName: !string

  /**
   * The name of the converted notebook.
   */
  filename: !string
}
