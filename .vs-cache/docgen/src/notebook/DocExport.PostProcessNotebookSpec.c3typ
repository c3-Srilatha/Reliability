/**
 * Spec Type to be passed into the {@link DocExport#postProcessAndExportNotebooks} function.
 */
@deprecated(finalVersion='13', details='This is a legacy Type from {@link DocExport}. Use {@link DocSiteExport} instead.')
type DocExport.PostProcessNotebookSpec mixes Spec {

  /**
   * The temporary directory url created for holding the documentation artifacts.
   */
  tmpDirectoryUrl: !string

  /**
   * The list of converted Jupyter notebooks to be post-processed and exported.
   */
  convertedNotebooks: [DocExport.ConvertedNotebook]
}
