/**
 * The {@link Spec} containing the information required for generating a {@link NotebookDoc}.
 */
@deprecated(finalVersion='13', details='This is a legacy Type from {@link DocExport}. Use {@link DocSiteExport} instead.')
type DocExport.NotebookSpec mixes Spec {

  /**
   * The string content of the {@link JupyterNotebook} for which to generate documentation artifacts.
   */
  content: string

  /**
   * The name of the tutorial jupyter notebook file.
   */
  name: string

  /**
   * The package in which this tutorial jupyter notebook was defined.
   */
  package: string

  /**
   * The version to set for this tutorial Jupyter notebook.
   */
  version: string

  /**
   * The path at which the {@link JupyterNotebook} is seeded.
   */
  path: string
}
