/**
 * Documentation link builder for the developer portal.
 */
@deprecated(finalVersion='13', details='This is a legacy Type from {@link DocExport}. Use {@link DocSiteExport} instead.')
type DevPortalDocumentationLinkBuilder mixes DocumentationLinkBuilder {

  /**
   * Return a logical URI intended for use by the developer portal. Full URLs remain
   * as-is and relative URLs return null.
   *
   * | Kind         | path            | URI                         |
   * |--------------|-----------------|-----------------------------|
   * | TYPE         | User            | doc:type:User               |
   * | DATA_FIELD   | User#groups     | doc:data-field:User#groups  |
   * | METHOD_FIELD | User#fetch      | doc:method-field:User#fetch |
   * | TOPIC        | typesys.c3doc   | typesys                     |
   * | URL          | http://c3iot.ai | http://c3iot.ai             |
   * | URL          | img/diagram.png |                             |
   *
   * @see DocumentationKind
   */
  endpoint: !string

  /**
   * The version to use when constructing the documentation link.
   */
  version: !string

  href: ~ js-server

  src: ~ js-server
}
