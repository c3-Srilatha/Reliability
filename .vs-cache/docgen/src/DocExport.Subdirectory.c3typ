/**
 * Enum type to represent the sub-directories in which various documentation artifacts are stored.
 */
@deprecated(finalVersion='13', details='This is a legacy Type from {@link DocExport}. Use {@link DocSiteExport} instead.')
enum type DocExport.Subdirectory {

  /**
   * Sub-directory to include files to be exported for the community bot. Includes all `.c3doc.md` and
   * `.ipynb` files declared in all packages for which documentation artifacts were generated.
   */
  COMMUNITY_BOT_FILES = 'community'

  /**
   * Sub-directory to store a file with a map from the files added to the Community Bot to their respective
   * url alias in the developer portal.
   *
   * For instance, `data-diagnostics-usage.c3doc.md` will be mapped to `/docs/8.4.0/topic/data-diagnostics-usage.md`
   * which translates to `https://developer.c3.ai/docs/8.4.0/topic/data-diagnostics-usage.md`.
   */
  URL_ALIASES = 'urlAliases'

  /**
   * Sub-directory to store the documentation artifacts generated to be uploaded onto the developer portal.
   */
  DOCUMENTATION_ARTIFACTS = 'documentation'

  /**
   * Sub-directory to store the tutorial notebook artifacts to be uploaded to the developer portal.
   * These are stored separately since the workflow to upload tutorial notebooks is different from other
   * documentation artifacts.
   */
  TUTORIAL_NOTEBOOK_ARTIFACTS = 'tutorialNotebooks'

  /**
   * Sub-directory to store the list of package dependency versions for each package for which documentation artifacts
   * were generated in the latest run.
   */
  DEPENDENCY_VERSIONS = 'dependencyVersions'
}
