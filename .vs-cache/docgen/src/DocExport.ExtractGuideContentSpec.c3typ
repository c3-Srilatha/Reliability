/**
 * Spec used by {@link DocExport#extractGuideContent}.
 */
@deprecated(finalVersion='13', details='This is a legacy Type from {@link DocExport}. Use {@link DocSiteExport} instead.')
private type DocExport.ExtractGuideContentSpec mixes Spec {

  /**
   * The lines of the guide content.
   */
  lines: [string]

  /**
   * The name of the package to which the guide content belongs.
   */
  packageName: string

  /**
   * The name of the file from which the guide content was extracted.
   */
  fileName: string

  /**
   * The version of the #package to which the guide content belongs.
   */
  version: string
}
