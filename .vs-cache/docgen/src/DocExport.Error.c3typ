/**
 * Type to capture errors encountered during docgen.
 */
@deprecated(finalVersion='13', details='This is a legacy Type from {@link DocExport}. Use {@link DocSiteExport} instead.')
entity type DocExport.Error {

  /**
   * Metadata about the errors encountered during docgen.
   */
  info: json

  /**
   * The error message thrown by the the docgen package.
   */
  errorMessage: string
}
