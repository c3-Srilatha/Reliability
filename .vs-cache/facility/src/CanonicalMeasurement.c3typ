/**
 * Represents a unique kind of measurement – for example, power (kW), energy (kWh), voltage, or temperature.
 * A MeterReading contains measurement values and timestamps, typically used to track resource usage,
 * sensor readings, or asset conditions over time.
 */
type CanonicalMeasurement mixes Canonical<CanonicalMeasurement> {

  /**
   * The start timestamp when the measurement period begins.
   */
  start: !datetime

  /**
   * The end timestamp when the measurement period ends. This can be null for ongoing measurements.
   */
  end: datetime

  /**
   * The measured value during the specified time period.
   */
  value: !decimal

  /**
   * The version of the data used for this measurement. Can be used for version control.
   */
  dataVersion: decimal

  /**
   * Indicates whether the measurement value is an estimate (true) or an actual reading (false).
   */
  isEstimate: boolean

  /**
   * The service point identifier associated with this measurement.
   */
  servicePointId: string

  /**
   * The asset identifier that the measurement corresponds to.
   */
  assetId: string

  /**
   * The status code of the measurement.
   */
  statusCode: string

  /**
   * The channel through which the measurement was taken.
   */
  channel: !string
}
