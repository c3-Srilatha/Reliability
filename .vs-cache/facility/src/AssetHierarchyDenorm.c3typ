/**
 * Denormalized view of asset hierarchy data, designed to provide fast access to 
 * hierarchical relationships between fixed assets. This entity is used for 
 * efficiently managing asset structures where one asset can have a parent-child relationship.
 * The denormalized data structure is optimized for performance and enables efficient querying 
 * of hierarchical asset relationships.
 */
@db(index=['to', 'from, to', 'isRoot'], shortId=true, shortIdReservationRange=10000)
@denorm(sources=[{type: 'DenormSource', source: 'FixedAsset', parentFieldName: 'parentRelations', childFieldName: 'childRelations'}], strictHierarchy=true)
entity type AssetHierarchyDenorm mixes HierarchyDenorm<FixedAsset> schema name 'STRUCT_ASHDNRM' {

  /**
   * Name of the asset hierarchy denormalized structure.
   * This field is not persisted in the database.
   */
  name:         ~ not persistable

  /**
   * Version information for the denormalized hierarchy.
   * This field is not persisted in the database.
   */
  version:      ~ not persistable

  /**
   * Metadata associated with the hierarchy.
   * This field is not persisted in the database.
   */
  meta:         ~ not persistable

  /**
   * Information about version edits of the hierarchy.
   * This field is not persisted in the database.
   */
  versionEdits: ~ not persistable
}
