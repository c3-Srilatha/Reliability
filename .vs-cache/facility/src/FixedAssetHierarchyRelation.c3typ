/**
 * Represents a hierarchical relationship between two fixed assets.
 * This entity defines how one FixedAsset is related to another FixedAsset, 
 * where `from` and `to` represent the source and target assets in the hierarchy.
 * The relationship is stored with a key of 'FA'.
 */
entity type FixedAssetHierarchyRelation extends PhysicalAssetHierarchyRelation type key 'FA' {

  /**
   * The FixedAsset at the source of the relationship.
   * Represents an asset from which the relation originates.
   */
  from: FixedAsset

  /**
   * The FixedAsset at the target of the relationship.
   * Represents an asset to which the relation points.
   */
  to:   FixedAsset
}
