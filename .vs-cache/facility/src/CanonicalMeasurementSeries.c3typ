/**
 * Represents the point of usage (meter/channel) for which interval data is provided.
 */
type CanonicalMeasurementSeries mixes Canonical<CanonicalMeasurementSeries> {

  /**
   * unique string for a given for a measurement from an measuring device of an asset or from a meter at a service point.
   */
  channel: !string

  /**
   * accumulation indicates how measurements are accumulated. Possible values are "register", "instantaneous", "delta", "indicative".
   *
   * “delta” means difference between reading at start time and end time; example: electricity consumption interval data
   * “indicating” means ‘what the meter would show' measured over a long, measurable time period; example: voltage measured over an interval
   * “register” means a cumulative reading from a dial at a point in time; example: monthly electricity consumption reading
   * “instantaneous” means a reading of a non-cumulative value at a point in time' example: temperature measurement at a moment in time
   */
  accumulation: string enum('register', 'instantaneous', 'delta', 'indicative')

  /**
   * interval length of measurements - QUARTER_HOUR, HOUR, DAY, MONTH
   */
  intervalLength: string

  /**
   * Unit of measurements "kilowatt", "kilowatt_hour", "volt", "volt_hour", "kvar", "kvar_hour"
   */
  uom: string

  /**
   * multiplication factor to be applied to the readings
   */
  multiplier: decimal

  /**
   * Id of service point
   */
  servicePointId: string

  /**
   * Id of asset
   */
  assetId: string

  /**
   * Type of measurement - "Consumption", "Production", "ConsumptionPeak", "ProductionPeak", "InductiveConsumption",
   * "InductiveProduction", "CapacitiveConsumption", "CapacitiveProduction", "Voltage"
   */
  measurementType: string
}
