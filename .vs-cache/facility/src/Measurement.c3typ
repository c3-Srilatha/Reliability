/**
 * Each entry represents a discrete measurement for a period of time.
 *
 * Thus far, most of them have been for 15-minute intervals of time.
 *
 * Don't make quantity required in this type.  It isn't enforced in direct write.
 */
@db(compactType=true,
    datastore='cassandra',
    partitionKeyField='parent',
    persistenceOrder='start,end',
    persistDuplicates=false,
    shortId=true,
    shortIdReservationRange=1000000)
@constraint(condition='start<end')
entity type Measurement mixes IntervalDataPoint<PhysicalMeasurementSeries>, Quantity schema name 'structure_Measurement'
