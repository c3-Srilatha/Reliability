/**
 * WorkItems are specific tasks that are associated with the work order.
 */
@db(index+=['parentWorkOrder'])
entity extendable type WorkItem schema name 'STRUCT_WORKITEM' {

  /**
   * The parent WorkOrder for the WorkItem
   */
  parentWorkOrder: WorkOrder

  /**
   * The status of the WorkItem represented by codes
   */
  statusCode: string

  /**
   * The end date timestamp of the WorkItem
   */
  workEndDate: datetime
}
