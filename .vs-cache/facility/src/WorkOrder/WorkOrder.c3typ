/**
 * WorkOrders are requests to perform work on any part of the grid.
 */
@db(index+=['asset, workType', 'facility', 'meta.timestamp'])
extendable entity type WorkOrder schema name 'STRUCT_WORKORDER' {

  /**
   * The Facility associated with the WorkOrder
   */
  facility: Facility

  /**
   * The status of the WorkOrder
   */
  status: string enum WorkOrderStatusEnum

  /**
   * The status code for the WorkOrder
   * Customer-specific codes indicating current status of the work order, e.g. Assigned to field
   */
  statusCode: string

  /**
   * The WorkOrder number specified
   * A customer-specific identifier for the work order. Not used internally as a key
   */
  workOrderNumber: string

  /**
   * The description of the WorkOrder
   */
  description: string

  /**
   * The type of the WorkOrder
   * The highest-level classification for a work order, e.g. customer requested in region X.
   */
  workOrderType: string

  /**
   * The work subtype of the WorkOrder
   * A finer distinction within a workType
   * e.g. work type might indicate a reconnect of power
   * work sub type might indicate because the customer has paid their back bill
   * or indicate that a new customer has moved in
   */
  workSubtype: string

  /**
   * The work type of the WorkOrder, is a property on the parentWorkOrder
   * The type of work order, describes the actual work that must be done for the work order
   * e.g. reconnection of power
   */
  workType: string

  /**
   * The work start date of the WorkOrder
   */
  workStartDate: datetime

  /**
   * The work end date of the WorkOrder
   * The more important of the two dates in most metrics as it indicates when to start looking for aberrant behavior
   */
  workEndDate: datetime

  /**
   * The opened date for the WorkOrder
   */
  openedDate: datetime

  /**
   * Allows back office or field investigators to provide other important information about the work order
   */
  comments: string

  /**
   * The resolution of the WorkOrder
   * e.g. "Completed Job" or "Confirmed - Unable to bill"
   */
  resolution: string

  /**
   * The time it took to resolve the WorkOrder
   * specified by ExactDimension with value and unit of measurement
   */
  resolutionTime: ExactDimension

  /**
   * The timestamp on the WorkOrder
   * Usually used to indicate when the work order was created
   * while workStartDate and workEndDate indicate the actual work time span
   */
  timestamp: datetime

  /**
   * The service group responsible for the WorkOrder
   */
  serviceGroup: string enum('IT', 'Field')

  /**
   * The service team within the service group responsible for the WorkOrder
   */
  serviceTeam: string

  /**
   * The technician associated with the WorkOrder
   */
  technician: Person

  /**
   * The asset associated with the WorkOrder
   */
  asset: FixedAsset

  /**
   * The customer associated with the WorkOrder
   */
  customer: Customer

  /**
   * The location associated with the WorkOrder
   */
  location: Location

  /**
   * The organization associated with the WorkOrder
   */
  customerOrg: Organization

  /**
   * The original WorkOrder created, this could have subtasks such as child WorkOrders or WorkItems
   */
  parentWorkOrder: WorkOrder

  /**
   * Separate work orders spawned from the original WorkOrder.
   * In Enel, for a while we stored WorkItems in WorkOrder and used childWorkOrders to link them,
   * but that was confusing and made the WorkOrder table too large to be performant.
   */
  @db(order='descending(id)')
  childWorkOrders: [WorkOrder](parentWorkOrder)

  /**
   * The work items for the WorkOrder
   * specific sub-tasks that are associated with the work order.
   */
  @db(order='descending(workEndDate)')
  workItems: [WorkItem](parentWorkOrder)

  /**
   * The internal code that corresponds with the reason for the work order
   */
  reasonCode: string
}
