/**
 * Facility is sub type for FixedAsset, you can think of it as a building.
 * So Facility has buildingType and construction date, and FixedAsset does not.
 *
 * @see FixedAsset
 */
@db(index+=['name', 'geometry.longitude', 'geometry.latitude'])
entity type Facility extends FixedAsset type key 'FMF' {

  /**
   * Geometry component of {@link Location#address placedAt.address}.
   *
   * @see LatLong
   */
  geometry: LatLong stored calc placedAt.address.geometry

  /**
   * Street address component of {@link Location#address placedAt.address}.
   */
  address1: string stored calc placedAt.address.components.(types.id=='street_address').name

  /**
   * Name of locality (city/town) component of {@link Location#address placedAt.address}.
   */
  city: string stored calc placedAt.address.components.(types.id=='locality').name

  /**
   * Abbreviation of State/Province/administrative_area component of {@link Location#address placedAt.address}.
   */
  state: string stored calc placedAt.address.components.(types.id=='administrative_area_level_1').abbr

  /**
   * Postal or zip code component of {@link Location#address placedAt.address}.
   */
  postal_code: string stored calc placedAt.address.components.(types.id=='postal_code').name

  /**
   * Utility defined building type of facility such as APT, RES, MARINA, B&B, AUTOGAS etc.
   */
  facilityType: string

  /**
   * Facility characteristics with historical values.
   *
   * @see FacilityCharacteristicSet
   */
  @db(order='descending(toUTC(timestamp))')
  characteristics: [FacilityCharacteristicSet](parent)
}
