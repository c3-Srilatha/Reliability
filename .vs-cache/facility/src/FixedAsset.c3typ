/**
 * Base type for fixed {@link PhysicalAsset}s. A {@link FixedAsset} has a fixed location.
 */
@db(index=['placedAt', 'typeIdent', 'typeIdent, placedAt', 'weatherStation', 'meta.timestamp', 'allRegionParents'])
extendable entity type FixedAsset extends PhysicalAsset mixes AclEnabled, WeatherAware type key 'ASSET:FA' {

  /**
   * A description of the asset.
   */
  description: string

  /**
   * The location of the asset. Certain assets can be moved from one place to another, such as electrical meters,
   * but currently, placedAt is just one location fixed across all of time.
   */
  placedAt: Location

  /**
   * The including asset
   */
  parent: FixedAsset

  /**
   * The assets directly included by this one
   */
  children: [FixedAsset](parent)

  /**
   * Records representing all ancestors in the asset hierarchy
   */
  denormParents: [AssetHierarchyDenorm](to) schema name 'DP'

  /**
   * Records representing all descendants in the asset hierarchy
   */
  denormChildren: [AssetHierarchyDenorm](from) schema name 'DCH'

  /**
   * All fixed asset owners for this asset.
   */
  assetOwners: [AssetOwner](assetOwned) schema name 'AO'

  /**
   * All organizations that are owners of this fixed asset.
   */
  orgs: [Organization] stored calc assetOwners.partyRole.party schema name 'ORG'

  /**
   * All relationships in the party role hierarchy.
   */
  @db(cascadeRemove=true)
  partyRelations: [AssetPartyRole](assetOwned) schema name 'PREL'

  /**
   * The specific party roles attached via AssetPartyRole.
   */
  partyRoles: [PartyRole] stored calc partyRelations.partyRole schema name 'PROL'

  /**
   * These commented out pending:PLAT-3387
   *
   * The business region this asset belongs to
   *
   * businessRegion    : BusinessRegion
   *
   * The geo-political region this asset belongs to
   *
   * geoPoliticalRegion    : GeoPoliticalRegion
   *
   * Regions directly linked to this asset
   *
   * stored calc "businessRegion + geoPoliticalRegion + utilityRateRegion"
   */
  regions: [Region] schema name 'RGNS'

  /**
   * Regions linked to this asset or its ancestor assets
   */
  regionParents: [Region] stored calc denormParents.from.regions schema name 'PRGNS'

  /**
   * Regions linked to this asset or its ancestor asset and all their parent regions
   */
  allRegionParents: [Region] stored calc denormParents.from.regions.denormParents.from schema name 'APRGNS'

  /**
   * The weather station associated with the location of the asset.
   */
  weatherStation: ~ stored calc placedAt.weatherStation
}
