/**
 * Represents a facility such as an office, data center, hospital, etc.
 * A facility is typically owned or leased by an organization, and contains various attributes to describe its
 * physical location and its association with the organization.
 */
type CanonicalFacility mixes Canonical<CanonicalFacility> {

  /**
   * The unique identifier for the facility.
   */
  facilityId:           !string

  /**
   * Identifier for the type of the facility.
   */
  typeIdent:            string

  /**
   * The general type of the facility.
   */
  facilityType:         string

  /**
   * The name of the facility.
   */
  facilityName:         string

  /**
   * The street address where the facility is located.
   */
  serviceStreetAddress: string

  /**
   * The city where the facility is located.
   */
  serviceCity:          string

  /**
   * The state or region where the facility is located.
   */
  serviceState:         string

  /**
   * The postal code (ZIP code) for the facility's location.
   */
  servicePostalCode:    string

  /**
   * The country where the facility is located.
   */
  serviceCountry:       string

  /**
   * The unique identifier for the organization that owns or leases the facility.
   */
  organizationId:       string

  /**
   * The longitude coordinate of the facility's location.
   */
  longitude:            double

  /**
   * The latitude coordinate of the facility's location.
   */
  latitude:             double
}
