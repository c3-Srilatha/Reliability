/**
 * A UI component which renders its children in a draggable container with a "handle" icon
 * along one side.
 */
type StudioDraggableHandle mixes UiSdlComponent<any> {

  /**
   * Any data that should be passed to the drop target when the user
   * drags and drops this source element.
   *
   * @see UiSdlDragDropSource#sourceData
   */
  dragDropSourceData: !map<string, any>

  /**
   * A category for this drag drop source element for the purpose of limiting to which drag drop targets
   * it may be dropped.
   */
  dragDropKind: !string

  /**
   * The UI elements to render inside this draggable container.
   */
  children: ![UiSdlComponentRef]

  /**
   * Whether the handle is draggable.
   */
  draggable: boolean = true
}
