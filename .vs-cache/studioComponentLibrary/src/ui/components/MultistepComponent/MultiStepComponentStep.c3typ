/**
 * Properties for handling the configuration of a step in {@link MultiStepComponent}
 */
type MultiStepComponentStep mixes Named {

  /**
   * Whether to show the progress of steps for this step
   */
  hideProgress: boolean

  /**
   * The value to display in the multi step header for this step
   */
  label: string | UiSdlDynamicValueSpec

  /**
   * The {@link UiSdlComponent#id} to render in the step
   */
  componentId: !string

  /**
   * Spec describing the transitions between the current step and other steps in the component
   */
  retrieveNextStep: !UiSdlDynamicValueSpecParam

  /**
   * The content to display on the primary (continue) button
   */
  continueText: string | UiSdlDynamicValueSpec

  /**
   * The content to display on the secondary (back) button
   */
  backText: string | UiSdlDynamicValueSpec

  /**
   * The content to display on the link (cancel) button
   */
  cancelText: string | UiSdlDynamicValueSpec

  /**
   * The content to display on the link (apply and save) button
   */
  saveText: string | UiSdlDynamicValueSpec

  /**
   * The content to display as the title when this step is in an edit state
   */
  editModeLabel: string | UiSdlDynamicValueSpec
}
