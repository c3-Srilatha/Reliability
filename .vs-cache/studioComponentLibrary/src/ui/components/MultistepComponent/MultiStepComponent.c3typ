/**
 * A component for displaying and interaction with a set of steps
 * allowing for navigation back/forth/between them and rendering arbitrary components.
 */
type MultiStepComponent mixes UiSdlComponent<UiSdlNoData>, UiSdlComponentTitle {

  /**
   * The current step to display in the component
   */
  currentStepIndex: private int

  /**
   * The steps for the component
   */
  configurationSteps: private [MultiStepComponentStep]

  /**
   * Map of steps in the component to whether they have been invalidated
   */
  stepInvalidated: private map<string, boolean>

  /**
   * Whether the buttons on the component should be loading
   */
  componentLoading: boolean

  /**
   * The notification to show for the component
   */
  componentNotification: UiSdlInlineNotification

  /**
   * Triggered to set the configuration steps of the component
   *
   * @param id
   *            Id of the component.
   * @param steps
   *            The {@link MultiStepComponentStep}s available to the component
   * @returns a `CONFIGURATION_STEPS_SET` action for this instance
   */
  @uiSdlActionCreator(actionType='CONFIGURATION_STEPS_SET')
  setConfigurationStepsAction: private function(id: !string, steps: [MultiStepComponentStep]): !UiSdlAction ts-client

  /**
   * Listens for actions of type `CONFIGURATION_STEPS_SET` and sets `configurationSteps`
   *
   * @param state
   *            Redux state
   * @param action
   *            Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='CONFIGURATION_STEPS_SET')
  configurationStepsSetReducer: private function(state: !UiSdlReduxState,
                                                 action: !UiSdlStepUpdateAction): !UiSdlReduxState ts-client

  /**
   * Triggered to signal to the component that external continue has completed
   *
   * @param id
   *            Id of the component.
   * @param valid
   *            Whether the component should actually continue
   * @returns a `CONTINUE_{COMPLETE|INVALID}` action for this instance
   */
  @uiSdlActionCreator(actionType='CONTINUE_{COMPLETE|INVALID}')
  continueCompleteAction: private function(id: !string, valid: boolean): !UiSdlAction ts-client

  /**
   * Updates the current step and dispatches followup actions based on the validity of the `CONTINUE_COMPLETE`
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlEpic(actionType='CONTINUE_COMPLETE')
  continueCompleteEpic: private inline function(state: !UiSdlReduxState,
                                                action: !UiSdlReduxAction): !UiSdlReduxState ts

  /**
   * Updates the loading state of the component
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlEpic(actionType='CONTINUE_INVALID')
  continueInvalidEpic: private inline function(state: !UiSdlReduxState,
                                               action: !UiSdlReduxAction): !UiSdlReduxState ts

  /**
   * Triggered to signal to the component to initiate saving.
   *
   * @param id
   *            Id of the component.
   * @param valid
   *            Whether the component should actually save
   * @returns a `CONTINUE_{COMPLETE|INVALID}` action for this instance
   */
  @uiSdlActionCreator(actionType='CONTINUE_{SAVE|INVALID}')
  continueSaveAction: private function(id: !string, valid: boolean): !UiSdlAction ts-client

  /**
   * Dispatches followup actions based on the validity of the `CONTINUE_SAVE`
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlEpic(actionType='CONTINUE_SAVE')
  continueSaveEpic: private inline function(state: !UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxState ts

  /**
   * Triggered to set the step index of the component
   *
   * @param id
   *            Id of the component.
   * @param index
   *            the index of the configuration step to render in the component
   * @param invalidate
   *            whether the previous step has changed and the current step should be invalidated
   * @returns a `STEP_UPDATE` action for this instance
   */
  @uiSdlActionCreator(actionType='STEP_UPDATE')
  updateStepAction: private function(id: !string, index: !int, invalidate: boolean): !UiSdlAction ts-client

  /**
   * Listens for actions of type `STEP_UPDATE` and sets `currentStepIndex`
   *
   * @param state
   *            Redux state
   * @param action
   *            Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='STEP_UPDATE')
  stepUpdateReducer: private function(state: !UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Dispatches teardown for configuration steps on `CANCEL_FLOW`
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlEpic(actionType='STEP_UPDATE')
  stepUpdateEpic: private inline function(state: !UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxState ts

  /**
   * Triggered by this component to fire off lifecycle events that are consumed externally
   *
   * @param id
   *            Id of the component.
   * @param actionSuffix
   *            The lifecycle event to trigger
   * @returns a `CONFIGURATION_STEPS_SET` action for this instance
   * @param additionalPayload
   *            The additional payload can be added to differentiate between different button click, for example cancel button
   */
  @uiSdlActionCreator(actionType='MULTISTEP_COMPONENT_{LIFE_CYCLE_SUFFIX}')
  multiStepComponentLifeCycleAction: private function(stepComponentId: !string,
                                                      actionSuffix: !string,
                                                      additionalPayload: any): !UiSdlAction ts-client

  /**
   * Triggered to signal to the component that it should cancel the current flow
   *
   * @param id
   *            Id of the component.
   * @returns a `CANCEL_FLOW` action for this instance
   */
  @uiSdlActionCreator(actionType='CANCEL_FLOW')
  cancelFlowAction: private function(id: !string): !UiSdlAction ts-client

  /**
   * Dispatches teardown for configuration steps on `CANCEL_FLOW`
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlEpic(actionType='CANCEL_FLOW')
  cancelFlowEpic: private inline function(state: !UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxState ts

  /**
   * Triggered to alert the component that a step has changed.
   * Used to help the component determine what to do when they are setting up.
   *
   * @param id
   *            Id of the component.
   * @param stepComponentId
   *            the componentId of the step that has been changed
   * @returns a `STEP_INVALIDATE` action for this instance
   */
  @uiSdlActionCreator(actionType='STEP_INVALIDATE')
  stepInvalidateAction: private function(id: !string, stepComponentId: !string): !UiSdlAction ts-client

  /**
   * Listens for actions of type `STEP_INVALIDATE` and sets `stepInvalidated`
   *
   * @param state
   *            Redux state
   * @param action
   *            Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='STEP_INVALIDATE')
  stepInvalidateReducer: private function(state: !UiSdlReduxState,
                                          action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Triggered to clear `invalidatedMap`
   *
   * @param id
   *            Id of the component.
   * @returns a `CLEAR_INVALIDATED_MAP` action for this instance
   */
  @uiSdlActionCreator(actionType='CLEAR_INVALIDATED_MAP')
  clearInvalidatedMapAction: private function(id: !string): !UiSdlAction ts-client

  /**
   * Listens for actions of type `CLEAR_INVALIDATED_MAP` and clears `stepInvalidated`
   *
   * @param state
   *            Redux state
   * @param action
   *            Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='CLEAR_INVALIDATED_MAP')
  clearInvalidatedMapReducer: private function(state: !UiSdlReduxState,
                                               action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Triggered to put the component in a loading state
   *
   * @param id
   *            Id of the component.
   * @param loading
   *            Whether the component should be loading or not
   * @returns a `SET_COMPONENT_LOADING` action for this instance
   */
  @uiSdlActionCreator(actionType='SET_COMPONENT_LOADING')
  setComponentLoadingAction: private function(id: !string, loading: !boolean): !UiSdlAction ts-client

  /**
   * Listens for actions of type `SET_COMPONENT_LOADING` and sets `componentLoading`
   *
   * @param state
   *            Redux state
   * @param action
   *            Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='SET_COMPONENT_LOADING')
  setComponentLoadingReducer: private function(state: !UiSdlReduxState,
                                               action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Triggered to put the component in a loading state
   *
   * @param id
   *            Id of the component.
   * @param componentNotification
   *            The notification to show
   * @returns a `SET_COMPONENT_NOTIFICATION` action for this instance
   */
  @uiSdlActionCreator(actionType='SET_COMPONENT_NOTIFICATION')
  setComponentNotificationAction: private function(id: !string,
                                                   componentNotification: !UiSdlInlineNotification): !UiSdlAction ts-client

  /**
   * Listens for actions of type `SET_COMPONENT_NOTIFICATION` and sets `componentNotification`
   *
   * @param state
   *            Redux state
   * @param action
   *            Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='SET_COMPONENT_NOTIFICATION')
  setComponentNotificationReducer: private function(state: !UiSdlReduxState,
                                                    action: !UiSdlReduxAction): !UiSdlReduxState ts-client
}
