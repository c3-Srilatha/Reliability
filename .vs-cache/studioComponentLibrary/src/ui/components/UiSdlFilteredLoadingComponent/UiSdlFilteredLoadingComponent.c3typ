/**
 * Helper that assumes there are children that should be put in "loading" state when data is being requested.
 */
type UiSdlFilteredLoadingComponent mixes UiSdlSpinner, UiSdlComponent<UiSdlNoData> {

  // Defining `leftSidePanel` and `children` here because this component cannot also mix UiSdlLayoutSidePanel (different parametric values)
  leftSidePanel: UiSdlComponentRef<UiSdlFilterPanel>

  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]

  /**
   * The index of the children that should be set in a "loading" state when {@link #loading} is true.
   */
  loadingChildIndex: private int

  @uiSdlEpic(actionType='INITIAL_RENDER')
  registerLoadingEpics: private function(actionStream: !UiSdlActionsObservable,
                                         stateStream: !UiSdlStatesObservable): !UiSdlActionsObservable ts-client

}
