type StudioSearchBarOption {
  /**
   * The value of the option
   */
  value: !string

  /**
   * The text to display with the option
   */
  title: !string

  /**
   * Icon class
   */
  icon: string

  /**
   * Subtitle to display to the right of the main title
   */
  subtitle: string

  /**
   * True if the option should have a disabled look. The option will still be clickable.
   */
  disabled: boolean
}
