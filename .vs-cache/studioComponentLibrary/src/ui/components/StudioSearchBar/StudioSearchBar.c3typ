/**
 * Component for searching options.
 * This currently is more of a presentational component. It does not support a data spec and options with render
 * specific fields are meant to be supplied via `derivedProps`.
 * If in the future we choose to move to a data spec driven component their should be {@link UiSdlFieldBasedDataSpecSetting}
 * for the fields in {@link StudioSearchBarOption}.
 */
@beta
@typeScript
type StudioSearchBar mixes UiSdlComponent<UiSdlNoData> {

  /**
   * Whether or not the search bar is focused and dropdown is shown
   */
  focused: private boolean

  /**
   * Current selected StudioSearchBarOption value
   * {@link StudioSearchBarOption#value}.
   */
  selectedOptionValue: string

  /**
   * The dropdown items to display for the search bar, the map is key'd by the
   * {@link StudioSearchBarOption#value}.
   */
  options: map<string, StudioSearchBarOption>

  /**
   * Placeholder text for the dropdown search bar
   */
  placeholder: string

  /**
   * Sorts the options alphabetically
   */
  sortAlphabetically: boolean = true

  /**
   * Property to determine whether options' text should be translated.
   */
  translateOptionText: boolean = true

  /**
   * Triggered to update the focus state of the search bar. This is to update the redux state.
   * It will set the actual focus on the UI.
   *
   * @param componentId
   *        the id of the component
   * @param focus
   *        true if the UI has focus
   */
  @uiSdlActionCreator(actionType='FOCUSED_SET')
  setFocusedAction: function(componentId: !string, focus: boolean): !UiSdlReduxAction ts-client

  /**
   * Listens to actions of type 'FOCUSED_SET'.
   *
   * @param state
   * @param action
   * @returns the state
   */
  @uiSdlReducer(actionType='FOCUSED_SET')
  focusedSetReducer: function(state: UiSdlReduxState, action: UiSdlReduxAction): UiSdlReduxState ts-client

  /**
   * Set selectedOptionValue into state
   *
   * @param componentId
   *        the id of the component
   * @param value
   *        selectedOptionValue
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_OPTION')
  setSelectedOptionValueAction: function(componentId: !string, value: string): !UiSdlReduxAction ts-client

  /**
   * Listens to actions of type 'SET_SELECTED_OPTION'.
   */
  @uiSdlReducer(actionType='SET_SELECTED_OPTION')
  setSelectedOptionValueReducer: function(state: UiSdlReduxState, action: UiSdlReduxAction): UiSdlReduxState ts-client

  /**
   * Get selectedOptionValue from state
   */
  getSelectedOptionValue: function(state: UiSdlReduxState, componentId: string): string ts-client

  /**
   * Triggered when a search option is selected. This is triggered even if the option is "disabled".
   *
   * @param id
   *        the id of the component
   * @param option
   *        the selected {@link StudioSearchBarOption}
   */
  @uiSdlActionCreator(actionType='OPTION_SELECTED')
  optionSelectedAction: function(id: !string, option: StudioSearchBarOption): !UiSdlReduxAction ts-client
}
