/**
 * The specification of data retrieval for instances of the {@link UiSdlEnhancedCardList} component type.
 */
@typeScript
type UiSdlEnhancedCardListDataSpec mixes UiSdlFieldBasedDataSpec {

  /**
   * Data spec configuration for the principal portion of UiSdlEnhancedCard.
   */
  principalCardDataSpecSetting: UiSdlEnhancedPrincipalCardDataSpecSetting

  /**
   * Data spec configuration for the sub UiSdlEnhancedCard.
   */
  subCardDataSpecSetting: UiSdlEnhancedSubCardDataSpecSetting

  /**
   * Action name
   */
  actionName: !string

  /**
   * Arguments to pass to the action
   */
  actionArgs: json

  /**
   * Converts the data spec into an array of partially applied actions.
   */
  toPartiallyAppliedActions: ~ ts-client
}
