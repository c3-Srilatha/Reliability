/**
 * Shared setting for the principal and sub portion of UiSdlEnhancedCard.
 */
@typeScript
type UiSdlEnhancedCardDataSpecSetting {

  /**
   * String of Object's nested keys. For example, if the object structure is { 'a': {'b': [1, 2]}}
   * and data for {@link UiSdlEnhancedCardList } is inside 'b', the
   * path string for it would be 'a.b'. If your key has '.' in it, wrap it in [""]. For example,
   * if the object is { 'a': {'b.d': [1, 2]}}, the path would be 'a["b.d"]'.
   */
  path: string

  /**
   * {@link UiSdlGraphic } Component's DataSpec setting
   */
  graphic: private UiSdlGraphicAvatarDataSpecSetting | UiSdlGraphicBadgeDataSpecSetting | UiSdlGraphicLogoDataSpecSetting

  /**
   * Field based configuration for the title
   */
  title: private UiSdlEnhancedCardTitleDataSpecSetting

  /**
   * Field based configuration for the subtitleOne
   */
  subtitleOne: private UiSdlEnhancedCardSubtitleDataSpecSetting

  /**
   * Field based configuration for the subtitleTwo
   */
  subtitleTwo: private UiSdlEnhancedCardSubtitleDataSpecSetting

  /**
   * Field based configuration for the subtitleThree
   */
  subtitleThree: private UiSdlEnhancedCardSubtitleDataSpecSetting

  /**
   * Field based configuration for the subtitleFour
   */
  subtitleFour: private UiSdlEnhancedCardSubtitleDataSpecSetting

  /**
   * Field based configuration for the subtitleFive
   */
  subtitleFive: private UiSdlEnhancedCardSubtitleDataSpecSetting

  /**
   * Field based configuration for the subtitleSix
   */
  subtitleSix: private UiSdlEnhancedCardSubtitleDataSpecSetting

  /**
   * Field based configuration for the subtitleSeven
   */
  subtitleSeven: private UiSdlEnhancedCardSubtitleDataSpecSetting

  /**
   * Field based configuration for the status
   */
  status: private UiSdlEnhancedCardStatusDataSpecSetting

  /**
   * Field based configuration for the action group
   */
  actionGroup: private UiSdlActionGroupFieldBasedDataSpecSetting
}
