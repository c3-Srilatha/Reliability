/**
 * Data Spec Configuration for the title of UiSdlEnhancedCard.
 * If the actionSuffix is set, it will take precedence over the link property.
 */
@typeScript
type UiSdlEnhancedCardTitleDataSpecSetting {

  /**
   * Field based configuration for internal/external links
   */
  link: UiSdlLinkFieldBasedDataSpecSetting

  /**
   * The action to dispatch when the user selects this option.
   */
  actionSuffix: string

  /**
   * Field based configuration for the subtitle text
   */
  text: !UiSdlTitleTextFieldBasedDataSpecSetting
}
