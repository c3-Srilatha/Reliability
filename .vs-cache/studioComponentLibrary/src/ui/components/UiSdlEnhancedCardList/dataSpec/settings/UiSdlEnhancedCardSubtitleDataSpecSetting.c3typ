/**
 * Data Spec Configuration for the subtitle of UiSdlEnhancedCard
 */
@typeScript
type UiSdlEnhancedCardSubtitleDataSpecSetting mixes UiSdlEnhancedCardTitleDataSpecSetting {

  /**
   * TODO: TOOLS-13048 Integration the graphic uisdl component
   */
  icon: private UiSdlFieldBasedDataSpecSetting

  /**
   * Field based configuration for the subtitle text
   */
  primaryText: private UiSdlSubtitleTextFieldBasedDataSpecSetting

  /**
   * Field based configuration for the subtitle metric
   */
  secondaryText: private UiSdlSubtitleTextFieldBasedDataSpecSetting

  /**
   * TODO: TOOLS-13048 Integration the graphic uisdl component
   */
  iconMap: private map<string, string>

  /**
   * TODO: TOOLS-13048 Integration the graphic uisdl component
   */
  iconColorMap: private map<string, string>

  /**
   * Configuration to add underline to the text
   */
  borderBottom: boolean
}
