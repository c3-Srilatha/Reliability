/**
 * Configuration for the status of {@link UiSdlEnhancedCard}
 */
@typeScript
type UiSdlEnhancedCardStatusDataSpecSetting mixes UiSdlFieldBasedDataSpecSetting {

  /**
   * Map of field value to the {@link UiSdlEnhancedCardStatus}.
   *
   * Example:
   * Field value 'Successful' can mapped to 'SUCCESS' of {@link UiSdlEnhancedCardStatus}.
   */
  statusMap: private map<string, string enum('success', 'warning', 'error', 'loading')>

  /**
   * Map of fieldValue to tooltip. Tooltip shows the field value if not set.
   *
   * Example:
   * Field value 'SUCCESS' can mapped to 'Successful'
   */
  tooltipMap: private map<string, string>
}
