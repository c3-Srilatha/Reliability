/**
 * Configuration type for links
 * TOOLS-13089 Move this out of UiSdlEnhancedCardList for it to be shared across all the SDL components.
 */
@beta
@typeScript
type UiSdlLink {

  /**
   * The target page for the URL redirect link.
   */
  targetPage: string

  /**
   * Whether the link should be treated as an internal application link or an external link.
   */
  internal: boolean

  /**
   * Whether clicking the link to a new page will open a new tab. Only works if internal property is set to false.
   */
  opensNewTab: boolean
}
