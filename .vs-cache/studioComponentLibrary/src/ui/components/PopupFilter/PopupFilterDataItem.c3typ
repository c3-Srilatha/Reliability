/**
 * A dataItem in the filter pop up {@link UiSdlFormDataGrid}.
 */
@typeScript
type PopupFilterDataItem mixes WithUniqueId {

  /**
   * The actual fieldName of what's being filtered
   */
  fieldName: string

  /**
   * The displayed name of what's being filtered
   */
  displayName: string

  /**
   * The filter operation (e.g <, >, ==, !=)
   */
  operation: string

  /**
   * The value being filtered
   */
  value: any

  /**
   * A join condition to another filter condition (e.g &&, ||)
   */
  joinCond: string
}
