/**
 * A component for previewing various file types with appropriate viewers
 */
type StudioFilePreview mixes UiSdlComponent<UiSdlNoData> {
  /**
   * The content of the file to be displayed
   */
  fileContent: any

  /**
   * The type/kind of file being previewed (e.g., 'CSV', 'PDF')
   */
  fileKind: string

  /**
   * The name of the file being previewed
   */
  fileName: string
}
