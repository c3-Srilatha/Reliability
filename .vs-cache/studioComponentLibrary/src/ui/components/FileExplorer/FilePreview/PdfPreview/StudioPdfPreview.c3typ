/**
 * A component for previewing PDF files with zoom and page navigation controls
 */
type StudioPdfPreview mixes UiSdlComponent<UiSdlNoData> {
  /**
   * The base64 encoded content of the PDF file to be displayed
   */
  fileContent: ?string

  /**
   * Optional name of the file being previewed
   */
  fileName: string
}
