/**
 * A type that is used by {@link Ann.UiImportGenerator} that generates extra imports
 * for {@link StudioFileExplorer} for filtering context menu actions.
 */

type FileExplorerImportGenerator {
  /**
   * Function to generate a {@link UiSdlImportResult}.
   *
   * @param metadata The json metadata for the component
   *
   * @returns a {@link UiSdlImportResult} representing the extra imports required by the component.
   */
  generateImport: function(metadata: json): UiSdlImportResult js-server
}
