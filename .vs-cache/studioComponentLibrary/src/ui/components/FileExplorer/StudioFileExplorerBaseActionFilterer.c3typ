/**
 * A base type for creating action filterers for {@link StudioFileExplorer}.
 */
@typeScript
abstract type StudioFileExplorerBaseActionFilterer {
  /**
   * TODO: make a type to replace "json"
   * Function to filter actions for a {@link StudioFileExplorer} based on the available actions and the node.
   *
   * @param actions
   *       Available actions
   * @param node
   *       The node to filter for
   * @returns a filtered list of actions.
   */
  filterActions: abstract function(actions: [json], node: json):  [json]
}
