/**
 * A component that creates a popover tooltip and truncates if the item is wider than it's parent element
 */
@typeScript
type TruncatedTooltip mixes UiSdlDataGridCell {

  /**
   * The full string content
   */
  content: string

  /**
   * The position of the popup relative to the trigger element
   */
  position: string enum('top left', 'top center', 'top right', 'left center', 'right center', 'bottom left', 'bottom center', 'bottom right') = 'top left'

  /**
   * The size of the popup
   */
  popupSize: string enum('mini', 'tiny', 'small', 'large', 'huge') = 'mini'

  /**
   * For use if there is custom truncate logic, the truncated string produced
   */
  truncatedContent: string
}
