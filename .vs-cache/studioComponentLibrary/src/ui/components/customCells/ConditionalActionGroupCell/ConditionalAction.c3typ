/**
 * Conditionally returns the {@link UiSdlAction}
 */
@typeScript
type ConditionalAction  {
  
  /**
   * A condition based on the field value of a dataObj
   */
  condition: UiSdlFieldBaseCondition

  /**
   * Action to return if condition is met
   */
  thenAction: UiSdlAction

  /**
   * Action to return if condition is not met
   */
  elseAction: UiSdlAction
}
