/**
 * A condition based on the field value of the dataObj.
 */
@typeScript
type UiSdlFieldBaseCondition {

  /**
   * The name of the field to which this condition apply
   */
  fieldName: string

  /**
   * The expected value of the field value
   */
  expectedValue: any
}
