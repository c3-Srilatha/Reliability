/**
 * Avatar settings for {@link StudioGridCell}
 */
@typeScript
type StudioGridCellAvatarSetting {

  /**
   * Field based icon configuration
   */
  icon: UiSdlFieldBasedDataSpecSetting

  /**
   * Map of field value to icon suffix.
   */
  iconMap: map<string, string>

  /**
   * Field based image configuration
   */
  image: UiSdlFieldBasedDataSpecSetting

  /**
   * Map of field value to image path.
   */
  imageMap: map<string, string>

  /**
   * Field based color configuration
   */
  color: UiSdlFieldBasedDataSpecSetting

  /**
   * Map of field value to color.
   */
  colorMap: map<string, string>

  /**
   * Field based backgroundColor configuration
   */
  backgroundColor: UiSdlFieldBasedDataSpecSetting

  /**
   * Map of field value to background color.
   */
  backgroundColorMap: map<string, string>

  /**
   * Tooltip to show on text hover
   */
  tooltip: UiSdlFieldBasedDataSpecSetting | UiSdlDynamicValueSpec

  /**
   * Map of field value to display tooptip text. If undefined, display tooltip text will default to field value.
   */
  tooltipMap: map<string, string>
}
