/**
 * A data grid cell with status and an icon derived from the status
 */
@typeScript
type StudioGridCell mixes UiSdlDataGridCell {

  /**
   * Text to show on the cell
   */
  content: UiSdlFieldBasedDataSpecSetting | UiSdlDynamicValueSpec

  /**
   * The link to direct to if the usage is link
   */
  link: UiSdlFieldBasedDataSpecSetting | UiSdlDynamicValueSpec

  /**
   * Map of field value to display text. If undefined, display text will default to field value.
   * {@link UiSdlDynamicValueSpec} only works with {@link UiSdlFieldBasedDataSpecSetting}
   */
  contentMap: map<string, UiSdlDynamicValueSpec>

  /**
   * Cell can be a button, link or plain text
   */
  usage: string enum('button', 'link', 'text')

  /**
   * Settings for avatar to be prepended to the content
   */
  prependedAvatar: StudioGridCellAvatarSetting

  /**
   * Settings for avatar to be appended to the content
   */
  appendedAvatar: StudioGridCellAvatarSetting

  /**
   * Tooltip to show on text hover
   */
  tooltip: UiSdlFieldBasedDataSpecSetting | UiSdlDynamicValueSpec

  /**
   * Map of field value to display text. If undefined, display text will default to field value.
   * {@link UiSdlDynamicValueSpec} only works with {@link UiSdlFieldBasedDataSpecSetting}
   */
  tooltipMap: map<string, UiSdlDynamicValueSpec | string>

  /**
   * Whether the content should be truncated
   */
  truncate: boolean = false

  /**
   * If provided, the inner text content will be truncated to this character limit. Only applicable when the truncate prop is true.
   * Useful to prevent rendering extremely long strings onto the DOM even when truncation is enabled.
   */
  truncatedCharacterLimit: int

  /**
   * Capitalize the field value.
   * Only works with UiSdlFieldBasedDynamicValueSpecParam
   */
  capitalizeText: boolean = false

  /**
   * ClassName to be set on the cell. For styling purpose only.
   */
  className: string
}
