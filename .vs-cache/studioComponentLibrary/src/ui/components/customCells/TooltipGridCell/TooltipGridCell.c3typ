/**
 * A grid cell to truncate the cell and display the tooltip
 */
@typeScript
type TooltipGridCell mixes UiSdlDataGridCell {
  /**
   * The field from the dataItem to use as the date field
   */
  fieldName: string

  /**
   * Threshold in which to truncate the string
   */
  truncateCharacterLimit: int = 30

  /**
   * How many characters of the truncated string to show from the beginning
   */
  leadingCharsLimit: int = 9

  /**
   * How many characters of the truncated string to show from the end
   */
  trailingCharsLimit: int = 0

  /**
   * The position of the popup relative to the trigger element
   */
  position: string enum('top left', 'top center', 'top right', 'left center', 'right center', 'bottom left', 'bottom center', 'bottom right') = 'top left'

  /**
   * The size of the popup
   */
  popupSize: string enum('mini', 'tiny', 'small', 'large', 'huge') = 'mini'
}
