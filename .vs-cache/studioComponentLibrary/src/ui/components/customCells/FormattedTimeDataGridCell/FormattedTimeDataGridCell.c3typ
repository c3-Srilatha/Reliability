/**
 * A grid cell to display a time-related strings with formatting
 */
@typeScript
type FormattedTimeDataGridCell mixes UiSdlDataGridCell {

  /**
   * How to interpret the data field.
   * `iso` - display an ISO formatted time string
   * `duration` - display an amount of time from the time string
   * `relative` - display the relative time from now (i.e. 1 day ago)
   */
  usage: string enum('iso', 'duration', 'relative')
}
