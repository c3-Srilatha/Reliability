/**
 * FileUploadStatusTracker is responsible for tracking and displaying the status of file uploads.
 * It provides information such as the current upload progress, total file size, and the status of each file being uploaded.
 */
@typeScript
type FileUploadStatusTracker mixes UiSdlComponent<UiSdlNoData>, UiSdlComponentTitle {

  /**
   * Whether to show or hide the progress bar
   */
  shouldShowProgressBar: boolean

  /**
   * Children of the file upload status tracker items
   */
  items: [FileUploadStatusTrackerItem]
}
