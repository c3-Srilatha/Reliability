/**
 * FileUploadStatusContainer to group FileUploadStatusTracker
 */
@typeScript
type FileUploadStatusContainer mixes UiSdlComponent<UiSdlNoData>, UiSdlComponentTitle {

  /**
   * FileUploadStatusContainer to have an array of FileUploadStatusTracker
   */
  statusTrackers: [FileUploadStatusTracker]

  /**
   * Triggered to set the configuration steps of the component
   *
   * @param id
   *            Id of the component.
   * @param file
   *            The file available to the component
   * @returns a `FILE_UPLOAD_STATUS_SET` action for this instance
   */
  @uiSdlActionCreator(actionType='FILE_UPLOAD_STATUS_SET')
  setFileUploadStatusAction: private function(id: string, file: [Obj]): !UiSdlAction ts-client

  /**
   * Listens for actions of type `FILE_UPLOAD_STATUS_SET` and sets `configurationSteps`
   */
  @uiSdlReducer(actionType='FILE_UPLOAD_STATUS_SET')
  fileUploadStatusSetReducer: private function(state: !UiSdlReduxState,
                                               action: !UiSdlStepUpdateAction): !UiSdlReduxState ts-client

  /**
   * Triggered when clicks on x button on the status tracker
   *
   * @param componentId
   *            Id of the component.
   * @param file
   *            The file available to the component
   * @returns a `CLICK_DISMISS_BUTTON` action for this instance
   */
  @uiSdlActionCreator(actionType='CLICK_DISMISS_BUTTON')
  clickDismissButtonAction: private function(componentId: string, file: Obj): !UiSdlAction ts-client
}
