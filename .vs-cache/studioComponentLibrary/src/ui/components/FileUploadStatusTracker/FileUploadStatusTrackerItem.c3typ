/**
 * Component to display file upload details
 */
@typeScript
type FileUploadStatusTrackerItem mixes UiSdlComponent<UiSdlNoData> {

  /**
   * A unique identifier for the information card. This will be passed when a card is clicked.
   */
  id: string

  /**
   * The status to display. This will inform the group that this item is displayed in.
   */
  uploadStatus: string

  /**
   * Whether a progress bar should be shown for this item
   */
  shouldShowProgressBar: boolean

  /**
   * An alternative to {@link image}.
   */
  iconName: string

  /**
   * Color of the icon
   */
  iconColor: string

  /**
   * Percentage for the status
   */
  percentage: int | UiSdlDynamicValueSpec

  /**
   * Total size of the file
   */
  totalFileSize: int | UiSdlDynamicValueSpec

  /**
   * Size for uploaded file
   */
  currentFileUploadedSize: int | UiSdlDynamicValueSpec

  /**
   * Name of the file
   */
  fileName: string | UiSdlDynamicValueSpec

  /**
   * The message to display for this item
   */
  message: string | UiSdlDynamicValueSpec

  /**
   * Whether it is complete and show on the top level
   */
  isCompleted: boolean

  /**
   * Total number of the file
   * Its an alternative way to display other than {@link totalFileSize}
   */
  totalNumberCount: int | UiSdlDynamicValueSpec

  /**
   * Total number of the successful file
   * Its an alternative way to display other than {@link currentFileUploadedSize}
   */
  successfulNumberCount: int | UiSdlDynamicValueSpec

  /**
   * The quantity name to display for this item
   */
  quatityName: string | UiSdlDynamicValueSpec

  /**
   * Boolean to show dismiss button
   */
  shouldShowDismissButton: boolean | UiSdlDynamicValueSpec
}
