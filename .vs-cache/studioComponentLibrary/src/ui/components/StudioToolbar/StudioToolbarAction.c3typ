/**
 * Configuration type for actions in {@link StudioToolbar}
 */
@typeScript
type StudioToolbarAction mixes UiSdlAction {

    /**
     * Whether the text should be truncated to 2 lines
     */
    truncate: boolean = true

    /**
     * Path to image to be used as action icon. Takes precedence over iconSuffix.
     */
    imagePath: string

    /**
     * The action to dispatch when the user selects this option.
     */
    actionSuffix: string

    /**
    * What color the action icon is
    */
    color: string = 'default'
}
