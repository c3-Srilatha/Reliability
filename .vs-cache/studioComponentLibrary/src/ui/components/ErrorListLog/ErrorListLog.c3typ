/**
 * Component for displaying a set of errors in a selectable format
 */
@typeScript
type ErrorListLog mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The errors to display from in the error list and the error log.
   * the field from the errors that will be shown is `fieldName`
   */
  errors: ![json]

  /**
   * The field to display from the selected error in the error log.
   * it should be a field or nested subfield from the json objects in `errors`
   */
  fieldName: !string

  /**
   * The translation for the error details title.
   * Should be a translation that takes a single parameter ({errorIdx})
   */
  errorDetailsTitle: string

}
