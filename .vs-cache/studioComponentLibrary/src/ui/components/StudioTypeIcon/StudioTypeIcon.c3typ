/**
 * Type Icon Component for Mapping Builder Page and UI Designer Component Configuration page.
 * This type is used so the corresponding react tsx file will be included in the webpack bundle.
 */
@typeScript
type StudioTypeIcon mixes UiSdlComponent<UiSdlNoData> {

  /**
   * Value type to convert into type icon.
   */
  valueType: ValueType

  /**
   * Whether the value type is in the format transformed by {@link UiSdlTypeWorkerValueTypeTransformHelper}.
   */
  isValueTypeTransformed: boolean
}
