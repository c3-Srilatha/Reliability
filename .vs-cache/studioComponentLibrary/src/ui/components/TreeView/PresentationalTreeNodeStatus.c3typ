/**
 * The status element of a {@link PresentationalTreeNode}
 */
@typeScript
type PresentationalTreeNodeStatus {

  /**
   * The content of the status.
   */
  status: string

  /**
   * The background color of the status.
   */
  backgroundColor: string

  /**
   * The tooltip of the status.
   */
  tooltip: string
}
