/**
 * Layout with a bottom sheet that either shows up at the top or the bottom the page
 * A bottom sheet is a container that hugs either the bottom or top of the page and
 * has the ability to open/close or collapse/expand.
 */
@typeScript
type BottomSheet mixes UiSdlLayoutBase {

  /**
   * Component to attach to the top or bottom of the page
   */
  attachedComponent: UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>

  /**
   * Allow bottom sheet to contain multiple components. Mutually exclusive with {@link attachedComponent}.
   * Use action {@link #setActiveComponentIdAction} to set the active component.
   */
  attachedComponents: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]

  /**
   * Render attached to the top or bottom of the page
   */
  alignment: string enum UiSdlVerticalAlignment = BOTTOM

  /**
   * Whether the component should allow to be collapsed. If `false`, it will be either open (full-screen) or closed.
   */
  collapsible: boolean

  /**
   * The open state of the component
   */
  open: private boolean

  /**
   * The expanded state of the component
   */
  expanded: private boolean

  /**
   * By default, hitting escape will collapse the bottomsheet if it is expanded for the first time,
   * and close the bottomsheet for the second time. Setting this to true will close the bottomsheet
   * on first hit.
   */
  closeOnEscape: private boolean = false

  /**
   * By default, the bottom sheet has cross close button on the top right. Set true to hide it.
   */
  hideCloseButton: private boolean = false

  /**
   * When {@link attachedComponent} is an array of component refs, this determines which component to show in the
   * bottom sheet.
   */
  activeComponentId: private string

  /**
   * List of action icons
   */
  actions: private [UiSdlActionGroup | UiSdlBaseDataGridToggleableTableActionGroup]

  /**
   * Triggered to open or close the component
   *
   * @param id
   *            Id of the component.
   * @param open
   *            If true the component will be opened.  If false the component will be closed
   * @param expanded
   *            True if the component is desired to be opened with `expanded` true state. Not used if `open` is false (action for _CLOSE).
   * @returns a `BOTTOM_SHEET_(OPEN|CLOSE)` action for this instance
   */
  @uiSdlActionCreator(actionType='BOTTOM_SHEET_(OPEN|CLOSE)')
  openCloseComponentAction: private function(id: !string,
                                             open: boolean,
                                             expanded: boolean): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `BOTTOM_SHEET_OPEN` and sets internal field {@link open} to true
   *
   * @param state
   *            Redux state
   * @param action
   *            Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='BOTTOM_SHEET_OPEN')
  componentOpenReducer: private function(state: !UiSdlReduxState,
                                         action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `BOTTOM_SHEET_CLOSE` and sets internal field {@link open} to false
   *
   * @param state
   *            Redux state
   * @param action
   *            Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='BOTTOM_SHEET_CLOSE')
  componentCloseReducer: private function(state: !UiSdlReduxState,
                                          action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Triggered to expand or collapse the component
   *
   * @param id
   *            Id of the component.
   * @param expanded
   *            If true the component will be collapsed.  If false the component will be expanded
   * @returns a `BOTTOM_SHEET_(EXPAND|COLLAPSE)` action for this instance
   */
  @uiSdlActionCreator(actionType='BOTTOM_SHEET_(EXPAND|COLLAPSE)')
  expandCollapseComponentAction: private function(id: !string, expanded: boolean): !UiSdlReduxAction ts-client

  /**
   * Triggered to toggle the {@link expanded} field for the component
   *
   * @param id
   *            Id of the component.
   * @returns a `BOTTOM_SHEET_TOGGLE_EXPANDED` action for this instance
   */
  @uiSdlActionCreator(actionType='BOTTOM_SHEET_TOGGLE_EXPANDED')
  toggleExpandedForComponentAction: private function(id: !string): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `BOTTOM_SHEET_EXPAND` and sets internal field {@link expanded} to true
   *
   * @param state
   *            Redux state
   * @param action
   *            Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='BOTTOM_SHEET_EXPAND')
  componentExpandReducer: private function(state: !UiSdlReduxState,
                                           action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `BOTTOM_SHEET_COLLAPSE` and sets internal field {@link expanded} to false
   *
   * @param state
   *            Redux state
   * @param action
   *            Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='BOTTOM_SHEET_COLLAPSE')
  componentCollapseReducer: private function(state: !UiSdlReduxState,
                                             action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `BOTTOM_SHEET_TOGGLE_EXPANDED` and toggles the value for internal field {@link expanded}
   *
   * @param state
   *            Redux state
   * @param action
   *            Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='BOTTOM_SHEET_TOGGLE_EXPANDED')
  componentExpandedToggleReducer: private function(state: !UiSdlReduxState,
                                                   action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Triggered when an icon action button is clicked.
   *
   * @param id
   *          Id of the component.
   * @param actionSuffix
   *          The action button that was clicked.
   *
   * @returns An `ACTION_CLICK_${actionSuffix}` action for this instance.
   */
  @uiSdlActionCreator(actionType='ACTION_CLICK_${actionSuffix}')
  clickButtonAction: function(id: string, actionSuffix: string): !UiSdlActionClickAction ts-client

  /**
   * Trigger to set the active component id in a bottom sheet with multiple components (attachedComponents is set.)
   *
   * @param id
   *          ID of the bottom sheet component instance.
   * @param activeComponentId
   *          The component ID of the component that is desired to be visible in the bottom sheet.
   * @returns A `SET_ACTIVE_COMPONENT_ID` action for this instance.
   */
  @uiSdlActionCreator(actionType='SET_ACTIVE_COMPONENT_ID')
  setActiveComponentIdAction: function(id: string, activeComponentId: string): !UiSdlReduxAction ts-client

  /**
   * Listens to actions of type SET_ACTIVE_COMPONENT_ID and sets the active component ID in the redux state.
   *
   * @param state
   *            Redux state
   * @param action
   *            Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='SET_ACTIVE_COMPONENT_ID')
  activeComponentIdSetReducer: private function(state: !UiSdlReduxState,
                                                action: !UiSdlReduxAction): !UiSdlReduxState ts-client
}
