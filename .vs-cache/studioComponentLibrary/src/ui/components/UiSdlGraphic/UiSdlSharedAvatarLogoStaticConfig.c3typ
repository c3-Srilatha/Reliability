/**
 * Static configuration for the Avatar/Logo
 * Display presedence is:
 * 1. Image
 * 2. Text
 * 3. Icon
 * TODO: TOOLS-13113 Integrate this with UiSdlGraphic
 */
@typeScript
type UiSdlSharedAvatarLogoStaticConfig mixes UiSdlGraphicTypeStaticConfig {

  /**
   * Path of the image to display
   */
  imagePath: private string

  /**
   * Tooltip text to display
   */
  tooltip: private string

  /**
   * If set, and text has the delimiter, component shows doubleDigit initials. Default is singleDigit.
   */
  doubleDigitDelimiter: private string
}
