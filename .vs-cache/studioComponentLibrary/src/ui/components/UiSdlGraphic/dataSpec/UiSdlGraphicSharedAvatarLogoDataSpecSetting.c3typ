/**
 * Shared DataSpec setting for Avatar and Logo.
 * Display presedence is:
 * 1. Image
 * 2. Text
 * 3. Icon
 */
@typeScript
type UiSdlGraphicSharedAvatarLogoDataSpecSetting mixes UiSdlGraphicTypeDataSpecSetting {

  /**
   * Field based image configuration. Field value should have the absolute image url.
   */
  image: private UiSdlFieldBasedDataSpecSetting

  /**
   * Field based tooltip configuration.
   */
  tooltip: private UiSdlFieldBasedDataSpecSetting

  /**
   * If set, and text has the delimiter, component shows doubleDigit initials. Default is singleDigit.
   */
  doubleDigitDelimiter: private string
}
