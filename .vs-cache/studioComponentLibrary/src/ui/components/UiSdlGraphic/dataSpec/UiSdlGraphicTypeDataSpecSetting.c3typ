/**
 * Shared dataSpec configuration for avatar, badge, and logo type of {@link UiSdlGraphic} component.
 * Display presedence is:
 * 1. Text
 * 2. Icon
 */
@typeScript
type UiSdlGraphicTypeDataSpecSetting {

  /**
   * Field based icon configuration
   */
  icon: private UiSdlFieldBasedDataSpecSetting

  /**
   * Map of field value to icon suffix.
   */
  iconMap: private map<string, string>

  /**
   * Field based color configuration
   */
  color: private UiSdlFieldBasedDataSpecSetting

  /**
   * Map of field value to color.
   */
  colorMap: private map<string, string>

  /**
   * Field based backgroundColor configuration
   */
  backgroundColor: private UiSdlFieldBasedDataSpecSetting

  /**
   * Map of field value to background color.
   */
  backgroundColorMap: private map<string, string>

  /**
   * Field based text configuration. First field value will be used for text.
   */
  text: private UiSdlFieldBasedDataSpecSetting

  /**
   * Picks a random color for background and text.
   * If true, it will select color and backgroundColor at random for the items without those settings.
   */
  randomizeBackgroundAndColor: boolean = false

  /**
   * The size of the component
   */
  size: private string enum('extraSmall', 'small', 'medium', 'large', 'extraLarge')
}
