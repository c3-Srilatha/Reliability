/**
 * The specification of data retrieval for instances of the {@link UiSdlGraphic} component type.
 */
@typeScript
type UiSdlGraphicDataSpec mixes UiSdlFieldBasedDataSpec {

  /**
   * Action name
   */
  actionName: !string

  /**
   * Arguments to pass to the action
   */
  actionArgs: json

  /**
   * Converts the data spec into an array of partially applied actions.
   */
  toPartiallyAppliedActions: ~ ts-client

  /**
   * Configuration setting for the graphic.
   */
  graphicTypeSetting: UiSdlGraphicAvatarDataSpecSetting | UiSdlGraphicBadgeDataSpecSetting | UiSdlGraphicLogoDataSpecSetting
}
