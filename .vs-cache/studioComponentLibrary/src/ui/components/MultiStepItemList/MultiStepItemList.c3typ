/**
 * The MultiStepItemList component containing a list of MultiStepItem and currentStep that stores in the state
 */
@typeScript
type MultiStepItemList mixes UiSdlComponent<UiSdlNoData> {

  /**
   * An array of MultiStepItem that contain step and title.
   */
  multiStepItemList: [MultiStepItem]

  /**
   * current step that is in the state
   */
  currentStep: int

  /**
   * Triggered when the MultiStepItem is clicked.
   *
   * @param id
   *            Id of the component.
   * @param step
   *            The step that was clicked.
   * @returns A `MULTI_STEP_ITEM_CLICK` action for this instance.
   */
  @uiSdlActionCreator(actionType='MULTI_STEP_ITEM_CLICK')
  multiStepItemClickAction: private function(id: string, step: int): !UiSdlReduxAction ts-client
}
