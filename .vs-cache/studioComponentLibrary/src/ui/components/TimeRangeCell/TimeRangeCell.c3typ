/**
 * Embed the time range component in a form or page somewhere
 */
@typeScript
type TimeRangeCell mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The dropdown options
   */
  option: [Obj]

  /*
   * -------------- GET SELECTED TIME -------------- 
   */ 

  /**
   * Stores the time option selected in the dropdown
   */
  timeSelected: string

  /**
   * Creates an action to update the time that is selected
   */
  @uiSdlActionCreator(actionType='SET_TIME')
  setTimeAction: private function(): !UiSdlReduxAction ts-client

  /**
   * Updates the time selected
   */
  @uiSdlReducer(actionType='SET_TIME')
  setTimeReducer: private function(state: !UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxState ts-client 


  /*
   * -------------- GET SELECTED TIME RANGE-------------- 
   */ 

  /**
   * Stores the time option selected in the dropdown
   */

  /**
   *  The start of the custom date range, when applicable
   */     
  startDate: string
  
  /**
   * The end of the custom date range, when applicable
   */
  endDate: string

  /**
   * Creates an action to update the time that is selected
   */
  @uiSdlActionCreator(actionType='SET_TIME_RANGE')
  setTimeRangeAction: private function(): !UiSdlReduxAction ts-client

  /**
   * Updates the time range selected
   */
  @uiSdlReducer(actionType='SET_TIME_RANGE')
  setTimeRangeReducer: private function(state: !UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxState ts-client      
}
