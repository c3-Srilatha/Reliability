/**
 * Node in the data tree provided to StudioFlameGraph. Currently unexposed fields are following:
 * - color (textColor)
 * - backgroundColor
 */
type StudioFlameGraphNode {

    /**
     * The name of this node.
     */
    name: string

    /**
     * The relative width of this node compared to its parent and neighbors.
     */
    value: int

    /**
     * The tooltip to be displayed when hovered over a node.
     */
    tooltip: string

    /**
     * The children nodes of this node.
     */
    children: [StudioFlameGraphNode]
}
