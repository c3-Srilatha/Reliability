/**
 * A type to render a flamegraph of hierarchical data based on a tree of data nodes. Nodes 
 * will be expanded when clicked on for a more precise view. See {@link StudioFlameGraphNode}
 * for configuration options on each node.
 */
@typeScript
type StudioFlameGraph mixes UiSdlComponent<any>{

    /**
     * The {@link StudioFlameGraphNode} root of the data tree provided to this flamegraph.
     * Gemerally will be specified using derivedProps
     */
    root: StudioFlameGraphNode

    /**
     * Optional title for the flamegraph
     */
    title: string

    /**
     * Color hue to be used with the color hash function to decide the color of each rectangle
     */
    colorHue: string enum ('warm', 'cold', 'blue', 'red', 'orange', 'yellow', 'green', 'pastelgreen', 'aqua') = 'warm'
}
