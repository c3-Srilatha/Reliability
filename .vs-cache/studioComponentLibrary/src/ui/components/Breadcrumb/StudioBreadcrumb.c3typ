/**
 * A generic breadcrumb component that accepts and displays a list of {@link BreadCrumbItem}s
 */
@typeScript
type StudioBreadcrumb mixes UiSdlComponent<UiSdlNoData> {

  /*
   * -------------- GET SELECTED COMPONENT IN THE BREADCRUMB-------------- 
   */ 

  /**
   * When true, the breadcrumb will be styled similar to {@link UiSdlBreadcrumb}
   */
  classicBreadcrumb: boolean

  /**
   * Stores the list of breadcrumbItem selected in the breadcrumb
   */
  breadcrumbItems: [BreadcrumbItem]

  /**
   * Creates an action to update the `breadcrumbItems` that are selected
   */
  @uiSdlActionCreator(actionType='SET_BREADCRUMB_ITEMS')
  setBreadcrumbAction: private function(componentId: !string, breadcrumbItems: [Obj]): !UiSdlReduxAction ts-client

  /**
   * Creates an action to get breadcrumbItem when clicking on the breadcrumb
   */
  @uiSdlActionCreator(actionType='CLICK_BREADCRUMB')
  clickBreadcrumbAction: private function(componentId: !string, breadcrumbItem: Obj): !UiSdlReduxAction ts-client


  /**
   * Updates the `breadcrumbItems` in the reducer
   */
  @uiSdlReducer(actionType='SET_BREADCRUMB_ITEMS')
  setBreadcrumbReducer: private function(state: !UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxState ts-client 
}
