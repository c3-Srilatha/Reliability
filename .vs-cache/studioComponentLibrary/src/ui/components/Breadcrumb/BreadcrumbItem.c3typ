/**
 * Define the breadcrumb in a breadcrumbItems
 */
@typeScript
type BreadcrumbItem {

  /**
   * Stores the title of the breadcrumb
   */
  label: string

  /**
   * Stores the value of the breadcrumb
   */
  value: string | UiSdlDynamicValueSpec

  /**
   * Whether a breadcrumbItem should be disabled
   */
  disabled: boolean

  /**
   * Render an icon for the breadcrumb item
   */
  iconProps: BreadcrumbItemIconProps
}
