/**
 * Define the breadcrumb in a breadcrumbItems
 */
@typeScript
type BreadcrumbItemIconProps {

  /**
   * Suffix of the icon
   *
   * See usage in {@link UiSdlGraphicReact} implementation, under SDLGraphic component
   */
  iconSuffix: string

  /**
   * Color of the component
   *
   * See usage in {@link UiSdlGraphicReact} implementation, under SDLGraphic component
   */
  color: string

  /**
   * Path of the image source.
   *
   * See usage in {@link UiSdlGraphicReact} implementation, under SDLGraphic component
   */
  imagePath: string

  /**
   * Text for the tooltip
   *
   * See usage in {@link UiSdlGraphicReact} implementation, under SDLGraphic component
   */
  tooltip: string

}
