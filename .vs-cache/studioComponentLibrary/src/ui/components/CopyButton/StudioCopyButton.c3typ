/**
 * A generic copy button component that accepts and copies text to the clipboard
 */
@typeScript
type StudioCopyButton mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The text to copy when the {@link StudioCopyButton} is clicked.
   */
  text: string

  /**
   * Whether to hide the {@link StudioCopyButton#text} adjacent to the {@link StudioCopyButton}.
   */
  hideText: boolean

  /**
   * Whether to show the "copied" text as a tooltip when clicked
   * If false, the copied text will be shown as a text adjacent to button.
   */
  showCopiedTextAsTooltip: boolean
}
