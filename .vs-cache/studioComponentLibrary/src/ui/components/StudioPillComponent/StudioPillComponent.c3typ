/**
 * Embed the time range component in a form or page somewhere
 */
@typeScript
type StudioPillComponent mixes UiSdlComponent<UiSdlNoData> {

  /**
   * Key for contentMap, iconMap, and colorMap.
   * If contentMap is not given or content is not in contentMap, content is displayed in pill
   */
  content: !string

  /**
   * Maps content field to text to display in pill
   */
  contentMap: Obj

  /**
   * If iconMap is not given or content is not in iconMap, given iconSuffix is displayed in pill
   */
  icon: string

  /**
   * Maps content field to iconSuffix of icon to display in pill
   */
  iconMap: Obj

  /**
   * If colorMap is not given or content is not in colorMap, color field colors the pill
   */
  color: string enum('red', 'yellow', 'green', 'blue', 'gray')

  /**
   * Maps content field to color of pill
   */
  colorMap: Obj

  /**
   * Tooltip that appears when you hover on the pill component
   */
  tooltip: string

  /**
   * If passed, the pill component will be clickable and this lambda will be called when pill is clicked
   */
  onClick: lambda()

  /**
   * The position of tooltip
   */
  tooltipPosition: string
}
