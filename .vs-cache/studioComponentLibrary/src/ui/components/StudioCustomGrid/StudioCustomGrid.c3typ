 /**
 * The custom grid that can handle logic for dataCollection props
 */
@typeScript
type StudioCustomGrid mixes UiSdlComponent<UiSdlNoData> {
  /**
   * The content of the dataCollection props, which is a list of json object
   * Example:
   *[{"valueType": "double","name": "longitude"},{"valueType": "int","name": "population"}]
   */
  content: [json]
}
