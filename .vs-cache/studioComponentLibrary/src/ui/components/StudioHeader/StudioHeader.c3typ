/**
 * The standard header component for studio related packages
 */
@beta
@typeScript
type StudioHeader mixes UiSdlComponent<UiSdlNoData>{

  /**
   * Static title for the header
   */
  title: string | UiSdlDynamicValueSpec

  /**
   * Static sub-title for the header
   */
  subtitle: string | UiSdlDynamicValueSpec

  /**
   * Static tooltip that appears to the right of the title
   */
  tooltip: string | UiSdlDynamicValueSpec

  /**
   * Header components to be displayed on the right of the header. Will be to the left of the iconActions if
   * there's any. The components are componentRefs so that users can provide any atomic components.
   */
  headerComponents: [StudioHeaderComponentRef]

  /**
   * An icon action group to be displayed on the very right of the header.
   */
  iconActions: [UiSdlAction]

  /**
   * The threshold for icons to collpase into a dropdown
   */
  iconActionsCollapseThreshold: int = 4

  /**
   * The pill component showing status in the header
   */
  pillComponent: UiSdlComponentRef<StudioPillComponent>

  /**
   * Triggered when an icon action button is clicked.
   *
   * @param id
   *          Id of the component.
   * @param actionSuffix
   *          The action button that was clicked.
   *
   * @returns An `ACTION_CLICK_${actionSuffix}` action for this instance.
   */
  @uiSdlActionCreator(actionType='ACTION_CLICK_${actionSuffix}')
  clickButtonAction: function(id: string, actionSuffix: string): !UiSdlActionClickAction ts-client
}
