@typeScript
type FieldNameElementsList mixes UiSdlComponent<UiSdlNoData> {

  /**
   * Named elements
   */
  elements: [json]

  /**
   * Configuration for what to show if their are no elements.
   * When actionSuffix is specified, clicking the cell will dispatch an action
   */
  emptyConfig: UiSdlAction

  /**
   * When rendering the element data, concatenate the strings together (comma separated).
   */
  concatenate: boolean

  /**
   * Name of the field in the elements to show data for
   */
  fieldName: string = 'name'
}
