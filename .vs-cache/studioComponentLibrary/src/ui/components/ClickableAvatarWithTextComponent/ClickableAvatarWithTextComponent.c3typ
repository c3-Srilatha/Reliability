/**
 * An optionally clickable component supporting avatar & text
 */
@typeScript
type ClickableAvatarWithTextComponent mixes UiSdlComponent<any> {

  /**
   * The displayed content of the button.
   */
  content: UiSdlDynamicValueSpec

  /**
   * The link to direct to if the usage style is a link.
   */
  link: UiSdlDynamicValueSpec

  /**
   * The the usage style for the button.
   */
  usage: string enum('button', 'link', 'text')

  /**
  * The orientation to display avatar and text with, either vertical or horizontal. Defaults to horizontal.
  */
  orientation: string enum('HORIZONTAL', 'VERTICAL') = 'HORIZONTAL'

  /**
  * Font size for text element
  */
  fontSize: string enum('xs', 'sm', 'md', 'lg', 'xl') = 'md'

  /**
   * Props for the prepended avatar
   */
  prependedAvatar: UiSdlGraphicAvatarStaticConfig

  /**
   * Props for the appended avatar
   */
  appendedAvatar: UiSdlGraphicAvatarStaticConfig

  /**
   * Arguments for the click action
   */
  actionArgs: json

  /**
   * Whether the text should be truncated
   */
  truncate: boolean = false

  /**
   * If provided, the inner text content will be truncated to this character limit. Only applicable when the truncate prop is true.
   * Useful to prevent rendering extremely long strings onto the DOM even when truncation is enabled.
   */
  truncatedCharacterLimit: int

  /**
   * Renders a tooltip when hover over content
   */
  tooltip: UiSdlDynamicValueSpec

  /**
   * Whether link should open in new tab if the usage style is a link.
   */
  opensInNewTab: boolean = false

  /**
   * Triggered when the component is clicked.
   *
   * @param id
   *            Id of the component.
   * @returns A `CLICK_ACTION` action for this instance.
   */
  @uiSdlActionCreator(actionType='CLICK_ACTION')
  clickAction: private function(id: string, args: json): !UiSdlReduxAction ts-client
}
