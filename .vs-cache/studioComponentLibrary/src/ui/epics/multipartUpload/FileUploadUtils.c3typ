/**
 * A util type to handle behaviors that are associated with, but not part of the {@link MultipartUploadEpic}
 */
@typeScript
type FileUploadUtils {

  /**
   * Moves a file from fileChunkDropUrl to fileInboxUrl after a Multipart-upload
   *
   * @param action
   *         The action where this call originates
   * @param state
   *         Redux State
   * @param fileChunkDropUrl
   *         The source url of the file to transfer
   * @param fileInboxUrl
   *         The target url of the file to transfer
   * @param followUpAction
   *         An action to dispatch on completion of the move
   */
  transferFileToInboxUrl: function(action: UiSdlReduxAction, state: UiSdlReduxState, fileChunkDropUrl: string,
    fileInboxUrl: string, followUpAction: UiSdlReduxAction) ts-client
}
