/**
 * Represents the structure around a file object used for multi-part upload.
 */
@typeScript
type FileToUpload mixes FileToUploadBase {

  /**
   * The name of the file
   */
  name: string

  /**
   * The file upload status
   */
  uploadStatus: string enum FileUploadStatus

  /**
   * The error thrown while uploading
   */
  uploadError: string

  /**
   * The size in bytes to slice the file for the multi-parts upload
   */
  multipartSliceSize: double

  /**
   * The parts the file was sliced into
   */
  parts: [FilePartToUpload]

  /**
   * Source inferred for the file
   */
  inferredSource: [json]
}
