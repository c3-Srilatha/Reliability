/**
 * Epic to manage multi-part uploads
 */
@typeScript
type MultipartUploadEpic mixes UiSdlEpic {

  /**
   * Triggers an action that adds a file to a dataset
   *
   * @param filesToUpload
   *            An array of {@link FileToUploadBase} objects
   * @returns a 'UPLOAD_FILES' action
   */
  @uiSdlActionCreator(actionType='UPLOAD_FILES')
  uploadFilesAction: function(filesToUpload: [FileToUploadBase], sendAsText: boolean): !UiSdlReduxAction ts-client

  /**
   * Triggers an action with the {@link FileToUpload} object containing latest status
   *
   * @param fileToUpload
   *            {@link FileToUploadBase} object
   * @returns a 'FILE_TO_UPLOAD_UPDATE' action
   */
  @uiSdlActionCreator(actionType='FILE_TO_UPLOAD_UPDATE')
  notifyClientOfStatusChange: function(fileToUpload: FileToUpload): !UiSdlReduxAction ts-client
}
