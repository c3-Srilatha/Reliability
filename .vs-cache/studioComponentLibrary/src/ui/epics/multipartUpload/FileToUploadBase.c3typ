/**
 * Represents the structure around a file object needed to initiate the multi-part upload
 */
@typeScript
type FileToUploadBase {

  /**
   * The id for the file
   */
  id: string

  /**
   * A slice of a file object. See https://developer.mozilla.org/en-US/docs/Web/API/File
   */
  file: any

  /**
   * The c3 server url to upload the file to. I.e. `s3://c3.prod--stage-services/dl/c3/c3/myFolder/inbox/test.csv`
   */
  url: string
}
