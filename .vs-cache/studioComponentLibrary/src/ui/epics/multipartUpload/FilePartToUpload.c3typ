/**
 * Represents the structure around a file part object used for multi-part upload.
 */
@typeScript
type FilePartToUpload mixes FileToUploadBase {

  /**
   * The upload status of the file
   */
  uploadStatus: string enum FileUploadStatus

  /**
   * The number of times the file upload was retried in case of failures
   */
  uploadRetries: int

  /**
   * The file upload error message
   */
  uploadErrorMessage: string

  /**
   * The id of {@link FileToUpload} this part belongs to
   */
  parentId: string
}
