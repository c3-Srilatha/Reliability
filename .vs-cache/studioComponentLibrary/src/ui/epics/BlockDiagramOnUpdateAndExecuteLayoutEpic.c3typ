/**
 * Reusable epic for any {@link UiSdlDiagram} that should have its UI blocked when it is updated or laid out.
 * Consumers must `"payloadStrategy": "MERGE"` a `loaderListComponentId` to the triggering action payloads.
 * The triggering actions are:
 *  - {@link UiSdlDiagram#updateAndExecuteLayoutAction}
 *  - {@link UiSdlDiagram#completeExecuteLayoutAction}
 *  - {@link UiSdlDiagram#clearRenderQueueAction}
 */
@typeScript
type BlockDiagramOnUpdateAndExecuteLayoutEpic mixes UiSdlEpic {

  updateAndExecuteLayoutAction: function(diagramId: string, shapeUpdates: [UiSdlDiagramUpdate]): !UiSdlReduxAction

  epic: ~
}
