/*
 * A generalized epic that allows an action to be dispatched with the most recent time.
 * Used to alert the user of various applications of their autorefresh behavior.
 * Payload takes in an action and an optional format string (ex: "H:mm:ss a").
 * Default format is "MMMM dd, H:mm:ss a".
 * Example payload:
 *  "payload": {
 *    "action": {
 *      "type": "Studio.ActivityState.UPDATE_LAST_REFRESHED",
 *      "payload": {
 *         "componentId": "Studio.ActivityState"
 *       }
 *     },
 *    "format": "H:mm:ss a"
 *  }
 */
@typeScript
type UpdateLastRefreshedTimeEpic mixes UiSdlEpic {

  epic: ~ ts-client

}
