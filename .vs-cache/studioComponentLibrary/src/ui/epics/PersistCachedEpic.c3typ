/**
 * Epic to persist an {@link Cached} into an application's package.
 * Use this epic to ensure that cached items, (like {@link Config}s) are properly saved when there is a possibility of publishing
 * an application's contents to source control
 */
@typeScript
type PersistCachedEpic mixes UiSdlEpic {

  /**
   * An action to persist an {@link Cached} to be seeded as part of an application's package
   *
   * @param cachedTypeName
   *         The kind of {@link Cached} to persist
   * @param cachedKey
   *         The cachedKey to use for the {@link Cached}
   * @param cachedIdentifier
   *         The identifier for the {@link Cached}
   * @param cacheType
   *         The artifact folder in src where the {@link Cached} object should be created
   * @return an action to persist a {@link Cached} object
   */
  @uiSdlActionCreator(actionType='PERSIST_CACHED')
  persistCachedAction: function(cachedTypeName: !string serialized Type,
                                cachedKey: !string enum('name', 'id'),
                                cachedIdentifier: !string,
                                cacheType: !string enum('seed', 'config')): !UiSdlReduxAction ts-client

  epic: ~ ts-client
}
