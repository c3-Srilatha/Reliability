/**
 * Epic to periodically dispatch an action on a timer. Timer is reset when epic is triggered again.
 * Takes a {@link RepeatIntervalSpec} to define the interval duration and the action to be dispatched.
 */
@typeScript
type RepeatIntervalEpic mixes UiSdlEpic {

  /**
   * A generic action to start the interval repeat loop.
   *
   * @param actionSuffix
   *           The action suffix for the specific repeat process
   * @param interval
   *           The interval at which the action should be repeated
   * @param repeatAction
   *           The action to be repeated
   * @param stopIntervalConditions
   *           The conditions under which the action should stop repeating
   * @returns a `REPEAT_INTERVAL_${actionSuffix}` action
   */
  @uiSdlActionCreator(actionType='REPEAT_INTERVAL_${actionSuffix}')
  repeatIntervalAction: function(actionSuffix: string, interval: UiSdlDynamicValueSpecParam, repeatAction: UiSdlReduxAction, stopIntervalConditions: [UiSdlDynamicValueSpecParam]): !UiSdlReduxAction ts-client

  epic: ~ ts-client
}
