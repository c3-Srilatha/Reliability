/**
 * Spec to handle determining if polling {@link PollingEpic} was succesful
 */
@typeScript
type PollingSuccessSpec {
  /**
   * The path to data in the result that needs to be compared.
   */
  dataPath: string

  /**
   * The comparator operator.
   */
  comparator: string enum('<', '>', '<=', '>=', '==', '!=') = '=='

  /**
   * The value to compare data in the dataPath with.
   */
  value: any
}
