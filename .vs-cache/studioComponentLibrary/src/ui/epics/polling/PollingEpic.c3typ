/**
 * Epic to poll for a generic action asynchronously and dispatch actions according to the result
 * To include this epic as part of your application, configure an effectTrigger as follows:
 * 
 *   {
 *    "trigger": {
 *       "type": "[string]",
 *       "value": ["<TypeName>_<ActionName>.START_POLLING", "<TypeName>_<ActionName>.STOP_POLLING"]
 *     },
 *     "effectType": "PollingEpic"
 *   }
 *
 *
 * You will also need to dispatch a `startPollingAction` with an {@link PollingSpec}. 
 * The `typeName` and `actionName` will be the componentId utilized throughout the polling process
 *
 *
 * To handle a succesful result, listen to `POLLING SUCESS`:
 *   {
 *     "trigger": "<TypeName>_<ActionName>.get.POLLING_SUCCESS",
 *     "effectType": "MyFollowUpEpic",
 *   }
 * 
 * To handle an unexpected error, listen to `POLLING_FAILED`.
 */
// TODO PLAT-64192: move this into uiInfrastructure
@typeScript
type PollingEpic mixes UiSdlEpic {

  epic: ~ ts-client

  /**
   * This action is utilized the initially fire this epic.
   * Provide a {@link PollingSpec} to asynchronously 
   * poll for an action in the type system
   *
   * @param spec
   *         Spec detailing the type and action, as well as other optional fields to poll
   */
  @uiSdlActionCreator(actionType='START_POLLING')
  startPollingAction: function(spec: PollingSpec): !UiSdlReduxAction ts-client

  /**
   * This action is dispatched by this epic to indicate that polling should stop
   * It also needs to be a trigger of this epic in json configuration in order to properly
   * complete polling.
   * Note: This action should generally not be dispatched by other epics
   * 
   * @param componentId
   *         The componentId used across polling actions for a specific 
   *         type and action. it is derived from the initial {@link PollingSpec}
   */
  @uiSdlActionCreator(actionType='STOP_POLLING')
  stopPollingAction: function(componentId: string): !UiSdlReduxAction ts-client

  /**
   * This action is dispatched by this epic to indicate that polling was successfull
   * To handle the positive flow of polling, listen for this action.
   * 
   * @param componentId
   *         The componentId used across polling actions for a specific 
   *         type and action. it is derived from the initial {@link PollingSpec}
   * @param result
   *          The result associated with the success
   */
  @uiSdlActionCreator(actionType='POLLING_SUCCESS')
  pollingSuccessAction: function(componentId: string, result: PollingSucessResult): !UiSdlReduxAction ts-client

  /**
   * This action is dispatched by this epic to indicate that polling encountered an exception
   * To handle the error flow of polling, listen for this action.
   * 
   * @param componentId
   *         The componentId used across polling actions for a specific 
   *         type and action. it is derived from the initial {@link PollingSpec}
   * @param result
   *          The error associated with the failure
   */
  @uiSdlActionCreator(actionType='POLLING_FAILED')
  pollingFailedAction: function(componentId: string, error: any): !UiSdlReduxAction ts-client

  /**
   * This action is dispatched by this epic to indicate that an iteration of polling occurred
   * 
   * @param componentId
   *         The componentId used across polling actions for a specific 
   *         type and action. it is derived from the initial {@link PollingSpec}
   * @param response
   *          The response associated with an incomplete call to the polling action
   */
  @uiSdlActionCreator(actionType='POLLING_TICK')
  pollingTickAction: function(componentId: string, response: any): !UiSdlReduxAction ts-client
}
