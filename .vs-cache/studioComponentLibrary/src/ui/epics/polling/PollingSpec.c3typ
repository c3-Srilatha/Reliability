/**
 * Spec to handle polling in {@link PollingEpic}
 */
@typeScript
type PollingSpec  {

  /**
   * The name of the type to dispatch the polling for
   */
  typeName: !string

  /**
   * The action on the typeName to dispatch polling for
   */
  actionName: !string

  /**
   * Any arguments required for the action being polled
   */
  args: map<string, any>

  /**
   * The interval to dispatch polling actions (seconds)
   */
  pollingInterval: int = 1000

  /**
   * The initial delay before dispatching the polling action (seconds)
   */
  delayBeforePolling: int = 0

  /**
   * The timeout to stop polling (seconds)
   */
  timeout: int = 5000

  /**
   * The spec to determine when polling should complete
   */
  // TODO PLAT-64192: make this more generic to support a callback 
  sucessSpec: PollingSuccessSpec

  /**
   * Whether the polling epic should dispatch an acknoledgement of 
   * partial responses recieved from the action
   */
  dispatchTick: boolean = false
}
