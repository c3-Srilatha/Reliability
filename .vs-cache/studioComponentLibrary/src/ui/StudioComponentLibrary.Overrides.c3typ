/**
 * Overrides for the Studio Component Library that allow customization of core functionality.
 * This type defines functions that can be overridden to modify the behavior of the Studio UI.
 */
@typeScript
type StudioComponentLibrary.Overrides {

  /**
   * Returns the partially applied action to fetch the app's info.
   *
   * @param state - The current Redux state of the application
   * @returns A partially applied action
   */
  fetchAppInfoDataSpec: function(state: UiSdlReduxState): App ts-client
}
