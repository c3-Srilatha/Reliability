/**
 * Represents how a chat agent will be displayed by the frontend Studio.GenAiChat toggle component.
 */
type StudioGenAiState.ChatAgentUi {

  // Used as the value, i.e. "CodeAssistantUi"
  agentTypeName: !string

  // Whether the agent is enabled
  enabled: !boolean

  // The icon to display next to the agent content, i.e. "infinity"
  icon: string

  // The text to display on the toggle
  content: string

  // A tooltip text to show when hovering over the toggle
  tooltip: string

  // Loading messages for the agents
  loadingMessages: string
}
