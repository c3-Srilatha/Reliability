/**
 * Additional context to provide GenAi agent
 */
type StudioGenAiState.Context {

  /**
   * The key of the context
   */
  key: !string

  /**
   * Description of what the key / value pair means, should be structured such that the sentence
   * `${description} is ${value}` makes sense
   */
  description: !string

  /**
   * The value the agent should use
   */
  value: any

  /**
   * Optional variable name. If provided, changes the sentence to `${description} is ${varName} = ${value}`
   */
  varName: string

  /**
   * Optional lambda function that gets the context value during runtime
   * Once specified, the {@link StudioGenAiState.Context#value} will be overridden by the result of this function
   */
  getValue: lambda(state: UiSdlReduxState): any
}
