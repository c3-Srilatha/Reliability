type StudioGenAiChatMessage mixes WithId {

  /**
   * The current user who sends the message
   * If empty, the message is from C3 Generative AI
   */
  user: User

  /**
   * The message content
   */
  message: string

  /**
   * The timestamp of the message
   */
  timestamp: !DateTime

  /**
   * The status of the message
   * This should stay consistent with StudioGenAiChatStatus in StudioGenAiState.ts
   */
  status: string enum('pending', 'success', 'error', 'stopped')

  /**
   * If user has given thumbs up for this message
   */
  thumbsUp: boolean

  /**
   * If user has given thumbs down for this message
   */
  thumbsDown: boolean

  /**
   * The database id of the feedback submitted for this message if any
   * If empty, no feedback has been submitted
   * If not empty, another feedback submitted for this message will update the existing feedback with the same id
   */
  feedbackId: string

  /**
   * Loading messages, to be displayed while the message is in a pending state
   */
  loadingMessages: [string]
}
