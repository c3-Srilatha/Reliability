/**
 * A pair of question and answer in a chat session with C3 Generative AI
 */
type StudioGenAiQuestionAnswerPair mixes WithId {

  /**
   * The question that was asked
   */
  question: StudioGenAiChatMessage

  /**
   * The answer that was given by C3 Generative AI to the {@link #question}.
   */
  answer: StudioGenAiChatMessage
}
