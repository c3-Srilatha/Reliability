/**
 * Dynamic value spec that extracts a value from a part of state that is a map
 */
@typeScript
type MapStateParam mixes UiSdlDynamicValueSpecParam {

  /**
   * The map to extract values from
   */
  mapState: UiSdlDynamicValueSpecParam

  /**
   * The key to extract from the map
   */
  key: UiSdlDynamicValueSpecParam

  /**
   * Additional path context for the extracted item
   */
  path: string

  /**
   * An action to evaluate on the extracted value
   */
  action: string

  extract: ~ ts-client
}
