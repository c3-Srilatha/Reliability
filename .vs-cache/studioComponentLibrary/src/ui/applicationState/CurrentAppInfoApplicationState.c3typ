/**
 * A generic application state to store current app information through {@link C3#app}
 * Note: Must created an metadata instance `CurrentAppInfo.ApplicationState` to use this appState.
 */
type CurrentAppInfoApplicationState mixes UiSdlSingletonApplicationState {

  id: ~

  /**
   * Meta info about the current application
   */
  currentAppInfo: json

  /**
   * An action to set `currentAppInfo`
   */
  @uiSdlActionCreator(actionType="SET_CURRENT_APP_INFO")
  setCurrentAppInfoAction: private function(currentAppInfo: json): !UiSdlReduxAction

  /**
   * Listens for actions of type `SET_CURRENT_APP_INFO` and sets `currentAppInfo`
   */
  @uiSdlReducer(actionType="SET_CURRENT_APP_INFO")
  setCurrentAppInfoReducer: private inline function(state: !UiSdlReduxState,
                                                    action: !UiSdlReduxAction): !UiSdlReduxState

  /**
   * Retrieves the `currentAppInfo` from state
   */
  getCurrentAppInfo: function(state: !UiSdlReduxState): json

  /**
   * Getter to determine if the current application is in production mode
   */
  isAppInProdMode: function(state: !UiSdlReduxState): boolean

  /**
   * Triggered to signal to the state to update the appInfo and singleNode
   *
   * @returns a `GET_CURRENT_APP_INFO` action for this instance
   */
  @uiSdlActionCreator(actionType='GET_CURRENT_APP_INFO')
  getCurrentAppInfoAction: private function(): !UiSdlAction ts-client

  /**
   * Epic to populate the `currentAppInfo` on application state initialize
   */
  @uiSdlEpic(actionType='GET_CURRENT_APP_INFO')
  setCurrentAppInfoEpic: private inline function(state: !UiSdlReduxState,
                                                 action: !UiSdlReduxAction): !UiSdlReduxState ts

  /**
   * Map of package dependencies for the current application
   */
  packageDependencies: Map<string, Pkg>

  /**
   * An action to set `packageDependencies`
   */
  @uiSdlActionCreator(actionType='SET_PACKAGE_DEPENDENCIES')
  setPackageDependenciesAction: private function(packageDependencies: Map<string, Pkg>): !UiSdlReduxAction

  /**
   * Listens for actions of type `SET_PACKAGE_DEPENDENCIES` and sets `packageDependencies`
   */
  @uiSdlReducer(actionType='SET_PACKAGE_DEPENDENCIES')
  setPackageDependenciesReducer: private inline function(state: !UiSdlReduxState,
                                                         action: !UiSdlReduxAction): !UiSdlReduxState

  /**
   * Retrieves the `packageDependencies` from state
   */
  getPackageDependencies: function(state: !UiSdlReduxState): Map<string, Pkg>
}
