/**
 * An application state for storing the {@link User#myUser} of the target app
 * for studio applications. The user stored in `SDL.DefaultSite` is the StudioUser,
 * with different permissions than the user in the target app.
 */
type CurrentUserApplicationState mixes UiSdlSingletonApplicationState {

  id: ~

  /**
   * {@link User#myUser}
   */
  currentUser: User

  /**
   * An action to set `currentUser`
   */
  @uiSdlActionCreator(actionType="SET_CURRENT_USER")
  setCurrentUserAction: private function(currentUser: User): !UiSdlReduxAction

  /**
   * Listens for actions of type `SET_CURRENT_USER` and sets `currentUser`
   */
  @uiSdlReducer(actionType="SET_CURRENT_USER")
  setCurrentUserReducer: private inline function(state: !UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxState

  /**
   * Retrieves the `currentUser` from state
   */
  getCurrentUser: function(state: !UiSdlReduxState): User

  /**
   * Epic to populate the `currentUser` on application state initialize
   */
  @uiSdlEpic(actionType='APPLICATION_STATE_INITIALIZE')
  setCurrentUserEpic: private inline function(state: !UiSdlReduxState,
                                                         action: !UiSdlReduxAction): !UiSdlReduxState ts
}
