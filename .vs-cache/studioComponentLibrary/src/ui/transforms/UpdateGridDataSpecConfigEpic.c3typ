/**
 * An Epic to update the data configs for the datasources of a {@link UiSdlDataGrid} and requests data after update
 */
@typeScript
type UpdateGridDataSpecConfigEpic mixes UiSdlEpic {

  /**
   * Action to trigger {@link UpdateGridDataSpecConfigEpic}
   * @param gridId
   *           The data grid being updated
   * @param typeNameSpec
   *           A dynamic value spec to resolve to the desired typeName for the grid
   * @param filterSpec
   *           A dynamic value spec to resolve to the desired filter string for the fetch and fetchCount call
   * @param includeSpec
   *           A dynamic value spec to resolve to the desired include string for the fetch call
   * @param pageSize
   *           The pageSize to reset to if the grid has pagination enabled
   * @returns UiSdlReduxAction
   */
  @uiSdlActionCreator(actionType='UPDATE_GRID_DATA_SPEC_CONFIG')
  updateDataSpecConfigAction: function(gridId: !string, typeNameSpec: !UiSdlDynamicValueSpecParam, filterSpec: UiSdlDynamicValueSpecParam, includeSpec: UiSdlDynamicValueSpecParam, pageSize: int): !UiSdlReduxAction ts-client

  epic: ~ ts-client
}
