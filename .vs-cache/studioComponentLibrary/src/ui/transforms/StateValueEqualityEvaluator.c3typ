/**
 * Evaluates equality between actual and expected state values using a comparison operator.
 * 
 * This transform compares two values (actual and expected) and returns a boolean result
 * based on the specified operator (EQUAL or NOT_EQUAL). It uses deep equality comparison
 * via lodash's isEqual function to handle complex objects and arrays.
 * 
 * @input object - Contains:
 *   - actual: any - The actual value to compare
 *   - expected: any - The expected value to compare against
 *   - operator: 'EQUAL' | 'NOT_EQUAL' - The comparison operator to use
 * 
 * @returns boolean - true if the comparison evaluates to true, false otherwise
 * 
 * @example
 * Input: { actual: 5, expected: 5, operator: 'EQUAL' }
 * Output: true
 * 
 * @example
 * Input: { actual: { a: 1 }, expected: { a: 2 }, operator: 'NOT_EQUAL' }
 * Output: true
 */
type StateValueEqualityEvaluator mixes UiSdlDataTransform<json, boolean> {

  transform: ~ ts-client
}

