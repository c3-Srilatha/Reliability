/**
 * Merges the passed column fields to the {@link UiSdlDataGrid}'s column fields based on the passed transform flag
 *
 * @param columnFields
 *           {@link UiSdlDataGridDataSpecColumnFieldSetting}
 * @param fieldNameToColumnFieldsMap
 *           A map of fieldName to the columnFields that should be merged if the CanaryMode is enabled.
 * @param transform
 *           Boolean to transform the fields
 * @returns {@link UiSdlDataGridDataSpecColumnFieldSetting}
 */

type GenerateTransformedColumnFields mixes UiSdlDataTransform<json, UiSdlDataGridDataSpecColumnFieldSetting> {
    transform: ~ ts-client
}
