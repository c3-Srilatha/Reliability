/**
 * Transforms a set of {@link Obj} and {@link UiSdlDataGrid} properties into a new set of
 * objects based on the arguments provided.
 * This transform's purpose is to provide search, sort, and pagination capabilities to
 * a grid whose {@link UiSdlDataGrid#dataCollection.objs} are derived via {@UiSdlConnected#derivedProps}
 *
 * Example usage of this transform:
 * MyData.Grid.json
 * {
 *  "type": "UiSdlConnected<UiSdlDataGrid>",
 *  "derivedProps": {
 *   "dataCollection": {
 *     "objs": {
 *       "type": "UiSdlMultiDynamicValueParam",
 *       "params": {
 *         "objs": {
 *           "type": "UiSdlApplicationStateValueParam",
 *           // Derive the original objs from state
 *         },
 *         "columnFields": {
 *           "type": "UiSdlComponentStateParam",
 *           "componentType": "component",
 *           "id": "MyData.Grid",
 *           "path": "dataSpec.columnFields"
 *         },
 *         "filterValue": {
 *           "type": "UiSdlComponentStateParam",
 *           "componentType": "component",
 *           "id": "MyData.Grid",
 *           "path": "value"
 *         },
 *         "sortColumn": {
 *           "type": "UiSdlComponentStateParam",
 *           "componentType": "component",
 *           "id": "MyData.Grid",
 *           "path": "sortColumn"
 *         },
 *         "paginationDataSkipSize": {
 *           "type": "UiSdlComponentStateParam",
 *           "componentType": "component",
 *           "id": "MyData.Grid",
 *           "path": "paginationDataSkipSize"
 *         },
 *         "pageSize": {
 *           "type": "UiSdlComponentStateParam",
 *           "componentType": "component",
 *           "id": "MyData.Grid",
 *           "path": "paginationConfig.pageSize"
 *         }
 *       },
 *       "dataTransforms": ["DeriveUiSdlGridObjs"]
 *     }
 *   },
 *   "dataCollectionCount": {
 *     "type": "UiSdlMultiDynamicValueParam",
 *     "params": {
 *       "objs": {
 *        "type": "UiSdlApplicationStateValueParam",
 *        // Derive the original objs from state
 *       },
 *       "columnFields": {
 *         "type": "UiSdlComponentStateParam",
 *         "componentType": "component",
 *         "id": "StudioFeatureStore.FeatureSetDetailsLambdaFeatureGrid",
 *         "path": "dataSpec.columnFields"
 *       },
 *       "filterValue": {
 *         "type": "UiSdlComponentStateParam",
 *         "componentType": "component",
 *         "id": "MyData.Grid",
 *         "path": "value"
 *       },
 *       "dataCollectionCount": {
 *         "type": "UiSdlDefinedValueParam",
 *         "value": true
 *       }
 *     },
 *     "dataTransforms": ["DeriveUiSdlGridObjs"]
 *   }
 *  },
 *  "component": {
 *   "filterBar": true,
 *   "paginationConfig": {
 *     "pageSize": 5,
 *     "pagination": true
 *   },
 *   "dataSpec": {
 *     "disableDataRequestOnFirstRender": true,
 *     "columnFields": [
 *       {
 *         "fieldName": "columnName",
 *         "label": "StudioFeatureStore.columnName.label",
 *         "searchable": true,
 *         "sortable":
 *       }
 *     ]
 *   }
 * }
 *}
 *
 * The transform's behavior is dependent on which arguments are provided.
 * When `dataCollectionCount` is present and true, the end result of this transform
 * is the size of the filtered objects, corresponding to {@link UiSdlDataGrid#dataCollectionCount}.
 * When a filterValue is present, the objects will be filtered.
 * When a sortColumn is present, the objects will be sorted.
 * When paginationDataSkipSize and pageSize are present, the objects returned will be a subset of the original objects.
 *
 */
@typeScript
type DeriveUiSdlGridObjs mixes UiSdlDataTransform<json, json> {

  transform: ~
}
