@typeScript
type SourceControlConfigFormUtils {

  /**
   * Configure the {@link REST} type
   *
   * @param restUrl
   *        the url that the {@link REST} type will make calls to
   *
   * @param setIsRequestComplete
   *        any function, will update a state so that the client knows that configuring was completed (val: boolean) => void
   *
   * @param restType
   *        the {@link REST} type that we want to configure rest url and token for
   *
   * @param envId
   *        The {@link Env} we want to configure the {@link REST} type for
   *
   * @param token
   *        the token to be set into the {@link REST} config, empty token can be passed in to only set url
   */
  setRestAuthAndUrlOnEnv: function(restType: !string, envId: !string, restUrl: string, token: string) ts-client

  /**
   * Retrieve an instance of {@link SourceControlRestApi} with the given repo set and set it
   *
   * @param repoUrl
   *        full repository url to get an updated {@link SourceControlRestApi} instance
   *
   * @param restInst
   *        Our current instance of {@link SourceControlRestApi} that we are going to update
   *
   * @param setRestInst
   *        setter used to replace the previous instance of the api to a new version with repository configured
   *        follows format (val: {@link SourceControlRestApi}) => void
   *
   * @param restType
   *        the {@link REST} type of the api that we are trying to configure
   */
  configureRestApiRepo: function(repoUrl: !string,
                                 restInst: !SourceControlRestApi,
                                 setRestInst: !any,
                                 restType: !string) ts-client
}
