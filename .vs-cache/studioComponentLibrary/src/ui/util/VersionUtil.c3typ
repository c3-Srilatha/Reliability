/**
 * Utility functions for handling {@link SemanticVersion}
 */
@typeScript
type VersionUtil {

  /**
   * Compares two semantic version strings. This utility ignores pre-release portion of versions.
   * returns 1 if 'version1' is semantically greater than 'version2'
   * returns -1 if 'version1' is semantically less than 'version2'
   * returns 0 if `version1` is semantically equal to `version2` (ignoring pre-release portions)
   * See {@link SemanticVersion#compareTo}
   */
  compareSemanticVersions: function(version1: !string serialized SemanticVersion,
                                    version2: !string serialized SemanticVersion): int ts-client

  /**
   * Similar to {@link #compareSemanticVersions} but ignores the patch version.
   */
  compareMajorMinorSemanticVersions: function(version1: !string serialized SemanticVersion,
                                              version2: !string serialized SemanticVersion): int ts-client
}
