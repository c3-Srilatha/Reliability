@typeScript
type StudioActionResultSpec {

  /**
   * Banner to show on result
   */
  bannerId: string = 'StudioComponentLibrary.BannerContainer'

  /**
   * Message to display, if any, as a result of the action
   */
  message: !UiSdlDynamicValueSpec

  /**
   * Whether or not to display a banner as a result of the action
   */
  skipBanner: boolean

  /**
   * Actions to dispatch on action result.
   * If the lambda argument `isError` is true, the `response` object is the Error.
   */
  actionGenerator: lambda(response: any, isError: boolean): UiSdlActionsObservable

  /**
   * Criteria to follow this result path. When not specified, any call that
   * does not error is considered a success.
   */
  criteria: lambda(response: any): boolean
}
