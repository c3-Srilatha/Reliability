/**
 * Parameters for {@link ChatAgentUi#ask}, supported by Studio.GenAiChat
 */
type ChatAgentUi.AskParams {

  /**
   * The question to ask.
   */
  question: !string

  /**
   * the id of the chat session.
   */
  chatId: !string

  /**
   * The server version of the current application
   */
  serverVersion: string

  /**
   * A list of Question/Answer pairs. Purposely left as json to allow for different question/answer formats
   */
  chatHistory: [json]

  /**
   * A list of context objects that are stored in the Gen Ai Chat state.
   */
  context: [StudioGenAiState.Context]
}
