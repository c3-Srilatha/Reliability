/**
 * Defines the interface for a chat agent that will be used in the Studio GenAI chat component.
 */
abstract type ChatAgentUi mixes Named {

  // see {@link StudioGenAiState.ChatAgentUi#icon}
  icon: string

  // tooltip text to display when hovering over the agent icon
  tooltip: string

  // loading messages to be displayed while response is pending
  loadingMessages: string

  // Called when a user submits a question for the specific agent.
  ask: abstract member function(askParams: !ChatAgentUi.AskParams): !ChatAgentUi.Answer js-server

  // Determines if the agent is enabled, populates {@link StudioGenAiState.ChatAgentUi#enabled}
  enabled: abstract member function(): boolean js-server

  // Called when the user submits feedback
  submitFeedback: abstract member function(feedbackSpec: !ChatAgentUi.FeedbackSpec): !Pair<!string, !string> js-server
}
