type ChatAgentUi.FeedbackSpec {

  /**
   * The question that was asked
   */
  question: !string

  /**
   * The answer that was given
   */
  answer: !string

  /**
   * The client service from which the feedback is given. Could be jupyter, VSCE, community, etc.
   */
  client: !string

  /**
   * The server version of the current application
   */
  serverVersion: !string

  /**
   * A list of Question/Answer pairs. Purposely left as json to allow for different question/answer formats
   */
  chatHistory: [json]

  /**
   * The feedback given by the user for the answer
   */
  feedback: ChatAgentUi.AnswerFeedback
}
