/**
 * A util type to format content length (bytes) to different units like KB, MB, GB, etc
 */
@typeScript
type ContentLengthUtil {

  /**
   * convert content size from bytes to other units
   */
  formatBytes: function(bytes: double, decimal: double): string ts-client
}
