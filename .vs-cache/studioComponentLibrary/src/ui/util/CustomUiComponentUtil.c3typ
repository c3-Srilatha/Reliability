@typeScript
type CustomUiComponentUtil {

  /**
   * Async request to c3server. Promise resolves with the response from the server.
   */
  c3Request: function(typeName: string, actionName: string, params: any): Promise<any> ts-client

  /**
   * requestArgs: { typeName: string, actionName: string, actionArgs: any }
   */
  parallelRequestsObservable: function(actionRequests: [map<string, any>]): !UiSdlActionsObservable ts-client
}
