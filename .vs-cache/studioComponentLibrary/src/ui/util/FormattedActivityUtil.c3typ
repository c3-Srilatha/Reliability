/**
 * A util type to format activitites
 */
@typeScript
type FormattedActivityUtil {

  /**
   * Returns the formatted activity string as (By {user} at {timestamp}).
   * @param user
   *          The user who created the associated activity
   * @param timestampString
   *          Timestamp string that is parseable by Date
   * @param timestampFormatSpec
   *          Specification of how to format the timestamp
   * @return Formatted activity string
   */
  getFormattedActivityString: function(user: string, timestampString: string, timestampFormatSpec: UiSdlDateTimeParamKindFormatSpec): string ts-client

  /**
   * Formats a timestamp string according to the provided spec
   * @param timestampString
   *          Timestamp string that is parseable by Date
   * @param timestampFormatSpec
   *          Specification of how to format the timestamp
   * @return Formatted timestamp
   */
  formatTimeStamp: function(timestampString: string, timestampFormatSpec: UiSdlDateTimeParamKindFormatSpec): string ts-client

  /**
   * Converts a time interval into {@link Duration}
   * @param rawTime
   *          The raw time interval either as a time string or a number of seconds
   * @return The {@link Duration} equivalent to rawTime
   */
  getDuration: function(rawTime: string | decimal): Duration ts-client

  /**
   * Formats a duration with units for UI presentation
   * @param duration
   *          The {@link Duration} to be formatted
   * @param truncated
   *          Returns a shorter version of the formatted duration ('8 min 6 sec' -> '8m 6s')
   * @param singleUnit
   *          Returns a single unit version of the formatted duration ('8 min 30 sec' -> '8.5 min')
   *          Can use both params together to get a truncated single unit. (ex. 8.5m)
   * @return A formatted string representing the duration with spacing and units
   */
  formatDuration: function(duration: !Duration, truncated: boolean, singleUnit: boolean): string ts-client

}
