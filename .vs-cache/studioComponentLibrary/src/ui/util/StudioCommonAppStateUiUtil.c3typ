/**
 * UI Helper functions for Studio's application states.
 */
@typeScript
type StudioCommonAppStateUiUtil mixes Value {

  /**
   * Clears the app state for id.
   *
   * @param id
   *            The id of the application state to be cleared
   * @param state
   *            The redux state
   *
   * @return the updated UiSdlReduxState
   */
  clearAppState: function(id: string, state: !UiSdlReduxState): !UiSdlReduxState ts-client

  /**
   * Clears the component state for the corresponding component id.
   *
   * @param componentId
   *             The id of the component state to be cleared.
   * @return the updated UiSdlReduxState
   */
  clearComponentState: function(componentId: !string, state: !UiSdlReduxState): !UiSdlReduxState ts-client

  /**
   * Sets or removes config value in application state.
   * If the value is undefined, the dataPath will be removed from the application state.
   *
   * @param stateId
   *           Id of the state.
   * @param state
   *           Redux state.
   * @param dataPath
   *           The path to the config value.
   * @param value
   *           The config value to set.
   * @returns Redux state.
   */
  setOrRemoveConfigInApplicationState: function(stateId: !string,
                                                state: !UiSdlReduxState,
                                                dataPath: [string],
                                                value: !any): !UiSdlReduxState ts-client
}
