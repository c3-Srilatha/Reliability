type StudioSourceControlUtils {

  /**
   * Validate that the token and url that is configured for the given environment is valid by calling {@link SourceControlRestApi#validateConfigTokenAndUrl}
   * and return an instance of the {@link SourceControlRestApi} type that is being validated.
   *
   * @param envId
   *        id for the {@link Env} that we want to check
   *
   * @param sourceControlType
   *        the type of source control we are validating token and url for, will be the name of a {@link REST} type
   *
   * @param repoUrl
   *        the optional repo url in the case that a repository has been selected already.
   *
   * @return SourceControlRestApi
   *        returns an instance of {@link SourceControlRestApi}
   */
  envSourceControlConfigs: function(sourceControlType: !string, envId: string): Pair<string, string> js-server

  /**
   * Configures {@link REST#auth} and {@link REST#url} for a source control type for a given environment.
   *    e.g. if sourceControlType is "GitHub", calls {@link GitHub#setApiUrlAndAuth} on the target environment.
   *
   * @param envId
   *        The id for the {@link Env} that we want to configure
   *
   * @param url
   *        The rest url that we will set the config to, will use default within {@link SourceControlRestApi} if null
   *
   * @param token
   *        The authentication token being configured
   *
   * @param sourceControlType
   *        The {@link REST} type for the source control that we are configuring
   */
  configureRestAuthAndUrl: function(sourceControlType: !string, url: string, token: string, envId: string) js-server

  /**
   * Get {@link Pkg.Store}`s git configuration for a given environment
   *
   * @param envId
   *        The id of the {@link Env} we want the {@link Pkg.Store} configuration for, if not passed in will default to retrieving from current environment
   *
   * @return {@link Pkg.Store.Git.Branch} or undefined if the environment is not configured with valid token
   */
  pkgStoreGitConfig: function(envId: string): Pkg.Store.Git.Branch js-server

  /**
   * Retrieve repositories for the given source control type
   */
  repositories: function(restInst: !SourceControlRestApi, limit: int): [SourceControlRepository] js-server

  /**
   * Retrieve branches for the given source control type
   */
  branches: function(restInst: !SourceControlRestApi,
                     pageNumber: int,
                     numberPerPage: int): [SourceControlBranch] js-server

  /**
   * Update the given rest inst with a repository url
   */
  createValidSourceControlRestApiInst: function(sourceControlType: !string,
                                                restApiUrl: !string,
                                                token: !string,
                                                repoUrl: string,
                                                validateInst: boolean): SourceControlRestApi js-server
}
