/**
 * Creates test data for {@Link FileExplorer} and utility functions
 * to teardown and setup the test data.
 * The file/directory structure the setup() method creates is the following:
 *
 * / (the default root)
 *   - Company/
 *     - Research/
 *       - AIML/
 *         - Products.txt
 *       - Robotics/
 *         - Products.txt
 *         - Teams/
 *     - Business/
 *       - Accounts/
 *         - Employees.csv
 *         - Clients.csv
 *       - Expenses/
 *         - OperatingCosts.txt
 *         - Wages.txt
 */
type FileExplorerTestData {
    /**
     * Setup test data for {} by instantiating a
     * basic file hierarchy with a files and nested directories
     */
    setup: function() js-server

    /**
     * Teardown the test data
     */
    teardown: function() js-server
}
