/**
 * Helper functions to download a file with different encoding types.
 */
@typeScript
type BaseUiDownloadUtil  {

    /**
     * This function helps to download a file with a binary encoding.
     * @param url the source of the file
     * @param fileName name for the file to download.
     */
    downloadBinary: function(url: !string, fileName: !string): !any ts-client

    /**
     * This function helps to download a file with a base64 encoding.
     * @param url the source of the file
     * @param fileName name for the file to download.
     */
    downloadBase64: function(url: !string, fileName: !string): !any ts-client
}
