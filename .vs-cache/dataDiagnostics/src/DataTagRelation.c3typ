/**
 * A relation that is created by a {@link DataTag} whose creation signifies the entity in the relation
 * has satisfied the logc in the {@link DataTag}.
 */

// TODO: PLAT-50926 Mix DataTagRelationBase<E> and remove `from` field.
type DataTagRelation<E, D: DataTag> {

  /**
   * The entity that is a part of this relation.
   */
  from: !E

  /**
   * The {@link DataTag} being linked to the entity in this relation.
   */
  to: !D
}
