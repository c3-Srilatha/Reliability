/**
 * Type used to create relations between entity types and {@link DataDiagnostic}s in order to
 * keep track of which entities should be in-scope for the evaluation logic of the diagnostic.
 */
entity extendable type EntityRelation<DD: DataDiagnostic, T> schema name 'ETY_RTN' {

  /**
   * The {@link DataDiagnostic} being linked to an entity of type T in this relation.
   */
  from: !DD

  /**
   * The parametrized entity type being linked to a specific data diagnostic.
   */
  to: !T

  /**
   * Whather or not it is a black listed entity or white-listed one.
   */
  blackListed: boolean
}
