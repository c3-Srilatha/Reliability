/**
 * A relation that is created by a {@link DataTagBase} whose creation signifies the entity in the relation
 * has satisfied the logic in the {@link DataTagBase}.
 */
type DataTagRelationBase<E> {

  /**
   * The entity that is a part of this relation.
   */
  from: !E

  /**
   * The {@link DataTagBase} being linked to the entity in this relation.
   */
  to: !DataTagBase
}
