/**
 * Runs the same kind of entity tagging logic seen in {@link DataTagBase} but optionally allows the maintenance
 * of white lists and black lists for the scope of the tagging.
 */
entity extendable type DataTag<ER: EntityRelation> extends DataTagBase mixes EntityRelatable<ER> type key 'DT' {

  /**
   * Get the {@link Filter} that specifies which entities to evaluate the data diagnostic logic on. This filter will include the
   * white and blacklisted entities for the DataTag.
   */
  getDiagnosticFilter: member function(overrideFilterSpec: DataDiagnosticFilterSpec): !Filter js-rhino
}
