/**
 * Used to override the period with which the {@link DataDiagnostic#metricExpression} is
 * evaluated at. Passed into tagging and alerting APIs.
 */
type DataDiagnosticMetricPeriodSpec mixes Spec {

  /**
   * The start date to evaluate the metric at.
   */
  start: !datetime

  /**
   * The end date to evaluate the metric at.
   */
  end: !datetime
}
