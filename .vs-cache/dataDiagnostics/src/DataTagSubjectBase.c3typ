/**
 * Type that gets mixed into an entity type in order to be able to tag it with
 * {@link DataTagBase} instances. Should be used purely with {@link DataTagBase} and
 * {@link DataTagRelationBase}.
 */
abstract type DataTagSubjectBase<DTRB: DataTagRelationBase> mixes FeatureEvaluatable {

  /**
   * The data tags related to this type.
   */
  dataTagRelations: [DTRB](from)

  /**
   * Clear the data tags for a specific instance that mixes in this type.
   */
  // TODO: ENGR-13706 Functions below not implemented yet, but data tagging works without them
  clearDataTags: member function() js-rhino

  /**
   * Populate all of the data tags for a specific type.
   */
  populateDataTags: function() js-rhino

  /**
   * Populate all of the data tags for a specific type that do not have a metric expression.
   */
  populateAttributeDataTags: function() js-rhino

  /**
   * Populate all of the data tags for a specific type that have a metric expression.
   */
  populateMetricDataTags: function() js-rhino
}
