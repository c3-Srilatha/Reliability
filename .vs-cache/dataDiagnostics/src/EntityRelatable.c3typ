/**
 * Type which should be mixed onto a persistable type that extends {@link DataDiagnostic}. Used to
 * maintain black and white lists for the diagnostic's scope.
 */
type EntityRelatable<ER: EntityRelation> {

  /**
   * The entities of a certain Type which this data diagnostic logic should be run on.
   * Gets "OR"ed with the filter on this data diagnostic during evaluation.
   */
  @db(filter='blackListed==false')
  whiteListedEntities: [ER](from)

  /**
   * The entities of type srcType which this data diagnostic logic should not be run on.
   * Gets "AND"ed with the filter on this data diagnostic during evaluation.
   */
  @db(filter='blackListed==true')
  blackListedEntities: [ER](from)

  /**
   * Get whiteList entity relation type name
   */
  getEntityRelationType: member function(): string js-rhino

  /**
   * Add the entity with this id to the whitelist of entities, if there is such an entity with that id.
   */
  addEntityToWhiteList: member function(id: !string): ER js-rhino

  /**
   * Add the entiy with this id to the blacklist of entities, if there is such an entity with that id.
   */
  addEntityToBlackList: member function(id: !string): ER js-rhino

  /**
   * Remove the entity with this id from the white list of entities.
   */
  removeEntityFromWhiteList: member function(id: !string): boolean js-rhino

  /**
   * Remove the entity with this id from the black list of entities.
   */
  removeEntityFromBlackList: member function(id: !string): boolean js-rhino
}
