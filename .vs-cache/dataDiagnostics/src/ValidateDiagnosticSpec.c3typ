/**
 * Type used as an argument to the validation functions of {@link DataDiagnostic}s.
 */
type ValidateDiagnosticSpec {

  /**
   * The ID of the entity used by the {@link DataDiagnostic} when evaluating its logic.
   */
  entityId: !string

  /**
   * The start of the evaluation of the {@link DataDiagnostic#metricExpression} when validating its logic.
   */
  start: !datetime

  /**
   * The start of the evaluation of the {@link DataDiagnostic#metricExpression} when validating its logic.
   */
  end: !datetime

  /**
   * The bindings used during the evaluation of the {@link DataDiagnostic} when validating its logic.
   */
  bindings: map<string, any>

  /**
   * Whether or not the {@link DataDiagnostic} evaluation results in some positive action being taken
   * based on the other arguments supplied in this spec.
   *
   * For example, the entity is tagged or an alert is created.
   */
  triggersAction: boolean
}
