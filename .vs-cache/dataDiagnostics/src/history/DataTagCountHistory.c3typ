/**
 * Used to store the historical counts of the {@link DataTagRelation}s on a per {@link DataTag} basis.
 */
@db(index+=['parent, timestamp'])
entity type DataTagCountHistory mixes TimedValueHistory<DataTagBase> schema name 'DTCH' {

  timestamp: !~

  /**
   * The number of {@link DataTagRelation}s or {@link DataTagRelationBase} instances at the
   * time this count was made.
   */
  numRelations: int

  /**
   * The number of {@link DataTagBase#srcType} instances at the time this count was made.
   */
  numSrcTypeInstances: int

  /**
   * The ratio of number relations (data tag logic satisfying instances) to all instances.
   */
  percentageSatisfying: double stored calc numRelations / numTypeInstances

  /**
   * Persists the counts of the current number of {@link DataTagRelation}s per {@link DataTag} along
   * with the number of instances of {@link DataTagBase#srcType}.
   *
   * @param spec
   *           Specifies the manner and scope with which {@link DataTagBase} instances will have their
   *           count of relations stored. See {@link PersistDataTagCountsSpec} for more details.
   */
  persistCounts: function(spec: PersistDataTagCountsSpec) js-rhino

  /**
   * Persist the counts for a specific {@link DataTagBase#srcType} and it's relation type pair. Mainly useful
   * orchestrating the {@link AsyncAction}s which can be used tp persist the counts in {@link #persistCounts}.
   *
   * @param srcTypeName
   *           The name of the type which is having its count persisted inside of {@link DataTagCountHistory} instances.
   * @param relationTypeName
   *           The name of the extending {@link DataTagRelationBase} typewhich is having its counts persisted.
   * @param creationTime
   *           The timestamp of when the data tag counts are being persisted.
   * @param cronJob
   *           The {@link CronJob} which called the batch job that populated data tags. Specifies
   *           the scope of {@link DataTagBase} instances to persist counts for.
   * @param enabledTagsOnly
   *           Whether or not the counts should only be persisted for data tags with {@link DataTagBase#enabled}
   *           equal to true. If not supplied then persists counts for all by default
   */
  persistCountsForSrcAndRelationType: function(srcTypeName: !string,
                                               relationTypeName: !string,
                                               creationTime: !datetime,
                                               cronJob: CronJob,
                                               enabledTagsOnly: boolean) js-rhino
}
