/**
 * Type containing configurations for override bindings to be used in
 * {@link DataDiagnostic#entitySpecificBindings}.
 */
type OverrideBindings {

  /**
   * Custom bindings per {@link DataDiagnostic#srcType} entity to be applied
   * in an `evalMetrics()` call in {@link DataDiagnostic#retrieveDiagnosticData}.
   */
  bindings: map<string, any> schema suffix 'BGS'
}
