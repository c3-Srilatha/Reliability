/**
 * A history of the status of a {@link TestFacility}.
 */
entity type TestFacilityStatusHistory {

  /**
   * The parent {@link TestFacility} this status history belong to.
   */
  testFacility: TestFacility

  /**
   * The time stamp for this status.
   */
  timestamp: datetime

  /**
   * The status of the facility at this timestamp.
   */
  status: boolean
}
