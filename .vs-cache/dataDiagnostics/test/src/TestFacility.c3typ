/**
 * A test facility for testing data diagnostics.
 */
entity type TestFacility mixes DataTagSubject<TestFacilityDataTagRelation, TestFacilityDataTag> schema name 'TST_FCLTY' {

  /**
   * The {@link TestOrg} related to this test facility.
   */
  testOrganization: TestOrg

  /**
   * The {@link TestServicePoint}s related to this test facility.
   */
  testServicePoints: [TestServicePoint](testFacility)

  /**
   * The status of this test facility.
   */
  statusHistories: [TestFacilityStatusHistory](testFacility)

}
