/**
 * A test work order for testing data diagnostics.
 */
entity type TestWorkOrder mixes TimedValue schema name 'TST_WRK_ODR' {

  /**
   * The {@link TestServicePoint} this is a test work order for.
   */
  testServicePoint: TestServicePoint

  /**
   * The {@link TestServicePointTwo} this is a test work order for.
   */
  testServicePointTwo: TestServicePointTwo
}
