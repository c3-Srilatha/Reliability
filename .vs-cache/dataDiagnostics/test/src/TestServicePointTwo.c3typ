/**
 * Entity type used to test the data tagging functionality.
 */
entity type TestServicePointTwo mixes DataTagSubjectBase<TestServicePointTwoDataTagRelation> schema name 'TST_SRVC_PNT_TWO' {

  /**
   * Date field to evaluate expression engine functions on.
   */
  createdDate: datetime

  /**
   * Date field to evaluate expression engine functions on.
   */
  closedDate: datetime

  /**
   * Double field to evaluate expression engine functions on.
   */
  recentMeasure: double

  /**
   * The {@link TestFacility} related to this test service point.
   */
  testFacility: TestFacility

  /**
   * List of {@link TestWorkOrder}s related to this test service point.
   */
  testWorkOrders: [TestWorkOrder](testServicePointTwo)
}
