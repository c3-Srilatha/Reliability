@typeScript
type LoaderList mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The children that are wrapped by the loader
   */
  children: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>]

  /**
   * List of items that are putting this component in a loading state.
   */
  loadingItems: private [LoadingListItem]

  /**
   * Triggered when the component should update the {@link LoaderList#loadingItems}.
   *
   * @param id
   *    The id of the component
   * @param loadingItems
   *    The loading items to add. the items will be placed at the front of the list.
   * @return
   *    A {@link UiSdlReduxAction} action for this event
   */
  @uiSdlActionCreator(actionType='LOADING_ITEMS_ADD')
  addLoadingItemsAction: private function(id: !string, loadingItems: [LoadingListItem]): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `LOADING_ITEMS_ADD` and updates the redux store
   *
   * @param state
   *    The current Redux state
   * @param action
   *    The Redux action
   * @return
   *    The new Redux state with an updated {@link #isLoading}
   */
  @uiSdlReducer(actionType='LOADING_ITEMS_ADD')
  loadingItemsAddReducer: private function(state: UiSdlReduxState,
                                           action: UiSdlReduxAction): UiSdlReduxState ts-client

  /**
   * Triggered when the component should update the {@link LoaderList#loadingItems}.
   *
   * @param id
   *    The id of the component
   * @param itemKeys
   *    The items to remove.
   * @return
   *    A {@link UiSdlReduxAction} action for this event
   */
  @uiSdlActionCreator(actionType='LOADING_ITEMS_REMOVE')
  removeLoadingItemsAction: private function(id: !string, itemKeys: [string]): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `LOADING_ITEMS_REMOVE` and updates the redux store
   *
   * @param state
   *    The current Redux state
   * @param action
   *    The Redux action
   * @return
   *    The new Redux state with an updated {@link #isLoading}
   */
  @uiSdlReducer(actionType='LOADING_ITEMS_REMOVE')
  loadingItemsRemoveReducer: private function(state: UiSdlReduxState,
                                              action: UiSdlReduxAction): UiSdlReduxState ts-client
}
