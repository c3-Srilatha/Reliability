/**
 * {@link LukeTestComponent} for Studio Gen AI Feedback modal custom component
 */
type LukeTestStudioGenAiFeedbackModal mixes LukeTestUiSdlModal {

  /**
   * Selector for the Gen AI Feedback modal close button
   */
  closeButtonSelector: string = '.c3-button-icon.c3-button-sm.c3-button-times.c3-icon.c3-icon-times'

  /**
   * Selector for the Gen AI Feedback modal Question and Answer fields
   */
  questionAnswerSelector: string = '.genai-negative-feedback-form-snippet .markdown-renderer'

  /**
   * Selector for the Gen AI Feedback modal "What went wrong?" option buttons
   */
  whatWentWrongOptionsSelector: string = '.MuiChip-label.MuiChip-labelMedium'

  /**
   * Selector for the Gen AI Feedback modal Desired Answer and Additional Feedback text inputs
   */
  desiredAnswerAdditionalFeedbackSelector: string = '.c3-form-field.genai-negative-feedback-form-input'

  /**
   * Closes the Gen AI Feedback modal
   */
  close: inline member function(): LukeAsyncQueueNode js

  /**
   * Returns the Client question in the Gen AI Feedback modal
   */
  question: inline member function(): LukeAsyncQueueNode js

  /**
   * Returns the Server answer in the Gen AI Feedback modal
   */
  answer: inline member function(): LukeAsyncQueueNode js

  /**
   * Searches all the "What went wrong?" option in the Gen AI Feedback modal
   */
  whatWentWrongOptions: inline member function(): LukeAsyncQueueNode js

  /**
   * Clicks on the given "What went wrong?" option in the Gen AI Feedback modal
   */
  clickWhatWentWrongOption: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Searches the Desired Answer field in the Gen AI Feedback modal
   */
  desiredAnswer: inline member function(): LukeAsyncQueueNode js

  /**
   * Write the given text in Desired Answer field in the Gen AI Feedback modal
   */
  writeDesiredAnswer: inline member function(text: string): LukeAsyncQueueNode js

  /**
   * Searches the Additonal Feedback field in the Gen AI Feedback modal
   */
  additionalFeedback: inline member function(): LukeAsyncQueueNode js

  /**
   * Write the given text in Additonal Feedback field in the Gen AI Feedback modal
   */
  writeAdditionalFeedback: inline member function(text: string): LukeAsyncQueueNode js
}
