/**
 * A test component for Testing containers of {@link PresentationalKpiTile}s
 */
type LukeTestTimeRangeCell mixes LukeTestComponent {

  /**
   * Selector for the title of the dropdown subtitle
   */
  selectFieldSubTitleSelector: string = '.select-field .subtitle'

  /**
   * Selector for the title of the date range subtitle
   */
  dateRangeSubTitleSelector: string = '.date-range .subtitle'

  /**
   * Selector for disabled date range inputs
   */
  disabledDateRangeSelector: string = 'input:disabled'

  /**
   * The dropdown associated with this time range cell
   */
  dropdown: LukeTestUiSdlSelectInput

  /**
   * The date time range selector associated with this time range cell
   */
  dateRange: LukeTestUiSdlDateTimeRangeInput

  /**
   * Sets the time range cell correctly
   */
  setTimeRangeValue: inline member function(dropdownValue: string, startDate: DateTime, endDate: DateTime): LukeAsyncQueueNode js

  /**
   * Returns the subtitle text of the time range dropdown
   *
   * @param timeout
   *         The timeout for luke
   * @returns the text of the time range cell subtitle
   */
  getDropdownSubTitleText: inline member function(timeout: int): string js

  /**
   * Returns the subtitle text of the time range date range
   *
   * @param timeout
   *         The timeout for luke
   * @returns the text of the time range date range subtitle
   */
  getDateRangeSubTitleText: inline member function(timeout: int): string js
}
