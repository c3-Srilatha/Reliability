/**
 * A test component for the Workload Management Header
 */
type LukeTestStudioHeader mixes LukeTestComponent {

  /**
   * The selector for the header
   */
  parentSelector: ~ = '.c3-studio-header'

  /**
   * The selector for the subtitle
   */
  subtitleSelector: string = '.c3-studio-header-subtitle'

  /**
   * The dropdown in the header
   */
  dropdown: LukeTestUiSdlSelectInput

  /**
   * Selector for the header's action group
   */
  actionsSelector: string = '.c3-studio-header-title-action-container .c3-studio-header-icon-actions'

  /**
   * Returns the text content in the header subtitle
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the subtitle text
   */
  getSubtitleText: inline member function(timeout: int): LukeAsyncQueueNode js
}
