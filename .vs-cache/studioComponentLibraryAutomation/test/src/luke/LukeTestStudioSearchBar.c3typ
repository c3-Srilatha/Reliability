type LukeTestStudioSearchBar mixes LukeTestComponent {

  parentSelector: ~ = '.c3-studio-search-bar'

  /**
   * The selector for the toolbar
   */
  inputSelector: string = '.c3-studio-search-bar input.search'

  /**
   * search in the node search bar and select an element
   * @param searchString
   *           The node name to search for
   * @param itemListIndex
   *           The index of the search result to click
   */
  querySearchBar: inline member function(searchString: !string, itemListIndex: !int): LukeWebElement js
}
