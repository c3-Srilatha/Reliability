/**
 * {@link LukeTestComponent} for Studio Gen AI side panel custom component
 */
type LukeTestStudioGenAiSidePanel mixes LukeTestUiSdlSidePanel {

  /**
   * Selector for the Gen AI side panel
   */
  parentSelector: ~ = '.c3-studio-genaisidepanel'

  /**
   * Selector for the Gen AI side panel
   */
  titleSelector: string = '.genai-feed-side-panel-header-title'

  /**
   * Selector for the open/close Gen AI side panel button
   */
  c3GenAiButtonSelector: string = '.c3-studio-global-nav .c3-button-sparkles.c3-icon.c3-icon-sparkles'

  /**
   * Selector for the Gen AI side panel client message.
   */
  clientMessageSelector: string = '.c3-genai-editable-query-container'

  /**
   * Selector for the Gen AI side panel server message.
   */
  serverMessageSelector: string = '.summary-card'

  /**
   * Selector for the Gen AI side panel server message content.
   */
  serverMessageContentSelector: string = 'p'

  /**
   * Selector for the Gen AI side panel message username.
   */
  messageUsernameSelector: string = '.genai-chat-message-user'

  /**
   * Selector for the Gen AI side panel message timestamp.
   */
  messageTimestampSelector: string = '.genai-chat-message-timestamp'

  /**
   * Selector for the Gen AI side panel message content.
   */
  messageContentSelector: string = 'h2'

  /**
   * Selector for the Gen AI side panel message code block.
   */
  messageCodeBlockSelector: string = '.genai-md-codeblock'

  /**
   * Selector for the Gen AI side panel message code block language.
   */
  messageCodeBlockLanguageSelector: string = 'code'

  /**
   * Selector for the Gen AI side panel message code block copy button.
   */
  messageCodeBlockCopyButtonSelector: string = '.code-block-header-button .c3-icon-copy'

  /**
   * Selector for the Gen AI messages, including client and server messages.
   */
  allMessagesSelector: string = '.genai-lazy-container>div>div'

  /**
   * Selector for the Gen AI messages, including client and server messages.
   */
  errorMessageSelector: string = '.summary-card-error'

  /**
   * Selector for the thumbs up feedback button
   */
  thumbsUpSelector: string = '.c3-button-icon.c3-button-sm.c3-button-thumbs-up'

  /**
   * Selector for the filled thumbs up feedback button
   */
  thumbsUpFilledSelector: string = '.c3-button-icon.c3-button-sm.c3-button-thumbs-up.selected-positive'

  /**
   * Selector for the thumbs down feedback button
   */
  thumbsDownSelector: string = '.c3-button-icon.c3-button-sm.c3-button-thumbs-down'

  /**
   * Selector for the filled thumbs down feedback button
   */
  thumbsDownFilledSelector: string = '.c3-button-icon.c3-button-sm.c3-button-thumbs-down.selected-negative'

  /**
   * Selector for the Gen AI side panel server message pending state.
   */
  serverMessagePendingStateSelector: string = '.genai-chat-message-server .genai-chat-message-pending-conatiner'

  /**
   * Selector for the Gen AI side panel text input.
   */
  textInputSelector: string = '.genai-feed-side-panel-search-bar-container textarea'

  /**
   * Selector for the Gen AI side panel text input when is temporarily disabled.
   */
  disabledTextInputSelector: string = '.c3-form-group.c3-form-group-disabled .c3-form-field.genai-input'

  /**
   * Selector for the Gen AI side panel cancel query button
   */
  cancelServerResponseButtonSelector: string = '.c3-button-icon-with-text.c3-button-sm.rectangle-xmark.c3-icon.c3-icon-rectangle-xmark'

  /**
   * Selector for the Gen AI side panel start new chat button
   */
  startNewChatButtonSelector: string = 'button.refresh'

  /**
   * Selector for the Gen AI side panel hide/show arrow button
   */
  arrowButtonSelector: string = 'button[class*="c3-icon-arrow-from"]'

  /**
   * Selector for the Gen AI side panel expand/compress button
   */
  wideButtonSelector: string = 'button[class$="-wide"]'

  /**
   * Selector for the Gen AI side panel suggestion title
   */
  suggestionTitleSelector: string = '.genai-suggestions-title'

  /**
   * Selector for the Gen AI side panel suggestion items
   */
  suggestionItemSelector: string = '.genai-suggestions-list .c3-button-icon-with-text.c3-icon-sparkles'

  /**
   * Clicks on the C3 Generative AI button to open/close the Gen AI side panel
   */
  clickGenAiButton: inline member function(): LukeAsyncQueueNode js

  /**
   * Sets the given query in the Gen AI side panel text input
   */
  enterClientQuery: inline member function(query: string): LukeAsyncQueueNode js

  /**
   * Returns the text in the Gen AI side panel text input
   */
  clientQuery: inline member function(): LukeAsyncQueueNode js

  /**
   * Submits the given query
   */
  submitClientQuery: inline member function(query: string): LukeAsyncQueueNode js

  /**
   * Returns the client message
   */
  clientMessage: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Returns the client message username
   */
  clientMessageUsername: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Returns the client message timestamp
   */
  clientMessageTimestamp: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Returns the client message content
   */
  clientMessageContent: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Clicks the hyperlink on a client message content
   */
  clickClientMessageHyperlink: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Searches for a code block in a client message
   */
  clientMessageCodeBlock: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Searches for the code block language in a client message
   */
  clientMessageCodeBlockLanguage: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Searches for the code block copy button in a client message
   */
  clientMessageCodeBlockCopyButton: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Returns the server message
   */
  serverMessage: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Returns the server message username
   */
  serverMessageUsername: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Returns the server message timestamp
   */
  serverMessageTimestamp: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Returns the server message content
   */
  serverMessageContent: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Clicks the hyperlink on a server message content
   */
  clickServerMessageHyperlink: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Searches for a code block in a server message
   */
  serverMessageCodeBlock: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Searches for the code block language in a server message
   */
  serverMessageCodeBlockLanguage: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Searches for the code block copy button in a server message
   */
  serverMessageCodeBlockCopyButton: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Searches the server message thumbs up button
   */
  serverMessageThumbsUpButton: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Clicks the server message thumbs up button
   */
  clickServerMessageThumbsUpButton: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * * Searches the server message filled thumbs up button
   */
  serverMessageThumbsUpFilled: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Searches the server message thumbs down button
   */
  serverMessageThumbsDownButton: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Clicks the server message thumbs down button
   */
  clickServerMessageThumbsDownButton: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * * Searches the server message filled thumbs down button
   */
  serverMessageThumbsDownFilled: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Searches for a server message in pending state
   */
  serverMessagePendingState: inline member function(): LukeAsyncQueueNode js

  /**
   * Searches for the disabled text input
   */
  disabledTextInput: inline member function(): LukeAsyncQueueNode js

  /**
   * Searches for the cancel server response button
   */
  cancelServerResponseButton: inline member function(): LukeAsyncQueueNode js

  /**
   * Cancels the server response from previous user query
   */
  cancelServerResponse: inline member function(): LukeAsyncQueueNode js

  /**
   * Returns the total chat messages in Gen AI side panel
   */
  totalMessageCount: inline member function(): LukeAsyncQueueNode js

  /**
   * Returns the total chat messages in Gen AI side panel
   */
  totalClientMessageCount: inline member function(): LukeAsyncQueueNode js

  /**
   * Returns the total chat messages in Gen AI side panel
   */
  totalServerMessageCount: inline member function(): LukeAsyncQueueNode js

  /**
   * Starts a new chat
   */
  startNewChat: inline member function(): LukeAsyncQueueNode js

  /**
   * Returns the Gen AI suggestion title
   */
  suggestionTitle: inline member function(): LukeAsyncQueueNode js

  /**
   * Searches for the Gen AI suggestions
   */
  suggestions: inline member function(): LukeAsyncQueueNode js

  /**
   * Clicks in a given Gen AI suggestion
   */
  clickSuggestion: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Returns the text of a given error message.
   */
  errorMessage: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Changes the side panel width
   */
  changeSidePanelWidth: inline member function(width: int): LukeAsyncQueueNode js
}
