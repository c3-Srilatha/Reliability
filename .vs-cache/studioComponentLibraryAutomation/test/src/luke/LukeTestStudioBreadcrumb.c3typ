/**
 * A test component for interacting with the {@link StudioBreadcrumb}.
 */
type LukeTestStudioBreadcrumb mixes LukeTestComponent {

  /**
   * The selector for the breadcrumb icon.
   */
  iconSelector: string = '.c3-sdl-sub-logo'

  /**
   * The selector for the breadcrumb container.
   */
  containerSelector: string = '.breadcrumb-container'

  /**
   * The selector for the breadcrumb text.
   */
  textSelector: string = '.breadcrumb-text'

  /**
   * The selector for the breadcrumb text with gray color.
   */
  greyTextSelector: string = '.breadcrumb-text-with-gray-color'

  /**
   * Retrieves the text of a breadcrumb item at the specified index.
   *
   * @param index The index of the breadcrumb item.
   * @return A {@link LukeAsyncQueueNode} that resolves with the text of the breadcrumb item.
   */
  getText: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Simulates a click on a breadcrumb item at the specified index.
   *
   * @param index The index of the breadcrumb item to click.
   * @return A {@link LukeAsyncQueueNode} that resolves when the click action is complete.
   */
  clickText: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Retrieves the gray-colored text of a breadcrumb item at the specified index.
   *
   * @param index The index of the breadcrumb item.
   * @return A {@link LukeAsyncQueueNode} that resolves with the gray-colored text of the breadcrumb item.
   */
  getGreyText: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Simulates a click on a breadcrumb item with gray-colored text at the specified index.
   *
   * @param index The index of the breadcrumb item to click.
   * @return A {@link LukeAsyncQueueNode} that resolves when the click action is complete.
   */
  clickGreyText: inline member function(index: int): LukeAsyncQueueNode js

  /**
   * Retrieves the specified icon within the breadcrumb.
   *
   * @param icon The name or identifier of the icon to retrieve.
   * @return A {@link LukeAsyncQueueNode} that resolves with the icon element.
   */
  getIcon: inline member function(icon: string): LukeAsyncQueueNode js
}
