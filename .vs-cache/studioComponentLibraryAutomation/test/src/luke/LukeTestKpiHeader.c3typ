/**
 * A test component for Testing containers of {@link PresentationalKpiTile}s
 */
type LukeTestKpiHeader mixes LukeTestComponent {

  /**
   * Selector for an individual tile
   */
  tileSelector: string = '.studio-tile'

  /**
   * Selector for title
   */
  titleSelector: string = '.studio-tile-title'

  /**
   * Selector for tooltip
   */
  tooltipSelector: string = '.c3-info-tooltip'

  /**
   * Selector for value
   */
  valueSelector: string = '.studio-tile-value'

  /**
   * Returns a compound selector for a tile with a given index
   *
   * @param tileIdx
   *         The index of the tile
   * @returns the tile selector for the index
   */
  getTileForIndex: inline member function(tileIdx: int): string js

  /**
   * Retrieves a studio tile icon by index
   *
   * @param tileIdx
   *         The index of the tile
   * @param iconSelector
   *         The selector for the specific tile icon
   * @param timeout
   *         The timeout for luke
   * @returns an {@link LukeAsyncQueueNode} for the tile value
   */
  getTileIcon: inline member function(tileIdx: int, iconSelector: string, timeout: int): LukeAsyncQueueNode js

  /**
   * Retrieves a studio tile title by index
   *
   * @param tileIdx
   *         The index of the tile
   * @param timeout
   *         The timeout for luke
   * @returns an {@link LukeAsyncQueueNode} for the tile value
   */
  getTileTitle: inline member function(tileIdx: int, timeout: int): LukeAsyncQueueNode js

  /**
   * Retrieves a studio tile tooltip text by index
   *
   * @param tileIdx
   *         The index of the tile
   * @param timeout
   *         The timeout for luke
   * @returns an {@link LukeAsyncQueueNode} for the tile value
   */
  getTooltipText: inline member function(tileIdx: int, timeout: int): LukeAsyncQueueNode js

  /**
   * Retrieve a studio tile value by index
   *
   * @param tileIdx
   *         The index of the tile
   * @param timeout
   *         The timeout for luke
   * @returns an {@link LukeAsyncQueueNode} for the tile value
   */
  getTileValue: inline member function(tileIdx: int, timeout: int): LukeAsyncQueueNode js
}
