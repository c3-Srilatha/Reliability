/**
 * A testing representation of the Studio radio button group component
 */
type LukeTestStudioRadioButtonGroup mixes LukeTestComponent {
  /**
   * Selectors to determine if the page rendered properly
   */
  renderingSelectors: ~ = '.radio-button-item'

  /**
   * The parent selector for this component
   */
  parentSelector: ~ = '.radio-button-group-container'

  /**
   * The selector for the radio button item
   */
  radioButtonItemSelector: string = '.radio-button-item'

  /**
   * The radio mark element
   */
  radioMarkEl: string = '.input-radio-mark'

  /**
   * Clicks the radio button option given an index
   * @param index
   *        The index of the option (one-based)
   */
  clickOption: member function(index: int): LukeAsyncQueueNode js-client
}
