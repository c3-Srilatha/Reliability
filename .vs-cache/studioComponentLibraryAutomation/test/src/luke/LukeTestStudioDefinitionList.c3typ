/**
 * {@link LukeTestComponent} for Studio DefinitionList custom component
 */
type LukeTestStudioDefinitionList mixes LukeTestComponent {

  renderingSelectors: ~ = ['.studio-definition-list-container']

  /*
   * Selector for the definition list container
   */
  definitionListSelector: string = '.studio-definition-list-container'

  /*
   * Selector for the list title
   */
  listTitleSelector: string = '.title'

  /*
   * Selector for the list content container
   */
  listContentSelector: string = '.list-content'

  /*
   * Selector for the list item element
   */
  listItemEl: string = '.definition-list-item'

  /*
   * Selector for the list item field label
   */
  listItemLabelSelector: string = '.header'

  /*
   * Selector for the list item field value
   */
  listItemValueSelector: string = '.description'

  /**
   * Selector for a text link element in a list item field value element
   */
  listItemValueTextLinkSelector: string = '.text-element-with-link'

  /**
   * Returns a list of list item elements.
   */
  items: inline member function(timeout: int = 20): LukeAsyncQueueNode js

  /**
   * Returns a list of list item value elements.
   */
  itemValues: inline member function(timeout: int = 20): LukeAsyncQueueNode js

  /**
   * Returns a list of rendered texts for all list items labels
   */
  itemLabelTexts: inline member function(timeout: int = 20): LukeAsyncQueueNode js

  /**
   * Returns a list of rendered texts for all list items values
   */
  itemValueTexts: inline member function(timeout: int = 20): LukeAsyncQueueNode js
}
