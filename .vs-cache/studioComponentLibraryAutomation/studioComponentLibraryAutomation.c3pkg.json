{
  "name": "studioComponentLibraryAutomation",
  "description": "Automation helpers for studioComponentLibrary package",
  "author": "studio <studio@c3.ai>",
  "version": "8.9.0",
  "compatibleToVersion": "8.7",
  "dependencies": {
    "uiComponentLibraryReact": "8.9",
    "uiAutomationLocal": "8.9"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@c3/c3-base",
      "plugin:@c3/typescript",
      "plugin:@c3/react",
      "plugin:jsx-a11y/recommended",
      "plugin:prettier/recommended",
      "prettier/react"
    ],
    "plugins": [
      "@c3",
      "react-hooks"
    ],
    "parserOptions": {
      "ecmaVersion": 2018,
      "sourceType": "module"
    },
    "rules": {
      "@typescript-eslint/ban-types": "error",
      "@typescript-eslint/no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^e$|^_",
          "ignoreRestSiblings": true
        }
      ],
      "import/exports-last": "off",
      "import/prefer-default-export": "off",
      "react/jsx-wrap-multilines": "off",
      "react/prop-types": "off",
      "react-hooks/rules-of-hooks": "error"
    },
    "settings": {
      "react": {
        "version": "16.9.0"
      }
    }
  }
}
