/**
 * Specifies the props needed to render the legend node item.
 * This type is not intended to be an SDL component, but is defined for webpack compatibility.
 */
@typeScript
type UiSdlDiagramLegendNodeItems mixes UiSdlComponent<UiSdlNoData> {
  /**
   * A list of the node category registrations that specify how to render the node section of the legend
   */
  nodeItems: [UiSdlDiagramLegendNodeItem]

  /**
   * Title text for the nodes.
   */
  nodesTitle: string | UiSdlDynamicValueSpec = 'UiSdlDiagramLegend.NodeTitle'

  /**
   * Limit of each rows in the container, default is 3.
   */
  rowLimit: string = 3
}
