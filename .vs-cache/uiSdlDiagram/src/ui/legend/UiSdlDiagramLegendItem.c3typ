/**
 * Base type containing common props to render an item on the {@link UiSdlDiagramLegend}.
 */
type UiSdlDiagramLegendItem {

  /**
   * Icon to represent the item
   */
  icon: string

  /**
   * Label for the text to be displayed on the legend for this item
   */
  text: string | UiSdlDynamicValueSpec
}
