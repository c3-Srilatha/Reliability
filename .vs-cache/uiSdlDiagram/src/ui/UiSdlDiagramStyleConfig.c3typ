/**
 * Holds all custom style config for the graph edges and vertices.
 */
@typeScript
type UiSdlDiagramStyleConfig {

  /**
   * Flag to determine whether to display end arrow for the edges of the graph.
   */
  edgeShowEndArrow: boolean

  /**
   * Stroke width for the edges of the graph.
   */
  edgeStrokeWidth: int = 2

  /**
   * Flag to determine whether to set edge connector style.
   */
  edgeConnectorConfigRequired: boolean = true

  /**
   * Flag to determine whether to show tooltip for ports.
   */
  showTooltipForPorts: boolean = false

  /**
   * Flag to determine whether to show tooltip for edges.
   */
  showTooltipForEdges: boolean = false
}
