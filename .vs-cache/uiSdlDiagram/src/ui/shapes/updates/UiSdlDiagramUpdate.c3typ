/**
 * Represents an update to a {@link UiSdlDiagramShape} that has occurred on a {@link UiSdlDiagram} and requires the
 * graph to be redrawn.
 */
@typeScript
type UiSdlDiagramUpdate {

  /**
   * The id of the {@link UiSdlDiagramShape} that has been updated
   */
  shape: UiSdlDiagramShape

  /**
   * The type of update that has occured. This will allow for different redraw behavior depending on the type of update.
   */
  updateType: !string enum UiSdlDiagramShapeRenderUpdateType

  /**
   * Whether or not the diagram needs to rerender the {@link #shape}
   */
  shouldRerender: boolean
}
