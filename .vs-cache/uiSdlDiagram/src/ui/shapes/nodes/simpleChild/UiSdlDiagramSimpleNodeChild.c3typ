/**
 * Specifies all of the props needed to render a simple node's child on a {@link UiSdlDiagram}.
 */
@typeScript
type UiSdlDiagramSimpleNodeChild mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The title to display
   */
  title: string

  /**
   * The subtitle to display
   */
  subtitle: string

  /**
   * The icon class to use
   */
  icon: string

  /**
   * Height of the node field in pixels
   */
  height: int = 34
}
