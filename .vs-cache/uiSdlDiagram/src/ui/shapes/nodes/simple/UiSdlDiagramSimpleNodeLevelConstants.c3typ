/**
 * Specifies different node level prop groups to be passed to {@link UiSdlDiagramSimpleNode}
 * TODO: TOOLS-13629 add back const to constant fields
 */
@typeScript
type UiSdlDiagramSimpleNodeLevelConstants {

  /**
   * Props for node at error level
   */
  ERROR: json = {borderClass: 'error-border', backgroundClass: 'error-background', layeredIconClass: 'c3-icon-exclamation-circle'}

  /**
   * Props for node at warning level
   */
  WARNING: json = {backgroundClass: 'warning-background', layeredIconClass: 'c3-icon-exclamation-triangle'}

  /**
   * Props for node at success level
   */
  SUCCESS: json = {layeredIconClass: 'c3-icon-check-circle'}
}
