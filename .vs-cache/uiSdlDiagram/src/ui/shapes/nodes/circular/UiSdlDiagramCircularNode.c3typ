/**
 * Specifies all of the props needed to render a circular diagram node
 */
@typeScript
type UiSdlDiagramCircularNode mixes UiSdlDiagramNodeUi {

  /**
   * Class that name should be applied on the rendering layer of this node
   */
  className: const ~ = 'c3-sdl-diagram-node-circular'

  /**
   * The id of the shape being rendered
   */
  shapeId: string

  /**
   * The icon class of the node. Rendered inline to the left of the title
   */
  iconClass: string

  /**
   * The color class of the node
   */
  colorClass: string

  /**
   * Sets border properties around the node
   */
  borderClass: string

  /**
   * Sets a background properties on the node
   */
  backgroundClass: string

  /**
   * Layers an icon on top of the node icon
   */
  layeredIconClass: string
}
