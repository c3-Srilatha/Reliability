/**
 * A node that renders the beginning or end of a {@link UiSdlDiagram} graph.
 */
@typeScript
type UiSdlDiagramTerminatorNode mixes UiSdlDiagramNodeUi {

  className: const ~ = 'c3-sdl-diagram-node-terminator'

  /**
   * Text for the title of the node.
   */
  title: string | UiSdlDynamicValueSpec
}
