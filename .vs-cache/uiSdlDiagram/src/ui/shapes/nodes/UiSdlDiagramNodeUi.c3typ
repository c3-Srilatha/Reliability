/**
 * This type only exists so that @uiSdlPluggable generates the correct artifacts
 */
@typeScript
abstract type UiSdlDiagramNodeUi mixes UiSdlComponent<UiSdlNoData>, UiSdlDiagramNode {
  // The below classNames are important for the rendering layers to apply for Luke tests to
  // be easier to write.
  /**
   * Selector that should be applied to all nodes
   */
  className: const string = 'c3-sdl-diagram-node'

  /**
   * Selector that should be applied to a node's (main) title.
   */
  titleClassName: const string = 'c3-sdl-diagram-node-title'

  /**
   * Selector that should be applied to a node's (main) subtitle.
   */
  subtitleClassName: const string = 'c3-sdl-diagram-node-subtitle'

  /**
   * Selector that should be applied to a node's (main) icon.
   */
  iconClassName: const string = 'c3-sdl-diagram-node-icon'
}
