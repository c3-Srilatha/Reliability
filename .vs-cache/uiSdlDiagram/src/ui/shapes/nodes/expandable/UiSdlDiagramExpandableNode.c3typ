/**
 * Specifies all of the props needed to render an expandable diagram node.
 * Consumers are expected to manage the `expanded` state themselves.
 */
@typeScript
type UiSdlDiagramExpandableNode mixes UiSdlDiagramSimpleNode {

  /**
   * Class that name should be applied on the rendering layer of this node
   */
  className: const ~ = 'c3-sdl-diagram-node-expandable'

  /**
   * Whether or not the node is expanded.
   */
  expanded: boolean

  /**
   * The optional children this node can render. Will be visually contained inside the node.
   */
  children: [UiSdlDiagramSimpleNodeChild]
}
