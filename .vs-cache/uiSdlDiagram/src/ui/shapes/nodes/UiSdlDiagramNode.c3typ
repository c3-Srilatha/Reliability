/**
 * Holds all of the data for a node that needs to be stored in {@link UiSdlDiagram} state.
 */
@typeScript
type UiSdlDiagramNode mixes UiSdlDiagramShape, UiSdlDiagramNodeCoordinates {

  vertex: ~ = true

  /**
   * Whether or not the node should be minimized when rendered on the {@link UiSdlDiagram}
   */
  minimized: boolean

  /**
   * Whether or not the node is expandable. Will determine if a collapse/expand toggle is rendered with the node.
   */
  expandable: boolean

  /**
   * Whether or not the node should be expanded or collapesed when rendered on the {@link UiSdlDiagram}
   */
  expanded: boolean

  /**
   * Whether or not the node should be connectable when rendered on the {@link UiSdlDiagram}.
   * Determines if new edges can be created between 2 given nodes via drag and drop.
   */
  connectable: boolean = true

  /**
   * Props passed to SDLDiagram by {@link UiSdlDiagram}, which the node can make use of.
   */
  diagramProps: any

  /**
   * The current scale of the diagram. Decimal representation of the % zoom shown in the UI (80% -> .8, 110% -> 1.1).
   * It is up to the node to decide how to handle it.
   */
  diagramScale: double

  /**
   * Actions associated with the node. If utilizing {@link UiSdlActionGroup#dropdownContent}, when a dropdown
   * item is clicked, the actionSuffix will be a concatenation with `_` of the {@link UiSdlActionGroup#actionSuffix} and
   * the item's {@link UiSdlAction#actionSuffix}, ex: `DROPDOWN_ITEM`.
   */
  nodeActions: [UiSdlActionGroup]

  /**
   * Context menu items to show on the node
   */
  contextMenuItems: [UiSdlDiagramNodeContextMenuItem]

  /**
   * In Ports on the node.
   */
  inPorts: [UiSdlDiagramNodePort]

  /**
   * Out Ports on the node.
   */
  outPorts: [UiSdlDiagramNodePort]
}
