/**
 * Specifies all of the props needed to render a diagram node with a context menu
 */
@typeScript
type UiSdlDiagramMinimizedNode mixes UiSdlDiagramNodeUi {
  /**
   * Class that name should be applied on the rendering layer of this node
   */
  className: const ~ = 'c3-sdl-diagram-node-minimized'
}
