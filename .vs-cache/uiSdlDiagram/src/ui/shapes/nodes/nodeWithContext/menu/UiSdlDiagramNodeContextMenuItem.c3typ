/**
 * All props required to render an item in the popup menu that appears when right-clicking a rendered
 * {@link UiSdlDiagramNode}
 */
@typeScript
type UiSdlDiagramNodeContextMenuItem {

  /**
   * Id of the action
   */
  id: string

  /**
   * Label for the action, can be a translation key
   */
  labelKey: string
}
