/**
 * Holds all of the data for a node port.
 */
@typeScript
type UiSdlDiagramNodePort {

  /**
   * Id of the port e.g. vertexId#portName.
   */
  id: string

  /**
   * Type of the port.
   */
  portType: string enum('IN', 'OUT', 'UNKNOWN') = 'UNKNOWN'

  /**
   * Name of the port.
   */
  name: string | UiSdlDynamicValueSpec
}
