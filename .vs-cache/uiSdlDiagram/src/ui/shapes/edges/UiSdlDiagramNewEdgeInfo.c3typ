/**
 * This type contains information about newly added edge
 */
@typeScript
type UiSdlDiagramNewEdgeInfo mixes Edge<string> {

  /**
   * The id of the {@link UiSdlDiagramShape} that is the source of a new edge
   */
  from: ~

  /**
   * The id of the {@link UiSdlDiagramShape} that is the target of a new edge
   */
  to: ~
}
