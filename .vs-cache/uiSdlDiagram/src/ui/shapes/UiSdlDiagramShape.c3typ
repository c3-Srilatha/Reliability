/**
 * Parent type for all shapes rendered on {@link UiSdlDiagram}.
 */
@typeScript
type UiSdlDiagramShape {

  /**
   * The id of the shape. Used to index {@link UiSdlDiagram#shapeMap}
   */
  id: string

  /**
   * Whether or not the shape is an edge
   */
  edge: boolean = false

  /**
   * Whether or not the shape is a vertex
   */
  vertex: boolean = false
}
