/**
 * Specifies all of the props needed to render a toolbar on a {@link UiSdlDiagram}.
 */
@typeScript
type UiSdlDiagramToolbar mixes UiSdlComponent<UiSdlNoData> {

  /**
   * List of toolbar items.
   * Ideally it should be [UiSdlComponentRef<UiSdlComponent>], framework code generation assumes componentRef are always defined
   * in the metadata or as derivedProps. 
   */
  items: [json]

  /**
   * List of component ids representing the toolbar items that will be rendered in a hidden state
   */
  hiddenItems: [string]

  /**
   * ACTIONS ////////////////////////////////
   *
   * Triggered to update the list of items
   *
   * @param id
   *            Id of the Toolbar component.
   * @param items
   *            List of items to show on the toolbar.
   * @param hiddenItems
   *            List of items to hide from the toolbar.
   */
  @uiSdlActionCreator(actionType='ITEMS_UPDATE')
  updateItemsAction: function(id: !string,
                              items: [UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>],
                              hiddenItems: [string]): !UiSdlReduxAction ts-client

  /**
   * Triggered to update the visibility of a {@link UiSdlDiagramToolbar} item
   *
   * @param id
   *            Id of the Toolbar component.
   * @param itemIds
   *            List of toolbar items ids to  update visibility for.
   * @param hide
   *           Whether the item should be hidden or shown
   */
  @uiSdlActionCreator(actionType='ITEMS_VISIBILITY_UPDATE')
  updateItemsVisibilityAction: function(id: !string, itemIds: [string], hide: boolean): !UiSdlReduxAction ts-client

  /**
   * REDUCERS ///////////////////////////
   *
   * Listens for actions of type `ITEMS_VISIBILITY_UPDATE` and sets the loading status of the state from the payload
   * value (true/false)
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='ITEMS_VISIBILITY_UPDATE')
  itemsVisibilityUpdateReducer: private function(state: !UiSdlReduxState,
                                                 action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `ITEMS_UPDATE` and sets the toolbar items in the state from the payload
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='ITEMS_UPDATE')
  itemsUpdateReducer: private function(state: !UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxState ts-client
}
