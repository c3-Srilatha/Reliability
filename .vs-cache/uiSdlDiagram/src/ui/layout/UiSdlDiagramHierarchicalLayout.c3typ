@typeScript
type UiSdlDiagramHierarchicalLayout mixes UiSdlDiagramLayout {

  /**
   * Layout name.
   */
  name: string = 'HierarchicalLayout'

  /**
   * Defines the orientation of the layout.
   */
  orientation: string enum('north', 'west') = 'west'

  /**
   * The spacing buffer added between shapes on the same layer. Default is 30.
   */
  intraShapeSpacing: int = 30

  /**
   * The spacing buffer added between shape on adjacent layers. Default is 150.
   */
  interRankShapeSpacing: int = 150

  /**
   * The spacing buffer between unconnected hierarchies. Default is 60.
   */
  interHierarchySpacing: int = 60

  /**
   * The distance between each parallel edge on each ranks for long edges. Default is 10.
   */
  parallelEdgeSpacing: int = 10

  /**
   * Whether to maintain hidden shapes location.
   * When a node is hidden and its descendants become root, they will be moved to the left or top depending on the orientation.
   */
  maintainHiddenShapesLocation: boolean = true
}
