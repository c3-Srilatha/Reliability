/**
 * Loads a dummy `shapeMap` for a sample UiSdlDiagrams.
 * At the very least: 
 * node1 -> node2
 * node3
 * Triggering action can add more nodes and edges via payload:
 * {
 *   additionalNodes: string[],
 *   additionalEdges: { id: string, from: { id: string }, to: { id: string } }[]
 * }
 * 
 */
@typeScript
type LoadDummyShapesEpic mixes UiSdlEpic {
  epic: ~ ts-client
}
