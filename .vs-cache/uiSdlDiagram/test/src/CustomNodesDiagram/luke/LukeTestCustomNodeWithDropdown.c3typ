/**
 * Sample Luke component for custom node.
 * Any {@link LukeTestUiSdlDiagramNode} that mixes in a {@link LukeTestComponent}, such as
 * {@link LukeTestUiSdlRadioButtonGroup} should be done at the developer's own risk - not all 
 * APIs are guaranteed to work because {@link LukeTestUiSdlDiagramNode} itself is not a 
 * {@link LukeTestComponent}.
 */
type LukeTestCustomNodeWithDropdown mixes LukeTestUiSdlDiagramNode, LukeTestUiSdlRadioButtonGroup {
  nodeSelector: const ~ = '.c3-mydiagram-node-dropdown'
  nodeType: const ~ = 'Dropdown'
}
