type LukeTestUiSdlDiagramExpandableNode mixes LukeTestUiSdlDiagramNode {

  nodeSelector: const ~ = '.c3-sdl-diagram-node-expandable'

  nodeType: const ~ = 'Expandable'

  /**
   * The CSS selector for a node's expansion button
   */
  nodeExpansionIconSelector: string = '.c3-sdl-diagram-node-toggle'

  /**
   * The CSS selector for a simple node's child container
   */
  simpleNodeChildContainerSelector: string = '.c3-sdl-diagram-node-expandable-child-container'

  /**
   * The CSS selector for a simple node's child
   */
  simpleNodeChildSelector: string = '.c3-sdl-diagram-node-simple-child'

   /**
   * The CSS selector for a simple node's field title
   */
  simpleNodeChildTitleSelector: string = '.c3-sdl-diagram-node-simple-child-title'

  /**
   * The CSS selector for a simple node's field subtitle
   */
  simpleNodeChildSubtitleSelector: string = '.c3-sdl-diagram-node-simple-child-subtitle'

  /**
   * The css selectfor for a simple node's icon
   */
  simpleNodeChildIconSelector: string = '.c3-sdl-diagram-node-simple-child-icon'

  /**
   * Toggles a simple node's expansion button
   */
  toggleSimpleNodeExpansion: inline member function(nodeName: !string) js-client

  /**
   * Returns the {@link LukeBrowserWebElement} for an expanded simple node's fields
   *
   * @param nodeName
   *           The name of the node to get the child container for
   * @return The child container as an element
   */
  getSimpleNodeChildContainer: inline member function(nodeName: !string): LukeBrowserWebElement js-client

  /**
   * Returns the {@link LukeBrowserWebElement} for expanded child text. Assumes that the node has already
   * been expanded.
   */
  childTextElement: inline member function(childTitle: !string): LukeBrowserWebElement js-client

  /**
   * Scrolls the child into view in the expanded container. Assumes that the node has already
   * been expanded.
   */
  scrollChildIntoView: inline member function(childTitle: !string): LukeAsyncQueueNode js-client

  /**
   * The element that represents {@link #simpleNodeChildSelector} at the specified index.
   */
  childForIndex: inline member function(index: !int): LukeBrowserWebElement js-client

  /**
   * Returns array of all the children titles, in order.
   */
  childTitles: inline member function(): LukeAsyncQueueCollection<LukeBrowserWebElement> js-client

  /**
   * Returns array of all children subtitles, in order.
   */
  childSubtitles: inline member function(): LukeAsyncQueueCollection<LukeBrowserWebElement> js-client

  /**
   * Returns array of all children icon selectors, in order.
   */
  childIcons: inline member function(): LukeAsyncQueueCollection<LukeBrowserWebElement> js-client

  /**
   * @param childTitle
   *          The title to search for
   * @param index
   *          Optional index to assert. If not specified, assertion will just be for general existence.
   */
  assertChildTitle: inline member function(childTitle: !string, index: !int): LukeAsyncQueueNode js-client

  /**
   * @param childSubtitle
   *          The subtitle to search for
   * @param index
   *          Optional index to assert. If not specified, assertion will just be for general existence.
   */
  assertChildSubtitle: inline member function(childSubtitle: !string, index: !int): LukeAsyncQueueNode js-client

  /**
   * @param iconClass
   *          The icon to search for, ex: `c3-icon-trash`.
   * @param index
   *          Optional index to assert. If not specified, assertion will just be for general existence.
   */
  assertChildIcon: inline member function(iconClass: !string, index: !int): LukeAsyncQueueNode js-client
}
