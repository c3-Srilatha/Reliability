/**
 * Test component for {@link UiSdlDiagramToolbar}
 */

type LukeTestUiSdlDiagramToolbar mixes LukeTestComponent {

  parentSelector: ~ = '.c3-sdl-diagram'

  /**
   * The selector for the toolbar
   */
  toolbarSelector: string = '.c3-diagram-toolbar'

  /**
   * The selector for each toolbar item
   */
  toolbarItemSelector: string = '.c3-diagram-toolbar-item'

  /**
   * Selector for hidden toolbar items
   */
  hiddenToolbarItemSelector: string = '.hide'

  /**
   * Returns the toolbar item element
   * @param toolbarItemSelector
   *           The selector for the item (selector just under {@link LukeTestUiSdlDiagramToolbar#toolbarItemSelector})
   * @param resolveOnFound
   *           {@see LukeCore#search}
   * @param timeout
   *           {@see LukeCore#search}
   */
  getToolbarItem: inline member function(toolbarItemSelector: !string,
                                         resolveOnFound: boolean,
                                         timeout: int): LukeWebElement js

  /**
   * Returns whether or not the toolbar item is hidden
   * @param toolbarItemSelector
   *           The selector for the item (selector just under {@link LukeTestUiSdlDiagramToolbar#toolbarItemSelector})
   * @param resolveOnFound
   *           {@see LukeCore#search}
   * @param timeout
   *           {@see LukeCore#search}
   */
  isToolbarItemHidden: inline member function(toolbarItemSelector: !string,
                                              resolveOnFound: boolean,
                                              timeout: int): LukeAsyncQueueNode js
}
