/**
 * Helper methods for populating Pendo
 *
 * See {@link https://support.pendo.io/hc/en-us/articles/360046272771-Developer-s-guide-to-installing-Pendo}
 */
type Genai.Pendo {
  /**
   * Returns the metadata for the current user that should be loaded into the Pendo visitor information.
   * If the {@link Genai.Pendo.Config#apiKey} key has not been set, this will return an empty object.
   */
  getPendoMetadata: function(): !Genai.PendoMetadata js-rhino
}
