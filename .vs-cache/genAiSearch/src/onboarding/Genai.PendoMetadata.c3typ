/**
 * The metadata sent to Pendo that represents the current visitor.
 */
type Genai.PendoMetadata {
  /**
   * The {@link User#id} for the current user
   */
  userId: string

  /**
   * The {@link User#email} for the current user
   */
  email: string

  /**
   * The {@link User#name} for the current user
   */
  fullName: string

  /**
   * The {@link UserGroup} ids for the current user
   */
  groupIds: [string]

  /**
   * The {@link App#id} for the current app
   */
  appId: string

  /**
   * The {@link App#name} for the current app
   */
  appName: string
}
