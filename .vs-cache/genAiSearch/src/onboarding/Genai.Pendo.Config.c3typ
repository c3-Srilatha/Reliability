/**
 * Configuration of Pendo.
 *
 * To configure:
 * cfg = Genai.Pendo.Config.inst().getConfig()
 * cfg.setConfigValue('apiKey', '<API_KEY>')
 * cfg.setSecretValue('integrationKey', <INTEGRATION_KEY>)
 */
@config(minOverride=APP)
type Genai.Pendo.Config mixes ConfigSingleton {
  /**
   * Pendo API key that is used to initialize the Pendo client
   */
  apiKey: string

  /**
   * Pendo Integration key used for integrations with other products and REST API calls
   */
  @config(secret=true)
  integrationKey: string

  /**
   * Id of the Pendo guide to show in the interactive onboarding tutorial
   * If none is specified, the "Start Tutorial" will not be rendered.
   */
  generalOnboardingGuideId: string
}
