/**
 * A log entry representing an action taken by a {@link User} on another user.
 */
abstract extendable entity type Genai.UserManagement.ActionAuditLogEntry {

  /**
   * The user who performed the action
   */
  user: User

  /**
   * The id of the user who was the target of the action. Stored as a string instead of a {@link User} to avoid failed
   * resolution in case the user object doesn't exist. For example, a user gets invited but never joins.
   */
  targetUserId: string

  /**
   * The action that was performed
   */
  action: string enum Genai.UserManagement.ActionEnum

  /**
   * The timestamp of the action
   */
  timestamp: datetime
}
