/**
 * A wrapper around the {@link UserUi} type for additional Gen AI functionality.
 */
type Genai.UserManagement.UserUi mixes FetchableUi {

  /**
   * Fetches all Gen AI {@link User}s according to the fetch spec. A Gen AI user is a user who has one of the roles
   * defined within {@link Genai.UserManagement.AssignableRoleEnum}.
   */
  @action(group='read')
  fetch: ~ js-rhino

  /**
   * Returns the fetch count of all Gen AI {@link User}s according to the fetch spec. A Gen AI user is a user who has
   * one of the roles defined within {@link Genai.UserManagement.AssignableRoleEnum}.
   */
  @action(group='read')
  fetchCount: ~ js-rhino
}
