/**
 * An audit log entry for an update to a user's role.
 */
entity type Genai.UserManagement.ActionAuditLogEntry.UpdateRole extends Genai.UserManagement.ActionAuditLogEntry type key "GAI_UPR_AUDT_LG" {

  action: ~ = Genai.UserManagement.ActionEnum.UPDATE_ROLE

  /**
   * The role(s) that were removed for the targetUser.
   */
  rolesRemoved: [string enum Genai.UserManagement.AssignableRoleEnum]

  /**
   * The new role(s) that were added for the targetUser.
   */
  rolesAdded: [string enum Genai.UserManagement.AssignableRoleEnum]
}
