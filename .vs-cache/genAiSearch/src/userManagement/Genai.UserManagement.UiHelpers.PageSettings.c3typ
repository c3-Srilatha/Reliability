/**
 * Page settings for the User Management UI
 */
type Genai.UserManagement.UiHelpers.PageSettings {

  /**
   * The maximum number of users allowed in the application
   */
  maxUsers: int

  /**
   * The current number of users in the application
   */
  numCurrentUsers: int

  /**
   * Email domains that are allowed when inviting new users
   */
  newUserInvitationEmailDomainWhitelist: [string]

  /**
   * All user emails in the application. This is used for client-side validation to make sure admins cannot re-create
   * existing users.
   */
  userEmails: [string]
}
