/**
 * An audit log entry for inviting a new user to the app.
 */
entity type Genai.UserManagement.ActionAuditLogEntry.InviteUser extends Genai.UserManagement.ActionAuditLogEntry type key "GAI_INV_AUDT_LG" {

  /**
   * The initial role that the new user was invited with.
   */
  initialRole: string enum Genai.UserManagement.AssignableRoleEnum

  action: ~ = Genai.UserManagement.ActionEnum.INVITE_USER
}
