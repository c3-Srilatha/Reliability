/**
 * The exposed {@link Role}s for the Gen AI UI. Also exposed here as an enum type so we can populate select fields
 * in the UI and pass only the enum key to the backend.
 */
enum type Genai.UserManagement.AssignableRoleEnum {
  /** ADMIN */
  ADMIN = "GenAiSearch.Role.Admin"
  /** DOCUMENT_ADMIN */
  DOCUMENT_ADMIN = "GenAiSearch.Role.DocumentAdmin"
  /** USER */
  USER = "GenAiSearch.Role.User"
  /** TRAINING_ADMIN */
  TRAINING_ADMIN = "GenAiSearch.Role.TrainingAdmin"
}
