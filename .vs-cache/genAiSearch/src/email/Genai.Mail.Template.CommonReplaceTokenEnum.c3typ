/**
 * Common tokens to replace in email templates. Expressions to evaluate should be added to
 * {@link Genai.Mail}. To use one of these tokens in a template, add the enum value, with the
 * `{{double curly braces}}`, to the {@link Genai.Mail.Template#commonReplaceTokens} array.
 */
remix enum type Genai.Mail.Template.CommonReplaceTokenEnum {

  /**
   * Creates a comma-separated list (with no spaces) of all admin email addresses. This is useful for populating a
   * `to` field in an email or "mailto" template.
   */
  ALL_ADMIN_EMAILS_STRING = "{{ALL_ADMIN_EMAILS_STRING}}"

  /**
   * Creates an array of all admin email addresses. This is useful for dynamically populating recipients.
   */
  ALL_ADMIN_EMAILS_ARRAY = "{{ALL_ADMIN_EMAILS_ARRAY}}"

  /**
   * Creates an array of all admin email addresses. This is useful for dynamically populating recipients.
   */
  ALL_NON_ADMIN_EMAILS_ARRAY = "{{ALL_NON_ADMIN_EMAILS_ARRAY}}"
}
