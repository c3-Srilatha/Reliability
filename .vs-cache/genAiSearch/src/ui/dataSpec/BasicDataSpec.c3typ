/**
 * Type to represent a very basic data spec.
 */
@beta
@typeScript
type BasicDataSpec mixes UiSdlComponentDataSpec, WithDataTransforms {

  /**
   * Converts the data spec to an array of partially applied actions.
   */
  toPartiallyAppliedActions: ~ ts-client

  /**
   * The action to call
   */
  actionName: string

  /**
   * The args to be passed to the API
   */
  args: json
}
