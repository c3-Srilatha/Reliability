/**
 * Payload for a {@link GenAiUiEpicPollDocumentsGrid}.
 */
type GenAiUiEpicPollDocumentsGridPayload mixes UiSdlComponentActionPayload {

  /**
   * The application state id for storing the current polling state
   */
  applicationStateId: string

  /**
   * The component id for the Documents Grid
   */
  componentId: string

  /**
   * How long to wait between requests while polling for data
   */
  pollInterval: int
}
