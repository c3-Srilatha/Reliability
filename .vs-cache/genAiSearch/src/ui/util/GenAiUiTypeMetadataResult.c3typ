/**
 * Output for {@link GenAiUiHelpers#getWhitelistedTypeMetadata}.
 */
type GenAiUiTypeMetadataResult {
  /**
   * The base TypeMeta for the type.
   */
  typeMeta: !TypeMeta

  /**
   * The number of rows for the type by calling fetchCount().
   */
  numRows: !int
}
