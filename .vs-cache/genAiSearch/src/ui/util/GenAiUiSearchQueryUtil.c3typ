/**
 * Set of util functions for handling {@link Genai.Query} objects in the UI.
 */
@typeScript
type GenAiUiSearchQueryUtil {

  /**
   * Helper function to set the targetTool, planner, and toolsOverride in the search query.
   * It handles all types of search queries.
   */
  setParamsInSearchQuery: function(state: !any, searchQuery: Genai.Query): Genai.Query ts-client

  /**
   * Helper function to get the targetTool based on the user selection and additional params.
   * When the user selects multiple tools, the target tool is multi source synthesizer and the
   * params contain the subset of selected tools
   */
  getTargetToolAndParams: function(state: any, searchQuery: Genai.Query): json ts-client

  /**
   * Helper function to add the target tool to the suggested query.
   */
  addTargetToolToSuggestedQuery: function(state: any, suggestedQuery: Genai.Query): Genai.Query ts-client
}
