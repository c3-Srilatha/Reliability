/**
 * Type to help render dynamically the elements needed by a dynamic component, combining base
 * elements with package specific ones. Examples of use cases are: generate tabs for the admin
 * pages, generate nav menu items
 */
type GenAiUiDynamicBaseElementsRenderer<T> {
  /**
   * Function used internally to combine the base and package-specific tab items
   * when creating the dynamic SDL component
   */
  getElements: function(baseElements: map<string, GenAiUiConditionallyRenderableElement<T>> ,
                        pkgSpecificElements: map<string, GenAiUiConditionallyRenderableElement<T>> ): json js-server

  /**
   * Function used to generate the base elements to render (ie. tabs, nav menu items)
   * It is important local paths do not begin with a slash, as this will prevent correct
   * active element from being found by the UI framework.
   */
  getBaseElements: abstract function(): map<string, GenAiUiConditionallyRenderableElement<T>> js-server

  /**
   * Function used to generate the footer elements to render (ie. theme toggle, help items)
   */
  getFooterElements: abstract function(): [UiSdlNavMenuItem] js-server

  /**
   * Function used to generate the package-specific elements to render (ie. tabs, nav menu items)
   */
  getPkgSpecificElements: function(): map<string, GenAiUiConditionallyRenderableElement<T>> js-server
}
