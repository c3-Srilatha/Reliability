/**
 * Implements UiSdlRenderCondition for component rendering based on an redux state value.
 *
 * This was taken from UiSdlDynamicValueCondition in the studioDataIntegration package
 *
 * It will render the thenComponent when the value of the evaluated `param`
 * is the `expectedValue` otherwise, the elseComponent will be rendered.
 *
 * Example:
 *
 * The following component will only render `GlobalCanvas.Canvas` when the value in redux state at
 * the `GlobalCanvas.SharedEnablementGlobalState.mode` is `dev`.
 *
 * {
 *   "type": "UiSdlConditionalRenderer",
 *   "condition": {
 *     "type": "UiSdlDynamicValueCondition",
 *     "param": {
 *        "type": "UiSdlApplicationStateValueParam",
 *        "id": "GlobalCanvas.SharedEnablementGlobalState",
 *        "path": "mode",
 *     },
 *     "expectedValue": "dev"
 *   },
 *   "thenComponent": {
 *     "id": "GlobalCanvas.Canvas"
 *   }
 *   "elseComponent": {
 *      "id": "GlobalCanvas.DiagramWithNodeOverviewSidePanelContainer"
 *   },
 * }
 */
@typeScript
type GenAiUiDynamicValueCondition mixes UiSdlRenderCondition {
  /**
   * The UiSdlDynamicValueSpecParam that contains the value to extract
   */
  param: UiSdlDynamicValueSpecParam

  /**
   * The expected value of the state
   */
  expectedValue: any

  useCondition: ~
}
