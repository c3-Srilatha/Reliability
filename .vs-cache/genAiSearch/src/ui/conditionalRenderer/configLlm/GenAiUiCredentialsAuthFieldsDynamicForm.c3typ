/**
 * Type to help render the dynamic form for the credentials auth fields.
 */
type GenAiUiCredentialsAuthFieldsDynamicForm {
  /**
   * Get the dynamic form configuration for the credentials auth fields.
   */
  getDynamicFormForType: function(provider: !string, requiredOnly: boolean): json js-server

  /**
   * Get the dynamic form configuration for the credentials auth fields with the corresponding values set by the user.
   */
  getDynamicFormForTypeWithValues: function(provider: !string, name: !string, requiredOnly: boolean): json js-server
}
