/**
 * Implements {@link UiSdlRenderCondition} for checks against a config value.
 *
 * If specified in {@link UiSdlConditionalRenderer#condition}, it will render the thenComponent when the
 * configKey on the configTypeName matches the expectedValue. Otherwise, the elseComponent
 * will be rendered.
 */
@typeScript
type GenAiUiConditionalRendererCheckConfigValue mixes UiSdlRenderCondition {

  /**
   * The config type name to assert against.
   */
  configTypeName: !string

  /**
   * The field in the config type type to assert against.
   */
  configKey: !string

  /**
   * The expected value of the config field.
   */
  expectedValue: !any

  useCondition: ~
}
