/**
 * Utility TypeScript helpers used by Gen AI visualization components.
 */
@typeScript
type GenAiUiVisualizationUtils {

  /**
   * Note: This should only be called within a React component where the result of `useTranslate` can be passed in.
   *
   * Common helper method to generates a chart title based on the chart properties.
   * If a `title` is provided, it will be used as-is and the remaining arguments will be ignored.
   * If a `title` is not provided, the `fallbackTranslationKey` will be plugged into the `translate` function
   * along with the `chartProps` to generate a proper fallback title.
   *
   * @param title
   *        The title provided by the chart properties
   * @param translate
   *        The translate function returned by `useTranslate`
   * @param fallbackTranslationKey
   *        The {@link Translation#key} to use as a fallback if a `title` is not provided
   * @param chartProps
   *        Chart properties that should be plugged into the `fallbackTranslationKey` if a `title` is not
   *        provided. Examples chart properties include `xAxis`, `yAxes`, and `groupBy`, but could technically be
   *        anything needed by the `fallbackTranslationKey`.
   */
  generateChartTitle: private function(title: string,
                                       translate: any,
                                       fallbackTranslationKey: string,
                                       chartProps: json): string ts-client

  /**
   * Called within #createDownloadActionButtons to generate one action button.
   *
   * @param fileType
   *        The file type inferred from the download option
   * @param fileName
   *        This will be used for the downloaded file.
   * @param data
   *        The data to be downloaded
   */
  createDownloadActionButton: private function(
    fileType: string enum GenAiVisualizationDownloadOption,
    fileName: string,
    data: json
  ): UiSdlAction ts-client

  /**
   * Creates the action buttons for the Gen AI visualization based on the incoming spec.
   *
   * @param downloadOptions
   *        The download options available for the visualization
   * @param visualizationTitle
   *        The visualization's title. This will be used to generate a file name for the downloaded file.
   * @param data
   *        The data to be downloaded
   */
  createDownloadActionButtons: private function(
    downloadOptions: [string enum GenAiVisualizationDownloadOption],
    visualizationTitle: string,
    data: json
  ): [UiSdlAction] ts-client

  /**
   * Applies rounding logic to numerical values for presentation in the UI. In most cases, numerical values are rounded
   * to the nearest `decimalPlaces` decimal places. For very small values where this runs the risk of making a dataset
   * confusing, such as very small values between 0 and 1, the rounding logic is only applied after the significant
   * figure is reached.
   *
   * Examples:
   *   beautifyNumber(1.234, 2) -> 1.23
   *   beautifyNumber(0.0001234, 2) -> 0.000123
   */
  beautifyNumber: private function(value: any, decimalPlaces: int): any ts-client

/**
 * Recursive helper function to format the values in an object or array based on their type.
 *
 * This function processes each value according to the following rules:
 * - Numbers: Rounded to the nearest specified number of decimal places, defined by `decimalPlaces`.
 * - Strings: Truncated to a maximum length of 50 characters.
 * - NaN: Returns a dash (`'-'`) to represent the Not-a-Number value.
 */
  beautifyData: private function(data: any, decimalPlaces: int): any ts-client

  /**
   * Customize series colors by metric names or other specific groups.
   *
   * Document: {@link https://echarts.apache.org/en/option.html#color}
   * If no color is set in series, the colors would be adopted sequentially and circularly from this list as the colors of series:
   * `['#5470c6', '#91cc75', '#fac858', '#ee6666', '#73c0de', '#3ba272', '#fc8452', '#9a60b4', '#ea7ccc']`
   *
   * For example, use red if data is above threshold, otherwise use green:
   * EChartOption =
   * {
   *  color: ['ee6666', '91cc75'],
   *  series: [
   *    {
   *     name: "IsAboveThreshold",
   *     data: [True]
   *    },
   *    {
   *     name: "IsAboveThreshold",
   *     data: [False]
   *    },
   *  ],
   *  ...
   * }
   *
   * If it returns an empty array, use the default Echarts color settings.
   *
   * @param series
   *           The chart series that should be transformed into ECharts series config.
   * @return an array of hex color strings.
   *         The base package's function implementation always returns `[]` which doesn't override default colors,
   *         because just exposing the function that customers can reimplement as needed.
   */
  generateColors: function(series: [GenAiUiChartSeries]): [string] ts-client

  /**
   * Iterates over the data provided and stringifies all object values.
   * @param data
   *       The data to be stringified
   * @return the data with all object values stringified
   */
  stringifyObjectValues: private function(data: ![json]): ![json] ts-client
}
