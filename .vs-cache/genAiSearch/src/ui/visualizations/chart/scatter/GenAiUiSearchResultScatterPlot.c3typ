@typeScript
remix type GenAiUiSearchResultScatterPlot {

  /**
   * Mutator helper function that adds a static bubble size to each data item in the incoming series data.
   */
  applyStaticBubbleSize: function(seriesData: [GenAiUiScatterPlotSeries]): [GenAiUiScatterPlotSeries] ts-client

  /**
   * Mutator helper function that adds a function that will dynamically be applied to each data item in the incoming
   * series data to determine the bubble size.
   */
  applyDynamicBubbleSize: function(seriesData: [GenAiUiScatterPlotSeries],
                                   dataFrameData: [json],
                                   bubbleSizeBy: string): [GenAiUiScatterPlotSeries] ts-client

  /**
   * A helper function that will construct the tooltip text for a given data item from
   * {@link GenAiUiScatterPlotSeries#data}.
   */
  tooltipFormatter: function(seriesItem: json): string ts-client

  /**
   * Generates all series for a scatter plot from the incoming chart config/data.
   */
  createChartSeries: function(chartConfig: GenAiUiSearchResultScatterPlot): [GenAiUiScatterPlotSeries] ts-client

  /**
   * Generates a single series for a scatter plot from the incoming chart config/data.
   */
  createSingleChartSeries: private function(chartConfig: GenAiUiSearchResultScatterPlot): GenAiUiScatterPlotSeries ts-client
}
