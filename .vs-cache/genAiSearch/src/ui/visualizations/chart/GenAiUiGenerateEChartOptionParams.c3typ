/**
 * Shape of the object to be passed into {@link GenAiUiChart#generateEChartOption}
 */
type GenAiUiGenerateEChartOptionParams {

  /**
   * The chart series that should be transformed into ECharts series config.
   */
  series: [GenAiUiChartSeries]

  /**
   * The x-axis that should be transformed into an ECharts x-axis config.
   */
  xAxis: json

  /**
   * The y-axes that should be transformed into an ECharts y-axis config.
   */
  yAxes: json

  /**
   * Additional ECharts option overrides
   */
  optionOverrides: any

  /**
   * The theme category (i.e., 'Light' or 'Dark') that will be used in some of the options to add themed styling.
   */
  themeCategory: string
}
