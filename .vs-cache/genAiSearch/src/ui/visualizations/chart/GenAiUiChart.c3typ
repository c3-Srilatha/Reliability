@typeScript
remix type GenAiUiChart {

  /**
   * Generates the object that gets passed in as the ECharts option.
   *
   * See {@link https://echarts.apache.org/en/option.html}
   */
  generateEChartOption: function(params: GenAiUiGenerateEChartOptionParams): any ts-client

  /**
   * Generates an axis with a `name` and a `type` based on the incoming `chartSeries`.
   */
  axisWithType: function(axisFieldName: string, chartSeries: json, isXAxis: boolean): json ts-client

  /**
   * Takes the incoming `data` and converts the value for the given `columnName` to an empty string if the value is
   * null or undefined. This addresses an edge case with groupBy on a column that has null or undefined values that
   * otherwise breaks ECharts.
   */
  convertNullAndUndefined: function(data: json, columnName: string): json ts-client
}
