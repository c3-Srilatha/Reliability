@typeScript
remix type GenAiUiSearchResultLineChart {

  /**
   * Generates all series for a line chart from the incoming chart config/data.
   */
  createChartSeries: function(chartConfig: GenAiUiSearchResultLineChart): [GenAiUiLineChartSeries] ts-client

  /**
   * Generates a single series for a line chart from the incoming chart config/data.
   */
  createSingleChartSeries: private function(chartConfig: GenAiUiSearchResultLineChart): GenAiUiLineChartSeries ts-client
}
