/**
 * Utility TypeScript class that initializes the Pendo instance on page load for the current user session.
 */
@typeScript
type GenAiUiPendo {
  /**
   * Initializes the Pendo instance.
   */
  init: function() ts-client

  /**
   * Can be used to get the current Pendo instance.
   */
  getInstance: function() ts-client
}
