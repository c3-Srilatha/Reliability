/**
 * Epic to get and set settings for the User Management page on initial page load. For example, it will get the maximum
 * number of users allowed in the application and set it in state. This can be used by the Add User modal to tell the
 * user how many more users can be added.
 */
@typeScript
type GenAiUiEpicGetUserManagementPageSettings mixes UiSdlEpic
