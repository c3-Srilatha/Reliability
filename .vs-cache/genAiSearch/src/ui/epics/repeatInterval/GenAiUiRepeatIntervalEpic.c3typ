/**
 * Epic to periodically dispatch an action on a timer. Timer is reset when epic is triggered again.
 * Takes a {@link GenAiUiRepeatIntervalSpec} to define the interval duration and the action to be dispatched.
 */
@typeScript
type GenAiUiRepeatIntervalEpic mixes UiSdlEpic {

    epic: ~ ts-client
}
