/**
 * Generalized redirect
 */
@typeScript
type GenAiUiBasicRedirectEpic mixes UiSdlEpic {
  /**
   * Redirect to another page in the application
   */
  @typeScript(env='client')
  epic: ~


  /**
   * Helper function to extract a url and optional params for a redirect within a site.  Params can be acquired through
   * fields provided in the payload.  The following order will take precedence depending on the configuration of the
   * payload and the param extraction options given.
   * Params hierarchy.  Lowest to highest
   * {@link GenAiUiBasicRedirectPayload#statePageParamVariables}
   * {@link GenAiUiBasicRedirectPayload#additionalParamVariables}
   * {@link GenAiUiBasicRedirectPayload#applicationStateParamVariables}
   * {@link GenAiUiBasicRedirectPayload#routeParams}
   *
   * Undefined param values will not be passed through
   * @param payload
   *          The payload to extract the url and params from
   * @param siteId
   *          The site id
   * @param state
   *          The UiSdlReduxState
   */
  @typeScript(env='client')
  getRedirectParams: function(payload: !GenAiUiBasicRedirectPayload, siteId: !string, state: !UiSdlReduxState): UiSdlPageUrl
}
