/**
 * Transform a configuration value to become the value of a dictionary so it can be used as part of an SDL Form.
 */
@typeScript
type GenAiUiTransformConfigInstanceToForm mixes UiSdlDataTransform<json, json> {

  transform: ~ ts-client
}
