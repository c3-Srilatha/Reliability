/**
 * Transforms a {@link GenAiVisualizationBase} into a {@link UiSdlDynamicComponentMetadata} in order to be consumed by
 * a {@link UiSdlDynamicComponentRenderer}.
 */
type GenAiUiTransformGenAiVisualizationBaseToUiSdlDynamicComponentMetadata mixes UiSdlDataTransform<GenAiVisualizationBase, UiSdlDynamicComponentMetadata> {
  /**
   * Transforms a {@link GenAiVisualizationBase} into a {@link UiSdlDynamicComponentMetadata}.  Sets the
   * {@link UiSdlDynamicComponentMetadata#children} to {@link GenAiVisualizationBase#visualizationConfiguration} in
   * order for a {@link UiSdlDynamicComponentRenderer} to be able to render the visualization.
   * @param data
   *          The {@link GenAiVisualizationBase} instance with its
   *          {@link GenAiVisualizationBase#visualizationConfiguration} component configured and
   *          renderable.
   * @return A UiSdlDynamicComponentMetadata to be provided to a {@link UiSdlDynamicComponentRenderer}
   */
  transform: ~
}
