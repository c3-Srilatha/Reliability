/**
 * Transform {@link EvalMetricsResult} to {@link UiSdlChartData}.
 */
@typeScript
type GenAiUiTransformEvalMetricsResultToUiSdlChartData mixes UiSdlDataTransform<EvalMetricsResult, UiSdlChartData> {

  /**
   * Override abstract function to transform {@link EvalMetricsResult} to {@link UiSdlChartData}.
   */
  transform: function(data: !EvalMetricsResult): UiSdlChartData ts-client

  /**
   * The evalMetricsResult could have been serialized into JSON by the server, making some methods into fields instead.
   * This private helper function handles both cases by taking in a potentially unserialized value and serializing it.
   */
  getSerializedValue: private function(obj: any, fieldName: string): any ts-client

  /**
   * Generate unique series id being used by SDLChart.
   *
   * @param id
   *        Source id.
   * @param metricName
   *        Metric name the series is used for.
   * @param bindingsSuffix
   *        MetricName suffix. Used for generating series id when an array of bindings is used.
   *
   * @return Unique series id used by SDLChart.
   */
  generateSeriesId: function(id: !string, metricName: !string, bindingsSuffix: string = ''): string ts-client

  /**
   * The function to generate eval metrics result keys.
   *
   * @param expression
   *        The source expression name.
   * @param values
   *        The binding values from {@link EvalMetricsSpec}.
   *
   * @return The key string.
   */
  generateEvalMetricResultKey: function(expression: string, values: map<string, any>): string ts-client
}
