/**
 * Helper functions for UI transforms in GenAiUi
 */
@typeScript
type GenAiUiTransformUtil  {

  /**
   * Takes in a url for a file and returns the name of the files (e.g. `/some/url/file1.pdf` => `file1.pdf`)
   */
  @typeScript(env='client')
  getFileName: function(url: !string): !string

  /**
   * Takes in a string and sanitizes blank spaces and special characters
   */
  @typeScript(env='client')
  sanitizeFileName: function(fileName: !string): !string

  /**
   * Takes in a url for a file and returns the type of content the file is: (e.g. `pdf`)
   */
  @typeScript(env='client')
  getContentType: function(url: !string): !string

  /**
   * Takes in a file and returns its mime type
   */
  @typeScript(env='client')
  getMimeType: function(file: !File): !string

  /**
   * Converts the bytes value to a human readable string format
   */
  @typeScript(env='client')
  bytesToFileSize: function(bytes: !int): !string


  /**
   * Returns a human readable string indicating how much time has elapsed since the given datetime (e.g. `2 days ago`)
   */
  @typeScript(env='client')
  getTimeElapsedString: function(timestamp: !DateTime): !string

  /**
   * Returns a generative AI result with the interim statuses sorted in case the statuses are out of order
   * This should only happen in the edge case where two statuses updates are triggered consequently due to
   * an error or missing logic in between the two updates.
   */
  @typeScript(env='client')
  sanitizeGenaiQueryResult: function(result: !Genai.Query.Result): !Genai.Query.Result
}
