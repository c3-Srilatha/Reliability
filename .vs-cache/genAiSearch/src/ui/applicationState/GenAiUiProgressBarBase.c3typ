/**
 * Props for a progress bar.
 */
type GenAiUiProgressBarBase {
  /**
   * Whether the progress bar is visible.
   */
  show: boolean

  /**
   * The total number of steps in the progress bar.
   */
  totalSteps: int

  /**
   * The number of steps that have been completed.
   */
  completedSteps: int
}
