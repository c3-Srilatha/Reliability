/**
 * {@link UiSdlApplicationState Application} of the Search Advantage application.
 */
@typeScript
type GenAiUiApplicationState mixes UiSdlApplicationState {

  /**
   * Indicates if the application is loading and the UI should show an overlay with a spinner.
   */
  isAppLoading: boolean

  /**
   * Project settings (ie: default and tutorial project)
   */
  projectSettings: Genai.Project.Settings

  /**
   * UI Settings dependent on the backend configuration
   */
  uiSettings: GenAiUiConfig

  /**
   * User Settings for the application (ie: active project for the user)
   */
  userSettings: Genai.App.UserSettings

  /**
   * The result of sending the query string to the Generative AI model. Fills out answer, rationale,
   * and sources in the UI
   */
  generativeAiResult: Genai.Query.Result

  /**
   * A representation of historical modififications to query results. This is specific to the scenario where a user
   * uses a UI feature, such as the Eval Spec Popover, to make a modification to a query result and apply changes.
   * A query result will only appear in this map if it was the result of such a modification.
   */
  queryResultHistoryCache: map<string, json>

  /**
   * The most recent query string the User has input
   */
  queryString: string

  /**
   * An entity id selected from a component in the UI
   */
  selectedEntityId: string

  /**
   * A passage relation id selected from the search results grid
   */
  selectedPassageId: string

  /**
   * A source file selected from the Documents grid
   */
  selectedDocument: Genai.SourceFile

  /**
   * Filterable metadata fields for the app instance
   */
  sourceMetadataFields: [DeclaredFieldType]

  /**
   * All metadata values associated with the fields in #sourceMetadataFields
   */
  sourceMetadataValues: map<string, set<string>>

  /**
   * Filters applied through the UI
   */
  uiFilters: [GenAiUiFilter]

  /**
   * Whether the chat input should be disabled
   */
  disableChat: boolean

  /**
   * Whether the full chat input should be disabled
   */
  disableChatInput: boolean

  /**
   * Whether the chat input should be disabled
   */
  disableSearch: boolean

  /**
   * Whether the query tool selector should be disabled
   */
  disableToolSelector: boolean

  /**
   * Whether to hide the 'Apply' button in the filters bar
   */
  hideFilterApply: boolean

  /**
   * Set of feature configuration values that are read-only to the user.
   */
  readOnlyConfig: Genai.App.ReadOnlyConfig

  /**
   * The saved options for document syncing.
   */
  syncScheduleOptions: GenAiUiSyncScheduleOptions

  /**
   */
   // TODO: GEN-10985 Remove subscription/billing logic from genAiSearch
  /**
   * Whether or not the current application is in a free trial state.
   * This is a value of type Genai.Billing.SubscriptionPlan. It is set to any because Genai.Billing.SubscriptionPlan is not in this package.
   * ONLY USED IN SELF SERVICE APPLICATIONS
   */
  subscriptionPlan: any

  /**
   * Files fetched from the selected collection while uploading documents
   */
  storedCollectionFiles: [File]

  /**
   * Gets the ReadOnlyConfig stored in application state
   */
  getReadOnlyConfig: function(state: !UiSdlReduxState): Genai.App.ReadOnlyConfig ts-client

  /**
   * A category tag type selected from the TagsGrid
   */
  selectedTagType: Genai.SourceFile.Metadata.Category

  /**
   * Listens for actions of type `GENERATIVE_AI_RESULT_SET` to update #queryResultHistoryCache in
   * application state.
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @return a new Redux state
   */
  @uiSdlReducer(actionType='ADD_QUERY_RESULT_HISTORY_CACHE_ENTRY')
  addQueryResultHistoryCacheEntryReducer: private inline function(state: !UiSdlReduxState,
                                                                         action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Triggered as the User submits the query from the {@link GenAiUiFuzzySearch} components in the application.
   * @param id
   *           The id of the application state.
   * @param generativeAiResultForUi
   *           The result from calling {@link Genai.Query.Result#getForUi}.
   * @return a Redux action
   */
  @uiSdlActionCreator(actionType='GENERATIVE_AI_RESULT_SET')
  setQueryResultAction: private function(id: !string,
                                          generativeAiResultForUi: !Genai.Query.Result.GetForUiResult
                                        ): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `GENERATIVE_AI_RESULT_SET`, and sets a provided payload {@link Genai.Query.Result} into the application state.
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @return a new Redux state
   */
  @uiSdlReducer(actionType='GENERATIVE_AI_RESULT_SET')
  generativeAiResultSetReducer: private inline function(state: !UiSdlReduxState,
                                                 action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Triggered when the user submits feedback.
   * @param id
   *           The id of the application state.
   * @param genAiResultId
   *           The result they are rating.
   * @param helpful
   *           Thumbs up/thumbs down
   * @param selections
   *           The selections the user made.
   * @return a Redux action
   */
  @uiSdlActionCreator(actionType='SUBMIT_FEEDBACK')
  applyLeaveFeedbackAction: private function(id: !string,
                                            genAiResultId: !string,
                                            helpful: !boolean,
                                            selections: [json],
                                            comment: string,
                                            trajectoryStepId: string
                                            ): !UiSdlReduxAction ts-client

  /**
   * Triggered as the User interacts with the {@link GenAiUiFuzzySearch} components in the application.
   * @param id
   *           The id of the application state.
   * @param queryString
   *           The queryString the User has input into the search.
   * @return a Redux action
   */
  @uiSdlActionCreator(actionType='QUERY_STRING_SET')
  setQueryStringAction: private function(id: !string, queryString: !string): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `QUERY_STRING_SET`, and sets a provided payload queryString into the application state.
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @return a new Redux state
   */
  @uiSdlReducer(actionType='QUERY_STRING_SET')
  queryStringSetReducer: private inline function(state: !UiSdlReduxState,
                                                 action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `ENTITY_ID_SET` and sets a provided payload entity Id into the application state.
   *
   * @param state
   *           Redux State
   * @param action
   *           Redux action
   * @return a new Redux state
   */
  @uiSdlReducer(actionType='ENTITY_ID_SET')
  entityIdSetReducer: private inline function(state: !UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `PASSAGE_ID_SET` and sets the provided payload passage Id into the application state.
   *
   * @param state
   *           Redux State
   * @param action
   *           Redux action
   * @return a new Redux state
   */
  @uiSdlReducer(actionType='PASSAGE_ID_SET')
  passageIdSetReducer: private inline function(state: !UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `BLUEPRINT_STEP_ID` and sets the provided payload blueprint step Id into the
   * application state.
   *
   * @param state
   *           Redux State
   * @param action
   *           Redux action
   * @return a new Redux state
   */
  @uiSdlReducer(actionType='BLUEPRINT_STEP_ID_SET')
  blueprintStepIdSetReducer: private inline function(state: !UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxAction ts-client

  /**
   * Triggered when the user clicks a row in the `GenAiUi.DocumentsGrid`.
   * @param id
   *           The id of the application state.
   * @param document
   *           The source file document
   * @return a Redux action
   */
  @uiSdlActionCreator(actionType='DOCUMENT_DETAIL_SELECTION_SET')
  setDocumentDetailSelectionAction: private function(id: !string,
                                                     document: !Genai.SourceFile): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `DOCUMENT_DETAIL_SELECTION_SET` and sets the provided payload for the selected
   * Document into the application state.
   *
   * @param state
   *           Redux State
   * @param action
   *           Redux action
   * @return a new Redux state
   */
   @uiSdlReducer(actionType='DOCUMENT_DETAIL_SELECTION_SET')
   documentDetailSelectionSetReducer: private inline function(state: !UiSdlReduxState,
                                                              action: !UiSdlReduxAction): !UiSdlReduxAction ts-client

  /**
   * Trigger this action to signify that a data spec is currently polling. This can be used to conditionally avoid
   * re-starting a new polling process if the data spec is already polling.
   */
  @uiSdlActionCreator(actionType='SET_IS_POLLING')
  setIsPollingAction: private function(id: !string, dataSpecId: !string, isPolling: !boolean, startPolling: boolean): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_IS_POLLING` and sets the polling state the application state.
   */
  @uiSdlReducer(actionType='SET_IS_POLLING')
  setIsPollingReducer: private inline function(state: !UiSdlReduxState,
                                               action: !UiSdlReduxAction): !UiSdlReduxAction ts-client

  /**
   * Triggered when the `GenAiUi.SearchResultPage` component is initially rendered.
   * Stores the fields of {@link Genai.SourceFile.Metadata} into application state to use for the filter UX.
   * @param id
   *           The id of the application state.
   * @param fields
   *           The filterable metadata fields.
   * @return a Redux action
   */
  @uiSdlActionCreator(actionType='SOURCE_METADATA_FIELDS_SET')
  setSourceMetadataFieldsAction: private function(id: !string, fields: ![DeclaredFieldType]): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SOURCE_METADATA_FIELDS_SET` and sets the filterable metadata fields in application state.
   */
  @uiSdlReducer(actionType='SOURCE_METADATA_FIELDS_SET')
  setSourceMetadataFieldsReducer: private inline function(state: !UiSdlReduxState,
                                             action: !UiSdlReduxAction): !UiSdlReduxAction ts-client

  /**
   * Triggered when the `GenAiUi.SearchResultPage` component is initially rendered.
   * Stores the values of {@link Genai.SourceFile.Metadata} into application state to use for fuzzy search in the filter UX.
   * @param id
   *           The id of the application state.
   * @param values
   *           The values of the filterable metadata fields.
   * @return a Redux action
   */
  @uiSdlActionCreator(actionType='SOURCE_METADATA_VALUES_SET')
  setSourceMetadataValuesAction: private function(id: !string, values: !map<string,set<string>>): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SOURCE_METADATA_VALUES_SET` and sets the metadata values in application state.
   */
  @uiSdlReducer(actionType='SOURCE_METADATA_VALUES_SET')
  setSourceMetadataValuesReducer: private inline function(state: !UiSdlReduxState,
                                             action: !UiSdlReduxAction): !UiSdlReduxAction ts-client

  /**
   * Triggered to load the settings of the application state. For example, it is used
   * to reload the settings after the active project is changed from the UI.
   *
   */
  @uiSdlActionCreator(actionType='LOAD_SETTINGS')
  loadSettingsAction: private function(id: !string): !UiSdlReduxAction ts-client

  /**
   * Triggered when the app is initially rendered.
   * Stores the User Settings into application state.
   * @param id
   *           The id of the application state.
   * @param projectSettings
   *           The project settings to set in the application state.
   * @return a Redux action
   */
  @uiSdlActionCreator(actionType='PROJECT_SETTINGS_SET')
  setProjectSettingsAction: private function(id: !string, projectSettings: !Genai.Project.Settings): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `PROJECT_SETTINGS_SET` and sets the project settings the application state.
   */
  @uiSdlReducer(actionType='PROJECT_SETTINGS_SET')
  setProjectSettingsReducer: private inline function(state: !UiSdlReduxState,
                                               action: !UiSdlReduxAction): !UiSdlReduxAction ts-client

  /**
   * Triggered when the `GenAiUi.SearchResultPage` component is initially rendered.
   * Stores the UI Settings dependent on the Genai.ChatBot configuration into application state.
   * @param id
   *           The id of the application state.
   * @param uiSettings
   *           The UI Settings to set in the application state.
   * @return a Redux action
   */
  @uiSdlActionCreator(actionType='UI_SETTINGS_SET')
  setUiSettingsAction: private function(id: !string, uiSettings: GenAiUiConfig): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `UI_SETTINGS_SET` and sets the UI Settings the application state.
   */
  @uiSdlReducer(actionType='UI_SETTINGS_SET')
  setUiSettingsReducer: private inline function(state: !UiSdlReduxState,
                                               action: !UiSdlReduxAction): !UiSdlReduxAction ts-client

  /**
   * Stores the translation config for multi-lingual configuration into application state.
   * @param id
   *           The id of the application state.
   * @param translatorConfig
   *           Whether translation config is enabled to set in the application state.
   * @return a Redux action
   */
  @uiSdlActionCreator(actionType='TRANSLATOR_CONFIG_SET')
  setTranslatorConfigAction: private function(id: !string, translatorConfig: Genai.Translator.Config): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `TRANSLATOR_CONFIG_SET` and sets the translation config the application state.
   */
  @uiSdlReducer(actionType='TRANSLATOR_CONFIG_SET')
  setTranslatorConfigReducer: private inline function(state: !UiSdlReduxState,
                                               action: !UiSdlReduxAction): !UiSdlReduxAction ts-client

  /**
   * Triggered when the app is initially rendered.
   * Stores the User Settings into application state.
   * @param id
   *           The id of the application state.
   * @param userSettings
   *           The user settings to set in the application state.
   * @return a Redux action
   */
  @uiSdlActionCreator(actionType='USER_SETTINGS_SET')
  setUserSettingsAction: private function(id: !string, userSettings: !Genai.App.UserSettings): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `USER_SETTINGS_SET` and sets the user settings the application state.
   */
  @uiSdlReducer(actionType='USER_SETTINGS_SET')
  setUserSettingsReducer: private inline function(state: !UiSdlReduxState,
                                               action: !UiSdlReduxAction): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `DISABLE_CHAT_SET` and sets whether the chat is disabled in
   * the application state.
   */
  @uiSdlActionCreator(actionType='DISABLE_CHAT_SET')
  setDisableChatAction: private function(id: !string, shouldDisable: boolean): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `DISABLE_CHAT_SET` and sets whether the chat reducer is disabled
   * in the application state.
   */
  @uiSdlReducer(actionType='DISABLE_CHAT_SET')
  setDisableChatReducer: private function(state: !UiSdlReduxState,
                                                  action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Stores the `shouldDisable` field into the application state to determine whether to disable the search input.
   * @param id
   *           The id of the application state.
   * @param shouldDisable
   *           Whether to disable the search input.
   * @return a Redux action
   */
  @uiSdlActionCreator(actionType='DISABLE_SEARCH_SET')
  setDisableSearchAction: private function(id: !string, shouldDisable: boolean): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `DISABLE_SEARCH_SET` and sets shouldDisable into the application state.
   * @param state
   *           Redux State
   * @param action
   *           Redux action
   * @return a new Redux state
   */
  @uiSdlReducer(actionType='DISABLE_SEARCH_SET')
  setDisableSearchReducer: private function(state: !UiSdlReduxState,
                                                  action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Triggered to disable the tool selector, (e.g. the user selects Math Agent by clicking on the calculator icon in a grid)
   * Stores the `shouldDisable` field into the application state to determine whether to disable the tool selector.
   * @param id
   *           The id of the application state.
   * @param shouldDisable
   *           Whether to disable the tool selector.
   * @return a Redux action
   */
  @uiSdlActionCreator(actionType='DISABLE_TOOL_SELECTOR')
  setDisableToolSelectorAction: private function(id: !string, shouldDisable: boolean): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `DISABLE_TOOL_SELECTOR` and sets disableToolSelector into the application state.
   * @param state
   *           Redux State
   * @param action
   *           Redux action
   * @return a new Redux state
   */
  @uiSdlReducer(actionType='DISABLE_TOOL_SELECTOR')
  setDisableToolSelectorReducer: private function(state: !UiSdlReduxState,
                                                  action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Triggered when the training admin selects option yes in the eval spec popover.
   * Stores the `shouldDisable` field into the application state to determine whether to disable the chat input.
   * @param id
   *           The id of the application state.
   * @param shouldDisable
   *           Whether to disable the chat input.
   * @return a Redux action
   */
  @uiSdlActionCreator(actionType='DISABLE_CHAT_INPUT_SET')
  setDisableChatInputAction: private function(id: !string, shouldDisable: boolean): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `DISABLE_CHAT_INPUT_SET` and sets shouldDisable into the application state.
   * @param state
   *           Redux State
   * @param action
   *           Redux action
   * @return a new Redux state
   */
  @uiSdlReducer(actionType='DISABLE_CHAT_INPUT_SET')
  setDisableChatInputReducer: private function(state: !UiSdlReduxState,
                                                  action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Triggered when the user selects relational database query in the negative feedback popover.
   * Stores the `shouldHighlight` field in the state to determine whether to highlight the eval spec popover button.
   * Stores the `queryOrigin` field in the state to record the query type.
   * @param id
   *           The id of the application state.
   * @param shouldHighlight
   *           Whether to highlight the eval spec popover button.
   * @param queryOrigin
   *           The query type from where the action was triggered.
   * @return a Redux action
   */
  @uiSdlActionCreator(actionType='HIGHLIGHT_EVAL_SPEC_POPOVER_SET')
  setEvalSpecPopoverHighlightAction: private function(id: !string, shouldHighlight: !boolean, queryOrigin: !string): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `HIGHLIGHT_EVAL_SPEC_POPOVER_SET` and sets shouldHighlight and queryOrigin
   * into the application state.
   *
   * @param state
   *           Redux State
   * @param action
   *           Redux action
   * @return a new Redux state
   */
  @uiSdlReducer(actionType='HIGHLIGHT_EVAL_SPEC_POPOVER_SET')
  setEvalSpecPopoverHighlightReducer: private function(state: !UiSdlReduxState,
                                                  action: !UiSdlReduxAction): !UiSdlReduxState ts-client
  /**
   * Action creator for actions of type `HIDE_FILTER_APPLY_SET`
   */
  @uiSdlActionCreator(actionType='HIDE_FILTER_APPLY_SET')
  setHideFilterApplyAction: private function(id: !string, shouldDisable: boolean): !UiSdlReduxAction ts-client

  /**
   * Reducer for actions of type `HIDE_FILTER_APPLY_SET`
   */
  @uiSdlReducer(actionType='HIDE_FILTER_APPLY_SET')
  setHideFilterApplyReducer: private inline function(state: !UiSdlReduxState,
                                                  action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Reducer for actions of type `UI_FILTERS_SET`
   */
  @uiSdlReducer(actionType='UI_FILTERS_SET')
  setUiFiltersReducer: private inline function(state: !UiSdlReduxState,
                                                 action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
    * Helper function to get the UI filters from the application state.
    */
  getUiFilters: function(state: !UiSdlReduxState): [GenAiUiFilter] ts-client

  /**
   * Triggered when a app blocking operation is triggered or has finished processing.
   * Stores the "isAppLoading" field in the state to determine whether to render the spinner.
   * @param id
   *           The id of the application state.
   * @param isAppLoading
   *           Whether the UI should show the app-level spinner or not.
   * @return a Redux action
   */
  @uiSdlActionCreator(actionType='IS_APP_LOADING_SET')
  setIsAppLoadingAction: private function(id: !string, isAppLoading: boolean): !UiSdlReduxAction ts-client

  /**
   * Reducer for actions of type `IS_APP_LOADING_SET`
   */
  @uiSdlReducer(actionType='IS_APP_LOADING_SET')
  setIsAppLoadingReducer: private inline function(state: !UiSdlReduxState,
                                                 action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   */
   // TODO: GEN-10985 Remove subscription/billing logic from genAiSearch
  /**
   * Triggered when the Application state is initially rendered.
   * Stores the current subscription plan, regardless if free or paid, in the application state.
   * @param id
   *           The id the application state.
   * @param subscriptionPlan
   *           The current subscription plan.
   * @return a Redux action
   */
  @uiSdlActionCreator(actionType='SUBSCRIPTION_PLAN_SET')
  setSubscriptionPlanAction: private function(id: !string, subscriptionPlan: json): !UiSdlReduxAction ts-client

  /**
   */
   // TODO: GEN-10985 Remove subscription/billing logic from genAiSearch
  /**
   * Reducer for actions of type `SUBSCRIPTION_PLAN_SET`
   */
  @uiSdlReducer(actionType='SUBSCRIPTION_PLAN_SET')
  setSubscriptionPlanReducer: private inline function(state: !UiSdlReduxState,
                                                  action: !UiSdlReduxAction): !UiSdlReduxState ts-client
  /**
   * Action creator for actions of type `REFRESH_QUERY_TOOL_OPTIONS`
   */
  @uiSdlActionCreator(actionType='REFRESH_QUERY_TOOL_OPTIONS')
  refreshQueryToolOptionsAction: private function(): !UiSdlReduxAction ts-client

  /**
   * Whether the query tool options are currently loading. This allows us to delay some UI elements until loaded.
   */
  queryToolOptionsLoading: boolean

  /**
   * Triggered on initial page load to set the query tool options loading state while the #queryToolOptions are
   * being loaded.
   */
  @uiSdlActionCreator(actionType='QUERY_TOOL_OPTIONS_LOADING_SET')
  setQueryToolOptionsLoadingAction: private function(
    queryToolOptions: [Genai.Agent.Tool.Config.UiOptions]
  ): !UiSdlReduxAction ts-client

  /**
   * Reducer for actions of type `QUERY_TOOL_OPTIONS_LOADING_SET`
   */
  @uiSdlReducer(actionType='QUERY_TOOL_OPTIONS_LOADING_SET')
  setQueryToolOptionsLoadingReducer: private inline function(
    state: !UiSdlReduxState,
    action: !UiSdlReduxAction
  ): !UiSdlReduxState ts-client

  /**
   * The query tool options available to the user. This allows the user to target a specific tool when submitting a
   * query.
   */
  queryToolOptions: [Genai.Agent.Tool.Config.UiOptions]

  /**
   * Triggered on initial page load to set the available query tool options. If multiple options exist, they will be
   * presented to the user next to the search input, allowing the user to select a specific tool when running queries.
   */
  @uiSdlActionCreator(actionType='QUERY_TOOL_OPTIONS_SET')
  setQueryToolOptionsAction: private function(
    queryToolOptions: [Genai.Agent.Tool.Config.UiOptions]
  ): !UiSdlReduxAction ts-client

  /**
   * Reducer for actions of type `QUERY_TOOL_OPTIONS_SET`
   */
  @uiSdlReducer(actionType='QUERY_TOOL_OPTIONS_SET')
  setQueryToolOptionsReducer: private inline function(
    state: !UiSdlReduxState,
    action: !UiSdlReduxAction
  ): !UiSdlReduxState ts-client

  /**
   * Triggered a) on page load if {@link GenAiUiConfig#queryToolSelectorVisibility} is set to "full" or "hideAllOption",
   * and b) when the user sets the query tool from action button dropdown next to the search input.
   */
  @uiSdlActionCreator(actionType='SEARCH_QUERY_TOOL_SELECTION_SET')
  setSearchQueryToolSelectionAction: private function(searchQueryToolSelection: Genai.Agent.Tool.Config.UiOptions, payloadPath: [string]): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SEARCH_QUERY_TOOL_SELECTION_SET` and sets the selected query tool in the application state.
   */
  @uiSdlReducer(actionType='SEARCH_QUERY_TOOL_SELECTION_SET')
  searchQueryToolSelectionSetReducer: private inline function(state: !UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Triggered when allowMultipleToolSelection is set to true and
