  /**
   * Reducer for actions of type `PLANNER_OPTIONS_LOADING_SET`
   */
  @uiSdlReducer(actionType='PLANNER_OPTIONS_LOADING_SET')
  setPlannerOptionsLoadingReducer: private inline function(
    state: !UiSdlReduxState,
    action: !UiSdlReduxAction
  ): !UiSdlReduxState ts-client


