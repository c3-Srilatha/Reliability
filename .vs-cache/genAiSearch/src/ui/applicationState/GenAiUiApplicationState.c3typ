  setPlannerSelectionAction: private function(id: string, selectedPlanner: Genai.Agent.Planner, toggle: boolean): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `PLANNER_SELECTION_SET` and sets the selected planner in the application state.
   */
  @uiSdlReducer(actionType='PLANNER_SELECTION_SET')
  plannerSelectionSetReducer: private inline function(state: !UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Triggered when the page is loaded or refreshed to set the planner options.
   * @param id
   *           The id of the application state.
   */
  @uiSdlActionCreator(actionType='REFRESH_PLANNER_OPTIONS')
  refreshPlannerOptionsAction: private function(id: string): !UiSdlReduxAction ts-client

  /**
   * Whether the planner options are currently loading. This allows us to delay some UI elements until loaded.
   */
