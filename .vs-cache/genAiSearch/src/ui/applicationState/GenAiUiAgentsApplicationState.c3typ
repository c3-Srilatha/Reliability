/**
 * Application state for the Agents page.
 */
@typeScript
type GenAiUiAgentsApplicationState mixes GenAiUiFeedApplicationState {

  /**
   * An action to store the selected agent data in the redux state.
   * @param id
   *           Take the id of the selected agent for the action.
   * @return a Redux action
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_AGENT')
  setSelectedAgentAction: function(id: !string): UiSdlReduxAction ts-client

  /**
   * Listens for action of type `SET_SELECTED_AGENT` sets the provided payload for selected agent.
   * @param state
   *           Redux State
   * @param action
   *           Redux action
   * @return a new Redux state
   */
  @uiSdlReducer(actionType='SET_SELECTED_AGENT')
  setSelectedAgentReducer: function(state: UiSdlReduxState, action: UiSdlReduxAction): UiSdlReduxState ts-client

  /**
   * Action creator for actions of type `REFRESH_AVAILABLE_AGENT_TOOL_OPTIONS`
   */
  @uiSdlActionCreator(actionType='REFRESH_AVAILABLE_AGENT_TOOL_OPTIONS')
  refreshAvailableAgentToolOptionsAction: private function(): !UiSdlReduxAction ts-client

  /**
   * An action to store the agent tools in the redux state.
   * @param tools - Take the ids of the agent tools for the action.
   * @return a Redux action
   */
  @uiSdlActionCreator(actionType='SET_AVAILABLE_AGENT_TOOLS')
  setAvailableAgentToolsAction: function(tools: ![string]): UiSdlReduxAction ts-client

  /**
   * Listens for action of type `SET_AVAILABLE_AGENT_TOOLS` sets the provided payload for agent tools.
   * @param state
   *           Redux State
   * @param action
   *           Redux action
   * @return a new Redux state
   */
  @uiSdlReducer(actionType='SET_AVAILABLE_AGENT_TOOLS')
  setAvailableAgentToolsReducer: function(state: UiSdlReduxState, action: UiSdlReduxAction): UiSdlReduxState ts-client
}
