/**
 * Application state for the settings page.
 */
type GenAiUiSettingsApplicationState mixes UiSdlApplicationState {

  /**
   * Whether the config detail is on read mode (JSON view), or edit mode.
   */
  configDetailMode: string enum ('read', 'edit') = 'read'

  /**
   * Action to toggle the read/edit mode on the config detail panel.
   * @param id
   *           The id of the {@link GenAiUiFeedApplicationState} for the action.
   * @param configDetailMode
   *           The mode to set the config detail panel to.
   */
  @uiSdlActionCreator(actionType='SET_CONFIG_DETAIL_MODE')
  setConfigDetailModeAction: private function(id: !string, configDetailMode: !string enum ('read', 'edit')): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_CONFIG_DETAIL_MODE` and updates the config detail mode.
   */
  @uiSdlReducer(actionType='SET_CONFIG_DETAIL_MODE')
  setConfigDetailModeReducer: private inline function(state: !UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxAction ts-client
}
