/**
 * An action button dropdown component that lists the available query tool options.
 *
 * See GenAiUiConfig#queryToolSelectorVisibility
 * See GenAiUiConfig#queryToolSelectorDefaultOption
 */
@typeScript
type GenAiUiQueryToolSelectorDropdown mixes UiSdlComponent<UiSdlNoData> {

  /**
   * Query tool options to render as action buttons.
   */
  queryToolOptions: [Genai.Agent.Tool.Config.UiOptions] = []

  /**
   * UI Settings dependent on the backend configuration
   */
  uiSettings: GenAiUiConfig

  /**
   * An action called when one of the #queryToolOptions action buttons is clicked.
   */
  @uiSdlActionCreator(actionType='ACTION_BUTTON_CLICK')
  actionButtonClickAction: function(id: !string, queryTool: Genai.Agent.Tool.Config.UiOptions): !GenAiUiQueryToolSelectorDropdownClickAction ts-client

  /**
   * An action called when one of the #queryToolOptions is selected from the checkboxes.
   */
  @uiSdlActionCreator(actionType='SELECT_CHECKBOX')
  selectCheckboxAction: function(id: !string, queryTools: [Genai.Agent.Tool.Config.UiOptions]): !GenAiUiQueryToolSelectorDropdownClickAction ts-client
}
