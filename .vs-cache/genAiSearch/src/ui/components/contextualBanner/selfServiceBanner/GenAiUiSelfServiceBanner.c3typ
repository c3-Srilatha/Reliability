/**
 */
// TODO: GEN-10985 Remove subscription/billing logic from genAiSearch
/**
 * Component that handles the rendering of the self service banner for the Enterprise Search app.
 */
@typeScript
type GenAiUiSelfServiceBanner mixes UiSdlComponent<BasicDataSpec> {

  @uiSdlDataSpec(dataDestinationField='remainingFreeTrialDays')
  dataSpec: ~

  /**
   * The number of days remaining in the free trial, or -1 if none.
   */
  remainingFreeTrialDays: int

  /**
   * The settings for the current user
   */
  userSettings: Genai.App.UserSettings
}
