/**
 * A UI component to renderthe muti tool response tab panel.
 */
@typeScript
type GenAiUiMultiToolResponseTabPanel mixes UiSdlComponent<BasicDataSpec> {

  /**
   * Results for which to render tabs in the component. One tab will be render per result
   */
  childResults: [Genai.Query.Result.GetForUiResult]

  /**
   * Function to set the active tab
   */
  setActiveTab: lambda(activeTabId: string)

  /**
   * Active tab on the component
   */
  activeTab: string

  /**
   * Set of tools that will produce an answer and for which the component should render a tab by default
   * If this is not provided, tabs will be lazily rendered as the tool's answers are recevied
   */
  initialToolIds: [string]

  /**
   * UI configurations for the tools that can be rendered in the tabs
   */
  queryToolOptions: [Genai.Agent.Tool.Config.UiOptions];
}
