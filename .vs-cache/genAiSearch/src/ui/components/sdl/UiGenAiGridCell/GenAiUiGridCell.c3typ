// c3-analysis-disable c3-excessive-method-params -- functions must be refactored to use specs where possible

/**
 * Custom cell component to display generative ai search results
 */
@typeScript
type GenAiUiGridCell mixes UiSdlDataGridCell {

  /**
   * Url for the image to be displayed
   */
  image: string

  /**
   * The text for the title of the grid cell
   */
  headerText: string | UiSdlDynamicValueSpec

  /**
   * The url for the header text to redirect to
   */
  headerUrl: string

  /**
   * The caption for the grid cell
   */
  caption: string | UiSdlDynamicValueSpec

  /**
   * Kick off a `FEEDBACK_BUTTON_ACTION` for feedback submission. Can be positive or negative
   */
  @uiSdlActionCreator(actionType='FEEDBACK_BUTTON_CLICK')
  clickFeedbackButtonAction: function(id: !string, helpful: !boolean, passageRelationId: !string, ownProps: any): !UiSdlButtonClickAction ts-client

  /**
   * Parses the file name and returns the file extension
   */
  getFileExtension: function(fileName: string): string ts-client

  /**
   * Returns the file type icon based on the file extension
   */
  getFileTypeIcon: function(fileExtension: string, theme: string): string ts-client
}
