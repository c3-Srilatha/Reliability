/**
* A UI component type button.
*/
@typeScript
type GenAiUiSummaryCard mixes UiSdlComponent<BasicDataSpec> {
  /**
    * The id of the component. If defined, the action for polling and setting the query result will be handled at component state level,
    * otherwise it will handled at application state level.
    */
  componentId: string

  /**
    * The title of the card
    */
  hideCardTitle: boolean

  /**
    * Whether or not to show the action group
    */
  hideRightActionGroup: boolean

  /**
    * The content of the header
    */
  contentHeader: UiSdlDynamicValueSpec

  /**
    * The title of the card. If undefined, defaults to "AI Summary"
    */
  title: UiSdlDynamicValueSpec

  /**
    * The content of the body
    */
  contentBody: UiSdlDynamicValueSpec

  /**
    * The {@link Genai.Query.Result} associated with the summary card
    */
  generativeAiResult: Genai.Query.Result

  /**
    * The {@link Genai.Query.Result.GetForUiResult} associated with the summary card.
    * Sources from this result are combined and rendered in the UI
    */
  generativeAiResultForUi: Genai.Query.Result.GetForUiResult

  /**
    * The {@link Genai.Query.Result} associated with the summary card
    */
  generativeAiResultId: !string

  /**
   * Whether the {@link Genai.Query.Result} failed in the backend
   */
  failed: boolean

  /**
   * The interim statuses of the {@link Genai.Query.Result}
   */
  interimStatuses: [Genai.Query.Result.InterimStatus]

  /**
    * The sub content of the graph
    */
  subContent: UiSdlComponentRef<UiSdlComponent>

  /**
   * The number of sources to display in full
   */
  numDisplayed: int = 7

  /**
   * UI Settings dependent on the backend configuration
   */
  uiSettings: GenAiUiConfig

  /**
   * Query tool options than can be rendered as tabs for multi tool responses.
   */
  queryToolOptions: [Genai.Agent.Tool.Config.UiOptions]

  /**
   * What mode and style the summary card should be rendered in.
   */
  viewMode: string enum("chat", "feed")

  /**
    * Triggered when the feedback button is clicked.
    *
    * @param id
    *            Id of the component
    * @param helpful
    *            True if feedback is positive, false if negative
    * @return A `FEEDBACK_BUTTON_CLICK` action for this instance. Is either positive or negative.
    */
  @uiSdlActionCreator(actionType='FEEDBACK_BUTTON_CLICK')
  clickFeedbackButtonAction: private function(id: !string, helpful: !boolean, generativeAiResultId: !string, ownProps: any): !UiSdlButtonClickAction ts-client

  /**
   * The step to be rendered in the summary card.
   */
  step: Genai.Agent.Trajectory.Step

  /**
  * Determines whether a given `queryResult` was generated using a structured tool.
  *
  * @param queryResult
  *           The query result object containing the toolType.
  * @return `true` if it was generated using a structured tool, otherwise `false`.
  */
  isStructuredTool: function(queryResult: Genai.Query.Result): !boolean ts-client
}
