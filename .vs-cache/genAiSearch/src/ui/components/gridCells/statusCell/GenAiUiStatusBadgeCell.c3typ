/**
 * Custom cell component to render a status
 */
@typeScript
type GenAiUiStatusBadgeCell mixes UiSdlDataGridCell {
  /**
   * Path to the status field in the data object
   */
  statusFieldPath: string = 'status'

  /**
   * Map of status values to colors
   */
  colorMap: map<string, string>

  /**
   * Map of status values to content (translation keys)
   */
  contentMap: map<string, string>

  /**
   * Map of status values to icons
   */
  iconMap: map<string, string>
}
