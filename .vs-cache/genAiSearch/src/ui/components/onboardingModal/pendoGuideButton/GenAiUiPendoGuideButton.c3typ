/**
 * Presentational component for rendering a button to trigger a Pendo guide.
 * This requires that Pendo is set up. See {@link Genai.Pendo.Config} for setup instructions.
 */
@typeScript
type GenAiUiPendoGuideButton mixes UiSdlButton {
  /**
   * Additional class names to be applied to the button
   */
  className: string

  /**
   * The id of the Pendo guide that should be triggered when clicking the button
   */
  guideId: !string

  /**
   * Callback function to be called when the button is clicked. This will be executed after the Pendo guide is triggered.
   */
  onClick: lambda()
}
