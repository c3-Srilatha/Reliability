/**
 * Presentational component for rendering the onboarding modal.
 */
@typeScript
type GenAiUiOnboardingModalWelcomeView mixes UiSdlComponent<UiSdlNoData> {
  /**
   * Whether the active project is a tutorial.
   */
  isUsingTutorial: boolean

  /**
   * The onboarding guides to be rendered in the welcome modal
   */
  onboardingGuides: [Genai.OnboardingGuide]

  /**
   * The {@link Genai.Project.Settings} for the application
   */
  projectSettings: Genai.Project.Settings

  /**
   * React handler to set the selected onboarding guide in the React state of the onboarding modal.
   */
  setSelectedGuide: lambda(selectedGuide: Genai.OnboardingGuide)
}
