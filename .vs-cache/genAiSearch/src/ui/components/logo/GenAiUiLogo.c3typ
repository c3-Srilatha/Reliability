/**
 * Component responsible for rendering the logo in the user interface (UI).
 *
 * This component manages the display and positioning of the logo based on the
 * specified image settings and configuration.
 */
@typeScript
type GenAiUiLogo mixes UiSdlComponent {
  /**
   * Enum representing the type of logo to be displayed. The types of logos are based on their
   * locations within the application. For a list of valid locations, see {@link LogoImagesValidLocations}.
   */
  imageType: string

  /**
   * Optional CSS class to apply to the wrapping `div` tag of the {@link GenAiUiLogoReact}.
   */
  className: string
}
