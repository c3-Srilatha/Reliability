/**
 * Type containing information about an external source and how it is displayed in the UI.
 */
type GenAiUiExternalSourceType {
  /**
   * The external source type
   */
  sourceType: !string enum('AWS', 'GCS', 'ADLS')

  /**
   * The string associated with the source type, to be displayed in the UI.
   */
  displayValue: !string
}
