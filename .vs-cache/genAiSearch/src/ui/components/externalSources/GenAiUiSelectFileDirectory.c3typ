/**
 * Component that renders step 3 of the new external sources form.
 */
@typeScript
type GenAiUiSelectFileDirectory mixes UiSdlComponent<UiSdlNoData> {
  /**
   * Base URL from which to list directories. It needs to be accessible from the File System.
   */
  basePath: string

  /**
   * The list of paths that have been selected by the user.
   */
  selectedPaths: [string]

  /**
   * React handler to set the list of paths selected by the user
   */
  setSelectedPaths: lambda(paths: [string])
}
