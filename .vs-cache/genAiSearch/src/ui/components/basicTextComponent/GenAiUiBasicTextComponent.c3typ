/**
 * A component that allows for rendering basic text.
 */
@beta
@typeScript
type GenAiUiBasicTextComponent mixes UiSdlComponent<BasicDataSpec> {

  /**
   * Optional class name to.
   */
  className: string

  /**
   * The HTML tag to render the text in.
   */
  htmlTag: string enum('h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'span', 'p') = 'p'

  /**
   * Whether or not to wrap the text in a container.
   */
  wrapWithContainer: boolean = false

  /**
   * Whether or not we hide the feedback options
   */
  hideFeedback: boolean

  /**
   * The specification used for retrieving data.
   */
  @uiSdlDataSpec(dataDestinationField='dataValue')
  dataSpec: ~

  /**
   * The value to render
   */
  dataValue: string

  /**
   * The value to render takes priority over dataValue.
   */
  staticValue: string

  /**
   * The secondary value to render.
   */
  secondaryStaticValue: string

  /**
   * The html tag for the secondary text
   */
  secondaryHtmlTag: string enum('h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'span', 'p') = 'p'

  /**
   * The class name for the secondary html tag.
   */
  secondaryClassName: string

  /**
   * The empty state text displayed in the first header when no data has been requested yet.
   */
  emptyStateText: string
}
