/**
 * A component for rendering very basic text.
 */
@beta
@typeScript
type GenAiUiMoreBasicTextComponent mixes UiSdlComponent<BasicDataSpec> {

  /**
   * Optional class name to.
   */
  className: string

  /**
   * The HTML tag to render the text in.
   */
  htmlTag: string enum('h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'span', 'p') = 'p'

  /**
   * Whether or not to wrap the text in a container.
   */
  wrapWithContainer: boolean = false

  /**
   * The specification used for retrieving data.
   */
  @uiSdlDataSpec(dataDestinationField='dataValue')
  dataSpec: ~

  /**
   * The value to render
   */
  dataValue: string | int | double | datetime

  /**
   * The value to render takes priority over dataValue.
   */
  staticValue: string | int | double | datetime

  /**
   * The text to display in the tooltip
   */
  infoTooltipText: string
}
