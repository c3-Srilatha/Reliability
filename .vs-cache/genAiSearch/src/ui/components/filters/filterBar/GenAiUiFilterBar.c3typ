/**
 * Component that handles the rendering of the filter bar for the Enterprise Search app.
 */
@typeScript
type GenAiUiFilterBar mixes GenAiUiFilterBase {
  /**
   * The filters to be initially rendered by the filter bar.
   */
  filters: [any]

  /**
   * Whether the apply button should be hidden.
   */
  isApplyButtonHidden: boolean

  /**
   * Filterable metadata fields for the app instance
   */
  sourceMetadataFields: [DeclaredFieldType]

  /**
   * Converts filters applied on the UI to filters that can be consumed in the backend.
   */
  convertToGenaiQueryFilters: private function(filters: [GenAiUiFilter]): map<string, Genai.Query.SourceFilter> ts-client

  /**
   * Converts filters stored on a {@link Genai.Query} to filters that can be consumed by the frontend.
   */
  convertQueryFiltersToUiFilters: private function(filters: Genai.Query.SourceFilter): [GenAiUiFilter] ts-client

  /**
   *  Triggers a new query with the filters set in the application state.
   */
  @uiSdlActionCreator(actionType='FILTERS_APPLY')
  applyFiltersAction: private function(id: !string): !UiSdlReduxAction ts-client
}
