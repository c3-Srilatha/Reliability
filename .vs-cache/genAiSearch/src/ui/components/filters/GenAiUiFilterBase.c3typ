/**
 * Base type for filter components.
 */
type GenAiUiFilterBase mixes UiSdlComponent<UiSdlNoData> {

  /**
   * If the filters list is read only, the filter pills cannot be interacted with.
   */
  readOnly: boolean

  /**
   * The number of filters currently in the filter bar.
   */
  numFilters: int

  /**
   * The max number of filters allowed in the filter bar.
   */
  maxNumFilters: int = 10;

  /**
   * Can either be a map of fields to their possible metadata values
   * or a set of possible metadata values for a single field.
   */
  sourceMetadataValues: map<string, set<string>> | set<string>
}
