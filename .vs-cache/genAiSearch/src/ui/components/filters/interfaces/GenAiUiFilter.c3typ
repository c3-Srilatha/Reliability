/**
 * Type containing information of a filter category or filter instance in the filter bar.
 */
type GenAiUiFilter {
  /**
   * The field name of the filter.
   */
  name: string

  /**
   * The field type of the filter.
   */
  filterType: string enum("string", "datetime", "tags")

  /**
   * The value of the filter.
   */
  value: string | [string]

  /**
   * The value displayed in the filter pill.
   */
  displayValue: string
}
