/**
 * Component for rendering a {@link GenAiUiFilter} in a pill format
 */
@typeScript
type GenAiUiFilterPill mixes GenAiUiFilterInstance {

  /**
   * Function to remove a {@link GenAiUiFilter} at the specified index
   */
  removeFilter: function(filterIndex: !int) ts-client

  /**
   * Function to update an existing {@link GenAiUiFilter} at the specified index
   */
  updateFilter: function(filter: GenAiUiFilter, filterIndex: !int) ts-client
}
