/**
 * Package specific util functions for the UI components of GenAiUi
 */
@typeScript
type GenAiUiPackageSpecificUtils {

  /**
   * Returns true if the data model state has gone stale at any point, and false otherwise.
   * If the data model state has gone stale, the user needs to be warned that the response is from a stale data model
   * @param interimStatuses
   *           Array of {@link Genai.Query.Result.InterimStatusHistory} indicating the interim status of the generativeAiResult
   *           If any of them has the status 'ToolStale', then the data model state has gone stale at some point
   * @return a boolean indicating if any of the interim statuses of the generativeAiResult are stale
   */
  isSearchResultFromStaleDataModel: function(interimStatuses: [Genai.Query.Result.InterimStatusHistory]): !boolean ts-client

  /**
   * Returns true if the component is ready to be rendered, and false otherwise.
   * For generativeAiResults that can be lazily loaded, we render each part of the answer as soon as it is available
   * For those that cannot be rendered, we also need to wait for the generativeAiResult to complete generation
   * @param isSpecificContentReady
   *           Condition indicating if the specific content rendered by the component is ready (ie, a visualization, answer, etc).
   * @param interimStatuses
   *           Array of {@link Genai.Query.Result.InterimStatusHistory} indicating the interim status of the generativeAiResult
   *           If any of them has the status 'Completed', then the generative AI result has completed generation
   * @param lazyLoadResults
   *           Boolean indicating if the generativeAiResults should be lazily loaded.
   *           If true, the component will be rendered as soon as the specific content is ready
   *           If false, the component will be rendered only when the generativeAiResult has completed generation, and the specific content is ready
   * @return a boolean indicating if the component is ready to be rendered
   */
  searchResultShouldRender: function(isSpecificContentReady: !boolean,
                         interimStatuses: [Genai.Query.Result.InterimStatusHistory],
                         lazyLoadResults: boolean ): !boolean ts-client
}
