/**
 * Query tool specific util functions for the UI components of EnterpriseSearch
 */
@typeScript
type GenAiUiQueryToolSpecificData {

  /**
   * Returns the checkbox values for the structured query tool
   */
  getStructuredQueryCheckboxData: function(): [json] ts-client

  /**
   * Returns the checkbox values for the unstructured query tool
   */
  getUnstructuredQueryCheckboxData: function(): [json] ts-client
}
