// c3-analysis-disable c3-excessive-method-params -- functions must be refactored to use specs where possible

/**
 * The chat component for the UI
 */
@beta
@typeScript
type GenAiUiChat mixes UiSdlComponent<BasicDataSpec> {

  @uiSdlDataSpec(dataDestinationField='latestMessage')
  dataSpec: ~

  /**
   * The text to overwrite the input of the chat component
   */
  inputText: string

  /**
   * The header text of the chat box component
   */
  headerText: string

  /**
   * The header of each chat message sent by the server
   */
  serverMessageHeader: string

  /**
   * The header of each message sent by the user
   */
  userMessageHeader: string enum('email', 'name')

  /**
   * Whether the chat box can be expanded to full screen
   */
  expandable: boolean

  /**
   * Whether the chat box can be cleared
   */
  clearable: boolean

  /**
   * Whether the search icon appears on user messages, allowing them to initiate a search query
   * using the original message as the query
   */
  searchableMessages: boolean

  /**
   * The format of the datetime displayed on each message
   */
  dateFormat: UiSdlDateTimeParamKindFormat

  /**
   * Whether feedback is allowed for chat messages sent by the server
   */
  allowFeedback: boolean

  /**
   * Whether the chat is in expanded view
   */
  expanded: boolean

  /**
   * The title of the chat box component
   */
  header: UiSdlComponentHeader

  /**
   * All of the chat messages sent in the chat
   */
  messages: [Genai.Query.ChatMessage]

  /**
   * The latest chat message sent in the chat. Not actually used for rendering. Instead,
   * the latest message is just appended to the #messages inside the reducer
   * #chatUpdateEffect. Still needed a field for the dataSpec to point to as the
   * `dataDestinationField` without it being #messages because it will just override
   * and we want it to append.
   */
  latestMessage: Genai.Query.ChatMessage

  /**
   * UI Settings dependent on the backend configuration
   */
  uiSettings: GenAiUiConfig

  /**
   * Whether the filter status banner is shown in the chat
   */
  showBanner: boolean

  /**
   * Whether the chat should be in read only mode, used in the conversation history page.
   * In read only mode, the user cannot send messages, give feedback, query from a message, or delete the chat contents.
   */
  readOnly: boolean

  /**
   * Represents the queries and messages the chat will initially be populated with.
   */
  conversation: Genai.Conversation

  /**
   * Kick off a `CHAT_MESSAGES_SET` action
   */
  @uiSdlActionCreator(actionType='CHAT_MESSAGES_SET')
  setChatMessagesAction: function(id: !string, messages: [Genai.Query.ChatMessage], ownProps: any): !GenAiUiChatMessagesSetAction ts-client

  /**
   * Kick off a `QUERY_SUBMIT` action
   */
  @uiSdlActionCreator(actionType='QUERY_SUBMIT')
  submitQueryAction: function(id: !string, query: !string, ownProps: any): !GenAiUiQuerySubmitAction ts-client

  /**
   * Kick off a `SET_INPUT` action
   */
  @uiSdlActionCreator(actionType='SET_INPUT')
  setInputAction: function(id: !string, inputText: !string): UiSdlReduxAction ts-client

  /**
    * Kick off a `FEEDBACK_BUTTON_ACTION` for feedback submission. Can be positive or negative
    */
  @uiSdlActionCreator(actionType='FEEDBACK_BUTTON_CLICK')
  clickFeedbackButtonAction: private function(id: !string, helpful: !boolean, generativeAiResultId: !string, ownProps: any): !UiSdlButtonClickAction ts-client

  /**
   * Kick off a `SEARCH_SUBMIT` action to move the chat message to search
   */
  @uiSdlActionCreator(actionType='SEARCH_SUBMIT')
  submitSearchAction: function(id: !string, searchQuery: !string, targetTool: string, ownProps: any): !GenAiUiSearchSubmitAction ts-client

  /**
   * Kick off an `EXPANDED_MODE_SET` action to put chat in and out of expanded mode
   */
  @uiSdlActionCreator(actionType="EXPANDED_MODE_SET")
  setExpandedModeAction: function(id: !string, expanded: boolean, ownProps: any): !GenAiUiChatExpandedSetAction ts-client

  /**
   * Kick off a `CLEAR_CHAT_BUTTON_CLICK` action to clear chat
   */
  @uiSdlActionCreator(actionType="CLEAR_CHAT_BUTTON_CLICK")
  setClearedModeAction: function(id: !string, ownProps: any): !UiSdlReduxAction ts-client

  /**
   * Kicks off a `STREAM_CHAT_SET` action to populate the recent chat message with the streamed text.
   */
  @uiSdlActionCreator(actionType='STREAM_CHAT_SET')
  setStreamChatAction: function(id: !string, chatMessage: Genai.Query.ChatMessage, queryResultForUi: Genai.Query.Result.GetForUiResult): UiSdlReduxAction ts-client

  /**
   * Update the state of the #messages to the value of the messages in the action passed in
   */
  @uiSdlReducer(actionType='CHAT_MESSAGES_SET')
  chatMessagesSetEffect: private inline function(state: !UiSdlReduxState,
                                                 action: !GenAiUiChatInputSetAction): !UiSdlReduxState ts-client

  /**
   * Kicks off a `REPLACE_CHAT_QUERY_RESULT` action to perform an in-place replacment of the {@link Genai.Query.Result}
   * for the chat message associated with the `responseAiResultIdToReplace`.
   */
  @uiSdlActionCreator(actionType='REPLACE_CHAT_QUERY_RESULT')
  replaceChatQueryResultAction: function(componentId: !string, responseAiResultIdToReplace: !string, queryResultForUi: !Genai.Query.Result.GetForUiResult): UiSdlReduxAction ts-client

  /**
   * Performs an in-place replacment of the {@link Genai.Query.Result} for the chat message associated with the
   * `responseAiResultIdToReplace`.
   */
  @uiSdlReducer(actionType='REPLACE_CHAT_QUERY_RESULT')
  replaceChatQueryResultReducer: private inline function(state: !UiSdlReduxState,
                                                         action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Update the state of #messages with an intermediary state of the user's message and a message
   * from the chat bot that it is generating an answer
   */
  @uiSdlReducer(actionType='QUERY_SUBMIT')
  querySubmitEffect: private inline function(state: !UiSdlReduxState,
                                             action: !GenAiUiQuerySubmitAction): !UiSdlReduxState ts-client

  /**
   * Update the state of the #inputText to the value of the inputText in the action passed in
   */
  @uiSdlReducer(actionType='SET_INPUT')
  setInputEffect: private inline function(state: !UiSdlReduxState,
                                             action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Append to the #messages when receiving data from the network request
   */
  @uiSdlReducer(actionType='LOADED_DATA_HANDLE')
  chatUpdateEffect: private inline function(state: !UiSdlReduxState,
                                             action: !GenAiUiQuerySubmitAction): !UiSdlReduxState ts-client

  /**
   * Handles updating messages for streaming
   */
  @uiSdlReducer(actionType='STREAM_CHAT_SET')
  chatUpdateStreamEffect: private inline function(state: !UiSdlReduxState,
                                                  action: !GenAiUiQuerySubmitAction): !UiSdlReduxState ts-client

  /**
   * Put the chat in and out of expanded mode
   */
  @uiSdlReducer(actionType='EXPANDED_MODE_SET')
  expandedModeSetEffect: private inline function(state: !UiSdlReduxState,
                                             action: !GenAiUiQuerySubmitAction): !UiSdlReduxState ts-client

  /**
   * Clear the chat
   */
  @uiSdlReducer(actionType='CLEAR_CHAT_MODE_SET')
  clearedModeSetEffect: private inline function(state: !UiSdlReduxState,
                                             action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Triggered when a chat message is selected in the conversation in the query detail page.
   * Sets the selected chat message in the chat component's Redux state.
   */
  @uiSdlActionCreator(actionType='SELECTED_CHAT_MESSAGE_SET')
  setSelectedChatMessageAction: private function(id: !string, chatMessage: Genai.Query.ChatMessage): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SELECTED_CHAT_MESSAGE_SET` and sets the selected message into the chat component state.
   *
   * @param state
   *           Redux State
   * @param action
   *           Redux action
   * @return a new Redux state
   */
  @uiSdlReducer(actionType='SELECTED_CHAT_MESSAGE_SET')
  setSelectedChatMessageReducer: private inline function(state: !UiSdlReduxState, action: !GenAiUiChatInputSetAction): !UiSdlReduxState ts-client

  /**
   * Gets the target tool based on the previous and current target tools depending on the state of the message
   * @param message
   *          The chat message from which to identify the target tool
   * @param prevTargetTool
   *         The previous target tool used
  * @return the target tool string
   */
  getTargetTool: function(message: Genai.Query.ChatMessage, prevTargetTool: string): string ts-client

    /**
   * Gets the target tool based on the previous and current target tools depending on the state of the message
   * @param parentResult
   *          The {@link Genai.Query.Result} from which to generate messages from the plan
   * @param translate
   *         Function to translate the message contents
  * @return an array of objects representing messages to display in the chat
   */
  createPlanMessages: function(parentResult: Genai.Query.Result, translate: any): [any] ts-client
}
