/**
 * Responsive container that adjusts the width of its content based on the available space on screen.
 * The width of the content will be the largest of:
 * - The minimum width of the content (minContentWidth)
 * - The width of the container minus the padding (2 * maxContainerPadding)
 */
@typeScript
type GenAiUiResponsiveContainer mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The minimum width of the content in pixels
   */
  minContentWidthPx: int

  /**
   * The maximum padding (right and left) of the container in pixels
   */
  maxContainerPaddingPx: int

  /**
   * The children components to render
   */
  children: [UiSdlComponentRef<UiSdlComponent>]

  /**
   * Optional CSS class to apply to the wrapping `div` tag of the container
   */
  className: string
}
