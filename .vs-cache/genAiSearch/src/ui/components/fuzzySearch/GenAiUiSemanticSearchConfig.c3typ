/**
 * Configuration options for a {@link https://react.semantic-ui#com/modules/search/ Semantic UI React} component.
 */
type GenAiUiSemanticSearchConfig {

  /**
   * Additional class name to add to the search input.
   */
  className: string

  /**
   * When true the search input will be disabled.
   */
  disabled: boolean

  /**
   * When true the results will take up the width of its container.  This applied to the results container and not the
   * search input itself.
   */
  fluid: boolean

  /**
   * Minimum characters to query for results
   */
  minCharacters: int = 1

  /**
   * The placeholder text to show when the User has not yet typed any thing.
   */
  placeholder: string

  /**
   * Whether a "no results" message should be shown if no results are found.  When false noResultsDescription and
   * noResultsMessage will be ignored.
   */
  showNoResults: boolean = true

  /**
   * Size to render the search results.
   */
  size: string enum('MINI', 'TINY', 'SMALL', 'LARGE', 'BIG', 'HUGE', 'MASSIVE')

  /**
   * The {@link Genai.Agent.Planner} that should be used to generate and execute the plan.
   */
  planner: string
}
