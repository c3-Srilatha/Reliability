/**
 * A component that allows a User to fuzzy search against a set of options client side.  The rendering component is
 * backed by {@link https://react.semantic-ui#com/modules/search/ Semantic UI React}.  The Fuzzy Matching is
 * backed by {@link https://fusejs#io/}.
 */
@beta
@typeScript
type GenAiUiFuzzySearch mixes UiSdlComponent<BasicDataSpec>, UiSdlDebounceableInput {

  /**
   * The specification used for retrieving data searchable by the GenAiUiFuzzySearch.
   */
  @uiSdlDataSpec(dataDestinationField='list')
  dataSpec: ~

  /**
   * The options to fuzzy match against.
   */
  list: private [Obj]

  /**
   * The current selected option from the #list.  Set via the #resultSelectReducer.
   */
  selectedResult: private Obj

  /**
   * The current value of the search input.  Set via #searchChangeReducer.
   */
  searchValue: private string

  /**
   * The number of options to render in the Search component.  Use `-1` to ignore the limit and render them all.
   */
  searchOptionsLimit: int = 10

  /**
   * Where in the data to get the values for the title.
   * See {@link https://react.semantic-ui.com/modules/search/#types-standard} `Search.Result` renderer
   */
  title: UiSdlFieldBasedDataSpecSetting

  /**
   * Where in the data to get the values for the description.
   * See {@link https://react.semantic-ui.com/modules/search/#types-standard} `Search.Result` renderer.
   */
   // TODO DEMO-2872 Support description field
  description: private UiSdlFieldBasedDataSpecSetting

  /**
   * Configuration options for the Fuse search instance.
   */
  fuseSearchConfig: GenAiUiFuseSearchConfig = {}

  /**
   * Configuration options for the Semantic Search component.
   */
  semanticSearchComponentConfig: GenAiUiSemanticSearchConfig = {}

  /**
   * Triggered when the User submits (hits the enter key) the input.
   *
   * @param id
   *           Id of the input component.
   * @param value
   *           Value of the input component upon submission.
   * @param event
   *           Browser event.
   * @return A `INPUT_SUBMIT` action for this instance.
   */
  @uiSdlActionCreator(actionType='INPUT_SUBMIT')
  submitInputAction: function(id: !string,
                              value: !string,
                              event: UiSdlBrowserEvent): !GenAiUiFuzzySearchInputSubmitAction ts-client

  /**
   * Triggered when the User changes the search input.
   * @param id
   *           Id of the component.
   * @param value
   *           The value of the search input.
   * @param event
   *           Browser event.
   * @return A `SEARCH_CHANGE` action for this instance.
   * See {@link https://react.semantic-ui.com/modules/search/#types-standard} `Search.onSearchChange`
   */
  @uiSdlActionCreator(actionType='SEARCH_CHANGE')
  changeSearchAction: function(id: !string,
                               value: !string,
                               event: UiSdlBrowserEvent): !GenAiUiFuzzySearchSearchChangeAction ts-client

  /**
   * Triggered when the User selects one of the search result options.
   * @param id
   *           Id of the component.
   * @param result
   *           The Obj that was selected from the #list of possible options.
   * @param event
   *           Browser event.
   * @return A `RESULT_SELECT` action for this instance.
   * See {@link https://react.semantic-ui.com/modules/search/#types-standard} `Search.onResultSelect`
   */
  @uiSdlActionCreator(actionType='RESULT_SELECT')
  selectResultAction: function(id: !string,
                               result: !Obj,
                               event: UiSdlBrowserEvent): !GenAiUiFuzzySearchResultSelectAction ts-client

  /**
   * Listens for actions of type `RESULT_SELECT` and sets the #selectedResult field.
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @return A new Redux state.
   */
  @uiSdlReducer(actionType='RESULT_SELECT')
  resultSelectReducer: function(state: !UiSdlReduxState,
                                action: !GenAiUiFuzzySearchResultSelectAction): !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `SEARCH_CHANGE` and sets the #searchValue field.
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @return A new Redux state.
   */
  @uiSdlReducer(actionType='SEARCH_CHANGE')
  searchChangeReducer: function(state: !UiSdlReduxState,
                                action: !GenAiUiFuzzySearchResultSelectAction): !UiSdlReduxState ts-client
}
