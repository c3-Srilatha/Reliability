/**
 * Container that accepts a reference. Useful for handling automatic scrolling to a referenced element.
 */
@typeScript
type GenAiUiReferencedContainer mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The identifier of the container
   */
  id: !string;

  /**
   * React reference. The component will add an entry to this object with the key being the id of the reference.
   */
  containerRefs: any

  /**
   * The class name of the container
   */
  className: string
}
