/**
 * Renders {@link Genai.Query.Result}s in a feed format
 */
@typeScript
type GenAiUiFeed mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The id of the {@link GenAiUiFeedApplicationState} this feed interacts with
   */
  feedApplicationStateId: string

  /**
   * The {@link Genai.Query.Result.GetForUiResult}s of the feed by their ids.
   */
  genAiResultsById: map<string, Genai.Query.Result.GetForUiResult> = {}

  /**
   * The ids of the {@link Genai.Query.Result.GetForUiResult}s sorted in the order in which they should be displayed in the feed.
   * Order is ascending, with older results at the beginning of the array and the last user interaction at the end.
   */
  genAiResultsOrder: [string] = []

  /**
   * The id of the {@link Genai.Query.Result.GetForUiResult} that is currently focused in the feed.
   * When this value changes, the feed will scroll to the focused result.
   */
  focusedGenAiResult: string

  /**
   * Whether to the resultId of the GenAI result should be tracked as a query param in the URL.
   * This allows to reload the conversation on page refresh.
   */
  addResultIdQueryParam: boolean

  /**
   * UI Settings dependent on the backend configuration
   */
  uiSettings: GenAiUiConfig

  /**
   * The typewriter delay for the mocked streaming of results.
   */
  typewriterDelay: number

  /**
   * Whether the search bar should be disabled.
   */
  disableSearch: boolean

  /**
   * Set of feature configuration values that are read-only to the user.
   */
  readOnlyConfig: Genai.App.ReadOnlyConfig

  /**
   * Whether corroboration should be enabled in the UI
   */
  corroborationVisibility: string enum ('visible', 'hidden')

  /**
   * Whether the corroboration result should be shown
   */
  showCorroborationResult: boolean

  /**
   * The query tool options available to the user. This allows the user to target a specific tool when submitting a
   * query.
   */
  queryToolOptions: [Genai.Agent.Tool.Config.UiOptions]
}
