/**
 * A textarea input component for entering instructions to the agent.
 */
type GenAiUiInstructionsTextareaField mixes UiSdlTextAreaInput {
  /**
   * The label for the textarea
   */
  label: string;

  /**
   * The field name for the textarea
   */
  field: string;

  /**
   * The loaded value of the textarea
   */
  loadedValue: string;

  /**
   * The placeholder text for the textarea
   */
  placeholder: string;

  /**
   * The formId of the form that this field belongs to
   */
  formId: !string;

  /**
   * The application state that this field will look the options up from
   */
  appStateId: !string;

  /**
   * The path on the application state that this field will look the options up from
   */
  optionsPathOnState: !string;
}
