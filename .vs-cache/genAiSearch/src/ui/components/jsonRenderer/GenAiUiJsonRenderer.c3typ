/**
 * The JSON renderer component.
 */
@typeScript
type GenAiUiJsonRenderer mixes UiSdlComponent<BasicDataSpec> {

  @uiSdlDataSpec(dataDestinationField='source')
  dataSpec: ~

  /**
   * The source JSON to render.
   */
  source: !json

  /**
   * The classname used to wrap the markdown. Allows for custom styling.
   */
  className: string

  /**
   * When an integer value is assigned, strings will be cut off at that length.
   * Collapsed strings are followed by an ellipsis.
   * String content can be expanded and collapsed by clicking on the string value.
   */
  collapseStringsAfterLength: int

  /**
   * Option to display a clipboard that users can click on to copy data in the JSON.
   */
  enableClipboard: boolean
}
