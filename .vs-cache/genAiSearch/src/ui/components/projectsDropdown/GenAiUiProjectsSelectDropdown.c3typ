/**
 * Component that handles the rendering of the projects dropdown.
 */
@typeScript
type GenAiUiProjectsSelectDropdown mixes UiSdlComponent<BasicDataSpec> {
  @uiSdlDataSpec(dataDestinationField='projects')
  dataSpec: ~

  /**
   * The projects to display in the dropdown.
   */
  projects: [Genai.Project]

  /**
   * The user settings for the application
   */
  userSettings: Genai.App.UserSettings

  /**
   * The current app state on {@link Genai.App.State}
   */
  appState: Genai.App.State

  /**
   * Boolean indicating if projects are enabled in the application.
   */
  isUsingProjects: boolean

  /**
   * Boolean indicating the component is rendered in a side panel.
   */
  isSidePanel: boolean

  /**
   * The current path of the application.
   */
  url: string

  /**
   * The page parameters of the application.
   */
  pageParams: json
}
