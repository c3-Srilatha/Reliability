/**
* Container that renders a list of suggested queries.
*/
type GenAiUiSuggestedQueriesContainer mixes UiSdlComponent<BasicDataSpec> {

  @uiSdlDataSpec(dataDestinationField='suggestedQueries')
  dataSpec: ~

  /**
   * The id of application state to which the actions triggered by the component will be attached
   */
 applicationStateId: string

  /**
   * Suggested queries to render in the container.
   */
  suggestedQueries: [Genai.Query]

  /**
   * The layout of the suggested queries container items.
   */
  suggestedQueriesLayout: string enum GenAiUiSuggestedQueriesLayout = LIST

  /**
   * Whether the title of the container should be hidden.
   */
  hideTitle: boolean
}