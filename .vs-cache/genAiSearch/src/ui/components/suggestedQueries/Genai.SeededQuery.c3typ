/**
* Represents a query that can be shown as a suggestion for the user. The #category field can be used to
* customize the suggested queries in the UI through filtering.
*/
entity type Genai.SeededQuery mixes Genai.Query {
  /**
   * The category of the seeded query, this is an optional parameter that can be used for
   * customizing the suggested queries in the feed.
   */
  category: string
}
