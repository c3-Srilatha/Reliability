/**
 * Payload for actions related to source file ids
 */
type GenAiUiSourceFileIdsPayload mixes UiSdlComponentActionPayload {

  /**
   * The source file ids to be added or removed from the file loader component
   */
  sourceFileIds: [string]

  /**
   * Whether to handle all source file ids
   */
  handleAll: boolean
}
