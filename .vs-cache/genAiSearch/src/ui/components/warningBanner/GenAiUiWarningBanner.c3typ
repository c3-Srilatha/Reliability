/**
 * UI Component
 */
@typeScript
type GenAiUiWarningBanner mixes UiSdlComponent<BasicDataSpec> {

  @uiSdlDataSpec(dataDestinationField='numberDocumentsRequested')
  dataSpec: ~

  /**
   * Number of documents requested by the backend.
   */
  numberDocumentsRequested: int

  /**
   * Number of documents displayed by the frontend.
   */
  numberDocuments: int

  /**
   * Banner header text.
   */
  headerText: string

  /**
   * Banner button text.
   */
  buttonText: string

  /**
   * Whether the component is loading.
   */
  loading: boolean

  /**
   * Action to set if the component is loading.
   */
  @uiSdlActionCreator(actionType='LOADING_SET')
  setLoadingAction: function(id: !string, loading: boolean): !GenAiUiWarningBannerLoadingSetAction ts-client

  /**
   * Action to set the number of documents in the banner. Used to hide/show the banner.
   */
  @uiSdlActionCreator(actionType='NUMBER_DOCUMENTS_SET')
  setNumberDocumentsAction: function(id: !string, numberDocuments: !int): !GenAiUiWarningBannerNumberDocumentsSetAction ts-client

  /**
   * Action to kick off when index button is clicked.
   */
  @uiSdlActionCreator(actionType='INDEX_BUTTON_CLICK')
  indexButtonClickAction: function(id: !string): !GenAiUiWarningBannerIndexButtonClickAction ts-client

  /**
   * Reducer for the {@link GenAiUiWarningBannerLoadingSetAction}.
   */
  @uiSdlReducer(actionType='LOADING_SET')
  loadingSetEffect: private inline function(state: !UiSdlReduxState,
                                            action: !GenAiUiWarningBannerLoadingSetAction): !UiSdlReduxState ts-client

  /**
   * Reducer for the {@link GenAiUiWarningBannerNumberDocumentsSetAction}.
   */
  @uiSdlReducer(actionType='NUMBER_DOCUMENTS_SET')
  numberDocumentsSetEffect: private inline function(state: !UiSdlReduxState,
                                                    action: !GenAiUiWarningBannerNumberDocumentsSetAction): !UiSdlReduxState ts-client

  /**
   * Reducer for when data requested by backend. Sets the number of documents displayed for the component.
   */
  @uiSdlReducer(actionType='LOADED_DATA_HANDLE')
  numberDocumentsUpdateEffect: private inline function(state: !UiSdlReduxState,
                                                    action: !UiSdlLoadedDataHandleAction): !UiSdlReduxState ts-client
}
