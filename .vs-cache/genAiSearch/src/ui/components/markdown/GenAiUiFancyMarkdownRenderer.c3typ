// c3-analysis-disable c3-excessive-method-params -- functions must be refactored to use specs where possible

/**
 * A fancy markdown renderer.
 */
@beta
@typeScript
type GenAiUiFancyMarkdownRenderer mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The markdown text that will be rendered.
   */
  markdown: !string

  /**
   * The class name used to wrap the markdown. Allows for custom styling.
   */
  className: string

  /**
   * The delay interval between re-renders of the #markdown text to make it appear as though it's streaming
   * to the UI, like a typewriter animation.
   *
   * Default 0, which disables the typewriter effect.
   */
  typewriterKeyDelay: int = 0

  /**
   * Map passed to `react-markdown` component telling it to prefer certain html tags
   * or custom components over other tags.
   *
   * i.e. {h2: 'h1', p: 'h1'} tells it to use `h1` over `h2` and `p`.
   */
  tagMapping: map<string, any>

  /**
   * Callback used by the typewriter hook. Triggers when the typewriter pauses.
   * @param genAiResultId
   *           The genAiResultId
   * @param chatMessage
   *           The chat message
   * @param dispatch
   *           The dispatch function
   * @param setDoneStreaming
   *           The lambda for setting the done streaming state
   * @param componentId
   *           The component id
   */
  onTypewriterPauseCallback: function(genAiResultId: !string,
                            chatMessage: Genai.Query.ChatMessage,
                            dispatch: !lambda(): any,
                            setDoneStreaming: !lambda(done: boolean),
                            componentId: !string) ts-client

  /**
   * Boolean indicating if the answer is completely done streaming.
   */
  doneStreaming: boolean

  /**
   * The list of sources in the result.
   */
  sources: [Genai.Query.ResultToSourceRelation] = [];
}
