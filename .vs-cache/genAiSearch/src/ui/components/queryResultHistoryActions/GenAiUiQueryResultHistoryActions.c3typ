/**
 * A UI component that conditionally displays a button that allows the user to revert modifications and render the
 * original query.
 */
type GenAiUiQueryResultHistoryActions mixes UiSdlComponent {
  /**
   * The id of the query result that is currently being displayed.
   */
  queryResultId: !string

  /**
   * A callback to clear the previous query. This is called when the button is clicked and _before_ the network request,
   * providing a cleaner user experience in case the request takes a while.
   */
  clearPreviousQuery: lambda()

  /**
   * A callback to update the query result.
   */
  onSetQueryResult: lambda(queryResultForUi: Genai.Query.Result.GetForUiResult)
}
