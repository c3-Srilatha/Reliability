/**
 * Simplified version of {@link UiSdlTabPanel} in which there are only tabs and the tabs content
 */
@typeScript
type GenAiUiTabPanelHeadless mixes UiSdlComponent {

  /**
   * Configurations of components to be rendered as child tabs,
   * it is essentially the same concept as UiViewComponent components.
   * id is required, title is optional
   */
  tabComponents: private ![UiSdlTabComponentRef]

  /**
   * The id of the active tab
   */
  activeTab: private string

  /**
   * Triggered when the active tab needs to be changed
   *
   * @param id
   *            Id of the component.
   * @param activeTab
   *           The id of the active tab
   * @return a `ACTIVE_TAB_CHANGE` action for this instance
   *   - payload {string} the id of the active tab
   */
  @uiSdlActionCreator(actionType='ACTIVE_TAB_CHANGE')
  changeActiveTabAction: function(id: string, activeTab: !string): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `ACTIVE_TAB_CHANGE`, then renders
   *  the tab component if it hasn't been rendered
   *
   *  @param state
   *            Redux state
   *  @param action
   *            Redux action
   *  @return a new Redux state
   */
  @uiSdlReducer(actionType='ACTIVE_TAB_CHANGE')
  activeTabChangeReducer: private function(state: !UiSdlReduxState,
                                           action: UiSdlReduxAction): !UiSdlReduxState ts-client
}
