/**
 * Side panel component for the search results feed.
 */
@typeScript
type GenAiUiSidePanel mixes UiSdlComponent<BasicDataSpec> {
  @uiSdlDataSpec(dataDestinationField='projects')
  dataSpec: ~

  /**
   * The projects to display in the dropdown.
   */
  projects: [Genai.Project]

  /**
   * The user settings for the application
   */
  userSettings: Genai.App.UserSettings

  /**
   * The current app state on {@link Genai.App.State}
   */
  appState: Genai.App.State

  /**
   * All {@link Genai.Conversation} to show in side panel for renaming, deleting, or navigation
   */
  conversationHistory: [Genai.Conversation]

  /**
   * The application state id for storing the conversation history
   */
  applicationStateId: string

   /**
   * The application state id for interacting with the feed.
   */
  feedApplicationStateId: string

  /**
   * The modal to show for confirmation of conversation history deletion
   */
  deleteConversationConfirmationModalId: string

  /**
   * The route to redirect to when a conversation is selected
   */
  conversationsPath: string

  /**
   * The route to the feed page
   */
  feedPagePath: string

  /**
   * The ids of the {@link Genai.Query.Result.GetForUiResult}s sorted in the order in which they should be displayed in the feed.
   * Order is ascending, with older results at the beginning of the array and the last user interaction at the end.
   */
  genAiResultsOrder: [string] = []
}
