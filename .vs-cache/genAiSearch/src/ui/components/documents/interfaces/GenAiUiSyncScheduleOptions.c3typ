/**
 * Type containing information about the document syncing options
 */
type GenAiUiSyncScheduleOptions {

  /**
   * True if the CronJob to handle automatic document syncing is enabled, false otherwise.
   */
  enableSync: !boolean

  /**
   * True if the CronJob should automatically update the index, false otherwise.
   */
  autoUpdateIndex: !boolean

  /**
   * How frequently the CronJob should run.
   */
  syncFrequency: !string enum('DAILY', 'MONTHLY')

  /**
   * The 12-hour time to run the CronJob at.
   */
  time: !int

  /**
   * The period of the day to run the CronJob at (AM or PM).
   */
  period: !string enum('AM', 'PM')
}
