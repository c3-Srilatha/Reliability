/**
 * Component that renders the document sync schedule form.
 */
@typeScript
type GenAiUiSyncScheduleForm mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The saved options for document syncing.
   */
  syncScheduleOptions: GenAiUiSyncScheduleOptions

  /**
   * Takes in a cron expression and parses it into an {@link GenAiUiSyncScheduleOptions} object.
   */
  parseCronJob: function(cronJob: !CronJob): !GenAiUiSyncScheduleOptions ts-client

  /**
   * Updates the syncing CronJob with the new preferences.
   */
  submitSyncScheduleOptions: function(options: GenAiUiSyncScheduleOptions) ts-client
}
