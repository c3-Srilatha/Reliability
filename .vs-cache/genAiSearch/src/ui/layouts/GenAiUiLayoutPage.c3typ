/**
 * Layout for Enterprise Search Pages
 */
@typeScript
type GenAiUiLayoutPage mixes UiSdlLayoutNavigation {
  /**
   * Optional CSS class to apply to the wrapping `div` tag of the layout
   * ```
   *   <div class="flex-container ${applicationName} ${className}">
   *   </div>
   * ```
   */
  applicationName: string = 'enterprise-search'

  /**
   * Optional CSS class to apply to the wrapping `div` tag of the layout
   * ```
   *   <div class="flex-container ${applicationName} ${className}">
   *   </div>
   * ```
   */
  className: string

  /**
   * The children components to render
   */
  children: [UiSdlComponentRef<UiSdlComponent>]

  /**
   * Document title for the browser tab.  Without a {@link UiSdlPageTitle} the default is Webpack App
   */
  documentTitle: string = 'Enterprise AI Search'
}
