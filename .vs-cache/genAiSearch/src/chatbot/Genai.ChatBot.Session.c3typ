/**
 * Type to interface with common {@link Genai.ChatBot} functions. This Type abstracts handling states and inputs for a chat session.
 */
 entity type Genai.ChatBot.Session {

  /**
   * Associated parent for the current chat. Synonymous with the first question of a chat session.
   */
  parentResult: Genai.Query.Result

  /**
   * The most recent query result for a chat session.
   */
  latestResult: Genai.Query.Result

  /**
   * The chat history associated with a chat session.
   */
  chatHistory: [Genai.Query.ChatMessage]

  /**
   * The user associated with the chat session.
   */
  user: User

  /**
   * The main user-facing function for chat. In the background, this function calls the private functions
   * `startChat` and `followupChat`, depending on chat state (first question in chat vs. follow-ups).
   * @param question
   *           The desired user query.
   * @return The answer from the created {@link Genai.Query.Result} from the user query.
   */
  getResponse: member function(question: !string): !string py

  /**
   * Private - should not be called directly.
   */
  startChat: private member function(question: !string): !string py

  /**
   * Private - should not be called directly.
   */
  followupChat: private member function(followup_question: !string): !string py
}
