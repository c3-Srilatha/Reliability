// c3-analysis-disable c3-excessive-method-params -- functions must be refactored to use specs where possible

/**
 * Backend to chat with the {@link Genai.UnstructuredQuery.Engine} either from an original search query
 * or from chat
 */
remix type Genai.ChatBot {

  /**
   * Used by the main search bar, it generates a relevant {@link Genai.Query.Result} to the user query.
   * @param inProgressResult
   *           The {@link Genai.Query.Result} which would be returned for the given search query.
   *           This result is persisted when the search is triggered and updated as the query is processed.
   * @param streamResponse
   *           Whether or not the response should be streamed.
   * @return The {@link Genai.Query.Result} that contains the answer to the user query.
   */
  query: function(inProgressResult: !Genai.Query.Result, streamResponse: boolean): !Genai.Query.Result js-rhino

  /**
   * Used by the main search bar, it generates a relevant {@link Genai.Query.Result} to the user query.
   * The only difference with #query is that this returns a stream the UI can use to show the answer before it has completed
   * generating. In order to show the final result, the {@link Genai.Query.Result} from inProgressResult needs to be polled
   * with {@link Genai.Query.Result#getForUi} after the stream has finished.
   * @param inProgressResult
   *           The {@link Genai.Query.Result} which would be returned for the given search query.
   *           This result is persisted when the search is triggered and updated as the query is processed.
   * @return The stream that contains the answer to the user query.
   */
  streamQuery: function(inProgressResult: !Genai.Query.Result): stream<string> js-rhino

  /**
   * Used for opening a query from a chat message, it generates a {@link Genai.Query.Result} that takes into account
   * context through the messages history and the initial {@link Genai.Query.Result}.
   * @param inProgressResult
   *           The {@link Genai.Query.Result} which would be returned for the given search query.
   *           This result is persisted when the search is triggered and updated as the query is processed.
   * @param originalAiResult
   *           The {@link Genai.Query.Result} that was generated from the original search query.
   * @param chatHistory
   *           The history of {@link Genai.Query.ChatMessage} that have been sent to the chatbot.
   * @param streamResponse
   *           Whether or not the response should be streamed.
   * @return The {@link Genai.Query.Result} that contains the answer to the user query.
   */
  queryFromChat: function(inProgressResult: !Genai.Query.Result,
                          originalAiResult: !Genai.Query.Result,
                          chatHistory: [Genai.Query.ChatMessage],
                          streamResponse: boolean): !Genai.Query.Result js-rhino

  /**
   * Used for opening a query from a test case, it generates a {@link Genai.Query.Result} that takes into account
   * context through the messages history and the initial {@link Genai.Query.Result}.
   * @param inProgressResult
   *           The {@link Genai.Query.Result} which would be returned for the given search query.
   *           This result is persisted when the search is triggered and updated as the query is processed.
   * @param testCaseSpec
   *           The {@link Genai.Agent.Dynamic.InitializationSpec} that should be used to answer the query.
   * @return The {@link Genai.Query.Result} that contains the answer to the user query.
   */
  queryFromTestCase: function(inProgressResult: !Genai.Query.Result,
                              testCaseSpec: !Genai.Agent.Dynamic.TestSpec): !Genai.Query.Result js-rhino

  /**
   * Used in chat interaction, it generates a new {@link Genai.Query.ChatMessage} containing the answer to the user query
   * in the {@link Genai.Query.ChatMessage#responseAiResult} that takes into account context through the messages history
   * @param newMessage
   *           The {@link Genai.Query.ChatMessage} that was sent by the user.
   * @param chatHistory
   *           The history of {@link Genai.Query.ChatMessage} that have been sent to the chatbot.
   * @return The {@link Genai.Query.ChatMessage} that contains the answer to the user query.
   */
  chat: function(newMessage: !Genai.Query.ChatMessage,
                 chatHistory: [Genai.Query.ChatMessage],
                 streamResponse: boolean): !Genai.Query.ChatMessage js-rhino

  /**
   * Used in chat interaction, it generates a new {@link Genai.Query.ChatMessage} containing the answer to the user query
   * in the {@link Genai.Query.ChatMessage#responseAiResult} that takes into account context through the messages history.
   * The only difference with #chat is that this returns a stream the UI can use to show the answer before it has completed
   * generating. In order to show the final result, the {@link Genai.Query.Result} from
   * {@link Genai.Query.ChatMessage#responseAiResult} needs to be polled with {@link Genai.Query.Result#getForUi}.
   * @param newMessage
   *           The {@link Genai.Query.ChatMessage} that was sent by the user.
   * @param chatHistory
   *           The history of {@link Genai.Query.ChatMessage} that have been sent to the chatbot.
   * @return The stream that contains the answer to the user query.
   */
  streamChat: function(newMessage: !Genai.Query.ChatMessage,
                       chatHistory: [Genai.Query.ChatMessage]): stream<string> js-rhino


  /**
   * Private - do not use - exposed only for testing purposes
   */
  chatIncludeString: private function(): !string js-rhino
}
