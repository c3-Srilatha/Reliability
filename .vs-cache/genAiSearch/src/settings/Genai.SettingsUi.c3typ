/**
 * Utility functions to fetch and manipulate settings from the UI
 */
type Genai.SettingsUi {
  /**
   * Returns the config Types used by the app
   */
  fetchConfigTypes: function(): !json js-rhino

  /**
   * Given a specific config type, returns all instances of that config type. For singletons, it will return a single instance.
   */
  fetchConfigInstances: function(configTypeName: string): !json js-rhino

  /**
   * Given a specific config type and instance, returns the config values for the instance.
   * @param configTypeName
   *           The name of the config type
   * @param configInstanceName
   *           The name of the config instance
   */
  getConfigInstance: function(configTypeName: string, configInstanceName: string): !json js-rhino

  /**
   * Given a specific config type, instance, and values, it will save the values to the instance.
   * @param configTypeName
   *           The name of the config type
   * @param configInstanceName
   *           The name of the config instance
   * @param configValues
   *           The values to save to the instance
   */
  saveConfig: function(configTypeName: !string, configInstanceName: !string, configValues: !json) js-rhino


  /**
   * It closes python processes to force a reload of the settings
   * @param affectedState
   *           The {@link Genai.App.State} field that needs the engines to restart to reflect changes. If `configsState`, it will
   *           restart all engines. If `agentsState`, it will restart only the query orchestrator engine.
   */
  restartEngines: function(affectedState: string enum ('agentsState', 'configsState') = 'configsState') js-rhino

  /**
   * It closes the query orchestrator engine across running nodes to force a reload of the agents in the app.
   */
  restartSearchEngine: function() js-rhino
}
