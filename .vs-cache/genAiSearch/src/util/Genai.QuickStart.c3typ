/**
 * Util Type for quick setup of standard GenAi deployment.
 */
remix type Genai.QuickStart {

   /**
    * Enable/disable multi-lingual functionality to translate user queries and uploaded documents.
    * Translation keys should be configured beforehand.
    *
    * @param enabled
   *           Enable/disable feature
    * @param translatorTypeName
   *           Translation type name to route translation requests to.
    */
  enableMultiLingual: function(enabled: !boolean, translatorTypeName: string) js-client
}
