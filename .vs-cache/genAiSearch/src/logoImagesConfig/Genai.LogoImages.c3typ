/**
 * Represents the different image variations used for proper display in the UI,
 * based on the themes defined in {@link UiSdlThemeCategory}.
 *
 * These variations ensure that images are styled and displayed correctly according
 * to the selected theme categories within the application.
 */
type Genai.LogoImages {
  /**
   * The image to be used when the selected theme is {@link UiSdlThemeCategory#LIGHT}.
   */
  Light: string

  /**
   * The image to be used when the selected theme is {@link UiSdlThemeCategory#DARK}.
   */
  Dark: string
}
