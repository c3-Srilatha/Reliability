/**
 * Type for managing the configuration of logo images to be displayed in the UI.
 *
 * This type handles the following operations for the logos:
 * - Storing logo images
 * - Updating existing images
 * - Retrieving images for display
 */
type Genai.LogoImages.Config mixes Config, Singleton {
  /**
   * Sets the images to be used in GenAiUi.SearchPage.
   */
  home: Genai.LogoImages

  /**
   * Sets the images to be used in {@link UiSdlNavMenu}.
   */
  menu: Genai.LogoImages

  /**
   * Sets the images to be used in GenAiUi.ChatBox.
   */
  chat: Genai.LogoImages

  /**
   * Sets the banner to be used in {@link GenAiUiC3WebpageBanner}
   */
  banner: Genai.LogoImages

  /**
   * Configures and saves one or more images by validating their format, theme, and location.
   *
   * This function performs the following tasks:
   * 1. Validates the image format against the allowed formats defined in {@link LogoImagesValidExtensions}.
   * 2. Checks if the provided theme is valid according to {@link UiSdlThemeCategory}.
   * 3. Ensures the location of the image is valid as specified in {@link LogoImagesValidLocations}.
   *
   * If all parameters are valid, the function:
   * - Appends `?not-from-cache-please` to the image URL to bypass the cache and retrieve the most recent version of the image.
   * - Encodes the URL to ensure it is saved correctly in the database.
   *
   * Finally, the function saves the image according to the specified parameters.
   *
   * @param imageUrl
   *      The URL of the image to be saved.
   * @param theme
   *      The theme associated with the image to be saved.
   * @param location
   *      The location where the image will be saved.
   * @return
   *      The result of the operation, which includes success message or any errors encountered.
   */
  setImageForTheme: function(
    imageUrl: !string,
    theme: UiSdlThemeCategory = LIGHT,
    location: LogoImagesValidLocations = ALL
  ): string js-rhino

  /**
   * Retrieves the image configuration from {@link Genai.LogoImages.Config}
   * and {@link Genai.LogoImages.DefaultConfig}.
   */
  getAllImages: function(): json js-rhino
}
