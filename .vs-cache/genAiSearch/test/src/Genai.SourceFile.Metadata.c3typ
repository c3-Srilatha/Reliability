/**
 * Remix of SourceMetadata to test the {@link Genai.SourceCollection#syncMetadataLambda}
 * functionality
 */
remix type Genai.SourceFile.Metadata {

  /**
   * Name of the machine the file is for.
   */
  machineName: string

  /**
   * Name of the component on the machine.
   */
  componentName: string
}
