/**
 * Utility Type for GenAi Luke tests.
 */
type Genai.LukeTestPage mixes LukeTestPage {
  /**
   * Reloads browser.
   */
  reloadPage: inline member function() js-client

  /**
   * Opens a LukeTestPage as a user with a given role.
   */
  openWithRole: inline function(client: !LukeBrowser, role: !string, path: string): Genai.LukeTestPage.Impersonated js-client

  /**
   * Searches for element using selectorMap in Genai.LukeTestPage.js.
   */
  search: inline member function(selectorKey: !string): LukeAsyncQueueNode js

  /**
   * Searches for element by text using selectorMap in Genai.LukeTestPage.js.
   */
  searchForElementWithText: inline member function(selectorKey: !string, text: !string): LukeAsyncQueueNode js

  /**
   * Enters query from home/search page
   */
  query: inline member function(searchQuery: !string) js-client

  /**
   * Configures specified tool as the only UI selectable tool and tool in toolkit
  */
  configureDefaultTool: inline member function(toolId: !string) js
}
