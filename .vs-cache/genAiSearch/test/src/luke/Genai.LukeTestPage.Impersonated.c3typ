
/**
 * Represents an impersonated {@link Genai.LukeTestPage} identified by the {@link TestUser}
 * that is being impersonated.
 */
type Genai.LukeTestPage.Impersonated {
  /**
   * Instance of the {@link Genai.LukeTestPage} that is being impersonated with the user token.
   */
  lukeTestPage: Genai.LukeTestPage

  /**
   * User that is being impersonated.
   */
  user: TestUser
}
