/**
 * This type serves as an example of what a developer would do to create their own custom operators.
 */
remix type Genai.Query.Operator.Types {
  /**
   * Filter based on {@link Genai.SourceFile.Metadata#machineName}.
   * Usage: "What is broken? machine:Conveyer" will query only on files with the machine metadata labeled as 'Conveyer'
   */
  machine: const string = 'machineName'

  /**
   * Filter based on {@link Genai.SourceFile.Metadata#componentName}.
   * Usage: "What is working? component:Bolt" will query only on files with the component metadata labeled as 'Bolt'
   */
  component: const string = 'componentName'
}
