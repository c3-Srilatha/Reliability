{
  "name": "genAiSearch",
  "version": "6.188.1",
  "description": "C3 Generative AI Search Application",
  "author": "C3 Generative AI Team<genai@c3.ai>",
  "dependencies": {
    "genAiBase": "6.188",
    "uiSdlReact": "8.8",
    "userManagement": "8.8",
    "selfServiceDI": "8.8"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@c3/c3-base",
      "plugin:@c3/esnext",
      "plugin:@c3/react",
      "plugin:@c3/typescript",
      "plugin:jsx-a11y/recommended",
      "plugin:prettier/recommended",
      "prettier/react"
    ],
    "plugins": ["@c3", "react-hooks"],
    "parserOptions": {
      "sourceType": "module"
    },
    "rules": {
      "@typescript-eslint/ban-types": "error",
      "@typescript-eslint/no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^e$|^_",
          "ignoreRestSiblings": true
        }
      ],
      "import/prefer-default-export": "off",
      "react-hooks/rules-of-hooks": "error",
      "react/jsx-wrap-multilines": "off",
      "react/prop-types": "off"
    },
    "settings": {
      "react": {
        "version": "16.9.0"
      }
    }
  }
}
