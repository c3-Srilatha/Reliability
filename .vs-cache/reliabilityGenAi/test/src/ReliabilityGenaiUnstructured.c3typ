/**
 * Type to trigger the syncing and processing of unstructured files uploaded to the application.
 */
type ReliabilityGenaiUnstructured {

  /**
   * Calls {@link ReliabilityGenaiUnstructured#setUpVectorStoreAndSourceCollection} to retrieve the {@link Genai.SourceCollection}.
   * Syncs and processes the files in the {@link Genai.SourceCollection}.
   */
  syncAndProcess: function() js-rhino

  /**
   * Sets up the Vector Store and creates the {@link Genai.SourceCollection}
   * for the files populated at {@link ReliabilityGenaiUnstructuredConfig#rootUrlMountName}.
   * @returns the initialized source collection for the vector store.
   */
  setUpVectorStoreAndSourceCollection: function(): Genai.SourceCollection js-rhino
}
