/**
 * Basic test data for the Reliability Generative Ai logic.
 */
type ReliabilityGenaiTestData {

  /**
   * Main entry point. Call this method to set up GenAi config and load all test data at once.
   * @param apiKey
   *          Required string API key for Gen Ai.
   * @param options
   *          Optional options through {@link ReliabilityGenaiTestDataOptions} to load test data
   */
  loadTestData: function (apiKey: !string, options: ReliabilityGenaiTestDataOptions) js-rhino

  /**
   * Removes test data. WARNING: calls `removeAll` on a lot of types.
   */
  removeTestData: function () js-rhino

  /**
   * Load types and relations required to support GenAi feature for alert and case detail pages
   * Called by #loadTestData
   * @param options
   *          Optional options through {@link ReliabilityGenaiTestDataOptions} to load test data
   */
  loadTypeData: function (options: ReliabilityGenaiTestDataOptions) js-rhino
}
