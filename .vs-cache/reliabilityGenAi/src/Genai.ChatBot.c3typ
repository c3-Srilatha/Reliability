// TODO REL-8557: Remove this file and other Reliability Chatbot workarounds.
remix type Genai.ChatBot {

  /**
   * Used in the side panel to modify the prompt parameters based on the route and page params to provide agent the context of what the user is seeing.
   * This is only used on detail pages like alert-detail, case-detail etc. to add the dynamic ids of those pages to the user query for the agent to provide better answers.
   *
   * @param agentConfigName
   *           The name of the agent config to use.
   * @param route
   *           The route of the page.
   * @param pageParams
   *           The page params of the page.
   *
   * @return The string specifying the content that was added to the prompt.
   */
  modifyPrompt: function(agentConfigName: !string, route: !string, pageParams: !map<string, string>): !string js-rhino
}
