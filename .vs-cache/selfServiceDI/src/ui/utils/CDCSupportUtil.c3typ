/**
 * Utility functions for checking CDC (Change Data Capture) support
 */
@typeScript
type CDCSupportUtil {

  /**
   * Checks if CDC features are supported by the current server version.
   * CDC features require server version 8.9.0 or higher.
   *
   * @param state - The current Redux state
   * @returns Returns true if server version is 8.9.0 or higher, false otherwise
   */
  isCDCSupported: function(state: UiSdlReduxState): boolean ts-client
}

