/**
 * Utility functions for checking unstructured data integration support
 */
@typeScript
type UnstructuredDISupportUtil {

  /**
   * Checks if unstructured data integration is supported in the current environment.
   * This function verifies:
   * 1. Server version is at least 8.9.0
   * 2. The application has a dependency on genaiPlatform package
   *
   * @param state - The current Redux state
   * @returns Returns true if unstructured DI is supported, false otherwise
   */
  isUnstructuredDISupported: function(state: UiSdlReduxState): UiSdlObservable ts-client
}
