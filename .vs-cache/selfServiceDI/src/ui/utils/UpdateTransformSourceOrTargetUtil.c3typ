/**
 * Utility functions to Update Source and Target for Transforms
 */
@typeScript
type UpdateTransformSourceOrTargetUtil {

  /**
   * Parses the transform for persistables and updates them to Identity Canonical
   * @param transforms
   *
   * @param typeMetasCache
   *
   * @returns [updatedTransforms, upsertTargetList]
   *          Updated transform object and Types List to upsert (If any)
   */
  updateTransformSourceOrTarget: function(transforms: ![json],
                                          typeMetasCache: !map<string, TypeMeta>): [json] ts-client
}
