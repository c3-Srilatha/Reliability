/**
 * Utility functions for NodeDiagram
 */
@typeScript
type NodeDiagramUtil {

  /**
   * Retrieves the source, target, and filter node identifiers based on the selected node ID and transform.
   * @param selectedNodeId - The ID of the selected node.
   * @param transform - The transform object containing source and target information.
   * @returns An object containing the sourceNode, targetNode, and filterNode identifiers.
   */
  getNodeIdentifiers: function(selectedNodeId: string, transform: Transform): Obj ts

  /**
   * Given a source system type, returns the corresponding source system name.
   */
  getNodeSourceSystemName: function(sourceSystemType: string): string ts 
}
