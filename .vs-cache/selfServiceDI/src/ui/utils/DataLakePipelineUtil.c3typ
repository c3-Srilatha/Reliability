/**
 * Utility functions for data lake pipeline operations
 */
@typeScript
type DataLakePipelineUtil {

  /**
   * Creates a default copy to data lake pipeline for the given source collection.
   * This function makes a tunneledAjax call to DataInteg.Pipeline.createDefaultCopyToDataLakePipeline
   * with the sourceCollection as the payload.
   *
   * @param state - The current Redux state
   * @param sourceCollection - The source collection to create the pipeline for
   * @returns Returns an observable that completes on success or errors on failure
   */
  createDefaultCopyToDataLakePipeline: function(state: UiSdlReduxState,
                                                sourceCollection: FileSourceCollection,
                                                partitionExpressions: [string]): UiSdlObservable ts-client
}
