/**
 * Does the following in order:
 * - Decides which component to render for the File Settings tab on the File Upload flow
 * - Would return 'parquetMode', 'csvEditMode' and 'csvViewMode' for different components rendering
 * - based on file type and edit mode
 */
@typeScript
type FileSettingsSwitchCondition mixes UiSdlRenderSwitchCondition {

  useSwitchCondition: ~
}
