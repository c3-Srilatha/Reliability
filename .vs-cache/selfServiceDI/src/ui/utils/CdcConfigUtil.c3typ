/**
 * Utility functions for handling CDC (Change Data Capture) configuration
 */
@typeScript
type CdcConfigUtil {

  /**
   * Creates tunneledAjax calls to fetch CDC config for multiple SqlSourceCollections
   *
   * @param siteId - The site identifier for the tunneled ajax calls
   * @param state - The current application state
   * @param sqlSourceCollections - Array of SqlSourceCollection objects that need config data
   * @returns Array of Observable config calls that can be used with forkJoin
   */
  createCdcConfigCalls: function(siteId: string,
                                 state: !UiSdlReduxState,
                                 sqlSourceCollections: [SourceCollection]): [UiSdlObservable] ts-client

  /**
   * Processes CDC config results and updates the source collections cache
   *
   * @param configResults - Array of CDC config results from forkJoin
   * @param sourceCollectionsCache - The source collections cache object to update
   */
  processCdcConfigResults: function(configResults: [SelfServiceDICdcConfig],
                                    sourceCollectionsCache: map<string, Obj>) ts-client

  /**
   * Processes CDC configs for source collections if needed, then triggers final actions.
   * This function handles the common pattern of:
   * 1. Filtering for SqlSourceCollections
   * 2. If none exist, immediately returning final actions
   * 3. Otherwise, fetching configs in parallel, processing results, then returning final actions
   */
  processCdcConfigsAndTriggerFinalActions: function(siteId: ?string,
                                                    state: !UiSdlReduxState,
                                                    sourceCollections: [SourceCollection],
                                                    sourceCollectionsCache: map<string, Obj>,
                                                    triggerFinalActions: lambda(): UiSdlObservable): UiSdlObservable ts-client

  /**
   * Checks if this is a first-time CDC setup for a source collection
   * First-time means: CDC is enabled with tracking column but no existing transforms
   */
  isFirstTimeCdcSetup: function(cdcConfig: SelfServiceDICdcConfig,
                                sourceCollection: SourceCollection,
                                transformCache: map<string, Transform>,
                                selectedSourceName: string): boolean ts-client
}
