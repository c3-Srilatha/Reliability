/**
 * Epic to load {@link SourceCollection}s for the given {@link SourceSystem}s and update the
 * {@link SelfServiceDIDataSourcesCacheApplicationState#sourceCollectionsCache} in state. If any source collections
 * for those source systems already exist in the cache and they are not included in the fetch result, they will be
 * removed from the cache.
 */
@typeScript
type SelfServiceDIRefreshSourceCollectionsForSourceSystemsEpic mixes UiSdlEpic {

  epic: ~ ts-client
}
