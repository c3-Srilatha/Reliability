/**
 * Epic to test the connection of a user's configuration form
 */
@typeScript
type OpenDeleteSourceModalEpic mixes UiSdlEpic {

  /**
   * Wraps the followUpObservable with relevant delete modal actions and returns {@link UiSdlActionsObservable}
   */
  handlePrimaryButtonClickForDeleteModalObservable: function(modalId: string, followUpObservable: UiSdlActionsObservable): UiSdlActionsObservable ts-client

  /**
   * An action open to call the {@link OpenDeleteSourceModalEpic}
   *
   * @param nodeId
   *    The id of the tree node to set the selected source in state.
   * @param modalId
   *    The id of the modal to open
   *
   * @returns a `OPEN_DELETE_SOURCE_MODAL` action
   */
  @uiSdlActionCreator(actionType='OPEN_DELETE_SOURCE_MODAL')
  openDeleteSourceModalAction: function(nodeId: string, modalId: string): !UiSdlReduxAction ts-client

  epic: ~ ts-client
}
