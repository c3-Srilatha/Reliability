/**
 * Removes the stale {@link SourceCollection}s {@link Type}s related to a {@link SourceSystem} if they are no longer
 * needed. A list of table names to keep can be provided, in which case the metadata relate to those table names will
 * not be deleted.
 */
@typeScript
type RemoveStaleSourceMetadataEpic mixes UiSdlEpic {

  epic: ~ ts-client
}
