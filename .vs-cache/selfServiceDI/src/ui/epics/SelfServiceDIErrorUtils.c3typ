/**
 * Utility for generating banner actions with generic error messaging for selfServiceDI
 */
@typeScript
type SelfServiceDIErrorUtils {
  /**
   * Returns an errorBanner action with preformatted information for errors to show in selfServiceDI
   * @param primaryText
   *        the text or spec to resolve to show the main text of the error banner
   */
  errorBannerAction: function(primaryText: string | UiSdlDynamicValueSpec): UiSdlBannerShowAction ts-client
}
