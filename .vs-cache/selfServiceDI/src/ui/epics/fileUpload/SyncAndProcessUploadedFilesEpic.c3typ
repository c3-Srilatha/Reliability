/**
 * Epic that syncs and triggers the data integration process for a set of files
 */
@typeScript
type SyncAndProcessUploadedFilesEpic mixes UiSdlEpic {

  /**
   * An action to sync and process files
   *
   * @param files
   *            An array of {@link File} to sync and process
   * @param sourceCollectionName
   *            The sourceCollection associated with the process
   * @returns a 'SYNC_AND_PROCESS_FILES' action
   */
  @uiSdlActionCreator(actionType='SYNC_AND_PROCESS_FILES')
  syncAndProcessFilesAction: function(files: !json, sourceCollectionName: !string): !UiSdlReduxAction ts-client

  epic: ~ ts-client
}
