/**
 * Does the following in order:
 * - Deletes all the table records.
 * - Deletes the {@link FileSourceCollection}, {@link Transform} metadata and {@link Persistable}, {@link Source} types for a given table.
 * - Deletes the {@link SourceFile}s, and chunk files for the table.
 */
@typeScript
type DeleteFileBackedTablePipelineEpic mixes UiSdlEpic {

  epic: ~ ts-client
}
