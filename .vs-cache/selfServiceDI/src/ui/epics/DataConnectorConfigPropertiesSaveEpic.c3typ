/**
 * Epic to Save Data Connector Config properties in state
 */
@typeScript
type DataConnectorConfigPropertiesSaveEpic mixes UiSdlEpic {

  epic: ~ ts-client

  /**
   * Observable that merges properties and generates form data for data connector configuration.
   * Single responsibility: prepare form data without dispatching actions.
   */
  getMergedPropertiesFormDataObservable: function(state: UiSdlReduxState): json ts-client
}
