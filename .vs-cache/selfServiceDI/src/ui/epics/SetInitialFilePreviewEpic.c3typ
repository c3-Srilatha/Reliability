/**
 * Epic to initialize the target preview with the first available file selected in file upload flow
 * or read the file and store in the state for the ConfigureSchemaAndPreviewStep
 */
@typeScript
type SetInitialFilePreviewEpic mixes UiSdlEpic {

  epic: ~ ts-client

  /**
   * Action to set the initial file preview
   */
  @uiSdlActionCreator(actionType='SET_INITIAL_FILE_PREVIEW')
  setInitialFilePreviewAction: private function(treeViewId: string,
                                                fileUploadpreviewTab: string,
                                                fileStoragePreviewTab: string): !UiSdlReduxAction ts-client
}
