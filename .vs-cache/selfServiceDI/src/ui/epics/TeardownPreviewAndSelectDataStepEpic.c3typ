/**
 * Epic to teardown state associated with the `PreviewAndSelectDataStep`. This is run on cancel when user edits should
 * be undone and on completion to clear state for next time.
 */
@typeScript
type TeardownPreviewAndSelectDataStepEpic mixes UiSdlEpic {

  epic: ~ ts-client
}
