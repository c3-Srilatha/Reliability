/**
 * Epic to set the selected file preview in state for target preview
 */
@typeScript
type SetSelectedFilePreviewEpic mixes UiSdlEpic {

  /**
   * Action creator for setting the selected file to avoid race conditions
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_FILE')
  setSelectedFileAction: function(nodeId: string): !UiSdlReduxAction ts-client

  epic: ~ ts-client
}
