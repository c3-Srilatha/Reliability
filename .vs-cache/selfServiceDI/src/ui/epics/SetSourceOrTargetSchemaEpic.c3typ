/**
 * Epic to set the source/target name and schema in state
 */
@typeScript
type SetSourceOrTargetSchemaEpic mixes UiSdlEpic {

  /**
   * Action creator for setting the source/target name and schema
   */
  @uiSdlActionCreator(actionType='SET_SCHEMA')
  setSchemaAction: function(schema: TypeMeta | DataFusionUiTypeMeta,
                            schemaLocation: string enum('source', 'target')): !UiSdlReduxAction ts-client

  epic: ~ ts-client
}
