/**
 * Epic to set up schemas for Transform Designer
 */
@typeScript
type GetSchemasForTransformDesignerEpic mixes UiSdlEpic {

  /**
   * Action creator for sending the proper schemas to transform designer
   */
  @uiSdlActionCreator(actionType='GET_SCHEMAS_FOR_TRANSFORM_DESIGNER')
  getSchemasForTransformDesignerAction: function(sourceName: string,
                                                 targetName: string,
                                                 sourceSchema: TypeMeta): !UiSdlReduxAction ts-client

  epic: ~ ts-client
}
