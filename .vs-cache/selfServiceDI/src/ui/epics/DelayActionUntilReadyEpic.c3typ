/**
 * Epic that handles delaying actions until a ready condition is met.
 *
 * This epic processes DelayActionUntilReadyAction and:
 * 1. Recursively resolves the readySpec to determine if the condition is met
 * 2. If ready, dispatches the followup actions
 * 3. If not ready and retry count is within limits, delays and retries
 * 4. If max retries exceeded, stops processing
 */
@typeScript
type DelayActionUntilReadyEpic mixes UiSdlEpic {

  /**
   * Creates a DelayActionUntilReadyAction
   *
   * @param followupActions - Array of actions to dispatch when ready condition is met
   * @param readySpec - UiSdlDynamicValueSpec that determines when actions are ready
   * @param delayMs - Delay in milliseconds between retries (default: 500)
   * @param maxRetries - Maximum number of retry attempts (default: 10)
   * @returns DelayActionUntilReadyAction
   */
  @uiSdlActionCreator(actionType='DELAY_UNTIL_READY')
  createDelayActionUntilReadyAction: function(follwupActions: [UiSdlReduxAction],
                                              readySpec: UiSdlDynamicValueSpecParam,
                                              delayMs: int,
                                              maxRetries: int): !UiSdlReduxAction ts-client

  epic: ~ ts-client
}
