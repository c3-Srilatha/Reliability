/**
 * Epic to list files for an external source system and store in the state
 */
@typeScript
type ListFilesForExternalSourceSystemEpic mixes UiSdlEpic {

  /**
   * Action creator for setting the sourceCollectionName and externalFileSourceCollectionName
   */
  @uiSdlActionCreator(actionType='LIST_FILES_FOR_EXTERNAL_SOURCE_SYSTEM')
  listFileForExternalSourceSystemAction: function(sourceCollectionName: string,
                                                  externalFileSourceCollectionName: string,
                                                  sourceSystemName: string): !UiSdlReduxAction ts-client

  epic: ~ ts-client
}
