/**
 * Helper methods for interacting with file uploading paths in SelfServiceDI
 */
@typeScript
type FileUploadPathUtil {

  /**
   * Creates the path to upload file chunks during {@link MultipartUploadEpic}
   * @param state
   *           Redux state
   * @param dataLoadMount
   *           The path to the data load mount
   * @param tableName
   *           The name of the table to upload to
   * @returns a combined path representing the intermediary location of source file chunks
   */
  getFileChunkDropLocation: function(state: !UiSdlReduxState, dataLoadMount: !string, tableName: !string): string

  /**
   * Extracts {@link SourceCollection#name} and the name of the file from the url
   * @param state
   *           Redux state
   * @param url
   *           The path of the file
   * @returns a new Redux state
   */
  extractUploadInfoFromPath: function(state: !UiSdlReduxState, url: !string): string
}
