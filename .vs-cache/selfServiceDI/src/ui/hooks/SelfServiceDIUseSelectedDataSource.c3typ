/**
 * Returns details about the selected data source node in the tree view
 */
@typeScript
type SelfServiceDIUseSelectedDataSource mixes UiSdlRenderSwitchCondition {

  /**
   * The path to use while traversing into the node in order to get the value to use as the switch condition
   */
  path: string

  useSwitchCondition: ~
}
