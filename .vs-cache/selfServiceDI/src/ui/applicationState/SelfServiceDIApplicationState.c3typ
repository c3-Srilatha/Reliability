/**
 * Application state for storing self-service DI related information
 */
@typeScript
type SelfServiceDIApplicationState mixes UiSdlSingletonApplicationState {

  id: ~

  /**
   * ---------------------------- STATIC DATA ----------------------------
   */

  /**
   * -------------- DATA LOAD MOUNT --------------
   */

  /**
   * Path to FileSystem.mounts['data-load']. Used when interacting with uploaded files
   * for {@link FileSourceCollection}s
   */
  dataLoadMountPath: string

  /**
   * An action to set the dataLoadMountPath in state.
   */
  @uiSdlActionCreator(actionType='SET_DATA_LOAD_MOUNT_PATH')
  setDataLoadMountPathAction: function(dataLoadMountPath: string): UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_DATA_LOAD_MOUNT_PATH` and sets dataLoadMountPath in state.
   */
  @uiSdlReducer(actionType='SET_DATA_LOAD_MOUNT_PATH')
  setDataLoadMountPathReducer: private inline function(state: !UiSdlReduxState,
                                                       action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Retrieves the dataLoadMountPath from state
   */
  getDataLoadMountPath: function(state: !UiSdlReduxState): string

  /**
   * -------------- POPULATE ROOT PKG NAME --------------
   */

  /**
   * Needed to construct a {@link Pkg.Path} will creating external types
   */
  rootPkg: string

  /**
   * Action to set the `rootPkg`
   */
  @uiSdlActionCreator(actionType='SET_ROOT_PKG')
  setRootPkgAction: function(rootPkg: string): UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_ROOT_PKG`
   */
  @uiSdlReducer(actionType='SET_ROOT_PKG')
  setRootPkgReducer: private inline function(state: !UiSdlReduxState,
                                             action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * -------------- PERSISTABLE KEYWORDS --------------
   */

  /**
   * Used to sanitize typeMetas that mix Persistable and ensure selfServiceDI generates valid {@link TypeMetas}
   */
  persistableKeywords: [string]

  /**
   * Action to set the `persistableKeywords`, The fields and methods of {@link Persistable}
   */
  @uiSdlActionCreator(actionType='SET_PERSISTABLE_KEYWORDS')
  setPersistableKeywordsAction: function(persistableKeywords: [string]): UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_PERSISTABLE_KEYWORDS`
   */
  @uiSdlReducer(actionType='SET_PERSISTABLE_KEYWORDS')
  setPersistableKeywordsReducer: private inline function(state: !UiSdlReduxState,
                                                         action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Retrieves `persistableKeywords` from state
   */
  getPersistableKeywords: function(state: !UiSdlReduxState): [string] ts-client

  /**
   * -------------- PERSISTABLE SCHEMA --------------
   */

  /**
   * The schema names corresponding to the system columns that cannot be used from {@link Persistable} and {@link Meta}
   * Used to sanitize typeMeta schemaNames and ensure selfServiceDI generates valid {@link TypeMetas}.
   */
  persistableSchemaNames: [string]

  /**
   * Action to set the `persistableSchemaNames`
   */
  @uiSdlActionCreator(actionType='SET_PERSISTABLE_SCHEMA_NAMES')
  setPersistableSchemaNamesAction: function(persistableSchemaNames: [string]): UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_PERSISTABLE_SCHEMA_NAMES` and sets `persistableSchemaNames` in state
   */
  @uiSdlReducer(actionType='SET_PERSISTABLE_SCHEMA_NAMES')
  setPersistableSchemaNamesReducer: private inline function(state: !UiSdlReduxState,
                                                            action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Retrieves `persistableSchemaNames` from state
   */
  getPersistableSchemaNames: function(state: !UiSdlReduxState): [string] ts-client

  /**
   * -------------- RESERVED TYPE NAMES --------------
   */

  /**
   * Used to validate user configured types to ensure there are no collisions with
   * the existing types declared in the current package and it's dependencies e.g. platform types.
   */
  reservedTypeNames: set<string>

  /**
   * Action to set the `reservedTypeNames`
   */
  @uiSdlActionCreator(actionType='SET_RESERVED_TYPE_NAMES')
  setReservedTypeNamesAction: function(typeNames: set<string>): UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_RESERVED_TYPE_NAMES` and sets `reservedTypeNames` in state
   */
  @uiSdlReducer(actionType='SET_RESERVED_TYPE_NAMES')
  setReservedTypeNamesReducer: private inline function(state: !UiSdlReduxState,
                                                       action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Retrieves `reservedTypeNames`, which are the type names for the entire pkg.
   */
  getReservedTypeNames: function(state: !UiSdlReduxState): set<string> ts-client

  /**
   * ---------------------------- LANDING PAGE ENTRIES ----------------------------
   */
  // -------------- SELECTED SOURCE SYSTEM CACHE ITEM --------------

  /**
   * Details about the currently selected source system cache item in the tree view.
   */
  selectedSourceSystemCacheItem: SelfServiceDISourceSystemCacheItem

  /**
   * An action to set the {@link selectedSourceSystemCacheItem}
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_SOURCE_SYSTEM_CACHE_ITEM')
  setSelectedSourceSystemCacheItemAction: function(sourceSystemCacheItem: SelfServiceDISourceSystemCacheItem)
                                            : !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SELECTED_SOURCE_SYSTEM_CACHE_ITEM` and sets {@link selectedSourceSystemCacheItem} in state.
   */
  @uiSdlReducer(actionType='SET_SELECTED_SOURCE_SYSTEM_CACHE_ITEM')
  setSelectedSourceSystemCacheItemReducer: private inline function(state: !UiSdlReduxState,
                                                                   action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Returns the {@link selectedSourceSystemCacheItem} from the state.
   */
  getSelectedSourceSystemCacheItem: function(state: !UiSdlReduxState): SelfServiceDISourceSystemCacheItem ts-client

  /**
   * Details about the currently selected source collection cache item in the tree view.
   */
  selectedSourceCollectionCacheItem: SelfServiceDISourceCollectionCacheItem

  /**
   * An action to set the {@link selectedSourceCollectionCacheItem}
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_SOURCE_COLLECTION_CACHE_ITEM')
  setSelectedSourceCollectionCacheItemAction: function(sourceCollectionCacheItem: SelfServiceDISourceCollectionCacheItem)
                                                : !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SELECTED_SOURCE_COLLECTION_CACHE_ITEM` and sets {@link selectedSourceCollectionCacheItem} in state.
   */
  @uiSdlReducer(actionType='SET_SELECTED_SOURCE_COLLECTION_CACHE_ITEM')
  setSelectedSourceCollectionCacheItemReducer: private inline function(state: !UiSdlReduxState,
                                                                       action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Returns the {@link selectedSourceCollectionCacheItem} from the state.
   */
  getSelectedSourceCollectionCacheItem: function(state: !UiSdlReduxState): SelfServiceDISourceCollectionCacheItem ts-client

  /**
   * Returns the {@link selectedSourceCollection} from the state.
   */
  getSelectedSourceCollection: function(state: !UiSdlReduxState): SourceCollection ts-client

  /**
   * The type metadata for the current selection when previewing a data source in the landing page.
   */
  selectedDataSourcePreviewTypeMeta: TypeMeta

  /**
   * An action to set the `selectedDataSourcePreviewTypeMeta`
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_DATA_SOURCE_PREVIEW_TYPE_META')
  setSelectedDataSourcePreviewTypeMetaAction: function(typeMeta: TypeMeta): !UiSdlReduxAction ts-client

  /**
   * Sets the `selectedDataSourcePreviewTypeMeta`
   */
  @uiSdlReducer(actionType='SET_SELECTED_DATA_SOURCE_PREVIEW_TYPE_META')
  setSelectedDataSourcePreviewTypeMetaReducer: private inline function(state: !UiSdlReduxState,
                                                                       action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Retrieves the `selectedDataSourcePreviewTypeMeta`
   */
  getSelectedDataSourcePreviewTypeMeta: function(state: !UiSdlReduxState): TypeMeta ts-client

  /**
   * -------------- SELECTED DATA SOURCE --------------
   */

  /**
   * The selected data source, currently used for selecting a data source to delete.
   */
  selectedDataSource: string

  /**
   * An action to set `selectedDataSource`
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_DATA_SOURCE')
  setSelectedDataSourceAction: private function(selectedDataSource: string): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SELECTED_DATA_SOURCE`
   */
  @uiSdlReducer(actionType='SET_SELECTED_DATA_SOURCE')
  setSelectedDataSourceReducer: private function(state: !UiSdlReduxState,
                                                 action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  // -------------- PREVIEW AND SELECT REMOTE SOURCE DATA --------------
  previewSourceDataErrors: [UiSdlInlineNotification]

  /**
   * An action to set the current errors that may occur when a user is previewing remote data.
   */
  @uiSdlActionCreator(actionType='SET_PREVIEW_SOURCE_DATA_ERRORS')
  setPreviewSourceDataErrorsAction: private function(errors: [UiSdlInlineNotification]): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_PREVIEW_SOURCE_DATA_ERRORS` and sets the previewSourceDataErrors in state.
   */
  @uiSdlReducer(actionType='SET_PREVIEW_SOURCE_DATA_ERRORS')
  setPreviewSourceDataErrorsReducer: private function(state: !UiSdlReduxState,
                                                      action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  // --------------  SET SELECTED INLINENOTIFICATION --------------
  // The inlineNotification selected, and passed as the args to match the {@link OpenEditDataConnectorModalEpic}
  selectedInlineNotification: Obj

  /**
   * An action set selectedInlineNotification, the object of id and the linkText
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_INLINE_NOTIFICATION_${actionSuffix}')
  setSelectedInlineNotificationAction: private function(selectedInlineNotification: Obj): !UiSdlReduxAction ts-client

  /**
   * -------------- SCHEMA TAB ERROR INLINE NOTIFICATION --------------
   */

  /**
   * Used by multiple conditional renderers to decide which error inline notification to render
   */
  schemaTabInlineNotification: UiSdlInlineNotification

  /**
   * An action to set `schemaTabInlineNotification`
   */
  @uiSdlActionCreator(actionType='SET_SCHEMA_TAB_INLINE_NOTIFICATION')
  setSchemaTabInlineNotificationAction: private function(component: UiSdlInlineNotification): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SCHEMA_TAB_INLINE_NOTIFICATION` and sets `schemaTabInlineNotification`
   */
  @uiSdlReducer(actionType='SET_SCHEMA_TAB_INLINE_NOTIFICATION')
  setSchemaTabInlineNotificationReducer: private function(state: !UiSdlReduxState,
                                                          action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * -------------- SHOULD REDIRECT TO SCHEMA TAB --------------
   */
  shouldRedirectToSchemaTab: boolean

  /**
   * An action to set `shouldRedirectToSchemaTab`. Used by the preview tab during initial render. See {@link RedirectToSchemaEditTabEpic}
   */
  @uiSdlActionCreator(actionType='SET_SHOULD_REDIRECT_TO_SCHEMA_TAB')
  setShouldRedirectToSchemaTabAction: private function(shouldRedirect: boolean): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SHOULD_REDIRECT_TO_SCHEMA_TAB` and sets `shouldRedirectToSchemaTab`
   */
  @uiSdlReducer(actionType='SET_SHOULD_REDIRECT_TO_SCHEMA_TAB')
  setShouldRedirectToSchemaTabReducer: private function(state: !UiSdlReduxState,
                                                        action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Retrieves `shouldRedirectToSchemaTab`
   */
  getShouldRedirectToSchemaTab: private function(state: !UiSdlReduxState): boolean ts-client

  /**
   * -------------- SELECTED TABLE SCHEMA CACHE ITEM --------------
   */

  /**
   * Details about the currently selected source collection's table schema cache item.
   */
  selectedTableSchemaCacheItem: SelfServiceDITableSchemaCacheItem

  /**
   * An action to set the {@link selectedTableSchemaCacheItem}
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_TABLE_SCHEMA_CACHE_ITEM')
  setSelectedTableSchemaCacheItemAction: function(tableSchemaCacheItem: SelfServiceDITableSchemaCacheItem)
                                           : !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SELECTED_TABLE_SCHEMA_CACHE_ITEM` and sets {@link selectedTableSchemaCacheItem} in state.
   */
  @uiSdlReducer(actionType='SET_SELECTED_TABLE_SCHEMA_CACHE_ITEM')
  setSelectedTableSchemaCacheItemReducer: private inline function(state: !UiSdlReduxState,
                                                                  action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Returns the {@link selectedTableSchemaCacheItem} from the state.
   */
  getSelectedTableSchemaCacheItem: function(state: !UiSdlReduxState): json ts-client

  /**
   * -------------- DELETED SOURCE FILES --------------
   */

  /**
   * The Deleted {@link SourceFile}s. Used to filter out the Target Preview Grid for {@link FileSourceCollection}
   * The keys are the sourceCollectionNames and the values are the sourceFileIds that have been deleted from them.
   */
  deletedSourceFiles: map<string, [string]>

  /**
   * An action to set `deletedSourceFiles`
   */
  @uiSdlActionCreator(actionType='SET_DELETED_SOURCE_FILES')
  setDeletedSourceFilesAction: private function(deletedSourceFiles: map<string, [string]>): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_DELETED_SOURCE_FILES` and sets `deletedSourceFiles`
   */
  @uiSdlReducer(actionType='SET_DELETED_SOURCE_FILES')
  setDeletedSourceFilesReducer: private function(state: !UiSdlReduxState,
                                                 action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * -------------- Expression Engine Functions --------------
   */

  /**
   * The expression engine functions available in an application. used for providing suggestion and validating transforms
   */
  expressionEngineFunctions: json

  /**
   * Action to fetch all the expression engine functions from the {@link TypeMeta}'s
   */
  @uiSdlActionCreator(actionType='FETCH_EXPRESSION_ENGINE_FUNCTIONS')
  fetchExpressionEngineFunctionsAction: function(): UiSdlReduxAction ts-client

  /**
   * Action to set the available expression engine functions in state
   */
  @uiSdlActionCreator(actionType='SET_EXPRESSION_ENGINE_FUNCTIONS')
  setExpressionEngineFunctionsAction: function(): UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_EXPRESSION_ENGINE_FUNCTIONS`
   */
  @uiSdlReducer(actionType='SET_EXPRESSION_ENGINE_FUNCTIONS')
  setExpressionEngineFunctionsReducer: private inline function(state: !UiSdlReduxState,
                                                               action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Returns the available `expressionEngineFunctions` from state
   */
  getExpressionEngineFunctions: function(state: !UiSdlReduxState): json ts-client

  @uiSdlEpic(actionType='FETCH_EXPRESSION_ENGINE_FUNCTIONS')
  loadExpressionEngineFunctionsEpic: private function(actionStream: !UiSdlActionsObservable,
                                                      stateStream: !UiSdlStatesObservable): !UiSdlActionsObservable ts-client

  // -------------- CLEAR APP STATE --------------

  /**
   * Clear the entire app state
   */
  @uiSdlActionCreator(actionType='CLEAR_APP_STATE')
  clearAppStateAction: private function(): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `CLEAR_APP_STATE` and clears the state.
   */
  @uiSdlReducer(actionType='CLEAR_APP_STATE')
  clearAppStateReducer: private function(state: !UiSdlReduxState,
                                         action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  // -------------- DIAGRAMS --------------

  /**
   * The current diagram ID
   */
  currentDiagramId: string

  /**
   * Sets the current diagram ID in state
   */
  @uiSdlActionCreator(actionType='SET_CURRENT_DIAGRAM_ID')
  setCurrentDiagramIdAction: private function(diagramId: string): !UiSdlReduxAction ts-client

  /**
   * Listens for action of type `SET_CURRENT_DIAGRAM_ID` and sets the diagramId in state.
   */
  @uiSdlReducer(actionType='SET_CURRENT_DIAGRAM_ID')
  setCurrentDiagramIdReducer: private function(state: !UiSdlReduxState,
                                               action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Returns the currentDiagramId from the state.
   */
  getCurrentDiagramId: function(state: !UiSdlReduxState): string ts-client

  // -------------- DATA CONNECTORS CONNECTION CONFIGURATION --------------

  /**
   * Data connector connection configuration properties and fields to render the connection form for data connectors
   * Stored as map to enable fast lookups while preserving property ordering
   */
  dataConnectorsConnectionConfiguration: map<string, json>

  /**
   * Action to set the `dataConnectorsConnectionConfiguration`
   */
  @uiSdlActionCreator(actionType='SET_DATA_CONNECTORS_CONNECTION_CONFIGURATION')
  setDataConnectorsConnectionConfigurationAction: function(dataConnectorsConnectionConfiguration: map<string, json>)
                                                    : UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_DATA_CONNECTORS_CONNECTION_CONFIGURATION`
   */
  @uiSdlReducer(actionType='SET_DATA_CONNECTORS_CONNECTION_CONFIGURATION')
  setDataConnectorsConnectionConfigurationReducer: private inline function(state: !UiSdlReduxState,
                                                                           action: !UiSdlReduxAction)
                                                                    : !UiSdlReduxState ts-client

  /**
   * Returns the data connectors configuration from the state.
   */
  getDataConnectorsConnectionConfiguration: function(state: !UiSdlReduxState): map<string, json> ts-client

  // -------------- FILE SYSTEMS MOUNTS LIST --------------

  /**
   * File Systems Mounts Options with key as (SelfServiceDI.UI.DataConnector storageKind)
   * value as array of string with corresponding mounts options
   */
  fileSystemsMountsOptions: map<string, any>

  /**
   * Action to set the `fileSystemsMountsOptions`
   */
  @uiSdlActionCreator(actionType='SET_FILE_SYSTEMS_MOUNTS_OPTIONS')
  setFileSystemsMountsOptionsAction: function(fileSystemsMountsOptions: map<string, any>): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_FILE_SYSTEMS_MOUNTS_OPTIONS`
   */
  @uiSdlReducer(actionType='SET_FILE_SYSTEMS_MOUNTS_OPTIONS')
  setFileSystemsMountsOptionsReducer: private function(state: !UiSdlReduxState,
                                                       action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Returns fileSystemsMountsOptions from state.
   */
  getFileSystemsMountsOptions: function(state: !UiSdlReduxState): map<string, any> ts-client

  // -------------- Store Data Connector Config form data in application state --------------

  /**
   * Properties stored with values for Data Connector Config form
   */
  dataConnectorConfigFormData: map<string, any>

  /**
   * Action to set the `dataConnectorConfigFormData`
   */
  @uiSdlActionCreator(actionType='SET_DATA_CONNECTOR_FORM_DATA')
  setDataConnectorFormDataAction: function(dataConnectorConfigFormData: map<string, any>): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_DATA_CONNECTOR_FORM_DATA`
   */
  @uiSdlReducer(actionType='SET_DATA_CONNECTOR_FORM_DATA')
  setDataConnectorFormDataReducer: private function(state: !UiSdlReduxState,
                                                    action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Returns dataConnectorConfigFormData from state.
   */
  getDataConnectorFormData: function(state: !UiSdlReduxState): map<string, any> ts-client
}
