/**
 * Application state specifically related to the Data Sources cache in the Self Service DI application. This cache is
 * used when rendering the tree list of data sources based on the {@link SourceSystem}s and
 * {@link SourceCollection}s configured for the application.
 */
@typeScript
type SelfServiceDIDataSourcesCacheApplicationState mixes UiSdlSingletonApplicationState {

  id: ~

  // -------------- SOURCE SYSTEMS CACHE --------------

  /**
   * A map of {@link SourceSystem#name} to cached information about the source system for quick lookup in the UI.
   */
  sourceSystemsCache: map<string, SelfServiceDISourceSystemCacheItem>

  /**
   * An action to trigger loading of all {@link SourceSystem}s.
   *
   * @returns a `LOAD_ALL_SOURCE_SYSTEMS` action
   */
  @uiSdlActionCreator(actionType='LOAD_ALL_SOURCE_SYSTEMS')
  loadAllSourceSystemsAction: function(): !UiSdlReduxAction ts-client

  /**
   * An action to trigger when all {@link SourceSystem}s have been loaded.
   *
   * @returns a `ALL_SOURCE_SYSTEMS_LOADED` action
   */
  @uiSdlActionCreator(actionType='ALL_SOURCE_SYSTEMS_LOADED')
  allSourceSystemsLoadedAction: function(): !UiSdlReduxAction ts-client

  /**
   * A generic action to update the {@link sourceSystemsCache} at a specific path.
   *
   * @param path
   *           An array-ified path to the position in the cache to update. An empty array will update at the top level
   *           of {@link sourceSystemsCache}.
   * @param dataToCache
   *           The data to modify in the cache at the provided path.
   *
   * @returns a `UPDATE_SOURCE_SYSTEMS_CACHE` action
   */
  @uiSdlActionCreator(actionType='UPDATE_SOURCE_SYSTEMS_CACHE')
  updateSourceSystemsCacheAction: function(path: [string], dataToCache: json): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `UPDATE_SOURCE_SYSTEMS_CACHE` and updates the {@link sourceSystemsCache} at the
   * provided path.
   */
  @uiSdlReducer(actionType='UPDATE_SOURCE_SYSTEMS_CACHE')
  updateSourceSystemsCacheReducer: private inline function(state: !UiSdlReduxState,
                                                           action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Retrieve all {@link SourceSystem}s from `sourceSystemsCache`
   */
  getAllSourceSystems: function(state: !UiSdlReduxState): [SourceSystem]

  /**
   * Retrieve a {@link SelfServiceDISourceSystemCacheItem} from `sourceSystemsCache`
   */
  getSourceSystemCacheItem: function(state: !UiSdlReduxState,
                                     sourceSystemName: string): SelfServiceDISourceSystemCacheItem

  /**
   * Retrieve a {@link SourceSystem} from `sourceSystemsCache`
   */
  getSourceSystemDetails: function(state: !UiSdlReduxState, sourceSystemName: string): SourceSystem

  /**
   * Retrieve a {@link SelfServiceDISourceSystemCacheItem#sourceSystemConfig} from `sourceSystemsCache`
   */
  getSourceSystemConfig: function(state: !UiSdlReduxState, sourceSystemName: string): JdbcStoreConfig

  /**
   * Retrieve the storage kind of a {@link SelfServiceDISourceSystemCacheItem} from `sourceSystemsCache`
   */
  getSourceSystemStorageKind: function(state: !UiSdlReduxState, sourceSystemName: string): string

  // -------------- SOURCE COLLECTIONS CACHE --------------

  /**
   * A map of {@link SourceCollection#name} to cached information about the source collection for quick lookup in the UI.
   */
  sourceCollectionsCache: map<string, SelfServiceDISourceCollectionCacheItem>

  /**
   * An action to trigger loading of all {@link SourceCollection}s.
   *
   * @returns a `LOAD_ALL_SOURCE_COLLECTIONS` action
   */
  @uiSdlActionCreator(actionType='LOAD_ALL_SOURCE_COLLECTIONS')
  loadAllSourceCollectionsAction: function(): !UiSdlReduxAction ts-client

  /**
   * An action to trigger when all {@link SourceCollection}s have been loaded.
   *
   * @returns a `ALL_SOURCE_COLLECTIONS_LOADED` action
   */
  @uiSdlActionCreator(actionType='ALL_SOURCE_COLLECTIONS_LOADED')
  allSourceCollectionsLoadedAction: function(): !UiSdlReduxAction ts-client

  /**
   * An action to trigger loading of {@link SourceCollection}s only for specific {@link SourceSystem}s.
   *
   * @returns a `REFRESH_SOURCE_COLLECTIONS_FOR_SOURCE_SYSTEMS` action
   */
  @uiSdlActionCreator(actionType='REFRESH_SOURCE_COLLECTIONS_FOR_SOURCE_SYSTEMS')
  refreshSourceCollectionsForSourceSystemsAction: function(sourceSystemNames: [string]): !UiSdlReduxAction ts-client

  /**
   * A generic action to update the {@link sourceCollectionsCache} at a specific path.
   *
   * @param path
   *           An array-ified path to the position in the cache to update. An empty array will update at the top level
   *           of {@link sourceCollectionsCache}.
   * @param dataToCache
   *           The data to modify in the cache at the provided path.
   *
   * @returns a `UPDATE_SOURCE_COLLECTIONS_CACHE` action
   */
  @uiSdlActionCreator(actionType='UPDATE_SOURCE_COLLECTIONS_CACHE')
  updateSourceCollectionsCacheAction: function(path: [string], dataToCache: json): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `UPDATE_SOURCE_COLLECTIONS_CACHE` and updates the {@link sourceSystemsCache} at the
   * provided path.
   */
  @uiSdlReducer(actionType='UPDATE_SOURCE_COLLECTIONS_CACHE')
  updateSourceCollectionsCacheReducer: private inline function(state: !UiSdlReduxState,
                                                               action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * An action to remove the {@link SelfServiceDISourceCollectionCacheItem} from {@link #sourceCollectionsCache}.
   *
   * @param sourceCollectionName
   *           Name of the {@link SourceCollection} to be removed.
   *
   * @returns a `REMOVE_SOURCE_COLLECTION_CACHE_ITEM` action
   */
  @uiSdlActionCreator(actionType='REMOVE_SOURCE_COLLECTION_CACHE_ITEM')
  removeSourceCollectionCacheItemAction: function(sourceCollectionName: !string): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `REMOVE_SOURCE_COLLECTION_CACHE_ITEM` and removes the {@link SelfServiceDISourceCollectionCacheItem}
   * from {@link #sourceCollectionsCache}.
   */
  @uiSdlReducer(actionType='REMOVE_SOURCE_COLLECTION_CACHE_ITEM')
  removeSourceCollectionCacheItemReducer: function(state: !UiSdlReduxState,
                                                   action: !UiSdlReduxAction): !UiSdlReduxAction ts-client

  /**
   * Returns a map of {@link SelfServiceDISourceCollectionCacheItem} keyed by name
   */
  getSourceCollectionsCache: function(state: !UiSdlReduxState): map<string, SelfServiceDISourceCollectionCacheItem>

  /**
   * Retrieve all {@link SourceCollection}s from `sourceCollectionsCache`
   */
  getAllSourceCollections: function(state: !UiSdlReduxState): [SourceCollection]

  /**
   * Retrieve a {@link SourceCollection} from `sourceCollectionsCache`
   */
  getSourceCollectionDetails: function(state: !UiSdlReduxState, sourceCollectionName: string): SourceCollection

  /**
   * Retrieve a {@link SelfServiceDISourceCollectionCacheItem} from `sourceCollectionsCache`
   */
  getSourceCollectionCacheItem: function(state: !UiSdlReduxState,
                                         sourceCollectionName: string): SelfServiceDISourceCollectionCacheItem

  /**
   * Retrieve a list of {@link SourceCollection}s from a {@link SourceSystem} in `sourceCollectionsCache`
   */
  getSourceCollectionsForSourceSystem: function(state: !UiSdlReduxState, sourceSystemName: string): [SourceCollection]

  /**
   * Retrieve a list of {@link SourceCollection}s from a sourceName in `sourceCollectionsCache`
   */
  getSelectedSourceCollectionsFromSourceName: function(state: !UiSdlReduxState,
                                                       sourceName: string): [SourceCollection]

  // -------------- SOURCE SYSTEM CONFIGURATION CACHE --------------

  /**
   * An action to trigger loading of all {@link SourceSystem} configurations.
   *
   * @returns a `LOAD_ALL_SOURCE_SYSTEM_CONFIGS` action
   */
  @uiSdlActionCreator(actionType='LOAD_ALL_SOURCE_SYSTEM_CONFIGS')
  loadAllSourceSystemConfigsAction: function(): !UiSdlReduxAction ts-client

  /**
   * An action to trigger loading of a specific {@link SourceSystem} configuration.
   *
   * @returns a `LOAD_SOURCE_SYSTEM_CONFIG` action
   */
  @uiSdlActionCreator(actionType='LOAD_SOURCE_SYSTEM_CONFIG')
  loadSourceSystemConfigAction: function(sourceSystem: mixing SelfServiceDIDataSourcesCacheApplicationState)
                                  : !UiSdlReduxAction ts-client

  /**
   * An action to update the {@link sourceSystemsCache} at the `{sourceSystemName}.sourceSystemConfig` path for a
   * specific source system.
   *
   * @param sourceSystemName
   *           The source system to update
   * @param configData
   *           The data to modify in the cache for the provided source system.
   *
   * @returns a `CACHE_SOURCE_SYSTEM_CONFIG` action
   */
  @uiSdlActionCreator(actionType='CACHE_SOURCE_SYSTEM_CONFIG')
  cacheSourceSystemConfigAction: function(sourceSystemName: string, configData: json): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `CACHE_SOURCE_SYSTEM_CONFIG` and updates the {@link sourceSystemsCache} at the
   * provided path.
   */
  @uiSdlReducer(actionType='CACHE_SOURCE_SYSTEM_CONFIG')
  cacheSourceSystemConfigReducer: private inline function(state: !UiSdlReduxState,
                                                          action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  // -------------- SOURCE SYSTEM PING RESULT --------------

  /**
   * An action to ping a {@link SourceSystem} and set the {@link PingResult} in the {@link sourceSystemsCache}.
   *
   * @returns a `REFRESH_SOURCE_SYSTEM_PING_RESULT` action
   */
  @uiSdlActionCreator(actionType='REFRESH_SOURCE_SYSTEM_PING_RESULT')
  refreshSourceSystemPingResultAction: function(sourceSystem: mixing SelfServiceDIDataSourcesCacheApplicationState)
                                         : !UiSdlReduxAction ts-client

  /**
   * An action to update the {@link sourceSystemsCache} at the `{sourceSystemName}.pingResult` path for a specific
   * source system.
   *
   * @param sourceSystemName
   *           The source system to update
   * @param pingResult
   *           The data to modify in the cache for the provided source system.
   *
   * @returns a `CACHE_SOURCE_SYSTEM_PING_RESULT` action
   */
  @uiSdlActionCreator(actionType='CACHE_SOURCE_SYSTEM_PING_RESULT')
  cacheSourceSystemPingResultAction: function(sourceSystemName: string,
                                              pingResult: PingResult): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `CACHE_SOURCE_SYSTEM_PING_RESULT` and updates the {@link sourceSystemsCache} at the
   * provided path.
   */
  @uiSdlReducer(actionType='CACHE_SOURCE_SYSTEM_PING_RESULT')
  cacheSourceSystemPingResultReducer: private inline function(state: !UiSdlReduxState,
                                                              action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  // -------------- LOADING STATE --------------

  /**
   * The loading state of different parts of the Data Sources cache.
   */
  loadingState: SelfServiceDIDataSourcesCacheLoadingState

  /**
   * A generic action to update the {@link loadingState} at a specific path.
   *
   * @param path
   *           An array-ified path to the position in the cache to update. An empty array will update at the top level
   *           of {@link loadingState}.
   * @param dataToCache
   *           The data to modify in the cache at the provided path.
   *
   * @returns a `DATA_SOURCES_CACHE_LOADING_CHANGE` action
   */
  @uiSdlActionCreator(actionType='DATA_SOURCES_CACHE_LOADING_CHANGE')
  dataSourcesCacheLoadingChangeAction: function(path: [string], loading: boolean): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `DATA_SOURCES_CACHE_LOADING_CHANGE` and updates the {@link loadingState} at the
   * provided path.
   */
  @uiSdlReducer(actionType='DATA_SOURCES_CACHE_LOADING_CHANGE')
  dataSourcesCacheLoadingChangeReducer: private inline function(state: !UiSdlReduxState,
                                                                action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * An action to update the {@link sourceSystemsCache} at the `{sourceSystemName}.configLoading` path for a specific
   * source system.
   *
   * @param sourceSystemName
   *           The source system to update
   * @param loading
   *           Whether the source system is loading.
   *
   * @returns a `SET_SOURCE_SYSTEM_CONFIG_LOADING` action
   */
  @uiSdlActionCreator(actionType='SET_SOURCE_SYSTEM_CONFIG_LOADING')
  setSourceSystemConfigLoadingAction: function(sourceSystemName: string,
                                               loading: boolean): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SOURCE_SYSTEM_CONFIG_LOADING` and updates the {@link sourceSystemsCache} at the
   * provided path.
   */
  @uiSdlReducer(actionType='SET_SOURCE_SYSTEM_CONFIG_LOADING')
  setSourceSystemConfigLoadingReducer: private inline function(state: !UiSdlReduxState,
                                                               action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * An action to update the {@link sourceSystemsCache} at the `{sourceSystemName}.pingLoading` path for a specific
   * source system.
   *
   * @param sourceSystemName
   *           The source system to update
   * @param loading
   *           Whether the source system is loading.
   *
   * @returns a `SET_SOURCE_SYSTEM_PING_LOADING` action
   */
  @uiSdlActionCreator(actionType='SET_SOURCE_SYSTEM_PING_LOADING')
  setSourceSystemPingLoadingAction: function(sourceSystemName: string, loading: boolean): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SOURCE_SYSTEM_PING_LOADING` and updates the {@link sourceSystemsCache} at the
   * provided path.
   */
  @uiSdlReducer(actionType='SET_SOURCE_SYSTEM_PING_LOADING')
  setSourceSystemPingLoadingReducer: private inline function(state: !UiSdlReduxState,
                                                             action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * An action to update the {@link sourceSystemsCache} at the `{sourceSystemName}.sourceCollectionsLoading` path for
   * a specific source system.
   *
   * @param sourceSystemName
   *           The source system to update
   * @param loading
   *           Whether the source collections are loading for a specific source system.
   *
   * @returns a `SET_SOURCE_SYSTEM_SOURCE_COLLECTIONS_LOADING` action
   */
  @uiSdlActionCreator(actionType='SET_SOURCE_SYSTEM_SOURCE_COLLECTIONS_LOADING')
  setSourceSystemSourceCollectionsLoadingAction: function(sourceSystemName: string,
                                                          loading: boolean): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SOURCE_SYSTEM_SOURCE_COLLECTIONS_LOADING` and updates the
   * {@link sourceSystemsCache} at the `{sourceSystemName}.sourceCollectionsLoading` path.
   */
  @uiSdlReducer(actionType='SET_SOURCE_SYSTEM_SOURCE_COLLECTIONS_LOADING')
  setSourceSystemSourceCollectionsLoadingReducer: private inline function(state: !UiSdlReduxState,
                                                                          action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  // -------------- SOURCE COLLECTION TABLE SCHEMA CACHE --------------

  /**
   * Stores a map of sourceCollectionName to its table schema information
   */
  tableSchemaCache: map<string, SelfServiceDITableSchemaCacheItem>

  /**
   * An action to trigger loading of all table schemas
   *
   * @returns a `REFRESH_ALL_SQL_TABLE_SCHEMA` action
   */
  @uiSdlActionCreator(actionType='REFRESH_TABLE_SCHEMA_FOR_SOURCE_COLLECTIONS')
  refreshTableSchemaForSourceCollectionsAction: function(sourceCollections: [string]): !UiSdlReduxAction ts-client

  /**
   * A generic action to update the {@link tableSchemaCache} at a specific path.
   *
   * @param path
   *           An array-ified path to the position in the cache to update. An empty array will update at the top level
   *           of {@link tableSchemaCache}.
   * @param dataToCache
   *           The data to modify in the cache at the provided path.
   *
   * @returns a `UPDATE_TABLE_SCHEMA_CACHE` action
   */
  @uiSdlActionCreator(actionType='UPDATE_TABLE_SCHEMA_CACHE')
  updateTableSchemaCacheAction: function(path: [string], dataToCache: json): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `UPDATE_TABLE_SCHEMA_CACHE` and updates the {@link tableSchemaCache} at the
   * provided path.
   */
  @uiSdlReducer(actionType='UPDATE_TABLE_SCHEMA_CACHE')
  updateTableSchemaCacheReducer: private inline function(state: !UiSdlReduxState,
                                                         action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * A generic action to update the {@link tableSchemaCache} at multiple specific paths.
   *
   * @param pathsToCache
   *           An array of objects, each containing a path and dataToCache. Each path is an array-ified path to the
   *           position in the cache to update. An empty array will update at the top level of {@link tableSchemaCache}.
   *           Each dataToCache is the data to modify in the cache at the provided path.
   *
   * @returns a `UPDATE_TABLE_SCHEMAS_CACHE` action
   */
  @uiSdlActionCreator(actionType='UPDATE_TABLE_SCHEMAS_CACHE')
  updateTableSchemasCacheAction: function(pathsToCache: [{ path: [string], dataToCache: json }]): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `UPDATE_TABLE_SCHEMAS_CACHE` and updates the {@link tableSchemaCache} at the
   * provided paths. For each path in pathsToCache, if dataToCache is undefined, the entry is removed; otherwise,
   * it is set to the provided dataToCache value.
   */
  @uiSdlReducer(actionType='UPDATE_TABLE_SCHEMAS_CACHE')
  updateTableSchemasCacheReducer: private inline function(state: !UiSdlReduxState,
                                                          action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Retrieve the data from the `tableSchemaCache` with the specified path.
   */
  getTableSchemaCacheItem: function(state: !UiSdlReduxAction, path: [string]): json ts-client

  /**
   * A generic action to directly set the {@link tableSchemaCache}.
   *
   * @param tableSchema
   *           The data to set `tableSchemaCache`
   *
   * @returns a `SET_TABLE_SCHEMA_CACHE` action
   */
  @uiSdlActionCreator(actionType='SET_TABLE_SCHEMA_CACHE')
  setTableSchemaCacheAction: function(tableSchema: json): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_TABLE_SCHEMA_CACHE` and sets the {@link tableSchemaCache}
   */
  @uiSdlReducer(actionType='SET_TABLE_SCHEMA_CACHE')
  setTableSchemaCacheReducer: private inline function(state: !UiSdlReduxState,
                                                      action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Retrieve `tableSchemaCache`
   */
  getTableSchemaCache: function(state: !UiSdlReduxAction): json ts-client

  /**
   * Indicates that tableSchemaCache has been fetched and stored
   */
  tableSchemaCacheFetched: boolean

  /**
   * Action to set the `tableSchemaCacheFetched` flag
   */
  @uiSdlActionCreator(actionType='SET_TABLE_SCHEMA_CACHE_FETCHED')
  setTableSchemaCacheFetchedAction: function(fetched: boolean): !UiSdlReduxAction ts-client

  /**
   * Reducer to store `tableSchemaCacheFetched`
   */
  @uiSdlReducer(actionType='SET_TABLE_SCHEMA_CACHE_FETCHED')
  setTableSchemaCacheFetchedReducer: private inline function(state: !UiSdlReduxState,
                                                             action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Getter for `tableSchemaCacheFetched`
   */
  getTableSchemaCacheFetched: function(state: !UiSdlReduxState): boolean ts-client

  /**
   * An action to trigger loading of all {@link Persistable} types for all the
   * valid sources in the state. The valid sources are all the sources linked
   * to the {@link FileSourceCollection}s in state.
   *
   * @returns a `LOAD_ALL_TARGET_AND_TRANSFORMS` action
   */
  @uiSdlActionCreator(actionType='LOAD_ALL_TARGET_AND_TRANSFORMS')
  loadAllTargetAndTransformsAction: function(): !UiSdlReduxAction ts-client

  /**
   * Returns the {@link TypeMeta} for the source or target depending on the type of
   * {@link SourceCollection} and it's validity.
   * The {@link TypeMeta} is used to generate the preview grid.
   *
   * @param state
   *         The state from which the typeMeta is retrieved.
   * @param sourceCollectionCacheItem
   *         The sourceCollection cache item to return the typeMeta for.
   * @returns TypeMeta
   */
  getPreviewTypeMeta: function(state: !UiSdlReduxState,
                               sourceCollectionCacheItem: SelfServiceDISourceCollectionCacheItem): TypeMeta ts-client

  /**
   * Returns the {@link SelfServiceDITableSchemaCacheItem} for the source or target depending on the type of
   * {@link SourceCollection} and it's validity.
   * The {@link SelfServiceDITableSchemaCacheItem} is used to generate the schema preview tab.
   *
   * @param state
   *         The state from which the tableSchemaCacheItem is retrieved.
   * @param sourceCollectionCacheItem
   *         The sourceCollection cache item to return the tableSchemaCacheItem for.
   * @returns SelfServiceDITableSchemaCacheItem
   */
  getSchemaTypeMeta: function(state: !UiSdlReduxState,
                              sourceCollectionCacheItem: SelfServiceDISourceCollectionCacheItem)
                       : SelfServiceDITableSchemaCacheItem ts-client

  // -------------- RETRIEVE SOURCE COLLECTION INFO --------------

  /**
   * An action to trigger loading of all {@link SourceCollection}s' additional information.
   *
   * @returns a `LOAD_ALL_SOURCE_COLLECTION_INFO` action
   */
  @uiSdlActionCreator(actionType='LOAD_ALL_SOURCE_COLLECTION_INFO')
  loadAllSourceCollectionInfoAction: function(): !UiSdlReduxAction ts-client

  /**
   * An action to trigger loading of all {@link FileSourceCollection}s' additional information.
   *
   * @returns a `LOAD_FILE_SOURCE_COLLECTION_INFO` action
   */
  @uiSdlActionCreator(actionType='LOAD_FILE_SOURCE_COLLECTION_INFO')
  loadFileSourceCollectionInfoAction: function(): !UiSdlReduxAction ts-client

  /**
   * An action to trigger refresh of a list {@link SourceCollection}s status based on a {@link SourceSystem}
   *
   * @returns a `REFRESH_SOURCE_COLLECTION_STATUSES_FOR_SOURCE_SYSTEM` action
   */
  @uiSdlActionCreator(actionType='REFRESH_SOURCE_COLLECTION_STATUSES_FOR_SOURCE_SYSTEM')
  refreshSourceCollectionStatusesForSourceSystemAction: function(sourceSystemName: string): !UiSdlReduxAction ts-client

  /**
   * An action to trigger refresh of a {@link SourceCollection}'s status
   *
   * @returns a `REFRESH_SOURCE_COLLECTION_STATUS` action
   */
  @uiSdlActionCreator(actionType='REFRESH_SOURCE_COLLECTION_STATUS')
  refreshSourceCollectionStatusAction: function(sourceCollection: SourceCollection): !UiSdlReduxAction ts-client

  /**
   * An action to trigger refresh of a {@link FileSourceCollection}'s status
   *
   * @returns a `REFRESH_FILE_SOURCE_COLLECTION_STATUS` action
   */
  @uiSdlActionCreator(actionType='REFRESH_FILE_SOURCE_COLLECTION_STATUS')
  refreshFileSourceCollectionStatusAction: function(sourceCollection: SourceCollection): !UiSdlReduxAction ts-client

  /**
   * -------------- SOURCE FILES CACHE --------------
   */

  /**
   * A map of {@link SourceFile} ids to {@link SelfServiceDISourceFileCacheItem}
   */
  soureFilesCache: map<string, SelfServiceDISourceFileCacheItem>

  /**
   * A generic action to update the {@link soureFilesCache} at a specific path.
   *
   * @param path
   *           An array-ified path to the position in the cache to update. An empty array will update at the top level
   *           of {@link soureFilesCache}.
   * @param dataToCache
   *           The data to modify in the cache at the provided path.
   *
   * @returns a `UPDATE_SOURCE_FILES_CACHE` action
   */
  @uiSdlActionCreator(actionType='UPDATE_SOURCE_FILES_CACHE')
  updateSourceFilesCacheAction: function(path: [string], dataToCache: json): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `UPDATE_SOURCE_FILES_CACHE` and updates the {@link soureFilesCache} at the
   * provided path.
   */
  @uiSdlReducer(actionType='UPDATE_SOURCE_FILES_CACHE')
  updateSourceFilesCacheReducer: private inline function(state: !UiSdlReduxState,
                                                         action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  // -------------- FILE UPLOAD FIRST LOAD MAP --------------

  /**
   * A map of source collection names to whether it is the first time loading this source collection
   * This is used in {@link RefreshFileUploadSourceCollectionStatusEpic} to determine
   * whether someone aborted file upload by refreshing the page.
   */
  fileUploadFirstLoadMap: map<string, boolean>

  /**
   *  Action to update the {@link fileUploadFirstLoadMap}
   *
   * @param sourceCollectionName
   *           source collection to be updated
   * @param state
   *           Whether it is the first load of a source collection
   *
   * @returns a `UPDATE_FILE_UPLOAD_FIRST_LOAD_MAP` action
   */
  @uiSdlActionCreator(actionType='UPDATE_FILE_UPLOAD_FIRST_LOAD_MAP')
  updateFileUploadFirstLoadMapAction: function(sourceCollectionName: string,
                                               state: boolean): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `UPDATE_FILE_UPLOAD_FIRST_LOAD_MAP` and updates `fileUploadFirstLoadMap`
   */
  @uiSdlReducer(actionType='UPDATE_FILE_UPLOAD_FIRST_LOAD_MAP')
  updateFileUploadFirstLoadMapReducer: private inline function(state: !UiSdlReduxState,
                                                               action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Retrieve whether a source collection is on its first load from `fileUploadFirstLoadMap`
   */
  getFileUploadFirstLoadState: function(state: !UiSdlReduxState, sourceCollectionName: string): string ts-client

  // -------------- SET ALL TRANSFORMATIONS --------------
  // The transform cache which is a mapping its transform name and transform
  transformCache: map<string, Transform>

  /**
   * An action to set the transformCache in state
   */
  @uiSdlActionCreator(actionType='SET_TRANSFORM_CACHE')
  setTransformCacheAction: function(transformCache: map<string, Transform>): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_TRANSFORM_CACHE` and updates transform in state
   */
  @uiSdlReducer(actionType='SET_TRANSFORM_CACHE')
  setTransformCacheReducer: private inline function(state: !UiSdlReduxState,
                                                    action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Indicates that Transform cache has been fetched and stored
   */
  transformCacheFetched: boolean

  /**
   * Action to set the `transformCacheFetched` flag
   */
  @uiSdlActionCreator(actionType='SET_TRANSFORM_CACHE_FETCHED')
  setTransformCacheFetchedAction: function(fetched: boolean): !UiSdlReduxAction ts-client

  /**
   * Reducer to store `transformCacheFetched`
   */
  @uiSdlReducer(actionType='SET_TRANSFORM_CACHE_FETCHED')
  setTransformCacheFetchedReducer: private inline function(state: !UiSdlReduxState,
                                                           action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Getter for `transformCacheFetched`
   */
  getTransformCacheFetched: function(state: !UiSdlReduxState): boolean ts-client

  // -------------- FILES PROPERTIES --------------

  /**
   * A map of {@link SourceCollection#name} to cached information about the files properties for quick lookup in the UI.
   */
  filesProperties: map<string, json>

  /**
   * A generic action to update the {@link filesProperties} at a specific path.
   *
   * @param path
   *           An array-ified path to the position in the cache to update. An empty array will update at the top level
   *           of filesProperties.
   * @param dataToCache
   *           The data to modify in the cache at the provided path.
   *
   * @returns a `UPDATE_FILES_PROPERTIES` action
   */
  @uiSdlActionCreator(actionType='UPDATE_FILES_PROPERTIES')
  updateFilesPropertiesAction: function(path: [string], dataToCache: json): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `UPDATE_FILES_PROPERTIES` and updates the filesProperties at the
   * provided path.
   */
  @uiSdlReducer(actionType='UPDATE_FILES_PROPERTIES')
  updateFilesPropertiesReducer: private inline function(state: !UiSdlReduxState,
                                                        action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * An action to remove the filesProperties.
   *
   * @param file
   *           object of the file to be removed.
   *
   * @returns a `REMOVE_FILES_PROPERTIES` action
   */
  @uiSdlActionCreator(actionType='REMOVE_FILES_PROPERTIES')
  removeFilesPropertiesAction: function(file: json): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `REMOVE_FILES_PROPERTIES` and removes the filesProperties
   */
  @uiSdlReducer(actionType='REMOVE_FILES_PROPERTIES')
  removeFilesPropertiesReducer: function(state: !UiSdlReduxState,
                                         action: !UiSdlReduxAction): !UiSdlReduxAction ts-client

  // The childSourceCollections of the selected sourceSystem
  childSourceCollections: [SelfServiceDISourceCollectionCacheItem]

  /**
   * An action to set the childSourceCollections in state
   */
  @uiSdlActionCreator(actionType='SET_CHILD_SOURCE_COLLECTIONS')
  setChildSourceCollectionsAction: function(childSourceCollections: [SelfServiceDISourceCollectionCacheItem])
                                     : !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_CHILD_SOURCE_COLLECTIONS` and updates childSourceCollections in state
   */
  @uiSdlReducer(actionType='SET_CHILD_SOURCE_COLLECTIONS')
  setChildSourceCollectionsReducer: private inline function(state: !UiSdlReduxState,
                                                            action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  // -------------- CLEAR APP STATE --------------

  /**
   * Clear the entire app state
   */
  @uiSdlActionCreator(actionType='CLEAR_APP_STATE')
  clearAppStateAction: private function(): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `CLEAR_APP_STATE` and clears the state.
   */
  @uiSdlReducer(actionType='CLEAR_APP_STATE')
  clearAppStateReducer: private function(state: !UiSdlReduxState,
                                         action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  // -------------- VECTOR STORES --------------
  // The vector store cache which is a mapping its id and vector store
  vectorStoreCache: map<string, any>

  /**
   * An action to set the vectorStoreCache in state
   */
  @uiSdlActionCreator(actionType='SET_VECTOR_STORE_CACHE')
  setVectorStoreCacheAction: function(vectorStoreCache: map<string, any>): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_VECTOR_STORE_CACHE` and updates vectorStoreCache in state
   */
  @uiSdlReducer(actionType='SET_VECTOR_STORE_CACHE')
  setVectorStoreCacheReducer: private inline function(state: !UiSdlReduxState,
                                                      action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * An action to trigger loading of all {@link GenaiCore.VectorStore}s
   *
   * @returns a `LOAD_ALL_VECTOR_STORES` action
   */
  @uiSdlActionCreator(actionType='LOAD_ALL_VECTOR_STORES')
  loadAllVectorStoresAction: function(): !UiSdlReduxAction ts-client

  // -------------- UNSTRUCTURED PIPELINES --------------
  // The unstructured pipeline cache which is a mapping of its id and unstructured pipeline
  unstructuredPipelineCache: map<string, any>

  /**
   * An action to set the unstructuredPipelineCache in state
   */
  @uiSdlActionCreator(actionType='SET_UNSTRUCTURED_PIPELINE_CACHE')
  setUnstructuredPipelineCacheAction: function(unstructuredPipelineCache: map<string, any>): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_UNSTRUCTURED_PIPELINE_CACHE` and updates unstructuredPipelineCache in state
   */
  @uiSdlReducer(actionType='SET_UNSTRUCTURED_PIPELINE_CACHE')
  setUnstructuredPipelineCacheReducer: private inline function(state: !UiSdlReduxState,
                                                               action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Retrieve the unstructured pipeline cache
   */
  getUnstructuredPipelineCache: function(state: !UiSdlReduxState): json ts-client

  // -------------- UNSTRUCTURED PROCESSORS --------------
  // The unstructured processor cache which is a mapping of its id and unstructured processor
  unstructuredProcessorCache: map<string, any>

  /**
   * An action to set the unstructuredProcessorCache in state
   */
  @uiSdlActionCreator(actionType='SET_UNSTRUCTURED_PROCESSOR_CACHE')
  setUnstructuredProcessorCacheAction: function(unstructuredProcessorCache: map<string, any>): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_UNSTRUCTURED_PROCESSOR_CACHE` and updates unstructuredProcessorCache in state
   */
  @uiSdlReducer(actionType='SET_UNSTRUCTURED_PROCESSOR_CACHE')
  setUnstructuredProcessorCacheReducer: private inline function(state: !UiSdlReduxState,
                                                                action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Retrieve the unstructured processor cache
   */
  getUnstructuredProcessorCache: function(state: !UiSdlReduxState): json ts-client

  // -------------- EMBEDDER --------------
  // The vector store cache which is a mapping its name and vector store
  embedderCache: map<string, any>

  /**
   * An action to set the embedderCache in state
   */
  @uiSdlActionCreator(actionType='SET_EMBEDDER_CACHE')
  setEmbedderCacheAction: function(embedderCache: map<string, any>): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_EMBEDDER_CACHE` and updates embedderCache in state
   */
  @uiSdlReducer(actionType='SET_EMBEDDER_CACHE')
  setEmbedderCacheReducer: private inline function(state: !UiSdlReduxState,
                                                   action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * An action to trigger loading of all {@link any}s
   *
   * @returns a `LOAD_ALL_EMBEDDERS` action
   */
  @uiSdlActionCreator(actionType='LOAD_ALL_EMBEDDERS')
  loadAllEmbeddersAction: function(): !UiSdlReduxAction ts-client
}
