/**
 * A typed structure representing various potential loading states of the
 * {@link SelfServiceDIDataSourcesCacheApplicationState}. This may be used by the UI to show loading indicators or
 * hide page elements.
 */
type SelfServiceDIDataSourcesCacheLoadingState {

  /**
   * Whether the cache is currently loading _all_ {@link SourceSystem}s.
   */
  allSourceSystems: boolean

  /**
   * Whether the cache is currently loading _all_ {@link SourceCollection}s.
   */
  allSourceCollections: boolean
}
