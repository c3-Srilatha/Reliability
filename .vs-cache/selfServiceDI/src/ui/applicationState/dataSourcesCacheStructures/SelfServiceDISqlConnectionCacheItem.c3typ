/**
 * Cached information about a {@link SourceSystem} for quick lookup for use in the UI.
 */
type SelfServiceDISqlConnectionCacheItem {

  /**
   * Whether the initial fetch for table names is in progress
   */
  tableNamesLoading: boolean

  /**
   * A map of schema names to the table names in that schema.
   */
  tableNamesBySchema: map<string, [string]>
}
