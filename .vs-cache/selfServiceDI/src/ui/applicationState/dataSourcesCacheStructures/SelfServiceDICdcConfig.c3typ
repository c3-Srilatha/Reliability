/**
 * CDC configuration extracted for a SqlSourceCollection.
 */
type SelfServiceDICdcConfig {

  /**
   * Whether CDC (Change Data Capture) is enabled for the SqlSourceCollection.
   */
  enabled: boolean

  /**
   * The column used for tracking changes in CDC.
   * Only present when CDC is enabled.
   */
  trackingColumn: string

  /**
   * The schedule for CDC cron job.
   * Only present when CDC is enabled.
   */
  schedule: string
}
