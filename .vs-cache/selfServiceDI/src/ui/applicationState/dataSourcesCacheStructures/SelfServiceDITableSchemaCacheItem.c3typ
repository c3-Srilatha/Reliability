/**
 * Stores the result from {@link SourceSystemManager#sourceSystemRemoteAndLocalCollectionsInfosByName}
 * and {@link #schemaTypeMeta} transformed from the result.
 */
type SelfServiceDITableSchemaCacheItem mixes SourceCollectionUi {

  /**
   * Data used for the schema preview tab
   */
  schemaTypeMeta: DataFusionUiTypeMeta

  /**
   * Whether there was a failure to load this schema cache item
   */
  failedToLoad: boolean
}
