/**
 * Application state for storing information needed in the add / edit data source multistep component flow.
 */
@typeScript
type SelfServiceDIAddDataSourceApplicationState mixes UiSdlSingletonApplicationState {

  id: ~

  // ---------------------------- GENERAL PURPOSE ----------------------------
  // -------------- EDIT MODE --------------
  // Whether the user is currently in a state of editing their data connectors
  editMode: boolean

  /**
   * An action set the edit mode of the application
   */
  @uiSdlActionCreator(actionType='SET_EDIT_MODE')
  setEditModeAction: private function(editMode: boolean): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_EDIT_MODE` and sets the editMode in state.
   */
  @uiSdlReducer(actionType='SET_EDIT_MODE')
  setEditModeReducer: private function(state: !UiSdlReduxState, action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Returns the {@link #editMode} from the state.
   */
  getEditMode: function(state: !UiSdlReduxState): boolean ts-client

  // -------------- CURRENT STEP FOR EDIT --------------
  // The steps to render in the edit modal
  editSteps: [MultiStepComponentStep]

  /**
   * An action to set the `editSteps` to render in edit mode
   */
  @uiSdlActionCreator(actionType='SET_EDIT_STEPS')
  setEditStepsAction: private function(editSteps: [MultiStepComponentStep]): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_EDIT_STEPS` and sets the `editSteps` in state
   */
  @uiSdlReducer(actionType='SET_EDIT_STEPS')
  setEditStepsReducer: private function(state: !UiSdlReduxState,
                                        action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  getEditSteps: function(state: !UiSdlReduxState): [MultiStepComponentStep] ts-client

  // -------------- SELECTED CACHE ITEM FOR EDIT MODE --------------
  // The cache item that has been selected for editing
  selectedCacheItemName: string

  /**
   * An action set selectedCacheItemName
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_CACHE_ITEM')
  setSelectedCacheItemNameAction: private function(selectedCacheItemName: string): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SELECTED_CACHE_ITEM` and sets `selectedCacheItemName` in the state.
   */
  @uiSdlReducer(actionType='SET_SELECTED_CACHE_ITEM')
  setSelectedCacheItemNameReducer: private function(state: !UiSdlReduxState,
                                                    action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Returns the {@link selectedCacheItemName} from the state.
   *
   * @param state - The current Redux state
   * @returns The name of the currently selected cache item, or undefined if none is selected
   */
  getSelectedCacheItemName: function(state: !UiSdlReduxState): string ts-client

  // -------------- SELECTED DATA CONNECTOR --------------
  // Stores the database that is selected
  selectedDataConnector: SelfServiceDI.Ui.DataConnector

  /**
   * Returns the {@link selectedDataConnector} from the state.
   */
  getSelectedDataConnector: function(state: !UiSdlReduxState): SelfServiceDI.Ui.DataConnector ts-client

  /**
   * An action to action to update the database title in the first step when it is selected
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_DATA_CONNECTOR')
  setSelectedDataConnectorAction: private function(selectedDataConnector: string): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SELECTED_DATA_CONNECTOR` and sets database title in the state.
   */
  @uiSdlReducer(actionType='SET_SELECTED_DATA_CONNECTOR')
  setSelectedDataConnectorReducer: private function(state: !UiSdlReduxState,
                                                    action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  // -------------- CLEAR APP STATE --------------

  /**
   * Clear the entire app state
   */
  @uiSdlActionCreator(actionType='CLEAR_APP_STATE')
  clearAppStateAction: private function(clearEditModeFields: !boolean): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `CLEAR_APP_STATE` and clears the state.
   */
  @uiSdlReducer(actionType='CLEAR_APP_STATE')
  clearAppStateReducer: private function(state: !UiSdlReduxState,
                                         action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  // ---------------------------- ADD / EDIT SQL DATA SOURCE ----------------------------
  // -------------- PREVIEW AND SELECT REMOTE SOURCE DATA --------------

  /**
   * Stores the transformed data returned from {@link SqlSourceSystem#previewTable}, with keys being the column name,
   * and value being a {@link SelfServiceDICell} storing value and valueType.
   * Example of the data structure:
   *      [
   *         {
   *           TIMESTAMP: {
   *             value: '2000-01-01',
   *             valueType: 'datetime',
   *           },
   *           ID: {
   *             value: 'id1',
   *             valueType: 'str',
   *           },
   *         },
   *         {
   *           TIMESTAMP: {
   *             value: '2000-01-02',
   *             valueType: 'datetime',
   *           },
   *           ID: {
   *             value: 'id2',
   *             valueType: 'str',
   *           },
   *         },
   *       ];
   */
  sqlTablePreviewData: [map<string, SelfServiceDICell>]

  /**
   * An action to set the `sqlTablePreviewData`
   */
  @uiSdlActionCreator(actionType='SET_SQL_TABLE_PREVIEW_DATA')
  setSqlTablePreviewDataAction: private function(previewData: [map<string, SelfServiceDICell>]): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SQL_TABLE_PREVIEW_DATA` and sets the `sqlTablePreviewData` in state.
   */
  @uiSdlReducer(actionType='SET_SQL_TABLE_PREVIEW_DATA')
  setSqlTablePreviewDataReducer: private function(state: !UiSdlReduxState,
                                                  action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  // -------------- PREVIEW REMOTE DATA ERRORS --------------

  /**
   * The inline notification to display errors in `PreviewAndSelectDataStep` and `EditSelectedTableSchemaStep`
   */
  previewRemoteDataError: UiSdlInlineNotification

  /**
   * An action to set the `previewRemoteDataError`
   */
  @uiSdlActionCreator(actionType='SET_PREVIEW_REMOTE_DATA_ERROR')
  setPreviewRemoteDataErrorAction: private function(error: UiSdlInlineNotification): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_PREVIEW_REMOTE_DATA_ERROR` and sets the `previewRemoteDataError` in state.
   */
  @uiSdlReducer(actionType='SET_PREVIEW_REMOTE_DATA_ERROR')
  setPreviewRemoteDataErrorReducer: private function(state: !UiSdlReduxState,
                                                     action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  // -------------- SQL CONNECTIONS CACHE --------------

  /**
   * A map of {@link SqlSourceSystem#name} to cached information about the remote connection for quick lookup in the UI.
   * This intentionally lives outside the {@link sourceSystemsCache} because it may include cached information for
   * {@link SqlSourceSystem}s that may not get fully configured by a user. In these cases, the concepts should remain
   * distinct in Redux state.
   */
  sqlConnectionsCache: map<string, SelfServiceDISqlConnectionCacheItem>

  /**
   * An action to update the {@link sqlConnectionsCache} at the `{sourceSystemName}.tableNamesLoading` path for a
   * specific {@link SqlSourceSystem}.
   */
  @uiSdlActionCreator(actionType='SET_SQL_TABLE_NAMES_LOADING')
  setSqlTableNamesLoadingAction: function(sourceSystemName: string, loading: boolean): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SQL_TABLE_NAMES_LOADING` and updates the {@link sqlConnectionsCache}
   * at the provided path.
   */
  @uiSdlReducer(actionType='SET_SQL_TABLE_NAMES_LOADING')
  setSqlTableNamesLoadingReducer: private inline function(state: !UiSdlReduxState,
                                                          action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * An action to update the {@link sqlConnectionsCache} at the `tableNamesBySchema.{sourceSystemName}` path for a
   * specific {@link SqlSourceSystem}.
   */
  @uiSdlActionCreator(actionType='SET_SQL_TABLE_NAMES_BY_SCHEMA')
  setSqlTableNamesBySchemaAction: function(sourceSystemName: string,
                                           tableNamesBySchema: map<string, [string]>): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SQL_TABLE_NAMES_BY_SCHEMA` and updates the {@link sqlConnectionsCache} at the
   * `tableNamesBySchema.{sourceSystemName}` path.
   */
  @uiSdlReducer(actionType='SET_SQL_TABLE_NAMES_BY_SCHEMA')
  setSqlTableNamesBySchemaReducer: private inline function(state: !UiSdlReduxState,
                                                           action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * The type metadata for the current selection when previewing a remote table.
   */
  remoteDataPreviewTypeMeta: TypeMeta

  /**
   * An action to set the `remoteDataPreviewTypeMeta`
   */
  @uiSdlActionCreator(actionType='SET_REMOTE_DATA_PREVIEW_TYPE_META')
  setRemoteDataPreviewTypeMetaAction: function(typeMeta: TypeMeta): !UiSdlReduxAction ts-client

  /**
   * Sets the `remoteDataPreviewTypeMeta`
   */
  @uiSdlReducer(actionType='SET_REMOTE_DATA_PREVIEW_TYPE_META')
  setRemoteDataPreviewTypeMetaReducer: private inline function(state: !UiSdlReduxState,
                                                               action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Retrieves `remoteDataPreviewTypeMeta`
   */
  getRemoteDataPreviewTypeMeta: function(state: !UiSdlReduxState): TypeMeta ts-client

  // -------------- CURRENT CONNECTION STATUS --------------
  // Current connect status for configuration form
  currentConnectStatus: PingResult

  /**
   * An action to set the currentConnectStatus in state
   */
  @uiSdlActionCreator(actionType='SET_CURRENT_CONNECT_STATUS')
  setCurrentConnectStatusAction: private function(pingResult: PingResult): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_CURRENT_CONNECT_STATUS` and sets in the state.
   */
  @uiSdlReducer(actionType='SET_CURRENT_CONNECT_STATUS')
  setCurrentConnectStatusReducer: private function(state: !UiSdlReduxState,
                                                   action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * An action to load the remote data for a {@link SourceSystem}.
   */
  @uiSdlActionCreator(actionType='LOAD_REMOTE_DATA_PREVIEW_TREE_LIST')
  loadRemoteDataPreviewTreeListAction: private function(treeViewComponentId: string,
                                                        sourceSystem: SourceSystem): !UiSdlReduxAction ts-client

  /**
   * An action to remove stale metadata from a {@link SourceSystem}. This will trigger
   * {@link SelfServiceDIRemoveStaleSourceMetadataEpic}.
   *
   * @param sourceSystem
   *           The source system to remove stale metadata from
   * @param tableNamesToKeep
   *           The table names that should be used to determine which metadata is stale. Any associated
   *           {@link SourceCollection}s where the {@link SourceCollection.source} type's schema does not match one of
   *           these table names will be removed. Similarly, those source types will also be removed.
   * @param refreshCache
   *           Whether the sourceSystem already exists and we need to refresh and update the cache
   * @param teardown
   *           Whether this action is called from a teardown (hitting cancel or close)
   */
  @uiSdlActionCreator(actionType='REMOVE_STALE_SOURCE_METADATA')
  removeStaleSourceMetadataAction: private function(sourceSystem: SourceSystem,
                                                    tableNamesToKeep: [string],
                                                    refreshCache: boolean,
                                                    teardown: boolean): !UiSdlReduxAction ts-client

  /*
   * Stores the current source system selection that should be used to populate the tree view for remote data. This
   * may be set in the multi-step form after connecting to a source system or it may be set when opening the remote
   * data tree view separately from a modal.
   */
  selectedSourceSystemForDataPreview: mixing SelfServiceDIAddDataSourceApplicationState

  /**
   * Returns the {@link selectedSourceSystemForDataPreview} from the state.
   */
  getSelectedSourceSystemForDataPreview: function(state: !UiSdlReduxState)
                                           : mixing SelfServiceDIAddDataSourceApplicationState ts-client

  /**
   * An action set the {@link selectedSourceSystemForDataPreview}
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_SOURCE_SYSTEM_FOR_DATA_PREVIEW')
  setSelectedSourceSystemForDataPreviewAction: private function(sourceSystem: mixing SelfServiceDIAddDataSourceApplicationState)
                                                         : !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SELECTED_SOURCE_SYSTEM_FOR_DATA_PREVIEW` and sets the
   * {@link selectedSourceSystemForDataPreview} in state.
   */
  @uiSdlReducer(actionType='SET_SELECTED_SOURCE_SYSTEM_FOR_DATA_PREVIEW')
  setSelectedSourceSystemForDataPreviewReducer: private function(state: !UiSdlReduxState,
                                                                 action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /*
   * Stores information about the prior state of the tree. This includes information like the source system, the
   * data connector type, and the checked state of the remote data preview tree. This is used to ensure we can
   * roll back changes if a user changes their mind at some point. For example, if the user cancels the modal, we
   * clean up any new source collections that were made while previewing data.
   */
  previewAndSelectDataStepPriorState: json

  /**
   * An action to set the {@link previewAndSelectDataStepPriorState}.
   */
  @uiSdlActionCreator(actionType='SET_PREVIEW_AND_SELECT_DATA_STEP_PRIOR_STATE')
  setPreviewAndSelectDataStepPriorStateAction: private function(priorState: json): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_PREVIEW_AND_SELECT_DATA_STEP_PRIOR_STATE` and sets the
   * {@link selectedSourceSystemForDataPreview} in state.
   */
  @uiSdlReducer(actionType='SET_PREVIEW_AND_SELECT_DATA_STEP_PRIOR_STATE')
  setPreviewAndSelectDataStepPriorStateReducer: private function(state: !UiSdlReduxState,
                                                                 action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * -------------- EDIT REMOTE TYPEMETA CACHE --------------
   */

  /**
   * Map only for storing remote {@link DataFusionUiTypeMeta} for `EditSelectedTableSchemaStep`, mapping from {@link SourceCollection} name to edited DataFusionUiTypeMeta
   * the map only stores DataFusionUiTypeMeta in intermediate edit state.
   */
  editRemoteTypeMetaCache: map<string, DataFusionUiTypeMeta>

  /**
   * Retrieves the data from `editRemoteTypeMetaCache` at the given path.
   */
  getEditRemoteTypeMetaFromCache: function(state: !UiSdlReduxState, path: [string]): DataFusionUiTypeMeta

  /**
   * An action to update a {@link DataFusionUiTypeMeta} in `editRemoteTypeMetaCache` based on the path provided.
   */
  @uiSdlActionCreator(actionType='UPDATE_EDIT_REMOTE_TYPE_META_CACHE')
  updateEditRemoteTypeMetaCacheAction: private function(path: [string],
                                                        dataToCache: json): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `UPDATE_EDIT_REMOTE_TYPE_META_CACHE` and set a new key value pair in
   * `editRemoteTypeMetaCache`.
   */
  @uiSdlReducer(actionType='UPDATE_EDIT_REMOTE_TYPE_META_CACHE')
  updateEditRemoteTypeMetaCacheReducer: private function(state: !UiSdlReduxState,
                                                         action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Retrieve the names of all the {@link SourceCollection} currently in the `editRemoteTypeMetaCache`.
   */
  getSourceCollectionNameInEditRemoteTypeMetaCache: function(state: !UiSdlReduxState): [string]

  /**
   * -------------- REMOTE TYPEMETA CACHE --------------
   */

  /**
   * Map only for storing remote {@link TypeMeta} for `EditSelectedTableSchemaStep`, mapping from {@link SourceCollection} name to {@link TypeMeta}.
   * the map only stores the unedited / original TypeMeta.
   */
  remoteTypeMetaCache: map<string, TypeMeta>

  /**
   * Retrieves the data from `remoteTypeMetaCache` at the given path.
   */
  getRemoteTypeMetaFromCache: function(state: !UiSdlReduxState, path: [string]): TypeMeta

  /**
   * An action to update a {@link TypeMeta} in `remoteTypeMetaCache` at the given path.
   */
  @uiSdlActionCreator(actionType='UPDATE_REMOTE_TYPE_META_CACHE')
  updateRemoteTypeMetaCacheAction: private function(path: [string], dataToCache: json): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `UPDATE_REMOTE_TYPE_META_CACHE` and set a new key value pair in `remoteTypeMetaCache`.
   */
  @uiSdlReducer(actionType='UPDATE_REMOTE_TYPE_META_CACHE')
  updateRemoteTypeMetaCacheReducer: private function(state: !UiSdlReduxState,
                                                     action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * -------------- SELECTED TABLE NAME BY SCHEMA --------------
   */

  /**
   * The selected table names in `PreviewAndSelectDataStep`
   */
  selectedTableNameBySchema: map<string, [string]>

  /**
   * An action to set `selectedTableNameBySchema`.
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_SQL_TABLE_NAME_BY_SCHEMA')
  setSelectedSqlTableNameBySchemaAction: function(tableNameBySchema: map<string, [string]>): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SELECTED_SQL_TABLE_NAME_BY_SCHEMA` and sets `selectedTableNameBySchema`.
   */
  @uiSdlReducer(actionType='SET_SELECTED_SQL_TABLE_NAME_BY_SCHEMA')
  setSelectedSqlTableNameBySchemaReducer: private inline function(state: !UiSdlReduxState,
                                                                  action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Retrieve `selectedTableNameBySchema`.
   */
  getSelectedTableNameBySchema: function(state: !UiSdlReduxState): map<string, [string]>

  // ---------------------------- ADD / EDIT FILE UPLOAD DATA SOURCE ----------------------------

  /**
   * A map of files that the user has browsed/dragged into the file uploader in step 2 to their file objs.
   * Note: these files are NOT uploaded until the end of the file upload add data source flow.
   * Example of the json in the map:
   * {
   *  "file": {},
   *  "preview": [
   *     {
   *         "exercise": "Reverse Curl",
   *         "sets": 3,
   *         "reps": 12,
   *         "restTime": 50,
   *         "__parsed_extra": [
   *             13
   *         ]
   *     }
   * ],
   * "errors": [
   *     {
   *         "type": "FieldMismatch",
   *         "code": "TooManyFields",
   *         "message": "Too many fields: expected 4 fields but parsed 5",
   *         "row": 0
   *     }
   * ]
   * }
   */
  queuedFiles: map<string, json>

  /**
   * Name of the schema that will be used to generate the {@link Source}.
   * {@link TypeMeta} for this schema will be stored in the {@link SelfServiceDIApplicationState#editTypeMetaCache}.
   */
  sourceName: string

  /**
   * Name of the schema that will be used to generate the {@link Persistable} types.
   * {@link TypeMeta} for the target will be stored in the {@link SelfServiceDIApplicationState#editTypeMetaCache}.
   */
  targetName: string

  /**
   * The error to display when issues occur in the select files and create schema step
   */
  selectFilesAndCreateSchemaError: string

  /**
   * An action to set queuedFiles in state
   */
  @uiSdlActionCreator(actionType='QUEUED_FILES_UPDATE')
  queuedFilesUpdateAction: function(files: map<string, json>): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `QUEUED_FILES_UPDATE` and updates queuedFiles in state
   */
  @uiSdlReducer(actionType='QUEUED_FILES_UPDATE')
  queueFilesUpdateReducer: private inline function(state: !UiSdlReduxState,
                                                   action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Retrieves the queued files from state
   */
  getQueuedFiles: function(state: !UiSdlReduxState): map<string, json>

  /**
   * An action to remove queuedFiles from state
   */
  @uiSdlActionCreator(actionType='QUEUED_FILES_REMOVE')
  queuedFilesRemoveAction: function(fileNames: [string]): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `QUEUED_FILES_REMOVE` and updates queuedFiles in state
   */
  @uiSdlReducer(actionType='QUEUED_FILES_REMOVE')
  queueFilesRemoveReducer: private inline function(state: !UiSdlReduxState,
                                                   action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * An action to clear queuedFiles from state
   */
  @uiSdlActionCreator(actionType='QUEUED_FILES_CLEAR')
  queuedFilesClearAction: function(): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `QUEUED_FILES_CLEAR` and clears queuedFiles from state
   */
  @uiSdlReducer(actionType='QUEUED_FILES_CLEAR')
  queueFilesClearReducer: private inline function(state: !UiSdlReduxState,
                                                  action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * An action to set the schema name in state
   */
  @uiSdlActionCreator(actionType='SET_SCHEMA_NAME')
  setSchemaNameAction: function(schemaName: string,
                                schemaType: string enum('source', 'target')): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SCHEMA_NAME` and sets the schema name in state
   */
  @uiSdlReducer(actionType='SET_SCHEMA_NAME')
  setSchemaNameReducer: private inline function(state: !UiSdlReduxState,
                                                action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Retrieves the schema name from state based on the schema type
   */
  getSchemaName: function(state: !UiSdlReduxState, schemaType: string enum('source', 'target')): string ts-client

  /**
   * An action to set errors for the select files and schema step in state
   */
  @uiSdlActionCreator(actionType='SET_SELECT_FILES_AND_CREATE_SCHEMA_ERROR')
  setSelectFilesAndCreateSchemaErrorAction: function(error: string): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SELECT_FILES_AND_CREATE_SCHEMA_ERROR` and sets the error in state
   */
  @uiSdlReducer(actionType='SET_SELECT_FILES_AND_CREATE_SCHEMA_ERROR')
  setSelectFilesAndCreateSchemaErrorReducer: private inline function(state: !UiSdlReduxState,
                                                                     action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  // -------------- CREATE TABLE FORM FILES FORM STATUS--------------
  // Form valid status for CreateTableFromFilesForm
  tableFromFilesFormStatus: Obj

  /**
   * An action to set the tableFromFilesFormStatus in state
   */
  @uiSdlActionCreator(actionType='SET_CREATE_TABLE_FORM_FILES_FORM_STATUS')
  setCreateTableFromFilesFormStatusAction: private function(formStatus: json): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_CREATE_TABLE_FORM_FILES_FORM_STATUS` and sets in the state.
   */
  @uiSdlReducer(actionType='SET_CREATE_TABLE_FORM_FILES_FORM_STATUS')
  setCreateTableFromFilesFormStatusReducer: private function(state: !UiSdlReduxState,
                                                             action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * -------------- SELECTED FILE PREVIEW --------------
   */

  /**
   * The selected preview to render in the target preview tab
   */
  selectedFilePreview: [Obj]

  /**
   * An action to set the selectedFilePreview in state.
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_FILE_PREVIEW')
  setSelectedFilePreviewAction: function(selectedFilePreview: [Obj]): UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SELECTED_FILE_PREVIEW` and sets selectedFilePreview in state.
   */
  @uiSdlReducer(actionType='SET_SELECTED_FILE_PREVIEW')
  setSelectedFilePreviewReducer: private inline function(state: !UiSdlReduxState,
                                                         action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * -------------- FILE UPLOAD SOURCE COLLECTION --------------
   */

  /**
   * The FileSourceCollection be to upserted in the file upload flow.
   */
  fileUploadSourceCollection: FileSourceCollection

  /**
   * An action to set the fileUploadSourceCollection in state.
   */
  @uiSdlActionCreator(actionType='SET_FILE_UPLOAD_SOURCE_COLLECTION')
  setFileUploadSourceCollectionAction: function(sourceCollection: FileSourceCollection): UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_FILE_UPLOAD_SOURCE_COLLECTION` and sets fileUploadSourceCollection in state.
   */
  @uiSdlReducer(actionType='SET_FILE_UPLOAD_SOURCE_COLLECTION')
  setFileUploadSourceCollectionReducer: private inline function(state: !UiSdlReduxState,
                                                                action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Retrieves `fileUploadSourceCollection`
   */
  getFileUploadSourceCollection: function(state: !UiSdlReduxState): FileSourceCollection ts-client

  // -------------- SET SELECTED FILENAME OF FILES GRID--------------
  // The name of the selected file in the files grid
  selectedFileNameInFilesGrid: string

  /**
   * An action to set the selectedFileNameInFilesGrid in state
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_FILE_NAME_IN_FILES_GRID')
  selectedFileNameInFilesGridAction: function(fileName: string): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SELECTED_FILE_NAME_IN_FILES_GRID` and updates selectedFileNameInFilesGrid in state
   */
  @uiSdlReducer(actionType='SET_SELECTED_FILE_NAME_IN_FILES_GRID')
  selectedFileNameInFilesGridReducer: private inline function(state: !UiSdlReduxState,
                                                              action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  // -------------- SET SOURCE COLLECTION CONFIG --------------
  // The configuration for the currently selected {@link SourceCollection}
