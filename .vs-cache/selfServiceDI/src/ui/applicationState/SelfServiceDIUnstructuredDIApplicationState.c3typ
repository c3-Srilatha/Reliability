/**
 * Application state for storing unstructured data integration information.
 */
@typeScript
type SelfServiceDIUnstructuredDIApplicationState mixes UiSdlSingletonApplicationState {

  id: ~

  // -------------- CURRENT SELECTED NODE --------------

  /**
   * The current selected unstructured DI node
   */
  selectedNodeId: string

  /**
   * An action to set the selectedNodeId in state.
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_NODE_ID')
  setSelectedNodeIdAction: function(selectedNodeId: string): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SELECTED_NODE_ID` and sets selectedNodeId in state.
   */
  @uiSdlReducer(actionType='SET_SELECTED_NODE_ID')
  setSelectedNodeIdReducer: private inline function(state: !UiSdlReduxState,
                                                    action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Returns the selectedNodeId from the state.
   */
  getSelectedNodeId: function(state: !UiSdlReduxState): string ts-client

  // -------------- Selected Configured Connector --------------

  /**
   * The selected configured connector state, used to store the currently selected connector.
   * { name: string }
   */
  selectedConfiguredConnector: json

  /**
   * An action to set the selected configured connector in state.
   */
  @uiSdlActionCreator(actionType='SET_SELECTED_CONFIGURED_CONNECTOR')
  setSelectedConfiguredConnectorAction: private function(selectedConfiguredConnectorName: string): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_SELECTED_CONFIGURED_CONNECTOR` and sets the selectedConfiguredConnector in state.
   */
  @uiSdlReducer(actionType='SET_SELECTED_CONFIGURED_CONNECTOR')
  setSelectedConfiguredConnectorReducer: private inline function(state: !UiSdlReduxState,
                                                                 action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Returns the selectedConfiguredConnector from the state.
   */
  getSelectedConfiguredConnector: function(state: !UiSdlReduxState): json ts-client

  // -------------- METADATA EXTRACTION --------------
  // -------------- TAGGING CATEGORIES --------------
  // The tagging categories cache which is a mapping of its id and tagging category
  taggingCategoriesCache: map<string, any>

  /**
   * An action to set the taggingCategoriesCache in state
   */
  @uiSdlActionCreator(actionType='SET_TAGGING_CATEGORIES_CACHE')
  setTaggingCategoriesCacheAction: function(taggingCategories: map<string, any>): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_TAGGING_CATEGORIES_CACHE` and updates taggingCategoriesCache in state
   */
  @uiSdlReducer(actionType='SET_TAGGING_CATEGORIES_CACHE')
  setTaggingCategoriesCacheReducer: function(state: !UiSdlReduxState,
                                             action: !UiSdlReduxAction): !UiSdlReduxAction ts-client

  /**
   * Retrieve the tagging categories cache
   */
  getTaggingCategoriesCache: function(state: !UiSdlReduxState): map<string, any> ts-client

  // -------------- COMPLETION CLIENTS --------------
  // The completion clients cache which is a mapping of its id and completion client
  completionClientsCache: map<string, any>

  /**
   * An action to set the completionClientsCache in state
   */
  @uiSdlActionCreator(actionType='SET_COMPLETION_CLIENTS_CACHE')
  setCompletionClientsCacheAction: function(completionClients: map<string, any>): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_COMPLETION_CLIENTS_CACHE` and updates completionClientsCache in state
   */
  @uiSdlReducer(actionType='SET_COMPLETION_CLIENTS_CACHE')
  setCompletionClientsCacheReducer: function(state: !UiSdlReduxState,
                                             action: !UiSdlReduxAction): !UiSdlReduxAction ts-client

  /**
   * Retrieve the completion clients cache
   */
  getCompletionClientsCache: function(state: !UiSdlReduxState): map<string, any> ts-client

  /**
   * Retrieve available metadata extraction tags in UI format
   * Transforms tagging categories into the format expected by the UI
   */
  getAvailableTags: function(state: !UiSdlReduxState): [json] ts-client

  /**
   * Retrieve available AI models for metadata extraction in UI format
   * Transforms completion clients into the format expected by the UI
   */
  getAvailableModels: function(state: !UiSdlReduxState): [json] ts-client
}
