/*
 * Custom form field to choose locally stored files
 */

@typeScript
type FileChooserInput mixes UiSdlComponent<UiSdlNoData> {

    /*
     * Label for form field; renders above input box
      */
    label: string

    /*
     * Boolean to indicate whether the field is required; renders a red star (*) next to label
     */
    required: boolean


    /*
     * Placeholder to render when no file is selected
     */
    placeholder: string

    /*
     * List of file extensions to accept as input
     */
    allowableFileExtensions: [string]
}
