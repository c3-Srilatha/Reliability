/**
 * Abstract type that can be mixed into a component to provide notifications. On its own, this only provides the
 * functionality to set notifications. The component mixing this type is responsible for rendering the notifications.
 */
@typeScript
abstract type WithNotifications {

  /**
   * A list of notification objects that should be rendered. The component mixing `WithNotifications` is in charge of
   * where and how to render these notifications.
   */
  componentNotifications: [UiSdlInlineNotification]

  /**
   * Triggered to set the notifications that should be displayed for a component.
   *
   * @param id
   *            Id of the component.
   * @param notifications
   *            An array of notifications matching the shape of {@link UiSdlInlineNotification}.
   */
  @uiSdlActionCreator(actionType='SET_COMPONENT_NOTIFICATIONS')
  setComponentNotificationsAction: private function(
    id: !string,
    notifications: [UiSdlInlineNotification]
  ): !UiSdlAction ts-client

  /**
   * Listens for actions of type `SET_COMPONENT_NOTIFICATIONS` and sets `componentNotifications`
   */
  @uiSdlReducer(actionType='SET_COMPONENT_NOTIFICATIONS')
  setComponentNotificationsReducer: private function(
    state: !UiSdlReduxState,
    action: !UiSdlStepUpdateAction
  ): !UiSdlReduxState ts-client
}
