/**
 * Custom component for Change Data Capture configuration form.
 * Provides a toggle for enabling CDC and conditional select fields for configuration.
 */
@typeScript
type CDCConfigForm mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The name of the SqlSourceCollection this CDC config is for
   */
  sourceCollectionName: string

  /**
   * CDC configuration object containing enabled flag, tracking column, and schedule
   */
  cdcConfig: SelfServiceDICdcConfig

  /**
   * Available timestamp columns for change tracking.
   * Populated dynamically from the data source.
   */
  availableTimestampColumns: [string]

  /**
   * To know whether the form is rendered in external source collection flow or not
   */
  isIntegrateTab: boolean

  /**
   * Whether CDC features are supported by the current server version
   */
  cdcSupported: boolean

  /**
   * Action to update CDC configuration when user changes values
   */
  @uiSdlActionCreator(actionType='UPDATE_CDC_CONFIG')
  updateCdcConfigAction: function(id: string,
                                  sourceCollectionName: string,
                                  cdcConfig: SelfServiceDICdcConfig): !UiSdlReduxAction ts-client

  /**
   * Action to integrate CDC configuration (save to backend)
   */
  @uiSdlActionCreator(actionType='INTEGRATE_CDC')
  integrateAction: function(id: string): !UiSdlReduxAction ts-client
}
