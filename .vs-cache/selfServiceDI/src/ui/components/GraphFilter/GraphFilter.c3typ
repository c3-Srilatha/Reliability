/**
 * A Graph Filter component for filtering hierarchical data organized into sections
 */
@typeScript
type GraphFilter mixes UiSdlComponent<UiSdlNoData> {

  /**
   * The ID of the graph to filter
   */
  graphId: string

  /**
   * The sections of the filter, each with a title and its own set of roots
   */
  sections: [GraphFilterSection]

  /**
   * The title text for the filter button
   */
  filterButtonTitle: string

  /**
   * A map of the nodes that are selected
   */
  selectedFilters: map<string, boolean>

  /**
   * Whether the filter is expanded
   */
  isExpanded: boolean

  /**
   * An action to set the sections of the graph filter
   *
   * @param sections
   *            The sections of the filter tree
   *
   * @returns a `SET_GRAPH_FILTER_SECTIONS` action
   */
  @uiSdlActionCreator(actionType='SET_GRAPH_FILTER_SECTIONS')
  setGraphFilterSectionsAction: private function(sections: [GraphFilterSection]): !UiSdlReduxAction ts-client

  /**
   * Updates `sections`
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='SET_GRAPH_FILTER_SECTIONS')
  setGraphFilterSectionsReducer: private function(state: !UiSdlReduxState,
                                                  action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * An action to set the selected state of a filter item
   *
   * @param nodeId
   *            The id of the node to update
   * @param selected
   *            Whether the node should be selected
   *
   * @returns a `SET_GRAPH_FILTER_SELECTED` action
   */
  @uiSdlActionCreator(actionType='SET_GRAPH_FILTER_SELECTED')
  setGraphFilterSelectedAction: private function(nodeId: string, selected: boolean): !UiSdlReduxAction ts-client

  /**
   * Updates `selectedFilters` for an individual node
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='SET_GRAPH_FILTER_SELECTED')
  setGraphFilterSelectedReducer: private function(state: !UiSdlReduxState,
                                                  action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * An action to set the expanded state of the filter
   *
   * @param expanded
   *            Whether the filter should be expanded
   *
   * @returns a `SET_GRAPH_FILTER_EXPANDED` action
   */
  @uiSdlActionCreator(actionType='SET_GRAPH_FILTER_EXPANDED')
  setGraphFilterExpandedAction: private function(expanded: boolean): !UiSdlReduxAction ts-client

  /**
   * Updates `isExpanded`
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='SET_GRAPH_FILTER_EXPANDED')
  setGraphFilterExpandedReducer: private function(state: !UiSdlReduxState,
                                                  action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * An action to clear the state of the graph filter
   *
   * @returns a `CLEAR_GRAPH_FILTER_STATE` action
   */
  @uiSdlActionCreator(actionType='CLEAR_GRAPH_FILTER_STATE')
  clearGraphFilterStateAction: private function(): !UiSdlReduxAction ts-client

  /**
   * Clears the state of the graph filter by resetting the necessary values
   */
  @uiSdlReducer(actionType='CLEAR_GRAPH_FILTER_STATE')
  clearGraphFilterStateReducer: private function(state: !UiSdlReduxState,
                                                 action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * Retrieves the sections from state
   *
   * @param state
   *           Redux state
   */
  getGraphFilterSections: function(state: !UiSdlReduxState): [GraphFilterSection] ts-client

  /**
   * Retrieves the map of selected filters from state
   *
   * @param state
   *           Redux state
   */
  getGraphFilterSelectedState: function(state: !UiSdlReduxState): map<string, boolean> ts-client

  /**
   * Retrieves the expanded state from state
   *
   * @param state
   *           Redux state
   */
  getGraphFilterExpandedState: function(state: !UiSdlReduxState): boolean ts-client

  /**
   * An action to set the selected state of multiple filter items at once
   *
   * @param selectedFilters
   *            The map of node ids to selected state
   *
   * @returns a `SET_GRAPH_FILTER_SELECTED_BULK` action
   */
  @uiSdlActionCreator(actionType='SET_GRAPH_FILTER_SELECTED_BULK')
  setGraphFilterSelectedBulkAction: private function(selectedFilters: map<string, boolean>): !UiSdlReduxAction ts-client

  /**
   * Updates `selectedFilters` for all nodes in bulk
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='SET_GRAPH_FILTER_SELECTED_BULK')
  setGraphFilterSelectedBulkReducer: private function(state: !UiSdlReduxState,
                                                      action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * An action to apply the current filter selection
   *
   * @returns an `APPLY_GRAPH_FILTER` action
   */
  @uiSdlActionCreator(actionType='APPLY_GRAPH_FILTER')
  applyGraphFilterAction: private function(): !UiSdlReduxAction ts-client
}
