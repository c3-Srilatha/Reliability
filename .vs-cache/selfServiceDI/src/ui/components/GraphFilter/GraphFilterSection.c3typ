/**
 * Type definition for a section within the GraphFilter component.
 * Represents a logical grouping of filter items with a common title or category.
 */
type GraphFilterSection {

  /**
   * The title of the section.
   * Used to categorize and organize filter items (e.g., "Packages", "Types").
   */
  title: string

  /**
   * The root nodes of the filter tree for this section.
   */
  roots: [GraphFilterItem]
}
