/**
 * The InlineNotification containing id, title and linkText and status
 */
@typeScript
type InlineNotification {

  /**
   * the type of the inlineNotification like CONNECTION_FAILURE, TABLE_CHANGE_ERROR
   */
  notificationType: string enum('CONNECTION_FAILURE', 'TABLE_CHANGE_ERROR', 'SCHEMA_CHANGE_ERROR')
  
  /**
   * Unique identifier for a inlineNotification, can be connectorName or other fields
   */
  id: !string

  /**
   * Stores information about an inline notification that could be needed when we click on a notification link
   */
  args: json

  /**
   * The title to display
   */
  title: string | UiSdlDynamicValueSpec

  /**
   * link text to display
   */
  linkText: string | UiSdlDynamicValueSpec

  /**
   * the status of the inlineNotification
   */
  status: string enum('WARNING', 'ERROR')
}
