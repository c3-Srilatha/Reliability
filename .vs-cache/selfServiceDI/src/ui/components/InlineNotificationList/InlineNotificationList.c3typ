/**
 * The InlineNotificationList component containing a list of InlineNotification
 */
@typeScript
type InlineNotificationList mixes UiSdlComponent<UiSdlNoData> {

  /**
   * An array of InlineNotification containing id, title, linkText and status.
   */
  inlineNotificationList: [InlineNotification]

  /**
   * Triggered when the InlineNotificationList is clicked.
   *
   * @param inlineNotificationObj
   *           The inline notification object containing all information about an inline notification
   * @returns A `INLINE_NOTIFICATION_CLICK` action for this instance.
   */
  @uiSdlActionCreator(actionType='INLINE_NOTIFICATION_CLICK')
  notificationLinkClickAction: private function(id: string, inlineNotificationObj: json): !UiSdlButtonClickAction ts-client
}
