/**
 * Vector Store Create Form Type
 *
 * This type defines the interface for creating a new vector store using the
 * GenaiCore.VectorStore.Pg format. Form state is managed internally within the
 * React component, and only the final submission dispatches an action.
 */
@typeScript
type VectorStoreCreateForm mixes UiSdlComponent<UiSdlNoData> {

  // ============================================================================
  // Props
  // ============================================================================

  /**
   * List of available entity TypeMeta objects for dropdown selection
   */
  entityTypeOptions: [TypeMeta]

  // ============================================================================
  // CREATE_VECTOR_STORE Action
  // ============================================================================

  /**
   * Create a new vector store with the provided data
   *
   * This action dispatches the form data formatted as a GenaiCore.VectorStore.Pg object
   * along with an isNewEntity flag.
   *
   * @param componentId - Unique identifier for the component instance
   * @param vectorStoreData - Vector store object in GenaiCore.VectorStore.Pg format
   * @param isNewEntity - Flag indicating this is a new entity
   * @returns Redux action for creating vector store
   */
  @uiSdlActionCreator(actionType='CREATE_VECTOR_STORE')
  createVectorStoreAction: function(componentId: !string, vectorStoreData: !json, isNewEntity: !boolean): !UiSdlReduxAction ts-client

  /**
   * Cancel vector store creation
   *
   * This action is dispatched when the user cancels the form without creating a vector store.
   *
   * @param componentId - Unique identifier for the component instance
   * @returns Redux action for canceling vector store creation
   */
  @uiSdlActionCreator(actionType='CANCEL_CREATE_VECTOR_STORE')
  cancelCreateVectorStoreAction: function(componentId: !string): !UiSdlReduxAction ts-client

}