/*
 * Remixing UiSdlFieldSetFormFieldSetting to support the custom type FileChooserInput in inputElement
 */

remix type UiSdlFieldSetFormFieldSetting {
    inputElement: UiSdlTextInput | UiSdlTextAreaInput | UiSdlDateTimeInput | UiSdlToggle | UiSdlNumberInput | UiSdlNumberRangeInput | UiSdlDateTimeRangeInput | UiSdlSelectInput | UiSdlIconSelectInput | UiSdlSingleSearch | UiSdlMultipleSearch | UiSdlSegmentedButton | UiSdlCheckboxTree | UiSdlSlider | UiSdlPassword | UiSdlFieldGroup | UiSdlGroupedInput | UiSdlRadioButtonGroup | UiSdlRadioButtonWithInputValueGroup | FileChooserInput
}
