/**
 * Custom Grid Cell that takes in {@link UiSdlDynamicValueSpecParam} and a trasform to generate
 * options for SDLSelectField
 */
@typeScript
type SDLSelectFieldFromStateContainerGridCell mixes UiSdlDataGridCell {

  /**
   * Whether the input should be clearable
   */
  clear: boolean

  /**
   * UiSdlDynamicValueSpecParam and a transform to generate the options
   */
  content: UiSdlDynamicValueSpecParam

  /**
   * UiSdlDynamicValueSpecParam and a transform to generate if the field
   * is disabled.
   */
  disabledMap: UiSdlDynamicValueSpecParam

  /**
   * The value to show the select field.
   */
  valueToshow: string

  /**
   * The placeholder text for the select field.
   * This field stores the placeholder text.
   */
  placeHolderText: string
}
