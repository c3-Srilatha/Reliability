/**
 * Observables and helper methods for modifying a {@link SourceSystem}
 */
@typeScript
type DataConnectorUtil {

  /**
   * Create a unique type name for the {@link SourceCollection} and source type.
   */
  generateUniqueTypeName: function(sourceSystemName: string, qualifiedSchemaTableName: string): string ts-client

  /**
   * Gets all SourceCollections that are associated with a SourceSystem
   */
  getSourceCollectionsFromSourceSystem: function(sourceSystem: string,
                                                 sourceCollections: [SourceCollection]): [SourceCollection] ts-client

  /**
   * Gets the set of unique source collection names from a list of {@link SourceFile}s
   */
  allSourceCollectionsFromSourceFiles: function(sourceFiles: [SourceFile]): [string] ts-client

  /**
   * Check whether a source collection has a table change error
   */
  sourceCollectionHasTableError: function(sourceCollectionCacheItem: SelfServiceDISourceCollectionCacheItem): boolean ts-client

  /**
   * Check whether a source collection has a schema change error
   */
  sourceCollectionHasSchemaError: function(tableSchemaCacheItem: SelfServiceDITableSchemaCacheItem): boolean ts-client

  /**
   * Returns the filtered items that should show for DataConnectors
   * @param sourceSystemCacheItem
   *         the cache item
   * @param supportedDataConnectors
   *         the available data connectors for the application
   * @param sourceCollections
   *         when applicable, the sourceCollections associated with the cache item
   * @return the filtered items that should show for DataConnectors
   */
  isSourceSystemConfiguredAndSupported: function(sourceSystemCacheItem: SelfServiceDISourceSystemCacheItem,
                                                 supportedDataConnectors: [SelfServiceDI.Ui.DataConnector],
                                                 sourceCollections: [SourceCollection]): boolean ts-client

  /**
   * Returns the storageKind for a sourceSystemCacheItem
   * @param sourceSystemCacheItem
   *         the cache item
   * @param sourceCollections
   *         when applicable, the sourceCollections associated with the cache item
   *
   * @return the storage kind for a {@link SelfServiceDISourceSystemCacheItem}
   */
  getStorageKindFromSourceSystemCacheItem: function(sourceSystemCacheItem: SelfServiceDISourceSystemCacheItem,
                                                    sourceCollections: [SourceCollection]): string ts-client

  /**
   * Check whether a field type is a foreign key (i.e building: Building)
   */
  isForeignKeyField: function(fieldType: DeclaredFieldType): boolean ts-client

  /**
   * Check whether a field type is a foreign key reference (i.e fixtures: [Fixture](building))
   */
  isForeignKeyReferenceField: function(fieldType: DeclaredFieldType): boolean ts-client

  /**
   * Returns true if the sourceCollection is a {@link FileSourceCollection}
   * and it's sourceSystem is Canonical
   *
   * @param sourceCollection
   *         The sourceCollection to validate
   * @returns boolean
   */
  isValidFileUploadSourceCollection: function(sourceCollection: SourceCollection): boolean ts-client

  /**
   * Generate an id for the grid entries from a DeclaredFieldType.
   */
  getIdFromFieldType: function(fieldType: DeclaredFieldType): string ts-client

  /**
   * Retrieve the data type from a fieldType. Would be either the {@link Ann.Db#dataTypeOverride}
   * of {@link DeclaredFieldType#valueType} of the field.
   */
  getFieldTypeDataType: function(fieldType: DeclaredFieldType): string ts-client

  /**
   * Build a {@link SelfServiceDITableSchemaCacheItems} from {@link SourceCollectionUi}
   */
  buildSelfServiceDITableSchemaCacheItem: function(remoteAndLocalCollectionInfo: SourceCollectionUi)
                                            : SelfServiceDITableSchemaCacheItem ts-client

  /**
   * Build a list of {@link SelfServiceDITableSchemaCacheItems} from results of {@link SourceSystemManager#sourceSystemRemoteAndLocalCollectionsInfosByName}
   */
  buildSelfServiceDISchemaMismatchCacheItems: function(remoteAndLocalCollectionInfos: [SourceCollectionUi])
                                                : [SelfServiceDITableSchemaCacheItem] ts-client

  /**
   * Returns true if the sourceSystemType is FileSourceSystem
   *
   * @param sourceSystemType
   *         The type of SourceSystem
   * @returns boolean
   */
  isFileSourceSystem: function(sourceSystemType: string): boolean ts-client

  /**
   * Returns true if the sourceSystemType is SqlSourceSystem
   *
   * @param sourceSystemType
   *         The type of SourceSystem
   * @returns boolean
   */
  isSqlSourceSystem: function(sourceSystemType: string): boolean ts-client

  /**
   * Returns true if the sourceCollectionType is FileSourceCollection
   *
   * @param sourceCollectionType
   *         The type of SourceCollection
   * @returns boolean
   */
  isFileSourceCollection: function(sourceCollectionType: string): boolean ts-client

  /**
   * Returns true if the sourceCollectionType is SqlSourceCollection
   *
   * @param sourceCollectionType
   *         The type of SourceCollection
   * @returns boolean
   */
  isSqlSourceCollection: function(sourceCollectionType: string): boolean ts-client

  /**
   * Builds a {@link DataFusionUiTypeMeta} from {@link TypeMeta}
   *
   * @param typeMeta
   *         The {@link TypeMeta} that needs to be transformed
   * @param reservedFieldTypeNames
   *         The names of the fields that cannot be set as a {@link DeclaredFieldTypes}
   * @param shouldSanitizeFieldNames
   *        If true, updates the fieldNames from the source schema to match the type system's syntax.
   * @param makePersistable
   *        If true, sets the declaredEntity property to true
   * @param selectAllFields
   *        If true, sets the selected flag to true for all the declared field types.
   *
   * @returns {@link DataFusionUiTypeMeta}
   */
  buildUiTypeMeta: function(typeMeta: TypeMeta,
                            reservedFieldTypeNames: [string],
                            shouldSanitizeFieldNames: boolean,
                            makePersistable: boolean,
                            selectAllFields: boolean): DataFusionUiTypeMeta ts-client

  removeTypes: function(typeNames: [string], followUpActions: [UiSdlReduxAction]) ts-client

  /**
   * Removes the transforms associated with the given source collections
   *
   * @param sourceCollectionForSourceSystem
   *         The source collections that have may have transforms associated with them
   * @returns EMPTY
   */
  removeTranforms: function(sourceCollectionForSourceSystem: [any]) ts-client

  /**
   * Retrieves the current UI theme.
   *
   * @returns The current theme as a string, e.g., 'Light' or 'Dark'.
   */
  getTheme: function(state: !UiSdlReduxState): string ts-client

  /**
   * Validates a Transform object by checking if its `source`, `target`, and `name` properties are not empty.
   *
   * @param transform - The Transform object to validate.
   * @returns `true` if all properties (`source`, `target`, `name`) are non-empty, otherwise `false`.
   */
  isTransformValid: function(transform: Transform): boolean ts-client

  /**
   * Transforms a list of files by extracting their content length and URL.
   *
   * @param files - The list of files to transform.
   * @returns A transformed list of files with content length and URL.
   */
  transformFiles: function(files: [Obj]): [Obj] ts-client

  /**
   * Removes the source collection from the list of source collections
   *
   * @param sourceCollection
   *         The source collection name that needs to be removed
   * @returns EMPTY
   */
  removeSourceCollectionObservable: function(sourceCollection: string) ts-client
}
