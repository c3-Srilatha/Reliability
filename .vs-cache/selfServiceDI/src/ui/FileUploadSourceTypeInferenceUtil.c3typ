/**
 * Helper methods for inferring {@link TypeMeta} information from files
 */
@typeScript
type FileUploadSourceTypeInferenceUtil {

/**
 * Infers the source type from individual files in an observable manner.
 * @param siteId
 *           The ID of the site.
 * @param state
 *           The current state of the Redux store.
 * @param spinnerId
 *           The ID of the spinner to be used during the operation.
 * @param queuedFiles
 *           The files that are queued for upload.
 * @param filesWithErrorspec
 *           A specification for dynamic values that may contain errors.
* @param persistableKeywords
 *           The array of keywords that are reserved.
 * @returns An observable of actions to be dispatched to the Redux store.
 */
  inferSourceTypeFromFilesObservable: function(siteId: string, state: !UiSdlReduxState, spinnerId: string, queuedFiles: map<[string], Obj>, filesWithErrorspec: UiSdlDynamicValueSpec, persistableKeywords: [string]): UiSdlActionsObservable ts-client

/**
 * Infers the source type from individual files in an observable manner.
 * @param siteId
 *           The ID of the site.
 * @param state
 *           The current state of the Redux store.
 * @param spinnerId
 *           The ID of the spinner to be used during the operation.
 * @param queuedFiles
 *           The files that are queued for upload.
 * @param filesWithErrorspec
 *           A specification for dynamic values that may contain errors.
 * @param persistableKeywords
 *           The array of keywords that are reserved.
 * @returns An observable of actions to be dispatched to the Redux store.
 */
  inferSourceTypeFromIndividualFilesObservable: function(siteId: string, state: !UiSdlReduxState, spinnerId: string, queuedFiles: map<[string], Obj>, filesWithErrorspec: UiSdlDynamicValueSpec, persistableKeywords: [string]): UiSdlActionsObservable ts-client
}
