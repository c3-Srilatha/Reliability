/**
 * Determines if table names are still loading by checking both tableNamesLoading flag and tableNamesBySchema existence.
 * Returns true (loading) if: tableNamesLoading is true, tableNamesBySchema is empty/undefined, or cache item doesn't exist.
 * Returns false (not loading) only when tableNamesLoading is false and tableNamesBySchema has data.
 */
@typeScript
type SelfServiceDITableNamesLoadingState mixes UiSdlDataTransform<json, boolean> {

  transform: ~
}
