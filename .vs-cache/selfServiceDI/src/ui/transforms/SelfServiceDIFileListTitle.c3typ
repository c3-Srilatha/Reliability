/**
 * Transforms the file list state to determine the appropriate title for the file preview side panel.
 * Returns "No files to preview" if the file list is empty, otherwise returns "Select a file to Preview".
 */
@typeScript
type SelfServiceDIFileListTitle mixes UiSdlDataTransform<json, string> {

  transform: ~
}
