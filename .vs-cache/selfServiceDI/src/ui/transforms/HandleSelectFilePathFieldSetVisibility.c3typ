/**
 * Transform to handle the visibility of fieldsets in the file path selection form.
 *
 * This transform takes a fieldset value and a hidden flag, then updates the visibility
 * of the first field in the first fieldset based on the hidden parameter. It is used
 * to dynamically show or hide form fields during the file path selection process
 * in the self-service data integration workflow.
 */
@typeScript
type HandleSelectFilePathFieldSetVisibility mixes UiSdlDataTransform<json, [UiSdlFormFieldSet]> {

  transform: ~
}
