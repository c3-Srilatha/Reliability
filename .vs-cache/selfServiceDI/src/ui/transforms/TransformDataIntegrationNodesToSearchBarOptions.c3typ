/**
 * Transform to convert data integration graph nodes into search bar options.
 * This transform takes node data from the graph and converts it into a format
 * suitable for display in the search bar filter options.
 */
@typeScript
type TransformDataIntegrationNodesToSearchBarOptions mixes UiSdlDataTransform<TypeMeta, json> {

  transform: ~
}
