/**
 * Observables and helper methods for connecting to an {@link SourceSystem}
 */
@typeScript
type ConnectionConfigurationUtil {

  /**
   * Validates whether a form is valid based on its state
   *
   * @param formFieldPropertiesWithValue
   *         Record of form field properties with their values
   * @returns whether the form is valid
   */
  isFormValid: function(formFieldPropertiesWithValue: map<string, json>): boolean ts-client

  /**
   * Converts formFieldValues based on configuration
   *
   * @param config
   *         The information to extract the correct values from the formFields and construct objects
   * @param formFieldValues
   *         The representation of form fields and values
   * @returns the extracted object based on field mapping
   */
  extractFromFieldMapping: function(config: SelfServiceDI.Ui.DataConnectorCredentialConfig,
                                    formFieldValues: map<string, string>): JdbcCredentialsFields ts-client

  /**
   * Extracts a {@link SourceSystem} from form field values
   *
   * @param formFieldValues
   *         The representation of form fields and values
   * @param sourceSystemCredentialType
   *         The credential type for the source system
   * @param sourceSystemType
   *         The type of source system
   * @returns a {@link SourceSystem} based on the form values
   */
  extractSourceSystem: function(formFieldValues: map<string, json>,
                                sourceSystemCredentialType: string,
                                sourceSystemType: string): json ts-client

  /**
   * Pings a {@link SourceSystem} after executing observables before
   * and then dispatches followup observables based on the {@link PingResult}
   *
   * @param sourceSystem
   *         The {@link SourceSystem} to ping
   * @param siteId
   *         The siteId of the app's site
   * @param state
   *         Redux State
   * @param pingTypeName
   *         The name of the type to execute a call for ping
   * @param pingActionName
   *         The name of the action to execute for ping
   * @param observablesForPingResult
   *         A function that emits observables based on a {@link PingResult}
   * @param observablesBeforePing
   *         Observables to resolve before pinging the {@link SourceSystem}
   * @param multiStepComponentId
   *         Optional multi-step component ID
   * @returns observable for pinging the source system
   */
  pingSourceSystem: function(sourceSystem: SourceSystem,
                             siteId: string,
                             state: UiSdlReduxState,
                             pingTypeName: string,
                             pingActionName: string,
                             observablesForPingResult: lambda(ping: PingResult),
                             observablesBeforePing: UiSdlActionsObservable,
                             multiStepComponentId: string): UiSdlObservable ts-client

  /**
   * Sets up a {@link SourceSystem} and its credentials for pinging
   *
   * @param siteId
   *         The siteId of the app's site
   * @param state
   *         Redux State
   * @param updatedSourceSystem
   *         The {@link SourceSystem} to ping
   * @param credentials
   *         The credentials to set for the {@link SourceSystem}
   * @param sourceSystemType
   *         Source system type string
   * @param beforeCredentialSetContext
   *         Context to set before credentials
   * @param beforeCredentialSetAction
   *         Action to execute before setting credentials
   * @param includeCredentials
   *         Whether to include credentials
   * @param isPostgresSLL
   *         Whether this is PostgreSQL SSL
   * @returns observables to setup {@link SourceSystem} and its credentials
   */
  setupSourceSystemAndCredentials: function(siteId: string,
                                            state: UiSdlReduxState,
                                            updatedSourceSystem: SourceSystem,
                                            credentialObject: JdbcCredentialsFields,
                                            sourceSystemType: string,
                                            beforeCredentialSetContext: json,
                                            beforeCredentialSetAction: ActionRef,
                                            includeCredentials: boolean,
                                            isPostgresSLL: boolean): UiSdlObservable ts-client

  /**
   * Extracts credentials and source system from form data
   *
   * @param dataConnector
   *         The data connector configuration
   * @param formFieldValues
   *         The representation of form fields and values
   * @param state
   *         Redux State
   * @returns object containing source system and credentials
   */
  extractCredentialsAndSourceSystem: function(dataConnector: SelfServiceDI.Ui.DataConnector,
                                              formFieldValues: map<string, json>,
                                              state: UiSdlReduxState): json ts-client

  /**
   * Validates form and tests connection
   *
   * @param action
   *         Redux action
   * @param state
   *         Redux State
   * @param pingFollowUp
   *         Function to handle ping follow-up
   * @returns observable for form validation and connection testing
   */
  validateFormAndTestConnection: function(action: json,
                                          state: UiSdlReduxState,
                                          pingFollowUp: lambda(ping: PingResult)): UiSdlObservable ts-client

  /**
   * Removes test source systems
   *
   * @param siteId
   *         The siteId of the app's site
   * @param state
   *         Redux State
   * @returns observable to remove test source systems
   */
  removeTestSourceSystemsObservable: function(siteId: string, state: UiSdlReduxState): UiSdlObservable ts-client

  /**
   * Updates source system state
   *
   * @param siteId
   *         The siteId of the app's site
   * @param state
   *         Redux State
   * @param sourceSystem
   *         The source system to update
   * @returns observable to update source system state
   */
  updateSourceSystemStateObservable: function(siteId: string,
                                              state: UiSdlReduxState,
                                              sourceSystem: SourceSystem): UiSdlObservable ts-client

  /**
   * Used to upsert a sourceSystem or sourceCollection
   *
   * @param siteId
   *         The siteId of the app's site
   * @param state
   *         Redux State
   * @param toUpsert
   *         The {@link Metadata} to upsert
   * @returns observables to upsert the {@link Metadata}
   */
  upsertItem: function(siteId: string, state: UiSdlReduxState, toUpsert: Metadata): UiSdlObservable ts-client

  /**
   * Extracts form properties as key-value pairs from the state
   *
   * @param state
   *         The current application state
   * @returns Record<string, object> - Key-value pairs of form properties
   */
  getFormPropertiesAsKeyValue: function(state: UiSdlReduxState): Map<string, json> ts-client

  /**
   * Extracts meaningful error messages from messy error blobs.
   * Handles various error formats including JSON blocks and Java errors.
   *
   * Example usage: Internal Java error: DATA_SOURCE HTTP protocol error. 403 Forbidden.
   * Raw response: {"error_code":403,"message":"Invalid access token. [ReqId: 40671a06-5178-4b94-8a44-5e48584d4184]"}!
   *
   * @param raw
   *         Raw error string that may contain JSON blocks or Java error messages
   * @returns Extracted error message or empty string if nothing meaningful found
   */
  extractErrorMessage: function(raw: string): string ts-client
}
