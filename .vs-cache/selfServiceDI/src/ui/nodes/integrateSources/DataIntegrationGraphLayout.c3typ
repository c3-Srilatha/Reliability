/**
 * Custom layout to properly set node positions for graphs present on:
 * - DataIntegrationGraph.json
 * - IntegrateTabGraph.json
 * - IntegrateSourcesGraph.json
 */

@typeScript
type DataIntegrationGraphLayout mixes NodeDiagramLayout {
  execute:                    ~ ts-client
  initialNodeHandlePositions: ~ ts-client

}
