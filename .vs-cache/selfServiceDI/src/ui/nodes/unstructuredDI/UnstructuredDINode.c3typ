/**
 * Node that renders the node for the unstructured DI graph
 */
type UnstructuredDINode mixes NodeDiagramNodeData {

  /**
   * The header of this node
   */
  header: UnstructuredDINodeHeader

  /**
   * The subheader of this node
   */
  subHeader: UnstructuredDINodeHeader

  /**
   * The package of this node
   */
  packageName: string

  /**
   * Whether the node has been configured or not
   */
  configured: !boolean

  /**
   * The kind of node
   */
  kind: !string enum('data_source', 'data_selector', 'metadata_extractor', 'document_parser', 'vector_store', 'integration_schedule')

  /**
   * The color associated with this node.
   */
  color: string

  /**
   * The status of the node as well as the message and icon
   */
  status: UnstructuredDINodeStatus

  /**
   * Whether the node should be clickable or not
   */
  disabled: boolean = false
}
