/**
 * Header type that defines an icon and header text
 */
type UnstructuredDINodeHeader {

  /**
   * The icon associated with this header
   */
  icon: string

  /**
   * The image path associated with this header.
   */
  imagePath: string

  /**
   * The text to be displayed on the header
   */
  headerText: string

  /**
   * The truncate style of the header
   */
  truncateStyle: string enum('truncateRegular', 'truncateFilePath')

  /**
   * The size of the header
   */
  size: !string enum('small', 'medium', 'large')
}
