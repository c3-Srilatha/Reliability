/**
 * Node that renders source or target node for the Integration step of the add data source flow
 */
type SourceTargetNode mixes NodeDiagramNodeData {

 /**
   * The color associated with this node. When specified the left border and icon will be of this color.
   */
  color: string

  /**
     * The fields associated with this node. The values displayed in dropdown
     */
  fields: [Obj]

  /**
     * The kind of node, either source or target
     */
  kind: string enum ('source', 'target') = 'source'
}
