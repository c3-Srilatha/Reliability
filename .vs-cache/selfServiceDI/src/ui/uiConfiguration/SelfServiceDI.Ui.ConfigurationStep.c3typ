/**
 * A step for a {@MultiStepComponent} to be utilized in the add data connector flow
 */
type SelfServiceDI.Ui.ConfigurationStep mixes Prioritized, MultiStepComponentStep {

  /**
   * The category associated with the step. When an {@link SelfServiceDI.Ui.DataConnector} with this step's category is selected
   * this step will be utilized by {@MultiStepComponent}
   */
  categories: [SelfServiceDI.Ui.DataConnectorCategory]

  /**
   * Whether we want the apply and save button in edit mode.
   */
  saveInEditMode: boolean = false
}
