/**
 * A representation of a category corresponding to a data connector for use in the UI.
 */
type SelfServiceDI.Ui.DataConnectorCategory mixes Prioritized {

  /**
   * A label for the category. This may be a translation key or a literal category string.
   */
  label: string

  /**
   * A sourceSystemType for the category. This will be used to connect unconfigure source system to a data connector catergory.
   */
  sourceSystemType: string
}
