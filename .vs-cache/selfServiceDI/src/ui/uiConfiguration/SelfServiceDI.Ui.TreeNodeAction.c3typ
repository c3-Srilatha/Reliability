/**
 * An extension of {@link UiSdlAction} to be rendered for the {@link PresentationalTreeNode}s
 */
type SelfServiceDI.Ui.TreeNodeAction mixes UiSdlAction, Prioritized {

  /**
   * One-to-one mapping with the name field of the {@link UiSdlAction}
   */
  label: !string

  /**
   * The depth at which to render this action in a nested tree
   */
  depth: !int = 0

  /**
   * The configuration step (s) to which this action is linked. If passed, the stepName (s)
   * will be passed as one of the action args.
   */
  steps: string serialized SelfServiceDI.ConfigurationStepGroup

  /**
   * The category associated with the action. If the category is disabled, the action will be hidden in the UI.
   */
  categories: ![!SelfServiceDI.Ui.DataConnectorCategory]
}
