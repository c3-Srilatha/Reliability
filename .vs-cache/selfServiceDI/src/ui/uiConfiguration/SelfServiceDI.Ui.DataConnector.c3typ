/**
 * A representation of a Data Connector for use in the UI.
 */
type SelfServiceDI.Ui.DataConnector mixes Prioritized {

  /**
   * A label for the category. This may be a translation key or a literal category string.
   */
  label: !string

  /**
   * A location prefix to drop file chunks. Only used by FileUpload data connector.
   */
  associatedPath: string

  /**
   * The name of the storage location for the connector.
   */
  storageKind: !(string enum DatastoreType | string enum FileSystemScheme | string serialized Type)

  /**
   * The vendor/provider for the connector. This is used for attribution. If not defined, the connector is assumed to
   * be "Open Source" and will be marked as such in the UI. This may be a translation key or a literal provider string.
   */
  provider: string

  /**
   * A path to the asset to render as the icon for the connector. If not defined, no icon will be rendered.
   * The path should resemble `"assets/images/{data connector name}.svg"` and the image should be placed in
   * `{packageName}/ui/content/assets/images/`.
   *
   * This takes precedence over {@link iconName}.
   */
  imagePath: string

  /**
   * Alternative to {@link imagePath} if there is no image. This can render a FontAwesome icon. {@link imagePath} takes
   * precedence if both are defined.
   */
  iconName: string

  /**
   * The category associated with the connector. If the category is disabled, the connector will be hidden in the UI.
   */
  category: SelfServiceDI.Ui.DataConnectorCategory

  /**
   * The configuration for the connector's credentials.
   */
  credentialConfig: SelfServiceDI.Ui.DataConnectorCredentialConfig

  /**
   * The configuration of a the args for {@link#beforeCredentialSetAction}
   */
  beforeCredentialSetContext: SelfServiceDI.Ui.DataConnectorCredentialConfig

  /**
   * The field properties for the connector. This is used as properties overrides to SQLEngine config
   */
  fieldOverrides: map<string, map<string, any>>

  /**
   * Field properties for existing connectors which would be migrated to SQLEngine configs
   * NOTE: To be deprecated from version 8.11
   */
  existingFieldsProperties: map<string, map<string, any>>

  /**
   * The {@link SourceSystem} subtype for the data connector
   */
  sourceSystemType: string

  /**
   * The API to optionally call before setting credentials on this data connector
   */
  beforeCredentialSetAction: ActionRef

  /**
   * List of errors typically returned by this data connector and their corresponding error messages
   */
  errorMappings: [SelfServiceDI.Ui.ErrorMappingEntry]
}
