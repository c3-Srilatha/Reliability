/*
 * This type defines the configuration for a data connector credential value,
 * detailing the mapping, prefix, and suffix configurations.
 */
type SelfServiceDI.Ui.DataConnectorCredentialValueConfig {

  /**
   * The target field name(s) in the data connector to which the credential value should be mapped.
   * For example, the `user` field may need to be mapped to the `credentials.user` ({ mapTo: 'credentials.user' })
   */
  mapTo: string | [string]

  /**
   * The prefix to be added to the data connector credential value.
   */
  prefix: string

  /**
   * The suffix to be added to the data connector credential value.
   */
  suffix: string
}
