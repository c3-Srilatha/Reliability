/**
 * Helper methods for managing data integration perspectives and UI state
 */
@typeScript
type DataIntegrationPerspectiveUtil {

  /**
   * Generate a consistent color for a package name using CSS variables
   * @param packageName The name of the package to generate a color for
   * @returns A CSS variable string representing the color
   */
  generatePackageColor: function(packageName: string): string ts-client

  /**
   * Get the display title for a node
   * @param node The node to get the display title for
   * @returns The display title string
   */
  getNodeDisplayTitle: function(node: Node): string ts-client

  /**
   * Get the display subtitle for a node
   * @param node The node to get the display subtitle for
   * @returns The display subtitle string
   */
  getNodeDisplaySubTitle: function(node: Node): string ts-client
}
