/**
 * Helper methods to abtract away the differences between schema edit tabs
 * in different parts of selfServiceDI
 */
@typeScript
type SchemaEditUtil {

  /**
   * Based on the sourceCategory, determine where to retrieve the schema type meta in state
   */
  getTypeMetaFromSourceCategory: function(sourceCategory: !string enum('file-upload', 'sql', 'main-page'),
                                          state: !UiSdlReduxState): DataFusionUiTypeMeta ts-client

  /**
   * Based on the sourceCategory, what action is dispatched to update the schema type meta in state
   */
  getTypeMetaEditActionFromSourceCategory: function(sourceCategory: !string enum('file-upload', 'sql', 'main-page'),
                                                    state: !UiSdlReduxState,
                                                    typeMeta: TypeMeta): UiSdlReduxAction ts-client

  /**
   * Based on the schemaData, return is description exists
   */
  checkSchemaDescription: function(schemaData: DataFusionUiTypeMeta): boolean ts-client
}
