/**
 * LLM based functions for Data Integration.
 */
type DataInteg.GenAi {

  /**
   * Generate a projection based C3 Transform from Source to Canonical or Canonical to Target provided the dsl of the types.
   * @param sourceOrCanonicalTypeDsl
   *            the dsl of the source type if the transform is to be generated from Source to Canonical or the dsl of the canonical type if the transform is to be generated from Canonical to Target.
   * @param canonicalOrTargetTypeDsl
   *            the dsl of the canonical type if the transform is to be generated from Source to Canonical or the dsl of the target type if the transform is to be generated from Canonical to Target.
   * @return the projection based C3 Transform for the given source to canonical type or canonical to target type
   */
  generateProjectionTransform: function(sourceOrCanonicalTypeDsl: !string, canonicalOrTargetTypeDsl: !string): json py
}
