{
  "name": "selfServiceDI",
  "description": "Self-Service DI Application",
  "author": "studio <studio@c3.ai>",
  "version": "8.9.0",
  "compatibleToVersion": "8.7",
  "dependencies": {
    "dataFusionBase": "8.9"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@c3/c3-base",
      "plugin:@c3/typescript",
      "plugin:@c3/react",
      "prettier"
    ],
    "plugins": [
      "@c3",
      "prettier"
    ],
    "parserOptions": {
      "ecmaVersion": 2018,
      "sourceType": "module"
    },
    "rules": {
      "prettier/prettier": "error",
      "import/prefer-default-export": "off",
      "import/exports-last": "off"
    }
  }
}
