/**
 * Type for SelfServiceDIJdbcStoreConfig including the name and secrepassword of the connector
 * We cannot use {@link JdbcStoreConfig} without being a cluster admin in the CI test
 */
type SelfServiceDIJdbcStoreConfig mixes Config, Named {

  /**
   * the name of the connector
   */
  name: !~

  /**
   * the secret password of the connector.
   */
  // Will need to change for covering over more data connectors
  @config(secret=true)
  secretPassword: any

  /**
   * the function that can get the SelfServiceDIJdbcStoreConfig
   */
  forName: ~ js-server

}
