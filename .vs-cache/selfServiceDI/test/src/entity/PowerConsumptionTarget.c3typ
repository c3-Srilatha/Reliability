/**
* Enter the Type purposes and use cases with code examples.
*/

@db(datastore='kv',
 persistenceOrder='id')
entity type PowerConsumptionTarget schema name 'POWER_CONSUMPTION_TARGET' {
  lastUpdated: datetime
  dateTime: datetime
  temperature: double
  humidity: double
  windSpeed: double
  generalDiffuseFlows: double
  diffuseFlows: string
  powerConsumptionZone1: int
  powerConsumptionZone2: int
  powerConsumptionZone3: int
}
