/**
 * Fetch cache data for testing
 */
@typeScript
type FetchCacheDataTestUtil {

  /**
   * Expression Engine Functions
   */
  EXPRESSION_ENGINE_FUNCTIONS_TEST: ![Obj]

  /**
   * Expression Engine Type Metas
   */
  EXPRESSION_ENGINE_TYPE_METAS_TEST: ![Obj]

  /**
   * Test Data Generated
   * P: Persistables, C: Canonicals, T: Transforms
   *
   *              P1 - T4 - C4 - T5 - P2
   *             /  \
   *            T3  T2
   *           /      \
   *          C3      C2
   *                    \
   *                    T1
   *                      \
   *                      C1
   *
   * Unmapped: C5, P3
   */

  /**
   * Persistable Type Metas
   */
  PERSISTABLE_TYPE_METAS_TEST: ![Obj]

  /**
   * Persistable Type Metas
   */
  CANONICAL_TYPE_METAS_TEST: ![Obj]

  /**
   * Transform Cache
   */
  TRANSFORM_CACHE_TEST: !map<string, Transform>

  /**
   * TypeMetasCache Returns - Persistables, Canonicals and Expression Engine TypeMetas
   */
  TYPE_METAS_CACHE_TEST: !map<string, Transform>

}
