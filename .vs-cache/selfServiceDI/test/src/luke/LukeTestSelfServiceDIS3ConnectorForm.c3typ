/**
 * A test component for the S3 Connector Form
 */
type LukeTestSelfServiceDIS3ConnectorForm mixes LukeTestSelfServiceDIConnectorForm {

  /**
   * Selector to click and open the dropdown options for the region.
   */
  regionDropdownSelector: string = '.c3-sdl-form-section:nth-of-type(2) .form-section-item:nth-child(2) .c3-select-field-dropdown'

  /**
   * Selector to select an option from dropdown for the region.
   */
  regionDropdownOptionSelector: string = '.c3-sdl-form-section:nth-of-type(2) .form-section-item:nth-child(2) .c3-select-field-dropdown .menu'

  /**
   * Selector to clear the selected option for the region.
   */
  regionDropdownClearSelector: string = '.c3-sdl-form-section:nth-of-type(2) .form-section-item:nth-child(3) .delete'

  /**
   * Selects the bucket region for the available options.
   *
   * @param value
   *          The value to be set.
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  selectBucketRegion: inline member function(value: string, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the selected bucket region of the connector.
   *
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  getSelectedBucketRegion: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Clears the selected bucket region of the connector.
   *
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  clearSelectedBucketRegion: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Sets the access key of the connector
   *
   * @param value
   *          The value to be set.
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  setAccessKey: inline member function(value: string, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the access key of the connector
   *
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  getAccessKey: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Asserts the error of the access key field of the connector
   *
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  hasAccessKeyError: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Sets the secret key of the connector
   *
   * @param value
   *          The value to be set.
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  setSecretKey: inline member function(value: string, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the secret key of the connector
   *
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  getSecretKey: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the error of the secret key field of the connector
   *
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  hasSecretKeyError: inline member function(timeout: int): LukeAsyncQueueNode js
}
