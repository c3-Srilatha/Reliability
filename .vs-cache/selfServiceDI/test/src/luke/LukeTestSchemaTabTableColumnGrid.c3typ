/**
 * A test component for table column grid in schema tab
 */
type LukeTestSchemaTabTableColumnGrid mixes LukeTestUiSdlDataGrid {

  /**
   * The selector for the table column grid in the schema tab
   */
  gridSelector: ~

  /**
   * The selector for the column alias in a grid cell
   */
  columnAliasSelector: string = ".source-type-edit-cell input"

  /**
   * The selector for the column description in a grid cell
   */
  columnDescriptionSelector: string = ".source-type-edit-cell input"

  /**
   * The selector for the column dataType in a grid cell
   */
  dataTypeSelector: string = "input[class='search']"

  /**
   * The selector for the dataType Value
   */
  dataTypeValueSelector: string = ".dropdown > .text:not(.default)"

  /**
   * The selector for a dropdown option span
   */
  optionSelector: string = "div[role='option'] .c3-sdl-select-field-dropdown-label"

  /**
   * The selector for disabled inputs
   */
  disabledSelector: string = ".c3-form-group-disabled"

  /**
   * The selector for not disabled inputs
   */
  notDisabledSelector: string = ".c3-form-group"

  /**
   * The selector for schema mismatch error in a grid cell
   */
  columnMismatchErrorSelector: string = ".schema-mismatch-cell .mismatch-error"

  /**
   * The selector for the hint text error in a grid cell
   */
  inputHintTextSelector: string = ".source-type-edit-cell .c3-form-field-hint"

  /**
   * The selector for the checkbox in a grid row
   */
  checkboxSelector: string = "input.k-checkbox"

  /**
   * The selector for the checkbox in a grid row
   */
  headerCheckboxSelector: string = ".k-grid-header .k-checkbox-label"

  /**
   * Gets the column alias for a given row (1-indexed)
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the text of the column alias in the given row
   */
  columnAlias: inline member function(checkBoxExists: boolean,rowIndex: !int, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the column description for a given row (1-indexed)
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the text of the column description in the given row
   */
  columnDescription: inline member function(checkBoxExists: boolean, rowIndex: !int, timeout: int): LukeAsyncQueueNode js

   /**
    * Gets the column dateTime for a given row (1-indexed)
    *
    * @param rowIndex
    *           The index of the row (1-indexed).
    * @param timeout
    *           Timeout in seconds for the chain.
    * @return a {@link LukeAsyncQueueNode} that will be resolved with the text of the column description in the given row
    */
   columnDateTime: inline member function(checkBoxExists: boolean, rowIndex: !int, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the dataType for a given row (1-indexed)
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the text of the dataType in the given row
   */
  dataType: inline member function(rowIndex: !int, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the disabled dataType for a given row (1-indexed)
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the text of the dataType in the given row
   */
  disabledDataType: inline member function(rowIndex: !int, timeout: int): LukeAsyncQueueNode js

  /**
   * Returns when the input for a given row is disabled (1-indexed)
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the disabled element if it exists
   */
  rowInputDisabled: inline member function(rowIndex: !int, colIndex: !int, timeout: int): LukeAsyncQueueNode js

  /**
   * Returns when the input for a given row is not disabled (1-indexed)
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the not disabled element if it exists
   */
  rowInputNotDisabled: inline member function(rowIndex: !int, colIndex: !int, timeout: int): LukeAsyncQueueNode js

  /**
   * Select or deselect a row with the given index.
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the select checkbox is clicked
   */
  selectRow: inline member function(rowIndex: !int, timeout: int): LukeAsyncQueueNode js

  /**
   * Select or deselect a header in the grid
   *
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the select checkbox is clicked
   */
  selectHeader: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Sets the column alias for a given index
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param alias
   *           The alias to be set
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the column alias is set
   */
  setColumnAlias: inline member function(checkBoxExists: boolean, rowIndex: !int, alias: string, timeout: int): LukeAsyncQueueNode js

  /**
   * Sets the column description for a given index
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param description
   *           The description to be set
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the column description is set
   */
  setColumnDescription: inline member function(checkBoxExists: boolean, rowIndex: !int, description: string, timeout: int): LukeAsyncQueueNode js

  /**
   * Sets the dataType for a given index
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param dataType
   *           The dataType to be set
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the column dataType is set
   */
  setDataType: inline member function(rowIndex: !int, dataType: string, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the column mismatch error of a table column
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the column mismatch error
   */
  columnMismatchError: inline member function(rowIndex: !int, colIndex: !int, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the column alias error of a table column
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the column alias error
   */
  columnAliasError: inline member function(checkBoxExists: boolean, rowIndex: !int, alias: string, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the column description error of a table column
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the column description error
   */
  columnDescriptionError: inline member function(checkBoxExists: boolean, rowIndex: !int, alias: string, timeout: int): LukeAsyncQueueNode js


  /**
   * Gets the dateTime error of a table column
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the column description error
   */
  columnDateTimeError: inline member function(checkBoxExists: boolean, rowIndex: !int, alias: string, timeout: int): LukeAsyncQueueNode js

  /**
   * Sets the dateTime for a given index
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param description
   *           The description to be set
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the column description is set
   */
  setColumnDateTime: inline member function(checkBoxExists: boolean, rowIndex: !int, description: string, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the column Alias values similar to {@link UiSdlDataGrid#getTextForCellsInColumn}
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the column description error
   */
  getColumnAliases: inline member function(checkBoxExists: boolean, timeout: int): LukeAsyncQueueNode js
}
