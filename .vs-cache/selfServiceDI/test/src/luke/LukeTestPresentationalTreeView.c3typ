/**
 * A test component for the LukeTestPresentationalTreeView
 */
type LukeTestPresentationalTreeView mixes LukeTestComponent {

  /**
   * The parent selector for the presentationalTreeView component.
   */
  parentSelector: ~ = '.presentational-tree-view-container'

  /**
   * The selector for whether a node is selected
   */
  selectedSelector: string = '.is-node-selected'

  /**
   * The selector for a tree node container
   */
  treeNodeContainerSelector: inline member function(treeNodeId: string) js

  /**
   * Click on presentational tree node's action based on index
   *
   * @param treeNodeId
   *           The ID of the tree node to be clicked.
   */
  treeNodeActionClick: inline member function(treeNodeId: string, actionIndex: int) js

  /**
   * Click on presentational tree node
   *
   * @param treeNodeId
   *           The ID of the tree node to be clicked.
   * @param timeout
   *           The timeout for the action
   * @return a Node that resolves to the click action
   */
  treeNodeClick: inline member function(treeNodeId: string, timeout: int) js

  /**
   * Simulates a click on a presentational tree node to toggle its expanded or collapsed state.
   *
   * @param treeNodeId
   *           The ID of the tree node to be clicked.
   * @return a click action and expand or collapse the tree node.
   */
  expandTreeNode: inline member function(treeNodeId: string) js

  /**
   * Simulates a click on a checkbox in a presentational tree node that is already selected.
   * This function is used to test that the checkbox can be deselected.
   *
   * @param treeNodeId
   *           The ID of the tree node whose checkbox is to be clicked.
   * @return a click action for check box
   */
  selectTreeNode: inline member function(treeNodeId: string) js

  /**
   * The selector for presentationalTreeNode with treeNodeId variable
   *
   * @param treeNodeId
   *                  the treeNodeId of the selector.
   * @return a selector for treeNodeTableName
   */
  treeNodeSelector: inline member function(treeNodeId: string) js

  /**
   * Filters the presentational tree nodes based on a search string.
   * This function is used to find a tree node that matches the provided search string.
   *
   * @param searchString
   *                  the searchString of the selector.
   * @return a search result for treeNodeSearch
   */
  filterTreeNode: inline member function(searchString: string) js

  /**
   * Checks the status of the children of a specific tree node based on their color.
   * This function is used to verify that the children of a tree node have the expected status.
   *
   * @param treeNodeId
   *                  the treeNodeId of the tree node.
   * @param color
   *                  the color of the tree node.
   * @return the status of the tree node
   */
  treeNodeChildrenStatus: inline member function(treeNodeId: string, color: string) js

  /**
   * Searches for a specific overlay icon in a tree node.
   *
   * @param treeNodeId
   *                  the treeNodeId of the tree node.
   * @param color
   *                  the color of the tree node.
   * @return a specific overlay icon in a tree node
   */
  treeNodeIconOverlay: inline member function(treeNodeId: string, color: string) js

  /**
   * Searches for a specific icon in a tree node.
   *
   * @param treeNodeId
   *                  the treeNodeId of the tree node.
   * @param icon
   *                  the icon of the tree node.
   * @return a specific icon in a tree node
   */
  treeNodeIcon: inline member function(treeNodeId: string, icon: string) js

  /**
   * Verifies the image of a specific tree node.
   *
   * @param treeNodeId
   *                  The ID of the tree node to check.
   * @param expectedImagePath
   *                  The expected image path for the tree node.
   * @return the assertion tree node image
   */
  verifyTreeNodeImage: inline member function(treeNodeId: string, expectedImagePath: string) js

  /**
   * Checks if a specific tree node is selected.
   *
   * @param treeNodeId
   *                  The ID of the tree node to check.
   * @return the assertion tree node is disabled
   */
  isTreeNodeSelected: inline member function(treeNodeId: string) js

  /**
   * Checks if a specific tree node is disabled.
   *
   * @param treeNodeId
   *                  The ID of the tree node to check.
   * @return the assertion tree node is disabled
   */
  isTreeNodeDisabled: inline member function(treeNodeId: string) js

  /**
   * Simulates unchecking a checkbox in the presentational tree view.
   *
   * @param treeNodeId
   *           the treeNodeId of the tree node.
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the click action is completed
   */
  unselectTreeNode: inline member function(treeNodeId: string, timeout: int): LukeAsyncQueueNode js
}
