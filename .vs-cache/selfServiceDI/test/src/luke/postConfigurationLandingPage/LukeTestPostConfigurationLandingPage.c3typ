type LukeTestPostConfigurationLandingPage mixes LukeTestSelfServiceDIConnector {

  /**
   * The Defintion List component for the landing page associated with this connector
   */
  landingPageConnectorNameAndDescription: LukeTestUiSdlDefinitionList

  /**
   * The presentationalTreeView with this page
   */
  presentationalTreeView: LukeTestPresentationalTreeView

  /**
   * The selector for the connection configuration modal
   */
  connectionConfigurationModalSelector: string = '.c3-metadata-id-selfservicedi-connectionconfigurationcontainer'

  /**
   * The selector for the connection configuration modal close button
   */
  connectionConfigurationXSelector: string = '.c3-button-times'

  /**
   * Verifies the tree view details
   */
  verifyTreeView: inline member function() js

  /**
   * Opens the landing page for the connector
   */
  openLandingPage: inline member function() js

  /**
   * Verifies the landing page details
   */
  verifyLandingPageDetails: inline member function() js

  /**
   * Creates an instance of the proper connector
   * based on the connector.name
   *
   * connector.name == 'kafka' => LukeTestPostConfigurationLandingPageKafka
   *
   * @param connector
   *           The connector to be created
   * @param lukeBrowserInstance
   *           The browser instance to be used
   * @return The connector instance
   */
  createInstance: function(connector: !json,
                           lukeBrowserInstance: LukeBrowser): LukeTestPostConfigurationLandingPage js
}
