/**
 * The Post Configuration Landing Page type for Cloud Message
 */
type LukeTestPostConfigurationLandingPageCloudMessage mixes LukeTestPostConfigurationLandingPage {

  /**
   * The connector category translation for the connector
   */
  connectorCategoryTranslationKey: ~ = 'SelfServiceDI.Ui.DataConnectorCategory.stream.label'

  /**
   * The selector for the Connector properties button
   */
  cloudMessageConnectorPropertiesButtonSelector: string = '.c3-button-link.c3-button-cd[aria-label="Connector properties"]'

  /**
   * The selector for the card content of the list of streams configured in the connector
   * that is viewable in the landing page
   */
  streamCardContentSelector: string = '.c3-sdl-card-content'

  verifyLandingPageDetails: ~ js
}
