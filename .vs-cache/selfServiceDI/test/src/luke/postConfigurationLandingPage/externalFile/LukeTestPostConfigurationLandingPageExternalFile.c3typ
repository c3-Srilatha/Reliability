/**
 * The Post Configuration Landing Page type for External File
 */
type LukeTestPostConfigurationLandingPageExternalFile mixes LukeTestPostConfigurationLandingPage {

  /**
   * The connector category translation for the connector
   */
  connectorCategoryTranslationKey: ~ = 'SelfServiceDI.Ui.DataConnectorCategory.file.label'

  /**
   * List of all the headers of the bucket details on external file landing page
   */
  bucketDetailsHeaders: [string] = ["BUCKET OR PATHS","TYPE","VERSIONING","CONTENTS","LOCATION","CONNECTION","FILE PATH SELECTION"]

  /**
   * The selector for the Estimate button
   */
  externalFileEstimateButtonSelector: string = '.c3-button-link.c3-button-cd[aria-label="Estimate"]'

  /**
   * The selector for the Connection properties button
   */
  externalFileConnectionPropertiesButtonSelector: string = '.c3-button-link.c3-button-cd[aria-label="Connection properties"]'

  verifyLandingPageDetails: ~ js
  getConnectorTreeViewId:   ~ js
}
