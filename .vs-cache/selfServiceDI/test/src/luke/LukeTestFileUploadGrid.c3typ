/**
 * A test component for table file upload grid in file Select Files and Set Schema Step
 */
type LukeTestFileUploadGrid mixes LukeTestUiSdlDataGrid {

  /**
   * Selector for the link to open the file preview grid
   */
   fileNameLinkSelector: string = '.text-element'

  /**
   * Selector for the delete icon for a row
   */
   deleteFileSelector: string = '.c3-button-trash'

  /**
   * Gets the file name for a given row (1-indexed)
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the text of the name in the given row
   */
  fileName: inline member function(rowIndex: !int, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the column status for a given row (1-indexed)
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the text of status in the given row
   */
  status: inline member function(rowIndex: !int, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the size for a given row (1-indexed)
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the text of the size in the given row
   */
  size: inline member function(rowIndex: !int, timeout: int): LukeAsyncQueueNode js

  /**
   * Returns when the input for a given row is disabled (1-indexed)
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the disabled element if it exists
   */
  warnings: inline member function(rowIndex: !int, timeout: int): LukeAsyncQueueNode js

  /**
   * Open the file preview grid for a given row
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the grid cell is clicked
   */
  filePreview: inline member function(rowIndex: !int, timeout: int): LukeAsyncQueueNode js

  /**
   * Remove a given row from the file grid
   *
   * @param rowIndex
   *           The index of the row (1-indexed).
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the cell action is clicked
   */
  deleteFile: inline member function(rowIndex: !int, timeout: int): LukeAsyncQueueNode js

}
