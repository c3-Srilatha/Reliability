/**
 * A test component for the Azure Connector Form
 */
type LukeTestSelfServiceDIAzureConnectorForm mixes LukeTestSelfServiceDIConnectorForm {

  /**
   * Sets the region.
   *
   * @param value
   *          The value to be set.
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  setRegion: inline member function(value: string, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the region.
   *
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  getRegion: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Asserts the error of the region field.
   *
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  hasRegionError: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Sets the access key
   *
   * @param value
   *          The value to be set.
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  setAccessKey: inline member function(value: string, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the access key.
   *
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  getAccessKey: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Asserts the error of the access key field.
   *
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  hasAccessKeyError: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Sets the account id.
   *
   * @param value
   *          The value to be set.
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  setAccountId: inline member function(value: string, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the account id.
   *
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  getAccountId: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Asserts the error of the access key field
   *
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  hasAccountIdError: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Sets the account name
   *
   * @param value
   *          The value to be set.
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  setAccountName: inline member function(value: string, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the account name
   *
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  getAccountName: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Asserts the error of the account name field
   *
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  hasAccountNameError: inline member function(timeout: int): LukeAsyncQueueNode js
}
