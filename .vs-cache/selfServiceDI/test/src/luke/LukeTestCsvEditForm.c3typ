/**
 * A test component for editing csv file settings in the file upload flow
 */
type LukeTestCsvEditForm mixes LukeTestUiSdlForm {

  /**
   * The selector for the CsvEditForm
   */
  parentSelector: ~ = '.c3-metadata-id-selfservicedi-csveditform .c3-sdl-form'

   /**
    * Sets delimiter for the dropdown
    *
    * @param optionName
    *         The optionName for the dropdown
    * @param timeout
    *         The timeout for luke
    * @returns an {@link LukeAsyncQueueNode} for clicking the dropdown
    */
   setDelimiter: inline member function(optionName: string, timeout: int): LukeAsyncQueueNode js

   /**
    * Sets quote for the dropdown
    *
    * @param optionName
    *         The optionName for the dropdown
    * @param timeout
    *         The timeout for luke
    * @returns an {@link LukeAsyncQueueNode} for clicking the dropdown
    */
   setQuote: inline member function(optionName: string, timeout: int): LukeAsyncQueueNode js

   /**
    * Sets escape for the dropdown
    *
    * @param optionName
    *         The optionName for the dropdown
    * @param timeout
    *         The timeout for luke
    * @returns an {@link LukeAsyncQueueNode} for clicking the dropdown
    */
   setEscape: inline member function(optionName: string, timeout: int): LukeAsyncQueueNode js
}
