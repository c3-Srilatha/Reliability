/**
 * A test component for InlineNotificationList
 */
type LukeTestInlineNotificationList mixes LukeTestComponent {

  /**
   * The selector for the inline notification list
   */
  parentSelector: ~ = '.inline-notification-list'

  /**
   * The selector for the inline notification title
   */
  titleSelector: string = '.inline-notification-title'

  /**
   * The selector for the inline notification link
   */
  linkTextSelector: string = '.inline-notification-link-text'

  /**
   * Returns the number of notifications in the inline notification list
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the number
   */
  numOfNotifications: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Returns title text of the ith (zero-indexed) inline notification
   * @param notificationIdx
   *          the ith index
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the title text
   */
  getTitleText: inline member function(notificationIdx: !int, timeout: int): LukeAsyncQueueNode js

  /**
   * Returns link text of the ith (zero-indexed) inline notification
   * @param notificationIdx
   *          the ith index
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved with the link text
   */
  getLinkText: inline member function(notificationIdx: !int, timeout: int): LukeAsyncQueueNode js

  /**
   * Clicks on the link of the ith (zero-index) inline notification
   * @param notificationIdx
   *          the ith index
   * @param timeout
   *          Timeout in seconds for the chain
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the click happens
   */
  clickLink: inline member function(notificationIdx: !int, timeout: int): LukeAsyncQueueNode js
}
