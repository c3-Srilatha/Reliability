/**
 * A test component for schema tab
 */
type LukeTestSelfServiceDISchemaTab mixes LukeTestComponent {

  /**
   * The selector for the save button
   */
  saveButtonSelector: string = ".c3-metadata-id-selfservicedi-externalsourceschemaeditsavebutton button"

  /**
   * The selector for the cancel button
   */
  cancelButtonSelector: string = ".c3-metadata-id-selfservicedi-externalsourceschemaeditcancelbutton button"

  /**
   * The selector for the edit button
   */
  editButtonSelector: string = ".c3-metadata-id-selfservicedi-externalsourceschemaeditbutton button"

  /**
   * The selector for the edit page container
   */
  editPageContainer: string = ".c3-metadata-id-selfservicedi-externalsourcetablenameandbuttoncontainer"

  /**
   * The table name definition list in the schema tab
   */
  tableNameList: LukeTestUiSdlDefinitionList

  /**
   * The table column grid component in the schema tab
   */
  tableColumnGrid: LukeTestSchemaTabTableColumnGrid

  /**
   * The table description form in the schema tab
   */
  tableDescriptionForm: LukeTestUiSdlForm

  /**
   * The error inline notification component in the schema tab
   */
  errorInlineNotification: LukeTestUiSdlInlineNotification

  /**
   * Assert on whether we are in preview mode of the schema tab
   *
   * @param timeout
   *           Timeout in seconds for the chain.
   */
  inPreviewMode: inline member function(timeout: int) js

  /**
   * Assert on whether we are in edit mode of the schema tab
   *
   * @param timeout
   *           Timeout in seconds for the chain.
   */
  inEditMode: inline member function(timeout: int) js

  /**
   * Start editing schema by clicking on the edit button in preview mode
   *
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the edit button is clicked
   */
  editSchema: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Save the edited schema by clicking on the save button in edit mode
   *
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the save button is clicked
   */
  saveSchemaChange: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Cancel the edited schema by clicking on the cancel button in edit mode
   *
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the cancel button is clicked
   */
  cancelSchemaChange: inline member function(timeout: int): LukeAsyncQueueNode js
}
