/**
 * A test component for the main page on SelfServiceDI
 */
type LukeTestSelfServiceDIConnectorForm mixes LukeTestUiSdlForm {

  /**
   * The selector for the connector form
   */
  parentSelector: ~ = '.c3-metadata-id-selfservicedi-connectorform'

  /**
   * The CSS selector for the "Test Connection" button in the SelfServiceDI multi-step component.
   * This selector is used to identify the "Test Connection" button in the DOM.
   */
  testConnectionButtonSelector: string = '.c3-metadata-id-selfservicedi-testconnectionbutton .c3-button-link'

  /**
   * The CSS selector to get the "Test Connection" status.
   */
  testConnectionStatusSelector: string = '.c3-metadata-id-selfservicedi-status .text-element'

  /**
   * Sets the name of the connector
   *
   * @param value
   *          The value to be set.
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  setName: inline member function(value: string, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the name of the connector
   *
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  getName: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the error of the name field of the connector
   *
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  getNameError: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Sets the description of the connector
   * @param value
   *          The value to be set.
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  setDescription: inline member function(value: string, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the description of the connector
   *
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  getDescription: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the error of the description field of the connector
   *
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  getDescriptionError: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Simulates a click on the "Test Connection" button in the Self Service DI multi-step component.
   * This function is used to test that the "Test Connection" button works correctly.
   *
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the click action is completed
   */
  clickTestConnectionButton: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Returns the status of the connection after testing.
   *
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the click action is completed
   */
  getTestConnectionStatus: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Selector to click and open the dropdown options for bucket url.
   */
  bucketUrlDropDownSelector: string = '.c3-sdl-form-section:nth-of-type(2) .form-section-item:nth-child(1) .c3-select-field-dropdown'

  /**
   * Selector to set the input value of the bucket url.
   */
  bucketUrlDropDownInputSelector: string = '.c3-sdl-form-section:nth-of-type(2) .form-section-item:nth-child(1) .c3-select-field-dropdown input'

  /**
   * Selector to select 1st option from dropdown for the bucket url.
   */
  bucketUrlDropDownInputOption1Selector: string = '.c3-sdl-form-section:nth-of-type(2) .form-section-item:nth-child(1) .c3-select-field-dropdown .menu div:nth-of-type(1)'

  /**
   * Selector to select an option from dropdown for the bucket url.
   */
  bucketUrlDropDownInputOptionSelector: string = '.c3-sdl-form-section:nth-of-type(2) .form-section-item:nth-child(1) .c3-select-field-dropdown .menu'

  /**
   * Selector to clear the selected option for the bucket url.
   */
  bucketUrlDropdownClearSelector: string = '.c3-sdl-form-section:nth-of-type(2) .form-section-item:nth-child(1) .delete'

  /**
   * Sets the new bucket url of the connector.
   * @param value
   *          The value to be set.
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  setNewBucketUrl: inline member function(value: string, timeout: int): LukeAsyncQueueNode js

  /**
   * Sets the new bucket url of the connector.
   * @param value
   *          The value to be set.
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  selectNewBucketUrl: inline member function(value: string, timeout: int): LukeAsyncQueueNode js

  /**
   * Gets the bucket url.
   *
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  getBucketUrl: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Clears the bucket url.
   *
   * @param timeout
   *          Timeout in seconds for the async chain
   * @return a {@link LukeAsyncQueueNode}.
   */
  clearSelectedBucketUrl: inline member function(timeout: int): LukeAsyncQueueNode js
}
