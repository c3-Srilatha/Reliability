/**
 * A test component for the add data source step
 */
type LukeTestAddDataSourceStep mixes LukeTestComponent {

  /**
   * The selfServiceDIPage associated with this step
   */
  selfServiceDIPage: LukeTestSelfServiceDIPage

  /**
   * Add a data source and verify that the data source is added to the data sources side panel
   * @param isUnconfiguredApp
   *           A boolean indicating whether an unconfigured/ fresh app is being used, defaulted to true
   * Steps:
   * 1. Open the page
   * 2. Assert that the page is rendered
   * 3. Assert that the data sources tree view is empty
   * 4. Assert that the landing page is empty
   * 5. Click the Add Data Source button
   * 6. Assert that the multi-step component is open
   * 7. Assert that the multi-step component only has two steps
   * 8. Assert that the first step is "Select data connector"
   * 9. Assert that the second step is "Configure data connector"
   * 10. Assert that the first step is the current rendered step
   */
  addDataSourceFlow: inline member function(isUnconfiguredApp: boolean) js
}
