/**
 * A test page for the selfServiceDI main flow
 */
type LukeTestSelfServiceDIPage mixes LukeTestPage {

  /**
   * The path of the URL
   */
  path: ~ = 'datafusion'

  renderingSelectors: ~ = ['.c3-metadata-id-selfservicedi-externalsourcescontainerhomepage', '.c3-metadata-id-selfservicedi-externalsourcessidepanel']

  /**
   * The ExternalSources Side Panel associated with this page
   */
  externalSourcesSidePanel: LukeTestUiSdlSidePanel

  /**
   * The connectorForm associated with this page
   */
  connectorForm: LukeTestSelfServiceDIConnectorForm

  /**
   * The datagrid with this page
   */
  dataGrid: LukeTestPreviewSqlTableDataGrid

  /**
   * The  Tab Panel associated with this page
   */
  tabPanel: LukeTestSelfServiceDITabPanel

  /**
   * The datagrid for the with this page
   */
  externalSourceDetailsCheckboxGrid: LukeTestExternalSourceDetailsCheckboxGrid

  /**
   * The datagrid with this page
   */
  externalSourceDetailsGrid: LukeTestExternalSourceDetailsGrid

  /**
   * The multiStepComponent with this page
   */
  multiStepComponent: LukeTestMultiStepComponent

  /**
   * The presentationalTreeView with this page
   */
  presentationalTreeView: LukeTestPresentationalTreeView

  /**
   * The information card list with this page
   */
  informationCardList: LukeTestInformationCardList

  /**
   * The selectDataConnectorStep with this page
   */
  selectDataConnectorStep: LukeTestSelectDataConnectorStep

  /**
   * The selector for sidePanelTreeviewEmptyStateSelector
   */
  sidePanelTreeviewEmptyStateSelector: string = '.c3-metadata-id-selfservicedi-sidepaneltreeviewemptystate'

  /**
   * The selector for externalSourcesEmptyStateSelector
   */
  externalSourcesEmptyStateSelector: string = '.c3-metadata-id-selfservicedi-externalsourcesemptystate'

  /**
   * The selector for addDataSourceButtonSelector
   */
  addDataSourceButtonSelector: string = '.c3-metadata-id-selfservicedi-adddatasourcebutton .c3-button-link'

  /**
   * The selector for fileUploadButtonSelector
   */
  fileUploadButtonSelector: string = '.data-connector-categories-list-container button[aria-label="File Upload"]'

  /**
   * The file upload component integrated as a child of this page
   */
  fileUpload: LukeTestUiSdlFileUpload

  /**
   * click on addDataSourceButtonSelector
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the click action is completed
   */
  addDataSource: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Initiates the file upload process in the selfServiceDI.
   *
   * @param files
   *         An array of file objects to be uploaded.
   */
  startFileUploadFlow: inline member function(files: [string]): LukeAsyncQueueNode js

  /**
   * Ensure the correct tab is loaded when we open the page
   *
   * @param tabTitle
   *           The name of a node that is rendered during initialization.
   * @param timeout
   *           The timeout for the page to render
   */
  openPage: inline member function(tabTitle: string, timeout: int) js

  /**
   * The selector for the empty treeview state in the data sources side panel
   *
   *
   * @return a selector for the empty treeview state in the data sources side panel
   */
  dataSourcesEmptyTreeView: inline member function() js

  /**
   * The selector for the empty landing page state in the data sources page
   *
   *
   * @return a selector for the empty landing page state in the data sources page
   */
  landingPageEmptyState: inline member function() js
}
