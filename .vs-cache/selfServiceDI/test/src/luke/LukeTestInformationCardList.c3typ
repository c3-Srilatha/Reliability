/**
 * A test component for the main page on SelfServiceDI
 */
type LukeTestInformationCardList mixes LukeTestComponent {

  /**
   * The selector for the InformationCardList
   */
  parentSelector: ~ = '.data-connector-categories-list-container'

  /**
   * The selector for the individual connector information cards
   */
  informationCardSelector: string = '.information-card'

  /**
   * The selector for the currently selected connector information card
   */
  informationCardSelectedSelector: string = '.information-card-parent.selected'

  /**
   * The selector for the information card title
   */
  informationCardTitleSelector: string = '.information-card-title'

  /**
   * The selector for the information card subtitle
   */
  informationCardSubtitleSelector: string = '.information-card-subtitle'

  /**
   * Simulates a click on a informationCardList at a given information card name
   *
   * @param informationCardName
   *           The name of the information card
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the click action is completed
   */
  selectInfoCardItem: inline member function(informationCardName: string, timeout: int): LukeAsyncQueueNode js

  /**
   * Simulates search for informationCardList at a given information card name
   *
   * @param informationCardName
   *           The name of the information card
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the click action is completed
   */
  searchInfoCardItem: inline member function(informationCardName: string, timeout: int): LukeAsyncQueueNode js
}
