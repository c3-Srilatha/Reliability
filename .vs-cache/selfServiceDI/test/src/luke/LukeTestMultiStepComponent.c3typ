/**
 * A test component for the LukeTestMultiStepComponent
 */
type LukeTestMultiStepComponent mixes LukeTestComponent {

  rendered:    ~ js-client
  notRendered: ~ js-client

  /**
   * The parent selector for the multi-step component.
   */
  parentSelector: ~ = '.multi-step-component'

  /**
   * The CSS selector for the "Next" button in the multi-step component.
   */
  multiStepComponentNextSelector: string = '.multi-step-component-footer .c3-button-primary'

  /**
   * The CSS selector for the "Back" button in the multi-step component.
   */
  multiStepComponentBackSelector: string = '.multi-step-component-footer .c3-button-secondary'

  /**
   * The CSS selector for the "Cancel" button in the multi-step component.
   */
  multiStepComponentCancelSelector: string = '.multi-step-component-footer .c3-button-link'

  /**
   * The CSS selector for the current step in the multi-step component.
   */
  multiStepComponentCurrentStepSelector: string = '.multi-step-progress-steps .current-step'

  /**
   * Simulates a click on the "Next" button in the multi-step component.
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the click action is completed
   */
  proceed: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Simulates a click on the "Back" button in the multi-step component.
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the click action is completed
   */
  back: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Simulates a click on the "Cancel" button in the multi-step component.
   * @param timeout
   *           Timeout in seconds for the chain.
   * @return a {@link LukeAsyncQueueNode} that will be resolved when the click action is completed
   */
  cancel: inline member function(timeout: int): LukeAsyncQueueNode js

  /**
   * Returns the Nth step requested (1-indexed)
   * @param n
   *         The step number you would like to get (1-indexed)
   * @return the nth step
   */
  getNthStep: inline member function(n: int) js

  /**
   * Returns the title of the step requested
   * @param stepNumber
   *         The step number you would like to get the title of
   * @return the title of the step
   */
  getStepTitle: inline member function(stepNumber: int) js

  /**
   * Asserts that the current step is the step number provided
   * @param stepNumber
   *         The step number you would like to assert is the current step
   */
  assertCurrentRenderedStep: inline member function(stepNumber: int) js

  /**
   * A function to verify the color of a step
   * @param step
   *           The step to verify
   * @param expectedColor
   *           The expected color of the step
   */
  verifyStepColor: inline member function(step: int, expectedColor: string) js

  /**
   * Verifies that step one is rendered
   */
  verifyStepOneRendered: inline member function() js
}
