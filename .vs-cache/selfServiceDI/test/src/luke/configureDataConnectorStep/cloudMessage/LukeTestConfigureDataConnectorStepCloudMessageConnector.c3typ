/**
 * The connector type for Cloud Message connectors which holds shared items of all Cloud Message connectors
 */
type LukeTestConfigureDataConnectorStepCloudMessageConnector mixes LukeTestSelfServiceDIConfigureDataConnectorStep {

  /**
   * Function that verifies the landing page with specifics of the CloudMessageConnectors
   */
  verifyLandingPage: inline member function() js

  /**
   * The connector category translation for the connector
   */
  connectorCategoryTranslationKey: ~ = 'SelfServiceDI.Ui.DataConnectorCategory.stream.label'

  /**
   * The selector for the card content of the list of streams configured in the connector
   * that is viewable in the landing page
   */
  streamCardContentSelector: string = '.c3-sdl-card-content'
}
