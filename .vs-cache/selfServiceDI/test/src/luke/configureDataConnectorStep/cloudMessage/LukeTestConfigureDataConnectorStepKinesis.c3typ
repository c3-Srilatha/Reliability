/**
 * The connector type for Cloud Message connectors which holds shared items of all Cloud Message connectors
 */
type LukeTestConfigureDataConnectorStepKinesis mixes LukeTestConfigureDataConnectorStepCloudMessageConnector {

  getCredentials: ~ js

  /**
   * Verifies the form for a failed connection
   * @param credentials
   *           The inputted credentials to be given in the form for the connector
   *              Region
   *                The region to be given in the form for the connector
   *               streamName
   *                The broker name to be given in the form for the connector
   *              accessKey
   *                The access key to be given in the form for the connector
   *              secretKey
   *                The secret key to be given in the form for the connector
   * @param errorMessageKey
   *           The error message key to be given in the form for the connector
   * @param assertionDescription
   *           The description to be given if the assertion fails
   */
  verifyFormError: ~(credentials: AwsCredentials, errorMessageKey: string, assertionDescription: string) js

  /**
   * Verifies the form for a successful connection
   * @param credentials
   *           The inputted credentials to be given in the form for the connector
   *              region
   *                The region to be given in the form for the connector
   *               streamName
   *                The broker name to be given in the form for the connector
   *              accessKey
   *                The access key to be given in the form for the connector
   *              secretKey
   *                The secret key to be given in the form for the connector
   */
  verifyFormSuccess: ~ js

  generateInvalidInput:           ~(key: string) js
  additionalCredentialFormErrors: ~ = [ { invalidCredentialFields: [ 'region','streamName','accessKey', 'secretKey'], errorMessageKey: 'SelfServiceDI.DataConnectorForm.currentConnectStatus.InvalidAccessOrSecretKeys.text', assertionDescription:'Inline error message not found for invalid credentials for all fields' }, { invalidCredentialFields: ['accessKey'], errorMessageKey:'SelfServiceDI.DataConnectorForm.currentConnectStatus.InvalidAccessOrSecretKeys.text', assertionDescription: 'Inline error message not found for invalid credentials for accessKey' }, { invalidCredentialFields: [ 'secretKey' ], errorMessageKey:'SelfServiceDI.DataConnectorForm.currentConnectStatus.genericError.text', assertionDescription: 'Inline error message not found for invalid credentials for secretKey' } ]
}
