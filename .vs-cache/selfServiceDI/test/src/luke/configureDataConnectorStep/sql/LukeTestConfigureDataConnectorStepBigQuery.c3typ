/**
 * The connector type for BigQuery connectors
 */
type LukeTestConfigureDataConnectorStepBigQuery mixes LukeTestConfigureDataConnectorStepSqlConnector {

  getCredentials: ~ js

  /**
   * Verifies the form for a failed connection
   * @param credentials
   *           The inputted credentials to be given in the form for the connector
   *           clientId
   *           accessToken
   *           refreshToken
   *           projectId
   *           clientSecret
   * @param errorMessageKey
   *           The error message key to be given in the form for the connector
   * @param assertionDescription
   *           The description to be given if the assertion fails
   */
  verifyFormError: ~(credentials: googlebigquery, errorMessageKey: string, assertionDescription: string) js

  /**
   * Verifies the form for a successful connection
   * @param credentials
   *           clientId
   *           accessToken
   *           refreshToken
   *           projectId
   *           clientSecret
   */
  verifyFormSuccess: ~ js

  generateInvalidInput:           ~(key: string) js
  additionalCredentialFormErrors: ~ = [ { invalidCredentialFields: ['clientId'], errorMessageKey: 'SelfServiceDI.DataConnectorForm.currentConnectStatus.invalidClientId.text', assertionDescription:'Inline error message not found for invalid clientId' }, { invalidCredentialFields: ['clientSecret'], errorMessageKey: 'SelfServiceDI.DataConnectorForm.currentConnectStatus.invalidCredentials.text', assertionDescription:'Inline error message not found for invalid clientSecret' }, ]
}
