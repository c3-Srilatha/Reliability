/**
 * The connector type for Service Now connectors
 */
type LukeTestConfigureDataConnectorStepServiceNow mixes LukeTestConfigureDataConnectorStepSqlConnector {

  getCredentials: ~ js

  /**
   * Verifies the form for a failed connection
   * @param credentials
   *           The inputted credentials to be given in the form for the connector
   *           url
   *           username
   *           password
   * @param errorMessageKey
   *           The error message key to be given in the form for the connector
   * @param assertionDescription
   *           The description to be given if the assertion fails
   */
  verifyFormError: ~(credentials: servicenow, errorMessageKey: string, assertionDescription: string) js

  /**
   * Verifies the form for a successful connection
   * @param credentials
   *           url
   *           username
   *           password
   */
  verifyFormSuccess: ~ js

  additionalCredentialFormErrors: ~ = [ { invalidCredentialFields: [ 'url'], errorMessageKey: 'SelfServiceDI.DataConnectorForm.currentConnectStatus.invalidHostOrPort.text', assertionDescription:'Inline error message not found for invalid url' }, { invalidCredentialFields: [ 'username'], errorMessageKey: 'SelfServiceDI.DataConnectorForm.currentConnectStatus.invalidUserNameOrPassword.text', assertionDescription:'Inline error message not found for invalid username' }, { invalidCredentialFields: [ 'password'], errorMessageKey: 'SelfServiceDI.DataConnectorForm.currentConnectStatus.invalidUserNameOrPassword.text', assertionDescription:'Inline error message not found for invalid password' }, ]
}
