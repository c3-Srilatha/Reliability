/**
 * The connector type for Google Cloud
 */
type LukeTestConfigureDataConnectorStepGoogleCloud mixes LukeTestConfigureDataConnectorStepExternalFileConnector {

  getCredentials:         ~ js
  getConnectorTreeViewId: ~ js
  fileUpload:             LukeTestUiSdlFileUpload

  /**
   * Verifies the form for a failed connection
   * @param credentials
   *           The inputted credentials to be given in the form for the connector
   *           fileName
   *           bucket
   * @param errorMessageKey
   *           The error message key to be given in the form for the connector
   * @param assertionDescription
   *           The description to be given if the assertion fails
   */
  verifyFormError: ~(credentials: GcpCredentials, errorMessageKey: string, assertionDescription: string) js

  /**
   * Verifies the form for a successful connection
   * @param credentials
   *           fileName
   *           bucket
   */
  verifyFormSuccess: ~ js

  generateInvalidInput:           ~(key: string) js
  additionalCredentialFormErrors: ~ = [ { invalidCredentialFields: [ 'fileName'], errorMessageKey: 'SelfServiceDI.DataConnectorForm.currentConnectStatus.InvalidAccessOrSecretKeys.text', assertionDescription:'Inline error message not found for invalid fileName' }, { invalidCredentialFields: [ 'bucket'], errorMessageKey: 'SelfServiceDI.DataConnectorForm.currentConnectStatus.InvalidBucket.text', assertionDescription:'Inline error message not found for invalid bucket' }, ]
}
