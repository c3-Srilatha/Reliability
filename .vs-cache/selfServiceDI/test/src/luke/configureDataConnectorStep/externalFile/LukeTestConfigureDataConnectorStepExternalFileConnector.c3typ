/**
 * The connector type for Exteral file Message connectors which holds shared items of all Cloud Message connectors
 */
type LukeTestConfigureDataConnectorStepExternalFileConnector mixes LukeTestSelfServiceDIConfigureDataConnectorStep {

  /**
   * The connector category translation for the connector
   */
  connectorCategoryTranslationKey: ~ = 'SelfServiceDI.Ui.DataConnectorCategory.file.label'

  /**
   * The selector for the bucket dropdown input in the connector form
   */
  bucketDropdownInputSelector: string = '.ui.search.dropdown.c3-select-field-dropdown input'

  /**
   * The selector for the new url option in the bucket dropdown
   */
  bucketDropdownNewUrlSelector: string = '.text.c3-sdl-actionable-option'

  /**
   * Function to set the bucket url in the connector form
   * @param bucketUrl the bucket url string to set in the dropdown
   */
  setBucketUrl: inline member function(bucketUrl: string) js
}
