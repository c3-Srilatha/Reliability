/**
 * The connector type for S3
 */
type LukeTestConfigureDataConnectorStepS3 mixes LukeTestConfigureDataConnectorStepExternalFileConnector {

  getCredentials:         ~ js
  getConnectorTreeViewId: ~ js

  /**
   * The selector for the region dropdown caret
   */
  regionDropdownSelector: string = 'div[field="region"] + .c3-sdl-icon-group.flex i.c3-icon-caret-down'

  /**
   * Verifies the form for a failed connection
   * @param credentials
   *           The inputted credentials to be given in the form for the connector
   *           accessKey
   *           secretKey
   *           region
   *           bucket
   * @param errorMessageKey
   *           The error message key to be given in the form for the connector
   * @param assertionDescription
   *           The description to be given if the assertion fails
   */
  verifyFormError: ~(credentials: AwsCredentials, errorMessageKey: string, assertionDescription: string) js

  /**
   * Verifies the form for a successful connection
   * @param credentials
   *           accessKey
   *           secretKey
   *           region
   *           bucket
   */
  verifyFormSuccess: ~ js

  generateInvalidInput:           ~(key: string) js
  additionalCredentialFormErrors: ~ = [ { invalidCredentialFields: [ 'accessKey'], errorMessageKey: 'SelfServiceDI.DataConnectorForm.currentConnectStatus.InvalidAccessOrSecretKeys.text', assertionDescription:'Inline error message not found for invalid accessKey' }, { invalidCredentialFields: [ 'secretKey'], errorMessageKey: 'SelfServiceDI.DataConnectorForm.currentConnectStatus.InvalidAccessOrSecretKeys.text', assertionDescription:'Inline error message not found for invalid secretKey' }, { invalidCredentialFields: [ 'region'], errorMessageKey: 'SelfServiceDI.DataConnectorForm.currentConnectStatus.InvalidBucketRegion.text', assertionDescription:'Inline error message not found for invalid region' }, { invalidCredentialFields: [ 'bucket'], errorMessageKey: 'SelfServiceDI.DataConnectorForm.currentConnectStatus.InvalidBucket.text', assertionDescription:'Inline error message not found for invalid bucket' }, ]
}
