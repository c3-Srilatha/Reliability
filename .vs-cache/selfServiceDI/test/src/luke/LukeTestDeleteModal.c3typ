/**
 * A test component for the delete modal in SelfServiceDI.
 * This component provides methods to interact with the delete modal, 
 * including clicking buttons and verifying modal text.
 */
type LukeTestDeleteModal mixes LukeTestUiSdlModal {

  /**
   * Simulates a click on the danger (delete) button in the modal.
   *
   * @return a {@link LukeAsyncQueueNode} that resolves when the button is clicked.
   */
  deleteButtonClick: inline member function(): LukeAsyncQueueNode js

  /**
   * Verifies that the header text of the modal matches the expected text.
   *
   * @param text The expected header text.
   * @return a {@link LukeAsyncQueueNode} that resolves when the verification is complete.
   */
  correctHeaderText: inline member function(text: string): LukeAsyncQueueNode js

  /**
   * Verifies that the content text of the modal matches the expected text.
   *
   * @param text The expected content text.
   * @return a {@link LukeAsyncQueueNode} that resolves when the verification is complete.
   */
  correctContentText: inline member function(text: string): LukeAsyncQueueNode js

  /**
   * Simulates a click on the cancel button in the modal.
   *
   * @return a {@link LukeAsyncQueueNode} that resolves when the button is clicked.
   */
  cancelButtonClick: inline member function(): LukeAsyncQueueNode js
}
