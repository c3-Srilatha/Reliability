/**
 * Mock auth type for testing {@link GenaiCore.Llm.Auth} and {@link GenaiCore.Llm.Auth.Secret} implementations.
 * Second type needed to ensure that clearAllConfigAndSecretOverridesForAuthType does not affect config instances
 * of other auth subtypes.
 */
type GenaiCore.Llm.Mock.OtherAuth mixes GenaiCore.Llm.Auth {
  /**
   * The non-secret string.
   */
  nonSecretString: string

  /**
   * The non-secret integer.
   */
  nonSecretInt: int

  /**
   * The secret string.
   */
  @config(secret=true)
  secretString: string
}
