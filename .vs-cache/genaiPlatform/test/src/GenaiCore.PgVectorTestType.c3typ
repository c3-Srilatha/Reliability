/**
 * Example entity vector type, used to test {@link GenaiCore.VectorStore.Pg}.
 */
entity type GenaiCore.PgVectorTestType mixes GenaiCore.Vector {

  /**
   * The text of the entity.
   */
  text: string

  /**
   * The vector of the entity.
   */
  @vector(dimension=5)
  emb1: string

  /**
   * The second vector of the entity.
   */
  @vector(dimension=5)
  emb2: string

  /**
   * The page number
   */
  pageNumber: int

  /**
   * The chunk number
   */
  chunkNumber: int

  /**
   * The document
   */
  doc: GenaiCore.DocumentTestType

  /**
   * The tags
   */
  tags: [string]
}
