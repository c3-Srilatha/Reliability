/**
 * Test vector to be used with {@link GenaiCore.Unstructured.Job}.
 */
entity type GenaiCore.TestChunkVector mixes GenaiCore.Vector {

  /**
   * The number of chunks that was produced from the corresponding source.
   */
  totalChunks: int

  /**
   * The index of this embedded chunk in the total number of chunks.
   */
  chunkIndex: int
}
