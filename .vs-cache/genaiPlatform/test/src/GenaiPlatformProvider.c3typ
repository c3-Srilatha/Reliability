/**
 * Enum type for the Genai Platform LLM model provider types.
 */
enum type GenaiPlatformProvider {

  /**
   * The Azure AI model provider type.
   */
  AZURE_AI = "GenaiCore.Llm.AzureAi"

  /**
   * The Azure OpenAI model provider type.
   */
  AZURE_OPEN_AI = "GenaiCore.Llm.AzureOpenAi"

  /**
   * The Vertex AI model provider type.
   */
  VERTEXAI = "GenaiCore.Llm.VertexAi"

  /**
   * The Bedrock model provider type.
   */
  BEDROCK = "GenaiCore.Llm.Bedrock"
}
