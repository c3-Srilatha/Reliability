/**
 * Input type defining a mathematical calculation.
 * The resulting calculation will be a + b, a - b, a * b, or a / b according to #operation.
 */
type GenaiCore.Tool.C3Method.TestType.CalculateInput {
  /**
   * The first number in the calculation.
   */
  a: !float

  /**
   * The second number in the calculation.
   */
  b: !float

  /**
   * The 'operation' to perform on "the" two numbers.
   */
  operation: !string enum('add', 'subtract', 'multiply', 'divide')
}
