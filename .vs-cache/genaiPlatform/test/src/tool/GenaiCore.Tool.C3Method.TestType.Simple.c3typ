/**
 * A 'simple' (no fields that refer to other types) test type for {@link GenaiCore.Tool.C3Method}.
 */
type GenaiCore.Tool.C3Method.TestType.Simple {

  /**
   * An int with a default value
   */
  i: int = 12

  /**
   * A required string
   */
  s: !string

  /**
   * json
   */
  j: json

  /**
   * An array
   */
  a: [string]
}
