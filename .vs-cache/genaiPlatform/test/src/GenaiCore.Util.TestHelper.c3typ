/**
 * Helper for testing GenaiCore.Util
 */
type GenaiCore.Util.TestHelper {
    /**
     * Helper function to test the executeWithLock function.
     * This function will call the executeWithLock function according to the given (massaged) parameters
     *
     * @param lockKey
     *              The key to use for the lock
     * @param lockFuncSleep
     *              The amount of time to sleep in the lock function
     * @param lockFuncIncrementAmount
     *              The amount by which to increment the lock file
     * @param lockWaitTimeout
     *              The amount of time to wait for the lock
     * @param useExecutePredicate
     *              Whether to use the execute predicate
     * @return The result of the executeWithLock function
     */
    callExecuteWithLock: inline function(
        lockKey: string,
        lockFuncSleep: !int,
        lockFuncIncrementAmount: !int,
        lockWaitTimeout: !int,
        useExecutePredicate: boolean
    ): !string py-py4j | py-client
}
