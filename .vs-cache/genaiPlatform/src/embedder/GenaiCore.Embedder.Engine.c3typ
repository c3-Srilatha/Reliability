/**
 * A standalone {@link Engine} to perform embedding. Wraps around a {@link GenaiCore.Embedder} to provide
 * low-latency embedding.
 */
type GenaiCore.Embedder.Engine mixes GenaiCore.TypeProxyEngine, GenaiCore.Embedder {

  encodeBatch: ~ py
  initialize: ~ py

  /**
   * Create and deploy an engine for the given embedder.
   *
   * @param embedder
   *          the embedder to create/deploy as an engine
   * @param spec
   *          optional customizations for the deployment
   * @return the newly created/deployed engine
   */
  createFromEmbedder: function(embedder: !GenaiCore.Embedder, spec: Engine.DeploySpec): !mixing GenaiCore.Embedder.Engine py
}
