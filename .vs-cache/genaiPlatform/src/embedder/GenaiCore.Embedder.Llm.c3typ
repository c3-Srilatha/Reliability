/**
 * Wraps around a {@link GenaiCore.Llm.Embedding.Client} to perform embedding.
 */
type GenaiCore.Embedder.Llm mixes GenaiCore.Embedder {

  /**
   * An initialized {@link client GenaiCore.Llm.Embedding.Client} that can perform embedding.
   */
  client: !GenaiCore.Llm.Embedding.Client

  /**
   * @inheritdoc
   *
   * Note that the kwargs here are user-provided options to override the default options of {@link #client}.
   */
  doEncodeBatch: ~ py-llm
}
