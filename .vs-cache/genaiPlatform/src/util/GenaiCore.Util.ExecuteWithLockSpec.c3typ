/**
 * Spec for {@link GenaiCore.Util#executeWithLock} to execute a function with a lock.
 */
type GenaiCore.Util.ExecuteWithLockSpec mixes Spec {

  /**
   * The logical key on which to lock. This key is relative only to the node on which the lock is being acquired.
   */
  lockKey: !string

  /**
   * The maximum amount of time to wait to acquire the lock
   */
  lockWaitTimeoutSeconds: !int = 300

  /**
   * If provided, then this will be executed before attempting to acquire the lock and again before executing the
   * function to determine whether it is still necessary to acquire the lock and execute the function.
   *
   * For example, if the function is trying to download a file to a given path, then this predicate could check
   * whether the file already exists.
   */
  executePredicate: lambda(): boolean

  /**
   * Kwargs dict for #executePredicate, if any
   */
  executePredicateKwargs: native

  /**
   * The function that will be executed once the lock is acquired.
   */
  func: !lambda(): native

  /**
   * Kwargs dict for {@link #func}, if any
   */
  funcKwargs: native
}
