/**
 * Spec to control the threadpool configured for an engine via {@link GenaiCore.EngineUtil#updateThreadPool}.
 */
type GenaiCore.UpdateThreadPoolSpec mixes App.Node.ThreadPool.Spec {

  /**
   * If provided, then {@link GenaiCore.EngineUtil#updateThreadPool} will internally call
   * {@link GenaiCore.EngineUtil#waitForEngineRunning} with this spec to ensure that the engine is running.
   */
  waitSpec: GenaiCore.EngineUtil.WaitSpec
}
