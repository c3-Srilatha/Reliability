/**
 * Type to contain utility functions for {@link GenaiCore.Llm.Client}
 */
type GenaiCore.LlmClientUtil {
    /**
     * Checks if the given model is compatible with the current runtime for the specified task.
     *
     * This function examines the runtime requirements of the model's implementation for the given task
     * and compares them with the current execution environment. If there's an incompatibility, it returns
     * a detailed error message explaining the issue and suggesting a solution.
     *
     * The function is useful when a model's implementation is only available in certain
     * runtimes but is being called from a different incompatible runtime.
     *
     * @param model
     *          The model to check the compatibility for.
     * @param task
     *          The name of the task being performed on the model.
     * @param returnJson
     *          When returnJson is true, no error message is returned. When false, runtime compatibility is
     *          enforced and an error message is returned if the model is not compatible.
     *
     * @returns a string containing the error message if the model is not compatible with the runtime
     *          otherwise returns an empty string.
     */
    runtimeIncompatibilityMessage: private inline function(model: !GenaiCore.Llm.Model, task: !string, returnJson: !boolean): string py
}
