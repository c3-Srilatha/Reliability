/**
 * A spec for controlling how various wait APIs should behave
 */
type GenaiCore.Util.WaitSpec mixes Spec {

  /**
   * The number of seconds to wait between checks
   */
  pollIntervalSeconds: !int = 5

  /**
   * The number of seconds to wait before the first check
   */
  initialWaitSeconds: int

  /**
   * The maximum number of seconds to wait
   */
  maxWaitSeconds: !int = 30
}
