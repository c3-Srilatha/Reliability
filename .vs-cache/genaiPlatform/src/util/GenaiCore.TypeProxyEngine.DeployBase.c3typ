/**
 * Fields to associate to an instance of {@link GenaiCore.TypeProxyEngine}.
 */
type GenaiCore.TypeProxyEngine.DeployBase {

  /**
   * The {@link GenaiCore.TypeProxyEngine} will invoke all actions on this instance.
   */
  instance: !Obj

  /**
   * Initialization and all subsequent actions will be run in an runtime that meets this action requirement.
   */
  actionRequirement: !string serialized Action.Requirement

  /**
   * The name of the function on {@link #instance} that should be called as part of thread
   * initialization on the {@link GenaiCore.TypeProxyEngine}.
   * If unspecified, then no initialization will be performed.
   */
  initFuncName: string
}
