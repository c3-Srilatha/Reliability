/**
 * A base serializer type for converting values to and from their serialized form.
 */
type GenaiCore.Serializer {

  /**
   * Serialize the given `obj` to a string. Should be symmetric with {@link #deserialize}.
   *
   * @param obj
   *          object instance to serialize.
   * @return the serialized object.
   */
  serializeValue: abstract inline member function(obj: !?native): !(string | binary)

  /**
   * Deserialize the string into an obj. Should be symmetric with {@link #serialize}.
   *
   * @param serialized
   *          object to deserialize.
   * @return the deserialized object.
   */
  deserializeValue: abstract inline member function(serialized: !(string | binary)): !?native
}
