/**
 * A spec for controlling how {@link GenaiCore.EngineUtil#waitForEngineRunning} should behave
 */
type GenaiCore.EngineUtil.WaitSpec mixes GenaiCore.Util.WaitSpec {
  /**
   * If `true`, then if the engine is not running after #maxWaitSeconds, {@link Engine#terminate} will be called.
   */
  terminateIfNotRunning: boolean
}
