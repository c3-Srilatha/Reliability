/**
 * A basic utility type for other types/instances whose implementation is backed by 'native' Python files/code.
 *
 * **NOTE**: This type cannot be an entity since some types that inherit from it (e.g. {@link GenaiCore.Tool.NativePy})
 * already extend an entity type, but it is expected that all concrete instances of this type will be entities.
 */
abstract type GenaiCore.NativePyUtil mixes WithId {

  /**
   * The source code for the instance. This can be either a single file or a zip.
   */
  pySrc: File

  /**
   * The minimal action requirement needed for the code to run.
   */
  actionRequirement: string serialized Action.Requirement = "py"

  /**
   * @return the local path to which the Python code should be downloaded.
   */
  localDirPath: private inline member function(): !string py

  /**
   * Loads and compiles the Python code from #pySrc and returns all 'global' variables that are instantiated
   * by the Python code.
   * @return a dict of the new global variables
   */
  loadImplGlobals: private inline member function(): !native py

  /**
   * For subtypes that support implementations in multi-file source directories, this is the name of the file
   * in the source directory that contains the 'main' implementation.
   *
   * The default implementation returns `c3_init.py` and subtypes should override this function if they use a
   * different file name.
   *
   * @return the name of the file in the source directory that contains the 'main' implementation
   */
  implFileNameInSrcDir: private inline cached function(): !string py

  /**
   * Downloads the Python code from #pySrc to a local path and returns the path.
   * @param force
   *        If true, the code will be downloaded even if it already exists locally.
   * @return the local path to the downloaded code
   */
  downloadToLocalPath: private inline member function(force: boolean): !string py-py4j | py-client

  /**
   * Internal function to upload the provided Python code and persist the new instance. Note that any sub-type-specific
   * fields should be set on the instance **before** calling this function.
   * @param filePath
   *        The path to the Python file to upload
   * @param actionRequirement
   *        The minimal action requirement needed for the code to run
   * @return the new instance
   */
  doCreateFromPyFile: private inline member function(filePath: !string,
                                              actionRequirement: string serialized Action.Requirement):
                                                                                      !mixing GenaiCore.NativePyUtil py

  /**
   * Helper function for subtypes that implement a `createFromPySrc` variant that takes a string of Python code.
   * @param pySrc
   *        The Python source code
   * @return the path to the local file that was created
   */
  writePySrcToFile: private inline function(pySrc: !string): !string py
}
