/**
 * Represents a single search result from similarity search.
 * This is returned from {@link GenaiCore.VectorStore#similaritySearch}.
 */
type GenaiCore.VectorStore.SimilaritySearchResult {

  /**
   * Unique identifier for the vector in the vector store.
   */
  vectorId: !string

  /**
   * The rank given by the vector store search.
   */
  rank: !int

  /**
   * The distance given by the vector store search.
   */
  distance: !double

  /**
   * The content corresponding to the embedding found in the vector store.
   * This is the object that was embedded.
   * For example, it could be the document content as a string.
   */
  content: any

  /**
   * Metadata associated with the {@link #content}.
   */
  metadata: map<string, any>
}
