/**
 * PrivilegedActions can only allow access to otherwise restricted actions on specific types, not subtypes. This means that allowing {@link GenaiCore.Llm.Auth#getSecret} does not allow
 * `getSecret` on any of its concrete subtypes. In order to enable {@link GenaiCore.Llm.Auth} extensibility and integration with the PrivilegedAction framework, we store the secrets in
 * this (single) concrete config type, which is then used by the {@link GenaiCore.Llm.Auth} types to retrieve the secrets.
 */
@config(doNotDefaultIfMissing=true)
private type GenaiCore.Llm.Auth.Secret mixes Named, Config {

  /**
   * Given an instance of a concrete {@link GenaiCore.Llm.Auth} type, return the #name corresponding for the GenaiCore.Llm.Auth.Secret instance.
   *
   * @param cfg
   *          concrete auth instance.
   * @return the secret corresponding to the auth instance.
   */
  forAuthConfig: inline function(cfg: !GenaiCore.Llm.Auth): !GenaiCore.Llm.Auth.Secret py

  /**
   * Given an instance of a concrete {@link GenaiCore.Llm.Auth} type, return the #authSecret.
   *
   * @param cfg
   *          concrete auth instance.
   * @return the secret value corresponding to the auth instance.
   */
  getSecretValueForConfig: inline function(cfg: !GenaiCore.Llm.Auth): !json py

  /**
   * Set the {@link GenaiCore.Llm.Auth.Secret} instance for the given concrete {@link GenaiCore.Llm.Auth}.
   *
   * @param cfg
   *          concrete auth instance to set.
   * @param override
   *          override level to set the auth instance for.
   */
  setSecretValueForConfig: inline function(cfg: !GenaiCore.Llm.Auth, override: string enum ConfigOverride) py

  /**
   * The secret value
   */
  @config(secret=true)
  authSecret: !json

  /**
   * Clear the secret value for the given config instance and override.
   *
   * @param cfg
   *          concrete auth instance to clear.
   * @param override
   *          override level to clear the auth instance for.
   */
  clearSecretValueForConfig: function(cfg: !GenaiCore.Llm.Auth, override: string enum ConfigOverride) py

  /**
   * Clear the secret value for the given config instance and all overrides.
   *
   * @param cfg
   *          concrete auth instance to clear.
   */
  clearSecretValueForConfigAllOverrides: function(cfg: !GenaiCore.Llm.Auth) py

  /**
   * Clear the secret value for all configs of the given type at the specified override.
   *
   * @param authType
   *          clear all the secret values on this auth type.
   * @param override
   *          override level to clear the secrets for.
   * @param confirm
   *          set to `true` to confirm the operation.
   */
  clearAllConfigAndSecretOverridesForAuthType: function(authType: !Type, override: !string enum ConfigOverride, confirm: boolean) py
}
