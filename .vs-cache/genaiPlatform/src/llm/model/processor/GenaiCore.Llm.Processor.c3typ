/**
 * Interface that declares preprocessing and postprocessing functions to be used with {@link GenaiCore.Llm.Model}.
 * To write a custom processor, the user should extend this interface and implement the {@link #doPreprocess} and
 * {@link #doPostprocess} functions.
 */
abstract type GenaiCore.Llm.Processor {

  /**
   * @param request
   *          the request to the LLM service, in native format.
   * @return preprocessed request.
   * By default this function returns the original request. The user should overwrite this method
   * to implement custom preprocessing.
   */
  doPreprocess: member function(request: !native): !native py

  /**
   * @param response
   *          the response from the LLM service, in native format.
   * @return postprocessed response.
   * By default this function returns the original request. The user should overwrite this method
   * to implement custom preprocessing.
   */
  doPostprocess: member function(response: !native): !native py

  /**
   * The preprocess function that will call the {@link #doPreprocess} function.
   *
   * @param request
   *          the request to the LLM service, in native format. For the chat-completion API,
   *          `request` will be the `messages` parameter with the format defined in
   *           {@link GenaiCore.Llm.Completion#completion}.
   * @return preprocessed request.
   */
  preprocess: member function(request: !native): !native py

  /**
   * The postprocess function that will call the {@link #doPostprocess} function.

   * @param response
   *          the response from the LLM service, in native format.  For the chat-completion API,
   *          `response` will be the raw response from the LLM service with the format defined in
   *          {@link https://docs.litellm.ai/docs/completion/output}.
   * @return postprocessed response.
   */
  postprocess: member function(response: !native): !native py
}
