/**
 * Private type to provide common implementation for litellm-backed embedding models.
 */
private abstract type GenaiCore.Llm.Embedding.LiteLlm mixes GenaiCore.Llm.Embedding, GenaiCore.Llm.LiteLlm {

  /**
   * @inheritdoc
   *
   * For models whose implementation is backed by litellm, this method should be reclaimed to specify
   * the required runtime (that contains provider-specific libraries). No implementation or changes to python code
   * should be required.
   * e.g. for {@link GenaiCore.Llm.Bedrock.Model} which requires libraries in `py-bedrock_litellm`,
   * the claim is `doEmbedding: ~ from super py-bedrock_litellm`
   */
  doEmbedding: ~ py-litellm

  /**
   * Internal helper function called by {@link GenaiCore.PrivilegedAction#getSecretInvokeTaskWithAuth} to call the
   * embedding API with the provided auth **that will have the auth secrets**.
   *
   * For models whose implementation is backed by litellm, this method should be reclaimed to specify
   * the required runtime (that contains provider-specific libraries). No implementation or changes to python code
   * should be required.
   * e.g. for {@link GenaiCore.Llm.Bedrock.Model} which requires libraries in `py-bedrock_litellm`,
   * the claim is `embeddingWithAuth: ~ from super py-bedrock_litellm`
   *
   * @param auth
   *          the auth configuration to use for embedding.
   * @param input
   *          Input text to embed. Can either take in a single string or an array of strings.
   * @param options
   *          Additional kwargs for the embedding API.
   * @return the embedding, in native form.
   */
  embeddingWithAuth: private inline member function(auth: !GenaiCore.Llm.Auth, input: !(string | [!string]), options: json): !native py-litellm
}
