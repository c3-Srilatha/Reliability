/**
 * Spec for {@link GenaiCore.Llm.LiteLlm.BatchRequestJob#createInputFile}.
 */
type GenaiCore.Llm.LiteLlm.BatchRequestJob.InputFileSpec mixes Spec {

  /**
   * Model name used for batch completion, e.g. gpt-4o-batch, gemini-pro-1.5-001
   */
  model: string

  /**
   * List of messages
   * E.g.
   * ```py
   * messages = [
   *     [{"role": "user", "content": "What's the time in UTC format? "}, {"role": "developer", "content": "You are a helpful assistant that answers programming questions"}],
   *     [{"role", "user", "content": "When was Open AI founded?"}]
   * ]
   * ```
   */
  messages: ![[json]]

  /**
   * List of options that will be used to create inputs which match the order of messages
   */
  optionsBatch: [json]
}
