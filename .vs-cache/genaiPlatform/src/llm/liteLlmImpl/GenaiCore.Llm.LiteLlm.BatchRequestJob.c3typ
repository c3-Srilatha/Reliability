/**
 * Generic BatchRequestJob implemented through LiteLLM functionality
 */
extendable entity type GenaiCore.Llm.LiteLlm.BatchRequestJob mixes GenaiCore.Llm.BatchRequestJob schema name 'BRJ'{

  /**
   * LiteLLM model used for submitting this batch request job
   */
  model: !GenaiCore.Llm.LiteLlm

  /**
   * The id of the batch request job
   */
  jobId: !string

  /**
   * @return whether this type supports using a file stored in c3 file system corresponding to the model provider, e.g. a file stored in GCS bucket used for Vertex AI models.
   */
  supportsC3File: inline function(): boolean py

  /**
   * Create a local input file at path from list of messages.
   *
   * @param path
   *        path to the input file on disk
   * @param spec
   *        spec used to create the input file, see {@link GenaiCore.Llm.LiteLlm.BatchRequestJob.InputFileSpec}.
   */
  createInputFile: abstract inline function(path: !string, spec: !GenaiCore.Llm.LiteLlm.BatchRequestJob.InputFileSpec)

  /**
   * Create the job on c3 side.
   *
   * @param model
   *        {@link GenaiCore.Llm.Model} that will use the input file
   * @param inputFilePath
   *        path to the input file
   * @param jobId
   *        optional jobId, if the job has already been submitted to cloud provider
   *
   * @return an instance of a concrete subtype of {@link GenaiCore.Llm.LiteLlm.BatchRequestJob}
   */
  createJob: private abstract inline function(model: !GenaiCore.Llm.Model, inputFilePath: !string, jobId: string): !mixing GenaiCore.Llm.LiteLlm.BatchRequestJob

  /**
   * @return the batch job object by cloud provider corresponding to this c3 entity.
   */
  retrieve: inline member function(): !native py-litellm

  /**
   * @param fileId
   *        the file id recognizable by cloud provider
   *
   * @return the file content by litellm-compatible file id
   */
  fileContent: inline member function(fileId: !string): !native py-litellm

  cancel: ~ py-litellm
}
