/**
 * A batch request for generating responses from an LLM, through the batch/batches API.
 * Note that the computation (batch job) runs outside of the C3 platform, so we only keep track of the state of the job.
 */
abstract type GenaiCore.Llm.BatchRequestJob {

  /**
   * @return the current state of the LLM batch job
   */
  state: abstract member function(): !string

  /**
   * @return whether the LLM batch job is done
   */
  completed: abstract member function(): !boolean

  /**
   * Cancel the LLM batch job.
   */
  cancel: abstract member function()

  /**
   * @return a list of responses from the LLM batch job when done. Returns None if the job is not done.
   */
  responses: abstract member function(): [string]

  /**
   * @return details of the LLM batch job for debugging purposes
   */
  details: abstract private member function(): string
}
