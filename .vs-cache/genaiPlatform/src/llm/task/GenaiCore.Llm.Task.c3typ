/**
 * Interface that represents a "task" that an LLM can perform. This type can be used to discover supported tasks, via
 * listing concrete sub-types.
 * Types of task supported currently:
 *  - {@link GenaiCore.Llm.Completion}
 *  - {@link GenaiCore.Llm.Embedding}
 */
abstract type GenaiCore.Llm.Task {

  /**
   * Default values to provide for the task. Caller-provided option values (e.g. `completion#options`)
   * will be merged and take precedence.
   */
  defaultOptions: json

  /**
   * @param options
   *          user provided options to the task
   * @return options merged with {@link #defaultOptions} giving precedence to the former.
   */
  mergeDefaultOptions: private inline member function(options: json): !?native py

  /**
   * @param optionsBatch
   *          user provided list of options to the task
   * @return options merged with {@link #defaultOptions} giving precedence to the former.
   */
  mergeDefaultOptionsBatch: private inline member function(optionsBatch: [json]): !?native py
}
