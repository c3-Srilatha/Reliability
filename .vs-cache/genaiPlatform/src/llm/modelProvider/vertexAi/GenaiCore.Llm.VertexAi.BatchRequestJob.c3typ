/**
 *  Customized BatchRequestJob field/method implemented for Vertex AI service
 */
entity type GenaiCore.Llm.VertexAi.BatchRequestJob<C: GenaiCore.Llm.VertexAi.BatchRequestJob.Config> extends GenaiCore.Llm.LiteLlm.BatchRequestJob mixes Configurable<C> type key 'VERTEX' {

  /**
   * The JSONL file containing the prompts passed to the LLM.
   */
  inputFile: !File

  /**
   * The directory containing the JSONL file containing the responses from the LLM.
   * Note that GCP takes in the directory into which the response files will be written,
   * but since {@link GcsFileSystem} does not have a type to represent a directory directly,
   * this uses {@link File} to represent the directory.
   */
  outputDir: !File

  supportsC3File: ~ py
  createInputFile: ~ py
  createJob: ~ py

  retrieve: ~ py-vertexai_litellm
  state: ~ py-vertexai_litellm
  completed: ~ py-vertexai_litellm
  responses: ~ py-vertexai_litellm
  details: ~ py-vertexai_litellm
  cancel: ~ py-vertexai_litellm

  /**
   * Upload a file at path.
   *
   * @param path
   *        The path where the file will be uploaded
   * @param model
   *        The model that will use the input file
   *
   * @return liteLLM compatible input file id
   */
  uploadInputFile: inline function(path: !string, model: GenaiCore.Llm.Model): !string py-litellm

  /**
   * Delete the LLM batch job. Use #remove to remove the entity.
   */
  delete: member function() py-vertexai_litellm

  /**
   * Cancels then deletes the job, and deletes the input file and output directory before removing.
   */
  @dependency(include="this")
  beforeRemove: ~ py-vertexai_litellm
}
