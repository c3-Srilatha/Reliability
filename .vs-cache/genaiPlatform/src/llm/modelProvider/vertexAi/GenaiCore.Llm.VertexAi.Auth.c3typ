/**
 * Authentication information for the Vertex AI LLM Service.
 */
type GenaiCore.Llm.VertexAi.Auth mixes GenaiCore.Llm.Auth {

  /**
   * The authentication key for the service account.
   * The string should be a json dump of the service account json.
   * An example of this can be found on {@link https://docs.litellm.ai/docs/providers/vertex#system-message}.
   */
  @config(secret=true)
  serviceAccountInfo: string

  /**
   * The Google Cloud Project ID or number.
   */
  project: string

  /**
   * The Vertex AI region.
   */
  location: string

  secretStringsFromAuthSecret: ~ py
}
