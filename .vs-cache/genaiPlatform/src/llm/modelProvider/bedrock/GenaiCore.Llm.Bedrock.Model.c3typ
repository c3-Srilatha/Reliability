/**
 * This type represents a model for the Bedrock LLM service.
 * While {@link #completion} could be called directly, it is recommended to instead use
 * {@link GenaiCore.Llm.Completion.Client}.
 */
type GenaiCore.Llm.Bedrock.Model mixes GenaiCore.Llm.Completion.LiteLlm, GenaiCore.Llm.Embedding.LiteLlm {

  providerMapping: ~ py
  doCompletion: ~ from super py-bedrock_litellm
  completionWithAuth: ~ from super py-bedrock_litellm
  doEmbedding: ~ from super py-bedrock_litellm
  embeddingWithAuth: ~ from super py-bedrock_litellm
  authType: ~ py
}
