/**
 * Authentication information for AWS GenaiCore.Llm.Bedrock.
 */
type GenaiCore.Llm.Bedrock.Auth mixes GenaiCore.Llm.Auth {

  /**
   * The secret authentication key for AWS GenaiCore.Llm.Bedrock.
   */
  @config(secret=true)
  awsSecretKey: string

  /**
   * The access key id for AWS GenaiCore.Llm.Bedrock.
   */
