/**
 * Customized BatchRequestJob field/method implemented for Azure Open AI service
 */
entity type GenaiCore.Llm.AzureOpenAi.BatchRequestJob extends GenaiCore.Llm.LiteLlm.BatchRequestJob type key 'AZURE' {

  /**
   * Id of the uploaded JSONL file containing the prompts passed to the LLM.
   */
  inputFileId: !string

  /**
   * Id of the output file containing the responses generated by the LLM. Only available after the output has been generated.
   */
  outputFileId: string

  createInputFile: ~ py
  createJob: ~ py

  state: ~ py-litellm
  completed: ~ py-litellm
  responses: ~ py-litellm
  details: ~ py-litellm

  /**
   * Cancels the job before removing.
   */
  @dependency(include="this")
  beforeRemove: ~ py-litellm
}
