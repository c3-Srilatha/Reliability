/**
 * This type represents a model for the Azure AI LLM service.
 * While {@link #completion} could be called directly, it is recommended to instead use
 * {@link GenaiCore.Llm.Completion.Client}.
 */
type GenaiCore.Llm.AzureAi.Model mixes GenaiCore.Llm.Completion.LiteLlm, GenaiCore.Llm.Embedding.LiteLlm {

  providerMapping: ~ py
  authType: ~ py

  /**
   * Helper function called by providerMapping
   *
   * @returns the mapping object.
   */
  _azureProviderMapping: private inline function(): native py
}
