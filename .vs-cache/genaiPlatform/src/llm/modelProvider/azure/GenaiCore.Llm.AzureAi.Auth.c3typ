/**
 * Authentication information for the Azure OpenAi LLM Service.
 */
type GenaiCore.Llm.AzureAi.Auth mixes GenaiCore.Llm.Auth {

  /**
   * The authentication key for the Azure OpenAI LLM Service.
   */
  @config(secret=true)
  apiKey: string

  /**
   * The Azure endpoint.
   */
  azureEndpoint: string

  secretStringsFromAuthSecret: ~ py
}
