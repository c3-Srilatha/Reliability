/**
 * This type represents a model for the Azure OpenAi LLM service.
 * While {@link #completion} could be called directly, it is recommended to instead use
 * {@link GenaiCore.Llm.Completion.Client}.
 */
type GenaiCore.Llm.AzureOpenAi.Model mixes GenaiCore.Llm.AzureAi.Model {

  providerMapping: ~ py
  authType: ~ py
  supportsCompletionJob: ~ py
  batchRequestJobType: ~ py
}
