/**
 * General client to use for {@link GenaiCore.Llm.Completion} tasks.
 * Example simple usage:
 * ```py
 * CompletionClient = c3.GenaiCore.Llm.Completion.Client
 * AzureOpenAiModel = c3.GenaiCore.Llm.AzureOpenAi.Model
 *
 * client = CompletionClient(
 *   model=AzureOpenAiModel(model="gpt-35-turbo", defaultOptions={"max_tokens": 10})
 * )
 * response = client.completion(
 *   messages=[
 *     {"content": "Hello world?", "role": "user"}
 *   ],
 *   options={"temperature": 0.3}
 * )
 * ```
 */
type GenaiCore.Llm.Completion.Client mixes GenaiCore.Llm.Client, GenaiCore.Llm.Completion {

  /**
   * @inheritdoc
   *
   * Wrapper around {@link GenaiCore.Llm.Completion#completion} that handles calls from runtimes that
   * cannot directly invoke the underlying #models completion method. Note that when such calls are
   * made, `options['returnJson']` must be set true (or `#defaultOptions['returnJson']`) or an error will be thrown.
   */
  completion: ~ py

  /**
   * @inheritdoc
   *
   * **NOTE** the client's {@link #model}'s `defaultOptions` has precedence over the client's.
   */
  defaultOptions: ~

  submitCompletionJob: ~ py

  supportsVision: ~ py
  supportsCompletionJob: ~ py
}
