/**
 * Interface that declares routing/retry/backoff logic for {@link GenaiCore.Llm.Client}.
 */
abstract type GenaiCore.Llm.Router {

  /**
   * Example:
   * ```py
   * router = ...
   * client = c3.GenaiCore.Llm.Completion.Client(
   *   model=[c3.GenaiCore.Llm.AzureOpenAi.Model(...), ...],
   *   router=router
   * )
   * resp = router.route(
   *   client=client,
   *   action=c3.ActionRef(typeName="GenaiCore.Llm.AzureOpenAi.Model", actionName="completion"),
   *   args={"max_tokens": 10, "temperature": 0.3, "stream": True}
   * )
   * ```
   *
   * @param client
   *          instance of the llm service client to route for. This will contain information like
   *          list of models {@link GenaiCore.Llm.Client#model}.
   * @param task
   *          the name of the task to call on {@link GenaiCore.Llm.Client#model} once a model is selected.
   *          Note: task is passed by name as string.
   * @param args
   *          the arguments to provide to the task of a {@link GenaiCore.Llm.Client#model}.
   * @return the native return value of the task of a {@link GenaiCore.Llm.Client#model}.
   */
  route: abstract member function(client: !GenaiCore.Llm.Client, task: !string, args: map<string, any>): native
}
