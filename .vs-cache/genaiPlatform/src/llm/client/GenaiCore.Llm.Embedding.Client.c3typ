/**
 * General client to use for {@link GenaiCore.Llm.Embedding} tasks.
 * Example simple usage:
 * ```py
 * EmbeddingClient = c3.GenaiCore.Llm.Embedding.Client
 * AzureOpenAiModel = c3.GenaiCore.Llm.AzureOpenAi.Model
 *
 * client = EmbeddingClient(
 *   model=AzureOpenAiModel(model="text-embedding-3-large", defaultOptions={"dimensions": 1024})
 * )
 * response = client.embedding(
 *   input=[
 *     "The quick brown fox jumps over the lazy dog."
 *   ]
 * )
 * ```
 */
type GenaiCore.Llm.Embedding.Client mixes GenaiCore.Llm.Client, GenaiCore.Llm.Embedding {

  embedding: ~ py
  doEmbedding: ~ py
}
