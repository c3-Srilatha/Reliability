/**
 * Entity type storing {@link GenaiCore.Observability.Trace}
 */
@db(index+=["name", "status", "spanCount", "errorCount", "durationInMillis", "startTime", "endTime", "llmCallsTokenSum", "llmCallsMaxTokens", "llmCallsMaxLatency"])
private entity type GenaiCore.Observability.Trace.Record mixes GenaiCore.Observability.Trace.Fields {

  /**
   * {@link Observability.Span.Record}s in this {@link GenaiCore.Observability.Trace.Record}
   */
  spans: [Observability.Span.Record] (traceId)

  afterRemove: ~ py
}
