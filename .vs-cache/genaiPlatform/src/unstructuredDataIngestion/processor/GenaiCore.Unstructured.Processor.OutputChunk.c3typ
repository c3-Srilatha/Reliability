/**
 * One chunk (future vector) of the result of {@link GenaiCore.Unstructured.Processor#process}[processing]
 * a single source file.
 */
type GenaiCore.Unstructured.Processor.OutputChunk {
  /**
   * The path to the source file.
   */
  source: string

  /**
   * The processed content for this chunk of the source file. If #contentToEmbed is not present, this is the content
   * that will be embedded by the {@link GenaiCore.Unstructured.Job.Options#embedder}.
   */
  content: !any

  /**
   * If specified, this content will be embedded by the {@link GenaiCore.Unstructured.Job.Options#embedder}
   * instead of #content. This may be used to embed additional metadata or other content that should not be
   * directly queried.
   */
  contentToEmbed: any

  /**
   * The metadata to store on the vector instance.
   */
  metadata: json
}
