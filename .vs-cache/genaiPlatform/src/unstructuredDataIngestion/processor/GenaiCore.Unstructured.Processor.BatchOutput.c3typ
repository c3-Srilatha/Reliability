/**
 * The output of {@link GenaiCore.Unstructured.Processor#processBatch}.
 */
type GenaiCore.Unstructured.Processor.BatchOutput {
  /**
   * The successully processed results.
   * The key is the source file path and the value is the processed output.
   */
  results: map<string, [GenaiCore.Unstructured.Processor.OutputChunk]>

  /**
   * The errors that occurred during processing.
   */
  errors: [GenaiCore.Unstructured.Processor.Error]
}
