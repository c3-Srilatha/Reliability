/**
 * An error that occurred during the execution of a processor.
 */
type GenaiCore.Unstructured.Processor.Error {
  /**
   * The error message.
   */
  message: !string

  /**
   * The error stack trace.
   */
  stackTrace: string

  /**
   * The source file for which the error occurred.
   */
  source: !string serialized File

  /**
   * The name of the component within which the error occurred.
   * {@see GenaiCore.Unstructured.Processor#components}
   */
  component: string
}
