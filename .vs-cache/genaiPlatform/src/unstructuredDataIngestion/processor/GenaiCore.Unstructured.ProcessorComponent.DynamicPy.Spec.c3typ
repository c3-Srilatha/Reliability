/**
 * A spec to control the creation of a {@link GenaiCore.Unstructured.ProcessorComponent.DynamicPy}
 */
type GenaiCore.Unstructured.ProcessorComponent.DynamicPy.Spec mixes Spec {
  /**
   * If specified, this will be the name of the component entity created.
   */
  componentName: string

  /**
   * If specified, the id of the component entity created.
   */
  componentId: string

  /**
   * The action requirement for the component
   */
  actionRequirement: string serialized Action.Requirement = "py"

  /**
   * If this is set to true, then the component will allow cross-runtime calls.
   * By default, cross-runtime calls will not be attempted, and instead a
   * runtime error will be raised.
   * If this is set to true, then the component creator should ensure that the
   * inputs/outputs of the component are serializable/non-native values.
   */
  allowCrossRuntimeCalls: boolean
}
