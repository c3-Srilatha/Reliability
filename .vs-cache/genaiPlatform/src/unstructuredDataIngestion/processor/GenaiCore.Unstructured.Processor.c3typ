/**
 * Processor for unstructured data. A processor is a collection of components that are used to process input data into
 * a format that can be embedded, indexed, and queried by the platform.
 */
extendable entity type GenaiCore.Unstructured.Processor mixes SeedData {

  /**
   * The components that will be used to process the input data.
   * The output of one component should be in a format that can be handled by the next component.
   * @see #componentOrder
   */
  components: !map<string, GenaiCore.Unstructured.ProcessorComponent>

  /**
   * The order in which each component, specified by its key in #components, should be executed.
   * The output of one component should be in a format that can be handled by the next component.
   *
   * The input to the first component will be a list of file paths, and when used as part of a
   * {@link GenaiCore.Unstructured.Job}, the last component must return data
   * in a format that can be embedded by the job's embedder.
   */
  componentOrder: ![string]

  /**
   * The action requirement needed for the processor to run.
   */
  actionRequirement: string serialized Action.Requirement

  /**
   * Validates the components in the processor.
   * At the moment, this just validates that all values in #componentOrder are keys in #components.
   */
  validateComponents: private member function() py

  /**
   * Process a single file. The file is processed by the processor's #components in the order specified by
   * #componentOrder, passing the output of one component as the input the next.
   *
   * The output of the last component must be in the format of a list of
   * {@link GenaiCore.Unstructured.Processor.OutputChunk}.
   *
   * @param filePath
   *        The path to the file, either a local path (on Jupyter) or a file elsewhere in the C3 file system
   *
   * @return The output of the last component
   */
  process: member function(filePath: !string): ![GenaiCore.Unstructured.Processor.OutputChunk] py

  /**
   * Process a batch of files. Each file is processed by the processor's #components in the order specified by
   * #componentOrder, passing the output of one component as the input the next. The default implementation simply
   * calls #process on each file in the batch.
   *
   * The output of the results for each source from the last component must be a list of
   * {@link GenaiCore.Unstructured.Processor.OutputChunk}
   *
   * @param filePaths
   *        The paths to the files, either local paths (on Jupyter) or files elsewhere in the C3 file system
   * @return The output of processing.
   */
  processBatch: member function(filePaths: ![string]): !GenaiCore.Unstructured.Processor.BatchOutput py

  /**
   * The same as {@link #processBatch}, except the input is a dict of file paths with corresponding native
   * checkpoint values, organized by component name.
   * Unlike {@link #processBatch}, this method does not necessarily run all files through every component, only
   * the ones for its checkpoint and beyond.
   *
   * @param checkpoints
   *          the checkpoints to use for each file path. The outer key is the component name, and the inner key is the
   *          file path. The inner value is the value of the checkpoint for that file path.
   * @param afterComponentFunc
   *          python lambda for running after each component {@link GenaiCore.Unstructured.ProcessorComponent#processBatch}.
   *          The lambda should take as argument the output of the component in the form of {@link GenaiCore.Unstructured.Processor.BatchOutput},
   *          as well as the component name. This lambda can do processor component-level checkpointing, as well as error saving.
   * @return the output of processing.
   */
  processCheckpoints: private inline member function(checkpoints: !map<string, map<string, native>>, afterComponentFunc: native): !GenaiCore.Unstructured.Processor.BatchOutput py
}
