/**
 * Options for {@link GenaiCore.Unstructured.Job#start}.
 */
private type GenaiCore.Unstructured.BatchJob.Options mixes GenaiCore.Unstructured.Job.Options,
                                                   GenaiCore.Unstructured.Job.RetrySpec {

  /**
   * Reference to the parent run.
   */
  parentRun: !GenaiCore.Unstructured.Job.Run

  /**
   * See corresponding argument in {@link GenaiCore.Unstructured.Job#start}.
   */
  sourceDir: !string serialized File

  /**
   * See corresponding argument in {@link GenaiCore.Unstructured.Job#startFromCheckpoint}.
   */
  referenceRun: GenaiCore.Unstructured.Job.Run

  /**
   * See corresponding argument in {@link GenaiCore.Unstructured.Job#startFromCheckpoint}.
   */
  checkpoint: string

  /**
   * If set, then this job corresponds to a {@link GenaiCore.Unstructured.Job.Run#retry}.
   */
  retry: boolean
}
