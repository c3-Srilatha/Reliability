/**
 * A job that processes unstructured data.
 *
 * This is the default implementation for {@link GenaiCore.Unstructured.Job}.
 */
private entity type GenaiCore.Unstructured.BatchJob extends BatchJob<GenaiCore.Unstructured.BatchJob,
                                                                     GenaiCore.Unstructured.BatchJob.Options,
                                                                     GenaiCore.Unstructured.BatchJob.Batch> type key 'PROC' {

  doStart:      ~ py-dill-py4j
  processBatch: ~ py-dill-py4j
  allComplete:  ~ py-dill-py4j
  failed:       ~ py-dill-py4j

  /**
   * Helper function for {@link #doStart} to enable dispatching to a dynamic runtime.
   *
   * @param job
   *          reference to the processing job.
   * @param options
   *          the options for the processing job.
   */
  doStartHelper: private inline function(job: !GenaiCore.Unstructured.BatchJob, options: !GenaiCore.Unstructured.BatchJob.Options) py

  /**
   * Helper function for {@link #processBatch} to enable dispatching to a dynamic runtime.
   *
   * @param batch
   *          the batch to process.
   * @param job
   *          reference to the processing job.
   * @param options
   *          the options for the processing job.
   */
  processBatchHelper: private inline function(batch: !GenaiCore.Unstructured.BatchJob.Batch, job: !GenaiCore.Unstructured.BatchJob, options: !GenaiCore.Unstructured.BatchJob.Options) py
}
