/**
 * Tracks the details for a single batch run of an unstructured job.
 */
@db(index = ['jobRun, runNumber'])
entity type GenaiCore.Unstructured.Job.BatchRun {

  /**
   * The run sequence number of the {@link GenaiCore.Unstructured.Job.Run} that this batch run is part of.
   * This field is 1-indexed.
   */
  runNumber: !int

  /**
   * Reference to the job run.
   */
  jobRun: !GenaiCore.Unstructured.Job.Run

  /**
   * A summary of the batch run represented by a mapping of job steps (e.g., initialization, processing
   * embedding, vector store) to their respective metrics.
   */
  summary: map<string, map<string, string>>
}
