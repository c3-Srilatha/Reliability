/**
 * Tracks the checkpoints/progress/errors of the processor/embedding/vectorStore execution
 * for a single source instance.
 */
@db(index = ['jobRun'], unique = ['jobRun, source'])
entity type GenaiCore.Unstructured.Job.SourceRun {

  /**
   * Path or id of the source that was processed.
   */
  source: !string

  /**
   * Reference to the job run.
   */
  jobRun: !GenaiCore.Unstructured.Job.Run

  /**
   * The status of source processing.
   */
  status: !JobStatusEnum

  /**
   * The number of chunks corresponding to the #source that were produced by the
   * {@link GenaiCore.Unstructured.Job#processor}.
   */
  processorChunkCount: int

  /**
   * The total number of vectors corresponding to the #source that were stored in the
   * {@link GenaiCore.Unstructured.Job#vectorStore} for this run.
   */
  vectorCount: int

  /**
   * The error messages if the job failed.
   * Key - name of the component that errored
   * Value - error message
   */
  errors: map<string, string>

  /**
   * The checkpoints saved by the {@link GenaiCore.Unstructured.Job} during processing.
   * Only saved if {@link GenaiCore.Unstructured.Job.StartSpec#enableCheckpointing} is true.
   * Key is the name of the component that saved the checkpoint.
   * Value is the checkpoint instance, which holds the path to the checkpoint file.
   */
  checkpoints: map<string, GenaiCore.Unstructured.Job.Checkpoint>
}
