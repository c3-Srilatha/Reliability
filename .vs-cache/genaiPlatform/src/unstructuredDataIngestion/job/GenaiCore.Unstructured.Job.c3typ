/**
 * A job that processes unstructured data. By default, the job will proceed by
 *    1. Passing all files within {@link #start}'s `sourceDir` to #processor
 *    2. Passing the output of #processor to #embedder
 *    3. Passing the output of #embedder to #vectorStore
 *
 * If #enableCheckpointing is true, the job will save checkpoints at each stage of processing.
 */
@db(createOnly=true)
extendable entity type GenaiCore.Unstructured.Job mixes GenaiCore.Unstructured.Job.Options, SeedData {

  /**
   * Start a run of this job. Options provided here will override the values on the job itself, where applicable.
   *
   * @param sourceDir
   *        The directory containing the source files to be processed.
   * @param spec
   *        Spec for this run of the job
   * @return The run of the job
   */
  start: member function(sourceDir: !string serialized File, spec: GenaiCore.Unstructured.Job.StartSpec): !GenaiCore.Unstructured.Job.Run py

  /**
   * Start a run of this job from a checkpoint. Options provided here will override the values on the job itself, where applicable.
   * If referenceRun has been cleaned up by `unstructured-job-run-cleanup`, then this will throw a RuntimeError.
   *
   * @param sourceDir
   *          The directory containing the source files to be processed.
   * @param referenceRun
   *          Use the checkpoints from this run.
   * @param checkpoint
   *          The name of the component checkpoint to start from.
   * @param spec
   *          Spec for this run of the job.
   * @return The run of the job. NOTE: the run will be a new run, not the same run as `referenceRun`.
   */
  startFromCheckpoint: member function(sourceDir: !string serialized File, referenceRun: !GenaiCore.Unstructured.Job.Run, checkpoint: !string, spec: GenaiCore.Unstructured.Job.StartSpec): !GenaiCore.Unstructured.Job.Run py

  /**
   * Removes all instances of {@link GenaiCore.Unstructured.Job.Run} and underlying types and deletes all
   * underlying {@link GenaiCore.Unstructured.Job.Checkpoint} that have exceeded their time to live.
   * Called by `unstructured-job-run-cleanup` {@link CronJob}. See {@link GenaiCore.Unstructured.Job.Options} for configurations.
   */
  cleanupJobRuns: function() py

}
