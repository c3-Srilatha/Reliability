/**
 * A serializer for {@link GenaiCore.Unstructured.Job.Checkpoint} objects.
 */
type GenaiCore.Unstructured.Job.Checkpoint.Serializer {

  /**
   * Serialize the given `data` to a string. Should be symmetric with {@link #deserializeCheckpoint}.
   *
   * @param data
   *          data to serialize
   * @param component
   *          the {@link GenaiCore.Unstructured.Job.Run#components}[component] that created the checkpoint
   * @return the serialized data
   */
  serializeCheckpoint: inline member function(data: !native, component: !string): !(string | binary) py

  /**
   * Deserialize the string into a data object. Should be symmetric with {@link #serializeCheckpoint}.
   *
   * @param serialized
   *          serialized data to deserialize
   * @param component
   *          the {@link GenaiCore.Unstructured.Job.Run#components}[component] that created the checkpoint
   * @return the deserialized data
   */
  deserializeCheckpoint: inline member function(serialized: !(string | binary), component: !string): !native py

  /**
   * If a serializer is provided, its GenaiCore.Serializer#serializeValue and GenaiCore.Serializer#deserializeValue
   * methods will be used.
   */
  baseSerializer: GenaiCore.Serializer
}
