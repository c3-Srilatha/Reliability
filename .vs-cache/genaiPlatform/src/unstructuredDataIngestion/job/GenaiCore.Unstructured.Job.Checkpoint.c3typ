/**
 * A checkpoint represents data in an intermediate state of data being
 * {@link GenaiCore.Unstructured.Processor}[processed].
 * Each instance corresponds to a specific source file after it has been processed by a given component (and all
 * preceeding components). Checkpoints can be saved and used to resume processing
 * or to observe and debug the state of the data at a specific point in the processing pipeline.
 */
type GenaiCore.Unstructured.Job.Checkpoint {

  /**
   * The job run that owns this checkpoint.
   */
  jobRun: !GenaiCore.Unstructured.Job.Run

  /**
   * The job run that originally created this checkpoint.
   */
  referenceRun: GenaiCore.Unstructured.Job.Run

  /**
   * Path to the checkpoint file.
   */
  checkpoint: !string serialized File

  /**
   * the {@link GenaiCore.Unstructured.Job.Run#components}[component] that created the checkpoint
   */
  component: !string

  /**
   * Load the checkpoint data into memory in its native format
   *
   * @return the checkpoint data
   */
  load: inline member function(): !?native py

  /**
   * Save the checkpoint data to the C3 file system
   *
   * @param jobRun
   *          the job run that owns this checkpoint
   * @param data
   *          the data to save
   * @param component
   *          the {@link GenaiCore.Unstructured.Job.Run#components}[component] that created the checkpoint
   * @param referenceRun
   *          the job run that originally created this checkpoint
   * @return the checkpoint object.
   */
  save: inline function(jobRun: !GenaiCore.Unstructured.Job.Run, data: !?native, component: !string, referenceRun: GenaiCore.Unstructured.Job.Run): !mixing GenaiCore.Unstructured.Job.Checkpoint py


  /**
   * Save the data for multiple checkpoints to the C3 file system
   *
   * @param jobRun
   *          the job run that owns this checkpoint
   * @param data
   *          the data to save; one instance per checkpoint
   * @param component
   *          the {@link GenaiCore.Unstructured.Job.Run#components}[component] that created the checkpoint
   * @param referenceRun
   *          the job run that originally created this checkpoint
   * @return the checkpoint objects.
   */
  saveBatch: inline function(jobRun: !GenaiCore.Unstructured.Job.Run, data: ![native], component: !string, referenceRun: GenaiCore.Unstructured.Job.Run): ![mixing GenaiCore.Unstructured.Job.Checkpoint] py
}
