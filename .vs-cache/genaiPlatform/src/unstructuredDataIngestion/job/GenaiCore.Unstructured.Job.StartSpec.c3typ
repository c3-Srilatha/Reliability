/**
 * Options for {@link GenaiCore.Unstructured.Job#start}.
 */
type GenaiCore.Unstructured.Job.StartSpec mixes Spec {

  /**
   * If true, then the job will save checkpoints between successive {@link GenaiCore.Unstructured.Processor#components}
   * within the job's processor as well as between both the processor and the embedder and the embedder and the vectorStore.
   * NOTE: This will take precedence over {@link GenaiCore.Unstructured.Job.Options#enableCheckpointing}.
   */
  enableCheckpointing: boolean

  /**
   * Number of sources to process in a single batch.
   */
  sourceBatchSize: int = 10
}
