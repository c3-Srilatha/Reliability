/**
 * Integration of the `mew3` multi-modal document parser/chunker library.
 */
type GenaiCore.Mew3 mixes Configurable<GenaiCore.Mew3.Config> {

  /**
   * Creates a {@link GenaiCore.Unstructured.Processor} representing an execution pipeline with components
   * from the `mew3` library.
   *
   * @param spec
   *          The specification for the processor to create. NOTE: this will be merged with precedence over
   *          the default spec options defined in {@link GenaiCore.Mew3.Config}.
   * @return
   *          The created processor.
   */
  createProcessor: function(spec: GenaiCore.Mew3.ProcessorCreateSpec): !GenaiCore.Unstructured.Processor py

  /**
   * Installs the mew3 wheel from the provided path, if not installed already.
   * NOTE: the installation will occur within the calling process's runtime.
   *
   * @param wheelPath
   *          the path to where the wheel is located, either caller-local or C3 filesystem.
   */
  ensureMew3Installation: inline function(wheelPath: !string) py

  /**
   * @return The path prefix for the local document path used in {@link #ensureLocalDocument}.
   */
  localDocumentPathPrefix: private inline function(): !string py

  /**
   * Ensures that the document at the provided path is available in the caller-local filesystem.
   *
   * @param path
   *          The path to the document.
   * @return The path to the document in the caller-local filesystem.
   *          NOTE: this will be the same as the input path if it is already in the caller-local filesystem.
   */
  ensureLocalDocument: private inline function(path: !string): !string py

  /**
   * Sets up and outputs a UI debugger for use in jupyter.
   * NOTE: this will create some caller-local files that are used for the UI debugger.
   *
   * @param doc
   *          The mew3 document to debug.
   * @param outputChunks
   *          The output chunks corresponding to the doc. These will be overlayed on the doc.
   * @param options
   *          Additional options to use for the UI debugger.
   * @return the UI debugger instance.
   */
  jupyterUiDebuggerHelper: private inline function(doc: !native, outputChunks: ![json], options: json): native py

  /**
   * Sets up and outputs a UI debugger for use in jupyter.
   * NOTE: this will create some caller-local files that are used for the UI debugger.
   *
   * @param jobRun
   *          The job run that is to be debugged.
   * @param source
   *          The source in the job run that is to be debugged.
   * @param options
   *          Additional options to use for the UI debugger.
   * @return links to display or download the debugger in jupyter.
   */
  jupyterUiDebugger: private inline function(jobRun: !GenaiCore.Unstructured.Job.Run, source: !string, options: json): native py
}
