/**
 * Common spec fields for all agent creation operations.
 */
private type GenaiCore.Agent.BaseCreateSpec mixes Spec {

  /**
   * The name for the new instance. An error will be thrown if this is found to not be unique.
   */
  name: string

  /**
   * The description for the new instance.
   */
  description: string
}
