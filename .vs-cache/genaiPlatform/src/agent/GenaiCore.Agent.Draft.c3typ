/**
 * This type is used as a draft to create a new {@link GenaiCore.Agent}.
 * A {@link GenaiCore.Agent.Draft} is intended to be an editable form of {@link GenaiCore.Agent}, since {@link GenaiCore.Agent}
 * is immutable. When a draft is ready to be deployed, then it should be converted to an agent via {@link #createAgent}.
 * If the intention is to seed an incomplete {@link GenaiCore.Agent.Draft} in a package, then it is recommended to
 * create a template from it using {@link #createTemplate}.
 */
@db(unique=['name'])
private entity type GenaiCore.Agent.Draft mixes GenaiCore.Agent.RunIface, GenaiCore.Agent.Reference {

  /**
   * The description for this draft.
   * NOTE: this is not the same as the description that is set on {@link GenaiCore.Agent} during {@link #createAgent}, and
   * it is also not the same as the description that is set on {@link GenaiCore.Agent.Template} during {@link #createTemplate}!
   */
  description: string

  doRun: ~ py
  run: ~ py

  /**
   * Validation that is called as a part of {@link #createAgent}.
   * For example, if there are any missing or invalid field values, then this method will identify them.
   *
   * @return a list of error messages, if any. If there are no errors, then an empty list is returned.
   */
  validate: member function(): [string] py

  /**
   * @return a list of fields that are required to be populated in order for the agent to be created.
   */
  requiredFieldNames: member function(): [string] py

  /**
   * Clone this draft into a template, for seedability.
   * NOTE: this will create a new {@link GenaiCore.Agent.Template} instance and upsert it to the database!
   *
   * @param spec
   *          optional params for template creation.
   * @return the created template.
   */
  createTemplate: member function(spec: GenaiCore.Agent.CreateTemplateSpec): !GenaiCore.Agent.Template py

  /**
   * Convert this draft into an agent, which is deployable and non-editable.
   * NOTE: this will create a new {@link GenaiCore.Agent} instance and upsert it to the database!
   *
   * @param spec
   *          optional params for agent creation.
   * @return the created agent.
   */
  createAgent: member function(spec: GenaiCore.Agent.CreateSpec): !GenaiCore.Agent py
}
