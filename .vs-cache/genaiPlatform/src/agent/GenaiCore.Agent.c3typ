/**
 * This is the generic type that defines an agent in the C3 ecosystem. An agent is seedable and immutable.
 * It can be deployed or cloned as a draft for editing.
 */
@db(createOnly=true, unique=['name'])
private abstract extendable entity type GenaiCore.Agent mixes SeedData, GenaiCore.Agent.RunIface {

  /**
   * The description of the agent.
   * NOTE: this is not the same as the description that is set on {@link GenaiCore.Agent.Draft} during {@link #createDraft}, and
   * it is also not the same as the description that is set on {@link GenaiCore.Agent.Deployment} during {@link #deploy}!
   */
  description: string

  /**
   * @return a map of the agent's fields that are configurable in the UI, with the corresponding values.
   */
  uiConfigurableFields: abstract function(): map<string, any>

  /**
   * Clone this agent into a draft, for editability.
   * NOTE: this will create a new {@link GenaiCore.Agent.Draft} instance and upsert it to the database!
   *
   * @param spec
   *          optional params for draft creation.
   * @return the created draft.
   */
  createDraft: member function(spec: GenaiCore.Agent.CreateDraftSpec): !GenaiCore.Agent.Draft py

  /**
   * Deploy this agent so that it is persistently running and accessible within the app.
   * NOTE: this will create a new {@link GenaiCore.Agent.Deployment} instance and upsert it to the database!
   *
   * @param spec
   *         optional params for deployment.
   * @return the created deployment.
   */
  deploy: member function(spec: GenaiCore.Agent.DeploySpec): !GenaiCore.Agent.Deployment py

  /**
   * Initialize the agent. Note that this will be no-op if the agent is already initialized.
   *
   * @param force
   *            If set to true, force re-initialize this tool.
   * @param spec
   *            Specs to customize the behavior of agent initialization
   */
  initialize: abstract member function(force: boolean, spec: GenaiCore.Agent.InitSpec): GenaiCore.Agent
}
