/**
 * A PydanticAI-based agent capable of handling queries using a customizable set of tools.
 * For more information, see the PydanticAI documentation: {@link https://ai.pydantic.dev/agents/#introduction}
 */
entity type GenaiCore.Agent.PydanticAI {

  /**
   * Session store for persisting session state between queries.
   */
  sessionStore: !GenaiCore.SessionStore

  /**
   * Collection of tools available to the agent
   */
  toolkit: !GenaiCore.Toolkit

  /**
   * The system prompt that defines the behavior of the agent.
   */
  systemPrompt: !string = "You are an intelligent assistant that uses available tools to answer user queries accurately and efficiently."

  /**
   * The llm used by the agent. Auth is set manually, and usage of this llm is currently ignored.
   */
  llm: !GenaiCore.Llm.Client

  /**
   * Run a query using the agent
   *
   * @param query
   *           The input prompt or question
   * @param sessionId
   *           The session ID for the current interaction
   * @return The result of the query, including the session ID and the generated response
   */
  runQuery: member function(query: !string, sessionId: string): !GenaiCore.Agent.PydanticAI.QueryResult py

  /**
   * Lazily initializes the PydanticAI agent using the configured tools, LLM, and system prompt.
   * If already initialized, the existing agent is returned.
   *
   * @param force
   *           If true, forces reinitialization of the cached agent.
   * @return The initialized or existing PydanticAI agent instance.
   */
  initialize: member function(force: boolean): !native py
}
