/**
 * This type represents a deployment of an {@link GenaiCore.Agent}. A deployment ensures that an agent is persistently running and
 * accessible within the app.
 */
@db(unique=['name'])
private entity type GenaiCore.Agent.Deployment mixes SeedData, GenaiCore.Agent.RunIface {

  /**
   * The description of the agent deployment.
   */
  description: string

  /**
   * The agent that is deployed.
   */
  agent: !GenaiCore.Agent

  run: ~ py
}
