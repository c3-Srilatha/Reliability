/**
 * Customizable options for the {@link GenaiCore.SessionStore#sessions} API.
 */
type GenaiCore.SessionStore.SessionsSpec mixes Spec {

  /**
   * The limit on number of sessions to return. Specifying -1 will cause the
   * API to return all sessions.
   */
  limit: int = 2000

  /**
   * Offset for the read. This allows for paginated reading.
   */
  offset: int
}
