/**
 * Simple time-to-live retention policy for sessions.
 */
type GenaiCore.SessionStore.RetentionPolicy.Ttl mixes GenaiCore.SessionStore.RetentionPolicy {

  /**
   * Time to live in seconds for a session. If a session was last updated more than this many
   * seconds ago, then it will not be retained.
   */
  timeToLiveSeconds: !int = 14400

  shouldRetain: ~ py
}
