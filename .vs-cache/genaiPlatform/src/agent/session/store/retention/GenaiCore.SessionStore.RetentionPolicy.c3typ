/**
 * Interface for implementing a {@link GenaiCore.Session} retention policy.
 * This is used as part of {@link GenaiCore.SessionStore.Persistable#cleanUpSessions}.
 */
abstract type GenaiCore.SessionStore.RetentionPolicy {

  /**
   * @param session
   *          the session to check retention for.
   * @return whether the session should be retained.
   */
  shouldRetain: abstract member function(session: !GenaiCore.Session): !boolean
}
