/**
 * Interface for metadata associated with a "session." A session implies state that is saved **across** multiple calls.
 * For example, a user could have a session that represents a single conversation thread.
 * @see GenaiCore.SessionStore#sessions
 * The session object is used with various {@link GenaiCore.SessionStore} APIs such as `updateState`, `getState`, etc.
 */
type GenaiCore.Session {

  /**
   * The globally unique generated id for the session.
   */
  id: !string

  /**
   * The id of the {@link GenaiCore.SessionStore} instance that is the
   * parent for this session.
   */
  sessionStoreId: !string

  /**
   * Monotonically increasing version number that tracks the number of updates that have
   * been made to the state of this session.
   * @see GenaiCore.SessionStore#updateState
   */
  // Developer Note: the type declaration may look odd here, but it is to be consistent with Persistable#version
  version: int32

  /**
   * Contains metadata about object creation and update times. This field is intended to help
   * implementations of {@link GenaiCore.SessionStore.RetentionPolicy}.
   */
  meta: Meta

  /**
   * Helper method to help enforce that ids are globally unique, given a locally (within store) unique name:
   * '<session_store_id>_<name>'
   *
   * @param store
   *          the session store instance.
   * @param name
   *          the name of the session. If not provided, then a UUID will be generated.
   * @return the properly formatted id.
   */
  idFromName: private inline function(store: !GenaiCore.SessionStore, name: string): !string py
}
