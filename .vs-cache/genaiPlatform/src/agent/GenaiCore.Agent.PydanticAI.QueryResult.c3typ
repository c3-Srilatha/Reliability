/**
 * The result of executing a query through a {@link GenaiCore.Agent}.
 * Contains the output generated by the agent and the associated @{GenaiCore.Session}.
 */
type GenaiCore.Agent.PydanticAI.QueryResult {

  /**
   * The session used or created.
   */
  session: !GenaiCore.Session

  /**
   * The output generated by the agent based on the input query.
   */
  response: !string
}
