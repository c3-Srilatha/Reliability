/**
 * This type is used as a template to create a {@link GenaiCore.Agent.Draft} from. The {@link GenaiCore.Agent.Draft}
 * can then be iterated over to create a {@link GenaiCore.Agent}.
 * A {@link GenaiCore.Agent.Template} is intended to be seeded in a package to accelerate {@link GenaiCore.Agent.Draft}
 * creation. If the intention is not to seed the {@link GenaiCore.Agent.Template} in a package, then it is recommended to
 * just use a {@link GenaiCore.Agent.Draft} directly instead.
 */
@db(createOnly=true, unique=['name'])
private entity type GenaiCore.Agent.Template mixes SeedData, GenaiCore.Agent.Reference {

  /**
   * The description for this template.
   * NOTE: this is not the same as the description that is set on {@link GenaiCore.Agent.Draft} during {@link #createDraft}!
   */
  description: string

  /**
   * Clone this template into a draft, for editability.
   * NOTE: this will create a new {@link GenaiCore.Agent.Draft} instance and upsert it to the database!
   *
   * @param spec
   *          optional params for draft creation.
   * @return the created draft.
   */
  createDraft: member function(spec: GenaiCore.Agent.CreateDraftSpec): !GenaiCore.Agent.Draft py
}
