/**
 * Interface for running an agent
 */
private abstract type GenaiCore.Agent.RunIface {

  /**
   * Run a query using the agent.
   *
   * @param query
   *            query used to run the agent
   * @param kwargs
   *            additional keyword args passed to run the agent
   * @return result of running this agent
   */
  run: abstract member function(query: native, kwargs: map<string, native>): native

  /**
   * This API is the same as {@link #run} and is called from the default implementation of
   * {@link #run}. This is the preferred function to override for concrete
   * implementations of {@link GenaiCore.Agent}, because {@link #run}
   * has extra boiler-plate implementation that does, for example, logging.
   *
   * Run a query using the agent.
   *
   *
   * @param query
   *            query used to run the agent
   * @param kwargs
   *            additional keyword args passed to run the agent
   * @return result of running this agent
   */
  doRun: abstract member function(query: native, kwargs: map<string, native>): native
}
