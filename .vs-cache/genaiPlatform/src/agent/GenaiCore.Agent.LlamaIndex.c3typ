/**
 * Represents a LlamaIndex-based agent capable of handling queries using a customizable set of tools
 */
// TODO: PLAT-117078 Update to use the GenaiCore.Agent.FunctionCalling interface
private entity type GenaiCore.Agent.LlamaIndex { // extends GenaiCore.Agent.FunctionCalling

  /**
   * Session store for persisting session state between queries.
   */
  sessionStore: !GenaiCore.SessionStore

  /**
   * Collection of tools available to the agent
   */
  toolkit: !GenaiCore.Toolkit

  /**
   * The system prompt that defines the behavior of the agent.
   */
  systemPrompt: string = "You are an intelligent assistant that uses available tools to answer user queries accurately and efficiently."

  /**
   * The llm used by the agent.
   */
  llm: !GenaiCore.Llm.Client

  /**
   * Run a query using the agent
   *
   * @param query
   *           The input prompt or question
   * @param sessionId
   *           The session ID for the current interaction
   * @return
   *           The agent's response
   */
  runQuery: member function(query: !string, sessionId: string): !any py

  /**
   * Lazily initializes the LlamaIndex agent using the configured tools, LLM, and system prompt.
   * If already initialized, the existing agent is returned.
   *
   * @param agentName
   *           The name of the agent class to be initialized.
   *           Should only use "FunctionAgent" for now, see: https://next.ts.llamaindex.ai/docs/api/classes/FunctionAgent.
   * @param force
   *           If true, forces reinitialization of the cached agent.
   * @return
   *           The initialized (or existing) LlamaIndex agent instance.
   */
  initialize: member function(agentName: string = "FunctionAgent", force: boolean): !native py
}
