/**
 * Abstract base type for function calling agents
 *
 * Currently supports:
 * - {@link GenaiCore.Agent.LlamaIndex}
 */
private abstract extendable entity type GenaiCore.Agent.FunctionCalling extends GenaiCore.Agent {

  /**
   * System prompt used to define the behavior of this agent.
   */
  systemPrompt: string

  /**
   * {@link Llm client GenaiCore.Llm.Client} that manages auth, routing strategy, configurations, etc.
   */
  llmClient: GenaiCore.Llm.Client

  /**
   * {@link Toolkit GenaiCore.Toolkit} used by this agent. Note that it could be nested, use {@link GenaiCore.Toolkit#allTools} to get all tools available.
   */
  tools: [GenaiCore.Tool | GenaiCore.Toolkit]

  /**
   * {@link Session store GenaiCore.SessionStore} used by this agent, for short term memory only.
   */
  shortTermMemoryStore: GenaiCore.SessionStore

  // TODO: PLAT-117076
  // memory: GenaiCore.Memory

  run: ~ py
  uiConfigurableFields: ~ py
}
