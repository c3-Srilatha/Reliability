/**
 * Spec for {@link GenaiCore.DynamicPy.Service#createFromPyFile}.
 */
type GenaiCore.DynamicPy.Service.CreateSpec mixes Spec {

  /**
   * If provided, the service will be registered to this path. Otherwise, the service will not be created or registered.
   * {@see ModelRegistry#registerMlPipe}
   */
  modelRegistryPath: string

  /**
   * Optional description of the service
   */
  description: string

  /**
   * If provided, then this spec will be passed to {@link ModelInference#deploy}. If not provided, then the service will not be deployed.
   * NOTE: #modelRegistryPath must be provided if #deploySpec is provided.
   */
  deploySpec: ModelInference.DeploySpec

  /**
   * If provided, then the service will be registered to this route; otherwise, the service will not have a route registered.
   * {@see ModelInference#setRoute}
   */
  route: string

  /**
   * `overwrite` argument for {@link ModelInference#setRoute}.
   */
  overwriteRoute: boolean

  /**
   * If true, then the value returned by the Python code's `load()` function will not be validated on the call to {@link GenaiCore.DynamicPy.Base#fromPyFile}
   * and any errors will only surface on deployment. This may be useful/necessary in situations where the service requires specific hardware or data
   * that is not available at the time of creation.
   */
  // doNotValidate: boolean
}
