/**
 * A wrapper around {@link GenaiCore.DynamicPy.Base} to make it deployable to MIS via {@link GenaiCore.DynamicPy.Service}
 */
private extendable entity type GenaiCore.DynamicPy.Service.BasePipe extends MlCustomPipe<any, void, any> mixes SeedData type key "DPB" {
    /**
     * The instance that implements the service
     */
    base: !GenaiCore.DynamicPy.Base

    /**
     * The method that should be used to create instances of BasePipe to ensure that all metadata/runtime requirements
     * are propagated to the new instance.
     *
     * @param base
     *          the base dynamic python implementation.
     * @return the instantiated base pipe.
     */
    fromBase: function(base: !GenaiCore.DynamicPy.Base): !mixing GenaiCore.DynamicPy.Service.BasePipe py

    processSync: ~ py
    doProcess: ~ py
    process: ~ py
    nativeModel: ~ py
}
