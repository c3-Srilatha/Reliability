/**
 * A spec used to create a {@link GenaiCore.Tool.NativePy} instance.
 */
type GenaiCore.Tool.NativePy.Spec mixes Spec {

  /**
   * The action requirement for the tool.
   */
  actionRequirement: string serialized Action.Requirement = "py"

  /**
   * If this is set to true, then the tool will allow cross-runtime calls.
   * By default, cross-runtime calls will not be attempted, and instead a
   * runtime error will be raised.
   * If this is set to true, then the tool creator should ensure that the
   * inputs/outputs of the tool are serializable/non-native values.
   */
  allowCrossRuntimeCalls: boolean

  /**
   * Optional kwargs passed to {@link GenaiCore.Tool#initialize}.
   */
  initKwargs: json
}
