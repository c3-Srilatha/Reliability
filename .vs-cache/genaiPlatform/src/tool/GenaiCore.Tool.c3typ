/**
 * Interface that represents a "tool" within C3's generative AI ecosystem. Fundamentally, a tool is just a function
 * that performs a specific task. What makes this interface genai-specific is that it supports common
 * APIs so that an "agent" can use this tool to accomplish a larger task.
 * For more context on how tools are typically used by agents, see the
 * [OpenAi documentation](https://platform.openai.com/docs/api-reference/chat/create#chat-create-tools).
 *
 * Subtypes of `GenaiCore.Tool` should implement a constructor to populate the tool's fields.
 * @see {@link GenaiCore.Tool.C3Method} or {@link GenaiCore.Tool.NativePy} for examples.
 */
abstract extendable entity type GenaiCore.Tool mixes WithName, SeedData {

  /**
   * The flag used to mark whether the tool has been published. Defaults to `false`.
   */
  isPublished: boolean

  /**
   * Optional persisted kwargs that will be passed to #initialize
   */
  initKwargs: json

  /**
   * Initialize the tool. This is called before the first call to the tool. This is a good place to
   * do any one-time (expensive) setup that the tool needs.
   *
   * @param force
   *          if true, then the tool should re-initialize itself, even if it has already been initialized.
   */
  initialize: optional inline member function(force: boolean)

  /**
   * Call the tool with the given arguments.
   * **NOTE** this method can only be invoked from Python.
   * @param args
   *          flexible positional-args supplied to the call of the tool.
   * @param kwargs
   *          flexible keyword-args supplied to the call of the tool.
   * @return result of the call to the tool.
   */
  call: inline member function(args: native, kwargs: native): native py-pydantic

  /**
   * The callable function object that will be called when the tool is invoked.
   *
   * NOTE: this is intended for concrete sub-types to implement, e.g. {@link GenaiCore.Tool.NativePy}.
   * For tool usage, use {@link #call} instead and do not invoke this method directly!
   *
   * @return the callable function object
   */
  func: abstract cached property(): !native

  /**
   * Source code that contains both the tool/method's input as a `pydantic.BaseModel` and a standalone Python function
   * that invokes the method. This can be used to get a native callable and the input schema for the tool for agent
   * frameworks for which using the {@link GenaiCore.Tool.C3Method} tool directly is not possible.
   *
   * @return the source code
   */
  standalonePyFuncCode: abstract cached property(): !string

  /**
   * A user-facing description of what this tool does. This is only used for documentation and display/discovery.
   * If not provided, defaults to #descriptionForLlm.
   */
  description: string

  /**
   * A description of what this tool does. This will be used by an LLM to
   * to choose when and how to call the tool.
   * e.g. "Get the current weather in a given location."
   *
   * {@see description}
   */
  descriptionForLlm: !string

  /**
   * A schema for the arguments that the {@link #call} function supports, described
   *          as a JSON Schema object. See this as reference: {@link https://json-schema.org/understanding-json-schema}.
   *          If nothing is returned, then that means that the function does not accept any arguments.
   *          e.g.
   *          ```https://json-schema.org/understanding-json-schema/reference/type
   *          {
   *            "type": "object",
   *            "properties": {
   *               "location": {"type": "string", "description": "The city and state, e.g. 'San Francisco, CA'"},
   *               "unit": {"type": "string", "enum": ["celsius", "fahrenheit"]}
   *            },
   *            "required": ["location"]
   *          }
   *          ```
   */
  argsSchema: !?json

  /**
   * A property that returns a Pydantic model that represents the arguments schema for the tool.
   *
   * @return the Pydantic model
   */
  argsSchemaPydanticModel: abstract inline cached property(): !native py-pydantic

  /**
   * A serialized representation of the Python type that the tool's `call` function returns.
   * e.g. `"int"`, `"str"`, `"typing.List[str]"`
   */
  outputPyType: !?json

  /**
   * A helper function to validate whether the given referenceType is valid for the default implementation of this tool.
   * In particular, this method checks that
   *    1. all fields are primitive types or collections of primitives
   *    2. all fields have documentation
   *
   * Exposed for testing purposes.
   * @param referenceType
   *            The Type to validate
   */
  validateReferenceType: private inline function(referenceType: !Type) py-pydantic

  /**
   * Return the Python type that corresponds to the given {@link ValueType}.
   * @param valueType
   *        The {@link ValueType} to convert to a Python type.
   * @param allowReferenceTypes
   *        Whether to allow reference types. Currently, 'single-level' reference types can be supported
   * @return The Python type that corresponds to the given {@link ValueType}.
   */
  valueTypeToPyType: inline function(valueType: !ValueType, allowReferenceTypes: boolean): !native py-pydantic

  /**
   * Internal helper function to get the details to create a Pydantic model for a given field or parameter.
   * @param fieldOrParam
   *        The field or parameter for which to create a Pydantic Field
   * @param methodTypeParamDocParsed
   *        If `fieldOrParam` is a param, the parsed documentation from {@link MethodType#docParsed} for that param
   *
   * @return A tuple of the Pydantic field name, the python type ({@link valueTypeToPyType}) and the Pydantic Field
   */
  pydanticTuplesForFieldOrParam: private inline function(fieldOrParam: !FunctionParam | !FieldType,
                                                  methodTypeParamDocParsed: ParameterDocumentation): !native py-pydantic

  /**
   * Return whether the given {@link ValueType} is supported by the GenaiCore.Tool framework.
   * @param valueType
   *        The {@link ValueType} to convert to a Python type.
   * @param allowReferenceTypes
   *        Whether to allow reference types. Currently, 'single-level' reference types can be supported
   * @return Whether the given {@link ValueType} is supported by the GenaiCore.Tool framework.
   */
  isSupportedValueType: inline function(valueType: !ValueType, allowReferenceTypes: boolean): !boolean py-pydantic

  /**
   * Return a string representation of the given Python type.
   * Used for things such as producing #standalonePyFuncCode given the native function and Python classes
   *
   * @param pyType
   *       The Python type to convert to a string.
   * @return The string representation of the given Python type.
   */
  pyTypeToStr: inline function(pyType: !native): !string py-pydantic

  /**
   * Produces a [Langchain Tool](https://python.langchain.com/docs/concepts/tools/) that wraps this tool.
   * This must be called in a runtime where langchain is installed.
   *
   * @return The native Langchain tool object
   */
  toLangchainTool: inline member function(): !native py-pydantic

  /**
   * Produces a [LlamaIndex Tool](https://docs.llamaindex.ai/en/stable/module_guides/deploying/agents/tools/)
   * that wraps this tool. This must be called in a runtime where llama-index is installed.
   *
   * @return the native LlamaIndex tool object
   */
  toLlamaIndexTool: inline member function(): !native py-pydantic

  /**
   * Produces a [PydanticAI Tool](https://ai.pydantic.dev/tools/)
   * that wraps this tool. This must be called in a runtime where pydantic-ai is installed.
   *
   * @return the native PydanticAI tool object
   */
  toPydanticAITool: inline member function(): !native py-pydantic

  /**
   * @return the description of this tool in json form, to be compatible with [OpenAi function calling](https://platform.openai.com/docs/guides/function-calling).
   */
  funcCallJson: inline member function(): !json py-pydantic

  /**
   * a list of arguments that the {@link #call} function takes but which are meant to be supplied by the system
   * or agent, and **NOT** the llm. The default implementation is an empty list
   *         e.g. ["apiKey"], ["username"]
   */
  // TODO: PLAT-108259
  // nonLlmArgs: [string] //inline member function(): [string] py
}
