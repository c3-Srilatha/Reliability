/**
 * A spec for creating a {@link GenaiCore.Tool.C3Method} instance.
 */
type GenaiCore.Tool.C3Method.Spec mixes Spec {
  /**
   * If not specified, the ID will be generated to include the method name and a random suffix.
   */
  toolId: string

  /**
   * The base version of {@link GenaiCore.Tool.C3Method} currently only supports methods whose parameters
   * and return value are all primitives ({@link PrimitiveType}). If `skipValidation` is not set `true`, then
   * the method will be validated to ensure that it meets this requirement.
   */
  skipValidation: boolean

  /**
   * The overload of the method to use. If the method has only one overload, this field should be omitted.
   */
  overload: int

  /**
   * If true, then the created tool will be returned but not upserted.
   */
  doNotUpsert: boolean
}
