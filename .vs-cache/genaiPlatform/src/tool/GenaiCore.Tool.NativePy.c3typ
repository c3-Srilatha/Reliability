/**
 * A tool that is a wrapper around a Python function. Note that all metadata provided
 * to the llm will be parsed from the Python function's docstring(s), so they should be as clear as possible.
 *
 * All functions must have a docstring AND use `typing.Annotated` parameters to provide descriptions.
 *
 * e.g.
 * ```py
 * from typing import Annotated
 * def divide(a: Annotated[float, "The quotient"], b: Annotated[float, "The divisor"]) -> float:
 *     """Divide one number by another."""
 *     return a / b
 * ```
 */
entity type GenaiCore.Tool.NativePy extends GenaiCore.Tool mixes GenaiCore.NativePyUtil type key "NTV" {

  /**
   * The spec used to construct this tool. See {@link #createFromPySrc} and {@link #createFromPyFile}.
   * Contains options for the tool execution.
   */
  spec: GenaiCore.Tool.NativePy.Spec

  /**
   * @inheritdoc
   *
   * If implemented, the initialize function will share the same #actionRequirement as the tool.
   * If the tool's requirement is not compatible with the agent's, (requiring a cross-process call),
   * it is recommended to serve the tool in an {@link Engine}.
   */
  initialize: ~ py

  standalonePyFuncCode: ~ py
  func: ~ py
  argsSchemaPydanticModel: ~ py

  /**
   * Helper function that compiles the source code of this tool; cached to avoid reloading globals every time.
   *
   * @return A map of attributes of the tool
   */
  compileSrc: private cached inline member function(): !map<string, native> py

  /**
   * Create a new GenaiCore.Tool.NativePy from the string of a Python function.
   * @param pySrc
   *          The python source code.
   *          The function must be documented with docstring and use `typing.Annotated` parameters.
   * @param toolName
   *          The name of the tool to create
   * @param spec
   *          A spec to control options for the tool creation
   *
   * @return A new GenaiCore.Tool.NativePy instance
   */
  createFromPySrc: function(pySrc: !string, toolName: !string, spec: GenaiCore.Tool.NativePy.Spec): !mixing GenaiCore.Tool.NativePy py

  /**
   * Create a new GenaiCore.Tool.NativePy from a Python file at the given path, which can be either
   * a local path (on Jupyter) or a file elsewhere in the C3 File System. If the file is not local,
   * a **NEW** copy will be created for the new tool instance. To change the implementation, you must
   * create a new tool.
   *
   * @param filePath
   *          The path to the python file. This can be either a local path or the path to a file in the C3 File System.
   *          The function must be documented with docstring and use `typing.Annotated` parameters.
   * @param toolName
   *          The name of the tool to create
   * @param spec
   *          A spec to control options for the tool creation
   *
   * @return A new GenaiCore.Tool.NativePy instance
   */
  createFromPyFile: function(filePath: !string, toolName: !string, spec: GenaiCore.Tool.NativePy.Spec): !mixing GenaiCore.Tool.NativePy py
}
