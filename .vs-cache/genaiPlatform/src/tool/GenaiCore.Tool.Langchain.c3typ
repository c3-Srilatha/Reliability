/**
 * A specialized tool that extends {@link GenaiCore.Tool} to integrate langchain native tools.
 * This entity allows execution of Langchain tools within the `GenaiCore.Tool` framework.
 *
 * Example usage:
 * ```py
 * langchain_tool = SomeLangchainTool()
 * c3_tool = GenaiCore.Tool.Langchain.createFromLangchainTool(langchain_tool)
 * result = c3_tool.call(args)
 * ```
 */
entity type GenaiCore.Tool.Langchain extends GenaiCore.Tool type key "LAN" {
  /**
   * This field represents the serialized string of the langchain native tools.
   */
  nativeTool: !string

  /**
   * Serializes langchain native tool and stores it in {@link #nativeTool}.
   * It captures the tool's description and argument schema (`args`).
   * @param tool
   *        The Langchain tool instance to be serialized.
   * @returns A `GenaiCore.Tool.Langchain` instance.
   */
  createFromLangchainTool: inline function(tool: !native): !GenaiCore.Tool.Langchain py

  func: ~ py
}
