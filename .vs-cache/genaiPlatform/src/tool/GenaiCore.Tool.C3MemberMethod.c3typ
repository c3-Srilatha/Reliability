/**
 * A subtype of {@link GenaiCore.Tool.C3Method} that wraps a member method on an instance
 */
extendable entity type GenaiCore.Tool.C3MemberMethod extends GenaiCore.Tool.C3Method type key "MEM" {
  /**
   * The tool will invoke #call and #func on this instance.
   */
  @db(persistAllFields=true)
  instance: !Obj

  /**
   * Indicates how {@link GenaiCore.Tool.C3MemberMethod#instance} should be instantiated for use.
   * By default,
   *      * {@link Persistable} (entity) instances will be instantiated via `forId`
   *      * {@link Engine} instances will be instantiated via `forName`
   *      * All other instances will be instantiated via `make` using the full instance json at the time
   *        {@link GenaiCore.Tool.C3MemberMethod#createFromMethodType} was called)
   */
  instantiationMethod: !string enum('forId', 'forName', 'make')

  /**
   * Given an instance and method, return a corresponding C3MemberMethod tool instance.
   * **NOTE**: If the method has more than one overload, then GenaiCore.Tool.C3MemberMethod.Spec#overload must be specified.
   *
   * @param instance
   *          The instance on which the method will be called
   * @param methodName
   *          The name of the method
   * @param spec
   *          The spec controlling other options for creating the tool
   *
   * @return the created tool instance
   */
  createFromObjAndMethodName: function(instance: !Obj, methodName: !string, spec: GenaiCore.Tool.C3MemberMethod.Spec): !mixing GenaiCore.Tool.C3MemberMethod py

  /**
   * Given a {@link MethodType}, return a corresponding C3MemberMethod tool instance.
   *
   * @param instance
   *          The instance on which the method will be called
   * @param methodTypeRef
   *          Reference to the target methodType
   * @param spec
   *          The spec controlling other options for creating the tool
   *
   * @return the created tool instance
   */
  createFromObjAndMethodType: function(instance: !Obj, methodTypeRef: !MethodTypeRef, spec: GenaiCore.Tool.C3MemberMethod.Spec): !mixing GenaiCore.Tool.C3MemberMethod py

  func: ~ py
  allowMemberMethods: ~ py
}
