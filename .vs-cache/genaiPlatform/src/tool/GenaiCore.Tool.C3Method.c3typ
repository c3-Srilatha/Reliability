/**
 * A tool that wraps an existing C3 type method.
 *
 * **NOTE** For now, only static methods or member methods on {@link DefaultInstance} types are supported.
 */
extendable entity type GenaiCore.Tool.C3Method extends GenaiCore.Tool type key "C3M" {
  /**
   * Whether to allow member methods.
   *
   * @return true if member methods are allowed
   */
  allowMemberMethods: function(): boolean py

  /**
   * Given a method, return a corresponding C3Method tool instance.
   *
   * **NOTE**: If the method has more than one overload, then {@link GenaiCore.Tool.C3Method.Spec#overload}
   * must be specified.
   *
   * @param type
   *          The type on which the method is defined
   * @param methodName
   *          The name of the method
   * @param spec
   *          The spec controlling other options for creating the tool
   *
   * @return the created instance
   */
  createFromMethodName: function(type: !Type, methodName: !string, spec: GenaiCore.Tool.C3Method.Spec):
                                                      !mixing GenaiCore.Tool.C3Method py

  /**
   * Given a {@link MethodType}, return a corresponding C3Method tool instance
   *
   * @param methodTypeRef
   *          Reference to the target methodType
   * @param spec
   *          The spec controlling other options for creating the tool
   *
   * @return the created instance
   */
  createFromMethodType: function(methodTypeRef: !MethodTypeRef, spec: GenaiCore.Tool.C3Method.Spec):
                                                      !mixing GenaiCore.Tool.C3Method py

  /**
   * Internal helper function for #createFromMethodType
   *
   * @param methodTypeRef
   *          Reference to the target methodType
   * @param calleeInstantiator
   *          A string that can instantiate the type or instance on which the method will be invoked
   *          e.g. `getattr(c3, "MyType")` or `c3.MyType(id="foo").get()`
   * @param spec
   *          The spec controlling other options for creating the tool
   *
   * @return the created instance
   */
  doCreateFromMethodType: private function(methodTypeRef: !MethodTypeRef, calleeInstantiator: !string, spec: GenaiCore.Tool.C3Method.Spec):
                                                      !mixing GenaiCore.Tool.C3Method py
  /**
   * A reference to the {@link MethodType} corresponding to this C3Method tool.
   */
  methodType: !MethodTypeRef

  /**
   * The code used for #standalonePyFuncCode
   */
  standaloneFuncCode: private !string

  standalonePyFuncCode: ~ py
  func: ~ py
  argsSchemaPydanticModel: ~ py

  /**
   * A helper function to validate whether the given methodType is valid for the default implementation of this tool.
   * In particular, this method checks that
   *    1. all parameters are primitive types
   *    2. the method and all parameters have documentation
   *
   * Exposed for testing purposes.
   * @param methodType
   *            The methodType to validate
   * @param allowMemberMethods
   *            Whether to allow member methods
   */
  validateMethodType: private inline function(methodType: !MethodType, allowMemberMethods: boolean) py

  /**
   * Returns the {@link MethodTypeRef} corresponding to the given method name and spec.
   *
   * @param typeMeta
   *          TypeMeta of the type on which the method is defined
   * @param methodName
   *          The name of the method
   * @param spec
   *          The spec controlling other options for creating the tool
   * @return the MethodTypeRef
   */
  methodTypeFromNameAndSpec: private inline function(typeMeta: !TypeMeta, methodName: !string, spec: GenaiCore.Tool.C3Method.Spec):
                                                      !MethodTypeRef py

  /**
   * @return the template string used to create #standaloneFuncCode
   */
  funcTemplateString: private inline function(): !string py

  /**
   * For methods which take {@link ReferenceType} parameters, we create a corresponding Pydantic model for the
   * input schema that can be used to constrain and validate llm-provided inputs. The C3 Method, however, cannot
   * take a Pydantic model as an input, so we need to convert the Pydantic model to a native Python
   * dictionary before passing it to the method. This function performs that conversion.
   *
   * @param args
   *        The arguments to the method, as a native Python list
   * @param kwargs
   *        The keyword arguments to the method, as a native Python dictionary
   * @return A tuple of the converted Pydantic inputs (i.e. `(coverted_args, converted_kwargs)`)
   */
  convertPydanticInputs: private inline function(args: native, kwargs: native): !native py
}
