/**
 * A collection of {@link GenaiCore.Tool} instances that are logically grouped together.
 */
@db(unique=['name'])
extendable entity type GenaiCore.Toolkit mixes SeedData {

  /**
   * A brief description of the logical group of tools specified in #tools.
   */
  description: string

  /**
   * All tools (or toolkits) available in this toolkit.
   */
  tools: [GenaiCore.Tool | GenaiCore.Toolkit]

  /**
   * The flag used to mark whether the toolkit has been published. Defaults to `false`.
   */
  isPublished: boolean

  /**
   * A flattened list of all tools in this toolkit and its sub-toolkits.
   *
   * @return A list of all tools in this toolkit and its sub-toolkits.
   */
  allTools: inline cached member function(): [GenaiCore.Tool] py

  /**
   * Saves this toolkit and all its #tools to the package.
   * Any Toolkits in #tools will also be published.
   * When saving, all tools will be recreated with `id`s that contain the toolkit's #name as a prefix.
   *
   * **NOTE**: This can only be executed if the current app's package is writable (i.e. `c3.pkg().appMode() == "dev"`).
   * This can be changed via `c3.pkg().setDevMode(True)`.
   *
   * This method, and **not publish**, is the recommended way to publish a Toolkit and its included tools to a package.
   *
   * @param republish
   *        If this Toolkit or any Toolkits in #tools have already been published, then an error will be thrown
   *        unless `republish` is set to true, in which case the toolkit (and any nested toolkits) will be
   *        republished/overwritten.
   * @return The published toolkit
   */
  publishToolkit: member function(republish: boolean): !mixing GenaiCore.Toolkit py
}
