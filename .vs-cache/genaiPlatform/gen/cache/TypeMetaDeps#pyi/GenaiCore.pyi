    class SessionStore():
        """
        Interface for a store of session state.
        Example usage:
        ```py
        store = c3.GenaiCore.SessionStore.Kv(id="my_store").upsert()
        
        session = store.initState("my_session")
        for i in range(10):
          curr_state = store.getState(session) or {}
          print(curr_state)
          new_state = curr_state
          new_state[f"iter{i}"] = i
          # use the new returned Session object for the next `getState` call!
          session = store.updateState(session, new_state)
        ```
        
        @remarks this represents a made instance of GenaiCore.SessionStore
        """
        
