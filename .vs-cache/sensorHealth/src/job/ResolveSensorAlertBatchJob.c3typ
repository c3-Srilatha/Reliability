/**
 * The batch job to resolve sensors alerts.
 */
entity type ResolveSensorAlertBatchJob extends BatchJob<ResolveSensorAlertBatchJob, ResolveSensorAlertBatchJobOptions, ResolveSensorAlertBatch> type key 'RSABJ' {
  /**
   * Starts a {@link ResolveSensorAlertBatchJob} if one isn't in progress, otherwise returns the in progress job.
   * @param batchSize
   *        The size of each batch.
   * @return A started {@link ResolveSensorAlertBatchJob}.
   */
  startJob: function (batchSize: int = 100): !ResolveSensorAlertBatchJob js-rhino

  doStart:      ~ js-rhino

  processBatch: ~ js-rhino
}
