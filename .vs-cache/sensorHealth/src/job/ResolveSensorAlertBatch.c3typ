/**
 * `ResolveSensorAlertBatch` defines the configuration for processing a batch of sensor alerts.
 * 
 * - `sensors`: A list of `Sensor` entities that need to be processed in this batch.
 */
type ResolveSensorAlertBatch {
  /**
   * List of {@link Sensor}s to be processed in this batch job.
   */
  sensors: [Sensor]
}
