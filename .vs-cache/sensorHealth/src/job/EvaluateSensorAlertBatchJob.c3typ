/**
 * The batch job to evaluate sensors alerts.
 */
entity type EvaluateSensorAlertBatchJob extends BatchJob<EvaluateSensorAlertBatchJob, EvaluateSensorAlertBatchJobOptions, EvaluateSensorAlertBatch> mixes Value type key 'ESABJ' {

  /**
   * Starts a {@link EvaluateSensorAlertBatchJob} if one isn't in progress, otherwise returns the in progress job.
   * @param batchSize
   *        The size of each batch.
   * @return A started {@link EvaluateSensorAlertBatchJob}.
   */
  startJob: function(batchSize: int = 100): !EvaluateSensorAlertBatchJob js-rhino

  doStart:      ~ js-rhino
  processBatch: ~ js-rhino
}
