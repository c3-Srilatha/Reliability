/**
 * `ReliabilitySensorAlert` is a deprecated entity that extends the `TimedValue` type and represents 
 * an alert related to sensor data. It has been replaced by the `SensorHealthAlert` entity.
 * 
 * This entity is deprecated in version 8.3.4 and should be replaced by the `SensorHealthAlert`.
 */
@deprecated(finalVersion='8.3.4', details='Use SensorHealthAlert')
entity extendable type ReliabilitySensorAlert mixes TimedValue type key 'SNSRALRT' {

  /**
   * `sensor`: The {@link Sensor} that this alert refers to. This field represents the sensor 
   * generating the alert.
   */
  sensor: !Sensor

  /**
   * `sensorAlertCategory`: Defines the type or category of the `ReliabilitySensorAlert`. 
   * It is represented by the `SensorHealthCategory` enum.
   */
  sensorAlertCategory: !SensorHealthCategory
}
