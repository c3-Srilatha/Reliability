/**
 * `SensorHealthAlertStateTransition` represents a state transition in a sensor health alert system. 
 * It is part of a state machine that tracks the progression between different states of the sensor health alert.
 * 
 * This entity type mixes with `StateMachineTransition` to inherit the necessary functionality for state transitions.
 */
entity type SensorHealthAlertStateTransition mixes StateMachineTransition<SensorHealthAlertState, SensorHealthAlertStateTransition> schema name 'SNSR_LRT_TRNS'
