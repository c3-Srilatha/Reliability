/**
 * Configurations for Sensor Health functionality.
 */
type SensorHealthConfig mixes Singleton, Config {

  /**
   * Timezone of evaluation in server-side logic for Sensor Health purposes. Used in {@link SensorHealthCategory#evaluateAlert}
