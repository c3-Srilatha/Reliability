/**
 * A sensor health alert that is raised when a {@link Sensor} experiences a health issue.
 */
entity extendable type SensorHealthAlert mixes FeatureEvaluatable, TimedValue, StateMachine<SensorHealthAlertStateHistory, SensorHealthAlertState, SensorHealthAlertStateTransition> type key 'SNSRALRT' {

  /**
   * The {@link Sensor} that this alert refers to
   */
  sensor: !Sensor

  /**
   * Type of SensorHealthAlert
   */
  sensorAlertCategory: !SensorHealthCategory
}
