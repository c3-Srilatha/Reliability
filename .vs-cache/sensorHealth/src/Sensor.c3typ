/**
 * @inheritdoc
 */
remix type Sensor {

  /**
   * List of {@link SensorHealthAlert}
   */
  @db(order='descending(timestamp)')
  sensorAlerts: [SensorHealthAlert](sensor)

  /**
   * The latest triggered {@link SensorHealthAlert} for this Sensor.
   */
  latestSensorAlert: SensorHealthAlert calc sensorAlerts[0]

  /**
   * List of {@link SensorHealthAlert}
   */
  @db(order='descending(timestamp)', filter='currentState.id == "Open"')
  openSensorAlerts: [SensorHealthAlert](sensor)

  /**
   * The latest triggered {@link SensorHealthAlert} that is still open.
   */
  latestOpenSensorAlert: SensorHealthAlert calc openSensorAlerts[0]

  /**
   * The array of monitored {@link SensorHealthCategory}s
   */
  monitoredAlertCategories: [SensorHealthCategory] schema suffix 'MAC'

  /**
   * The monitored alert flags represented as a string to display in the grid.
   */
  monitoredAlertCategoriesAsString: string calc join(monitoredAlertCategories.displayName, ", ")

  /**
   * Whether or not this sensor is monitored for sensor health purposes.
   */
  isMonitored: boolean calc exists(monitoredAlertCategories)

  /**
   * The monitored status displayed in the grid
   */
  isMonitoredAsString: string calc isMonitored ? "MONITORED" : "NOT_MONITORED"

  /**
   * Updates the monitor settings for the given sensors.
   *
   * @param sensorIds
   *     The list of sensor ids to update.
   * @param alertFlagsToSet
   *     The list of alert flags to set.
   */
  updateMonitorSettings: function(sensorIds: [string], alertFlagsToSet: [string]) js-rhino
}
