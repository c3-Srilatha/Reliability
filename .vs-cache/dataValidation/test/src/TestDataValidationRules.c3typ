/**
 * Test type for data validation rules.
 */
type TestDataValidationRules mixes Value {

  /**
   * Checks if id and name fields match.
   * @param args
   *     map that contains any value that the function could needs to run the logic, like subjectId.
   */
  idMatchesName: function(args: map<string, any>): DataValidationRuleResult js-rhino

  /**
   * Checks if the {@link TestDataValidationSubject#passFilter} is true.
   * @param args
   *     map that contains any value that the function could needs to run the logic, like subjectId.
   */
  matchPassFilter: function(args: map<string, any>): DataValidationRuleResult js-rhino

  /**
   * Waits for a couple seconds and returns a dummy result.
   * @param args
   *     map that contains any value that the function could needs to run the logic, like subjectId.
   */
  dummyRuleWithResult: function(args: map<string, any>): [DataValidationRuleResult] js-rhino

  /**
   * Immediately returns nothing.
   * @param args
   *     map that contains any value that the function could needs to run the logic, like subjectId.
   */
  dummyRuleWithoutResult: function(args: map<string, any>): DataValidationRuleResult js-rhino

  /**
   * Returns a dummy result with the subject as a related entity
   * @param args
   *     map that contains any value that the function could needs to run the logic, like subjectId.
   */
  dummyRuleWithSubjectResult: function(args: map<string, any>): DataValidationRuleResult js-rhino

  /**
   * Immediately throws an error.
   * @param args
   *     map that contains any value that the function could needs to run the logic, like subjectId.
   */
  throwError: function(args: map<string, any>): DataValidationRuleResult js-rhino

  /**
   * It is used for testing case when {@DataValidationRuleResult#output} does not match with {@DataValidationRule#possibleOutputs}.
   * @param args
   *     map that contains any value that the function could needs to run the logic, like subjectId.
   */
  notMatchingPossibleOutputs: function(args: map<string, any>): DataValidationRuleResult js-rhino
}
