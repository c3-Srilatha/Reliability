/**
 * Test entity type to evaluate the mapReduce flow.
 * The fields are for the purpose of creating rules about them.
 */
entity type TestSmartBulb mixes DataValidationSubject schema name "TST_BLB" {

  /**
   * Test field that represents enum values.
   */
  bulbType: string enum("LED", "N/A", "INCAN")

  /**
   * Test field that describes a number value.
   */
  wattage: !decimal

  /**
   * Test field that describes a datetime value.
   */
  startDate: !datetime

  /**
   * Test field that represents a string value.
   */
  status: string = "OFF"

  /**
   * Test field to test reference field population.
   */
  apartments: [TestSmartBulbToApartmentRelation](from)
}
