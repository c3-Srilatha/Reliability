/**
 * Test type for data validation rules.
 */
type TestSmartBulbRules {

  /**
   * Checks if {@link TestSmartBulb#bulbType} is not 'N/A' or Null.
   */
  bulbHasTypeCheck: function(args: map<string, any>):DataValidationRuleResult js-rhino

  /**
   * Checks if {@link TestSmartBulb#bulbType} is 'LED' or 'INCAN'.
   */
  bulbTypeCheck: function(args: map<string, any>):DataValidationRuleResult js-rhino


  /**
   * Checks if {@link TestSmartBulb#status} is 'ON' or 'OFF'.
   */
  bulbWattageForStatusOff: function(args: map<string, any>):DataValidationRuleResult js-rhino

  /**
   * Checks if {@link TestSmartBulb#wattage} is grather to Zero.
   */
  bulbWattageCheck: function(args: map<string, any>):DataValidationRuleResult js-rhino

  /**
   * Checks if {@link TestSmartBulb#startDate} exists.
   */
  bulbStartDateCheck: function(args: map<string, any>):DataValidationRuleResult js-rhino

  /**
   * Checks if {@link TestSmartBulb#startDate} is less than now.
   */
  bulbStartDateIntervalCheck: function(args: map<string, any>):DataValidationRuleResult js-rhino

  /**
   * Checks if {@link TestSmartBulb#startDate} is grather than 0 and less than 8.
   */
  bulbWattageIntervalCheck: function(args: map<string, any>):DataValidationRuleResult js-rhino

  /**
   * Checks if {@link TestSmartBulb#apartments} exists.
   */
  apartmentWithBulbs: function(args: map<string, any>):DataValidationRuleResult js-rhino

  /**
   * Checks if {@link TestApartment#number} in a {@link TestSmartBulb#apartments} contains a department number.
   */
  bulbApartmentsNumberCheck: function(args: map<string, any>):DataValidationRuleResult js-rhino

  /**
   * Checks if {@link TestApartment#buildingId} in a {@link TestSmartBulb#apartments} exists.
   */
  bulbApartmentsBuildingCheck: function(args: map<string, any>):DataValidationRuleResult js-rhino
}
