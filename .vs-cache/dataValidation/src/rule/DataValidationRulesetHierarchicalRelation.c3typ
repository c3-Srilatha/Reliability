/**
 * Relation type containing fields to explain the relationship between {@link DataValidationRuleset}s
 */

entity type DataValidationRulesetHierarchicalRelation schema name "DVRHR" {
  /**
   * The {@link DataValidationRuleset} this relation comes from. This is the parent ruleset.
   */
  from: !DataValidationRuleset

  /**
   * The {@link DataValidationRuleset} this relation connects to. This is the child ruleset.
   */
  to: !DataValidationRuleset
}
