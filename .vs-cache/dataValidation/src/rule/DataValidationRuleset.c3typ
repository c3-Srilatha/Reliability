/**
 * A ruleset encompassing a set of data integration validation rules (aka {@link DataValidationRule}s). Used to
 * group the rules into sets of similar rulesets such as validating data model requirements and to run that group
 * of rules' logic all at once either synchronously or in a batch job.
 */
entity type DataValidationRuleset schema name 'DV_RULESET' {

  /**
   * The name of the ruleset.
   */
  name: !~

  /**
   * A description of what this ruleset encompasses and when in the deployment process rules of this ruleset should be used.
   */
  description: !string

  /**
   * A map whose keys indicate the keys of the argument map passed into the target {@link DataValidationRule#action action} for any rule which is part of this ruleset.
   * The values are a description of what these keys should be populated with.
   */
  argSpec: map<string, string> schema suffix 'ARGS'

  /**
   * The rules belonging to this ruleset.
   */
  rules: [DataValidationRule](ruleset)

  /**
   * Type mixing {@link DataValidationSubject} to validate.
   */
  subjectType: Type

  /**
   * String that contains filter to fetch subjects.
   * Used if subjectsArgKey is not specified or defined
   */
  subjectsFilterArgKey: string

  /**
   * String that contains the key for the subjectType objects.
   */
  subjectsArgKey: string

  /**
   * Performs data validation on the ruleset and its child ruleset. Uses a batch job if no rules from
   * this rule or its descendants have dependencies. Uses a map-reduce otherwise.
   * @param args
   *     The arguments which are passed into the target {@link DataValidationRule#action action} of each rule.
   * @param spec
   *     Extra arguments to specify desired validation results.
   * @return
   *     If spec.doNotRun is false, returns the run(s) which are being performed by the respective job
   *     triggered by this function:
   *        Returns a {@link DataValidationRun} if using batch job.
   *        Returns an array of {@link DataValidationRun} if using a map-reduce.
   *     If spec.doNotRun is true:
   *        Returns the job (map-reduce or batch job) without starting or persisting it.
   *
   */
  validate: member function(args: map<string, any>, spec: DataValidationExecutionSpec):
    DataValidationRun | [DataValidationRun] | DataValidationBatchJob | DataValidationMapReduceJob js-rhino

  /**
   * Performs data validation on the ruleset.
   *
   * @param args
   *     The arguments which are passed into the target {@link DataValidationRule#action action} of each rule.
   * @param spec
   *     Extra arguments to specify desired validation results.
   * @param rules
   *    All {@link DataValidationRule}s to validate.
   * @return
   *     The entity which was created for this validation run. If spec.doNotRun is true, returns the job instead.
   */
  batchJobValidation: private member function(rules: ![DataValidationRule],
                                        args: map<string, any>,
                                        spec: !DataValidationExecutionSpec):
                                        DataValidationRun | DataValidationBatchJob js-rhino
  /**
   * Fetches the {@link DataValidationResult}s for the latest {@link DataValidationRun} for the ruleset.
   *
   * @param spec
   *     Extra arguments to specify desired results. Applied on {@link DataValidationResult}.
   * @return FetchResult<DataValidationResult>
   *     The results from the latest validation run for the ruleset.
   */
  fetchLatestResults: member function(spec: FetchSpec): FetchResult<DataValidationResult> js-rhino

  /**
   * All incoming {@link DataValidationRulesetHierarchicalRelation}s
   */
  childrenRelations: [DataValidationRulesetHierarchicalRelation](from)

  /**
   * The {@link DataValidationRulesetResult} of this ruleset.
   */
  result: DataValidationRulesetResult

  /**
   * Returns all {@link DataValidationRule}s associated with this and all descendent {@link DataValidationRuleset}s.
   */
  getSelfAndDescendantRules: member function(): [DataValidationRule] js-rhino

  /**
   * @param allRules
   *    All {@link DataValidationRule}s to validate.
   * @param sourceRules
   *    All {@link DataValidationRule}s without parents.
   * @param args
   *     The arguments which are passed into the target {@link DataValidationRule#action action} of each rule.
   * @param spec
   *     Arguments to configure the @{DataValidationMapReduce}.
   * @return
   *     The runs that were created for this validation. If spec.doNotRun is true, returns the job instead.
   */
  mapReduceValidation: private member function(allRules: ![DataValidationRule],
                                            sourceRules: [DataValidationRule],
                                            args: map<string, any>,
                                            spec: !?DataValidationExecutionSpec):
                                            [DataValidationRun] |  DataValidationMapReduceJob js-rhino
}
