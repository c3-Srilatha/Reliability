/**
 * A single rule for data validation. Typically corresponds to one desired property of one type. The main type which
 * users will seed/create in their application to define data model validation logic.
 */
entity type DataValidationRule schema name 'DV_RULE' {

  /**
   * The name of the rule.
   */
  name: !~

  /**
   * An description of what kind of validation checks this rule performs.
   */
  description: !string

  /**
   * The ruleset this rule belongs to.
   */
  ruleset: !DataValidationRuleset

  /**
   * Target action that performs the validation required for this rule.
   * This function must take in an argument `args`, which is specified by the rule's {@link DataValidationRuleset#argSpec}.
   * All other arguments must be specified in this field directly.
   * This function returns any violations of the rule in the form of {@link DataValidationRuleResult}(s) (single entity or list are both okay).
   * It should return an empty list if the rule is not violated in any way.
   */
  action: !PartiallyAppliedAction schema suffix 'ACTION'

  /**
   * The type that this rule primarily deals with. Only used for display/informational purposes.
   */
  targetType: Type

  /**
   * Whether or not this rule is active and executed when the associated ruleset is run.
   */
  inactive: boolean

  /**
   * Whether or not this rule should be batched with other rules to be run sequentially and synchronously.
   * For rules which are known to take a long time, this field should be true.
   */
  doNotBatch: boolean

  /**
   * All dependencies of the rule.
   */
  dependencies: [DataValidationRuleDependency] schema suffix 'DVRDP'

  /**
   * Represents possible outputs of  the {@link DataValidationRule#ruleset}.
   */
  possibleOutputs: set<string> schema suffix 'PO'

  /**
   * Executes the rule and returns any violations.
   *
   * @param args
   *     The arguments which are passed into the {@link DataValidationRule#action action} of the rule.
   * @param run
   *     The {@link DataValidationRun} to associate any results with, if any.
   * @param doNotPersist
   *     Whether to persist any resulting {@link DataValidationResult} objects.
   * @return [DataValidationResult]
   *     The results from the execution of this rule.
   */
  executeRule: member function(args: map<string, any>,
                               run: DataValidationRun,
                               doNotPersist: boolean): [DataValidationPersistedResult] js-rhino

  /**
   * Executes all provided rules using {@link DataValidationRule#executeRule}.
   */
  executeRules: function(rules: ![DataValidationRule],
                         args: map<string, any>,
                         run: DataValidationRun,
                         doNotPersist: boolean): [DataValidationPersistedResult] js-rhino

  /**
   * Sets the {@link DataValidationRule#inactive} field.
   */
  setInactiveStatus: member function(status: boolean) js-rhino

  /**
   * Return an ordered array of {@link DataValidationRule}s after the application of topological sort
   * to a set of {@link DataValidationRule rules} that represents a directed acyclic graph.
   *
   * @param allRules
   *     A set of all {@link DataValidationRule rules} that need to be processed and represent a DAG.
   * @param sourceRules
   *     A set of all {@link DataValidationRule rules} contained in allRules and have no dependencies.
   * @return [{@link DataValidationRule}]
   *     An ordered array of {@link DataValidationRule}s after the application of topological sort
   */
  topologicalSort: function(allRules: ![DataValidationRule], sourceRules: [DataValidationRule] ): [DataValidationRule] js-rhino
}
