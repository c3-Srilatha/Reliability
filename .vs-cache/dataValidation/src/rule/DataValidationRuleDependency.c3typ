/**
 * Type to define conditional edge (based on triggers) from a parent to a child that represent a Directed acyclic graph (DAG).
 */
type DataValidationRuleDependency {

    /**
     * Set of outputs that triggers the child rule. The parent must complete with one of
     * the outputs in this array in order to run the rule this dependency is associated with.
     */
    triggers: set<string> schema suffix 'TRG'

    /**
     * It represents the child dependency, with to a parent.
     */
    parentRule: !DataValidationRule
}
