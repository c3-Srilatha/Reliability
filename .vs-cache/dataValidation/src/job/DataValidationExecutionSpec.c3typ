/**
 * Spec used to pass parameter into {@link DataValidationRuleset#validate}
 */

type DataValidationExecutionSpec {

    /**
     * The priority for invalidation queue entries generated by the job.
     */
    priority: int

    /**
     * The nodePool of servers that are expected to run the associated {@link DataValidationBatchJob}s.
     * Only servers with a matching nodePool will process jobs.
     */
    nodePool: string

    /**
     * If false, the {@link DataValidationRuleset#validate} is done asynchronously.
     */
    sync: boolean = false

    /**
     * The maximum number of rules to be evaluated in each batch.
     */
    batchSize: int = 5

    /**
     * Specifies whether DataValidationResults should be upserted immediately after rule execution(true) or at the end (false).
     * Only applies to map reduce execution. Batch jobs will always persist progress after each rule is executed.
     */
    persistProgress: boolean

    /**
     * If true, specifies that job should be returned without running it.
     */
    doNotRun: boolean

    /**
     * If true, the {@link DataValidationRun} will not be marked with a runStatus of complete after it is finished.
     */
    doNotMarkComplete: boolean = false
 }
