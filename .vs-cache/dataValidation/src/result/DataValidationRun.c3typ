/**
 * A point-in-time execution of a set of {@link DataValidationRule}s. Enables grouping of validation results into distinct "runs".
 * Created by a call to {@link DataValidationRuleset#validate} when processing its group of {@link DataValidationRule}s.
 * The {@link DataValidationRun#validationStatus} of the executed rules are linked to this run for future reference.
 */
entity type DataValidationRun schema name 'DV_RUN' {

  /**
   * The timestamp at which this validation run was executed.
   */
  timestamp: !datetime

  /**
   * The root ruleset whose rules and all descendant rules were run.
   */
  rootRuleset: !DataValidationRuleset

  /**
   * The {@link DataValidationSubject} this run is associated with. If not set, the run is one per ruleset, rather than one per subject.
   */
  subject: DataValidationSubject

  /**
   * The args passed into each rule function.
   */
  args: map<string, any> schema suffix 'ARGS'

  /**
   * The results generated by this run that are not persisted.
   * Please use {DataValidationRun#getResults} to get the results from a run.
   */
  results: private [DataValidationResult] schema suffix 'DVR'

  /**
   * The results found by this run that are persisted.
   * Please use {DataValidationRun#getResults} to get the results from a run.
   */
  persistedResults: private [DataValidationPersistedResult](run)


  /**
   * The ruleset results found by this run that are not persisted.
   * Please use {DataValidationRun#getRulesetResults} to get the results from a run.
   */
  rulesetResults: private [DataValidationRulesetResult] schema suffix 'DVRR'

  /**
   * The ruleset results found by this run that are persisted.
   * Please use {DataValidationRun#getRulesetResults} to get the results from a run.
   */
  persistedRulesetResults: private [DataValidationPersistedRulesetResult](run)

  /**
   * Gets the complete list of results for a run.
   * @param include
   *    Which fields to include for the returned {@link DataValidationResult}s.
   *    Does NOT apply to this {@link DataValidationRun}.
   * @return
   *    All the results generated by this run.
   */
  getResults: member function(include: string): [DataValidationResult] js-rhino

  /**
   * Gets the complete list of ruleset results for a run.
   * @param include
   *    Which fields to include for the returned {@link DataValidationRulesetResult}s.
   *    Does NOT apply to this {@link DataValidationRun}.
   * @return
   *    All the ruleset results generated by this run.
   */
  getRulesetResults: member function(include: string): [DataValidationRulesetResult] js-rhino

  /**
   * Number of data violations found by this run.
   */
  numViolations: int stored calc count(persistedResults.ruleResult.status.(category != 'Complete')) + count(results.ruleResult.status.(category != 'Complete'))

  /**
   * The batch job or map reduce used to generate results, if any.
   */
  job: DataValidationMapReduceJob | DataValidationBatchJob

  /**
   * The jobId for the current job. It is used as a foreing key on {@link DataValidationMapReduceJob} or {@link DataValidationBatchJob}.
   */
  jobId: string stored calc job.id

  /**
   * The error message, if the run failed.
   */
  jobError: string

  /**
   * The status of this run.
   */
  runStatus: !string enum DataValidationRunStatus

  /**
   * The status of the {@link DataValidationRuleset} rules ouput.
   */
  validationStatus: DataValidationStatus

  /**
   * A function to set the {@link DataValidationRun#runStatus} of the run.
   */
  setRunStatus: member function(status: !string enum DataValidationRunStatus, errorMessage: string) js-rhino

  /**
   * @inheritdoc
   */
  beforeCreate: ~ js-rhino

  /**
   * Generate the {@link DataValidationRulesetResult} after a {@link DataValidationMapReduceJob} is complete.
   * Calculate the result for a subject run {@link DataValidationRun}.
   * If ALL results are {@link DataValidationStatusCategory#COMPLETE},
   *  then the {@link DataValidationRulesetResult#validationStatus} would be “COMPLETE”.
   * If NO results are {@link DataValidationStatusCategory#FAILED},
   *  but ANY rules are “WARNING” {@link DataValidationStatusCategory#WARNING},then {@link DataValidationRulesetResult#validationStatus} would be “WARNING”
   * If ANY rules are @link DataValidationStatusCategory#FAILED} then the {@link DataValidationRulesetResult#validationStatus} would be “FAILED”
   *
   * @param persistResults
   *     Flag to determine whether results should be persisted.
   */
  generateResult: member function(persistResults: boolean) js-rhino

  /**
   * Updates the {@link DataValidationRulesetResult#validationStatus}.
   * Then calculates the result for a subject run {@link DataValidationRun#validationStatus}.
   * If ALL results are {@link DataValidationStatusCategory#COMPLETE},
   *  then the {@link DataValidationRulesetResult#validationStatus} would be “COMPLETE”.
   * If NO results are {@link DataValidationStatusCategory#FAILED},
   *  but ANY rules are “WARNING”,then {@link DataValidationRulesetResult#validationStatus} would be “WARNING”
   * If ANY rules are @link DataValidationStatusCategory#FAILED} then the {@link DataValidationRulesetResult#validationStatus} would be “FAILED”
   *
   * @param ruleset
   *     The {@link DataValidationRuleset} used to re calculate the results.
   *
   * @param persistResults
   *     Flag to determine whether results should be persisted.
   */
  updateRulesetResult: member function(ruleset: !DataValidationRuleset, persistResults: boolean) js-rhino
}
