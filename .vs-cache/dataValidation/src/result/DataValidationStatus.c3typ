/**
 * Represents the status ouput of a {@link DataValidationRun}, or {@link DataValidationRuleResult}.
 */
type DataValidationStatus mixes Identified, Metadata {

  /**
   * The status category for a validation rule.
   */
  category: !string enum DataValidationStatusCategory

  /**
   * Field used to add more details about what this status represents for an output in a {@link DataValidationRuleset} or {@link DataValidationRuleResult} .
   */
  description: string
}
