/**
 * The current status of a {@ DataValidationRuleset} or {@ DataValidationRule}
 */
enum type DataValidationStatusCategory {

    /**
     * The process finished without any failure.
     */
    COMPLETE = 'Complete'

    /**
     * It indicates that the process found a non-critical issue, and no critical errors.
     */
    WARNING = 'Warning'

    /**
     * It indicates that the process found a critical error.
     */
    FAILED = 'Failed'
}
