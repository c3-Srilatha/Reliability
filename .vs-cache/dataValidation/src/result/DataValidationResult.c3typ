/**
 * A rule result with additional information about the result of the rule and time of validation. Created and
 * returned by the {@link DataValidationRule#executeRule} function when the invoking {@link DataValidationRule} finds entities which
 * don't meet the requirements set by the {@link DataValidationRule#action}.
 */
type DataValidationResult {

  /**
   * The run which this result is associated with, if any.
   */
  run: DataValidationRun

  /**
   * The rule which triggered this result.
   */
  rule: !DataValidationRule

  /**
   * The status of the process in {@link DataValidationRule}.
   */
  runStatus: !string enum DataValidationRunStatus

  /**
   * The result which was triggered by the rule.
   */
  ruleResult: DataValidationRuleResult schema suffix 'DVRR'

}
