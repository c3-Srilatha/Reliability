/**
 * Possible run statuses for a {@link DataValidationRun} or {@link DataValidationResult}.
 */
enum type DataValidationRunStatus {

  /**
   * Process have not started running yet.
   */
  NOT_STARTED = 'Not Started'

  /**
   * Process not yet completed.
   */
  IN_PROGRESS = 'In Progress'

  /**
   * Process completed.
   */
  COMPLETE = 'Complete'

  /**
   * Process could not finish.
   */
  ERROR = 'Error'

  /**
   * Process was skipped.
   */
  SKIPPED = 'Skipped'
}
