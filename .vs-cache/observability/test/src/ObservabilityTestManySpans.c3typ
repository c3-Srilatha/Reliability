/**
 * Test type for Observability - Multiple spans per action.
 * Parent calls 2 private functions and there are 3 spans created per invocation
 * of parent action.
 */
type ObservabilityTestManySpans {

  /**
   * Entry point for test.
   */
  parent: member function(): !ObservabilityTestRefActions py-opentelemetry
}
