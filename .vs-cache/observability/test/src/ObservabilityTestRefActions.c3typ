/**
 * Type used by APIs in observability test types like {@link ObservabilityTestType}, {@link ObservabilityTestManyRuntimes} and etc.
 * Used for asserting correctness of automatically captured action IDs of {@link Observability.Span.Record}.
 */
type ObservabilityTestRefActions {

  /**
   * Action ID associated with {@link ObservabilityTestType#parent}.
   */
  parentActionId: string

  /**
   * Action ID associated with {@link ObservabilityTestType#child1}.
   */
  child1ActionId: string

  /**
   * Action ID associated with {@link ObservabilityTestType#child2}.
   */
  child2ActionId: string

  /**
   * Action ID associated with {@link ObservabilityTestType#grandChild} when invoked from {@link ObservabilityTestType#child1}.
   */
  grandChildFromChild1ActionId: string

  /**
   * Action ID associated with {@link ObservabilityTestType#grandChild} when invoked from {@link ObservabilityTestType#child2}.
   */
  grandChildFromChild2ActionId: string

  /**
   * Action ID associated with root action of {@link ObservabilityTestType#parent}.
   */
  rootOfParent: string

  /**
   * String representing {@link ObservabilityTestRefActions} associated with {@link ObservabilityTestType#parentWithLambdaAttributes}.
   */
  parentValue: string

  /**
   * String representing {@link ObservabilityTestRefActions} associated with {@link ObservabilityTestType#childWithLambdaAttributes}.
   */
  child1Value: string

  /**
   * Action IDs associated with child spans.
   * Keys can be "child_0", "child_1", ..., or custom names.
   */
  childActionIds: Map<string, string>

  /**
   * Action IDs associated with grandchild spans.
   * Keys can be "grandChild_from_child_0", etc.
   */
  grandChildActionIds: Map<string, string>
}
