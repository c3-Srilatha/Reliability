/**
 * Shared type for Observability tests between different runtimes.
 */
type Observability.TestUtil {

  /**
   * Returns functions that you can use like
   * ```python
   *    utils = Observability.TestUtil.utils()
   *    utils.func()
   * ```
   */
  utils: function(): native py
}
