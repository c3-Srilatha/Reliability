/**
 * Type for generating demo traces for observability testing
 */
type ObservabilityDemoType {

  /**
   * Tracer Type used for tracing
   */
  tracer: !Type<<Observability.Tracer>>

  /**
   * Number of traces to generate
   */
  numTraces: !int = 3

  /**
   * Number of planning phases per trace.
   * Each phase generates approximately 10 spans:
   * - 1 planning span
   * - 3 tool-related spans (1 tool × 3 spans)
   * - 6 LLM-related spans (2 LLM calls × 3 spans each)
   */
  numPhases: !int = 2

  /**
   * Generate demo traces for observability testing.
   * Run with numTrace=1 multiple times or, run from Jupyter notebook with a runtime that does not
   * have opentelemetry to have numTraces to be respected. Otherwise, it will end up with
   * a single trace with a lot of spans.
   */
  generateTraces: member function() py

  /**
   * Simulate agent execution flow with multiple spans
   */
  simulateAgentExecution: private member function() py-opentelemetry

  /**
   * Simulate tool execution with different tools
   *
   * @param toolName
   *    Name of the tool to simulate execution
   */
  simulateToolExecution: private member function(toolName: !string, throwException: boolean) py-opentelemetry

  /**
   * Simulate LLM interaction with prompt handling
   * @param promptType
   *    Type of prompt to simulate
   */
  simulateLLMInteraction: private member function(promptType: !string) py-opentelemetry
}
