/**
 * Fields for span.
 */
type Observability.Span.Fields {
  /**
   * The ID of the parent {@link Observability.Span}. Root span does not have any `parentSpanId`.
   */
  parentSpanId: string

  /**
   * Action context associated with this {@link Observability.Span}.
   */
  actionContext: string

  /**
   * The name of this {@link Observability.Span}.
   */
  name: !string

  /**
   * The kind of this {@link Observability.Span}.
   */
  kind: string

  /**
   * The start time of this {@link Observability.Span}.
   */
  startTime: !datetime with millis

  /**
   * The end time of this {@link Observability.Span}.
   */
  endTime: !datetime with millis

  /**
   * The action ID associated with this {@link Observability.Span}.
   */
  actionId: string

  /**
   * The parent action ID associated with this {@link Observability.Span}.
   */
  parentActionId: string

  /**
   * A map of attributes associated with this {@link Observability.Span}.
   */
  attributes: map<string, ?any>

  /**
   * The status code of this {@link Observability.Span}.
   */
  // Developer Note: OpenTelemetry's SpanStatusCode support UNSET, OK and ERROR.
  //                 We are setting the status to be OK unless there is an error.
  status: !string enum("OK", "ERROR")  = "OK"

  /**
   * The error stack trace for this {@link Observability.Span}.
   */
  exceptionStack: string serialized FileUrl

  /**
   * {@link Type} of trace that this span belongs to.
   */
  traceType: ?string serialized Type<<Observability.Trace>>
}
