/**
 * Entity storing Span. Span is a single operation within a {@link Observability.Trace}.
 * For more information, see the OpenTelemetry definition of Span:
 * <https://opentelemetry.io/docs/concepts/signals/traces/#spans>
 */
@beta
@db(index += ['traceId', 'traceRecordType', 'traceType', 'parentSpanId',
'name', 'kind', 'status', 'traceId, traceRecordType', 'trace'])
private entity type Observability.Span.Record mixes Observability.Span.Fields {
  /**
   * The {@link Observability.Trace.Record} to which this {@link Observability.Span.Record} belongs.
   */
  @deprecated(finalVersion='1.5.0', details="Replaced by traceId and traceType to account for many types of trace records")
  trace: Observability.Trace.Record

  /**
   * `id` of trace record that this span belongs to.
   */
  traceId: ?string

  /**
   * {@link Type} of trace record that this span belongs to.
   */
  traceRecordType: ?string serialized Type<<Persistable<Observability.Trace.Fields>>>

  /**
   * Aggregates span attribute values to trace
   * @param spans
   *     List of spans whose attribute values will be aggregated to trace.
   */
  aggregateSpans: inline private function(spans: ![Observability.Span.Record]) py
}
