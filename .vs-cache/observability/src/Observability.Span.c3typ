/**
 * Namespace for observability span.
 * For Spans, see [OpenTelemetry Spans] <https://opentelemetry.io/docs/concepts/signals/traces/#spans>
 */
@beta
type Observability.Span mixes Observability.Span.Fields {

  /**
   * Unique identifier of this {@link Observability.Span}.
   */
  id: string

  /**
   * Unique identifier of {@link Observability.Trace} that this span belongs to.
   */
  trace: string

  /**
   * A map of system attributes associated with this {@link Observability.Span}.
   */
  systemAttributes: map<string, ?any>

  /**
   * Duration of this {@link Observability.Span}.
   */
  duration: string
}
