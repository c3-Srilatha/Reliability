/**
 * Type used by {@link Observability.Trace#spanSummary} for UI purposes.
 */
private type Observability.Span.Result mixes Observability.Span {

  /**
   * A map of system attributes associated with this {@link Observability.Span.Result}.
   */
  systemAttributes: map<string, string>

  /**
   * A map of attributes associated with this {@link Observability.Span.Result}.
   */
  attributes: map<string, string>

  /**
   * The children spans of this span
   */
  children: [Observability.Span.Result]
}
