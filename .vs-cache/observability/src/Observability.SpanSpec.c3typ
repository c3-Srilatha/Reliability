/**
 * Spec for customization of starting of a new span.
 * @See Observability.Tracer#start_as_current_span
 */
@beta
type Observability.SpanSpec mixes Spec {
  /**
   * By default, the current trace will be associated with the newly created span.
   * Setting this to true will ensure that a new trace is created and associated with the newly created span.
   */
  // Developer Note: this feature is not supported until context propagation is enabled in the server side.
  startAsNewTrace: private boolean

  /**
   * The kind of the span.
   */
  kind: string = "c3"

  /**
   * If true, the span will not record exceptions.
   * By default, exception will be recorded based on the {@link Observability.Tracer.Config#disableExceptionRecording}.
   */
  disableExceptionRecording: boolean
}
