/**
 * Enum specifying {@link Observability.Span#status} and {@link Observability.Trace#status}.
 */
@beta
enum type Observability.Status {

  /**
   * Default Status set on trace/span
   */
  OK = 'OK'

  /**
   * Status set on trace/span if there are errors
   */
  ERROR = 'ERROR'
}
