/**
 * Type used to interact with the Observability following the OpenTelemetry standard.
 * For more information, see [OpenTelemetry Introduction]<https://opentelemetry.io/docs/concepts/what-is-opentelemetry/>.
 * @See Observability.Tracer#start_as_current_span
 */
@beta
type Observability.Tracer mixes Configurable<Observability.Tracer.Config> {
  /**
   * Returns current {@link Observability.Trace#id} inside of a span context. If no span is active, returns null.
   * It is recommended to use span's trace_id property to get the trace id instead this method for performance.
   * ```python
   * with c3.Observability.Tracer.start_as_current_span("my-span") as span:
   *     trace_id = span.trace_id
   * ```
   */
  currentTraceId: inline function(): string py

  /**
   * Provides the trace type associated with this tracer.
   *
   * @returns the trace type associated with this tracer.
   */
  traceType: inline function(): !Type<<Observability.Trace>> py

  /**
   * Returns a list of {@link Observability.Trace} instances in this application generated by this tracer.
   * @param spec
   *     {@link FetchSpec} for the traces.
   * @return list of traces
   */
  traces: function(spec: Spec): [Observability.Trace] py
}
