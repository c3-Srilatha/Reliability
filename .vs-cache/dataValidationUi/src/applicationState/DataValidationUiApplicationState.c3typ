/**
 * Application state for the dataValidationUi package
 */
@beta
@typeScript
type DataValidationUiApplicationState mixes DataValidationUiPageSettings, DataValidationUiPageData, UiSdlApplicationState {
  /**
   * Specifies the path of a pageKey
   */
  pageKeyPageParamId: string

  /**
   * pageKey specified at pageKeyPageParamPath
   */
  pageKey: string

  /**
   * Id of component that should be shown in dataValidationUi.ValidationResultContainer
   */
  currentComponentId: string

  /**
   * Subject that data validation should be run on. Received from page param specified by {@link DataValidationUiPageSettings}
   */
  subject: DataValidationSubject

  /**
   * An action to change a field in this state.
   *
   * @param field
   *            The field in application state to be updated.
   * @param path
   *            The path the value to update the state field with (optional).
   * @param value
   *            The value to update the state field with. This is optional since you can also include a path to the value instead.
   * @returns a Redux action of type `SET_FIELD`.
   */
  @uiSdlActionCreator(actionType='SET_FIELD')
  setFieldAction: private function(field: !string,
                                   value: string,
                                   path: string): !UiSdlReduxAction ts-client

  /**
   * Listens for actions of type `SET_FIELD` and store selected value in application state.
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='SET_FIELD')
  setFieldReducer: private inline function(state: !UiSdlReduxState,
                                           action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * An action to merge selected page settings.
   *
   * @param pageSettings
   *            A {@link DataValidationUiPageSettings} to update the application state with.
   * @returns a Redux action of type `MERGE_PAGE_SETTINGS`.
   */
  @uiSdlActionCreator(actionType='MERGE_PAGE_SETTINGS')
  mergePageSettingsAction: private function(pageSettings: !DataValidationUiPageSettings): !UiSdlReduxAction ts-client

  /**
   * An action to merge selected page data.
   *
   * @param pageData
   *            A {@link DataValidationUiPageData} to update the application state with.
   * @returns a Redux action of type `MERGE_PAGE_DATA`.
   */
  @uiSdlActionCreator(actionType='MERGE_PAGE_DATA')
  mergePageDataAction: private function(pageData: !DataValidationUiPageData): !UiSdlReduxAction ts-client


  /**
   * Listens for actions of type `MERGE_PAGE_SETTINGS` or `MERGE_PAGE_DATA` and merge entity's page settings or data in application state.
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType=['MERGE_PAGE_SETTINGS', 'MERGE_PAGE_DATA'])
  mergeMultipleDataValidationStateFields: private inline function(state: !UiSdlReduxState,
                                                                  action: !UiSdlReduxAction): !UiSdlReduxState ts-client

  /**
   * An action to clear application state.
   *
   * @returns a Redux action of type `CLEAR_STATE`.
   */
  @uiSdlActionCreator(actionType='CLEAR_STATE')
  clearStateAction: private function(): !UiSdlReduxAction ts-client

  /**
   * Clears application state completely.
   *
   * @param state
   *           Redux state
   * @param action
   *           Redux action
   * @returns a new Redux state
   */
  @uiSdlReducer(actionType='CLEAR_STATE')
  clearStateReducer: private inline function(
    state: !UiSdlReduxState,
    action: !UiSdlReduxAction
  ): !UiSdlReduxState ts-client
}
