/**
 * Helper to fetch the correct page settings and latest run data for the Data Validation UI.
 * If users would like to change data fetching logic, this type should be remixed and functions reimplemented.
 */
type DataValidationUiHelper {

  /**
   * Get the latest run data for a given {@link DataValidationSubject} and {@link DataValidationRuleset}.
   */
  fetchLatestCompletedRunData: function(subject: DataValidationSubject,
                                        ruleset: DataValidationRuleset): DataValidationUiPageData js-rhino
}
