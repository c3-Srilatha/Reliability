/**
 * Collection of settings to specify the rendering of UI page
 */
type DataValidationUiPageSettings {

  /**
   * Translation/string to show as overview title.
   */
  overviewTitle: string

  /**
   * Translation/string to show as overview subtitle.
   */
  overviewSubtitle: string

  /**
   * Translation/string to show as overview body text.
   */
  overviewBodyText: string

  /**
   * Link to the documentation of the page.
   */
  documentationUrl: string

  /**
   * {@link DataValidationRuleset Ruleset} of this page.
   */
  ruleset: DataValidationRuleset

  /**
   * Args for the running data validation.
   */
  validationArgs: map<string, any>

  /**
   * {@link DataValidationExecutionSpec Execution spec} to use when running data validation.
   */
  executionSpec: DataValidationExecutionSpec

  /**
   * Path on page parameters where subject is stored.
   */
  subjectPageParamId: string

  /**
   * An array of settings that define what should be rendered for each {@link DataValidationUiStepSettings step}. They should be in display order.
   */
  stepSettings: [DataValidationUiStepSettings]

}
