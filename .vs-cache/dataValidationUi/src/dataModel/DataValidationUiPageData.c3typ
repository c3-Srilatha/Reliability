/**
 * Type used to load the information in data Validation UI pages.
 */
type DataValidationUiPageData {

  /**
   * Latest completed {@link DataValidationRun run} for this page’s
   * {@link DataValidationRuleset ruleset} and {@link DataValidationSubject subject}
   */
  latestCompletedRun: DataValidationRun

  /**
   * Latest in progress {@link DataValidationRun run} for this page’s
   * {@link DataValidationRuleset ruleset} and {@link DataValidationSubject subject}
   */
  latestInProgressRun: DataValidationRun

  /**
   *  Returns all validation results for a given run. The key is the id of the {@link DataValidationResult}.
   */
  validationResults: map<string, DataValidationResult>

  /**
   * Returns all ruleset results for a given run. The map key is the id of the {@link DataValidationRulesetResult}
   */
  validationRulesetResults: map<string, DataValidationRulesetResult>

  /**
   * Stores what the steps definition lists should show
   */
  numStepsDataRecord: json

}
