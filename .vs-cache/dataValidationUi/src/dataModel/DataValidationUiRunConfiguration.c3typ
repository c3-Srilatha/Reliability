/**
 * Specifies execution parameters for running {@link DataValidationRuleset#validate}.
 */
type DataValidationUiRunConfiguration {

  /**
   * The ruleset to be run.
   */
  ruleset: DataValidationRuleset

  /**
   * The params that specify how the ruleset should be run.
   */
  executionSpec: DataValidationExecutionSpec

  /**
   * Arguments that will be passed to the validation rules that will be run.
   */
  validationArgs: map<string, any>
}
