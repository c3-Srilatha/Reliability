/**
 * Helper to run the data validation for a single subject or multiple subjects
 */
@typeScript
type DataValidationUiRunHelper  {

  /**
   * It runs the data validation from a single subject and updates the state triggering
   * dataValidationUi.ValidationOverviewTabPanel.UPDATE_STATE
   */
  runDataValidation: function(
    subjectId: !string,
    action: !any,
    stateStream: !UiSdlStatesObservable,
    runConfiguration: DataValidationUiRunConfiguration
  ): !UiSdlObservable ts-client

  /**
   * It runs the data validation from multiple subjects.
   */
  runBulkDataValidation: function(
    subjectIds: ![string],
    action: !any,
    stateStream: !UiSdlStatesObservable,
    runConfiguration: DataValidationUiRunConfiguration
  ): !UiSdlObservable ts-client

  /**
   * Returns an observable containing redux actions to run when Data Validation is started.
   */
  runStartedActions: function(
    loaderId: !string,
    bannerId: !string,
    panelId: !string,
    stateId: !string,
    state: !UiSdlReduxState
  ): !UiSdlObservable ts-client

  /**
   * Returns an observable containing redux actions to run when Data Validation is finished.
   * @param bannerId
   *    id of banner to show data validation status.
   * @param showError
   *    If true, an error will be shown to the user.
   * @param forceDataUpdate
   *    If true, the data validation page will be forced to refresh the data that is shown to the user.
   *    This is important in cases where an update has been made to an existing run.
   */
  runFinishedActions: function(
    bannerId: !string,
    showError: boolean,
    forceDataUpdate: boolean
  ): !UiSdlObservable ts-client

  /**
   * Returns an observable containing a redux action that triggers UpdateDataValidationAppStateEpic.
   * 
   * @param forceUpdate (boolean): If true, forces an immediate update to the application state.
   * 
   * @returns (UiSdlObservable): Returns an observable to trigger the state update epic.
   */
  updateAppStateAction: function(forceUpdate: boolean): !UiSdlObservable ts-client

  /**
   * Runs data validation for a specific rule in the latest run.
   * 
   * @param payload (json): Contains necessary information such as bannerId, panelId, and loaderId.
   * @param state (UiSdlReduxState): The current state of the application.
   * @param siteId (string): The ID of the site where validation is being run.
   * @param ruleId (string): The ID of the {@link DataValidationRule} to validate.
   * @param hasErrors (boolean): If true, indicates that the previous steps encountered errors and the failure banner should be displayed.
   * 
   * @returns (UiSdlObservable): Returns an int with number of instrumented sensors linked to this
   */
  runDataValidationRule: function(
    payload: json,
    state: !UiSdlReduxState,
    siteId: string,
    ruleId: !string,
    hasErrors: !boolean
  ): !UiSdlObservable ts-client

}
