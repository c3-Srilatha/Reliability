{
  "name": "uiGraphComponent",
  "description": "Type definitions for the graph UI component that is available with C3 AI UI Component Library",
  "author": "studio <studio@c3.ai>",
  "version": "8.9.0",
  "compatibleToVersion": "8.7",
  "dependencies": {
    "uiComponentLibrary": "8.9"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@c3/c3-base",
      "plugin:@c3/typescript",
      "prettier"
    ],
    "plugins": [
      "@c3",
      "prettier"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^e$|^_",
          "ignoreRestSiblings": true
        }
      ],
      "import/prefer-default-export": "off",
      "prettier/prettier": "error"
    }
  }
}
