/**
 * Provides access to configuration settings defined in {@link DataVisualizationGraphConfig} type.
 */
type DataVisualizationGraphSettings mixes Configurable<DataVisualizationGraphConfig>, Singleton {

  /**
   * Field path to set graph cache key defined in {@link DataVisualizationGraphConfig} type.
   */
  graphCacheKeyFieldPath: string = 'graphCacheKey'

  /**
   * Sets the given graph cache key.
   *
   * @param graphCacheKey
   *           The graph cache key to set.
   */
  setGraphCacheKey: member function(graphCacheKey: !string) js-server

  /**
   * Gets the graph cache key.
   *
   * @return The graph cache key.
   */
  getGraphCacheKey: member function(): string js-server

  /**
   * Clears the graph cache key.
   */
  clearGraphCacheKey: member function() js-server
}
