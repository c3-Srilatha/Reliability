/**
 * Leaflet options for layer style configuration from https://leafletjs.com/reference-1.7.1.html#path.
 */
type UiSdlGraphVisualizationGeoJsonStyleConfig {

  /**
   * Outline stroke color.
   */
  outlineColor: string serialized Color = '#708090'

  /**
   * Outline stroke color when a region is hovered on.
   */
  outlineColorOnHover: string serialized Color = '#fff'

  /**
   * Outline stroke color when a region is selected.
   */
  outlineColorWhenSelected: string serialized Color = '#fff'

  /**
   * Outline stroke width in pixels.
   */
  outlineWeight: int

  /**
   * Outline stroke width in pixels when a region is hovered on.
   */
  outlineWeightOnHover: int = 3

  /**
   * Outline stroke width in pixels when a region is selected.
   */
  outlineWeightWhenSelected: int = 6

  /**
   * Outline stroke opacity.
   */
  outlineOpacity: double = 1.0

  /**
   * Determine the fill color based on a field value of the data. Select one of three possible strategies for how to
   * color the GeoJSON regions.
   * {@link UiSdlGraphVisualizationFillColorByPropertyStrategyCategorical}
   *   - The field value itself is used to color the GeoJSON region.
   * {@link UiSdlGraphVisualizationFillColorByPropertyStrategyStepped}
   *   - The GeoJSON region color is chosen based on the field value's position among a set of threshold values.
   * {@link UiSdlGraphVisualizationFillColorByPropertyStrategyGradient}
   *   - GeoJSON region color is chosen based on where the field value falls along a continuous gradient.
   */
  fillColorByProperty: UiSdlGraphVisualizationFillColorByPropertyStrategyCategorical | UiSdlGraphVisualizationFillColorByPropertyStrategyStepped | UiSdlGraphVisualizationFillColorByPropertyStrategyGradient

  /**
   * Fill color when selected. Defaults to color of region determined by gradient or
   * {@link UiSdlGraphVisualizationGeoJsonStyleConfig#fillColorByProperty}.
   */
  fillColorWhenSelected: string serialized Color

  /**
   * Fill opacity.
   */
  fillOpacity: double = 0.2

  /**
   * Fill opacity when a region is hovered on.
   */
  fillOpacityOnHover: double = 0.7

  /**
   * Fill opacity when a region is selected.
   */
  fillOpacityWhenSelected: double = 0.7
}
