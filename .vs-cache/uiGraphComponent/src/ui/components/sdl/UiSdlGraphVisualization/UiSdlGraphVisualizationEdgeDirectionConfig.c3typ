/**
 * Configuration to control how the edges are directed based on the value at the fieldName property.
 * The directionality of an edge can be specified by adding the field value in the appropriate directionality bucket below.
 * If the value at the specified field does not appear in any of the directionality buckets, the edge appears undirected.
 */
type UiSdlGraphVisualizationEdgeDirectionConfig mixes UiSdlFieldBasedDataSpecSetting {

  /**
   * List of values to map to unidirectional edges pointing from a start node to an end node.
   */
  unidirectional: [string]

  /**
   * List of values to map to bidirectional edges.
   */
  bidirectional: [string]

  /**
   * List of values to map to unidirectional edges that go from the end node to the start node.
   */
  reverse: [string]
}
