/**
 * Type to define the structure for {@link UiSdlGraphVisualization#activeTooltip}.
 */
type UiSdlGraphVisualizationTooltipData {

  /**
   * The x location of the pointer in view coordinates.
   */
  x: double

  /**
   * The y location of the pointer in view coordinates.
   */
  y: double

  /**
   * The tooltip title data.
   */
  tooltipTitle: string

  /**
   * The tooltip subtitle data.
   */
  tooltipSubtitle: string

  /**
   * The tooltip body data.
   */
  tooltipBody: string
}
