/**
 * The GeoJson data spec configuration for a Leaflet map.
 */

@typeScript
type UiSdlGraphVisualizationGeoJsonDataSpec mixes UiSdlFieldBasedDataSpec  {

  /**
   * Converts the data spec to an array of partially applied actions.
   */
  toPartiallyAppliedActions: ~ ts-client

  /**
   * The action to call.
   */
  actionName: string

  /**
   * The args to be passed to the API.
   */
  actionArgs: map<string, any>

  /**
   * Property to control if shapes from the geoJSON can be highlighted on hover.
   */
  highlightable: boolean = true

  /**
   * Property to control if shapes from the geoJSON can be selected by the user.
   */
  selectable: boolean

  /**
   * Configuration for the geoJson layer style.
   */
  style: UiSdlGraphVisualizationGeoJsonStyleConfig

  /**
   * The configuration for the Layer tooltip.
   * The {@link highlightable} config must be set to true to be able to see the tooltip
   */
  tooltipConfig: UiSdlGraphVisualizationTooltipConfig

  /**
   * Property to control if the region legend should be shown.
   */
  showRegionLegend: boolean = true
}
