/**
 * Options to control how node multi-selection affects 1st degree neighbor highlighting.
 */
enum type UiSdlGraphVisualizationNodeMultiselectionOption {

  /**
   * Highlight all the 1st degree neighbors of the selected nodes.
   */
  UNION = 'union'

  /**
   * Highlight only the 1st degree neighbors that the selected nodes have in common.
   */
  INTERSECTION = 'intersection'
}
