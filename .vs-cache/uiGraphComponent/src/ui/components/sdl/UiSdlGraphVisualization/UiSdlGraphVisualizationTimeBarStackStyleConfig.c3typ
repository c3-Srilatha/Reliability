/**
 * The configuration for styling an item in a {@link UiSdlGraphVisualizationTimeBarStackConfig}
 */
type UiSdlGraphVisualizationTimeBarStackStyleConfig mixes UiSdlFieldBasedDataSpec {

  /**
   * The color of the time bar stack
   */
  color: string

  /**
   * The hover color of the time bar stack
   */
  hoverColor: string

}
