/**
* Configuration for the graph view of the UI SDL graph visualization.
*/
type UiSdlGraphVisualizationGraphViewConfig mixes UiSdlFieldBasedDataSpec {
  /**
   * The zoom level of the graph and where to get the data from.
   */
  zoom: double | UiSdlFieldBasedDataSpecSetting

  /**
   * The x offset of the graph relative to the graph canvas and where to get the data from.
   */
  offsetX: double | UiSdlFieldBasedDataSpecSetting

  /**
   * The y offset of the graph relative to the graph canvas and where to get the data from.
   */
  offsetY: double | UiSdlFieldBasedDataSpecSetting
}
