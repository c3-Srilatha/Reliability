/**
 * Type to represent the abstract zoom configuration for graph visualization.
 */

@typeScript
type UiSdlGraphVisualizationChartZoomConfig mixes UiSdlGraphVisualizationZoomConfig {

  /**
   * The minimum zoom level.
   * This value can be from 0 to 100%.
   * The default value is 50%.
   */
  minZoom: ~ = 50

  /**
   * The maximum zoom level.
   * The value can be from 100% to 400%.
   * The default value is 400%.
   */
  maxZoom: ~ = 400

}
