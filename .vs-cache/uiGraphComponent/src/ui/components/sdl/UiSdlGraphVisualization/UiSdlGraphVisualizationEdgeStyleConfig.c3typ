/**
 * Type defining the configuration for how an edge should be styled.
 */
type UiSdlGraphVisualizationEdgeStyleConfig mixes UiSdlFieldBasedDataSpecSetting {

  /**
   * Fill with a static color. HTML color name 'gray' => '#808080'
   */
  fillColor: string serialized Color = '#808080'

  /**
   * Configuration that controls if and how edges are directed.
   * Edges can either appear as bidirectional, unidirectional, unidirectional (reverse), or undirected.
   */
  directionConfig: UiSdlGraphVisualizationEdgeDirectionConfig

  /**
   * The size of a link.
   */
  size: int = 1

  /**
   * A numerical property that, when specified, dictates how links are sized. Takes precedence over
   * {@link UiSdlGraphVisualizationEdgeStyleConfig#size}.
   */
  sizeByProperty: UiSdlFieldBasedDataSpecSetting

  /**
   * The name of the link property which, when evaluated, will determine if the line is solid or dotted:
   * true -> dotted, false -> solid.
   */
  isDotted: UiSdlFieldBasedDataSpecSetting

  /**
   * The link property used to populate the label of an edge. If unspecified, there will be no label.
   * If a given link doesn't have the specified property, the label will be blank.
   */
  labelText: UiSdlFieldBasedDataSpecSetting

  /**
   * The link property used to populate the label of an edge, close to the from node end. If unspecified, there will be no label.
   */
  fromNodeEndLabelText: UiSdlFieldBasedDataSpecSetting

  /**
   * The link property used to populate the label of an edge, close to the to node end. If unspecified, there will be no label.
   */
  toNodeEndLabelText: UiSdlFieldBasedDataSpecSetting

  /**
   * Determine the fill color based on a field value of the data.  Select one of three possible strategies for how to
   * color the edge.
   * {@link UiSdlGraphVisualizationFillColorByPropertyStrategyCategorical}
   *   - Field values are grouped and an edge color is selected from {@link UiSdlGraphVisualization#defaultEdgeColors}.
   *   - Use {@link UiSdlGraphVisualizationFillColorByPropertyStrategyCategorical#colorMap} to assign a specific color
   *     to each category.
   * {@link UiSdlGraphVisualizationFillColorByPropertyStrategyStepped}
   *   - Edge color is chosen based on the field value's position among a set of threshold values.
   * {@link UiSdlGraphVisualizationFillColorByPropertyStrategyGradient}
   *   - Edge color is chosen based on where the field value falls along a continuous gradient.
   */
  fillColorByProperty: UiSdlGraphVisualizationFillColorByPropertyStrategyCategorical | UiSdlGraphVisualizationFillColorByPropertyStrategyStepped | UiSdlGraphVisualizationFillColorByPropertyStrategyGradient

  /**
   * Color to apply to the edge when hovered
   */
  fillColorOnHover: string serialized Color

  /**
   * Width to apply to the edge when hovered
   */
  widthOnHover: string

  /**
   * The configuration for the flow animation on an edge.
   */
  flowConfig: UiSdlGraphVisualizationEdgeFlowConfig
}
