/**
 * Type to represent the data spec {@link UiSdlGraphVisualization}.
 */

@typeScript
type UiSdlGraphVisualizationDataSpec mixes UiSdlComponentDataSpec {

  /**
   * Converts the data spec to an array of partially applied actions.
   */
  toPartiallyAppliedActions: ~ ts-client

  /**
   * The action to call.
   */
  actionName: string

  /**
   * The args to be passed to the API.
   */
  actionArgs: map<string, any>

  /**
   * List of data transform types, which will be applied after the data is retrieved.
   */
  dataTransforms: ~ = ['UiSdlTransformInMemoryGraphToGraphVisualizationData']

  /**
   * Configuration for stacking items in TimeBar
   */
  timeBarStackConfig: UiSdlGraphVisualizationTimeBarStackConfig

  /**
   * Configuration for node data spec.
   */
  nodeConfig: UiSdlGraphVisualizationNodeConfig

  /**
   * Configuration for edge data spec.
   */
  edgeConfig: UiSdlGraphVisualizationEdgeConfig

  /**
   * Configuration for annotation data spec.
   */
  annotationConfig: UiSdlFieldBasedDataSpecSetting

  /**
   * Configuration for graph view.
   * This represents the whole graph zoom level,
   * offsetX and offsetY relative to the canvas.
   */
  graphViewConfig: UiSdlGraphVisualizationGraphViewConfig
}
