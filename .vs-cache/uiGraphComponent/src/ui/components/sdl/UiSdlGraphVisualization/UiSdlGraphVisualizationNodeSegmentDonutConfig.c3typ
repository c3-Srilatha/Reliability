/**
 * The configuration `donut` border of segmented sections around a node of type `segment`.
 * Doesn't apply to nodes when shape is set to `box`.
 */
type UiSdlGraphVisualizationNodeSegmentDonutConfig {

  /**
   * Node donuts of type `segment` render upto the first four segments.
   */
  donutType: string = 'segment'

  /**
   * The list of up to four properties to set donut segment size and color.
   * If more than four are specified the additional segments are ignored.
   */
  @constraint(condition='segments.length <= 4')
  segments: [UiSdlColorableFieldBasedDataSpecSetting]

  /**
   * Width of the donut.
   */
  width: !string enum UiSdlGraphVisualizationNodeDonutWidthOption = THIN
}
