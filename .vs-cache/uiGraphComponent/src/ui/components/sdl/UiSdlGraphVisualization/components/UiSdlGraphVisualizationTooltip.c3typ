/**
 * A UI Component type that represents a tooltip for {@link UiSdlGraphVisualization} instance.
 */
@uiComponentCategorizer(name='Graph visualization tooltip', category='Data Visualization', hide=true)
type UiSdlGraphVisualizationTooltip mixes UiSdlComponent<any> {

  /**
   * The value of the tooltip body.
   */
  tooltipBody: private string

  /**
   * The value of the tooltip subtitle.
   */
  tooltipSubtitle: private string

  /**
   * The value of the tooltip title.
   */
  tooltipTitle: private string

  /**
   * The x position of the tooltip.
   */
  x: private int

  /**
   * The y position of the tooltip.
   */
  y: private int
}
