/**
 * A UI Component type that represents an action for {@link UiSdlGraphVisualization} instance.
 */
@uiComponentCategorizer(name='Graph component action', category='Data Visualization', hide=true)
type UiSdlGraphVisualizationGraphAction mixes UiSdlComponent<any> {

  /**
   * The text to be displayed in the button.
   */
  buttonText: private string

  /**
   * Icon to be displayed in the button.
   */
  iconClass: private string

  /**
   * The role of the action.
   */
   role: private string = 'button'
}
