/**
 * A UI Component type that represents a context menu for {@link UiSdlGraphVisualization} instance.
 */
@uiComponentCategorizer(name='Graph visualization context menu', category='Data Visualization', hide=true)
type UiSdlGraphVisualizationContextMenu mixes UiSdlComponent<any> {

  /**
   * The id of the item currently displaying the context menu.
   */
  itemId: private string

  /**
   * The options for the context menu.
   */
  options: private [UiSdlAction]

  /**
   * Whether or not the context menu is currently visible.
   */
  visible: private boolean

  /**
   * The x position of the context menu.
   */
  x: private int

  /**
   * The y position of the context menu.
   */
  y: private int
}
