/**
 * A UI Component type that represents a legend for {@link UiSdlGraphVisualization} instance.
 */
@uiComponentCategorizer(name='Graph component legend', category='Data Visualization', hide=true)
type UiSdlGraphVisualizationLegend mixes UiSdlComponent<any> {

  /**
   * Default icon to use with all items.
   */
  icon: private string = 'user-circle'

  /**
   * The list of legend items.
   */
  items: private [UiSdlGraphVisualizationLegendItem]

  /**
   * The max number of legend items to show before truncating. Use 0 to show none, -1 to show all legend items or a
   * number to show that exact number.
   */
  maxLegendItems: private int = 10
}
