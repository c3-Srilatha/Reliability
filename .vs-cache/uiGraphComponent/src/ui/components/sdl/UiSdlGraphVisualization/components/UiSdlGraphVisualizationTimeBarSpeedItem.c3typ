/**
 * Type to define the structure for a {@link UiSdlGraphVisualizationTimeBarControlBar} item.
 */
private type UiSdlGraphVisualizationTimeBarSpeedItem {
  /**
   * The text for the speed value
   */
  text: private string = 'UiSdlGraphVisualizationTimeBarSpeed.1_0x'

  /**
   * The id of the legend item.
   */
  value: private double
}
