/**
 * A UI Component type that represents a node label with a colored shape used to differentiate nodes rendered
 * as a group. This component is used by {@link UiSdlGraphVisualizationLegend}.
 */
@uiComponentCategorizer(name='Graph visualization nodes label', category='Data Visualization', hide=true)
type UiSdlGraphVisualizationNodesLabel mixes UiSdlComponent<any> {

  /**
   * The color value for the colored icon rendered adjacent to the `label`.
   */
  color: private string serialized Color = '#333'

  /**
   * The human-readable label for the node.
   */
  label: private !string

  /**
   * Whether this node is hidden
   */
  isHidden: private boolean = false
}
