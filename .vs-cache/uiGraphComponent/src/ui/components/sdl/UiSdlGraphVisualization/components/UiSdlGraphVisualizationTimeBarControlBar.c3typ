/**
 * A UI Component type that represents time bar controls for {@link UiSdlGraphVisualization} instance.
 */
@uiComponentCategorizer(name='Graph time bar controls', category='Data Visualization', hide=true)
type UiSdlGraphVisualizationTimeBarControlBar mixes UiSdlComponent<any> {

  /**
   * The icon for the backward button.
   */
  backwardIcon: string = 'fast-backward'

  /**
   * The icon for the pause button.
   */
  pauseIcon: string = 'pause'

  /**
   * The icon for the pause button.
   */
  playIcon: string = 'play'

  /**
   * The icon for the forward button.
   */
  forwardIcon: string = 'fast-forward'

  /**
   * A list of the available play speeds for the time bar.
   * Each of these speeds are multiplied by the TIME_BAR_BASE_SPEED that is 60 pixels per second,
   * meaning the value is actualy a multiplier other than a fixed speed value to update.
   */
  playSpeeds: [UiSdlGraphVisualizationTimeBarSpeedItem] = [ {"value":0.25, "text":"UiSdlGraphVisualizationTimeBarSpeed.0_25x"},
                                                                    {"value":0.5, "text":"UiSdlGraphVisualizationTimeBarSpeed.0_5x"},
                                                                    {"value":1, "text":"UiSdlGraphVisualizationTimeBarSpeed.1_0x"},
                                                                    {"value":1.5, "text":"UiSdlGraphVisualizationTimeBarSpeed.1_5x"},
                                                                    {"value":2, "text":"UiSdlGraphVisualizationTimeBarSpeed.2_0x"}]

  /**
   * The default speed value for the time bar. This will be the value selected in {@link playSpeeds} dropdown
   * The time bar will start with this speed (multiplied by 60 pixels per second)
   */
  defaultSpeed: double = 1
}
