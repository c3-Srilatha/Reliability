/**
 * A UI Component type that represents zoom controls for {@link UiSdlGraphVisualization} instance.
 */
@uiComponentCategorizer(name='Graph visualization zoom controls', category='Data Visualization', hide=true)
type UiSdlGraphVisualizationZoomControls mixes UiSdlComponent<any> {

  /**
   * The icon for the zoom fit button.
   */
  zoomFitIcon: private string = 'expand'

  /**
   * The value passed to the handler function when the zoom fit button is clicked.
   */
  zoomFitValue: private string = 'all'

  /**
   * The icon for the zoom in button.
   */
  zoomInIcon: private string = 'plus'

  /**
   * The value passed to the handler function when the zoom in button is clicked.
   */
  zoomInValue: private string = 'in'

  /**
   * The icon for the zoom out button.
   */
  zoomOutIcon: private string = 'minus'

  /**
   * The value passed to the handler function when the zoom out button is clicked.
   */
  zoomOutValue: private string = 'out'
}
