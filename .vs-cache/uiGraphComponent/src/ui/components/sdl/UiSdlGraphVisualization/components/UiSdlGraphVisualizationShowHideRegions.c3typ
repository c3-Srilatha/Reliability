/**
 * A UI component type that displays data in a graph.
 */
@typeScript
type UiSdlGraphVisualizationShowHideRegions {

  /**
   * A list of hidden region ids.
   */
  hiddenRegions: [string]

  /**
   * Triggered to update chart hidden regions.
   *
   * @param id
   *            Id of the component.
   * @param hiddenRegionIds
   *            Array of region ids to hide.
   *
   * @return A `SHOW_HIDE_REGIONS` action for this instance with the following properties:
   * - payload {string} The id's of the regions.
   */
  @uiSdlActionCreator(actionType='SHOW_HIDE_REGIONS')
  showHideRegionsAction: function(id: !string,
                                     hiddenRegionIds: ![string]): UiSdlGraphVisualizationShowHideRegionsAction ts-client

  /**
   * Listens for actions of type `SHOW_HIDE_REGIONS` and updates internal field {@link hiddenRegions}.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   *
   * @returns A new Redux state.
   */
  @uiSdlReducer(actionType='SHOW_HIDE_REGIONS')
  showHideRegionsReducer: function(state: UiSdlReduxState,
                                                    action: UiSdlGraphVisualizationShowHideRegionsAction): UiSdlReduxState ts-client
}
