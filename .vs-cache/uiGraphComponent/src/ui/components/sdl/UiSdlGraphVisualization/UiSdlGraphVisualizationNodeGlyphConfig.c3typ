/**
 * Glyphs are circular annotations or badges which can be applied to items. They can be used to report information about
 * an item, or to allow user interaction.  On nodes, glyphs are drawn along the border at a compass position.
 */
type UiSdlGraphVisualizationNodeGlyphConfig mixes UiSdlGraphVisualizationBaseGlyphConfig {

  /**
   * Config for the top left glyph.
   */
  topLeft: UiSdlGraphVisualizationTopLeftGlyphConfig

  /**
   * Config for the top right glyph.
   */
  topRight: UiSdlGraphVisualizationTopRightGlyphConfig

  /**
   * Config for the bottom left glyph.
   */
  bottomLeft: UiSdlGraphVisualizationBottomLeftGlyphConfig

  /**
   * Config for the bottom right glyph.
   */
  bottomRight: UiSdlGraphVisualizationBottomRightGlyphConfig
}
