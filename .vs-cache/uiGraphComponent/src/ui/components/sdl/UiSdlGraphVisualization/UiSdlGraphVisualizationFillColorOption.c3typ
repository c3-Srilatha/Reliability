  /**
   * Slate 50.
   */
  SLATE_50 = '#8A90AB'

  /**
   * Plum 50.
   */
  PLUM_50 = '#D96AB6'

  /**
   * Forest 40.
   */
  FOREST_40 = '#7DBA92'

  /**
   * Choco 50.
   */
  CHOCO_50 = '#BF808C'

  /**
   * Yellow 20.
   */
  YELLOW_20 = '#FFDB99'

  /**
   * Cyan 50.
   */
  CYAN_50 = '#0CA0AB'

  /**
   * Plum 30.
   */
  PLUM_30 = '#F7B5E4'

  /**
   * Red 40.
   */
  RED_40 = '#FF7893'

  /**
