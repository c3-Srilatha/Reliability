/**
* UiSdlGraphVisualizationDataGraphView defines the structure for the graph view configuration.
*/
type UiSdlGraphVisualizationDataGraphView {
  /**
   * The zoom level of the graph.
   */
  zoom: double

  /**
   * The x offset of the graph relative to the graph canvas.
   */
  offsetX: double

  /**
   * The y offset of the graph relative to the graph canvas.
   */
  offsetY: double
}
