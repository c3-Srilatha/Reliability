/**
 * Glyphs are circular annotations or badges which can be applied to items. They can be used to report information about
 * an item, or to allow user interaction. On edges, glyphs can be drawn on labels.
 */
type UiSdlGraphVisualizationEdgeGlyphConfig {

  /**
   * Configuration for the glyph positioned at the start of the edge.
   */
  start: UiSdlGraphVisualizationBaseGlyphConfig

  /**
   * Configuration for the glyph positioned at the center of the edge.
   */
  center: UiSdlGraphVisualizationBaseGlyphConfig

  /**
   * Configuration for the glyph positioned at the end of the edge.
   */
  end: UiSdlGraphVisualizationBaseGlyphConfig
}
