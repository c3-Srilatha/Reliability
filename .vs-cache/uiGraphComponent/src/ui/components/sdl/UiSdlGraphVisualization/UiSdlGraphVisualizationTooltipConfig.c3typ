/**
 * Data configuration for a graph visualization tooltip.
 */
type UiSdlGraphVisualizationTooltipConfig {

  /**
   * Data field mapping for the tooltip title.
   */
  tooltipTitle: string | UiSdlFieldBasedDataSpecSetting

  /**
   * Data field mapping for the tooltip subtitle.
   */
  tooltipSubtitle: string | UiSdlFieldBasedDataSpecSetting

  /**
   * Data field mapping for the tooltip body.
   */
  tooltipBody: string | UiSdlFieldBasedDataSpecSetting
}
