/**
 * The edge configuration for a graph component.
 */
type UiSdlGraphVisualizationEdgeConfig mixes UiSdlFieldBasedDataSpec {

  /**
   * Configuration for the edge glyphs.
   */
  glyphConfig: UiSdlGraphVisualizationEdgeGlyphConfig

  /**
   * Configuration for the edge tooltip.
   */
  tooltipConfig: UiSdlGraphVisualizationTooltipConfig

  /**
   * Configuration for how an edge should be styled.
   */
  style: UiSdlGraphVisualizationEdgeStyleConfig

  /**
   * Actions to be displayed in a context menu, when the edge is right-clicked.
   */
  contextMenuConfig: [UiSdlAction]
}
