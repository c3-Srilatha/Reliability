/**
 * Type to define the structure for {@link UiSdlGraphVisualization} data.
 */
type UiSdlGraphVisualizationData {

  /**
   * The nodes for the graph keyed by their id.
   */
  nodes: map<string, UiSdlGraphVisualizationDataNode>

  /**
   * The edges for the graph keyed by their id.
   */
  edges: map<string, UiSdlGraphVisualizationDataEdge>

  /**
   * The graph view configuration.
   */
  view: UiSdlGraphVisualizationDataGraphView
}
