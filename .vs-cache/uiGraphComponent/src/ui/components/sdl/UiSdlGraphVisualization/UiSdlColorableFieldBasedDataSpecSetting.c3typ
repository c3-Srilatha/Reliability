/**
 * The type defining properties used by donut segment.
 */
type UiSdlColorableFieldBasedDataSpecSetting mixes UiSdlFieldBasedDataSpecSetting {

  /**
   * The color to use.
   */
  color: !string serialized Color

  /**
   * The color mapping to use if field values map to different colors.  Prioritize colorMapping before color.
   */
  colorMapping: map<string, string serialized Color>
}
