/**
 * The type defining configuration for canvas legend.
 */
type UiSdlGraphVisualizationCanvasLegendConfig {

  /**
   * The maximum number of legend items to show in the legend.   Use 0 to show none, -1 to show all legend items or a
   * number to show that exact number.
   */
  @constraint(condition='maxLegendItems >= 1')
  maxLegendItems: int = 10

  /**
   * Default icon to be displayed with the icon items.
   */
  icon: string
}
