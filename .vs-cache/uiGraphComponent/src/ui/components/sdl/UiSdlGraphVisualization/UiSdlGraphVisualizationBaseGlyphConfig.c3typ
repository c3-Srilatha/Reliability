/**
 * Glyphs are circular annotations or badges which can be applied to items. They can be used to report information about
 * an item, or to allow user interaction.  On nodes, glyphs are drawn along the border at either a compass position or
 * an integer angle from 0-359. On links, glyphs can be drawn on labels.
 */
type UiSdlGraphVisualizationBaseGlyphConfig mixes UiSdlFieldBasedDataSpecSetting {

  /**
   * Configuration for the fill color of the glyph.
   */
  color: string serialized Color

  /**
   * Configuration for the outline color of the glyph.
   */
  outlineColor: string serialized Color

  /**
   * Configuration for the size enlargement factor of the glyph.
   */
  size: int = 1

  /**
   * Configuration for the glyph type.
   */
  glyphType: !string enum UiSdlGraphVisualizationGlyphTypeOption
}
