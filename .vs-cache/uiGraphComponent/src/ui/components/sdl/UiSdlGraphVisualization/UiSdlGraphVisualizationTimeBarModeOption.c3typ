/**
 * Enum type defining time bar mode options.
 */
enum type UiSdlGraphVisualizationTimeBarModeOption {

  /**
   * The mode for filtering.
   * Nodes and edges are removed from the canvas when filtered by the time bar.
   */
  FILTER = 'filter'

  /**
   * The mode for dimming.
   * Nodes and edges are dimmed when filtered by the time bar.
   */
  DIM = 'dim'
}
