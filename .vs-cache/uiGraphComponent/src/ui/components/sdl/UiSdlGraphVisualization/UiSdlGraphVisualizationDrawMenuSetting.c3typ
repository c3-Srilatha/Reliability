/**
 * The individual draw toolbar item setting.
 */
type UiSdlGraphVisualizationDrawMenuSetting {
  /**
   * The particular draw type to use.
   * More information at https://leaflet.github.io/Leaflet.draw/docs/leaflet-draw-latest.html#l-draw-toolbar
   */
  drawType: string enum('polyline', 'polygon', 'circle', 'rectangle', 'marker', 'circle-marker')
}
