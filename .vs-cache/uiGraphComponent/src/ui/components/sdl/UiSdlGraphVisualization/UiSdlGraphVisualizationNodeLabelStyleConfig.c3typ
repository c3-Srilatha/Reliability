/**
 * Type defining node label styling.
 */
type UiSdlGraphVisualizationNodeLabelStyleConfig {

  /**
   * Whether to vertically center the text in the node. If true, text will appear inside the node.
   */
  textCenter: boolean = false

  /**
   * If text label, the field of the data used to provide the value for the label.
   */
  textLabelField: UiSdlFieldBasedDataSpecSetting

  /**
   * Image url.
   */
  imageUrl: string serialized Url

  /**
   * Themed icon name.
   */
  themedIcon: string

  /**
   * Image url by property.
   */
  imageUrlByProperty: UiSdlFieldBasedDataSpecSetting

  /**
   * The icon, should represent a Font Awesome icon name, e.g. 'user'.
   */
  icon: string

  /**
   * Field whose value represents a Font Awesome icon.
   */
  iconByProperty: UiSdlFieldBasedDataSpecSetting
}
