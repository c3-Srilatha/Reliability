  setLayoutAction: function(id: string,
                                    layout: UiSdlGraphVisualizationLayout)
                             : !UiSdlReduxAction<UiSdlGraphVisualizationSetLayoutActionPayload> ts-client

  /**
   * Dispatched to set the animation.
   *
