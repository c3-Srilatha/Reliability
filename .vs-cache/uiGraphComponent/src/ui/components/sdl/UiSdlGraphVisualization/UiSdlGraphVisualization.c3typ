  deleteAnnotationAction: function(id: string, itemId: string)
                                  : !UiSdlReduxAction<UiSdlGraphVisualizationDeleteAnnotationActionPayload> ts-client

  /**
   * Listens for actions of type `CACHE_KEY_SET` and updates {@link UiSdlGraphVisualization#cacheKey}.
   *
   * @param state
   *           Redux state.
   * @param action
   *           Redux action.
   * @return a new Redux state.
   */
