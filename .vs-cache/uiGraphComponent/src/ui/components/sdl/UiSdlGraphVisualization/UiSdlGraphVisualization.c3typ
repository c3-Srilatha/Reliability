  clickContextMenuItemAction: function(id: string,
                                               itemId: string,
                                               actionToDispatch: UiSdlAction)
                                        : !UiSdlReduxAction<UiSdlGraphVisualizationClickContextMenuItemActionPayload> ts-client

  /**
   * Action triggered when an annotation is submitted
   * @param id
   *           The id of the component
   * @param annotation
   *           The text of the annotation
   * @param itemId
   *           The id of the item to be annotated
   * @param itemType
   *           The type of the item being annotated (node/edge)
   * @return a `ANNOTATION_SUBMIT` action for this instance.
   */
  @uiSdlActionCreator(actionType='ANNOTATION_SUBMIT')
  submitAnnotationAction: function(id: string,
                                         annotation: string,
                                         itemId: string,
                                         itemType: string)
                                  : !UiSdlReduxAction<UiSdlGraphVisualizationSubmitAnnotationActionPayload> ts-client

  /**
   * Dispatched when a combo is changed, either gaining or losing a node.
   *
   * @param id
   *           Id of the graph component.
   * @param item
   *           The item that was added to or removed from a combo.
   * @param items
   *           The canvas items after the change.
   * @return a `COMBO_ITEMS_UPDATED` action for this instance.
   */
