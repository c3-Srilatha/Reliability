                                          action: !UiSdlGraphVisualizationClickLegendActionPayload)
                                    : !UiSdlReduxState ts-client

  /**
   * Listens for actions of type `RESET_GRAPH_TO_INITIAL_STATE` and updates {@link UiSdlGraphVisualization}.
   *
