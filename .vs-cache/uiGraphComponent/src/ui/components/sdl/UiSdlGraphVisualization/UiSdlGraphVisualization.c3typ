  updateComboItemsAction: function(id: string, item: UiSdlGraphVisualizationDataNode, items: [UiSdlGraphVisualizationDataNode]): !UiSdlReduxAction<UiSdlGraphVisualizationUpdateComboItemsActionPayload> ts-client

  /** Dispatched when an annotation is deleted.
   *
   * @param id
   *           Id of the graph component.
   * @param itemId
   *           The id of the item that the annotation is associated with.
   * @return a `ANNOTATION_DELETE` action for this instance.
   */
