  @uiSdlActionCreator(actionType='DRAW_EDIT_VERTEX')
  drawEditVertexAction: function(id: string, actionType: string): !UiSdlReduxAction<UiSdlComponentActionPayload> ts-client

 /**
   * Triggers when user moves the shape using the editing tool
   *
