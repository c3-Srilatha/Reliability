/**
 * The configuration for creating different stacks in the TimeBar of {@link UiSdlGraphVisualization}
 */
type UiSdlGraphVisualizationTimeBarStackConfig mixes UiSdlFieldBasedDataSpec {

  /**
   * The field inside of the item's data field that the stack should be separated on
   */
  by: string

  /**
   * A map of styles where the key is the value of the field specified in 'by' and the value is a {@link UiSdlGraphVisualizationTimeBarStackStyleConfig}
   */
  styles: map<string, UiSdlGraphVisualizationTimeBarStackStyleConfig>

}
