/**
* Represents the view of the graph.
* This object is used by ReGraph to render the graph with a specific position and zoom level.
*/
type UiSdlGraphVisualizationGraphView {
  /**
  * The x-coordinate of the view relative to the graph visualization canvas.
  */
  offsetX: double

  /**
  * The y-coordinate of the view relative to the graph visualization canvas.
  */
  offsetY: double

  /**
  * The zoom level of the view.
  */
  zoom: double
}
