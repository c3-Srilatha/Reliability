/**
 * The styles available for {@link UiSdlMapbox}.
 */
enum type UiSdlMapboxStyle {

  /**
   * The Streets style.
   */
  STREETS

  /**
   * The Light style.
   */
  LIGHT

  /**
   * The Dark style.
   */
  DARK

  /**
   * The Satellite style.
   */
  SATELLITE

  /**
   * The Satellite with lables style.
   */
  SATELLITE_STREETS

  /**
   * The Terrain/Outdoors style.
   */
  OUTDOORS

  /**
   * THe not_set default value
   */
  NOT_SET
}
