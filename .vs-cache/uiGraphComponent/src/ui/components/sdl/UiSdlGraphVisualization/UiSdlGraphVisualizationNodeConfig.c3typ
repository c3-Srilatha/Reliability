/**
 * The node data spec configuration for a graph component.
 */
type UiSdlGraphVisualizationNodeConfig mixes UiSdlFieldBasedDataSpec {
  /**
   * The configuration for the node coordinates when {@link UiSdlGraphVisualization#showMap} is true.
   */
  coordinatesConfig: UiSdlGraphVisualizationNodeCoordinatesConfig

  /**
   * The configuration for clustering nodes within a certain pixel radius when
   * {@link UiSdlGraphVisualization#showMap} is true.
   */
  clusterConfig: UiSdlGraphVisualizationNodeClusterConfig

  /**
   * The configuration for the node donuts.
   */
  donutConfig: UiSdlGraphVisualizationNodeSegmentDonutConfig | UiSdlGraphVisualizationNodePercentageDonutConfig

  /**
   * The configuration for the node glyphs.
   */
  glyphConfig: UiSdlGraphVisualizationNodeGlyphConfig

  /**
   * The configuration for the node tooltip.
   */
  tooltipConfig: UiSdlGraphVisualizationTooltipConfig

  /**
   * The configuration for the node style.
   */
  style: UiSdlGraphVisualizationNodeStyleConfig

  /**
   * Actions to be displayed in a context menu, when the node is right-clicked.
   */
  contextMenuConfig: [UiSdlAction]
}
