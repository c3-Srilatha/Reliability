/**
 * The configuration `donut` border of segmented sections around a node of type `percentage`.
 * Doesn't apply to nodes when shape is set to `box`.
 */
type UiSdlGraphVisualizationNodePercentageDonutConfig {

  /**
   * Node donuts of type `percentage` render only 1 segment with the angle matching the percentage value.
   */
  donutType: string = 'percentage'

  /**
   * Properties to set the donut segment size and color.
   */
  percentageSegment: UiSdlColorableFieldBasedDataSpecSetting

  /**
   * Properties to set the donut segment size and color if you want segment to change color based on value.
   * This will only be used when {@link #percentageSegment} is not confugured
   */
  percentStepSegment: UiSdlStepColorableFieldBasedDataSpecSetting

  /**
   * Width of the donut.
   */
  width: !string enum UiSdlGraphVisualizationNodeDonutWidthOption = THIN
}
