/**
 * Defines the payload to be dispatched when a context menu item is clicked.
 */
type UiSdlGraphVisualizationClickContextMenuItemActionPayload mixes UiSdlComponentActionPayload {

  /**
   * The id of the item (node or edge) that was right-clicked.
   */
  itemId: string

  /**
   * Configuration for the action that should be dispatched upon selecting a context menu item.
   */
  actionToDispatch: UiSdlAction
}
