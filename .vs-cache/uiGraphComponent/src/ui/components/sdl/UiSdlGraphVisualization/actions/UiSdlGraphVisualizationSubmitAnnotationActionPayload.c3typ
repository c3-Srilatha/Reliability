/**
 * Defines the payload to be dispatched when an annotation is submitted.
 */
type UiSdlGraphVisualizationSubmitAnnotationActionPayload mixes UiSdlComponentActionPayload {
  /**
   * The text content of the annotation.
   */
  annotation: string

  /**
   * The id of the node that was annotated.
   */
  itemId: string
}
