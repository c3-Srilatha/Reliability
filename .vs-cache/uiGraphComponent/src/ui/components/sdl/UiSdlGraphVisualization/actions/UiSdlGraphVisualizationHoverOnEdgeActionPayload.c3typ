/**
 * Type which describes the payload for {@link UiSdlGraphVisualization#hoverOnEdgeAction}.
 */
type UiSdlGraphVisualizationHoverOnEdgeActionPayload mixes UiSdlComponentActionPayload {

  /**
   * The id of the hovered edge.
   */
  hoveredEdgeId: string

  /**
   * The x location of the pointer in view coordinates.
   */
  x: int

  /**
   * The y location of the pointer in view coordinates.
   */
  y: int
}
