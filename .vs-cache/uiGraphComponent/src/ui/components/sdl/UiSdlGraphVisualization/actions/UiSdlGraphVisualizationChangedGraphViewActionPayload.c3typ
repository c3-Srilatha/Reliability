/**
* The payload of the action to change the graph view.
* This payload is dispatched when the user changes the view of the graph visualization.
* The view changes when users drag the graph visualization or zoom in/out.
*/
type UiSdlGraphVisualizationChangedGraphViewActionPayload mixes UiSdlComponentActionPayload {
  /**
  * The new view object of the graph.
  */
  view: UiSdlGraphVisualizationGraphView
}
