/**
* Payload for the action that changes the positions of the nodes in the graph visualization.
*/
type UiSdlGraphVisualizationChangedNodesPositionsActionPayload mixes UiSdlComponentActionPayload {
  /**
   * The list of all the nodes in the graph with their last positions,
   * you need to calculate the diff of each one if you want to only get
   * the ones that changed.
   */
  nodes: map<string, UiSdlGraphVisualizationNodePosition>
}
