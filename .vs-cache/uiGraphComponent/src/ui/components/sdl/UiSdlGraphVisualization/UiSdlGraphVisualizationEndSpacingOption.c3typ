/**
 * Controls the spacing between link ends and nodes.
 */
enum type UiSdlGraphVisualizationEndSpacingOption {

  /**
   * Adds some spacing between nodes and edges.
   */
  LOOSE = 'loose'

  /**
   * No spacing between nodes and edges.
   */
  TIGHT = 'tight'
}
