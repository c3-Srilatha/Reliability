/**
 * This type is a base type for the recipient of all notifications.
 */
entity extendable type NotificationRecipient schema name 'NTFY_RCP' {

  /**
   * Recipient's email address
   */
  email: string

  /**
   * Recipient's phone number
   */
  phoneNumber: string

  /**
   * How often to receive emails in batch mode
   * Unit: number of minutes
   */
  batchPeriod: int

  /**
   * Flag to indicate whether the notification should be in batch or not
   */
  isBatch: boolean stored calc exists(preferences.(preference == NotificationPreference.BATCH))

  /**
   * Current recipient's preferences in different types
   */
  preferences: [NotificationCategoryPreference](recipient)

  /**
   * Count of notifications that have not been sent
   */
  unsentNotificationCount: int stored calc count(unsentNotifications)

  /**
   * The notification histories for the current recipient
   */
  notifications: [NotificationHistory](parent)

  /**
   * Unsent notification histories for the current recipient
   */
  @db(filter='sent == false')
  unsentNotifications: [NotificationHistory](parent)

  /**
   * The next time a batch notification will be sent out for the current recipient
   */
  nextRunTime: private datetime

  /**
   * Schedule the notification according to the preference
   * If a setting or a category doesn't exist, the default is 'push' i.e. send right away
   * If the user wants to receive notification right away, an email notification will be sent and the NotificationHistory record will be marked as sent.
   * If the user wants to receive notification in batch, only NotificationHistory record will be created.
   * @param spec
   *          Specification to schedule notification
   */
  scheduleNotification: member function(spec: !NotificationSpec) js-rhino

  /**
   * Method to send all pending (i.e. unsent) notifications
   */
  sendPendingNotifications: member function() js-rhino

  /**
   * Method evoked by cron job
   * Even if a recipient doesn't have unsent notifications, we still need to process it to increment the nextRunTime
   */
  sendScheduledNotifications: function() js-rhino
}
