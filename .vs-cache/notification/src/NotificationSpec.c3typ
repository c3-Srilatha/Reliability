/**
 * This type defines specification for a type of notifications.
 */
type NotificationSpec mixes Spec {

  /**
   * The email subject for the notification
   */
  subject: string

  /**
   * The email content for the notification
   */
  content: !string

  /**
   * The category for the notification
   */
  category: string = ''

  /**
   * The url for the notification
   */
  url: string
}
