/**
 * A type for user as recipient.
 */
@db(unique=['user'])
entity type NotificationUserRecipient extends NotificationRecipient type key 'USER' {

  /**
   * Current user as the recipient
   */
  user: !User

  /**
   * Email address to notify user
   */
  email: ~ stored calc user.email

  /**
   * Send a message to a group of users according to the preference setting
   * It will fetch NotificationUserRecipient for all the users and create NotificationUserRecipients if not found.
   * It will call NotificationUserRecipient.scheduleNotification iteratively.
   * @param users
   *          List of users to notify
   * @param spec
   *          Specification for the notification
   */
  scheduleNotificationToUsers: function(users: ![User], spec: !NotificationSpec) js-rhino
}
