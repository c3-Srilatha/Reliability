/**
 * This type defines history for each notification.
 */
@db(datastore='kv',
    compactType=true,
    partitionKeyField='parent',
    persistenceOrder='sent, updatedTimestamp',
    persistDuplicates=false,
    shortId=true,
    shortIdReservationRange=100000)
entity type NotificationHistory mixes NotificationSpec schema name 'NTFY_HIST' {

  /**
   * The owner of current notification history
   */
  parent: !NotificationRecipient

  /**
   * When the content is updated or created
   */
  updatedTimestamp: !datetime

  /**
   * Whether the notification is sent
   */
  sent: boolean

  /**
   * When the notification is sent
   * null if the message is not sent
   */
  sentTimestamp: datetime

  /**
   * Error message of when fail to send notification
   */
  error: string
}
