/**
 * This type defines notification preference for a single recipient.
 */
@db(unique=['recipient, category'])
entity type NotificationCategoryPreference schema name 'NTFY_CAT_PREF' {

  /**
   * The recipient who owns this preference
   */
  recipient: !NotificationRecipient

  /**
   * Current preference's category
   */
  category: !string

  /**
   * Specific preference for the notification
   */
  preference: !string enum NotificationPreference
}
