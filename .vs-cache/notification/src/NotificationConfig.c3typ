/**
 * This type defines configuration for notifications.
 */
type NotificationConfig mixes Config, Singleton {

  /**
   * Unsubscribe text in each notification
   * The text and URL are in HTML format (e.g. <p> To unsubscribe click <a href = ''>unsubscribe</a></p>)
   */
  unsubscribeText: string

  /**
   * The email subject for batch notifications
   */
  batchSubject: string = 'Your Batch Email'

  /**
   * Default batch period to use if not defined
   * Unit: number of minutes
   */
  defaultBatchPeriod: int = 60

  /**
   * The email address the notifications are sent from
   */
  fromAddress: string = 'no-reply@c3iot.com'
}
