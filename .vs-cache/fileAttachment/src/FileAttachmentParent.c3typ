/**
 * Abstract type representing a parent type for file attachments.
 *
 * A parent type for file attachments is an entity that can have multiple file attachments associated with it.
 *
 * @param FA
 *           The type of file attachment associated with this parent type.
 */
abstract type FileAttachmentParent<FA> {

  /**
   * The file attachments associated with this parent object.
   */
  fileAttachments: [FA](parent)

  /**
   * Returns a relative file endpoint url for the files passed as arguments
   *
   * @param fileMetas
   *        Array of {@link FileMeta} of attachments we want to download
   * @param rootFolder
   *        When zipping is required, the zip file is saved to `{rootFolder}/{current date}/` directory in
   *        FileSystemMount.ATTACHMENT mount.
   * @return If a single file is requested its relative file endpoint url is returned. If multiple files are requested,
   *         relative file endpoint url of a zip archive containing all the files is returned
   */
  downloadAttachments: function (fileMetas: ![FileMeta], rootFolder: string = 'zip'): string serialized Url js-rhino

  /**
   * Generates a zip archive containing all the files passed as arguments
   *
   * @param fileMetas
   *        Array of {@link FileMeta}s which should be included in the zip archive
   * @param rootFolder
   *        The zip file is saved to `{rootFolder}/{current date}/` directory in
   *        FileSystemMount.ATTACHMENT mount.
   * @return The zip file
   */
  zipFiles: private function (fileMetas: ![FileMeta], rootFolder: string = 'zip'): !File js-rhino

  /**
   * Save the given new file in {@link FileSystemMount#ATTACHMENT}, update its ACL,
   * and create the corresponding file attachment instance
   *
   * @param spec
   *        The specification on what and how to upload the file
   * @return The created file attachment instance for this attachment
   */
  uploadAttachment: member function(spec: !UploadAttachmentSpec): FA js-rhino

  /**
   * Save the given new file in FileSystemMount.ATTACHMENT, update its ACL.
   * @param spec
   *        The specification on what and how to upload the file
   * @return The created file meta
   */
   createFileMeta: function(spec: !UploadAttachmentSpec): FileMeta js-rhino

   /**
   * Create corresponding file attachment for a FileMeta.
   * @param fileMeta
   *        The FileMeta for the file attachment.
   * @return The file attachment instance
   */
   createFileAttachment: member function(fileMeta: !FileMeta): FA js-rhino
}
