/**
 * Specification type to upload attachment
 */
type UploadAttachmentSpec {
  /**
   * The file name to be saved
   */
  fileName: !string

  /**
   * The binary content of the attachment
   */
  content: !binary

  /**
   * The member to add into the ACL for this attachment
   */
  aclMembers: [Member]

  /**
   * The relative path to store the file in mount
   */
  relativePath: !string
}
