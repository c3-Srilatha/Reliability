@denorm(target='TestOrganizationDenorm', strictHierarchy=true)
entity type TestOrganization schema name 'TSTORG' {

  children: [TestOrganization](parent)
  parent:   TestOrganization

  /**
   * Denormalized parents which are used to show the hierarchy.
   */
  denormParents: [TestOrganizationDenorm](to) schema name 'ORGDP'

  /**
   * Denormalized children which are used to show the hierarchy.
   */
  denormChildren: [TestOrganizationDenorm](from) schema name 'ORGDCH'
}
