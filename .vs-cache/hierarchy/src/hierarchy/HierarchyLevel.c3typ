/**
 * Defines how a node inside a Hierarchy might branch out to other nodes.
 *
 * When a {@link HierarchyLevel} is specified in a {@link Hierarchy.hierarchyLevels} mapping, any node that matches the mapped type name
 * will be used to find new nodes in this level by using the {@link branches} configuration.
 */
type HierarchyLevel {

  branches: [HierarchyBranch] schema suffix 'HBS'
}
