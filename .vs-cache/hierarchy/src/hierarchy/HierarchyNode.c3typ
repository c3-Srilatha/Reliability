type HierarchyNode {

  nodeId: string
  name:   string

  /**
   * The type name of the object this node represents.
   */
  nodeType: string

  /**
   * Populated when returned as a result of {@link Hierarchy.search} call
   */
  parent: HierarchyNode

  context: [string]

  /**
   * Indicate the tree level from its root parent
   */
  depth: int

  /**
   * Indicate whether the current HierarchyNode has children or not.
   */
  hasChildren: boolean
}
