/**
 * Connector between {@link PartyRole} and {@link PhysicalAsset}.
 */
extendable entity type AssetPartyRole mixes TimedIntervalRelation<PhysicalAsset, PartyRole> type key 'FAPR' schema name 'STRUCT_FAPROLE' {

  /**
   * The asset owned by this {@link PartyRole}.
   */
  assetOwned: !PhysicalAsset schema name 'ASSET_R'

  /**
   * The {@link PartyRole} associated with this asset.
   */
  partyRole: !PartyRole

  /**
   * Calculated field representing the 'from' side of the relation (the {@link PhysicalAsset}).
   */
  from: ~ stored calc assetOwned

  /**
   * Calculated field representing the 'to' side of the relation (the {@link PartyRole}).
   */
  to: ~ stored calc partyRole
}
