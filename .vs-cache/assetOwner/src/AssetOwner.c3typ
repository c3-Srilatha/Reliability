/**
 * Tracks the ownership details of an {@link PhysicalAsset}, including the fraction of ownership.
 */
entity type AssetOwner extends AssetPartyRole type key 'FAOW' {

  /**
   * The fraction of ownership of the asset. Default is 1.0 (full ownership).
   */
  ownershipFraction: decimal = 1.0

  /**
   * The scope of emissions associated with the asset.
   */
  scope: string
}
