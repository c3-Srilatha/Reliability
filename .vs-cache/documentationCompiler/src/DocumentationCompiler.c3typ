/**
 * Allows for streaming and uploading {@link ArtifactHub.Artifact.Content} in a low memory way.
 */
@restful(endpoint='docs')
type DocumentationCompiler mixes Restful {
  handle: ~ js-server

  /**
   * Creates HTML files to display C3 documentation.
   *
   * @param rootPkg
   *          The package we are creating the documentation for. Will default to the current app's root package if empty.
   */
  @nodejs(typeSystem=false, async=true)
  bootstrap: function(rootPkg: !string) js-documentationcompiler-server-node

  /**
   * Returns the prefix to prepend to the files that will be copied to the C3 File System.
   */
  @nodejs(typeSystem=false, async=false)
  c3fsPrefix: function(): string js-documentationcompiler-server-node
}
