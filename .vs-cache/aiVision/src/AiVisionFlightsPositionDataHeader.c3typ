/**
 * Header for a set of {@link AiVisionFlightsPositionDataPoint} measurements.
 */
entity type AiVisionFlightsPositionDataHeader mixes TimedDataHeader<AiVisionFlightsPositionDataPoint> schema name 'AV_FPDH' {

  /**
   * The aggregation/disaggregation to use for the measurements. The only possible values are specified here. Otherwise, an error will be thrown.
   */
  treatment: string enum('previous', 'rate', 'integral')

  /**
   * The for which measurements were taken.
   */
  flight: AiVisionFlight
}
