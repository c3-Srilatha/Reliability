/**
 * Data points that represent the position of an missile in a launch.
 */
 @db(datastore='kv',
  partitionKeyField='parent',
  persistenceOrder='start',
  persistDuplicates=false,
  compactType=true,
  shortIdReservationRange=100000)
entity type AiVisionMissilesPositionDataPoint mixes TimedDataPoint<AiVisionMissilesPositionDataHeader> schema name 'AV_MISSPDP' {

  /**
   * The latitude of the missile.
   */
  @ts(treatment='previous')
  latitude: double

  /**
   * The longitude of the missile.
   */
  @ts(treatment='previous')
  longitude: double

  /**
   * The altitude of the missile.
   */
  @ts(treatment='previous')
  altitude: double
}
