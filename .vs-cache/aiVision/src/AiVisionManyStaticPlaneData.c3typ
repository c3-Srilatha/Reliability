entity type AiVisionManyStaticPlaneData mixes SeedData, Identified schema name 'VMSPD' {
  /**
   * Location of the plane as a city
   */
  location: string

  /**
   * latitude of the plane
   */
  latitude: double

  /**
   * longitude of the plane
   */
  longitude: double

  /**
   * altitude of the plane as units of distance in cesium
   */
  altitude: double

  /**
   * Color of the plane
   */
  color: string

  /**
   * How likely it is that the plane will be delayed
   */
  riskOfDelay: AiVisionPlaneDataRiskOfDelay

  /**
   * Whether or not the plane is on the ground
   */
  grounded: boolean stored calc altitude == 0

  /**
   * Orientation for the plane to face (degree value from -179, 180)
   */
  orientation: double
}
