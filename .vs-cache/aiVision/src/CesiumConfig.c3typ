/**
 * The CesiumConfig type defines Cesium-related configuration settings.
 */
type CesiumConfig {

  /*
   * The URL to connect to Cesium. This can be configured based on if the user
   * is storing their backend data on Cesium or their own self-hosted Cesium instance.
   */
  url: string = "https://ion.cesium.com/"

  /*
   * Access token when linking API requests to Cesium. The access token must be provided to authenticate and issue API requests to a Cesium account.
   * By default, an access token is not provided. If an access token is not provided, the Cesium API will not be accessible.
   * For more information about Cesium access tokens, see {$@link https://cesium.com/learn/ion/cesium-ion-access-tokens/}.
   */
  accessToken: string
}
