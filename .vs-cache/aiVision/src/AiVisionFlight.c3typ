/**
 * Represents a flight of a plane, with departure and arrival airports.
 */
entity type AiVisionFlight mixes MetricEvaluatable type key 'AV_FLIGHT' {

  /**
   * The plane that is flying.
   */
  planeId: string

  /**
   * The flight number.
   */
  flightNumber: string

  /**
   * The departure location of the flight.
   */
  departureAirport: string

  /**
   * The arrival location of the flight.
   */
  arrivalAirport: string
}
