/**
 * Represents a missile launch, with base location and target.
 */
entity type AiVisionMissileLaunch mixes MetricEvaluatable type key 'AV_MISSL' {

  /**
   * The base location of the missile.
   */
  base: string

  /**
   * The target location of the missile.
   */
  target: string
}
