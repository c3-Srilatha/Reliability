/**
 * A test component to link to two different pages.
 */
type BundlerTestAppNavPage mixes UiSdlComponent<any> {

  /**
   * The link the test user has access to
   */
  allowedLink: string = 'bundler-test-app-role-required-access/dashboard'

  /**
   * The link the test user does not have access to
   */
  notAllowedLink: string = 'bundler-test-app-role-required/dashboard'
}
