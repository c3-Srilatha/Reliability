/**
 * React hook to evaluate a condition and use its value in a React component.
 */
@typeScript
type UiSdlUseRenderConditionType {

  /**
   * Returns a React component type that uses the given condition type to evaluate a condition.
   *
   * @param condition
   *           The condition to evaluate.
   *
   * @returns A react component with same props as UiSdlConditionalRenderer but that is specific for the given condition type.
   */
  useRenderConditionType: function(condition: UiSdlRenderCondition): ReactFunction ts-client
}
