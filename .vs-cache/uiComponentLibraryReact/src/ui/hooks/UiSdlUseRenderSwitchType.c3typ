/**
 * React hook to evaluate a switch condition and use its value in a React component.
 */
@typeScript
type UiSdlUseRenderSwitchType {

  /**
   * Returns a React component type that uses the given switch condition type to evaluate a condition.
   *
   * @param condition
   *           The condition to evaluate.
   * @param componentsToRender
   *           The mapping of the value resulting from evaluation of the switch condition, to the component to render for that condition.
   *
   * @returns A react component with same props as UiSdlSwitchRenderer but that is specific for the given switch condition type.
   */
  useRenderSwitchType: function(condition: UiSdlRenderSwitchCondition,
                                componentsToRender: map<any, UiSdlComponentRef<UiSdlComponent<UiSdlNoData>>>): ReactFunction ts-client
}
