/**
 * Custom hook that checks if the content ref is overflowing and sets the overflow flags.
 */
@typeScript
type UiSdlUseScrollBehavior {

  /**
   * Custom hook that checks if the content ref is overflowing and sets the overflow flags.
   *
   * @param componentRef - The ref of the component to check for overflow.
   * @returns {isOverflowingLeft, isOverflowingRight, scrollRight, scrollLeft}
   */
  useScrollBehavior: function(componentRef: UiSdlComponentRef): json ts-client
}
