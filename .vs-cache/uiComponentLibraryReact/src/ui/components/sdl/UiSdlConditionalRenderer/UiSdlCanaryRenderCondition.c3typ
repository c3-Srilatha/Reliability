/**
 * Implements UiSdlRenderCondition for component rendering of Canary elements.
 *
 * It will render the thenComponent when the {@link CanaryMode#enabled} is true, otherwise,
 * the elseComponent will be rendered.
 *
 * Example:
 *
 * The following component will only render `MyApp.CanaryGrid` when the {@link CanaryMode#enabled} is true.
 *
 *     {
 *       type: "UiSdlConditionalRenderer",
 *       condition: {
 *         type: "UiSdlCanaryRenderCondition"
 *       },
 *       thenComponent: {
 *         id: "MyApp.CanaryGrid"
 *       }
 *     }
 */
@typeScript
type UiSdlCanaryRenderCondition mixes UiSdlRenderCondition {

  useCondition: ~
}
