/**
 * Implements UiSdlRenderCondition for component rendering using feature flags in {@link UiSdlApplicationConfig}.
 *
 * It will render the thenComponent when the {@link CanaryMode#enabled} is true, otherwise,
 * the elseComponent will be rendered.
 *
 * Example:
 *
 * The following component will only render `MyApp.CoolVisualization` when the {@link UiSdlApplicationConfig} field
 * `myApp.myFeature` is true.
 *
 *     {
 *       type: "UiSdlConditionalRenderer",
 *       condition: {
 *         type: "UiSdlFeatureFlagCondition",
 *         expectedValue: true,
 *         configPath: ["myApp", "myFeature"]
 *       },
 *       thenComponent: {
 *         id: "MyApp.CoolVisualization"
 *       }
 *     }
 */
@typeScript
type UiSdlFeatureFlagCondition mixes UiSdlRenderCondition {

  /**
   * When the config value stored at the configPath location is equal to this expected value,
   * the condition will be truthy.
   */
  expectedValue: boolean = true

  /**
   * The path for the configuration from UiSdlConfig.
   * Example: If you define the "myApp" field in {@link UiSdlApplicationConfig} and it contains a field called "myFeature",
   * you need to provide ["myApp", "myFeature"] here.
   */
  configPath: [string]

  useCondition: ~
}
