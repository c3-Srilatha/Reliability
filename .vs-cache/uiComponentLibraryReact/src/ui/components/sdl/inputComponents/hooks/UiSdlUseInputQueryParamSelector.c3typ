/**
 * React hook to keep a submittable input component's value and its unique query parameter value.
 * in sync.
 */
@typeScript
type UiSdlUseInputQueryParamSelector {

  /**
   * The function that implements the aforementioned React hook.
   *
   * @param componentId
   *           The id of the input component.
   * @param value
   *           The value of the input component.
   * @param submittable
   *           Whether the input component is submittable.
   * @param autoFillValue
   *           Optional value to auto fill the input component as default value.
   * @param submitInputAction
   *           The function to call if the input's value must be submitted to update its unique query param.
   * @param setValueAction
   *           The function to call if the input's 'value' field must be updated.
   */
  useInputQueryParamSelector: inline function(componentId: string,
                                              value: string | [string],
                                              submittable: boolean,
                                              autoFillValue: string,
                                              submitInputAction: lambda(id: string,
                                                                        event: any,
                                                                        value: string | [string]): UiSdlReduxAction,
                                              setValueAction: lambda(id: string,
                                                                     event: any,
                                                                     value: string | [string]): UiSdlReduxAction) ts-client
}
