/**
 * Base type for input components for {@link UiSdlFilterPanel} and {@link UiSdlForm}.
 */
@typeScript
@uiSdlPluggable(namespace='inputComponents')
abstract type UiSdlInputReact {

  /**
   * Determines if this input component should be rendered a a connected dynamic component
   * based on its props.
   */
  shouldRenderAsConnectedDynamicComponent: abstract function(props: mixing UiSdlInputReact): boolean
}
