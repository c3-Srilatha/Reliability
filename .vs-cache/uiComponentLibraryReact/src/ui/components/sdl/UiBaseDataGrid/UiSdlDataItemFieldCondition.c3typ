@typeScript
type UiSdlDataItemFieldCondition mixes UiSdlComparisonCondition {
  /**
   * Field to extract from the data item
   */
  fieldName: string

  /**
   * Data item to be analyzed. This field is set by the framework.
   */
  dataItem: private any

  produceSubject: ~ ts-client
}
