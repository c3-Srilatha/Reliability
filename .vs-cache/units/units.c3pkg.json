{
  "name": "units",
  "description": "seed data for units",
  "author": "studio <studio@c3.ai>",
  "version": "8.9.0",
  "compatibleToVersion": "8.7",
  "eslintConfig": {
    "extends": [
      "plugin:@c3/c3-base",
      "plugin:@c3/typescript",
      "plugin:prettier/recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2018,
      "sourceType": "module"
    },
    "plugins": [
      "@c3"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^e$|^_",
          "ignoreRestSiblings": true
        }
      ]
    }
  }
}
