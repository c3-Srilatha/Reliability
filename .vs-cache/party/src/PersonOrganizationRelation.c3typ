/**
 * Relationship between {@link Person} and {@link Organization}.
 */
@db(index+=['to, start', 'from, start'])
entity type PersonOrganizationRelation extends PartyTimedIntervalRelation type key 'PER_ORG' {

  /**
   * The {@link Person} in this relationship
   */
  from: Person

  /**
   * The {@link Organization} in this relationship
   */
  to: Organization
}
