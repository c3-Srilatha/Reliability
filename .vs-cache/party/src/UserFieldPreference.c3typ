/**
 * Represents user-specific field preferences stored as key-value pairs.
 * This type provides a flexible mechanism for storing arbitrary user preferences
 * that can be dynamically configured without schema changes. It serves as a
 * temporary solution for field-level user preferences until filtering by value
 * on UserPreference is implemented.
 *
 */
// TODO: PLAT-128837 Remove when UserPreference supports value-based filtering
entity type UserFieldPreference schema name 'PREF_USERFLD' {

  /**
   * The member (user) this preference belongs to
   */
  member: Member

  /**
   * The preference key identifier
   */
  key: string

  /**
   * The preference value associated with the key
   */
  value: string

  /**
   * Person-to-user mappings for this member
   */
  personMappings: [PersonUser](user, member)
}
