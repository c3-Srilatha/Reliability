/**
 * Represents the relationship between a {@link Customer} and their designated {@link Contact} person.
 * This relationship type extends {@link PartyRoleRelation} to establish a connection
 * between customers and the specific contacts who handle their business interactions.
 */
entity type CustomerContact extends PartyRoleRelation type key 'CCTR' {

  /**
   * The {@link Customer} in this relationship
   */
  fromRole: Customer

  /**
   * The {@link Contact} person designated for this customer
   */
  toRole: Contact
}
