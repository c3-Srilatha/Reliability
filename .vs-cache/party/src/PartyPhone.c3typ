/**
 * Phone number associated to a party.
 *
 * Business Key: party+number+usage
 */
@db(unique=['party,number,phoneUsage'], index+=['meta.timestamp'])
entity type PartyPhone mixes Telephone schema name 'STRUCT_PARTYPHON' {

  /**
   * Allows designation of use for parties with multiple phone numbers
   * i.e. billing phone, emergency phone/SMS, etc.
   */
  phoneUsage: string enum('Billing', 'Emergency', 'Work', 'Home', 'Preferred', 'Mobile', 'Office')

  /**
   * Preferred number for party.
   *
   * In future may be used for stored calc to replicate on party or partyRole
   */
  isPreferred: boolean

  /**
   * The Party to which this number belongs.
   */
  party: !Party

  name: ~ not persistable
}
