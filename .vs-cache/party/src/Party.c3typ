/**
 * A person or an organization
 * Examples: Joe Smith, Environmental Protection Agency, Dow Chemicals.
 */
@db(index+=['meta.timestamp'])
extendable entity type Party type key 'PRT' schema name 'STRUCT_PARTY' {

  /**
   * Incoming edges of the {@link Party} hierarchy
   */
  parentRelations: [PartyTimedIntervalRelation](to)

  /**
   * Outgoing edges of the {@link Party} hierarchy
   */
  childRelations: [PartyTimedIntervalRelation](from)

  /**
   * Outgoing edges of the {@link Party} lateral relation graph
   */
  relatedPartyEdgesFrom: [PartyEdge](from)

  /**
   * Incoming edges of the {@link Party} lateral relation graph
   */
  relatedPartyEdgesTo: [PartyEdge](to)

  /**
   * The party's preferred contact method.
   */
  preferredCommunicationMethod: string enum CommunicationType stored calc exists(communicationPreferences.(isPreferred == 'true' && isSubscribed == 'true')) ? communicationPreferences.(isPreferred == 'true' && isSubscribed == 'true')[0].communicationType : exists(communicationPreferences.(isPreferred != 'false' && isSubscribed == 'true')) ? communicationPreferences.(isPreferred != 'false' && isSubscribed == 'true')[0].communicationType : exists(communicationPreferences.(isSubscribed == 'true')) ? communicationPreferences.(isSubscribed == 'true')[0].communicationType : null

  /**
   * Preference of the party's communication method
   */
  communicationPreferences: [PartyCommunicationPreference](party)

  /**
   * Whether the party want to receive email or not
   */
  receiveEmail: boolean stored calc !exists(communicationPreferences.(communicationType == 'email' && isSubscribed == false))

  /**
   * Whether the party want to receive SMS or not
   */
  receiveSMS: boolean stored calc !exists(communicationPreferences.(communicationType == 'sms' && isSubscribed == false))

  /**
   * The parents of the party based on the PartyRoles specified.
   */
  parents: [Party] stored calc roles.parents.party schema name 'PAR'

  /**
   * Preferred language of communication locale code
   * Standard locale codes
   * en_US - English United States
   * en_GB - English United Kingdon
   * fr_CA - French Canadian
   *
   * FK references FROM parents
   */
  preferredLanguageLocaleCode: Locale

  /**
   * PartyRoles assigned to the Party.
   */
  @db(cascadeRemove=true)
  roles: [PartyRole](party) schema name 'ROLE'

  /**
   * Phone contact information entries for the Party.
   */
  @db(order='descending(toUTC(meta.updated))')
  phones: [PartyPhone](party)

  /**
   * Electronic contact information, e.g. Twitter, email, Facebook, etc.
   *
   * fetch most recent if fetching only 1
   */
  @db(order='descending(toUTC(meta.updated))')
  electronicCommunications: [PartyElectronicCommunication](party)

  /**
   * Postal addresses.
   *
   * fetch most recent if fetching only 1
   */
  @db(order='descending(toUTC(meta.updated))')
  postalAddresses: [PartyPostalAddress](party)

  /**
   * Most recent postal address of this party.
   */
  latestAddress: PartyPostalAddress stored calc postalAddresses[0]

  /**
   * Customers of this Party.
   */
  customers: [Customer](party)

  /**
   * Preferred phone. Pick the one that was last updated, when there are many.
   */
  preferredPhoneNumber: PartyPhone stored calc phones.(isPreferred == 'true')[0]

  /**
   * Preferred email. Pick the one that was last updated, when there are many.
   */
  preferredEmail: PartyElectronicCommunication stored calc exists(electronicCommunications.(communicationType == 'email' && isPreferred == 'true')) ? electronicCommunications.(communicationType == 'email' && isPreferred == 'true')[0] : electronicCommunications.(communicationType == 'email')[0]

  /**
   * Do not disturb schedule.
   */
  doNotDisturbSchedule: ScheduleRecurringDayRule
}
