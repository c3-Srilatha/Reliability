/**
 * Type to represent an organization segment (e.g., sector or industry).
 */
@db(index+=['meta.timestamp'])
entity extendable type OrganizationSegment type key 'ORG_SEGMENT' schema name 'STRUCT_ORG_SEGMENT' {

  /**
   * The description of {@link OrganizationSegment}.
   */
  description: string

  /**
   * The segment type.
   */
  segmentType: string

  /**
   * The segment code.
   */
  segmentCode: string

  /**
   * List of {@link Organization}s assigned to this {@link OrganizationSegment}.
   */
  organizations: [Organization](organizationSegment)

  /**
   * List of children {@link OrganizationSegment}s.
   */
  children: [OrganizationSegment](parent)

  /**
   * Parent {@link OrganizationSegment}.
   */
  parent: OrganizationSegment
}
