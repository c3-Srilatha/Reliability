/**
 * Preference of communication method for the Party
 */
@db(unique=['communicationType,party'], index+=['meta.timestamp'])
entity type PartyCommunicationPreference schema name 'STRU_PARTYCOMM_PREF' {

  /**
   * Designates how to communicate with the party
   */
  communicationType: !string enum CommunicationType

  /**
   * Whether the party subscribes the communication type or not.
   *
   * For example, the party could subscribe email message but unsubscribe phone call
   */
  isSubscribed: boolean = true

  /**
   * Whether the communication type is a preferred method or not
   */
  isPreferred: boolean

  /**
   * The party
   */
  party: !Party
}
