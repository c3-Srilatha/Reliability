/**
 * Represents a contact person within an {@link Organization}.
 * A Contact is a specific type of {@link PartyRole} that identifies a {@link Person} who serves
 * as a point of contact for business communications and interactions.
 */
entity type Contact extends PartyRole type key 'CNT' {

  /**
   * The {@link Person} who serves as the contact
   */
  party: Person

  /**
   * Job title of the person in this contact role for the related company
   */
  title: string
}
