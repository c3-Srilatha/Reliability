/**
 * Map between a Person and a login user
 */
@db(unique=['user, person'])
entity type PersonUser mixes FeatureEvaluatable schema name 'STRUCT_PERUSR' {

  /**
   * The {@link Person} associated with the user account
   */
  person: !Person

  /**
   * Reference from login user account
   */
  user: !User

  /**
   * Date person registered on the C3 Portal (and created User row).
   */
  registrationDate: datetime
}
