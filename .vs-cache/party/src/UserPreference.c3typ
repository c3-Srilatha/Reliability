/**
 * Represents user-specific preferences and settings in the system.
 * UserPreference is an extendable base type that allows storing arbitrary
 * user preferences using a path-value structure. It mixes {@link AclEnabled} to
 * provide access control capabilities for preference data.
 *
 * This type serves as the foundation for specific preference types like
 * {@link UserNotificationPreference} and other user customization settings.
 */
extendable entity type UserPreference mixes AclEnabled schema name 'PREF_USER' {

  /**
   * The {@link Member} this preference belongs to
   */
  member: Member schema name 'MEMBER_ID'

  /**
   * The hierarchical path identifying the specific preference setting
   */
  path: string

  /**
   * The preference value, stored as a generic object to support various data types
   */
  value: Obj
}
