/**
 * Represents a specific role that a Party can assume in business contexts.
 * PartyRole is an extendable base type that allows parties ({@link Organization}s or {@link Person}s)
 * to take on different roles such as {@link Customer}, {@link Supplier}, {@link Contact}, {@link Department}, etc.
 * This enables flexible modeling of business relationships and organizational structures.
 */
@db(unique=['party, typeIdent'], index+=['party', 'meta.timestamp'])
extendable entity type PartyRole type key 'PR' schema name 'STRUCT_PARTYROLE' {

  /**
   * The {@link Party} that assumes this role
   */
  party: !Party

  /**
   * Relationships where this role serves as the source/from role
   */
  @db(cascadeRemove=true)
  relationSources: [PartyRoleRelation](fromRole) schema name 'RS'

  /**
   * Relationships where this role serves as the target/to role
   */
  @db(cascadeRemove=true)
  relationTargets: [PartyRoleRelation](toRole) schema name 'RT'

  /**
   * Parent {@link PartyRole} in the relationship hierarchy, derived from relation targets
   */
  parents: [PartyRole] stored calc relationTargets.fromRole schema name 'PAR'

  /**
   * Denormalized organizational parents for efficient hierarchy queries
   */
  denormOrgParents: [OrganizationHierarchyDenorm](to, party) schema name 'DOP'

  /**
   * {@link ScheduleCalendar}s associated with this party role
   */
  scheduleCalendar: [ScheduleCalendar](partyRole)

  /**
   * Name of this role, derived from the associated party's name
   */
  name: ~ = party.name
}
