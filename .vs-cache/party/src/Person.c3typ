/**
 * Represents a single logical human being.
 *
 * Human persons
 */
entity type Person extends Party type key 'PER' {

  /**
   * Given name.
   */
  firstName: string

  /**
   * Surname.
   */
  lastName: string

  /**
   * Country where the person was born.
   */
  countryOfBirth: Country

  /**
   * Person's nationalities.
   */
  nationalities: [Country] schema suffix 'NA'

  /**
   * Person's current address.
   */
  currentAddress: InlineAddress schema suffix 'CA'

  /**
   * The list of {@link PersonOrganizationRelation}s.
   */
  organizationRelations: [PersonOrganizationRelation](from)

  /**
   * All contacts for the person.
   *
   * FK references FROM parents
   */
  contact: Contact(party)

  /**
   * Date person registered on the C3 Portal (and created User row).
   */
  registrationDate: datetime

  /**
   * Related login user accounts for this person
   */
  userMapping: [PersonUser](person)

  /**
   * The member.
   */
  member: Member

  /**
   * Full name: "<first> <last>"
   */
  name: ~ = concat(firstName , ' ' , lastName)
}
