/**
 * Represents a relationship between two {@link PartyRole} in the system.
 * {@link PartyRoleRelation} is an extendable base type that establishes connections
 * between different roles that parties can assume, enabling the modeling of
 * complex business relationships such as customer-supplier relationships,
 * organizational hierarchies, and contact assignments.
 */
@db(index+=['meta.timestamp'])
extendable entity type PartyRoleRelation type key 'PREL' schema name 'STRUCT_PROLEREL' {

  /**
   * The source {@link PartyRole} in this relationship (the "from" side)
   */
  fromRole: !PartyRole

  /**
   * The target {@link PartyRole} in this relationship (the "to" side)
   */
  toRole: !PartyRole
}
