/**
 * Type to represent lateral relationship between two {@link Party}s. Each {@link Party} can represent a client
 */
@db(index+=['to, start', 'from, start'])
entity type PartyEdge mixes TimedIntervalRelation<Party, Party> schema name 'PA_REL' {

  /**
   * Used to indicate the nature of the relationship.
   * This field can be used to maintain multiple graphs among {@link Party}s
   */
  relationship: string
}
