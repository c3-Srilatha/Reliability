/**
 * Represents a customer-supplier relationship between two organizations.
 */
entity type CustomerRelation extends PartyRoleRelation mixes Relation<Organization> type key 'CUSR' {

  /**
   * The parent {@link Organization} in the relationship hierarchy
   */
  parent: Organization stored calc fromRole.party

  /**
   * The child {@link Organization} in the relationship hierarchy
   */
  child: Organization stored calc toRole.party

  /**
   * The {@link Supplier} role in this customer relationship
   */
  fromRole: !Supplier

  /**
   * The {@link Customer} role in this customer relationship
   */
  toRole: !Customer

  /**
   * The relationship identifier for this customer relationship
   */
  relationship: ~ = 'PREL:CUSR'

  /**
   * Denormalized reference to the parent organization ({@link Supplier})
   */
  from: ~ stored calc parent

  /**
   * Denormalized reference to the child organization ({@link Customer})
   */
  to: ~ stored calc child

  /**
   * Denormalized type identifier of the supplier role
   */
  fromInfo: ~ stored calc fromRole.typeIdent

  /**
   * Denormalized type identifier of the customer role
   */
  toInfo: ~ stored calc toRole.typeIdent
}
