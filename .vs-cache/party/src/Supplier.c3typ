/**
 * Represents a supplier in the business relationship context.
 * A Supplier is a specific type of {@link PartyRole} that identifies an {@link Organization}
 * that provides goods or services to other organizations or customers.
 */
entity type Supplier extends PartyRole type key 'SUP' {

  /**
   * The {@link Organization} that serves as the supplier
   */
  party: Organization
}
