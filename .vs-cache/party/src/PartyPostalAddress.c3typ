/**
 * Postal address and geo coordinates associated to a party.
 * currently only used by role of Contact
 */
@db(index+=['meta.timestamp'])
entity type PartyPostalAddress mixes InlineAddress schema name 'STRUCT_PARTYADDR' {

  /**
   * Allows designation of use for parties with multiple addresses
   * i.e. billing address, work/office address (for a contact). etc
   */
  addressUsage: string enum('billing', 'office')

  /**
   * Preferred postal address for a party
   * May be used for stored calc to replicate on party or partyRole
   */
  isPreferred: boolean

  /**
   * Street address.
   */
  street_address: string stored calc components.(types.id=='street_address').name

  /**
   * City.
   */
  city: string stored calc components.(types.id=='locality').name

  /**
   * State.
   */
  state: string stored calc components.(types.id=='administrative_area_level_1').abbr

  /**
   * Postal code.
   */
  postalCode: string stored calc components.(types.id=='postal_code').name

  /**
   * FK references FROM parents
   */
  party: !Party

  name: ~ not persistable
}
