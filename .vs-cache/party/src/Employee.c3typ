/**
 * Type to represent an employee.
 */
extendable entity type Employee extends PartyRole type key 'EMPL' {

  /**
   * The {@link Person} has first name and last name.
   */
  party: !Person

  /**
   * Identifier of the employee.
   */
  employeeId: string

  /**
   * Identifier of the employee's department.
   */
  departmentId: string

  /**
   * Employee's role in the company.
   */
  role: string

  /**
   * Employee's status in the company.
   */
  status: string enum('contractor', 'fte')

  /**
   * Start of employment.
   */
  startOfEmployment: datetime

  /**
   * End of employment.
   */
  endOfEmployment: datetime

  /**
   * Country of employment.
   */
  countryOfEmployment: Country
}
