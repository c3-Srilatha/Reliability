/**
 * A hierarchical relationship among {@link Party}s.
 */
@db(index+=['to, start', 'from, start'])
extendable entity type PartyTimedIntervalRelation mixes Relation<Party>, TimedIntervalValue schema name 'PTY_REL' {

  /**
   * Used to indicate the nature of the relationship.
   * This field can be used to maintain multiple tree structures among {@link Party}s
   */
  relationship: ~
}
