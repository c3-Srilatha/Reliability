/**
 * Denormalized hierarchy structure for {@link Organization}s to enable efficient querying
 * of organizational relationships and hierarchies.
 *
 * This type flattens hierarchical relationships from multiple sources including
 * {@link OrganizationRollup} and {@link CustomerRelation} into a single denormalized structure
 * for improved query performance.
 *
 */
@db(index+=['relationship, to', 'relationship, from, to', 'relationship, isRoot'])
@denorm(
  sources=[
    {
      type: 'DenormSource',
      source: 'OrganizationRollup',
      parentFieldName: 'orgRollupParents',
      childFieldName: 'orgRollupChildren'
    },
    {
      type: 'DenormSource',
      source: 'CustomerRelation',
      parentFieldName: 'customerRelationParents',
      childFieldName: 'customerRelationChildren'
    }
  ],
  strictHierarchy=false
)
entity type OrganizationHierarchyDenorm mixes HierarchyDenorm<Organization> schema name 'STRUCT_ORGHDNRM' {

  /**
   * Name field inherited from base type, not persisted in denormalized structure
   */
  name: ~ not persistable

  /**
   * Version field inherited from base type, not persisted in denormalized structure
   */
  version: ~ not persistable

  /**
   * Metadata field inherited from base type, not persisted in denormalized structure
   */
  meta: ~ not persistable

  /**
   * Version edits field inherited from base type, not persisted in denormalized structure
   */
  versionEdits: ~ not persistable
}
