/**
 * Email, Twitter handle, URL etc associated with a party.
 *
 * Business Key: party+type+identifier+usage
 */
@db(unique=['communicationIdentifier,communicationType,communicationUsage,party'], index+=['meta.timestamp'])
entity type PartyElectronicCommunication schema name 'STRUCT_PARTYEC' {

  /**
   * Allows designation of use for parties with multiple email addresses
   * i.e. billing email, marketing email, etc
   */
  communicationUsage: string enum('billing')

  /**
   * Designates how to communicate with the party using communicationIdentifier
   */
  communicationType: !string enum('email', 'twitter', 'facebook', 'url')

  /**
   * Email address, twitter handle text used for identification
   */
  communicationIdentifier: !string

  /**
   * Preferred electronic communication for a party
   * may be used for stored calc to replicate on party or partyRole
   */
  isPreferred: boolean

  /**
   * FK to parent
   */
  party: !Party

  name: ~ not persistable
}
