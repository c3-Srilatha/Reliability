/**
 * Organizations = companies, agencies, etc.
 * Examples: Environmental Protection Agency, Dow Chemicals.
 */
@denorm(target='OrganizationHierarchyDenorm', strictHierarchy=false)
entity type Organization extends Party
                         mixes AclEnabled, WeatherAware, FeatureEvaluatable type key 'ORG' {

  /**
   * Full textual description of Organization.
   */
  description: string

  /**
   * Country of incorporation.
   */
  countryOfIncorporation: Country

  /**
   * Date of incorporation.
   */
  dateOfIncorporation: datetime

  /**
   * Country of domicile.
   */
  countryOfDomicile: Country

  /**
   * Country of location.
   */
  countryOfLocation: Country

  /**
   * Country of risk.
   */
  countryOfRisk: Country

  /**
   * The company type.
   */
  companyType: string

  /**
   * The market segment.
   */
  marketSegment: string

  /**
   * The gross revenue.
   */
  grossRevenue: MonetaryValue

  /**
   * The {@link OrganizationSegment} to which belongs this {@link Organization}.
   */
  organizationSegment: OrganizationSegment

  /**
   * The number of employees.
   */
  numberOfEmployees: int

  /**
   * Whether this {@link Organization} is linked to a sanctioned country.
   */
  linkedToSanctionedCountry: boolean

  /**
   * In the OrganizationHierarchyDenorm, the parents of this Org.
   */
  denormParents: [OrganizationHierarchyDenorm](to) schema name 'DP'

  /**
   * In the OrganizationRollup, the parents of this Org.
   */
  orgRollupParents: [OrganizationRollup](to)

  /**
   * In the CustomerRelation, the parents of this Org.
   */
  customerRelationParents: [CustomerRelation](to)

  /**
   * In the OrganizationRollup, the children of this Org.
   */
  orgRollupChildren: [OrganizationRollup](from)

  /**
   * In the CustomerRelation, the children of this Org.
   */
  customerRelationChildren: [CustomerRelation](from)

  /**
   * In the OrganizationHierarchyDenorm, the actual Organization associated with the
   * OrganizationHierarchyDenorm parents of this Organization.
   */
  parentOrgs: [Organization] stored calc denormParents.(startsWith(relationship, 'PREL:OROL')).from schema name 'PO'

  /**
   * Depth in the OrganizationHierarchyDenorm
   * - 0 - is root parent,
   * - null - is not part of hierarchy
   * - n (n>0) is nth level from root
   */
  depthFromRootParent: int stored calc max(denormParents.(startsWith(relationship, 'PREL:OROL')).distance)

  /**
   * In the OrganizationHierarchyDenorm, the children of this Org.
   */
  denormChildren: [OrganizationHierarchyDenorm](from) schema name 'DC'

  /**
   * The various characteristics of the Org (instead of adding innumerable fields to the type)
   */
  characteristics: [OrganizationCharacteristicSet](parent)

  /**
   * The list of {@link PersonOrganizationRelation}s.
   */
  personRelations: [PersonOrganizationRelation](to)
}
